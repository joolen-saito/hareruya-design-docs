{
  "name": "hareruya-e2e",
  "version": "0.1.0",
  "private": true,
  "description": "結合テストケース（integration_test/casegen/all_test_cases.tsv）を Playwright で実行する基盤。テストデータは画面から作る。",
  "scripts": {
    "test": "playwright test",
    "test:headed": "playwright test --headed",
    "report": "playwright show-report",
    "typecheck": "tsc --noEmit",
    "coverage": "node tools/coverage.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.0",
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0"
  }
}
