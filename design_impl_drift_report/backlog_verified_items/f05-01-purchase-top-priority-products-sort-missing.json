          "start": 1,
          "end": 8,
          "language": "twig",
          "contains": [
            "tagged_unisearch_request(constant('Eccube\\\\Entity\\\\Tag::FEATURE_PURCHASE_ID'), purchaseUnisearchPageSize|default(60), true)",
            "目玉買取商品"
          ]
        },
        {
          "label": "ec-cube-enterprise 買取タグブロックは発売日ソートを固定設定",
          "path": "ec-cube-enterprise/src/Eccube/Twig/Extension/TaggedUnisearchRequestExtension.php",
          "start": 67,
          "end": 80,
          "language": "php",
          "contains": [
            "'tags' => [(string) $tagId]",
            "if ($isBuy) {",
            "$query['sort'] = 'release_date';",
            "'unisearchRequest' => $this->uniSearchService->createUnisearchParameter($query, $isBuy)"
          ]
        },
        {
          "label": "ec-cube-enterprise UniSearch は release_date desc を送信",
          "path": "ec-cube-enterprise/src/Eccube/Service/UniSearch/UniSearchService.php",
          "start": 316,
          "end": 329,
          "language": "php",
          "contains": [
            "$sortKey = $query['sort'] ?? null;",
            "} elseif ($sortKey === 'release_date') {",
            "$params[] = 'sort='.urlencode('release_date desc,product desc,language asc,foil_flg asc');"
          ]
        },
        {
          "label": "ec-cube-enterprise タグには優先表示商品カラムがある",
          "path": "ec-cube-enterprise/src/Eccube/Entity/Tag.php",
          "start": 221,
          "end": 229,
          "language": "php",
          "contains": [
