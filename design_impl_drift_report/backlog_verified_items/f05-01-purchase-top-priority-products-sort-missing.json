          "end": 68,
          "language": "php",
          "contains": [
            "'tags' => [Tag::FEATURE_PURCHASE_ID]",
            "$app['hareruya_ec.repository.product_sub_class']->getProductsByTagsExceptHighPrice($query, 'purchase_top_feature_products')"
          ]
        },
        {
          "label": "ベース実装 pf-eccube3 買取トップ向け検索で優先表示商品対応を呼び出す",
          "path": "pf-eccube3/app/Plugin/HareruyaEc/Repository/DtbProductSubClassRepository.php",
          "start": 861,
