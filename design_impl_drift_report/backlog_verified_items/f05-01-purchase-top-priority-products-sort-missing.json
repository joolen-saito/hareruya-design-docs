          "language": "php",
          "contains": [
            "public function getProductsByTagsExceptHighPrice($query, $cacheName)",
            "pc.price02 > 0",
            "pt.Tag",
            "$priorityParameters = $this->addSortForPriority($qb, $tags);"
          ]
        },
        {
          "label": "ベース実装 pf-eccube3 priorityProducts から商品コード順の CASE ソートを組む",
          "path": "pf-eccube3/app/Plugin/HareruyaEc/Repository/DtbProductSubClassRepository.php",
          "start": 1033,
