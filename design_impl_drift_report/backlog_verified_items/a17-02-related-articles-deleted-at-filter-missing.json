{
  "id": "a17-02-related-articles-deleted-at-filter-missing",
  "status": "verified",
  "sourceFinding": "hareruya-design-docs/design_impl_drift_report/findings/a17-02_0517_sheet-4_id.json",
  "sourceFindingId": "a17-02_0517_sheet-4_id-conformance-bb37c3e32fee",
  "classification": "APIその他",
  "feature": "記事IDに関連する記事情報を取得",
  "issueCategory": "実装違い",
  "issue": "関連記事取得で論理削除済みの記事が除外されない",
  "designBook": "0517_基本設計仕様書(API_その他).xlsx",
  "reproSteps": [
    "dtb_article に、同じ wp_type_id と関連中間テーブルを共有する記事を用意し、基準記事または関連記事側の deleted_at に日時を設定する",
    "GET http://localhost:8080/article/related/{wpPostId} を実行する",
    "deleted_at が設定された基準記事または関連記事が、関連記事検索の基準・レスポンス対象になるかを確認する"
  ],
  "expected": [
    "dtb_article.deleted_at が設定された記事は論理削除済みとして、基準記事にも関連記事レスポンスにも使用しない",
    "基準記事は dtb_article.wp_post_id で特定し、deleted_at が NULL の記事だけを対象にする",
    "関連記事側も deleted_at が NULL の記事だけを返す"
  ],
  "current": [
    {
      "text": "ec-cube-enterprise では、`ArticleController::getRelatedArticlesAction` が `DtbArticleRepository::getRelatedArticles()` を呼び、同Repositoryは DBAL connection の raw SQL で `dtb_article a1` と `dtb_article a2` を直接参照している。SQLの WHERE は `a1.wp_post_id = :wpPostId`、`a2.wp_post_id <> a1.wp_post_id`、`a2.wp_post_id <> 0` と共有中間テーブルの EXISTS 条件で、`a1.deleted_at IS NULL` も `a2.deleted_at IS NULL` もない。raw SQL なので Doctrine SoftDeleteable filter による暗黙除外も効かず、論理削除済み記事が基準または関連記事に含まれ得る。",
      "snippets": [
        {
          "label": "ec-cube-enterprise Controller は関連記事取得を DtbArticleRepository::getRelatedArticles に委譲する",
          "path": "ec-cube-enterprise/src/Eccube/Controller/App/ArticleController.php",
          "start": 81,
          "end": 104,
          "language": "php",
          "contains": [
            "#[Route('/article/related/{id}', name: 'article_related', methods: ['GET'])]",
            "public function getRelatedArticlesAction(string $id, Request $request): JsonResponse",
            "$relatedArticles = $this->dtbArticleRepository->getRelatedArticles((int) $id, $limit)",
            "throw new NotFoundException('関連記事が見つかりません')",
            "return new JsonResponse($relatedArticles, 200)"
          ]
        },
        {
          "label": "ec-cube-enterprise Repository は raw SQL で dtb_article a1/a2 を参照するが deleted_at 条件がない",
          "path": "ec-cube-enterprise/src/Eccube/Repository/DtbArticleRepository.php",
          "start": 40,
          "end": 80,
          "language": "php",
          "contains": [
            "public function getRelatedArticles(int $wpPostId, int $limit): array",
            "$conn = $this->getEntityManager()->getConnection()",
            "$sql = '",
            "FROM dtb_article a1",
            "INNER JOIN dtb_article a2 ON a1.wp_type_id = a2.wp_type_id",
            "WHERE a1.wp_post_id = :wpPostId",
            "AND a2.wp_post_id <> a1.wp_post_id",
            "AND a2.wp_post_id <> 0"
          ]
        },
        {
          "label": "ec-cube-enterprise Repository は executeQuery で raw SQL を実行し、結果をそのままレスポンス配列へ詰める",
          "path": "ec-cube-enterprise/src/Eccube/Repository/DtbArticleRepository.php",
          "start": 119,
          "end": 139,
          "language": "php",
          "contains": [
            "$stmt = $conn->prepare($sql)",
            "$result = $stmt->executeQuery(",
            "'wpPostId' => $wpPostId",
            "'limit' => $limit",
            "'wpPostId' => ParameterType::INTEGER",
            "'wpPostId' => (int) $row['wp_post_id']",
            "return $rows"
          ]
        },
        {
          "label": "ec-cube-enterprise DtbArticle は deleted_at カラムを持つが SoftDeleteable 属性は付いていない",
          "path": "ec-cube-enterprise/src/Eccube/Entity/DtbArticle.php",
          "start": 27,
          "end": 51,
          "language": "php",
          "contains": [
            "#[ORM\\Entity(repositoryClass: DtbArticleRepository::class)]",
            "class DtbArticle extends AbstractEntity",
            "#[ORM\\Column(name: 'wp_post_id'",
            "#[ORM\\Column(name: 'deleted_at', type: Types::DATETIMETZ_MUTABLE, nullable: true)]",
            "private ?\\DateTime $deletedAt = null"
          ]
        }
      ]
    },
    {
      "text": "ベース実装(pf-api)では、`GET /article/related/{id}` が `ArticleController::getRelatedArticlesAction` から ORM QueryBuilder の `DtbArticleRepository::getRelatedArticles()` を呼ぶ。Repository本文に明示的な `deletedAt` 条件はないが、対象Entity `DtbArticle` には `@Gedmo\\SoftDeleteable(fieldName=\"deletedAt\")` が付与され、Doctrineの `softdeleteable` filter が有効化され、SoftDeleteableListener も登録されている。そのため、pf-apiではORM経由の関連記事取得で論理削除済み記事が暗黙に除外される。",
      "snippets": [
        {
          "label": "ベース実装 pf-api は GET /article/related/{id} を getRelatedArticlesAction に割り当てる",
          "path": "pf-api/config/routes.yaml",
          "start": 152,
          "end": 155,
          "language": "yaml",
          "contains": [
            "get_related_article:",
            "path: /article/related/{id}",
            "controller: App\\Controller\\ArticleController::getRelatedArticlesAction",
            "methods: GET"
          ]
        },
        {
          "label": "ベース実装 pf-api Controller は Repository の getRelatedArticles を呼び、空なら Not Found を返す",
          "path": "pf-api/src/Controller/ArticleController.php",
          "start": 116,
          "end": 130,
          "language": "php",
          "contains": [
            "public function getRelatedArticlesAction($id, Request $request)",
            "$articles = $em->getRepository(DtbArticle::class)->getRelatedArticles($id, $request->get('limit'))",
            "if (empty($articles))",
            "\"code\" => 404",
            "\"message\" => 'Not Found'",
            "return $articles"
          ]
        },
        {
          "label": "ベース実装 pf-api Repository は ORM QueryBuilder で DtbArticle を取得する",
          "path": "pf-api/src/Repository/DtbArticleRepository.php",
          "start": 37,
          "end": 68,
          "language": "php",
          "contains": [
            "public function getRelatedArticles($wpPostId, $limit = 20)",
            "$qb = $this->createQueryBuilder('article1')",
            "->from('\\App\\Entity\\DtbArticle', 'article2')",
            "->where('article1.wpPostId = :wpPostId')",
            "->andWhere('article1.wpPostId <> article2.wpPostId')",
            "return $qb->getQuery()->getResult()"
          ]
        },
        {
          "label": "ベース実装 pf-api DtbArticle は Gedmo SoftDeleteable 対象である",
          "path": "pf-api/src/Entity/DtbArticle.php",
          "start": 10,
          "end": 16,
          "language": "php",
          "contains": [
            "DtbArticle",
            "@JSON\\ExclusionPolicy(\"all\")",
            "@Gedmo\\SoftDeleteable(fieldName=\"deletedAt\", timeAware=false)",
            "class DtbArticle"
          ]
        },
        {
          "label": "ベース実装 pf-api は Doctrine softdeleteable filter を有効化している",
          "path": "pf-api/config/packages/doctrine.yaml",
          "start": 28,
          "end": 31,
          "language": "yaml",
          "contains": [
            "filters:",
            "softdeleteable:",
            "class: Gedmo\\SoftDeleteable\\Filter\\SoftDeleteableFilter",
            "enabled: true"
          ]
        },
        {
          "label": "ベース実装 pf-api は SoftDeleteableListener を Doctrine event subscriber として登録している",
          "path": "pf-api/config/services.yaml",
          "start": 45,
          "end": 50,
          "language": "yaml",
          "contains": [
            "gedmo.listener.softdeleteable:",
            "class: Gedmo\\SoftDeleteable\\SoftDeleteableListener",
            "setAnnotationReader",
            "doctrine.event_subscriber"
          ]
        }
      ]
    }
  ],
