    31	    /**
    32	     * 関連記事を取得
    33	     * 
    34	     * @param integer $wpPostId
    35	     * @return array
    36	     */
    37	    public function getRelatedArticles($wpPostId, $limit = 20)
    38	    {
    39	        $qb = $this->createQueryBuilder('article1')
    40	            ->distinct(true)
    41	            ->from('\App\Entity\DtbArticle', 'article2')
    42	            ->leftJoin('article1.decks', 'deck1')
    43	            ->leftJoin('article2.decks', 'deck2')
    44	            ->leftJoin('article1.cards', 'card1')
    45	            ->leftJoin('article2.cards', 'card2')
    46	            ->leftJoin('article1.archetypes', 'archetype1')
    47	            ->leftJoin('article2.archetypes', 'archetype2')
    48	            ->leftJoin('article1.eventDetails', 'eventDetail1')
    49	            ->leftJoin('article2.eventDetails', 'eventDetail2')
    50	            ->select('article2.wpPostId')
    51	            ->addSelect('max(CASE WHEN deck1.deckId = deck2.deckId THEN 1 ELSE 0 END) as hasSameDeck')
    52	            ->addSelect('max(CASE WHEN archetype1.archetypeId = archetype2.archetypeId THEN 1 ELSE 0 END) as hasSameArchetype')
    53	            ->addSelect('max(CASE WHEN card1.id = card2.id THEN 1 ELSE 0 END) as hasSameCard')
    54	            ->addSelect('max(CASE WHEN eventDetail1.eventDetailId = eventDetail2.eventDetailId THEN 1 ELSE 0 END) as hasSameEventDetail')
    55	            ->groupBy('article2.wpPostId')
    56	            ->where('article1.wpPostId = :wpPostId')
    57	            ->andWhere('article1.wpPostId <> article2.wpPostId')
    58	            ->andWhere('article1.wpTypeId = article2.wpTypeId')
    59	            ->andWhere('article2.wpPostId <> 0')
    60	            ->andWhere('deck1.deckId = deck2.deckId OR card1.id = card2.id OR archetype1.archetypeId = archetype2.archetypeId OR eventDetail1.eventDetailId = eventDetail2.eventDetailId')
    61	            ->orderBy('hasSameDeck', 'DESC')
    62	            ->addOrderBy('hasSameArchetype', 'DESC')
    63	            ->addOrderBy('hasSameCard', 'DESC')
    64	            ->addOrderBy('hasSameEventDetail', 'DESC')
    65	            ->setMaxResults($limit)
    66	            ->setParameter('wpPostId', $wpPostId);
    67	
    68	        return $qb->getQuery()->getResult();
    69	    }
    70	}
