from pathlib import Path
class P(HTMLParser):
 def __init__(self): super().__init__(convert_charrefs=True); self.stack=[]; self.items=[]
 def handle_starttag(self,tag,attrs):
  d=dict(attrs); self.stack.append([d.get('data-excel-ref'),[]] if d.get('data-excel-ref') else None)
 def handle_data(self,data):
  for x in self.stack:
