   566	    public function cancelRequestByProductStatus(): int
   567	    {
   568	        $sql = <<<SQL
   569	            UPDATE dtb_product_request
   570	            SET deleted_at = :now
   571	            WHERE deleted_at IS NULL
   572	              AND (
   573	                  product_class_id IN (
   574	                      SELECT pc.id
   575	                      FROM dtb_product_class pc
   576	                      JOIN dtb_product p ON pc.product_id = p.id
   577	                      WHERE pc.product_status_id IN (:hide, :abolished)
   578	                         OR p.product_status_id IN (:hide, :abolished)
   579	                  )
   580	                  OR (
   581	                      product_class_id IS NULL
   582	                      AND product_id IN (
   583	                          SELECT p.id
   584	                          FROM dtb_product p
   585	                          WHERE p.product_status_id IN (:hide, :abolished)
   586	                      )
   587	                  )
   588	              )
   589	            SQL;
   590	
   591	        return $this->getEntityManager()->getConnection()->executeStatement($sql, [
   592	            'now' => (new \DateTime())->format(self::MYSQL_DATE_FORMAT),
   593	            'hide' => ProductStatus::DISPLAY_HIDE,
   594	            'abolished' => ProductStatus::DISPLAY_ABOLISHED,
   595	        ]);
   596	    }
