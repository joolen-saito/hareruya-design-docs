    36	
    37	        // elementをkeyとした連想配列
    38	        foreach ($shopPageElements as $shopPageElement) {
    39	            $e = $shopPageElement->getElement();
    40	            $v = $shopPageElement->getValue();
    41	            foreach (self::RightColumns as $ck => $cv) {
    42	                if (strpos($e, $cv) !== false && !in_array($cv, $rightColumns) && $v){
    43	                    $rightColumns[] = $cv;
    44	                    if (empty($lastElement) || $lastElement < $ck) {
    45	                        $lastElement = $ck;
    46	                    }
    47	                }
    48	            }
    49	            $values += [$e => $v];
    50	        }
    51	        // 最後の要素名
    52	        if ($lastElement) {
    53	            $lastElement = self::RightColumns[$lastElement];
    54	        }
    55	
    56	        return $app->render('ShopPage/index.twig', [
