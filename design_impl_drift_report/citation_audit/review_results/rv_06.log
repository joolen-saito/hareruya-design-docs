 ('0303_基本設計仕様書(フロント_商品).html','sheet-3',[
  'ご指定の条件に一致する商品が見つかりませんでした。','0件','ゼロ件','該当なし','検索結果なし','見つかりません','一致する商品','抽出件数','一覧領域','該当商品','検索条件'])]

class P(HTMLParser):
 def __init__(self, target):
  super().__init__(convert_charrefs=True); self.target=target; self.sections=[]; self.capture=[]; self.rows=[]
 def handle_starttag(self,tag,attrs):
  a=dict(attrs)
  if tag=='section': self.sections.append((a.get('id'), 'function-design-embed' in a.get('class','').split()))
  if tag=='span' and 'src-cell' in a.get('class','').split() and any(sid==self.target for sid,_ in self.sections) and not any(embed for _,embed in self.sections):
   self.capture.append({'tag':tag,'depth':1,'line':self.getpos()[0],'ref':a.get('data-excel-ref'),'text':[]})
  elif self.capture:
   self.capture[-1]['depth'] += 1
 def handle_startendtag(self,tag,attrs):
  pass
 def handle_data(self,d):
  if self.capture: self.capture[-1]['text'].append(d)
 def handle_endtag(self,tag):
  if self.capture:
   self.capture[-1]['depth'] -= 1
   if self.capture[-1]['depth']==0:
    r=self.capture.pop(); r['text']=''.join(r['text']).strip(); self.rows.append(r)
  if tag=='section' and self.sections: self.sections.pop()

root=Path('hareruya-design-docs/excel_to_html/output')
for fn,sec,terms in jobs:
 p=P(sec); p.feed((root/fn).read_text())
 print(f'FILE={fn} SECTION={sec} SRC_CELLS={len(p.rows)}')
 for term in terms:
  hits=[r for r in p.rows if term.casefold() in r['text'].casefold()]
  print(f'{term}\\t{len(hits)}\\t'+' | '.join(f\"L{r['line']} {r['ref']} 『{r['text']}』\" for r in hits[:6]))
