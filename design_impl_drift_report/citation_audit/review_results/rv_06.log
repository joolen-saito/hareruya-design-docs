import base64,sys
from html.parser import HTMLParser
from pathlib import Path
src=Path('hareruya-design-docs/excel_to_html/output/0302_基本設計仕様書(フロント_グローバルナビ).html').read_text()
part=src[src.index('<section class=\"sheet-panel\" id=\"sheet-6\">'):src.index('<"'!-- function-design-embed:start f02-04'"')]
class P(HTMLParser):
 def __init__(self): super().__init__(); self.rows=[]
 def handle_starttag(self,tag,attrs):
  if tag=='img':
