    /**
     * ステータスを「出荷完了」に更新
     *
     * @param  Application $app
     * @param  string      $smaregiCode
     * @return integer
     */
    private function updateSmaregiStatusToDeliv(Application $app, ?string $smaregiCode)
    {
        if (empty($smaregiCode)) {
            return 0;
        }

        $orderSub = $app['hareruya_ec.repository.order_sub']->findOneBy(['smaregiCode' => $smaregiCode], ['orderId' => 'DESC']);

        if (!$orderSub) {
            return 0;
        }

        $now = new \DateTime();

        $order = $orderSub->getOrder();
        foreach ($order->getShippings() as $shipping) {
            $shipping->setShippingCommitDate($now);
        }

        $order
            ->setCommitDate($now)
            ->setOrderStatus($app['eccube.repository.order_status']->find(OrderStatus::ORDER_DELIV));
        $orderSub->setShippingDate($now);

        $memberSub = $app['hareruya_ec.repository.member_sub']->findOneBySmaregiMemberFlg(1);
        if (!empty($memberSub)) {
            $orderSub->setOperator($memberSub->getMember());
        }
        $app['hareruya_ec.service.point']->gainPoints($order);
        $app['orm.em']->persist($orderSub);

        // スマレジ側で決済やポイントの付与が行われている場合は以降の処理不要
        if ($orderSub->getGainedPoints() === 0) {
            $app['orm.em']->flush();

            return 1;
        }

        $player = $app['hareruya_ec.repository.player']->findOneByCustomer($order->getCustomer());

        // 付与ポイントのスマレジ連携。使用ポイントはECからの注文時に連携済み
        $response = $app['hareruya_ec.service.smaregi_customer']->postSmaregiPoint($player->getSmaregiId(), $orderSub->getGainedPoints(), false);
        if (!array_key_exists('result', $response)) {
            $orderSub
                ->setPointErrorMessage(json_encode($response, JSON_UNESCAPED_UNICODE))
                ->setSmaregiErrorFlg(true);
        }

        $app['orm.em']->flush();

        return 1;
    }

     * @param  Application $app
     * @param  string $header
     * @param  string $process
     * @param  string $param
     */
    private function cURLForwardBranchSmaregi(Application $app, $header, $process, $param)
    {
        $param = urlencode($param);
        $url = $app['hareruya_ec.config.api']['branch_api_url'] . $app['hareruya_ec.config.api']['endpoint_smaregi_transaction'];
        $curl = curl_init();
        curl_setopt($curl, CURLOPT_URL, $url);
        curl_setopt($curl, CURLOPT_CUSTOMREQUEST, 'POST');
        curl_setopt($curl, CURLOPT_HTTPHEADER, $header);
        curl_setopt($curl, CURLOPT_POSTFIELDS, "proc_name={$process}&params=" . $param);
        curl_setopt($curl, CURLOPT_RETURNTRANSFER, true);
        curl_setopt($curl, CURLOPT_HEADER, true);

        $response = curl_exec($curl);
        $header_size = curl_getinfo($curl, CURLINFO_HEADER_SIZE);
        $body = substr($response, $header_size);
        $result = json_decode($body, true);

        curl_close($curl);

        return $result;
    }
}
