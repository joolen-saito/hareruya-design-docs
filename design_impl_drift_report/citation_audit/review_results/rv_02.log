sId": 1149755,<br>                                    "productCode": "TDM00233JPMP",<br>                                    "buyPrice": 100,<br>                                    "price": "350",<br>                                    "stock": "0",<br>                                    "sectionId": 2<br>                                },<br>                                "HP": {<br>                                    "productClassId": 1149756,<br>                                    "productCode": "TDM00233JPHP",<br>                                    "buyPrice": 50,<br>                                    "price": "300",<br>                                    "stock": "0",<br>                                    "sectionId": 2<br>                                }<br>                            }<br>                        }<br>                    }<br>                },カードに紐づくカード詳細IDがまだある場合は以降も続く</td></tr>
