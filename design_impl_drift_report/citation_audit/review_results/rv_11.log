<?php
namespace Plugin\HareruyaEc\Form\Type\Admin;

use Symfony\Component\HttpFoundation\File\UploadedFile;
use Symfony\Component\Validator\ConstraintValidator;
use Symfony\Component\Validator\Constraint;
use Eccube\Entity\Master\Disp;

class CsvMimeTypeValidator extends ConstraintValidator
{
    /**
     * validate
     *
     * @param UploadedFile $value
     * @param Constraint $constraint
     */
    public function validate($value, Constraint $constraint)
    {
        if ($value instanceof UploadedFile && $value->isValid()) {
            $mimeTypes = ['text/plain', 'text/csv', 'text/tab-separated-values', 'application/vnd.ms-excel'];
            $mime = $value->getClientMimeType();
            foreach ($mimeTypes as $mimeType) {
                if ($mimeType === $mime) {
                    return;
                }
            }

            $this->context->buildViolation($constraint->app->trans('admin.csv.error.upload.mime'))
                ->setParameter('{{ type }}', $mime)
                ->setParameter('{{ types }}', implode(', ', $mimeTypes))
                ->addViolation();
        }
    }
}
