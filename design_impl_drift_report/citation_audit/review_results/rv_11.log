    public function onAfterImport(AfterReadEvent $event)
    {
        parent::onAfterImport($event);

        // インポート成功の場合、支店システムと連携
        if ($event->isSuccessful()) {
            $this->em->commit(); // $this->emのトランザクションをcommitしないと支店側が最新化されない
            $branchUpdate = new BranchUpdateService($this->app);
            $branchUpdate->noticeProductUpdate(array_unique($this->importedIds));
        }
        // メモリを開放する
        $this->productIdColumn = null;
        $this->languageIdColumn = null;
        $this->sellPriceColumn = null;
        $this->buyPriceColumn = null;
            return $this->render($app, $form, $headers, $this->productPriceTwig, [], MtbCsvImportType::PRODUCT_PRICE_IMPORT_CSV_ID);
        }

        log_info('セール用価格変更CSV登録開始');

        $importer = new CsvImporter($app, new ProductPriceImportHandler($app));
        $result = $importer->import($file);

        if ($result->hasError()) {
            log_info('セール用価格変更CSV登録 異常終了');
        } else {
            $app->addSuccess('admin.product.csv_import.save.complete', 'admin');
            log_info('セール用価格変更CSV登録完了', ['count' => $result->getCount()]);
            $csvImportType = $app['hareruya_ec.repository.csv_import_type']->findOneById(MtbCsvImportType::PRODUCT_PRICE_IMPORT_CSV_ID);
            $app['hareruya_ec.repository.csv_import_history']->insertCsvImportHistory($app, $csvImportType, $file->getClientOriginalName());
        }

        $app['hareruya_ec.repository.member']->removeSoftDeleteFilterForMember($app);
        $importHistories = $app['hareruya_ec.repository.csv_import_history']->findBy(['csvImportTypeId' => MtbCsvImportType::PRODUCT_PRICE_IMPORT_CSV_ID], ['createDate' => 'DESC'], self::CSV_IMPORT_HISTORY_LIMIT);
