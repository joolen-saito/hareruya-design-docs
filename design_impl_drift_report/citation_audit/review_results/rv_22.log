from html.parser import HTMLParser
class P(HTMLParser):
 def __init__(self): super().__init__(); self.stack=[]; self.rows=[]
 def handle_starttag(self, tag, attrs):
  d=dict(attrs)
  for x in self.stack:
   if x: x['level']+=1
  self.stack.append({'tag':tag,'level':1,'a':d,'t':[]} if 'data-excel-ref' in d else None)
 def handle_data(self,d):
  for x in self.stack:
   if x: x['t'].append(d)
 def handle_endtag(self,tag):
  if not self.stack:return
  x=self.stack.pop()
  if x:self.rows.append((x['a'].get('data-excel-sheet'),x['a'].get('data-excel-ref'),' '.join(''.join(x['t']).split())))
  for y in self.stack:
   if y:y['level']-=1
p=P();p.feed(open('hareruya-design-docs/excel_to_html/output/0208_基本設計仕様書(カード管理).html',encoding='utf-8').read())
for target in ['カード詳細(登録・編集・削除)','カード登録CSVアップロード','カード登録CSV']:
 print('\\n###',target)
 seen=set()
 for sh,ref,text in p.rows:
