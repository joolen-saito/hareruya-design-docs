from html.parser import HTMLParser
from collections import defaultdict
class P(HTMLParser):
 def __init__(self): super().__init__(); self.stack=[]; self.rows=[]
 def handle_starttag(self, tag, attrs):
  d=dict(attrs); self.stack.append({'a':d,'t':[]} if 'data-excel-ref' in d else None)
 def handle_startendtag(self, tag, attrs):
  d=dict(attrs)
  if 'data-excel-ref' in d:self.rows.append((d.get('data-excel-sheet'),d['data-excel-ref'],''))
 def handle_data(self,d):
  for x in self.stack:
   if x:x['t'].append(d)
 def handle_endtag(self,tag):
  if not self.stack:return
  x=self.stack.pop()
  if x:self.rows.append((x['a'].get('data-excel-sheet'),x['a']['data-excel-ref'],' '.join(''.join(x['t']).split())))
