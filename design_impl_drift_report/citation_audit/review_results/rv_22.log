   176	            $cardlist = !is_null($id) ? $app['hareruya_ec.repository.card']->selectCardsetId($id) : [];
   177	
   178	            return $app->render('HareruyaEc/Resource/template/admin/Cardset/card_set_detail.twig', [
   179	                'form' => $form->createView(),
   180	                'cardlists' => $cardlist,
   181	                'id' => $id,
   182	            ]);
   183	        }
   184	
   185	        $data = $form->getData();
   186	        // シンボル画像前処理
   187	        $symbolImage = null;
   188	
   189	        if (!empty($data['upload_url'])) {
   190	            $uploadDir = $app['config']['user_data_realdir'];
   191	            $symbolImage = $this->convertStrToServer($data['upload_url']->getClientOriginalName());
   192	            $uploadPath = $uploadDir . '/' . $symbolImage;
   193	        // アップロードしない場合、元の画像を引き継ぐ
   194	        } elseif (!empty($data['symbol_image'])) {
   195	            $symbolImage = $data['symbol_image'];
   196	        }
   197	        // 登録/更新判定
   198	        $isRegister = is_null($data['id']);
   199	
   200	        if ($isRegister) {
   201	            $mtbCardset = new \Plugin\HareruyaEc\Entity\MtbCardset();
   202	        } else {
   203	            $mtbCardset = $app['hareruya_ec.repository.cardset']->findOneById($data['id']);
   204	        }
   205	
   206	        $mtbCardset->setNameJp($data['nameJp'])
   207	            ->setNameEn($data['nameEn'])
   208	            ->setCode($data['code'])
