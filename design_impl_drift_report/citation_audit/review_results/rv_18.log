    /*
     * 既に自身以外のスマレジ用アカウントが存在するか
    */
    private function isExistSmaregiMember(Application $app, int $memberId) : bool
    {
        $criteria = new \Doctrine\Common\Collections\Criteria();
        $criteria->where($criteria->expr()->eq('smaregiMemberFlg', 1))
            ->andWhere($criteria->expr()->neq('memberId', $memberId));

        return count($app['hareruya_ec.repository.member_sub']->matching($criteria)) > 0;
    }
}
