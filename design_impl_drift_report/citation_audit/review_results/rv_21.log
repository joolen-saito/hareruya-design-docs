for key,(path,sid) in specs.items():
    p=Cells(sid); p.feed(Path(path).read_text())
    print(f'[{key} {sid}] cells={len(p.cells)}')
    for term in terms[key]:
        hits=[(ref,txt) for ref,txt in p.cells if term.casefold() in txt.casefold()]
        if hits:
            print(f'{term}: {len(hits)} :: ' + ' | '.join(f'{ref}={txt}' for ref,txt in hits[:3]))
        else: print(f'{term}: 0')
