from html.parser import HTMLParser
from pathlib import Path
class Cells(HTMLParser):
    def __init__(self,sid):
        super().__init__(); self.sid=sid; self.sec_depth=0; self.in_target=False; self.target_depth=None; self.span=None; self.buf=[]; self.cells=[]
    def handle_starttag(self,tag,attrs):
        a=dict(attrs)
        if tag=='section':
            self.sec_depth += 1
            if not self.in_target and a.get('id')==self.sid:
                self.in_target=True; self.target_depth=self.sec_depth
        if self.in_target and tag=='span' and 'src-cell' in a.get('class','').split() and a.get('data-excel-ref'):
            self.span=a['data-excel-ref']; self.buf=[]
        elif self.in_target and self.span is not None and tag=='br':
            self.buf.append(' ')
    def handle_endtag(self,tag):
        if self.in_target and tag=='span' and self.span is not None:
            text=' '.join(''.join(self.buf).split()); self.cells.append((self.span,text)); self.span=None; self.buf=[]
        if tag=='section':
            if self.in_target and self.sec_depth==self.target_depth:
                self.in_target=False
            self.sec_depth -= 1
    def handle_data(self,data):
        if self.in_target and self.span is not None:self.buf.append(data)
