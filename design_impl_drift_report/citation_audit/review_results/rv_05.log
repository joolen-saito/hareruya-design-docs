from pathlib import Path
class P(HTMLParser):
    def __init__(self):
        super().__init__(); self.stack=[]; self.cur=None; self.out=[]
    def handle_starttag(self,tag,attrs):
        a=dict(attrs)
        if tag=='span' and 'src-cell' in a.get('class','').split():
            self.cur=[a,[]]; self.stack.append('src')
        elif self.cur is not None: self.stack.append(tag)
    def handle_endtag(self,tag):
        if self.cur is not None:
            if tag=='span' and len(self.stack)==1 and self.stack[-1]=='src':
