from html.parser import HTMLParser
from pathlib import Path
class P(HTMLParser):
    def __init__(self): super().__init__(); self.stack=[]; self.rows=[]
    def handle_starttag(self, tag, attrs):
        a=dict(attrs); classes=a.get('class','').split()
        if tag=='span' and 'src-cell' in classes: self.stack.append({'depth':1,'ref':a.get('data-excel-ref',''),'sheet':a.get('data-excel-sheet',''),'line':self.getpos()[0],'text':[]})
        elif self.stack:
            self.stack[-1]['depth']+=1
            if tag=='br': self.stack[-1]['text'].append(' / ')
    def handle_startendtag(self, tag, attrs):
        if self.stack and tag=='br': self.stack[-1]['text'].append(' / ')
    def handle_data(self,data):
        if self.stack: self.stack[-1]['text'].append(data)
    def handle_endtag(self,tag):
        if self.stack:
            self.stack[-1]['depth']-=1
            if self.stack[-1]['depth']==0:
                x=self.stack.pop(); x['text']=' '.join(''.join(x['text']).split()); self.rows.append(x)
p=Path('/home/y-saito/Developments/hareruya-design-docs/excel_to_html/output/0209_基本設計仕様書(基本情報設定).html'); h=P(); h.feed(p.read_text())
