from html.parser import HTMLParser
from pathlib import Path
class P(HTMLParser):
 def __init__(self): super().__init__(); self.tags=[]; self.caps=[]; self.rows=[]; self.sections=[]
 def handle_starttag(self,t,a):
  d=dict(a); self.tags.append(t)
  if t=='section' and d.get('id','').startswith('sheet-'): self.sections.append((len(self.tags),d['id']))
  if 'data-excel-ref' in d:
   self.caps.append({'level':len(self.tags),'ref':d['data-excel-ref'],'section':self.sections[-1][1] if self.sections else '', 'line':self.getpos()[0], 'text':[]})
 def handle_startendtag(self,t,a): pass
 def handle_data(self,d):
  for c in self.caps: c['text'].append(d)
 def handle_endtag(self,t):
  level=len(self.tags)
  done=[c for c in self.caps if c['level']==level]
  for c in done:
   c['text']=' '.join(''.join(c['text']).split()); self.rows.append(c); self.caps.remove(c)
  if self.sections and self.sections[-1][0]==level: self.sections.pop()
  if self.tags: self.tags.pop()
def run(path, groups):
 h=P(); h.feed(Path(path).read_text())
 for section,terms in groups.items():
  rows=[r for r in h.rows if r['section']==section and r['text']]
  print('###',section,'elements',len(rows))
  for term in terms:
   hits=[]; seen=set()
   for r in rows:
    if term.lower() in r['text'].lower():
     key=(r['ref'],r['text'])
     if key not in seen: hits.append(r); seen.add(key)
   print(f'[{term}] {len(hits)}')
   for r in hits[:5]: print(' ',r['line'],r['ref'],r['text'][:350])
