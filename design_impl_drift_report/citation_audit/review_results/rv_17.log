from html.parser import HTMLParser
from pathlib import Path
class P(HTMLParser):
    def __init__(self):
        super().__init__(); self.stack=[]; self.rows=[]
    def handle_starttag(self, tag, attrs):
        a=dict(attrs); classes=a.get('class','').split()
        if tag=='span' and 'src-cell' in classes:
            self.stack.append({'tag':tag,'depth':1,'ref':a.get('data-excel-ref',''),'sheet':a.get('data-excel-sheet',''),'line':self.getpos()[0],'text':[]})
        elif self.stack:
            self.stack[-1]['depth']+=1
            if tag=='br': self.stack[-1]['text'].append(' / ')
    def handle_startendtag(self, tag, attrs):
        if self.stack and tag=='br': self.stack[-1]['text'].append(' / ')
    def handle_data(self, data):
        if self.stack: self.stack[-1]['text'].append(data)
    def handle_endtag(self, tag):
        if self.stack:
            self.stack[-1]['depth']-=1
            if self.stack[-1]['depth']==0:
                x=self.stack.pop(); x['text']=' '.join(''.join(x['text']).split()); self.rows.append(x)
p=Path('/home/y-saito/Developments/hareruya-design-docs/excel_to_html/output/0210_基本設計仕様書(コンテンツ管理).html')
h=P(); h.feed(p.read_text())
queries={
'ページ管理(一覧)':['ドロップダウン','レイアウト編集','ページ編集','削除','操作','メニュー','レイアウト名'],
'ブロック管理(一覧)':['403','404','アクセス拒否','アクセスできない','削除不可','編集不可','編集できない','対象ブロック','存在しない','見つからない'],
'ブロック管理(登録・編集)':['403','404','アクセス拒否','アクセスできない','削除不可','編集不可','編集できない','対象ブロック','存在しない','見つからない'],
'支店トップページ管理':['toppage_management','integration','GET','POST','302','リダイレクト','id','ID','支店選択','支店を選択','読み込み','遷移','編集画面','register','登録','成功','失敗','同一画面','エラー','未設定','補完','空','不足','初期化','フロント','表示時','4個','4枠','上段左','上段右','下段左','下段右','タイル位置']}
for sheet, terms in queries.items():
    rows=[r for r in h.rows if r['sheet']==sheet]
    print(f'### {sheet} cells={len(rows)}')
