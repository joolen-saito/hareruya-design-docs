<script>
    $(function() {
        eccube.setModeAndSubmitBanner = function(mode, keyname, keyid) {
            document.hareruyaec_banner.mode.value = mode;
            if (keyname !== undefined && keyname !== "" && keyid !== undefined && keyid !== "") {
                document.hareruyaec_banner[keyname].value = keyid;
            }

            // 並び順が被りなく設定されているかの判定。
            var sortNoValues = [];
            var isEmpty = false;

            $('[id^="hareruyaec_banner_sort_no_"]').each(function(index) {
                if ($.trim($(this).val()).length === 0) {
                    alert('並び順が空フォームがあります。');
                    isEmpty = true;
                    return false;
                }
                sortNoValues.push(parseInt($(this).val()));
            });

            if (isEmpty) {
                return;
            }

            var duplications = sortNoValues.filter(function (x, i, self) {
                return self.indexOf(x) === i && i !== self.lastIndexOf(x);
            });

            if (duplications.length > 0) {
                alert('同じ並び順があります(' + duplications.join(',') + ')');
                return
            }

            document.hareruyaec_banner.submit();
        };

    });
</script>
