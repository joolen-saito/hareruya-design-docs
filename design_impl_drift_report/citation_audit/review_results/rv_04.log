    40	
    24	    /**
    25	     * Retry the linkage of an order where the Smaregi linkage failed
    26	     */
    27	    public function execute()
    28	    {
    29	        $app = $this->app;
    30	
    31	        $orders = $app['hareruya_ec.repository.order_sub']->getSmaregiErrorOrder();
    32	
    33	        foreach ($orders as $order) {
    34	            $orderSub = $order['orderSub'];
    35	            $player = $order['player'];
    36	            $response = $app['hareruya_ec.service.smaregi_customer']->postSmaregiPoint($player->getSmaregiId(), $player->getPoint(), true);
    37	            if (array_key_exists('result', $response)) {
    38	                $orderSub->setSmaregiErrorFlg(false);
    39	            } else {
    40	                $orderSub->setPointErrorMessage(json_encode($response, JSON_UNESCAPED_UNICODE));
    41	            }
    42	            $app['orm.em']->persist($orderSub);
