    /**
     * 削除
     * @param Application $app
     * @param Request $request
     * @param string $formatId
     * @return \Symfony\Component\HttpFoundation\Response
     */
    public function delete(Application $app, Request $request, $formatId)
    {
        $this->checkCsrfValid($app);

        if (is_null($format = $app['hareruya_ec.repository.format']->find($formatId))) {
            // DBに見つからない場合はエラーとする
            return $app->abort(404);
        }
        // 大会・デッキ・アーキタイプで使用されているなら削除不可とする
        if (!$format->getEvents()->isEmpty() || !$format->getDecks()->isEmpty() || !$format->getArchetypes()->isEmpty()) {
            $app->addError('admin.format.error.delete.event', 'admin');

            return $app->redirect($request->headers->get('referer'));
        }

        // 禁止・制限情報の削除
        foreach($format->getCardFormats() as $cardFormat) {
            $app['orm.em']->remove($cardFormat);
        }

        // フォーマットの削除
        $app['orm.em']->remove($format);
        $app['orm.em']->flush();
        $app->addSuccess('admin.delete.complete', 'admin');

        return $app->redirect($app->url('admin_format_list'));
    }

