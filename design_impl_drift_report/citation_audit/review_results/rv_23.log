namespace Plugin\HareruyaEc\Form\Type\Admin\Archetype;

use Symfony\Component\Form\AbstractType;
use Symfony\Component\Form\Extension\Core\Type;
use Symfony\Component\Form\FormBuilderInterface;
use Symfony\Component\Validator\Constraints as Assert;
use Doctrine\ORM\EntityRepository;
use Symfony\Component\OptionsResolver\OptionsResolver;

class SearchArchetypeType extends AbstractType
{
    private $config;

    public function __construct($app)
    {
        $this->app = $app;
    }

    public function configureOptions(OptionsResolver $resolver)
    {
        $resolver->setDefaults([
            // disable CSRF protection for this form
            'csrf_protection' => false,
        ]);
    }

    /**
     * {@inheritdoc}
     */
    public function buildForm(FormBuilderInterface $builder, array $options)
    {
        $config = $this->app['config'];

        $builder
            ->add('multi', 'text',
                [
                    'label' => 'form.card.multi.label',
                    'required' => false,
                    'constraints' => [
                        new Assert\Length(['max' => $config['stext_len']]),
                    ],
                ]
            )
            ->add('colors', 'entity',
                [
                    'label' => 'form.color.label',
                    'required' => false,
                    'expanded' => true,
                    'multiple' => true,
                    'empty_value' => false,
                    'class' => 'Plugin\HareruyaEc\Entity\MtbColor',
                ]
            )
            ->add('format', 'entity',
                [
                    'label' => 'form.format.label',
                    'required' => false,
                    'query_builder' => function (EntityRepository $er) {
                        return $er->createQueryBuilder('f')
                            ->orderBy('f.rank', 'ASC')
                            ->addOrderBy('f.id', 'ASC');
                    },
                    'expanded' => false,
                    'multiple' => true,
                    'class' => 'Plugin\HareruyaEc\Entity\MtbFormat',
                ]
            )
            ->add('deckTags', 'entity',
                [
                    'label' => 'form.deck_tag.label',
                    'required' => false,
                    'expanded' => false,
                    'multiple' => true,
                    'class' => 'Plugin\HareruyaEc\Entity\MtbDeckTag',
                ]
            )
            ->add('oldArchetypeId', 'text',
                [
                    'label' => 'form.archetype.old_archetype_id.label',
                    'required' => false,
                ]
            )
            ;
    }

    /**
     * {@inheritdoc}
     */
    public function getName()
    {
        return 'admin_search_archetype';
    }
}

