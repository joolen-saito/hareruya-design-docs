{% extends 'default_frame.twig' %}

{% set menus = ['card_menu', 'format_list'] %}

{% block title %}フォーマット管理{% endblock %}
{% block sub_title %}
フォーマット一覧
<div style="float: right">
    <a href="{{ url('admin_format_new') }}">
        <input type="button" class="btn btn-primary btn-sm btn-new" value="新規登録">
    </a>
</div>
{% endblock %}

{% block stylesheet %}
<link rel="stylesheet" href="{{ app.config.root_urlpath }}/admin/assets/css/format.css">
{% endblock %}

{% block main %}
<div class="row" id="aside_wrap">
    <div class="box">
        <div class="box-body form-horizontal">
            <div id="result_list" class="row">
                <div class="col-md-12">
                    <div id="result_list__list" class="item_list">
                        <div class="tableish tableish-striped">
                            <table class="table table-striped">
                                <thead><tr>
                                    <th>フォーマット名</th>
                                    <th>略称</th>
                                    <th>認定</th>
                                    <th>&nbsp;</th>
                                </tr></thead>
                                <tbody>
                                {% for format in formats %}
                                    <tr>
                                        <td>
                                            <a href="{{ url('admin_format_edit', {'formatId':format.id}) }}">{{ format.nameJp }} / {{ format.nameEn }}</a>
                                        </td>
                                        <td>
                                            {{ format.code }}
                                        </td>
                                        <td>
                                        {% if format.certificationId is not null %}
                                            {{ format.certification.nameJp }} / {{ format.certification.nameEn }}
                                        {% endif %}
                                        </td>
                                        <td class="icon_edit">
                                            <div class="dropdown">
                                                <a class="dropdown-toggle" data-toggle="dropdown" aria-expanded="false"><svg class="cb cb-ellipsis-h"> <use xlink:href="#cb-ellipsis-h" /></svg></a>
                                                <ul class="dropdown-menu dropdown-menu-right">
                                                    <li><a href="{{ url('admin_format_edit', {formatId: format.id}) }}" >編集</a></li>
                                                    <li><a href="{{ url('admin_format_delete', {formatId: format.id}) }}" {{ csrf_token_for_anchor() }} data-method="delete" data-message="{{ trans('admin.confirm.delete')|format(format) }}">削除</a></li>
                                                </ul>
                                            </div>
                                        </td>
                                    </tr>
                                {% endfor %}
                                </tbody>
                            </table>
                        </div>
                    </div><!-- /.box -->
