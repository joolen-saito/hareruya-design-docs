     * @param Request $request
     * @return \Symfony\Component\HttpFoundation\Response
     */
    public function searchMainCardHtml(Application $app, Request $request, $page_no = null)
    {
        $pageNo = $page_no;
        $session = $request->getSession();
        $data = [];
        $pagination = [];
        if ($request->isXmlHttpRequest()) {
            $pageCount = $app['config']['default_page_count'];
            // フォーム取得
            $builder = $app['form.factory']->createBuilder('admin_search_card');
            // 検索ボタンから遷移
            if ('POST' === $request->getMethod()) {
                $pageNo = 1;
                $searchData = [
                    'multi' => $request->get('search_word'),
                    'cardName' => $request->get('search_name'),
                    'perfectMatch' => $request->get('perfect_match'),
                    'cardText' => $request->get('search_text'),
                ];
                // Sessionに追加
                $session->set('admin.archetype.main_card.search', $searchData);
                $session->set('admin.archetype.main_card.search.page_no', $pageNo);
            // ページ番号からの遷移
            } else {
                $searchData = (array)$session->get('admin.archetype.main_card.search');
                // ページ番号が取得できない場合Sessionから取得
                if (is_null($pageNo)) {
                    $pageNo = intval($session->get('admin.archetype.main_card.search.page_no'));
                } else {
                    $session->set('admin.archetype.main_card.search.page_no', $pageNo);
                }
            }

            // 代表カード検索
            $qb = $app['hareruya_ec.repository.card_image']->getCardImagesBySearchData($searchData);
            $pagination = $app['paginator']()->paginate(
                $qb,
                $pageNo,
                $pageCount,
                ['wrap-queries' => true]
            );
        }

    <div class="modal-dialog modal-lg">
        <div id="search_Main_Card_modal_box" class="modal-content">
            <div id="search_Main_Card_modal_box__header" class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-label="Close"><span class="modal-close" aria-hidden="true">&times;</span></button>
                <h4 class="modal-title" id="myModalLabel">代表カード検索</h4>
            </div>
            <div id="search_Main_Card_modal_box__body" class="modal-body">
                <div class="form-group">
                    {{ form_widget(mainCardModalForm.card_name) }}
                    {{ form_widget(mainCardModalForm.perfect_match) }}
                </div>
                <div class="form-group">
                    {{ form_widget(mainCardModalForm.card_text) }}
                </div>
                <div id="search_Main_Card_modal_box__button_search" class="col-xs-8 col-xs-offset-2 col-sm-4 col-sm-offset-4 text-center form-group modal_search">
                    <button type="button" id="searchMainCardModalButton" class="btn btn-primary btn-block btn-lg" data-url="{{ url('admin_archetype_main_card_html') }}"> 検索する <svg class="cb cb-angle-right"><use xlink:href="#cb-angle-right"></svg></button>
                </div>
                <div class="form-group" id="searchMainCardModalList">
                </div>
            </div>
        </div>
    </div>
</div>

{% endblock modal %}
{% block javascript %}
<script src="{{ app.config.root_urlpath }}/admin/assets/js/card-image.js"></script>
{% endblock javascript %}
<div class="table-responsive">
    {% if pagination.totalItemCount > 0 %}
    <table class="table">
        <thead>
            <tr id="search_main_card_modal_box__body_inner_header">
                <th>ID</th>
                <th>カード名</th>
                <th>画像</th>
                <th>決定</th>
            </tr>
        </thead>
        <tbody>
            {% for data in pagination.getItems %}
                <tr>
                    <td>
                        {{ data.getId }}
                    </td>
                    <td>
                        {{ data.getCardDetail.getCard.getMixName }}
                    </td>
                    <td>
                        <img src='{{ image_path(data.getUrl) }}' width="200px" />
                    </td>
                    <td class="column_set">
                        <button type="button" class="btn btn-default btn-sm set-main-card" data-image="{{ data.getId }}" data-root="{{ image_path() }}" data-url="{{ url('admin_archetype_search_main_card_by_id') }}">決定</button>
                    </td>
                </tr>
            {% endfor %}
        </tbody>
    </table>
        {% include "pager.twig" with {'id': 'main_card_pagination', 'pages': pagination.paginationData, 'routes': 'admin_archetype_main_card_html_page'} %}
    {% else %}
    <div id="result_list_main__header" class="box-header with-arrow">
        <h3 class="box-title">検索条件に該当するデータがありませんでした。</h3>
    </div>
    {% endif %}
</div>

