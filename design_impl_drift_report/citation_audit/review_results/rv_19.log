/bin/bash -lc "python3 - <<'PY'
from html.parser import HTMLParser
from pathlib import Path
class X(HTMLParser):
    def __init__(self, targets):
        super().__init__(convert_charrefs=True); self.targets=set(targets); self.cur=None; self.depth=0; self.capture=[]; self.out=[]
    def handle_starttag(self, tag, attrs):
        a=dict(attrs)
        if self.cur is None and a.get('id') in self.targets:
            self.cur=a['id']; self.depth=1
        elif self.cur is not None:
            self.depth += 1
        ref=a.get('data-excel-ref')
        if self.cur and ref:
