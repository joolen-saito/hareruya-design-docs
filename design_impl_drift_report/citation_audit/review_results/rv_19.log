class P(HTMLParser):
  void={'area','base','br','col','embed','hr','img','input','link','meta','param','source','track','wbr'}
  def __init__(self,sheets): super().__init__(convert_charrefs=True); self.sheets=set(sheets); self.level=0; self.caps=[]; self.out=[]
  def handle_starttag(self,tag,attrs):
    a=dict(attrs)
    if a.get('data-excel-sheet') in self.sheets and a.get('data-excel-ref'): self.caps.append([tag,self.level,a['data-excel-sheet'],a['data-excel-ref'],[]])
    if tag not in self.void:self.level+=1
  def handle_data(self,d):
    for c in self.caps:c[4].append(d)
  def handle_endtag(self,tag):
    if tag not in self.void:self.level-=1
    for i in range(len(self.caps)-1,-1,-1):
      c=self.caps[i]
      if c[0]==tag and c[1]==self.level:
        self.out.append((c[2],c[3],' '.join(''.join(c[4]).split())));self.caps.pop(i);break
