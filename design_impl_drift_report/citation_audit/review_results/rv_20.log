    /**
     * イベント登録、更新
     * @param Application $app
     * @param Request $request
     * @return \Symfony\Component\HttpFoundation\Response
     */
    public function bulkUpdate(Application $app, Request $request)
    {
        $builder = $app['form.factory']->createBuilder('admin_entry_bulk_update');
        $form = $builder->getForm();
        $form->handleRequest($request);
        if (!$request->isXmlHttpRequest()) {
            return $app->json(['message'=> $app->trans('admin.register.failed')]);
        }
        if (!$this->isFormValid($app, $form)) {
            $errors = [];
            foreach ($form->getErrors(true) as $error) {
                $errors[] = $error->getMessage();
            }

            return $app->json(['message'=> $errors]);
        }

        // ページ分割
        foreach ($eventDecks as $deck) {
            $dispDecks[$i] = [];

            $deckText = [
                'main' => CardUtil::decodeCardlist($app, $deck->getTextMain()),
                'side' => CardUtil::decodeCardlist($app, $deck->getTextSide()),
            ];

            $mainCount = array_sum(array_column($deckText['main'], 'count'));
            $sideCount = array_sum(array_column($deckText['side'], 'count'));

            // １ページ分で分割
            $chunks = array_chunk($deckText['main'], 40);
            $j = 0;
            foreach ($chunks as $chunk) {
                // サイドボードを1ページ目にあれば設定
                if ($j === 0 && 0 < count($deckText['side'])) {
                    $dispDecks[$i][$j]['deck']['side'] = $deckText['side'];
                } else {
                    $dispDecks[$i][$j]['deck']['side'] = [];
                }
                $dispDecks[$i][$j]['player'] = trim($deck->getPlayerName()) ?: $deck->getPlayer()->getCustomer()->getKana01() . ' ' . $deck->getPlayer()->getCustomer()->getKana02();
                $dispDecks[$i][$j]['dciNo'] = $deck->getPlayer()->getDciNo();
                $dispDecks[$i][$j]['detail'] = $deck->getEventDetail();
                $dispDecks[$i][$j]['deck']['main'] = $chunk;
                $dispDecks[$i][$j]['count']['main'] = $mainCount;
                $dispDecks[$i][$j++]['count']['side'] = $sideCount;
            }
            $i++;
        }

        return $app->render('HareruyaEc/Resource/template/admin/Entry/decklist.twig', [
            'dispDecks' => $dispDecks,
        ]);
