exec
/bin/bash -lc "html='hareruya-design-docs/excel_to_html/output/0214_基本設計仕様書(イベント管理).html'
for spec in \\
'sheet-7|schedule/new|admin_schedule_new|GET|POST|ルート|画面遷移|日程追加' \\
'sheet-8|repeatschedule|admin_repeat_schedule_new|GET|POST|支払い方法|支払方法|決済|申込受付不可|エラー|admin.schedule' \\
'sheet-9|duplicateId|admin_event_duplicate|/duplicate|GET|URL|bind|1以上|正の整数|複製元' \\
'sheet-12|isXmlHttpRequest|XHR|Ajax|非同期|同期|JSON|失敗メッセージ|エラー' \\
'sheet-13|40枚|1ページ40|array_chunk|先頭ページ|サイドボード|sideboard|メイン|サイド|枚数|合計|見出し' \\
'sheet-16|entry/search/event/id|イベントID|直接検索|指定ID|非同期|XHR|Ajax|空の検索結果|モーダル枠' \\
'sheet-17|entry/search/event/html|entry/search/event/id|POST|GET|非同期|XHR|Ajax|空の検索結果|モーダル枠'; do
  IFS='|' read -r -a parts <<< \""'$spec"
  sheet="${parts[0]}"
  for ((i=1;i<${#parts[@]};i++)); do
    term="${parts[$i]}"
    count=$(python3 /tmp/rv20_extract.py "$html" "$sheet" "$term" | wc -l)
    printf '"'%s\\t%s\\t%s\\n' \""'$sheet" "$term" "$count"
  done
done' in /home/y-saito/Developments
