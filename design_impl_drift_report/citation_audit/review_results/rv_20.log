+from html.parser import HTMLParser
+from pathlib import Path
+import re
+import sys
+
+
+class ExcelCellParser(HTMLParser):
+    def __init__(self):
+        super().__init__(convert_charrefs=True)
+        self.sheet = None
+        self.in_embed = False
+        self.stack = []
+        self.cells = []
+        self.current = None
+
+    def handle_comment(self, data):
+        if "function-design-embed:start" in data:
+            self.in_embed = True
+        elif "function-design-embed:end" in data:
+            self.in_embed = False
+
+    def handle_starttag(self, tag, attrs):
+        attrs = dict(attrs)
+        if tag not in {"br", "img", "meta", "link", "input", "hr", "source"}:
+            self.stack.append(tag)
+        if tag == "section" and attrs.get("id", "").startswith("sheet-"):
+            self.sheet = attrs["id"]
+        classes = attrs.get("class", "").split()
+        if (
+            not self.in_embed
+            and "src-cell" in classes
+            and attrs.get("data-excel-ref")
+        ):
+            self.current = {
+                "sheet": self.sheet,
+                "ref": attrs["data-excel-ref"],
+                "text": [],
+                "depth": len(self.stack),
+            }
+
+    def handle_endtag(self, tag):
+        if self.current and len(self.stack) == self.current["depth"]:
+            self.current["text"] = " ".join(
+                "".join(self.current["text"]).split()
+            )
+            self.cells.append(self.current)
+            self.current = None
+        if self.stack:
+            self.stack.pop()
+
+    def handle_data(self, data):
+        if self.current:
+            self.current["text"].append(data)
+
+
+path = Path(sys.argv[1])
+sheets = set(sys.argv[2].split(","))
+patterns = [re.compile(term, re.I) for term in sys.argv[3:]]
+parser = ExcelCellParser()
+parser.feed(path.read_text(encoding="utf-8"))
+for cell in parser.cells:
+    if cell["sheet"] not in sheets:
+        continue
+    if patterns and not any(pattern.search(cell["text"]) for pattern in patterns):
+        continue
+    print(f'{cell["sheet"]}\t{cell["ref"]}\t{cell["text"]}')

