    87	    public function getFormatCardListNativeQuery(int $formatId): iterable
    88	    {
    89	        $sql = <<<EOT
    90	            SELECT
    91	                c.name_jp,
    92	                c.name_en
    93	            FROM
    94	                mtb_format f
    95	            INNER JOIN
    96	                dtb_card_format cf ON cf.format_id = f.id
    97	            INNER JOIN
    98	                mtb_card c ON c.id = cf.card_id
    99	            WHERE
   100	                f.id = :formatId
   101	EOT;
   102	
   103	        $rsm = new ResultSetMapping();
   104	        $rsm->addScalarResult('name_jp', 'name_jp');
   105	        $rsm->addScalarResult('name_en', 'name_en');
   106	
   107	        $query = $this->getEntityManager()
   108	            ->createNativeQuery($sql, $rsm)
   109	            ->setParameter('formatId', $formatId);
   110	
   111	        return $query->toIterable();
   112	    }
   113	
   114	    /**
   115	     * 実 DtbEvent に 1 件以上 設定 されている format のみ id ASC で 取得する。
   116	     *
   117	     * @return list<MtbFormat>
   118	     */
   119	    public function getFormatsAssignedToEvents(): array
   120	    {
   121	        /** @var list<MtbFormat> $formats */
   122	        $formats = $this->createQueryBuilder('f')
   123	            ->innerJoin('f.Events', 'e')
   124	            ->andWhere('e.deletedAt IS NULL')
   125	            ->groupBy('f.id')
   126	            ->orderBy('f.id', 'ASC')
   127	            ->getQuery()
   128	            ->getResult();
   129	
   130	        return $formats;
   131	    }
   132	}

