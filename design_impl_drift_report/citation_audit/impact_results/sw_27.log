   794	     * デッキCSV出力.
   795	     */
   796	    #[Route('/%eccube_admin_route%/deck/csv_export', name: 'admin_deck_csv_export', methods: ['POST'])]
   797	    public function csvExport(Request $request): StreamedResponse|RedirectResponse
   798	    {
   799	        $token = $request->request->get('_token');
   800	        if (!$this->isCsrfTokenValid('admin_deck_csv_export', $token)) {
   801	            $this->addError('admin.common.csrf_invalid', 'admin');
   802	
   803	            return $this->redirectToRoute('admin_deck_list');
   804	        }
   805	
   806	        $pageNo = $this->session->get($this->sessionKey.'.page_no', 1);
   807	
   808	        /** @var array<int, string> $rawDeckIds */
   809	        $rawDeckIds = $request->request->all('deckId');
   810	        $deckIds = array_values(array_unique(array_filter(array_map('intval', $rawDeckIds), fn (int $id): bool => $id > 0)));
   811	
   812	        if ($deckIds === []) {
   813	            $this->addError('admin.deck.csv_export_no_selection', 'admin');
   814	
   815	            return $this->redirectToRoute('admin_deck_search', ['page_no' => $pageNo]);
   816	        }
   817	
   818	        if ($this->deckRepository->findByDeckIds($deckIds) === []) {
   819	            $this->addError('admin.deck.csv_export_no_selection', 'admin');
   820	
   821	            return $this->redirectToRoute('admin_deck_search', ['page_no' => $pageNo]);
   822	        }
   823	
   824	        $event = new EventArgs([], $request);
   825	        $this->eventDispatcher->dispatch($event, EccubeEvents::ADMIN_DECK_CSV_EXPORT);
   826	
   827	        return $this->deckCsvExporterService->exportByIds('deck', $deckIds);
   828	    }
