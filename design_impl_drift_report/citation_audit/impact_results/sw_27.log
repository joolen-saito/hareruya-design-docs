   432	    #[Route('/%eccube_admin_route%/deck/{id}/copy', name: 'admin_deck_copy', methods: ['POST'])]
   433	    public function copy(Request $request, DtbDeck $Deck): RedirectResponse
   434	    {
   435	        if (!$this->isCsrfTokenValid('admin_deck_copy', $request->request->get('_token'))) {
   436	            $this->addError('admin.common.csrf_invalid', 'admin');
   437	
   438	            return $this->redirectToRoute('admin_deck_edit', ['id' => $Deck->getId()]);
   439	        }
   440	
   441	        $copyForm = $this->createForm(DeckCopyType::class);
   442	        $copyForm->handleRequest($request);
   443	
   444	        if (!$copyForm->isSubmitted() || !$copyForm->isValid()) {
   445	            $this->addError('admin.common.save_error', 'admin');
   570	        $searchWord = $request->request->getString('search_word');
   571	        $shopId = $request->request->getString('shop_id');
   572	        $page = $request->request->getInt('page', 1);
   573	        $limit = 10;
   574	
   575	        $qb = $this->entityManager->createQueryBuilder()
   576	            ->select('ed.id AS eventDetailId', 'e.id AS eventId', 'e.nameJp', 'e.nameEn', 'ed.startDate')
   577	            ->from(\Eccube\Entity\DtbEventDetail::class, 'ed')
   578	            ->join('ed.Event', 'e')
   579	            ->orderBy('e.id', 'DESC')
   580	            ->addOrderBy('ed.startDate', 'DESC');
   581	
   582	        if (!empty($searchWord)) {
   583	            $qb->andWhere('e.nameJp LIKE :word OR e.nameEn LIKE :word')
   584	                ->setParameter('word', '%'.$searchWord.'%');
   585	        }
   586	
   587	        if (!empty($shopId)) {
   588	            $qb->andWhere('e.BaseInfo = :shopId')
   589	                ->setParameter('shopId', (int) $shopId);
   590	        }
   591	
   592	        $from = $request->request->getString('from');
   593	        $to = $request->request->getString('to');
   594	        if (!empty($from)) {
   595	            $qb->andWhere('ed.startDate >= :from')->setParameter('from', $from);
   596	        }
   597	        if (!empty($to)) {
   598	            $qb->andWhere('ed.startDate <= :to')->setParameter('to', $to.' 23:59:59');
   599	        }
   600	
   601	        $event = new EventArgs(
   602	            [
   603	                'qb' => $qb,
   604	            ],
   605	            $request
   606	        );
   607	        $this->eventDispatcher->dispatch($event, EccubeEvents::ADMIN_DECK_EVENT_SEARCH);
   608	
   609	        $countQb = clone $qb;
   610	        $countQb->select('COUNT(ed.id)')->resetDQLPart('orderBy');
   611	        $totalCount = (int) $countQb->getQuery()->getSingleScalarResult();
   612	        $totalPages = (int) ceil($totalCount / $limit);
   613	
   614	        $qb->setFirstResult(($page - 1) * $limit)
   615	            ->setMaxResults($limit);
   616	
   617	        $results = $qb->getQuery()->getResult();
   618	        $data = [];
   619	        foreach ($results as $row) {
   620	            $data[] = [
   621	                'eventDetailId' => $row['eventDetailId'],
   622	                'eventId' => $row['eventId'],
   623	                'nameJp' => $row['nameJp'],
   624	                'nameEn' => $row['nameEn'] ?? '',
   625	                'startDate' => $row['startDate']->format('Y/m/d H:i'),
   626	                'rowSpan' => 0,
   627	            ];
   628	        }
   629	
   630	        // 同 eventId 連続行をまとめるための rowSpan 計算（先頭行に行数を設定）
   631	        $previousEventId = null;
   632	        $headIndex = -1;
   633	        foreach ($data as $i => $row) {
   634	            if ($row['eventId'] === $previousEventId) {
   635	                $data[$headIndex]['rowSpan']++;
   636	            } else {
   637	                $headIndex = $i;
   638	                $data[$headIndex]['rowSpan'] = 1;
   639	                $previousEventId = $row['eventId'];
   640	            }
   641	        }
   642	
   643	        return new JsonResponse([
   644	            'items' => $data,
   645	            'totalCount' => $totalCount,
   646	            'page' => $page,
   647	            'totalPages' => $totalPages,
   648	        ]);
   649	    }
