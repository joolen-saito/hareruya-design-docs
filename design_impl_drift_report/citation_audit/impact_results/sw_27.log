   105	                'label' => 'admin.deck.private_flg',
   106	                'required' => false,
   107	                'multiple' => true,
   108	                'expanded' => true,
   109	            ])
   110	            ->add('event_date_from', DateType::class, [
   111	                'label' => 'admin.deck.event_date',
   112	                'required' => false,
   113	                'input' => 'datetime',
   114	                'widget' => 'single_text',
   115	                'data' => (new \DateTime())->modify('-3 months')->setTime(0, 0),
   116	                'attr' => ['class' => 'datetimepicker-input', 'data-bs-toggle' => 'datetimepicker'],
   117	            ])
   118	            ->add('event_date_to', DateType::class, [
   119	                'label' => false,
   120	                'required' => false,
   121	                'input' => 'datetime',
   122	                'widget' => 'single_text',
   123	                'attr' => ['class' => 'datetimepicker-input', 'data-bs-toggle' => 'datetimepicker'],
   124	            ])
   125	            ->add('event_name', TextType::class, [
   126	                'label' => 'admin.deck.event_name',
   127	                'required' => false,
   128	                'constraints' => [
   129	                    new Assert\Length(['max' => $this->eccubeConfig['eccube_stext_len']]),
   130	                ],
   131	            ])
   132	            ->add('ranking_from', IntegerType::class, [
   133	                'label' => 'admin.deck.ranking',
   134	                'required' => false,
   135	                'attr' => ['min' => 1],
   136	            ])
   137	            ->add('ranking_to', IntegerType::class, [
   138	                'label' => false,
   139	                'required' => false,
   140	                'attr' => ['min' => 1],
   141	            ])
   142	            ->add('result', TextType::class, [
   143	                'label' => 'admin.deck.result',
   144	                'required' => false,
   145	                'constraints' => [
   146	                    new Assert\Length(['max' => $this->eccubeConfig['eccube_stext_len']]),
