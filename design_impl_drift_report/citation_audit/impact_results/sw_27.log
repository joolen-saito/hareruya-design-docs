   379	            'copyForm' => $copyForm !== null ? $copyForm->createView() : null,
   380	            'Deck' => $Deck,
   381	            'isNew' => $isNew,
   382	            'shops' => $shops,
   383	        ];
   384	    }
   385	
   386	    /**
   387	     * デッキ個別削除.
   388	     */
   389	    #[Route('/%eccube_admin_route%/deck/{id}/delete', name: 'admin_deck_delete', methods: ['POST'])]
   390	    public function delete(Request $request, DtbDeck $Deck): RedirectResponse
   391	    {
   392	        $token = $request->request->get('_token');
   393	        if (!$this->isCsrfTokenValid('admin_deck_delete', $token)) {
   394	            $this->addError('admin.common.csrf_invalid', 'admin');
   395	
   396	            return $this->redirectToRoute('admin_deck_list');
   397	        }
   398	
   399	        $User = $this->getUser();
   400	        $Member = $User instanceof \Eccube\Entity\Member ? $User : null;
   401	        $input = new DeckBulkDeleteInput([(string) $Deck->getId()], $Member);
   402	
   403	        try {
   404	            $this->bulkDeleteAction->handle($input);
   405	        } catch (\RuntimeException $e) {
   406	            $this->addError($e->getMessage(), 'admin');
   407	
   408	            return $this->redirectToRoute('admin_deck_edit', ['id' => $Deck->getId()]);
   409	        } catch (\Exception $e) {
   410	            log_error('デッキ削除エラー', ['message' => $e->getMessage()]);
   660	        $page = $request->request->getInt('page', 1);
   661	        $limit = 10;
   662	
   663	        $qb = $this->entityManager->createQueryBuilder()
   664	            ->select('ci.id', 'ci.url', 'c.name_jp', 'c.name_en')
   665	            ->from(\Eccube\Entity\Master\MtbCardImage::class, 'ci')
   666	            ->join('ci.CardDetail', 'cd')
   667	            ->join('cd.Card', 'c')
   668	            ->andWhere('ci.back_flg = false');
   669	
   670	        if (!empty($searchWord)) {
   671	            if ($exactMatch) {
   672	                $qb->andWhere('c.name_jp = :word OR c.name_en = :word')
   673	                    ->setParameter('word', $searchWord);
   674	            } else {
   675	                $words = preg_split('/[\s\x{3000},,]+/u', $searchWord, -1, PREG_SPLIT_NO_EMPTY) ?: [];
   676	                foreach ($words as $i => $word) {
   677	                    $param = 'word_'.$i;
   678	                    $qb->andWhere(sprintf('c.name_jp LIKE :%1$s OR c.name_en LIKE :%1$s', $param))
   679	                        ->setParameter($param, '%'.$word.'%');
   680	                }
   681	            }
   682	        }
   683	
   684	        if (!empty($cardText)) {
   685	            $textWords = preg_split('/[\s\x{3000},,]+/u', $cardText, -1, PREG_SPLIT_NO_EMPTY) ?: [];
   686	            foreach ($textWords as $i => $textWord) {
   687	                $param = 'cardText_'.$i;
   688	                $qb->andWhere(sprintf('c.text_jp LIKE :%1$s OR c.text_en LIKE :%1$s', $param))
   689	                    ->setParameter($param, '%'.$textWord.'%');
   690	            }
   691	        }
   692	
   693	        $event = new EventArgs(
   694	            [
   695	                'qb' => $qb,
   696	            ],
   697	            $request
   698	        );
   699	        $this->eventDispatcher->dispatch($event, EccubeEvents::ADMIN_DECK_CARD_IMAGE_SEARCH);
   700	
   701	        $countQb = clone $qb;
   702	        $countQb->select('COUNT(ci.id)');
   703	        $totalCount = (int) $countQb->getQuery()->getSingleScalarResult();
   704	        $totalPages = (int) ceil($totalCount / $limit);
   705	
   706	        $qb->setFirstResult(($page - 1) * $limit)
   707	            ->setMaxResults($limit);
   708	
   709	        $results = $qb->getQuery()->getResult();
   710	        $data = [];
   711	        foreach ($results as $row) {
   712	            $data[] = [
   713	                'id' => $row['id'],
   714	                'url' => $row['url'],
   715	                'nameJp' => $row['name_jp'] ?? '',
   716	                'nameEn' => $row['name_en'] ?? '',
   717	            ];
   718	        }
   719	
   720	        return new JsonResponse([
   721	            'items' => $data,
   722	            'totalCount' => $totalCount,
   723	            'page' => $page,
   724	            'totalPages' => $totalPages,
   725	        ]);
     1	{% extends '@admin/default_frame.twig' %}
