    95	                    '%maxRecord%' => static::ADMIN_CSV_IMPORT_MAX_ROWS,
    96	                ]),
    97	            ]);
    98	        }
    99	
   100	        $extension = strtolower($formFile->getClientOriginalExtension());
   101	        if ($extension !== 'csv') {
   102	            return $this->renderWithErrors($form, [$this->translator->trans('admin.common.csv_upload_error')]);
   103	        }
   104	
   105	        $User = $this->getUser();
   106	        if (!$User instanceof Member) {
   107	            return $this->renderWithErrors($form, [$this->translator->trans('admin.common.system_error')]);
   108	        }
   109	
   110	        log_info('admin.deck.csv.import.start');
   111	
   112	        $handler = new DeckUpdateImportHandler(
   113	            $this->entityManager,
   114	            $this->translator,
   115	            $this->deckRepository,
   116	            $this->archetypeRepository,
   117	            $this->eventDetailRepository,
   118	            $this->deckCardRepository,
   119	            $this->cardRepository,
   120	            $this->cardImageRepository,
   121	            $this->deckTypeRepository,
   122	            $this->dispRepository,
   123	            $this->deckTagRepository,
   124	            $this->formatRepository,
   125	            $User,
   126	        );
   127	        $importer = new CsvImporter(
   128	            $this->entityManager,
   129	            $this->translator,
   130	            $this->eccubeConfig,
   131	            $handler,
   132	            $User,
   133	        );
   134	
   135	        try {
   136	            $result = $importer->import($formFile);
   137	        } catch (\Exception $e) {
   138	            return $this->renderWithErrors($form, [$e->getMessage()]);
   139	        }
   140	
   141	        if ($result->hasError()) {
   142	            $errors = array_map(static fn (array $error): string => $error['message'], $result->getErrors());
   143	
   144	            return $this->renderWithErrors($form, $errors);
   145	        }
   146	
   147	        log_info('admin.deck.csv.import.complete');
   148	
   149	        $event = new EventArgs(
   150	            [
   151	                'form' => $form,
   152	            ],
   153	            $request
   154	        );
   155	        $this->eventDispatcher->dispatch($event, EccubeEvents::ADMIN_DECK_CSV_INDEX_COMPLETE);
   156	
   157	        $this->addSuccess('admin.common.csv_upload_complete', 'admin');
   158	
   159	        return $this->redirectToRoute('admin_deck_csv_import');
   160	    }
   161	
   162	    /**
   163	     * @param list<string> $errors
   164	     */
   165	    private function renderWithErrors(FormInterface $form, array $errors): Response
   166	    {
   167	        return $this->render('@admin/Deck/csv_import.twig', [
   168	            'form' => $form->createView(),
   169	            'headers' => $this->getCsvHeader(),
   170	            'errors' => $errors,
   171	        ]);
   172	    }
   173	
   174	    /**
   175	     * @return array<string, string>
   176	     */
   177	    private function getCsvHeader(): array
   178	    {
   179	        return [
   180	            'player_name' => 'プレイヤー名',
   181	            'format' => 'フォーマット',
   182	            'archetype' => 'アーキタイプ',
   183	            'event_detail_id' => 'イベント詳細ID',
   184	            'deck_name' => 'デッキ名',
   185	            'ranking' => '順位',
   186	            'result' => '成績',
   187	            'tags' => 'タグ',
   188	            'event_name_en' => 'イベント名(英)',
   189	            'event_name_jp' => 'イベント名(日)',
   190	            'event_date' => 'イベント開催日',
   191	            'source_url' => '参照元',
   192	            'participants' => 'イベント参加人数',
   193	            'disp_flg' => '表示フラグ',
   194	            'private_flg' => 'デッキリスト非公開フラグ',
   195	            'main_list' => 'メインリスト',
   196	            'side_list' => 'サイドリスト',
   197	            'commander' => '統率者',
   198	            'deck_id' => 'デッキID',
   199	            'image_card_name' => '代表カード名',
   200	        ];
   201	    }
   202	}
     1	{% extends '@admin/default_frame.twig' %}
     2	
     3	{% set menus = ['deck_management', 'deck_list'] %}
     4	
     5	{% block title %}{{ 'admin.deck.csv_upload_title'|trans }}{% endblock %}
     6	{% block sub_title %}{{ 'admin.deck.deck_management'|trans }}{% endblock %}
     7	
     8	{% form_theme form '@admin/Form/bootstrap_4_horizontal_layout.html.twig' %}
     9	
    10	{% block stylesheet %}
    11	    <style nonce="{{ csp_nonce }}">
    12	        .csv-format-card > .card-header {
    13	            border-bottom: 0;
    14	        }
    15	        .csv-format-table th:first-child,
    16	        .csv-format-table td:first-child {
    17	            border-left: 0;
    18	        }
    19	        .csv-format-table th:last-child,
    20	        .csv-format-table td:last-child {
    21	            border-right: 0;
    22	        }
    23	        .csv-format-table thead th {
    24	            font-weight: normal;
    25	        }
    26	        .c-contentsArea__primaryCol {
    27	            max-width: 0;
    28	        }
    29	        .csv-format-scroll {
    30	            overflow-x: auto;
    31	            -webkit-overflow-scrolling: touch;
    32	        }
    33	        .csv-format-table {
    34	            margin-bottom: 10px !important;
    35	        }
    36	        .csv-format-table > tbody > tr > td {
    37	            background-color: #fff !important;
    38	            --bs-table-bg: #fff !important;
    39	            --bs-table-bg-state: #fff !important;
    40	            --bs-table-bg-type: #fff !important;
    41	            font-weight: bold;
    42	        }
    43	    </style>
    44	{% endblock stylesheet %}
    45	
    46	{% block javascript %}
    47	    <script nonce="{{ csp_nonce }}">
    48	        $(function() {
    49	            var $fileInput = $('#admin_csv_import_import_file');
    50	
    51	            $('#file-select').on('click', function() {
    52	                $fileInput.trigger('click');
    53	            });
    54	
    55	            $fileInput.on('change', function() {
    56	                var files = $(this).prop('files');
    57	                if (files.length) {
    58	                    $('#admin_csv_import_import_file_name').text(files[0].name);
    59	                    $('#upload-button').prop('disabled', false);
    60	                }
    61	            });
    62	        });
    63	    </script>
    64	{% endblock javascript %}
    65	
    66	{% block main %}
    67	    <div class="c-contentsArea__cols">
    68	        <div class="c-contentsArea__primaryCol">
    69	            <div class="c-primaryCol">
    70	                {% if errors is defined and errors|length > 0 %}
    71	                    <div class="alert alert-danger alert-dismissible fade show" role="alert">
    72	                        {% for error in errors %}
    73	                            <p class="mb-0">
    74	                                <i class="fa fa-warning fa-lg me-2"></i>
    75	                                <span class="fw-bold">{{ error }}</span>
    76	                            </p>
    77	                        {% endfor %}
    78	                        <button class="btn-close" type="button" data-bs-dismiss="alert" aria-label="Close"></button>
    79	                    </div>
    80	                {% endif %}
    81	                <div class="card rounded border-0 mb-4">
    82	                    <div class="card-header fw-bold">
    83	                        <span>{{ 'admin.deck.csv_upload_header'|trans }}</span>
    84	                    </div>
    85	                    <div class="card-body">
    86	                        <div class="row">
    87	                            <div class="col-2"><span>{{ 'admin.common.csv_file_select'|trans }}</span></div>
    88	                            <div class="col">
    89	                                <form id="upload-form" method="post" action="{{ url('admin_deck_csv_import') }}" enctype="multipart/form-data">
    90	                                    {{ form_widget(form._token) }}
    91	                                    <div class="mb-2">
    92	                                        <button id="file-select" type="button" class="btn btn-ec-regular me-2">{{ 'admin.common.file_select'|trans }}</button>
    93	                                        <span id="admin_csv_import_import_file_name">{{ 'admin.common.file_select_empty'|trans }}</span>
    94	                                        {{ form_widget(form.import_file, {'attr': {'accept': 'text/csv,.csv', 'class': 'd-none'}}) }}
    95	                                        {{ form_errors(form.import_file) }}
    96	                                    </div>
    97	                                    <button class="btn btn-ec-conversion" id="upload-button" type="submit" disabled>{{ 'admin.common.csv_upload'|trans }}</button>
    98	                                </form>
    99	                            </div>
   100	                        </div>
   101	                    </div>
   102	                </div>
   103	                <div class="card rounded border-0 mb-4 csv-format-card">
   104	                    <div class="card-header fw-bold">
   105	                        <span>{{ 'admin.deck.csv_format_title'|trans }}</span>
   106	                    </div>
   107	                    <div class="card-body px-0 pt-0 pb-0">
   108	                        <div class="csv-format-scroll">
   109	                            <table class="table table-bordered csv-format-table mb-0">
   110	                                <thead>
   111	                                    <tr>
   112	                                        {% for key in headers|keys %}
   113	                                            <th class="align-middle text-nowrap table-ec-lightGray">{{ key }}</th>
   114	                                        {% endfor %}
   115	                                    </tr>
   116	                                </thead>
   117	                                <tbody>
   118	                                    <tr>
   119	                                        {% for value in headers %}
   120	                                            <td class="align-middle text-nowrap">{{ value }}</td>
   121	                                        {% endfor %}
   122	                                    </tr>
   123	                                </tbody>
   124	                            </table>
   125	                        </div>
   126	                    </div>
   127	                </div>
   128	            </div>
   129	        </div>
   130	    </div>
   131	{% endblock %}
