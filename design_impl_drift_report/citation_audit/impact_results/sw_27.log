    51	{% block javascript %}
    52	    <script src="{{ asset('assets/js/select2.min.js', 'admin') }}" nonce="{{ csp_nonce }}"></script>
    53	    <script nonce="{{ csp_nonce }}">
    54	        $(function() {
    55	            const multiSelectPlaceholder = '{{ 'admin.deck.multi_select_placeholder'|trans|e('js') }}';
    56	            const bulkUpdateRequiredMessage = '{{ 'admin.deck.bulk_update_required'|trans|e('js') }}';
    57	            const initSelect2 = function($el) {
    58	                const opts = { width: '100%' };
    59	                if ($el.prop('multiple')) {
    60	                    opts.placeholder = multiSelectPlaceholder;
    61	                }
    62	                $el.select2(opts);
    63	            };
    64	            $('.select2-select').each(function() { initSelect2($(this)); });
    65	
    66	            $('#page_count_pulldown').on('change', function () {
    67	                const targetUrl = $(this).val();
    68	                if (targetUrl) {
    69	                    window.location.href = targetUrl;
    70	                }
    71	            });
    72	
    73	            $('#sort_key_pulldown, #sort_order_pulldown').on('change', function () {
    74	                const sortKey = $('#sort_key_pulldown').val();
    75	                const sortOrder = $('#sort_order_pulldown').val();
    76	                const $searchForm = $('#admin_search_deck');
    77	                $searchForm.find('.hidden_sort_key').val(sortKey);
    78	                $searchForm.find('.hidden_sort_order').val(sortOrder);
    79	                $searchForm.submit();
    80	            });
    81	
    82	            $('#date_clear').on('click', function() {
    83	                $('#admin_search_deck_event_date_from').val('');
    84	                $('#admin_search_deck_event_date_to').val('');
    85	            });
    86	
    87	            $('#toggle_bulk_edit').on('click', function() {
    88	                $('#bulk_edit_panel').slideToggle(200, function() {
    89	                    $('#bulk_edit_panel .select2-select').each(function() { initSelect2($(this)); });
    90	                });
    91	            });
    92	
    93	            $('.toggle_bulk_update_check').on('change', function() {
    94	                const $formArea = $(this).closest('label').siblings('.bulk_update_form');
    95	                $formArea.toggle($(this).prop('checked'));
    96	                $formArea.siblings('.bulk_update_error').remove();
    97	            });
    98	
    99	            const BULK_EDIT_STATE_KEY = 'admin_deck_bulk_edit_state';
   100	
   101	            const captureBulkEditState = function() {
   102	                const state = {
   103	                    deckIds: $('input.searched_deck_id:checked').map(function() { return $(this).val(); }).get(),
   104	                    changeFlgs: {},
   105	                    fields: {}
   106	                };
   107	                $('.toggle_bulk_update_check:checked').each(function() {
   108	                    const m = ($(this).attr('name') || '').match(/^change_flgs\[(.+)\]$/);
   109	                    if (m) {
   110	                        state.changeFlgs[m[1]] = true;
   111	                    }
   112	                });
   113	                $('#bulk_edit_panel').find('input, select, textarea').each(function() {
   114	                    const name = $(this).attr('name');
   115	                    if (!name || name === '_token' || name.indexOf('change_flgs') === 0) return;
   116	                    const $el = $(this);
   117	                    if ($el.is(':checkbox') || $el.is(':radio')) {
   118	                        if ($el.is(':checked')) {
   119	                            state.fields[name] = $el.val();
   120	                        }
   121	                    } else {
   122	                        const v = $el.val();
   123	                        if (v !== null && v !== '' && !(Array.isArray(v) && v.length === 0)) {
   124	                            state.fields[name] = v;
   125	                        }
   126	                    }
   127	                });
   128	                return state;
   129	            };
   130	
   131	            const restoreBulkEditState = function() {
   132	                const raw = sessionStorage.getItem(BULK_EDIT_STATE_KEY);
   133	                if (!raw) return;
   134	                sessionStorage.removeItem(BULK_EDIT_STATE_KEY);
   135	                let state;
   136	                try { state = JSON.parse(raw); } catch (e) { return; }
   137	
   138	                if (Array.isArray(state.deckIds)) {
   139	                    state.deckIds.forEach(function(id) {
   140	                        $('input.searched_deck_id[value="' + id + '"]').prop('checked', true);
   141	                    });
   142	                }
   143	                const hasFlgs = state.changeFlgs && Object.keys(state.changeFlgs).length > 0;
   144	                if (hasFlgs) {
   145	                    $('#bulk_edit_panel').show();
   146	                    $('#bulk_edit_panel .select2-select').each(function() { initSelect2($(this)); });
   147	                    Object.keys(state.changeFlgs).forEach(function(key) {
   148	                        const $check = $('input.toggle_bulk_update_check[name="change_flgs[' + key + ']"]');
   149	                        $check.prop('checked', true);
   150	                        $check.closest('label').siblings('.bulk_update_form').show();
   151	                    });
   152	                }
   153	                if (state.fields) {
   154	                    Object.keys(state.fields).forEach(function(name) {
   155	                        const $el = $('#bulk_edit_panel').find('[name="' + name + '"]');
   156	                        if ($el.length === 0) return;
   157	                        if ($el.is(':checkbox') || $el.is(':radio')) {
   158	                            $el.filter('[value="' + state.fields[name] + '"]').prop('checked', true);
   159	                        } else {
   160	                            $el.val(state.fields[name]).trigger('change');
   161	                        }
   162	                    });
   163	                }
   164	            };
   165	
   166	            $('button[formaction*="bulk_update"]').on('click', function(e) {
   167	                $('.bulk_update_error').remove();
   168	                let hasError = false;
   169	                $('.toggle_bulk_update_check:checked').each(function() {
   170	                    const $container = $(this).closest('label').siblings('.bulk_update_form');
   171	                    const $input = $container.find('input, select, textarea').first();
   172	                    const val = $input.val();
   173	                    const isRadio = $input.is(':radio');
   174	                    const isEmpty = isRadio
   175	                        ? $container.find('input:radio:checked').length === 0
   176	                        : (val === null || val === '' || (Array.isArray(val) && val.length === 0));
   177	                    if (isEmpty) {
   178	                        $container.after('<div class="bulk_update_error text-danger mt-1">' + bulkUpdateRequiredMessage + '</div>');
   179	                        hasError = true;
   180	                    }
   181	                });
   182	                if (hasError) {
   183	                    e.preventDefault();
   184	                    return;
   185	                }
   186	                // バリデーションエラーで同画面が返ったときに復元できるよう state を保存
   187	                sessionStorage.setItem(BULK_EDIT_STATE_KEY, JSON.stringify(captureBulkEditState()));
   188	            });
   189	
   190	            restoreBulkEditState();
   191	
   192	            $('#allCheck').on('change', function() {
   193	                $('.searched_deck_id').prop('checked', $(this).prop('checked'));
   194	            });
   195	
   196	            $('.search-clear').on('click', function(e) {
   197	                e.preventDefault();
   198	                const $form = $(this).closest('form');
   199	                $form.find('input[type="text"], input[type="number"], input[type="date"]').val('');
   200	                $form.find('input[type="checkbox"], input[type="radio"]').prop('checked', false);
   201	                $form.find('select').val(null).trigger('change');
   202	            });
   203	
   204	            // 一括フォームは formaction でアクションを切り替えるため、CSRFトークンも対応する値に差し替える
   205	            $('#bulk_form').on('submit', function(e) {
   206	                var submitter = e.originalEvent && e.originalEvent.submitter ? e.originalEvent.submitter : null;
   207	                var action = submitter ? ($(submitter).attr('formaction') || '') : ($(this).attr('action') || '');
   208	                if (action.indexOf('csv_export') !== -1) {
   209	                    $('#bulk_form_token').val($('#csv_export_token_value').val());
   210	                } else if (action.indexOf('bulk_update') !== -1) {
   211	                    $('#bulk_form_token').val($('#bulk_update_token_value').val());
   212	                } else {
   213	                    $('#bulk_form_token').val($('#bulk_delete_token_value').val());
   214	                }
   215	            });
   216	        });
   217	    </script>
