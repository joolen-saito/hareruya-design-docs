     8	{% form_theme searchForm '@admin/Form/bootstrap_4_horizontal_layout.html.twig' %}
     9	
    10	{% block stylesheet %}
    11	    <style nonce="{{ csp_nonce }}">
    12	        .deck-search-check .form-check { padding-left: 0; margin-right: 0.5rem; }
    13	        .deck-search-check .form-check-input { margin-left: 0; margin-right: 0.25rem; }
