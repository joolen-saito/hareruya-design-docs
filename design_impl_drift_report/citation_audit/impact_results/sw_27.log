    77	                'choice_label' => 'name_jp',
    78	                'label' => 'admin.deck.color',
    79	                'label_attr' => ['class' => 'checkbox-inline'],
    80	                'required' => false,
    81	                'multiple' => true,
    82	                'expanded' => true,
    83	            ])
    84	            ->add('archetypes', EntityType::class, [
    85	                'class' => DtbArchetype::class,
    86	                'choice_label' => 'nameJp',
    87	                'label' => 'admin.deck.archetype',
    88	                'required' => false,
    89	                'multiple' => true,
    90	                'attr' => ['class' => 'select2-select'],
    91	            ])
    92	            ->add('disp', EntityType::class, [
    93	                'class' => MtbDisp::class,
    94	                'choice_label' => 'name',
    95	                'label' => 'admin.deck.disp',
