   149	    #[Route('/%eccube_admin_route%/deck/bulk_delete', name: 'admin_deck_bulk_delete', methods: ['POST'])]
   150	    public function bulkDelete(Request $request): RedirectResponse
   151	    {
   152	        $token = $request->request->get('_token');
   153	        if (!$this->isCsrfTokenValid('admin_deck_bulk_delete', $token)) {
   154	            $this->addError('admin.common.csrf_invalid', 'admin');
   155	
   156	            return $this->redirectToRoute('admin_deck_list');
   157	        }
   158	
   159	        $pageNo = $this->session->get($this->sessionKey.'.page_no', 1);
   160	
   161	        /** @var array<int, string> $deckIds */
   162	        $deckIds = $request->request->all('deckId');
   163	
   164	        if (empty($deckIds)) {
   165	            return $this->redirectToRoute('admin_deck_search', ['page_no' => $pageNo]);
   166	        }
   167	
   168	        $User = $this->getUser();
   169	        $Member = $User instanceof \Eccube\Entity\Member ? $User : null;
   170	        $input = new DeckBulkDeleteInput($deckIds, $Member);
   171	
   172	        try {
   173	            $this->bulkDeleteAction->handle($input);
   174	        } catch (NotFoundHttpException $e) {
   175	            throw $e;
   176	        } catch (\RuntimeException $e) {
   177	            $this->addError($e->getMessage(), 'admin');
   178	
   179	            return $this->redirectToRoute('admin_deck_search', ['page_no' => $pageNo]);
   180	        } catch (\Exception $e) {
   181	            log_error('デッキ一括削除エラー', ['message' => $e->getMessage()]);
   182	            $this->addError('admin.common.delete_error', 'admin');
   183	
   184	            return $this->redirectToRoute('admin_deck_search', ['page_no' => $pageNo]);
   185	        }
   186	
   187	        $event = new EventArgs([], $request);
   188	        $this->eventDispatcher->dispatch($event, EccubeEvents::ADMIN_DECK_BULK_DELETE_COMPLETE);
   189	
   190	        $this->addSuccess('admin.common.delete_complete', 'admin');
   191	
   192	        return $this->redirectToRoute('admin_deck_search', ['page_no' => $pageNo]);
   193	    }
