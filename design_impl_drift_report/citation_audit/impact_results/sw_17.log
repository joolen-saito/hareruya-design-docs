            // $csvService = $app['eccube.service.csv.export'];
            $csvService = $this->csvExportService;
            $csvService->fopen();

            // ヘッダ行出力
            $csvService->fputcsv(array_keys($this->csvHeader));

            // データ出力
            foreach ($csvRows as $csvRow) {
                $csvService->fputcsv($csvRow);
            }

            $csvService->fclose();
        });

        $filename = $this->createFileName('order_');
        $this->setCsvResponseHeader($response, $filename);

        log_info('CSV出力ファイル名', [$filename]);

        return $response;
    }

    /**
     * 出荷実績登録処理
     * 対応状況が出荷指示かつ出荷日が入力されている受注情報を更新
     *
     * @param array<string, string> $headers
     * @param CsvImportService<int, array<int|string, string>> $data
            ->setParameter('shippingIds', $shippingIds, ArrayParameterType::INTEGER)
            ->setParameter('stackPaperThresholdPrice', (int) $optionValues['stack_paper_threshold_price'])
            ->getResult();
    }

    /**
     * 受注管理
     * 出荷実績インポート用CSVに出力する情報を取得
     *
     * @param array<int> $orderIdList
     *
     * @return array<int, mixed>
     */
    public function generateResultCsv(array $orderIdList): array
    {
        $qb = $this->getEntityManager()->createQueryBuilder()
            ->from('Eccube\Entity\Order', 'o')
            ->select([
                'o.order_number',
                'c.id AS customer_id',
                'c.name01 AS customer_name01',
                'c.name02 AS customer_name02',
                'c.kana01 AS customer_kana01',
                'c.kana02 AS customer_kana02',
                'c.company_name AS customer_company_name',
                // TODO：顧客郵便番号はテーブルでカラムが01，02に分かれていない。一旦ここで分割して出力する。
                'SUBSTRING(c.postal_code, 1, 3) AS customer_zip01',
                'SUBSTRING(c.postal_code, 4, 4) AS customer_zip02',
                'cp.id AS customer_pref_id',
                'cp.name AS customer_pref_name',
                'c.addr01 AS customer_addr01',
                'c.addr02 AS customer_addr02',
                'c.addr03 AS customer_addr03',
                'c.email AS customer_email',
                'c.tel01 AS customer_tel01',
                'c.tel02 AS customer_tel02',
                'c.tel03 AS customer_tel03',
                'c.fax01 AS customer_fax01',
                'c.fax02 AS customer_fax02',
                'c.fax03 AS customer_fax03',
                'cs.id AS customer_sex_id',
                'cs.name AS customer_sex',
                'cj.id AS customer_job_id',
                'cj.name AS customer_job',
                'c.birth AS customer_birth',
                'c.note AS customer_note',
                'o.subtotal',
                'o.discount',
                'o.delivery_fee_total',
                'o.tax',
                'o.total',
                'o.payment_total',
                'ost.id AS status_id',
                'ost.name AS status',
                'py.id AS payment_id',
                'py.method',
                'o.order_date',
                'o.confirmDate',
                'o.payment_date',
                'o.commitDate',
                'o.shippingDate',
                's.name01 AS shipping_name01',
                's.name02 AS shipping_name02',
                's.kana01 AS shipping_kana01',
                's.kana02 AS shipping_kana02',
                's.company_name AS shipping_company_name',
                // TODO：配送先郵便番号はテーブルでカラムが01，02に分かれていない。一旦ここで分割して出力する。
                'SUBSTRING(s.postal_code, 1, 3) AS shipping_zip01',
                'SUBSTRING(s.postal_code, 4, 4) AS shipping_zip02',
                'sp.id AS shipping_pref_id',
                'sp.name AS shipping_pref_name',
                's.addr01 AS shipping_addr01',
                's.addr02 AS shipping_addr02',
                's.addr03 AS shipping_addr03',
                's.tel01 AS shipping_tel01',
                's.tel02 AS shipping_tel02',
                's.tel03 AS shipping_tel03',
                // TODO：配送先Fax番号はテーブルにカラムなし。一旦空文字を出力する。
                "'' AS shipping_fax01",
                "'' AS shipping_fax02",
                "'' AS shipping_fax03",
                'd.id AS delivery_id',
                'd.name AS delivery_name',
                'o.invoiceNumber',
                't.id AS delivery_time_id',
                't.delivery_time',
            ])
            ->join('o.Pref', 'op')
            ->leftJoin('o.Country', 'oc')
            ->join('o.Customer', 'c')
            ->leftJoin('c.Sex', 'cs')
