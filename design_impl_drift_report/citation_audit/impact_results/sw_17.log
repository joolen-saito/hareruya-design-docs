        protected RegisterIndividualStockAction $registerIndividualStockAction,
        protected ProductClassRepository $productClassRepository,
        protected DtbOtcBuyOrderStockRepository $otcBuyOrderStockRepository,
        protected DtbOtcBuyOrderDetailRepository $otcBuyOrderDetailRepository,
        private readonly IsAccessibleRouteExtension $isAccessibleRouteExtension,
    ) {
        // === Trait 必須プロパティ ===
        $this->sessionKey = 'otcbuyorder';
        $this->formType = OtcBuyOrderType::class;
    }

    /**
     * 買取一覧
     *
     * @return array<string, mixed>
     */
    #[
        Route(
            path: '/%eccube_admin_route%/otcbuyorder',
            name: 'admin_otcbuyorder',
            methods: ['GET', 'POST'],
        ),
    ]
    #[
        Route(
            path: '/%eccube_admin_route%/otcbuyorder/page/{page_no}',
            name: 'admin_otcbuyorder_page',
            requirements: ['page_no' => "\d+"],
            methods: ['GET'],
        ),
    ]
    #[Template(template: '@admin/OtcBuyOrder/index.twig')]
    public function index(
        Request $request,
        PaginatorInterface $paginator,
        int $page_no = 0,
    ): array {
        // 現行だとパスパラメータでのページネーションだが、pager.twig が クエリパラメータでのページネーションを想定しているため両方に対応しておく
        if ($page_no === 0) {
            $page_no =
                $request->query->getInt('pageno', 0) ?:
                $request->query->getInt('page_no', 0);
        }

        // ページ番号が指定されている場合、セッションから検索条件を復元して指定のページを開く
        if ($page_no > 0) {
            $result = $this->search($request, null, $page_no);

            $event = new EventArgs([], $request);
            $this->eventDispatcher->dispatch($event, EccubeEvents::ADMIN_OTC_BUY_ORDER_INDEX_SEARCH);

            return $result;
        }

        // GET: 初期表示（空の状態）
        if ($request->isMethod('GET')) {
            $builder = $this->formFactory->createBuilder(OtcBuyOrderType::class);

            $event = new EventArgs(
                [
                    'builder' => $builder,
                ],
                $request
            );
            $this->eventDispatcher->dispatch($event, EccubeEvents::ADMIN_OTC_BUY_ORDER_INDEX_INITIALIZE);

            $form = $builder->getForm();

            return [
                'searchForm' => $form->createView(),
                'pagination' => [],
                'pageMaxis' => [],
                'page_count' => $this->eccubeConfig['eccube_default_page_count'],
            ];
        }

        // POST: 検索実行
        $result = $this->search($request);

        $event = new EventArgs([], $request);
        $this->eventDispatcher->dispatch($event, EccubeEvents::ADMIN_OTC_BUY_ORDER_INDEX_SEARCH);

        return $result;
    }

    /**
     * QueryBuilder取得（SearchControllerTraitのgetQueryBuilderをオーバーライドし、型安全なDtoを使うようにする）
     *
     * @param array{searchData: array<string, scalar|array<scalar>|object|null>} $args
     *
     * @return QueryBuilder
     */
    protected function getQueryBuilder(array $args): QueryBuilder
    {
        $searchData = SearchDataDto::fromFormData($args['searchData']);

        return $this->otcBuyOrderRepository->getQueryBuilderBySearchData(
            $searchData,
        );
    }

