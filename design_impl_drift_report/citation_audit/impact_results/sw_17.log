    #[\Override]
    protected function setUp(): void
    {
        $this->tenantOnlyAllowedTest();
        $this->generator = static::getContainer()->get(Generator::class);
    }

    /**
     * 出荷待ち受注を出荷実績インポートで更新すると、日本語の出荷完了メールが1通送信されること.
     * CSV の注文番号はゼロ埋めなしでも、DB の 8桁 order_number にマッチすること.
     */
    public function testShippingResultImportSendsJapaneseShippingCompleteMail(): void
    {
        $Customer = $this->generator->createCustomer();
        /** @var Order $Order */
        $Order = $this->generator->createOrder(Customer: $Customer, statusTypeId: OrderStatus::PRE_DELIV);
        $orderNumber = sprintf('%08d', $Order->getId());
        $Order->setOrderNumber($orderNumber);
        $Order->setShippingDate(null);
        $this->entityManager->flush();

        // pf 同様、CSV 側はゼロ埋めなしでも検索できること
        $csvOrderNumber = (string) (int) $orderNumber;
        $this->submitShippingResultCsv($csvOrderNumber, 'TRACK-TEST-001');

        $this->assertTrue($this->client->getResponse()->isRedirect());
        $this->assertStringContainsString(
            'shipping_result_csv/import',
            $this->client->getResponse()->headers->get('Location') ?? ''
        );

        $this->assertEmailCount(1);
        /** @var Email $Message */
        $Message = $this->getMailerMessage(0);
        $jpTemplate = $this->entityManager->find(MailTemplate::class, MailTemplate::SHIPMENT_COMPLETE_JP);
        $this->assertNotNull($jpTemplate);
        $this->assertSame($jpTemplate->getMailSubject(), $Message->getSubject());
        $this->assertSame($Order->getEmail(), $Message->getTo()[0]->getAddress());

        $this->entityManager->clear();
        /** @var Order $updatedOrder */
        $updatedOrder = $this->entityManager->find(Order::class, $Order->getId());
        $this->assertSame(OrderStatus::DELIVERED, $updatedOrder->getOrderStatus()->getId());
        $this->assertInstanceOf(\DateTime::class, $updatedOrder->getShippingDate());
        $this->assertSame('TRACK-TEST-001', $updatedOrder->getInvoiceNumber());

        /** @var Shipping $Shipping */
        $Shipping = $updatedOrder->getShippings()->first();
        $this->assertInstanceOf(\DateTime::class, $Shipping->getShippingDate());
        $this->assertInstanceOf(\DateTime::class, $Shipping->getMailSendDate());

        // 受注編集画面は Order.invoiceNumber を表示する
        $crawler = $this->client->request(
            Request::METHOD_GET,
            $this->generateUrl('admin_order_edit', ['id' => $updatedOrder->getId()])
        );
        $this->assertSame(Response::HTTP_OK, $this->client->getResponse()->getStatusCode());
        $this->assertSame(
            'TRACK-TEST-001',
            $crawler->filter('#order_invoiceNumber')->attr('value')
        );
    }

    /**
     * 海外会員の受注は英語の出荷完了メールが送信されること
     */
    public function testShippingResultImportSendsEnglishShippingCompleteMailForAbroadCustomer(): void
    {
        $Customer = $this->generator->createCustomer();
        $Customer->setPref($this->entityManager->find(Pref::class, Pref::PREF_ABROAD));
        /** @var Order $Order */
        $Order = $this->generator->createOrder(Customer: $Customer, statusTypeId: OrderStatus::PRE_DELIV);
        $orderNumber = sprintf('%08d', $Order->getId());
        $Order->setOrderNumber($orderNumber);
        $Order->setShippingDate(null);
        $this->entityManager->flush();

        $this->submitShippingResultCsv($orderNumber, 'TRACK-TEST-EN');

        $this->assertTrue($this->client->getResponse()->isRedirect());

