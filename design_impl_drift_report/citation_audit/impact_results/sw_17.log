        }

        $form = $this->createForm(OtcBuyOrderStatusType::class);
        $form->handleRequest($request);

        if ($form->isSubmitted() && $form->isValid()) {
            $NextStatus = $form->get('otc_buy_order_status')->getData();

            try {
                $this->updateStatusAction->handle(new UpdateStatusInput(
                    OtcBuyOrder: $OtcBuyOrder,
                    NextStatus: $NextStatus,
                    Member: $this->getMember(),
                ));
            } catch (\InvalidArgumentException $e) {
                $this->addError($e->getMessage(), 'admin');

                return $this->redirectToRoute('admin_otcbuyorder_status', [
                    'otcBuyOrderId' => $OtcBuyOrder->getId(),
                ]);
            }

            $event = new EventArgs(
                [
                    'form' => $form,
                    'OtcBuyOrder' => $OtcBuyOrder,
                ],
                $request
            );
            $this->eventDispatcher->dispatch($event, EccubeEvents::ADMIN_OTC_BUY_ORDER_STATUS_UPDATE_COMPLETE);

            $this->addSuccess('admin.common.save_complete', 'admin');

            return $this->redirectToRoute('admin_otcbuyorder_detail', [
                'otcBuyOrderId' => $OtcBuyOrder->getId(),
            ]);
        }

        return [
            'form' => $form->createView(),
            'OtcBuyOrder' => $OtcBuyOrder,
        ];
    }

