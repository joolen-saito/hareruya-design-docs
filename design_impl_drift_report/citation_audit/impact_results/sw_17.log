    public function statusUpdate(Request $request, int $otcBuyOrderId): array|Response
    {
        $OtcBuyOrder = $this->otcBuyOrderRepository->find($otcBuyOrderId);
        if (!$OtcBuyOrder) {
            throw $this->createNotFoundException();
        }

        if (!$this->isAccessibleRouteExtension->isAccessibleRoute('admin_otcbuyorder_status_update')) {
            $this->addError('exception.error_message_restrict_url', 'admin');

