        methods: ['POST']
    )]
    public function registerIndividualStock(
        Request $request,
        int $otcBuyOrderId,
        int $individualProductId,
    ): Response {
        if (!$this->isCsrfTokenValid('register_individual_stock', $request->request->get('_token'))) {
            $this->addError('admin.common.csrf_token_error', 'admin');

            return $this->redirectToRoute('admin_otcbuyorder_detail', ['otcBuyOrderId' => $otcBuyOrderId]);
        }

        $OtcBuyOrder = $this->otcBuyOrderRepository->find($otcBuyOrderId);
        if (!$OtcBuyOrder) {
            throw $this->createNotFoundException();
        }

        $IndividualProduct = $this->entityManager->find(
            DtbOtcBuyOrderIndivisualInputProduct::class,
            $individualProductId,
        );
        if (!$IndividualProduct || $IndividualProduct->getOtcBuyOrder()->getId() !== $OtcBuyOrder->getId()) {
            throw $this->createNotFoundException();
