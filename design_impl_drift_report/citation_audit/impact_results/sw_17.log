class OtcBuyOrderHistoryController extends AbstractController
{
    use SearchControllerTrait;

    public function __construct(
        protected PageMaxRepository $pageMaxRepository,
        protected PaginatorInterface $paginator,
        protected DtbOtcBuyOrderStockHistoryRepository $otcBuyOrderStockHistoryRepository,
        protected DtbOtcBuyOrderStockRepository $otcBuyOrderStockRepository,
        protected CsrfTokenManagerInterface $csrfTokenManager,
        protected OtcBuyOrderHistoryCsvExportService $historyCsvExportService,
    ) {
        // === Trait 必須プロパティ ===
        $this->sessionKey = 'otcbuyorder_history';
        $this->formType = OtcBuyOrderHistoryType::class;
    }

    /**
     * 買取商品履歴
     *
     * @return array<string, mixed>
     */
    #[
        Route(
            path: '/%eccube_admin_route%/otcbuyorder/history',
            name: 'admin_otcbuyorder_history',
            methods: ['GET', 'POST'],
        ),
    ]
    #[
        Route(
            path: '/%eccube_admin_route%/otcbuyorder/history/page/{page_no}',
            name: 'admin_otcbuyorder_history_page',
            requirements: ['page_no' => "\d+"],
            methods: ['GET'],
        ),
    ]
    #[Template(template: '@admin/OtcBuyOrder/history.twig')]
    public function index(
        Request $request,
        PaginatorInterface $paginator,
        int $page_no = 0,
    ): array {
        // 現行だとパスパラメータでのページネーションだが、pager.twig が クエリパラメータでのページネーションを想定しているため両方に対応しておく
        if ($page_no === 0) {
            $page_no =
                $request->query->getInt('pageno', 0) ?:
                $request->query->getInt('page_no', 0);
        }

        // ページ番号が指定されている場合、セッションから検索条件を復元して指定のページを開く
        if ($page_no > 0) {
            $result = $this->search($request, null, $page_no);
            $result['buyQuantities'] = $this->buildBuyQuantities($result);

            return $result;
        }

        // GET: 初期表示（空の状態）
        if ($request->isMethod('GET')) {
            $builder = $this->formFactory->createBuilder(OtcBuyOrderHistoryType::class);

            $event = new EventArgs(
                [
                    'builder' => $builder,
                ],
                $request
            );
            $this->eventDispatcher->dispatch($event, EccubeEvents::ADMIN_OTC_BUY_ORDER_HISTORY_INDEX_INITIALIZE);

            $form = $builder->getForm();

            return [
                'searchForm' => $form->createView(),
                'pagination' => [],
                'buyQuantities' => [],
                'pageMaxis' => [],
                'page_count' => $this->eccubeConfig['eccube_default_page_count'],
            ];
        }

        // POST: 検索実行
        $result = $this->search($request);
        $result['buyQuantities'] = $this->buildBuyQuantities($result);

        return $result;
    }

    /**
     * 一覧に表示する実在庫ごとの買取数を取得する
     *
     * 買取数は検索クエリ(getQueryBuilder)ではなく、ページング後の表示対象に対して一括で集計している。
     * 検索クエリで集計しようとすると、
     * ・HIDDENなしでSUMをaddSelectすると結果がEntityではなく配列になり、paginatorとtwigの前提が崩れる
     * ・HIDDENありでは値を取り出せない
     * ・買取明細と個別入力商品の2系統をJOINで足すと直積で行が増え、買取数と件数が壊れる
     * ため成立しない。
     *
     * @param array<string, mixed> $searchResult search() の戻り値
     *
     * @return array<int, int> 実在庫ID => 買取数
     */
    private function buildBuyQuantities(array $searchResult): array
    {
        $pagination = $searchResult['pagination'] ?? null;
        if ($pagination === null || $pagination->getTotalItemCount() === 0) {
            return [];
        }

        $stockIds = [];
        foreach ($pagination->getItems() as $History) {
            if (!$History instanceof DtbOtcBuyOrderStockHistory) {
                continue;
            }
            $stockIds[] = $History->getOtcBuyOrderStock()->getId();
        }

        return $this->otcBuyOrderStockRepository->getBuyQuantities(array_values(array_unique($stockIds)));
    }

    /**
     * QueryBuilder取得（SearchControllerTraitのgetQueryBuilderをオーバーライドし、型安全なDtoを使うようにする）
     *
     * @param array{searchData: array<string, scalar|array<scalar>|object|null>} $args
     *
     * @return QueryBuilder
     */
    protected function getQueryBuilder(array $args): QueryBuilder
    {
        $searchData = HistorySearchDataDto::fromFormData($args['searchData']);

        return $this->otcBuyOrderStockHistoryRepository->getQueryBuilderByHistorySearchData(
            $searchData,
        );
    }

