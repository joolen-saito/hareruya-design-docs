            name: 'admin_otcbuyorder_history_export',
            methods: ['POST'],
        ),
    ]
    public function export(Request $request): Response
    {
        set_time_limit(0);

        $exportType = $request->request->get('export_type');

        return match ($exportType) {
            'check_export' => $this->exportByChecked($request),
            'all_export' => $this->exportAll($request),
            default => throw new \InvalidArgumentException('Invalid export type: '.$exportType),
        };
    }

