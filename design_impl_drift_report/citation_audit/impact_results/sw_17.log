trait SearchControllerTrait
{
    /** セッションキー。表示件数、検索条件、ソート条件の保持に使用 */
    protected string $sessionKey;
    /** フォームタイプ */
    protected string $formType;
    /** フォーム名 */
    protected string $formName;
    /** デフォルトソートキー */
    protected string $defaultSort = 'default';
    /** デフォルト並び順 */
    protected string $defaultOrder = 'DESC';
    /**
     * ソート参照用レポジトリ
     * 使用する場合は[ | ]を使用してリポジトリの宣言追加をすること
     * 追加するリポジトリにgetQueryBuilderBySearchDataを実装すること
     */
    protected CustomerRepository|DtbArchetypeRepository|DtbBuyOrderRepository|DtbBuyOrderStockHistoryRepository|DtbDeckRepository|DtbInventoryPlanRepository|DtbPriceHistoryRepository|MtbCardRepository|DtbShippingStandbyRepository $repository;
    /** リダイレクト先 */
    protected string $redirect = '';
    /** 検索パターンキー名 */
    protected string $patternKey = '';
    /**
     * @var array<string, mixed>
     * Form作成時のオプション
     */
    protected array $formCreateOption = [];

    /** 意図名（intention） */
    protected string $intention = '';

    protected PaginatorInterface $paginator;

    protected DtbSearchPatternRepository $dtbSearchPatternRepository;

    public function __construct(
        PageMaxRepository $pageMaxRepository,
        EccubeConfig $eccubeConfig,
        PaginatorInterface $paginator,
    ) {
        $this->pageMaxRepository = $pageMaxRepository;
        $this->eccubeConfig = $eccubeConfig;
    }

    /**
     * 表示件数ドロップダウン用。画面ごとにコントローラでオーバーライドする。
     *
     * @return list<\Eccube\Entity\Master\PageMax>
     */
    protected function getPageMaxisForSearch(): array
    {
        return $this->pageMaxRepository->findAll();
    }

    /**
     * データ検索メイン処理
     *
     * @return array<string, mixed>
     *
     * @throws \Exception
     */
    public function search(Request $request, ?int $patternId = null, int $pageNo = 1): array
    {
        // セッション取得
        $session = $request->getSession();
        $sessionkey = $this->sessionKey;
        // セッションキー：ページ内表示件数
        $pageCountKey = "eccube.admin.{$sessionkey}.search.page_count";
        // セッションキー：ページ表示番号
        $pageNoKey = "eccube.admin.{$sessionkey}.search.page_no";
        // セッションキー：検索条件
        $viewKey = "eccube.admin.{$sessionkey}.search";
        // セッションキー：ソートカラム
        $sortKey = "eccube.admin.{$sessionkey}.sort";
        // セッションキー：降順/昇順
        $orderKey = "eccube.admin.{$sessionkey}.order";

        // フォーム取得
        $builder = $this->formFactory->createBuilder($this->formType, null, $this->formCreateOption);

        // パターンIDに設定する
        $searchForm = $builder->getForm();
        $searchForm->handleRequest($request);

        // ソートキー、並び順
        // sort の処理
        $sort = match (true) {
            !empty($request->get('sort')) => $request->get('sort'),
            !is_null($session->get($sortKey)) => $session->get($sortKey),
            default => $this->defaultSort,
        };

        // order の処理
        $order = match (true) {
            !empty($request->get('order')) => $request->get('order'),
            !is_null($session->get($orderKey)) => $session->get($orderKey),
            default => $this->defaultOrder,
        };

        if (!preg_match('/^(ASC|DESC|asc|desc)$/', $order)) {
            $this->addError('admin.error.sort', 'admin');

            return $this->index($request, $this->paginator);
        }

        $pageMaxis = $this->getPageMaxisForSearch();

        $maxArr = [];
        foreach ($pageMaxis as $pageMax) {
            $maxArr[] = $pageMax->getName();
        }
        // 表示件数取得する、1.SESSION 2.設定ファイル
        $defaultPageCount = (string) $this->eccubeConfig['eccube_default_page_count'];
        $pageCount = (string) $session->get($pageCountKey, $defaultPageCount);
        if ($maxArr !== [] && !in_array($pageCount, $maxArr, true)) {
            $pageCount = in_array($defaultPageCount, $maxArr, true) ? $defaultPageCount : $maxArr[0];
            $session->set($pageCountKey, $pageCount);
        }
        $pageCountParam = $request->get('page_count');
        // 表示件数入力値がマスターに設定されている場合SESSIONに保存する
        if ($pageCountParam !== null && $pageCountParam !== '' && in_array((string) $pageCountParam, $maxArr, true)) {
            $pageCount = (string) $pageCountParam;
            $session->set($pageCountKey, $pageCount);
        }

        // 検索条件
        $searchData = $searchForm->getData();
        $viewData = FormUtil::getViewData($searchForm);

        // 検索条件が空の場合、セッションに保存されている検索条件を復元する
        if (is_null($searchData)) {
            $viewData = $session->get($viewKey);
            // sessionに保持されている検索条件を復元.
            $searchData = FormUtil::submitAndGetData($searchForm, $viewData);
            if (is_null($viewData) && is_null($searchData)) {
                return $this->index($request, $this->paginator);
            }
        }

        $searchData['pattern_id'] = $patternId ?? null;
        $searchData['sort'] = $sort;
        $searchData['order'] = $order;
        $searchRequest = ['searchData' => $searchData];

        $qb = $this->getQueryBuilder($searchRequest);

        // Sessionに設定
        $session->set($pageNoKey, $pageNo);
        $session->set($viewKey, $viewData);
        $session->set($sortKey, $sort);
        $session->set($orderKey, $order);
        $session->set($pageCountKey, $pageCount);

        // 検索結果
        $pagination = $this->paginator->paginate(
            $qb,
            $pageNo,
            (int) $pageCount,
            $this->paginationOption ?? []
        );
        // 最終ページのデータ削除時に表示するデータがなくなった場合、１つ前のページを表示する
        $resultCount = $pagination->getTotalItemCount();
        $pageCountInt = (int) $pageCount;
        if ($pageNo > 1 && $resultCount === (($pageNo - 1) * $pageCountInt)) {
            $pageNo = $pageNo - 1;
            $session->set($pageNoKey, $pageNo);
            $pagination = $this->paginator->paginate(
                $qb,
                $pageNo,
                $pageCountInt,
                $this->paginationOption ?? []
            );
        }

        return [
            'searchForm' => $searchForm->createView(),
            'pagination' => $pagination,
            'pageMaxis' => $pageMaxis,
            'page_no' => $pageNo,
            'page_count' => (int) $pageCount,
            'sort_key' => $sort,
            'order_key' => $order,
            'has_errors' => false,
            'pattern_id' => $patternId,
            'is_search_filter_active' => $this->isSearchFilterActive($searchData),
        ];
    }

    /**
     * 検索パターン保存
     *
     * @return array<string, mixed>
     *
     * @throws ORMException
     * @throws NonUniqueResultException
     * @throws OptimisticLockException
     */
    public function saveSearchPattern(Request $request): array
    {
        $searchForm = $this->getForm();
        $searchForm->handleRequest($request);
        $viewData = FormUtil::getViewData($searchForm);

        if (is_null($viewData['pattern_name']) || $viewData['pattern_name'] === '') {
            $this->addError('admin.common.save_pattern.error.name_empty', 'admin');

            return $this->search($request);
        }

        if ($viewData['pattern_id']) {
            $searchPattern = $this->dtbSearchPatternRepository->find($viewData['pattern_id']) ?? new DtbSearchPattern();
        } else {
            $searchPattern = new DtbSearchPattern();
        }
        $searchPattern
            ->setPattern(serialize($viewData))
            ->setName($viewData['pattern_name'])
            ->setDisplayKey($this->patternKey);
