    /**
     * 受注管理 出荷指示リスト編集
     * ピッキングリスト印刷用の情報を取得
     *
     * @param int $standbyId
     * @param int[] $orderIdList
     *
     * @return array <mixed> $data>>
     */
    public function generatePickingList(int $standbyId, array $orderIdList = []): array
    {
        $option1 = $this->optionRepository->findOneBy([
            'option_key' => MtbOption::ORDER_LIST_THRESHOLD_PRICE_1,
        ]);
        $thresholdPrice1 = $option1 !== null ? (int) $option1->getOptionValue() : 0;

        $option2 = $this->optionRepository->findOneBy([
            'option_key' => MtbOption::ORDER_LIST_THRESHOLD_PRICE_2,
        ]);
        $thresholdPrice2 = $option2 !== null ? (int) $option2->getOptionValue() : 0;

        $qb = $this->createQueryBuilder('ss')
        ->select(
            'CASE WHEN cc.id IS NOT NULL THEN COUNT(DISTINCT cc.id) ELSE 1 END AS colorCount',
            // 重複を除いたカテゴリ数がNULLなら1を返し、NULLでなければその数をcategoryCountとして返す
            'COALESCE(NULLIF(COUNT(DISTINCT ct.category_id), 0), 1) AS categoryCount',
            'oi.product_name',
            'SUM(oi.quantity) AS polyquantity',
            'psc.id AS productClassId',
            'psc.price02 AS price',
            'cc.name_jp AS colorName',
            'r.code AS rarityCode',
            'prm.code AS promotionCode',
            'lng.code AS languageCode',
            'ccd.code AS conditionCode',
            'stc.name AS storageCode',
            'MIN(ct.category_id) AS categoryId',
            'sn.name AS shelfNumberName',
        )
        ->addSelect('CASE WHEN oi.price < :price1 THEN 1 ELSE 0 END AS class1')
        ->addSelect('CASE WHEN oi.price < :price2 THEN 1 ELSE 0 END AS class2')
        ->join('ss.Orders', 'o', 'WITH', 'ss = :standbyId AND o IN (:orders)')
        ->join('o.OrderItems', 'oi')
        ->join('oi.Product', 'p')
        ->Join('oi.ProductClass', 'psc')
        ->leftjoin('p.ProductCategories', 'ct')
        ->leftJoin('p.StorageCode', 'stc')
        ->leftJoin('p.CardDetail', 'cd')
        ->leftJoin('psc.Language', 'lng')
