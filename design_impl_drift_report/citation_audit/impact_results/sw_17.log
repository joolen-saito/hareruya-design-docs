     * @param Array $headers
     * @param Integer $headerSize
     * @param CsvImportService $data
     */
    public function registerShippingResult($headers, $headerSize, $data)
    {
        $requiredHeaders = $this->requiredCsvHeader;

        $updatedOrders = [];
        foreach ($data as $row) {
            $rowIndex = $data->key() + 1;

            // ヘッダーサイズチェック
            $this->checkHeaderSize($headerSize, $row, $rowIndex);
            // CSV必須項目入力チェック
            $this->checkRequiredHeaders($requiredHeaders, $row, $rowIndex);

            $orderSub = $this->app['hareruya_ec.repository.order_sub']->findOneByOrderNumber(sprintf('%08d', $row['注文番号']));
            if (!$orderSub) {
                throw new \RuntimeException(sprintf($this->app->trans('admin.csv.error.data.not_registered'), '注文番号', $row['注文番号'], $rowIndex));
            }
            $order = $orderSub->getOrder();

            if (empty($row['出荷日'])) {
                continue;
            }
            // 非会員の場合エラーを出力
            if (!$order->getCustomer()) {
                throw new \RuntimeException(sprintf($this->app->trans('admin.csv.error.customer.not_member'), $rowIndex));
            }
            try {
                $shippingDate = new \Datetime($row['出荷日']);
            } catch (\Exception $e) {
                throw new \RuntimeException(sprintf($this->app->trans('admin.csv.error.exception.datetime'), $rowIndex, '出荷日'));
            }
            $invoiceNumber = $row['送り状No.'];
            $newStatus = $this->app['eccube.repository.order_status']->find(OrderStatus::ORDER_DELIV);
            if (!$orderSub->getShippingDate()) {
                $order->setOrderStatus($newStatus);
                $orderSub
                    ->setShippingDate($shippingDate)
                    ->setInvoiceNumber($invoiceNumber);
                $updatedOrders[] = [
                    'order' => $order,
                    'orderSub' => $orderSub,
                    'player' => $this->app['hareruya_ec.repository.player']->findOneByCustomer($order->getCustomer())
                ];
            }
            foreach ($order->getShippings() as $shipping) {
                $shipping->setShippingCommitDate($shippingDate);
            }

        }
        $this->em->flush();
        $this->em->commit();

        return $updatedOrders;
    }

