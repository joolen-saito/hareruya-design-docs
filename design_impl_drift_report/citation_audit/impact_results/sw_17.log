    ) {
    }

    /**
     * 戻しリストPDF用のTwig変数を組み立て、対象買取を棚戻し済みに更新する
     *
     * @param list<int> $otcBuyOrderIds
     *
     * @return array{restockListSections: list<array{
     *     titleBase: string,
     *     isSupply: bool,
     *     items: list<array<string, mixed>>,
     *     total_quantity: int
     * }>}
     */
    public function buildPdfViewData(array $otcBuyOrderIds): array
    {
        $rawRows = $this->otcBuyOrderRepository->getOtcBuyOrderRestockListExportData($otcBuyOrderIds);
        $built = $this->restockListPdfSectionBuilder->buildSections($rawRows);
        $this->markOtcBuyOrdersAsRestocked($otcBuyOrderIds);

        return [
            'restockListSections' => $built['sections'],
        ];
    }

    /**
     * @param array<int, int> $otcBuyOrderIds
     */
    public function markOtcBuyOrdersAsRestocked(array $otcBuyOrderIds): void
    {
        $this->entityManager->beginTransaction();
        try {
            foreach ($otcBuyOrderIds as $id) {
                $OtcBuyOrder = $this->entityManager->find(DtbOtcBuyOrder::class, $id);
                if ($OtcBuyOrder === null) {
                    continue;
                }
                $OtcBuyOrder->setRestockedFlg(true);
                $this->entityManager->persist($OtcBuyOrder);
            }
            $this->entityManager->flush();
            $this->entityManager->commit();
        } catch (\Exception $e) {
            $this->entityManager->rollback();
            throw $e;
        }
    }

