   314	    #[Route('/%eccube_admin_route%/customer/{imageUrl}', name: 'admin_identification_image', requirements: ['imageUrl' => '.+\.[a-zA-Z0-9]+'], methods: ['GET'])]
   315	    public function identificationImage(Request $request, string $imageUrl): StreamedResponse
   316	    {
   317	        /** @var Member $Member */
   318	        $Member = $this->getUser();
   319	
   320	        $AccessDeniedAuthorityRole = $this->authorityRoleRepository->findOneBy([
   321	            'Authority' => $Member->getAuthority(),
   322	            'deny_url' => $this->eccubeConfig['eccube_access_denied_authority_identification'],
   323	        ]);
   324	
   325	        if (!empty($AccessDeniedAuthorityRole)) {
   326	            throw new AccessDeniedHttpException();
   327	        }
   328	
   329	        // DBに未登録のファイルの場合は404エラーを返し、S3からファイルを取得しない
   330	        if ($this->identificationImageRepository->findOneBy(['url' => $imageUrl]) === null) {
   331	            throw $this->createNotFoundException();
   332	        }
   333	
   334	        $file = $this->s3ServiceIdentification->getFile($imageUrl);
   335	
   336	        // 身分証画像が取得できなかった場合は404エラーを返し、画像表示を行わない
   337	        if ($file === '') {
   338	            throw $this->createNotFoundException();
   339	        }
   340	
   341	        // DBに保存されたS3オブジェクトキーからファイル拡張子を取得
   342	        $ext = pathinfo($imageUrl, PATHINFO_EXTENSION);
   343	
   344	        $response = new StreamedResponse(function () use ($file): void {
   345	            echo $file['Body']->getContents();
   346	        });
   347	        $response->headers->set('Content-Type', 'image/'.$ext);
   348	        $response->headers->set('Cache-Control', 'private, no-store');
   349	
   350	        $event = new EventArgs(
   351	            [
   352	                'response' => $response,
   353	            ],
   354	            $request
   355	        );
   356	        $this->eventDispatcher->dispatch($event, EccubeEvents::ADMIN_CUSTOMER_EDIT_IDENTIFICATION_IMAGE_EXPORT);
   357	
   358	        return $response;
   359	    }
   360	}
