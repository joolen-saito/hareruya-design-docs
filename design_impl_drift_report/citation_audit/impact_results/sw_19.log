    48	    public function edit(Request $request, Customer $Customer, $did = null): array|RedirectResponse
    49	    {
    50	        // 配送先住所最大値判定
    51	        // $idが存在する際は、追加処理ではなく、編集の処理ため本ロジックスキップ
    52	        if (is_null($did)) {
    53	            $addressCurrNum = count($Customer->getCustomerAddresses());
    54	            $addressMax = $this->eccubeConfig['eccube_deliv_addr_max'];
    55	            if ($addressCurrNum >= $addressMax) {
    56	                throw new NotFoundHttpException();
    57	            }
    58	            $CustomerAddress = new CustomerAddress();
    59	            $CustomerAddress->setCustomer($Customer);
    60	        } else {
    61	            $CustomerAddress = $this->customerAddressRepository->findOneBy(
    62	                [
    63	                    'id' => $did,
    64	                    'Customer' => $Customer,
    65	                ]
    66	            );
    67	            if (!$CustomerAddress) {
    68	                throw new NotFoundHttpException();
    69	            }
    70	        }
    71	
    72	        $builder = $this->formFactory
    73	            ->createBuilder(CustomerAddressType::class, $CustomerAddress);
    74	
    75	        $event = new EventArgs(
    76	            [
    77	                'builder' => $builder,
    78	                'Customer' => $Customer,
    79	                'CustomerAddress' => $CustomerAddress,
    80	            ],
    81	            $request
    82	        );
    83	
    84	        $this->eventDispatcher->dispatch($event, EccubeEvents::ADMIN_CUSTOMER_DELIVERY_EDIT_INDEX_INITIALIZE);
    85	
    86	        $form = $builder->getForm();
    87	        $form->handleRequest($request);
    88	
    89	        if ($form->isSubmitted() && $form->isValid()) {
    90	            log_info('お届け先登録開始', [$did]);
    91	
    92	            $this->entityManager->persist($CustomerAddress);
    93	            $this->entityManager->flush();
    94	
    95	            log_info('お届け先登録完了', [$did]);
    96	
    97	            $event = new EventArgs(
    98	                [
    99	                    'form' => $form,
   100	                    'Customer' => $Customer,
   101	                    'CustomerAddress' => $CustomerAddress,
   102	                ],
   103	                $request
   104	            );
   105	            $this->eventDispatcher->dispatch($event, EccubeEvents::ADMIN_CUSTOMER_DELIVERY_EDIT_INDEX_COMPLETE);
   106	
   107	            $this->addSuccess('admin.common.save_complete', 'admin');
   108	
   109	            return $this->redirectToRoute('admin_customer_delivery_edit', [
   110	                'id' => $Customer->getId(),
   111	                'did' => $CustomerAddress->getId(),
   112	            ]);
   113	        }
   114	
   115	        return [
   116	            'form' => $form->createView(),
   117	            'Customer' => $Customer,
   118	            'CustomerAddress' => $CustomerAddress,
   119	        ];
   120	    }
   121	
   122	    /**
   123	     * @param string $did
   124	     *
   125	     * @throws NotFoundHttpException
   126	     */
   127	    #[Route(path: '/%eccube_admin_route%/customer/{id}/delivery/{did}/delete', name: 'admin_customer_delivery_delete', requirements: ['id' => '\d+', 'did' => '\d+'], methods: ['DELETE'])]
   128	    public function delete(Request $request, Customer $Customer, $did): RedirectResponse
   129	    {
   130	        $this->isTokenValid();
   131	
   132	        log_info('お届け先削除開始', [$did]);
   133	
   134	        $CustomerAddress = $this->customerAddressRepository->find($did);
   135	        if (is_null($CustomerAddress)) {
   136	            throw new NotFoundHttpException();
   137	        } else {
   138	            if ($CustomerAddress->getCustomer()->getId() != $Customer->getId()) {
   139	                $this->deleteMessage();
   140	
   141	                return $this->redirectToRoute('admin_customer_edit', ['id' => $Customer->getId()]);
   142	            }
   143	        }
   144	
   145	        try {
   146	            $this->customerAddressRepository->delete($CustomerAddress);
   147	            $this->addSuccess('admin.common.delete_complete', 'admin');
   148	        } catch (ForeignKeyConstraintViolationException $e) {
   149	            log_error('お届け先削除失敗', [$e]);
   150	
   151	            $message = trans('admin.common.delete_error_foreign_key', ['%name%' => trans('admin.customer.customer_address')]);
   152	            $this->addError($message, 'admin');
   153	        }
   154	
   155	        log_info('お届け先削除完了', [$did]);
   156	
   157	        $event = new EventArgs(
   158	            [
   159	                'Customer' => $Customer,
   160	                'CustomerAddress' => $CustomerAddress,
   161	            ],
   162	            $request
   163	        );
   164	        $this->eventDispatcher->dispatch($event, EccubeEvents::ADMIN_CUSTOMER_DELIVERY_DELETE_COMPLETE);
   165	
   166	        return $this->redirectToRoute('admin_customer_edit', ['id' => $Customer->getId()]);
   167	    }
   168	}
