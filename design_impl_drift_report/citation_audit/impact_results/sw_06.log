FILE src/Eccube/MessageHandler/SmaregiOtcDeleteMessageHandler.php
    20	use Eccube\Entity\Order;
    21	use Eccube\Message\SmaregiOtcDeleteMessage;
    22	use Eccube\Repository\MessengerJobRepository;
    23	use Eccube\Repository\OrderRepository;
    24	use Eccube\Service\Smaregi\Api\SmaregiAccessTokenService;
    25	use Eccube\Service\Smaregi\Api\SmaregiMessengerJobContext;
    26	use Eccube\Service\Smaregi\Otc\SmaregiOtcDeleteResult;
    27	use Eccube\Service\Smaregi\Otc\SmaregiOtcDeleteService;
    28	use Eccube\Service\Smaregi\SmaregiMessengerJobProcessingLock;
    29	use Psr\Log\LoggerInterface;
    30	use Symfony\Component\Messenger\Attribute\AsMessageHandler;
    31	
    32	/**
    33	 * 店頭受取注文 (OTC) スマレジ商品削除メッセージのハンドラ。
    34	 *
    35	 * 同一ジョブの重複実行を {@see SmaregiMessengerJobProcessingLock} で抑止し、
    36	 * {@see SmaregiOtcDeleteService::delete()} を呼び出す。
    37	 * API 呼出ログを当該子ジョブに紐付けるために {@see SmaregiMessengerJobContext::setJobId()} を実行する
    38	 */
    39	#[AsMessageHandler]
    40	final readonly class SmaregiOtcDeleteMessageHandler
    41	{
    42	    public function __construct(
    43	        private LoggerInterface $logger,
    44	        private EntityManagerInterface $entityManager,
    45	        private SmaregiMessengerJobProcessingLock $smaregiMessengerJobProcessingLock,
    46	        private MessengerJobRepository $messengerJobRepository,
    47	        private OrderRepository $orderRepository,
    48	        private SmaregiAccessTokenService $accessTokenService,
    49	        private SmaregiOtcDeleteService $deleteService,
    50	        private SmaregiMessengerJobContext $smaregiMessengerJobContext,
    51	        private string $smaregiApiIdUrl,
    52	        private string $smaregiApiUrl,
    53	        private string $smaregiApiClientId,
    54	        private string $smaregiApiClientSecret,
    55	        private string $smaregiApiContractId,
    56	    ) {
    57	    }
    58	
    59	    public function __invoke(SmaregiOtcDeleteMessage $message): void
    60	    {
    61	        $Job = $this->messengerJobRepository->find($message->getJobId());
    62	        if (!$Job instanceof MessengerJob) {
    63	            $this->logger->error('MessengerJob not found for SmaregiOtcDeleteMessage', [
    64	                'jobId' => $message->getJobId(),
    65	                'orderId' => $message->getOrderId(),
    66	            ]);
    67	
    68	            return;
    69	        }
    70	
    71	        $this->smaregiMessengerJobContext->setJobId((int) $Job->getId());
    72	        try {
    73	            if (!$this->smaregiMessengerJobProcessingLock->tryBeginProcessingJob($Job)) {
    74	                return;
    75	            }
    76	
    77	            try {
    78	                $Order = $this->orderRepository->find($message->getOrderId());
    79	                if (!$Order instanceof Order) {
    80	                    $this->failJob($Job, sprintf('受注が見つかりません (orderId=%d).', $message->getOrderId()));
    81	
    82	                    return;
    83	                }
    84	
    85	                $accessToken = $this->accessTokenService->getAccessToken(
    86	                    $this->smaregiApiIdUrl,
    87	                    $this->smaregiApiContractId,
    88	                    $this->smaregiApiClientId,
    89	                    $this->smaregiApiClientSecret,
    90	                );
    91	
    92	                $result = $this->deleteService->delete(
    93	                    $Order,
    94	                    $this->smaregiApiUrl,
    95	                    $this->smaregiApiContractId,
    96	                    $accessToken,
    97	                );
    98	
    99	                $this->finalizeJob($Job, $result, $message->getOrderId());
   100	            } catch (\Throwable $e) {
   101	                $this->failJob($Job, $e->getMessage());
   102	                $this->logger->error('Smaregi OTC delete handler failed', [
   103	                    'jobId' => $Job->getId(),
   104	                    'orderId' => $message->getOrderId(),
   105	                    'exception' => $e,
   106	                ]);
   107	            }
   108	        } finally {
   109	            $this->smaregiMessengerJobContext->clear();
   110	        }
   111	    }
   112	
   113	    private function finalizeJob(MessengerJob $Job, SmaregiOtcDeleteResult $result, int $orderId): void
   114	    {
   115	        if ($result === SmaregiOtcDeleteResult::DELETE_FAILED) {
   116	            $this->failJob($Job, sprintf('Smaregi OTC delete failed: result=%s', $result->value));
   117	
   118	            return;
   119	        }
   120	
   121	        $Job->setStatus(MessengerJob::STATUS_COMPLETED);
   122	        $Job->setCompletedAt(new \DateTime());
   123	        $Job->setErrorMessage(null);
   124	        $this->entityManager->flush();
   125	
   126	        $this->logger->info('Smaregi OTC delete handler completed', [
   127	            'jobId' => $Job->getId(),
   128	            'orderId' => $orderId,
   129	            'result' => $result->value,
   130	        ]);
