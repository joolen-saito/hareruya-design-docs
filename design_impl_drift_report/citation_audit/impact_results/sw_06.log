rg -n \"function sendNoSectionAlertMail|部門未設定|count\\(\\"'$products'"\\)|件数\" src/Eccube/Service/MailService.php
nl -ba src/Eccube/Service/MailService.php | sed -n '1340,1425p'
rg -n \"function sendOrderDuplicateNotificationMail|ポイント重複登録通知|TransportExceptionInterface\" src/Eccube/Service/MailService.php | tail -50
