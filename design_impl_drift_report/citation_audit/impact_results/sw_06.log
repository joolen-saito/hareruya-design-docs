   932	    /**
   933	     * @return array<int, array{product_name: string, product_code: string}>
   934	     */
   935	    public function getNoSectionProducts(\DateTime $summaryDate): array
   936	    {
   937	        // 集計区間
   938	        $from = clone $summaryDate;
   939	        $to = (clone $summaryDate)->modify('23:59:59');
   940	
   941	        // 部門未設定(null)の商品データ
   942	        $sql = <<<EOT
   943	            SELECT
   944	                p.name AS product_name,
   945	                pc.product_code AS product_code
   946	            FROM
   947	                dtb_otc_buy_order obo
   948	            JOIN
   949	                dtb_otc_buy_order_detail obod
   950	                ON obod.otc_buy_order_id = obo.id
   951	                AND obod.section_id IS NULL
   952	            JOIN
   953	                dtb_product_class pc ON pc.id = obod.product_class_id
   954	            JOIN
   955	                dtb_product p ON p.id = pc.product_id
   956	            WHERE
   957	                AND obo.complete_date >= :from
   958	                AND obo.complete_date <= :to
   959	            UNION
   960	            SELECT
   961	                oboi.name AS product_name,
   962	                '' AS product_code
   963	            FROM
   964	                dtb_otc_buy_order obo
   965	            JOIN
   966	                dtb_otc_buy_order_indivisual_input_product oboi
   967	                ON oboi.otc_buy_order_id = obo.id
   968	                AND oboi.section_id IS NULL
   969	            WHERE
   970	                AND obo.complete_date >= :from
   971	                AND obo.complete_date <= :to
   972	        EOT;
   973	
   974	        $rsm = new ResultSetMapping();
   975	        $rsm->addScalarResult('product_name', 'product_name')->addScalarResult(
   976	            'product_code',
   977	            'product_code',
   978	        );
   979	
   980	        return $this->getEntityManager()
   981	            ->createNativeQuery($sql, $rsm)
   982	            ->setParameters([
   983	                'from' => $from,
   984	                'to' => $to,
   985	            ])
   986	            ->getResult();
   987	    }
