    58	    #[\Override]
    59	    protected function execute(InputInterface $input, OutputInterface $output): int
    60	    {
    61	        $io = new SymfonyStyle($input, $output);
    62	
    63	        $orderIdOption = $input->getOption('order-id');
    64	        if ($orderIdOption !== null) {
    65	            $orders = $this->loadSingleOrder((string) $orderIdOption, $io);
    66	            if ($orders === null) {
    67	                return Command::FAILURE;
    68	            }
    69	        } else {
    70	            $limitOption = $input->getOption('limit');
    71	            if (!is_string($limitOption) || !ctype_digit($limitOption) || (int) $limitOption < 1) {
    72	                $io->error('--limit は 1 以上の数値を指定してください。');
    73	
    74	                return Command::FAILURE;
    75	            }
    76	            $limit = (int) $limitOption;
    77	            $orders = $this->orderRepository->getDeleteSmaregiProduct($limit);
    78	        }
    79	
    80	        if ($orders === []) {
    81	            $io->success('対象受注はありません。');
    82	
    83	            return Command::SUCCESS;
    84	        }
    85	
    86	        $enqueued = 0;
    87	        $failed = 0;
    88	        foreach ($orders as $Order) {
    89	            try {
    90	                $Job = $this->dispatcher->dispatch($Order);
    91	                ++$enqueued;
    92	                $io->writeln(sprintf('  - orderId=%d jobId=%d enqueued', $Order->getId() ?? 0, $Job->getId() ?? 0));
    93	            } catch (\Throwable $e) {
    94	                ++$failed;
    95	                $this->logger->error('Smaregi OTC delete enqueue failed', [
    96	                    'orderId' => $Order->getId(),
    97	                    'error' => $e->getMessage(),
    98	                ]);
    99	                $io->writeln(sprintf('  - orderId=%d enqueue_failed: %s', $Order->getId() ?? 0, $e->getMessage()));
   100	            }
   101	        }
   102	
   103	        $message = sprintf('OTC delete enqueue completed: enqueued=%d failed=%d', $enqueued, $failed);
   104	
   105	        if ($failed > 0) {
   106	            $io->error($message);
   107	
   108	            return Command::FAILURE;
   109	        }
   110	
   111	        $io->success($message);
   112	
   113	        return Command::SUCCESS;
   114	    }
   115	
