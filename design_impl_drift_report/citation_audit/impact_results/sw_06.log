   122	            $io->error('--order-id は数値で指定してください。');
   123	
   124	            return null;
   125	        }
   126	        $Order = $this->orderRepository->find((int) $orderId);
   127	        if (!$Order instanceof Order) {
   128	            $io->error(sprintf('受注 ID %s が見つかりません。', $orderId));
