namespace Eccube\Controller\Admin\Analysis;

use Eccube\Controller\AbstractController;
use Eccube\Entity\BaseInfo;
use Eccube\Entity\Member;
use Eccube\Event\EccubeEvents;
use Eccube\Event\EventArgs;
use Eccube\Form\Type\Admin\Analysis\SummaryType;
use Eccube\Service\Admin\Analysis\AnalysisSummaryBuilder;
use Eccube\Service\Csv\Exporter\SummaryCsvExporterService;
use Symfony\Bridge\Twig\Attribute\Template;
use Symfony\Component\Form\FormInterface;
use Symfony\Component\HttpFoundation\RedirectResponse;
use Symfony\Component\HttpFoundation\Request;
use Symfony\Component\HttpFoundation\StreamedResponse;
use Symfony\Component\Routing\Attribute\Route;

class SummaryController extends AbstractController
{
    private const VIEW_KEY = 'admin.summary.search';

    /**
     * 集計結果テーブルの表示カラム（固定表示）。
     *
     * @var array<string, string>
     */
    private const RESULT_COLUMNS = [
        'store_name' => '店舗名',
        'order_amount_order' => '総売上',
        'cost' => '原価',
        'gross_profit' => '粗利益高',
        'order_count_order' => '販売点数',
        'buyer_count' => '取引数',
        'order_average_order' => '取引単価(平均)',
        'purchase_count' => '買取件数',
        'purchase_amount' => '買取金額',
        'discard_count' => '廃棄',
        'out_of_stock_count' => '欠品',
    ];

    public function __construct(
        private readonly AnalysisSummaryBuilder $analysisSummaryBuilder,
        private readonly SummaryCsvExporterService $summaryCsvExporterService,
    ) {
    }

    /**
     * @return array<string, mixed>
     */
    #[Route(path: '/%eccube_admin_route%/analysis/summary/daily', name: 'admin_summary_daily', methods: ['GET'])]
    #[Template(template: '@admin/Analysis/summary.twig')]
    public function daily(Request $request): array
    {
        $response = $this->buildInitialResponse($request, 'daily');

        $event = new EventArgs(
            [
                'response' => $response,
            ],
            $request
        );
        $this->eventDispatcher->dispatch($event, EccubeEvents::ADMIN_ANALYSIS_SUMMARY_DAILY_COMPLETE);

        return $response;
    }

    /**
     * @return array<string, mixed>
     */
    #[Route(path: '/%eccube_admin_route%/analysis/summary/monthly', name: 'admin_summary_monthly', methods: ['GET'])]
    #[Template(template: '@admin/Analysis/summary.twig')]
    public function monthly(Request $request): array
    {
        $response = $this->buildInitialResponse($request, 'monthly');

        $event = new EventArgs(
            [
                'response' => $response,
            ],
            $request
        );
        $this->eventDispatcher->dispatch($event, EccubeEvents::ADMIN_ANALYSIS_SUMMARY_MONTHLY_COMPLETE);

        return $response;
    }

    /**
     * @return array<string, mixed>
     */
    #[Route(path: '/%eccube_admin_route%/analysis/summary/result', name: 'admin_summary_result', methods: ['POST'])]
    #[Template(template: '@admin/Analysis/summary.twig')]
    public function result(Request $request): array
    {
        $summaryType = $this->normalizeSummaryType($request->request->all('admin_summary')['summary_type'] ?? null);
        $form = $this->createSummaryForm($summaryType);
        $form->handleRequest($request);

        if (!$form->isSubmitted() || !$form->isValid()) {
            $request->getSession()->remove(self::VIEW_KEY);

            return $this->buildSummaryResponse($this->normalizeSummaryType($form->get('summary_type')->getData()), $form);
        }

        $criteria = $this->extractSearchCriteria($form);
        if ($criteria === null) {
            $request->getSession()->remove(self::VIEW_KEY);

            return $this->buildInitialResponse($request, $this->normalizeSummaryType($form->get('summary_type')->getData()));
        }

        $request->getSession()->set(self::VIEW_KEY, [
            'summary_type' => $criteria['summary_type'],
            'summary_date_from' => $criteria['date_from']->format('Y-m-d'),
            'summary_date_to' => $criteria['date_to']->format('Y-m-d'),
            'mail_order_enabled' => $criteria['mail_order_enabled'],
            'store_sales_targets' => $criteria['store_sales_targets'],
        ]);

        $summaryData = $this->analysisSummaryBuilder->build(
            $criteria['summary_type'],
            $criteria['date_from'],
            $criteria['date_to'],
            $this->resolveTargetBaseInfoIds($criteria['mail_order_enabled'], $criteria['store_sales_targets']),
            $criteria['mail_order_enabled'],
            self::RESULT_COLUMNS
        );

        $event = new EventArgs(
            [
                'form' => $form,
            ],
            $request
        );
        $this->eventDispatcher->dispatch($event, EccubeEvents::ADMIN_ANALYSIS_SUMMARY_RESULT_COMPLETE);

        return $this->buildSummaryResponse(
            $criteria['summary_type'],
            $form,
            $summaryData['summary'],
            $summaryData['total'],
            self::RESULT_COLUMNS
        );
    }

    #[Route(path: '/%eccube_admin_route%/analysis/summary/export', name: 'admin_summary_export', methods: ['GET'])]
    public function export(Request $request): StreamedResponse|RedirectResponse
    {
        $viewData = $request->getSession()->get(self::VIEW_KEY);
        if (!is_array($viewData)) {
            $this->addError('検索条件がありません。先に検索を実行してください。', 'admin');

            return $this->redirectToRoute('admin_summary_daily');
        }

        $summaryType = $this->normalizeSummaryType($viewData['summary_type'] ?? null);
        $mailOrderEnabled = (bool) ($viewData['mail_order_enabled'] ?? false);

        $dateFrom = \DateTimeImmutable::createFromFormat('Y-m-d', (string) ($viewData['summary_date_from'] ?? ''));
        $dateTo = \DateTimeImmutable::createFromFormat('Y-m-d', (string) ($viewData['summary_date_to'] ?? ''));
        if ($dateFrom === false || $dateTo === false) {
            $this->addError('日付の形式が不正です。再度検索を実行してください。', 'admin');

            return $this->redirectToRoute('admin_summary_daily');
        }

        $event = new EventArgs(
            [
                'searchData' => $viewData,
            ],
            $request
        );
        $this->eventDispatcher->dispatch($event, EccubeEvents::ADMIN_ANALYSIS_SUMMARY_CSV_EXPORT);

        return $this->summaryCsvExporterService->export(
            $summaryType,
            $dateFrom,
            $dateTo,
            $this->resolveTargetBaseInfoIds(
                $mailOrderEnabled,
                is_iterable($viewData['store_sales_targets'] ?? null) ? $viewData['store_sales_targets'] : []
            ),
            $mailOrderEnabled
        );
    }

    /**
     * 集計タイプを 'daily' / 'monthly' に正規化する。
     */
    private function normalizeSummaryType(mixed $summaryType): string
    {
        return $summaryType === 'monthly' ? 'monthly' : 'daily';
    }

    /**
     * 集計フォームを生成する。集計タイプにより日付入力の形式（月次は yyyy-MM）が切り替わる。
     *
     * @param array<string, mixed>|null $data
     */
    private function createSummaryForm(string $summaryType, ?array $data = null): FormInterface
    {
        return $this->createForm(SummaryType::class, $data, [
            'monthly_date_inputs' => $summaryType === 'monthly',
        ]);
    }

    /**
     * 検索フォームから集計条件を取り出す。日付が未確定の場合は null を返す。
     *
     * @return array{summary_type: string, date_from: \DateTimeInterface, date_to: \DateTimeInterface, mail_order_enabled: bool, store_sales_targets: list<int>}|null
     */
    private function extractSearchCriteria(FormInterface $form): ?array
    {
        $dateFrom = $form->get('summary_date_from')->getData();
        $dateTo = $form->get('summary_date_to')->getData();
        if (!$dateFrom instanceof \DateTimeInterface || !$dateTo instanceof \DateTimeInterface) {
            return null;
        }

        $storeSalesTargets = $form->get('store_sales_targets')->getData();
        $targets = [];
        if (is_iterable($storeSalesTargets)) {
            foreach ($storeSalesTargets as $storeSalesTarget) {
                $targets[] = (int) $storeSalesTarget;
            }
        }

        return [
            'summary_type' => $this->normalizeSummaryType($form->get('summary_type')->getData()),
            'date_from' => $dateFrom,
            'date_to' => $dateTo,
            'mail_order_enabled' => (bool) ($form->get('mail_order_enabled')->getData() ?? false),
            'store_sales_targets' => $targets,
        ];
    }

    /**
     * @return array<string, mixed>
     */
    private function buildInitialResponse(Request $request, string $summaryType): array
    {
        $summaryType = $this->normalizeSummaryType($summaryType);
        $request->getSession()->remove(self::VIEW_KEY);

        [$dateFrom, $dateTo] = $this->resolveInitialSummaryDateRange($summaryType);
        $initialTargets = $this->resolveInitialSummaryTargets();

        $form = $this->createSummaryForm($summaryType, [
            'summary_type' => $summaryType,
            'summary_date_from' => $dateFrom,
            'summary_date_to' => $dateTo,
            'mail_order_enabled' => $initialTargets['mail_order_enabled'],
            'store_sales_targets' => $initialTargets['store_sales_targets'],
        ]);

        return $this->buildSummaryResponse($summaryType, $form);
    }

    /**
     * テンプレートへ渡す表示用コンテキストを組み立てる。
     * 集計タイプによる表示差分（メニュー・日付入力形式・ラベル判定）はすべてここで決定する。
     *
     * @param array<int, array<string, mixed>> $summary
     * @param array<string, mixed>             $total
     * @param array<string, string>            $columns
     *
     * @return array<string, mixed>
     */
    private function buildSummaryResponse(
        string $summaryType,
        FormInterface $form,
        array $summary = [],
        array $total = [],
        array $columns = [],
    ): array {
        $isMonthly = $summaryType === 'monthly';

        return [
            'searchForm' => $form->createView(),
            'summary' => $summary,
            'total' => $total,
            'columns' => $columns,
            'summaryType' => $summaryType,
            'summaryMenuKey' => $isMonthly ? 'analysis_summary_monthly' : 'analysis_summary_daily',
            'dateInputType' => $isMonthly ? 'month' : 'date',
            'isMonthlySummary' => $isMonthly,
        ];
    }

    /**
     * 集計期間の初期値を返す。
     * 月次: 2ヶ月前 ～ 当月、日次: 当月1日 ～ 当月末日。
     *
     * @return array{0: \DateTime, 1: \DateTime}
     */
    private function resolveInitialSummaryDateRange(string $summaryType): array

