        #summarySearchDetail #admin_summary_store_sales_targets {
            display: grid;
            grid-template-columns: repeat(4, minmax(160px, 1fr));
            gap: .5rem 1rem;
        }
        #summarySearchDetail #admin_summary_store_sales_targets .form-check {
            margin-bottom: 0;
        }
    </style>
{% endblock %}

{% block javascript %}
    <script nonce="{{ csp_nonce }}">
        $(function () {
            $('#admin_summary_store_sales_all').on('change', function () {
                const checked = $(this).prop('checked');
                $('input[id^="admin_summary_store_sales_targets_"]').prop('checked', checked);
            });

            document.querySelectorAll('input[name="admin_summary[summary_type]"]').forEach((input) => {
                input.addEventListener('change', function () {
                    if (!this.checked) {
                        return;
                    }
                    window.location.href = this.value === 'monthly'
                        ? '{{ path('admin_summary_monthly') }}'
                        : '{{ path('admin_summary_daily') }}';
                });
            });

            const summarySearchDetailEl = document.getElementById('summarySearchDetail');
            const summarySearchDetailToggleBtn = document.querySelector('[data-bs-target="#summarySearchDetail"]');
            if (summarySearchDetailEl && summarySearchDetailToggleBtn) {
                const toggleExpanded = summarySearchDetailToggleBtn.querySelector('.admin-product-search-detail-toggle-expanded');
                const toggleCollapsed = summarySearchDetailToggleBtn.querySelector('.admin-product-search-detail-toggle-collapsed');
                summarySearchDetailEl.addEventListener('shown.bs.collapse', function () {
                    if (toggleExpanded) { toggleExpanded.classList.remove('d-none'); }
                    if (toggleCollapsed) { toggleCollapsed.classList.add('d-none'); }
                    summarySearchDetailToggleBtn.setAttribute('aria-expanded', 'true');
                });
                summarySearchDetailEl.addEventListener('hidden.bs.collapse', function () {
                    if (toggleExpanded) { toggleExpanded.classList.add('d-none'); }
                    if (toggleCollapsed) { toggleCollapsed.classList.remove('d-none'); }
                    summarySearchDetailToggleBtn.setAttribute('aria-expanded', 'false');
                });
            }
        });
    </script>
{% endblock %}

{% block main %}
    {% set summaryPeriodLabel = isMonthlySummary|default(false)
        ? 'admin.analysis.summary.summary_month'|trans
        : 'admin.analysis.summary.summary_date'|trans %}
    <div class="c-outsideBlock search-box-inner">
        <form name="search_form" id="search_form" method="post" action="{{ path('admin_summary_result') }}">
            <div class="mb-3 text-center">
                <button type="button"
                        class="btn btn-ec-regular admin-product-search-detail-toggle px-3"
                        data-bs-toggle="collapse"
                        data-bs-target="#summarySearchDetail"
                        aria-expanded="true"
                        aria-controls="summarySearchDetail"
                        aria-label="{{ 'admin.analysis.summary.search_toggle'|trans }}"
                        title="{{ 'admin.analysis.summary.search_toggle'|trans }}">
                    <i class="fa fa-minus admin-product-search-detail-toggle-expanded" aria-hidden="true"></i>
                    <i class="fa fa-plus admin-product-search-detail-toggle-collapsed d-none" aria-hidden="true"></i>
                    <span class="visually-hidden">{{ 'admin.analysis.summary.search_toggle'|trans }}</span>
                </button>
            </div>
            <div class="c-subContents collapse ec-collapse show border rounded p-3 mb-0 bg-white" id="summarySearchDetail">
                <div class="row g-3 mb-3 summary-top-row">
                    <div class="col-12 col-md-6 summary-field">
                        <label class="col-form-label">{{ 'admin.analysis.summary.summary_type'|trans }}</label>
                        <div>
                            {{ form_widget(searchForm.summary_type) }}
                            {{ form_errors(searchForm.summary_type) }}
                        </div>
                    </div>
                    <div class="col-12 col-md-6 summary-field">
                        <label class="col-form-label">{{ summaryPeriodLabel }}</label>
                        <div class="form-group range">
                            {{ form_widget(searchForm.summary_date_from, {attr: {type: dateInputType|default('date')}}) }} ～ {{ form_widget(searchForm.summary_date_to, {attr: {type: dateInputType|default('date')}}) }}
                            {{ form_errors(searchForm.summary_date_from) }}
                            {{ form_errors(searchForm.summary_date_to) }}
                        </div>
                    </div>
                </div>

                <div class="summary-target-title">{{ 'admin.analysis.summary.summary_target'|trans }}</div>

                <div class="row g-3 mb-3">
                    <div class="col-12">
                        <div class="target-group-header">{{ 'admin.analysis.summary.mail_order_sales'|trans }}</div>
                        <div class="target-group-body">
                            {{ form_widget(searchForm.mail_order_enabled) }}
                            {{ form_errors(searchForm.mail_order_enabled) }}
                        </div>
                    </div>
                </div>

                <div class="row g-3 mb-3">
                    <div class="col-12">
                        <div class="target-group-header with-checkbox">
                            <span>{{ 'admin.analysis.summary.store_sales'|trans }}</span>
                            {{ form_widget(searchForm.store_sales_all) }}
                        </div>
                        <div class="target-group-body">
                            {{ form_errors(searchForm.store_sales_all) }}
                            {{ form_widget(searchForm.store_sales_targets) }}
                            {{ form_errors(searchForm.store_sales_targets) }}
                        </div>
                    </div>
                </div>
            </div>

            <div class="text-center my-4">
                <button type="submit" class="btn btn-ec-conversion px-5">
                    {{ 'admin.analysis.summary.search'|trans }} <i class="fa fa-angle-right ms-1" aria-hidden="true"></i>
                </button>
            </div>
        </form>
    </div>

{% if summary %}
    <div id="result_list" class="row">
        <div class="col-12">
            <div id="result_list_main" class="box">
                <div id="result_list__menu" class="row mb-3">
                    <div class="col-md-12 d-flex justify-content-end">
