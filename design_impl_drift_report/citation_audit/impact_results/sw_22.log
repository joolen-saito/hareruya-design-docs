namespace Eccube\Service\Admin\Analysis;

use Doctrine\ORM\EntityManagerInterface;
use Eccube\Repository\DtbDailySummaryRepository;
use Eccube\Repository\DtbMonthlySummaryRepository;

class BatchAggregateMonthlySummaryAction
{
    public function __construct(
        private readonly EntityManagerInterface $entityManager,
        private readonly DtbDailySummaryRepository $dailySummaryRepository,
        private readonly DtbMonthlySummaryRepository $monthlySummaryRepository,
    ) {
    }

    public function handle(\DateTimeInterface $targetMonth): int
    {
        $monthStart = \DateTimeImmutable::createFromInterface($targetMonth)->modify('first day of this month')->setTime(0, 0, 0);
        $monthEnd = $monthStart->modify('last day of this month')->setTime(23, 59, 59);

        // 月内の日次集計を店舗ごとに合算する（sale_average は合算値ではないためここで算出する）
        $dailyTotals = $this->dailySummaryRepository->aggregateMonthlyTotalsByBaseInfo($monthStart, $monthEnd);

        $connection = $this->entityManager->getConnection();
        $connection->beginTransaction();
        try {
            // 再集計に備え、対象月の既存集計を一旦すべて削除してから登録し直す。
            // 失敗時はトランザクションごとロールバックされ、削除前の状態に戻る。
            $this->monthlySummaryRepository->deleteBySummaryMonth($monthStart);

            $affected = 0;
            foreach ($dailyTotals as $row) {
                $baseInfoId = (int) ($row['base_info_id'] ?? 0);
                $grossSales = (int) ($row['gross_sales'] ?? 0);
                $saleCount = (int) ($row['sale_count'] ?? 0);
                $saleAverage = $saleCount > 0
                    ? (int) ceil($grossSales / $saleCount)
                    : 0;

                $this->monthlySummaryRepository->insertMonthlySummary(
                    $monthStart,
                    $baseInfoId,
                    [
                        'gross_sales' => $grossSales,
                        'total_cost' => (int) ($row['total_cost'] ?? 0),
                        'gross_profit' => (int) ($row['gross_profit'] ?? 0),
                        'sale_quantity' => (int) ($row['sale_quantity'] ?? 0),
                        'sale_count' => $saleCount,
                        'sale_average' => $saleAverage,
                        'purchase_count' => (int) ($row['purchase_count'] ?? 0),
                        'purchase_amount' => (int) ($row['purchase_amount'] ?? 0),
                        'waste_count' => (int) ($row['waste_count'] ?? 0),
                        'shortage_count' => (int) ($row['shortage_count'] ?? 0),
                    ]
                );
                ++$affected;
            }

            $connection->commit();

            return $affected;
        } catch (\Throwable $e) {
            $connection->rollBack();
            throw $e;
        }
    }
}
