class SalesType extends AbstractType
{
    public function __construct(
        private readonly BaseInfoRepository $baseInfoRepository,
    ) {
    }

    public const DATE_TYPE = [
        'admin.analysis.sales.date_type.order_date' => 'order_date',
        'admin.analysis.sales.date_type.confirm_date' => 'confirm_date',
        'admin.analysis.sales.date_type.payment_date' => 'payment_date',
        'admin.analysis.sales.date_type.shipping_date' => 'shipping_date',
        'admin.analysis.sales.date_type.closing_date' => 'closing_date',
        'admin.analysis.sales.date_type.cancel_date' => 'cancel_date',
    ];

    public const SUMMARY_TYPE = [
        'admin.analysis.sales.summary_type.product' => 'product_id',
        'admin.analysis.sales.summary_type.category' => 'class_category_name',
    ];

    public const SORT_KEYS = [
        'admin.analysis.sales.sort_key.summary_type' => 'summary_type',
        'admin.analysis.sales.sort_key.order_count' => 'order_count',
        'admin.analysis.sales.sort_key.total' => 'total',
        'admin.analysis.sales.sort_key.sales' => 'sales',
    ];

    public const CARD_CONDITIONS = [
        MtbCardCondition::CODE_NEAR_MINT => MtbCardCondition::NM,
        MtbCardCondition::CODE_SLIGHTLY_PLAYED => MtbCardCondition::SP,
        MtbCardCondition::CODE_MODERATELY_PLAYED => MtbCardCondition::MP,
        MtbCardCondition::CODE_HEAVY_PLAYED => MtbCardCondition::HP,
    ];

    public const PAGE_COUNTS = [
        '10' => 10,
        '50' => 50,
        '100' => 100,
        '300' => 300,
        '500' => 500,
        '1000' => 1000,
        '2000' => 2000,
        '10000' => 10000,
        '12000' => 12000,
        '15000' => 15000,
        '20000' => 20000,
    ];

    /** {@inheritdoc} */
    public function configureOptions(OptionsResolver $resolver): void
    {
        $resolver->setDefaults([
            'csrf_protection' => false,
        ]);
    }

    /** {@inheritdoc} */
    public function buildForm(FormBuilderInterface $builder, array $options): void
    {
        $builder
            ->add('multi', TextType::class, [
                'required' => false,
                'attr' => ['placeholder' => 'admin.analysis.sales.form.multi.placeholder'],
            ])
            ->add('summary_date_from', DateTimeType::class, [
                'required' => false,
                'input' => 'datetime',
                'widget' => 'single_text',
                'with_seconds' => true,
                'data' => new \DateTime('first day of this month 00:00:00'),
            ])
            ->add('summary_date_to', DateTimeType::class, [
                'required' => false,
                'input' => 'datetime',
                'widget' => 'single_text',
                'with_seconds' => true,
                'data' => new \DateTime('last day of this month 23:59:59'),
            ])
            ->add('date_type', ChoiceType::class, [
                'required' => false,
                'expanded' => true,
                'multiple' => false,
                'placeholder' => false,
                'choices' => self::DATE_TYPE,
                'choice_translation_domain' => 'messages',
                'data' => 'order_date',
            ])
            ->add('summary_type', ChoiceType::class, [
                'required' => false,
                'expanded' => false,
                'multiple' => false,
                'placeholder' => false,
                'choices' => self::SUMMARY_TYPE,
                'choice_translation_domain' => 'messages',
                'data' => 'product_id',
            ])
            ->add('sort_key', ChoiceType::class, [
                'required' => false,
                'expanded' => false,
                'multiple' => false,
                'placeholder' => false,
                'choices' => self::SORT_KEYS,
                'choice_translation_domain' => 'messages',
                'data' => 'summary_type',
            ])
            ->add('asc_desc', ChoiceType::class, [
                'required' => false,
                'expanded' => true,
                'multiple' => false,
                'placeholder' => false,
                'choices' => [
                    'admin.analysis.sales.form.asc' => 'ASC',
                    'admin.analysis.sales.form.desc' => 'DESC',
                ],
                'choice_translation_domain' => 'messages',
                'data' => 'ASC',
            ])
            ->add('page_count', ChoiceType::class, [
                'required' => false,
                'placeholder' => false,
                'choices' => self::PAGE_COUNTS,
                'choice_translation_domain' => false,
                'data' => 10,
            ])
            ->add('category_id', EntityType::class, [
                'required' => false,
                'class' => Category::class,
                'choice_label' => 'name',
                'placeholder' => 'admin.common.select',
                'query_builder' => fn (EntityRepository $er) => $er->createQueryBuilder('c')
                    ->orderBy('c.sort_no', 'DESC'),
            ])
            ->add('card_condition', ChoiceType::class, [
                'required' => false,
                'expanded' => true,
                'multiple' => true,
                'choices' => self::CARD_CONDITIONS,
                'choice_translation_domain' => false,
            ])
            ->add('tag_sales_analysis', EntityType::class, [
                'required' => false,
                'class' => MtbTagSalesAnalysis::class,
                'choice_label' => 'name',
                'multiple' => true,
                'expanded' => false,
                'query_builder' => fn (EntityRepository $er) => $er->createQueryBuilder('t')
                    ->orderBy('t.rank', 'ASC')
                    ->addOrderBy('t.id', 'ASC'),
                'attr' => ['class' => 'select2-select'],
            ])
            ->add('cardset', EntityType::class, [
                'required' => false,
                'class' => MtbCardset::class,
                'choice_label' => 'name_jp',
                'multiple' => true,
                'expanded' => false,
                'attr' => ['class' => 'select2-select'],
            ])
            ->add('price_from', IntegerType::class, [
                'required' => false,
            ])
            ->add('price_to', IntegerType::class, [
                'required' => false,
            ])
            ->add('quantity_from', IntegerType::class, [
                'required' => false,
            ])
            ->add('quantity_to', IntegerType::class, [
                'required' => false,
            ])
            ->add('mail_order_enabled', CheckboxType::class, [
                'required' => false,
                'label' => 'admin.analysis.summary.mail_order',
            ])
            ->add('store_sales_all', CheckboxType::class, [
                'required' => false,
                'label' => 'admin.analysis.sales.form.store_sales_all',
            ])
            ->add('store_sales_targets', ChoiceType::class, [
                'required' => false,
                'expanded' => true,
                'multiple' => true,
                'choices' => $this->getPublishedStoreChoices(),
            ]);
    }

    /**
     * @return array<string, int>
     */
    private function getPublishedStoreChoices(): array
    {
        $BaseInfos = $this->baseInfoRepository->getPublicTenantShopsForSummary();
        $choices = [];

        foreach ($BaseInfos as $BaseInfo) {
            $label = trim($BaseInfo->getShortNameJp());
            if ($label === '') {
                $label = (string) ($BaseInfo->getShopName() ?? '');
            }
            if ($label === '') {
                continue;
            }
            $id = $BaseInfo->getId();
            if ($id === null) {
                continue;
            }
            $uniqueLabel = $label;
            if (isset($choices[$uniqueLabel])) {
                $uniqueLabel = sprintf('%s (ID:%d)', $label, $id);
            }
            $choices[$uniqueLabel] = $id;
        }

        return $choices;
    }

    /** {@inheritdoc} */
    #[\Override]
    public function getBlockPrefix(): string
    {
        return 'admin_analysis_sales';
    }
