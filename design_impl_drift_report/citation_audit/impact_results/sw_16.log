   330	    private function createStockEditLineItemsQueryBuilder(array $approvalListIds): DbalQueryBuilder
   331	    {
   332	        $connection = $this->getEntityManager()->getConnection();
   333	
   334	        $qb = $connection->createQueryBuilder();
   335	        $qb
   336	            ->select(
   337	                'p.name AS product_name',
   338	                'pc.product_code AS product_code',
   339	                'lang.name_jp AS language_name_jp',
   340	                'cc.name_jp AS card_condition_name_jp',
   341	                'cd.foil_flg AS foil_flg',
   342	                'bi.shop_name AS shop_name',
   343	                'ps.stock_location_id AS stock_location_id',
   344	                'sad.before_edit_quantity AS before_edit_quantity',
   345	                'sad.edit_quantity AS edit_quantity',
   346	                'sad.purchase_unit_price AS purchase_unit_price',
   347	                'sad.before_purchase_unit_price AS before_purchase_unit_price',
   348	                'sad.stock_change_reason AS stock_change_reason',
   349	                'sct.name AS stock_change_type_parent_name',
   350	                'sctd.child_name AS stock_change_type_child_name',
   351	                'sa.registered_at AS registered_at',
   352	                'm_reg.name AS registered_member_name',
   353	                'sa.approved_at AS approved_at',
   354	                'm_appr.name AS approver_name',
   355	                'sal.approved_date AS sort_approved_date',
   356	                'sal.registered_date AS sort_registered_date',
   357	                'sal.id AS sort_sal_id',
   358	                'sad.id AS sort_sad_id'
   359	            )
   360	            ->from('dtb_stock_approval_list', 'sal')
   361	            ->innerJoin('sal', 'dtb_stock_edit_approval_detail', 'sad', 'sal.history_source_id = sad.stock_edit_approval_id')
   362	            ->innerJoin('sad', 'dtb_stock_edit_approval', 'sa', 'sad.stock_edit_approval_id = sa.id')
   363	            ->innerJoin('sad', 'dtb_product_stock', 'ps', 'sad.product_stock_id = ps.id')
   364	            ->innerJoin('ps', 'dtb_product_class', 'pc', 'ps.product_class_id = pc.id')
   365	            ->innerJoin('pc', 'dtb_product', 'p', 'pc.product_id = p.id')
   366	            ->innerJoin('ps', 'dtb_base_info', 'bi', 'ps.base_info_id = bi.id')
   367	            ->innerJoin('sa', 'dtb_member', 'm_reg', 'sa.registered_member_id = m_reg.id')
   368	            ->leftJoin('sa', 'dtb_member', 'm_appr', 'sa.approval_member_id = m_appr.id')
   369	            ->leftJoin('pc', 'mtb_language', 'lang', 'pc.language_id = lang.id')
   370	            ->leftJoin('pc', 'mtb_card_condition', 'cc', 'pc.card_condition_id = cc.id')
   371	            ->leftJoin('p', 'mtb_card_detail', 'cd', 'p.card_detail_id = cd.id')
   372	            ->leftJoin('sa', 'mtb_stock_change_type_detail', 'sctd', 'sa.stock_change_type_detail_id = sctd.id')
   373	            ->leftJoin('sctd', 'mtb_stock_change_type', 'sct', 'sctd.stock_change_type_id = sct.id')
   374	            ->where('sal.history_source_type_id IN (:stockEditTypes)')
   375	            ->andWhere('sal.id IN (:ids)')
   376	            ->setParameter('stockEditTypes', [
   377	                MtbStockHistorySourceType::STOCK_EDIT,
   378	                MtbStockHistorySourceType::STOCK_BULK_EDIT,
   379	                MtbStockHistorySourceType::STOCK_CHANGE_CSV_IMPORT,
   380	            ], ArrayParameterType::INTEGER)
   381	            ->setParameter('ids', $approvalListIds, ArrayParameterType::INTEGER)
   382	            ->orderBy('sal.approved_date', 'DESC')
   383	            ->addOrderBy('sal.registered_date', 'ASC')
   384	            ->addOrderBy('sal.id', 'ASC')
   385	            ->addOrderBy('sad.id', 'DESC');
   386	
   387	        return $qb;
   388	    }
