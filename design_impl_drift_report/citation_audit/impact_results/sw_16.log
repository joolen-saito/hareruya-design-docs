    72	                } elseif ($stockChangeTypeId === MtbStockChangeType::TRANSFER) {
    73	                    $approvalTargetLabel = 'admin.stock.approval_list.approval_target_stock_transfer';
    74	                    $approvalTargetLink = $this->urlGenerator->generate('admin_stock_transfer', ['id' => $ApprovalList->getHistorySourceId()]);
