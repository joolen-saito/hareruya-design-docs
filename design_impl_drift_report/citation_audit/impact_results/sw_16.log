   255	    public function countStockEditLineItemsForApprovalListIds(array $approvalListIds): int
   256	    {
   257	        if ($approvalListIds === []) {
   258	            return 0;
   259	        }
   260	
   261	        $sql = <<<'SQL'
   262	SELECT COUNT(sad.id)
   263	FROM dtb_stock_approval_list sal
   264	INNER JOIN dtb_stock_edit_approval_detail sad ON sal.history_source_id = sad.stock_edit_approval_id
   265	INNER JOIN dtb_stock_edit_approval sa ON sad.stock_edit_approval_id = sa.id
   266	INNER JOIN dtb_product_stock ps ON sad.product_stock_id = ps.id
   267	INNER JOIN dtb_product_class pc ON ps.product_class_id = pc.id
   268	INNER JOIN dtb_product p ON pc.product_id = p.id
   269	INNER JOIN dtb_base_info bi ON ps.base_info_id = bi.id
   270	WHERE sal.history_source_type_id IN (:stockEditTypes)
   271	AND sal.id IN (:ids)
   272	SQL;
   273	
   274	        return (int) $this->getEntityManager()->getConnection()->fetchOne(
   275	            $sql,
   276	            [
   277	                'stockEditTypes' => [
   278	                    MtbStockHistorySourceType::STOCK_EDIT,
   279	                    MtbStockHistorySourceType::STOCK_BULK_EDIT,
   280	                    MtbStockHistorySourceType::STOCK_CHANGE_CSV_IMPORT,
   281	                ],
   282	                'ids' => $approvalListIds,
   283	            ],
   284	            [
   285	                'stockEditTypes' => ArrayParameterType::INTEGER,
   286	                'ids' => ArrayParameterType::INTEGER,
   287	            ]
   288	        );
   289	    }
