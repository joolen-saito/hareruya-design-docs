    76	
    77	                $approvalTargetLinkOpenType = '_blank';
    78	            } elseif ($typeId === MtbStockHistorySourceType::STOCK_SPLIT_EDIT) {
    79	                $approvalTargetLink = $this->urlGenerator->generate('admin_stock_split_approval', ['id' => $ApprovalList->getHistorySourceId()]);
    80	                $approvalTargetLinkOpenType = '_blank';
    81	            } elseif ($typeId === MtbStockHistorySourceType::STOCK_JOIN_EDIT) {
    82	                $approvalTargetLink = $this->urlGenerator->generate('admin_stock_join_approval', ['id' => $ApprovalList->getHistorySourceId()]);
    83	                $approvalTargetLinkOpenType = '_blank';
    84	            }
    85	
    86	            /** @var ?Member $user */
    87	            $user = $this->context->getCurrentUser();
    88	            $currentMemberId = $user?->getId();
    89	
    90	            $isBulkActionable = in_array($typeId, self::BULK_ACTIONABLE_HISTORY_SOURCE_TYPE_IDS, true)
    91	                && $ApprovalList->getApprovalStatus() === DtbStockApprovalList::APPROVAL_STATUS_UNAPPROVED
    92	                && $ApprovalList->getRegisteredMember()->getId() !== $currentMemberId; // 登録者と現在のログインユーザーが違う場合のみ一括操作を可能にする
