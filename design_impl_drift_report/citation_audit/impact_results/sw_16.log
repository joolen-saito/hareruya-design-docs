    16	namespace Eccube\Repository;
    17	
    18	use Doctrine\ORM\QueryBuilder;
    19	use Doctrine\Persistence\ManagerRegistry;
    20	use Eccube\Entity\DtbStockMoveInstruction;
    21	
    22	/**
    23	 * @extends AbstractRepository<DtbStockMoveInstruction>
    24	 */
    25	class DtbStockMoveInstructionRepository extends AbstractRepository
    26	{
    27	    public function __construct(ManagerRegistry $registry)
    28	    {
    29	        parent::__construct($registry, DtbStockMoveInstruction::class);
    30	    }
    31	
    32	    /**
    33	     * 検索条件でQueryBuilderを取得
    34	     *
    35	     * @param array<string, mixed> $searchData 検索条件
    36	     */
    37	    public function getQueryBuilderBySearchData(array $searchData): QueryBuilder
    38	    {
    39	        $qb = $this->createQueryBuilder('s')
    40	            ->select('s')
    41	            ->leftJoin('s.MoveFromBaseInfo', 'mfrom')
    42	            ->leftJoin('s.MoveToBaseInfo', 'mto')
    43	            ->leftJoin('s.RegisteredMember', 'reg_member')
    44	            ->addSelect('mfrom', 'mto', 'reg_member')
    45	            ->orderBy('s.createDate', 'DESC');
    46	
    47	        if (!empty($searchData['move_from_base_info'])) {
    48	            $qb
    49	                ->andWhere('s.MoveFromBaseInfo = :move_from_base_info')
    50	                ->setParameter('move_from_base_info', $searchData['move_from_base_info']);
    51	        }
    52	
    53	        if (!empty($searchData['move_to_base_info'])) {
    54	            $qb
    55	                ->andWhere('s.MoveToBaseInfo = :move_to_base_info')
    56	                ->setParameter('move_to_base_info', $searchData['move_to_base_info']);
    57	        }
    58	
    59	        $instructionId = isset($searchData['instruction_id']) ? trim((string) $searchData['instruction_id']) : '';
    60	        if ($instructionId !== '') {
    61	            $qb
    62	                ->andWhere('CONCAT(s.id, \'\') LIKE :instruction_id')
    63	                ->setParameter('instruction_id', '%'.addcslashes($instructionId, '%_').'%');
    64	        }
    65	
    66	        $stockMoveTransferId = isset($searchData['stock_move_transfer_id']) ? trim((string) $searchData['stock_move_transfer_id']) : '';
    67	        if ($stockMoveTransferId !== '') {
    68	            $qb->leftJoin(
    69	                'Eccube\Entity\DtbStockMoveTransfer',
    70	                't',
    71	                'WITH',
    72	                't.moveInstructionId = s.id'
    73	            )
    74	                ->andWhere('CONCAT(t.id, \'\') = :stock_move_transfer_id')
    75	                ->setParameter('stock_move_transfer_id', $stockMoveTransferId)
    76	                ->distinct();
    77	        }
    78	
    79	        if (!empty($searchData['create_date_start'])) {
    80	            $qb
    81	                ->andWhere('s.createDate >= :create_date_start')
    82	                ->setParameter('create_date_start', $searchData['create_date_start']);
    83	        }
    84	
    85	        if (!empty($searchData['create_date_end'])) {
    86	            $date = clone $searchData['create_date_end'];
    87	            $date->modify('+1 days');
    88	            $qb
    89	                ->andWhere('s.createDate < :create_date_end')
    90	                ->setParameter('create_date_end', $date);
    91	        }
    92	
    93	        if (!empty($searchData['update_date_start'])) {
    94	            $qb
    95	                ->andWhere('s.updateDate >= :update_date_start')
    96	                ->setParameter('update_date_start', $searchData['update_date_start']);
    97	        }
    98	
    99	        if (!empty($searchData['update_date_end'])) {
   100	            $date = clone $searchData['update_date_end'];
   101	            $date->modify('+1 days');
   102	            $qb
   103	                ->andWhere('s.updateDate < :update_date_end')
   104	                ->setParameter('update_date_end', $date);
   105	        }
   106	
   107	        // 発送状況: 送り状Noの有無で「済」「未」を判定（チェックしたものだけ絞り込み）
   108	        $done = !empty($searchData['shipment_status_done']);
   109	        $notDone = !empty($searchData['shipment_status_not_done']);
   110	        if ($done && !$notDone) {
   111	            $qb->andWhere('s.trackingNo IS NOT NULL AND s.trackingNo != :empty_str')
   112	                ->setParameter('empty_str', '');
   113	        }
   114	        if ($notDone && !$done) {
   115	            $qb->andWhere('s.trackingNo IS NULL OR s.trackingNo = :empty_str_not_done')
   116	                ->setParameter('empty_str_not_done', '');
   117	        }
   118	
   119	        return $qb;
   120	    }
   121	
   122	    /**
   123	     * 在庫移動指示IDごとの移動原価合計（DtbStockMoveTransferDetail の集計値）.
   124	     *
   125	     * DtbStockMoveInstruction.outboundTotalCost は作成時点では 0 のため、
   126	     * 表示時は転送明細から実績値を集計して使用する。
   127	     *
   128	     * @param list<int> $instructionIds
   129	     *
   130	     * @return array<int, string> [instructionId => outbound_total_cost]
   131	     */
   132	    public function getOutboundTotalCostByIds(array $instructionIds): array
   133	    {
   134	        if ($instructionIds === []) {
   135	            return [];
   136	        }
   137	
   138	        $rows = $this->createQueryBuilder('i')
   139	            ->select('i.id AS instruction_id')
   140	            ->addSelect('COALESCE(SUM(d.outboundTotalCost), 0) AS outbound_total_cost')
   141	            ->innerJoin('Eccube\Entity\DtbStockMoveTransfer', 't', 'WITH', 't.moveInstructionId = i.id')
   142	            ->innerJoin('Eccube\Entity\DtbStockMoveTransferDetail', 'd', 'WITH', 'd.StockMoveTransfer = t')
   143	            ->where('i.id IN (:ids)')
   144	            ->setParameter('ids', $instructionIds)
   145	            ->groupBy('i.id')
   146	            ->getQuery()
   147	            ->getArrayResult();
   148	
   149	        $result = [];
   150	        foreach ($rows as $row) {
   151	            $result[(int) $row['instruction_id']] = (string) $row['outbound_total_cost'];
   152	        }
   153	
   154	        return $result;
   155	    }
   156	
   157	    /**
   158	     * 指示に紐づく在庫移動振替IDごとの集計（移動点数・基準価格合計・移動原価合計・高額商品合計・通常商品合計）.
   159	     *
   160	     * 高額/通常は instruction.moveFromPriceThreshold を閾値として product_class.standard_price で判定する。
   161	     *
   162	     * @param list<int> $transferIds   集計対象の在庫移動振替ID
   163	     * @param int       $priceThreshold 出庫元店舗の高額商品閾値（DtbStockMoveInstruction.moveFromPriceThreshold）
   164	     *
   165	     * @return array<int, array{quantity: int, standard_total: string, outbound_total_cost: string, high_total: string, regular_total: string}>
   166	     */
   167	    public function getTransferAggregatesByTransferIds(array $transferIds, int $priceThreshold): array
   168	    {
   169	        if ($transferIds === []) {
   170	            return [];
   171	        }
   172	
   173	        $rows = $this->createQueryBuilder('i')
   174	            ->select('t.id AS transfer_id')
   175	            ->addSelect('COALESCE(SUM(d.moveTransferQuantity), 0) AS move_transfer_quantity')
   176	            ->addSelect('COALESCE(SUM(d.standardTotalPrice), 0) AS standard_total_price')
   177	            ->addSelect('COALESCE(SUM(d.outboundTotalCost), 0) AS outbound_total_cost')
   178	            ->addSelect('COALESCE(SUM(CASE WHEN pc.standardPrice >= :threshold THEN d.standardTotalPrice ELSE 0 END), 0) AS high_total_price')
   179	            ->addSelect('COALESCE(SUM(CASE WHEN pc.standardPrice < :threshold THEN d.standardTotalPrice ELSE 0 END), 0) AS regular_total_price')
   180	            ->innerJoin('Eccube\Entity\DtbStockMoveTransfer', 't', 'WITH', 't.moveInstructionId = i.id')
   181	            ->innerJoin('Eccube\Entity\DtbStockMoveTransferDetail', 'd', 'WITH', 'd.StockMoveTransfer = t')
   182	            ->innerJoin('Eccube\Entity\ProductStock', 'ps', 'WITH', 'ps = d.MoveFromProductStock')
   183	            ->innerJoin('Eccube\Entity\ProductClass', 'pc', 'WITH', 'pc = ps.ProductClass')
   184	            ->where('t.id IN (:ids)')
   185	            ->setParameter('ids', $transferIds)
   186	            ->setParameter('threshold', $priceThreshold)
   187	            ->groupBy('t.id')
   188	            ->getQuery()
   189	            ->getArrayResult();
   190	
   191	        $aggregates = [];
   192	
   193	        foreach ($rows as $row) {
   194	            $highTotal = (string) $row['high_total_price'];
   195	            $regularTotal = (string) $row['regular_total_price'];
   196	            if ($priceThreshold === 0) {
   197	                $regularTotal = bcadd($highTotal, $regularTotal, 2);
   198	                $highTotal = '0';
   199	            }
   200	            $aggregates[(int) $row['transfer_id']] = [
   201	                'quantity' => (int) $row['move_transfer_quantity'],
   202	                'standard_total' => (string) $row['standard_total_price'],
   203	                'outbound_total_cost' => (string) $row['outbound_total_cost'],
   204	                'high_total' => $highTotal,
   205	                'regular_total' => $regularTotal,
   206	            ];
   207	        }
   208	
   209	        return $aggregates;
   210	    }
   211	
   212	    /**
   213	     * 送り状CSV用の移動指示一覧を取得
   214	     *
   215	     * @param int[] $ids 移動指示ID
   216	     *
   217	     * @return array<int, DtbStockMoveInstruction>
   218	     */
   219	    public function findByIdsForLabelExport(array $ids): array
   220	    {
   221	        if ($ids === []) {
   222	            return [];
   223	        }
   224	
   225	        return $this->createQueryBuilder('s')
   226	            ->select('s')
   227	            ->innerJoin('s.MoveFromBaseInfo', 'mfrom')->addSelect('mfrom')
   228	            ->leftJoin('mfrom.Pref', 'mfromPref')->addSelect('mfromPref')
   229	            ->innerJoin('s.MoveToBaseInfo', 'mto')->addSelect('mto')
   230	            ->leftJoin('mto.Pref', 'mtoPref')->addSelect('mtoPref')
   231	            ->where('s.id IN (:ids)')
   232	            ->setParameter('ids', $ids)
   233	            ->orderBy('s.id', 'ASC')
   234	            ->getQuery()
   235	            ->getResult();
   236	    }
   237	}

