    99	            $approvalMemberName = $ApprovalMember !== null ? ($ApprovalMember->getName() ?? null) : null;
   100	
   101	            // 編集・一括編集・変更CSV・分割・結合、合計在庫増減数・合計総原価増減数・在庫変動区分を表示
   102	            if ($typeId === MtbStockHistorySourceType::STOCK_EDIT
   103	                || $typeId === MtbStockHistorySourceType::STOCK_BULK_EDIT
   104	                || $typeId === MtbStockHistorySourceType::STOCK_CHANGE_CSV_IMPORT
   105	                || $typeId === MtbStockHistorySourceType::STOCK_SPLIT_EDIT
   106	                || $typeId === MtbStockHistorySourceType::STOCK_JOIN_EDIT) {
   107	                $totalChangeQuantity = $ApprovalList->getInventoryChangeTotalCount();
   108	                $totalCostChange = '¥'.number_format($ApprovalList->getTotalCostPriceBefore());
   109	                $changeTypeDetailName = $ApprovalList->getChangeTypeParentLabel().'/'.$ApprovalList->getChangeTypeChildLabel();
   110	            } else {
   111	                $totalChangeQuantity = '-';
   112	                $totalCostChange = '-';
   113	                $changeTypeDetailName = '-';
   114	            }
   115	
   116	            $rows[] = [
   117	                'id' => $ApprovalList->getId(),
   118	                'approval_status_id' => $ApprovalList->getApprovalStatus(),
   119	                'approval_status_label' => $ApprovalList->getApprovalStatusLabel(),
   120	                'approval_target_label' => $approvalTargetLabel,
   121	                'approval_target_link' => $approvalTargetLink,
   122	                'approval_target_link_open_type' => $approvalTargetLinkOpenType,
   123	                'is_bulk_actionable' => $isBulkActionable,
   124	                'store_name' => $storeName,
   125	                'stock_location_id' => $ApprovalList->getStockLocationId(),
   126	                'stock_location_name' => $locationNames[$ApprovalList->getStockLocationId()] ?? '-',
   127	                'target_product_count' => $ApprovalList->getProductStockTotalCount(),
   128	                'total_change_quantity' => $totalChangeQuantity,
   129	                'total_cost_change' => $totalCostChange,
   130	                'change_type_detail_name' => $changeTypeDetailName,
   131	                'registered_date' => $ApprovalList->getRegisteredDate(),
   132	                'registered_member_name' => $registeredMemberName,
   133	                'approved_date' => $ApprovalList->getApprovedDate(),
   134	                'approval_member_name' => $approvalMemberName,
   135	            ];
   136	        }
   137	
   138	        return $rows;
   139	    }
