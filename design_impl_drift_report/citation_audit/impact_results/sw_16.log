    22	use Symfony\Component\HttpFoundation\StreamedResponse;
    23	
    24	/**
    25	 * 在庫移動・振替 戻しリストCSV
    26	 */
    27	class StockMoveTransferReturnListCsvExportService
    28	{
    29	    /**
    30	     * @var array<string, string>
    31	     */
    32	    public const CSV_HEADER = [
    33	        'pickingType' => 'ピッキング区分',
    34	        'shelfNumber' => '棚番号',
    35	        'languageAndCondition' => '言語/状態',
    36	        'storageCode' => '略称',
    37	        'colorAndRarity' => '色/R',
    38	        'quantity' => '数',
    39	        'productName' => '商品名',
    40	        'standardPrice' => '基準価格',
    41	    ];
    42	
    43	    /** 戻しリスト出力が許可されるステータス */
    44	    private const ALLOWED_STATUS_IDS = [
    45	        MtbStockMoveTransferStatus::STATUS_MOVING,
    46	        MtbStockMoveTransferStatus::STATUS_INBOUND_APPROVAL_PENDING,
    47	        MtbStockMoveTransferStatus::STATUS_INBOUND_APPROVED,
    48	    ];
    49	
    50	    public function __construct(
    51	        protected CsvExportService $csvExportService,
    52	        protected DtbStockMoveTransferRepository $stockMoveTransferRepository,
    53	        protected RestockListCsvRowFormatter $restockListCsvRowFormatter,
    54	    ) {
    55	    }
    56	
    57	    /**
    58	     * @param array<int, int> $stockMoveTransferIds
    59	     */
    60	    public function exportByIds(array $stockMoveTransferIds): StreamedResponse
    61	    {
    62	        $header = self::CSV_HEADER;
    63	        $headerKeys = array_keys($header);
    64	
    65	        $response = new StreamedResponse();
    66	        $response->setCallback(function () use ($header, $headerKeys, $stockMoveTransferIds): void {
    67	            $this->csvExportService->fopen();
    68	
    69	            try {
    70	                $this->csvExportService->fputcsv(array_values($header));
    71	
    72	                // NOTE:
    73	                // 店頭・ネット買取の戻しリストと列構成・整形ルールが同一のため RestockListCsvRowFormatter を共用する。
    74	                // データ取得は getListExportRows() が担い、入庫先在庫・入庫先店舗の閾値で SQL 行を返す。
    75	                $rows = $this->restockListCsvRowFormatter->iterateFormattedRows(
    76	                    $this->stockMoveTransferRepository->getListExportRows(
    77	                        $stockMoveTransferIds,
    78	                        DtbStockMoveTransferRepository::LIST_EXPORT_TYPE_RETURN,
    79	                    ),
    80	                );
    81	
    82	                foreach ($rows as $row) {
    83	                    $orderedRow = array_map(
    84	                        fn ($key) => $row[$key] ?? '',
    85	                        $headerKeys,
    86	                    );
    87	
    88	                    $this->csvExportService->fputcsv($orderedRow);
    89	                }
    90	            } finally {
    91	                $this->csvExportService->fclose();
    92	            }
    93	        });
    94	
    95	        $prefix = 'stock_move_transfer_return_list_'.sprintf('%07d', min($stockMoveTransferIds)).'_';
    96	        $filename = $prefix.(new \DateTime())->format('YmdHis').'.csv';
    97	        $response->headers->set('Content-Type', 'application/octet-stream');
    98	        $response->headers->set(
    99	            'Content-Disposition',
   100	            'attachment; filename='.$filename,
   101	        );
   102	
   103	        log_info('在庫移動・振替 戻しリストCSV出力完了. ファイル名: '.$filename);
   104	
   105	        return $response;
   106	    }
   107	
   108	    /**
   109	     * 戻しリストCSV用バリデーション
   110	     *
   111	     * @param array<int, int> $stockMoveTransferIds
   112	     *
   113	     * @return list<string>
   114	     */
   115	    public function validateReturnListExportIds(array $stockMoveTransferIds, Member $Member): array
   116	    {
   117	        $uniqueStockMoveTransferIds = array_values(array_unique($stockMoveTransferIds));
   118	        $stockMoveTransfers = $this->stockMoveTransferRepository->getMoveToBaseInfoAndStatusByIds($uniqueStockMoveTransferIds);
   119	
   120	        if ($stockMoveTransfers === []) {
   121	            return ['対象のデータが見つかりません。'];
   122	        }
   123	
   124	        $errors = [];
   125	
   126	        $editableShopIds = $Member
   127	            ->getMemberBaseInfos()
   128	            ->map(fn ($mbi) => $mbi->getBaseInfo()->getId())
   129	            ->toArray();
   130	
   131	        $shopIds = [];
   132	        $moveTransferIds = [];
   133	
   134	        foreach ($stockMoveTransfers as $stockMoveTransfer) {
   135	            $moveTransferIds[] = $stockMoveTransfer['transferId'];
   136	            $shopId = $stockMoveTransfer['shopId'];
   137	
   138	            if ($shopId !== null) {
   139	                $shopIds[] = $shopId;
   140	            }
   141	
   142	            if ($shopId === null) {
   143	                $errors[] = sprintf(
   144	                    'ID: %d は入庫先店舗が設定されていません。',
   145	                    $stockMoveTransfer['transferId'],
   146	                );
   147	            } elseif (!in_array($shopId, $editableShopIds, true)) {
   148	                $errors[] = sprintf(
   149	                    'ID: %d は権限のない店舗のデータです。',
   150	                    $stockMoveTransfer['transferId'],
   151	                );
   152	            }
   153	
   154	            if (!in_array($stockMoveTransfer['statusId'], self::ALLOWED_STATUS_IDS, true)) {
   155	                $errors[] = sprintf(
   156	                    'ID: %d は対象外のステータスです。',
   157	                    $stockMoveTransfer['transferId'],
   158	                );
   159	            }
   160	        }
   161	
   162	        foreach ($uniqueStockMoveTransferIds as $uniqueStockMoveTransferId) {
   163	            if (!in_array($uniqueStockMoveTransferId, $moveTransferIds, true)) {
   164	                $errors[] = sprintf('ID: %d は存在しません。', $uniqueStockMoveTransferId);
   165	            }
   166	        }
   167	
   168	        if (count(array_unique($shopIds)) > 1) {
   169	            $errors[] = '複数店舗の在庫移動・振替情報を同時に処理することはできません。';
   170	        }
   171	
   172	        return $errors;
   173	    }
   174	}
