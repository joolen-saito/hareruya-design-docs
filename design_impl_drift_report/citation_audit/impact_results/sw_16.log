    51	     *
    52	     * @return list<array<string, mixed>>
    53	     */
    54	    public function build(iterable $StockApprovalLists): array
    55	    {
    56	        $rows = [];
    57	        $locationNames = ProductStock::STOCK_LOCATION_ID_TO_NAME;
    58	
    59	        foreach ($StockApprovalLists as $ApprovalList) {
    60	            $typeId = $ApprovalList->getHistorySourceTypeId();
    61	
    62	            $approvalTargetLabel = $ApprovalList->getApprovalTargetLabel();
    63	            $approvalTargetLink = '#';
    64	            $approvalTargetLinkOpenType = '_self';
    65	
    66	            // 在庫移動振替の場合はラベル・リンク先を移動・振替に細分化
    67	            if (in_array($typeId, [MtbStockHistorySourceType::STOCK_MOVE_EDIT, MtbStockHistorySourceType::STOCK_TRANSFER_EDIT], true)) {
    68	                $stockChangeTypeId = $ApprovalList->getStockChangeTypeId();
    69	                if ($stockChangeTypeId === MtbStockChangeType::MOVE) {
    70	                    $approvalTargetLabel = 'admin.stock.approval_list.approval_target_stock_move';
