    18	use Eccube\Entity\BaseInfo;
    19	use Eccube\Entity\Master\MtbCardDetail;
    20	
    21	/**
    22	 * 店頭・ネット買取の棚戻しリストCSVで共通する、SQL 1行分からCSV列への整形
    23	 *
    24	 * 入力は DtbOtcBuyOrderRepository::getOtcBuyOrderRestockListExportData /
    25	 * DtbBuyOrderRepository::getBuyOrderRestockListCsvExportData が返す
    26	 * iterateAssociative の連想配列キーと整合させること。
    27	 */
    28	final class RestockListCsvRowFormatter
    29	{
    30	    /**
    31	     * @param iterable<array<string, mixed>> $rawRows
    32	     *
    33	     * @return \Generator<int, array<string, string|int|null>>
    34	     */
    35	    public function iterateFormattedRows(iterable $rawRows): \Generator
    36	    {
    37	        foreach ($rawRows as $row) {
    38	            yield $this->formatRow($row);
    39	        }
    40	    }
    41	
    42	    /**
    43	     * @return list<int>
    44	     */
    45	    public function resolveSortedThresholds(?int $threshold1, ?int $threshold2, ?int $threshold3): array
    46	    {
    47	        $sortedThresholds = [];
    48	        foreach ([$threshold1, $threshold2, $threshold3] as $threshold) {
    49	            if ($threshold !== null) {
    50	                $sortedThresholds[] = $threshold;
    51	            }
    52	        }
    53	        $sortedThresholds = array_values(array_unique($sortedThresholds));
    54	        sort($sortedThresholds, SORT_NUMERIC);
    55	
    56	        return $sortedThresholds;
    57	    }
    58	
    59	    /**
    60	     * @param array<string, mixed> $row
    61	     *
    62	     * @return array<string, string|int|null>
    63	     */
    64	    public function formatRow(array $row): array
    65	    {
    66	        $isSupply = (bool) $row['isSupply'];
    67	        $standardPrice = $row['standardPrice'] !== null ? (int) $row['standardPrice'] : null;
    68	        $threshold1 = $row['threshold1'] !== null ? (int) $row['threshold1'] : null;
    69	        $threshold2 = $row['threshold2'] !== null ? (int) $row['threshold2'] : null;
    70	        $threshold3 = $row['threshold3'] !== null ? (int) $row['threshold3'] : null;
    71	        $foilFlg = (int) ($row['foilFlg'] ?? 0);
    72	        $languageCode = (string) ($row['languageCode'] ?? '');
    73	        $conditionCode = (string) ($row['conditionCode'] ?? '');
    74	        $storageCodeName = (string) ($row['storageCodeName'] ?? '');
    75	        $colorName = (string) ($row['colorName'] ?? '');
    76	        $rarityCode = (string) ($row['rarityCode'] ?? '');
    77	
    78	        $isMainStore = (int) $row['baseInfoId'] === BaseInfo::TC_TOKYO_ID;
    79	
    80	        return [
    81	            'pickingType' => $this->formatPickingType($isSupply, $standardPrice, $threshold1, $threshold2, $threshold3),
    82	            'languageAndCondition' => $this->formatLanguageAndCondition($isSupply, $languageCode, $conditionCode, $foilFlg),
    83	            'storageCode' => $isSupply ? '' : $storageCodeName,
    84	            'colorAndRarity' => $isSupply ? '' : ($colorName.$rarityCode),
    85	            'quantity' => $row['quantity'],
    86	            'productName' => $isSupply
    87	                ? (string) $row['rawProductName']
    88	                : $this->stripProductNameComponents(
    89	                    (string) $row['rawProductName'],
    90	                    $storageCodeName,
    91	                    $languageCode,
    92	                    $conditionCode,
    93	                ),
    94	            'standardPrice' => $standardPrice ?? '',
    95	            'shelfNumber' => $isMainStore ? (string) ($row['shelfNumberName'] ?? '') : '',
    96	        ];
    97	    }
    98	
    99	    private function formatPickingType(
   100	        bool $isSupply,
   101	        ?int $standardPrice,
   102	        ?int $threshold1,
   103	        ?int $threshold2,
   104	        ?int $threshold3,
   105	    ): string {
   106	        if ($isSupply) {
   107	            return 'サプライ';
   108	        }
   109	
   110	        if ($standardPrice === null) {
   111	            return '';
   112	        }
   113	
   114	        $sortedThresholds = $this->resolveSortedThresholds($threshold1, $threshold2, $threshold3);
   115	
   116	        if ($sortedThresholds === []) {
   117	            return '';
   118	        }
   119	
   120	        if ($standardPrice < $sortedThresholds[0]) {
   121	            return number_format($sortedThresholds[0]).'円未満';
   122	        }
   123	
   124	        $count = count($sortedThresholds);
   125	        for ($i = 0; $i < $count - 1; ++$i) {
   126	            $low = $sortedThresholds[$i];
   127	            $high = $sortedThresholds[$i + 1];
   128	            if ($standardPrice >= $low && $standardPrice < $high) {
   129	                return number_format($low).'円以上'.number_format($high).'円未満';
   130	            }
   131	        }
   132	
   133	        return number_format($sortedThresholds[$count - 1]).'円以上';
   134	    }
   135	
   136	    private function formatLanguageAndCondition(
   137	        bool $isSupply,
   138	        string $languageCode,
   139	        string $conditionCode,
   140	        int $foilFlg,
   141	    ): string {
   142	        if ($isSupply) {
   143	            return 'サプライ品';
   144	        }
   145	
   146	        $foilPrefix = $foilFlg !== MtbCardDetail::NON_FOIL ? 'Foil' : '';
   147	        $condition = $conditionCode !== '' ? '/'.$conditionCode : '';
   148	
   149	        return $foilPrefix.$languageCode.$condition;
   150	    }
   151	
   152	    /**
   153	     * 商品名から略称・言語・状態・色・レアリティを取り除く
   154	     * 受注管理ピッキングリストと同様のロジック（ShippingStandbyController参照）
   155	     */
   156	    private function stripProductNameComponents(
   157	        string $productName,
   158	        string $storageCodeName,
   159	        string $languageCode,
   160	        string $conditionCode,
   161	    ): string {
   162	        $name = $productName;
   163	
   164	        if ($storageCodeName !== '' && preg_match('/\['.preg_quote($storageCodeName, '/').'\]/', $name, $matched)) {
   165	            $name = str_replace($matched[0], '', $name);
   166	        } else {
   167	            $name = (string) preg_replace('/\[.+?\]/', '', $name);
   168	        }
   169	
   170	        if ($languageCode !== '' || $conditionCode !== '') {
   171	            $name = str_replace('【'.$languageCode.'/'.$conditionCode.'】', '', $name);
   172	        }
   173	
   174	        $colorRarityPatterns = [
   175	            '/(無|白|青|黒|赤|緑|金|茶|分|混|土地|か)(M|R|U|C|L|S|T)?$/',
   176	            '/(無|白|青|黒|赤|緑|金|茶|分|混|土地)(M|R|U|C|L|S|T)?\(/',
   177	            '/(無|白|青|黒|赤|緑|金|茶|分|混|土地)(M|R|U|C|L|S|T)?\s/',
   178	            '/(無|白|青|黒|赤|緑|金|茶|分|混|土地)\[/',
   179	        ];
   180	        foreach ($colorRarityPatterns as $pattern) {
   181	            if (preg_match($pattern, $name)) {
   182	                $name = (string) preg_replace($pattern, '', $name);
   183	                break;
   184	            }
   185	        }
   186	
   187	        return trim($name);
   188	    }
   189	}
