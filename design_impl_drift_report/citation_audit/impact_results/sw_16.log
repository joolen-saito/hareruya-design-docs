   240	    #[Template(template: '@admin/Stock/inventory_plan_edit.twig')]
   241	    public function edit(Request $request, int $id, ?int $page_no = null): array
   242	    {
   243	        if (!$InventoryPlan = $this->inventoryPlanRepository->find($id)) {
   244	            throw $this->createNotFoundException();
   245	        }
   246	
   247	        $onlyDiff = $request->get('only_diff');
   248	        if ($onlyDiff === null) {
   249	            $onlyDiff = $request->getSession()->get('only_diff', false);
   250	        } else {
   251	            $onlyDiff = $onlyDiff === 'true';
   252	            $request->getSession()->set('only_diff', $onlyDiff);
   253	        }
   254	
   255	        $request->getSession()->remove('previousId');
   256	
   257	        $qb = $this->inventoryPlanDetailRepository->getQueryBuilderByInventoryPlanId($id, $onlyDiff);
   258	
   259	        $page_count = $request->get('page_count') ?? $this->eccubeConfig->get('eccube_default_page_count');
   260	        $page_no = $page_no ?? 1;
   261	        $request->getSession()->set(self::INVENTORY_PLAN_DETAIL_PAGING_SESSION_KEY, [
   262	            'page_no' => $page_no,
   263	            'page_count' => $page_count,
   264	        ]);
   265	
   266	        $pagination = $this->paginator->paginate(
   267	            $qb,
   268	            $page_no,
   269	            (int) $page_count
   270	        );
   271	
   272	        $canEditInventoryPlan = $InventoryPlan->isEditableBy($this->getMember());
   273	
   274	        $builder = $this->formFactory->createBuilder(InventoryPlanType::class, $InventoryPlan, [
   275	            'isNew' => false,
   276	            'Member' => $this->getMember(),
   277	            'disabled' => !$canEditInventoryPlan,
   278	        ]);
   279	
   280	        $event = new EventArgs(
   281	            [
   282	                'builder' => $builder,
   283	                'InventoryPlan' => $InventoryPlan,
   284	            ],
   285	            $request
   286	        );
   287	        $this->eventDispatcher->dispatch($event, EccubeEvents::ADMIN_STOCK_INVENTORY_PLAN_EDIT_INITIALIZE);
   288	
   289	        $form = $builder->getForm();
   290	
   291	        return [
   292	            'pagination' => $pagination,
   293	            'pageMaxis' => $this->pageMaxRepository->findAll(),
   294	            'pageCount' => (int) $page_count,
   295	            'onlyDiff' => $onlyDiff,
   296	            'form' => $form->createView(),
   297	            'canEditInventoryPlan' => $canEditInventoryPlan,
   298	            'productCsvFormName' => 'admin_csv_import',
   299	            'quantityCsvFormName' => 'admin_inventory_plan_quantity_csv',
   300	            'csvImportMaxRecords' => self::INVENTORY_PLAN_CSV_IMPORT_MAX_RECORDS,
   301	            'hasUnconfirmedStockDifferenceDetail' => $this->inventoryPlanDetailRepository->checkUnconfirmedStockDifferenceDetailExists($id),
   302	        ];
   303	    }
