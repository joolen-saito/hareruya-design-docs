codex
全36件の再判定をJSONへ反映しました。現行コードで指摘差が解消済みだった3件（承認一覧100件、メール送信失敗表示、履歴画面の読み取り専用化）を NO_IMPACT に変更し、残りは具体的な画面・HTTP・CSV・DB・検索結果の差を確認できたため IMPACT としています。最終的なJSON整合性と全rowIdの欠落を検証します。
exec
/bin/bash -lc 'set -e
result=hareruya-design-docs/design_impl_drift_report/citation_audit/impact_results/sw_16.json
packet=hareruya-design-docs/design_impl_drift_report/citation_audit/impact_packets/sw_16.json
jq empty "$result"
test "$(jq '"'.results | length' \""'$result")" -eq "$(jq '"'.findings | length' \""'$packet")"
test -z "$(comm -3 <(jq -r '"'.findings[].rowId' \""'$packet" | sort -n) <(jq -r '"'.results[].rowId' \""'$result" | sort -n))"
test "$(jq '"'[.results[] | select(.verdict == \"IMPACT\" and (.observableEffect | length == 0))] | length' \""'$result")" -eq 0
test "$(jq '"'[.results[] | select(.verdict == \"NO_IMPACT\" and (.checked | length == 0))] | length' \""'$result")" -eq 0
test "$(jq '"'[.results[] | select((.verdict == .authorVerdict) "'!= .agree)] | length'"' \""'$result")" -eq 0
jq '"'{packetId, count:(.results|length), verdicts:(.results|group_by(.verdict)|map({key:.[0].verdict,value:length})|from_entries), noImpactRows:[.results[]|select(.verdict==\"NO_IMPACT\")|.rowId]}' \""'$result"
