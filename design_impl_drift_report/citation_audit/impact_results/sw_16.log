    16	namespace Eccube\Service\Admin\Stock;
    17	
    18	use Eccube\Entity\Master\MtbCardDetail;
    19	use Eccube\Entity\ProductStock;
    20	
    21	/**
    22	 * DbalQueryBuilderが返す連想配列を受け取り、
    23	 * 在庫編集モーダル内の明細行の表示用配列を構築する。
    24	 */
    25	class StockEditLineItemRowBuilder
    26	{
    27	    /**
    28	     * @param array<array<string, mixed>> $rows
    29	     *
    30	     * @return list<array<string, string>>
    31	     */
    32	    public function buildFromRawRows(array $rows): array
    33	    {
    34	        $items = [];
    35	        foreach ($rows as $row) {
    36	            $items[] = $this->mapRow($row);
    37	        }
    38	
    39	        return $items;
    40	    }
    41	
    42	    /**
    43	     * @param array<string, mixed> $row
    44	     *
    45	     * @return array<string, string>
    46	     */
    47	    private function mapRow(array $row): array
    48	    {
    49	        $beforeQty = (int) ($row['before_edit_quantity'] ?? 0);
    50	        $editQty = (int) ($row['edit_quantity'] ?? 0);
    51	        $afterQty = $beforeQty + $editQty;
    52	
    53	        $beforeUnit = (string) ($row['before_purchase_unit_price'] ?? '0');
    54	        $purchaseUnit = (string) ($row['purchase_unit_price'] ?? '0');
    55	
    56	        $beforeTotal = bcmul($beforeUnit, (string) $beforeQty, 2);
    57	        $movementCost = bcmul($purchaseUnit, (string) $editQty, 2);
    58	        $afterTotal = bcadd($beforeTotal, $movementCost, 2);
    59	        $deltaTotal = bcsub($afterTotal, $beforeTotal, 2);
    60	
    61	        $stockLocationId = (int) ($row['stock_location_id'] ?? 0);
    62	        $locationName = ProductStock::STOCK_LOCATION_ID_TO_NAME[$stockLocationId] ?? '-';
    63	
    64	        $parent = (string) ($row['stock_change_type_parent_name'] ?? '');
    65	        $child = (string) ($row['stock_change_type_child_name'] ?? '');
    66	
    67	        if ($parent !== '' && $child !== '') {
    68	            $typeDetail = $parent.'/'.$child;
    69	        } elseif ($parent !== '') {
    70	            $typeDetail = $parent;
    71	        } else {
    72	            $typeDetail = $child;
    73	        }
    74	
    75	        $name = (string) ($row['product_name'] ?? '');
    76	        $code = (string) ($row['product_code'] ?? '');
    77	        $productNameAndCode = $code !== '' ? $name.' / '.$code : $name;
    78	
    79	        $shopName = (string) ($row['shop_name'] ?? '-');
    80	
    81	        $registeredAtRaw = $row['registered_at'] ?? null;
    82	        $registeredAt = $registeredAtRaw !== null
    83	            ? date('Y/m/d H:i', (int) strtotime((string) $registeredAtRaw))
    84	            : '-';
    85	
    86	        $approvedAtRaw = $row['approved_at'] ?? null;
    87	        $approvedAt = $approvedAtRaw !== null
    88	            ? date('Y/m/d H:i', (int) strtotime((string) $approvedAtRaw))
    89	            : '-';
    90	
    91	        return [
    92	            // モーダル表示用（後方互換）
    93	            'product_name_and_code' => $productNameAndCode !== '' ? $productNameAndCode : '-',
    94	            'store_and_stock_location' => sprintf('%s / %s', $shopName, $locationName),
    95	            'stock_change_type_detail' => $typeDetail !== '' ? $typeDetail : '-',
    96	            // CSV用（分割カラム）
    97	            'product_name' => $name !== '' ? $name : '-',
    98	            'product_code' => $code !== '' ? $code : '-',
    99	            'language' => (string) ($row['language_name_jp'] ?? '-'),
   100	            'card_condition' => (string) ($row['card_condition_name_jp'] ?? '-'),
   101	            'foil' => $this->formatFoilFlg(isset($row['foil_flg']) ? (int) $row['foil_flg'] : null),
   102	            'store_name' => $shopName,
   103	            'stock_location' => $locationName,
   104	            'stock_before' => (string) $beforeQty,
   105	            'stock_after' => (string) $afterQty,
   106	            'stock_change_quantity' => (string) $editQty,
   107	            'purchase_unit_price' => $this->formatDecimalYen($purchaseUnit, true),
   108	            'total_cost_delta' => $this->formatDecimalYen($deltaTotal, false),
   109	            'total_cost_before' => $this->formatDecimalYen($beforeTotal, false),
   110	            'total_cost_after' => $this->formatDecimalYen($afterTotal, false),
   111	            'stock_change_type_parent' => $parent !== '' ? $parent : '-',
   112	            'stock_change_type_child' => $child !== '' ? $child : '-',
   113	            'stock_change_reason' => (string) ($row['stock_change_reason'] ?? ''),
   114	            'registered_at' => $registeredAt,
   115	            'registered_member' => (string) ($row['registered_member_name'] ?? '-'),
   116	            'approved_at' => $approvedAt,
   117	            'approver' => (string) ($row['approver_name'] ?? '-'),
   118	            'last_updated_at' => '-',
   119	            'last_updated_by' => '-',
   120	        ];
   121	    }
   122	
   123	    private function formatFoilFlg(?int $flg): string
   124	    {
   125	        return match ($flg) {
   126	            MtbCardDetail::NON_FOIL => 'なし',
   127	            MtbCardDetail::FOIL => MtbCardDetail::FOIL_LABEL,
   128	            MtbCardDetail::FOIL_SPECIAL => '特殊Foil',
   129	            default => '-',
   130	        };
   131	    }
   132	
   133	    private function formatDecimalYen(string $amount, bool $fractionalDigits2 = false): string
   134	    {
   135	        if ($amount === '' || !is_numeric($amount)) {
   136	            return '¥0';
   137	        }
   138	
   139	        $decimals = $fractionalDigits2 ? 2 : 0;
   140	
   141	        return '¥'.number_format((float) $amount, $decimals, '.', ',');
   142	    }
   143	}
