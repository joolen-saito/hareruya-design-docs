   313	    #[Route(
   314	        path: '/%eccube_admin_route%/product/stock/inventory_plan/{id}',
   315	        name: 'admin_stock_inventory_plan_update',
   316	        requirements: ['id' => '\d+'],
   317	        methods: ['POST']
   318	    )]
   319	    public function update(Request $request, ?int $id = null): Response
   320	    {
   321	        $isNew = $id === null;
   322	
   323	        if ($isNew) {
   324	            $InventoryPlan = new DtbInventoryPlan();
   325	        } elseif (!$InventoryPlan = $this->inventoryPlanRepository->find($id)) {
   326	            throw $this->createNotFoundException();
   327	        }
   328	
   329	        if ($InventoryPlan->getStockReflectionedDate() !== null) {
   330	            $this->addError('admin.inventory_plan.update.already_reflected', 'admin');
   331	
   332	            return $this->redirectToRoute('admin_stock_inventory_plan_edit', ['id' => $InventoryPlan->getId()]);
   333	        }
   334	
   335	        if (!$isNew && !$InventoryPlan->isEditableBy($this->getMember())) {
   336	            $this->addError('admin.inventory_plan_detail.not_editable_store', 'admin');
   337	
   338	            return $this->redirectToRoute('admin_stock_inventory_plan_edit', ['id' => $InventoryPlan->getId()]);
   339	        }
   340	
   341	        $form = $this->createForm(InventoryPlanType::class, $InventoryPlan, [
   342	            'isNew' => $isNew,
   343	            'Member' => $this->getMember(),
   344	            'disabled' => false,
   345	        ]);
   346	        $form->handleRequest($request);
   347	
   348	        if (!$form->isSubmitted() || !$form->isValid()) {
   349	            $this->addError('admin.inventory_plan.save.failed', 'admin');
   350	
   351	            if ($isNew) {
   352	                return $this->render('@admin/Stock/inventory_plan.twig', [
   353	                    'form' => $form->createView(),
   354	                ]);
   355	            }
   356	
   357	            $formErrors = [];
   358	            foreach ($form->getErrors(true) as $error) {
   359	                $formErrors[] = $error->getMessage();
   360	            }
   361	            if ($formErrors !== []) {
   362	                $this->addError(implode('', $formErrors), 'admin');
   363	            }
   364	
   365	            return $this->redirectToRoute('admin_stock_inventory_plan_edit', ['id' => $InventoryPlan->getId()]);
   366	        }
   367	
   368	        /** @var DtbInventoryPlan $InventoryPlan */
   369	        $InventoryPlan = $form->getData();
   370	
   371	        /** @var Member $Member */
   372	        $Member = $this->getUser();
   373	        $InventoryPlan->setMember($Member);
   374	
   375	        $this->entityManager->persist($InventoryPlan);
   376	        $this->entityManager->flush();
   377	
   378	        $event = new EventArgs(
   379	            [
   380	                'form' => $form,
   381	                'InventoryPlan' => $InventoryPlan,
   382	            ],
   383	            $request
   384	        );
   385	        $this->eventDispatcher->dispatch($event, EccubeEvents::ADMIN_STOCK_INVENTORY_PLAN_UPDATE_COMPLETE);
   386	
   387	        $this->addSuccess('admin.inventory_plan.save.complete', 'admin');
   388	
   389	        return $this->redirectToRoute('admin_stock_inventory_plan_edit', ['id' => $InventoryPlan->getId()]);
   390	    }
