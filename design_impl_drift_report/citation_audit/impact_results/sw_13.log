   285	
   286	        // 言語フィルター
   287	        // JP_ID(1)            → pc.Language = 1
   288	        // EN_ID(2)            → pc.Language = 2
   289	        // NOT_JP_EN_LANG_ID   → pc.Language NOT IN (1, 2)（日本語・英語以外）
   290	        // 複数選択時は OR で結合
   291	        if ($input->languages !== []) {
   292	            $hasJp = in_array(MtbLanguage::JP_ID, $input->languages, true);
   293	            $hasEn = in_array(MtbLanguage::EN_ID, $input->languages, true);
   294	            $hasOther = in_array(MtbLanguage::NOT_JP_EN_LANG_ID, $input->languages, true);
   295	
   296	            $conditions = [];
   297	            if ($hasJp) {
   298	                $conditions[] = 'IDENTITY(pc.Language) = '.MtbLanguage::JP_ID;
   299	            }
   300	            if ($hasEn) {
   301	                $conditions[] = 'IDENTITY(pc.Language) = '.MtbLanguage::EN_ID;
   302	            }
   303	            if ($hasOther) {
   304	                $conditions[] = '(pc.Language IS NOT NULL AND IDENTITY(pc.Language) NOT IN (:stockListConstantLangIds))';
