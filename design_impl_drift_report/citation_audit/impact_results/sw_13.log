   225	                const modalEl = document.getElementById('stockTransferDeleteRowModal');
   226	                if (modalEl && typeof bootstrap !== 'undefined' && bootstrap.Modal.getInstance(modalEl)) {
   227	                    bootstrap.Modal.getInstance(modalEl).hide();
