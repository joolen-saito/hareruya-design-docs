    45	        private readonly ProductStockEntityManager $productStockEntityManager,
    46	        private readonly StockHistoryEntityManager $stockHistoryEntityManager,
    47	        private readonly MtbStockChangeTypeDetailRepository $stockChangeTypeDetailRepository,
