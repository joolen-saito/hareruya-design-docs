    25	use Symfony\Contracts\Translation\TranslatorInterface;
    26	
    27	/**
    28	 * 在庫移動・振替一覧（検索結果の全件）CSV出力
    29	 *
    30	 * @see StockApprovalListCsvExportService
    31	 */
    32	class StockMoveTransferListCsvExportService
    33	{
    34	    private const EXPORT_CHUNK_SIZE = 100;
    35	
    36	    public const CSV_HEADER = [
    37	        'stock_move_transfer_id' => '在庫移動振替ID',
    38	        'move_instruction_id' => '移動指示ID',
    39	        'move_transfer_type' => '移動タイプ',
    40	        'move_from_base_info' => '出庫元店舗',
    41	        'move_from_stock_location' => '出庫元在庫区分',
    42	        'move_to_base_info' => '入庫先店舗',
    43	        'move_to_stock_location' => '入庫先在庫区分',
    44	        'move_quantity' => '移動点数',
    45	        'standard_total_price' => '基準価格合計',
    46	        'move_transfer_status' => 'ステータス',
    47	        'move_from_stock_at' => '出庫日',
    48	        'move_to_stock_at' => '入庫日',
    49	        'registered_member' => '登録者',
    50	        'create_date' => '登録日',
    51	    ];
    52	
    53	    public function __construct(
    54	        protected CsvExportService $csvExportService,
    55	        protected DtbStockMoveTransferRepository $stockMoveTransferRepository,
    56	        protected DtbStockMoveTransferDetailRepository $stockMoveTransferDetailRepository,
    57	        protected EntityManagerInterface $entityManager,
    58	        protected TranslatorInterface $translator,
    59	    ) {
    60	    }
    61	
    62	    /**
    63	     * 検索条件に一致する在庫移動・振替一覧をCSV出力する
    64	     *
    65	     * @param array<string, mixed> $searchData SearchStockMoveTransferType の getData() 結果
    66	     */
    67	    public function exportBySearchData(array $searchData): StreamedResponse
    68	    {
    69	        $header = self::CSV_HEADER;
    70	        $headerKeys = array_keys($header);
    71	
    72	        $response = new StreamedResponse();
    73	        $response->setCallback(function () use ($header, $headerKeys, $searchData): void {
    74	            $this->csvExportService->fopen();
    75	
    76	            try {
    77	                $this->csvExportService->fputcsv(array_values($header));
    78	
    79	                $qb = $this->stockMoveTransferRepository->getQueryBuilderBySearchData($searchData);
    80	                $locationNames = ProductStock::STOCK_LOCATION_ID_TO_NAME;
    81	
    82	                /** @var list<DtbStockMoveTransfer> $chunk */
    83	                $chunk = [];
    84	
    85	                foreach ($qb->getQuery()->toIterable() as $stockMoveTransfer) {
    86	                    $chunk[] = $stockMoveTransfer;
    87	
    88	                    if (count($chunk) >= self::EXPORT_CHUNK_SIZE) {
    89	                        // チャンクサイズ毎にCSV出力
    90	                        $this->writeChunkRows($chunk, $headerKeys, $locationNames);
    91	                        $chunk = [];
    92	                        $this->entityManager->clear();
    93	                    }
    94	                }
    95	
    96	                if ($chunk !== []) {
    97	                    // チャンクサイズに満たなかった最後のチャンクをCSV出力
    98	                    $this->writeChunkRows($chunk, $headerKeys, $locationNames);
    99	                }
   100	            } finally {
   101	                $this->csvExportService->fclose();
   102	            }
   103	        });
   104	
   105	        $filename = 'stock_move_transfer_list_'.(new \DateTime())->format('YmdHis').'.csv';
   106	        $response->headers->set('Content-Type', 'application/octet-stream');
   107	        $response->headers->set(
   108	            'Content-Disposition',
   109	            'attachment; filename='.$filename,
   110	        );
   111	
   112	        log_info('在庫移動・振替一覧CSV出力完了. ファイル名: '.$filename);
   113	
   114	        return $response;
   115	    }
   116	
   117	    /**
   118	     * @param list<DtbStockMoveTransfer> $stockMoveTransfers
   119	     * @param list<string> $headerKeys
   120	     * @param array<int, string> $locationNames
   121	     */
   122	    private function writeChunkRows(array $stockMoveTransfers, array $headerKeys, array $locationNames): void
   123	    {
   124	        $stockMoveTransferIds = array_map(
   125	            static fn (DtbStockMoveTransfer $stockMoveTransfer): int => $stockMoveTransfer->getId(),
   126	            $stockMoveTransfers,
   127	        );
   128	        $aggregates = $this->stockMoveTransferDetailRepository->getAggregatesByStockMoveTransferIds($stockMoveTransferIds);
   129	
   130	        foreach ($stockMoveTransfers as $stockMoveTransfer) {
   131	            $row = $this->buildCsvRow($stockMoveTransfer, $aggregates, $locationNames);
   132	            $orderedRow = array_map(
   133	                fn (string $key) => (string) ($row[$key] ?? ''),
   134	                $headerKeys,
   135	            );
   136	            $this->csvExportService->fputcsv($orderedRow);
   137	        }
   138	    }
   139	
   140	    /**
   141	     * @param array<int, array{quantity: int, standard_total: string}> $aggregates
   142	     * @param array<int, string> $locationNames
   143	     *
   144	     * @return array<string, string>
   145	     */
   146	    private function buildCsvRow(
   147	        DtbStockMoveTransfer $stockMoveTransfer,
   148	        array $aggregates,
   149	        array $locationNames,
   150	    ): array {
   151	        $aggregate = $aggregates[$stockMoveTransfer->getId()] ?? null;
   152	        $moveInstructionId = $stockMoveTransfer->getMoveInstructionId();
   153	
   154	        return [
   155	            'stock_move_transfer_id' => (string) $stockMoveTransfer->getId(),
   156	            'move_instruction_id' => $moveInstructionId !== null ? (string) $moveInstructionId : '',
   157	            'move_transfer_type' => $this->formatMoveTransferType($stockMoveTransfer->getMoveTransferType()),
   158	            'move_from_base_info' => $stockMoveTransfer->getMoveFromBaseInfo()?->getShopName() ?? '',
   159	            'move_from_stock_location' => $this->formatStockLocationName(
   160	                $stockMoveTransfer->getMoveFromStockLocationId(),
   161	                $locationNames,
   162	            ),
   163	            'move_to_base_info' => $stockMoveTransfer->getMoveToBaseInfo()?->getShopName() ?? '',
   164	            'move_to_stock_location' => $this->formatStockLocationName(
   165	                $stockMoveTransfer->getMoveToStockLocationId(),
   166	                $locationNames,
   167	            ),
   168	            'move_quantity' => (string) (($aggregate ?? [])['quantity'] ?? 0),
   169	            'standard_total_price' => $this->formatStandardTotalPrice(($aggregate ?? [])['standard_total'] ?? '0'),
   170	            'move_transfer_status' => $stockMoveTransfer->getMoveTransferStatus()->getStatusName(),
   171	            'move_from_stock_at' => $this->formatDateTime($stockMoveTransfer->getMoveFromStockAt()),
   172	            'move_to_stock_at' => $this->formatDateTime($stockMoveTransfer->getMoveToStockAt()),
   173	            'registered_member' => $stockMoveTransfer->getRegisteredMember()->getName() ?? '',
   174	            'create_date' => $stockMoveTransfer->getCreateDate()->format('Y/m/d H:i'),
   175	        ];
   176	    }
   177	
   178	    private function formatMoveTransferType(int $moveTransferType): string
   179	    {
   180	        if ($moveTransferType === DtbStockMoveTransfer::MOVE_TRANSFER_TYPE_MOVE) {
   181	            return $this->translator->trans('admin.stock.move.type_move', [], 'messages');
   182	        }
   183	
   184	        if ($moveTransferType === DtbStockMoveTransfer::MOVE_TRANSFER_TYPE_TRANSFER) {
   185	            return $this->translator->trans('admin.stock.move.type_transfer', [], 'messages');
   186	        }
   187	
   188	        return (string) $moveTransferType;
   189	    }
   190	
   191	    /**
   192	     * @param array<int, string> $locationNames
   193	     */
   194	    private function formatStockLocationName(?int $stockLocationId, array $locationNames): string
   195	    {
   196	        if ($stockLocationId === null) {
   197	            return '';
   198	        }
   199	
   200	        return $locationNames[$stockLocationId] ?? '';
   201	    }
   202	
   203	    private function formatStandardTotalPrice(string $standardTotal): string
   204	    {
   205	        if ($standardTotal === '' || !is_numeric($standardTotal)) {
   206	            return '0';
   207	        }
   208	
   209	        return (string) (int) round((float) $standardTotal);
   210	    }
