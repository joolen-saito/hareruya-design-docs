   229	    /**
   230	     * @param list<string> $headers
   231	     */
   232	    private function buildCsvTemplateResponse(array $headers, string $filename): StreamedResponse
   233	    {
   234	        $out = fopen('php://temp', 'r+');
   235	        if ($out === false) {
   236	            throw new \RuntimeException('Failed to open temp stream.');
   237	        }
   238	        fputcsv($out, $headers, ',', '"', '\\');
   239	        rewind($out);
   240	        $content = stream_get_contents($out);
   241	        fclose($out);
   242	        $response = new StreamedResponse(function () use ($content): void {
   243	            echo "\xEF\xBB\xBF".($content !== false ? $content : '');
   244	        });
   245	        $response->headers->set('Content-Type', 'application/octet-stream');
   245	        $response->headers->set('Content-Type', 'application/octet-stream');
   246	        $response->headers->set('Content-Disposition', 'attachment; filename="'.$filename.'"');
   247	
   248	        return $response;
   249	    }
