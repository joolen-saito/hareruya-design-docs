   319	    private function adminStockListEscapeLikePattern(string $value): string
   320	    {
   321	        $e = self::ADMIN_STOCK_LIST_LIKE_ESCAPE_CHAR;
   322	        // ESCAPE '!' を明示指定した場合、\ は特殊文字ではなくリテラルとして扱われるため二重化不要。
   323	        $escaped = str_replace($e, $e.$e, $value);
   324	        $escaped = str_replace('%', $e.'%', $escaped);
   325	        $escaped = str_replace('_', $e.'_', $escaped);
   326	
   327	        return '%'.$escaped.'%';
   328	    }
