    56	    public function exportBySearchData(array $searchData): StreamedResponse
    57	    {
    58	        $qb = $this->dtbStockSplitJoinRepository->getQueryBuilderBySearchData($searchData);
    59	        $qb->orderBy('s.id', 'ASC');
    60	
    61	        /** @var list<DtbStockSplitJoin> $splitJoins */
