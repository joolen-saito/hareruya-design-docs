    53	    public function handle(StockTransferStoreInput $input): DtbStockMoveTransfer
    54	    {
    55	        $this->entityManager->beginTransaction();
    56	
    57	        $MoveTransferStatus = $this->stockMoveTransferStatusRepository->find(MtbStockMoveTransferStatus::STATUS_TRANSFER_APPROVAL_PENDING);
    58	
    59	        try {
    60	            $StockTransfer = $this->stockMoveTransferEntityManager->save(
    61	                StockMoveTransfer: null,
    62	                MoveTransferStatus: $MoveTransferStatus,
    63	                MoveFromBaseInfo: $input->BaseInfo,
    64	                MoveToBaseInfo: $input->BaseInfo,
    65	                moveFromStockLocationId: $input->stockLocationId,
    66	                moveToStockLocationId: $input->stockLocationId,
    67	                memo: $input->memo,
    68	                RegisteredMember: $input->Member,
    69	                UpdatedMember: $input->Member,
    70	                moveTransferType: DtbStockMoveTransfer::MOVE_TRANSFER_TYPE_TRANSFER,
    71	            );
    72	
    73	            $this->entityManager->flush();
    74	
    75	            $persistedDetailCount = 0;
    76	
    77	            foreach ($input->transferDetails as $detail) {
    78	                $moveFromProductStockId = (int) $detail['move_from_product_stock_id'];
    79	                $destProductCode = trim((string) $detail['dest_product_code']);
    80	                $moveTransferQuantity = (int) $detail['move_transfer_quantity'];
    81	
    82	                if ($moveTransferQuantity <= 0 || $destProductCode === '') {
    83	                    continue;
    84	                }
    85	
    86	                $FromProductStock = $this->productStockRepository->find($moveFromProductStockId);
    87	                if ($FromProductStock === null) {
    88	                    throw new \Exception('振替元の商品在庫が見つかりません');
    89	                }
    90	
    91	                $ProductClass = $this->productClassRepository->findOneBy(['code' => $destProductCode]);
    92	                if ($ProductClass === null) {
    93	                    throw new \Exception(sprintf('振替先の商品コード「%s」が見つかりません', $destProductCode));
    94	                }
    95	
    96	                $ToProductStock = $this->productStockRepository->findOneBy([
    97	                    'ProductClass' => $ProductClass,
    98	                    'baseInfo' => $input->BaseInfo,
    99	                    'stockLocationId' => $input->stockLocationId,
   100	                ]);
   101	                if ($ToProductStock === null) {
   102	                    throw new \Exception(sprintf('振替先の商品在庫（商品コード: %s）が見つかりません', $destProductCode));
   103	                }
   104	
   105	                $moveQuantity = (string) $moveTransferQuantity;
   106	
   107	                $standardPrice = $ProductClass->getStandardPrice();
   108	                $standardTotalPrice = bcmul((string) $standardPrice, $moveQuantity, 0);
   109	
   110	                $fromOutboundTotalCost = $FromProductStock->getMovementTotalCost($moveQuantity);
   111	
   112	                $this->stockMoveTransferDetailEntityManager->save(
   113	                    StockMoveTransferDetail: null,
   114	                    StockMoveTransfer: $StockTransfer,
   115	                    MoveFromProductStock: $FromProductStock,
   116	                    MoveToProductStock: $ToProductStock,
   117	                    moveTransferQuantity: $moveTransferQuantity,
   118	                    standardTotalPrice: (string) $standardTotalPrice,
   119	                    outboundTotalCost: (string) $fromOutboundTotalCost,
   120	                );
   121	
   122	                $afterFromStock = $FromProductStock->getStockQuantityAfterChange(bcmul($moveQuantity, '-1', 0));
   123	                $afterFromTotalCost = $FromProductStock->getTotalCostAfterChange(bcmul($moveQuantity, '-1', 0));
   124	
   125	                $this->stockHistoryEntityManager->save(
   126	                    ProductStock: $FromProductStock,
   127	                    StockChangeTypeDetail: $this->stockChangeTypeDetailRepository->find(MtbStockChangeTypeDetail::TRANSFER_OUTBOUND),
   128	                    oldStock: $FromProductStock->getStock(),
   129	                    stock: $afterFromStock,
   130	                    stockChangeQuantity: $moveQuantity,
   131	                    sellPrice: $ProductClass->getPrice02(),
   132	                    unitCostPriceBefore: $FromProductStock->getUnitCost(),
   133	                    unitCostPriceAfter: $FromProductStock->getUnitCostPriceAfterChange($moveQuantity),
   134	                    totalCostPriceBefore: $FromProductStock->getTotalCost(),
   135	                    totalCostPriceAfter: $FromProductStock->getTotalCostAfterChange($moveQuantity),
   136	                    stockChangeReason: '',
   137	                    shortageReason: null,
   138	                    HistorySourceType: $this->stockHistorySourceTypeRepository->find(MtbStockHistorySourceType::STOCK_TRANSFER_EDIT),
   139	                    historySourceId: $StockTransfer->getId(),
   140	                    registeredAt: new \DateTime(),
   141	                    RegisteredMember: $input->Member,
   142	                    operatorMemberName: $input->Member->getName(),
   143	                );
   144	
   145	                $this->productStockEntityManager->save(
   146	                    ProductStock: $FromProductStock,
   147	                    ProductClass: $FromProductStock->getProductClass(),
   148	                    BaseInfo: $FromProductStock->getBaseInfo(),
   149	                    stock: $afterFromStock,
   150	                    pickUpFlg: $FromProductStock->getPickUpFlg(),
   151	                    stockLocationId: $FromProductStock->getStockLocationId(),
   152	                    totalCost: $afterFromTotalCost,
   153	                );
   154	
   155	                ++$persistedDetailCount;
   156	            }
   157	
   158	            if ($persistedDetailCount === 0) {
   159	                throw new \Exception('登録可能な振替明細がありません');
   160	            }
   161	
   162	            // 在庫承認一覧用のデータを作成
   163	            $this->stockApprovalListEntityManager->save(
   164	                StockApprovalList: null,
   165	                BaseInfo: $input->BaseInfo,
   166	                StockLocationId: $input->stockLocationId,
   167	                HistorySourceType: $this->stockHistorySourceTypeRepository->find(MtbStockHistorySourceType::STOCK_TRANSFER_EDIT),
   168	                historySourceId: $StockTransfer->getId(),
   169	                StockTransferTypeDetail: $this->entityManager->getReference(MtbStockChangeTypeDetail::class, MtbStockChangeTypeDetail::TRANSFER_OUTBOUND),
   170	                approvalStatus: DtbStockApprovalList::APPROVAL_STATUS_UNAPPROVED,
   171	                registeredDate: new \DateTime(),
   172	                RegisteredMember: $input->Member,
   173	                approvedDate: null,
   174	                ApprovalMember: null,
   175	                ProductStockTotalCount: $persistedDetailCount,
   176	                InventoryChangeTotalCount: 0,
   177	                TotalCostPriceBefore: 0,
   178	            );
   179	
   180	            $this->entityManager->flush();
   181	            $this->entityManager->commit();
   182	
   183	            return $StockTransfer;
   184	        } catch (\Exception $e) {
   185	            $this->entityManager->rollback();
