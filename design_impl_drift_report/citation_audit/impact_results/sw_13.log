    57	    public function getQueryBuilderForAdminStockList(StockListSearchInput $input): QueryBuilder
    58	    {
    59	        $qb = $this->createQueryBuilder('ps')
    60	            ->innerJoin('ps.ProductClass', 'pc')
    61	            ->innerJoin('pc.Product', 'p');
    62	
    63	        $productNameTrimmed = $input->productName !== null ? trim($input->productName) : '';
    64	        if ($productNameTrimmed !== '') {
    65	            $qb->andWhere('p.name LIKE :productName'.$this->adminStockListLikeEscapeDql())
    66	                ->setParameter('productName', $this->adminStockListEscapeLikePattern($productNameTrimmed));
    67	        }
    68	
    69	        $cardNameTrimmed = $input->cardName !== null ? trim($input->cardName) : '';
    70	        if ($cardNameTrimmed !== '') {
    71	            $qb->leftJoin('p.CardDetail', 'sl_cd')
    72	                ->leftJoin('sl_cd.Card', 'sl_card');
    73	            $esc = $this->adminStockListLikeEscapeDql();
    74	            $qb->andWhere('(sl_card.name_jp LIKE :stockListCardName'.$esc.' OR sl_card.name_en LIKE :stockListCardName'.$esc.')')
    75	                ->setParameter('stockListCardName', $this->adminStockListEscapeLikePattern($cardNameTrimmed));
    76	        }
    77	
    78	        $productIdTrimmed = $input->productId !== null ? trim($input->productId) : '';
    79	        if ($productIdTrimmed !== '') {
    80	            $qb->andWhere("CONCAT(p.id, '') LIKE :stockListProductId".$this->adminStockListLikeEscapeDql())
    81	                ->setParameter('stockListProductId', $this->adminStockListEscapeLikePattern($productIdTrimmed));
    82	        }
    83	
    84	        $productCodeTrimmed = $input->productCode !== null ? trim($input->productCode) : '';
    85	        if ($productCodeTrimmed !== '') {
    86	            $qb->andWhere('pc.code LIKE :productCode'.$this->adminStockListLikeEscapeDql())
    87	                ->setParameter('productCode', $this->adminStockListEscapeLikePattern($productCodeTrimmed));
    88	        }
    89	
    90	        if ($input->baseInfos !== []) {
    91	            $qb->andWhere($qb->expr()->in('ps.baseInfo', ':stockListBaseInfos'))
    92	                ->setParameter('stockListBaseInfos', $input->baseInfos);
    93	        }
    94	
    95	        if ($input->stockLocationIds !== []) {
    96	            $qb->andWhere('ps.stockLocationId IN (:stockLocationIds)')
    97	                ->setParameter('stockLocationIds', $input->stockLocationIds);
    98	        }
    99	
   100	        if ($input->updateDateFrom !== null) {
   101	            $qb->andWhere('pc.update_date >= :stockListUpdateDateFrom')
   102	                ->setParameter('stockListUpdateDateFrom', $input->updateDateFrom);
   103	        }
   104	        if ($input->updateDateTo !== null) {
   105	            $toExclusive = \DateTimeImmutable::createFromInterface($input->updateDateTo)
   106	                ->modify('+1 day')
   107	                ->setTime(0, 0, 0);
   108	            $qb->andWhere('pc.update_date < :stockListUpdateDateToExclusive')
   109	                ->setParameter('stockListUpdateDateToExclusive', $toExclusive);
   110	        }
   111	
   112	        if ($input->cardConditions !== []) {
   113	            $qb->andWhere($qb->expr()->in('pc.CardCondition', ':stockListCardConditions'))
   114	                ->setParameter('stockListCardConditions', $input->cardConditions);
   115	        }
   300	            if ($hasEn) {
   301	                $conditions[] = 'IDENTITY(pc.Language) = '.MtbLanguage::EN_ID;
   302	            }
   303	            if ($hasOther) {
   304	                $conditions[] = '(pc.Language IS NOT NULL AND IDENTITY(pc.Language) NOT IN (:stockListConstantLangIds))';
   305	                $qb->setParameter('stockListConstantLangIds', MtbLanguage::CONSTANT_LANG_IDS);
   306	            }
   307	
   308	            if ($conditions !== []) {
   309	                $qb->andWhere('('.implode(' OR ', $conditions).')');
   310	            }
   311	        }
   312	
   313	        $qb->orderBy('p.id', 'DESC')
   314	            ->addOrderBy('ps.stockLocationId', 'ASC');
   315	
   316	        return $qb;
   317	    }
