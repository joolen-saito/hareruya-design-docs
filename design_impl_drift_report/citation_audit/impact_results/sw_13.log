   275	    public function listSplitCsvImport(Request $request): RedirectResponse
   276	    {
   277	        $csvBag = $request->request->all('admin_stock_split_csv_upload');
   278	        $token = isset($csvBag['_token']) ? (string) $csvBag['_token'] : '';
   279	        if (!$this->isCsrfTokenValid('admin_stock_split_csv_upload', $token)) {
   280	            $this->addError('admin.common.csrf_invalid', 'admin');
   281	
   282	            return $this->redirectToRoute('admin_stock_split_join_list');
   283	        }
   284	
   285	        $splitFiles = $request->files->get('admin_stock_split_csv_upload');
   286	        $file = \is_array($splitFiles) ? ($splitFiles['import_file'] ?? null) : null;
   287	        if (!$file instanceof UploadedFile || !$file->isValid()) {
   288	            $this->addError(trans('admin.common.csv_upload_error'), 'admin');
   289	
   290	            return $this->redirectToRoute('admin_stock_split_join_list');
   291	        }
   292	
   293	        $storeId = isset($csvBag['store']) ? (int) $csvBag['store'] : 0;
   294	        $BaseInfo = $storeId > 0 ? $this->baseInfoRepository->find($storeId) : $this->baseInfoRepository->get();
   295	        if ($BaseInfo === null) {
   296	            $this->addError(trans('admin.common.csv_upload_error'), 'admin');
   297	
   298	            return $this->redirectToRoute('admin_stock_split_join_list');
   299	        }
   300	
   301	        $stockLocationId = isset($csvBag['inventory_category']) ? (int) $csvBag['inventory_category'] : 0;
   302	        $allowedInventoryIds = [StockSplitCsvUploadType::INVENTORY_CATEGORY_EC_CUBE, StockSplitCsvUploadType::INVENTORY_CATEGORY_SMAREGI];
   303	        if (!in_array($stockLocationId, $allowedInventoryIds, true)) {
   304	            $this->addError(trans('admin.common.csv_upload_error'), 'admin');
   305	
   306	            return $this->redirectToRoute('admin_stock_split_join_list');
   307	        }
   308	
   309	        $Member = $this->getUser();
   310	        if (!$Member instanceof Member) {
   311	            $this->addError(trans('admin.stock.split.login_required'), 'admin');
   312	
   313	            return $this->redirectToRoute('admin_stock_split_join_list');
   314	        }
   315	
   316	        $handler = new StockSplitListCsvImportHandler(
   317	            $this->productStockRepository,
   318	            $this->stockSplitRegisterAction,
   319	            $this->stockSplitApplyApprovalAction,
   320	            $this->entityManager,
   321	            $BaseInfo,
   322	            $stockLocationId,
   323	            $Member,
   324	        );
   325	
   326	        $importer = new CsvImporter(
   327	            $this->entityManager,
   328	            $this->translator,
   329	            $this->eccubeConfig,
   330	            $handler,
   331	            $Member,
   332	        );
   333	
   334	        try {
   335	            $result = $importer->import($file);
   336	        } catch (\Throwable $e) {
   337	            $detail = sprintf('[%s] %s', get_class($e), $e->getMessage());
   338	            log_error('在庫分割CSV取り込みに失敗しました: '.$detail, [$e]);
   339	            error_log('在庫分割CSV取り込みエラー: '.$detail.' in '.$e->getFile().':'.$e->getLine());
   340	            $this->addError(trans('admin.common.csv_import_error').': '.$detail, 'admin');
   341	
   342	            return $this->redirectToRoute('admin_stock_split_join_list');
   343	        }
   344	
   345	        foreach ($result->getErrors() as $error) {
   346	            $this->addError($error['message'], 'admin');
   347	        }
   348	        foreach ($handler->getFlashErrors() as $msg) {
   349	            $this->addError($msg, 'admin');
   350	        }
   351	        foreach ($handler->getFlashSuccesses() as $msg) {
   352	            $this->addSuccess($msg, 'admin');
   353	        }
   354	
   355	        // 承認通知先メールの送信（取り込み成功時のみ）
   356	        if ($handler->getFlashSuccesses() !== []) {
   357	            $this->sendApprovalNotificationMails($csvBag['approval_notification_target_members'] ?? []);
   358	        }
   359	
   360	        $event = new EventArgs([], $request);
   361	        $this->eventDispatcher->dispatch($event, EccubeEvents::ADMIN_STOCK_SPLIT_JOIN_LIST_SPLIT_CSV_IMPORT_COMPLETE);
   362	
   363	        return $this->redirectToRoute('admin_stock_split_join_list');
   364	    }
