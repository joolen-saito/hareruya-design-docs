    68	
    69	            /**
    70	             * 商品検索モーダル：商品決定処理
    71	             * product_class_id から AJAX で商品規格表示情報を取得し振替先セルにセットする。
    72	             * 振替元と振替先を比較し、差異がある項目を赤文字で表示する。
    73	             *
    74	             * @param {jQuery} $transferRow - 振替一覧の行
    75	             * @param {Object} destData - API 取得した振替先表示用データ
    76	             */
    77	            function applyDestToTransferRow($transferRow, destData) {
    78	                const destKeys = ['product_name_code', 'language', 'card_condition', 'foil', 'standard_price'];
    79	                const sourceColIndex = [0, 1, 2, 3, 4];
    80	
    81	                destKeys.forEach(function(destKey, i) {
    82	                    const $destCell = $transferRow.find('[data-destKey="' + destKey + '"]');
    83	                    const $sourceCell = $transferRow.find('td').eq(sourceColIndex[i]);
    84	
    85	                    if (destKey === 'product_name_code') {
    86	                        const sourceName = $sourceCell.clone().children().remove().end().text().replace(/\s+/g, ' ').trim();
    87	                        const sourceCode = $sourceCell.find('small').text().replace(/\s+/g, ' ').trim();
    88	                        const destName = (destData.product_name || '-').trim();
    89	                        const destCode = (destData.product_code || '-').trim();
    90	                        const nameDiff = sourceName !== destName;
    91	                        const codeDiff = sourceCode !== destCode;
    92	                        const nameHtml = nameDiff ? '<span class="text-danger">' + escapeHtml(destName) + '</span>' : escapeHtml(destName);
    93	                        const codeHtml = codeDiff ? '<span class="text-danger">' + escapeHtml(destCode) + '</span>' : escapeHtml(destCode);
    94	                        $destCell.html(nameHtml + '<br><small>' + codeHtml + '</small>');
    95	                    } else {
    96	                        const sourceText = $sourceCell.text().replace(/\s+/g, ' ').trim();
    97	                        const destText = (destData[destKey] ?? '-').toString().trim();
    98	                        $destCell.text(destText);
    99	                        $destCell.toggleClass('text-danger', sourceText !== destText);
   100	                    }
   101	                });
   102	            }
   103	
   104	            function escapeHtml(str) {
   105	                const div = document.createElement('div');
   106	                div.textContent = str;
   107	                return div.innerHTML;
   108	            }
   109	
   110	            // 商品検索モーダル内「決定」ボタン押下処理
