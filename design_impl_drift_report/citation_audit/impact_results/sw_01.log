    27	 * スマレジ側 Webhook にリトライ機構が無いため、受信失敗した在庫変動を後追いで補完する。
    28	 * 在庫変動履歴API は productId / storeId 単位でしか取得できないため、在庫一覧API で対象の
    29	 * (productId, storeId) を列挙し、対象日 (target_date) の在庫変動履歴を問い合わせる。
    30	 *
    31	 * 取得した在庫変動履歴のうち、まだ EC-CUBE に取り込まれていない (在庫変動履歴IDが未保存の) ものを
    32	 * Webhook 受信経路と同じ子ジョブ ({@see \Eccube\Message\SmaregiStockProcessMessage}) として enqueue し、
    33	 * 反映処理を既存ハンドラ・{@see \Eccube\Service\Smaregi\Webhook\Stock\SmaregiStockChangeApplier} に委譲する。
    34	 */
    35	final readonly class SmaregiStockBackfillAction
    36	{
    37	    /** バッチ起点の子ジョブであることを示す action ラベル (Webhook 受信は 'edited')。 */
    38	    public const ACTION_BACKFILL = 'backfill';
    39	
    40	    /** API 取得 1 ページあたりの件数。 */
    41	    private const PAGE_LIMIT = 1000;
    42	
    43	    /** ページング暴走防止のための最大ページ数。 */
    44	    private const MAX_PAGES = 1000;
    45	
    46	    public function __construct(
    47	        private LoggerInterface $logger,
    48	        private SmaregiAccessTokenService $accessTokenService,
    49	        private SmaregiStockApiClient $stockApiClient,
