   156	
   157	            // 在庫履歴の作成
   158	            $this->stockHistoryEntityManager->save(
   159	                ProductStock: $ProductStock,
   160	                StockChangeTypeDetail: $StockChangeTypeDetail,
   161	                oldStock: $beforeStock,
