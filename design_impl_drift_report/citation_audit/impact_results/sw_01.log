    56	        private string $smaregiApiContractId,
    57	    ) {
    58	    }
    59	
    60	    /**
    61	     * @param string|null $targetDate 取得対象日 (未指定時は駆動日)。スマレジ在庫変動履歴API の target_date に渡す。
    62	     *
    63	     * @return array{targetDate:string,pairs:int,fetched:int,enqueued:int,skipped:int,failed:int}
    64	     */
    65	    public function handle(?string $targetDate = null): array
    66	    {
    67	        $targetDate = ($targetDate === null || $targetDate === '')
    68	            ? (new \DateTime())->format('Y-m-d')
    69	            : $targetDate;
    70	
    71	        $accessToken = $this->accessTokenService->getAccessToken(
    72	            $this->smaregiApiIdUrl,
    73	            $this->smaregiApiContractId,
    74	            $this->smaregiApiClientId,
    75	            $this->smaregiApiClientSecret,
    76	        );
    77	
    78	        $pairs = $this->collectStockPairs($accessToken);
    79	
    80	        $summary = [
    81	            'targetDate' => $targetDate,
    82	            'pairs' => count($pairs),
    83	            'fetched' => 0,
    84	            'enqueued' => 0,
    85	            'skipped' => 0,
    86	            'failed' => 0,
    87	        ];
    88	
    89	        foreach ($pairs as $pair) {
    90	            $this->backfillPair($accessToken, $pair['productId'], $pair['storeId'], $targetDate, $summary);
    91	        }
    92	
    93	        $this->logger->info('Smaregi stock backfill finished', $summary);
    94	
    95	        return $summary;
    96	    }
    97	
    98	    /**
    99	     * 在庫一覧API をページングで全件取得し、対象の (productId, storeId) を列挙する。
   100	     *
   101	     * @return list<array{productId:string,storeId:string}>
   102	     */
   103	    private function collectStockPairs(string $accessToken): array
   104	    {
   105	        $pairs = [];
   106	        $seen = [];
   107	
   108	        $reachedEnd = false;
   109	        for ($page = 1; $page <= self::MAX_PAGES; $page++) {
   110	            $response = $this->stockApiClient->listStocks(
   111	                $this->smaregiApiUrl,
   112	                $this->smaregiApiContractId,
   113	                $accessToken,
   114	                [
   115	                    'page' => (string) $page,
   116	                    'limit' => (string) self::PAGE_LIMIT,
   117	                ],
   118	            );
   119	
   120	            $statusCode = $response['statusCode'];
   121	            if ($statusCode < 200 || $statusCode >= 300) {
   122	                throw new \RuntimeException(sprintf('Failed to list Smaregi stocks (page=%d, statusCode=%d)', $page, $statusCode));
   123	            }
   124	
   125	            $rows = $this->extractRows($response['json']);
   126	            foreach ($rows as $row) {
   127	                $productId = $this->stringOrNull($row['productId'] ?? null);
   128	                $storeId = $this->stringOrNull($row['storeId'] ?? null);
   129	                if ($productId === null || $storeId === null) {
   130	                    continue;
   131	                }
   132	                $key = $productId.'|'.$storeId;
   133	                if (isset($seen[$key])) {
   134	                    continue;
   135	                }
   136	                $seen[$key] = true;
   137	                $pairs[] = ['productId' => $productId, 'storeId' => $storeId];
   138	            }
   139	
   140	            if (count($rows) < self::PAGE_LIMIT) {
   141	                $reachedEnd = true;
   142	                break;
   143	            }
   144	        }
   145	
   146	        if (!$reachedEnd) {
   147	            // MAX_PAGES に達しても各ページが PAGE_LIMIT 件で埋まり続けている＝未取得の在庫が残っている
   148	            // 可能性があるため、対象の取りこぼしを黙って無視せず例外で失敗させる。
   149	            throw new \RuntimeException(sprintf('Smaregi stock list exceeded max pages (maxPages=%d, limit=%d); not all stock data retrieved.', self::MAX_PAGES, self::PAGE_LIMIT));
   150	        }
   151	
   152	        return $pairs;
   153	    }
   154	
   155	    /**
   156	     * 1 つの (productId, storeId) について、対象日の在庫変動履歴を取得し、未保存分を子ジョブへ enqueue する。
   157	     *
   158	     * @param array{targetDate:string,pairs:int,fetched:int,enqueued:int,skipped:int,failed:int} $summary
   159	     */
   160	    private function backfillPair(
   161	        string $accessToken,
   162	        string $productId,
   163	        string $storeId,
   164	        string $targetDate,
   165	        array &$summary,
   166	    ): void {
   167	        $reachedEnd = false;
   168	        for ($page = 1; $page <= self::MAX_PAGES; $page++) {
   169	            $response = $this->stockApiClient->listStockChanges(
   170	                $this->smaregiApiUrl,
   171	                $this->smaregiApiContractId,
   172	                $accessToken,
   173	                $productId,
   174	                $storeId,
   175	                [
   176	                    'target_date' => $targetDate,
   177	                    'page' => (string) $page,
   178	                    'limit' => (string) self::PAGE_LIMIT,
   179	                ],
   180	            );
   181	
   182	            $statusCode = $response['statusCode'];
   183	            if ($statusCode < 200 || $statusCode >= 300) {
   184	                // 1 ペアの失敗で全体を止めず、件数だけ記録して次のペアへ進む。
   185	                $summary['failed']++;
   186	                $this->logger->warning('Failed to list Smaregi stock changes', [
   187	                    'productId' => $productId,
   188	                    'storeId' => $storeId,
   189	                    'targetDate' => $targetDate,
   190	                    'page' => $page,
   191	                    'statusCode' => $statusCode,
   192	                ]);
   193	
   194	                return;
   195	            }
   196	
   197	            $rows = $this->extractRows($response['json']);
   198	            foreach ($rows as $row) {
   199	                $summary['fetched']++;
   200	                $this->enqueueIfUnsaved($row, $productId, $storeId, $summary);
   201	            }
   202	
   203	            if (count($rows) < self::PAGE_LIMIT) {
   204	                $reachedEnd = true;
   205	                break;
   206	            }
   207	        }
   208	
   209	        if (!$reachedEnd) {
   210	            // MAX_PAGES に達しても各ページが PAGE_LIMIT 件で埋まり続けている＝未取得の在庫変動が残っている
   211	            // 可能性があるため、当該ペアを失敗として記録する (全体は止めず次のペアへ進む)。
   212	            $summary['failed']++;
   213	            $this->logger->warning('Smaregi stock changes exceeded max pages; some changes may be unprocessed', [
   214	                'productId' => $productId,
   215	                'storeId' => $storeId,
   216	                'targetDate' => $targetDate,
   217	                'maxPages' => self::MAX_PAGES,
   218	            ]);
   219	        }
   220	    }
