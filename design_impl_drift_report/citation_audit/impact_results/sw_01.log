  1667	        $sql = <<<EOT
  1668	            (
  1669	                SELECT
  1670	                    o.id AS order_id,
  1671	                    o.order_date,
  1672	                    o.order_number,
  1673	                    CONCAT(o.kana01, ' ', o.kana02) AS name_kana,
  1674	                    CONCAT(o.name01, ' ', o.name02) AS name,
  1675	                    o.payment_total,
  1676	                    '□' AS expensive,
  1677	                    o.smaregi_code,
  1678	                    CASE WHEN o.message IS NOT NULL THEN true ELSE false END AS has_message
  1679	                FROM dtb_order o
  1680	                JOIN dtb_shipping s ON s.order_id = o.id
  1681	                JOIN mtb_order_status os ON os.id = o.order_status_id
  1682	                WHERE o.base_info_id = :baseInfoId
  1683	                  AND o.order_number IS NOT NULL
  1684	                  AND s.delivery_id = :otc
  1685	                  AND o.order_status_id = :orderNew
  1686	                  AND o.smaregi_code IS NOT NULL
  1687	                GROUP BY o.id
  1688	            )
  1689	            UNION
  1690	            (
  1691	                SELECT
  1692	                    o.id AS order_id,
  1693	                    o.order_date,
  1694	                    o.order_number,
  1695	                    CONCAT(o.kana01, ' ', o.kana02) AS name_kana,
  1696	                    CONCAT(o.name01, ' ', o.name02) AS name,
  1697	                    o.payment_total,
  1698	                    '□' AS expensive,
  1699	                    o.smaregi_code,
  1700	                    CASE WHEN o.message IS NOT NULL THEN true ELSE false END AS has_message
  1701	                FROM dtb_order o
  1702	                JOIN dtb_shipping s ON s.order_id = o.id
  1703	                WHERE o.base_info_id = :baseInfoId
  1704	                    AND o.order_number IS NOT NULL
  1705	                    AND o.browser_print_flg = true
  1706	                GROUP BY o.id
  1707	            )
  1708	            LIMIT 10
  1709	            EOT;
  1710	
  1711	        $rsm = new ResultSetMapping();
  1712	        $rsm
  1713	            ->addScalarResult('order_id', 'order_id')
  1714	            ->addScalarResult('order_date', 'order_date', 'datetimetz')
  1715	            ->addScalarResult('order_number', 'order_number')
  1716	            ->addScalarResult('name_kana', 'name_kana')
  1717	            ->addScalarResult('name', 'name')
  1718	            ->addScalarResult('payment_total', 'payment_total')
  1719	            ->addScalarResult('expensive', 'expensive')
  1720	            ->addScalarResult('smaregi_code', 'smaregi_code')
  1721	            ->addScalarResult('has_message', 'hasMessage')
  1722	        ;
  1723	
  1724	        $result = $this->getEntityManager()
  1725	            ->createNativeQuery($sql, $rsm)
  1726	            ->setParameters([
  1727	                'baseInfoId' => $base_info_id,
  1728	                'otc' => Delivery::OTC,
  1729	                'orderNew' => OrderStatus::NEW,
  1730	            ])
  1731	            ->getResult();
  1732	
  1733	        return $result;
  1734	    }
