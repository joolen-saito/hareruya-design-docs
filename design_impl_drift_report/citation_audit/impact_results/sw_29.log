   110	            function copyString(textString) {
   111	                const $tmpAttr = $('<div></div>');
   112	                $tmpAttr.text(textString);
   113	                $tmpAttr.css({
   114	                    position: 'absolute',
   115	                    left: '-100%',
   116	                });
   117	                $('body').append($tmpAttr);
   118	                const selection = document.getSelection();
   119	                if (selection) {
   120	                    selection.removeAllRanges();
   121	                    selection.selectAllChildren($tmpAttr.get(0));
   122	                }
   123	                const copied = document.execCommand('copy');
   124	                $tmpAttr.remove();
   125	                if (!copied) {
   126	                    if (navigator.clipboard && navigator.clipboard.writeText) {
   127	                        navigator.clipboard.writeText(textString);
   128	                    } else {
   129	                        window.prompt('URL', textString);
   130	                    }
   131	                }
   132	                return copied;
   133	            }
   134	
   135	            $(document).on('click', '.js-copy-url', function (event) {
   136	                event.preventDefault();
   137	                const url = $(this).data('url');
   138	                if (!url) {
   139	                    return;
   140	                }
   141	                copyString(url);
   142	            });
   143	        });
