    82	                $toggleButton.attr('aria-expanded', isOpen ? 'true' : 'false');
    83	            };
    84	
    85	            syncLabel($addForm.hasClass('show'));
    86	            $addForm.on('shown.bs.collapse', () => syncLabel(true));
    87	            $addForm.on('hidden.bs.collapse', () => syncLabel(false));
    88	        });
    89	    </script>
