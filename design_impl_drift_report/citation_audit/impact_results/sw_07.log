    79	CREATED_CLUSTER=1
    80	log "cluster restoring: ${TMP_CLUSTER_ID}"
    81	
    82	# 3. 一時インスタンスを作成
    83	aws rds create-db-instance \
    84	  --db-cluster-identifier "${TMP_CLUSTER_ID}" \
    85	  --db-instance-identifier "${TMP_INSTANCE_ID}" \
    86	  --engine "${DB_ENGINE}" \
    87	  --db-instance-class "${DB_INSTANCE_CLASS}" \
    88	  --no-publicly-accessible >/dev/null
    89	CREATED_INSTANCE=1
