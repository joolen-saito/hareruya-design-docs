    21	use Symfony\Component\Console\Input\InputInterface;
    22	use Symfony\Component\Console\Output\OutputInterface;
    23	use Symfony\Component\Console\Style\SymfonyStyle;
    24	
    25	/**
    26	 * 決済処理中チェックバッチ
    27	 *
    28	 * イベント申込のリンク型決済で、通信障害や決済画面からの離脱で申込完了画面へ
    29	 * 遷移しなかった申込についてSP.LINKSに取引照会を行い、照会結果に応じた処理を行う。
    30	 *
    31	 * 【使い方】
    32	 *
    33	 *   bin/console eccube:payment-status-check
    34	 */
    35	#[AsCommand(name: 'eccube:payment-status-check', description: '決済処理中チェックバッチ')]
    36	class PaymentStatusCheckCommand extends Command
    37	{
    38	    public function __construct(
    39	        private readonly PaymentStatusCheckAction $paymentStatusCheckAction,
    40	    ) {
    41	        parent::__construct();
    42	    }
    43	
    44	    #[\Override]
    45	    protected function execute(InputInterface $input, OutputInterface $output): int
    46	    {
    47	        $io = new SymfonyStyle($input, $output);
    48	
    49	        try {
    50	            $result = $this->paymentStatusCheckAction->handle();
    51	        } catch (\Throwable $e) {
    52	            $io->error('決済処理中チェックでエラーが発生しました。 '.$e->getMessage());
    53	
    54	            return Command::FAILURE;
    55	        }
    56	
    57	        if ($result['error'] > 0) {
    58	            $io->error('決済処理中チェックでエラーが発生しました。 '.$result['detail']);
    59	
    60	            return Command::FAILURE;
    61	        }
    62	
    63	        $io->success('決済処理中チェックが完了しました。'.$result['detail']);
    64	
    65	        return Command::SUCCESS;
    66	    }
    67	}

