    61	  --query "reverse(sort_by(DBClusterSnapshots[?DBClusterIdentifier=='${PROD_CLUSTER_ID}' && Status=='available'],&SnapshotCreateTime))[0].DBClusterSnapshotIdentifier" \
    62	  --output text)
    63	if [ -z "${SNAPSHOT_ID}" ] || [ "${SNAPSHOT_ID}" = "None" ]; then
