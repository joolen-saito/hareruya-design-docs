    28	read -ra VPC_SG_ARR <<< "${VPC_SECURITY_GROUP_IDS}"
    29	
    30	# 再実行・並列実行で他実行の一時DBを誤削除しないよう実行毎に一意な識別子にする
    31	# 複数ホスト同時実行でも衝突しないよう乱数由来のIDを使う(uuidgen が無い環境ではPIDで代替)
    32	RUN_ID="$(uuidgen 2>/dev/null | tr 'A-Z' 'a-z' | tr -cd 'a-z0-9' | cut -c1-8)"
    33	[ -n "${RUN_ID}" ] || RUN_ID="$$"
    34	RUN_SUFFIX="$(date +%Y%m%d%H%M%S)-${RUN_ID}"
