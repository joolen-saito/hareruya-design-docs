   108	if [ -z "${PGHOST}" ] || [ "${PGHOST}" = "None" ]; then
   109	  log "ERROR: ${TMP_CLUSTER_ID} のエンドポイントが取得できません"
   110	  exit 1
   111	fi
   112	export PGHOST
   113	log "endpoint: ${PGHOST}"
   114	
   115	# 6. 抽出クエリを実行して TSV を出力
   116	OUT="stock_$(date +%Y%m%d).txt"
