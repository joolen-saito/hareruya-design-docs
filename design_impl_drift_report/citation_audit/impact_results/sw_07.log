    67	log "snapshot: ${SNAPSHOT_ID}"
    68	
    69	# 2. スナップショットから一時クラスタを復元
    70	aws rds restore-db-cluster-from-snapshot \
    71	  --snapshot-identifier "${SNAPSHOT_ID}" \
    72	  --db-cluster-identifier "${TMP_CLUSTER_ID}" \
    73	  --engine "${DB_ENGINE}" \
    74	  ${DB_ENGINE_VERSION:+--engine-version "${DB_ENGINE_VERSION}"} \
    75	  --db-subnet-group-name "${DB_SUBNET_GROUP}" \
