namespace Eccube\Service\Admin\OtcBuyOrder;

use Eccube\Repository\DtbOtcBuyOrderRepository;
use Eccube\Repository\DtbOtcBuyOrderSummaryRepository;
use Eccube\Repository\Master\MtbOptionRepository;
use Eccube\Service\MailService;

class BatchAggregateSummaryAction
{
    public function __construct(
        private readonly DtbOtcBuyOrderRepository $otcBuyOrderRepository,
        private readonly DtbOtcBuyOrderSummaryRepository $otcBuyOrderSummaryRepository,
        private readonly MtbOptionRepository $mtbOptionRepository,
        private readonly MailService $mailService,
    ) {
    }

    /**
     * バッチ用の集計実行。
     * 集計完了後に部門未設定商品が存在する場合は通知メールを送信する。
     * 集計処理で例外が発生した場合はエラー通知メールを送信して例外を再スローする。
     *
     * @throws \Exception 集計処理で例外が発生した場合
     */
    public function handle(\DateTime $summaryDate): void
    {
        try {
            SummaryByDateAggregator::aggregate(
                $summaryDate,
                $this->otcBuyOrderRepository,
                $this->otcBuyOrderSummaryRepository,
                $this->mtbOptionRepository,
            );

            $noSectionProducts = $this->otcBuyOrderRepository->getNoSectionProducts($summaryDate);
            if (!empty($noSectionProducts)) {
                $this->mailService->sendNoSectionAlertMail($noSectionProducts);
            }
        } catch (\Exception $exception) {
            $this->mailService->sendUpdateOtcBuyOrderSummaryErrorMail($exception->getMessage());

            throw $exception;
        }
    }
}
     * 受注テーブルが肥大化した時点で部分インデックス
     *   `CREATE INDEX dtb_order_smaregi_delete_idx
     *      ON dtb_order (order_status_id) WHERE smaregi_del_flg = false AND smaregi_code IS NOT NULL`
     * 等の追加を検討する。バッチが日次 4 時実行のため当面は許容範囲を想定。
     *
     * @return list<Order>
     */
    public function getDeleteSmaregiProduct(int $limit = 100): array
    {
        $qb = $this->createQueryBuilder('o');
        $qb
            ->where($qb->expr()->in('o.OrderStatus', ':statusIds'))
            ->andWhere('o.smaregi_code IS NOT NULL')
            ->andWhere('o.smaregi_del_flg = :flgFalse')
            ->setParameter('statusIds', [OrderStatus::CANCEL, OrderStatus::DELIVERED, OrderStatus::PASSED])
            ->setParameter('flgFalse', Constant::DISABLED)
            ->orderBy('o.id', 'ASC')
            ->setMaxResults($limit);

        /** @var list<Order> $result */
        $result = $qb->getQuery()->getResult();

        return $result;
    }

    /**
     * スマレジ連携エラーの受注を取得
     */
    public function getSmaregiErrorOrder(): mixed
    {
        $qb = $this->createQueryBuilder('o');

        $results = $qb->join('o.Customer', 'c')
            ->join(DtbPlayer::class, 'p', 'WITH', 'c = p.Customer')
            ->select('o', 'p', 'c')
            ->where('o.smaregi_error_flg = 1')
            ->getQuery()
            ->getResult();

        $orders = [];
        $players = [];

        foreach ($results as $result) {
            if ($result instanceof Order) {
                $orders[] = $result;
            }

            if ($result instanceof DtbPlayer) {
                $players[$result->getCustomer()->getId()] = $result;
            }
        }

        $returnArray = [];

        foreach ($orders as $order) {
            $returnArray[] = [
                    // 利用ポイント履歴の存在を識別して判定する
                    if (!$this->pointHistoryRepository->hasSpendPointHistoryForOrder($Order)) {
                        $this->pointService->spendPoints($Order);
                    }
                    $shouldUpdateSmaregiPoint = true;
                }
                // 注文番号を取得
                $orderNumberEntity = $Order->getOrderNumber();
                // 注文番号を整形して取得
                $orderNumber = $orderNumberEntity !== null && $orderNumberEntity !== ''
                    ? sprintf('%08d', (int) $orderNumberEntity)
                    : '';
                // 在庫履歴と販売数を更新
                $this->shoppingService->updateStock($Order, $orderNumber);
                // メールの再送信
                $this->mailService->resendOrderMail($Order, $this->getLang($Order->getCustomer()));
                $this->entityManager->commit();
                ++$processedCount;

                if (!empty($shouldUpdateSmaregiPoint)) {
                    // スマレジポイント連携を別プロセスで実行
                    $projectDir = $this->eccubeConfig->get('kernel.project_dir');
                    $process = Process::fromShellCommandline(
                        "nohup php {$projectDir}/bin/console eccube:smaregi:update-point {$Order->getId()} &"
                    );
                    $process->run();
                    if (!$process->isSuccessful()) {
                        log_warning("Warning: Smaregi point update failed for Order ID {$Order->getId()}: {$process->getErrorOutput()}\n");
                    }
                }
            } catch (\Exception $e) {
                ++$failedCount;
                log_error('購入完了手続き再処理で受注処理に失敗しました', [
                    'order_id' => $Order->getId(),
                    'message' => $e->getMessage(),
                ]);
                if ($this->entityManager->getConnection()->isTransactionActive()) {
                    $this->entityManager->rollback();
                }
            }
        }
