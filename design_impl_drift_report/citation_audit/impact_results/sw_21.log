     1	{% extends '@admin/default_frame.twig' %}
     2	
     3	{% set menus = ['setting', 'basic_info', 'custom_automail'] %}
     4	
     5	{% block title %}{{ 'admin.setting.shop.custom_automail'|trans }}{% endblock %}
     6	{% block sub_title %}{{ 'admin.setting.basic_info'|trans }}{% endblock %}
     7	
     8	{% form_theme form '@admin/Form/bootstrap_4_horizontal_layout.html.twig' %}
     9	
    10	{% block stylesheet %}
    11	    <style>
    12	        .ui-resizable-se {
    13	            right: -3px;
    14	            bottom: -3px;
    15	        }
    16	    </style>
    17	{% endblock %}
    18	
    19	{% block javascript %}
    20	<script nonce="{{ csp_nonce }}">
    21	    $(function() {
    22	
    23	        $(window).on('pageshow', function() {
    24	            const tmp_select =  $('#mail_template[name="mail[template]"] option[selected]').val();
    25	            $('#mail_template[name="mail[template]"]').val(tmp_select);
    26	            
    27	            $('#mail_template[name="mail[template]"] option[value=""]').prop('disabled', true);
    28	        });
    29	
    30	        $('#mail_template').on('change', function() {
    31	            const id = $(this).val();
    32	            if (id) {
    33	                location.href = '{{ url('admin_mall_auto_mail_edit') }}/' + id;
    34	            } else {
    35	                location.href = '{{ url('admin_mall_auto_mail_edit') }}';
    36	            }
    37	        });
    38	
    39	        $('#form1').on('submit', function(e) {
    40	            const mailId = '{{ Mail ? Mail.id : '' }}';
    41	            if (!mailId) {
    42	                e.preventDefault();
    43	                alert('{{ 'admin.setting.shop.custom_automail.new'|trans }}');
    44	                return false;
    45	            }
    46	        });
    47	    });
    48	</script>
    49	{% endblock javascript %}
    50	
    51	{% block main %}
    52	    <form name="form1" role="form" class="form-horizontal" id="form1" method="post" action="">
    53	        {{ form_widget(form._token) }}
    54	        <div class="c-contentsArea__cols">
    55	            <div class="c-contentsArea__primaryCol">
    56	                <div class="c-primaryCol">
    57	                    <div class="card rounded border-0 mb-4">
    58	                        <div class="card-header"><span class="card-title">{{ 'admin.setting.shop.mail.mail_template_edit'|trans }}</span></div>
    59	                        <div class="card-body">
    60	                            <div class="row mb-2">
    61	                                <div class="col-2">
    62	                                    <div class="d-inline-block" data-bs-toggle="tooltip" data-bs-placement="top" title="{{ 'tooltip.setting.shop.mail.mail_template'|trans }}">
    63	                                        <span>{{ 'admin.setting.shop.mail.mail_template'|trans }}</span><i class="fa fa-question-circle fa-lg ms-1"></i>
    64	                                    </div>
    65	                                </div>
    66	                                <div class="col-10">
    67	                                    {{ form_widget(form.template) }}
    68	                                    {{ form_errors(form.template) }}
    69	                                </div>
    70	                            </div>
    71	                            {% if Mail and Mail.id %}
    72	                            <div class="row mb-2">
    73	                                <div class="col-2"><span>{{ 'admin.common.last_updater'|trans }}</span></div>
    74	                                <div class="col-10">
    75	                                    {{ Mail.Creator ? Mail.Creator.name : '' }}
    76	                                </div>
    77	                            </div>
    78	                            <div class="row mb-2">
    79	                                <div class="col-2"><span>{{ 'admin.common.last_update_date'|trans }}</span></div>
    80	                                <div class="col-10">
    81	                                    {{ Mail.update_date ? Mail.update_date|date('Y-m-d H:i:s') : '' }}
    82	                                </div>
    83	                            </div>
    84	                            <div class="row mb-2">
    85	                                <div class="col-2"><span>{{ 'admin.setting.shop.mail.mail_template_name'|trans }}</span><span class="badge bg-primary ms-1">{{ 'admin.common.required'|trans }}</span></div>
    86	                                <div class="col-10">
    87	                                    {{ form_widget(form.name) }}
    88	                                    {{ form_errors(form.name) }}
    89	                                </div>
    90	                            </div>
    91	                            <div class="row mb-2">
    92	                                <div class="col-2"><span>{{ 'admin.setting.shop.mail.mail_subject'|trans }}</span><span class="badge bg-primary ms-1">{{ 'admin.common.required'|trans }}</span></div>
    93	                                <div class="col-10">
    94	                                    {{ form_widget(form.mail_subject) }}
    95	                                    {{ form_errors(form.mail_subject) }}
    96	                                </div>
    97	                            </div>
    98	                            {% if template_header is not empty and template_header|trim is not empty %}
    99	                            <div class="row mb-3">
   100	                                <div class="col-2"><span>{{ 'admin.setting.shop.mail.mail_template_header'|trans }}</span></div>
   101	                                <div class="col-10">
   102	                                    <textarea readonly class="form-control bg-light" rows="2" style="resize: vertical;">{{ template_header }}</textarea>
   103	                                </div>
   104	                            </div>
   105	                            {% endif %}
   106	                            <div class="row mb-2">
   107	                                <div class="col-2"><span>{{ 'admin.setting.shop.mail.mail_header'|trans }}</span></div>
   108	                                <div class="col-10">
   109	                                    {{ form_widget(form.header) }}
   110	                                    {{ form_errors(form.header) }}
   111	                                </div>
   112	                            </div>
   113	                            {% if form.tpl_data.vars.value is not empty and form.tpl_data.vars.value|trim is not empty %}
   114	                            <div class="row mb-2">
   115	                                <div class="col-2"><span>{{ 'admin.setting.shop.mail.mail_template_body'|trans }}</span></div>
   116	                                <div class="col-10">
   117	                                    {{ form_widget(form.tpl_data, {'attr': {'rows': 20, 'readonly': true, 'class': 'form-control bg-light' ~ (has_errors(form.tpl_data) ? ' is-invalid' : '')}}) }}
   118	                                    {{ form_errors(form.tpl_data) }}
   119	                                </div>
   120	                            </div>
   121	                            {% endif %}
   122	                            <div class="row mb-2">
   123	                                <div class="col-2"><span>{{ 'admin.setting.shop.mail.mail_footer'|trans }}</span></div>
   124	                                <div class="col-10">
   125	                                    {{ form_widget(form.footer) }}
   126	                                    {{ form_errors(form.footer) }}
   127	                                </div>
   128	                            </div>
   129	                            {% if template_footer is not empty and template_footer|trim is not empty %}
   130	                            <div class="row mb-2">
   131	                                <div class="col-2"><span>{{ 'admin.setting.shop.mail.mail_template_footer'|trans }}</span></div>
   132	                                <div class="col-10">
   133	                                    <pre class="bg-light p-3 border" style="white-space: pre-wrap; word-wrap: break-word; max-height: 200px; overflow-y: auto;">{{ template_footer }}</pre>
   134	                                </div>
   135	                            </div>
   136	                            {% endif %}
   137	
   138	                            {% for f in form|filter(f => f.vars.eccube_form_options.auto_render) %}
   139	                                {% if f.vars.eccube_form_options.form_theme %}
   140	                                    {% form_theme f f.vars.eccube_form_options.form_theme %}
   141	                                    {{ form_row(f) }}
   142	                                {% else %}
   143	                                    <div class="row mb-2">
   144	                                        <div class="col-2"><span>{{ f.vars.label|trans }}</span></div>
   145	                                        <div class="col-10">
   146	                                            {{ form_widget(f) }}
   147	                                            {{ form_errors(f) }}
   148	                                        </div>
   149	                                    </div>
   150	                                {% endif %}
   151	                            {% endfor %}
   152	                            {% endif %}
   153	                        </div>
   154	                    </div>
   155	                </div>
   156	            </div>
   157	        </div>
   158	        <div class="c-conversionArea" id="aside_column">
   159	            <div class="c-conversionArea__container">
   160	                <div class="row justify-content-between align-items-center">
   161	                    <div class="col-6">
   162	                        <div class="c-conversionArea__leftBlockItem">
   163	                        </div>
   164	                    </div>
   165	                    <div class="col-6">
   166	                        <div id="ex-conversion-action" class="row align-items-center justify-content-end">
   167	                            {% if Mail and Mail.id %}
   168	                            <div class="col-auto">
   169	                                <button class="btn btn-ec-conversion px-5" type="submit">{{ 'admin.common.registration'|trans }}</button>
   170	                            </div>
   171	                            {% endif %}
   172	                        </div>
   173	                    </div>
   174	                </div>
   175	            </div>
   176	        </div>
   177	    </form>
   178	{% endblock %}
