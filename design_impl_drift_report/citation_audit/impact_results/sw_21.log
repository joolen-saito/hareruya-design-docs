    46	     * @return array<string, mixed>|RedirectResponse
    47	     */
    48	    #[\Symfony\Component\Routing\Attribute\Route(path: '/%eccube_admin_route%/mall/auto_mail', name: 'admin_mall_auto_mail', methods: ['GET', 'POST'])]
    49	    #[\Symfony\Component\Routing\Attribute\Route(path: '/%eccube_admin_route%/mall/auto_mail/{Mail}', name: 'admin_mall_auto_mail_edit', methods: ['GET', 'POST'])]
    50	    #[Template(template: '@admin/mall/AutoMail/detail.twig')]
    51	    public function index(
    52	        Request $request,
    53	        Environment $twig,
    54	        CacheUtil $cacheUtil,
    55	        ?MailTemplate $Mail = null,
    56	    ): array|RedirectResponse {
    57	        $Mall = $this->baseInfoRepository->find($this->eccubeConfig->get('eccube_root_base_info_id'));
