    32	class TaxRuleType extends AbstractType
    33	{
    34	    public function __construct(protected TaxRuleRepository $taxRuleRepository)
    35	    {
    36	    }
    37	
    38	    /**
    39	     * {@inheritdoc}
    40	     *
    41	     * @param array<string, mixed> $options
    42	     */
    43	    #[\Override]
    44	    public function buildForm(FormBuilderInterface $builder, array $options): void
    45	    {
    46	        $builder
    47	            ->add('tax_rate', IntegerType::class, [
    48	                'required' => true,
    49	                'constraints' => [
    50	                    new Assert\NotBlank(),
    51	                    new Assert\Range(['min' => 0]),
    52	                    new Assert\Regex([
    53	                        'pattern' => "/^\d+(\.\d+)?$/u",
    54	                        'message' => 'form_error.float_only',
    55	                    ]),
    56	                ],
    57	            ])
    58	            ->add('rounding_type', RoundingTypeType::class, [
    59	                'required' => true,
    60	            ])
    61	            ->add('apply_date', DateTimeType::class, [
    62	                'widget' => 'single_text',
    63	                'input' => 'datetime',
    64	                'years' => range(date('Y'), date('Y') + 10),
    65	                'placeholder' => [
    66	                    'year' => '----', 'month' => '--', 'day' => '--',
    67	                ],
    68	                'constraints' => [
    69	                    new Assert\NotBlank(),
    70	                ],
    71	            ]);
    72	
    73	        $builder->addEventListener(FormEvents::POST_SUBMIT, function (FormEvent $event): void {
    74	            /** @var TaxRule $TaxRule */
    75	            $TaxRule = $event->getData();
    76	            $qb = $this->taxRuleRepository->createQueryBuilder('t');
    77	            $qb
    78	                ->select('count(t.id)')
    79	                ->where('t.apply_date = :apply_date')
    80	                ->andWhere('t.ProductClass IS NULL')
    81	                ->setParameter('apply_date', $TaxRule->getApplyDate());
    82	
    83	            if ($TaxRule->getId()) {
    84	                $qb
    85	                    ->andWhere('t.id <> :id')
    86	                    ->setParameter('id', $TaxRule->getId());
    87	            }
    88	            $count = $qb->getQuery()
    89	                ->getSingleScalarResult();
    90	            if ($count > 0) {
    91	                $form = $event->getForm();
    92	                $form['apply_date']->addError(new FormError(trans('admin.setting.shop.tax.apply_date.available_error')));
    93	            }
    94	        });
    95	    }
    96	
    97	    /**
    98	     * {@inheritdoc}
    99	     */
   100	    #[\Override]
   101	    public function configureOptions(OptionsResolver $resolver): void
   102	    {
   103	        $resolver->setDefaults([
   104	            'data_class' => TaxRule::class,
   105	        ]);
   106	    }
   107	
   108	    /**
   109	     * {@inheritdoc}
   110	     */
    55	        protected TokenStorageInterface $tokenStorage,
    56	        protected AuthorizationCheckerInterface $authorizationChecker,
    57	        MallReferenceViaTenantViewRepository $referenceViaTenantViewRepository,
    58	        EccubeConfig $eccubeConfig,
    59	        ConnectionType $connectionName = ConnectionType::LOW_TRAFFIC,
    60	    ) {
    61	        $em = $registry->getManager($connectionName->value);
    62	        assert($em instanceof EntityManagerInterface);
    63	        parent::__construct(
    64	            $em,
    65	            $em->getClassMetadata(TaxRule::class)
    66	        );
    67	        $this->baseInfo = $referenceViaTenantViewRepository->getMallBaseInfo();
    68	        $this->eccubeConfig = $eccubeConfig;
    69	    }
    70	
    71	    /**
    72	     * 新たな TaxRule インスタンスを生成して返す.
    73	     *
    74	     * 現在適用されている丸め規則を設定する.
    75	     * 現在適用されている丸め規則が取得できない場合は四捨五入を設定する.
    76	     */
    77	    public function newTaxRule(BaseInfo $baseInfo): TaxRule
    78	    {
    79	        /** @var RoundingType $RoundingType */
    80	        $RoundingType = $this->getEntityManager()->getRepository(RoundingType::class)->find(RoundingType::ROUND);
    81	        try {
    82	            $CurrentRule = $this->getByRule();
    83	            $RoundingType = $CurrentRule->getRoundingType();
    84	        } catch (NoResultException) {
    85	            // quiet
    86	        }
    87	        $TaxRule = new TaxRule();
    88	        $TaxRule->setRoundingType($RoundingType);
    89	        $TaxRule->setTaxAdjust('0');
    90	        $TaxRule->setBaseInfo($baseInfo);
    91	
    92	        return $TaxRule;
    93	    }
