    94	            }
    95	
    96	            $form->handleRequest($request);
    97	
    98	            if ($form->isSubmitted() && $form->isValid()) {
    99	                $Mail = $form->getData();
   100	
   101	                $this->entityManager->persist($Mail);
   102	                $this->entityManager->flush();
   103	
   104	                $event = new EventArgs(
   105	                    [
   106	                        'form' => $form,
   107	                        'Mail' => $Mail,
   108	                    ],
