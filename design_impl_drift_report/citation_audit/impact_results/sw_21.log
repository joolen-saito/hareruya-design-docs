   110	                );
   111	                $this->eventDispatcher->dispatch($event, EccubeEvents::ADMIN_MALL_AUTO_MAIL_INDEX_COMPLETE);
   112	
   113	                $this->addSuccess('admin.common.save_complete', 'admin');
