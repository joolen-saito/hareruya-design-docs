   131	    /**
   132	     * テンプレートファイルを解析して、header、本文、footerに分割
   133	     *
   134	     * @param string $source テンプレートファイルの内容
   135	     *
   136	     * @return array<string, string> ['header_prefix' => string, 'body' => string, 'footer_suffix' => string]
   137	     */
   138	    private function replaceBody(string $source): array
   139	    {
   140	        $headerPrefix = '';
   141	        $body = $source;
   142	        $footerSuffix = '';
   143	
   144	        $headerPos = strpos($source, '{{ header }}');
   145	        if ($headerPos !== false) {
   146	            $headerPrefix = substr($source, 0, $headerPos);
   147	            $body = substr($source, $headerPos + strlen('{{ header }}'));
   148	        }
   149	
   150	        $footerPos = strpos($body, '{{ footer }}');
   151	        if ($footerPos !== false) {
   152	            $footerSuffix = substr($body, $footerPos + strlen('{{ footer }}'));
   153	            $body = substr($body, 0, $footerPos);
   154	        }
   155	
   156	        return [
   157	            'header_prefix' => $headerPrefix,
   158	            'body' => $body,
   159	            'footer_suffix' => $footerSuffix,
   160	        ];
   161	    }
   162	}
