    71	        $this->eventDispatcher->dispatch($event, EccubeEvents::ADMIN_SETTING_SHOP_MAIL_INDEX_INITIALIZE);
    72	
    73	        $form = $builder->getForm();
    74	
    75	        $parsed = [
    76	            'header_prefix' => '',
    77	            'body' => '',
    78	            'footer_suffix' => '',
    79	        ];
    80	
    81	        if ($Mail !== null && $Mail->getId() !== null) {
    82	            $form['template']->setData($Mail);
    83	            $source = $twig->getLoader()
    84	                ->getSourceContext($Mail->getFileName())
    85	                ->getCode();
