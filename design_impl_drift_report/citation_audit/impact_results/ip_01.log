   419	     * 基準店舗の ProductStock を新店舗用に複製する（在庫数0で初期化）。
   420	     *
   421	     * @param int $sourceBaseInfoId 基準店舗ID（複製元）
   422	     * @param int $targetBaseInfoId 新店舗ID（複製先）
   423	     *
   424	     * @return int 作成件数
   425	     */
   426	    public function copyStockForNewShop(int $sourceBaseInfoId, int $targetBaseInfoId): int
   427	    {
   428	        $now = new \DateTime();
   429	
   430	        $sql = <<<SQL
   431	            INSERT INTO dtb_product_stock
   432	                (product_class_id, base_info_id, creator_id, stock, stock_location_id, total_cost, pick_up_flg, create_date, update_date)
   433	            SELECT
   434	                product_class_id, :target_base_info_id, 1, 0, stock_location_id, 0, false, :now, :now
   435	            FROM
   436	                dtb_product_stock
   437	            WHERE
   438	                base_info_id = :source_base_info_id
   439	            SQL;
   440	
   441	        return $this->getEntityManager()->getConnection()->executeStatement(
   442	            $sql,
   443	            [
   444	                'target_base_info_id' => $targetBaseInfoId,
   445	                'source_base_info_id' => $sourceBaseInfoId,
   446	                'now' => $now,
   447	            ],
   448	            [
   449	                'target_base_info_id' => ParameterType::INTEGER,
   450	                'source_base_info_id' => ParameterType::INTEGER,
   451	                'now' => Types::DATETIMETZ_MUTABLE,
   452	            ],
   453	        );
   454	    }
