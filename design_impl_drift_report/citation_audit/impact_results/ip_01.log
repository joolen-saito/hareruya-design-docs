    26	/**
    27	 * 店頭買取 日次集計バッチ
    28	 *
    29	 * 店舗・買取成立日・部門ごとに店頭買取情報を集計し、dtb_otc_buy_order_summary に登録する。
    30	 * 対象日のデータが既に存在する場合は削除して再登録する（べき等）。
    31	 *
    32	 * 【使い方】
    33	 *
    34	 *   # 前日分を集計（引数省略時）
    35	 *   bin/console eccube:otc-buy-order:aggregate-summary
    36	 *
    37	 *   # 日付を指定して集計
    38	 *   bin/console eccube:otc-buy-order:aggregate-summary 2026-03-01
    39	 *
    40	 * 【メール通知】
    41	 *   - 部門未設定の商品が存在する場合: 部門未設定商品通知メールを送信（集計は続行）
    42	 *   - 集計処理でエラーが発生した場合: 集計エラー通知メールを送信
    43	 *   送信先: MtbOption の otc_summary_mail_address（カンマ区切りで複数指定可）
    44	 */
    45	#[AsCommand(name: 'eccube:otc-buy-order:aggregate-summary', description: '店頭買取集計バッチ')]
    46	class OtcBuyOrderAggregateSummaryCommand extends Command
    47	{
    48	    public function __construct(private readonly BatchAggregateSummaryAction $batchAggregateSummaryAction)
    49	    {
    50	        parent::__construct();
    51	    }
    52	
    53	    #[\Override]
    54	    protected function configure(): void
    55	    {
    56	        $this->addArgument('date', InputArgument::OPTIONAL, '集計対象日 (Y-m-d形式)。省略時は前日');
    57	    }
    58	
    59	    #[\Override]
    60	    protected function execute(InputInterface $input, OutputInterface $output): int
    61	    {
    62	        $io = new SymfonyStyle($input, $output);
    63	
    64	        $dateArg = $input->getArgument('date');
    65	        if ($dateArg !== null) {
    66	            $summaryDate = \DateTime::createFromFormat('Y-m-d', $dateArg);
    67	            if ($summaryDate === false) {
    68	                $io->error('日付の形式が正しくありません。Y-m-d形式で指定してください。例: 2026-03-01');
    69	
    70	                return Command::FAILURE;
    71	            }
    72	        } else {
    73	            $summaryDate = new \DateTime('yesterday');
    74	        }
    75	
    76	        $summaryDate->setTime(0, 0, 0);
    77	
    78	        $io->info('集計対象日: '.$summaryDate->format('Y-m-d'));
    79	
    80	        try {
    81	            $this->batchAggregateSummaryAction->handle($summaryDate);
    82	        } catch (\Exception $e) {
    83	            $io->error('集計処理でエラーが発生しました: '.$e->getMessage());
    84	
    85	            return Command::FAILURE;
    86	        }
    87	
    88	        $io->success('店頭買取集計が完了しました。');
    89	
    90	        return Command::SUCCESS;
    91	    }
    92	}
