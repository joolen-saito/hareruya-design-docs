    30	     * 基準店舗の ProductStock を新店舗用に複製する（在庫数0で初期化）。
    31	     *
    32	     * @param int $targetBaseInfoId 新店舗のBaseInfo ID
    33	     *
    34	     * @return int 作成件数
    35	     */
    36	    public function handle(int $targetBaseInfoId): int
    37	    {
    38	        $TargetBaseInfo = $this->baseInfoRepository->find($targetBaseInfoId);
    39	        if ($TargetBaseInfo === null) {
    40	            throw new \RuntimeException(sprintf('新店舗（base_info_id=%d）が見つかりません。', $targetBaseInfoId));
    41	        }
    42	
    43	        $sourceBaseInfoId = \Eccube\Entity\BaseInfo::TC_TOKYO_ID;
    44	        if ($targetBaseInfoId === $sourceBaseInfoId) {
    45	            throw new \RuntimeException(sprintf('新店舗IDと基準店舗IDが同一です（base_info_id=%d）。', $targetBaseInfoId));
    46	        }
    47	
    48	        $SourceBaseInfo = $this->baseInfoRepository->find($sourceBaseInfoId);
    49	        if ($SourceBaseInfo === null) {
    50	            throw new \RuntimeException(sprintf('基準店舗（base_info_id=%d）が見つかりません。', $sourceBaseInfoId));
    51	        }
    52	
    53	        return $this->productStockRepository->copyStockForNewShop($sourceBaseInfoId, $targetBaseInfoId);
    54	    }
    55	}
