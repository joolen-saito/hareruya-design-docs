   231	    /**
   232	     * サプライ/パック（CardDetail未設定）を保持し、金額を加算
   233	     *
   234	     * @param DtbBuyMainCard[] $ExistingBuyMainCards
   235	     * @param int[] $keepCardIds
   236	     *
   237	     * @return array{int, int[]} [サプライ/パック合計, 更新後の保持ID配列]
   238	     */
   239	    private function preserveSupplyPackCards(
   240	        array $ExistingBuyMainCards,
   241	        int $bulkPurchaseId,
   242	        array $keepCardIds,
   243	    ): array {
   244	        $supplyPackTotal = 0;
   245	
   246	        foreach ($ExistingBuyMainCards as $Card) {
   247	            $Product = $Card->getProduct();
   248	
   249	            // まとめて買取商品は削除対象（保持しない）
   250	            if ($Product->getId() === $bulkPurchaseId) {
   251	                continue;
   252	            }
   253	
   254	            // CardDetail未設定 = サプライ/パック → 保持
   255	            if ($Product->getCardDetail() === null) {
   256	                $supplyPackTotal += ($Card->getPrice() ?? 0) * ($Card->getCount() ?? 0);
   257	                $keepCardIds[] = $Card->getId();
   258	            }
   259	        }
   260	
   261	        return [$supplyPackTotal, $keepCardIds];
   262	    }
   263	
   264	    /**
   265	     * 金額を10円未満は切り上げ
   266	     *
   267	     * @param int $price
   268	     *
   269	     * @return int
   270	     */
   271	    private function roundUpPrice(int $price): int
   272	    {
   273	        return (int) ceil($price / self::PRICE_ROUNDING_UNIT) * self::PRICE_ROUNDING_UNIT;
   274	    }
