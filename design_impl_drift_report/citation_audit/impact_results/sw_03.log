    47	    /**
    48	     * 査定終了処理
    49	     *
    50	     * ネット買取の場合はユーザーの買取申込時にカード情報をDBに登録済みのため店頭買取とロジックが異なる。
    51	     * ①査定データと登録済みデータを比較して同じものは上書きする
    52	     * ②言語や状態が異なるなどの場合は新規レコードとする
    53	     * ③査定データに含まれなかったDB登録済みレコードを削除する
    54	     */
    55	    public function handle(UpdateBuyOrderInput $input): void
    56	    {
    57	        $this->entityManager->beginTransaction();
    58	
    59	        try {
    60	            $oldStatusId = $input->BuyOrder->getBuyOrderStatus()->getId();
    61	            $bulkPurchaseId = $this->bulkPurchaseIdService->get();
    62	
    63	            // 既存データを取得
    64	            /** @var DtbBuyMainCard[] $ExistingBuyMainCards */
    65	            $ExistingBuyMainCards = $this->buyMainCardRepository->findBy(['BuyOrder' => $input->BuyOrder->getId()]);
    66	            $ExistingIndivisualMap = $this->buildExistingIndivisualMap($input->BuyOrder);
    67	
    68	            // orderDetailsから保存用のEntityを構築し、洗い替えで保持するIDと小計を取得
    69	            $buildResult = $this->buildOrderDetailEntities(
    70	                $input->BuyOrder,
    71	                $input->orderDetails,
    72	                $ExistingBuyMainCards,
    73	                $ExistingIndivisualMap
    74	            );
    75	
    76	            // 構築したEntityを永続化
    77	            foreach ($buildResult['entities'] as $Entity) {
    78	                $this->entityManager->persist($Entity);
    79	            }
    80	
    81	            // サプライ/パックは既存レコードを保持し、小計を加算
    82	            [$supplyPackTotal, $keepCardIds] = $this->preserveSupplyPackCards(
    83	                $ExistingBuyMainCards,
    84	                $bulkPurchaseId,
    85	                $buildResult['keepCardIds']
    86	            );
    87	
    88	            // 不要レコードを削除
    89	            foreach ($ExistingBuyMainCards as $Card) {
    90	                if (!in_array($Card->getId(), $keepCardIds, true)) {
    91	                    $this->entityManager->remove($Card);
    92	                }
    93	            }
    94	            foreach ($ExistingIndivisualMap as $IndivisualProduct) {
    95	                if (!in_array($IndivisualProduct->getId(), $buildResult['keepIndivisualIds'], true)) {
    96	                    $this->entityManager->remove($IndivisualProduct);
    97	                }
    98	            }
    99	
   100	            // BuyOrder更新
   101	            $now = new \DateTime();
   102	            $totalPrice = $this->roundUpPrice($buildResult['totalPrice'] + $supplyPackTotal);
   103	            $input->BuyOrder
   104	                ->setBuyOrderStatus($input->NewBuyOrderStatus)
   105	                ->setTotalPrice($totalPrice)
   106	                ->setMember($input->Member)
   107	                ->setUpdateDate($now);
   108	            $this->entityManager->persist($input->BuyOrder);
   109	
   110	            // ステータスが変更された場合、履歴を登録
   111	            if ($oldStatusId !== $input->NewBuyOrderStatus->getId()) {
   112	                $this->buyOrderStatusHistoryEntityManager->save(
   113	                    $input->BuyOrder,
   114	                    $input->NewBuyOrderStatus,
   115	                    $input->Member,
   116	                    $now
   117	                );
   118	            }
   119	
   120	            $this->entityManager->flush();
   121	            $this->entityManager->commit();
   122	        } catch (InvalidParameterException $e) {
   123	            $this->entityManager->rollback();
   124	            $this->logger->warning('Invalid parameter in buy order update', [
   125	                'exception' => $e,
   126	                'buyOrderId' => $input->BuyOrder->getId(),
   127	                'memberId' => $input->Member->getId(),
   128	            ]);
   129	            throw $e;
   130	        } catch (\Throwable $e) {
   131	            $this->entityManager->rollback();
   132	            $this->logger->error('Failed to update buy order assessment', [
   133	                'exception' => $e,
   134	                'buyOrderId' => $input->BuyOrder->getId(),
   135	                'memberId' => $input->Member->getId(),
   136	            ]);
   137	            throw new InternalException('システムエラーが発生しました', $e);
   138	        }
   139	    }
