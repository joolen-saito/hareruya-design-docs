    16	namespace Eccube\Controller\App\MTGBuyer\V1\Admin;
    17	
    18	use Eccube\Controller\AbstractController;
    19	use Eccube\Entity\DtbBuyMainCard;
    20	use Eccube\Repository\DtbBuyMainCardRepository;
    21	use Symfony\Component\HttpFoundation\JsonResponse;
    22	use Symfony\Component\HttpFoundation\Request;
    23	use Symfony\Component\Routing\Attribute\Route;
    24	use Symfony\Component\Security\Http\Attribute\IsGranted;
    25	
    26	#[IsGranted('IS_AUTHENTICATED_FULLY')]
    27	class BuyMainCardController extends AbstractController
    28	{
    29	    public function __construct(
    30	        private readonly DtbBuyMainCardRepository $buyMainCardRepository,
    31	    ) {
    32	    }
    33	
    34	    /**
    35	     * 複数ネット買取IDからネット買取受注の商品一覧を取得
    36	     */
    37	    #[Route('/%eccube_api_v1_route%/admin/buyMainCard.json', name: 'api_admin_buy_main_card', methods: ['POST'])]
    38	    public function getByBuyOrderIds(Request $request): JsonResponse
    39	    {
    40	        $ids = $request->request->get('ids');
    41	
    42	        // 旧システム互換目的：クライアントAppが空のリクエストを送信する可能性があり、400エラーで返すとハンドリングできないため空配列を返す
    43	        if ($ids === null || $ids === '') {
    44	            return new JsonResponse([]);
    45	        }
    46	
    47	        // カンマ区切りを配列に変換し、数字のみをフィルタリング
    48	        $buyOrderIds = array_filter(
    49	            explode(',', $ids),
    50	            static fn (string $id) => preg_match('/^\d+$/', trim($id)) === 1
    51	        );
    52	        $buyOrderIds = array_map('intval', $buyOrderIds);
    53	
    54	        // 有効なIDがない場合は空配列を返す
    55	        if (empty($buyOrderIds)) {
    56	            return new JsonResponse([]);
    57	        }
    58	
    59	        $BuyMainCards = $this->buyMainCardRepository->findByBuyOrderIdsWithApplicationPrices($buyOrderIds);
    60	
    61	        $response = array_map(function (DtbBuyMainCard $BuyMainCard): array {
    62	            // 状態（NM、SP等）をキーにした買取価格を整形
    63	            $pricesByCondition = [];
    64	            foreach ($BuyMainCard->getApplicationPrices() as $ApplicationPrice) {
    65	                $conditionCode = $ApplicationPrice->getCardCondition()->getCode();
    66	                $pricesByCondition[$conditionCode] = $ApplicationPrice->getApplicationPrice();
    67	            }
    68	
    69	            return [
    70	                'buyMainCardId' => $BuyMainCard->getId(),
    71	                'buyOrderId' => $BuyMainCard->getBuyOrder()->getId(),
    72	                'productId' => $BuyMainCard->getProduct()->getId(),
    73	                'languageId' => $BuyMainCard->getLanguage()?->getId(),
    74	                'foilFlg' => $BuyMainCard->getFoilFlg(),
    75	                'count' => $BuyMainCard->getCount(),
    76	                'price' => $BuyMainCard->getPrice(),
    77	                'cardConditionId' => $BuyMainCard->getCardCondition()?->getId(),
    78	                'saleFlg' => $BuyMainCard->getSaleFlg(),
    79	                'purchaseCategory' => $BuyMainCard->getPurchaseCategory(),
    80	                'applicationPrice' => $pricesByCondition,
    81	            ];
    82	        }, $BuyMainCards);
    83	
    84	        return new JsonResponse($response);
    85	    }
    86	}
