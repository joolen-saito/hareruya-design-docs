    21	use Eccube\Exception\App\InvalidStatusTransitionException;
    22	use Eccube\Service\App\MTGBuyer\V1\Admin\BuyOrder\ActionInput\UpdateStatusInput;
    23	use Eccube\Service\EntityManager\BuyOrderStatusHistoryEntityManager;
    24	use Psr\Log\LoggerInterface;
    25	
    26	class UpdateStatusAction
    27	{
    28	    private const FROM_STATUS_TO_ALLOWED_STATUSES = [
    29	        // 商品到着 -> 査定中, 査定中断, 査定再開
    30	        MtbBuyOrderStatus::PRODUCT_ARRIVAL => [
    31	            MtbBuyOrderStatus::ASSESSING,
    32	            MtbBuyOrderStatus::PENDING,
    33	            MtbBuyOrderStatus::RESUMPTION,
    34	        ],
    35	        // 査定中 -> 査定中断, 査定再開
    36	        MtbBuyOrderStatus::ASSESSING => [
    37	            MtbBuyOrderStatus::PENDING,
    38	            MtbBuyOrderStatus::RESUMPTION,
    39	        ],
    40	        // 査定中断 -> 査定中, 査定再開
    41	        MtbBuyOrderStatus::PENDING => [
    42	            MtbBuyOrderStatus::ASSESSING,
    43	            MtbBuyOrderStatus::RESUMPTION,
    44	        ],
    45	        // 査定再開 -> 査定中, 査定中断
    46	        MtbBuyOrderStatus::RESUMPTION => [
    47	            MtbBuyOrderStatus::ASSESSING,
    48	            MtbBuyOrderStatus::PENDING,
    49	        ],
    50	    ];
    51	
    52	    public function __construct(
    53	        private readonly EntityManagerInterface $entityManager,
    54	        private readonly LoggerInterface $logger,
    55	        private readonly BuyOrderStatusHistoryEntityManager $buyOrderStatusHistoryEntityManager,
    56	    ) {
    57	    }
    58	
    59	    /**
    60	     * ステータスを更新する
    61	     * 更新前ステータス [2: 商品到着, 10: 査定中, 11: 査定中断, 12: 査定再開]
    62	     * 更新後ステータス [10: 査定中, 11: 査定中断, 12: 査定再開]
    63	     * ただし、査定中 -> 査定再開のステータス更新ができるのは BuyOrderの更新者(Member)のみ
    64	     */
    65	    public function handle(UpdateStatusInput $input): void
    66	    {
    67	        $CurrentStatus = $input->BuyOrder->getBuyOrderStatus();
    68	        $currentStatusId = $CurrentStatus->getId();
    69	        $nextStatusId = $input->NewBuyOrderStatus->getId();
    70	
    71	        if ($currentStatusId === $nextStatusId) {
    72	            return;
    73	        }
    74	
    75	        // 遷移ルールに定義されていないステータスからは変更不可
    76	        // 旧システムとの互換性目的：メッセージを分けているのはクライアント側がAPIのメッセージをそのまま表示するため
    77	        if (!isset(self::FROM_STATUS_TO_ALLOWED_STATUSES[$currentStatusId])) {
    78	            $message = $input->NewBuyOrderStatus->isAssessmentActive()
    79	                ? 'この査定はすでに終了しているため開くことができません。'
    80	                : 'この査定はすでに終了しているためステータスの更新に失敗しました。';
    81	
    82	            throw new InvalidStatusTransitionException($message);
    83	        }
    84	
    85	        // 遷移ルールに定義されていないステータス先へ変更不可
    86	        if (!in_array($nextStatusId, self::FROM_STATUS_TO_ALLOWED_STATUSES[$currentStatusId], true)) {
    87	            throw new InvalidStatusTransitionException('不正なステータス遷移です');
    88	        }
    89	
    90	        // 査定者本人を除き、査定中または査定再開のものは査定アクティブ状態にできない
    91	        if (
    92	            $CurrentStatus->isAssessmentActive()
    93	            && $input->NewBuyOrderStatus->isAssessmentActive()
    94	            && $input->Member !== $input->BuyOrder->getMember()
    95	        ) {
    96	            throw new InvalidStatusTransitionException("この受注は「{$input->BuyOrder->getMember()->getName()}」が査定中です。");
    97	        }
    98	
    99	        $this->entityManager->beginTransaction();
   100	        try {
   101	            $now = new \DateTime();
   102	            $input->BuyOrder
   103	                ->setBuyOrderStatus($input->NewBuyOrderStatus)
   104	                ->setMember($input->Member)
   105	                ->setUpdateDate($now);
   106	
   107	            $this->buyOrderStatusHistoryEntityManager->save($input->BuyOrder, $input->NewBuyOrderStatus, $input->Member, $now);
   108	
   109	            $this->entityManager->flush();
   110	            $this->entityManager->commit();
   111	        } catch (\Throwable $e) {
   112	            $this->entityManager->rollback();
   113	            $this->logger->error('Failed to update buy order status', ['exception' => $e, 'buyOrderId' => $input->BuyOrder->getId(), 'currentStatusId' => $currentStatusId, 'nextStatusId' => $nextStatusId, 'memberId' => $input->Member->getId()]);
   114	            throw new InternalException('システムエラーが発生しました', $e);
   115	        }
   116	    }
   117	}
