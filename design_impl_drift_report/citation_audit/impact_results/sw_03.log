   211	    /**
   212	     * 個別入力商品Entityを構築
   213	     *
   214	     * @param array<string, DtbBuyOrderIndivisualInputProduct> $ExistingIndivisualMap
   215	     */
   216	    private function buildIndivisualInputProduct(
   217	        DtbBuyOrder $BuyOrder,
   218	        UpdateBuyOrderDetailDto $orderDetail,
   219	        array $ExistingIndivisualMap,
   220	    ): DtbBuyOrderIndivisualInputProduct {
   221	        $IndivisualProduct = $ExistingIndivisualMap[$orderDetail->name] ?? new DtbBuyOrderIndivisualInputProduct();
   222	        $IndivisualProduct
   223	            ->setName($orderDetail->name)
   224	            ->setQuantity($orderDetail->quantity)
   225	            ->setPrice($orderDetail->price)
   226	            ->setBuyOrder($BuyOrder);
   227	
   228	        return $IndivisualProduct;
   229	    }
