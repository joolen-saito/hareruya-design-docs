    21	
    22	class UpdateFreeCommentAction
    23	{
    24	    public function __construct(
    25	        private readonly EntityManagerInterface $entityManager,
    26	        private readonly LoggerInterface $logger,
    27	    ) {
    28	    }
    29	
    30	    public function handle(UpdateFreeCommentInput $input): void
    31	    {
    32	        $this->entityManager->beginTransaction();
    33	        try {
    34	            $input->BuyOrder
    35	                ->setMemo($input->freeComment)
    36	                ->setMember($input->Member)
    37	                ->setUpdateDate(new \DateTime());
    38	
    39	            $this->entityManager->flush();
    40	            $this->entityManager->commit();
    41	        } catch (\Exception $e) {
    42	            $this->entityManager->rollback();
    43	            $this->logger->error('Failed to update free comment', ['exception' => $e]);
    44	            throw new \RuntimeException('システムエラーが発生しました');
    45	        }
    46	    }
    47	}

