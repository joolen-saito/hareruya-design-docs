    74	    public function isAppApi(): bool
    75	    {
    76	        $request = $this->requestStack->getMainRequest();
    77	        if ($request === null) {
    78	            return false;
    79	        }
    80	        $pathInfo = \rawurldecode($request->getPathInfo());
    81	        $appApiPath = $this->eccubeConfig->get('eccube_api_v1_route');
    82	        $appApiPath = '/'.\trim((string) $appApiPath, '/').'/';
    83	
    84	        if (str_starts_with($pathInfo, $appApiPath)) {
    85	            return true;
    86	        }
    87	
    88	        // コントローラーの名前空間ベースの判定
    89	        $controller = $request->attributes->get('_controller');
    90	        if (is_string($controller) && str_contains($controller, '::')) {
    91	            [$className] = explode('::', $controller, 2);
    92	            if (str_starts_with($className, 'Eccube\Controller\App\\')) {
    93	                return true;
    94	            }
    95	        }
    96	
    97	        return false;
    98	    }
