    16	namespace Eccube\Service\Admin\Product;
    17	
    18	use Doctrine\DBAL\Exception\ForeignKeyConstraintViolationException;
    19	use Doctrine\ORM\EntityManagerInterface;
    20	use Eccube\Entity\MessengerJob;
    21	use Eccube\Entity\ProductClass;
    22	use Eccube\Repository\DtbPriceHistoryRepository;
    23	use Eccube\Repository\DtbProductClassImageRepository;
    24	use Eccube\Service\Smaregi\SmaregiProductClassEventService;
    25	
    26	class ProductClassDeleteAction
    27	{
    28	    public function __construct(
    29	        private readonly EntityManagerInterface $entityManager,
    30	        private readonly DtbPriceHistoryRepository $priceHistoryRepository,
    31	        private readonly DtbProductClassImageRepository $productClassImageRepository,
    32	        private readonly SmaregiProductClassEventService $smaregiProductClassEventService,
    33	    ) {
    34	    }
    35	
    36	    /**
    37	     * @throws ForeignKeyConstraintViolationException
    38	     */
    39	    public function handle(ProductClass $ProductClass): void
    40	    {
    41	        $productClassId = (int) $ProductClass->getId();
    42	        $Product = $ProductClass->getProduct();
    43	        $productId = $Product !== null ? (int) $Product->getId() : 0;
    44	        $smaregiAlignmentFlg = $ProductClass->getSmaregiAlignmentFlg();
    45	        $smaregiProductIdForDelete = $ProductClass->getSmaregiProductId();
    46	        $trimmedSmaregiProductId = ($smaregiProductIdForDelete !== null && trim($smaregiProductIdForDelete) !== '')
    47	            ? trim($smaregiProductIdForDelete)
    48	            : null;
    49	
    50	        $this->entityManager->beginTransaction();
    51	
    52	        $smaregiDeleteJob = null;
    53	        try {
    54	            if ($smaregiAlignmentFlg && $productId > 0 && $trimmedSmaregiProductId !== null) {
    55	                $smaregiDeleteJob = $this->smaregiProductClassEventService->registerDeleteJob(
    56	                    $productClassId,
    57	                    $productId,
    58	                    $trimmedSmaregiProductId,
    59	                );
    60	            }
    61	
    62	            // 商品規格に関連するレコードを削除する
    63	            $this->priceHistoryRepository->deleteByProductClass($ProductClass);
    64	            $this->productClassImageRepository->deleteByProductClass($ProductClass);
    65	
    66	            $this->entityManager->remove($ProductClass);
    67	            $this->entityManager->flush();
    68	
    69	            $this->entityManager->commit();
    70	
    71	            if ($smaregiDeleteJob instanceof MessengerJob && $trimmedSmaregiProductId !== null) {
    72	                $this->smaregiProductClassEventService->dispatchDeleteMessage(
    73	                    $smaregiDeleteJob,
    74	                    $productClassId,
    75	                    $productId,
    76	                    $trimmedSmaregiProductId,
    77	                );
    78	            }
    79	        } catch (\Exception $e) {
    80	            if ($this->entityManager->getConnection()->isTransactionActive()) {
    81	                $this->entityManager->rollback();
    82	            }
    83	
    84	            throw $e;
    85	        }
    86	    }
    87	}

