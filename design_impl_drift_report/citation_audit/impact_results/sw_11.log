    93	    public function findWithSortedClassCategories(int $productId): ?Product
    94	    {
    95	        $qb = $this->createQueryBuilder('p');
    96	        $qb->addSelect(['pc', 'cc1', 'cc2', 'pi', 'pt', 'cd', 'c'])
    97	            ->innerJoin('p.ProductClasses', 'pc')
    98	            ->leftJoin('pc.ClassCategory1', 'cc1')
    99	            ->leftJoin('pc.ClassCategory2', 'cc2')
   100	            ->leftJoin('p.ProductImage', 'pi')
   101	            ->leftJoin('p.ProductTag', 'pt')
   102	            ->leftJoin('p.CardDetail', 'cd')
   103	            ->leftJoin('cd.Card', 'c')
   104	            ->where('p.id = :id')
   105	            ->andWhere('pc.visible = :visible')
   106	            ->setParameter('id', $productId)
   107	            ->setParameter('visible', true)
   108	            ->orderBy('cc1.sort_no', 'DESC')
   109	            ->addOrderBy('cc2.sort_no', 'DESC');
   110	
   111	        return $qb
   112	            ->getQuery()
   113	            ->getOneOrNullResult();
   114	    }
