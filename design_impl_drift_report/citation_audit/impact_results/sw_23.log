   127	    #[Route(path: '/%eccube_admin_route%/analysis/format-sales/export', name: 'admin_analysis_format_sales_export', methods: ['GET'])]
   128	    public function export(Request $request): StreamedResponse|RedirectResponse
   129	    {
   130	        $viewData = $this->session->get(self::SESSION_KEY);
   131	
   132	        if (!is_array($viewData)) {
   133	            $this->addError('検索条件がありません。先に検索を実行してください。', 'admin');
   134	
   135	            return $this->redirectToRoute('admin_analysis_format_sales');
   136	        }
   137	
   138	        $form = $this->createForm(FormatSalesType::class);
   139	        $form->submit($viewData);
   140	        $inputDate = new \DateTime((string) $form->get('month')->getData().'-01');
   141	        $baseInfoFilter = $this->resolveBaseInfoFilter(
   142	            (bool) $form->get('mail_order_enabled')->getData(),
   143	            (bool) $form->get('store_enabled')->getData(),
   144	        );
   145	
   146	        $result = $this->buildFormatSalesSummary($inputDate, $baseInfoFilter);
   147	
   148	        $event = new EventArgs(
   149	            [
   150	                'form' => $form,
   151	                'searchData' => $form->getData(),
   152	            ],
   153	            $request
   154	        );
   155	        $this->eventDispatcher->dispatch($event, EccubeEvents::ADMIN_ANALYSIS_FORMAT_SALES_CSV_EXPORT);
   156	
   157	        $response = new StreamedResponse(function () use ($result): void {
   158	            $handle = fopen('php://output', 'w');
   159	            if ($handle === false) {
   160	                throw new \RuntimeException('Failed to open output stream');
   161	            }
   162	            fwrite($handle, "\xEF\xBB\xBF");
   163	            fputcsv($handle, array_merge(['日'], $result['formats'], ['合計']));
   164	
   165	            foreach ($result['formatSales'] as $day => $sales) {
   166	                $row = [$day];
   167	                foreach ($sales as $sale) {
   168	                    $row[] = $sale;
   169	                }
   170	                $row[] = $result['daySum'][$day];
   171	                fputcsv($handle, $row);
   172	            }
   173	
   174	            fclose($handle);
   175	        });
   176	
   177	        $filename = 'format_sales_'.(new \DateTime())->format('YmdHis').'.csv';
   178	        $response->headers->set('Content-Type', 'application/octet-stream');
   179	        $response->headers->set('Content-Disposition', 'attachment; filename="'.$filename.'"');
   180	
   181	        return $response;
   182	    }
