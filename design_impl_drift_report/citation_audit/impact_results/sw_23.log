    36	    }
    37	
    38	    /**
    39	     * @param array<string, mixed> $searchData
    40	     */
    41	    public function exportBySearchData(array $searchData): StreamedResponse
    42	    {
    43	        $rows = $this->productRequestRepository->getAnalysisSummary($searchData);
    44	
    45	        $response = new StreamedResponse();
    46	        $response->setCallback(function () use ($rows): void {
    47	            $this->csvExportService->fopen();
    48	            $this->csvExportService->fputcsv(array_values(self::CSV_HEADER));
    49	
    50	            foreach ($rows as $row) {
    51	                $orderedRow = array_map(
    52	                    fn (string $key): string => (string) ($row[$key] ?? ''),
    53	                    array_keys(self::CSV_HEADER),
    54	                );
    55	                $this->csvExportService->fputcsv($orderedRow);
    56	            }
    57	
    58	            $this->csvExportService->fclose();
    59	        });
    60	
    61	        $now = new \DateTime();
    62	        $filename = 'request_report_'.$now->format('YmdHis').'.csv';
    63	        $response->headers->set('Content-Type', 'application/octet-stream');
    64	        $response->headers->set('Content-Disposition', 'attachment; filename='.$filename);
    65	
    66	        return $response;
    67	    }
    68	}

