    16	namespace Eccube\Service\Front\Mypage;
    17	
    18	use Doctrine\ORM\EntityManagerInterface;
    19	use Eccube\Entity\DtbDeck;
    20	use Eccube\Entity\DtbPlayer;
    21	use Eccube\Entity\Master\MtbDeckType;
    22	use Eccube\Entity\Master\MtbDisp;
    23	use Eccube\Repository\DtbDeckRepository;
    24	use Eccube\Service\Front\Mypage\ActionInput\DeckEntryInput;
    25	
    26	class DeckEntryAction
    27	{
    28	    public function __construct(
    29	        private readonly EntityManagerInterface $entityManager,
    30	        private readonly DtbDeckRepository $deckRepository,
    31	    ) {
    32	    }
    33	
    34	    /**
    35	     * @throws \Exception
    36	     */
    37	    public function handle(DeckEntryInput $input): DtbDeck
    38	    {
    39	        $now = new \DateTime();
    40	
    41	        $Deck = $this->deckRepository->findOneBy([
    42	            'Player' => $input->Player,
    43	            'EventDetail' => $input->EventDetail,
    44	            'Format' => $input->Format,
    45	        ]);
    46	
    47	        if ($Deck !== null) {
    48	            $Deck
    49	                ->setTextMain($input->textMain)
    50	                ->setTextSide($input->textSide)
    51	                ->setUpdateDate($now);
    52	        } else {
    53	            /** @var MtbDisp $Disp */
    54	            $Disp = $this->entityManager->find(MtbDisp::class, MtbDisp::DISPLAY_HIDE);
    55	            /** @var MtbDeckType $DeckType */
    56	            $DeckType = $this->entityManager->find(MtbDeckType::class, MtbDeckType::EVENT_ID);
    57	
    58	            $Deck = (new DtbDeck())
    59	                ->setPlayer($input->Player)
    60	                ->setPlayerName($this->resolvePlayerName($input->Player))
    61	                ->setEventDetail($input->EventDetail)
    62	                ->setEventNameJp($input->EventDetail->getEventNameJp())
    63	                ->setEventNameEn($input->EventDetail->getEventNameEn())
    64	                ->setEventDate($input->EventDetail->getStartDate())
    65	                ->setFormat($input->Format)
    66	                ->setTextMain($input->textMain)
    67	                ->setTextSide($input->textSide)
    68	                ->setPrivateFlg(true)
    69	                ->setLatestFlg(false)
    70	                ->setRegulationViolationFlg(false)
    71	                ->setDisp($Disp)
    72	                ->setDeckType($DeckType)
    73	                ->setCreateDate($now)
    74	                ->setUpdateDate($now);
    75	        }
    76	
    77	        $Deck->setMember(null);
    78	
    79	        $this->entityManager->persist($Deck);
    80	        $this->entityManager->flush();
    81	
    82	        return $Deck;
    83	    }
    84	
    85	    private function resolvePlayerName(DtbPlayer $Player): string
    86	    {
    87	        $lastNameEn = $Player->getLastNameEn();
    88	        $firstNameEn = $Player->getFirstNameEn();
    89	        $lastNameJp = $Player->getLastNameJp();
    90	        $firstNameJp = $Player->getFirstNameJp();
    91	
    92	        if ($lastNameEn !== null && $lastNameEn !== '' && $firstNameEn !== null && $firstNameEn !== '') {
    93	            return $lastNameEn.' '.$firstNameEn;
    94	        }
    95	
    96	        if ($lastNameJp !== null && $lastNameJp !== '' && $firstNameJp !== null && $firstNameJp !== '') {
    97	            return $lastNameJp.' '.$firstNameJp;
    98	        }
    99	
   100	        foreach ([$lastNameEn, $firstNameEn, $lastNameJp, $firstNameJp] as $name) {
   101	            if ($name !== null && $name !== '') {
   102	                return $name;
   103	            }
   104	        }
   105	
   106	        return '';
   107	    }
   108	}
