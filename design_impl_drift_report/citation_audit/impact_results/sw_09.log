   105	    #[Template(template: 'Mypage/purchase_history_detail.twig')]
   106	    public function detailNet(int $buyOrderId): array
   107	    {
   108	        $customer = $this->getSessionCustomer();
   109	        $buyOrder = $this->dtbBuyOrderRepository->find($buyOrderId);
   110	        if (!$buyOrder instanceof DtbBuyOrder || $buyOrder->getCustomer()->getId() !== $customer->getId()) {
   111	            throw new NotFoundHttpException();
   112	        }
   113	
   114	        $netDetail = $this->purchaseHistoryNetDetailAction->handle($buyOrder);
   115	
   116	        return [
   117	            'Customer' => $customer,
   118	            'channel' => 'net',
   119	            'netDetail' => $netDetail,
   120	            'buyOrderId' => $buyOrderId,
   121	        ];
   122	    }
