    63	                ->setEventNameEn($input->EventDetail->getEventNameEn())
    64	                ->setEventDate($input->EventDetail->getStartDate())
    65	                ->setFormat($input->Format)
    66	                ->setTextMain($input->textMain)
    67	                ->setTextSide($input->textSide)
    68	                ->setPrivateFlg(true)
    69	                ->setLatestFlg(false)
