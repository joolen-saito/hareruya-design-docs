   379	                                {% set uniqueMyDeckFormats = uniqueMyDeckFormats|merge([MyDeck.format]) %}
   380	                            {% endif %}
   381	                        {% endfor %}
   382	                        <select class="p-hareruya-deckentry-edit__mydeck-filter-select" id="select_format" name="select_format">
   383	                            <option value="0">指定なし</option>
   384	                            {% for MyDeckFormat in uniqueMyDeckFormats %}
   385	                            <option value="{{ MyDeckFormat.id }}">{{ MyDeckFormat.nameJp }}</option>
   386	                            {% endfor %}
   387	                        </select>
   388	                    </div>
   389	                </div>
   390	                <div class="p-hareruya-deckentry-edit__mydeck-list">
   391	                    {% for MyDeck in MyDecks %}
   392	                    <button class="p-hareruya-deckentry-edit__mydeck-item" type="button"
   393	                        data-deck_id="{{ MyDeck.id }}"
   394	                        data-format="{{ MyDeck.format is not null ? MyDeck.format.id : 0 }}"
   395	                        data-main="{{ MyDeck.textMain|e('html_attr') }}"
   396	                        data-side="{{ MyDeck.textSide|e('html_attr') }}">
   397	                        <span class="p-hareruya-deckentry-edit__mydeck-item-img"{% if MyDeck.cardImage is not null %} style="background-image: url({{ image_path(MyDeck.cardImage.url) }})"{% endif %}></span>
   398	                        <span class="p-hareruya-deckentry-edit__mydeck-item-body">
   399	                            {% if MyDeck.format is not null %}
   400	                            <span class="p-hareruya-deckentry-edit__mydeck-tag p-hareruya-deckentry-edit__mydeck-tag--{{ mydeckTagClassMap[MyDeck.format.code]|default('standard') }}">{{ MyDeck.format.nameJp }}</span>
   401	                            {% endif %}
   402	                            <span class="p-hareruya-deckentry-edit__mydeck-item-name">{{ MyDeck.deckName }}</span>
   403	                            <span class="p-hareruya-deckentry-edit__mydeck-item-info">
   404	                                <span class="p-hareruya-deckentry-edit__mydeck-item-info-row">
   405	                                    <span class="p-hareruya-deckentry-edit__mydeck-item-info-label">プレイヤー</span>
   406	                                    <span class="p-hareruya-deckentry-edit__mydeck-item-info-value">{{ MyDeck.playerName }}</span>
   407	                                </span>
   408	                                <span class="p-hareruya-deckentry-edit__mydeck-item-info-row">
   409	                                    <span class="p-hareruya-deckentry-edit__mydeck-item-info-label">作成日</span>
   410	                                    <span class="p-hareruya-deckentry-edit__mydeck-item-info-value">{{ MyDeck.createDate|date('Y/n/j') }}</span>
   411	                                </span>
   412	                                <span class="p-hareruya-deckentry-edit__mydeck-item-info-row">
   413	                                    <span class="p-hareruya-deckentry-edit__mydeck-item-info-label">更新日</span>
   414	                                    <span class="p-hareruya-deckentry-edit__mydeck-item-info-value">{{ MyDeck.updateDate|date('Y/n/j') }}</span>
   415	                                </span>
   416	                            </span>
   417	                        </span>
   418	                    </button>
   419	                    {% endfor %}
   420	                </div>
   421	                {% else %}
   422	                <p class="p-hareruya-deckentry-edit__mydeck-empty">マイデッキがありません。</p>
   423	                {% endif %}
   424	            </div>
   425	        </div>
   426	    </div>
   427	</div>
   428	{% endblock %}
    50	    #[Template(template: 'Mypage/deck_entry_edit.twig')]
    51	    public function index(Request $request, int $eventDetailId): array|Response
    52	    {
    53	        /** @var Customer $Customer */
    54	        $Customer = $this->getUser();
    55	        $Player = $Customer->getPlayer();
    56	        if ($Player === null) {
    57	            throw new NotFoundHttpException();
    58	        }
    59	
    60	        $EventDetail = $this->eventDetailRepository->find($eventDetailId);
    61	        if ($EventDetail === null || !$EventDetail->canBeRegisteredDeck()) {
    62	            throw new NotFoundHttpException();
    63	        }
    64	
    65	        $Event = $EventDetail->getEvent();
    66	        $Formats = $Event->getFormats();
    67	
    68	        $deckByFormats = [];
    69	        foreach ($Formats as $Format) {
    70	            $Deck = $this->deckRepository->findOneBy([
    71	                'Player' => $Player,
    72	                'EventDetail' => $EventDetail,
    73	                'Format' => $Format,
    74	            ]);
    75	            if ($Deck !== null) {
    76	                $deckByFormats[$Format->getId()] = $Deck;
    77	            }
    78	        }
    79	
    80	        $MyDecks = $this->deckRepository->findBy(
    81	            ['Player' => $Player, 'DeckType' => $this->entityManager->find(MtbDeckType::class, MtbDeckType::USER_ID)],
    82	            ['createDate' => 'DESC']
    83	        );
    84	
    85	        return [
    86	            'EventDetail' => $EventDetail,
    87	            'Player' => $Player,
    88	            'Customer' => $Customer,
    89	            'Formats' => $Formats,
    90	            'deckByFormats' => $deckByFormats,
    91	            'MyDecks' => $MyDecks,
    92	        ];
    93	    }
    94	
    95	    /**
    96	     * @throws \Exception
    97	     */
    98	    #[Route(path: '/deckentry/{eventDetailId}/update', name: 'mypage_deckentry_update', requirements: ['eventDetailId' => '\d+'], methods: ['POST'])]
    99	    public function entry(Request $request, int $eventDetailId): RedirectResponse
   100	    {
   101	        $this->isTokenValid();
   102	
   103	        /** @var Customer $Customer */
   104	        $Customer = $this->getUser();
   105	        $Player = $Customer->getPlayer();
   106	        if ($Player === null) {
   107	            throw new NotFoundHttpException();
   108	        }
   109	
   110	        $EventDetail = $this->eventDetailRepository->find($eventDetailId);
   111	        if ($EventDetail === null || !$EventDetail->canBeRegisteredDeck()) {
   112	            throw new NotFoundHttpException();
   113	        }
   114	
   115	        $Event = $EventDetail->getEvent();
   116	        $Formats = $Event->getFormats();
   117	
   118	        $selectableFormats = $Formats->filter(fn (MtbFormat $f) => $f->isRankingFlg() || $f->isOtherMetaFlg());
   119	
   120	        $formatId = (int) $request->request->get('format', 0);
   121	        $Format = null;
   122	        if ($selectableFormats->isEmpty()) {
   123	            $Format = $Formats->isEmpty() ? null : $Formats->first();
   124	        } else {
   125	            foreach ($selectableFormats as $f) {
   126	                if ($f->getId() === $formatId) {
   127	                    $Format = $f;
   128	                    break;
   129	                }
   130	            }
   131	        }
   132	
   133	        if (!$Format instanceof MtbFormat) {
   134	            throw new NotFoundHttpException();
   135	        }
   136	
   137	        $input = new DeckEntryInput(
   138	            Player: $Player,
   139	            EventDetail: $EventDetail,
   140	            Format: $Format,
   141	            textMain: (string) $request->request->get('deckMain', ''),
   142	            textSide: (string) $request->request->get('deckSide', ''),
   143	        );
   144	
   145	        $Deck = $this->deckEntryAction->handle($input);
   146	
   147	        try {
   148	            $this->mailService->sendDeckEntryCompleteMail($Customer, $Deck);
   149	        } catch (\Throwable $e) {
   150	            log_critical('デッキ登録完了メール送信に失敗しました。deckId='.$Deck->getId().': '.$e->getMessage());
   151	        }
   152	
   153	        return $this->redirectToRoute('mypage_deckentry_check', ['deckId' => $Deck->getId()]);
   154	    }
   155	
   156	    /**
   157	     * @return array<string, mixed>|Response
   158	     */
   159	    #[Route(path: '/deckentry/{deckId}/check', name: 'mypage_deckentry_check', requirements: ['deckId' => '\d+'], methods: ['GET'])]
   160	    #[Template(template: 'Mypage/deck_entry_check.twig')]
   161	    public function check(int $deckId): array|Response
   162	    {
   163	        /** @var Customer $Customer */
   164	        $Customer = $this->getUser();
   165	        $Player = $Customer->getPlayer();
   166	        if ($Player === null) {
   167	            throw new NotFoundHttpException();
   168	        }
   169	
   170	        $Deck = $this->deckRepository->find($deckId);
   171	        if ($Deck === null || $Deck->getPlayer()?->getId() !== $Player->getId()) {
   172	            throw new NotFoundHttpException();
   173	        }
   174	
   175	        $EventDetail = $Deck->getEventDetail();
   176	        if ($EventDetail === null) {
   177	            throw new NotFoundHttpException();
   178	        }
   179	
   180	        $checkData = $this->deckValidationService->getCheckData($Deck);
   180	        $checkData = $this->deckValidationService->getCheckData($Deck);
   181	
   182	        return [
   183	            'Deck' => $Deck,
   184	            'EventDetail' => $EventDetail,
   185	            'Player' => $Player,
   186	            'Customer' => $Customer,
   187	            'mainErrors' => $checkData['mainErrors'],
   188	            'sideErrors' => $checkData['sideErrors'],
   189	            'mainCount' => $checkData['mainCount'],
   190	            'sideCount' => $checkData['sideCount'],
   191	            'mainCards' => $checkData['mainCards'],
   192	            'sideCards' => $checkData['sideCards'],
   193	        ];
   194	    }
   195	}
