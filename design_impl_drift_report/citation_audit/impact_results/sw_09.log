   131	        methods: ['POST'],
   132	    )]
   133	    public function confirmNet(int $buyOrderId, Request $request): RedirectResponse
   134	    {
   135	        $this->isTokenValid();
   136	
   137	        $customer = $this->getSessionCustomer();
   138	        $buyOrder = $this->dtbBuyOrderRepository->find($buyOrderId);
   139	        if (!$buyOrder instanceof DtbBuyOrder || $buyOrder->getCustomer()->getId() !== $customer->getId()) {
   140	            throw new NotFoundHttpException();
   141	        }
   142	        if ($buyOrder->getBuyOrderStatus()->getId() !== MtbBuyOrderStatus::COMMUNICATED) {
   143	            throw new ConflictHttpException();
   144	        }
   145	
   146	        try {
   147	            $this->purchaseHistoryNetConsentConfirmAction->handle(
   148	                new PurchaseHistoryNetConsentConfirmInput($buyOrder, $request->request->all()),
   149	            );
   150	            $this->addSuccess('front.mypage.purchase_history.detail.confirm.success');
   151	        } catch (BadRequestHttpException) {
   152	            $this->addRequestError('front.mypage.purchase_history.detail.confirm.error');
   153	        }
   154	
   155	        return $this->redirectToRoute('mypage_purchase_history_detail_net', ['buyOrderId' => $buyOrderId]);
   156	    }
