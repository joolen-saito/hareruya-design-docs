    87	    #[Route(path: '/topBanners/{languageCode}', name: 'top_banners_by_language_code', methods: ['GET'])]
    88	    public function getTopBannersByLanguageCode(Request $request, string $languageCode): JsonResponse
    89	    {
    90	        try {
    91	            $Language = $this->languageRepository->findOneBy([
    92	                'code' => $languageCode,
    93	            ]);
    94	
    95	            if (empty($Language)) {
    96	                log_warning('言語情報が見つかりません', [
    97	                    'request_url' => $request->getUri(),
    98	                ]);
    99	                throw new NotFoundException('Not Found');
   100	            }
