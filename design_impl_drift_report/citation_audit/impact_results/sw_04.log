   137	    /**
   138	     * PointGranter からの受信リクエストを解析用にログ出力する.
   139	     *
   140	     * 旧スマレジAPI（transaction_upd 等）のパラメータ仕様が資料で確定できないため、
   141	     * 開発環境で実リクエストを収集して proc_name / params の実値（pointAttr 等の
   142	     * スマレジ標準外項目を含む）を解析することを目的とする。
   143	     * アクセストークンは秘匿情報のため値を出力せず、契約IDはマスクする。
   144	     *
   145	     * @param Request $request
   146	     * @param string $procName
   147	     * @param string $params
   148	     *
   149	     * @return void
   150	     */
   151	    private function captureRequestForAnalysis(Request $request, string $procName, string $params): void
   152	    {
   153	        if ($this->pointGranterRequestCapture === false) {
   154	            return;
   155	        }
   156	
   157	        try {
   158	            // 生の params は customerId 等のPIIを含むため、フィールド名は残しつつ
   159	            // 既知のPII列（CAPTURE_MASK_KEYS）の値のみマスクした構造を出力する。
   160	            log_info('[PointGranter capture] 受信リクエスト', [
   161	                'procName' => $procName,
   162	                'sourceIp' => $request->getClientIp(),
   163	                'headerKeys' => array_keys($request->headers->all()),
   164	                'contractId' => $this->maskSecret((string) $request->headers->get('X-Contract-Id', '')),
   165	                'hasAccessToken' => (string) $request->headers->get('X-Access-Token', '') !== '',
   166	                'paramsSanitized' => $this->sanitizeParamsForCapture(json_decode($params, true)),
   167	            ]);
   168	        } catch (\Throwable $e) {
   169	            // 解析用ログの失敗で本処理を止めない。
   170	            log_warning('[PointGranter capture] 受信リクエストのログ出力に失敗しました', [
   171	                'error' => $e->getMessage(),
   172	            ]);
   173	        }
   174	    }
   175	
   176	    /**
   177	     * 解析用キャプチャ向けに params を再帰的にサニタイズする.
   178	     *
   179	     * 構造把握のためキー（フィールド名）はすべて残し、CAPTURE_MASK_KEYS に一致する
   180	     * キーの値のみをマスクする。pointAttr 等の解析対象はそのまま出力する。
   181	     *
   182	     * @param mixed $value
   183	     *
   184	     * @return mixed
   185	     */
   186	    private function sanitizeParamsForCapture(mixed $value): mixed
   187	    {
   188	        if (!is_array($value)) {
   189	            return $value;
   190	        }
   191	
   192	        $sanitized = [];
   193	        foreach ($value as $key => $child) {
   194	            if (is_string($key) && in_array($key, self::CAPTURE_MASK_KEYS, true)) {
   195	                $sanitized[$key] = is_scalar($child) ? $this->maskSecret((string) $child) : '***';
   196	
   197	                continue;
   198	            }
   199	
   200	            $sanitized[$key] = $this->sanitizeParamsForCapture($child);
   201	        }
   202	
   203	        return $sanitized;
   204	    }
