    16	namespace Eccube\Repository;
    17	
    18	use Doctrine\DBAL\ParameterType;
    19	use Doctrine\Persistence\ManagerRegistry as RegistryInterface;
    20	use Eccube\Entity\DtbArticle;
    21	
    22	/**
    23	 * @extends AbstractRepository<DtbArticle>
    24	 */
    25	class DtbArticleRepository extends AbstractRepository
    26	{
    27	    public function __construct(RegistryInterface $registry)
    28	    {
    29	        parent::__construct($registry, DtbArticle::class);
    30	    }
    31	
    32	    /**
    33	     * 関連記事を取得する.
    34	     *
    35	     * @param int $wpPostId 基準記事のWordPress投稿ID
    36	     * @param int $limit 取得件数の上限
    37	     *
    38	     * @return array<int, array{wpPostId: int, hasSameDeck: string, hasSameArchetype: string, hasSameCard: string, hasSameEventDetail: string}>
    39	     */
    40	    public function getRelatedArticles(int $wpPostId, int $limit): array
    41	    {
    42	        $conn = $this->getEntityManager()->getConnection();
    43	
    44	        $sql = '
    45	            SELECT
    46	                a2.wp_post_id AS wp_post_id,
    47	                CASE WHEN EXISTS (
    48	                    SELECT 1
    49	                    FROM dtb_article_deck ad1
    50	                    INNER JOIN dtb_article_deck ad2 ON ad1.deck_id = ad2.deck_id
    51	                    WHERE ad1.article_id = a1.id
    52	                      AND ad2.article_id = a2.id
    53	                ) THEN 1 ELSE 0 END AS has_same_deck,
    54	                CASE WHEN EXISTS (
    55	                    SELECT 1
    56	                    FROM dtb_article_archetype aa1
    57	                    INNER JOIN dtb_article_archetype aa2 ON aa1.archetype_id = aa2.archetype_id
    58	                    WHERE aa1.article_id = a1.id
    59	                      AND aa2.article_id = a2.id
    60	                ) THEN 1 ELSE 0 END AS has_same_archetype,
    61	                CASE WHEN EXISTS (
    62	                    SELECT 1
    63	                    FROM dtb_article_card ac1
    64	                    INNER JOIN dtb_article_card ac2 ON ac1.card_id = ac2.card_id
    65	                    WHERE ac1.article_id = a1.id
    66	                      AND ac2.article_id = a2.id
    67	                ) THEN 1 ELSE 0 END AS has_same_card,
    68	                CASE WHEN EXISTS (
    69	                    SELECT 1
    70	                    FROM dtb_article_event_detail aed1
    71	                    INNER JOIN dtb_article_event_detail aed2 ON aed1.event_detail_id = aed2.event_detail_id
    72	                    WHERE aed1.article_id = a1.id
    73	                      AND aed2.article_id = a2.id
    74	                ) THEN 1 ELSE 0 END AS has_same_event_detail
    75	            FROM dtb_article a1
    76	            INNER JOIN dtb_article a2 ON a1.wp_type_id = a2.wp_type_id
    77	            WHERE a1.wp_post_id = :wpPostId
    78	              AND a2.wp_post_id <> a1.wp_post_id
    79	              AND a2.wp_post_id <> 0
    80	              AND (
    81	                  EXISTS (
    82	                      SELECT 1
    83	                      FROM dtb_article_deck ad1
    84	                      INNER JOIN dtb_article_deck ad2 ON ad1.deck_id = ad2.deck_id
    85	                      WHERE ad1.article_id = a1.id
    86	                        AND ad2.article_id = a2.id
    87	                  )
    88	                  OR EXISTS (
    89	                      SELECT 1
    90	                      FROM dtb_article_archetype aa1
    91	                      INNER JOIN dtb_article_archetype aa2 ON aa1.archetype_id = aa2.archetype_id
    92	                      WHERE aa1.article_id = a1.id
    93	                        AND aa2.article_id = a2.id
    94	                  )
    95	                  OR EXISTS (
    96	                      SELECT 1
    97	                      FROM dtb_article_card ac1
    98	                      INNER JOIN dtb_article_card ac2 ON ac1.card_id = ac2.card_id
    99	                      WHERE ac1.article_id = a1.id
   100	                        AND ac2.article_id = a2.id
   101	                  )
   102	                  OR EXISTS (
   103	                      SELECT 1
   104	                      FROM dtb_article_event_detail aed1
   105	                      INNER JOIN dtb_article_event_detail aed2 ON aed1.event_detail_id = aed2.event_detail_id
   106	                      WHERE aed1.article_id = a1.id
   107	                        AND aed2.article_id = a2.id
   108	                  )
   109	              )
   110	            ORDER BY
   111	                has_same_deck DESC,
   112	                has_same_archetype DESC,
   113	                has_same_card DESC,
   114	                has_same_event_detail DESC,
   115	                a2.wp_post_id ASC
   116	            LIMIT :limit
   117	        ';
   118	
   119	        $stmt = $conn->prepare($sql);
   120	        $result = $stmt->executeQuery([
   121	            'wpPostId' => $wpPostId,
   122	            'limit' => $limit,
   123	        ], [
   124	            'wpPostId' => ParameterType::INTEGER,
   125	            'limit' => ParameterType::INTEGER,
   126	        ]);
   127	
   128	        $rows = [];
   129	        while ($row = $result->fetchAssociative()) {
   130	            $rows[] = [
   131	                'wpPostId' => (int) $row['wp_post_id'],
   132	                'hasSameDeck' => (string) $row['has_same_deck'],
   133	                'hasSameArchetype' => (string) $row['has_same_archetype'],
   134	                'hasSameCard' => (string) $row['has_same_card'],
   135	                'hasSameEventDetail' => (string) $row['has_same_event_detail'],
   136	            ];
   137	        }
   138	
   139	        return $rows;
   140	    }
   141	}
