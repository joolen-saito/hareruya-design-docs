   206	    /**
   207	     * 秘匿情報を先頭・末尾2文字を残してマスクする.
   208	     *
   209	     * @param string $value
   210	     *
   211	     * @return string
   212	     */
   213	    private function maskSecret(string $value): string
   214	    {
   215	        $length = strlen($value);
   216	        if ($length <= 4) {
   217	            return str_repeat('*', $length);
   218	        }
   219	
   220	        return substr($value, 0, 2).str_repeat('*', $length - 4).substr($value, -2);
