    45	    #[Route('/article.json', name: 'article_by_params', methods: ['GET'])]
    46	    public function getSingleArticleByParamsAction(Request $request): JsonResponse
    47	    {
    48	        try {
    49	            $wpPostIdParam = $request->query->get('wpPostId');
    50	            if ($wpPostIdParam === null || $wpPostIdParam === '') {
    51	                throw new MissingRequiredParameterException('wpPostIdは必須です');
    52	            }
    53	
    54	            if (!is_numeric($wpPostIdParam) || (int) $wpPostIdParam != $wpPostIdParam || (int) $wpPostIdParam < 1) {
    55	                throw new InvalidParameterException('wpPostIdは正の整数である必要があります');
    56	            }
    57	
    58	            $Article = $this->dtbArticleRepository->findOneBy(['wpPostId' => (int) $wpPostIdParam]);
    59	            if ($Article === null) {
    60	                throw new NotFoundException('記事が見つかりません');
    61	            }
    62	
    63	            return $this->json($this->articleResponseBuilder->build($Article));
    64	        } catch (BaseApiException $e) {
    65	            // APIルートが/%eccube_api_v1_route%/ではなく、ExceptionListenerのエラーハンドリングが動作しないため、直接JSONを返す
    66	            return $this->json([
    67	                'code' => $e->getStatusCode(),
    68	                'errors' => $e->getErrors(),
    69	            ], $e->getStatusCode());
    70	        }
    71	    }
