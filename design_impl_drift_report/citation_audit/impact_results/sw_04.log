    45	     *
    46	     * @return JsonResponse
    47	     */
    48	    #[Route(path: '/topBanner/{topBannerId}', name: 'top_banner_by_top_banner_id', methods: ['GET'])]
    49	    public function getTopBannerByTopBannerId(Request $request, string $topBannerId): JsonResponse
    50	    {
    51	        try {
    52	            if (!preg_match('/^\d+$/', $topBannerId) || (int) $topBannerId < 1) {
    53	                log_warning('topBannerIdは正の整数である必要があります', [
    54	                    'request_url' => $request->getUri(),
    55	                ]);
    56	                throw new NotFoundException('Not Found');
    57	            }
    58	
    59	            $TopBanner = $this->topBannerRepository->find((int) $topBannerId);
    60	            if (empty($TopBanner)) {
    61	                log_warning('トップバナーが見つかりません', [
    62	                    'request_url' => $request->getUri(),
    63	                ]);
    64	                throw new NotFoundException('Not Found');
    65	            }
    66	
    67	            $response = $this->topBannerResponseBuilder->build($TopBanner);
    68	
    69	            return $this->json($response, Response::HTTP_OK);
    70	        } catch (BaseApiException $e) {
    71	            return $this->json([
    72	                'code' => $e->getStatusCode(),
    73	                'errors' => $e->getErrors(),
    74	            ], $e->getStatusCode());
    75	        }
    76	    }
