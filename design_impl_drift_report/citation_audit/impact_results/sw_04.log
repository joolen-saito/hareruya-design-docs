    29	class PointGranterController extends AbstractController
    30	{
    31	    /**
    32	     * 解析用キャプチャログで値をマスクする既知のPIIフィールド名.
    33	     *
    34	     * フィールド名（キー）は構造把握のため残し、値のみをマスクする。
    35	     * pointAttr など解析対象の項目は含めない。
    36	     *
    37	     * @var array<int, string>
    38	     */
    39	    private const CAPTURE_MASK_KEYS = [
    40	        'customerId',
    41	        'customerCode',
    42	        'customerNo',
    43	        'customerPinCode',
    44	        'memo',
    45	        'receiptMemo',
    46	    ];
    47	
    48	    public function __construct(
    49	        private readonly PointGranterAction $action,
    50	        private readonly SmaregiApiService $smaregiApiService,
    51	        private readonly bool $pointGranterRequestCapture = false,
    52	    ) {
    53	    }
    54	
    55	    /**
    56	     * PointGranterからのリクエストをSmaregi APIに中継するAPIエンドポイント
    57	     *
    58	     * @param Request $request
    59	     *
    60	     * @return JsonResponse
    61	     */
    62	    #[Route('/admin_api/point_granter', name: 'point_granter', methods: ['POST'])]
    63	    public function processPointGranter(Request $request): JsonResponse
    64	    {
    65	        $contractId = (string) $request->headers->get('X-Contract-Id', '');
    66	        $accessToken = (string) $request->headers->get('X-Access-Token', '');
    67	        $procName = (string) $request->request->get('proc_name', '');
    68	        $params = (string) $request->request->get('params', '');
    69	
    70	        // 旧スマレジAPI用の proc_name / params（pointAttr 等の独自項目を含む）の実値を
    71	        // 開発環境で解析するための受信キャプチャ。POINT_GRANTER_REQUEST_CAPTURE=true のときのみ出力する。
    72	        $this->captureRequestForAnalysis($request, $procName, $params);
    73	
    74	        try {
    75	            if ($contractId === '' || $accessToken === '' || $procName === '' || $params === '') {
    76	                log_warning('必要なヘッダーまたはパラメータが不足しています', [
    77	                    'headerKeys' => array_keys($request->headers->all()),
    78	                    'hasContractId' => $contractId !== '',
    79	                    'hasAccessToken' => $accessToken !== '',
    80	                    'procName' => $procName,
    81	                ]);
    82	
    83	                return $this->jsonResponse([], Response::HTTP_BAD_REQUEST);
    84	            }
    85	
    86	            $result = $this->smaregiApiService->postRegisterTransaction(
    87	                $contractId,
    88	                $accessToken,
    89	                (string) $procName,
    90	                (string) $params
    91	            );
    92	
    93	            if (!array_key_exists('result', $result)) {
    94	                log_warning('スマレジAPIのレスポンスにresultキーが存在しません', [
    95	                    'request' => $request->request->all(),
    96	                    'response' => $result,
    97	                ]);
    98	
    99	                return $this->jsonResponse($result, Response::HTTP_BAD_REQUEST);
   100	            }
   101	
   102	            if ($procName !== 'transaction_upd') {
   103	                return $this->jsonResponse($result, Response::HTTP_OK);
   104	            }
   105	
   106	            $row = $this->extractRow((string) $params);
   107	            if (!is_array($row) || !isset($row['customerId'])) {
   108	                return $this->jsonResponse($result, Response::HTTP_OK);
