    60	            throw new AccessDeniedHttpException();
    61	        }
    62	
    63	        // IPアドレス拒否リストを確認
    64	        $denyAdminHosts = $this->eccubeConfig['eccube_admin_deny_hosts'];
    65	        if (!empty($denyAdminHosts) && $this->isClientIpInList($denyAdminHosts, $clientIp)) {
    66	            throw new AccessDeniedHttpException();
    67	        }
    68	    }
