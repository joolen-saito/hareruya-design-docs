    19	use Eccube\Entity\Master\MtbLanguage;
    20	use Eccube\Entity\Master\MtbTopBanner;
    21	use Eccube\Repository\AbstractRepository;
    22	
    23	/**
    24	 * @extends AbstractRepository<MtbTopBanner>
    25	 */
    26	class MtbTopBannerRepository extends AbstractRepository
    27	{
    28	    public function __construct(ManagerRegistry $registry)
    29	    {
    30	        parent::__construct($registry, MtbTopBanner::class);
    31	    }
    32	
    33	    /**
    34	     * 条件に一致する画像URLが空文字でないレコードをすべて返す
    35	     *
    36	     * @param array<int, mixed> $dispTypes
    37	     */
    38	    public function findWhereUrlIsNotEmpty(string $locale, int $limit, array $dispTypes = []): mixed
    39	    {
    40	        // localeとlocaleIdの対応づけ処理
    41	        $localeId = $locale === 'en' ? MtbLanguage::EN_ID : MtbLanguage::JP_ID;
    42	
    43	        $qb = $this->createQueryBuilder('tb');
    44	        $query = $qb->join('tb.Languages', 'l')
    45	            ->where($qb->expr()->eq('l.id', ':localeId'))
    46	            ->andWhere($qb->expr()->in('tb.dispType', ':dispTypes'))
    47	            ->andWhere("tb.imageUrl <> ''")
    48	            ->setParameter('localeId', $localeId)
    49	            ->setParameter('dispTypes', $dispTypes)
    50	            ->orderBy('tb.sortNo', 'ASC')
    51	            ->addOrderBy('tb.id', 'ASC')
    52	            ->setMaxResults($limit)
    53	            ->getQuery();
    54	
    55	        return $query->execute();
    56	    }
    57	}
