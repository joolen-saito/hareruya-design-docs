    81	    #[Route('/article/related/{id}', name: 'article_related', methods: ['GET'])]
    82	    public function getRelatedArticlesAction(string $id, Request $request): JsonResponse
    83	    {
    84	        try {
    85	            if (!preg_match('/^\d+$/', $id) || (int) $id < 1) {
    86	                throw new InvalidParameterException('idは正の整数である必要があります');
    87	            }
    88	
    89	            $limitParam = $request->query->get('limit', '');
    90	            $limit = $this->eccubeConfig->get('eccube_article_related_api_default_limit');
    91	            if ($limitParam !== '') {
    92	                if (!is_numeric($limitParam) || (int) $limitParam != $limitParam || (int) $limitParam < 1) {
    93	                    throw new InvalidParameterException('limitは正の整数である必要があります');
    94	                }
    95	                $limit = (int) $limitParam;
    96	            }
