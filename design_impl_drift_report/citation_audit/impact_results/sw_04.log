   536	                    merged_sales.base_info_id,
   537	                    merged_sales.order_date,
   538	                    LEAST(merged_sales.quantity, COALESCE(predecessor.quantity, 0)) AS eccube_quantity,
   539	                    merged_sales.quantity - COALESCE(predecessor.quantity, 0) AS smaregi_quantity
   540	                FROM merged_order_sales merged_sales
   541	                LEFT JOIN predecessor_order_sales predecessor
   542	                    ON predecessor.order_id = merged_sales.order_id
   543	                   AND predecessor.product_class_id = merged_sales.product_class_id
   544	            ),
   545	            -- 統合受注の販売数とそれ以外の販売数をマージ。
   546	            sales AS (
   547	                SELECT product_class_id, base_info_id, sales_location, order_date, quantity
   548	                FROM order_item_sales
   549	                UNION ALL
   550	                SELECT
   551	                    product_class_id,
   552	                    base_info_id,
   553	                    CAST(:sales_location_eccube AS INTEGER),
   554	                    order_date,
   555	                    eccube_quantity
   556	                FROM merged_split
   557	                WHERE eccube_quantity > 0
   558	                UNION ALL
   559	                -- 差が0以下（複製元の方が多い返品ケース等）は計上しない。
   560	                SELECT
   561	                    product_class_id,
   562	                    base_info_id,
   563	                    CAST(:sales_location_smaregi AS INTEGER),
   564	                    order_date,
   565	                    smaregi_quantity
   566	                FROM merged_split
   567	                WHERE smaregi_quantity > 0
   568	            )
   569	            SELECT
   570	                product_class_id,
   571	                base_info_id,
   572	                sales_location,
   573	                SUM(CASE WHEN order_date::date = (:order_date_ts::timestamptz)::date - 1 THEN quantity ELSE 0 END) AS sales_yesterday,
   574	                SUM(CASE WHEN order_date >= :order_date_ts::timestamptz - INTERVAL '3 days' THEN quantity ELSE 0 END) AS sales_3day,
   575	                SUM(CASE WHEN order_date >= :order_date_ts::timestamptz - INTERVAL '7 days' THEN quantity ELSE 0 END) AS sales_weekly,
   576	                SUM(CASE WHEN order_date >= :order_date_ts::timestamptz - INTERVAL '28 days' THEN quantity ELSE 0 END) AS sales_month,
   577	                SUM(CASE WHEN order_date >= :order_date_ts::timestamptz - INTERVAL '90 days' THEN quantity ELSE 0 END) AS sales_90day,
   578	                SUM(CASE WHEN order_date >= :order_date_ts::timestamptz - INTERVAL '180 days' THEN quantity ELSE 0 END) AS sales_180day,
   579	                SUM(CASE WHEN order_date >= :order_date_ts::timestamptz - INTERVAL '365 days' THEN quantity ELSE 0 END) AS sales_365day
   580	            FROM sales
   581	            GROUP BY product_class_id, base_info_id, sales_location
   582	            SQL;
   583	    }
