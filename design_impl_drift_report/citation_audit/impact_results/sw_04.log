   521	                    SUM(oi.quantity::int) AS quantity
   522	                FROM dtb_order_item oi
   523	                JOIN dtb_order predecessor ON oi.order_id = predecessor.id
   524	                WHERE predecessor.next_order_id IS NOT NULL
   525	                  AND oi.order_item_type_id = :product_item_type
   526	                  AND oi.product_class_id IS NOT NULL
   527	                GROUP BY predecessor.next_order_id, oi.product_class_id
   528	            ),
   529	            -- 統合受注を複製分（ECCUBE）とついで買い分（スマレジ）に分解する。
   530	            -- 双方とも統合受注の店舗・受注日で計上するため、合計は必ず統合受注の数量に一致する。
