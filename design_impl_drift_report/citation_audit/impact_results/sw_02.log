namespace Eccube\Entity\Master;

use Doctrine\DBAL\Types\Types;
use Doctrine\ORM\Mapping as ORM;
use Eccube\Entity\AbstractEntity;
use Eccube\Repository\Master\MtbOtcBuyOrderStatusRepository;

#[ORM\Table(name: 'mtb_otc_buy_order_status')]
#[ORM\HasLifecycleCallbacks]
#[ORM\Entity(repositoryClass: MtbOtcBuyOrderStatusRepository::class)]
class MtbOtcBuyOrderStatus extends AbstractEntity implements \Stringable
{
    /**
     * 店頭買取注文ステータス
     * 1. 買取成立
     * 2. 買取キャンセル
     * 3. ダブルチェック済み (廃止)
     * 4. 入力済み (廃止)
     * 5. 査定前
     * 6. 査定中
     * 7. 払出し待ち (廃止)
     * 8. 査定中断
     * 9. 査定再開
     * 10. 経理払出し待ち
     * 11. 入庫済み
     * 12. 未登録在庫あり
     * 13. 入庫待ち
     * 14. 管理者取消
     */
    public const STATUS_COMPLETE = 1;
    public const STATUS_CANCEL = 2;
    /** @deprecated 廃止されたステータスです */
    public const STATUS_DOUBLE_CHECKED = 3;
    /** @deprecated 廃止されたステータスです */
    public const STATUS_INPUT = 4;
    public const STATUS_ASSESSMENT_PENDING = 5;
    public const STATUS_ASSESSMENT_IN_PROGRESS = 6;
    /** @deprecated 廃止されたステータスです */
    public const STATUS_BEFORE_PAY = 7;
    public const STATUS_ASSESSMENT_PAUSED = 8;
    public const STATUS_ASSESSMENT_RESUMED = 9;
    public const STATUS_ACCOUNTING_PAYMENT_PENDING = 10;
    public const STATUS_STOCKING_COMPLETE = 11;
    public const STATUS_HAS_UNREGISTERED_STOCK = 12;
    public const STATUS_STOCKING_PENDING = 13;
    public const STATUS_REVOKED_BY_ADMIN = 14;

    /**
     * 買取集計データ対象ステータス
     */
    public const SUMMARY_STATUSES = [
        self::STATUS_COMPLETE,
        self::STATUS_STOCKING_COMPLETE,
        self::STATUS_HAS_UNREGISTERED_STOCK,
        self::STATUS_STOCKING_PENDING,
    ];

    public const DEPRECATED_STATUSES = [
        self::STATUS_DOUBLE_CHECKED,
        self::STATUS_INPUT,
        self::STATUS_BEFORE_PAY,
    ];

    public const ASSESSMENT_ACTIVE_STATUSES = [
        self::STATUS_ASSESSMENT_IN_PROGRESS,
        self::STATUS_ASSESSMENT_RESUMED,
    ];

    public const ASSESSMENT_UNCOMPLETED_STATUSES = [
        self::STATUS_ASSESSMENT_PENDING,
        self::STATUS_ASSESSMENT_IN_PROGRESS,
        self::STATUS_ASSESSMENT_PAUSED,
        self::STATUS_ASSESSMENT_RESUMED,
    ];

    public const ASSESSMENT_COMPLETED_STATUSES = [
        self::STATUS_COMPLETE,
        self::STATUS_CANCEL,
        self::STATUS_ACCOUNTING_PAYMENT_PENDING,
    ];

    #[
        ORM\Column(
            name: 'id',
            type: Types::INTEGER,
            options: [
                'unsigned' => true,
                'comment' => '店頭買取注文ステータスID',
            ],
        ),
    ]
    #[ORM\Id]
    #[ORM\GeneratedValue(strategy: 'IDENTITY')]
    private int $id;

    #[
        ORM\Column(
            name: 'name',
            type: Types::STRING,
            length: 16,
            options: ['comment' => 'ステータス名'],
        ),
    ]
    private string $name;

    #[\Override]
    public function __toString(): string
    {
        return $this->name;
    }

    public function getId(): int
    {
        return $this->id;
    }

    public function setName(string $name): MtbOtcBuyOrderStatus
    {
        $this->name = $name;

        return $this;
    }

    public function getName(): string
    {
        return $this->name;
    }

    public function isAssessmentActive(): bool
    {
        return in_array($this->id, self::ASSESSMENT_ACTIVE_STATUSES, true);
    }

    public function isAssessmentCompleted(): bool
    {
        return in_array($this->id, self::ASSESSMENT_COMPLETED_STATUSES, true);
    }

    public function isCancel(): bool
    {
        return $this->id === self::STATUS_CANCEL;
    }

    public function isComplete(): bool
    {
        return $this->id === self::STATUS_COMPLETE;
    }

    public function isAccountingPaymentPending(): bool
    {
        return $this->id === self::STATUS_ACCOUNTING_PAYMENT_PENDING;
    }
}
