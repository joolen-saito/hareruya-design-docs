namespace Eccube\Entity\Views;

use Doctrine\DBAL\Types\Types;
use Doctrine\ORM\Mapping as ORM;
use Eccube\Entity\AbstractEntity;
use Eccube\Repository\Views\LoginMemberViewRepository;

#[ORM\Entity(repositoryClass: LoginMemberViewRepository::class, readOnly: true)]
#[ORM\Table(name: 'login_member_view')]
class LoginMemberView extends AbstractEntity
{
    private function __construct()
    {
    }

    /**
     * 管理者ID
     */
    #[ORM\Column(name: 'id', type: Types::INTEGER, options: ['unsigned' => true], nullable: true)]
    #[ORM\Id]
    private ?int $id = null;

    /**
     * 管理者のログインID
     */
    #[ORM\Column(name: 'login_id', type: Types::STRING, length: 255)]
    private string $login_id = '';

    /**
     * 稼働フラグ
     */
    #[ORM\Column(type: Types::INTEGER, length: 255, nullable: true)]
    private ?int $work_id = null;

    /**
     * 管理者のパスワードのソルト
     */
    #[ORM\Column(name: 'salt', type: Types::STRING, length: 255, nullable: true)]
    private ?string $salt = null;

    /**
     * 管理者のパスワード
     */
    #[ORM\Column(name: 'password', type: Types::STRING, length: 255)]
    private string $password = '';

    /**
     * 店舗ID
     */
    #[ORM\Column(name: 'base_info_id', type: Types::INTEGER, length: 255, nullable: true)]
    private ?int $base_info_id = null;

    /**
     * 権限ID
     */
    #[ORM\Column(name: 'authority_id', type: Types::INTEGER, length: 255, nullable: true)]
    private ?int $authority_id = null;

    /**
     * 管理者名
     */
    #[ORM\Column(name: 'name', type: Types::STRING, length: 255, nullable: true)]
    private ?string $name = null;

    /**
     * 管理者IDを取得する
     */
    public function getId(): ?int
    {
        return $this->id;
    }

    /**
     * 管理者のログインIDを取得する
     */
    public function getLoginId(): string
    {
        return $this->login_id;
    }

    /**
     * 稼働フラグを取得する
     */
    public function getWorkId(): ?int
    {
        return $this->work_id;
    }

    /**
     * 管理者のパスワードのソルトを取得する
     */
    public function getSalt(): ?string
    {
        return $this->salt;
    }

    /**
     * 管理者のパスワードを取得する
     */
    public function getPassword(): string
    {
        return $this->password;
    }

    /**
     * 店舗IDを取得する
     */
    public function getBaseInfoId(): ?int
    {
        return $this->base_info_id;
    }

    /**
     * 権限IDを取得する
     */
    public function getAuthorityId(): ?int
    {
        return $this->authority_id;
    }

    /**
     * 管理者名を取得する
     */
    public function getName(): ?string
    {
        return $this->name;
    }
}
