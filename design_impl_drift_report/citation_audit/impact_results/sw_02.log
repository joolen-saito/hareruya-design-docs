namespace Eccube\Service\App\MTGBuyer\V1\Admin\OtcBuyOrder;

use Eccube\Dto\App\MTGBuyer\V1\Admin\UpdateOtcBuyOrderDetailDto;
use Eccube\Exception\App\InvalidRequestParameterException;

final readonly class OtcBuyOrderDetailUpdatePlan
{
    /**
     * @param list<UpdateOtcBuyOrderDetailDto> $details
     * @param list<UpdateOtcBuyOrderDetailDto> $indivisuals
     * @param array<int,int> $productClassQuantities
     * @param array<int,int> $productClassSubtotals
     */
    public function __construct(
        public array $details,
        public array $indivisuals,
        public array $productClassQuantities,
        public array $productClassSubtotals,
        public int $totalPrice,
    ) {
    }
}

final class BuildOtcBuyOrderDetailUpdatePlan
{
    /** @param list<UpdateOtcBuyOrderDetailDto> $orderDetails */
    public function build(array $orderDetails): OtcBuyOrderDetailUpdatePlan
    {
        $details = [];
        $indivisuals = [];
        $productClassQuantities = [];
        $productClassSubtotals = [];
        $totalPrice = 0;

        foreach ($orderDetails as $detail) {
            if ($detail->price === null || $detail->quantity === null) {
                // Validationでガードしているが、念のためチェックしている
                throw new InvalidRequestParameterException('価格または数量が指定されていません');
            }

            $totalPrice += $detail->price * $detail->quantity;

            if ($detail->productClassId !== null) {
                $details[] = $detail;
                $productClassQuantities[$detail->productClassId] = ($productClassQuantities[$detail->productClassId] ?? 0) + $detail->quantity;
                // MTGBuyerは ”単価 x 数量" で計算しておりbcmath不要。
                $productClassSubtotals[$detail->productClassId] = ($productClassSubtotals[$detail->productClassId] ?? 0) + $detail->price * $detail->quantity;
            } else {
                $indivisuals[] = $detail;
            }
        }

        return new OtcBuyOrderDetailUpdatePlan($details, $indivisuals, $productClassQuantities, $productClassSubtotals, $totalPrice);
    }
}
