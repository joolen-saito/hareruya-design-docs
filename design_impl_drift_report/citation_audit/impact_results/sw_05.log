    16	namespace Eccube\MessageHandler;
    17	
    18	use Doctrine\ORM\EntityManagerInterface;
    19	use Eccube\Entity\Master\MtbOption;
    20	use Eccube\Entity\MessengerJob;
    21	use Eccube\Entity\Order;
    22	use Eccube\Message\SmaregiOtcSyncMessage;
    23	use Eccube\Repository\Master\MtbOptionRepository;
    24	use Eccube\Repository\MessengerJobRepository;
    25	use Eccube\Repository\OrderRepository;
    26	use Eccube\Service\Smaregi\Api\SmaregiAccessTokenService;
    27	use Eccube\Service\Smaregi\Api\SmaregiMessengerJobContext;
    28	use Eccube\Service\Smaregi\Otc\SmaregiOtcOrderSyncService;
    29	use Eccube\Service\Smaregi\Otc\SmaregiOtcSyncResult;
    30	use Eccube\Service\Smaregi\SmaregiMessengerJobProcessingLock;
    31	use Psr\Log\LoggerInterface;
    32	use Symfony\Component\Messenger\Attribute\AsMessageHandler;
    33	
    34	/**
    35	 * 店頭受取注文 (OTC) スマレジ連携メッセージのハンドラ。
    36	 *
    37	 * 同一ジョブの重複実行を {@see SmaregiMessengerJobProcessingLock} で抑止し、
    38	 * {@see SmaregiOtcOrderSyncService::sync()} を呼び出す。
    39	 * 失敗系は MessengerJob を STATUS_FAILED に遷移させて例外を握りつぶす方針
    40	 * (Symfony Messenger の自動リトライを使わず、運用側で FAILED ジョブを再投入する想定)。
    41	 */
    42	#[AsMessageHandler]
    43	final readonly class SmaregiOtcSyncMessageHandler
    44	{
    45	    public function __construct(
    46	        private LoggerInterface $logger,
    47	        private EntityManagerInterface $entityManager,
    48	        private SmaregiMessengerJobProcessingLock $smaregiMessengerJobProcessingLock,
    49	        private MessengerJobRepository $messengerJobRepository,
    50	        private OrderRepository $orderRepository,
    51	        private MtbOptionRepository $mtbOptionRepository,
    52	        private SmaregiAccessTokenService $accessTokenService,
    53	        private SmaregiOtcOrderSyncService $syncService,
    54	        private SmaregiMessengerJobContext $smaregiMessengerJobContext,
    55	        private string $smaregiApiIdUrl,
    56	        private string $smaregiApiUrl,
    57	        private string $smaregiApiClientId,
    58	        private string $smaregiApiClientSecret,
    59	        private string $smaregiApiContractId,
    60	    ) {
    61	    }
    62	
    63	    public function __invoke(SmaregiOtcSyncMessage $message): void
    64	    {
    65	        $Job = $this->messengerJobRepository->find($message->getJobId());
    66	        if (!$Job instanceof MessengerJob) {
    67	            $this->logger->error('MessengerJob not found for SmaregiOtcSyncMessage', [
    68	                'jobId' => $message->getJobId(),
    69	                'orderId' => $message->getOrderId(),
    70	            ]);
    71	
    72	            return;
    73	        }
    74	
    75	        $this->smaregiMessengerJobContext->setJobId((int) $Job->getId());
    76	        try {
    77	            if (!$this->smaregiMessengerJobProcessingLock->tryBeginProcessingJob($Job)) {
    78	                return;
    79	            }
    80	
    81	            try {
    82	                $Order = $this->orderRepository->find($message->getOrderId());
    83	                if (!$Order instanceof Order) {
    84	                    $this->failJob($Job, sprintf('受注が見つかりません (orderId=%d).', $message->getOrderId()));
    85	
    86	                    return;
    87	                }
    88	
    89	                $smaregiShopId = $Order->getBaseInfo()->getSmaregiShopId();
    90	                if ($smaregiShopId === null) {
    91	                    $this->failJob($Job, sprintf('BaseInfo.smaregi_shop_id が未設定のため処理不能 (orderId=%d).', $message->getOrderId()));
    92	
    93	                    return;
    94	                }
    95	
    96	                $categoryId = $this->resolveSmaregiCategoryId();
    97	                if ($categoryId === '') {
    98	                    $this->failJob($Job, '追加システム設定のスマレジ部門ID (smaregi_category_id) が未設定のため処理不能');
    99	
   100	                    return;
   101	                }
   102	
   103	                $accessToken = $this->accessTokenService->getAccessToken(
   104	                    $this->smaregiApiIdUrl,
   105	                    $this->smaregiApiContractId,
   106	                    $this->smaregiApiClientId,
   107	                    $this->smaregiApiClientSecret,
   108	                );
   109	
   110	                $result = $this->syncService->sync(
   111	                    $Order,
   112	                    $this->smaregiApiUrl,
   113	                    $this->smaregiApiContractId,
   114	                    $accessToken,
   115	                    (string) $smaregiShopId,
   116	                    $categoryId,
   117	                );
   118	
   119	                $this->finalizeJob($Job, $result, $message->getOrderId());
   120	            } catch (\Throwable $e) {
   121	                $this->failJob($Job, $e->getMessage());
   122	                $this->logger->error('Smaregi OTC sync handler failed', [
   123	                    'jobId' => $Job->getId(),
   124	                    'orderId' => $message->getOrderId(),
   125	                    'exception' => $e,
   126	                ]);
   127	            }
   128	        } finally {
   129	            $this->smaregiMessengerJobContext->clear();
   130	        }
   131	    }
   132	
   133	    private function finalizeJob(MessengerJob $Job, SmaregiOtcSyncResult $result, int $orderId): void
   134	    {
   135	        if (in_array($result, [SmaregiOtcSyncResult::PRODUCT_FAILED, SmaregiOtcSyncResult::STOCK_FAILED], true)) {
   136	            $this->failJob($Job, sprintf('Smaregi OTC sync failed: result=%s', $result->value));
   137	
   138	            return;
   139	        }
   140	
   141	        $Job->setStatus(MessengerJob::STATUS_COMPLETED);
   142	        $Job->setCompletedAt(new \DateTime());
   143	        $Job->setErrorMessage(null);
   144	        $this->entityManager->flush();
   145	
   146	        $this->logger->info('Smaregi OTC sync handler completed', [
   147	            'jobId' => $Job->getId(),
   148	            'orderId' => $orderId,
   149	            'result' => $result->value,
   150	        ]);
