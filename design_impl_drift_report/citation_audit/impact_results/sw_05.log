    89	            log_error('SFTPリスト取得に失敗しました。', ['dir' => $this->remoteDir]);
    90	
    91	            return false;
    92	        }
    93	
    94	        foreach ($list as $file) {
    95	            if (!is_string($file) || $file === '.' || $file === '..') {
    96	                continue;
    97	            }
    98	            foreach ($prefixes as $prefix) {
    99	                if (str_starts_with($file, $prefix)) {
   100	                    $path = $this->remoteDir.'/'.$file;
   101	                    if (!$sftp->delete($path)) {
   102	                        log_error('SFTP削除に失敗しました。', ['path' => $path, 'errors' => $sftp->getErrors()]);
   103	
   104	                        return false;
   105	                    } else {
   106	                        log_info('SFTP既存ファイルを削除しました。', ['path' => $path]);
   107	                    }
   108	                    break;
   109	                }
   110	            }
   111	        }
   112	
   113	        return true;
   114	    }
