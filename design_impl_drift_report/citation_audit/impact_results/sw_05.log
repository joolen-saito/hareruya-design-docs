    91	
    92	    /**
    93	     * フロントお気に入りブロック用: お気に入り登録商品のうち公開中・在庫あり・locale 一致の ProductClass を返す。
    94	     *
    95	     * pf-eccube3 の ProductFinder の locale (display_locale_list) / stock 条件を踏襲し、
    96	     * Product ごとに 1 ProductClass (pc.id 昇順で deterministic) を cfp.create_date 降順で返す。
    97	     *
    98	     * @return ProductClass[]
    99	     */
   100	    public function findTopFavoriteProductClassesByCustomer(
   101	        Customer $Customer,
   102	        string $locale,
   103	        int $limit,
   104	        ?int $stockBaseInfoId = null,
   105	    ): array {
   106	        $baseInfoId = $stockBaseInfoId ?? (int) $this->eccubeConfig->get('eccube_root_base_info_id');
   107	
   108	        /** @var ProductClass[] $candidates */
   109	        $candidates = $this->getEntityManager()->createQueryBuilder()
   110	            ->select('pc', 'p')
   111	            ->addSelect('cfp.create_date AS HIDDEN favoritedAt')
   112	            ->addSelect('cfp.id AS HIDDEN favoriteId')
   113	            ->from(ProductClass::class, 'pc')
   114	            ->innerJoin('pc.Product', 'p')
   115	            ->innerJoin(CustomerFavoriteProduct::class, 'cfp', 'WITH', 'cfp.Product = p')
   116	            ->leftJoin('p.RegionRestriction', 'rr')
   117	            ->where('cfp.Customer = :Customer')
   118	            ->andWhere('p.Status = 1')
   119	            ->andWhere('pc.visible = true')
   120	            ->andWhere('EXISTS (
   121	                SELECT 1 FROM \Eccube\Entity\ProductStock ps
   122	                WHERE ps.ProductClass = pc
   123	                  AND ps.stock > 0
   124	                  AND IDENTITY(ps.baseInfo) = :baseInfoId
   125	                  AND ps.stockLocationId = :eccubeStockLocationId
   126	            )')
   127	            ->andWhere('(rr.display_locale_list IS NULL OR rr.display_locale_list LIKE :locale)')
   128	            ->setParameter('Customer', $Customer)
   129	            ->setParameter('baseInfoId', $baseInfoId)
   130	            ->setParameter('eccubeStockLocationId', ProductStock::STOCK_LOCATION_ECCUBE)
   131	            ->setParameter('locale', '%'.$locale.'%')
   132	            ->orderBy('favoritedAt', 'DESC')
   133	            ->addOrderBy('favoriteId', 'DESC')
   134	            ->addOrderBy('pc.id', 'ASC')
   135	            ->getQuery()
   136	            ->getResult();
   137	
   138	        $selectedByProductId = [];
   139	        foreach ($candidates as $ProductClass) {
   140	            $productId = $ProductClass->getProduct()->getId();
   141	            if (isset($selectedByProductId[$productId])) {
   142	                continue;
   143	            }
   144	            $selectedByProductId[$productId] = $ProductClass;
   145	        }
   146	
   147	        return array_slice(array_values($selectedByProductId), 0, $limit);
   148	    }
   149	
   150	    /**
   151	     * お気に入りを削除します.
   152	     *
   153	     * @param CustomerFavoriteProduct $CustomerFavoriteProduct
   154	     */
   155	    #[\Override]
   156	    public function delete($CustomerFavoriteProduct): void
   157	    {
   158	        $em = $this->getEntityManager();
   159	        $em->remove($CustomerFavoriteProduct);
   160	        $em->flush();
   161	    }
