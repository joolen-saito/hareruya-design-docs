    56	        $this->filesystem->mkdir([$this->workDir]);
    57	        $this->lockFile = $this->workDir.'unisearch.lock';
    58	        $this->cdnBaseUrl = (string) $params->get('cdn_base_url');
    59	        $this->s3Endpoint = (string) $params->get('s3_endpoint');
    60	        $this->awsS3Bucket = (string) $params->get('aws_s3_bucket');
    61	        $this->workerCount = max(1, (int) $params->get('eccube_unisearch_export_workers'));
