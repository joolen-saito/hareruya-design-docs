    64	
    65	    public function exportAndUpload(bool $isManualExecution = false): int
    66	    {
    67	        $executionTime = new \DateTimeImmutable('now');
    68	        $lockHandle = $this->acquireLock();
    69	        if ($lockHandle === null) {
    70	            log_warning('Unisearch 商品フィードTSV出力処理は既に実行中のためスキップしました。');
    71	
    72	            return 0;
    73	        }
    74	        $this->deleteExistingOutputFiles();
    75	        $baseFileName = 'feed_hareruyamtgecc_'.$executionTime->format('YmdHis');
    76	        $baseDoneFileName = 'done_hareruyamtgecc_'.$executionTime->format('YmdHis');
    77	
    78	        $tsvPath = $this->workDir.$baseFileName.'.tsv';
    79	        $donePath = $this->workDir.$baseDoneFileName.'.txt';
    80	
    81	        try {
    82	            $this->deleteOldBackupFiles();
    83	
    84	            $total = $this->exportTsvBySql($tsvPath);
    85	            if ($total === 0) {
    86	                $this->filesystem->dumpFile($tsvPath, '');
    87	                log_info('出力対象が0件のため空ファイルを作成しました。', ['path' => $tsvPath]);
    88	            }
    89	
    90	            $gzipPath = $this->compressFile($tsvPath, self::COMPRESS_GZIP);
    91	
    92	            $md5 = md5_file($gzipPath);
    93	            $this->filesystem->dumpFile($donePath, $md5);
    94	            log_info('.doneファイルを生成しました。', ['path' => $donePath, 'md5' => $md5]);
    95	
    96	            log_info('バックアップファイルを作成しました。', ['path' => $gzipPath]);
    97	            $this->applyPermissions([$tsvPath, $gzipPath, $donePath]);
    98	
    99	            if (!$isManualExecution) {
   100	                if (!$this->sftpService->deleteRemoteByPrefixes(['feed_hareruyamtg_', 'done_hareruyamtg_'])) {
   101	                    throw new \RuntimeException('SFTP既存ファイルの削除に失敗しました。');
   102	                }
   103	                if (!$this->sftpService->upload($gzipPath)) {
   104	                    throw new \RuntimeException('SFTPアップロードに失敗しました。');
   105	                }
   106	                if (!$this->sftpService->upload($donePath)) {
   107	                    throw new \RuntimeException('SFTPアップロードに失敗しました。');
   108	                }
   109	                log_info('生成したファイルをSFTPにアップロードしました。');
   110	            } else {
   111	                log_info('手動実行モードのため、SFTPアップロードをスキップしました。');
   112	            }
   113	        } catch (\Throwable $e) {
   114	            log_error('ユニサーチ商品フィード連携処理でエラーが発生しました。', [
   115	                'error' => $e->getMessage(),
   116	                'trace' => $e->getTraceAsString(),
   117	            ]);
   118	            throw $e;
   119	        } finally {
   120	            $this->releaseLock($lockHandle);
   121	        }
   122	
   123	        return $total;
   124	    }
