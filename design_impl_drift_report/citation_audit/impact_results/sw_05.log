   163	    /**
   164	     * @param array<string, mixed>|null $searchData
   165	     *
   166	     * @return CustomerFavoriteProduct[]
   167	     */
   168	    public function getQueryBuilderBySearchFavorite(Customer $Customer, ?array $searchData): array
   169	    {
   170	        $qb = $this->createQueryBuilder('fp')
   171	            ->addSelect(['p', 'cd', 'pc'])
   172	            ->innerJoin('fp.Product', 'p')
   173	            ->innerJoin('p.ProductClasses', 'pc')
   174	            ->leftJoin('p.CardDetail', 'cd')
   175	            ->leftJoin('cd.Card', 'c')
   176	            ->where('fp.Customer = :Customer')
   177	            ->andWhere('p.Status = :status')
   178	            ->setParameter('Customer', $Customer)
   179	            ->setParameter('status', ProductStatus::DISPLAY_SHOW);
   180	
   181	        if (isset($searchData['sale_flg']) && $searchData['sale_flg']) {
   182	            $qb
   183	                ->andWhere('pc.sale_flg = :sale_flg')
   184	                ->setParameter('sale_flg', Constant::ENABLED);
   185	        }
   186	
   187	        $orderId = !empty($searchData['orderby']) ? $searchData['orderby']->getId() : null;
   188	
   189	        if ($orderId === ProductListOrderBy::PRICE_ROW) {
   190	            // 価格低い順
   191	            $qb
   192	                ->andWhere('pc.visible = true')
   193	                ->addSelect('MIN(pc.price02) as HIDDEN price02_min')
   194	                ->groupBy('fp.id, p.id, cd.id, c.id')
   195	                ->orderBy('price02_min', 'ASC');
   196	        } elseif ($orderId === ProductListOrderBy::PRICE_HIGHER) {
   197	            // 価格高い順
   198	            $qb
   199	                ->andWhere('pc.visible = true')
   200	                ->addSelect('MAX(pc.price02) as HIDDEN price02_max')
   201	                ->groupBy('fp.id, p.id, cd.id, c.id')
   202	                ->orderBy('price02_max', 'DESC');
   203	        } else {
   204	            // 色順
   205	            $qb->orderBy('c.ColorSequence', 'ASC');
   206	        }
   207	
   208	        $qb->addOrderBy('fp.id', 'DESC');
   209	
   210	        return $qb->getQuery()->getResult();
   211	    }
   212	
   213	    /**
   214	     * セール中のお気に入り商品を会員別に取得する。
   215	     *
   216	     * 本会員のみ対象（仮会員・退会済み会員は除外）。
   217	     * 会員ごとに商品名・言語コードをまとめた配列を返す。
   218	     *
   219	     * @return array<int, array{
   220	     *     customer_id: int,
   221	     *     name01: string,
   222	     *     name02: string,
   223	     *     email: string,
   224	     *     pref_id: int|null,
   225	     *     product_name: string,
   226	     *     product_name_en: string|null,
   227	     *     lang_code: string|null,
   228	     * }>
   229	     */
   230	    public function findSaleFavoriteProducts(): array
   231	    {
   232	        return $this->createQueryBuilder('cfp')
   233	            ->select(
   234	                'c.id AS customer_id',
   235	                'c.name01',
   236	                'c.name02',
   237	                'c.email',
   238	                'pref.id AS pref_id',
   239	                'p.name AS product_name',
   240	                'p.name_en AS product_name_en',
   241	                'l.code AS lang_code',
   242	            )
   243	            ->join('cfp.Customer', 'c')
   244	            ->join('cfp.Product', 'p')
   245	            ->join('p.ProductClasses', 'pc')
   246	            ->join('c.Pref', 'pref')
   247	            ->leftJoin('pc.Language', 'l')
   248	            ->where('pc.sale_flg = true')
   249	            ->andWhere('c.Status = :regularStatus')
   250	            ->setParameter('regularStatus', \Eccube\Entity\Master\CustomerStatus::REGULAR)
   251	            ->groupBy('c.id, p.id, l.id, pref.id')
   252	            ->orderBy('c.id', 'ASC')
   253	            ->getQuery()
   254	            ->getResult();
   255	    }
   256	}
