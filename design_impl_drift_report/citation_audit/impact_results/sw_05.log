    46	    public function __construct(
    47	        private readonly ProductClassRepository $productClassRepository,
    48	        private readonly CategoryRepository $categoryRepository,
    49	        private readonly UniSearchSftpService $sftpService,
    50	        private readonly Filesystem $filesystem,
