    22	/**
    23	 * 店頭受取注文のスマレジ連携用アクション.
    24	 */
    25	class SmaregiOtcOrderPostAction
    26	{
    27	    public function __construct(
    28	        private readonly OrderRepository $orderRepository,
    29	        private readonly SmaregiOtcSyncDispatcher $dispatcher,
    30	        private readonly EntityManagerInterface $entityManager,
    31	    ) {
    32	    }
    33	
    34	    /**
    35	     * 店頭受取注文のスマレジ連携を行う.
    36	     *
    37	     * @param \DateTime $targetDateTime 対象時刻
    38	     */
    39	    public function handle(\DateTime $targetDateTime): void
    40	    {
    41	        // 対象受注を取得
    42	        $Orders = $this->orderRepository->findTargetOrdersForSmaregiPost($targetDateTime);
    43	
    44	        if ($Orders === []) {
    45	            log_info('対象受注はありません。', ['targetDateTime' => $targetDateTime]);
    46	
    47	            return;
    48	        }
    49	
    50	        $failedOrderIds = [];
    51	        foreach ($Orders as $Order) {
    52	            // 抽出条件で店舗情報.スマレジ店舗IDと店舗コードをnot null指定で取得している
    53	            $BaseInfo = $Order->getBaseInfo();
    54	            $smaregiShopId = $BaseInfo->getSmaregiShopId();
    55	            $orderNumber = $Order->getOrderNumber();
    56	
    57	            // スマレジ商品用バーコードの採番
    58	            $smaregiCode = $this->getProductBarcode('20', '1', sprintf('%03d', $smaregiShopId), $orderNumber);
    59	            // スマレジ用商品コード(バーコード)登録
    60	            $Order->setSmaregiCode($smaregiCode);
    61	            $this->entityManager->persist($Order);
    62	
    63	            try {
    64	                $Job = $this->dispatcher->dispatch($Order);
    65	                log_info('店頭受取注文スマレジ連携ジョブを enqueue しました', [
    66	                    'orderId' => $Order->getId(),
    67	                    'jobId' => $Job->getId(),
    68	                    'smaregiCode' => $smaregiCode,
    69	                ]);
    70	            } catch (\Throwable $e) {
    71	                $failedOrderIds[] = $Order->getId();
    72	                log_error('店頭受取注文スマレジ連携ジョブの enqueue に失敗しました', [
    73	                    'orderId' => $Order->getId(),
    74	                    'error' => $e->getMessage(),
    75	                ]);
    76	            }
    77	        }
    78	
    79	        if ($failedOrderIds !== []) {
    80	            throw new \RuntimeException(sprintf('店頭受取注文スマレジ連携ジョブの enqueue に失敗した受注があります (orderIds=%s)', implode(',', $failedOrderIds)));
    81	        }
    82	    }
    83	
    84	    /**
    85	     * 注文番号からJANコードを生成する
    86	     *
    87	     * @param string $inStoreCode インストアコード
    88	     * @param string $extension 拡張コード
    89	     * @param string $shopCode スマレジ店舗ID
    90	     * @param string $orderNumber 注文番号
    91	     *
    92	     * @return string
    93	     */
    94	    public function getProductBarcode(string $inStoreCode, string $extension, string $shopCode, string $orderNumber): string
    95	    {
    96	        // CheckDigit付与前のJANコード
    97	        $janCode = $inStoreCode.$extension.$shopCode.substr($orderNumber, -6);
    98	        $oddDigit = 0;
    99	        $evenDigit = 0;
   100	
   101	        foreach (str_split($janCode) as $key => $num) {
   102	            // 奇数桁（添字は偶数）
   103	            if ($key % 2 === 0) {
   104	                $oddDigit += intval($num);
   105	            // 偶数桁
   106	            } else {
   107	                $evenDigit += intval($num);
   108	            }
   109	        }
   110	
   111	        // 10 - (奇数桁の合計＋偶数桁の合計×3)の下1桁
   112	        $checkDigit = 10 - ($oddDigit + $evenDigit * 3) % 10;
   113	
   114	        return $janCode.($checkDigit === 10 ? 0 : $checkDigit);
   115	    }
   116	}
