   225	                    :stock_up_90day,
   226	                    :stock_up_180day,
   227	                    :stock_up_365day,
   228	                    :stock_up_2week,
   229	                    :stock_up_3week,
   230	                    :update_date
   231	                )';
   232	        } else {
   233	            $query = '
   234	                UPDATE dtb_stock_up_quantity
   235	                SET stock_up_quantity_01 = 0,
   236	                    stock_up_quantity_02 = :stock_up_yesterday,
   237	                    stock_up_quantity_03 = :stock_up_3day,
   238	                    stock_up_quantity_04 = :stock_up_weekly,
   239	                    stock_up_quantity_05 = :stock_up_month,
   240	                    stock_up_quantity_06 = :stock_up_90day,
   241	                    stock_up_quantity_07 = :stock_up_180day,
   242	                    stock_up_quantity_08 = :stock_up_365day,
   243	                    stock_up_quantity_09 = :stock_up_2week,
   244	                    stock_up_quantity_10 = :stock_up_3week,
   245	                    update_date = :update_date
   246	                WHERE product_class_id = :product_class_id AND base_info_id = :base_info_id';
   247	        }
   248	        $this->getEntityManager()->getConnection()->executeUpdate($query, $stockUpQuantity);
   249	    }
