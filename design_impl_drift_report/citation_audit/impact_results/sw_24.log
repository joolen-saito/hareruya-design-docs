    33	    public function handle(RepeatScheduleStoreInput $input): void
    34	    {
    35	        $Event = $input->Event;
    36	        $Member = $input->Member;
    37	        $formData = $input->formData;
    38	
    39	        $weekArr = $formData['week'];
    40	        $repeatStartDate = Carbon::parse($formData['repeatStartDate']);
    41	        $repeatEndDate = Carbon::parse($formData['repeatEndDate']);
    42	        $startTime = Carbon::parse($formData['startTime']);
    43	        $offlineEntryFlg = $formData['offlineEntryFlg'];
    44	        $entryStartTime = $formData['entryStartTime'] ?? null;
    45	        $entryEndTime = $formData['entryEndTime'] ?? null;
    46	        $deckRegistFlg = $formData['deckRegistFlg'];
    47	        $deckRegistDeadlineDays = $formData['deckRegistDeadlineDays'] ?? 0;
