    17	{% block javascript %}
    18	<script src="{{ asset('assets/js/vendor/moment-with-locales.min.js', 'admin') }}"></script>
    19	<script nonce="{{ csp_nonce }}">
    20	    document.addEventListener('DOMContentLoaded', function () {
    21	        const searchPlayerUrl = {{ path('admin_entry_registration_search_player')|json_encode|raw }};
    22	        const eventDetailId = {{ eventEntry.EventDetail.id|json_encode|raw }};
    23	        const eventEntryId = {{ eventEntry.id|default(0)|json_encode|raw }};
    24	        const searchInput = document.getElementById({{ form.search.vars.id|json_encode|raw }});
    25	        const entryPlayerFormInput = document.getElementById({{ form.entryPlayer.vars.id|json_encode|raw }});
    26	        const modal = document.getElementById('searchPlayerModal');
    27	        const listHost = document.getElementById('searchPlayerModalList');
    28	        const runBtn = document.getElementById('searchPlayerModalButton');
    29	
    30	        function syncEntryPlayerField() {
    31	            if (!entryPlayerFormInput) {
    32	                return;
    33	            }
    34	            const pid = document.getElementById('player_id--1');
    35	            const idVal = pid && pid.value ? parseInt(pid.value, 10) : null;
    36	            entryPlayerFormInput.value = (idVal !== null && !isNaN(idVal) && idVal > 0) ? String(idVal) : '';
    37	        }
    38	
    39	        function refreshSubmitEnabled() {
    40	            const submit = document.getElementById('submit_entry');
    41	            if (!submit) {
    42	                return;
    43	            }
    44	            const idInput = document.getElementById('player_id--1');
    45	            submit.disabled = !idInput || !idInput.value;
    46	        }
    47	
    48	        function updatePayingPlayerLabel() {
    49	            const el = document.getElementById('paying_player_name');
    50	            if (!el) {
    51	                return;
    52	            }
    53	            const nameEl = document.getElementById('detail_player__name_jp--1');
    54	            const text = nameEl ? (nameEl.textContent || '').trim() : '';
    55	            el.textContent = text || '－';
    56	        }
    57	
    58	        function applyPlayerToRow(playerId, nameJp, nameEn) {
    59	            const row = '1';
    60	            const jp = document.getElementById('detail_player__name_jp--' + row);
    61	            const en = document.getElementById('detail_player__name_en--' + row);
    62	            const hid = document.getElementById('player_id--' + row);
    63	            const divSearch = document.getElementById('div_search--' + row);
    64	            const divClear = document.getElementById('div_clear--' + row);
    65	            if (hid) {
    66	                hid.value = String(playerId);
    67	            }
    68	            if (jp) {
    69	                jp.textContent = nameJp;
    70	            }
    71	            if (en) {
    72	                en.textContent = nameEn;
    73	            }
    74	            if (divSearch) {
    75	                divSearch.classList.add('d-none');
    76	            }
    77	            if (divClear) {
    78	                divClear.classList.remove('d-none');
    79	            }
    80	            syncEntryPlayerField();
    81	            refreshSubmitEnabled();
    82	            updatePayingPlayerLabel();
    83	        }
    84	
    85	        function clearPlayerRow() {
    86	            const row = '1';
    87	            const jp = document.getElementById('detail_player__name_jp--' + row);
    88	            const en = document.getElementById('detail_player__name_en--' + row);
    89	            const hid = document.getElementById('player_id--' + row);
    90	            const divSearch = document.getElementById('div_search--' + row);
    91	            const divClear = document.getElementById('div_clear--' + row);
    92	            if (hid) {
    93	                hid.value = '';
    94	            }
    95	            if (jp) {
    96	                jp.textContent = '';
    97	            }
    98	            if (en) {
    99	                en.textContent = '';
   100	            }
   101	            if (divSearch) {
   102	                divSearch.classList.remove('d-none');
   103	            }
   104	            if (divClear) {
   105	                divClear.classList.add('d-none');
   106	            }
   107	            syncEntryPlayerField();
   108	            refreshSubmitEnabled();
   109	            updatePayingPlayerLabel();
   110	        }
   111	
   112	        if (modal) {
   113	            modal.addEventListener('show.bs.modal', function () {
   114	                modal.setAttribute('data-active-row', '1');
   115	                if (listHost) {
   116	                    listHost.innerHTML = '';
   117	                }
   118	            });
   119	        }
   120	
   121	        function loadPlayerSearchResults(url) {
   122	            if (!listHost) {
   123	                return;
   124	            }
   125	            listHost.innerHTML = '<p class="text-muted text-center mb-0">' + {{ 'admin.common.search'|trans|json_encode|raw }} + '...</p>';
   126	            fetch(url, { credentials: 'same-origin', headers: { 'X-Requested-With': 'XMLHttpRequest' } })
   127	                .then(function (r) {
   128	                    if (!r.ok) {
   129	                        throw new Error('search failed');
   130	                    }
   131	                    return r.text();
   132	                })
   133	                .then(function (html) {
   134	                    listHost.innerHTML = html;
   135	                })
   136	                .catch(function () {
   137	                    listHost.innerHTML = '<p class="text-danger text-center mb-0">' + {{ 'admin.common.system_error'|trans|json_encode|raw }} + '</p>';
   138	                });
   139	        }
   140	
   141	        if (runBtn && listHost) {
   142	            runBtn.addEventListener('click', function () {
   143	                if (!modal) {
   144	                    return;
   145	                }
   146	                const q = searchInput ? searchInput.value.trim() : '';
   147	                let url = searchPlayerUrl + '?event_detail_id=' + encodeURIComponent(String(eventDetailId)) + '&q=' + encodeURIComponent(q) + '&page_no=1';
   148	                if (eventEntryId > 0) {
   149	                    url += '&event_entry_id=' + encodeURIComponent(String(eventEntryId));
   150	                }
   151	                loadPlayerSearchResults(url);
   152	            });
   153	        }
   154	
   155	        if (listHost && modal) {
   156	            listHost.addEventListener('click', function (ev) {
   157	                const pageLink = ev.target.closest('.pagination a.page-link');
   158	                if (pageLink) {
   159	                    const href = pageLink.getAttribute('href');
   160	                    if (href) {
   161	                        ev.preventDefault();
   162	                        loadPlayerSearchResults(href);
   163	                    }
   164	                    return;
   165	                }
   166	                const sel = ev.target.closest('.js-entry-player-select');
   167	                if (!sel) {
   168	                    return;
   169	                }
   170	                const pid = sel.getAttribute('data-player-id');
   171	                const nameJp = sel.getAttribute('data-name-jp') || '';
   172	                const nameEn = sel.getAttribute('data-name-en') || '';
   173	                if (!pid) {
   174	                    return;
   175	                }
   176	                applyPlayerToRow(pid, nameJp, nameEn);
   177	                const inst = typeof bootstrap !== 'undefined' ? bootstrap.Modal.getInstance(modal) : null;
   178	                if (inst) {
   179	                    inst.hide();
   180	                }
   181	            });
   182	        }
   183	
   184	        const form = document.getElementById('event_form');
   185	        if (form) {
   186	            form.addEventListener('click', function (ev) {
   187	                const btn = ev.target.closest('.player_selector');
   188	                if (!btn || btn.classList.contains('search')) {
   189	                    return;
   190	                }
   191	                clearPlayerRow();
   192	            });
   193	            form.addEventListener('change', function (ev) {
   194	                if (ev.target.classList && ev.target.classList.contains('player_confirm')) {
   195	                    syncEntryPlayerField();
   196	                }
   197	            });
   198	        }
   199	
   200	        syncEntryPlayerField();
   201	        refreshSubmitEnabled();
   202	        updatePayingPlayerLabel();
   203	    });
   204	</script>
   205	{% endblock javascript %}
