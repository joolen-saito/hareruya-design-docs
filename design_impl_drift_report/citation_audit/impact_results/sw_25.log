   140	                $paginator,
   141	                $allDatas,
   142	                $pageNo,
   143	                self::SCHEDULES_PER_PAGE
   144	            );
   145	        }
   146	
   147	        return [
   148	            'searchForm' => $searchForm->createView(),
   149	            'pagination' => $pagination,
   150	            'datas' => $datas,
   151	        ];
   152	    }
   153	
   154	    /**
   155	     * イベント申込新規（GET: フォーム表示、POST: 登録処理）
   156	     *
   157	     * @return RedirectResponse|array<string, mixed>
   158	     */
   159	    #[Route(path: '/%eccube_admin_route%/entry_registration/new/{eventDetailId}', name: 'admin_entry_new', requirements: ['eventDetailId' => '\d+'], methods: ['GET', 'POST'])]
   160	    #[Template(template: '@admin/Event/EntryRegistration/edit.twig')]
   161	    public function create(Request $request, #[MapEntity(id: 'eventDetailId')] DtbEventDetail $eventDetail): RedirectResponse|array
   162	    {
   163	        $baseInfo = $eventDetail->getEvent()->getBaseInfo();
   164	        if ($baseInfo === null || !$this->getMember()->isEditableShop($baseInfo)) {
   165	            throw $this->createNotFoundException();
   166	        }
   167	
   168	        $eventEntry = new DtbEventEntry();
   169	        $eventEntry->setId(0);
   170	        $eventEntry->setEventDetail($eventDetail);
   171	
   172	        $form = $this->formFactory->create(EventEntryDetailType::class, $eventEntry, ['registration_mode' => true]);
   173	        $form->get('eventDetailId')->setData((string) $eventDetail->getId());
   174	
   175	        $event = new EventArgs(
   176	            [
   177	                'form' => $form,
   178	            ],
   179	            $request
   180	        );
   181	        $this->eventDispatcher->dispatch($event, EccubeEvents::ADMIN_EVENT_ENTRY_REGISTRATION_CREATE_INITIALIZE);
   182	
   183	        $form->handleRequest($request);
   184	
   185	        $entryPlayer = $form->get('entryPlayer')->getData();
   186	        $submittedPlayerId = is_string($entryPlayer) && $entryPlayer !== '' ? (int) $entryPlayer : 0;
   187	
   188	        if ($form->isSubmitted() && $form->isValid()) {
   189	            /** @var DtbEventEntry $FormEventEntry */
   190	            $FormEventEntry = $form->getData();
   191	            $input = new EntryRegistrationStoreInput($FormEventEntry, $eventDetail, $this->getMember(), $submittedPlayerId);
   192	            try {
   193	                $this->entryRegistrationStoreAction->handle($input);
   194	
   195	                $event = new EventArgs(
   196	                    [
   197	                        'form' => $form,
   198	                    ],
   199	                    $request
   200	                );
   201	                $this->eventDispatcher->dispatch($event, EccubeEvents::ADMIN_EVENT_ENTRY_REGISTRATION_CREATE_COMPLETE);
   202	
   203	                $this->addSuccess('admin.common.save_complete', 'admin');
   204	
   205	                return $this->redirectToRoute('admin_event_entry_event_detail', ['event_detail_id' => $eventDetail->getId()]);
   206	            } catch (\InvalidArgumentException $e) {
   207	                $this->addError($e->getMessage(), 'admin');
   208	            } catch (\Exception $e) {
   209	                $this->addError('admin.common.save_error', 'admin');
   210	            }
   211	        }
   212	
   213	        $entryPlayer = null;
   214	        if ($submittedPlayerId > 0) {
   215	            $player = $this->playerRepository->find($submittedPlayerId);
   216	            if ($player instanceof DtbPlayer) {
   217	                $entryPlayer = (new DtbEntryPlayer())->setPlayer($player);
   218	            }
   219	        }
   220	
   221	        return [
   222	            'form' => $form->createView(),
   223	            'eventEntry' => $eventEntry,
   224	            'entryPlayer' => $entryPlayer,
   225	            'seatNames' => [],
   226	        ];
   227	    }
   228	
   229	    /**
   230	     * 申込登録画面: プレイヤー検索モーダル用 HTML 断片
   231	     */
   232	    #[Route(path: '/%eccube_admin_route%/entry_registration/search_player', name: 'admin_entry_registration_search_player', methods: ['GET'])]
   233	    public function searchPlayer(Request $request, PaginatorInterface $paginator): Response
   234	    {
   235	        if (!$request->isXmlHttpRequest()) {
   236	            $emptyQb = $this->playerRepository->createQueryBuilder('pl')->andWhere('1 = 0');
   237	            $emptyPagination = $paginator->paginate(
   238	                $emptyQb,
   239	                1,
   240	                self::ENTRY_PLAYER_SEARCH_PER_PAGE,
   241	                [
   242	                    'pageParameterName' => 'page_no',
   243	                    'wrap-queries' => true,
   244	                ]
   245	            );
   246	
   247	            return $this->render('@admin/Event/Entry/search_player_modal_list.twig', [
   248	                'players' => [],
   249	                'pagination' => $emptyPagination,
   250	                'entriedFlgs' => [],
   251	                'selectedPlayers' => [],
   252	            ]);
   253	        }
   254	
   255	        $eventDetailIdParam = $request->get('event_detail_id');
   256	        if ($eventDetailIdParam === null || $eventDetailIdParam === '' || (int) $eventDetailIdParam <= 0) {
   257	            throw $this->createNotFoundException();
   258	        }
   259	        $eventDetailId = (int) $eventDetailIdParam;
   260	        $eventDetail = $this->eventDetailRepository->find($eventDetailId);
   261	        if ($eventDetail === null) {
   262	            throw $this->createNotFoundException();
   263	        }
   264	
   265	        $keyword = (string) $request->query->get('q', '');
   266	        $pageNo = max(1, $request->query->getInt('page_no', 1));
   267	        $qb = $this->playerRepository->getQueryBuilderByEntrySearchData([
   268	            'search' => $keyword,
   269	        ]);
   270	
   271	        $event = new EventArgs(
   272	            [
   273	                'qb' => $qb,
   274	            ],
   275	            $request
   276	        );
   277	        $this->eventDispatcher->dispatch($event, EccubeEvents::ADMIN_EVENT_ENTRY_REGISTRATION_PLAYER_SEARCH);
   278	
   279	        $pagination = $paginator->paginate(
   280	            $qb,
   281	            $pageNo,
   282	            self::ENTRY_PLAYER_SEARCH_PER_PAGE,
   283	            [
   284	                'pageParameterName' => 'page_no',
   285	                'wrap-queries' => true,
   286	            ]
   287	        );
   288	
   289	        $items = $pagination->getItems();
   290	        $entriedFlgs = [];
