    28	class TransactionListener implements EventSubscriberInterface
    29	{
    30	    /**
    31	     * TransactionListener constructor.
    32	     *
    33	     * @param bool $isEnabled
    34	     */
    35	    public function __construct(protected EntityManagerInterface $em, protected $isEnabled = true)
    36	    {
    37	    }
    38	
    39	    /**
    40	     * Disable transaction listener.
    41	     */
    42	    public function disable(): void
    43	    {
    44	        $this->isEnabled = false;
    45	    }
    46	
    47	    /**
    48	     * Kernel request listener callback.
    49	     */
    50	    public function onKernelRequest(RequestEvent $event): void
    51	    {
    52	        if (!$this->isEnabled) {
    53	            log_debug('Transaction Listener is disabled.');
    54	
    55	            return;
    56	        }
    57	
    58	        if (!$event->isMainRequest()) {
    59	            return;
    60	        }
    61	
    62	        /** @var Connection $Connection */
    63	        $Connection = $this->em->getConnection();
    64	        if (!$Connection->isConnected()) {
    65	            $Connection->connect();
    66	        }
    67	        $Connection->setAutoCommit(false);
    68	        $Connection->setTransactionIsolation(TransactionIsolationLevel::READ_COMMITTED);
    69	        $this->em->beginTransaction();
    70	        log_debug('Begin Transaction.');
    71	    }
