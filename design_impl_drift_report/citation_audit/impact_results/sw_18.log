    76	    public function onKernelException(ExceptionEvent $event): void
    77	    {
    78	        if (!$this->isEnabled) {
    79	            log_debug('Transaction Listener is disabled.');
    80	
    81	            return;
    82	        }
    83	
    84	        if (!$event->isMainRequest()) {
    85	            return;
    86	        }
    87	
    88	        /** @var \PDO $nativeConnection */
    89	        $nativeConnection = $this->em->getConnection()->getNativeConnection();
    90	        if ($nativeConnection->inTransaction()) {
    91	            if ($this->em->getConnection()->isRollbackOnly()) {
    92	                $this->em->rollback();
    93	            }
    94	            log_debug('Rollback executed.');
    95	        } else {
    96	            log_debug('Transaction is not active. Rollback skipped.');
    97	        }
    98	    }
    99	
   100	    /**
   101	     *  Kernel terminate listener callback.
   102	     */
   103	    public function onKernelTerminate(TerminateEvent $event): void
   104	    {
   105	        if (!$this->isEnabled) {
   106	            log_debug('Transaction Listener is disabled.');
   107	
   108	            return;
   109	        }
   110	
   111	        /** @var \PDO $nativeConnection */
   112	        $nativeConnection = $this->em->getConnection()->getNativeConnection();
   113	
   114	        if ($nativeConnection->inTransaction()) {
   115	            if ($this->em->getConnection()->isRollbackOnly()) {
   116	                $this->em->rollback();
   117	                log_debug('Rollback executed.');
   118	            } else {
   119	                $this->em->commit();
   120	                log_debug('Commit executed.');
   121	            }
   122	        } else {
   123	            log_debug('Transaction is not active. Rollback skipped.');
   124	        }
   125	    }
   126	
   127	    /**
   128	     * Return the events to subscribe to.
   129	     *
   130	     * @return array<string, mixed>
   131	     */
   132	    #[\Override]
   133	    public static function getSubscribedEvents(): array
   134	    {
   135	        return [
   136	            KernelEvents::REQUEST => 'onKernelRequest',
   137	            KernelEvents::EXCEPTION => 'onKernelException',
   138	            KernelEvents::TERMINATE => 'onKernelTerminate',
   139	        ];
   140	    }

