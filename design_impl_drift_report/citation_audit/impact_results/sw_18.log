    24	/**
    25	 * ネット買取 棚戻しリスト（CSV・PDF）共通処理
    26	 */
    27	class BuyOrderRestockListService
    28	{
    29	    /** 棚戻しリスト出力が許可される買取ステータス */
    30	    private const ALLOWED_STATUS_IDS = [
    31	        MtbBuyOrderStatus::WAITING_FOR_STOCK,
    32	        MtbBuyOrderStatus::STOCKING_COMPLETE,
    33	    ];
    34	
    35	    public function __construct(
    36	        private readonly DtbBuyOrderRepository $buyOrderRepository,
    37	        private readonly EntityManagerInterface $entityManager,
    38	        private readonly RestockListPdfSectionBuilder $restockListPdfSectionBuilder,
    39	    ) {
    40	    }
    41	
    42	    /**
    43	     * 戻しリストPDF用のTwig変数を組み立て、対象買取を棚戻し済みに更新する
    44	     *
    45	     * @param list<int> $buyOrderIds
    46	     *
    47	     * @return array{restockListSections: list<array{
    48	     *     titleBase: string,
    49	     *     isSupply: bool,
    50	     *     items: list<array<string, mixed>>,
    51	     *     total_quantity: int
    52	     * }>}
    53	     */
    54	    public function buildPdfViewData(array $buyOrderIds): array
    55	    {
    56	        $rawRows = $this->buyOrderRepository->getBuyOrderRestockListCsvExportData($buyOrderIds);
    57	        $built = $this->restockListPdfSectionBuilder->buildSections($rawRows);
    58	        $this->markBuyOrdersAsRestocked($buyOrderIds);
    59	
    60	        return [
    61	            'restockListSections' => $built['sections'],
    62	        ];
    63	    }
    64	
    65	    /**
    66	     * @param array<int, int> $buyOrderIds
    67	     */
    68	    public function markBuyOrdersAsRestocked(array $buyOrderIds): void
    69	    {
    70	        $this->entityManager->beginTransaction();
    71	        try {
    72	            foreach ($buyOrderIds as $id) {
    73	                $BuyOrder = $this->entityManager->find(DtbBuyOrder::class, $id);
    74	                if ($BuyOrder === null) {
    75	                    continue;
    76	                }
    77	                $BuyOrder->setRestockedFlg(true);
    78	                $this->entityManager->persist($BuyOrder);
    79	            }
    80	            $this->entityManager->flush();
    81	            $this->entityManager->commit();
    82	        } catch (\Exception $e) {
    83	            $this->entityManager->rollback();
    84	            throw $e;
    85	        }
    86	    }
    87	
    88	    /**
    89	     * 棚戻しリスト出力用バリデーション
    90	     *
    91	     * @param array<int, int> $buyOrderIds
    92	     *
    93	     * @return list<string>
    94	     */
    95	    public function validateRestockListRequest(array $buyOrderIds): array
    96	    {
    97	        $uniqueIds = array_values(array_unique($buyOrderIds));
    98	        /** @var list<DtbBuyOrder> $BuyOrders */
    99	        $BuyOrders = $this->buyOrderRepository->findBy(['id' => $uniqueIds]);
   100	
   101	        if ($BuyOrders === []) {
   102	            return ['対象のデータが見つかりません。'];
   103	        }
   104	
   105	        $foundById = [];
   106	        foreach ($BuyOrders as $BuyOrder) {
   107	            $foundById[$BuyOrder->getId()] = $BuyOrder->getBuyOrderStatus()->getId();
   108	        }
   109	
   110	        $errs = [];
   111	        foreach ($uniqueIds as $orderId) {
   112	            if (!isset($foundById[$orderId])) {
   113	                $errs[] = sprintf('買取番号: %07d は存在しません。', $orderId);
   114	
   115	                continue;
   116	            }
   117	            if (!in_array($foundById[$orderId], self::ALLOWED_STATUS_IDS, true)) {
   118	                $errs[] = sprintf('買取番号: %07d 出力対象に入庫待ち、入庫済み以外のステータスが設定されています。', $orderId);
   119	            }
   120	        }
   121	
   122	        return $errs;
   123	    }
   124	}

