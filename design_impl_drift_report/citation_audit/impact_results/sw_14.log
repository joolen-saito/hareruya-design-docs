namespace Eccube\Entity;

use Doctrine\DBAL\Types\Types;
use Doctrine\ORM\Mapping as ORM;
use Eccube\Repository\DtbStockSplitJoinDetailRepository;

/**
 * 在庫分割・結合の詳細（一対の機能で共通）
 * 分割時: 分割先（subject_product_stock）に対する分割数を保持
 * 結合時: 結合元（subject_product_stock）に対する結合数を保持
 *
 * 仕様: dtb_stock_split_join_detail
 * - id (integer, PK / SERIAL), stock_split_join_id, subject_product_stock_id: NOT NULL
 * - standard_price numeric(12,2), split_join_quantity: NOT NULL
 * - cost_price, total_cost, stock: numeric(12,2) NULL 可
 * - missing_quantity, missing_member_id: NULL 可
 */
#[ORM\Table(name: 'dtb_stock_split_join_detail')]
#[ORM\Entity(repositoryClass: DtbStockSplitJoinDetailRepository::class)]
class DtbStockSplitJoinDetail extends AbstractEntity
{
    /** 在庫分割・結合詳細ID */
    #[ORM\Column(name: 'id', type: Types::INTEGER, nullable: false, options: ['comment' => '在庫分割・結合詳細ID'])]
    #[ORM\Id]
    #[ORM\GeneratedValue(strategy: 'IDENTITY')]
    private ?int $id = null;

    /** 在庫分割・結合ID */
    #[ORM\ManyToOne(targetEntity: DtbStockSplitJoin::class, inversedBy: 'Details')]
    #[ORM\JoinColumn(name: 'stock_split_join_id', referencedColumnName: 'id', nullable: false)]
    private DtbStockSplitJoin $StockSplitJoin;

    /** 対象商品在庫ID */
    #[ORM\ManyToOne(targetEntity: ProductStock::class)]
    #[ORM\JoinColumn(name: 'subject_product_stock_id', referencedColumnName: 'id', nullable: false)]
    private ProductStock $SubjectProductStock;

    /** 基準価格 */
    #[ORM\Column(name: 'standard_price', type: Types::DECIMAL, precision: 12, scale: 2, nullable: false, options: ['comment' => '基準価格'])]
    private string $standardPrice;

    /** 原価単価 */
    #[ORM\Column(name: 'cost_price', type: Types::DECIMAL, precision: 12, scale: 2, nullable: true, options: ['comment' => '原価単価'])]
    private ?string $costPrice = null;

    /** 総原価 */
    #[ORM\Column(name: 'total_cost', type: Types::DECIMAL, precision: 12, scale: 2, nullable: true, options: ['comment' => '総原価'])]
    private ?string $totalCost = null;

    /** 在庫数 */
    #[ORM\Column(name: 'stock', type: Types::DECIMAL, precision: 12, scale: 2, nullable: true, options: ['comment' => '在庫数'])]
    private ?string $stock = null;

    /** 分割・結合数 */
    #[ORM\Column(name: 'split_join_quantity', type: Types::INTEGER, nullable: false, options: ['comment' => '分割・結合数'])]
    private int $splitJoinQuantity;

    /** 欠品点数 */
    #[ORM\Column(name: 'missing_quantity', type: Types::INTEGER, nullable: true, options: ['comment' => '欠品点数'])]
    private ?int $missingQuantity = null;

    /** 欠品登録者 */
    #[ORM\ManyToOne(targetEntity: Member::class)]
    #[ORM\JoinColumn(name: 'missing_member_id', referencedColumnName: 'id', nullable: true)]
    private ?Member $MissingMember = null;

    public function getId(): ?int
    {
        return $this->id;
    }

    public function getStockSplitJoin(): DtbStockSplitJoin
    {
        return $this->StockSplitJoin;
    }

    public function setStockSplitJoin(DtbStockSplitJoin $StockSplitJoin): self
    {
        $this->StockSplitJoin = $StockSplitJoin;

        return $this;
    }

    public function getSubjectProductStock(): ProductStock
    {
        return $this->SubjectProductStock;
    }

    public function setSubjectProductStock(ProductStock $SubjectProductStock): self
    {
        $this->SubjectProductStock = $SubjectProductStock;

        return $this;
    }

    public function getStandardPrice(): string
    {
        return $this->standardPrice;
    }

