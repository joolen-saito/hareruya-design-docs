   106	    private function fetchRows(StockListSearchInput $input): \Traversable
   107	    {
   108	        $isAllStore = $input->baseInfos === [];
   109	
   110	        [$whereSql, $params, $paramTypes] = $this->buildWhere($input);
   111	
   112	        $cardNameJoin = '';
   113	        if ($input->cardName !== null && trim($input->cardName) !== '') {
   114	            $cardNameJoin = '
   115	            LEFT JOIN mtb_card_detail cd ON p.card_detail_id = cd.id
   116	            LEFT JOIN mtb_card card ON cd.card_id = card.id';
   117	        }
   118	
   119	        $cardDetailMainJoin = '';
   120	        if (
   121	            $input->cardsets !== []
   122	            || $input->foilValues !== []
   123	            || $input->rarities !== []
   124	            || $input->frameValues !== []
   125	            || $input->promotions !== []
   126	        ) {
   127	            $cardDetailMainJoin = '
   128	            LEFT JOIN mtb_card_detail cd_main ON p.card_detail_id = cd_main.id';
   129	        }
   130	
   131	        $innerSql = "
   132	            SELECT
   133	                bi.id                                        AS bi_id,
   134	                bi.shop_name                                 AS store_name,
   135	                pc.id                                        AS pc_id,
   136	                pc.product_code                                      AS product_code,
   137	                p.name                                       AS product_name,
   138	                p.id                                         AS product_id,
   139	                pc.language_id                               AS language_id,
   140	                SUM(COALESCE(ps.stock, 0))                   AS current_stock,
   141	                SUM(COALESCE(wsh.stock_01, 0))               AS stock_1w_ago,
   142	                SUM(COALESCE(wsh.stock_02, 0))               AS stock_2w_ago,
   143	                SUM(COALESCE(wsh.stock_03, 0))               AS stock_3w_ago,
   144	                SUM(COALESCE(wsh.stock_04, 0))               AS stock_1m_ago,
   145	                COALESCE(MAX(dsq.sales_quantity_04), 0)      AS weekly_sales,
   146	                COALESCE(MAX(dsuq.stock_up_quantity_04), 0)  AS weekly_inbound,
   147	                COALESCE(MAX(dsq.sales_quantity_05), 0)      AS monthly_sales,
   148	                COALESCE(MAX(dsuq.stock_up_quantity_05), 0)  AS monthly_inbound
   149	            FROM dtb_product_stock ps
   150	            INNER JOIN dtb_product_class pc  ON ps.product_class_id = pc.id
   151	            INNER JOIN dtb_product p         ON pc.product_id = p.id
   152	            INNER JOIN dtb_base_info bi       ON ps.base_info_id = bi.id
   153	            LEFT JOIN dtb_weekly_stock_history wsh
   154	                ON wsh.product_stock_id = ps.id
   155	            -- dtb_sales_quantity は販売場所(ECCUBE/スマレジ)ごとに複数行になるため、
   156	            -- 販売数を EC+スマレジ で合算したい。ただし ps(在庫区分ごとに複数行) と直接JOINすると
   157	            -- 行が掛け合わされ SUM(ps.stock) が二重計上される。先に (pc, 店舗) 単位へ集約してからJOINし、
   158	            -- 外側は MAX で ps 複製分の重複を吸収する(合算値は既に一意なので MAX で正しく取れる)。
   159	            LEFT JOIN (
   160	                SELECT
   161	                    product_class_id,
   162	                    base_info_id,
   163	                    SUM(sales_quantity_04) AS sales_quantity_04,
   164	                    SUM(sales_quantity_05) AS sales_quantity_05
   165	                FROM dtb_sales_quantity
   166	                GROUP BY product_class_id, base_info_id
   167	            ) dsq
   168	                ON dsq.product_class_id = pc.id AND dsq.base_info_id = bi.id
   169	            LEFT JOIN dtb_stock_up_quantity dsuq
   170	                ON dsuq.product_class_id = pc.id AND dsuq.base_info_id = bi.id
   171	            {$cardNameJoin}
   172	            {$cardDetailMainJoin}
   173	            {$whereSql}
   174	            GROUP BY bi.id, bi.shop_name, pc.id, pc.product_code, p.id, p.name, pc.language_id
   175	        ";
   176	
   177	        if ($isAllStore) {
   178	            $sql = "
   179	                SELECT
   180	                    '全店'                          AS store_name,
    65	    }
