   108	                '登録元ID' => $StockHistory->getHistorySourceId(),
   109	                '変更前在庫' => $StockHistory->getOldStock(),
   110	                '変更後在庫' => $StockHistory->getStock(),
   111	                '在庫増減数' => $StockHistory->getStockChangeQuantity(),
   112	                '在庫変動理由区分' => $StockHistory->getStockChangeTypeDetail()->getStockChangeType()->getName(),
   113	                '在庫変動理由' => $StockHistory->getStockChangeReason(),
   114	                '変更時販売価格' => $StockHistory->getSellPrice(),
   115	                '仕入単価' => $ProductClass->getBuyPrice(),
   116	                '変更前原価単価' => $StockHistory->getUnitCostPriceBefore(),
   117	                '変更後原価単価' => $StockHistory->getUnitCostPriceAfter(),
   118	                '総原価増減数' => ($StockHistory->getTotalCostPriceAfter() - $StockHistory->getTotalCostPriceBefore()),
   119	                '変更前総原価' => $StockHistory->getTotalCostPriceBefore(),
   120	                '変更後総原価' => $StockHistory->getTotalCostPriceAfter(),
   121	                '登録日' => !empty($StockHistory->getRegisteredAt()) ? $StockHistory->getRegisteredAt()->format('Y-m-d H:i') : '',
   122	                '登録者' => $StockHistory->getRegisteredMember(),
   123	                '承認日' => !empty($StockHistory->getApprovalAt()) ? $StockHistory->getApprovalAt()->format('Y-m-d H:i') : '',
   124	                '承認者' => $StockHistory->getApprovalMember(),
   125	                '最終更新日' => !empty($StockHistory->getUpdateDate()) ? $StockHistory->getUpdateDate()->format('Y-m-d H:i') : '',
   126	                '最終更新者' => $StockHistory->getUpdateMember(),
   127	            ];
   128	            $csvRows[] = $rowBase;
   129	        }
   130	
   131	        return $csvRows;
   132	    }
