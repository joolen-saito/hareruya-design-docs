   338	    /**
   339	     * 指定した在庫の最新履歴を取得する.
   340	     *
   341	     * 承認日時があるものは承認日時、ないものは登録日時を基準に降順で最大 $limit 件.
   342	     *
   343	     * @return list<DtbStockHistory>
   344	     */
   345	    public function findLatestByProductStockId(int $productStockId, int $limit = 30): array
   346	    {
   347	        $qb = $this->createQueryBuilder('sh')
   348	            ->addSelect('sctd', 'sct', 'hst', 'rm', 'am')
   349	            ->innerJoin('sh.StockChangeTypeDetail', 'sctd')
   350	            ->innerJoin('sctd.StockChangeType', 'sct')
   351	            ->leftJoin('sh.HistorySourceType', 'hst')
   352	            ->leftJoin('sh.RegisteredMember', 'rm')
   353	            ->leftJoin('sh.ApprovalMember', 'am')
   354	            ->andWhere('sh.ProductStock = :productStockId')
   355	            ->setParameter('productStockId', $productStockId)
   356	            ->addSelect('COALESCE(sh.approvalAt, sh.registeredAt, sh.createDate) AS HIDDEN sortDate')
   357	            ->orderBy('sortDate', 'DESC')
   358	            ->addOrderBy('sh.registeredAt', 'DESC')
   359	            ->setMaxResults($limit);
   360	
   361	        return $qb->getQuery()->getResult();
   362	    }
