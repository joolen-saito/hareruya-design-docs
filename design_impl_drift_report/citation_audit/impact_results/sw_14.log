    48	     *
    49	     * @param array<int, mixed> $stockHistoryIds
    50	     *
    51	     * @return StreamedResponse
    52	     */
    53	    public function exportCsv(array $stockHistoryIds): StreamedResponse
    54	    {
    55	        if (empty($stockHistoryIds) || !$StockHistories = $this->stockHistoryRepository->getStockHistories($stockHistoryIds)) {
    56	            throw new \RuntimeException($this->translator->trans('admin.csv.error.export.not_registered_stock_history_id'));
    57	        }
    58	
    59	        $csvRows = $this->convertExportCsvRows($StockHistories);
    60	        if ($csvRows === []) {
    61	            throw new \RuntimeException($this->translator->trans('admin.csv.error.export.no_stock_history_data'));
    62	        }
    63	        $response = new StreamedResponse();
    64	
    65	        $headerKeys = array_keys($this->csvHeader);
    66	        $response->setCallback(function () use ($csvRows, $headerKeys): void {
    67	            $this->csvExportService->fopen();
    68	            $this->csvExportService->fputcsv($headerKeys);
    69	            foreach ($csvRows as $row) {
    70	                $this->csvExportService->fputcsv(array_map(fn (string $key) => $row[$key] ?? '', $headerKeys));
    71	            }
    72	            $this->csvExportService->fclose();
    73	        });
    74	
    75	        $filename = $this->createFileName('stock_history_disposal_');
    76	        $this->setCsvResponseHeader($response, $filename);
    77	
    78	        log_info('欠品履歴CSV出力ファイル名', [$filename]);
    79	
    80	        return $response;
    81	    }
    82	
    83	    /**
    84	     * DtbStockHistoryをCSV出力できる形にコンバート
    85	     *
    86	     * @param array<int, DtbStockHistory> $StockHistories StockHistoryの配列
    87	     *
    88	     * @return array<int, array<string, mixed>>
    89	     */
    90	    public function convertExportCsvRows(array $StockHistories): array
    91	    {
    92	        $csvRows = [];
    93	
    94	        foreach ($StockHistories as $StockHistory) {
    95	            $ProductStock = $this->productStockRepository->findOneBy(['id' => $StockHistory->getProductStock()]);
    96	            $ProductClass = $this->productClassRepository->findOneBy(['id' => $ProductStock->getProductClass()]);
    97	            $Product = $this->productRepository->findOneBy(['id' => $ProductClass->getProduct()]);
    98	
    99	            $rowBase = [
   100	                '商品コード' => $ProductClass->getCode(),
   101	                '商品名' => $Product->getName(),
   102	                '言語' => $ProductClass->getLanguageNameJp(),
   103	                '状態' => $ProductClass->getCardCondition()->getCode(),
   104	                'Foil' => '',   // TODO - From Foil Master Table
   105	                '店舗' => $ProductStock->getBaseInfo(),
   106	                '在庫場所' => $ProductStock->getLocationName(),
   107	                '登録元' => $StockHistory->getHistorySourceType(),
   108	                '登録元ID' => $StockHistory->getHistorySourceId(),
   109	                '欠品点数' => $StockHistory->getStock(),
   110	                '欠品時販売価格' => $StockHistory->getSellPrice(),
   111	                '欠品理由' => $StockHistory->getStockChangeReason(),
   112	                '登録日' => !empty($StockHistory->getRegisteredAt()) ? $StockHistory->getRegisteredAt()->format('Y-m-d H:i') : '',
   113	                '登録者' => $StockHistory->getRegisteredMember(),
   114	                '最終更新日' => !empty($StockHistory->getUpdateDate()) ? $StockHistory->getUpdateDate()->format('Y-m-d H:i') : '',
   115	                '最終更新者' => $StockHistory->getUpdateMember(),
   116	            ];
   117	            $csvRows[] = $rowBase;
   118	        }
   119	
   120	        return $csvRows;
   121	    }
   122	}

