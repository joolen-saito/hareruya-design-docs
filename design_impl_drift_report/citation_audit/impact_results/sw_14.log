    85	    }
    86	
    87	    public function onValidateRow(ReadCsvRowEvent $event): void
    88	    {
    89	        $this->pendingSourcePs = null;
    90	
    91	        $row = $event->getRow();
    92	        $lineNum = $row->getRowNumber();
    93	        $messageStore = $event->getMessageStore();
    94	
    95	        if (!$row->exists(self::COLUMN_PRODUCT_CODE) || !$row->exists(self::COLUMN_SOURCE_QTY)) {
    96	            $messageStore->addRawMessage("{$lineNum}行目: 1行目の列名を確認してください（".self::COLUMN_PRODUCT_CODE.'、'.self::COLUMN_SOURCE_QTY.'）。');
    97	            $event->breakAll();
    98	
    99	            return;
   100	        }
   101	
   102	        $code = trim($row->getValue(self::COLUMN_PRODUCT_CODE));
   103	        if ($code === '') {
   104	            $messageStore->addRawMessage("{$lineNum}行目: 商品コードが空です。");
   105	            $event->breakAll();
   106	
   107	            return;
   108	        }
   109	
   110	        $qtyRaw = trim($row->getValue(self::COLUMN_SOURCE_QTY));
   111	        if ($qtyRaw === '' || !ctype_digit($qtyRaw) || (int) $qtyRaw < 1) {
   112	            $messageStore->addRawMessage("{$lineNum}行目: 結合元在庫数が不正です（1以上の整数を指定してください）。");
   113	            $event->breakAll();
   114	
   115	            return;
   116	        }
   117	
   118	        $srcPs = $this->productStockRepository->findOneByProductCodeAndBaseInfoAndStockLocation(
   119	            $code,
   120	            $this->destBaseInfo,
   121	            $this->destStockLocationId
   122	        );
   123	
   124	        if ($srcPs === null) {
   125	            $messageStore->addRawMessage("{$lineNum}行目: 商品コード「{$code}」は同一店舗・在庫区分で見つかりません。");
   126	            $event->breakAll();
   127	
   128	            return;
   129	        }
   130	
   131	        if ($srcPs->getId() === $this->destPsId) {
   132	            $messageStore->addRawMessage("{$lineNum}行目: 結合先と同一の在庫は結合元に指定できません。");
   133	            $event->breakAll();
   134	
   135	            return;
   136	        }
   137	
   138	        $this->pendingSourcePs = $srcPs;
   139	    }
