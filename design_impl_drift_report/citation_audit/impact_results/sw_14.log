    30	/**
    31	 * 結合元商品CSV（2列：商品コード・結合元在庫数）を読み込み、結合元情報をSESSIONに保存するハンドラ。
    32	 *
    33	 * DBへの書き込みは行わない。結合元の確定は承認申請時に行う。
    34	 *
    35	 * SESSION 保存は {@see handleToSession()} を使うこと。
    36	 * SESSION キー: stock_join_edit_sources_{joinId}
    37	 * SESSION 値: array<int productStockId, array{quantity: int}>
    38	 *
    39	 * ライフサイクルメソッドは後方互換のために残しているが、
    40	 * プロダクションでは handleToSession() 経由で使用すること。
    41	 */
    42	class StockJoinEditReplaceSourcesImportHandler extends BaseCsvImportHandler
    43	{
    44	    private const COLUMN_PRODUCT_CODE = '商品コード';
    45	    private const COLUMN_SOURCE_QTY = '結合元在庫数';
    46	    private const MAX_ERROR_COUNT = 20;
