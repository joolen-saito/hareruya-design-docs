   383	
   384	        set_time_limit(0);
   385	        $this->entityManager->getConfiguration()->setSQLLogger(null);
   386	
   387	        $stockHistoryDisposalCsv = new StockHistoryDisposalCsv(
   388	            $this->entityManager,
   389	            $this->translator,
   390	            $this->eccubeConfig,
   391	            $this->stockHistoryRepository,
   392	            $this->csvExportService,
   393	            $this->productRepository,
   394	            $this->productClassRepository,
   395	            $this->productStockRepository,
   396	            $this->getStockHistoryDisposalCsvHeader(),
   397	            $this->getRequiredStockHistoryCsvHeader()
   398	        );
   399	
   400	        $event = new EventArgs(
   401	            [
   402	                'stockHistoryIds' => $stockHistoryIds,
   403	            ],
   404	            $request
   405	        );
   406	        $this->eventDispatcher->dispatch($event, EccubeEvents::ADMIN_STOCK_HISTORY_STOCK_HISTORY_DISPOZAL_CSV_EXPORT);
   407	
   408	        try {
   409	            return $stockHistoryDisposalCsv->exportCsv($stockHistoryIds);
