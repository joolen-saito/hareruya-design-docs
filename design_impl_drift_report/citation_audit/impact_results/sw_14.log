   371	    #[Route(path: '/%eccube_admin_route%/product/stock/history/disposal/csv_export', name: 'admin_stock_history_disposal_csv_export', methods: ['POST'])]
   372	    public function csvStockHistoryDispozalExport(Request $request): StreamedResponse|RedirectResponse
   373	    {
   374	        $params = $request->request->all();
   375	        $ids = $params['ids'] ?? [];
   376	        $stockHistoryIds = \is_array($ids)
   377	            ? array_values(array_filter(array_map('intval', $ids), fn (int $id): bool => $id > 0))
