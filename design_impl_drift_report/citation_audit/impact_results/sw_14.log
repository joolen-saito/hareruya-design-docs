    64	    }
    65	
    66	    public function onBeforeImport(): void
    67	    {
    68	        parent::onBeforeImport();
    69	
    70	        $this->pendingSourcePs = null;
    71	        $this->sources = [];
    72	
    73	        $destPs = $this->stockSplitJoin->getProductStock();
    74	        $this->destPsId = $destPs->getId();
    75	        $this->destBaseInfo = $destPs->getBaseInfo();
    76	        $this->destStockLocationId = $destPs->getStockLocationId();
