    21	
    22	/**
    23	 * POSTされた振向数量を明細に適用し、0件の明細を削除して残存明細リストを返す。
    24	 * ヘッダーの split_join_quantity（結合先数量）はユーザー入力値を保持するため変更しない。
    25	 */
    26	final class StockJoinApplyPostedSourceStocks
    27	{
    28	    /**
    29	     * @param list<DtbStockSplitJoinDetail> $destinations
    30	     * @param array<int, int> $postedMap detailId → posted source_stock value
    31	     *
    32	     * @return list<DtbStockSplitJoinDetail>
    33	     */
    34	    public static function applyPostedAndRemoveZeroLines(
    35	        DtbStockSplitJoin $StockSplitJoin,
    36	        array $destinations,
    37	        array $postedMap,
    38	        EntityManagerInterface $entityManager,
    39	    ): array {
    40	        $finalDetails = [];
    41	        foreach ($destinations as $Detail) {
    42	            $detailId = $Detail->getId();
    43	            if ($detailId === null || !\array_key_exists($detailId, $postedMap)) {
    44	                $finalDetails[] = $Detail;
    45	                continue;
    46	            }
    47	            $posted = $postedMap[$detailId];
    48	            if ($posted <= 0) {
    49	                $entityManager->remove($Detail);
    50	                continue;
    51	            }
    52	            $Detail->setSplitJoinQuantity($posted);
    53	            $finalDetails[] = $Detail;
    54	        }
    55	
    56	        return $finalDetails;
    57	    }
    58	}

