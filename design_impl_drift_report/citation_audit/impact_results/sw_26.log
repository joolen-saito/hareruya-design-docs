   567	    private function updateCard(MtbCard $Card, array $row, string $normalizedNameEn): void
   568	    {
   569	        $nameJp = trim((string) ($row['name_jp'] ?? ''));
   570	        if ($nameJp !== '') {
   571	            // カード名(日本語)が入力されている場合に限り、アリーナカード名(日本語)、ルールテキスト(日本語)を登録/更新する
   572	            $Card
   573	                ->setNameJp(str_replace('＋', '/', $nameJp))
   574	                ->setTextJp((string) ($row['text_jp'] ?? ''))
   575	                ->setArenaFormatNameJp(str_replace('＋', '/', (string) ($row['arena_format_name_jp'] ?? '')));
   576	        }
   577	
   578	        $Card
   579	            ->setNameEn($normalizedNameEn)
   580	            ->setArenaFormatNameEn(str_replace('//', '/', (string) ($row['arena_format_name_en'] ?? '')))
   581	            ->setTextEn((string) ($row['text_en'] ?? ''))
   582	            ->setManaCost($this->convertManaCost((string) ($row['mana_cost'] ?? '')))
   583	            ->setCmc((float) $this->getCmc($row))
   584	            ->setPower((string) ($row['power'] ?? ''))
   585	            ->setToughness((string) ($row['toughness'] ?? ''))
   586	            ->setLoyalty((string) ($row['loyalty'] ?? ''));
   587	    }
