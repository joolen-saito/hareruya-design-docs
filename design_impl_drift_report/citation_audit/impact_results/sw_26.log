   589	    /**
   590	     * @param array<string, mixed> $row
   591	     *
   592	     * @return array<int, MtbCardtype>
   593	     */
   594	    private function resolveCardTypes(array $row, int $rowIndex): array
   595	    {
   596	        $types = [];
   597	        foreach ($this->splitSlashOrComma((string) ($row['cardtype'] ?? '')) as $nameEn) {
   598	            $Type = $this->cardtypeRepository->findOneBy(['name_en' => $nameEn]);
   599	            if ($Type === null) {
   600	                throw new \RuntimeException(sprintf($this->translator->trans('admin.csv.error.data.not_registered', [], 'messages'), $this->columnLabelForCsvColumn('cardtype'), $nameEn, $rowIndex));
   601	            }
   602	            $types[] = $Type;
   603	        }
   604	
   605	        return $types;
   606	    }
