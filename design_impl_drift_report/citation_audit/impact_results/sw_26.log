    43	
    44	            /**
    45	             * 必須バッジを付与する関数
    46	             * @param {jQuery} $container 走査対象の親要素
    47	             */
    48	            function applyRequiredBadges($container) {
    49	                $container.find('input[required], select[required], textarea[required]').not(':radio').each(function() {
    50	                    let id = $(this).attr('id');
    51	                    if (!id) return;
    52	                    let $label = $('label[for="' + id + '"]');
    53	
    54	                    if ($label.length > 0 && $label.find('.ec-required').length === 0) {
    55	                        $label.append('<span class="badge bg-primary ms-1">{{ 'admin.common.required'|trans }}</span>');
    56	                    }
    57	                });
    58	            }
    59	            applyRequiredBadges($('form#form1'));
    60	
    61	            // リーガリティ追加
    62	            $('#add-format').on('click', function() {
    63	                let $formatContainer = $('#card-formats-container');
    64	                let prototype = $formatContainer.data('prototype');
    65	
    66	                // 現在の要素数をインデックスとして使用
    67	                let formatIndex = $formatContainer.find('.removable-item').length;
    68	
    69	                let newFormHtml = prototype.replace(/__name__/g, formatIndex);
    70	                let $newForm = $(newFormHtml);
    71	
    72	                // 最初のラジオボタンをオンにする
    73	                $newForm.find('input:radio[name*="[restriction]"]:first').prop('checked', true);
    74	
    75	                $formatContainer.append($newForm);
    76	            });
    77	
    78	            // 詳細情報追加
    79	            let $detailContainer = $('#card-details-container');
    80	            let detailIndex = $detailContainer.find('.detail-card').length;
    81	            $('#add-detail').on('click', function() {
    82	                let prototype = $detailContainer.data('prototype');
    83	                let newFormHtml = prototype.replace(/__name__/g, detailIndex);
    84	                let $newForm = $(newFormHtml);
    85	                $detailContainer.append($newForm);
    86	                applyRequiredBadges($newForm);
    87	                detailIndex++;
    88	            });
    89	
    90	            // 削除処理
    91	            $(document).on('click', '.delete-item', function() {
