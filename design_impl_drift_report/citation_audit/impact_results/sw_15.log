   107	     * @param array<int, array{quantity: int}> $sessionSources
   108	     *
   109	     * @throws StockJoinMoveToShortageValidationException
   110	     */
   111	    private function validateForNew(DtbStockSplitJoin $StockSplitJoin, array $sessionSources): void
   112	    {
   113	        if ($sessionSources === []) {
   114	            throw new StockJoinMoveToShortageValidationException('admin.stock.join.require_at_least_one_source', 'admin_stock_join_edit', ['id' => $StockSplitJoin->getId()]);
   115	        }
   116	
   117	        $plannedTotal = 0;
   118	        foreach ($sessionSources as $data) {
   119	            $plannedTotal += \max(0, $data['quantity']);
   120	        }
   121	        if ($plannedTotal < 1) {
   122	            throw new StockJoinMoveToShortageValidationException('admin.stock.join.apply_approval_zero_quantity', 'admin_stock_join_edit', ['id' => $StockSplitJoin->getId()]);
   123	        }
   124	    }
