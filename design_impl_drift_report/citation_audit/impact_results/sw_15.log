   180	    public function onReadRow(ReadCsvRowEvent $event): bool
   181	    {
   182	        $row = $event->getRow();
   183	
   184	        $this->pendingRows[] = [
   185	            'dest_code' => trim($row->getValue(self::COL_DEST_CODE)),
   186	            'join_qty' => trim($row->getValue(self::COL_JOIN_QTY)),
   187	            'src_code' => trim($row->getValue(self::COL_SRC_CODE)),
   188	            'src_cat' => trim($row->getValue(self::COL_SRC_CAT)),
   189	            'src_qty' => trim($row->getValue(self::COL_SRC_QTY)),
   190	        ];
   191	
   192	        return true;
   193	    }
   194	
   195	    public function onAfterImport(AfterReadEvent $event): void
   196	    {
   197	        parent::onAfterImport($event);
   198	
   199	        try {
   200	            if (!$event->isSuccessful() || $this->hasErrors || $this->pendingRows === []) {
   201	                $this->entityManager->rollback();
   202	
   203	                return;
   204	            }
   205	
   206	            // 結合先商品コード・結合数が未指定の場合はエラー
   207	            if ($this->globalDestCode === '' || $this->globalJoinQty === '') {
   208	                $this->flashErrors[] = '結合先商品コードまたは結合数が指定されていません。いずれかの行に結合先商品コードと結合数を指定してください。';
   209	                $this->entityManager->rollback();
   210	
   211	                return;
   212	            }
   213	
   214	            // em->clear() 後、$this->member は UnitOfWork から完全に除外されて detach 状態になる。
   215	            // SaveEventSubscriber が prePersist/preUpdate で getCurrentUser()（= $this->member と
   216	            // 同一オブジェクト）を setCreator() に渡すため、flush() 時に
   217	            // getEntityIdentifier($this->member) が EntityNotFoundException を投げる。
   218	            // 対策: ① registerManaged で identity map へ再登録（originalEntityData は空で初期化）
   219	            //       ② refresh で DB 値を同期し originalEntityData を正しく設定（不要な UPDATE を防ぐ）
   220	            // em->find() を先に呼ぶと別オブジェクトが identity map に入り EntityIdentityCollisionException
   221	            // になるため、registerManaged → refresh の順序を厳守する。
   222	            $uow = $this->entityManager->getUnitOfWork();
   223	            $uow->registerManaged(
   224	                $this->member,
   225	                $this->entityManager->getClassMetadata(Member::class)->getIdentifierValues($this->member),
   226	                [],
   227	            );
   228	            $this->entityManager->refresh($this->member);
   229	            $member = $this->member;
   230	
   231	            // em->clear() により baseInfo が detach されているため再取得する（在庫区分はプルダウン店舗を維持）
   232	            $baseInfo = $this->entityManager->find(BaseInfo::class, $this->baseInfo->getId());
   233	            if ($baseInfo === null) {
   234	                $this->entityManager->rollback();
   235	
   236	                return;
   237	            }
   238	
   239	            $groups = $this->buildGroups();
   240	            $successCount = 0;
   241	            $businessHasError = false;
   242	
   243	            foreach ($groups as $groupRows) {
   244	                $result = $this->processGroup($groupRows, $member, $baseInfo);
   245	                if ($result['ok']) {
   246	                    ++$successCount;
   247	                } else {
   248	                    $businessHasError = true;
   249	                    $this->flashErrors = array_merge($this->flashErrors, $result['errors']);
   250	                }
   251	            }
   252	
   253	            if ($businessHasError) {
   254	                $this->entityManager->rollback();
   255	
   256	                return;
   257	            }
   258	
   259	            if ($successCount > 0) {
   260	                $this->flashSuccesses[] = trans('admin.stock.split_join.list_csv_join_import_done', ['%count%' => (string) $successCount]);
   261	            }
   262	
   263	            $this->entityManager->flush();
   264	            $this->entityManager->commit();
   265	        } catch (\Exception $e) {
   266	            try {
   267	                $this->entityManager->rollback();
   268	            } catch (\Throwable $t) {
   269	                // ロールバック失敗は無視して元の例外を伝播させる
   270	            }
   271	            throw $e;
   272	        }
   273	    }
