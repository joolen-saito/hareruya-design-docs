   486	            return $this->json(['matrix' => [], 'options' => []]);
   487	        }
   488	
   489	        $LoginMember = $this->getUser();
   490	        if ($LoginMember instanceof Member && !$LoginMember->isEditableShop($BaseInfo)) {
   491	            return $this->json(['matrix' => [], 'options' => []], 403);
   492	        }
   493	
   494	        $members = $this->memberRepository->getApprovalAuthorityMembers($BaseInfo);
   495	
   496	        $groups = [];
   497	        $seenOptionLabels = [];
   498	        $seenMatrixNames = [];
   499	        $options = [];
   500	
   501	        foreach ($members as $Member) {
   502	            $memberId = (string) $Member->getId();
   503	            $name = $Member->getName() ?? '';
   504	            $dept = $Member->getDepartment();
   505	            $deptName = $dept !== null ? $dept->getName() : null;
   506	            $deptId = $dept !== null ? (string) $dept->getId() : '0';
   507	
   508	            // 選択肢ラベルの同名 ID 補完
   509	            $label = $name;
   510	            if (isset($seenOptionLabels[$label])) {
   511	                $label .= '(ID:'.$memberId.')';
   512	            } else {
   513	                $seenOptionLabels[$label] = true;
   514	            }
   515	            $options[] = ['value' => $memberId, 'label' => $label];
   516	
   517	            // マトリクス（チップ UI 表示名）の同名 ID 補完はグローバルで判定
   518	            $nameKey = $name;
   519	            $displayName = $name;
   520	            if (isset($seenMatrixNames[$nameKey])) {
   521	                $displayName = $name.'(ID:'.$memberId.')';
   522	            } else {
   523	                $seenMatrixNames[$nameKey] = true;
   524	            }
   525	
   526	            if (!isset($groups[$deptId])) {
   527	                $groups[$deptId] = ['id' => $deptId, 'label' => $deptName ?? '', 'members' => []];
   528	            }
   529	            $groups[$deptId]['members'][] = ['id' => $memberId, 'name' => $displayName];
   530	        }
   531	
   532	        $response = $this->json(['matrix' => array_values($groups), 'options' => $options]);
   533	
   534	        $event = new EventArgs(
   535	            [
   536	                'response' => $response,
   537	                'BaseInfo' => $BaseInfo,
   538	            ],
   539	            $request
   540	        );
   541	        $this->eventDispatcher->dispatch($event, EccubeEvents::ADMIN_STOCK_SPLIT_JOIN_APPROVAL_MEMBERS_COMPLETE);
   542	
   543	        return $response;
   544	    }
