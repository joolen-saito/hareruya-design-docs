    65	    public function handle(StockJoinMoveToShortageEntryInput $input): array
    66	    {
    67	        $ProductStock = $input->ProductStock;
    68	        $Member = $input->Member !== null
    69	            ? $this->entityManager->find(Member::class, $input->Member->getId())
    70	            : null;
    71	
    72	        if ($Member === null) {
    73	            throw new StockJoinMoveToShortageValidationException('admin.stock.split_join.login_required', 'admin_stock_join_new', ['productStockId' => $ProductStock->getId()]);
    74	        }
    75	
    76	        $StockSplitJoin = $this->resolveStockSplitJoin($input);
    77	        $statusId = $StockSplitJoin->getStockSplitJoinStatus()->getId();
    78	
    79	        if ($statusId === MtbStockSplitJoinStatus::NEW) {
    80	            $this->validateForNew($StockSplitJoin, $input->sessionSources);
    81	            $this->createDetailsFromSession($StockSplitJoin, $input->sessionSources, $Member);
    82	        } else {
    83	            $this->validateForRegistered($StockSplitJoin);
    84	        }
    85	
    86	        $Status = $this->statusRepository->find(MtbStockSplitJoinStatus::JOIN_SOURCE_REGISTERED);
    87	        if ($Status === null) {
    88	            throw new \LogicException('StockJoinMoveToShortageEntryAction requires JOIN_SOURCE_REGISTERED status in master.');
    89	        }
    90	
    91	        $now = new \DateTime();
    92	        $StockSplitJoin->setStockSplitJoinStatus($Status);
    93	        $StockSplitJoin->setMoveToApprovalAt($now);
    94	        $StockSplitJoin->setMoveToApprovalMember($Member);
    95	        $StockSplitJoin->setUpdater($Member);
    96	        $StockSplitJoin->setUpdateDate($now);
    97	
    98	        $this->statusHistoryEntityManager->save(null, $StockSplitJoin, $Status, $Member, $now);
    99	        $this->entityManager->flush();
   100	
   101	        return ['joinId' => (int) $StockSplitJoin->getId()];
   102	    }
