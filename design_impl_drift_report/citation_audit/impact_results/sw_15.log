   131	        $rowErrors = [];
   132	
   133	        $srcCode = trim($row->getValue(self::COL_SRC_CODE));
   134	        $splitQtyRaw = trim($row->getValue(self::COL_SPLIT_QTY));
   135	        $destCode = trim($row->getValue(self::COL_DEST_CODE));
   136	        $destQtyRaw = trim($row->getValue(self::COL_DEST_QTY));
   137	
   138	        // 分割元商品コード: 空欄→グローバル引き継ぎ、同一→許可、異なる→エラー
