   141	                $this->globalSrcCode = $srcCode;
   142	            } elseif ($this->globalSrcCode !== $srcCode) {
   143	                $rowErrors[] = "{$lineNum}行目: 分割元商品コードが異なります。1ファイルに指定できる分割元は1件のみです。";
   144	            }
   145	        }
