   127	     * JOIN_SOURCE_REGISTERED ステータス用バリデーション（DB の Detail を検証）
   128	     *
   129	     * @throws StockJoinMoveToShortageValidationException
   130	     */
   131	    private function validateForRegistered(DtbStockSplitJoin $StockSplitJoin): void
   132	    {
   133	        $sources = $this->stockSplitJoinDetailRepository->findByStockSplitJoin($StockSplitJoin);
   134	        if (\count($sources) < 1) {
   135	            throw new StockJoinMoveToShortageValidationException('admin.stock.join.require_at_least_one_source', 'admin_stock_join_edit', ['id' => $StockSplitJoin->getId()]);
   136	        }
   137	
   138	        $plannedJoinTotal = 0;
   139	        foreach ($sources as $SourceDetail) {
   140	            $plannedJoinTotal += \max(0, $SourceDetail->getSourceStock() - $SourceDetail->getShortageQuantity());
   141	        }
   142	        if ($plannedJoinTotal < 1) {
   143	            throw new StockJoinMoveToShortageValidationException('admin.stock.join.apply_approval_zero_quantity', 'admin_stock_join_edit', ['id' => $StockSplitJoin->getId()]);
   144	        }
   145	    }
