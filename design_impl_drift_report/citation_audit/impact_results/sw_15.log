    15	
    16	namespace Eccube\Service\Csv\Importer\Validator;
    17	
    18	use Eccube\Service\Csv\Importer\MessageStore;
    19	use Eccube\Service\Csv\Importer\Model\CsvValueInterface;
    20	use Eccube\Util\SqlUtil;
    21	
    22	/**
    23	 * 0以上の整数であることを検証する ValidatorInterface 実装。
    24	 */
    25	class NumericValidator implements ValidatorInterface
    26	{
    27	    use ValidatorTrait;
    28	
    29	    /**
    30	     * @param MessageStore $errors エラーメッセージの格納先
    31	     * @param CsvValueInterface $value 検証する値
    32	     *
    33	     * @return bool $value が空ではない場合 true
    34	     */
    35	    public function validate(MessageStore $errors, CsvValueInterface $value): bool
    36	    {
    37	        if (!$value->hasValue()) {
    38	            // 未入力の場合はチェックしない
    39	            return true;
    40	        }
    41	
    42	        $validator = function ($value) {
    43	            return SqlUtil::isNumericParam($value);
    44	        };
    45	
    46	        if (!$value->validate($validator)) {
    47	            $errors->addNumericError($value->getRowNumber(), $value->getLabel());
    48	
    49	            return false;
    50	        }
    51	
    52	        return true;
    53	    }
    54	}
