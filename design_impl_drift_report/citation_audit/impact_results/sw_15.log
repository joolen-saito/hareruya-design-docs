    86	    public function onBeforeImport(): void
    87	    {
    88	        parent::onBeforeImport();
    89	        $this->pendingRows = [];
    90	        $this->flashErrors = [];
    91	        $this->flashSuccesses = [];
    92	        $this->hasErrors = false;
    93	        $this->dataRowCount = 0;
    94	        $this->globalDestCode = '';
    95	        $this->globalJoinQty = '';
    96	        $this->entityManager->beginTransaction();
