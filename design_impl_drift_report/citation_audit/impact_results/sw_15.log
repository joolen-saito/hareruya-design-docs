   463	            || $normalized === 'smaregi'
   464	            || $normalized === 'smaregi在庫'
   465	            || $normalized === 'スマレジ在庫'
   466	        ) {
   467	            return ProductStock::STOCK_LOCATION_SMAREGI;
   468	        }
   469	
   470	        return null;
   471	    }
