    19	
    20	/**
    21	 * 在庫移動実績CSV用の CsvImportService。
    22	 * テンプレートDLのBOM付きUTF-8・列数ずれに対応するため setColumnHeaders / current をオーバーライドする。
    23	 */
    24	class StockMoveInstructionCsvImportService extends CsvImportService
    25	{
    26	    /**
    27	     * ヘッダー設定時に先頭列からUTF-8 BOMを除去する。
    28	     */
    29	    public function setColumnHeaders(array $columnHeaders): void
    30	    {
    31	        foreach ($columnHeaders as $i => $h) {
    32	            if (is_string($h) || is_int($h)) {
    33	                $s = (string) $h;
    34	                $s = preg_replace('/^\xEF\xBB\xBF/u', '', $s) ?? $s;
    35	                $s = preg_replace('/^\x{FEFF}/u', '', $s) ?? $s;
    36	                $columnHeaders[$i] = $s;
    37	            }
    38	        }
    39	        parent::setColumnHeaders($columnHeaders);
    40	    }
    41	
    42	    /**
    43	     * 列数がヘッダーと一致しない行もパディング／切り詰めして結合し、「○行目の○ではデータを取得できません」を防ぐ。
    44	     * 常に getColumnHeaders() の順で array_combine して返し、行ごとのキー順の揺れをなくす。
    45	     *
    46	     * @return array<int, string>|null
    47	     */
    48	    #[\ReturnTypeWillChange]
    49	    public function current(): ?array
    50	    {
    51	        $result = parent::current();
    52	        $headerKeys = $this->getColumnHeaders();
    53	        if (!is_array($result) || $headerKeys === []) {
    54	            return $result;
    55	        }
    56	
    57	        $headerCount = count($headerKeys);
    58	        $lineArray = array_values($result);
    59	        $lineCount = count($lineArray);
    60	
    61	        if ($lineCount < $headerCount) {
    62	            $lineArray = array_pad($lineArray, $headerCount, '');
    63	        } elseif ($lineCount > $headerCount) {
    64	            $lineArray = array_slice($lineArray, 0, $headerCount);
    65	        }
    66	
    67	        return array_combine($headerKeys, $lineArray);
    68	    }
    69	}
