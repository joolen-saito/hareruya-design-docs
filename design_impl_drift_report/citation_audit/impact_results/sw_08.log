   136	    /**
   137	     * 本会員をリセットキー、またはリセットキーとメールアドレスで検索する.
   138	     *
   139	     * @return RegisterCustomerView|null 見つからない場合はnullを返す.
   140	     *
   141	     * @throws NonUniqueResultException
   142	     */
   143	    public function getRegularCustomerByResetKey(string $resetKey, ?string $email = null): ?RegisterCustomerView
   144	    {
   145	        $qb = $this->createQueryBuilder('c')
   146	            ->where('c.reset_key = :reset_key AND c.statusId = :status AND c.reset_expire >= :reset_expire')
   147	            ->setParameter('reset_key', $resetKey)
   148	            ->setParameter('status', CustomerStatus::REGULAR)
   149	            ->setParameter('reset_expire', new \DateTime());
   150	
   151	        if ($email) {
   152	            $qb
   153	                ->andWhere('c.email = :email')
   154	                ->setParameter('email', $email);
   155	        }
   156	
   157	        return $qb->setMaxResults(1)
   158	            ->getQuery()
   159	            ->getOneOrNullResult();
   160	    }
