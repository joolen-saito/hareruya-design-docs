   181	    #[Route(path: '/purchase/fill', name: 'purchase_fill', methods: ['GET'])]
   182	    #[Template(template: 'Purchase/fill.twig')]
   183	    public function fill(Request $request): array|RedirectResponse
   184	    {
   185	        $session = $request->getSession();
   186	        if (!$session->get(self::CART_SESSION_KEY)) {
   187	            return $this->redirectToRoute('purchase_cart');
   188	        }
   189	
   190	        if (!$this->isGranted('IS_AUTHENTICATED_FULLY')) {
   191	            return $this->redirectToRoute('purchase_login');
   192	        }
   193	
   194	        // セッションのカート情報を正規化
   195	        $cartPage = $this->purchaseCartService->buildCartPageResult(
   196	            $session->get(self::CART_SESSION_KEY),
   197	        );
   198	        $session->set(self::CART_SESSION_KEY, $cartPage->normalizedCart);
   199	
   200	        if ($cartPage->display->lines === []) {
   201	            return $this->redirectToRoute('purchase_cart');
   202	        }
   203	
   204	        $customer = $this->getUser();
   205	        if (!$customer instanceof Customer) {
   206	            return $this->redirectToRoute('purchase_login');
   207	        }
   208	
   209	        // Note:前回の口座情報を初期表示に使う（移植元踏襲）
   210	        $bankAccount = $this->dtbBankAccountRepository->findOneBy(
   211	            ['Customer' => $customer],
   212	            ['id' => 'DESC'],
   213	        );
   214	        // フォールバック
   215	        if ($bankAccount === null) {
   216	            $bankAccount = new DtbBankAccount();
   217	        }
   218	
   219	        $isQualifiedInvoiceIssuerAccount = false;
   220	        $qualifiedInvoiceIssuerAccount = $this->dtbQualifiedInvoiceIssuerAccountRepository
   221	            ->getQualifiedInvoiceIssuerAccountByCustomer($customer);
   222	        // フォールバック
