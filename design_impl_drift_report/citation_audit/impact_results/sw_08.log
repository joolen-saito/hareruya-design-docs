   740	            $CustomerAddress = new CustomerAddress();
   741	            if ($this->isGranted('IS_AUTHENTICATED_FULLY')) {
   742	                /** @var Customer $Customer */
   743	                $Customer = $this->getUser();
   744	                // 配送先登録上限に達していたら処理を止めて 404 を返す
   745	                $addressCurrNum = count($Customer->getCustomerAddresses());
   746	                $addressMax = $this->eccubeConfig['eccube_deliv_addr_max'];
   747	                if ($addressCurrNum >= $addressMax) {
   748	                    throw new NotFoundHttpException();
   749	                }
   750	
   751	                $CustomerAddress->setCustomer($Customer);
   752	            } else {
   753	                // 非会員時はお届け先をセット
   754	                $CustomerAddress->setFromShipping($Shipping);
   755	            }
   756	        }
   757	        $builder = $this->formFactory->createBuilder(ShoppingShippingType::class, $CustomerAddress);
   758	
   759	        $event = new EventArgs(
   760	            [
   761	                'builder' => $builder,
   762	                'Order' => $Order,
   763	                'Shipping' => $Shipping,
   764	                'CustomerAddress' => $CustomerAddress,
   765	                'id' => $Shipping->getId(),
   766	            ],
   767	            $request
   768	        );
   769	        $this->eventDispatcher->dispatch($event, EccubeEvents::FRONT_SHOPPING_SHIPPING_EDIT_INITIALIZE);
   770	
   771	        $form = $builder->getForm();
   772	
   773	        // セッションから入力データを復元
   774	        $session = $request->getSession();
   775	        $inputData = $session->get('eccube.front.shopping.shipping.input');
   776	        $isRestored = false;
   777	        if ($inputData && isset($inputData['shopping_shipping'])) {
   778	            $form->submit($inputData['shopping_shipping']);
   779	            $session->remove('eccube.front.shopping.shipping.input');
   780	            $isRestored = true;
   781	        } else {
   782	            $form->handleRequest($request);
   783	        }
   784	
   785	        // フォームが送信されて、かつ復元されていない場合、かつバリデーションが通った場合
   786	        if (!$isRestored && $form->isSubmitted() && $form->isValid()) {
   787	            // 確認画面を表示
   788	            return $this->render('Shopping/delivery_confirm.twig', [
   789	                'form' => $form->createView(),
