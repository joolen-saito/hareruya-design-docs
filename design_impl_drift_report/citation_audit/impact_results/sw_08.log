   277	    /**
   278	     * 会員登録処理を行う
   279	     *
   280	     * @throws EntryAlreadyActivatedException 既に本会員登録済みの場合
   281	     * @throws EntryInvalidSecretKeyException 無効な secret_key の場合
   282	     * @throws EntryActivateFailedException 本会員化後のスマレジ会員連携に失敗した場合
   283	     */
   284	    private function entryActivate(Request $request, string $secret_key): int
   285	    {
   286	        log_info('本会員登録開始');
   287	
   288	        $Customer = $this->registerCustomerViewRepository->getProvisionalCustomerBySecretKey($secret_key);
   289	        if ($Customer === null) {
   290	            if ($this->registerCustomerViewRepository->isAlreadyActivatedBySecretKey($secret_key)) {
   291	                throw new EntryAlreadyActivatedException();
   292	            }
   293	
   294	            throw new EntryInvalidSecretKeyException();
   295	        }
   296	
   297	        // ビューでお客様のステータスを更新する。
   298	        $this->entityManager->getConnection()->executeQuery(
   299	            'UPDATE registration_view SET customer_status_id = :status_id WHERE secret_key = :secret_key',
   300	            [
   301	                'status_id' => CustomerStatus::REGULAR,
   302	                'secret_key' => $Customer->getSecretKey(),
   303	            ]
   304	        );
   305	
   306	        log_info('本会員登録完了');
   307	
   308	        $event = new EventArgs(
   309	            [
   310	                'Customer' => $Customer,
   311	            ],
   312	            $request
   313	        );
   314	        $this->eventDispatcher->dispatch($event, EccubeEvents::FRONT_ENTRY_ACTIVATE_COMPLETE);
   315	
   316	        // スマレジ会員を作成し、採番された会員IDをdtb_playerへ保存
   317	        $ActivatedCustomer = $this->linkSmaregiCustomer($secret_key);
   318	
   319	        // メール送信
   320	        $this->mailService->sendCustomerCompleteMail($Customer);
   321	
   322	        // Assign session carts into customer carts
   323	        $Carts = $this->cartService->getCarts();
   324	        $qtyInCart = 0;
   325	        foreach ($Carts as $Cart) {
   326	            $qtyInCart += $Cart->getTotalQuantity();
   327	        }
   328	
   329	        if ($ActivatedCustomer instanceof Customer) {
   330	            $this->security->login($ActivatedCustomer, 'form_login', 'customer');
   331	        }
   332	
   333	        if ($qtyInCart) {
   334	            $this->cartService->save();
   335	        }
   336	
   337	        return $qtyInCart;
   338	    }
   339	
   340	    /**
   341	     * EC-CUBE上の会員とスマレジ会員と紐付ける
   342	     *
   343	     * activate が扱う $Customer は読み取り専用ビュー (RegisterCustomerView) のため、
   344	     * 書き込み可能な CustomerRepository から実体を引き直して dtb_player を更新する。
   345	     *
   346	     * @return Customer|null アクティベートされた会員
   347	     *
   348	     * @throws EntryActivateFailedException スマレジ会員連携に失敗した場合
   349	     */
   350	    private function linkSmaregiCustomer(string $secret_key): ?Customer
   351	    {
   352	        /** @var Customer|null $Customer */
   353	        $Customer = $this->customerRepository->findOneBy(['secret_key' => $secret_key]);
   354	        if ($Customer === null) {
   355	            return null;
   356	        }
   357	
   358	        $Player = $Customer->getPlayer();
   359	        if ($Player === null) {
   360	            return $Customer;
   361	        }
   362	
   363	        // 既に連携済みなら何もしない (冪等).
   364	        $smaregiId = $Player->getSmaregiId();
   365	        if ($smaregiId !== null && $smaregiId !== '') {
   366	            return $Customer;
   367	        }
   368	
   369	        // 同一会員のアクティベートが並行しても二重登録しないよう、Player 行を悲観ロックして直列化する。
   370	        // ロック取得後に smaregi_id を再チェックし、先行リクエストが連携済みなら何もしない。
   371	        $this->entityManager->beginTransaction();
   372	        try {
   373	            $this->entityManager->lock($Player, LockMode::PESSIMISTIC_WRITE);
   374	            $this->entityManager->refresh($Player);
   375	
   376	            $lockedSmaregiId = $Player->getSmaregiId();
   377	            if ($lockedSmaregiId !== null && $lockedSmaregiId !== '') {
   378	                // 先行リクエストが連携済みのため二重作成しない。
   379	                $this->entityManager->commit();
   380	
   381	                return $Customer;
   382	            }
   383	
   384	            $result = $this->smaregiCustomerService->createCustomer($Customer);
   385	
   386	            if ($result['ok'] && !empty($result['smaregiId'])) {
   387	                $Player->setSmaregiId($result['smaregiId']);
   388	                $Player->setExistsSmaregiFlg(true);
   389	                $this->entityManager->flush();
   390	                $this->entityManager->commit();
   391	
   392	                return $Customer;
   393	            }
   394	
   395	            // スマレジ API 失敗時はフラグ OFF のまま確定し、アクティベート失敗画面で終了する
   396	            $this->markSmaregiLinkFailed($Player, $Customer->getId(), $result['error']);
   397	            $this->entityManager->commit();
   398	
   399	            throw new EntryActivateFailedException('スマレジ会員連携に失敗しました');
   400	        } catch (EntryActivateFailedException $e) {
   401	            throw $e;
   402	        } catch (\Throwable $e) {
   403	            if ($this->entityManager->getConnection()->isTransactionActive()) {
   404	                $this->entityManager->rollback();
   405	            }
   406	
   407	            // 予期しない例外も連携失敗として扱い、アクティベート失敗画面へ遷移させる
   408	            log_error('スマレジ会員連携処理で例外が発生しました(本会員化は完了済み)', [
   409	                'customerId' => $Customer->getId(),
   410	                'error' => $e->getMessage(),
   411	            ]);
   412	
   413	            throw new EntryActivateFailedException('スマレジ会員連携処理で例外が発生しました', 0, $e);
   414	        }
   415	    }
   416	
   417	    /**
   418	     * スマレジ連携失敗を記録する (exists_smaregi_flg を OFF のまま確定し、ログを残す)
   419	     */
   420	    private function markSmaregiLinkFailed(DtbPlayer $Player, ?int $customerId, ?string $error): void
   421	    {
   422	        $Player->setExistsSmaregiFlg(false);
   423	        $this->entityManager->flush();
   424	
   425	        log_error('スマレジ会員連携に失敗しました(本会員化は完了済み)', [
   426	            'customerId' => $customerId,
   427	            'error' => $error,
   428	        ]);
   429	    }
