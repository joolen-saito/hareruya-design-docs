     4	{% extends 'default_frame.twig' %}
     5	
     6	{% set body_class = 'purchase purchase_page purchase_search' %}
     7	{% if Category is defined and Category %}
     8	    {% set _purchase_names = [] %}
     9	    {% for _cat in Category.path %}
    10	        {% set _purchase_names = _purchase_names|merge([_cat.name]) %}
    11	    {% endfor %}
    12	    {% if _purchase_names|length >= 3 and _purchase_names[1] in _purchase_names[2] %}
    13	        {% set _purchase_names = [_purchase_names[0], _purchase_names[2]] %}
    14	    {% endif %}
    15	    {% set subtitle = _purchase_names|join(' / ') ~ ('front.seo.purchase_list.subtitle_suffix'|trans) %}
    16	{% else %}
    17	    {% set subtitle = 'front.seo.purchase_list.subtitle_default'|trans %}
    18	{% endif %}
    19	
    20	{% block stylesheet %}
    21	    <link rel="stylesheet" href="{{ asset('assets/hareruya/css/hareruya-products-list.css') }}">
    22	{% endblock %}
