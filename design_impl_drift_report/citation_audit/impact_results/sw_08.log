   441	        $categoryFormatGroups = [
   442	            ['type' => TopCategoryListBuilder::GROUP_STANDARD, 'items' => $categoryGroups[TopCategoryListBuilder::GROUP_STANDARD]['items']],
   443	            ['type' => TopCategoryListBuilder::GROUP_PIONEER, 'items' => $categoryGroups[TopCategoryListBuilder::GROUP_PIONEER]['items']],
