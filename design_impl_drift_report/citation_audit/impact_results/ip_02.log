   217	        $isDeckRegistrationList = ($searchData['searchMode'] ?? 'event_entry') === 'deck_registration';
   218	        $activeSortKeysMap = $isDeckRegistrationList ? $this->deckRepository->getEntryDeckSearchSortKeys() : $entrySortKeysMap;
   219	        $defaultSortKey = $isDeckRegistrationList ? DtbDeckRepository::DEFAULT_ENTRY_DECK_SEARCH_SORT_KEY : self::ENTRY_LIST_DEFAULT_SORT_KEY;
   220	
   221	        $sortKey = (string) ($request->query->get('sort') ?? $this->session->get(self::SESSION_KEY.'.sort', $defaultSortKey));
   222	        if (!isset($activeSortKeysMap[$sortKey])) {
   223	            $sortKey = $defaultSortKey;
   224	        }
   225	        $order = strtoupper((string) ($request->query->get('order') ?? $this->session->get(self::SESSION_KEY.'.order', 'DESC')));
   226	        if ($order !== 'ASC' && $order !== 'DESC') {
   227	            $order = 'DESC';
   228	        }
   229	        $this->session->set(self::SESSION_KEY.'.sort', $sortKey);
   230	        $this->session->set(self::SESSION_KEY.'.order', $order);
   231	
   232	        if ($shouldSearch) {
   233	            $searchData['sort'] = $sortKey;
   234	            $searchData['order'] = $order;
   235	
   236	            if ($isDeckRegistrationList) {
   237	                $qb = $this->deckRepository->getEntryDeckData($searchData);
   238	            } else {
   239	                $qb = $this->entryRepository->getQueryBuilderByEntrySearchData($searchData);
   240	            }
   241	            $pagination = $paginator->paginate(
   242	                $qb->getQuery(),
   243	                $pageNo,
   244	                (int) $pageCount,
   245	                self::ENTRY_LIST_PAGINATION_OPTIONS
   380	        );
   381	        $this->eventDispatcher->dispatch($event, EccubeEvents::ADMIN_EVENT_ENTRY_BULK_UPDATE_ENTRY_STATUS_COMPLETE);
