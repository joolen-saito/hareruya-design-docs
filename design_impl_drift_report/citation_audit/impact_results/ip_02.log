   157	                $sortKey = (string) ($request->query->get('sort') ?? $this->session->get(self::SESSION_KEY.'.sort', $errDefaultSortKey));
   158	                if (!isset($errSortKeysMap[$sortKey])) {
   159	                    $sortKey = $errDefaultSortKey;
   160	                }
   161	                $order = strtoupper((string) ($request->query->get('order') ?? $this->session->get(self::SESSION_KEY.'.order', 'DESC')));
   162	                if ($order !== 'ASC' && $order !== 'DESC') {
   163	                    $order = 'DESC';
   164	                }
   165	                $this->session->set(self::SESSION_KEY.'.sort', $sortKey);
   166	                $this->session->set(self::SESSION_KEY.'.order', $order);
   167	
   168	                $emptyPagination = $paginator->paginate([], $pageNo, (int) $pageCount);
   169	
   170	                return [
   171	                    'searchForm' => $searchForm->createView(),
