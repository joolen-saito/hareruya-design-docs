   342	    /**
   343	     * @param string|null $id
   344	     */
   345	    #[Route(path: '/%eccube_admin_route%/content/page/{id}/delete', name: 'admin_content_page_delete', requirements: ['id' => '\d+'], methods: ['DELETE'])]
   346	    public function delete(Request $request, CacheUtil $cacheUtil, $id = null): RedirectResponse
   347	    {
   348	        $this->isTokenValid();
   349	
   350	        $Page = $this->pageRepository
   351	            ->findOneBy([
   352	                'id' => $id,
   353	            ]);
   354	
   355	        if (!$Page) {
   356	            $this->deleteMessage();
   357	
   358	            return $this->redirectToRoute('admin_content_page');
   359	        }
   360	
   361	        $adapter = $this->fileManager->getAdapter();
   362	        $contentBucketOptions = $this->fileManager->getContentBucketOptions();
   363	
   364	        // ユーザーが作ったページのみ削除する
   365	        if ($Page->getEditType() == Page::EDIT_TYPE_USER) {
   366	            $templatePath = $this->getParameter('eccube_theme_user_data_dir');
   367	            $file = $templatePath.'/'.$Page->getFileName().'.twig';
   368	            $fs = new Filesystem();
   369	            if ($fs->exists($file)) {
   370	                $fs->remove($file);
   371	            }
   372	            $this->entityManager->remove($Page);
   373	            $this->entityManager->flush();
   374	
   375	            $event = new EventArgs(
   376	                [
   377	                    'Page' => $Page,
   378	                ],
   379	                $request
   380	            );
   381	            $this->eventDispatcher->dispatch($event, EccubeEvents::ADMIN_CONTENT_PAGE_DELETE_COMPLETE);
   382	
   383	            if ($adapter->exists($this::USER_DATA_PAGE_PATH.$Page->getFileName().'.twig', $contentBucketOptions)) {
   384	                $adapter->delete($this::USER_DATA_PAGE_PATH.$Page->getFileName().'.twig', $contentBucketOptions);
   385	            } else {
   386	                log_error($this::USER_DATA_PAGE_PATH.$Page->getFileName().'.twig はS3に存在しません');
   387	            }
   388	
   389	            $this->addSuccess('admin.common.delete_complete', 'admin');
