    92	    public function edit(Request $request, Environment $twig, RouterInterface $router, CacheUtil $cacheUtil, $id = null): RedirectResponse|array
    93	    {
    94	        // URLクエリーに付与されているlocaleパラメータのバリデーション (デフォルト: ja)
    95	        $locale = $request->query->get('locale', 'ja');
    96	        if (!in_array($locale, $this->getParameter('kernel.enabled_locales'), true)) {
    97	            throw new NotFoundHttpException();  // localeパラメータがjaでもenでもなければ404ページ表示
    98	        }
    99	        // 日本語は.jaなし（例: foo.twig）、英語は.en付き（例: foo.en.twig）
   100	        $localeSuffix = $locale === 'ja' ? '' : '.'.$locale;
   101	        $this->addInfoOnce('admin.common.restrict_file_upload_info', 'admin');
   102	
   103	        if (null === $id) {
   104	            $Page = $this->pageRepository->newPage();
   105	        } else {
   106	            $Page = $this->pageRepository->find($id);
   107	            if ($Page == null) {
   108	                throw new NotFoundHttpException();
   109	            }
   110	        }
   111	
   112	        // フォーム生成前に isUserDataPage を確定する
