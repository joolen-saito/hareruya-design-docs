   116	            ->createBuilder(MainEditType::class, $Page, [
   117	                'is_user_data_page' => $isUserDataPage,
   118	            ]);
   119	
   120	        $event = new EventArgs(
   121	            [
   122	                'builder' => $builder,
   123	                'Page' => $Page,
   124	            ],
   125	            $request
   330	            'page_id' => $Page->getId(),
   331	            'is_user_data_page' => $isUserDataPage,
   332	            'is_confirm_page' => $Page->getEditType() == Page::EDIT_TYPE_DEFAULT_CONFIRM,
   333	            'template_path' => $templatePath,
   334	            'url' => $url,
   335	            'locale' => $locale,
   336	            'update_date' => $Page->getUpdateDate(),
   337	            'tpl_data_value' => $source ?? null,
   338	            'page_file_name' => $PrevPage->getFileName(),
