    37	    #[\Override]
    38	    public function configureOptions(OptionsResolver $resolver): void
    39	    {
    40	        $currency = $this->eccubeConfig->get('currency');
    41	        $scale = Currencies::getFractionDigits($currency);
    42	        $max = $this->eccubeConfig['eccube_price_max'];
    43	        $min = -$max;
    44	
    45	        $constraints = function (Options $options) use ($max, $min) {
    46	            $constraints = [];
    47	            // requiredがtrueに指定されている場合, NotBlankを追加
    48	            if (isset($options['required']) && true === $options['required']) {
    49	                $constraints[] = new NotBlank();
    50	            }
    51	
    52	            if (isset($options['accept_minus']) && true === $options['accept_minus']) {
    53	                $constraints[] = new Range([
    54	                    'min' => $min,
    55	                    'max' => $max,
    56	                ]);
    57	            } else {
    58	                $constraints[] = new Range(['min' => 0, 'max' => $max]);
    59	            }
    60	
    61	            return $constraints;
    62	        };
    63	
    64	        $resolver->setDefaults(
    65	            [
    66	                'currency' => $currency,
    67	                'scale' => $scale,
    68	                'grouping' => true,
    69	                'constraints' => $constraints,
    70	                'accept_minus' => false, // マイナス値を許容するかどうか
    71	            ]
    72	        );
    73	    }
