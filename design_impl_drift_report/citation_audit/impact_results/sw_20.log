   540	            ->getQuery()
   541	            ->getResult();
   542	
   543	        $selectedByProductId = [];
   544	        foreach ($candidates as $ProductClass) {
   545	            $productId = $ProductClass->getProduct()->getId();
   546	            $current = $selectedByProductId[$productId] ?? null;
   547	            if ($current === null || $this->compareProductClassPreference($ProductClass, $current, $priorityIndex) < 0) {
   548	                $selectedByProductId[$productId] = $ProductClass;
   549	            }
   550	        }
   551	
   552	        $selected = array_values($selectedByProductId);
   553	        usort($selected, function (ProductClass $a, ProductClass $b) use ($priorityIndex): int {
   554	            $aPos = $this->priorityPositionOfProductClass($a, $priorityIndex);
   555	            $bPos = $this->priorityPositionOfProductClass($b, $priorityIndex);
   556	            if ($aPos !== $bPos) {
   557	                return $aPos <=> $bPos;
   558	            }
   559	
   560	            return $b->getProduct()->getId() <=> $a->getProduct()->getId();
   561	        });
   562	
   563	        return array_slice($selected, 0, $limit);
   564	    }
