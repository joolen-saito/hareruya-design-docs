    63	    /**
    64	     * @return array<string, mixed>
    65	     */
    66	    #[Route('/%eccube_admin_route%/archetype', name: 'admin_archetype_list', methods: ['GET', 'POST'])]
    67	    #[Route('/%eccube_admin_route%/archetype/search/{page_no}', name: 'admin_archetype_search', requirements: ['page_no' => '\d+'], methods: ['GET', 'POST'])]
    68	    #[Template('@admin/Archetype/index.twig')]
    69	    public function index(Request $request, PaginatorInterface $paginator, int $page_no = 1): array
    70	    {
    71	        $searchForm = $this->getForm();
    72	
    73	        $event = new EventArgs(
    74	            [
    75	                'form' => $searchForm,
    76	            ],
    77	            $request
    78	        );
    79	        $this->eventDispatcher->dispatch($event, EccubeEvents::ADMIN_ARCHETYPE_INDEX_INITIALIZE);
    80	
    81	        if ($request->isMethod('POST')) {
    82	            $searchForm->handleRequest($request);
    83	
    84	            if (!$searchForm->isValid()) {
    85	                return [
    86	                    'searchForm' => $searchForm->createView(),
    87	                    'pagination' => null,
    88	                    'is_search_filter_active' => true,
    89	                ];
    90	            }
    91	
    92	            $page_no = 1;
    93	            $viewData = FormUtil::getViewData($searchForm);
    94	
    95	            $this->session->set('eccube.admin.'.$this->sessionKey.'.search', $viewData);
    96	            $this->session->set('eccube.admin.'.$this->sessionKey.'.search.page_no', $page_no);
    97	        } else {
    98	            $pageNoAttr = $request->attributes->get('page_no');
    99	            if ($request->query->getInt('resume') === Constant::ENABLED || $pageNoAttr !== null) {
   100	                if ($pageNoAttr !== null) {
   101	                    $page_no = (int) $pageNoAttr;
   102	                    $this->session->set('eccube.admin.'.$this->sessionKey.'.search.page_no', $page_no);
   103	                } else {
   104	                    $page_no = $this->session->get('eccube.admin.'.$this->sessionKey.'.search.page_no', 1);
   105	                }
   106	                $viewData = $this->session->get('eccube.admin.'.$this->sessionKey.'.search', []);
   107	                FormUtil::submitAndGetData($searchForm, $viewData);
   108	            } else {
   109	                $viewData = FormUtil::getViewData($searchForm);
   110	                $this->session->set('eccube.admin.'.$this->sessionKey.'.search', $viewData);
   111	                $this->session->set('eccube.admin.'.$this->sessionKey.'.search.page_no', 1);
   112	                $this->session->set('eccube.admin.'.$this->sessionKey.'.search.page_count', 100);
   113	
   114	                return [
   115	                    'searchForm' => $searchForm->createView(),
   116	                    'pagination' => null,
   117	                    'is_search_filter_active' => false,
   118	                ];
   119	            }
   120	        }
   121	
   122	        $responseData = $this->search($request, null, $page_no);
   123	
   124	        $searchData = $searchForm->getData();
   125	        $sortKeys = $this->archetypeRepository->getSortKeys();
   126	        $sortKey = (string) ($searchData['sortKey'] ?? $this->archetypeRepository::DEFAULT_SORT_KEY);
   127	        if (!array_key_exists($sortKey, $sortKeys)) {
   128	            $sortKey = $this->archetypeRepository::DEFAULT_SORT_KEY;
   129	        }
   130	        $sortOrder = strtoupper((string) ($searchData['sortOrder'] ?? $this->archetypeRepository::DEFAULT_SORT_ORDER));
   131	        if (!in_array($sortOrder, ['ASC', 'DESC'], true)) {
   132	            $sortOrder = $this->archetypeRepository::DEFAULT_SORT_ORDER;
   133	        }
   134	
   135	        $responseData['sortKeys'] = $sortKeys;
   136	        $responseData['sortKey'] = $sortKey;
   137	        $responseData['sortOrder'] = $sortOrder;
   138	
   139	        return $responseData;
   140	    }
