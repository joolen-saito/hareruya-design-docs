    77	        if ($shopDigit === '') {
    78	            return self::TOP_BANNER_S3_DIRECTORY;
    79	        }
    80	
    81	        return self::TOP_BANNER_S3_DIRECTORY.'/'.$shopDigit;
    82	    }
