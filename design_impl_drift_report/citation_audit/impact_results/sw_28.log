    35	    public function handle(TopBannerUploadInput $input): array
    36	    {
    37	        $file = $input->getFile();
    38	        $Member = $input->getMember();
    39	        $BaseInfo = $input->getBaseInfo();
    40	        if ($BaseInfo !== null && !$Member->isEditableShop($BaseInfo)) {
    41	            throw new \RuntimeException('admin.data.top_banner.upload_not_allowed');
    42	        }
    43	
    44	        $filename = $this->buildFileName($file);
    45	        $uploadDirectory = $this->buildUploadDirectory($BaseInfo);
