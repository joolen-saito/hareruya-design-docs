    56	
    57	    private function buildFileName(UploadedFile $file): string
    58	    {
    59	        $extension = $file->getClientOriginalExtension();
    60	        if ($extension === '') {
    61	            $extension = (string) $file->guessExtension();
    62	        }
    63	        if ($extension === '') {
    64	            $extension = 'jpg';
    65	        }
    66	
    67	        return date('mdHis').uniqid('_').'.'.strtolower($extension);
    68	    }
    69	
    70	    private function buildUploadDirectory(?BaseInfo $BaseInfo): string
    71	    {
    72	        if ($BaseInfo === null) {
    73	            return self::TOP_BANNER_S3_DIRECTORY;
    74	        }
    75	
