   175	    #[Route('/%eccube_admin_route%/archetype/{id}/edit', name: 'admin_archetype_edit', requirements: ['id' => '\d+'], methods: ['GET', 'POST'])]
   176	    #[Template('@admin/Archetype/edit.twig')]
   177	    public function edit(Request $request, DtbArchetype $Archetype): array|RedirectResponse
   178	    {
