   206	            $this->addError('admin.common.delete_error', 'admin');
   207	
   208	            return $this->redirectToRoute('admin_archetype_edit', ['id' => $Archetype->getId()]);
   209	        }
   210	
   211	        $this->addSuccess('admin.common.delete_complete', 'admin');
   212	
   213	        $event = new EventArgs(
   214	            [
   215	                'Archetype' => $Archetype,
   216	            ],
   217	            $request
   218	        );
   219	        $this->eventDispatcher->dispatch($event, EccubeEvents::ADMIN_ARCHETYPE_DELETE_COMPLETE);
   220	
   221	        return $this->redirectToRoute('admin_archetype_list');
