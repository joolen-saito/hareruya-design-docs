   149	    public function new(Request $request): array|RedirectResponse
   150	    {
   151	        $Archetype = new DtbArchetype();
   152	        $defaultDisp = $this->entityManager->getRepository(MtbDisp::class)->find(MtbDisp::DISPLAY_SHOW);
   153	        if ($defaultDisp !== null) {
   154	            $Archetype->setDisp($defaultDisp);
   155	        }
   156	        $defaultFormat = $this->entityManager->getRepository(MtbFormat::class)
   157	            ->createQueryBuilder('f')
   158	            ->orderBy('f.rank', 'ASC')
   159	            ->addOrderBy('f.id', 'ASC')
   160	            ->setMaxResults(1)
   161	            ->getQuery()
   162	            ->getOneOrNullResult();
   163	        if ($defaultFormat !== null) {
   164	            $Archetype->setFormat($defaultFormat);
   165	        }
   166	
   167	        return $this->save($request, $Archetype, isNew: true);
   168	    }
