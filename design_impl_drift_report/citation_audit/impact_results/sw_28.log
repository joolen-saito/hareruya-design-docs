   224	    /**
   225	     * 保存処理（新規/編集共通）.
   226	     *
   227	     * @return array<string, mixed>|RedirectResponse
   228	     */
   229	    private function save(Request $request, DtbArchetype $Archetype, bool $isNew): array|RedirectResponse
   230	    {
   231	        $form = $this->createForm(ArchetypeType::class, $Archetype);
   232	
   233	        if (!$isNew && !$request->isMethod('POST') && $Archetype->getCardImage() !== null) {
   234	            $form->get('cardImageId')->setData((string) $Archetype->getCardImage()->getId());
   235	        }
   236	
   237	        $event = new EventArgs(
   238	            [
   239	                'form' => $form,
   240	                'Archetype' => $Archetype,
   241	            ],
   242	            $request
   243	        );
   244	        $this->eventDispatcher->dispatch(
   245	            $event,
   246	            $isNew ? EccubeEvents::ADMIN_ARCHETYPE_NEW_INITIALIZE : EccubeEvents::ADMIN_ARCHETYPE_EDIT_INITIALIZE
   247	        );
   248	
   249	        $form->handleRequest($request);
   250	
   251	        if ($form->isSubmitted() && $form->isValid()) {
   252	            $User = $this->getUser();
   253	            $Member = $User instanceof \Eccube\Entity\Member ? $User : null;
   254	
   255	            $cardImageRaw = $form->get('cardImageId')->getData();
   256	            $cardImageId = ($cardImageRaw !== null && $cardImageRaw !== '') ? (int) $cardImageRaw : null;
   257	
   258	            $input = new ArchetypeStoreInput($Archetype, $cardImageId, $Member);
   259	
   260	            try {
   245	            $event,
   246	            $isNew ? EccubeEvents::ADMIN_ARCHETYPE_NEW_INITIALIZE : EccubeEvents::ADMIN_ARCHETYPE_EDIT_INITIALIZE
   247	        );
   248	
   249	        $form->handleRequest($request);
   250	
   251	        if ($form->isSubmitted() && $form->isValid()) {
   252	            $User = $this->getUser();
   253	            $Member = $User instanceof \Eccube\Entity\Member ? $User : null;
   254	
   255	            $cardImageRaw = $form->get('cardImageId')->getData();
   256	            $cardImageId = ($cardImageRaw !== null && $cardImageRaw !== '') ? (int) $cardImageRaw : null;
   257	
   258	            $input = new ArchetypeStoreInput($Archetype, $cardImageId, $Member);
   259	
   260	            try {
   261	                $Saved = $this->storeAction->handle($input);
   262	
   263	                $event = new EventArgs(
   264	                    [
   265	                        'form' => $form,
   266	                        'Archetype' => $Saved,
   267	                    ],
   268	                    $request
   269	                );
   270	                $this->eventDispatcher->dispatch(
   271	                    $event,
   272	                    $isNew ? EccubeEvents::ADMIN_ARCHETYPE_NEW_COMPLETE : EccubeEvents::ADMIN_ARCHETYPE_EDIT_COMPLETE
   273	                );
   274	
   275	                $this->addSuccess('admin.common.save_complete', 'admin');
   276	
   277	                return $this->redirectToRoute('admin_archetype_edit', ['id' => $Saved->getId()]);
   278	            } catch (\RuntimeException $e) {
   279	                $this->addError($e->getMessage(), 'admin');
   280	            } catch (\Exception $e) {
   281	                log_error('アーキタイプ保存エラー', ['message' => $e->getMessage()]);
   282	                $this->addError('admin.common.save_error', 'admin');
   283	            }
   284	        }
   285	
   286	        return [
   287	            'form' => $form->createView(),
   288	            'Archetype' => $Archetype,
   289	            'isNew' => $isNew,
   290	        ];
   291	    }
