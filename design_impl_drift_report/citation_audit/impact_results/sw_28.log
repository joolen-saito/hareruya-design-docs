    54	        private readonly ArchetypeDeleteAction $deleteAction,
    55	    ) {
    56	        $this->repository = $this->archetypeRepository;
    57	        $this->sessionKey = 'archetype';
    58	        $this->formType = SearchArchetypeType::class;
    59	        $this->formName = 'admin_search_archetype';
    60	        $this->defaultOrder = 'DESC';
    61	    }
