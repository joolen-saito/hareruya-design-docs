   190	    public function delete(Request $request, DtbArchetype $Archetype): RedirectResponse
   191	    {
   192	        if (!$this->isCsrfTokenValid('admin_archetype_delete', $request->request->get('_token'))) {
   193	            $this->addError('admin.common.csrf_invalid', 'admin');
   194	
   195	            return $this->redirectToRoute('admin_archetype_list');
   196	        }
