'0307_基本設計仕様書(フロント_イベント).xlsx':{'イベント大会TOP':['D271']},
}
ns={'m':'http://schemas.openxmlformats.org/spreadsheetml/2006/main','r':'http://schemas.openxmlformats.org/officeDocument/2006/relationships','p':'http://schemas.openxmlformats.org/package/2006/relationships'}
def texts(node): return ''.join(t.text or '' for t in node.findall('.//m:t',ns))
for fn,sheets in checks.items():
  with ZipFile(base/fn) as z:
    shared=[]
    if 'xl/sharedStrings.xml' in z.namelist():
      root=ET.fromstring(z.read('xl/sharedStrings.xml')); shared=[texts(si) for si in root.findall('m:si',ns)]
    wb=ET.fromstring(z.read('xl/workbook.xml'))
    relroot=ET.fromstring(z.read('xl/_rels/workbook.xml.rels'))
    rels={e.attrib['Id']:e.attrib['Target'] for e in relroot}
    sheetpaths={s.attrib['name']:'xl/'+rels[s.attrib['{'+ns['r']+'}id']].lstrip('/') for s in wb.findall('m:sheets/m:sheet',ns)}
    print('###',fn)
    for sn,cells in sheets.items():
      root=ET.fromstring(z.read(sheetpaths[sn])); cmap={c.attrib['r']:c for c in root.findall('.//m:c',ns)}
      for ref in cells:
        c=cmap.get(ref); val=None
        if c is not None:
          typ=c.attrib.get('t'); v=c.find('m:v',ns)
          if typ=='s' and v is not None: val=shared[int(v.text)]
          elif typ=='inlineStr': val=texts(c)
          elif v is not None: val=v.text
        print(f'{sn}"'!{ref} = {val!r}'"')
