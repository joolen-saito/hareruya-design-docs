terms=['パンくず','ルール適用','大型イベント','12文字以上','エラーを最大20件','表示件数','送り状','在庫区分','ステータス','生年月日','会員ステータス','手動メール','晴れる屋','FAX番号','商品別税率','テンプレ名称','店舗種別','開店','購入処理エラー']
NS={'m':'http://schemas.openxmlformats.org/spreadsheetml/2006/main','r':'http://schemas.openxmlformats.org/officeDocument/2006/relationships','p':'http://schemas.openxmlformats.org/package/2006/relationships'}
for p in sorted(root.glob('*.xlsx')):
  if p.name[:4] not in {'0202','0207','0209','0210','0307','0308'}: continue
  print('\\n###',p.name)
  with ZipFile(p) as z:
    shared=[]
    if 'xl/sharedStrings.xml' in z.namelist():
      ss=ET.fromstring(z.read('xl/sharedStrings.xml'))
      for si in ss.findall('m:si',NS): shared.append(''.join(t.text or '' for t in si.iter('{%s}t'%NS['m'])))
    wb=ET.fromstring(z.read('xl/workbook.xml'))
    rels=ET.fromstring(z.read('xl/_rels/workbook.xml.rels'))
    relmap={x.attrib['Id']:x.attrib['Target'] for x in rels}
    sheets=[]
    for s in wb.find('m:sheets',NS):
      target=relmap[s.attrib['{%s}id'%NS['r']]]
      target='xl/'+target.lstrip('/') if not target.startswith('/') else target.lstrip('/')
      sheets.append((s.attrib['name'],target))
    for sname,target in sheets:
      hits=[]
      rootxml=ET.fromstring(z.read(target))
      for c in rootxml.iter('{%s}c'%NS['m']):
        typ=c.attrib.get('t'); v=c.find('m:v',NS)
        if typ=='inlineStr': val=''.join(t.text or '' for t in c.iter('{%s}t'%NS['m']))
        elif v is None: continue
        elif typ=='s': val=shared[int(v.text)]
        else: val=v.text or ''
        sval=str(val).replace('\\n',' / ')
        matched=[t for t in terms if t in sval]
        if matched: hits.append((c.attrib.get('r'),sval[:240],','.join(matched)))
      if hits:
        print('SHEET',sname)
        for h in hits[:40]: print(' ',h[0],h[1], '[',h[2],']')
