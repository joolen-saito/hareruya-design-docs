from zipfile import ZipFile
from xml.etree import ElementTree as ET
from pathlib import Path
p=Path('/home/y-saito/Developments/hareruya-design-docs/excel_to_html/input/0202_基本設計仕様書(在庫管理機能).xlsx')
want='在庫分割結合検索一覧(検索・結果)'
NS={'m':'http://schemas.openxmlformats.org/spreadsheetml/2006/main','r':'http://schemas.openxmlformats.org/officeDocument/2006/relationships'}
with ZipFile(p) as z:
 ss=[]
 rt=ET.fromstring(z.read('xl/sharedStrings.xml'))
 for si in rt.findall('m:si',NS): ss.append(''.join(t.text or '' for t in si.iter('{%s}t'%NS['m'])))
 wb=ET.fromstring(z.read('xl/workbook.xml')); rel=ET.fromstring(z.read('xl/_rels/workbook.xml.rels'))
 rm={x.attrib['Id']:x.attrib['Target'] for x in rel}
 s=next(x for x in wb.find('m:sheets',NS) if x.attrib['name']==want)
 target='xl/'+rm[s.attrib['{%s}id'%NS['r']]].lstrip('/')
 root=ET.fromstring(z.read(target))
 for c in root.iter('{%s}c'%NS['m']):
  ref=c.attrib.get('r',''); row=int(''.join(ch for ch in ref if ch.isdigit()) or 0)
  if not 130<=row<=150: continue
  v=c.find('m:v',NS)
  if v is None: continue
  val=ss[int(v.text)] if c.attrib.get('t')=='s' else v.text
  if val and val not in {'-'}: print(ref, str(val).replace('\\n',' / '))
