   286	    /**
   287	     * @param array<string,string> $body
   288	     */
   289	    private function assertProductUpdateOk(
   290	        string $accessToken,
   291	        string $smaregiProductId,
   292	        array $body,
   293	    ): void {
   294	        $result = $this->productApiClient->update(
   295	            $this->smaregiApiUrl,
   296	            $this->smaregiApiContractId,
   297	            $accessToken,
   298	            $smaregiProductId,
   299	            $body,
   300	        );
   301	        if (!$this->isHttpSuccess($result['statusCode'])) {
   302	            throw new \RuntimeException('スマレジ商品更新APIが失敗しました (status='.$result['statusCode'].').');
   303	        }
   304	    }
