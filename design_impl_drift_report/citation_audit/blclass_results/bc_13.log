   138	     * パスワード再設定完了画面.
   139	     *
   140	     * @return array<empty>
   141	     *
   142	     * @throws HttpException\NotFoundHttpException
   143	     */
   144	    #[Route(path: '/forgot/resetcomplete', name: 'forgot_resetcomplete', methods: ['GET'])]
   145	    #[Template(template: 'Forgot/reset_complete.twig')]
   146	    public function resetComplete(): array
   147	    {
   148	        if ($this->isGranted('IS_AUTHENTICATED_FULLY')) {
   149	            throw new HttpException\NotFoundHttpException();
   150	        }
   151	
   152	        return [];
   153	    }
   154	
   155	    /**
   156	     * パスワード再発行実行画面.
   157	     *
   158	     * @param string $reset_key
   159	     *
   160	     * @return RedirectResponse|array<string, mixed>
   161	     *
   162	     * @throws HttpException\NotFoundHttpException
   163	     */
   164	    #[Route(path: '/forgot/reset/{reset_key}', name: 'forgot_reset', methods: ['GET', 'POST'])]
   165	    #[Template(template: 'Forgot/reset.twig')]
   166	    public function reset(Request $request, $reset_key): RedirectResponse|array
   167	    {
   168	        if ($this->isGranted('IS_AUTHENTICATED_FULLY')) {
   169	            throw new HttpException\NotFoundHttpException();
   170	        }
   171	
   172	        $errors = $this->validator->validate(
   173	            $reset_key,
   174	            [
   175	                new Assert\NotBlank(),
   176	                new Assert\Regex(
   177	                    [
   178	                        'pattern' => '/^[a-zA-Z0-9]+$/',
   179	                    ]
   180	                ),
   181	            ]
   182	        );
   183	
   184	        if (count($errors) > 0) {
   185	            // リセットキーに異常がある場合
   186	            throw new HttpException\NotFoundHttpException();
   187	        }
   188	
   189	        $Customer = $this->registerCustomerViewRepository
   190	            ->getRegularCustomerByResetKey($reset_key);
   191	
   192	        if (null === $Customer) {
   193	            // リセットキーから会員データが取得できない場合
   194	            throw new HttpException\NotFoundHttpException();
   195	        }
   196	
   197	        $builder = $this->formFactory
   198	            ->createNamedBuilder('', PasswordResetType::class);
   199	
   200	        $form = $builder->getForm();
   201	        $form->handleRequest($request);
   202	        $error = null;
   203	
   204	        if ($form->isSubmitted() && $form->isValid()) {
   205	            // リセットキー・入力メールアドレスで会員情報検索
   206	            $Customer = $this->registerCustomerViewRepository
   207	                ->getRegularCustomerByResetKey($reset_key, $form->get('login_email')->getData());
   208	            if ($Customer) {
   209	                // パスワードの発行・更新
   210	                $password = $this->passwordHasher->hashPassword($Customer, $form->get('password')->getData());
   211	
   212	                $this->entityManager->getConnection()->executeQuery(
   213	                    'UPDATE registration_view SET password = :password, reset_key = :reset_key WHERE secret_key = :secret_key',
   214	                    [
   215	                        'password' => $password,
   216	                        'secret_key' => $Customer->getSecretKey(),
   217	                        'reset_key' => null,
   218	                    ]
   219	                );
   220	
   221	                $event = new EventArgs(
   222	                    [
   223	                        'Customer' => $Customer,
   224	                    ],
   225	                    $request
   226	                );
   227	                $this->eventDispatcher->dispatch($event, EccubeEvents::FRONT_FORGOT_RESET_COMPLETE);
   228	
   229	                return $this->redirectToRoute('forgot_resetcomplete');
   230	            } else {
   231	                // リセットキー・メールアドレスから会員データが取得できない場合
   232	                $error = trans('front.forgot.reset_not_found');
   233	            }
   234	        }
   235	
   236	        return [
   237	            'error' => $error,
   238	            'form' => $form->createView(),
   239	        ];
   240	    }
   241	}
