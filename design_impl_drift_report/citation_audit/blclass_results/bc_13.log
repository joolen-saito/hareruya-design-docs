    35	    public function dispatchUpsert(ProductClass $productClass): void
    36	    {
    37	        if (!$productClass->getSmaregiAlignmentFlg()) {
    38	            return;
    39	        }
    40	
    41	        $smaregiProductCode = $productClass->getSmaregiProductCode();
    42	        if ($smaregiProductCode === null || trim($smaregiProductCode) === '') {
    43	            return;
    44	        }
    45	
    46	        $id = $productClass->getId();
    47	        if ($id === null) {
    48	            return;
    49	        }
    50	
    51	        $job = new MessengerJob();
    52	        $job->setMessageClass(SmaregiProductClassUpsertMessage::class);
    53	        $job->setStatus(MessengerJob::STATUS_PENDING);
    54	        $job->setPayloadSummary(sprintf(
    55	            'productClassId=%d productId=%s smaregiProductId=%s',
    56	            $id,
    57	            (string) ($productClass->getProduct()?->getId() ?? ''),
    58	            (string) ($productClass->getSmaregiProductId() ?? ''),
    59	        ));
    60	        $this->entityManager->persist($job);
    61	        $this->entityManager->flush();
    62	
    63	        try {
    64	            $this->messageBus->dispatch(new SmaregiProductClassUpsertMessage(
    65	                $id,
    66	                (int) $job->getId(),
    67	            ));
    68	        } catch (\Throwable $e) {
    69	            try {
    70	                $job->setStatus(MessengerJob::STATUS_FAILED);
    71	                $job->setCompletedAt(new \DateTime());
    72	                $job->setErrorMessage('メッセージバスへの投入に失敗しました: '.$e->getMessage());
    73	                $this->entityManager->flush();
    74	            } catch (\Throwable $persistError) {
    75	                $this->logger->error('Failed to persist Smaregi product class upsert job failure state', [
    76	                    'jobId' => $job->getId(),
    77	                    'productClassId' => $id,
    78	                    'error' => $persistError->getMessage(),
    79	                ]);
    80	            }
    81	            $this->logger->error('Smaregi product class upsert message dispatch failed', [
    82	                'exception' => $e,
    83	                'jobId' => $job->getId(),
    84	                'productClassId' => $id,
    85	            ]);
    86	
    87	            throw $e;
    88	        }
    89	    }
