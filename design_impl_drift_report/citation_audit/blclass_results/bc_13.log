    95	    public function registerDeleteJob(int $productClassId, int $productId, string $smaregiProductId): MessengerJob
    96	    {
    97	        $job = new MessengerJob();
    98	        $job->setMessageClass(SmaregiProductClassDeleteMessage::class);
    99	        $job->setStatus(MessengerJob::STATUS_PENDING);
   100	        $job->setPayloadSummary(sprintf(
   101	            'productClassId=%d productId=%d smaregiProductId=%s',
   102	            $productClassId,
   103	            $productId,
   104	            $smaregiProductId,
   105	        ));
   106	        $this->entityManager->persist($job);
   107	
   108	        return $job;
   109	    }
   110	
   111	    /**
   112	     * registerDeleteJob の flush / commit 成功後にのみ呼ぶ。
   113	     * メッセージバス投入に失敗しても例外は投げず、ジョブを FAILED にしてログする（EC 側処理は既に確定している想定）。
   114	     * FAILED 更新時の {@see EntityManagerInterface::flush()} が失敗しても例外は伝播させない.
   115	     */
   116	    public function dispatchDeleteMessage(MessengerJob $job, int $productClassId, int $productId, string $smaregiProductId): void
   117	    {
   118	        $jobId = (int) $job->getId();
   119	        if ($jobId < 1) {
   120	            $this->logger->error('Smaregi delete job has no id; cannot dispatch message bus.', [
   121	                'productClassId' => $productClassId,
   122	                'productId' => $productId,
   123	            ]);
   124	
   125	            return;
   126	        }
   127	
   128	        try {
   129	            $this->messageBus->dispatch(new SmaregiProductClassDeleteMessage(
   130	                $productClassId,
   131	                $productId,
   132	                $smaregiProductId,
   133	                $jobId,
   134	            ));
   135	        } catch (\Throwable $e) {
   136	            try {
   137	                $managed = $this->entityManager->find(MessengerJob::class, $jobId);
   138	                if ($managed instanceof MessengerJob) {
   139	                    $managed->setStatus(MessengerJob::STATUS_FAILED);
   140	                    $managed->setCompletedAt(new \DateTime());
   141	                    $managed->setErrorMessage('メッセージバスへの投入に失敗しました: '.$e->getMessage());
   142	                    $this->entityManager->flush();
   143	                }
   144	            } catch (\Throwable $persistError) {
   145	                $this->logger->error('Failed to persist Smaregi delete job failure state', [
   146	                    'jobId' => $jobId,
   147	                    'productClassId' => $productClassId,
   148	                    'productId' => $productId,
   149	                    'error' => $persistError->getMessage(),
   150	                ]);
   151	            }
   152	            $this->logger->error('Smaregi product class delete message dispatch failed', [
   153	                'exception' => $e,
   154	                'jobId' => $jobId,
   155	                'productClassId' => $productClassId,
   156	                'productId' => $productId,
   157	            ]);
   158	        }
   159	    }
