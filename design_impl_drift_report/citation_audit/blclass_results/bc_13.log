    39	    public function reset(): void
    40	    {
    41	        $this->deferredProductClassIds = [];
    42	    }
    43	
    44	    /**
    45	     * 行処理時に呼ぶ。連携ONかつスマレジ商品コードが空でない場合のみバッファする。
    46	     */
    47	    public function deferIfEligible(int $productClassId, int $smaregiAlignmentFlg, ?string $smaregiProductCode): void
    48	    {
    49	        if ($smaregiAlignmentFlg !== Constant::ENABLED) {
    50	            return;
    51	        }
    52	        if ($smaregiProductCode === null || trim($smaregiProductCode) === '') {
    53	            return;
    54	        }
    55	        $this->deferredProductClassIds[$productClassId] = true;
    56	    }
    57	
    58	    /**
    59	     * {@see \Eccube\Service\Csv\Importer\CsvImporter} によるコミット後、{@see AfterReadEvent::isSuccessful} に応じて投入またはバッファ破棄。
    60	     *
    61	     * 投入に失敗した場合はログの後に {@see \RuntimeException} を送出し、CSV 取込処理側で失敗として扱えるようにする。
    62	     *
    63	     * @throws \RuntimeException 連携タスクの投入が1件以上失敗した場合（原因は previous に保持）
    64	     */
    65	    public function afterCsvImportFinished(bool $importSuccessful): void
    66	    {
    67	        if (!$importSuccessful) {
    68	            $this->deferredProductClassIds = [];
    69	
    70	            return;
    71	        }
    72	
    73	        $dispatchFailed = false;
    74	        $firstFailure = null;
    75	
    76	        try {
    77	            foreach (array_keys($this->deferredProductClassIds) as $productClassId) {
    78	                $ProductClass = $this->productClassRepository->find($productClassId);
    79	                if ($ProductClass === null) {
    80	                    continue;
    81	                }
    82	                if (!$ProductClass->getSmaregiAlignmentFlg()) {
    83	                    continue;
    84	                }
    85	                $code = $ProductClass->getSmaregiProductCode();
    86	                if ($code === null || trim($code) === '') {
    87	                    continue;
    88	                }
    89	                try {
    90	                    $this->smaregiProductClassEventService->dispatchUpsert($ProductClass);
    91	                } catch (\Throwable $e) {
    92	                    $dispatchFailed = true;
    93	                    $firstFailure ??= $e;
    94	                    log_error('スマレジ連携タスクの投入に失敗しました（'.$this->logContextLabel.'）。', [
    95	                        'product_class_id' => $productClassId,
    96	                        'message' => $e->getMessage(),
    97	                        'file' => $e->getFile(),
    98	                        'line' => $e->getLine(),
    99	                    ]);
   100	                }
   101	            }
   102	        } finally {
   103	            $this->deferredProductClassIds = [];
   104	        }
   105	
   106	        if ($dispatchFailed) {
   107	            throw new \RuntimeException('スマレジ連携タスクの投入に失敗しました（'.$this->logContextLabel.'）。', 0, $firstFailure);
   108	        }
   109	    }
   110	}
