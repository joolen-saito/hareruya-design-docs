    36	                const message = '本人確認用情報に変更があるため本人確認ステータスを未確認に変更します。よろしいですか？\n本人確認用情報：お名前、お名前(フリガナ)、住所、生年月日';
    37	                const identityConfirmStatusUnconfirmed = '{{ constant("Eccube\\Entity\\Master\\MtbIdentityConfirmStatus::STATUS_UNCONFIRMED") }}';
    38	                if (isIdentificationChanged()) {
    39	                    if (window.confirm(message)) {
    40	                        $(`input[name="admin_customer[Player][IdentityConfirmStatus]"][value="${identityConfirmStatusUnconfirmed}"]`).prop('checked', true);
    41	                    } else {
    42	                        return;
    43	                    }
    44	                }
    45	                $('#customer_form').submit();
    46	            });
    47	            // 本人確認用情報に変更があればtrueを返す
    48	            function isIdentificationChanged() {
    49	                // 本人ステータスが「簡易書留確認済み」もしくは「確認済み」の場合、住所情報が変更されたら変更あり
    50	                const identityConfirmStatusConfirmed = '{{ constant("Eccube\\Entity\\Master\\MtbIdentityConfirmStatus::STATUS_CONFIRMED") }}';
    51	                const identityConfirmStatusMailConfirmed = '{{ constant("Eccube\\Entity\\Master\\MtbIdentityConfirmStatus::STATUS_REGISTERED_MAIL_CONFIRMED") }}';
    52	
    53	                if (
    54	                    ('{{ form.Player.IdentityConfirmStatus.vars.value }}' === identityConfirmStatusConfirmed || '{{ form.Player.IdentityConfirmStatus.vars.value }}' === identityConfirmStatusMailConfirmed)
    55	                    &&
    56	                    (
    57	                        $('#admin_customer_country').val() !== '{{ form.country.vars.value|e('js') }}'
    58	                        || $('#admin_customer_postalCode_postalCode01').val() !== '{{ form.postalCode.postalCode01.vars.value|e('js') }}'
    59	                        || $('#admin_customer_postalCode_postalCode02').val() !== '{{ form.postalCode.postalCode02.vars.value|e('js') }}'
    60	                        || $('#admin_customer_abroadPostalCode').val() !== '{{ form.abroadPostalCode.vars.value|e('js') }}'
    61	                        || $('#admin_customer_address_pref').val() !== '{{ form.address.pref.vars.value|e('js') }}'
    62	                        || $('#admin_customer_address_addr01').val() !== '{{ form.address.addr01.vars.value|e('js') }}'
    63	                        || $('#admin_customer_address_addr02').val() !== '{{ form.address.addr02.vars.value|e('js') }}'
    64	                        || $('#admin_customer_address_addr03').val() !== '{{ form.address.addr03.vars.value|e('js') }}'
    65	                    )
    66	                ) {
    67	                    return true;
    68	                }
    69	
    70	                // 本人ステータスが「確認済み」の場合、名前・誕生日が変更されていたらtrue
    71	                return ('{{ form.Player.IdentityConfirmStatus.vars.value }}' === identityConfirmStatusConfirmed)
    72	                    &&
    73	                    (
    74	                        $('#admin_customer_name_name01').val() !== '{{ form.name.name01.vars.value|e('js') }}'
    75	                        || $('#admin_customer_name_name02').val() !== '{{ form.name.name02.vars.value|e('js') }}'
    76	                        || $('#admin_customer_kana_kana01').val() !== '{{ form.kana.kana01.vars.value|e('js') }}'
    77	                        || $('#admin_customer_kana_kana02').val() !== '{{ form.kana.kana02.vars.value|e('js') }}'
    78	                        || $('#admin_customer_birth').val() !== '{{ form.birth.vars.value|e('js') }}'
    79	                    );
    80	            }
    81	
    82	            $('#submit_confirm').click(function(event) {
    83	                event.preventDefault();
    84	                let form = $('<form>', {
    85	                    'method': 'POST',
    86	                    'action': $(this).attr('href')
    87	                });
    88	                form.append($('<input>', {
    89	                    'type': 'hidden',
    90	                    'name': 'id_expiration_date',
    91	                    'value': $('input[name="admin_customer[Player][id_expiration_date]"]').val()
    92	                }));
    93	                $('body').append(form);
    94	                form.submit();
    95	            });
    96	        });
    97	    </script>
