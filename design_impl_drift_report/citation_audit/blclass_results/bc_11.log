    48	    public function getQueryBuilderBySearchData(array $searchData): QueryBuilder
    49	    {
    50	        $qb = $this->createQueryBuilder('s')
    51	            ->select('s')
    52	            ->leftJoin('s.MoveFromBaseInfo', 'fromBase')->addSelect('fromBase')
    53	            ->leftJoin('s.MoveToBaseInfo', 'toBase')->addSelect('toBase')
    54	            ->leftJoin('s.MoveTransferStatus', 'st')->addSelect('st')
    55	            ->leftJoin('s.RegisteredMember', 'reg')->addSelect('reg')
    56	            ->orderBy('s.createDate', 'DESC')
    57	            ->addOrderBy('s.id', 'DESC');
    58	
    59	        $stockMoveTransferId = isset($searchData['stock_move_transfer_id']) ? trim((string) $searchData['stock_move_transfer_id']) : '';
    60	        if ($stockMoveTransferId !== '') {
    61	            if (ctype_digit($stockMoveTransferId)) {
    62	                $qb->andWhere('s.id = :smt_id_exact')
    63	                    ->setParameter('smt_id_exact', (int) $stockMoveTransferId);
    64	            } else {
    65	                $qb->andWhere('CONCAT(s.id, \'\') LIKE :smt_id_like')
    66	                    ->setParameter('smt_id_like', '%'.addcslashes($stockMoveTransferId, '%_').'%');
    67	            }
    68	        }
    69	
    70	        $moveInstructionId = isset($searchData['move_instruction_id']) ? trim((string) $searchData['move_instruction_id']) : '';
