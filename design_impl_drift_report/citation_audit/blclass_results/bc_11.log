/bin/bash -lc "python3 - <<'PY'
from zipfile import ZipFile
from xml.etree import ElementTree as ET
from pathlib import Path
from posixpath import normpath, join, dirname
NS={'m':'http://schemas.openxmlformats.org/spreadsheetml/2006/main','r':'http://schemas.openxmlformats.org/officeDocument/2006/relationships','p':'http://schemas.openxmlformats.org/package/2006/relationships'}
base=Path('hareruya-design-docs/excel_to_html/input')
books=['0307_基本設計仕様書(フロント_イベント).xlsx','0202_基本設計仕様書(在庫管理機能).xlsx','0207_基本設計仕様書(会員管理機能).xlsx','0209_基本設計仕様書(基本情報設定).xlsx']
terms={books[0]:['イベント規模','次の1ヶ月','現在日を含む','10日間','日付選択(4-23)','別日程の同イベント','受付期間'],books[1]:['99999999','結合計画承認済み','10,000件','1ページ20件','移動総原価','備考情報の内容の登録','最も高い価格','在庫移動振替IDを降順'],books[2]:['身分証有効期限を空欄','処理日降順','支払方法設定に登録されている支払方法をすべて'],books[3]:['登録されているCSV全種','在庫移動・振替CSV','商品CSV 受注CSV 配送CSV']}
def texts(el): return ''.join((t.text or '') for t in el.findall('.//m:t',NS))
for fn in books:
  print('\\n###',fn)
  with ZipFile(base/fn) as z:
    shared=[]
    if 'xl/sharedStrings.xml' in z.namelist():
      root=ET.fromstring(z.read('xl/sharedStrings.xml'))
      shared=[texts(si) for si in root.findall('m:si',NS)]
    wb=ET.fromstring(z.read('xl/workbook.xml'))
    relroot=ET.fromstring(z.read('xl/_rels/workbook.xml.rels'))
    rels={e.attrib['Id']:e.attrib['Target'] for e in relroot.findall('p:Relationship',NS)}
    sheets=[]
    for s in wb.findall('m:sheets/m:sheet',NS):
      target=rels[s.attrib['{'+NS['r']+'}id']]
      path=normpath(join('xl',target)) if not target.startswith('/') else target.lstrip('/')
      sheets.append((s.attrib['name'],path))
    print('sheets:', ' / '.join(n for n,_ in sheets))
    hits={t:[] for t in terms[fn]}
    for sn,path in sheets:
      root=ET.fromstring(z.read(path))
      for c in root.findall('.//m:c',NS):
        typ=c.attrib.get('t'); val=''
        if typ=='inlineStr': val=texts(c)
        else:
          v=c.find('m:v',NS)
          if v is not None and v.text is not None:
            if typ=='s':
              try: val=shared[int(v.text)]
              except: val=''
            else: val=v.text
        for term in hits:
          if term in val:
            hits[term].append(f'{sn}"'!{c.attrib.get("r")}={val[:300].replace(chr(10)," / ")}'"')
    for term, rows in hits.items():
      print('TERM',term,'HITS',len(rows))
      for h in rows[:12]: print(' ',h)
