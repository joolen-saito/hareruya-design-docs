    if typ=='s' and v is not None: val=ss[int(v.text)]
    elif typ=='inlineStr': val=text(c)
    elif v is not None: val=v.text or ''
    if any(t in val for t in terms): hits.append((c.attrib.get('r'),val.replace('\\n',' / ')[:500]))
