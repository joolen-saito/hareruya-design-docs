            "\u65e2\u5b58\u306e\u898b\u7a4d\u6839\u62e0": "\u627f\u8a8d\u7533\u8acb\u6642\u306b\u6309\u5206\u984d\u3092\u8a08\u7b97\u30fb\u4fdd\u5b58\u3057\u3066\u627f\u8a8d\u6642\u306f\u305d\u306e\u30b9\u30ca\u30c3\u30d7\u30b7\u30e7\u30c3\u30c8\u3092\u4f7f\u3046\u5909\u66f4\u3068\u3001\u7aef\u6570\u5148\u3092\u8cb7\u53d6\u5c0f\u8a08\u6700\u5927\u304b\u3089\u8cb7\u53d6\u5358\u4fa1\u6700\u5927\u3078\u5909\u3048\u308b2\u4ef6\u3002\u65b0\u898f\u6c38\u7d9a\u9805\u76ee\u3001EntityManager\u3001\u7533\u8acb\u30fb\u627f\u8a8d\u30b5\u30fc\u30d3\u30b9\u3092\u6a2a\u65ad\u3059\u308b\u91d1\u984d\u30ed\u30b8\u30c3\u30af\u6539\u4fee\u3002",
            "\u672c\u6587": "# \u57fa\u672c\u60c5\u5831\u3010\u5fc5\u9808\u3011 \u5206\u985e\uff1a\u5728\u5eab\u7ba1\u7406 \u6a5f\u80fd\uff1a\u5728\u5eab\u5206\u5272 \u767b\u9332\u7de8\u96c6 \u8ab2\u984c\u30ab\u30c6\u30b4\u30ea\uff1a\u4e0d\u5177\u5408\uff08\u30d0\u30b0\uff09 \u8ab2\u984c\uff1a\u3010\u5b9f\u88c5\u4e56\u96e2\u3011\u5728\u5eab\u7ba1\u7406_\u5728\u5eab\u5206\u5272 \u767b\u9332\u7de8\u96c6_\u5728\u5eab\u5206\u5272 \u767b\u9332\u7de8\u96c6\u306b\u3066\u3001\u5206\u5272\u5148\u5546\u54c1\u306e\u4ed5\u5165\u7dcf\u4fa1\u683c\uff08\u8cb7\u53d6\u91d1\u984d\u6bd4\u7387\u3067\u306e\u6309\u5206\uff09\u304c\u627f\u8a8d\u7533\u8acb\u6642\u3067\u306f\u306a\u304f\u627f\u8a8d\u6642\u306b\u8a08\u7b97\u3055\u308c\u3001\u5206\u5272\u5148\u5546\u54c1\u60c5\u5831\u306b\u4fdd\u5b58\u3055\u308c\u306a\u3044 \u8a2d\u8a08\u66f8\uff1a0202_\u57fa\u672c\u8a2d\u8a08\u4ed5\u69d8\u66f8(\u5728\u5eab\u7ba1\u7406\u6a5f\u80fd).xlsx # \u671f\u5f85\u3055\u308c\u308b\u6319\u52d5\u3010\u5fc5\u9808\u3011 - \u627f\u8a8d\u7533\u8acb\u6642\u306b\u3001\u57fa\u672c\u60c5\u5831\u306e\u66f4\u65b0\u30fb\u5206\u5272\u5148\u5546\u54c1\u306e\u4ed5\u5165\u7dcf\u4fa1\u683c\u306e\u8a08\u7b97\u30fb\u30b9\u30c6\u30fc\u30bf\u30b9\u5909\u66f4\u5c65\u6b74\u306e\u66f4\u65b0\u30fb\u627f\u8a8d\u901a\u77e5\u5148\u3078\u306e\u30e1\u30fc\u30eb\u9001\u4fe1\u3092\u884c\u3044\u3001\u8a08\u7b97\u3057\u305f\u4ed5\u5165\u7dcf\u4fa1\u683c\u3092\u5206\u5272\u5148\u5546\u54c1\u60c5\u5831\u306b\u767b\u9332\u3059\u308b\u3053\u3068\uff08\u5206\u5272\u5148\u304c\u78ba\u5b9a\uff1d\u7de8\u96c6\u4e0d\u53ef\u3068\u306a\u308b\u627f\u8a8d\u7533\u8acb\u6642\u306b\u8a08\u7b97\u3059\u308b\uff09\u3002 - \u5206\u5272\u5148\u5546\u54c1\u306e\u4ed5\u5165\u7dcf\u4fa1\u683c\u306f\u5206\u5272\u5148\u5546\u54c1\u306e\u8cb7\u53d6\u91d1\u984d\u6bd4\u7387\u3067\u6309\u5206\u3057\u3001\u5408\u8a08\u304c\u5206\u5272\u5143\u5546\u54c1\u306e\u79fb\u52d5\u7dcf\u539f\u4fa1\u3068\u4e00\u81f4\u3057\u306a\u3044\u5834\u5408\u306f\u7aef\u6570\u5206\u3092\u300c\u6700\u3082\u8cb7\u53d6\u91d1\u984d\uff08\u5358\u4fa1\uff09\u304c\u9ad8\u3044\u5206\u5272\u5148\u5546\u54c1\u300d\u306b\u5272\u308a\u5f53\u3066\u308b\u3053\u3068\u3002 # \u73fe\u5728\u306e\u6319\u52d5\u3010\u5fc5\u9808\u3011 - \u627f\u8a8d\u7533\u8acb\uff08StockSplitApplyApprovalAction\uff09\u306f\u3001\u5206\u5272\u5148\u660e\u7d30\u306e\u4f5c\u6210\u30fb\u30b9\u30c6\u30fc\u30bf\u30b9\u306e\u5206\u5272\u627f\u8a8d\u5f85\u3061\u3078\u306e\u5909\u66f4\u30fb\u627f\u8a8d\u7533\u8acb\u4e00\u89a7\u3078\u306e\u767b\u9332\u306e\u307f\u3092\u884c\u3044\u3001\u4ed5\u5165\u7dcf\u4fa1\u683c\u306e\u6309\u5206\u8a08\u7b97\u306f\u4e00\u5207\u884c\u3063\u3066\u3044\u306a\u3044\u3002 - \u5206\u5272\u5148\u660e\u7d30\uff08DtbStockSplitJoinDetail\uff09\u306b\u306f\u4ed5\u5165\u7dcf\u4fa1\u683c\u3092\u4fdd\u6301\u3059\u308b\u30ab\u30e9\u30e0\u81ea\u4f53\u304c\u7121\u304f\uff08standardPrice / costPrice / totalCost / stock / splitJoinQuantity / missingQuantity \u306e\u307f\uff09\u3001\u627f\u8a8d\u7533\u8acb\u6642\u70b9\u306e\u4ed5\u5165\u7dcf\u4fa1\u683c\u306f\u4fdd\u5b58\u3055\u308c\u306a\u3044\u3002 - \u8cb7\u53d6\u91d1\u984d\u6bd4\u7387\u3067\u306e\u6309\u5206\u3068\u7aef\u6570\u8abf\u6574\u306f\u627f\u8a8d\u51e6\u7406\uff08StockSplitApprovalApproveAction\uff09\u3067\u90fd\u5ea6\u8a08\u7b97\u3055\u308c\u3066\u304a\u308a\u3001\u627f\u8a8d\u6642\u70b9\u306e\u8cb7\u53d6\u4fa1\u683c\u30fb\u5206\u5272\u5143\u7dcf\u539f\u4fa1\u3067\u8a08\u7b97\u3055\u308c\u308b\u305f\u3081\u3001\u7533\u8acb\u6642\u304b\u3089\u5024\u304c\u5909\u52d5\u3057\u305f\u5834\u5408\u306b\u8a2d\u8a08\u3068\u7570\u306a\u308b\u91d1\u984d\u306b\u306a\u308b\u3002 - \u7aef\u6570\u306e\u5272\u5f53\u5148\u306f\u300c\u8cb7\u53d6\u4fa1\u683c\u00d7\u6570\u91cf\uff08\u8cb7\u53d6\u91d1\u984d\u5c0f\u8a08\uff09\u304c\u6700\u5927\u306e\u5206\u5272\u5148\u300d\u3067\u3042\u308a\u3001\u8a2d\u8a08\u306e\u300c\u6700\u3082\u8cb7\u53d6\u91d1\u984d\uff08\u5358\u4fa1\uff09\u304c\u9ad8\u3044\u5206\u5272\u5148\u5546\u54c1\u300d\u3068\u306f\u3001\u5358\u4fa1\u306f\u4f4e\u3044\u304c\u6570\u91cf\u304c\u591a\u3044\u5546\u54c1\u304c\u5b58\u5728\u3059\u308b\u30b1\u30fc\u30b9\u3067\u4e00\u81f4\u3057\u306a\u3044\u3002 - \u627f\u8a8d\u901a\u77e5\u5148\uff08\u30e1\u30f3\u30d0\u30fc\uff09\u306e\u5fc5\u9808\u30c1\u30a7\u30c3\u30af\u3068\u627f\u8a8d\u901a\u77e5\u30e1\u30fc\u30eb\u9001\u4fe1\u3001\u30b9\u30c6\u30fc\u30bf\u30b9\u306e\u5206\u5272\u627f\u8a8d\u5f85\u3061\u3078\u306e\u9077\u79fb\u306f\u5b9f\u88c5\u3055\u308c\u3066\u3044\u308b\u3002 # \u88dc\u8db3\u60c5\u5831\u3010\u4efb\u610f\u3011 \u25bc\u8a2d\u8a08\u66f8\u8a72\u5f53\u7b87\u6240 M04_stock_management_basedesign.md:2176 \u306e\u9010\u8a9e\u5f15\u7528\u300c6-5.\u627f\u8a8d\u7533\u8acb\u6642\u3001\u57fa\u672c\u60c5\u5831\u306e\u66f4\u65b0\u3068\u3001\u5206\u5272\u5148\u5546\u54c1\u306e\u4ed5\u5165\u7dcf\u4fa1\u683c\u306e\u8a08\u7b97\u3001\u30b9\u30c6\u30fc\u30bf\u30b9\u5909\u66f4\u5c65\u6b74\u306e\u66f4\u65b0\u3001\u627f\u8a8d\u901a\u77e5\u5148\u3078\u306e\u30e1\u30fc\u30eb\u9001\u4fe1\u3092\u884c\u3046\u300d M04_stock_management_basedesign.md:2183 \u306e\u9010\u8a9e\u5f15\u7528\u300c6-7.\u5206\u5272\u5148\u5546\u54c1\u306e\u4ed5\u5165\u7dcf\u4fa1\u683c\uff081\u5546\u54c1\u306b\u3064\u3044\u3066\u6570\u91cf\u5206\u306e\u4ed5\u5165\u4fa1\u683c\uff09\u3092\u8a08\u7b97\u3057\u3001\u5206\u5272\u5148\u5546\u54c1\u60c5\u5831\u306b\u767b\u9332\u3059\u308b\u300d M04_stock_management_basedesign.md:5050-5052 \u306e\u9010\u8a9e\u5f15\u7528\u300c* \u5206\u5272\u306f\u3001\u5206\u5272\u5148\u306e\u5546\u54c1\u306e\u8cb7\u53d6\u91d1\u984d\u6bd4\u7387\u3067\u6309\u5206\u3092\u884c\u3044\u4ed5\u5165\u7dcf\u4fa1\u683c\u3068\u3059\u308b / * \u5206\u5272\u5148\u5546\u54c1\u306e\u4ed5\u5165\u7dcf\u4fa1\u683c\u306e\u5408\u8a08\uff1d\u5206\u5272\u5143\u5546\u54c1\u306e\u79fb\u52d5\u7dcf\u4fa1\u683c\u3068\u306a\u3089\u306a\u3044\u5834\u5408\u306f / \u7aef\u6570\u5206\u3092\u6700\u3082\u8cb7\u53d6\u91d1\u984d\uff08\u5358\u4fa1\uff09\u304c\u9ad8\u3044\u5206\u5272\u5148\u5546\u54