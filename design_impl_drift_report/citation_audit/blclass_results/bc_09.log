   266	    /**
   267	     * @param array<int, array<int, array{count: int, cardId: int, name: string, row: int}>> $boardCardLists
   268	     *
   269	     * @return array<int, list<string>>
   270	     */
   271	    private function validateBoardCounts(DtbDeck $Deck, array $boardCardLists): array
   272	    {
   273	        $Format = $Deck->getFormat();
   274	        if ($Format === null) {
   275	            return [];
   276	        }
   277	
   278	        $totals = [];
   279	        foreach ($boardCardLists as $boardId => $cards) {
   280	            $totals[$boardId] = array_sum(array_column($cards, 'count'));
   281	        }
   282	
   283	        $mainCount = $totals[MtbBoard::BOARD_ID_MAIN] ?? 0;
   284	        $sideCount = $totals[MtbBoard::BOARD_ID_SIDE] ?? 0;
   285	        $commandCount = $totals[MtbBoard::BOARD_ID_COMMAND] ?? 0;
   286	
   287	        if ($Format->isCommanderInMain()) {
   288	            $mainCount += $commandCount;
   289	        }
   290	
   291	        $warningsByBoard = [
   292	            MtbBoard::BOARD_ID_MAIN => $this->checkBoardRange(
   293	                $mainCount,
   294	                $Format->getMainMaxCardCount(),
   295	                $Format->getMainMinCardCount(),
   296	            ),
   297	            MtbBoard::BOARD_ID_SIDE => $this->checkBoardRange(
   298	                $sideCount,
   299	                $Format->getSideMaxCardCount(),
   300	                $Format->getSideMinCardCount(),
   301	            ),
   302	            MtbBoard::BOARD_ID_COMMAND => [],
   303	        ];
   304	
   305	        $CommandFormatBoard = $Format->getFormatBoardByBoardId(MtbBoard::BOARD_ID_COMMAND);
   306	        if ($CommandFormatBoard === null) {
   307	            if ($commandCount > 0) {
   308	                $warningsByBoard[MtbBoard::BOARD_ID_COMMAND][] = trans('admin.deck.validation.no_command');
   309	            }
   310	        } else {
   311	            $warningsByBoard[MtbBoard::BOARD_ID_COMMAND] = $this->checkBoardRange(
   312	                $commandCount,
   313	                $CommandFormatBoard->getMaxCardCount(),
   314	                $CommandFormatBoard->getMinCardCount(),
   315	            );
   316	        }
   317	
   318	        return $warningsByBoard;
   319	    }
   320	
   321	    /**
   322	     * @return list<string>
   323	     */
   324	    private function checkBoardRange(int $count, ?int $max, ?int $min): array
   325	    {
   326	        $warnings = [];
   327	        if ($max !== null && $count > $max) {
   328	            $warnings[] = trans('admin.deck.validation.too_many', ['%count%' => $max]);
   329	        } elseif ($min !== null && $count < $min) {
   330	            $warnings[] = trans('admin.deck.validation.too_few', ['%count%' => $min]);
   331	        }
   332	
   333	        return $warnings;
   334	    }
   335	}
