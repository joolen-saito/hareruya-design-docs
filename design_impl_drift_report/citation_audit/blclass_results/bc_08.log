    48	    public function __construct(
    49	        private readonly ClientInterface $httpClient,
    50	        private readonly CacheItemPoolInterface $cache,
    51	        private readonly LoggerInterface $logger,
    52	        private readonly SmaregiPlatformApiCallRecorder $platformApiCallRecorder,
    53	    ) {
    54	    }
    55	
    56	    public function getAccessToken(
    57	        string $idUrl,
    58	        string $contractId,
    59	        string $clientId,
    60	        string $clientSecret,
    61	    ): string {
    62	        $cacheKey = self::CACHE_KEY_PREFIX.$contractId;
    63	        $cacheItem = $this->cache->getItem($cacheKey);
    64	        if ($cacheItem->isHit()) {
    65	            $cached = $cacheItem->get();
    66	            if (is_array($cached) && isset($cached['token']) && is_string($cached['token'])) {
    67	                return $cached['token'];
    68	            }
    69	        }
    70	
    71	        $url = sprintf('%s/app/%s/token', rtrim($idUrl, '/'), $contractId);
    72	        $bodyParams = [
    73	            'grant_type' => 'client_credentials',
    74	            'scope' => implode(' ', self::SCOPES),
    75	        ];
    76	
    77	        $headersForLog = [
    78	            'Content-Type' => 'application/x-www-form-urlencoded',
    79	            'Authorization' => 'Basic '.base64_encode($clientId.':'.$clientSecret),
    80	        ];
    81	        $requestBodyStr = http_build_query($bodyParams);
    82	
    83	        $started = hrtime(true);
    84	        $statusCode = null;
    85	        $raw = '';
    86	        /** @var array<string, array<string>> $responseHeaders */
    87	        $responseHeaders = [];
    88	
    89	        try {
    90	            $response = $this->httpClient->request('POST', $url, [
    91	                'auth' => [$clientId, $clientSecret],
    92	                'headers' => [
    93	                    'Content-Type' => 'application/x-www-form-urlencoded',
    94	                ],
    95	                'form_params' => $bodyParams,
    96	                'http_errors' => false,
    97	            ]);
    98	            $statusCode = $response->getStatusCode();
    99	            $raw = (string) $response->getBody();
   100	            $responseHeaders = $response->getHeaders();
   101	        } catch (\Throwable $e) {
   102	            $durationMs = (int) ((hrtime(true) - $started) / 1_000_000);
   103	            $this->platformApiCallRecorder->record(
   104	                SmaregiPlatformApiCallLog::OPERATION_ACCESS_TOKEN,
   105	                'POST',
   106	                $url,
   107	                $headersForLog,
   108	                $requestBodyStr,
   109	                null,
   110	                [],
   111	                '',
   112	                $durationMs,
   113	                $e->getMessage(),
   114	            );
   115	            throw $e;
   116	        }
   117	
   118	        $durationMs = (int) ((hrtime(true) - $started) / 1_000_000);
   119	        $this->platformApiCallRecorder->record(
   120	            SmaregiPlatformApiCallLog::OPERATION_ACCESS_TOKEN,
   121	            'POST',
   122	            $url,
   123	            $headersForLog,
   124	            $requestBodyStr,
   125	            $statusCode,
   126	            $responseHeaders,
   127	            $raw,
   128	            $durationMs,
   129	            null,
   130	        );
   131	
   132	        if ($statusCode !== 200) {
   133	            $this->logger->error('Smaregi access token request failed', [
   134	                'statusCode' => $statusCode,
   135	                'url' => $url,
   136	                'response' => $raw,
   137	            ]);
   138	            throw new \RuntimeException('スマレジアクセストークンの取得に失敗しました (status='.$statusCode.').');
   139	        }
   140	
   141	        $data = json_decode($raw, true);
   142	        if (!is_array($data) || !isset($data['access_token']) || !is_string($data['access_token'])) {
   143	            $this->logger->error('Smaregi access token response invalid', [
   144	                'url' => $url,
   145	                'response' => $raw,
   146	            ]);
   147	            throw new \RuntimeException('スマレジアクセストークン応答の解析に失敗しました。');
   148	        }
   149	
   150	        $token = $data['access_token'];
   151	        $expiresIn = (int) ($data['expires_in'] ?? 3600);
   152	        $ttl = max(60, $expiresIn - 300); // 5分バッファ（最低60秒）
   153	
   154	        $cacheItem->set(['token' => $token]);
   155	        $cacheItem->expiresAfter($ttl);
   156	        $this->cache->save($cacheItem);
   157	
   158	        return $token;
   159	    }
   160	}
