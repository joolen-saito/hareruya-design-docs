<?php
namespace Plugin\HareruyaEc\Form\Type\Admin\Analysis;

use Symfony\Component\Form\AbstractType;
use Symfony\Component\Form\FormBuilderInterface;
use Symfony\Component\OptionsResolver\OptionsResolver;

class UsedCardType extends AbstractType
{
    private $app;

    public function __construct($app)
    {
        $this->app = $app;
    }

    public function configureOptions(OptionsResolver $resolver)
    {
        $resolver->setDefaults([
            // disable CSRF protection for this form
            'csrf_protection' => false,
        ]);
    }

    /**
     * {@inheritdoc}
     */
    public function buildForm(FormBuilderInterface $builder, array $options)
    {
        $app = $this->app;

        $builder
            ->add('startDate', 'datetime', [
                'required' => true,
                'input' => 'datetime',
                'widget' => 'single_text',
                'format' => 'yyyy-MM-dd',
                'attr' => ['autocomplete' => 'off'],
                'data' => new \Datetime('2 week ago'),
            ])
            ->add('endDate', 'datetime', [
                'required' => false,
                'input' => 'datetime',
                'widget' => 'single_text',
                'format' => 'yyyy-MM-dd',
                'attr' => ['autocomplete' => 'off'],
            ])
            ->add('formats', 'entity', [
                'empty_value' => '選択してください',
                'required' => true,
                'class' => 'Plugin\HareruyaEc\Entity\MtbFormat',
                'expanded' => false,
                'multiple' => true,
            ])
            ->add('includeBasic', 'checkbox', [
                'label' => '基本土地を含める',
                'value' => true,
                'required' => false,
            ])
            ;
    }

    /**
     * {@inheritdoc}
     */
    public function getName()
    {
        return 'admin_used_card';
    }
}
    showTodayButton: true
});
$(function() {
    $('#admin_used_card_formats').select2({width:"100%"});

    $(".search-clear").click(function(){
        $('#admin_used_card_formats').val(null).trigger('change');
        $('#admin_used_card_startDate').val('{{ "2 week ago"|date("Y-m-d") }}')
    });
});
</script>
