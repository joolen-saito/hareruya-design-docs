{% block sub_title %}買取詳細{% endblock %}

{% form_theme form '@admin/Form/bootstrap_4_horizontal_layout.html.twig' %}

{% block main %}
<form name="form" id="form" method="post" action="{{ path('admin_otcbuyorder_status_update', {'otcBuyOrderId': OtcBuyOrder.id}) }}">
    {{ form_widget(form._token) }}

    <div id="detail_wrap" class="c-contentsArea__cols">
        <div class="c-contentsArea__primaryCol">
            <div class="c-primaryCol">
                <div class="card rounded border-0 mb-4">
                    <div class="card-header"><span>ステータス変更</span></div>
                    <div class="card-body">
                        {# 査定番号 #}
                        <div class="row mb-2">
                            <div class="col-3"><strong>査定番号</strong></div>
                            <div class="col-9">{{ OtcBuyOrder.assessmentId }}</div>
                        </div>

                        {# 現在のステータス #}
                        <div class="row mb-2">
                            <div class="col-3"><strong>現在のステータス</strong></div>
                            <div class="col-9">
                                {{ OtcBuyOrder.OtcBuyOrderStatus ? OtcBuyOrder.OtcBuyOrderStatus.name : '' }}
                            </div>
                        </div>

                        <hr class="my-4">

                        {# 変更後のステータス（入力エリア） #}
                        <div class="row mb-2">
                            <div class="col-3">
                                <strong>{{ form_label(form.otc_buy_order_status, '変更後のステータス') }}</strong>
                            </div>
                            <div class="col-9">
                                {{ form_widget(form.otc_buy_order_status) }}
                                {{ form_errors(form.otc_buy_order_status) }}
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    {# === 画面下部の操作バー（4系スタイル） === #}
    <div class="c-conversionArea">
        <div class="c-conversionArea__container">
            <div class="row justify-content-between align-items-center">
                <div class="col-6">
                    <div class="c-conversionArea__leftBlockItem">
                        {# 戻るボタンを詳細画面へ #}
                        <a class="c-baseLink" href="{{ path('admin_otcbuyorder_detail', {'otcBuyOrderId': OtcBuyOrder.id}) }}">
                            <i class="fa fa-backward" aria-hidden="true"></i>
                            <span>店頭買取詳細</span>
                        </a>
                    </div>
                </div>
                <div class="col-6">
                    <div class="row align-items-center justify-content-end">
                        <div class="col-auto">
                            {# 保存ボタン #}
                            <button class="btn btn-ec-conversion px-5" type="submit">保存</button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</form>
{% endblock %}
