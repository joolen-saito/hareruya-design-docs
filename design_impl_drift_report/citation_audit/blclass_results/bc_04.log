{# オリジナル: pf-eccube3/app/Plugin/HareruyaEc/Resource/template/admin/OtcBuyOrder/summary.twig #}
{% extends '@admin/default_frame.twig' %}

{% set menus = ['purchase_store', 'summary'] %}

{% block title %}{{ 'admin.purchase.store.title'|trans }}{% endblock %}
{% block sub_title %}{{ 'admin.purchase.store.summary'|trans }}{% endblock %}

{% form_theme searchForm '@admin/Form/bootstrap_4_horizontal_layout.html.twig' %}

{% block javascript %}
<script src="{{ asset('assets/js/select2.min.js', 'admin') }}"></script>
<script src="{{ asset('assets/js/OtcBuyOrder/otc-buy-order-summary.js', 'admin') }}"></script>
{% endblock javascript %}

{% block main %}
    <form name="search_form" id="search_form" method="post" action="{{ path('admin_otcbuyorder_summary_search') }}">
        <div id="search_wrap" class="search-box">
            <div id="search_box" class="row">
                <div class="col-md-12 accordion">
                    <div id="search_box___body" class="search-box-inner">
                        <div class="row">
                            <div id="search_box__body_inner" class="col-sm-12 col-lg-12 search">
                                <div class="row">
                                    <div class="col-xs-12 col-md-12">
                                        <label>{{ 'admin.purchase.store.summary.form.summary_date_from.label'|trans }}</label>
                                        <div class="form-group range">
                                            {{ form_widget(searchForm.summary_date_from) }}　～　{{ form_widget(searchForm.summary_date_to) }}
                                            {{ form_errors(searchForm.summary_date_from) }}
                                            {{ form_errors(searchForm.summary_date_to) }}
                                        </div>
                                    </div>
                                </div>
                                <div class="row">
                                    <div class="col-md-6">
                                        <div id="search_box__section" class="form-group">
                                            <label>{{ 'admin.purchase.store.summary.form.section.label'|trans }}</label>
                                            {{ form_widget(searchForm.section) }}
                                            {{ form_errors(searchForm.section) }}
                                        </div>
                                    </div>
                                    <div class="col-md-6">
                                        <div id="search_box__shop" class="form-group">
                                            <label>{{ 'admin.purchase.store.summary.form.shop.label'|trans }}</label>
                                            {{ form_widget(searchForm.shop) }}
                                            {{ form_errors(searchForm.shop) }}
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div id="search_box_footer" class="row btn_area">
                <div id="search_box_footer__button_area" class="col-xs-8 col-xs-offset-2 col-sm-4 col-sm-offset-4 text-center">
                    <button type="submit" class="btn btn-primary btn-block btn-lg searchBtn">
                        {{ 'admin.purchase.store.summary.form.search.button'|trans }} <svg class="cb cb-angle-right"><use xlink:href="#cb-angle-right"></svg>
                    </button>
                </div>
            </div>
        </div>
    </form>
    {% if searched %}
        <div id="result_list" class="row">
            <div class="col-md-12">
                <div id="result_list_main" class="box">
                    {% if entirePeriodSummary %}
                        <div id="result_list__menu" class="row">
                            <div class="col-md-12 summary-header" >
                                <p>
