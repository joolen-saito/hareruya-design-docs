        $('.action-down, .action-up').on('click', function() {
            const self = $(this);
            const current = $(this).parents('tr');
            $('body').append($('<div class="modal-backdrop show"></div>'));
            $.ajax({
                url: self.attr('href'),
                method: self.data('method'),
            }).done(function() {
                if (self.hasClass('action-down')) {
                    current.next().after(current);
                } else {
                    current.prev().before(current);
                }
            }).always(function() {
                $('.modal-backdrop').remove();
                $('.action-up, .action-down').removeClass('disabled');
                $('.action-up').first().addClass('disabled');
                $('.action-down').last().addClass('disabled');
            });

            return false;
