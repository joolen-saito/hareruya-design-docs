    private function createFreshBannerPageState(?string $htmlClass): array
    {
        $bannerSettingSlots = array_values($this->bannerRepository->findBy([], ['id' => 'ASC']));
        $baseInfos = $this->getAllBaseInfosOrdered();
        $selectedBaseInfo = $this->resolveSelectedBaseInfo($htmlClass);
        $Member = $this->getMember();
        $uploadChoiceBaseInfos = $this->filterBaseInfosEditableByMember($Member, $baseInfos);
        $initialUploadShop = null;
        if ($selectedBaseInfo !== null && $Member->isEditableShop($selectedBaseInfo)) {
            $initialUploadShop = $selectedBaseInfo;
        }

        return [
            'bannerSettingSlots' => $bannerSettingSlots,
            'baseInfos' => $baseInfos,
            'selectedBaseInfo' => $selectedBaseInfo,
            'settingForm' => $this->createSettingForm($bannerSettingSlots, $baseInfos),
            'uploadForm' => $this->createUploadForm($initialUploadShop, $uploadChoiceBaseInfos),
            'htmlClass' => $htmlClass,
        ];
    }

    /**
     * Twig に渡す連想配列（フォームビュー・S3 一覧等）をまとめる。
     *
     * @param array{
     *     bannerSettingSlots: list<?MtbBanner>,
     *     baseInfos: list<BaseInfo>,
     *     selectedBaseInfo: ?BaseInfo,
     *     settingForm: FormInterface,
     *     uploadForm: FormInterface,
     *     htmlClass: ?string
     * } $page
     * @param array{message: string, params?: array<string, string>}|null $uploadError
     *
     * @return array<string, mixed>
     */
    private function buildBannerTwigViewData(array $page, ?array $uploadError = null): array
    {
        $htmlClass = $page['htmlClass'] ?? null;

        return [
            'settingForm' => $page['settingForm']->createView(),
            'uploadForm' => $page['uploadForm']->createView(),
            'bannerSettingSlots' => $page['bannerSettingSlots'],
            'baseInfos' => $page['baseInfos'],
            'htmlClass' => $htmlClass,
            'selectedBaseInfo' => $page['selectedBaseInfo'],
            'arrFileList' => $this->eventBannerStorage->loadSortedFileList($htmlClass),
            'uploadError' => $uploadError,
            'bannerDeletableHtmlClasses' => $this->getMemberEditableBannerHtmlClasses($page['baseInfos']),
        ];
    }

    /**
     * URL の htmlClass に対応する BaseInfo を取得する。不正なら 404。
     */
    private function resolveSelectedBaseInfo(?string $htmlClass): ?BaseInfo
    {
        if ($htmlClass === null || $htmlClass === '') {
            return null;
        }

        $BaseInfo = $this->baseInfoRepository->findByHtmlClassName($htmlClass);
        if ($BaseInfo === null) {
            throw new NotFoundHttpException();
        }

        return $BaseInfo;
    }

