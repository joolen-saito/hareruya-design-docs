   498	                WHERE ps.ProductClass = pc
   499	                  AND ps.stock > 0
   500	                  AND ps.pick_up_flg = true
   501	                  AND IDENTITY(ps.baseInfo) = :baseInfoId
   502	            )')
   503	            ->andWhere('(rr.display_locale_list IS NULL OR rr.display_locale_list LIKE :locale)')
   504	            ->setParameter('statusShow', ProductStatus::DISPLAY_SHOW)
   505	            ->setParameter('baseInfoId', $baseInfoId)
   506	            ->setParameter('locale', '%'.$locale.'%')
   507	            ->getQuery()
   508	            ->getResult();
