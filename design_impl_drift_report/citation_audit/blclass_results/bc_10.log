from html.parser import HTMLParser
from pathlib import Path
class P(HTMLParser):
 def __init__(self): super().__init__(); self.stack=[]; self.items=[]
 def handle_starttag(self,tag,attrs):
  d=dict(attrs); active=next((x for x in reversed(self.stack) if x is not None),None)
  item=None
  if tag=='span' and 'src-cell' in d.get('class','').split(): item={'ref':d.get('data-excel-ref'),'text':[]}; self.items.append(item)
  self.stack.append(item or active)
 def handle_endtag(self,tag):
  if self.stack: self.stack.pop()
 def handle_data(self,d):
  if self.stack and self.stack[-1] is not None:self.stack[-1]['text'].append(d)
