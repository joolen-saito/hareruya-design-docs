use GuzzleHttp\ClientInterface;
use GuzzleHttp\Exception\GuzzleException;

class CreateLatestArticleListAction
{
    public const LIST_DIRECTORY = 'list';

    public const LIST_FILENAME = 'latestArticleList.json';

    public const WP_API_URL = 'https://article.hareruyamtg.com/article/wp-json/wp/v2/posts/?per_page=20';

    public function __construct(
        private readonly EccubeConfig $eccubeConfig,
        private readonly FileManager $fileManager,
        private readonly ClientInterface $httpClient,
    ) {
    }

    public function handle(): void
    {
        $body = $this->fetchWordPressResponseBody();

        try {
            $latestArticleList = json_decode($body, true, 512, JSON_THROW_ON_ERROR);
        } catch (\JsonException $e) {
            throw new \RuntimeException('WordPress APIのJSON形式が不正です: '.$e->getMessage(), 0, $e);
        }

        if (!is_array($latestArticleList)) {
            throw new \RuntimeException('WordPress APIのレスポンス形式が不正です。JSONのルートは配列である必要があります。');
        }

        $this->saveJsonFile(self::LIST_FILENAME, $latestArticleList);
    }

    /**
     * @throws \RuntimeException
     */
    private function fetchWordPressResponseBody(): string
    {
        try {
            $response = $this->httpClient->request('GET', self::WP_API_URL);
        } catch (GuzzleException $e) {
            throw new \RuntimeException('WordPress記事の取得に失敗しました。: '.$e->getMessage(), 0, $e);
        }

        $statusCode = $response->getStatusCode();
        if ($statusCode !== 200) {
            throw new \RuntimeException(sprintf('WordPress APIの取得に失敗しました。HTTPステータス: %d', $statusCode));
        }

        $body = (string) $response->getBody();
        if ($body === '') {
            throw new \RuntimeException('WordPress APIのレスポンス本文が空です。');
