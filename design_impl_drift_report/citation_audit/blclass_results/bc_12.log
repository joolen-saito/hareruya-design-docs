{% set articles = (latestArticlesBlockPayload|default({})).articles|default([]) %}
{% if articles|length > 0 %}
<section class="p-hareruya-section">
  <div class="l-hareruya-container">
    <div class="p-hareruya-heading__wrap p-hareruya-section__heading">
      <h2 class="c-hareruya-heading--lev2">{{ 'front.top.latest_articles.title'|trans }}</h2>
      <a class="c-hareruya-text--link p-hareruya-heading--more-link" href="https://article.hareruyamtg.com">{{ 'front.top.latest_articles.more'|trans }}</a>
    </div>
    <div class="p-hareruya-media__grid">
      {% for article in articles %}
      {% set rawHref = article.url|default(article.link|default('')) %}
      {% set safeHref = (rawHref starts with 'https://' or rawHref starts with 'http://') ? rawHref : '#' %}
      <a class="p-hareruya-media-card" href="{{ safeHref }}" target="_blank" rel="noopener noreferrer">
        <div class="p-hareruya-media-card__img-wrap">
          <img class="p-hareruya-media-card__image" src="{{ article.thumbnail|default(article.thumbnailUrl|default('')) }}" alt="{{ article.title|default('') }}" width="168" height="86" decoding="async" loading="lazy">
        </div>
        <div class="p-hareruya-media-card__content">
          <div class="p-hareruya-media-card__body">
            {% if article.category is defined and article.category %}
            <span class="p-hareruya-media-card__label c-hareruya-label c-hareruya-label--{{ article.categoryClass|default('media') }}">{{ article.category }}</span>
            {% endif %}
            <p class="p-hareruya-media-card__title">{{ article.title|default('') }}</p>
          </div>
          {% if article.author is defined and article.author %}
          <span class="p-hareruya-media-card__meta">{{ article.author }}</span>
          {% endif %}
        </div>
      </a>
      {% endfor %}
    </div>
  </div>
</section>
{% endif %}

