{
    public function __construct(
        private readonly ScheduleStoreAction $scheduleStoreAction,
        private readonly ScheduleUpdateAction $scheduleUpdateAction,
    ) {
    }

    /**
     * スケジュール新規登録（GET: フォーム表示、POST: 登録処理）
     *
     * @return RedirectResponse|array<string, mixed>
     */
    #[Route(path: '/%eccube_admin_route%/event/{eventId}/schedule/create', name: 'admin_schedule_create', requirements: ['eventId' => '\d+'], methods: ['GET', 'POST'])]
    #[Template(template: '@admin/Event/Schedule/edit.twig')]
    public function create(Request $request, #[MapEntity(id: 'eventId')] DtbEvent $Event): RedirectResponse|array
    {
        $EventDetail = new DtbEventDetail($Event);

        $builder = $this->formFactory->createBuilder(ScheduleType::class, $EventDetail, ['event' => $Event, 'is_new' => true]);

        $event = new EventArgs(
            [
                'builder' => $builder,
                'Event' => $Event,
            ],
            $request
        );
        $this->eventDispatcher->dispatch($event, EccubeEvents::ADMIN_EVENT_SCHEDULE_CREATE_INITIALIZE);

        $form = $builder->getForm();
        $form->handleRequest($request);

        if ($form->isSubmitted() && $form->isValid()) {
            /** @var DtbEventDetail $FormEventDetail */
            $FormEventDetail = $form->getData();
            $input = new ScheduleStoreInput($Event, $FormEventDetail, $this->getMember());

            try {
                $EventDetail = $this->scheduleStoreAction->handle($input);

                $event = new EventArgs(
                    [
                        'form' => $form,
                        'Event' => $Event,
                    ],
                    $request
                );
                $this->eventDispatcher->dispatch($event, EccubeEvents::ADMIN_EVENT_SCHEDULE_CREATE_COMPLETE);

                $this->addSuccess('admin.common.save_complete', 'admin');

                return $this->redirectToRoute('admin_schedule_edit', ['eventId' => $Event->getId(), 'eventDetailId' => $EventDetail->getId()]);
            } catch (\Exception $e) {
                $this->addError('admin.common.save_error', 'admin');
            }
        }

        $Member = $this->getMember();
        $isEditableBaseInfo = $Event->getBaseInfo() && $Member->isEditableShop($Event->getBaseInfo());

        return [
            'form' => $form->createView(),
            'Event' => $Event,
            'EventDetail' => $EventDetail,
            'isNew' => true,
            'isEditableBaseInfo' => $isEditableBaseInfo,
        ];
    }

    /**
     * スケジュール編集（GET: フォーム表示、POST: 更新処理）
     *
     * @return RedirectResponse|array<string, mixed>
     */
    #[Route(path: '/%eccube_admin_route%/event/{eventId}/schedule/{eventDetailId}/edit', name: 'admin_schedule_edit', requirements: ['eventId' => '\d+', 'eventDetailId' => '\d+'], methods: ['GET', 'POST'])]
    #[Template(template: '@admin/Event/Schedule/edit.twig')]
    public function edit(Request $request, #[MapEntity(id: 'eventId')] DtbEvent $Event, #[MapEntity(id: 'eventDetailId')] DtbEventDetail $EventDetail): RedirectResponse|array
    {
        if ($EventDetail->getEvent()->getId() !== $Event->getId()) {
            $this->addError('admin.common.error_invalid_request', 'admin');

            return $this->redirectToRoute('admin_event_edit', ['id' => $Event->getId()]);
        }

        $builder = $this->formFactory->createBuilder(ScheduleType::class, $EventDetail, ['event' => $Event, 'is_new' => false]);

        if ($mainCards === []) {
            return null;
        }

        $displayName = $this->resolvePlayerDisplayName($deck);
        $eventDetail = $deck->getEventDetail();

        return [
            'displayName' => $displayName,
            'firstLetter' => $displayName !== '' ? (string) mb_substr(trim($displayName), 0, 1) : '',
            'pageNo' => 1,
            'totalPages' => 1,
            'tableNumber' => '',
            'dciNo' => $deck->getPlayer()?->getDciNo() ?? '',
            'eventName' => $eventDetail?->getEvent()?->getNameJp() ?? '',
            'eventDate' => $eventDetail?->getStartDate()?->format('Y/m/d') ?? '',
            'mainboard' => $this->buildMainboard($mainCards, $cardtypes),
        ];
    }

