from pathlib import Path
import re
fn=Path('hareruya-design-docs/excel_to_html/output/0301_基本設計仕様書(フロント_トップ).html')
class P(HTMLParser):
 def __init__(self): super().__init__(); self.on=False; self.a={}; self.b=[]
 def handle_starttag(self,t,attrs):
  a=dict(attrs)
  if t=='span' and 'src-cell' in a.get('class','').split(): self.on=True;self.a=a;self.b=[]
  elif self.on and t=='br':self.b.append(' ')
 def handle_data(self,d):
  if self.on:self.b.append(d)
 def handle_endtag(self,t):
  if self.on and t=='span':
   ref=self.a.get('data-excel-ref',''); text=' '.join(''.join(self.b).split())
   if '支店ECTOP' in ref and any(x in text for x in ('おすすめ特集','ブロック管理','編集/削除可能','編集可能なブロック','遷移する','バナー')): print(ref,'|',text)
   self.on=False
p=P();p.feed(fn.read_text())
