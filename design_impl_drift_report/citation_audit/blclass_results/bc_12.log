{% extends 'default_frame.twig' %}

{% set body_class = 'shop_top' %}
{% set page_title = 'front.seo.shop_top.page_title'|trans({'%shop_name%': Shop.shopName}) %}

{% block stylesheet %}
    <link rel="stylesheet" href="{{ asset('assets/hareruya/css/hareruya-top.css') }}">
    <style{% if csp_nonce is defined %} nonce="{{ csp_nonce }}"{% endif %}>
        .shop_top .ec-layoutRole__contents { max-width: none !important; display: block !important; }
        .shop_top .p-hareruya-product-card p { margin-bottom: 0; }
        .shop_top .p-hareruya-product-card__cart-form { margin: 0; padding: 0; }
        .shop_top .p-hareruya-cart-popup__link { white-space: pre-line !important; text-align: center; }
        .p-hareruya-top__category-list .p-hareruya-category-list { max-width: none; width: 100%; }
        .p-hareruya-top__category-list .p-hareruya-category-item { max-width: none; width: 100%; }
    </style>
{% endblock %}

{% block main_top %}{% endblock %}

{% block main %}
<div role="main">
    {% if Layout.MainTop %}
        {{ include('block.twig', {'Blocks': Layout.MainTop}) }}
    {% endif %}
    <div class="p-hareruya-branch-top">
        {% include 'Block/shop_order_method.twig' with { isBranchShopFront: isBranchShopFront, Shop: Shop } %}
        {% include 'Block/shop_best_sellers.twig' with { ProductClasses: BestSellerProductClasses, forms: bestSellerForms, favorites: favorites } %}
        {% include 'Block/shop_sale.twig' with { ProductClasses: SaleProductClasses, forms: saleForms, favorites: favorites } %}
        {% include 'Block/shop_item_list.twig' with {
            Shop: Shop,
            tiles: tiles,
            banner: banner,
            favorites: favorites,
        } %}
        {% include 'Block/search_items.twig' %}
        {% include 'Block/category_list.twig' %}
        {% include 'Block/shop_recommend.twig' %}
        {% include 'Block/shop_promo.twig' with { Shop: Shop, isBranchShopFront: isBranchShopFront, shopTopUrl: shopTopUrl, shopTopQrDataUri: shopTopQrDataUri, xAccountQrDataUri: xAccountQrDataUri } %}
        {% include 'Block/shop_recruit.twig' %}
    </div>
    {% if Layout.MainBottom %}
        {{ include('block.twig', {'Blocks': Layout.MainBottom}) }}
    {% endif %}
</div>
{% endblock %}

{% block main_bottom %}{% endblock %}

{% block modal %}{% endblock %}

{% block javascript %}
    {% include 'Block/js/product_js.twig' %}
    {% include 'Block/_top_page_scripts.twig' %}
{% endblock %}
