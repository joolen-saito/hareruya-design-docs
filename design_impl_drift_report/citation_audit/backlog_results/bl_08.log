    /**
     * ContactType constructor.
     */
    public function __construct(protected EccubeConfig $eccubeConfig)
    {
    }

    /**
     * {@inheritdoc}
     */
    #[\Override]
    public function configureOptions(OptionsResolver $resolver): void
    {
        $resolver->setDefaults([
            'entry_type' => EmailType::class,
            'required' => true,
            'invalid_message' => 'form_error.same_email',
            'options' => [
                'constraints' => [
                    new Email(null, null, $this->eccubeConfig['eccube_rfc_email_check'] ? 'strict' : null),
                    new Assert\Length([
                        'max' => $this->eccubeConfig['eccube_email_len'],
                    ]),
                    new Assert\Regex([
                        'pattern' => '/\.{2,}|\.@/',
                        'match' => false,
                        'message' => 'form_error.invalid_email_format',
                    ]),
                ],
            ],
            'first_options' => [
                'attr' => [
                    'placeholder' => 'common.mail_address_sample',
                ],
            ],
            'second_options' => [
                'attr' => [
                    'placeholder' => 'common.repeated_confirm',
                ],
            ],
            'first_notblank_message' => null,
            'second_notblank_message' => null,
            'error_bubbling' => false,
            'trim' => true,
            'error_mapping' => fn (Options $options) => ['.' => $options['second_name']],
        ]);

        $resolver->setNormalizer('first_options', function (Options $options, $value) {
            $notBlank = $options['first_notblank_message'] !== null
                ? new Assert\NotBlank(['message' => $options['first_notblank_message']])
                : new Assert\NotBlank();
            $optionConstraints = $options['options']['constraints'] ?? [];
            $value['constraints'] = array_merge([$notBlank], $optionConstraints, $value['constraints'] ?? []);

            return $value;
        });

        $resolver->setNormalizer('second_options', function (Options $options, $value) {
            $notBlank = $options['second_notblank_message'] !== null
                ? new Assert\NotBlank(['message' => $options['second_notblank_message']])
                : new Assert\NotBlank();
            $optionConstraints = $options['options']['constraints'] ?? [];
            $value['constraints'] = array_merge([$notBlank], $optionConstraints, $value['constraints'] ?? []);

            return $value;
        });
    }

    /**
     * {@inheritdoc}
     */
    #[\Override]
    public function getParent(): ?string
    {
        return RepeatedType::class;
    }

    /**
     * {@inheritdoc}
     */
    #[\Override]
    public function getBlockPrefix(): string
    {
        return 'repeated_email';
    }
