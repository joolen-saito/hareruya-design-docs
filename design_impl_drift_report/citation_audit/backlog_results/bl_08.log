    #[Route(path: '/%eccube_admin_route%/customer/mail/{id}/history', name: 'admin_customer_mail_history', requirements: ['id' => '\d+'], methods: ['GET'])]
    /**
     * 店頭受取→スマレジ取引（Pattern 2/3 等）の統合グループ照会用キーを返す。
     * 統合受注は自分の ID、旧受注は next_order_id（統合受注の ID）をキーとする。
     */
    private function resolveOtcSmaregiLinkedLookupKey(Order $Order): ?int
    {
        if ($Order->hasPredecessorOrder()) {
            return $Order->getId();
        }

        return $Order->getNextOrderId();
    }

    /**
     * next_order_id ごとに、紐づく店頭受取受注の order_date の最大値（最も新しい日付）を返す。
     *
     * @param list<int> $nextOrderIds
     *
     * @return array<int, \DateTime>
     */
    private function findNewestOtcOrderDatesByNextOrderIds(array $nextOrderIds): array
    {
        if ($nextOrderIds === []) {
            return [];
        }

        /** @var list<array{nextOrderId: int|string, newestOrderDate: \DateTime|\DateTimeInterface|string}> $rows */
        $rows = $this->createQueryBuilder('o')
            ->select('o.nextOrderId AS nextOrderId, MAX(o.order_date) AS newestOrderDate')
            ->where('o.nextOrderId IN (:nextOrderIds)')
            ->andWhere('o.order_date IS NOT NULL')
            ->setParameter('nextOrderIds', $nextOrderIds)
