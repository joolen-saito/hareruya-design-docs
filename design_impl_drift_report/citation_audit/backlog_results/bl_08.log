    private function getDefaultUsePoint(Order $Order): int
    {
        $pointBalance = (int) ($Order->getCustomer()?->getPlayer()?->getPoint() ?? 0);

        return max(0, min($pointBalance, $this->getPaymentTotalBeforePoint($Order)));
    }

    private function getPaymentTotalBeforePoint(Order $Order): int
    {
        return max(0, (int) $Order->getSubtotal()
            + (int) $Order->getDeliveryFeeTotal()
            + (int) $Order->getCharge());
    }

