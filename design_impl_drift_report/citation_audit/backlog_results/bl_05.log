        private ?array $editableShopIds = null;

        /**
         * 編集可能店舗かどうか判定します
         */
        public function isEditableShop(BaseInfo $TargetBaseInfo): bool
        {
            // 1. 最初の一回だけ、全許可店舗のIDを配列にまとめる

            if ($this->editableShopIds === null) {
                $this->editableShopIds = [];

                foreach ($this->getMemberBaseInfos() as $MemberBaseInfo) {
                    $this->editableShopIds[] = $MemberBaseInfo->getBaseInfo()->getId();
                }
            }

            return in_array($TargetBaseInfo->getId(), $this->editableShopIds, true);
        }

