    public function edit(Request $request, Environment $twig, RouterInterface $router, CacheUtil $cacheUtil, $id = null): RedirectResponse|array
    {
        // URLクエリーに付与されているlocaleパラメータのバリデーション (デフォルト: ja)
        $locale = $request->query->get('locale', 'ja');
        if (!in_array($locale, $this->getParameter('kernel.enabled_locales'), true)) {
            throw new NotFoundHttpException();  // localeパラメータがjaでもenでもなければ404ページ表示
        }
        // 日本語は.jaなし（例: foo.twig）、英語は.en付き（例: foo.en.twig）
        $localeSuffix = $locale === 'ja' ? '' : '.'.$locale;
        $this->addInfoOnce('admin.common.restrict_file_upload_info', 'admin');

        if (null === $id) {
            $Page = $this->pageRepository->newPage();
        } else {
            $Page = $this->pageRepository->find($id);
            if ($Page == null) {
                throw new NotFoundHttpException();
            }
        }

        // フォーム生成前に isUserDataPage を確定する
        $isUserDataPage = !($id && $Page->getEditType() >= Page::EDIT_TYPE_DEFAULT);

