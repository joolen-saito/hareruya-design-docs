namespace Eccube\Form\Type\Admin\OtcBuyOrder;

use Doctrine\ORM\EntityRepository;
use Eccube\Entity\BaseInfo;
use Eccube\Entity\Master\MtbCardCondition;
use Eccube\Entity\Master\MtbLanguage;
use Eccube\Entity\Master\MtbOtcBuyOrderStatus;
use Eccube\Entity\Member;
use Eccube\Repository\BaseInfoRepository;
use Symfony\Bridge\Doctrine\Form\Type\EntityType;
use Symfony\Bundle\SecurityBundle\Security;
use Symfony\Component\Form\AbstractType;
use Symfony\Component\Form\Extension\Core\Type\ChoiceType;
use Symfony\Component\Form\Extension\Core\Type\DateTimeType;
use Symfony\Component\Form\Extension\Core\Type\IntegerType;
use Symfony\Component\Form\Extension\Core\Type\TextType;
use Symfony\Component\Form\FormBuilderInterface;
use Symfony\Component\OptionsResolver\OptionsResolver;

class OtcBuyOrderHistoryType extends AbstractType
{
    public const DISPLAY_STATUSES = [
        MtbOtcBuyOrderStatus::STATUS_COMPLETE,
        MtbOtcBuyOrderStatus::STATUS_CANCEL,
        MtbOtcBuyOrderStatus::STATUS_STOCKING_PENDING,
        MtbOtcBuyOrderStatus::STATUS_HAS_UNREGISTERED_STOCK,
        MtbOtcBuyOrderStatus::STATUS_STOCKING_COMPLETE,
        MtbOtcBuyOrderStatus::STATUS_REVOKED_BY_ADMIN,
    ];

    /**
     * @var BaseInfoRepository
     */
    protected BaseInfoRepository $baseInfoRepository;

    /**
     * @var Security
     */
    protected Security $security;

    public function __construct(BaseInfoRepository $baseInfoRepository, Security $security)
    {
        $this->baseInfoRepository = $baseInfoRepository;
        $this->security = $security;
    }

    /**
     * {@inheritdoc}
     */
    public function configureOptions(OptionsResolver $resolver): void
    {
        $resolver->setDefaults([
            // disable CSRF protection for this form
            'csrf_protection' => false,
        ]);
    }

    /**
     * {@inheritdoc}
     */
    public function buildForm(
        FormBuilderInterface $builder,
        array $options,
    ): void {
        $builder
            ->add('assessment_id', TextType::class, [
                'required' => false,
            ])
            ->add('customer_id', TextType::class, [
                'required' => false,
            ])
            ->add('customer_name', TextType::class, [
                'required' => false,
            ])
            ->add('otc_buy_order_status', EntityType::class, [
                'label' => trans('form.otc_buy_order_status.label'),
                'required' => false,
                'expanded' => true,
                'multiple' => true,
                'class' => MtbOtcBuyOrderStatus::class,
                'query_builder' => function (EntityRepository $er) {
                    return $er
                        ->createQueryBuilder('obos')
                        ->where('obos.id in (:statuses)')
                        ->setParameter('statuses', self::DISPLAY_STATUSES);
                },
            ])
            ->add('complete_date_from', DateTimeType::class, [
                'required' => false,
                'input' => 'datetime',
                'widget' => 'single_text',
                'attr' => [
                    'class' => 'datetimepicker-input',
                    'data-target' => '#'.$this->getBlockPrefix().'_complete_date_from',
                    'data-toggle' => 'datetimepicker',
                ],
            ])
            ->add('complete_date_to', DateTimeType::class, [
                'required' => false,
                'input' => 'datetime',
                'widget' => 'single_text',
                'attr' => [
                    'class' => 'datetimepicker-input',
                    'data-target' => '#'.$this->getBlockPrefix().'_complete_date_to',
                    'data-toggle' => 'datetimepicker',
                ],
            ])
            ->add('shop', EntityType::class, [
                'label' => trans('form.shop.label'),
                'required' => false,
                'expanded' => false,
                'multiple' => false,
                'class' => BaseInfo::class,
                'placeholder' => 'admin.purchase.store.history.form.shop.placeholder',
                'data' => $this->getMemberDefaultSearchBaseInfo(),
            ])
            ->add('assessment_member_name', TextType::class, [
                'required' => false,
            ])
            ->add('buy_price_from', IntegerType::class, [
                'required' => false,
            ])
            ->add('buy_price_to', IntegerType::class, [
                'required' => false,
            ])
            ->add('standard_price_from', IntegerType::class, [
                'required' => false,
            ])
            ->add('standard_price_to', IntegerType::class, [
                'required' => false,
            ])
            ->add('product_name', TextType::class, [
                'required' => false,
            ])
            ->add('product_code', TextType::class, [
                'expanded' => false,
                'placeholder' => 'common.select__unspecified',
                'choice_label' => 'shopName',
                'data' => $options['base_info_default'] ?? [],
                'query_builder' => fn (EntityRepository $er) => $er->createQueryBuilder('b')
                    ->orderBy('b.id', 'ASC'),
            ])
            ->add('sortkey', HiddenType::class, [
                'label' => 'admin.list.sort.key',
                'required' => false,
            ])
            ->add('sorttype', HiddenType::class, [
                'label' => 'admin.list.sort.type',
                'required' => false,
            ])
