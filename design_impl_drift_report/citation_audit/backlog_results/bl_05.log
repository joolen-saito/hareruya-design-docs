    function handlePermissionCheckboxChange(e) {
        const checkbox = e.target;
        if (!checkbox?.classList.contains('permission-checkbox')) {
            return;
        }

        const row = checkbox.closest('tr');
        const groupId = checkbox.dataset.groupId;
        if (!row || !groupId) {
            return;
        }

        updateGroupLocks(row, groupId);
    }
    
    function handleCopyClick(e) {
        e.preventDefault();
        e.stopPropagation();
        
        const sourceRow = e.target?.closest('tr');
        const tbody = document.querySelector('#table-authority tbody');
        if (!sourceRow || !tbody) {
            return false;
        }

        const newRow = sourceRow.cloneNode(true);
        const uniqueId = Date.now();
        const sourceCheckboxes = sourceRow.querySelectorAll('.permission-checkbox');
        const newCheckboxes = newRow.querySelectorAll('.permission-checkbox');

        const nameCell = newRow.querySelector('th:first-child');
        if (nameCell) {
            nameCell.innerHTML = '<input type="text" class="form-control authority-name-input" name="new_authority_name[' + uniqueId + ']" placeholder="権限名を入力" value="" required style="width: 100%;">';
        }
        
        newCheckboxes.forEach(function(checkbox, index) {
            const permissionId = checkbox.dataset.permissionId;
            if (permissionId) {
                checkbox.name = 'authority[' + uniqueId + '][' + permissionId + ']';
                checkbox.dataset.authorityId = uniqueId;
                checkbox.checked = sourceCheckboxes[index]?.checked || false;
            }
        });
        
        const actionCell = newRow.querySelector('td:last-child');
        const deleteButton = document.createElement('button');
        deleteButton.type = 'button';
        deleteButton.className = 'btn btn-ec-regular btn-delete';
        deleteButton.textContent = '削除';
        deleteButton.onclick = function(e) {
            e.preventDefault();
            e.stopPropagation();
            e.currentTarget.closest('tr')?.remove();
        };
        if (actionCell) {
            actionCell.innerHTML = '';
            actionCell.appendChild(deleteButton);
        }
        tbody.appendChild(newRow);
        return false;
    }
    
    function init() {
        const table = document.querySelector('#table-authority');
        if (!table) {
            return;
        }
        table.addEventListener('click', function(e) {
            if (e.target?.classList.contains('btn-copy')) {
                handleCopyClick(e);
