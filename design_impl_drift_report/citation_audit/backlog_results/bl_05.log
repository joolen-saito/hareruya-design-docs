namespace Eccube\Twig\Loader;

use Symfony\Component\HttpFoundation\RequestStack;
use Twig\Loader\FilesystemLoader;
use Twig\Source;

/**
 * FilesystemLoaderを拡張し、ロケールに応じたテンプレート切り替えを行う
 *
 * - ロケールが'ja'の場合、'Product/detail.twig'を優先して読み込む
 * - ロケールが'en'の場合、'Product/detail.en.twig'を優先して読み込む
 *   - 'Product/detail.en.twig'が存在しない場合、'Product/detail.twig'を読み込む
 */
class LocaleFilesystemLoader extends FilesystemLoader
{
    private ?RequestStack $requestStack = null;
    private ?string $defaultLocale = null;

    public function setRequestStack(RequestStack $requestStack): void
    {
        $this->requestStack = $requestStack;
    }

    public function setDefaultLocale(string $defaultLocale): void
    {
        $this->defaultLocale = $defaultLocale;
    }

    /**
     * @see FilesystemLoader::exists()
     */
    #[\Override]
    public function exists(string $name): bool
    {
        $localeTemplateName = $this->getLocaleTemplateName($name);

        if ($localeTemplateName === null) {
            return parent::exists($name);
        }

        if (parent::exists($localeTemplateName)) {
            return true;
        }

        return parent::exists($name);
    }

    /**
     * @see FilesystemLoader::getSourceContext()
     */
    #[\Override]
    public function getSourceContext(string $name): Source
    {
        $localeTemplateName = $this->getLocaleTemplateName($name);

        if ($localeTemplateName === null) {
            return parent::getSourceContext($name);
        }

        if (parent::exists($localeTemplateName)) {
            return parent::getSourceContext($localeTemplateName);
        }

        return parent::getSourceContext($name);
    }

    /**
     * @see FilesystemLoader::getCacheKey()
     */
    #[\Override]
    public function getCacheKey(string $name): string
    {
        $localeTemplateName = $this->getLocaleTemplateName($name);

        if ($localeTemplateName === null) {
            return parent::getCacheKey($name);
        }

        if (parent::exists($localeTemplateName)) {
            return parent::getCacheKey($localeTemplateName);
        }

        return parent::getCacheKey($name);
    }

    /**
     * @see FilesystemLoader::isFresh()
     */
    #[\Override]
    public function isFresh(string $name, int $time): bool
    {
        $localeTemplateName = $this->getLocaleTemplateName($name);

        if ($localeTemplateName === null) {
            return parent::isFresh($name, $time);
        }

        if (parent::exists($localeTemplateName)) {
            return parent::isFresh($localeTemplateName, $time);
        }

        return parent::isFresh($name, $time);
    }

    private function getLocaleTemplateName(string $name): ?string
    {
        if ($this->requestStack === null || $this->defaultLocale === null) {
            return null;
        }

        $request = $this->requestStack->getCurrentRequest();

        if ($request === null) {
            return null;
        }

        $locale = $request->getLocale();

        if ($locale === $this->defaultLocale) {
            return null;
        }

        // ロケール付きテンプレート名を生成
        return preg_replace('/\.twig$/', '.'.$locale.'.twig', $name);
    }
}
            } catch (\Throwable $e) {
                // LoggerFacade未初期化など、ロギングに失敗してもルーティング自体は止めない
            }
        }
    }

    #[\Override]
    protected function build(ContainerBuilder $container): void
    {
        $this->addEntityExtensionPass($container);

        $container->registerExtension(new EccubeExtension());

        // サービスタグの自動設定を行う
        $container->addCompilerPass(new AutoConfigurationTagPass(), PassConfig::TYPE_BEFORE_OPTIMIZATION, 11);

        // サービスタグの収集より先に実行し, 付与されているタグをクリアする.
        // FormPassは優先度0で実行されているので, それより速いタイミングで実行させる.
        // 自動登録されるタグやコンパイラパスの登録タイミングは, FrameworkExtension::load(), FrameworkBundle::build()を参考に.
        $container->addCompilerPass(new PluginPass(), PassConfig::TYPE_BEFORE_OPTIMIZATION, 10);

        // DocumentRootをルーティディレクトリに設定する.
        $container->addCompilerPass(new WebServerDocumentRootPass('%kernel.project_dir%/'));

        // twigのurl,path関数を差し替え
        $container->addCompilerPass(new TwigExtensionPass());

        // ロケールに応じたTwigテンプレート切り替え（*.en.twig形式）
        $container->addCompilerPass(new LocaleTwigLoaderPass());

        // クエリカスタマイズの拡張.
        $container->registerForAutoconfiguration(QueryCustomizer::class)
            ->addTag(QueryCustomizerPass::QUERY_CUSTOMIZER_TAG);
        $container->addCompilerPass(new QueryCustomizerPass());

        // 管理画面ナビの拡張
        $container->registerForAutoconfiguration(EccubeNav::class)
            ->addTag(NavCompilerPass::NAV_TAG);
        $container->addCompilerPass(new NavCompilerPass());

        // TwigBlockの拡張
        $container->registerForAutoconfiguration(EccubeTwigBlock::class)
            ->addTag(TwigBlockPass::TWIG_BLOCK_TAG);
        $container->addCompilerPass(new TwigBlockPass());

        // PaymentMethod の拡張
        $container->registerForAutoconfiguration(PaymentMethodInterface::class)
            ->addTag(PaymentMethodPass::PAYMENT_METHOD_TAG);
        $container->addCompilerPass(new PaymentMethodPass());

        // PurchaseFlow の拡張
    #[Route(path: '/%eccube_admin_route%/content/page/{id}/delete', name: 'admin_content_page_delete', requirements: ['id' => '\d+'], methods: ['DELETE'])]
    public function delete(Request $request, CacheUtil $cacheUtil, $id = null): RedirectResponse
    {
        $this->isTokenValid();

        $Page = $this->pageRepository
            ->findOneBy([
                'id' => $id,
            ]);

        if (!$Page) {
            $this->deleteMessage();

            return $this->redirectToRoute('admin_content_page');
        }

        $adapter = $this->fileManager->getAdapter();
        $contentBucketOptions = $this->fileManager->getContentBucketOptions();

        // ユーザーが作ったページのみ削除する
        if ($Page->getEditType() == Page::EDIT_TYPE_USER) {
            $templatePath = $this->getParameter('eccube_theme_user_data_dir');
            $file = $templatePath.'/'.$Page->getFileName().'.twig';
            $fs = new Filesystem();
            if ($fs->exists($file)) {
                $fs->remove($file);
            }
            $this->entityManager->remove($Page);
            $this->entityManager->flush();

            $event = new EventArgs(
                [
                    'Page' => $Page,
                ],
                $request
            );
            $this->eventDispatcher->dispatch($event, EccubeEvents::ADMIN_CONTENT_PAGE_DELETE_COMPLETE);

            if ($adapter->exists($this::USER_DATA_PAGE_PATH.$Page->getFileName().'.twig', $contentBucketOptions)) {
                $adapter->delete($this::USER_DATA_PAGE_PATH.$Page->getFileName().'.twig', $contentBucketOptions);
            } else {
                log_error($this::USER_DATA_PAGE_PATH.$Page->getFileName().'.twig はS3に存在しません');
            }

            $this->addSuccess('admin.common.delete_complete', 'admin');

            // キャッシュの削除
            $cacheUtil->clearTwigCache();
            $cacheUtil->clearDoctrineCache();
        } else {
            if ($adapter->exists($this::DEFAULT_PAGE_PATH.$Page->getFileName().'.twig', $contentBucketOptions)) {
                $adapter->delete($this::DEFAULT_PAGE_PATH.$Page->getFileName().'.twig', $contentBucketOptions);
            } else {
                log_error($this::DEFAULT_PAGE_PATH.$Page->getFileName().'.twig はS3に存在しません');
            }
        }

        return $this->redirectToRoute('admin_content_page');
    }
}

