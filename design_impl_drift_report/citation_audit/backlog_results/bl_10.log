        $CsvType = $options['csvType'];
        $CsvExtension = $options['csvExtension'];
        $isCsvExtensionExisting = $CsvExtension->getId() !== null;

        $csvOutput = [];
        $csvOutputIds = [];
        if ($isCsvExtensionExisting) {
            $CsvCsvExtensions = $CsvExtension->getCsvCsvExtensions()->toArray();
            usort($CsvCsvExtensions, function (DtbCsvCsvExtension $a, DtbCsvCsvExtension $b) {
                return $a->getRank() <=> $b->getRank();
            });
            $csvOutput = array_map(function (DtbCsvCsvExtension $CsvCsvExtension) {
                return $CsvCsvExtension->getCsv();
            }, $CsvCsvExtensions);
            $csvOutputIds = array_map(function (Csv $Csv) {
                return $Csv->getId();
            }, $csvOutput);
        }

        $criteria = new Criteria();
        if (!empty($csvOutputIds)) {
            $criteria->where($criteria->expr()->notIn('id', $csvOutputIds));
        }
        $criteria->andWhere($criteria->expr()->eq('CsvType', $CsvType))
            ->orderBy(['sort_no' => 'ASC']);
        $csvNotOutput = $this->csvRepository->matching($criteria);

        $builder
            ->add('csv_type', EntityType::class, [
                'class' => 'Eccube\Entity\Master\CsvType',
                'required' => true,
                'constraints' => [
                    new NotBlank(),
                ],
                'query_builder' => function (EntityRepository $er) {
                    return $er->createQueryBuilder('c')
                        ->where('c.id IN (:csvIds)')
                        ->setParameter('csvIds', self::CSV_TYPES);
                },
                'data' => $CsvType,
            ])
            ->add('csv_extensions', EntityType::class, [
                'class' => 'Eccube\Entity\DtbCsvExtension',
                'required' => false,
                'query_builder' => function (EntityRepository $er) use ($CsvType) {
                    return $er->createQueryBuilder('ce')
                        ->join('ce.CsvType', 'ct', 'WITH', 'ct = :csvType')
                        ->setParameter('csvType', $CsvType);
                },
                'placeholder' => '新規作成',
                'data' => $isCsvExtensionExisting ? $CsvExtension : null,
            ])
            ->add('name', TextType::class, [
