    /**
     * @return array{stockSplitJoinId: int, successMessage: string}
     */
    public function handle(StockJoinApprovalApproveInput $input): array
    {
        $StockSplitJoin = $input->StockSplitJoin;
        $Member = $input->Member;

        $StatusCompleted = $this->mtbStockSplitJoinStatusRepository->find(MtbStockSplitJoinStatus::RECEIPT_COMPLETED);
        if ($StatusCompleted === null) {
            throw new \LogicException('StockJoinApprovalApproveAction requires RECEIPT_COMPLETED status in master.');
        }

        $joinInboundType = $this->stockChangeTypeDetailRepository->find(MtbStockChangeTypeDetail::JOIN_INBOUND);
        $historySourceType = $this->stockHistorySourceTypeRepository->find(MtbStockHistorySourceType::STOCK_JOIN_EDIT);
        if ($joinInboundType === null || $historySourceType === null) {
            throw new \LogicException('StockJoinApprovalApproveAction requires JOIN_INBOUND and history source type masters.');
        }

        $now = new \DateTime();

        $this->entityManager->beginTransaction();
        try {
            $this->entityManager->lock($StockSplitJoin, LockMode::PESSIMISTIC_WRITE);
            $this->entityManager->refresh($StockSplitJoin);
            if ($StockSplitJoin->getStockSplitJoinStatus()->getId() !== MtbStockSplitJoinStatus::JOIN_APPROVAL_WAITING) {
                throw new \LogicException('StockJoinApprovalApproveAction requires JOIN_APPROVAL_WAITING status.');
            }

            $splitJoinMemo = trim($input->splitJoinMemo);
            $StockSplitJoin->setSplitJoinMemo($splitJoinMemo !== '' ? $splitJoinMemo : null);

            $DestPs = $StockSplitJoin->getProductStock();
            $this->entityManager->lock($DestPs, LockMode::PESSIMISTIC_WRITE);
            $this->entityManager->refresh($DestPs);

            foreach ($details as $Detail) {
                $srcCodes[] = (string) ($Detail->getSubjectProductStock()->getProductClass()->getCode() ?? '');
            }
            $joinRejectReason = '在庫結合棄却による戻し 結合元：'.implode('、', array_filter($srcCodes)).' 結合先：'.$destCode.' 在庫結合分割番号：'.$StockSplitJoin->getId();
            foreach ($details as $Detail) {
                $this->entityManager->lock($Detail, LockMode::PESSIMISTIC_WRITE);
                $this->entityManager->refresh($Detail);
                $effQty = $this->effectiveJoinQuantity($Detail);
                if ($effQty < 1) {
                    continue;
                }
                $effQtyStr = (string) $effQty;
                $SourcePs = $Detail->getSubjectProductStock();
                $this->entityManager->lock($SourcePs, LockMode::PESSIMISTIC_WRITE);
                $this->entityManager->refresh($SourcePs);

                $costPrice = $Detail->getCostPrice() ?? '0';
                $restoredCost = \bcmul($costPrice, $effQtyStr, 2);
                $currentStock = $SourcePs->getStock() ?? '0';
                $currentTotalCost = $SourcePs->getTotalCost();
                $afterStock = \bcadd($currentStock, $effQtyStr, 0);
                $afterTotalCost = \bcadd($currentTotalCost, $restoredCost, 2);
                $ProductClass = $SourcePs->getProductClass();
                $unitCostBefore = $SourcePs->getUnitCost();
                $unitCostAfter = \bccomp($afterStock, '0', 0) > 0
                    ? \bcround(\bcdiv($afterTotalCost, $afterStock, 8), 0)
                    : '0';

                $this->productStockEntityManager->save(
                    ProductStock: $SourcePs,
                    ProductClass: $ProductClass,
                    BaseInfo: $SourcePs->getBaseInfo(),
                    stock: $afterStock,
                    pickUpFlg: $SourcePs->getPickUpFlg(),
                    stockLocationId: $SourcePs->getStockLocationId(),
                    totalCost: $afterTotalCost,
            $this->entityManager->flush();
            $this->entityManager->commit();
        } catch (\Throwable $e) {
            $this->entityManager->rollback();
            throw $e;
        }

        return [
            'stockSplitJoinId' => $StockSplitJoin->getId(),
            'successMessage' => 'admin.stock.join.approval_reject_complete',
        ];
    }

    private function effectiveJoinQuantity(\Eccube\Entity\DtbStockSplitJoinDetail $Detail): int
    {
        return \max(0, $Detail->getSplitJoinQuantity() - $Detail->getShortageQuantity());
    }
}
