    public function save(
        BaseInfo $MoveFromBaseInfo,
        BaseInfo $MoveToBaseInfo,
        Member $RegisteredMember,
        string $standardTotalPrice = '0',
        string $outboundTotalCost = '0',
        string $highTotalPrice = '0',
        string $regularTotalPrice = '0',
        ?int $subjectOfMoves = null,
        ?int $quantityOfMoves = null,
        ?string $trackingNo = null,
        ?string $memo = null,
        ?\DateTime $createDate = null,
    ): DtbStockMoveInstruction {
        $Instruction = new DtbStockMoveInstruction();
        $Instruction->setMoveFromBaseInfo($MoveFromBaseInfo);
        $Instruction->setMoveToBaseInfo($MoveToBaseInfo);
        $Instruction->setMoveFromPriceThreshold($MoveFromBaseInfo->getExpensiveThreshold1() ?? 0);
        $Instruction->setStandardTotalPrice($standardTotalPrice);
        $Instruction->setOutboundTotalCost($outboundTotalCost);
        $Instruction->setHighTotalPrice($highTotalPrice);
        $Instruction->setRegularTotalPrice($regularTotalPrice);
        $Instruction->setSubjectOfMoves($subjectOfMoves);
        $Instruction->setQuantityOfMoves($quantityOfMoves);
        $Instruction->setTrackingNo($trackingNo);
        $Instruction->setMemo($memo);
        $Instruction->setCreateDate($createDate ?? new \DateTime());
        $Instruction->setRegisteredMember($RegisteredMember);

        $this->entityManager->persist($Instruction);

        return $Instruction;
    }
}
