namespace Eccube\Service\Csv;

use Doctrine\ORM\EntityManagerInterface;
use Eccube\Common\EccubeConfig;
use Eccube\Controller\Admin\Order\OrderCsvController;
use Eccube\Entity\Master\OrderStatus;
use Eccube\Entity\Order;
use Eccube\Repository\DtbPlayerRepository;
use Eccube\Repository\Master\OrderStatusRepository;
use Eccube\Repository\OrderRepository;
use Eccube\Service\CsvExportService;
use Eccube\Service\CsvImportService;
use Symfony\Component\HttpFoundation\Response;
use Symfony\Component\HttpFoundation\StreamedResponse;
use Symfony\Contracts\Translation\TranslatorInterface;

class OrderCsv extends AbstractCsvService
{
    public function __construct(
        protected EntityManagerInterface $entityManager,
        protected TranslatorInterface $translator,
        protected EccubeConfig $eccubeConfig,
        protected CsvExportService $csvExportService,
        protected OrderRepository $orderRepository,
        protected DtbPlayerRepository $playerRepository,
        protected OrderStatusRepository $orderStatusRepository,
    ) {
        parent::__construct(
            $entityManager,
            $translator,
            $eccubeConfig,
            OrderCsvController::CSV_HEADER,
            OrderCsvController::REQUIRED_CSV_HEADER,
        );
    }

    /**
     * 出荷実績インポート用CSVを出力する
     *
     * @param array<int> $orderIdList
     */
    public function exportCsv(array $orderIdList): StreamedResponse
    {
        if (!$csvRows = $this->orderRepository->generateResultCsv($orderIdList)) {
            throw new \RuntimeException($this->translator->trans('admin.csv.error.export.not_registered'));
        }

        $response = new StreamedResponse();

        // $response->setCallback(function () use ($app, $csvRows) {
        $response->setCallback(function () use ($csvRows): void {
            // $csvService = $app['eccube.service.csv.export'];
            $csvService = $this->csvExportService;
            $csvService->fopen();

            // ヘッダ行出力
            $csvService->fputcsv(array_keys($this->csvHeader));

            // データ出力
            foreach ($csvRows as $csvRow) {
                $csvService->fputcsv($csvRow);
            }

            $csvService->fclose();
        });

        $filename = $this->createFileName('order_');
        $this->setCsvResponseHeader($response, $filename);

        log_info('CSV出力ファイル名', [$filename]);

        return $response;
    }

    /**
     * 出荷実績登録処理
     * 対応状況が出荷指示かつ出荷日が入力されている受注情報を更新
     *
     * @param array<string, string> $headers
     * @param CsvImportService<int, array<int|string, string>> $data
     *
     * @return array<int, array{order: Order, player: \Eccube\Entity\DtbPlayer|null}>
     */
    public function registerShippingResult(array $headers, int $headerSize, CsvImportService $data): array
    {
        $requiredHeaders = $this->requiredCsvHeader;

        $updatedOrders = [];
        foreach ($data as $row) {
            $rowIndex = $data->key() + 1;

            // ヘッダーサイズチェック
            $this->checkHeaderSize($headerSize, $row, $rowIndex);
            // CSV必須項目入力チェック
            $this->checkRequiredHeaders($requiredHeaders, $row, $rowIndex);

            $orderNumber = sprintf('%08d', $row['注文番号']);
            $order = $this->orderRepository->findOneBy(['order_number' => $orderNumber]);

            if ($order === null) {
                throw new \RuntimeException(sprintf($this->translator->trans('admin.csv.error.data.not_registered'), '注文番号', $row['注文番号'], $rowIndex));
            }
            if (empty($row['出荷日'])) {
                continue;
            }
            // 非会員の場合エラーを出力
            if ($order->getCustomer() === null) {
                throw new \RuntimeException($this->translator->trans('admin.csv.error.customer.not_member', ['%row%' => $rowIndex]));
            }
            try {
                $shippingDate = new \DateTime($row['出荷日']);
            } catch (\Exception $e) {
                $message = $this->translator->trans('admin.csv.error.exception.datetime', ['%row%' => $rowIndex, '%column%' => '出荷日']);
                throw new \RuntimeException($message, $rowIndex, $e);
            }
            $invoiceNumber = $row['送り状No.'];
            $newStatus = $this->orderStatusRepository->find(OrderStatus::DELIVERED);
            $isPreDeliv = $order->getOrderStatus()?->getId() === OrderStatus::PRE_DELIV;
            if ($isPreDeliv && $order->getShippingDate() === null) {
                $order->setOrderStatus($newStatus);
                $order
                    ->setShippingDate($shippingDate)
                    ->setInvoiceNumber($invoiceNumber);
                $updatedOrders[] = [
                    'order' => $order,
                    'player' => $this->playerRepository->findOneByCustomer($order->getCustomer()),
                ];
            }
            foreach ($order->getShippings() as $shipping) {
                $shipping->setShippingDate($shippingDate);
            }
        }

        $this->entityManager->flush();

        return $updatedOrders;
    }

    /**
     * 登録、更新時の画面表示
     *
     * @return Response
     */
    public function render(): Response
    {
        if (!empty($this->getFileName())) {
            try {
                $this->deleteTempData();
            } catch (\Exception $e) {
                // エラーが発生しても無視する
            }
        }

        return new Response();
    }
}
                'o' => ['name01', 'name02', 'kana01', 'kana02'],
            ];
            SqlUtil::multiTextQuery($qb, $texts, $searchColumns);
        }

        // multi
        if (isset($searchData['multi']) && StringUtil::isNotBlank($searchData['multi'])) {
            // 半角スペース、全角スペース、カンマで分割
            $texts = preg_split('/[\s, ]+/u', $searchData['multi']);
            $searchColumns = [
                'o' => ['company_name', 'message', 'note'],
                'oi' => ['product_code'],
            ];
            SqlUtil::multiTextQuery($qb, $texts, $searchColumns);
        }

        // status
        $filterStatus = false;
        if (isset($searchData['status']) && count($searchData['status']) > 0) {
            $qb
                ->andWhere($qb->expr()->in('o.OrderStatus', ':status'))
                ->setParameter('status', $searchData['status']);
            $filterStatus = true;
        }

        if (!$filterStatus) {
            // 未選択時のデフォルト検索: 購入処理中・キャンセル・引き渡し済み・対応中・返品以外を対象とする.
            // ※ 決済処理中(PENDING)・購入処理中(PROCESSING)は OrderStatusFilter により常時除外される.
            // ※ ステータス明示指定時は IN 条件を優先する（CANCEL は UI から選択可。
            //    IN_PROGRESS / PASSED / RETURNED は検索フォームから除外済み）.
            $qb->andWhere($qb->expr()->notIn('o.OrderStatus', ':status'))
                ->setParameter('status', [
                    OrderStatus::PROCESSING,
                    OrderStatus::CANCEL,
                    OrderStatus::IN_PROGRESS,
                    OrderStatus::PASSED,
                    OrderStatus::RETURNED,
                ]);
        }

        // payment
        if (!empty($searchData['payment']) && count($searchData['payment']) > 0) {
            $payments = [];
            foreach ($searchData['payment'] as $payment) {
                $payments[] = $payment->getId();
            }
            $qb
                ->leftJoin('o.Payment', 'p')
                ->andWhere($qb->expr()->in('p.id', ':payments'))
                ->setParameter('payments', $payments);
        }
    }

    /**
     * 新規登録画面および編集画面、下記には登録一覧ページ(常に新規)
     *
     * @return array<string, mixed>
     */
    #[Route(path: '/%eccube_admin_route%/order/waiting_tag', name: 'admin_order_waiting_tag', methods: ['GET', 'POST'])]
    #[Template(template: '@admin/Order/waiting_tag.twig')]
    public function index(Request $request): array
    {
        $defaultBaseInfo = $this->resolveDefaultSearchBaseInfo();
        $WaitingTag = new DtbWaitingTag();
        $WaitingTag->setBaseInfo($defaultBaseInfo);

        $builder = $this->formFactory->createBuilder(WaitingTagType::class, $WaitingTag);

        $event = new EventArgs(
            [
                'builder' => $builder,
            ],
            $request
        );
        $this->eventDispatcher->dispatch($event, EccubeEvents::ADMIN_ORDER_WAITING_TAG_INDEX_INITIALIZE);

        $form = $builder->getForm();

        if ($request->getMethod() === 'POST') {
            $form->handleRequest($request);
            $WaitingTag = $form->getData();

            // エラーを消すために新しいフォームを作成(店名を検索用として利用している為)
            $form = $this->formFactory->createBuilder(WaitingTagType::class, $WaitingTag)->getForm();
        }

        $BaseInfo = $WaitingTag->getBaseInfo() ?? $defaultBaseInfo;

        return [
            'WaitingTags' => $this->waitingTagRepository->findBy(['BaseInfo' => $BaseInfo]),
            'form' => $form->createView(),
        ];
    }

