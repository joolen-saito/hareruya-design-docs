    private function resolveBaseInfo(string $shopName): ?BaseInfo
    {
        if ($shopName === '') {
            return null;
        }

        return $this->baseInfoRepository->findOneBy(['shop_name' => $shopName]);
    }

    private function resolveFormats(string $commaNames): bool
    {
        $parts = $this->formatNameParts($commaNames);
        if ($parts === []) {
            return false;
        }
        foreach ($parts as $part) {
            if ($this->formatRepository->findOneBy(['name_jp' => $part]) === null) {
                return false;
            }
        }

        return true;
    }

    /**
     * @return ArrayCollection<int, MtbFormat>
     */
    private function resolveFormatsCollection(string $commaNames): ArrayCollection
    {
        $c = new ArrayCollection();
        foreach ($this->formatNameParts($commaNames) as $part) {
            $f = $this->formatRepository->findOneBy(['name_jp' => $part]);
            if ($f instanceof MtbFormat) {
                $c->add($f);
            }
        }

        return $c;
    }

