    public function __construct(
        private readonly ScheduleStoreAction $scheduleStoreAction,
        private readonly ScheduleUpdateAction $scheduleUpdateAction,
    ) {
    }

    /**
     * スケジュール新規登録（GET: フォーム表示、POST: 登録処理）
     *
     * @return RedirectResponse|array<string, mixed>
     */
    #[Route(path: '/%eccube_admin_route%/event/{eventId}/schedule/create', name: 'admin_schedule_create', requirements: ['eventId' => '\d+'], methods: ['GET', 'POST'])]
    #[Template(template: '@admin/Event/Schedule/edit.twig')]
    public function create(Request $request, #[MapEntity(id: 'eventId')] DtbEvent $Event): RedirectResponse|array
    {
        $EventDetail = new DtbEventDetail($Event);

        $builder = $this->formFactory->createBuilder(ScheduleType::class, $EventDetail, ['event' => $Event, 'is_new' => true]);

        $event = new EventArgs(
            [
                'builder' => $builder,
                'Event' => $Event,
            ],
            $request
        );
        $this->eventDispatcher->dispatch($event, EccubeEvents::ADMIN_EVENT_SCHEDULE_CREATE_INITIALIZE);

        $form = $builder->getForm();
        $form->handleRequest($request);

        if ($form->isSubmitted() && $form->isValid()) {
            /** @var DtbEventDetail $FormEventDetail */
            $FormEventDetail = $form->getData();
            $input = new ScheduleStoreInput($Event, $FormEventDetail, $this->getMember());

            try {
                $EventDetail = $this->scheduleStoreAction->handle($input);

                $event = new EventArgs(
                    [
                        'form' => $form,
                        'Event' => $Event,
                    ],
                    $request
                );
                $this->eventDispatcher->dispatch($event, EccubeEvents::ADMIN_EVENT_SCHEDULE_CREATE_COMPLETE);

                $this->addSuccess('admin.common.save_complete', 'admin');

                return $this->redirectToRoute('admin_schedule_edit', ['eventId' => $Event->getId(), 'eventDetailId' => $EventDetail->getId()]);
            } catch (\Exception $e) {
                $this->addError('admin.common.save_error', 'admin');
            }
        }

        $Member = $this->getMember();
        $isEditableBaseInfo = $Event->getBaseInfo() && $Member->isEditableShop($Event->getBaseInfo());

        return [
            'form' => $form->createView(),
            'Event' => $Event,
            'EventDetail' => $EventDetail,
            'isNew' => true,
            'isEditableBaseInfo' => $isEditableBaseInfo,
        ];
    }

    /**
     * スケジュール編集（GET: フォーム表示、POST: 更新処理）
     *
     * @return RedirectResponse|array<string, mixed>
     */
    #[Route(path: '/%eccube_admin_route%/event/{eventId}/schedule/{eventDetailId}/edit', name: 'admin_schedule_edit', requirements: ['eventId' => '\d+', 'eventDetailId' => '\d+'], methods: ['GET', 'POST'])]
    #[Template(template: '@admin/Event/Schedule/edit.twig')]
    public function edit(Request $request, #[MapEntity(id: 'eventId')] DtbEvent $Event, #[MapEntity(id: 'eventDetailId')] DtbEventDetail $EventDetail): RedirectResponse|array
    {
        if ($EventDetail->getEvent()->getId() !== $Event->getId()) {
            $this->addError('admin.common.error_invalid_request', 'admin');

            return $this->redirectToRoute('admin_event_edit', ['id' => $Event->getId()]);
        }

        $builder = $this->formFactory->createBuilder(ScheduleType::class, $EventDetail, ['event' => $Event, 'is_new' => false]);

        $event = new EventArgs(
            [
                'builder' => $builder,
                'Event' => $Event,
            ],
            $request
        );
        $this->eventDispatcher->dispatch($event, EccubeEvents::ADMIN_EVENT_SCHEDULE_EDIT_INITIALIZE);

        $form = $builder->getForm();
        $form->handleRequest($request);

        if ($form->isSubmitted() && $form->isValid()) {
            /** @var DtbEventDetail $EventDetail */
            $EventDetail = $form->getData();
            $input = new ScheduleUpdateInput($EventDetail, $this->getMember());

            try {
                $this->scheduleUpdateAction->handle($input);

                'label' => 'admin.event.schedule.is_entry',
                'required' => false,
            ])
            ->add('onlineEntryStartDays', IntegerType::class, [
                'required' => false,
                'data' => 0,
                'attr' => ['min' => 0],
                'constraints' => [
                    new GreaterThanOrEqual(0),
                ],
            ])
            ->add('onlineEntryStartTime', TimeType::class, [
                'required' => false,
                'widget' => 'single_text',
            ])
            ->add('onlineEntryEndDateDays', IntegerType::class, [
                'required' => false,
                'data' => 0,
                'attr' => ['min' => 0],
                'constraints' => [
                    new GreaterThanOrEqual(0),
                ],
            ])
            ->add('onlineEntryEndTime', TimeType::class, [
                'required' => false,
                'widget' => 'single_text',
            ])
            ->addEventListener(FormEvents::POST_SUBMIT, function (FormEvent $event) use ($Event): void {
                $form = $event->getForm();

                // オンライン受付ありかつ親イベントで参加費が有料の場合は、親イベントで支払方法の設定が必要
                $entryFlg = $form->get('entryFlg')->getData();
                if ($entryFlg && (int) $Event->getEntryFee() > 0 && $Event->getPayments()->isEmpty()) {
                    $form->get('entryFlg')->addError(new FormError(trans('form_error.schedule_credit_payment_required', [], 'validators')));
                }

                $values = array_combine(self::DATE_FIELDS, array_map(fn (string $fieldName) => $form->get($fieldName)->getData(), self::DATE_FIELDS));
                if ($values['repeatStartDate'] === null) {
                    return;
                }

                $buildEventDateTime = function (int $daysBefore, ?\DateTimeInterface $time) use ($values): ?\DateTimeInterface {
                    if ($time === null) {
                        return null;
                    }

                    return Carbon::parse($values['repeatStartDate'])
                        ->subDays($daysBefore)
                        ->setTimeFromTimeString($time->format('H:i:s'));
                };

                $eventStart = $buildEventDateTime(0, $values['startTime']);

                $toComparable = function (?\DateTimeInterface $dt, bool $isTimeOnly) use ($values): ?\DateTimeInterface {
                    if ($dt === null) {
                        return null;
                    }
                    if ($isTimeOnly) {
                        return Carbon::parse($values['repeatStartDate'])->setTimeFromTimeString($dt->format('H:i'));
                    }

                        continue;
                    }

                    $timeOnlyFields = [...self::TIME_ONLY_FIELDS, ...self::TIME_ONLY_FOR_COMPARISON];
                    $fieldTimeOnly = in_array($field, $timeOnlyFields, true);
                    $targetTimeOnly = in_array($target, $timeOnlyFields, true);
                    $after = $toComparable($fieldVal, $fieldTimeOnly);
                    $before = $toComparable($targetVal, $targetTimeOnly);
                    if ($after === null || $before === null) {
                        continue;
                    }

                    $valid = match ($op) {
                        '<' => $after < $before,
                        '<=' => $after <= $before,
                    };
                    if (!$valid) {
                        $form->get($field)->addError(new FormError(trans($msgKey, ['%field1%' => $label($field), '%field2%' => $label($target)], 'validators')));
                    }
                }

                if ($eventStart !== null) {
                    $onlineEntryStartDays = $form->get('onlineEntryStartDays')->getData();
                    $onlineEntryStartTime = $form->get('onlineEntryStartTime')->getData();
                    $onlineEntryEndDateDays = $form->get('onlineEntryEndDateDays')->getData();
                    $onlineEntryEndTime = $form->get('onlineEntryEndTime')->getData();

                    if ($onlineEntryStartDays !== null && $onlineEntryStartTime !== null && $onlineEntryEndDateDays !== null && $onlineEntryEndTime !== null) {
                        $onlineEntryStart = $buildEventDateTime($onlineEntryStartDays, $onlineEntryStartTime);
                        $onlineEntryEnd = $buildEventDateTime($onlineEntryEndDateDays, $onlineEntryEndTime);
                        // オンライン申込開始 >= オンライン申込終了 になる入力はエラー
                        if ($onlineEntryStart !== null && $onlineEntryEnd !== null && $onlineEntryStart >= $onlineEntryEnd) {
                            $form->get('onlineEntryStartTime')->addError(new FormError(trans('form_error.schedule_date_before', [
                                '%field1%' => trans('admin.event.repeat_schedule.online_entry.start_date_time'),
                                '%field2%' => trans('admin.event.repeat_schedule.online_entry.end_date_time'),
                            ], 'validators')));
                        }
                    }

                    if ($onlineEntryEndTime !== null) {
                        $onlineEntryEnd = $buildEventDateTime($onlineEntryEndDateDays ?? 0, $onlineEntryEndTime);
                        // オンライン申込終了 >= イベント開始時間 になる入力はエラー
                        if ($onlineEntryEnd !== null && $onlineEntryEnd >= $eventStart) {
                            $form->get('onlineEntryEndTime')->addError(new FormError(trans('form_error.schedule_date_before', [
                                '%field1%' => trans('admin.event.repeat_schedule.online_entry.end_date_time'),
                                '%field2%' => trans('admin.event.repeat_schedule.start_time'),
                            ], 'validators')));
                        }
                    }
                }
            });
    }

    /**
     * {@inheritdoc}
     */
    #[\Override]
    public function configureOptions(OptionsResolver $resolver): void
    {
        $resolver->setDefaults([
            'data_class' => null,
            'is_new' => true,
        ]);
        $resolver->setRequired('event');
        $resolver->setAllowedTypes('event', DtbEvent::class);
        $resolver->setAllowedTypes('is_new', 'bool');
    }

    /**
     * {@inheritdoc}
     */
    #[\Override]
    public function getBlockPrefix(): string
    {
        return 'admin_repeat_schedule';
    }
}

