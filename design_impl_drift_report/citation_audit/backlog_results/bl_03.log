            )
            ->groupBy('p.id')
            ->addGroupBy('p.name')
            ->addGroupBy('l.id')
            ->addGroupBy('l.code');

        // キーワード（商品名日/英）
        $multi = isset($searchData['multi']) ? trim((string) $searchData['multi']) : '';
