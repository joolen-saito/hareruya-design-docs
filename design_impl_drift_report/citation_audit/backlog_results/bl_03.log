namespace Eccube\Form\Type;

use Eccube\Common\EccubeConfig;
use Symfony\Component\Form\AbstractType;
use Symfony\Component\Form\Extension\Core\Type\RepeatedType;
use Symfony\Component\Form\Extension\Core\Type\TextType;
use Symfony\Component\OptionsResolver\Options;
use Symfony\Component\OptionsResolver\OptionsResolver;
use Symfony\Component\Validator\Constraints as Assert;

/**
 * Class RepeatedPasswordType
 */
class RepeatedPasswordType extends AbstractType
{
    /**
     * RepeatedPasswordType constructor.
     */
    public function __construct(protected EccubeConfig $eccubeConfig)
    {
    }

    /**
     * {@inheritdoc}
     */
    #[\Override]
    public function configureOptions(OptionsResolver $resolver): void
    {
        $resolver->setDefaults([
            'type' => TextType::class, // type password だと入力欄を空にされてしまうので、widgetで対応
            'invalid_message' => 'form_error.same_password',
            'required' => true,
            'error_bubbling' => false,
            'options' => [
                'constraints' => [
                    new Assert\Length([
                        'min' => $this->eccubeConfig['eccube_password_min_len'],
                        'max' => $this->eccubeConfig['eccube_password_max_len'],
                    ]),
                    new Assert\Regex([
                        'pattern' => $this->eccubeConfig['eccube_password_pattern'],
                        'message' => 'form_error.password_pattern_invalid',
                    ]),
                ],
            ],
            'first_options' => [
                'attr' => [
                    'placeholder' => trans('common.password_sample', [
                        '%min%' => $this->eccubeConfig['eccube_password_min_len'],
                        '%max%' => $this->eccubeConfig['eccube_password_max_len'], ]),
                ],
            ],
            'second_options' => [
                'attr' => [
                    'placeholder' => 'common.repeated_confirm',
                ],
            ],
            'first_notblank_message' => null,
            'second_notblank_message' => null,
        ]);

        $resolver->setNormalizer('first_options', function (Options $options, $value) {
            if ($options['first_notblank_message'] !== null) {
                $baseConstraints = $options['options']['constraints'] ?? [];
                $value['constraints'] = array_merge(
                    [new Assert\NotBlank(['message' => $options['first_notblank_message']])],
                    $baseConstraints,
                    $value['constraints'] ?? []
                );
            }

            return $value;
        });

        $resolver->setNormalizer('second_options', function (Options $options, $value) {
            if ($options['second_notblank_message'] !== null) {
                $baseConstraints = $options['options']['constraints'] ?? [];
                $value['constraints'] = array_merge(
                    [new Assert\NotBlank(['message' => $options['second_notblank_message']])],
                    $baseConstraints,
                    $value['constraints'] ?? []
                );
            }

            return $value;
        });
    }

    /**
     * {@inheritdoc}
     */
    #[\Override]
    public function getParent(): ?string
    {
        return RepeatedType::class;
    }

 * パスワード変更専用画面コントローラー.
 *
 * パスワードポリシー未準拠の会員がログイン後に遷移する専用画面。
 * パスワード変更が完了するとポリシー未準拠フラグを解除する。
 */
class PasswordChangeController extends AbstractController
{
    /**
     * @param UserPasswordHasherInterface $passwordHasher
     */
    public function __construct(
        private readonly UserPasswordHasherInterface $passwordHasher,
    ) {
    }

    /**
     * パスワード変更画面
     *
     * @return array<string, mixed>|RedirectResponse
     */
    #[IsGranted('ROLE_USER')]
    #[Route(path: '/mypage/password_change', name: 'mypage_password_change', methods: ['GET', 'POST'])]
    #[Template(template: 'Mypage/password_change.twig')]
    public function index(Request $request): array|RedirectResponse
    {
        if (!$request->getSession()->get(PasswordPolicyListener::SESSION_KEY)) {
            return $this->redirectToRoute('mypage');
        }

        /** @var Customer $Customer */
        $Customer = $this->getUser();
        $Customer->setPlainPassword('');

        $form = $this->formFactory->createBuilder(PasswordChangeType::class, $Customer)->getForm();
        $form->handleRequest($request);

        if ($form->isSubmitted() && $form->isValid()) {
            $password = $this->passwordHasher->hashPassword($Customer, (string) $Customer->getPlainPassword());
            $Customer->setPassword($password);
            $this->entityManager->flush();

            $request->getSession()->remove(PasswordPolicyListener::SESSION_KEY);

            return $this->redirectToRoute('mypage_password_change_complete');
        }

        return ['form' => $form->createView()];
    }

    /**
     * パスワード変更完了画面
     *
     * @return array<string, mixed>
     */
    #[IsGranted('ROLE_USER')]
    #[Route(path: '/mypage/password_change_complete', name: 'mypage_password_change_complete', methods: ['GET'])]
    #[Template(template: 'Mypage/password_change_complete.twig')]
    public function complete(): array
    {
        return [];
    }
                            return $this->redirectToRoute('entry_activate', [
                                'secret_key' => $Customer->getSecretKey(),
                            ]);
                        }
                }
            }
        }

        return [
            'form' => $form->createView(),
        ];
    }

    /**
     * 会員登録完了画面.
     *
     * @return array<empty>|null
     */
    #[Route(path: '/entry/complete', name: 'entry_complete', methods: ['GET'])]
    #[Template(template: 'Entry/complete.twig')]
    public function complete(): ?array
    {
        return [];
    }

    /**
     * 会員のアクティベート（本会員化）を行う.
     *
     * @param string $secret_key
     * @param string|null $qtyInCart
     *
     * @return array<string, mixed>|Response
     */
    #[Route(path: '/entry/activate/{secret_key}/{qtyInCart}', name: 'entry_activate', methods: ['GET'])]
    #[Template(template: 'Entry/activate.twig')]
    public function activate(Request $request, $secret_key, $qtyInCart = null): array|Response
    {
        $errors = $this->recursiveValidator->validate(
            $secret_key,
            [
                new Assert\NotBlank(),
                new Assert\Regex(
                    [
                        'pattern' => '/^[a-zA-Z0-9]+$/',
                    ]
                ),
            ]
        );

        if (!$this->session->has('eccube.login.target.path')) {
            $this->setLoginTargetPath($this->generateUrl('mypage', [], UrlGeneratorInterface::ABSOLUTE_URL));
        }

        if (!is_null($qtyInCart)) {
            return [
                'qtyInCart' => $qtyInCart,
            ];
        } elseif ($request->getMethod() === 'GET' && count($errors) === 0) {
            // 会員登録処理を行う
            try {
                $result = $this->entryActivate($request, $secret_key);

                return [
                    'qtyInCart' => $result,
                ];
            } catch (EntryAlreadyActivatedException $e) {
                return $this->render('Entry/activate_error.twig', ['error_type' => 'already_activated']);
            } catch (EntryInvalidSecretKeyException $e) {
                return $this->render('Entry/activate_error.twig', ['error_type' => 'forbidden']);
            } catch (EntryActivateFailedException $e) {
                return $this->render('Entry/activate_error.twig', ['error_type' => 'activate_failed']);
            }
        }

        return $this->render('Entry/activate_error.twig', ['error_type' => 'forbidden']);
    }

    /**
     * 会員登録処理を行う
     *
     * @throws EntryAlreadyActivatedException 既に本会員登録済みの場合
     * @throws EntryInvalidSecretKeyException 無効な secret_key の場合
     * @throws EntryActivateFailedException 本会員化後のスマレジ会員連携に失敗した場合
     */
    private function entryActivate(Request $request, string $secret_key): int
    {
        log_info('本会員登録開始');

        $Customer = $this->registerCustomerViewRepository->getProvisionalCustomerBySecretKey($secret_key);
        if ($Customer === null) {
            if ($this->registerCustomerViewRepository->isAlreadyActivatedBySecretKey($secret_key)) {
                throw new EntryAlreadyActivatedException();
            }

            throw new EntryInvalidSecretKeyException();
        }

        // ビューでお客様のステータスを更新する。
        $this->entityManager->getConnection()->executeQuery(
            'UPDATE registration_view SET customer_status_id = :status_id WHERE secret_key = :secret_key',
            [
                'status_id' => CustomerStatus::REGULAR,
                'secret_key' => $Customer->getSecretKey(),
            ]
        );

        log_info('本会員登録完了');

        $event = new EventArgs(
            [
                'Customer' => $Customer,
            ],
            $request
        );
        $this->eventDispatcher->dispatch($event, EccubeEvents::FRONT_ENTRY_ACTIVATE_COMPLETE);

        // スマレジ会員を作成し、採番された会員IDをdtb_playerへ保存
        $ActivatedCustomer = $this->linkSmaregiCustomer($secret_key);

        // メール送信
        $this->mailService->sendCustomerCompleteMail($Customer);

        // Assign session carts into customer carts
        $Carts = $this->cartService->getCarts();
        $qtyInCart = 0;
        foreach ($Carts as $Cart) {
            $qtyInCart += $Cart->getTotalQuantity();
        }

        if ($ActivatedCustomer instanceof Customer) {
            $this->security->login($ActivatedCustomer, 'form_login', 'customer');
        }

        if ($qtyInCart) {
            $this->cartService->save();
        }

        return $qtyInCart;
    }

    /**
     * EC-CUBE上の会員とスマレジ会員と紐付ける
     *
     * activate が扱う $Customer は読み取り専用ビュー (RegisterCustomerView) のため、
     * 書き込み可能な CustomerRepository から実体を引き直して dtb_player を更新する。
     *
     * @return Customer|null アクティベートされた会員
     *
     * @throws EntryActivateFailedException スマレジ会員連携に失敗した場合
     */
    private function linkSmaregiCustomer(string $secret_key): ?Customer
    {
        /** @var Customer|null $Customer */
        $Customer = $this->customerRepository->findOneBy(['secret_key' => $secret_key]);
        if ($Customer === null) {
            return null;
        }

        $Player = $Customer->getPlayer();
        if ($Player === null) {
            return $Customer;
        }

        // 既に連携済みなら何もしない (冪等).
        $smaregiId = $Player->getSmaregiId();
        if ($smaregiId !== null && $smaregiId !== '') {
            return $Customer;
        }

        // 同一会員のアクティベートが並行しても二重登録しないよう、Player 行を悲観ロックして直列化する。
        // ロック取得後に smaregi_id を再チェックし、先行リクエストが連携済みなら何もしない。

