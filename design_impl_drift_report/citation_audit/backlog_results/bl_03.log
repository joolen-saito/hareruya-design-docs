     * activate が扱う $Customer は読み取り専用ビュー (RegisterCustomerView) のため、
     * 書き込み可能な CustomerRepository から実体を引き直して dtb_player を更新する。
     *
     * @return Customer|null アクティベートされた会員
     *
     * @throws EntryActivateFailedException スマレジ会員連携に失敗した場合
     */
    private function linkSmaregiCustomer(string $secret_key): ?Customer
    {
        /** @var Customer|null $Customer */
        $Customer = $this->customerRepository->findOneBy(['secret_key' => $secret_key]);
        if ($Customer === null) {
            return null;
        }

        $Player = $Customer->getPlayer();
        if ($Player === null) {
            return $Customer;
        }

        // 既に連携済みなら何もしない (冪等).
        $smaregiId = $Player->getSmaregiId();
        if ($smaregiId !== null && $smaregiId !== '') {
            return $Customer;
        }

        // 同一会員のアクティベートが並行しても二重登録しないよう、Player 行を悲観ロックして直列化する。
        // ロック取得後に smaregi_id を再チェックし、先行リクエストが連携済みなら何もしない。
        $this->entityManager->beginTransaction();
        try {
            $this->entityManager->lock($Player, LockMode::PESSIMISTIC_WRITE);
            $this->entityManager->refresh($Player);

            $lockedSmaregiId = $Player->getSmaregiId();
            if ($lockedSmaregiId !== null && $lockedSmaregiId !== '') {
                // 先行リクエストが連携済みのため二重作成しない。
                $this->entityManager->commit();

                return $Customer;
            }

            $result = $this->smaregiCustomerService->createCustomer($Customer);

            if ($result['ok'] && !empty($result['smaregiId'])) {
                $Player->setSmaregiId($result['smaregiId']);
                $Player->setExistsSmaregiFlg(true);
                $this->entityManager->flush();
                $this->entityManager->commit();

                return $Customer;
            }

            // スマレジ API 失敗時はフラグ OFF のまま確定し、アクティベート失敗画面で終了する
            $this->markSmaregiLinkFailed($Player, $Customer->getId(), $result['error']);
            $this->entityManager->commit();

            throw new EntryActivateFailedException('スマレジ会員連携に失敗しました');
        } catch (EntryActivateFailedException $e) {
            throw $e;
        } catch (\Throwable $e) {
            if ($this->entityManager->getConnection()->isTransactionActive()) {
                $this->entityManager->rollback();
            }

            // 予期しない例外も連携失敗として扱い、アクティベート失敗画面へ遷移させる
            log_error('スマレジ会員連携処理で例外が発生しました(本会員化は完了済み)', [
                'customerId' => $Customer->getId(),
                'error' => $e->getMessage(),

codex
見積りの大きい箇所は実コードも確認しました。カードサジェストは既存 `/api/cards` を流用でき、入荷通知CSVは通知済み状態の永続化・送信処理・集計SQL・CSVヘッダーまで横断するため、前者は新規JS機能、後者はデータ永続化を主区分にしています。
apply patch
