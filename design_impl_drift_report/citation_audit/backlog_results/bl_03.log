     * 規格単位・商品×言語単位（まとめて入荷通知）の両方を集計対象とする。
     *
     * 通知待ち: 同一ユーザーが同一商品×言語を複数規格で登録していても1件としてカウント（いずれか1件でも未削除なら通知待ち）
     * 通知済み: 同一ユーザーの同一商品×言語に紐づく全依頼が削除済みの場合のみカウント
     *
     * @param array<string, mixed> $searchData
     *
     * @return list<array<string, int|string|null>>
    {
        if (!$this->productStockRepository->hasPositiveEccubeStockForProductAndLanguage($productId, $languageId, $baseInfoId)) {
            return;
        }

        $requests = $this->dtbProductRequestRepository->findPendingRestockRequestsByProductAndLanguage($productId, $languageId);
        if ($requests === []) {
            return;
        }

        foreach ($requests as $ProductRequest) {
            $this->sendMail($ProductRequest);
        }
    }

    /**
     * 再入荷通知リクエストを行った会員にメールを送信する(1件)
     */
    private function sendMail(DtbProductRequest $ProductRequest): void
    {
        $sent = $this->mailService->sendProductRestockNotificationMail($ProductRequest);
        if (!$sent) {
            log_error('入荷通知メールの送信に失敗しました。', [
                'product_request_id' => $ProductRequest->getId(),
                'product_class_id' => $ProductRequest->getProductClass()?->getId(),
            ]);
        }
    }
}

