    #[Route('/api/cards', name: 'api_deck_builder_cards_search', methods: ['GET', 'OPTIONS'])]
    public function searchCards(Request $request): JsonResponse
    {
        if ($request->isMethod('OPTIONS')) {
            return $this->createCorsResponse(new JsonResponse(null, Response::HTTP_NO_CONTENT));
        }

        $params = $request->query->all();
        if (!$this->isValidSearchParams($params)) {
            return $this->createErrorResponse(
                Response::HTTP_BAD_REQUEST,
                trans('api.deck_builder.common.invalid_request')
            );
        }

        $result = $this->cardRepository->findBySearchParams($params);

        return $this->createCorsResponse(new JsonResponse([
            'code' => Response::HTTP_OK,
            'total_count' => $result['total_count'],
            'cards' => $result['cards'],
        ], Response::HTTP_OK));
    }

    /**
     * @param array<string, mixed> $params
     */
    private function isValidSearchParams(array $params): bool
    {
        foreach (self::CONDITION_FIELDS as $config) {
            if (!$this->isValidEnumParam($params, $config['field'], $config['allowed'])) {
                return false;
            }
        }
        foreach (self::NUMERIC_FIELDS as $field) {
            if (!$this->isValidDigitParam($params, $field)) {
                return false;
            }
        }

        return true;
    }

