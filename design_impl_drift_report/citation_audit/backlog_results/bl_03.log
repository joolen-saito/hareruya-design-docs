        $qb = $conn->createQueryBuilder()
            ->select(
                'p.id AS product_id',
                'p.name AS product_name',
                'l.id AS language_id',
                'l.code AS language_code',
                'COUNT(DISTINCT CASE WHEN pr.deleted_at IS NULL THEN pr.player_id ELSE NULL END) AS pending_count',
                '(COUNT(DISTINCT pr.player_id) - COUNT(DISTINCT CASE WHEN pr.deleted_at IS NULL THEN pr.player_id ELSE NULL END)) AS deleted_count',
                'MIN((SELECT MIN(pc_min.price02) FROM dtb_product_class pc_min WHERE pc_min.product_id = p.id AND pc_min.language_id = l.id)) AS min_price',
