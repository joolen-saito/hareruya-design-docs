namespace Eccube\Service\Csv\Exporter;

use Eccube\Repository\DtbProductRequestRepository;
use Eccube\Service\CsvExportService;
use Symfony\Component\HttpFoundation\StreamedResponse;

class ProductRequestCsvExportService
{
    private const CSV_HEADER = [
        'product_id' => '商品ID',
        'language_id' => '言語ID',
        'product_name' => '商品名',
        'pending_count' => '通知待ち',
        'deleted_count' => '削除',
    ];

    public function __construct(
        protected CsvExportService $csvExportService,
        protected DtbProductRequestRepository $productRequestRepository,
    ) {
    }

    /**
     * @param array<string, mixed> $searchData
     */
    public function exportBySearchData(array $searchData): StreamedResponse
    {
        $rows = $this->productRequestRepository->getAnalysisSummary($searchData);

        $response = new StreamedResponse();
        $response->setCallback(function () use ($rows): void {
            $this->csvExportService->fopen();
            $this->csvExportService->fputcsv(array_values(self::CSV_HEADER));

            foreach ($rows as $row) {
                $orderedRow = array_map(
                    fn (string $key): string => (string) ($row[$key] ?? ''),
                    array_keys(self::CSV_HEADER),
                );
                $this->csvExportService->fputcsv($orderedRow);
            }

            $this->csvExportService->fclose();
        });

        $now = new \DateTime();
        $filename = 'request_report_'.$now->format('YmdHis').'.csv';
        $response->headers->set('Content-Type', 'application/octet-stream');
        $response->headers->set('Content-Disposition', 'attachment; filename='.$filename);

        return $response;
    }
}

