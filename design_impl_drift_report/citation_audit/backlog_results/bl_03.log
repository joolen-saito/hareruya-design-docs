{% extends 'default_frame.twig' %}

{% set mypageno = 'deckentry' %}
{% set body_class = 'mypage front_page p-deckentry-edit' %}

{% block stylesheet %}
    <link rel="stylesheet" href="{{ asset('assets/hareruya/css/hareruya-deck.css') }}">
    <link rel="stylesheet" href="{{ asset('assets/hareruya/css/hareruya-event.css') }}">
{% endblock %}

{% block javascript %}
<script{% if csp_nonce is defined %} nonce="{{ csp_nonce }}"{% endif %}>
$(function() {
    const $deckMain = $('#deckMain');
    const $deckSide = $('#deckSide');
    let selectedBoard = 'main';
    let currentFormatId = $('input[name="format"]:checked').val() || $('input[name="format"]').first().val();

    function persistCurrentFormatDraft() {
        if (!currentFormatId) { return; }
        $('#deckMain--' + currentFormatId).val($deckMain.val() || '');
        $('#deckSide--' + currentFormatId).val($deckSide.val() || '');
    }

    // フォーマット切り替え
    $('input[name="format"]').on('change', function() {
        persistCurrentFormatDraft();
        const formatId = $(this).val();
        currentFormatId = formatId;
        $deckMain.val($('#deckMain--' + formatId).val() || '');
        $deckSide.val($('#deckSide--' + formatId).val() || '');
    });

    $deckMain.on('input', persistCurrentFormatDraft);
    $deckSide.on('input', persistCurrentFormatDraft);

    // ボード選択切り替え
    $('input[name="board"]').on('change', function() {
        selectedBoard = $(this).val();
    });

    function addCardToDecklist(count) {
        const cardName = $('#cardNameInput').val().trim();
        if (!cardName) { return; }
        const line = count + ' ' + cardName + '\n';
        if (selectedBoard === 'main') {
            const current = $deckMain.val();
            $deckMain.val(current && !current.endsWith('\n') ? current + '\n' + line : current + line);
        } else {
            const current = $deckSide.val();
            $deckSide.val(current && !current.endsWith('\n') ? current + '\n' + line : current + line);
        }
        $('#cardNameInput').val('');
        $('[data-deckentry-card-suggest]').attr('aria-hidden', 'true');
    }

    // 枚数ボタン（固定値）
    $('.p-hareruya-deckentry-edit__num-btn').on('click', function() {
        addCardToDecklist(parseInt($(this).data('value'), 10));
    });

    // カスタム枚数追加
    $('.p-hareruya-deckentry-edit__num-submit').on('click', function() {
        const num = Number($('#cardNumInput').val());
        if (Number.isInteger(num) && num > 0) {
            addCardToDecklist(num);
        }
    });

    // カード名サジェスト
    $('#cardNameInput').on('input', function() {
        $('[data-deckentry-card-suggest]').attr('aria-hidden', $(this).val().trim().length === 0 ? 'true' : 'false');
    });

    $(document).on('click', '[data-deckentry-card-suggest-item]', function() {
        $('#cardNameInput').val($(this).text().trim());
        $('[data-deckentry-card-suggest]').attr('aria-hidden', 'true');
    });

    // MTGアリーナ形式インポート
    $('#copyArenaListButton').on('click', function() {
        const raw = $('#arenaDeckList').val();
        const { main, side } = parseArenaFormat(raw);
        $deckMain.val(main);
        $deckSide.val(side);
        $('#deckentry-import [data-js-modal-close]').trigger('click');
    });

    function parseArenaFormat(text) {
        const lines = text.split(/\r?\n/);
        const main = [];
        const side = [];
        let section = 'main';

        for (const line of lines) {
            const trimmed = line.trim();
            if (trimmed === '') {
                section = 'side';
                continue;
            }
            if (/^(Deck|Sideboard|Commander|Companion)$/i.test(trimmed)) {
                if (/^Sideboard$/i.test(trimmed)) { section = 'side'; }
                if (/^(Commander|Companion)$/i.test(trimmed)) { section = 'main'; }
                continue;
            }
            const m = trimmed.match(/^(\d+)\s+(.+)$/);
            if (!m) { continue; }
            const entry = m[1] + ' ' + m[2].split(' (')[0].trim();
            if (section === 'main') {
                main.push(entry);
            } else {
                side.push(entry);
            }
        }

        return { main: main.join('\n'), side: side.join('\n') };
    }

    // マイデッキ選択
    $(document).on('click', '.p-hareruya-deckentry-edit__mydeck-item', function() {
        $deckMain.val($(this).data('main') || '');
        $deckSide.val($(this).data('side') || '');
        persistCurrentFormatDraft();
        $('#deckentry-mydeck [data-js-modal-close]').trigger('click');
    });

    // how-to-import へのスクロール（グローバルJSがアンカー遷移を横取りするため明示的に実装）
    $('a[href="#how-to-import"]').on('click', function(e) {
        e.preventDefault();
        const $target = $('#how-to-import');
        if ($target.length) {
            $('html, body').animate({ scrollTop: $target.offset().top }, 300, function() {
                history.pushState(null, null, '#how-to-import');
            });
        }
    });

    // マイデッキ フォーマット絞り込み
    $('#select_format').on('change', function() {
        const val = $(this).val();
        if (val === '0') {
            $('.p-hareruya-deckentry-edit__mydeck-item').show();
        } else {
            $('.p-hareruya-deckentry-edit__mydeck-item').each(function() {
                $(this).toggle(String($(this).data('format')) === val);
            });
        }
    });
});
</script>
