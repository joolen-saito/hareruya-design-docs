    private function initializeColumnDefinitions(): void
    {
        $this->productIdColumn = ColumnDefinitions::productId();
        $this->languageIdColumn = ColumnDefinitions::languageId($this->em)->setRequired(true);
        $this->statusIdColumn = ColumnDefinitions::statusId()->setRequired(true);
        $this->isBranchPublishedColumn = ColumnDefinitions::branchStatusId()->setRequired(true);
