namespace Eccube\Service\Deck;

use Doctrine\ORM\EntityManagerInterface;
use Eccube\Entity\DtbDeck;
use Eccube\Entity\DtbDeckCard;
use Eccube\Entity\Master\MtbBoard;
use Eccube\Entity\Master\MtbCard;
use Eccube\Repository\Master\MtbCardRepository;

class CardListParserService
{
    public const UNKNOWN_CARD = 0;
    public const UNKNOWN_NAME = -1;

    private const MAIN_BOARD_HEADER = '/^(?:Deck|デッキ)$/u';
    private const SIDE_BOARD_HEADER = '/^(?:Sideboard|サイドボード|相棒|Companion)$/u';
    private const COMMANDER_HEADER = '/^(?:Commander|統率者)$/u';

    public function __construct(
        private readonly MtbCardRepository $cardRepository,
        private readonly EntityManagerInterface $entityManager,
    ) {
    }

    /**
     * カードリストテキストを解析してカード配列に変換する。
     *
     * @return array<int, array{count: int, cardId: int, name: string, row: int}>|int 正常時は配列、異常時はエラー行番号
     */
    public function decodeCardList(string $cardListText): array|int
    {
        $returnArray = [];

        if (empty($cardListText)) {
            return $returnArray;
        }

        $cardListArray = preg_split('/[\r\n]+/u', $cardListText);
        foreach ($cardListArray as $row => $cardText) {
            $cardText = trim($cardText);
            if ($cardText === '' || $this->isBoardHeaderLine($cardText)) {
                continue;
            }

            $rowNumber = $row + 1;

            // Arena形式: "4 Lightning Bolt (SET) 123" または標準形式: "4 Lightning Bolt"
            if (preg_match('/^(\d+) (\S.*) \((\S.*)\) (\d+)/', $cardText, $match) === 0
                && preg_match('/^(\d+) (\S.*)/', $cardText, $match) === 0) {
                return $rowNumber;
            }

            $count = (int) $match[1];
            $name = $this->getSimpleCardName(trim($match[2]));

            $cardId = $this->getValidCardId($name);
            if ($cardId !== null) {
                $overlapRow = array_search($cardId, array_column($returnArray, 'cardId'));
                if ($overlapRow === false) {
                    $returnArray[] = [
                        'count' => $count,
                        'cardId' => $cardId,
                        'name' => $name,
                        'row' => $rowNumber,
                    ];
                } else {
                    $returnArray[$overlapRow]['count'] += $count;
                }
            } else {
                $returnArray[] = [
                    'count' => $count,
                    'cardId' => self::UNKNOWN_NAME,
                    'name' => $name,
                    'row' => $rowNumber,
                ];
            }
        }

        return $returnArray;
    }

    /**
     * 解析済みカード配列を DtbDeckCard として登録する。
     *
     * @param array<int, array{count: int, cardId: int, name: string, row: int}> $cardArray
     */
    public function setDeckCards(array $cardArray, DtbDeck $Deck, int $boardId): void
    {
        $Board = $this->entityManager->getReference(MtbBoard::class, $boardId);

        foreach ($cardArray as $card) {
            if ($card['cardId'] === self::UNKNOWN_NAME) {
                continue;
            }

        $sellPrice = (int) bcfloor((string) $this->sellPriceColumn->getValue($row));
        $buyPrice = (int) bcfloor((string) $this->buyPriceColumn->getValue($row));
        $standardPrice = (int) bcfloor((string) $this->standardPriceColumn->getValue($row));
        $saleLimit = $this->saleLimitColumn->getValue($row);
        $productCode = $this->productCodeColumn->getValue($row);
        $smaregiAlignmentFlg = (int) ($this->smaregiAlignmentFlgColumn->getValue($row) ?? Constant::DISABLED);
        $smaregiProductCode = $this->smaregiProductCodeColumn->getValue($row);
        $sectionId = $this->sectionIdColumn->getValue($row);
        $memberId = $event->getUpdateUser()->getId();

        // 商品公開ステータスが「非公開」または「廃止」の場合、スマレジ連携フラグを自動的にOFFにする
        $statusId = $this->statusIdColumn->getValue($row);
        if ($statusId === ProductStatus::DISPLAY_HIDE || $statusId === ProductStatus::DISPLAY_ABOLISHED) {
            $smaregiAlignmentFlg = Constant::DISABLED;
        }

        /** @var ProductClassRepository $productClassRepository */
        $productClassRepository = $this->productClassRepository;

        $productClass = $this->findProductClass($productId);
        $productClassId = $productClass['productClassId'] ?? null;
        $saleFlg = ((int) ($productClass['saleFlg'] ?? 0)) === 1 ? 1 : 0;

        if ($productClassId !== null) {
            // 商品規格が登録済みの場合はupdateを行う

            // セールフラグが無効な場合は販売価格を基準価格で上書き
            if ($saleFlg === 0) {
                $sellPrice = $standardPrice;
            } else {
                // セールフラグが有効な場合、登録済みの販売価格(price02)を維持する
                $sellPrice = (int) ($productClass['price02'] ?? $sellPrice);
            }

            try {
                $productClassRepository->updateProductClass(
                    [
                        'id' => $productClassId,
                        'saleLimit' => $saleLimit,
                        'price02' => $sellPrice,
                        'buyPrice' => $buyPrice,
                        'standardPrice' => $standardPrice,
                        'smaregiAlignmentFlg' => $smaregiAlignmentFlg,
                        'smaregiProductCode' => $smaregiProductCode,
                        'sectionId' => $sectionId,
                        'languageId' => $languageId,
                        'saleFlg' => $saleFlg,
                    ]
                );
            } catch (UniqueConstraintViolationException $e) {
                $event->getMessageStore()
                    ->addNewProductSmaregiProductCodeDuplicateError(
                        $row->getRowNumber(),
                        $smaregiProductCode
                    );
                $event->skipRow();
                throw $e;
            }

            // TODO: スマレジ連携フラグが無効から有効に変更された場合、スマレジ連携のキューを作成する
            // SmaregiProductClassEventService::dispatchUpsert() を呼び出す
            // 既存のスマレジ連携フラグと比較して、無効から有効に変わった場合にキューを作成する必要がある
            // TODO:スマレジ連携状態の確認後、更新するか決める（https://joolen.slack.com/archives/C086TQW7VTK/p1777341428022289）
            $this->smaregiCsvImportUpsertCoordinator->deferIfEligible($productClassId, $smaregiAlignmentFlg, (string) $smaregiProductCode);

            // 価格履歴登録のためにProductClassを取得
            /** @var ProductClass $ProductClass */
            $ProductClass = $this->productClassRepository->find($productClassId);

            // updateの場合、販売/買取/基準価格のいずれかが変更された場合のみ履歴を登録する
            $oldSellPrice = (int) $productClass['price02'];
            $oldBuyPrice = (int) ($productClass['buyPrice'] ?? 0);
            $oldStandardPrice = (int) ($productClass['standardPrice'] ?? 0);
            if ($sellPrice !== $oldSellPrice || $buyPrice !== $oldBuyPrice || $standardPrice !== $oldStandardPrice) {
                $priceHistory = new DtbPriceHistory();
                $priceHistory->setProductClass($ProductClass);
                $priceHistory->setSellPrice($sellPrice);
                $priceHistory->setOldSellPrice($oldSellPrice);
                $priceHistory->setBuyPrice($buyPrice);
                $priceHistory->setOldBuyPrice($oldBuyPrice);
                $priceHistory->setStandardPrice($standardPrice);
            $this->cardsetIdColumn,
            $this->saleLimitColumn,
            $this->standardPriceColumn,
            $this->sellPriceColumn,
            $this->buyPriceColumn,
            $this->productCodeColumn,
            $this->smaregiAlignmentFlgColumn,
            $this->smaregiProductCodeColumn,
            $this->sectionIdColumn,
            $this->regionRestrictionIdColumn,
            $this->freeAreaColumn,
            $this->costUnitPriceColumn,
        ];
    }

    /**
     * 列を検証するロジックを取得する。
     *
     * @return array<RowValidatorInterface> 列全体を検証する定義を RowValidatorInterface で返す。
     */
    protected function getRowValidators(): array
    {
        return [
            new PriceConsistencyRowValidator($this->sellPriceColumn, $this->buyPriceColumn),
            new SmaregiConditionalRequiredValidator(
                $this->smaregiAlignmentFlgColumn,
                $this->smaregiProductCodeColumn,
