namespace Eccube\Service\Smaregi\Api;

use Eccube\Entity\SmaregiPlatformApiCallLog;
use GuzzleHttp\ClientInterface;
use Psr\Log\LoggerInterface;

/**
 * スマレジ POS 商品 API
 */
class SmaregiProductApiClient
{
    public function __construct(
        private readonly ClientInterface $httpClient,
        private readonly LoggerInterface $logger,
        private readonly SmaregiPlatformApiCallRecorder $platformApiCallRecorder,
    ) {
    }

    /**
     * 商品一覧取得（product_code で絞り込み）.
     *
     * @return array{statusCode:int,headers:array<string,array<string>>,body:string,json:array<int,array<string,mixed>>|null}
     */
    public function listByProductCode(
        string $apiUrl,
        string $contractId,
        string $accessToken,
        string $productCode,
    ): array {
        $url = sprintf('%s/%s/pos/products', rtrim($apiUrl, '/'), $contractId);

        return $this->requestGet(
            SmaregiPlatformApiCallLog::OPERATION_PRODUCT_LIST,
            $url,
            $accessToken,
            [
                'product_code' => $productCode,
            ],
            [
                'productCode' => $productCode,
            ],
        );
    }

    /**
     * @param array<string,mixed> $body
     *
     * @return array{statusCode:int,headers:array<string,array<string>>,body:string,json:array<string,mixed>|null}
     */
    public function create(
        string $apiUrl,
        string $contractId,
        string $accessToken,
        array $body,
    ): array {
        $url = sprintf('%s/%s/pos/products', rtrim($apiUrl, '/'), $contractId);

        return $this->request(
            SmaregiPlatformApiCallLog::OPERATION_PRODUCT_CREATE,
            'POST',
            $url,
            $accessToken,
            $body,
            [
                'productCode' => $body['productCode'] ?? '',
            ],
        );
    }

    /**
     * @param array<string,mixed> $body
     *
     * @return array{statusCode:int,headers:array<string,array<string>>,body:string,json:array<string,mixed>|null}
     */
    public function update(
        string $apiUrl,
        string $contractId,
        string $accessToken,
        string $smaregiProductId,
        array $body,
    ): array {
        $url = sprintf('%s/%s/pos/products/%s', rtrim($apiUrl, '/'), $contractId, rawurlencode($smaregiProductId));

        return $this->request(
            SmaregiPlatformApiCallLog::OPERATION_PRODUCT_UPDATE,
            'PATCH',
            $url,
            $accessToken,
            $body,
            [
                'smaregiProductId' => $smaregiProductId,
            ],
        );
    }

    /**
     * @return array{statusCode:int,headers:array<string,array<string>>,body:string,json:array<string,mixed>|null}
     */
    public function delete(
        string $apiUrl,
        string $contractId,
        string $accessToken,
        string $smaregiProductId,
    ): array {
        $url = sprintf('%s/%s/pos/products/%s', rtrim($apiUrl, '/'), $contractId, rawurlencode($smaregiProductId));

        return $this->request(
            SmaregiPlatformApiCallLog::OPERATION_PRODUCT_DELETE,
            'DELETE',
            $url,
            $accessToken,
            null,
            [
                'smaregiProductId' => $smaregiProductId,
            ],
        );
    }

    /**
     * @param array<string,string> $query
     * @param array<string,mixed>  $logContext
     *
     * @return array{statusCode:int,headers:array<string,array<string>>,body:string,json:array<int,array<string,mixed>>|null}
     */
    private function requestGet(
        string $operation,
        string $url,
        string $accessToken,
        array $query,
        array $logContext,
    ): array {
        $headers = [
            'Authorization' => 'Bearer '.$accessToken,
            'Accept' => 'application/json',
        ];
        $queryString = http_build_query($query);
        $requestUrl = $url.(str_contains($url, '?') ? '&' : '?').$queryString;
        $started = hrtime(true);

        try {
            $response = $this->httpClient->request('GET', $url, [
                'headers' => $headers,
                'query' => $query,
                'http_errors' => false,
            ]);
        } catch (\Throwable $e) {
            $this->recordProductGetFailure($operation, $requestUrl, $headers, $started, $e, $logContext);

            return [
                'statusCode' => 0,
                'headers' => [],
                'body' => '',
                'json' => null,
            ];
        }

        $statusCode = $response->getStatusCode();
        $body = (string) $response->getBody();
        /** @var array<string,array<string>> $responseHeaders */
        $responseHeaders = $response->getHeaders();
        $durationMs = (int) ((hrtime(true) - $started) / 1_000_000);

        $decoded = null;
        try {
            $raw = json_decode($body, true, 512, JSON_THROW_ON_ERROR);
            if (is_array($raw) && array_is_list($raw)) {
                /** @var array<int,array<string,mixed>> $decoded */
                $decoded = [];
                foreach ($raw as $item) {
                    if (is_array($item)) {
                        $decoded[] = $item;
                    }
                }
            }
        } catch (\Throwable) {
            $decoded = null;
        }

        try {
            $this->platformApiCallRecorder->record(
                $operation,
                'GET',
                $requestUrl,
                $headers,
                '',
                $statusCode,
                $responseHeaders,
                $body,
                $durationMs,
                null,
            );
        } catch (\Throwable $e) {
            $this->logger->error('Smaregi product platform API call log (success) record failed', $logContext + [
                'method' => 'GET',
                'url' => $requestUrl,
                'statusCode' => $statusCode,
                'error' => $e->getMessage(),
            ]);
        }

        try {
            $this->logger->info('Smaregi product API requested', $logContext + [
                'method' => 'GET',
                'url' => $requestUrl,
                'statusCode' => $statusCode,

