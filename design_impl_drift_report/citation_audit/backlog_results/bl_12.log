namespace Eccube\Service\Front\Mypage;

use Doctrine\ORM\EntityManagerInterface;
use Eccube\Entity\DtbDeck;
use Eccube\Entity\DtbPlayer;
use Eccube\Entity\Master\MtbDeckType;
use Eccube\Entity\Master\MtbDisp;
use Eccube\Repository\DtbDeckRepository;
use Eccube\Service\Front\Mypage\ActionInput\DeckEntryInput;

class DeckEntryAction
{
    public function __construct(
        private readonly EntityManagerInterface $entityManager,
        private readonly DtbDeckRepository $deckRepository,
    ) {
    }

    /**
     * @throws \Exception
     */
    public function handle(DeckEntryInput $input): DtbDeck
    {
        $now = new \DateTime();

        $Deck = $this->deckRepository->findOneBy([
            'Player' => $input->Player,
            'EventDetail' => $input->EventDetail,
            'Format' => $input->Format,
        ]);

        if ($Deck !== null) {
            $Deck
                ->setTextMain($input->textMain)
                ->setTextSide($input->textSide)
                ->setUpdateDate($now);
        } else {
            /** @var MtbDisp $Disp */
            $Disp = $this->entityManager->find(MtbDisp::class, MtbDisp::DISPLAY_HIDE);
            /** @var MtbDeckType $DeckType */
            $DeckType = $this->entityManager->find(MtbDeckType::class, MtbDeckType::EVENT_ID);

            $Deck = (new DtbDeck())
                ->setPlayer($input->Player)
                ->setPlayerName($this->resolvePlayerName($input->Player))
                ->setEventDetail($input->EventDetail)
                ->setEventNameJp($input->EventDetail->getEventNameJp())
                ->setEventNameEn($input->EventDetail->getEventNameEn())
                ->setEventDate($input->EventDetail->getStartDate())
                ->setFormat($input->Format)
                ->setTextMain($input->textMain)
                ->setTextSide($input->textSide)
                ->setPrivateFlg(true)
                ->setLatestFlg(false)
                ->setRegulationViolationFlg(false)
                ->setDisp($Disp)
                ->setDeckType($DeckType)
                ->setCreateDate($now)
                ->setUpdateDate($now);
        }

        $Deck->setMember(null);

        $this->entityManager->persist($Deck);
        $this->entityManager->flush();

        return $Deck;
    }

    private function resolvePlayerName(DtbPlayer $Player): string
    {
        $lastNameEn = $Player->getLastNameEn();
        $firstNameEn = $Player->getFirstNameEn();
        $lastNameJp = $Player->getLastNameJp();
        $firstNameJp = $Player->getFirstNameJp();

        if ($lastNameEn !== null && $lastNameEn !== '' && $firstNameEn !== null && $firstNameEn !== '') {
            return $lastNameEn.' '.$firstNameEn;
        }

        if ($lastNameJp !== null && $lastNameJp !== '' && $firstNameJp !== null && $firstNameJp !== '') {
            return $lastNameJp.' '.$firstNameJp;
        }

        foreach ([$lastNameEn, $firstNameEn, $lastNameJp, $firstNameJp] as $name) {
            if ($name !== null && $name !== '') {
                return $name;
            }
        }

        return '';
    }
}
                    ];
                } else {
                    $returnArray[$overlapRow]['count'] += $count;
                }
            } else {
                $returnArray[] = [
                    'count' => $count,
                    'cardId' => self::UNKNOWN_NAME,
                    'name' => $name,
                    'row' => $rowNumber,
                ];
            }
        }

        return $returnArray;
    }

    /**
     * 解析済みカード配列を DtbDeckCard として登録する。
     *
     * @param array<int, array{count: int, cardId: int, name: string, row: int}> $cardArray
     */
    public function setDeckCards(array $cardArray, DtbDeck $Deck, int $boardId): void
    {
        $Board = $this->entityManager->getReference(MtbBoard::class, $boardId);

        foreach ($cardArray as $card) {
            if ($card['cardId'] === self::UNKNOWN_NAME) {
                continue;
            }

            $DeckCard = new DtbDeckCard();
            $DeckCard->setDeck($Deck);
            $DeckCard->setBoard($Board);
            $DeckCard->setCount($card['count']);

            if ($card['cardId'] !== self::UNKNOWN_CARD) {
                $Card = $this->entityManager->getReference(MtbCard::class, $card['cardId']);
                $DeckCard->setCard($Card);
            }

            $this->entityManager->persist($DeckCard);
        }
    }

    private function isBoardHeaderLine(string $line): bool
    {
        return preg_match(self::MAIN_BOARD_HEADER, $line) === 1
            || preg_match(self::SIDE_BOARD_HEADER, $line) === 1
            || preg_match(self::COMMANDER_HEADER, $line) === 1;
    }

    /**
     * カード名から括弧や分割カードセパレータを正規化する。
     */
    private function getSimpleCardName(string $name): string
    {
        $name = preg_replace('/\(.*\)/', '', $name);

        return trim($name);
    }

