    /**
     * 整形済み CSV 行から印刷用データを組み立てる。
     *
     * pickingType を閾値ラベルとしてグループ化し、各グループを印刷ページへ分割する。
     * SQL 由来の行順はグループ内で維持する。
     *
     * @param list<array<string, string|int|null>> $formattedRows RestockListCsvRowFormatter 出力
     *
     * @return MoveTransferListPrintData
     */
    public function buildListDataFromCsvFormattedRows(array $formattedRows): array
    {
        // pickingType を閾値ラベルとしてグループ化する
        $rowsByThresholdLabel = [];
        foreach ($formattedRows as $formattedRow) {
            $thresholdLabel = (string) ($formattedRow['pickingType'] ?? '');
            if (!array_key_exists($thresholdLabel, $rowsByThresholdLabel)) {
                $rowsByThresholdLabel[$thresholdLabel] = [];
            }
            $rowsByThresholdLabel[$thresholdLabel][] = $formattedRow;
        }

        // 各グループを印刷ページへ分割する
        $groups = [];
        foreach ($rowsByThresholdLabel as $thresholdLabel => $rows) {
            $groups[] = [
                'thresholdLabel' => $thresholdLabel,
                'pages' => $this->buildPrintPagesForThresholdGroup($rows),
            ];
        }

        return [
            'createdAt' => (new \DateTime('now', new \DateTimeZone('Asia/Tokyo')))->format('Y/m/d H:i:s'),
            'maxPageRows' => self::MAX_PAGE_ROWS,
            'groups' => $groups,
        ];
    }

