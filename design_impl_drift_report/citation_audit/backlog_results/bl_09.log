namespace Eccube\Service\Admin\Stock;

use Doctrine\DBAL\LockMode;
use Doctrine\ORM\EntityManagerInterface;
use Eccube\Entity\DtbStockApprovalList;
use Eccube\Entity\Master\MtbStockChangeTypeDetail;
use Eccube\Entity\Master\MtbStockHistorySourceType;
use Eccube\Entity\Master\MtbStockSplitJoinStatus;
use Eccube\Repository\DtbStockApprovalListRepository;
use Eccube\Repository\DtbStockSplitJoinDetailRepository;
use Eccube\Repository\Master\MtbStockChangeTypeDetailRepository;
use Eccube\Repository\Master\MtbStockHistorySourceTypeRepository;
use Eccube\Repository\Master\MtbStockSplitJoinStatusRepository;
use Eccube\Service\Admin\Stock\ActionInput\StockSplitApprovalApproveInput;
use Eccube\Service\EntityManager\ProductStockEntityManager;
use Eccube\Service\EntityManager\StockHistoryEntityManager;
use Eccube\Service\EntityManager\StockSplitJoinStatusHistoryEntityManager;

/**
 * 在庫分割の承認処理。
 */
class StockSplitApprovalApproveAction
{
    public function __construct(
        private readonly DtbStockApprovalListRepository $stockApprovalListRepository,
        private readonly DtbStockSplitJoinDetailRepository $stockSplitJoinDetailRepository,
        private readonly MtbStockSplitJoinStatusRepository $mtbStockSplitJoinStatusRepository,
        private readonly MtbStockChangeTypeDetailRepository $stockChangeTypeDetailRepository,
        private readonly MtbStockHistorySourceTypeRepository $stockHistorySourceTypeRepository,
        private readonly ProductStockEntityManager $productStockEntityManager,
        private readonly StockHistoryEntityManager $stockHistoryEntityManager,
        private readonly EntityManagerInterface $entityManager,
        private readonly StockSplitJoinStatusHistoryEntityManager $statusHistoryEntityManager,
    ) {
    }

    /**
     * @return array{stockSplitJoinId: int, successMessage?: string, errorMessage?: string}
     */
    public function handle(StockSplitApprovalApproveInput $input): array
    {
        $StockSplitJoin = $input->StockSplitJoin;
        $Member = $input->Member;

        $StatusCompleted = $this->mtbStockSplitJoinStatusRepository->find(MtbStockSplitJoinStatus::RECEIPT_COMPLETED);
        if ($StatusCompleted === null) {
            throw new \LogicException('StockSplitApprovalApproveAction requires RECEIPT_COMPLETED status in master.');
        }

        $splitInboundType = $this->stockChangeTypeDetailRepository->find(MtbStockChangeTypeDetail::SPLIT_INBOUND);
        $historySourceType = $this->stockHistorySourceTypeRepository->find(MtbStockHistorySourceType::STOCK_SPLIT_EDIT);
        if ($splitInboundType === null || $historySourceType === null) {
            throw new \LogicException('StockSplitApprovalApproveAction requires stock change type and history source type masters.');
        }

        $now = new \DateTime();

        $this->entityManager->beginTransaction();
        try {
            $this->entityManager->lock($StockSplitJoin, LockMode::PESSIMISTIC_WRITE);
            $this->entityManager->refresh($StockSplitJoin);

            $splitJoinMemo = trim($input->splitJoinMemo);
            $StockSplitJoin->setSplitJoinMemo($splitJoinMemo !== '' ? $splitJoinMemo : null);

            $currentStatusId = $StockSplitJoin->getStockSplitJoinStatus()->getId();
            if ($currentStatusId !== MtbStockSplitJoinStatus::SPLIT_APPROVAL_WAITING) {
                $this->entityManager->rollback();
                $joinId = (int) ($StockSplitJoin->getId() ?? 0);
                if ($currentStatusId === MtbStockSplitJoinStatus::RECEIPT_COMPLETED) {
                    return [
                        'stockSplitJoinId' => $joinId,
                        'successMessage' => 'admin.stock.split.approval_approve_complete',
                    ];
                }

                return [
                    'stockSplitJoinId' => $joinId,
                    'errorMessage' => 'admin.stock.split.approval_status_error',
                ];
            }

            $Destinations = $this->stockSplitJoinDetailRepository->findByStockSplitJoin($StockSplitJoin);

            $srcCode = (string) ($StockSplitJoin->getProductStock()->getProductClass()->getCode() ?? '');
            $destCodes = [];
            foreach ($Destinations as $Detail) {
                $destCodes[] = (string) ($Detail->getSubjectProductStock()->getProductClass()->getCode() ?? '');
            }
            $splitInboundReason = '在庫分割による加算 分割元：'.$srcCode.' 分割先：'.implode('、', array_filter($destCodes)).' 在庫結合分割番号：'.$StockSplitJoin->getId();

            // 移動分の総原価: 分割元総原価 × (分割数 / 分割元在庫数)
            $srcStock = $StockSplitJoin->getStock();
            $movedCost = '0';
            if ($srcStock > 0) {
                $movedCost = bcmul(
                    bcdiv($StockSplitJoin->getTotalCost(), (string) $srcStock, 8),
                    (string) $StockSplitJoin->getSplitJoinQuantity(),
                    2
                );
            }

            // 全分割先の買取金額合計（個数×買取価格の合計）・個数合計を事前集計
            $totalBuySubtotal = '0';
            $totalDestinationQty = '0';
            foreach ($Destinations as $Detail) {
                if ($Detail->getSplitJoinQuantity() <= 0) {
                    continue;
                }
                $buyPriceForSum = (string) ($Detail->getSubjectProductStock()->getProductClass()->getBuyPrice() ?? 0);
                $totalBuySubtotal = bcadd($totalBuySubtotal, bcmul($buyPriceForSum, (string) $Detail->getSplitJoinQuantity(), 2), 2);
                $totalDestinationQty = bcadd($totalDestinationQty, (string) $Detail->getSplitJoinQuantity(), 0);
            }

            // 各分割先の配分額を先に計算してスナップショットを保持する（端数調整のため）
            $allocations = [];
            $maxNumerator = '-1';
            $maxNumeratorIdx = -1;

            foreach ($Destinations as $Detail) {
                $qty = (string) $Detail->getSplitJoinQuantity();
                if (bccomp($qty, '0', 0) <= 0) {
                    continue;
                }
                $SubjectProductStock = $Detail->getSubjectProductStock();
                $this->entityManager->lock($SubjectProductStock, LockMode::PESSIMISTIC_WRITE);
                $this->entityManager->refresh($SubjectProductStock);

                $buyPrice = (string) ($SubjectProductStock->getProductClass()->getBuyPrice() ?? 0);

                // 分割先の仕入総価格 = 移動分の総原価 × (分割先個数×買取価格 / 全分割先個数×買取価格合計)
                // 買取価格が全て0の場合は個数比率で按分する（フォールバック）
                if (bccomp($totalBuySubtotal, '0', 2) > 0) {
                    $numerator = bcmul($buyPrice, $qty, 2);
                    $denominator = $totalBuySubtotal;
                } else {
                    $numerator = $qty;
                    $denominator = $totalDestinationQty;
                }
                $addCost = bccomp($denominator, '0', 0) > 0
                    ? bcround(bcmul($movedCost, bcdiv($numerator, $denominator, 8), 8), 0)
                    : '0';

                $idx = count($allocations);
                $allocations[] = [
                    'SubjectProductStock' => $SubjectProductStock,
                    'qty' => $qty,
                    'addCost' => $addCost,
                    'buyPrice' => $buyPrice,
                    'currentStock' => $SubjectProductStock->getStock() ?? '0',
                    'currentTotalCost' => $SubjectProductStock->getTotalCost(),
                    'unitCostBefore' => $SubjectProductStock->getUnitCost(),
                ];

                if (bccomp($numerator, $maxNumerator, 2) >= 0) {
                    $maxNumerator = $numerator;
                    $maxNumeratorIdx = $idx;
                }
            }

            // 端数調整: 各行の丸め誤差により合計が movedCost の整数値とずれる場合、
            // 比率が最大の分割先に差分を加減算して合計を movedCost の整数値と一致させる。
            if ($maxNumeratorIdx >= 0) {
                $movedCostInt = (int) bcround($movedCost, 0);
                $sumAddCost = (int) array_sum(array_map(static fn (array $a): int => (int) $a['addCost'], $allocations));
                $remainder = $movedCostInt - $sumAddCost;
                if ($remainder !== 0) {
                    $allocations[$maxNumeratorIdx]['addCost'] = (string) ((int) $allocations[$maxNumeratorIdx]['addCost'] + $remainder);
                }
            }

            foreach ($allocations as $alloc) {
                $SubjectProductStock = $alloc['SubjectProductStock'];
                $addCost = $alloc['addCost'];
                $qty = $alloc['qty'];
                $currentStock = $alloc['currentStock'];
                $currentTotalCost = $alloc['currentTotalCost'];
                $unitCostBefore = $alloc['unitCostBefore'];

                $newStock = bcadd($currentStock, $qty, 0);
                $newTotalCost = bcadd($currentTotalCost, $addCost, 0);
                $unitCostAfter = bccomp($newStock, '0', 0) > 0
                    ? bcround(bcdiv($newTotalCost, $newStock, 8), 0)
                    : '0';

                $ProductClass = $SubjectProductStock->getProductClass();
                $this->productStockEntityManager->save(
                    ProductStock: $SubjectProductStock,
                    ProductClass: $ProductClass,
                    BaseInfo: $SubjectProductStock->getBaseInfo(),
                    stock: $newStock,
                    pickUpFlg: $SubjectProductStock->getPickUpFlg(),
                    stockLocationId: $SubjectProductStock->getStockLocationId(),
                    totalCost: $newTotalCost,
                );

                $this->stockHistoryEntityManager->save(
                    ProductStock: $SubjectProductStock,
                    StockChangeTypeDetail: $splitInboundType,
                    oldStock: $currentStock,
                    stock: $newStock,
                    stockChangeQuantity: $qty,
                    sellPrice: (int) ($ProductClass->getPrice02() ?? 0),
                    unitCostPriceBefore: $unitCostBefore,
                    unitCostPriceAfter: $unitCostAfter,
                    totalCostPriceBefore: $currentTotalCost,
                    totalCostPriceAfter: $newTotalCost,
                    stockChangeReason: $splitInboundReason,
                    shortageReason: null,
                    HistorySourceType: $historySourceType,
                    historySourceId: $StockSplitJoin->getId(),
                    registeredAt: $now,
                    RegisteredMember: $Member,
                    operatorMemberName: $Member !== null ? $Member->getName() : null,
                );
            }

            $StockSplitJoin->setStockSplitJoinStatus($StatusCompleted);
            $StockSplitJoin->setRejectedMemo(null);
            $StockSplitJoin->setUpdateDate($now);
            if ($Member !== null) {
                $StockSplitJoin->setUpdater($Member);
            }

            $historyMember = $Member ?? $StockSplitJoin->getRegisteredMember();
            $this->statusHistoryEntityManager->save(null, $StockSplitJoin, $StatusCompleted, $historyMember, $now);

            $StockApprovalList = $this->stockApprovalListRepository->findOneBy([
                'HistorySourceType' => $historySourceType,
                'historySourceId' => $StockSplitJoin->getId(),
            ]);
            if ($StockApprovalList !== null) {
                $StockApprovalList->setApprovalStatus(DtbStockApprovalList::APPROVAL_STATUS_APPROVED);
                $StockApprovalList->setApprovedDate($now);
                $StockApprovalList->setApprovalMember($Member);
            }

            $this->entityManager->flush();
            $this->entityManager->commit();
        } catch (\Throwable $e) {
            $this->entityManager->rollback();
            throw $e;
        }

