    /**
     * ピック・出庫承認申請画面のピック表PDF出力
     * 別ウィンドウで表示するため、JSONレスポンスでHTMLを返す
     */
    #[Route(path: '/%eccube_admin_route%/product/stock/move/outbound_approval_request/{id}/pick-list-pdf-export', requirements: ['id' => '\d+'], name: 'admin_stock_move_outbound_approval_request_pick_list_pdf_export', methods: ['POST'])]
    public function outboundApprovalRequestPickListPdfExport(Request $request, #[MapEntity(id: 'id')] DtbStockMoveTransfer $StockMoveTransfer): JsonResponse
    {
        $redirectUrl = $this->generateUrl('admin_stock_move_outbound_approval_request', ['id' => $StockMoveTransfer->getId()]);

        try {
            $this->isTokenValid();
        } catch (AccessDeniedHttpException) {
            return $this->json(['success' => false, 'redirectUrl' => $redirectUrl], Response::HTTP_FORBIDDEN);
        }

        if ($StockMoveTransfer->getMoveTransferStatus()->getId() !== MtbStockMoveTransferStatus::STATUS_NEW) {
            $this->addError('admin.stock.move.pick_list_export.invalid_status', 'admin');

            return $this->json(['success' => false, 'redirectUrl' => $redirectUrl]);
        }

        /** @var Member $Member */
        $Member = $this->getUser();
        $moveFromBaseInfo = $StockMoveTransfer->getMoveFromBaseInfo();
        if ($moveFromBaseInfo === null) {
            $this->addError('admin.stock.move.pick_list_export.unauthorized', 'admin');

            return $this->json(['success' => false, 'redirectUrl' => $redirectUrl]);
        }

        $editableShopIds = $Member
            ->getMemberBaseInfos()
            ->map(fn ($memberBaseInfo) => $memberBaseInfo->getBaseInfo()->getId())
            ->toArray();

        if (!in_array($moveFromBaseInfo->getId(), $editableShopIds, true)) {
            $this->addError('admin.stock.move.pick_list_export.unauthorized', 'admin');

            return $this->json(['success' => false, 'redirectUrl' => $redirectUrl]);
        }

        $html = $this->renderView('@admin/Stock/MoveTransfer/pick_list.twig', [
            'PickList' => $this->stockMoveTransferListPdfFormatter->buildPickListDataByStockMoveTransferIds(
                [$StockMoveTransfer->getId()],
            ),
            'StockMoveTransfer' => $StockMoveTransfer,
        ]);

        $response = $this->json(['success' => true, 'html' => $html]);

        $event = new EventArgs(
            [
                'response' => $response,
                'StockMoveTransfer' => $StockMoveTransfer,
            ],
            $request
        );
        $this->eventDispatcher->dispatch($event, EccubeEvents::ADMIN_STOCK_MOVE_OUTBOUND_APPROVAL_REQUEST_PICK_LIST_PDF_EXPORT);

        return $response;
    }

