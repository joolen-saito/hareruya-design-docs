    #[ORM\Column(name: 'shop_front_flg', type: Types::BOOLEAN, options: ['default' => false, 'comment' => '店頭販売用フラグ'])]

    /**
     * 日次集計向けに、受注金額・原価・販売数量・販売件数を店舗(base_info)ごとに集計する。
     * 総売上(order_amount_order)は値引き前金額（ポイント・クーポン値引きは考慮しない）に送料・手数料を含めた額。
     *
     * @return array<int, array<string, mixed>>
     */
    public function aggregateOrderSummaryByBaseInfo(\DateTimeInterface $from, \DateTimeInterface $to): array
    {
        return $this->getEntityManager()->getConnection()->fetchAllAssociative(
            <<<'SQL'
SELECT
    o.base_info_id,
    COALESCE(SUM(o.subtotal + o.delivery_fee_total + o.charge), 0) AS order_amount_order,
    COALESCE(SUM(order_cost.total_cost), 0) AS cost,
    COALESCE(SUM(order_cost.sale_quantity), 0) AS sale_quantity,
    COUNT(o.id) AS buyer_count
FROM dtb_order o
LEFT JOIN (
    SELECT
        oi.order_id,
        COALESCE(SUM(oi.total_cost), 0) AS total_cost,
        -- 販売数量は商品明細の数量のみを合算する（送料・手数料・値引き・ポイント明細の数量は含めない）
        COALESCE(SUM(CASE WHEN oi.order_item_type_id = :productItemTypeId THEN oi.quantity ELSE 0 END), 0) AS sale_quantity
    FROM dtb_order_item oi
    GROUP BY oi.order_id
) order_cost ON order_cost.order_id = o.id
WHERE
    o.base_info_id IS NOT NULL
    AND o.order_date >= :summaryDateFrom
    AND o.order_date <= :summaryDateTo
GROUP BY o.base_info_id
SQL,
            [
                'summaryDateFrom' => $from->format('Y-m-d H:i:s'),
                'summaryDateTo' => $to->format('Y-m-d H:i:s'),
                'productItemTypeId' => OrderItemType::PRODUCT,
            ]
        );
    }

    /**
     * 日次集計向けに、買取件数・買取金額を集計する。
     * ネット買取(dtb_buy_order)は本店(root)に集約し、店頭買取(dtb_otc_buy_order)は店舗ごとに集計する。
     * 集計日(申込日)はネット買取が order_date、店頭買取が apply_date で絞り込む。
     *
     * @return array<int, array<string, mixed>>
     */
    public function aggregatePurchaseSummaryByBaseInfo(int $rootBaseInfoId, \DateTimeInterface $from, \DateTimeInterface $to): array
    {
        return $this->getEntityManager()->getConnection()->fetchAllAssociative(
            <<<'SQL'
SELECT
    purchase_base.base_info_id,
    SUM(purchase_base.purchase_count) AS purchase_count,
    SUM(purchase_base.purchase_amount) AS purchase_amount
FROM (
    SELECT
        CAST(:rootBaseInfoId AS INTEGER) AS base_info_id,
        COUNT(bo.id) AS purchase_count,
        COALESCE(
            SUM(
                CEIL(
                    (
                        COALESCE(main_card_sum.main_total, 0)
                        + COALESCE(indiv_sum.indiv_total, 0)
                    ) / 10.0
                ) * 10
            ),
            0
        ) AS purchase_amount
    FROM dtb_buy_order bo
    LEFT JOIN (
        SELECT
            bmc.buy_order_id,
            SUM(
                CASE
                    WHEN bmc.sale_flg THEN COALESCE(bmc.price, 0) * COALESCE(bmc."count", 0)
                    ELSE 0
                END
            ) AS main_total
        FROM dtb_buy_main_card bmc
        GROUP BY bmc.buy_order_id
    ) main_card_sum ON main_card_sum.buy_order_id = bo.id
    LEFT JOIN (
        SELECT
            biip.buy_order_id,
            SUM(
                CASE
                    WHEN biip.sale_flg THEN COALESCE(biip.price, 0) * COALESCE(biip.quantity, 0)
                    ELSE 0
                END
            ) AS indiv_total
        FROM dtb_buy_order_indivisual_input_product biip
        GROUP BY biip.buy_order_id
    ) indiv_sum ON indiv_sum.buy_order_id = bo.id
    WHERE
        bo.auto_approval_flg = TRUE
        AND bo.order_date >= :summaryDateFrom
        AND bo.order_date <= :summaryDateTo
    GROUP BY base_info_id

    UNION ALL

    SELECT
        obo.base_info_id,
        COUNT(obo.id) AS purchase_count,
        COALESCE(SUM(obo.total_price), 0) AS purchase_amount
    FROM dtb_otc_buy_order obo
    WHERE
        obo.base_info_id IS NOT NULL
        AND obo.cancel_date IS NULL
        AND obo.apply_date >= :summaryDateFrom
        AND obo.apply_date <= :summaryDateTo
    GROUP BY obo.base_info_id
) purchase_base
GROUP BY purchase_base.base_info_id
SQL,
            [
                'summaryDateFrom' => $from->format('Y-m-d H:i:s'),
                'summaryDateTo' => $to->format('Y-m-d H:i:s'),
                'rootBaseInfoId' => $rootBaseInfoId,
            ]
        );
    }

    /**
     * 日次集計向けに、廃棄数量を店舗(base_info)ごとに集計する。
     * - 在庫変動区分が廃棄(MtbStockChangeType::DISPOSAL)の在庫履歴が対象
     * - 詳細区分のうち「廃棄(他事業移動)」「廃棄(イベント商品)」は対象外
     * - 集計日は在庫変動履歴の登録日(registered_at)
     * - 在庫変動履歴は減算分がマイナスで入るため、合計を符号反転してプラスにする
     *   （廃棄(却下)による戻しは正の値で入り、ここで差し引かれる）
     *
     * @return array<int, array<string, mixed>>
     */
     * 在庫移動指示削除（送り状No登録後は削除不可）
     */
    #[Route(path: '/%eccube_admin_route%/product/stock/move-instruction/{id}/delete', name: 'admin_stock_move_instruction_delete', requirements: ['id' => '\d+'], methods: ['POST'])]
    public function delete(Request $request, int $id): RedirectResponse
    {
        $this->isTokenValid();

        $Instruction = $this->stockMoveInstructionRepository->find($id);
        if ($Instruction === null) {
            throw new NotFoundHttpException();
        }

        try {
            $this->deleteInstruction($Instruction);
        } catch (StockMoveInstructionDeleteException) {
            $this->addError('admin.stock.move_instruction.delete_error_after_tracking', 'admin');

            return $this->redirectToRoute('admin_stock_move_instruction_detail', ['id' => $id]);
        }

        $event = new EventArgs(
            [
                'Instruction' => $Instruction,
            ],
            $request
        );
        $this->eventDispatcher->dispatch($event, EccubeEvents::ADMIN_STOCK_MOVE_INSTRUCTION_DELETE_COMPLETE);

        $this->addSuccess('admin.common.delete_complete', 'admin');

        return $this->redirectToRoute('admin_stock_move_instruction_list', ['resume' => '1']);
    }

    /**
     * 在庫移動指示一覧検索
     *
     * @param array<string, mixed> $searchData
     *
     * @return list<DtbStockMoveInstruction>
     */
    /**
     * 在庫移動指示削除（送り状No未登録のみ可。紐づく Transfer の move_instruction_id / luggage_no を null にしてから削除）
     *
     * @throws StockMoveInstructionDeleteException 送り状No.登録済みの場合は削除不可
     */
    private function deleteInstruction(DtbStockMoveInstruction $Instruction): void
    {
        $trackingNo = $Instruction->getTrackingNo();
        if ($trackingNo !== null && $trackingNo !== '') {
            throw new StockMoveInstructionDeleteException();
        }

        $Moves = $this->stockMoveTransferRepository->findBy(
            ['moveInstructionId' => $Instruction->getId()],
            ['id' => 'ASC']
        );
        foreach ($Moves as $Move) {
            $Move->setTrackingNo(null);
            $Move->setMoveInstructionId(null);
        }

        $this->entityManager->remove($Instruction);
        $this->entityManager->flush();
    }

    /**
     * 送り状CSV出力
     */
    #[Route(path: '/%eccube_admin_route%/product/stock/move-instruction/labels', name: 'admin_stock_move_instruction_labels_export', methods: ['POST'])]
    public function exportLabelCsv(Request $request): StreamedResponse
    {
        set_time_limit(0);
        $this->isTokenValid();

        $requestedIds = $request->request->all('ids');
        if ($requestedIds === []) {
            throw new NotFoundHttpException();
        }

        $response = $this->stockMoveInstructionLabelCsvExporterService->exportByInstructionIds($requestedIds);

        $event = new EventArgs(
            [
                'response' => $response,
            ],
            $request
        );
        $this->eventDispatcher->dispatch($event, EccubeEvents::ADMIN_STOCK_MOVE_INSTRUCTION_LABEL_CSV_EXPORT);

        return $response;
    }

    /**
     * 在庫移動実績入力用CSV雛形ダウンロード
     */
    #[Route(path: '/%eccube_admin_route%/product/stock/move-instruction/csv-template', name: 'admin_stock_move_instruction_csv_download_record', methods: ['GET'])]
