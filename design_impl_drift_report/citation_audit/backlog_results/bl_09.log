    /**
     * 在庫移動指示詳細（表示・送り状No・備考の編集）
     *
     * @return array<string, mixed>|RedirectResponse
     */
    #[Route(path: '/%eccube_admin_route%/product/stock/move-instruction/{id}', name: 'admin_stock_move_instruction_detail', requirements: ['id' => '\d+'], methods: ['GET', 'POST'])]
    #[Template(template: '@admin/Stock/stock_move_instruction_detail.twig')]
    public function detail(Request $request, int $id): array|RedirectResponse
    {
        $Instruction = $this->stockMoveInstructionRepository->find($id);
        if ($Instruction === null) {
            throw new NotFoundHttpException();
        }

        $originalTrackingNo = $Instruction->getTrackingNo();
        $builder = $this->formFactory->createBuilder(StockMoveInstructionDetailType::class, $Instruction);

        $event = new EventArgs(
            [
                'builder' => $builder,
                'Instruction' => $Instruction,
            ],
            $request
        );
        $this->eventDispatcher->dispatch($event, EccubeEvents::ADMIN_STOCK_MOVE_INSTRUCTION_DETAIL_INITIALIZE);

        $form = $builder->getForm();
        $form->handleRequest($request);

        if ($form->isSubmitted() && $form->isValid()) {
            $newTrackingNo = trim($Instruction->getTrackingNo() ?? '');
            if ($originalTrackingNo !== null && $originalTrackingNo !== '' && $newTrackingNo === '') {
                $form->get('trackingNo')->addError(
                    new FormError(
                        $this->translator->trans('admin.stock.move_instruction.detail_tracking_no_cannot_be_cleared', [], 'messages')
                    )
                );
            } else {
                $input = new StockMoveInstructionDetailUpdateInput(
                    $Instruction,
                    $this->getMember(),
                );
                $this->detailUpdateAction->handle($input);

                $event = new EventArgs(
                    [
                        'Instruction' => $Instruction,
                    ],
                    $request
                );
                $this->eventDispatcher->dispatch($event, EccubeEvents::ADMIN_STOCK_MOVE_INSTRUCTION_DETAIL_COMPLETE);

                $this->addSuccess('admin.common.save_complete', 'admin');

                return $this->redirectToRoute('admin_stock_move_instruction_detail', ['id' => $id]);
            }
        }

        $Moves = $this->stockMoveTransferRepository->findBy(
            ['moveInstructionId' => $Instruction->getId()],
            ['id' => 'ASC']
        );

        $moveIds = array_map(static fn ($m) => $m->getId(), $Moves);
        $moveAggregates = $this->stockMoveInstructionRepository->getTransferAggregatesByTransferIds(
            $moveIds,
            $Instruction->getMoveFromPriceThreshold()
        );

        $outboundTotalCost = '0';
        $highTotalPrice = '0';
        $regularTotalPrice = '0';
        foreach ($moveAggregates as $agg) {
            $outboundTotalCost = bcadd($outboundTotalCost, $agg['outbound_total_cost'], 2);
            $highTotalPrice = bcadd($highTotalPrice, $agg['high_total'], 2);
            $regularTotalPrice = bcadd($regularTotalPrice, $agg['regular_total'], 2);
        }

        return [
            'instruction' => $Instruction,
            'form' => $form->createView(),
            'Moves' => $Moves,
            'moveAggregates' => $moveAggregates,
            'outboundTotalCost' => $outboundTotalCost,
    }

    /**
     * 在庫移動指示IDごとの移動原価合計（DtbStockMoveTransferDetail の集計値）.
     *
     * DtbStockMoveInstruction.outboundTotalCost は作成時点では 0 のため、
     * 表示時は転送明細から実績値を集計して使用する。
     *
     * @param list<int> $instructionIds
     *
     * @return array<int, string> [instructionId => outbound_total_cost]
     */
    public function getOutboundTotalCostByIds(array $instructionIds): array
    {
        if ($instructionIds === []) {
            return [];
        }

        $rows = $this->createQueryBuilder('i')
            ->select('i.id AS instruction_id')
            ->addSelect('COALESCE(SUM(d.outboundTotalCost), 0) AS outbound_total_cost')
            ->innerJoin('Eccube\Entity\DtbStockMoveTransfer', 't', 'WITH', 't.moveInstructionId = i.id')
            ->innerJoin('Eccube\Entity\DtbStockMoveTransferDetail', 'd', 'WITH', 'd.StockMoveTransfer = t')
            ->where('i.id IN (:ids)')
            ->setParameter('ids', $instructionIds)
            ->groupBy('i.id')
            ->getQuery()
            ->getArrayResult();

        $result = [];
        foreach ($rows as $row) {
            $result[(int) $row['instruction_id']] = (string) $row['outbound_total_cost'];
        }

        return $result;
    }

    /**
     * 指示に紐づく在庫移動振替IDごとの集計（移動点数・基準価格合計・移動原価合計・高額商品合計・通常商品合計）.
     *
     * 高額/通常は instruction.moveFromPriceThreshold を閾値として product_class.standard_price で判定する。
     *
     * @param list<int> $transferIds   集計対象の在庫移動振替ID
     * @param int       $priceThreshold 出庫元店舗の高額商品閾値（DtbStockMoveInstruction.moveFromPriceThreshold）
     *
     * @return array<int, array{quantity: int, standard_total: string, outbound_total_cost: string, high_total: string, regular_total: string}>
     */
    public function getTransferAggregatesByTransferIds(array $transferIds, int $priceThreshold): array
    {
        if ($transferIds === []) {
            return [];
        }

        $rows = $this->createQueryBuilder('i')
            ->select('t.id AS transfer_id')
            ->addSelect('COALESCE(SUM(d.moveTransferQuantity), 0) AS move_transfer_quantity')
            ->addSelect('COALESCE(SUM(d.standardTotalPrice), 0) AS standard_total_price')
            ->addSelect('COALESCE(SUM(d.outboundTotalCost), 0) AS outbound_total_cost')
            ->addSelect('COALESCE(SUM(CASE WHEN pc.standardPrice >= :threshold THEN d.standardTotalPrice ELSE 0 END), 0) AS high_total_price')
            ->addSelect('COALESCE(SUM(CASE WHEN pc.standardPrice < :threshold THEN d.standardTotalPrice ELSE 0 END), 0) AS regular_total_price')
            ->innerJoin('Eccube\Entity\DtbStockMoveTransfer', 't', 'WITH', 't.moveInstructionId = i.id')
            ->innerJoin('Eccube\Entity\DtbStockMoveTransferDetail', 'd', 'WITH', 'd.StockMoveTransfer = t')
            ->innerJoin('Eccube\Entity\ProductStock', 'ps', 'WITH', 'ps = d.MoveFromProductStock')
            ->innerJoin('Eccube\Entity\ProductClass', 'pc', 'WITH', 'pc = ps.ProductClass')
            ->where('t.id IN (:ids)')
            ->setParameter('ids', $transferIds)
            ->setParameter('threshold', $priceThreshold)
            ->groupBy('t.id')
            ->getQuery()
            ->getArrayResult();

        $aggregates = [];

        foreach ($rows as $row) {
            $highTotal = (string) $row['high_total_price'];
            $regularTotal = (string) $row['regular_total_price'];
            if ($priceThreshold === 0) {
                $regularTotal = bcadd($highTotal, $regularTotal, 2);
                $highTotal = '0';
            }
            $aggregates[(int) $row['transfer_id']] = [
                'quantity' => (int) $row['move_transfer_quantity'],
                'standard_total' => (string) $row['standard_total_price'],
                'outbound_total_cost' => (string) $row['outbound_total_cost'],
                'high_total' => $highTotal,
                'regular_total' => $regularTotal,
            ];
        }

        return $aggregates;
    }
