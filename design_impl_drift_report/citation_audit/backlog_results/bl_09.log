namespace Eccube\Service\Admin\Stock;

use Doctrine\ORM\EntityManagerInterface;
use Eccube\Entity\DtbStockApprovalList;
use Eccube\Entity\DtbStockSplitJoin;
use Eccube\Entity\DtbStockSplitJoinDetail;
use Eccube\Entity\Master\MtbStockChangeTypeDetail;
use Eccube\Entity\Master\MtbStockHistorySourceType;
use Eccube\Entity\Master\MtbStockSplitJoinStatus;
use Eccube\Entity\Member;
use Eccube\Entity\ProductStock;
use Eccube\Repository\DtbStockSplitJoinRepository;
use Eccube\Repository\Master\MtbStockHistorySourceTypeRepository;
use Eccube\Repository\Master\MtbStockSplitJoinStatusRepository;
use Eccube\Repository\ProductStockRepository;
use Eccube\Service\Admin\Stock\ActionInput\StockSplitApplyApprovalInput;
use Eccube\Service\EntityManager\StockApprovalListEntityManager;
use Eccube\Service\EntityManager\StockSplitJoinDetailEntityManager;
use Eccube\Service\EntityManager\StockSplitJoinStatusHistoryEntityManager;

/**
 * 分割の承認申請（DtbStockSplitJoinDetail を DB に登録し、ステータスを「分割承認待ち」に変更）
 * 手動入力（Session 経由）・CSV アップロード経由の両方から呼ばれる。
 */
class StockSplitApplyApprovalAction
{
    public function __construct(
        private readonly DtbStockSplitJoinRepository $stockSplitJoinRepository,
        private readonly MtbStockHistorySourceTypeRepository $stockHistorySourceTypeRepository,
        private readonly MtbStockSplitJoinStatusRepository $mtbStockSplitJoinStatusRepository,
        private readonly EntityManagerInterface $entityManager,
        private readonly StockApprovalListEntityManager $stockApprovalListEntityManager,
        private readonly StockSplitJoinDetailEntityManager $detailEntityManager,
        private readonly StockSplitJoinStatusHistoryEntityManager $statusHistoryEntityManager,
        private readonly ProductStockRepository $productStockRepository,
    ) {
    }

    /**
     * 成功時はリダイレクト先に使う ID とフラッシュ用メッセージのみ返す。エラー時はメッセージのみ（Controller が Request から戻り先を決める）。
     *
     * @return array{
     *     stockSplitJoinId?: int,
     *     successMessage?: string,
     *     errorMessage?: string
     * }
     */
    public function handle(StockSplitApplyApprovalInput $input): array
    {
        $ProductStock = $input->ProductStock;
        // em->clear() 後に detach される可能性があるため find() で管理下エンティティを再取得する
        $Member = $input->Member !== null
            ? $this->entityManager->find(Member::class, $input->Member->getId())
            : null;

        if ($input->stockSplitJoinId <= 0) {
            return ['errorMessage' => 'admin.stock.split_join.not_found'];
        }

        $StockSplitJoin = $this->stockSplitJoinRepository->find($input->stockSplitJoinId);

        if ($StockSplitJoin === null
            || $StockSplitJoin->getProductStock()->getId() !== $ProductStock->getId()
            || $StockSplitJoin->getSplitJoinType() !== DtbStockSplitJoin::SPLIT_JOIN_TYPE_SPLIT) {
            return ['errorMessage' => 'admin.stock.split_join.not_found'];
        }

        if ($StockSplitJoin->getStockSplitJoinStatus()->getId() === MtbStockSplitJoinStatus::REJECTED) {
            return ['errorMessage' => 'admin.stock.split.apply_approval_invalid_status'];
        }

        // 分割先データから DtbStockSplitJoinDetail を新規作成する
        /** @var list<DtbStockSplitJoinDetail> $Destinations */
        $Destinations = [];
        foreach ($input->sessionDestinations as $productStockId => $data) {
            $DestPs = $this->productStockRepository->find((int) $productStockId);
            if (!$DestPs instanceof ProductStock) {
                continue;
            }
            $quantity = \max(0, (int) $data['quantity']);
            $Destinations[] = $this->detailEntityManager->save(
                Detail: null,
                StockSplitJoin: $StockSplitJoin,
                SubjectProductStock: $DestPs,
                splitJoinQuantity: $quantity,
                stockSnapshot: (int) ($DestPs->getStock() ?? 0),
                totalCost: $DestPs->getTotalCost(),
            );
        }
        $this->entityManager->flush();
        $commitRuleError = $this->validateSplitDestinationCommitRules($StockSplitJoin, $Destinations);
        if ($commitRuleError !== null) {
            return ['errorMessage' => $commitRuleError];
        }

        $StatusPending = $this->mtbStockSplitJoinStatusRepository->find(MtbStockSplitJoinStatus::SPLIT_APPROVAL_WAITING);
        if ($StatusPending === null) {
            throw new \LogicException('StockSplitApplyApprovalAction::handle requires split approval waiting status in master.');
        }

        $now = new \DateTime();
        $historyMember = $Member ?? $StockSplitJoin->getRegisteredMember();
        $this->statusHistoryEntityManager->save(null, $StockSplitJoin, $StatusPending, $historyMember, $now);
        $StockSplitJoin->setStockSplitJoinStatus($StatusPending);
        $StockSplitJoin->setMoveToApprovalAt($now);
        if ($Member !== null) {
            $StockSplitJoin->setMoveToApprovalMember($Member);
        }
        $StockSplitJoin->setUpdateDate($now);
        if ($Member !== null) {
            $StockSplitJoin->setUpdater($Member);
        }
        $splitJoinMemo = trim($input->splitJoinMemo);
        $StockSplitJoin->setSplitJoinMemo($splitJoinMemo !== '' ? $splitJoinMemo : null);

        $HistorySourceType = $this->stockHistorySourceTypeRepository->find(MtbStockHistorySourceType::STOCK_SPLIT_EDIT);
        if ($HistorySourceType === null) {
            throw new \LogicException('StockSplitApplyApprovalAction requires STOCK_SPLIT_EDIT in master.');
        }

        $destinationTotalQuantity = 0;
        foreach ($Destinations as $detail) {
            $destinationTotalQuantity += \max(0, $detail->getSplitJoinQuantity());
        }

        // 移動分の総原価 = 登録時に計算済みの出庫総原価（= 総原価 × 移動個数 ÷ 総在庫数）をそのまま使用
        $splitTransferCost = (int) bcround($StockSplitJoin->getOutboundTotalCost() ?? '0', 0);

        // 1申請 = 1行（分割先全件 + 分割元1件）
        $this->stockApprovalListEntityManager->save(
            StockApprovalList: null,
            BaseInfo: $ProductStock->getBaseInfo(),
            StockLocationId: $ProductStock->getStockLocationId(),
            HistorySourceType: $HistorySourceType,
            historySourceId: (int) $StockSplitJoin->getId(),
            StockTransferTypeDetail: $this->entityManager->getReference(MtbStockChangeTypeDetail::class, MtbStockChangeTypeDetail::SPLIT_OUTBOUND),
            approvalStatus: DtbStockApprovalList::APPROVAL_STATUS_UNAPPROVED,
            registeredDate: $now,
            RegisteredMember: $historyMember,
            ProductStockTotalCount: count($Destinations) + 1,
            InventoryChangeTotalCount: $destinationTotalQuantity,
            TotalCostPriceBefore: $splitTransferCost,
        );

        $this->entityManager->flush();

        return [
            'stockSplitJoinId' => $StockSplitJoin->getId(),
            'successMessage' => 'admin.stock.split.apply_approval_success',
        ];
    }

    /**
     * @param list<DtbStockSplitJoinDetail> $Destinations
     */
    private function validateSplitDestinationCommitRules(DtbStockSplitJoin $StockSplitJoin, array $Destinations): ?string
    {
        if ($StockSplitJoin->getSplitJoinQuantity() < 1) {
            return 'admin.stock.split.quantity_min';
        }
        if ($Destinations === []) {
            return 'admin.stock.split.destination_required';
        }
        $destinationQuantitySum = 0;
        foreach ($Destinations as $detail) {
            $destinationQuantitySum += \max(0, $detail->getSplitJoinQuantity());
        }
        if ($destinationQuantitySum < 1) {
            return 'admin.stock.split.destination_total_zero';
        }

        return null;
    }
}
