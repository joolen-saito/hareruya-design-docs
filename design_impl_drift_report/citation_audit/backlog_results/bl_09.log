    public function __construct(
        protected CsvExportService $csvExportService,
        protected AnalysisSummaryBuilder $analysisSummaryBuilder,
    ) {
    }

    /**
     * @param list<int> $targetBaseInfoIds
     */
    public function export(
        string $summaryType,
        \DateTimeInterface $dateFrom,
        \DateTimeInterface $dateTo,
        array $targetBaseInfoIds,
        bool $mailOrderEnabled,
    ): StreamedResponse {
        $summaryData = $this->analysisSummaryBuilder->build(
            $summaryType,
            $dateFrom,
            $dateTo,
            $targetBaseInfoIds,
            $mailOrderEnabled,
            self::RESULT_COLUMNS
        );
        $summary = $summaryData['summary'];
        $exportHeader = $summaryType === 'monthly'
            ? self::EXPORT_HEADER_MONTHLY
            : self::EXPORT_HEADER_DAILY;

        $response = new StreamedResponse(function () use ($summary, $exportHeader): void {
            $this->csvExportService->fopen();
            $this->csvExportService->fputcsv($exportHeader);
            foreach ($summary as $row) {
                $this->csvExportService->fputcsv([
                    (string) ($row['order_date'] ?? ''),
                    (string) ($row['store_name'] ?? ''),
                    (string) ((int) ($row['order_amount_order'] ?? 0)),
                    (string) ((int) ($row['cost'] ?? 0)),
                    (string) ((int) ($row['gross_profit'] ?? 0)),
                    (string) ((int) ($row['order_count_order'] ?? 0)),
                    (string) ((int) ($row['buyer_count'] ?? 0)),
                    (string) ((int) ($row['order_average_order'] ?? 0)),
                    (string) ((int) ($row['purchase_count'] ?? 0)),
                    (string) ((int) ($row['purchase_amount'] ?? 0)),
                    (string) ((int) ($row['discard_count'] ?? 0)),
                    (string) ((int) ($row['out_of_stock_count'] ?? 0)),
                ]);
            }
            $this->csvExportService->fclose();
        });

        $filename = sprintf('summary_%s_%s.csv', $summaryType, (new \DateTime())->format('YmdHis'));
        $response->headers->set('Content-Type', 'application/octet-stream');
        $response->headers->set('Content-Disposition', 'attachment; filename='.$filename);

        return $response;
    }
}
