            ->setConverter(new IntConverter())
            ->addValidator(new NumericValidator());
        $this->moveFromShopColumn = new BaseCsvColumn(self::COL_MOVE_FROM_SHOP, self::COL_MOVE_FROM_SHOP);
        $this->moveToShopColumn = new BaseCsvColumn(self::COL_MOVE_TO_SHOP, self::COL_MOVE_TO_SHOP);
        $this->trackingNoColumn = (new BaseCsvColumn(self::COL_TRACKING_NO, self::COL_TRACKING_NO))
            ->setRequired(true)
            ->addValidator(new RequiredValidator());
    }

