     */
    protected function getRowValidators(): array
    {
        return [];
    }

    private function initializeColumnDefinitions(): void
    {
        $this->instructionIdColumn = (new BaseCsvColumn(self::COL_INSTRUCTION_ID, self::COL_INSTRUCTION_ID))
