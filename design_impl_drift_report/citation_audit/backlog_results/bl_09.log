namespace Eccube\Service\EntityManager;

use Doctrine\ORM\EntityManagerInterface;
use Eccube\Entity\DtbStockSplitJoin;
use Eccube\Entity\DtbStockSplitJoinDetail;
use Eccube\Entity\ProductStock;

class StockSplitJoinDetailEntityManager
{
    public function __construct(
        private readonly EntityManagerInterface $entityManager,
    ) {
    }

    /**
     * 在庫分割・結合の明細を1件作成して persist する。flush は呼び出し側で行う。
     * DtbStockSplitJoin のメモリ上コレクションとの双方向同期も行う（addDetail）。
     */
    public function save(
        ?DtbStockSplitJoinDetail $Detail,
        DtbStockSplitJoin $StockSplitJoin,
        ProductStock $SubjectProductStock,
        int $splitJoinQuantity,
        int|string $stockSnapshot,
        string $totalCost,
    ): DtbStockSplitJoinDetail {
        $ProductClass = $SubjectProductStock->getProductClass();
        $basePrice = (string) ($ProductClass->getStandardPrice() ?? 0);

        $Detail = $Detail ?? new DtbStockSplitJoinDetail();
        $Detail->setStockSplitJoin($StockSplitJoin);
        $Detail->setSubjectProductStock($SubjectProductStock);
        $Detail->setStandardPrice($basePrice);
        $Detail->setCostPrice($SubjectProductStock->getUnitCost());
        $Detail->setTotalCost($totalCost);
        $Detail->setStock($stockSnapshot);
        $Detail->setSplitJoinQuantity($splitJoinQuantity);
        $StockSplitJoin->addDetail($Detail);

        $this->entityManager->persist($Detail);

        return $Detail;
    }
}
