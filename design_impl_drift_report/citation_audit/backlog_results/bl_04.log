namespace Eccube\Service\Smaregi;

use Eccube\Common\Constant;
use Eccube\Repository\ProductClassRepository;

/**
 * CSV インポートはファイル単位でトランザクションが閉じるまで DB が確定しないため、
 * 規格IDをバッファし、コミット成功後に {@see SmaregiProductClassEventService::dispatchUpsert} を呼ぶ。
 *
 * インポート処理ごとに新しいインスタンスを使うこと（並行インポートで状態が混ざらないようにする）。
 */
final class SmaregiProductClassCsvImportUpsertCoordinator
{
    /** @var array<int, true> */
    private array $deferredProductClassIds = [];

    public function __construct(
        private readonly SmaregiProductClassEventService $smaregiProductClassEventService,
        private readonly ProductClassRepository $productClassRepository,
        private readonly string $logContextLabel,
    ) {
    }

    public function reset(): void
    {
        $this->deferredProductClassIds = [];
    }

    /**
     * 行処理時に呼ぶ。連携ONかつスマレジ商品コードが空でない場合のみバッファする。
     */
    public function deferIfEligible(int $productClassId, int $smaregiAlignmentFlg, ?string $smaregiProductCode): void
    {
        if ($smaregiAlignmentFlg !== Constant::ENABLED) {
            return;
        }
        if ($smaregiProductCode === null || trim($smaregiProductCode) === '') {
            return;
        }
        $this->deferredProductClassIds[$productClassId] = true;
    }

    /**
     * {@see \Eccube\Service\Csv\Importer\CsvImporter} によるコミット後、{@see AfterReadEvent::isSuccessful} に応じて投入またはバッファ破棄。
     *
     * 投入に失敗した場合はログの後に {@see \RuntimeException} を送出し、CSV 取込処理側で失敗として扱えるようにする。
     *
     * @throws \RuntimeException 連携タスクの投入が1件以上失敗した場合（原因は previous に保持）
     */
    public function afterCsvImportFinished(bool $importSuccessful): void
    {
        if (!$importSuccessful) {
            $this->deferredProductClassIds = [];

            return;
        }

        $dispatchFailed = false;
        $firstFailure = null;

        try {
            foreach (array_keys($this->deferredProductClassIds) as $productClassId) {
                $ProductClass = $this->productClassRepository->find($productClassId);
                if ($ProductClass === null) {
                    continue;
                }
                if (!$ProductClass->getSmaregiAlignmentFlg()) {
                    continue;
                }
                $code = $ProductClass->getSmaregiProductCode();
                if ($code === null || trim($code) === '') {
                    continue;
                }
                try {
                    $this->smaregiProductClassEventService->dispatchUpsert($ProductClass);
                } catch (\Throwable $e) {
                    $dispatchFailed = true;
                    $firstFailure ??= $e;
                    log_error('スマレジ連携タスクの投入に失敗しました（'.$this->logContextLabel.'）。', [
                        'product_class_id' => $productClassId,
                        'message' => $e->getMessage(),
                        'file' => $e->getFile(),
                        'line' => $e->getLine(),
                    ]);
                }
            }
        } finally {
            $this->deferredProductClassIds = [];
        }

        if ($dispatchFailed) {
            throw new \RuntimeException('スマレジ連携タスクの投入に失敗しました（'.$this->logContextLabel.'）。', 0, $firstFailure);
        }
    }
}

