        {
            "issueKey": "ECCUBE_HARERUYA-2011",
            "summary": "\u3010\u4e00\u90e8\u5b9f\u88c5\u3011\u5728\u5eab\u7ba1\u7406_\u5728\u5eab\u5206\u5272 \u767b\u9332\u7de8\u96c6_\u5728\u5eab\u5206\u5272 \u767b\u9332\u7de8\u96c6\u306e\u5206\u5272\u5148\u5546\u54c1CSV\u767b\u9332\u306b\u3066\u3001\u30a8\u30e9\u30fc\u4e00\u89a7\u306e\u5148\u982d\u306b\u56fa\u5b9a\u6587\u8a00\u300c\u30a8\u30e9\u30fc\u3092\u6700\u592720\u4ef6\u307e\u3067\u8868\u793a\u3057\u3066\u3044\u307e\u3059\u3002\u300d\u304c\u8868\u793a\u3055\u308c\u306a\u3044\uff08\u7d50\u5408\u5074\u3067\u306f\u8868\u793a\u3055\u308c\u308b\uff09",
            "issueType": "\u672a\u5b9f\u88c5\u30fb\u5b9f\u88c5\u4e56\u96e2\u30ea\u30b9\u30c8",
            "status": "\u51e6\u7406\u4e2d",
            "priority": "\u4f4e",
            "description": "# \u57fa\u672c\u60c5\u5831\u3010\u5fc5\u9808\u3011\n\u5206\u985e\uff1a\u5728\u5eab\u7ba1\u7406\n\u6a5f\u80fd\uff1a\u5728\u5eab\u5206\u5272 \u767b\u9332\u7de8\u96c6\n\u8ab2\u984c\u30ab\u30c6\u30b4\u30ea\uff1a\u4e0d\u5177\u5408\uff08\u30d0\u30b0\uff09\n\u8ab2\u984c\uff1a\u3010\u4e00\u90e8\u5b9f\u88c5\u3011\u5728\u5eab\u7ba1\u7406_\u5728\u5eab\u5206\u5272 \u767b\u9332\u7de8\u96c6_\u5728\u5eab\u5206\u5272 \u767b\u9332\u7de8\u96c6\u306e\u5206\u5272\u5148\u5546\u54c1CSV\u767b\u9332\u306b\u3066\u3001\u30a8\u30e9\u30fc\u4e00\u89a7\u306e\u5148\u982d\u306b\u56fa\u5b9a\u6587\u8a00\u300c\u30a8\u30e9\u30fc\u3092\u6700\u592720\u4ef6\u307e\u3067\u8868\u793a\u3057\u3066\u3044\u307e\u3059\u3002\u300d\u304c\u8868\u793a\u3055\u308c\u306a\u3044\uff08\u7d50\u5408\u5074\u3067\u306f\u8868\u793a\u3055\u308c\u308b\uff09\n\u8a2d\u8a08\u66f8\uff1a0202_\u57fa\u672c\u8a2d\u8a08\u4ed5\u69d8\u66f8(\u5728\u5eab\u7ba1\u7406\u6a5f\u80fd).xlsx\n\n# \u671f\u5f85\u3055\u308c\u308b\u6319\u52d5\u3010\u5fc5\u9808\u3011\n- \u5206\u5272\u5148\u5546\u54c1CSV\u767b\u9332\u3067\u306f\u3001CSV\u306e\u767b\u9332\u4e0a\u9650\u30922,000\u4ef6\u3068\u3057\u3001\u5165\u529b\u30c1\u30a7\u30c3\u30af\u306f\u30a8\u30e9\u30fc\u304c20\u4ef6\u306b\u5230\u9054\u3059\u308b\u307e\u3067\u884c\u3044\u3001\u884c\u756a\u53f7\u30fb\u5546\u54c1\u30b3\u30fc\u30c9\u30fb\u5546\u54c1\u540d\u3092\u30bb\u30c3\u30c8\u306b\u3057\u305f\u30a8\u30e9\u30fc\u30e1\u30c3\u30bb\u30fc\u30b8\u3092\u6700\u592720\u4ef6\u307e\u3067\u753b\u9762\u4e0a\u306b\u8868\u793a\u3059\u308b\u3053\u3068\u3002\n- \u30a8\u30e9\u30fc\u30e1\u30c3\u30bb\u30fc\u30b8\u306b\u306f\u56fa\u5b9a\u3067\u300c\u30a8\u30e9\u30fc\u306f20\u4ef6\u307e\u3067\u8868\u793a\u3055\u308c\u307e\u3059\u300d\u3068\u3044\u3046\u6587\u8a00\u3092\u30a8\u30e9\u30fc\u30e1\u30c3\u30bb\u30fc\u30b8\u306e\u4e0a\u306b\u8868\u793a\u3059\u308b\u3053\u3068\u3002\n- \u3059\u3067\u306b\u5206\u5272\u5148\u5546\u54c1\u304c1\u4ef6\u3067\u3082\u767b\u9332\u3055\u308c\u3066\u3044\u308b