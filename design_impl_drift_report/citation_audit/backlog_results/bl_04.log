            ],
            $request
        );
        $this->eventDispatcher->dispatch($event, EccubeEvents::ADMIN_STOCK_JOIN_EDIT_JOIN_INITIALIZE);

        return array_merge($this->buildEditViewModel($StockSplitJoin, false, $request), [
            'form' => $form->createView(),
            'searchProductModalForm' => $searchProductModalForm,
        ]);
    }

