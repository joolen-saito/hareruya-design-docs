            $this->smaregiCsvImportUpsertCoordinator->deferIfEligible($productClassId, $smaregiAlignmentFlg, (string) $smaregiProductCode);

            // 価格履歴登録のためにProductClassを取得
            /** @var ProductClass $ProductClass */
            $ProductClass = $this->productClassRepository->find($productClassId);

            // updateの場合、販売/買取/基準価格のいずれかが変更された場合のみ履歴を登録する
            $oldSellPrice = (int) $productClass['price02'];
            $oldBuyPrice = (int) ($productClass['buyPrice'] ?? 0);
            $oldStandardPrice = (int) ($productClass['standardPrice'] ?? 0);
            if ($sellPrice !== $oldSellPrice || $buyPrice !== $oldBuyPrice || $standardPrice !== $oldStandardPrice) {
                $priceHistory = new DtbPriceHistory();
                $priceHistory->setProductClass($ProductClass);
                $priceHistory->setSellPrice($sellPrice);
                $priceHistory->setOldSellPrice($oldSellPrice);
                $priceHistory->setBuyPrice($buyPrice);
                $priceHistory->setOldBuyPrice($oldBuyPrice);
                $priceHistory->setStandardPrice($standardPrice);
                $priceHistory->setOldStandardPrice($oldStandardPrice);
                $priceHistory->setMemberId($memberId);
                $this->priceHistoryRepository->addHistoryNative($priceHistory);
            }
        } else {
            // 商品規格が未登録の場合はinsertを行う
            // 新規登録時はセールフラグ無効として、基準価格を販売価格として登録する
            $sellPrice = $standardPrice;

            try {
                $productClassId = $productClassRepository->insertProductClass(
                    [
                        'productId' => $productId,
                        'creatorId' => $memberId,
                        'productCode' => $productCode,
                        'saleLimit' => $saleLimit,
                        'price02' => $sellPrice,
                        'cardConditionId' => $conditionId,
                        'languageId' => $languageId,
                        'buyPrice' => $buyPrice,
                        'standardPrice' => $standardPrice,
                        'smaregiAlignmentFlg' => $smaregiAlignmentFlg,
                        'smaregiProductCode' => $smaregiProductCode,
                        'sectionId' => $sectionId,
                    ]
                );
            } catch (UniqueConstraintViolationException $e) {
                $event->getMessageStore()
                    ->addNewProductSmaregiProductCodeDuplicateError(
                        $row->getRowNumber(),
                        $smaregiProductCode
                    );
                $event->skipRow();
                throw $e;
            }

            $this->smaregiCsvImportUpsertCoordinator->deferIfEligible($productClassId, $smaregiAlignmentFlg, (string) $smaregiProductCode);

            // 価格履歴登録のためにProductClassを取得
            /** @var ProductClass $ProductClass */
            $ProductClass = $this->productClassRepository->find($productClassId);

            // TODO: スマレジ連携フラグが無効から有効に変更された場合、スマレジ連携のキューを作成する
            // SmaregiProductClassEventService::dispatchUpsert() を呼び出す
            // 既存のスマレジ連携フラグと比較して、無効から有効に変わった場合にキューを作成する必要がある
            // TODO:スマレジ連携状態の確認後、更新するか決める（https://joolen.slack.com/archives/C086TQW7VTK/p1777341428022289）

            $BaseInfos = $this->baseInfoRepository->getOpenShops();

