    public function onReadRow(ReadCsvRowEvent $event): bool
    {
        $srcPs = $this->pendingSourcePs;
        $this->pendingSourcePs = null;

        if ($srcPs === null) {
            return false;
        }

        $row = $event->getRow();
        $qty = (int) trim($row->getValue(self::COLUMN_SOURCE_QTY));
        $this->sources[(int) $srcPs->getId()] = ['quantity' => $qty];

        return true;
    }

