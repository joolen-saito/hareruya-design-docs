    }

    /**
     * 商品一覧取得（product_code で絞り込み）.
     *
     * @return array{statusCode:int,headers:array<string,array<string>>,body:string,json:array<int,array<string,mixed>>|null}
     */
    public function listByProductCode(
        string $apiUrl,
        string $contractId,
        string $accessToken,
        string $productCode,
    ): array {
        $url = sprintf('%s/%s/pos/products', rtrim($apiUrl, '/'), $contractId);

        return $this->requestGet(
            SmaregiPlatformApiCallLog::OPERATION_PRODUCT_LIST,
            $url,
            $accessToken,
            [
                'product_code' => $productCode,
            ],
            [
                'productCode' => $productCode,
            ],
        );
    }

    /**
     * @param array<string,mixed> $body
     *
     * @return array{statusCode:int,headers:array<string,array<string>>,body:string,json:array<string,mixed>|null}
     */
    public function create(
        string $apiUrl,
        string $contractId,
        string $accessToken,
        array $body,
    ): array {
        $url = sprintf('%s/%s/pos/products', rtrim($apiUrl, '/'), $contractId);

        return $this->request(
            SmaregiPlatformApiCallLog::OPERATION_PRODUCT_CREATE,
            'POST',
            $url,
            $accessToken,
            $body,
            [
                'productCode' => $body['productCode'] ?? '',
            ],
        );
    }

    /**
     * @param array<string,mixed> $body
     *
     * @return array{statusCode:int,headers:array<string,array<string>>,body:string,json:array<string,mixed>|null}
     */
    public function update(
        string $apiUrl,
        string $contractId,
        string $accessToken,
        string $smaregiProductId,
        array $body,
    ): array {
        $url = sprintf('%s/%s/pos/products/%s', rtrim($apiUrl, '/'), $contractId, rawurlencode($smaregiProductId));

        return $this->request(
            SmaregiPlatformApiCallLog::OPERATION_PRODUCT_UPDATE,
            'PATCH',
            $url,
            $accessToken,
            $body,
            [
                'smaregiProductId' => $smaregiProductId,
            ],
        );
    }

    /**
     * @return array{statusCode:int,headers:array<string,array<string>>,body:string,json:array<string,mixed>|null}
     */
    public function delete(
        string $apiUrl,
        string $contractId,
        string $accessToken,
        string $smaregiProductId,
    ): array {
        $url = sprintf('%s/%s/pos/products/%s', rtrim($apiUrl, '/'), $contractId, rawurlencode($smaregiProductId));

        return $this->request(
            SmaregiPlatformApiCallLog::OPERATION_PRODUCT_DELETE,
            'DELETE',
            $url,
            $accessToken,
            null,
            [
                'smaregiProductId' => $smaregiProductId,
            ],
        );
    }

