    /**
     * 結合元商品CSV（編集画面・2列で明細全置換）
     * CSVインポートは即時DB登録（Sessionを経由しない）。
     */
    #[Route(path: '/%eccube_admin_route%/product/stock/join/{id}/edit-source-csv-upload', name: 'admin_stock_join_edit_source_csv_upload', requirements: ['id' => '\d+'], methods: ['POST'])]
    public function joinEditSourceCsvUpload(Request $request, #[MapEntity(id: 'id')] DtbStockSplitJoin $StockSplitJoin): JsonResponse
    {
        if (!$this->isCsrfTokenValid('stock_join_edit_source_csv', (string) $request->request->get('_token'))) {
            return new JsonResponse(['ok' => false, 'errors' => ['CSRFトークンが無効です。']], Response::HTTP_FORBIDDEN);
        }

        $file = $request->files->get('import_file');
        if (!$file instanceof UploadedFile) {
            return new JsonResponse([
                'ok' => false,
                'errors' => [trans('admin.stock.split_csv_modal.csv_file_required')],
            ]);
        }

        if (!$StockSplitJoin->isJoin()) {
            return new JsonResponse(['ok' => false, 'errors' => ['在庫結合ではありません。']]);
        }

        $statusId = $StockSplitJoin->getStockSplitJoinStatus()->getId();
        if ($statusId === MtbStockSplitJoinStatus::JOIN_APPROVAL_WAITING) {
            return new JsonResponse(['ok' => false, 'errors' => [trans('admin.stock.split_join.already_applied')]]);
        }
        if ($statusId === MtbStockSplitJoinStatus::RECEIPT_COMPLETED) {
