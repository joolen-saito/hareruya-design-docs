    /**
     * グッズ・サプライ・情報商材登録CSVアップロード
     */
    #[Route(path: '/%eccube_admin_route%/product/product_goods_csv_upload', name: 'admin_product_goods_csv_upload', methods: ['POST'])]
    public function import(Request $request): RedirectResponse
    {
        set_time_limit(0);

        /** @var Member $Member */
        $Member = $this->getUser();

        $form = $this->formFactory->createBuilder(CsvImportType::class)->getForm();
        $form->handleRequest($request);

        if (!$form->isValid()) {
            foreach ($form->getErrors(true) as $error) {
                $this->addError($error->getMessage(), 'admin');
            }

            return $this->redirectToRoute('admin_product_goods_csv_import');
        }

        /** @var UploadedFile|null $file */
        $file = $form['import_file']->getData();
        if ($file === null) {
            $this->addError('admin.common.csv_invalid_format', 'admin');

            return $this->redirectToRoute('admin_product_goods_csv_import');
        }

        if ($this->countCsvRows($file) >= static::ADMIN_CSV_IMPORT_MAX_ROWS) {
            $this->addError($this->getCsvImportMaxRowsExceededMessage(), 'admin');

            return $this->redirectToRoute('admin_product_goods_csv_import');
        }

        log_info('グッズ・サプライ・情報商材CSV登録開始');

        $handler = new ProductGoodsImportHandler(
            $this->entityManager,
            $this->productRepository,
            $this->productClassRepository,
            $this->baseInfoRepository,
            $this->dtbPriceHistoryRepository,
            $this->productStockRepository,
            $this->productImageService,
            $this->smaregiProductClassCsvImportUpsertCoordinatorFactory->create('グッズ・サプライ・情報商材CSVインポート後'),
        );
        $importer = new CsvImporter(
            $this->entityManager,
            $this->translator,
            $this->eccubeConfig,
            $handler,
            $Member
        );
        $result = $importer->import($file);

        if ($result->hasError()) {
            log_info('グッズ・サプライ・情報商材 異常終了');
            foreach ($result->getErrors() as $error) {
                $this->addError($error['message'], 'admin');
            }
        } else {
            $this->addSuccess('admin.common.csv_upload_complete', 'admin');
            // TODO スマレジ連携の表示の仕様確定後変更(M03-27)
            $this->csvImportHistoryRepository->insertCsvImportHistory(
                MtbCsvImportType::PRODUCT_GOODS_IMPORT_CSV_ID,
                $file->getClientOriginalName(),
                $Member->getId()
            );
            log_info('グッズ・サプライ・情報商材', ['count' => $result->getCount()]);

            $event = new EventArgs(
                [
                    'form' => $form,
                    'result' => $result,
                ],
                $request
            );
            $this->eventDispatcher->dispatch($event, EccubeEvents::ADMIN_PRODUCT_CSV_GOODS_CSV_IMPORT_COMPLETE);
        }

        return $this->redirectToRoute('admin_product_goods_csv_import');
    }
