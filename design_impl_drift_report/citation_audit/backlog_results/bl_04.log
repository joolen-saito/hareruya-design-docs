    public function detail(Request $request, CacheUtil $cacheUtil, ?BaseInfo $BaseInfo = null): RedirectResponse|array
    {
        $activateCreationFlow = false;
        if ($BaseInfo === null) {
            $BaseInfo = new BaseInfo();
