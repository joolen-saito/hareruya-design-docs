            "issueKey": "ECCUBE_HARERUYA-2013",
            "summary": "\u3010\u4e00\u90e8\u5b9f\u88c5\u3011\u5728\u5eab\u7ba1\u7406_\u5728\u5eab\u7d50\u5408 \u767b\u9332\u7de8\u96c6_\u5728\u5eab\u7d50\u5408 \u767b\u9332\u7de8\u96c6\u306b\u3066\u3001\u7d50\u5408\u6570\u306e\u6700\u5927\u5024\uff0899999999\uff09\u30fb\u5728\u5eab\u6570\u8d85\u904e\u306e\u30a8\u30e9\u30fc\u30c1\u30a7\u30c3\u30af\u304c\u7121\u304f\u3001\u30b9\u30c6\u30fc\u30bf\u30b9\u3082\u8a2d\u8a08\u306e7\u6bb5\u968e\uff08\u4e8c\u6bb5\u968e\u627f\u8a8d\uff09\u3067\u306f\u306a\u304f5\u6bb5\u968e\uff08\u5358\u4e00\u627f\u8a8d\uff09\u306b\u306a\u3063\u3066\u3044\u308b",
            "issueType": "\u672a\u5b9f\u88c5\u30fb\u5b9f\u88c5\u4e56\u96e2\u30ea\u30b9\u30c8",
