class TenantController extends AbstractController
{
    public function __construct(
        private readonly BaseInfoRepository $baseInfoRepository,
        private readonly PageMaxRepository $pageMaxRepository,
        private readonly CreateTenantManager $createTenantManager,
        private readonly TenantStatusRepository $tenantStatusRepository,
        EccubeConfig $eccubeConfig,
        protected FileManager $fileManager,
    ) {
        $this->eccubeConfig = $eccubeConfig;
