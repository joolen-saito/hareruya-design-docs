    /**
     * CSVを読み込み、結合元情報を SESSION に保存する。
     * DBへの書き込みは行わない。
     *
     * SESSION キー: stock_join_edit_sources_{joinId}
     * SESSION 値: array<int productStockId, array{quantity: int}>
     *
     * @return array{ok: bool, count?: int, errors?: list<string>}
     */
    public function handleToSession(UploadedFile $file, SessionInterface $session): array
    {
        $path = $file->getRealPath();
        if ($path === false || !file_exists($path)) {
            return ['ok' => false, 'errors' => ['ファイルが読み込めません。']];
        }

        $splFile = new \SplFileObject($path);
        $importService = new CsvImportService(
            $splFile,
            $this->eccubeConfig['eccube_csv_import_delimiter'],
            $this->eccubeConfig['eccube_csv_import_enclosure']
        );

        if (!$importService->setHeaderRowNumber(0)) {
            return ['ok' => false, 'errors' => ['ヘッダー行が見つかりません。CSVテンプレートを確認してください。']];
        }
        $importService->next();
        if (!$importService->valid()) {
            return ['ok' => false, 'errors' => ['データが存在しません。']];
        }
        $importService->seek(0);

        $destPs = $this->stockSplitJoin->getProductStock();
        $destBaseInfo = $destPs->getBaseInfo();
        $destStockLocationId = $destPs->getStockLocationId();
        $destPsId = $destPs->getId();

        $sources = [];
        $errors = [];
        $count = 0;

        foreach ($importService as $rowIndex => $rowData) {
            $lineNum = $rowIndex + 1;

            if (!isset($rowData[self::COLUMN_PRODUCT_CODE], $rowData[self::COLUMN_SOURCE_QTY])) {
                return ['ok' => false, 'errors' => ['1行目の列名を確認してください（'.self::COLUMN_PRODUCT_CODE.'、'.self::COLUMN_SOURCE_QTY.'）。']];
            }

            $code = trim($rowData[self::COLUMN_PRODUCT_CODE]);
            if ($code === '') {
                $errors[] = "{$lineNum}行目: 商品コードが空です。";
                if (count($errors) >= self::MAX_ERROR_COUNT) {
                    break;
                }
                continue;
            }

            $qtyRaw = trim($rowData[self::COLUMN_SOURCE_QTY]);
            if ($qtyRaw === '' || !ctype_digit($qtyRaw) || (int) $qtyRaw < 1) {
                $errors[] = "{$lineNum}行目: 結合元在庫数が不正です（1以上の整数を指定してください）。";
                if (count($errors) >= self::MAX_ERROR_COUNT) {
                    break;
                }
                continue;
            }

            $srcPs = $this->productStockRepository->findOneByProductCodeAndBaseInfoAndStockLocation(
                $code,
                $destBaseInfo,
                $destStockLocationId
            );

            if ($srcPs === null) {
                $errors[] = "{$lineNum}行目: 商品コード「{$code}」は同一店舗・在庫区分で見つかりません。";
                if (count($errors) >= self::MAX_ERROR_COUNT) {
                    break;
                }
                continue;
            }

            if ($srcPs->getId() === $destPsId) {
                $errors[] = "{$lineNum}行目: 結合先と同一の在庫は結合元に指定できません。";
                if (count($errors) >= self::MAX_ERROR_COUNT) {
                    break;
                }
                continue;
            }

            $sources[(int) $srcPs->getId()] = ['quantity' => (int) $qtyRaw];
            ++$count;
        }

        if ($errors !== []) {
            if (count($errors) >= self::MAX_ERROR_COUNT) {
                array_unshift($errors, trans('admin.stock.csv.error_limit_notice'));
            }

            return ['ok' => false, 'errors' => $errors];
        }

        $sessionKey = sprintf('stock_join_edit_sources_%d', $this->stockSplitJoin->getId());
        $session->set($sessionKey, $sources);

        return ['ok' => true, 'count' => $count, 'errors' => []];
    }

    /** @return array<CsvColumnInterface> */
    protected function getColumns(): array
    {
        return [
            $this->productCodeColumn,
            $this->sourceQtyColumn,
        ];
    }

    /** @return array<RowValidatorInterface> */
    protected function getRowValidators(): array
    {
        return [];
    }

    private function initializeColumnDefinitions(): void
    {
        $this->productCodeColumn = ColumnDefinitions::productCode(self::COLUMN_PRODUCT_CODE)->setRequired(true);
        $this->sourceQtyColumn = ColumnDefinitions::editQuantity(self::COLUMN_SOURCE_QTY)->setRequired(true);
    }

    private function clearColumnDefinitions(): void
    {
        $this->productCodeColumn = null;
        $this->sourceQtyColumn = null;
    }
