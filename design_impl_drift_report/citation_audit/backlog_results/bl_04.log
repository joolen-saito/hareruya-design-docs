        $builder = $this->formFactory
            ->createBuilder(MallTenantShopType::class, $BaseInfo);

        $event = new EventArgs(
            [
                'builder' => $builder,
                'BaseInfo' => $BaseInfo,
            ],
            $request
        );
        $this->eventDispatcher->dispatch($event, EccubeEvents::ADMIN_MALL_TENANT_DETAIL_INITIALIZE);

        $CloneInfo = clone $BaseInfo;
        $this->entityManager->detach($CloneInfo);

        $form = $builder->getForm();
        $form->handleRequest($request);

        if ($form->isSubmitted() && $form->isValid()) {
            $objectKeysToDelete = [];

            try {
                $this->entityManager->wrapInTransaction(function () use ($activateCreationFlow, $BaseInfo, $CloneInfo, $form, &$objectKeysToDelete) {
                    $this->entityManager->persist($BaseInfo);
                    $this->entityManager->flush();

                    $fileAdapter = $this->fileManager->getAdapter();
                    $tmpDir = rtrim((string) $this->eccubeConfig->get('preferred_temp_tenant_image_path'), '/').'/';

                    // ショップアイコンの削除リクエストがあった場合
                    $deleteShopIcon = $form->get('delete_shop_icon_image')->getData();
                    if (is_string($deleteShopIcon) && $deleteShopIcon !== '') {
                        $currentShopIcon = $CloneInfo->getShopIcon();
                        if ($currentShopIcon === '' || !hash_equals($currentShopIcon, $deleteShopIcon)) {
                            throw new BadRequestHttpException();
                        }

                        // flush後にS3からファイルを削除するため、object keyを保持
                        $objectKeysToDelete[] = $currentShopIcon;

                        $BaseInfo->setShopIcon('');
                    }

                    // ショップアイコンの追加リクエストがあった場合は一時ディレクトリから本ディレクトリにファイルを移動
                    $addShopIcon = $form->get('add_shop_icon_image')->getData();
                    if (is_string($addShopIcon) && $addShopIcon !== '') {
                        $shopIconTempFile = $tmpDir.'shop_icon/'.$addShopIcon;

                        if ($fileAdapter->exists($shopIconTempFile, [])) {
                            $shopIconDir = FilesystemUtil::convertRawPathToDynamicPath(
                                ['id'],
                                $BaseInfo,
                                rtrim((string) $this->eccubeConfig->get('preferred_tenant_image_path'), '/').'/shop_icon/'
                            );

                            $existingShopIcon = $CloneInfo->getShopIcon();
                            if ($existingShopIcon !== '') {
                                $objectKeysToDelete[] = $existingShopIcon;
                            }

                            $fileAdapter->move($shopIconTempFile, $shopIconDir, $addShopIcon, []);

                            $BaseInfo->setShopIcon($fileAdapter->toEntitySaveData()['s3_object_key']);
                        }
                    }

                    // ご当地晴れる屋くん画像の削除リクエストがあった場合
                    $deleteHareruyakunImage = $form->get('delete_local_hareruyakun_image')->getData();
                    if (is_string($deleteHareruyakunImage) && $deleteHareruyakunImage !== '') {
                        $currentHareruyakunImage = $CloneInfo->getLocalHareruyakunImage();
                        if (!is_string($currentHareruyakunImage) || $currentHareruyakunImage === '' || !hash_equals($currentHareruyakunImage, $deleteHareruyakunImage)) {
                            throw new BadRequestHttpException();
                        }

                        $objectKeysToDelete[] = $currentHareruyakunImage;
                        $BaseInfo->setLocalHareruyakunImage(null);
                    }

                    // ご当地晴れる屋くん画像の追加リクエストがあった場合は一時ディレクトリから本ディレクトリにファイルを移動
                    $addHareruyakunImage = $form->get('add_local_hareruyakun_image')->getData();
                    if (is_string($addHareruyakunImage) && $addHareruyakunImage !== '') {
                        $hareruyakunImageTempFile = $tmpDir.'local_hareruyakun_image/'.$addHareruyakunImage;

                        if ($fileAdapter->exists($hareruyakunImageTempFile, [])) {
                            $hareruyakunImageDir = FilesystemUtil::convertRawPathToDynamicPath(
                                ['id'],
                                $BaseInfo,
                                rtrim((string) $this->eccubeConfig->get('preferred_tenant_image_path'), '/').'/local_hareruyakun_image/'
                            );

                            $existingHareruyakunImage = $CloneInfo->getLocalHareruyakunImage();
                            if (is_string($existingHareruyakunImage) && $existingHareruyakunImage !== '') {
                                $objectKeysToDelete[] = $existingHareruyakunImage;
                            }

                            $fileAdapter->move($hareruyakunImageTempFile, $hareruyakunImageDir, $addHareruyakunImage, []);

                            $BaseInfo->setLocalHareruyakunImage($fileAdapter->toEntitySaveData()['s3_object_key']);
                        }
                    }

                    $this->entityManager->flush();

                    // 新規作成の場合はテナント初期化処理を実行
                    if ($activateCreationFlow === true) {
                        // テナント初期化処理
                        $this->createTenantManager->createTenant($BaseInfo);
                    }
