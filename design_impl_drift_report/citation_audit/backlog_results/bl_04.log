     *
     * @return array<string, mixed> - 配列
     *
     * @throws \Doctrine\DBAL\Exception - Doctrine DBAL例外
     */
    #[Route(path: '/%eccube_admin_route%/mall/tenant', name: 'admin_mall_tenant_index', methods: ['GET', 'POST'])]
    #[Route(path: '/%eccube_admin_route%/mall/tenant/page/{page_no}', name: 'admin_mall_tenant_index_page', methods: ['GET', 'POST'])]
    #[Template(template: '@admin/mall/tenant/index.twig')]
    public function index(Request $request, PaginatorInterface $paginator, ?int $page_no = null): array
    {
        $builder = $this->formFactory
            ->createBuilder(SearchTenantType::class);

        $event = new EventArgs(
            [
                'builder' => $builder,
            ],
            $request
        );
        $this->eventDispatcher->dispatch($event, EccubeEvents::ENTERPRISE_ADMIN_MALL_TENANT_INDEX_INITIALIZE);

        $searchForm = $builder->getForm();

        // セッションからページ番号を取得.
        $page_count = $this->session->get(
            'eccube.enterprise.admin.mall.tenant.search.page_count',
            $this->eccubeConfig->get('eccube_default_page_count')
        );
        $page_count_param = (int) $request->get('page_count');
        $pageMaxis = $this->pageMaxRepository->findAll();

        // ページ数の選択がある場合は, セッションに保存する.
        if ($page_count_param) {
            foreach ($pageMaxis as $pageMax) {
                if ($page_count_param == $pageMax->getName()) {
                    $page_count = $pageMax->getName();
                    $this->session->set('eccube.enterprise.admin.mall.tenant.search.page_count', $page_count);
                    break;
                }
            }
        }

        if ('POST' === $request->getMethod()) {
            $searchForm->handleRequest($request);

            if ($searchForm->isValid()) {
                /**
                 * 検索が実行された場合は, セッションに検索条件を保存する.
                 * ページ番号は最初のページ番号に初期化する.
                 */
                $page_no = 1;
                $searchData = $searchForm->getData();

                // 検索条件, ページ番号をセッションに保持.
                $this->session->set('eccube.enterprise.admin.mall.tenant.search', FormUtil::getViewData($searchForm));
                $this->session->set('eccube.enterprise.admin.mall.tenant.search.page_no', $page_no);
            } else {
                // 検索エラーの際は, 詳細検索枠を開いてエラー表示する.
                return [
                    'searchForm' => $searchForm->createView(),
                    'pagination' => [],
                    'pageMaxis' => $pageMaxis,
                    'page_no' => $page_no,
                    'page_count' => $page_count,
                    'has_errors' => true,
                ];
            }
        } else {
            if (null !== $page_no || $request->get('resume') !== null) {
                /*
                 * ページ送りの場合または、他画面から戻ってきた場合は, セッションから検索条件を復旧する.
                 */
                // ページ送りで遷移した場合.
                $this->session->set('eccube.enterprise.admin.mall.tenant.search.page_no', $page_no);
                $viewData = $this->session->get('eccube.enterprise.admin.mall.tenant.search', []);
                $searchData = FormUtil::submitAndGetData($searchForm, $viewData);
            } else {
                /**
                 * 初期表示の場合.
                 */
                $page_no = 1;
                // submit default value
                $viewData = FormUtil::getViewData($searchForm);
                $searchData = FormUtil::submitAndGetData($searchForm, $viewData);

                // セッション中の検索条件, ページ番号を初期化.
                $this->session->set('eccube.enterprise.admin.mall.tenant.search', $viewData);
                $this->session->set('eccube.enterprise.admin.mall.tenant.search.page_no', $page_no);
            }
        }

        // 検索条件に基づいてクエリを生成.
        $tenantsQueryBuilder = $this->baseInfoRepository->getQueryBuilderBySearchDataForAdmin(
            $this->baseInfoRepository->getTenantData(),
            $searchData
        );

        $event = new EventArgs(
            [
                'qb' => $tenantsQueryBuilder,
                'searchData' => $searchData,
            ],
            $request
        );

        $this->eventDispatcher->dispatch($event, EccubeEvents::ENTERPRISE_ADMIN_MALL_TENANT_INDEX_SEARCH);

        // ページネーション.
        $pagination = $paginator->paginate(
            $tenantsQueryBuilder,
            $page_no,
            $page_count
        );

        $event = new EventArgs(
            [
                'searchData' => $searchData,
            ],
            $request
        );
        $this->eventDispatcher->dispatch($event, EccubeEvents::ADMIN_MALL_TENANT_INDEX_COMPLETE);

        return [
            'searchForm' => $searchForm->createView(),
            'pageMaxis' => $pageMaxis,
            'base_info_pagination' => $pagination,
            'page_count' => $page_count,
        ];
    }

