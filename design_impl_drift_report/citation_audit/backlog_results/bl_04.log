namespace Eccube\Service\Admin\Analysis;

use Doctrine\ORM\EntityManagerInterface;
use Eccube\Common\EccubeConfig;
use Eccube\Repository\DtbDailySummaryRepository;

class BatchAggregateDailySummaryAction
{
    public function __construct(
        private readonly EccubeConfig $eccubeConfig,
        private readonly EntityManagerInterface $entityManager,
        private readonly DtbDailySummaryRepository $dailySummaryRepository,
    ) {
    }

    public function handle(\DateTimeInterface $summaryDate): int
    {
        $summaryDateFrom = \DateTime::createFromInterface($summaryDate)->setTime(0, 0, 0);
        $summaryDateTo = \DateTime::createFromInterface($summaryDate)->setTime(23, 59, 59);
        $rootBaseInfoId = (int) $this->eccubeConfig->get('eccube_root_base_info_id');

        $orderRows = $this->dailySummaryRepository->aggregateOrderSummaryByBaseInfo($summaryDateFrom, $summaryDateTo);
        $purchaseRows = $this->dailySummaryRepository->aggregatePurchaseSummaryByBaseInfo($rootBaseInfoId, $summaryDateFrom, $summaryDateTo);
        $wasteRows = $this->dailySummaryRepository->aggregateDisposalQuantityByBaseInfo($summaryDateFrom, $summaryDateTo);
        $shortageRows = $this->dailySummaryRepository->aggregateShortageQuantityByBaseInfo($summaryDateFrom, $summaryDateTo);

        /** @var array<int, array<string, int>> $summaries */
        $summaries = [];
        foreach ($orderRows as $row) {
            $baseInfoId = (int) ($row['base_info_id'] ?? 0);
            if ($baseInfoId < 1) {
                continue;
            }

            $summaries[$baseInfoId] = array_merge(
                $this->createEmptySummary($baseInfoId),
                [
                    'order_amount_order' => (int) ($row['order_amount_order'] ?? 0),
                    'cost' => (int) ($row['cost'] ?? 0),
                    'sale_quantity' => (int) ($row['sale_quantity'] ?? 0),
                    'buyer_count' => (int) ($row['buyer_count'] ?? 0),
                ]
            );
        }

        foreach ($purchaseRows as $row) {
            $baseInfoId = (int) ($row['base_info_id'] ?? 0);
            if ($baseInfoId < 1) {
                continue;
            }

            if (!isset($summaries[$baseInfoId])) {
                $summaries[$baseInfoId] = $this->createEmptySummary($baseInfoId);
            }

            $summaries[$baseInfoId]['purchase_count'] += (int) ($row['purchase_count'] ?? 0);
            $summaries[$baseInfoId]['purchase_amount'] += (int) ($row['purchase_amount'] ?? 0);
        }

        foreach ($wasteRows as $row) {
            $baseInfoId = (int) ($row['base_info_id'] ?? 0);
            if ($baseInfoId < 1) {
                continue;
            }

            if (!isset($summaries[$baseInfoId])) {
                $summaries[$baseInfoId] = $this->createEmptySummary($baseInfoId);
            }

            $summaries[$baseInfoId]['waste_count'] += (int) ($row['waste_quantity'] ?? 0);
        }

        foreach ($shortageRows as $row) {
            $baseInfoId = (int) ($row['base_info_id'] ?? 0);
            if ($baseInfoId < 1) {
                continue;
            }

            if (!isset($summaries[$baseInfoId])) {
                $summaries[$baseInfoId] = $this->createEmptySummary($baseInfoId);
            }

            $summaries[$baseInfoId]['shortage_count'] += (int) ($row['shortage_quantity'] ?? 0);
        }

        $rows = array_values($summaries);

        $connection = $this->entityManager->getConnection();
        $connection->beginTransaction();
        try {
            // 再集計に備え、対象日の既存集計を一旦すべて削除してから登録し直す。
            // 失敗時はトランザクションごとロールバックされ、削除前の状態に戻る。
            $this->dailySummaryRepository->deleteBySummaryDate($summaryDateFrom);

            $affected = 0;
            foreach ($rows as $row) {
                $baseInfoId = (int) ($row['base_info_id'] ?? 0);
                $grossSales = (int) ($row['order_amount_order'] ?? 0);
                $totalCost = (int) ($row['cost'] ?? 0);
                $saleCount = (int) ($row['buyer_count'] ?? 0);
                $saleAverage = $saleCount > 0
                    ? (int) ceil($grossSales / $saleCount)
                    : 0;

                $this->dailySummaryRepository->insertDailySummary(
                    $summaryDateFrom,
                    $baseInfoId,
                    [
                        'gross_sales' => $grossSales,
                        'total_cost' => $totalCost,
                        'gross_profit' => $grossSales - $totalCost,
                        'sale_quantity' => (int) ($row['sale_quantity'] ?? 0),
                        'sale_count' => $saleCount,
                        'sale_average' => $saleAverage,
                        'purchase_count' => (int) ($row['purchase_count'] ?? 0),
                        'purchase_amount' => (int) ($row['purchase_amount'] ?? 0),
                        'waste_count' => (int) ($row['waste_count'] ?? 0),
                        'shortage_count' => (int) ($row['shortage_count'] ?? 0),
                    ]
                );
                ++$affected;
            }

            $connection->commit();

            return $affected;
        } catch (\Throwable $e) {
            $connection->rollBack();
            throw $e;
        }
    }

    /**
     * 集計値が未設定の店舗別サマリ行を生成する。
     *
     * @return array<string, int>
     */
    private function createEmptySummary(int $baseInfoId): array
    {
        return [
            'base_info_id' => $baseInfoId,
            'order_amount_order' => 0,
            'cost' => 0,
            'sale_quantity' => 0,
            'buyer_count' => 0,
            'purchase_count' => 0,
            'purchase_amount' => 0,
            'waste_count' => 0,
            'shortage_count' => 0,
        ];
    }
}
