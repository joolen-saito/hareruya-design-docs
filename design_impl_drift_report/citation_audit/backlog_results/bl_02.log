    #[Route(path: '/deck/', name: 'deck_index', methods: ['GET'])]
    #[Template(template: 'Deck/index.twig')]
    public function index(): array|Response
    {
        $rankFormats = [];
        $metaData = [];
        $metaRangeDates = [];
        foreach ($this->mtbFormatRepository->findBy(['ranking_flg' => true], ['rank' => 'ASC']) as $Format) {
            $rankFormats[$Format->getId()] = $Format;
            $metaData[$Format->getId()] = $this->dtbDeckRepository->getDeckCountByFormatId(
                $Format->getId(),
                $Format->getMetaRange(),
                self::RANKING_LIMIT,
            );
            $metaRangeDates[$Format->getId()] = $this->dtbDeckRepository->getMetaDate($Format->getMetaRange());
        }

        $otherMetaData = [];
        foreach ($this->mtbFormatRepository->findBy(['other_meta_flg' => true], ['rank' => 'ASC']) as $Format) {
            $otherMetaData[$Format->getId()] = $Format;
        }

        $latestEvents = $this->mtbLatestEventDeckRepository->getLatestEventDeck();

        return [
            'rankFormats' => $rankFormats,
            'metaData' => $metaData,
            'metaRangeDates' => $metaRangeDates,
            'otherMetaData' => $otherMetaData,
            'latestEvents' => $latestEvents,
        ];
    }

    /**
     * @return array<string, mixed>|Response
     */
