{
    private const COOKIE_SHOP_KEY = 'shop';
    private const BANNER_LIMIT = 8;
    private const SPECIAL_BANNER_LIMIT = 10;

    public function __construct(
        private readonly BaseInfoRepository $baseInfoRepository,
        private readonly MtbBannerRepository $bannerRepository,
    ) {
    }

    #[Route(path: '/events', name: 'event_top', methods: ['GET'])]
    public function index(Request $request): Response
    {
        $shopId = $this->resolveShopId($request);
        $Shop = $this->baseInfoRepository->find($shopId);
        if ($Shop === null) {
            throw $this->createNotFoundException();
        }

        $Banners = $this->bannerRepository->findWhereUrlIsNotEmpty(
            $shopId,
            $request->getLocale(),
            self::BANNER_LIMIT,
            [MtbBanner::SHOW_BOTH, MtbBanner::SHOW_ONLY_SLIDE],
        );
        $SpecialBanners = $this->bannerRepository->findWhereUrlIsNotEmpty(
            $shopId,
            $request->getLocale(),
            self::SPECIAL_BANNER_LIMIT,
            [MtbBanner::SHOW_BOTH, MtbBanner::SHOW_ONLY_CAMPAIGN],
        );
        $OpenShops = $this->baseInfoRepository->getOpenShops();

        $response = $this->render('Event/index.twig', [
            'Shop' => $Shop,
            'OpenShops' => $OpenShops,
            'Banners' => $Banners,
            'SpecialBanners' => $SpecialBanners,
        ]);

        if ((string) $request->cookies->get(self::COOKIE_SHOP_KEY, '') !== (string) $shopId) {
            $response->headers->setCookie(Cookie::create(self::COOKIE_SHOP_KEY)
                ->withValue((string) $shopId)
                ->withPath('/'));
        }

        return $response;
    }

    /**
     * クエリ `?shop=X` → Cookie `shop` → 既定店舗 ID の順で店舗 ID を解決する (現行踏襲)。
     */
    private function resolveShopId(Request $request): int
    {
        $queryShop = $request->query->get('shop');
        if ($queryShop !== null && ctype_digit((string) $queryShop)) {
            return (int) $queryShop;
        }

        $cookieShop = $request->cookies->get(self::COOKIE_SHOP_KEY);
        if ($cookieShop !== null && ctype_digit((string) $cookieShop)) {
            return (int) $cookieShop;
        }

        return (int) $this->eccubeConfig->get('eccube_root_base_info_id');
            ->select(['b', 's'])
            ->leftJoin('b.BaseInfos', 's')
            ->getQuery();

        return $query->execute();
    }

    /**
     * 条件に一致する画像URLが空文字でないレコードをすべて返す
     *
     * @param array<int, mixed> $dispTypes
     */
    public function findWhereUrlIsNotEmpty(int $baseInfoId, string $locale, int $limit, array $dispTypes = []): mixed
    {
        // localeとlocaleIdの対応づけ処理
        $localeId = $locale === 'en' ? MtbLanguage::EN_ID : MtbLanguage::JP_ID;

        $qb = $this->createQueryBuilder('b');
        $query = $qb->join('b.BaseInfos', 's')
            ->join('b.Languages', 'l')
            ->where($qb->expr()->eq('s.id', ':baseInfoId'))
            ->andWhere($qb->expr()->eq('l.id', ':localeId'))
            ->andWhere($qb->expr()->in('b.dispType', ':dispTypes'))
            ->andWhere("b.imageUrl <> ''")
            ->setParameter('baseInfoId', $baseInfoId)
            ->setParameter('localeId', $localeId)
            ->setParameter('dispTypes', $dispTypes)
            ->setMaxResults($limit)
            ->getQuery();

        return $query->execute();
    }
}
