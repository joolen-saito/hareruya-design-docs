     * @return ProductClass[]
     */
    public function findTopSaleProductsByBaseInfo(int $baseInfoId, string $locale, int $limit): array
    {
        $sql = <<<'SQL'
            SELECT p.id
            FROM dtb_product p
            LEFT JOIN mtb_region_restriction rr ON rr.id = p.region_restriction_id
            WHERE p.product_status_id = :statusShow
              AND (rr.display_locale_list IS NULL OR rr.display_locale_list LIKE :locale)
              AND EXISTS (
                  SELECT 1
                  FROM dtb_product_class pc
                  INNER JOIN dtb_product_stock ps ON ps.product_class_id = pc.id
                  INNER JOIN dtb_product_tag pt ON pt.product_id = pc.product_id AND pt.tag_id = :saleTagId
                  WHERE pc.product_id = p.id
                    AND pc.visible = true
                    AND pc.sale_flg = true
                    AND pc.price02 >= 1
                    AND ps.stock > 0
                    AND ps.base_info_id = :baseInfoId
              )
            ORDER BY RANDOM()
            LIMIT :limit
            SQL;

        $rows = $this->getEntityManager()->getConnection()->executeQuery($sql, [
            'statusShow' => ProductStatus::DISPLAY_SHOW,
            'locale' => '%'.$locale.'%',
            'saleTagId' => Tag::SALE_ID,
            'baseInfoId' => $baseInfoId,
            'limit' => $limit,
        ])->fetchAllAssociative();

        $productIds = array_map(static fn (array $row): int => (int) $row['id'], $rows);
        if ($productIds === []) {
            return [];
        }

        /** @var ProductClass[] $candidates */
        $candidates = $this->getEntityManager()->createQueryBuilder()
            ->select('pc', 'p')
            ->from(ProductClass::class, 'pc')
            ->innerJoin('pc.Product', 'p')
            ->where('p.id IN (:productIds)')
            ->andWhere('pc.visible = true')
            ->andWhere('pc.sale_flg = true')
            ->andWhere('pc.price02 >= 1')
            ->andWhere('EXISTS (
                SELECT 1 FROM \Eccube\Entity\ProductStock ps
                WHERE ps.ProductClass = pc
                  AND ps.stock > 0
                  AND IDENTITY(ps.baseInfo) = :baseInfoId
            )')
            ->setParameter('productIds', $productIds)
            ->setParameter('baseInfoId', $baseInfoId)
            ->getQuery()
            ->getResult();

        $selectedByProductId = [];
        foreach ($candidates as $ProductClass) {
            $productId = $ProductClass->getProduct()->getId();
            $current = $selectedByProductId[$productId] ?? null;
            if ($current === null || $this->isBetterCardCondition($ProductClass, $current)) {
                $selectedByProductId[$productId] = $ProductClass;
            }
        }

        $ordered = [];
        foreach ($productIds as $id) {
            if (isset($selectedByProductId[$id])) {
                $ordered[] = $selectedByProductId[$id];
            }
        }

        return $ordered;
    }

    /**
     * 指定支店でピックアップフラグが立っている ProductClass を持つ公開商品を上位取得する。
     *
     * @return ProductClass[]
     */
    public function findTopPickUpProductsByBaseInfo(int $baseInfoId, string $locale, int $limit): array
    {
        /** @var ProductClass[] $candidates */
        $candidates = $this->getEntityManager()->createQueryBuilder()
            ->select('pc', 'p')
            ->from(ProductClass::class, 'pc')
            ->innerJoin('pc.Product', 'p')
            ->leftJoin('p.RegionRestriction', 'rr')
            ->where('pc.visible = true')
            ->andWhere('p.Status = :statusShow')
            ->andWhere('EXISTS (
                SELECT 1 FROM \Eccube\Entity\ProductStock ps
                WHERE ps.ProductClass = pc
                  AND ps.stock > 0
                  AND ps.pick_up_flg = true
                  AND IDENTITY(ps.baseInfo) = :baseInfoId
            )')
            ->andWhere('(rr.display_locale_list IS NULL OR rr.display_locale_list LIKE :locale)')
            ->setParameter('statusShow', ProductStatus::DISPLAY_SHOW)
            ->setParameter('baseInfoId', $baseInfoId)
            ->setParameter('locale', '%'.$locale.'%')
            ->getQuery()
            ->getResult();

        $selectedByProductId = [];
        foreach ($candidates as $ProductClass) {
            $productId = $ProductClass->getProduct()->getId();
            $current = $selectedByProductId[$productId] ?? null;
            if ($current === null || $this->isBetterCardCondition($ProductClass, $current)) {
                $selectedByProductId[$productId] = $ProductClass;
            }
        }

        $selected = array_values($selectedByProductId);
        usort($selected, static fn (ProductClass $a, ProductClass $b): int => $b->getProduct()->getId() <=> $a->getProduct()->getId());

        return array_slice($selected, 0, $limit);
    }

    /**
     * フロントブロック用: Tag + 在庫 + 地域制限フィルタを満たす公開商品を上位取得する。
     *
     * pf-eccube3 の ProductFinder が適用していた stock>=1 / locale (display_locale_list) 条件を踏襲し、
     * フィルタ通過した ProductClass から Product 単位に 1 件選出して返す。
     * Tag の priority_products (1行1コード) に登録されているコードを持つ ProductClass を優先表示する。
     *
     * @return ProductClass[]
     */
    public function findTopPublicProductsByTag(int $tagId, string $locale, int $limit, ?int $baseInfoId = null): array
    {
        $priorityIndex = $this->resolveTagPriorityIndex($tagId);

        /** @var ProductClass[] $candidates */
        $candidates = $this->buildPublicProductClassesByTagQueryBuilder($tagId, $locale, $baseInfoId)
            ->getQuery()
            ->getResult();

        $selectedByProductId = [];
        foreach ($candidates as $ProductClass) {
            $productId = $ProductClass->getProduct()->getId();
            $current = $selectedByProductId[$productId] ?? null;
            if ($current === null || $this->compareProductClassPreference($ProductClass, $current, $priorityIndex) < 0) {
                $selectedByProductId[$productId] = $ProductClass;
            }
        }

        $selected = array_values($selectedByProductId);
        usort($selected, function (ProductClass $a, ProductClass $b) use ($priorityIndex): int {
            $aPos = $this->priorityPositionOfProductClass($a, $priorityIndex);
            $bPos = $this->priorityPositionOfProductClass($b, $priorityIndex);
            if ($aPos !== $bPos) {
                return $aPos <=> $bPos;
            }

            return $b->getProduct()->getId() <=> $a->getProduct()->getId();
        });

        return array_slice($selected, 0, $limit);
    }

    /**
     * 公開中で指定Tagを持ち、在庫があり、locale が表示対象に含まれる ProductClass を取得する QueryBuilder を返す。
     */
    private function buildPublicProductClassesByTagQueryBuilder(int $tagId, string $locale, ?int $baseInfoId = null): QueryBuilder
    {
        $effectiveBaseInfoId = $baseInfoId ?? (int) $this->eccubeConfig->get('eccube_root_base_info_id');

        return $this->getEntityManager()->createQueryBuilder()
            ->select('pc', 'p')
            ->from(ProductClass::class, 'pc')
            ->innerJoin('pc.Product', 'p')
            ->leftJoin('p.RegionRestriction', 'rr')
            ->where('pc.visible = true')
            ->andWhere('p.Status = :statusShow')
            ->andWhere('EXISTS (
                SELECT 1 FROM \Eccube\Entity\ProductTag pt
                WHERE pt.Product = p AND IDENTITY(pt.Tag) = :tagId
            )')
            ->andWhere('EXISTS (
                SELECT 1 FROM \Eccube\Entity\ProductStock ps
                WHERE ps.ProductClass = pc
                  AND ps.stock > 0
                  AND IDENTITY(ps.baseInfo) = :baseInfoId
            )')
            ->andWhere('rr.display_locale_list IS NULL OR rr.display_locale_list LIKE :locale')
            ->setParameter('statusShow', ProductStatus::DISPLAY_SHOW)
            ->setParameter('tagId', $tagId)
            ->setParameter('locale', '%'.$locale.'%')
            ->setParameter('baseInfoId', $effectiveBaseInfoId);
    }

