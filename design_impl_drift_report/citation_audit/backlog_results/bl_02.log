{% extends 'default_frame.twig' %}

{% set body_class = 'front_page p-hareruya-deck' %}

{% block stylesheet %}
    <link rel="stylesheet" href="{{ asset('assets/hareruya/css/hareruya-deck.css') }}">
{% endblock %}

{% block javascript %}
    <script src="{{ asset('assets/hareruya/js/hareruya-deck.js') }}" defer></script>
{% endblock %}

{% block main %}
    <div class="theme_main_only" id="contents">
        {{ include('breadcrumb_nav.twig') }}
        <div class="container-fluid inner">
            <div id="main">
                <div id="main_top"></div>
                <div class="ranking_banner">
                    <a href="{{ url('deck_usage_ranking', { formatId: 1 }) }}">
                        <picture>
                            <source srcset="{{ asset('assets/hareruya/img/deck/bnr_deck_ranking_pc.webp') }}" media="(min-width: 1024px)" type="image/webp">
                            <img src="{{ asset('assets/hareruya/img/deck/bnr_deck_ranking.webp') }}" width="343" height="64" alt="{{ 'front.deck.usage_ranking_banner_alt'|trans }}" fetchpriority="high">
                        </picture>
                    </a>
                </div>
                <div id="main_middle">
                    <div class="event-main-middle-wrapper">
                        <div class="deckSearch-top__flexwrapper deckSearch-top__flexwrapper--rankingView">
                            {% for format in rankFormats %}
                            <div class="deckSearch-top__metagame__wrapper">
                                {% set metaList = attribute(metaData, format.id) %}
                                {% set metaTop = (metaList|length) ? metaList[0] : [] %}
                                {% if metaTop|length %}
                                <a class="deckSearch-top__archetype__numberonelink pc" href="{{ url('deck_result', { 'archetypeIds': metaTop.archetypeId, 'dateFrom': attribute(metaRangeDates, format.id) }) }}" style="background-image: url('{{ archetype_path(metaTop.url) }}')">
                                    {{ metaTop.nameJp }}
                                </a>
                                {% endif %}
                                <div class="deckSearch-top__metagame-title deckSearch-top__metagame-title-{{ format.code }} deckSearch-top__metagame-title-clicked">
                                    {{ format.nameJp }}メタゲーム<span class="deckSearch-top__metagame-title__aggrpriod pc">{{ attribute(metaRangeDates, format.id) }}~</span>
                                    <a class="deckSearch-top__metagame-title__link" href="{{ url('deck_metagame', {formatId: format.id}) }}"></a>
                                </div>
                                <div class="deckSearch-top__archetype__wrapper deckSearch-top__archetype__wrapper-{{ format.code }}">
                                    {% for meta in metaList %}
                                    <a class="deckSearch-top__archetype__link" href="{{ url('deck_result', { 'archetypeIds': meta.archetypeId, 'dateFrom': attribute(metaRangeDates, format.id) }) }}">
                                        <span class="deckSearch-top__archetype__rank pc">{{ loop.index }}</span>
                                        <div class="deckSearch-top__archetype__container-bg" style="background-image: url({{ archetype_path(meta.url) }})">
                                            <div class="deckSearch-top__archetype__container">
                                                <span class="deckSearch-top__archetype-name">{{ meta.nameJp }}</span><br>
                                                <span class="deckSearch-top__archetype-count">{{ 'front.deck.deck_count_prefix'|trans }}{{ meta.deckcount }}</span>
                                            </div>
                                        </div>
                                    </a>
                                    {% endfor %}
                                </div>
                                <a class="deckSearch-top__archetype__link--more c-hareruya-btn c-hareruya-btn--md" href="{{ url('deck_metagame', {formatId: format.id}) }}">{{ 'front.deck.see_more'|trans }}<i class="icon-hareruya-arrow-right c-hareruya-icon--xs"></i></a>
                            </div>
                            {% endfor %}
                        </div>
                        <div class="deckSearch-top__flexwrapper deckSearch-top__flexwrapper--second">
                            {% for key, other in otherMetaData %}
                            <div class="deckSearch-top__metagame__wrapper">
                                <a href="{{ url('deck_metagame', {formatId: other.id}) }}" class="deckSearch-top__metagame-title deckSearch-top__metagame-title-{{ other.code }}">
                                    {{ other.nameJp }}{{ 'front.deck.metagame_title_suffix'|trans }}
                                </a>
                            </div>
                            {% if loop.index == 8 %}
                                </div>
                                <div class="deckSearch-top__flexwrapper deckSearch-top__flexwrapper--last">
                            {% endif %}
                            {% endfor %}
                            <div class="deckSearch-top__metagame__wrapper">
                                <a href="{{ url('deck_others') }}" class="deckSearch-top__metagame-title deckSearch-top__metagame-title-other">
                                    {{ 'front.deck.others'|trans }}
                                </a>
                            </div>
                        </div>

