namespace Eccube\Service\ProductList;

use Eccube\Entity\BaseInfo;
use Eccube\Entity\Master\MtbCardCondition;
use Eccube\Entity\Master\MtbLanguage;
use Eccube\Entity\Product;
use Eccube\Entity\ProductClass;
use Eccube\Repository\DtbSalesQuantityRepository;
use Eccube\Repository\ProductClassRepository;
use Eccube\Service\BaseInfoService;
use Eccube\Service\Product\MaxPriceInStockProductClassFinder;
use Symfony\Component\DependencyInjection\ParameterBag\ParameterBagInterface;

/**
 * 本店（pf）商品一覧カード相当の表示用データを組み立てる.
 *
 * @phpstan-type ListVariantRow array{
 *     variantId: string,
 *     language: string,
 *     condition: string,
 *     price02: string|null,
 *     stock: int,
 *     stockUnlimited: bool,
 *     stockFind: bool,
 *     defaultQuantity: int,
 *     classcategory_id1: string,
 *     classcategory_id2: string
 * }
 * @phpstan-type ProductListCardViewModel array{
 *     lead_class: ProductClass,
 *     product_classes: list<ProductClass>,
 *     display_other_conditions: bool,
 *     weekly_sold: int,
 *     all_sold_out: bool,
 *     card_id: ?int,
 *     condition_display_min_price: int,
 *     list_variants: list<ListVariantRow>,
 *     list_badges: array{sale: bool, reservation: bool, point_up: bool},
 *     eccube_stock_by_product_class_id: array<string, int>
 * }
 *
 * eccube_stock_by_product_class_id: 規格 ID（文字列キー）。無制限は 0（表示は stockUnlimited）。
 */
class ProductListCardViewModelBuilder
{
    public function __construct(
        private readonly ProductClassRepository $productClassRepository,
        private readonly DtbSalesQuantityRepository $dtbSalesQuantityRepository,
        private readonly ParameterBagInterface $parameterBag,
        private readonly BaseInfoService $baseInfoService,
    ) {
    }

    /**
     * @return ProductListCardViewModel|null
     */
    public function build(Product $product, int $preferredLanguageId): ?array
    {
        $representative = $this->productClassRepository->findRepresentativeProductClassForListWithLanguageFallback(
            $product->getId(),
            $preferredLanguageId
        );
        if ($representative === null) {
            return null;
        }

        return $this->buildFromRepresentativeProductClass($product, $representative, $preferredLanguageId);
    }

    /**
     * 商品一覧用。代表規格ベースが組めないときは visible 規格からフォールバックする.
     *
     * @return ProductListCardViewModel|null 表示可能な規格が1件もないときのみ null
     */
    public function buildForProductList(Product $product, int $preferredLanguageId): ?array
            $classes,
            static function (ProductClass $a, ProductClass $b) use ($order): int {
                return ($order[$a->getId()] ?? \PHP_INT_MAX) <=> ($order[$b->getId()] ?? \PHP_INT_MAX);
            }
        );
    }

    /**
     * @param list<ProductClass> $filtered
     *
     * @return ProductListCardViewModel
     */
    private function assembleViewModel(Product $product, ProductClass $leadClass, array $filtered, int $minPrice, int $preferredLanguageId): array
    {
        $shop = $this->baseInfoService->getByRequestShop();
        $displayOther = $this->isDisplayOtherConditions($filtered, $minPrice, $shop);
        $weeklySold = $this->sumWeeklySold($filtered);
        $allSoldOut = $this->isAllSoldOut($filtered, $minPrice, $shop);

        $card = $product->getCardDetail()?->getCard();
        $cardId = $card?->getId();

        return [
            'lead_class' => $leadClass,
            'product_classes' => $filtered,
            'display_other_conditions' => $displayOther,
            'weekly_sold' => $weeklySold,
            'all_sold_out' => $allSoldOut,
            'card_id' => $cardId,
            'condition_display_min_price' => $minPrice,
            'list_variants' => $this->buildListVariantsForVisibleProduct($product, $shop, $preferredLanguageId, $minPrice, $displayOther),
            'list_badges' => $this->buildListBadges($leadClass),
            'eccube_stock_by_product_class_id' => $this->buildEccubeStockByProductClassId($filtered, $shop),
        ];
    }

    /**
     * 商品に紐づく visible かつ販売価格>0 の規格（一覧カードのバリエーション UI 用）.
     * {@see filterByDisplayMinPrice} と同じ価格閾値を適用する。他の状態非表示時は NM のみ残す.
     *
     * @return list<ListVariantRow>
     */
    private function buildListVariantsForVisibleProduct(
        Product $product,
        BaseInfo $shop,
        int $preferredLanguageId,
        int $minPrice,
        bool $displayOtherConditions,
    ): array {
        $productClasses = [];

        foreach ($product->getProductClasses() as $pc) {
            if (!$pc->isVisible() || (int) $pc->getPrice02() <= 0) {
                continue;
            }
            $langId = $pc->getLanguage()?->getId();
            if ($langId !== null && $langId !== $preferredLanguageId) {
                continue;
            }
            $code = $pc->getCardCondition()?->getCode();
            if (!$displayOtherConditions && $code !== MtbCardCondition::CODE_NEAR_MINT) {
                continue;
            }
            if ($code !== MtbCardCondition::CODE_NEAR_MINT && (int) $pc->getPrice02() < $minPrice) {
                continue;
            }
            $productClasses[] = $pc;
        }

        $defaultQuantityClassId = MaxPriceInStockProductClassFinder::find($productClasses, $shop)?->getId();

        $rows = [];
        foreach ($productClasses as $pc) {
            $rows[] = $this->serializeVariantRow($pc, $shop, $defaultQuantityClassId);
        }

        usort($rows, function (array $a, array $b): int {
            $lk = $a['language'].$a['condition'].(string) $a['variantId'];
            $rk = $b['language'].$b['condition'].(string) $b['variantId'];

            return $lk <=> $rk;

            return $this->json([
                'message' => trans('front.cart.product.request_notlogin.message'),
                'status' => 'nologin',
            ]);
        }

        $Player = $playerRepository->findOneBy(['Customer' => $Customer]);
        if (!$Player) {
            return $this->json([
                'message' => trans('front.cart.product.request_notlogin.message'),
                'status' => 'nologin',
            ]);
        }

        $ProductRequest = $productRequestRepository->findOneBy(
            $ProductClass !== null
                // 規格単位の依頼
                ? ['Player' => $Player, 'ProductClass' => $ProductClass]
                // 商品×言語単位の依頼
                : ['Player' => $Player, 'Product' => $Product, 'Language' => $Language]
        );

        // 既に通知依頼が存在する場合は削除
        if ($ProductRequest !== null) {
            $this->entityManager->remove($ProductRequest);
            $this->entityManager->flush();

            return $this->json([
                'message' => trans('front.cart.product_request.cancel'),
                'status' => 'cancel',
            ]);
        }

        $compare = $productRequestRepository->compareRequestCountAndMax($Player->getId());
        if ($compare !== null) {
            return $this->json([
                'message' => sprintf(trans('front.cart.product.over_request_count.message'), $compare['max_value']),
                'status' => 'fail',
            ]);
        }

        // 通知依頼を新規作成
        $input = new NotifylistProductCreateInput(
            Player: $Player,
            ProductClass: $ProductClass,
            Product: $ProductClass === null ? $Product : null,
            Language: $ProductClass === null ? $Language : null,
        );

        try {
            $notifylistProductAction->handle($input);
        } catch (\Exception $e) {
            log_error($e->getMessage());
        }

        return $this->json([
            'message' => trans('front.cart.product_request.success'),
            'status' => 'success',
        ]);
    }
}

