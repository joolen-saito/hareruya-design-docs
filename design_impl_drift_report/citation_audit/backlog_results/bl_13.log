        $maxPriceInStockProductClass = MaxPriceInStockProductClassFinder::find(
            array_column($productClassStocks, 'productClass'),
            $shopForStock
        );
        $maxPriceInStockProductClassId = $maxPriceInStockProductClass?->getId();

        foreach ($productClassStocks as $productClassStock) {
            $ProductClass = $productClassStock['productClass'];
            $stock = $productClassStock['stock'];
            $maxAttr = [];

            // 在庫制限がある場合のみ max 属性をセット
            if ($stock !== null) {
                $maxAttr['max'] = (int) $stock;
            }

            $builder->add('quantity_'.$ProductClass->getId(), HiddenType::class, [
                // 在庫がある中で最大価格の規格の数量を1、他は0とする
                'data' => $ProductClass->getId() === $maxPriceInStockProductClassId ? 1 : 0,
                'label' => false,
