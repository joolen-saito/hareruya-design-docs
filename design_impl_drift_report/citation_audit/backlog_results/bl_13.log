    /**
     * @return ListVariantRow
     */
    private function serializeVariantRow(ProductClass $pc, BaseInfo $shop, ?int $maxPriceInStockProductClassId): array
    {
        $Language = $pc->getLanguage();
        $languageCode = 'JP';
        if ($Language !== null) {
            $languageCode = match ($Language->getId()) {
                MtbLanguage::JP_ID => 'JP',
                MtbLanguage::EN_ID => 'EN',
                default => strtoupper(substr($Language->getCode(), 0, 2)),
            };
        }

        $CardCondition = $pc->getCardCondition();
        $conditionCode = $CardCondition?->getCode() ?? '—';

        $stockUnlimited = $pc->isStockUnlimited();
        $stock = $stockUnlimited ? 0 : $this->getEccubeStockForShop($pc, $shop);

        $ClassCategory1 = $pc->getClassCategory1();
        $ClassCategory2 = $pc->getClassCategory2();

        return [
            'variantId' => (string) $pc->getId(),
            'language' => $languageCode,
            'condition' => $conditionCode,
            'price02' => $pc->getPrice02(),
            'stock' => $stock,
            'stockUnlimited' => $stockUnlimited,
            'stockFind' => $pc->getStockFind($shop),
            // 在庫がある中で最大価格の規格の数量を1、他は0とする
            'defaultQuantity' => ($pc->getId() === $maxPriceInStockProductClassId) ? 1 : 0,
            'classcategory_id1' => $ClassCategory1 !== null ? (string) $ClassCategory1->getId() : '__unselected2',
            'classcategory_id2' => $ClassCategory2 !== null ? (string) $ClassCategory2->getId() : '',
        ];
    }

