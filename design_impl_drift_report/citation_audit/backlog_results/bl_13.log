        if (\is_string($raw) && $raw !== '') {
            $decoded = json_decode($raw, true);
            if (\is_array($decoded)) {
                $list = $decoded;
            }
        } elseif (\is_array($raw)) {
            $list = $raw;
        }

        $docs = [];
        foreach ($list as $item) {
            if (\is_array($item)) {
                $docs[] = $item;
            }
        }

        return $docs;
    }

    /**
     * ユニサーチ検索APIアクセス
     */
    #[Route(path: '/products/search/unisearch_api', name: 'product_search_unisearch_api', methods: ['GET', 'POST'])]
    public function getUnisearchApi(Request $request): JsonResponse
    {
        $queryString = (string) $request->server->get('QUERY_STRING', '');
        $clientIp = $request->getClientIp();
        if ($clientIp !== null) {
            $queryString .= ($queryString === '' ? '' : '&').'user_ip='.urlencode($clientIp);
        }

        $url = $this->uniSearchService->getConfig()['unisearch_api_url'].'?'.$queryString;
        $result = $this->uniSearchService->execCurl($url) ?? [];

        return $this->json($result, 200, [
            'Content-Type' => 'application/json',
            'Access-Control-Allow-Origin' => '*',
        ]);
    }

    /**
     * 関連ワード API プロキシ
     */
    #[Route(path: '/products/search/unisearch_rword_api', name: 'product_search_unisearch_rword_api', methods: ['GET', 'POST'])]
    public function getUnisearchRelationWordApi(Request $request): JsonResponse
    {
        $url = $this->uniSearchService->getConfig()['unisearch_rword_api_url'].'?'.$request->server->get('QUERY_STRING', '');
        $result = $this->uniSearchService->execCurl($url) ?? [];

        return $this->json($result, 200, [
            'Content-Type' => 'application/json',
            'Access-Control-Allow-Origin' => '*',
        ]);
    }

