     * ユニサーチ doc 順の（商品ID・言語・高額商品コード）キーから一覧ページ用コンテキストを組み立てる.
     *
     * @param list<array{productId: int, languageId: int, highPriceCode: string|null}> $orderedDocKeys
     *
     * @return array{
     *     list_card_view_models: array<string, mixed>,
     *     forms: array<string, \Symfony\Component\Form\FormView|null>,
     *     product_list_favorites: array<string, true>,
     *     product_list_notify_class_set: array<int, true>,
     *     can_show_restock_notify: bool,
     *     products_by_id: array<int, Product>,
     *     product_list_items: list<array{Product: Product, languageId: int, cardKey: string}>
     * }
     */
    private function buildProductListPageContextFromUnisearchDocKeys(array $orderedDocKeys, int $preferredLanguageId): array
    {
        $listCardViewModels = [];
        $forms = [];
        $productListFavorites = [];
        $productListNotifyClassSet = [];
        $productListItems = [];
        $isMainShop = $this->getShop()->isMainShop();
        $canShowRestockNotify = $this->productRestockNotifyPolicy->canShowRestockNotifyFeature(
            $this->getShop(),
            $this->resolveCurrentCustomer(),
        );

        $productIds = array_values(array_unique(array_map(
            static fn (array $key): int => $key['productId'],
            $orderedDocKeys,
        ), SORT_REGULAR));
        $productsById = [];
        if ($productIds !== []) {
            foreach ($this->productRepository->findBy(['id' => $productIds]) as $loadedProduct) {
                $productsById[$loadedProduct->getId()] = $loadedProduct;
            }
        }

        if ($isMainShop && $this->isGranted('ROLE_USER')) {
            $user = $this->getUser();
            if ($user instanceof Customer) {
                $Player = $user->getPlayer();
                $FavoriteProducts = $this->dtbFavoriteProductRepository->findBy(['Player' => $Player]);
                foreach ($FavoriteProducts as $FavoriteProduct) {
                    $productListFavorites[$FavoriteProduct->getProduct()->getId().'_'.$FavoriteProduct->getLanguage()->getId()] = true;
                }
            }
        }

        if ($isMainShop) {
            $customer = $this->getUser();
            if ($customer instanceof Customer) {
                $productListNotifyClassSet = $this->productRequestRepository->getProductClassIdByPlayer($customer);
            }
        }

        foreach ($orderedDocKeys as $docKey) {
            $productId = $docKey['productId'];
            $langId = $docKey['languageId'];
            $highPriceCode = $docKey['highPriceCode'];
            $Product = $productsById[$productId] ?? null;
            if ($Product === null || !$this->checkVisibility($Product)) {
                continue;
            }

            $effectiveLangId = $langId === 0 ? $preferredLanguageId : $langId;
            $card = $this->productListCardViewModelBuilder->buildForProductListByLanguageAndHighPrice(
                $Product,
                $effectiveLangId,
                $highPriceCode,
            );
            if ($card === null) {
                continue;
            }

            $cardKey = $productId.'_'.$langId.'_'.($highPriceCode ?? '');
            $card['restock_notify_eligible_by_class_id'] = $this->productRestockNotifyPolicy->buildEligibleClassIdMap(
                $card['product_classes']
            );
            $listCardViewModels[$cardKey] = $card;
            $productListItems[] = [
                'Product' => $Product,
                'languageId' => $langId,
                'cardKey' => $cardKey,
            ];

            $classIds = [];
            foreach ($card['product_classes'] as $ProductClass) {
                $classIds[] = $ProductClass->getId();
            }
            if ($classIds !== []) {
                if (\count($classIds) === 1) {
                    $builder = $this->formFactory->createNamedBuilder(
                        '',
                        AddCartType::class,
                        null,
                        [
                            'product' => $Product,
                            'id_add_product_id' => false,
                            'shop_for_stock' => $this->getShop(),
                        ]
                    );
                    $forms[$cardKey] = $builder->getForm()->createView();
                } else {
                    $builder = $this->formFactory->createNamedBuilder('favorite_cart', FavoriteCartType::class, null, [
                        'product' => $Product,
                        'product_class_ids' => $classIds,
                        'shop_for_stock' => $this->getShop(),
                    ]);
                    $forms[$cardKey] = $builder->getForm()->createView();
                }
            } else {
                $forms[$cardKey] = null;
            }
        }

        return [
            'list_card_view_models' => $listCardViewModels,
            'forms' => $forms,
            'product_list_favorites' => $productListFavorites,
            'product_list_notify_class_set' => $productListNotifyClassSet,
            'can_show_restock_notify' => $canShowRestockNotify,
            'products_by_id' => $productsById,
            'product_list_items' => $productListItems,
        ];
    }

    /**
     * @param array<string, mixed> $doc
     */
    private function normalizeHighPriceCodeFromUnisearchDoc(array $doc, ?ProductClass $productClass = null): ?string
    {
        $raw = $doc['high_price_code'] ?? $productClass?->getHighPriceCode();
        if ($raw === null || (string) $raw === '') {
            return null;
        }

        return (string) $raw;
    }

    /**
     * 閲覧可能な商品かどうかを判定
     *
     * @return bool 閲覧可能な場合はtrue
     */
    protected function checkVisibility(Product $Product): bool
    {
        $is_admin = $this->session->has('_security_admin');

        // 管理ユーザの場合はステータスやオプションにかかわらず閲覧可能.
        if (!$is_admin) {
            // 在庫なし商品の非表示オプションが有効な場合.
            // if ($this->BaseInfo->isOptionNostockHidden()) {
            //     if (!$Product->getStockFind()) {
            //         return false;
            //     }
            // }
            // 公開ステータスでない商品は表示しない.
            if ($Product->getStatus()->getId() !== ProductStatus::DISPLAY_SHOW) {
                return false;
            }
            // 支店サイトでは支店公開ステータスが非公開の商品は表示しない.
            if (!$this->getShop()->isMainShop() && !$Product->isBranchPublished()) {
                return false;
            }
        }

        return true;
    }

