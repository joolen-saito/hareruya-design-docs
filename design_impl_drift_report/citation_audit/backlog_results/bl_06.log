namespace Eccube\Service\Block;

use Eccube\Service\RedisService;
use GuzzleHttp\Client;
use Psr\Log\LoggerInterface;

/**
 * latest_articles ブロック (トップページ MainBottom) 用の Twig payload を構築する。
 */
class LatestArticlesBlockPayloadBuilder
{
    // TODO: ECCUBE_HARERUYA-126 正しい最新記事APIエンドポイントに差し替え（現在のURL latest_articles.json は404）
    private const API_URL = 'https://api.corp.hareruyamtg.com/user_data/lp/json/latest_articles.json';
    private const TIMEOUT = 5;
    private const MAX_ARTICLES = 4;
    private const CACHE_KEY = 'front_top_block:latest_articles';
    private const CACHE_TTL_SECONDS = 300;

    public function __construct(
        private readonly LoggerInterface $logger,
        private readonly RedisService $redisService,
    ) {
    }

    /**
     * @return array{articles: array<int, array<string, mixed>>}
     */
    public function build(): array
    {
        return [
            'articles' => $this->fetchArticles(),
        ];
    }

    /**
     * @return array<int, array<string, mixed>>
     */
    private function fetchArticles(): array
    {
        try {
            $cached = $this->redisService->get(self::CACHE_KEY);
        } catch (\Throwable $e) {
            $this->logger->warning('Failed to read latest articles cache: '.$e->getMessage());
            $cached = null;
        }
        if (is_string($cached)) {
            $decoded = json_decode($cached, true);
            if (is_array($decoded)) {
                return $decoded;
            }
        }

        try {
            $client = new Client(['timeout' => self::TIMEOUT, 'verify' => true]);
            $response = $client->get(self::API_URL);
            $data = json_decode($response->getBody()->getContents(), true, 512, JSON_THROW_ON_ERROR);
            $articles = array_slice($data['items'] ?? $data, 0, self::MAX_ARTICLES);

            $encoded = json_encode($articles);
            if ($encoded !== false) {
                try {
                    $this->redisService->set(self::CACHE_KEY, $encoded, self::CACHE_TTL_SECONDS);
                } catch (\Throwable $e) {
                    $this->logger->warning('Failed to write latest articles cache: '.$e->getMessage());
                }
            }

            return $articles;
        } catch (\Throwable $e) {
            $this->logger->warning('Failed to fetch latest articles: '.$e->getMessage());

            return [];
        }
    }
}
