     * @param string $quantity 設定する数量
     *
     * @return bool 成功した場合true
     */
    public function setProductQuantity(BaseInfo $BaseInfo, ProductClass|int $ProductClass, string $quantity): bool
    {
        if (bccomp($quantity, '0', 0) <= 0) {
            return $this->removeProduct($BaseInfo, $ProductClass);
        }

        $this->removeProduct($BaseInfo, $ProductClass);

        return $this->addProduct($BaseInfo, $ProductClass, $quantity);
    }

    public function save(): void
    {
        $cartKeys = [];
        foreach ($this->carts as $Cart) {
            /** @var Customer|null $Customer */
            $Customer = $this->getUser();
            if ($Customer !== null) {
                $this->entityManager->refresh($Customer);
            }

            $Cart->setCustomer($Customer);
            $this->entityManager->persist($Cart);
            foreach ($Cart->getCartItems() as $item) {
                $this->entityManager->persist($item);
            }
            $this->entityManager->flush();
            $cartKeys[] = $Cart->getCartKey();
        }

        $this->session->set('cart_keys', $cartKeys);
