namespace Eccube\Controller\Front;

use Eccube\Controller\AbstractController;
use Eccube\Entity\Customer;
use Eccube\Repository\DtbEventDetailRepository;
use Eccube\Repository\DtbEventEntryRepository;
use Eccube\Service\Front\Event\EventDetailButtonStateResolver;
use Symfony\Component\HttpFoundation\Response;
use Symfony\Component\HttpKernel\Exception\NotFoundHttpException;
use Symfony\Component\Routing\Attribute\Route;

class EventDetailController extends AbstractController
{
    public function __construct(
        private readonly DtbEventDetailRepository $eventDetailRepository,
        private readonly DtbEventEntryRepository $eventEntryRepository,
        private readonly EventDetailButtonStateResolver $buttonStateResolver,
    ) {
    }

    #[Route(path: '/events/{detailId}/detail', name: 'event_detail', requirements: ['detailId' => '\d+'], methods: ['GET'])]
    public function index(int $detailId): Response
    {
        $Detail = $this->eventDetailRepository->findForFront($detailId);
        if ($Detail === null) {
            throw new NotFoundHttpException();
        }

        $user = $this->getUser();
        $Customer = $user instanceof Customer ? $user : null;

        $activeEntryCount = $this->eventEntryRepository->countActiveEntriesByDetailId($detailId);
        $hasMyActiveEntry = $this->eventEntryRepository->hasActiveEntryByCustomerAndDetail($Customer, $detailId);

        $buttonState = $this->buttonStateResolver->resolve(
            $Detail,
            $activeEntryCount,
            $hasMyActiveEntry,
            new \DateTimeImmutable(),
        );

        return $this->render('Event/detail.twig', [
            'Detail' => $Detail,
            'Event' => $Detail->getEvent(),
            'buttonState' => $buttonState,
            'activeEntryCount' => $activeEntryCount,
        ]);
    }
}

