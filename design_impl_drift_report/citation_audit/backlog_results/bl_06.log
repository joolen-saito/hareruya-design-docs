namespace Eccube\Service\Front\Event;

/**
 * イベント検索のクエリパラメータ
 */
final readonly class EventSearchInput
{
    public const TERM_MAX_LENGTH = 255;
    public const PER_PAGE = 100;
    public const MAX_RESULT_COUNT = 9999;
    public const CATEGORY_BEGINNER = 'beginner';
    public const CATEGORY_CASUAL = 'casual';
    public const CATEGORY_COMPETITIVE = 'competitive';
    public const CATEGORY_RESERVATION = 'reservation';
    public const ALLOWED_CATEGORIES = [
        self::CATEGORY_BEGINNER,
        self::CATEGORY_CASUAL,
        self::CATEGORY_COMPETITIVE,
        self::CATEGORY_RESERVATION,
    ];

    /**
     * @param list<int>    $formats   format id (OR)
     * @param list<int>    $venues    BaseInfo id (OR)
     * @param list<string> $categories self::CATEGORY_* の subset
     */
    public function __construct(
        public string $term = '',
        public ?\DateTimeImmutable $from = null,
        public ?\DateTimeImmutable $to = null,
        public array $formats = [],
        public array $venues = [],
        public bool $isWeekday = true,
        public bool $isHoliday = true,
        public bool $allowPast = false,
        public array $categories = [],
        public bool $isLarge = false,
        public bool $isFree = false,
        public int $page = 1,
    ) {
    }

    /**
     * Symfony Request の `$request->query->all()` を normalize して生成する。
     *
     * @param array<string, mixed> $query
     */
    public static function fromQuery(array $query): self
    {
        // form 経由の submit なら _submitted=1 が付与される。 未付与 = 初期アクセス想定で
        // checkbox 系は デザイン初期値 (= 両方ON 等) を採用、submit 後は チェック外し = 確実に OFF とする。
        $submitted = isset($query['_submitted']);
        $checkboxDefault = !$submitted;

        $term = is_string($query['term'] ?? null) ? mb_substr(trim($query['term']), 0, self::TERM_MAX_LENGTH) : '';
        $from = self::parseDate($query['from'] ?? null);
        $to = self::parseDate($query['to'] ?? null);
        $formats = self::parseIntList($query['formats'] ?? null);
        $venues = self::parseIntList($query['venues'] ?? null);
        $categories = self::parseCategories($query);
        $isWeekday = self::parseBool($query['isWeekday'] ?? null, $checkboxDefault);
        $isHoliday = self::parseBool($query['isHoliday'] ?? null, $checkboxDefault);
        $allowPast = self::parseBool($query['allowPast'] ?? null, false);
        $isLarge = self::parseBool($query['isLarge'] ?? null, false);
        $isFree = self::parseBool($query['isFree'] ?? null, false);
        $page = max(1, (int) ($query['page'] ?? 1));

        return new self(
            term: $term,
            from: $from,
            to: $to,
            formats: $formats,
            venues: $venues,
            isWeekday: $isWeekday,
            isHoliday: $isHoliday,
            allowPast: $allowPast,
            categories: $categories,
            isLarge: $isLarge,
            isFree: $isFree,
            page: $page,
        );
    }

    /**
     * URL Query 配列に逆変換する (chip × クリック後の再遷移 URL 生成等で利用)。
     *
     * @return array<string, mixed>
     */
    public function toQuery(): array
    {
        $query = ['_submitted' => '1'];
        if ($this->term !== '') {
            $query['term'] = $this->term;
        }
        if ($this->from !== null) {
            $query['from'] = $this->from->format('Y/m/d');
        }
        if ($this->to !== null) {
            $query['to'] = $this->to->format('Y/m/d');
        }
        if ($this->formats !== []) {
            $query['formats'] = $this->formats;
        }
        if ($this->venues !== []) {
            $query['venues'] = $this->venues;
        }
        if ($this->isWeekday) {
            $query['isWeekday'] = 'true';
        }
        if ($this->isHoliday) {
            $query['isHoliday'] = 'true';
        }
        if ($this->allowPast) {
            $query['allowPast'] = 'true';
        }
        if ($this->categories !== []) {
            $query['categories'] = $this->categories;
        }
        if ($this->isLarge) {
            $query['isLarge'] = 'true';
        }
        if ($this->isFree) {
            $query['isFree'] = 'true';
        }
        if ($this->page > 1) {
            $query['page'] = $this->page;
        }

        return $query;
    }

    /**
     * 空白分割した検索キーワード list (term 0 件なら 空配列)。
     *
     * @return list<string>
     */
    public function termTokens(): array
    {
        if ($this->term === '') {
            return [];
        }
        $normalized = trim(mb_convert_kana($this->term, 's', 'UTF-8'));
        $tokens = preg_split('/\s+/u', $normalized) ?: [];

        return array_values(array_filter($tokens, static fn (string $t): bool => $t !== ''));
    }

    public function offset(): int
    {
        return ($this->page - 1) * self::PER_PAGE;
    }

    private static function parseDate(mixed $raw): ?\DateTimeImmutable
    {
        if (!is_string($raw) || $raw === '') {
            return null;
        }
        $normalized = str_replace('-', '/', $raw);
        $dt = \DateTimeImmutable::createFromFormat('Y/m/d', $normalized);
        if ($dt === false) {
            return null;
        }
        $errors = \DateTimeImmutable::getLastErrors();
        if (is_array($errors) && ($errors['warning_count'] > 0 || $errors['error_count'] > 0)) {
            return null;
        }

        return $dt->setTime(0, 0);
    }

    /**
     * @return list<int>
     */
    private static function parseIntList(mixed $raw): array
    {
        if (!is_array($raw)) {
            return [];
        }
        $ids = [];
        foreach ($raw as $value) {
            if (!is_scalar($value)) {
                continue;
            }
            $intValue = (int) $value;
            if ($intValue > 0) {
                $ids[] = $intValue;
            }
        }

        return array_values(array_unique($ids));
    }

    /**
     * @param array<string, mixed> $query
     *
     * @return list<string>
     */
    private static function parseCategories(array $query): array
    {
        $raw = $query['categories'] ?? null;
        if (!is_array($raw)) {
            return [];
        }
        $categories = [];
        foreach ($raw as $value) {
            if (is_string($value) && in_array($value, self::ALLOWED_CATEGORIES, true)) {
                $categories[] = $value;
            }
        }

        return array_values(array_unique($categories));
    }

    private static function parseBool(mixed $raw, bool $default): bool
    {
        if ($raw === null) {
            return $default;
        }
        if (is_bool($raw)) {
            return $raw;
        }
        if (is_string($raw)) {
            return in_array(strtolower($raw), ['true', '1', 'on', 'yes'], true);
        }

        return (bool) $raw;
    }
}

