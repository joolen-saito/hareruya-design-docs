                    $event->breakAll();

                    return;
                }
                if ($recvToDt > $startDt) {
                    $ms->addRawMessage($this->transError('admin.event.entry.bulk_csv.error.reception_end_after_event_start', $rn));
                    $event->breakAll();

                    return;
                }
            }

            $online = $this->cellStr($row, $this->onlineReceptionColumn);
            if ($online === self::LABEL_OPTION_YES) {
                $onFrom = $this->cellStr($row, $this->onlineReceptionTimeFromColumn);
                $onTo = $this->cellStr($row, $this->onlineReceptionTimeToColumn);
                if ($onFrom === '' || $onTo === '') {
                    $ms->addRawMessage($this->transError('admin.event.entry.bulk_csv.error.online_reception_time_required', $rn));
                    $event->breakAll();

                    return;
                }
                $onlineFromDt = $this->parseReceptionWindowDateTime($onFrom);
                if ($onlineFromDt === null) {
                    $ms->addInvalidFormatError($rn, $this->onlineReceptionTimeFromColumn->getLabel());
                    $event->breakAll();

                    return;
                }
                $onlineToDt = $this->parseReceptionWindowDateTime($onTo);
                if ($onlineToDt === null) {
                    $ms->addInvalidFormatError($rn, $this->onlineReceptionTimeToColumn->getLabel());
                    $event->breakAll();

                    return;
                }
                if ($onlineFromDt >= $onlineToDt) {
                    $ms->addRawMessage($this->transError('admin.event.entry.bulk_csv.error.online_reception_time_order', $rn));
                    $event->breakAll();

                    return;
                }
                if ($onlineToDt >= $startDt) {
                    $ms->addRawMessage($this->transError('admin.event.entry.bulk_csv.error.online_reception_end_not_before_event_start', $rn));
                    $event->breakAll();

                    return;
                }
            }

            $deckDeadlineRaw = $this->cellStr($row, $this->deckDeadlineColumn);
            if ($deckDeadlineRaw !== '' && $this->parseDateTimeYmdHm($deckDeadlineRaw) === null) {
                $ms->addInvalidFormatError($rn, $this->deckDeadlineColumn->getLabel());
                $event->breakAll();

                return;
            }

            $dispS = $this->cellStr($row, $this->publicSchedColumn);
            if ($dispS === '' || $this->resolveDispByPublicLabel($dispS) === null) {
                $ms->addInvalidFormatError($rn, $this->publicSchedColumn->getLabel());
                $event->breakAll();

                return;
            }

            $capSc = $this->capacityScheduleColumn->getValue($row);
            if ($capSc !== null && (int) $capSc < $this->capacityMin) {
                $ms->addInvalidFormatError($rn, $this->capacityScheduleColumn->getLabel());
                $event->breakAll();

