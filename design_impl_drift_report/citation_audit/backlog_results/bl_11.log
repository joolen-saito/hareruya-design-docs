    /**
     * @param array<int, array<int, array{count: int, cardId: int, name: string, row: int}>> $boardCardLists
     *
     * @return array<int, list<string>>
     */
    private function validateBoardCounts(DtbDeck $Deck, array $boardCardLists): array
    {
        $Format = $Deck->getFormat();
        if ($Format === null) {
            return [];
        }

        $totals = [];
        foreach ($boardCardLists as $boardId => $cards) {
            $totals[$boardId] = array_sum(array_column($cards, 'count'));
        }

        $mainCount = $totals[MtbBoard::BOARD_ID_MAIN] ?? 0;
        $sideCount = $totals[MtbBoard::BOARD_ID_SIDE] ?? 0;
        $commandCount = $totals[MtbBoard::BOARD_ID_COMMAND] ?? 0;

        if ($Format->isCommanderInMain()) {
            $mainCount += $commandCount;
        }

        $warningsByBoard = [
            MtbBoard::BOARD_ID_MAIN => $this->checkBoardRange(
                $mainCount,
                $Format->getMainMaxCardCount(),
                $Format->getMainMinCardCount(),
            ),
            MtbBoard::BOARD_ID_SIDE => $this->checkBoardRange(
                $sideCount,
                $Format->getSideMaxCardCount(),
                $Format->getSideMinCardCount(),
            ),
            MtbBoard::BOARD_ID_COMMAND => [],
        ];

        $CommandFormatBoard = $Format->getFormatBoardByBoardId(MtbBoard::BOARD_ID_COMMAND);
        if ($CommandFormatBoard === null) {
            if ($commandCount > 0) {
                $warningsByBoard[MtbBoard::BOARD_ID_COMMAND][] = trans('admin.deck.validation.no_command');
            }
        } else {
            $warningsByBoard[MtbBoard::BOARD_ID_COMMAND] = $this->checkBoardRange(
                $commandCount,
                $CommandFormatBoard->getMaxCardCount(),
                $CommandFormatBoard->getMinCardCount(),
            );
        }

        return $warningsByBoard;
    }

    /**
     * @return list<string>
     */
    private function checkBoardRange(int $count, ?int $max, ?int $min): array
    {
        $warnings = [];
        if ($max !== null && $count > $max) {
            $warnings[] = trans('admin.deck.validation.too_many', ['%count%' => $max]);
        } elseif ($min !== null && $count < $min) {
            $warnings[] = trans('admin.deck.validation.too_few', ['%count%' => $min]);
        }

        return $warnings;
    }
