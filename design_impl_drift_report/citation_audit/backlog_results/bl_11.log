namespace Eccube\Service\Csv\Importer\Event;

use Doctrine\Common\Collections\ArrayCollection;
use Doctrine\ORM\EntityManagerInterface;
use Eccube\Entity\DtbArchetype;
use Eccube\Entity\DtbDeck;
use Eccube\Entity\DtbDeckCard;
use Eccube\Entity\Master\MtbBoard;
use Eccube\Entity\Master\MtbCard;
use Eccube\Entity\Master\MtbDeckTag;
use Eccube\Entity\Master\MtbDeckType;
use Eccube\Entity\Master\MtbDisp;
use Eccube\Entity\Master\MtbFormat;
use Eccube\Entity\Member;
use Eccube\Repository\DtbArchetypeRepository;
use Eccube\Repository\DtbDeckCardRepository;
use Eccube\Repository\DtbDeckRepository;
use Eccube\Repository\DtbEventDetailRepository;
use Eccube\Repository\Master\MtbCardImageRepository;
use Eccube\Repository\Master\MtbCardRepository;
use Eccube\Repository\Master\MtbDeckTagRepository;
use Eccube\Repository\Master\MtbDeckTypeRepository;
use Eccube\Repository\Master\MtbDispRepository;
use Eccube\Repository\Master\MtbFormatRepository;
use Eccube\Service\Csv\Importer\Model\BaseCsvColumn;
use Eccube\Service\Csv\Importer\Model\CsvColumnInterface;
use Eccube\Service\Csv\Importer\Validator\RowValidatorInterface;
use Symfony\Contracts\Translation\TranslatorInterface;

class DeckUpdateImportHandler extends BaseCsvImportHandler
{
    private const CSV_DISP_HIDE = '0';
    private const CSV_DISP_SHOW = '1';
    private const CSV_PRIVATE_SHOW = '0';
    private const CSV_PRIVATE_HIDE = '1';

    /** @var array<string, CsvColumnInterface> */
    private array $columns = [];

    /** @var array<string, int> format name_en => id */
    private array $formatNameToId = [];

    /** @var array<string, int> deck tag name_jp => id */
    private array $deckTagNameJpToId = [];

    /** @var array<string, int> deck tag name_en => id */
    private array $deckTagNameEnToId = [];

    public function __construct(
        private readonly EntityManagerInterface $em,
        private readonly TranslatorInterface $translator,
        private readonly DtbDeckRepository $deckRepository,
        private readonly DtbArchetypeRepository $archetypeRepository,
        private readonly DtbEventDetailRepository $eventDetailRepository,
        private readonly DtbDeckCardRepository $deckCardRepository,
        private readonly MtbCardRepository $cardRepository,
        private readonly MtbCardImageRepository $cardImageRepository,
        private readonly MtbDeckTypeRepository $deckTypeRepository,
        private readonly MtbDispRepository $dispRepository,
        private readonly MtbDeckTagRepository $deckTagRepository,
        private readonly MtbFormatRepository $formatRepository,
        private readonly Member $loginMember,
    ) {
    }

    public function onBeforeImport(): void
    {
        parent::onBeforeImport();
        $this->initializeColumns();
        $this->buildMasterMaps();
    }

    public function onAfterImport(AfterReadEvent $event): void
    {
        parent::onAfterImport($event);
        $this->columns = [];
        $this->formatNameToId = [];
        $this->deckTagNameJpToId = [];
        $this->deckTagNameEnToId = [];
    }

    public function onValidateRow(ReadCsvRowEvent $event): void
    {
        parent::onValidateRow($event);
        if ($event->isBreakAll() || $event->isSkipRow()) {
            return;
        }

        $row = $event->getRow();
        $rowNumber = $row->getRowNumber();
        $messageStore = $event->getMessageStore();

        $privateFlg = trim((string) $this->columns['private_flg']->getValue($row));
        $mainList = (string) $this->columns['main_list']->getValue($row);
        if ($privateFlg === self::CSV_PRIVATE_SHOW && trim($mainList) === '') {
            $messageStore->addRequireError($rowNumber, (string) $this->columns['main_list']->getLabel());
            $event->breakAll();

            return;
        }

        $formatName = trim((string) $this->columns['format']->getValue($row));
        if (!isset($this->formatNameToId[$formatName])) {
            $messageStore->addRawMessage(sprintf(
                $this->translator->trans('admin.csv.error.data.not_registered'),
                $this->translator->trans('admin.deck.format'),
                $formatName,
                $rowNumber,
            ));
            $event->breakAll();

            return;
        }
        $Format = $this->em->getRepository(MtbFormat::class)->find($this->formatNameToId[$formatName]);
        \assert($Format instanceof MtbFormat);

        $archetypeName = trim((string) $this->columns['archetype']->getValue($row));
        if ($this->findArchetype($archetypeName, $Format) === null) {
            $messageStore->addRawMessage(sprintf(
                $this->translator->trans('admin.csv.error.data.not_registered'),
                $this->translator->trans('admin.deck.archetype'),
                $archetypeName,
                $rowNumber,
            ));
            $event->breakAll();

            return;
        }

        $eventDetailId = trim((string) $this->columns['event_detail_id']->getValue($row));
        if ($eventDetailId !== '' && $this->eventDetailRepository->find((int) $eventDetailId) === null) {
            $messageStore->addRawMessage(sprintf(
                $this->translator->trans('admin.csv.error.data.not_registered'),
                $this->translator->trans('admin.deck.event_detail_id'),
                $eventDetailId,
                $rowNumber,
            ));
            $event->breakAll();

            return;
        }

        $eventDateStr = trim((string) $this->columns['event_date']->getValue($row));
        if ($this->parseEventDate($eventDateStr) === null) {
            $messageStore->addRawMessage(sprintf(
                $this->translator->trans('admin.deck.csv.error.format_invalid'),
                $this->translator->trans('admin.deck.event_date'),
                $rowNumber,
            ));
            $event->breakAll();

            return;
        }

        $dispFlg = trim((string) $this->columns['disp_flg']->getValue($row));
        if ($dispFlg !== self::CSV_DISP_HIDE && $dispFlg !== self::CSV_DISP_SHOW) {
            $messageStore->addRawMessage(sprintf(
                $this->translator->trans('admin.deck.csv.error.format_invalid'),
                $this->translator->trans('admin.deck.disp'),
                $rowNumber,
            ));
            $event->breakAll();

            return;
        }

        if ($privateFlg !== self::CSV_PRIVATE_SHOW && $privateFlg !== self::CSV_PRIVATE_HIDE) {
            $messageStore->addRawMessage(sprintf(
                $this->translator->trans('admin.deck.csv.error.format_invalid'),
                $this->translator->trans('admin.deck.private_flg'),
                $rowNumber,
            ));
            $event->breakAll();

            return;
        }

        if ($Format->getUseCommandFlg() === true) {
            $commanderName = trim((string) $this->columns['commander']->getValue($row));
            if ($commanderName === '') {
                $messageStore->addRawMessage(sprintf(
                    $this->translator->trans('admin.csv.error.data.require'),
                    $this->translator->trans('admin.deck.csv.commander'),
                    $rowNumber,
                ));
                $event->breakAll();

                return;
            }
            if ($this->findCardByName($commanderName) === null) {
                $messageStore->addRawMessage(sprintf(
                    $this->translator->trans('admin.csv.error.data.not_registered'),
                    $this->translator->trans('admin.deck.csv.commander'),
                    $commanderName,
                    $rowNumber,
                ));
                $event->breakAll();

                return;
            }
        }

        $deckId = trim((string) $this->columns['deck_id']->getValue($row));
        if ($deckId !== '') {
            $Deck = $this->deckRepository->find((int) $deckId);
            if ($Deck === null) {
                $messageStore->addRawMessage(sprintf(
                    $this->translator->trans('admin.deck.csv.error.deck_not_found'),
                    $deckId,
                    $rowNumber,
                ));
                $event->breakAll();

                return;
            }
            if ($Deck->getDeckType()->getId() !== MtbDeckType::EVENT_ID) {
                $messageStore->addRawMessage(sprintf(
                    $this->translator->trans('admin.deck.csv.error.deck_type_invalid'),
                    $deckId,
                    $rowNumber,
                ));
                $event->breakAll();
            }
        }
    }

    public function onReadRow(ReadCsvRowEvent $event): bool
    {
        $row = $event->getRow();
        $playerName = (string) $this->columns['player_name']->getValue($row);
        $formatName = trim((string) $this->columns['format']->getValue($row));
