namespace Eccube\Entity;

use Doctrine\DBAL\Types\Types;
use Doctrine\ORM\Mapping as ORM;
use Eccube\Repository\DtbWaitingNumberRepository;

#[ORM\Table(name: 'dtb_waiting_number')]
#[ORM\HasLifecycleCallbacks]
#[ORM\Entity(repositoryClass: DtbWaitingNumberRepository::class)]
class DtbWaitingNumber extends AbstractEntity
{
    #[ORM\Column(name: 'id', type: Types::INTEGER, options: ['unsigned' => true, 'comment' => 'ID'])]
    #[ORM\Id]
    #[ORM\GeneratedValue(strategy: 'IDENTITY')]
    private int $id;

    #[ORM\JoinColumn(name: 'base_info_id', referencedColumnName: 'id', nullable: false)]
    #[ORM\ManyToOne(targetEntity: BaseInfo::class)]
    private BaseInfo $BaseInfo;

    #[ORM\Column(name: 'order_id', type: Types::INTEGER, options: ['unsigned' => true, 'comment' => 'オーダーID'])]
    private int $orderId;

    #[ORM\Column(name: 'waiting_number', type: Types::INTEGER, nullable: false, options: ['unsigned' => true, 'comment' => '店舗販売用整理番号'])]
    private int $waitingNumber;

    public function setId(int $id): DtbWaitingNumber
    {
        $this->id = $id;

        return $this;
    }

    public function setOrderId(int $orderId): DtbWaitingNumber
    {
        $this->orderId = $orderId;

        return $this;
    }

    public function getOrderId(): int
    {
        return $this->orderId;
    }

    public function getBaseInfo(): BaseInfo
    {
        return $this->BaseInfo;
    }

    public function setBaseInfo(BaseInfo $BaseInfo): DtbWaitingNumber
    {
        $this->BaseInfo = $BaseInfo;

        return $this;
    }

    public function getId(): int
    {
        return $this->id;
    }

    public function getWaitingNumber(): int
    {
        return $this->waitingNumber;
    }

    public function setWaitingNumber(int $waitingNumber): DtbWaitingNumber
    {
        $this->waitingNumber = $waitingNumber;

        return $this;
    }
}
