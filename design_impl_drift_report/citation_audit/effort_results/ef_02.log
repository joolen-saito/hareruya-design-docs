            ])
            ->join('o.Pref', 'op')
            ->leftJoin('o.Country', 'oc')
            ->join('o.Customer', 'c')
            ->leftJoin('c.Sex', 'cs')
            ->leftJoin('c.Job', 'cj')
            ->join('c.Pref', 'cp')
            ->leftjoin('c.Country', 'cc')
            ->join('o.Payment', 'py')
            ->join('o.OrderStatus', 'ost')
            ->leftJoin('o.Shippings', 's')
            ->join('s.Pref', 'sp')
            ->join('s.Delivery', 'd')
            ->leftJoin('d.DeliveryTimes', 't', 'WITH', 't.id = s.time_id')
            ->where('o IN (:orders)')
            ->setParameter('orders', $orderIdList)
            ->groupBy('
                o.id,
                c.id,
                cp.id,
                cs.id,
                cj.id,
                ost.id,
                py.id,
                py.id,
                sp.id,
                s.name01,
                s.name02,
                s.kana01,
                s.kana02,
                s.company_name,
                s.postal_code,
                s.addr01,
                s.addr02,
                s.addr03,
                s.tel01,
                s.tel02,
                s.tel03,
                d.id,
                t.id
            ');

        $result = $qb
            ->getQuery()
            ->getResult();

        array_walk_recursive($result, function (&$item) {
            if ($item instanceof \DateTime) {
                $item = $item->format(self::CSV_DATE_FORMAT);
            }
        });

        return $result;
    }

