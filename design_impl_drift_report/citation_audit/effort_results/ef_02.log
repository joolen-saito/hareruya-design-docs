<?php

namespace App\Controller\Admin;

use FOS\RestBundle\Controller\FOSRestController;
use FOS\RestBundle\Controller\Annotations as Rest;
use FOS\RestBundle\View\View;
use Symfony\Component\HttpFoundation\Request;
use Symfony\Component\HttpFoundation\Response;

class LoginController extends FOSRestController
{
    /**
     * @param Request $request
     */
    public function postAction(Request $request)
    {
        $loginCheckUrl = $this->container->getParameter('admin_login_check_url') ?? ('http://' . filter_input(INPUT_SERVER, 'HTTP_HOST') . '/admin/login_check');
        $loginUrl = $this->container->getParameter('admin_login_url') ?? ('http://' . filter_input(INPUT_SERVER, 'HTTP_HOST') . '/admin/login');
        $loginId = $request->get('login_id');
        $cookieFile = "/tmp/login{$loginId}.cookie";

        // Get cookie
        $ch = curl_init();
        $options = [
            CURLOPT_URL => $loginUrl,
            CURLOPT_CUSTOMREQUEST => 'GET',
            CURLOPT_RETURNTRANSFER => true,
            CURLOPT_HEADER => true,
            CURLOPT_COOKIEJAR => $cookieFile,
        ];
        curl_setopt_array($ch, $options);

        $response = curl_exec($ch);
        curl_close($ch);

        // Login check
        $chCheck = curl_init();
        $requestData = [
            'login_id' => $loginId,
            'password' => $request->get('password'),
        ];
        $fields = http_build_query($requestData);

        $options = [
            CURLOPT_URL => $loginCheckUrl,
            CURLOPT_POST => true,
            CURLOPT_RETURNTRANSFER => true,
            CURLOPT_FOLLOWLOCATION => true,
            CURLOPT_COOKIEFILE => $cookieFile,
            CURLOPT_POSTFIELDS => $fields,
        ];
        curl_setopt_array($chCheck, $options);
        $response = curl_exec($chCheck);
        curl_close($chCheck);
        unlink($cookieFile);
        $content = json_decode($response, true);

        if (empty($content)) {
            $pattern = '/<span class="text-danger">([^"]*)<\/span>/';
            preg_match($pattern, $response, $result);

            $view = View::create([
                "code" => Response::HTTP_UNAUTHORIZED,
                "message" => str_replace('<br>', '', $result[1]),
            ], Response::HTTP_UNAUTHORIZED);

            return $this->get('fos_rest.view_handler')->handle($view);
        }

        return $content;
    }
}

<?php

namespace App\Tests\Controller;

use Symfony\Component\HttpFoundation\Response;
use App\DataFixtures\CommonFixtureLoader;
use App\Tests\FixtureAwareWebTestCase;

class LoginControllerPostActionTest extends FixtureAwareWebTestCase
{
    /**
     * fixture setup
     */
    public static function setUpBeforeClass()
    {
        parent::setUpBeforeClass();
    }

    /**
     * Success
     */
    public function testSuccess()
    {
        $client = $this->submitTestRequest('admin', 'password');

        $this->assertEquals(Response::HTTP_OK, $client->getResponse()->getStatusCode());
        $content = json_decode($client->getResponse()->getContent(), true);
        $this->assertArrayHasKey('jwtToken', $content);
        $this->assertArrayHasKey('memberName', $content);
        $this->assertArrayHasKey('memberId', $content);
        $this->assertArrayHasKey('shopName', $content);
        $this->assertArrayHasKey('shopAddr', $content);
    }

    /**
     * Failure login ID
     */
    public function testFailureLoginId()
    {
        $client = $this->submitTestRequest('admin11111', 'password');
        $this->assertEquals(Response::HTTP_UNAUTHORIZED, $client->getResponse()->getStatusCode());
    }

    /**
     * Failure password
     */
    public function testFailureLoginPassword()
    {
        $client = $this->submitTestRequest('admin', 'pass');
        $this->assertEquals(Response::HTTP_UNAUTHORIZED, $client->getResponse()->getStatusCode());
    }

    private function submitTestRequest($loginId, $password)
    {
        $client = static::createClient();
        $response = $client->request(
            'POST',
            '/admin/login.json',
            [
                "login_id" => $loginId,
                "password" => $password,
            ],
            [],
            $this->getCommonRequestHeader()
        );

        return $client;
    }
}

