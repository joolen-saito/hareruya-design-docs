use Psr\Log\LoggerInterface;

class UpdatePrintedOrderStatusAction
{
    public function __construct(
        private readonly EntityManagerInterface $entityManager,
        private readonly BaseInfoRepository $baseInfoRepository,
        private readonly OrderStatusRepository $orderStatusRepository,
        private readonly OrderRepository $orderRepository,
        private readonly LoggerInterface $logger,
    ) {
    }

    /**
     * 印刷が完了した受注のステータスを更新する
     *
     * @param UpdatePrintedOrderStatusInput $input
     *
     * @throws \Exception
     */
    public function handle(UpdatePrintedOrderStatusInput $input): void
    {
        $responseFile = $input->responseFile;

        $xml = @simplexml_load_string($responseFile);
        if ($xml === false) {
            $this->logger->error($responseFile);
            $this->logger->error('XMLパースエラー');

            return;
        }
        if ((string) $xml->ServerDirectPrint === 'false' || count($xml->ePOSPrint) < 1) {
            $this->logger->error($responseFile);

            return;
        }

        $BaseInfo = $this->baseInfoRepository->find($input->base_info_id);
        $pickingStatus = $this->orderStatusRepository->find(OrderStatus::PICKING);

        if (!$BaseInfo) {
            $this->logger->error("ステータス更新エラー：BaseInfo（ID: {$input->base_info_id}）が存在しません。");

            return;
        }

        if (!$pickingStatus) {
            $this->logger->error('ステータス更新エラー：PICKINGステータスが存在しません。');

            return;
        }

        $this->entityManager->beginTransaction();
        try {
            foreach ($xml->ePOSPrint as $print) {
                $orderId = explode('_', (string) $print->Parameter->printjobid)[0];

                $Order = $this->orderRepository->find($orderId);
                if (!$Order) {
                    $this->logger->error("ステータス更新エラー：受注ID{$orderId}が存在しません。");

                    continue;
                }
                if ($Order->isBrowserPrintFlg()) {
                    $Order->setBrowserPrintFlg(false);
                } else {
                    $Order->setOrderStatus($pickingStatus);
                    if ($BaseInfo->isMainShop()) {
                        // 本店の場合、注文確定日を更新
                        $Order->setConfirmDate(new \DateTime());
                    } else {
                        // 支店の場合、ピック開始日を更新
                        $Order->setPickingDate(new \DateTime());
                    }
                }
                $this->entityManager->persist($Order);
                $this->entityManager->flush();
            }

            $this->entityManager->commit();
        } catch (\Throwable $e) {
            $this->entityManager->rollback();

            throw $e;
        }
    }
