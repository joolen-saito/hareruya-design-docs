            $response = $this->httpClient->request('GET', $url, [
                'headers' => $headers,
                'query' => $query,
                'http_errors' => false,
            ]);
        } catch (\Throwable $e) {
            $this->recordFailure($operation, 'GET', $requestUrl, $headers, null, $started, $e, $logContext);

            return [
                'statusCode' => 0,
                'headers' => [],
                'body' => '',
                'json' => null,
            ];
        }

