namespace Eccube\Service\Smaregi\Webhook\Transaction;

use Doctrine\DBAL\LockMode;
use Doctrine\ORM\EntityManagerInterface;
use Eccube\Dto\Smaregi\Api\Transaction\TransactionDto;
use Eccube\Entity\Customer;
use Eccube\Entity\Master\MtbPointType;
use Eccube\Repository\DtbPointHistoryRepository;
use Eccube\Repository\Master\MtbPointTypeRepository;
use Eccube\Service\EntityManager\PointHistoryEntityManager;
use Eccube\Service\Smaregi\SmaregiCustomerResolver;
use Eccube\Service\Smaregi\SmaregiPointPushLogService;
use Psr\Log\LoggerInterface;

/**
 * スマレジ取引区分6 (ポイント加算) / 7 (ポイント減算) の「ポイント専用取引」を
 * EC-CUBE 会員ポイント残高へ反映する。
 *
 * 通常購入 (取引区分1) と異なり商品明細を持たず受注作成パターンに乗らないため、
 * {@see \Eccube\MessageHandler\SmaregiTransactionProcessMessageHandler} の created 処理で
 * 受注を作らずに本サービスへ分岐させる。
 *
 * 仕様:
 *  - 区分6: 付与ポイント (`newPoint`) を加算。
 *  - 区分7: 使用ポイント (`spendPoint`) を減算。
 *  - 会員 (customerId → DtbPlayer) に紐付かない取引は対象外。
 *  - 冪等性: 同一 `transactionHeadId` のポイント履歴が既にあれば再適用しない。
 *  - 履歴種別はスマレジ由来ポイントとして {@see MtbPointType::PURCHASE_TYPE} で統一する。
 */
final readonly class SmaregiPointAdjustmentApplier
{
    private const DIVISION_POINT_ADD = '6';

    private const DIVISION_POINT_SUBTRACT = '7';

    public function __construct(
        private LoggerInterface $logger,
        private EntityManagerInterface $entityManager,
        private SmaregiCustomerResolver $customerResolver,
        private DtbPointHistoryRepository $pointHistoryRepository,
        private MtbPointTypeRepository $pointTypeRepository,
        private PointHistoryEntityManager $pointHistoryEntityManager,
        private SmaregiPointPushLogService $pushLogService,
    ) {
    }

    /**
     * 取引がポイント専用取引 (区分6/7) かどうか。
     */
    public function supports(TransactionDto $transaction): bool
    {
        return in_array(
            $transaction->transactionHeadDivision,
            [self::DIVISION_POINT_ADD, self::DIVISION_POINT_SUBTRACT],
            true,
        );
    }

    public function apply(TransactionDto $transaction): void
    {
        if (!$this->supports($transaction)) {
            return;
        }

        // EC-CUBE発のpoint/addが生んだ取引（送信記録に該当）は、EC-CUBE側で既にポイント反映済みのためここでは適用しない。
        if ($this->pushLogService->isPushed($transaction->transactionHeadId)) {
            $this->logger->info('Smaregi point adjustment skipped: EC-originated push (self-issued)', [
                'transactionHeadId' => $transaction->transactionHeadId,
                'division' => $transaction->transactionHeadDivision,
            ]);

            return;
        }

        $customerId = $transaction->customerId;
        if ($customerId === null || $customerId === '') {
            // ポイントは会員にしか紐付かないため、会員IDが無い取引は対象外。
            $this->logger->warning('Smaregi point adjustment skipped: transaction has no customerId', [
                'transactionHeadId' => $transaction->transactionHeadId,
                'division' => $transaction->transactionHeadDivision,
            ]);

            return;
        }

        // 受信した customerId はスマレジ採番IDのため、会員取得APIで customerNo を引いて
        // dtb_player.smaregi_id と突合する（SmaregiCustomerResolver が解決を担う）。
        $player = $this->customerResolver->resolvePlayerByCustomerId($customerId);
        $customer = $player?->getCustomer();
        if ($player === null || !$customer instanceof Customer) {
            $this->logger->warning('Smaregi point adjustment skipped: member not resolved', [
                'transactionHeadId' => $transaction->transactionHeadId,
                'customerId' => $customerId,
            ]);

            return;
        }

        $transactionId = $this->resolveTransactionId($transaction);
        if ($transactionId === null) {
            // 取引IDが数値でない場合は冪等性を担保できないため適用しない。
            $this->logger->warning('Smaregi point adjustment skipped: transactionHeadId is not numeric', [
                'transactionHeadId' => $transaction->transactionHeadId,
            ]);

            return;
        }

        $pointChange = $this->resolvePointChange($transaction);
        if ($pointChange === 0) {
            return;
        }

        // 同一 transactionHeadId の Webhook が並列処理されると existsByTransactionId が両者 false を
        // 見て二重適用し得る。残高を持つ Player 行を悲観ロックして直列化し、ロック確立後に
        // 冪等性チェック → 残高更新 → 履歴記録までを同一トランザクションで完了させる。
        $this->entityManager->beginTransaction();
        try {
            $this->entityManager->lock($player, LockMode::PESSIMISTIC_WRITE);

            // 冪等性: 同一取引のポイント履歴が既にあれば再適用しない (ロック確立後に再確認)。
            if ($this->pointHistoryRepository->existsByTransactionId($transactionId)) {
                $this->entityManager->commit();
                $this->logger->info('Smaregi point adjustment already applied for transaction, skipping', [
                    'transactionHeadId' => $transaction->transactionHeadId,
                ]);

                return;
            }

            $player->setPoint($player->getPoint() + $pointChange);
            $this->entityManager->persist($player);

            $pointType = $this->pointTypeRepository->find(MtbPointType::PURCHASE_TYPE);
            $this->pointHistoryEntityManager->save(
                null,
                $customer,
                null,
                $pointType,
                $pointChange,
                null,
                new \DateTime(),
                $transactionId,
            );
            $this->entityManager->flush();
            $this->entityManager->commit();
        } catch (\Throwable $e) {
            if ($this->entityManager->getConnection()->isTransactionActive()) {
                $this->entityManager->rollback();
            }

            throw $e;
        }

        $this->logger->info('Smaregi point adjustment applied to member', [
            'transactionHeadId' => $transaction->transactionHeadId,
            'division' => $transaction->transactionHeadDivision,
            'pointChange' => $pointChange,
            'playerId' => $player->getId(),
        ]);
    }

    /**
     * 区分6は付与ポイントを加算、区分7は使用ポイントを減算する。
     */
    private function resolvePointChange(TransactionDto $transaction): int
    {
        return match ($transaction->transactionHeadDivision) {
            self::DIVISION_POINT_ADD => (int) ($transaction->newPoint ?? 0),
            self::DIVISION_POINT_SUBTRACT => -(int) ($transaction->spendPoint ?? 0),
            default => 0,
        };
    }

    /**
     * 取引IDを履歴用の int に変換する。数値でなければ null を返す。
     */
    private function resolveTransactionId(TransactionDto $transaction): ?int
    {
        $transactionHeadId = $transaction->transactionHeadId;
        if ($transactionHeadId === null || !ctype_digit($transactionHeadId)) {
            return null;
        }

        return (int) $transactionHeadId;
    }
}
