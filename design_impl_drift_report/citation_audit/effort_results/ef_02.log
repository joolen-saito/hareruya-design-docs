namespace Eccube\Service\Smaregi\Webhook\Transaction;

use Doctrine\ORM\EntityManagerInterface;
use Eccube\Entity\Master\MtbPointType;
use Eccube\Repository\DtbPlayerRepository;
use Eccube\Repository\DtbPointHistoryRepository;
use Eccube\Repository\Master\MtbPointTypeRepository;
use Eccube\Service\EntityManager\PointHistoryEntityManager;
use Psr\Log\LoggerInterface;

/**
 * スマレジ「ポイント専用取引」(取引区分6/7) の取消(canceled)/打消(disposed)で、
 * {@see SmaregiPointAdjustmentApplier} が適用したポイントを EC-CUBE 会員残高から差し戻す。
 *
 * 判別:
 *  - ポイント専用取引の履歴は受注に紐付かない (dtb_point_history.order_id が NULL) ため、
 *    取引ID + order_id IS NULL で抽出する。受注由来のポイント履歴 (order_id 有り) は対象外。
 *
 * 差し戻し方式:
 *  - 元の付与/減算履歴は監査用に残し、相殺用の逆仕訳履歴 (符号反転) を追加して残高を戻す。
 *    元履歴を削除しないことで created 再送時の forward 冪等性 (`existsByTransactionId`) も維持する。
 *  - 既に逆仕訳済み (net = 0) の場合は再処理しない。
 */
final readonly class SmaregiPointAdjustmentReverter
{
    private const REVERT_NOTE = 'スマレジ取消/打消によるポイント差し戻し';

    public function __construct(
        private LoggerInterface $logger,
        private EntityManagerInterface $entityManager,
        private DtbPlayerRepository $playerRepository,
        private DtbPointHistoryRepository $pointHistoryRepository,
        private MtbPointTypeRepository $pointTypeRepository,
        private PointHistoryEntityManager $pointHistoryEntityManager,
    ) {
    }

    /**
     * 指定取引IDで適用済みのポイント専用取引を差し戻す。
     *
     * @param ?string $originalTransactionId 取消は取引自体のID、打消は打消元(disposeServerTransactionHeadId)
     *
     * @return bool ポイント専用取引だった(差戻し実施 or 既に差戻し済み)場合 true、対象でなければ false
     */
    public function revert(?string $originalTransactionId): bool
    {
        $transactionId = $this->resolveTransactionId($originalTransactionId);
        if ($transactionId === null) {
            return false;
        }

        $histories = $this->pointHistoryRepository->findPointOnlyByTransactionId($transactionId);
        if ($histories === []) {
            // 受注に紐付かないポイント履歴が無い = ポイント専用取引ではない (または対象なし)。
            return false;
        }

        $net = 0;
        foreach ($histories as $history) {
            $net += (int) $history->getPointChange();
        }
        if ($net === 0) {
            // 付与/減算 と 逆仕訳 が相殺済み = 既に差し戻し済みのため再処理しない。
            $this->logger->info('Smaregi point adjustment already reverted, skipping', [
                'transactionId' => $transactionId,
            ]);

            return true;
        }

        $customer = $histories[0]->getCustomer();
        $player = $this->playerRepository->findOneByCustomer($customer);
        if ($player === null) {
            $this->logger->warning('Smaregi point adjustment revert skipped: player not resolved', [
                'transactionId' => $transactionId,
            ]);

            return true;
        }

        // 残高を差し戻し、相殺用の逆仕訳履歴 (元履歴は保持) を残す。
        $player->setPoint($player->getPoint() - $net);
        $this->entityManager->persist($player);

        $pointType = $this->pointTypeRepository->find(MtbPointType::PURCHASE_TYPE);
        $this->pointHistoryEntityManager->save(
            null,
            $customer,
            null,
            $pointType,
            -$net,
            self::REVERT_NOTE,
            new \DateTime(),
            $transactionId,
        );
        $this->entityManager->flush();

        $this->logger->info('Smaregi point adjustment reverted', [
            'transactionId' => $transactionId,
            'revertedPoint' => -$net,
            'playerId' => $player->getId(),
        ]);

        return true;
    }

    /**
     * 取引IDを履歴用の int に変換する。数値でなければ null を返す。
     */
    private function resolveTransactionId(?string $transactionId): ?int
    {
        if ($transactionId === null || !ctype_digit($transactionId)) {
            return null;
        }

        return (int) $transactionId;
    }
}
