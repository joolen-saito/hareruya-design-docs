namespace Eccube\Service\Smaregi\Webhook\Transaction;

use Doctrine\DBAL\LockMode;
use Doctrine\ORM\EntityManagerInterface;
use Eccube\Dto\Smaregi\Api\Transaction\TransactionDto;
use Eccube\Entity\Customer;
use Eccube\Entity\Order;
use Eccube\Repository\DtbPlayerRepository;
use Eccube\Repository\DtbPointHistoryRepository;
use Eccube\Service\PointService;
use Psr\Log\LoggerInterface;

/**
 * スマレジの売上取引 (受注 Webhook) に乗った獲得/使用ポイントを EC-CUBE 会員残高へ反映する。
 *
 * 対象は商品明細を伴う売上取引で、受注作成パターン (OTC 等) に紐づくもの。商品明細を持たない
 * ポイント専用取引 (区分6/7) は {@see SmaregiPointAdjustmentApplier} が扱う（本クラスの対象外）。
 *
 * 仕様:
 *  - 付与ポイント (`newPoint`) を加算、使用ポイント (`spendPoint`) を減算する。
 *    店頭受取のオンライン注文で使われたポイントは EC 側が注文時に減算済みのため、
 *    Webhook の `spendPoint` には店頭レジでの使用分のみが乗る前提で二重減算しない。
 *  - 非会員 (Order に Customer が紐付かない) は対象外。
 *  - 冪等性: 同一 `transactionHeadId` のポイント履歴が既にあれば再適用しない
 *    (Webhook 再送・補完取得バッチでの重複付与を防ぐ)。
 *
 * ポイント残高/履歴の更新は共通の {@see PointService} に委譲し、`transactionId` を履歴へ記録する。
 */
final readonly class SmaregiOrderPointApplier
{
    public function __construct(
        private LoggerInterface $logger,
        private EntityManagerInterface $entityManager,
        private PointService $pointService,
        private DtbPointHistoryRepository $pointHistoryRepository,
        private DtbPlayerRepository $playerRepository,
    ) {
    }

    /**
     * @param Order $order ポイント付与対象の受注 (Pattern 1 は既存オンライン受注、Pattern 2-5/8 は新規受注)
     */
    public function apply(Order $order, TransactionDto $transaction): void
    {
        // 非会員はポイント対象外。
        $customer = $order->getCustomer();
        if (!$customer instanceof Customer) {
            return;
        }

        $transactionId = $this->resolveTransactionId($transaction);
        if ($transactionId === null) {
            // 取引IDが数値でない場合は冪等性を担保できないため適用しない。
            $this->logger->warning('Smaregi point not applied: transactionHeadId is not numeric', [
                'transactionHeadId' => $transaction->transactionHeadId,
                'orderId' => $order->getId(),
            ]);

            return;
        }

        $gained = (int) ($transaction->newPoint ?? 0);
        $spended = (int) ($transaction->spendPoint ?? 0);
        if ($gained === 0 && $spended === 0) {
            return;
        }

        // ポイント残高を持つ会員 (Player) を取得。Player が無ければ PointService 側でも
        // 残高加減算されないため、ロックも適用も行わない。
        $player = $this->playerRepository->findOneByCustomer($customer);
        if ($player === null) {
            $this->logger->warning('Smaregi point not applied: player not found for customer', [
                'transactionHeadId' => $transaction->transactionHeadId,
                'orderId' => $order->getId(),
                'customerId' => $customer->getId(),
            ]);

            return;
        }

        // 同一 transactionHeadId の Webhook が並列処理されると existsByTransactionId が両者 false を
        // 見て二重付与し得る。1 取引 = 1 会員のため、残高を持つ Player 行を悲観ロックして直列化し、
        // ロック確立後に冪等性チェック → 付与 → 履歴記録までを同一トランザクションで完了させる。
        $this->entityManager->beginTransaction();
        try {
            $this->entityManager->lock($player, LockMode::PESSIMISTIC_WRITE);

            // 冪等性: 同一取引のポイント履歴が既にあれば再適用しない (ロック確立後に再確認)。
            if ($this->pointHistoryRepository->existsByTransactionId($transactionId)) {
                $this->entityManager->commit();
                $this->logger->info('Smaregi point already applied for transaction, skipping', [
                    'transactionHeadId' => $transaction->transactionHeadId,
                    'orderId' => $order->getId(),
                ]);

                return;
            }

            $order->setGainedPoints($gained);
            $order->setSpendedPoints($spended);
            $this->entityManager->persist($order);

            $this->pointService->gainPoints($order, $transactionId);
            $this->pointService->spendPoints($order, $transactionId);
            $this->entityManager->flush();
            $this->entityManager->commit();
        } catch (\Throwable $e) {
            if ($this->entityManager->getConnection()->isTransactionActive()) {
                $this->entityManager->rollback();
            }

            throw $e;
        }

        $this->logger->info('Smaregi point applied to member', [
            'transactionHeadId' => $transaction->transactionHeadId,
            'orderId' => $order->getId(),
            'gainedPoints' => $gained,
            'spendedPoints' => $spended,
        ]);
    }

    /**
     * 取引IDを履歴用の int に変換する。数値でなければ null を返す。
     */
    private function resolveTransactionId(TransactionDto $transaction): ?int
    {
        $transactionHeadId = $transaction->transactionHeadId;
        if ($transactionHeadId === null || !ctype_digit($transactionHeadId)) {
            return null;
        }

        return (int) $transactionHeadId;
    }
}

