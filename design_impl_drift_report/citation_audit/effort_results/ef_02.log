    /**
     * 受注メール送信に必要な注文情報を取得
     *
     * @return array{Order|null, Delivery|null}
     */
    public function findForOrderMail(int $orderId): array
    {
        $result = $this->getEntityManager()->createQueryBuilder()
            ->from('Eccube\Entity\Order', 'o')
            ->select('o')
            ->leftJoin('o.OrderItems', 'oi')
            ->leftJoin('oi.Product', 'p')
            ->join('o.Shippings', 's')
            ->join('s.Delivery', 'd')
            ->addSelect(['oi', 'p', 's', 'd'])
            ->where('o.id = :order')
            ->setParameter('order', $orderId)
            ->getQuery()
            ->getResult();

        $Order = $result[0] ?? null;
        $Delivery = $Order?->getShippings()->first()?->getDelivery();

        return [$Order, $Delivery];
    }

    /**
