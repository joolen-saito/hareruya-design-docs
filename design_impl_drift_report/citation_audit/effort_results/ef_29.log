namespace Eccube\Controller\Admin\Event;

use Eccube\Common\EccubeConfig;
use Eccube\Controller\AbstractController;
use Eccube\Entity\DtbEntryPlayer;
use Eccube\Entity\DtbEventDetail;
use Eccube\Entity\DtbEventEntry;
use Eccube\Entity\DtbPlayer;
use Eccube\Event\EccubeEvents;
use Eccube\Event\EventArgs;
use Eccube\Form\Type\Admin\EntryRegisterSearchType;
use Eccube\Form\Type\Admin\EventEntryDetailType;
use Eccube\Repository\DtbEventDetailRepository;
use Eccube\Repository\DtbEventEntryRepository;
use Eccube\Repository\DtbEventRepository;
use Eccube\Repository\DtbPlayerRepository;
use Eccube\Service\Admin\Event\ActionInput\EntryRegistrationStoreInput;
use Eccube\Service\Admin\Event\EntryRegistrationScheduleRowBuilder;
use Eccube\Service\Admin\Event\EntryRegistrationStoreAction;
use Eccube\Util\FormUtil;
use Knp\Component\Pager\PaginatorInterface;
use Symfony\Bridge\Doctrine\Attribute\MapEntity;
use Symfony\Bridge\Twig\Attribute\Template;
use Symfony\Component\HttpFoundation\RedirectResponse;
use Symfony\Component\HttpFoundation\Request;
use Symfony\Component\HttpFoundation\Response;
use Symfony\Component\Routing\Attribute\Route;

class EntryRegistrationController extends AbstractController
{
    private const SESSION_KEY = 'eccube.enterprise.admin.entry_registration.search';

    private const SCHEDULES_PER_PAGE = 10;

    private const ENTRY_PLAYER_SEARCH_PER_PAGE = 10;

    public function __construct(
        protected EccubeConfig $eccubeConfig,
        private readonly DtbEventRepository $eventRepository,
        private readonly EntryRegistrationScheduleRowBuilder $entryRegistrationScheduleRowBuilder,
        private readonly EntryRegistrationStoreAction $entryRegistrationStoreAction,
        private readonly DtbEventDetailRepository $eventDetailRepository,
        private readonly DtbEventEntryRepository $eventEntryRepository,
        private readonly DtbPlayerRepository $playerRepository,
    ) {
    }

    /**
     * @return array<string, mixed>
     */
    #[Route(path: '/%eccube_admin_route%/entry_registration', name: 'admin_entry_registration', methods: ['GET', 'POST'])]
    #[Route(path: '/%eccube_admin_route%/entry_registration/page/{page_no}', name: 'admin_entry_registration_page', requirements: ['page_no' => '\d+'], methods: ['GET', 'POST'])]
    #[Template(template: '@admin/Event/EntryRegistration/index.twig')]
    public function index(Request $request, PaginatorInterface $paginator, ?int $page_no = null): array
    {
        $hasExplicitPageParam = $page_no !== null;
        $pageNo = $page_no ?? 1;
        $member = $this->getMember();
        $defaultBaseInfo = $member->getDefaultSearchBaseInfo();
        $builder = $this->formFactory
            ->createBuilder(EntryRegisterSearchType::class, null, [
                'base_info_default' => $defaultBaseInfo ? [$defaultBaseInfo] : [],
            ]);

        $event = new EventArgs(
            [
                'builder' => $builder,
            ],
            $request
        );
        $this->eventDispatcher->dispatch($event, EccubeEvents::ADMIN_EVENT_ENTRY_REGISTRATION_INDEX_INITIALIZE);

        $searchForm = $builder->getForm();
        $pagination = null;
        $datas = [];
        $shouldSearch = false;
        $searchData = [];

        if ('POST' === $request->getMethod()) {
            $searchForm->handleRequest($request);
            if ($searchForm->isValid()) {
                $pageNo = 1;
                $searchData = $searchForm->getData();
                $this->session->set(self::SESSION_KEY, FormUtil::getViewData($searchForm));
                $this->session->set(self::SESSION_KEY.'.page_no', $pageNo);
                $shouldSearch = true;
            } else {
                return [
                    'searchForm' => $searchForm->createView(),
                    'pagination' => [],
                    'datas' => [],
                    'has_errors' => true,
                ];
            }
        } else {
            if ($hasExplicitPageParam || $request->get('resume') !== null) {
                if ($hasExplicitPageParam) {
                    $this->session->set(self::SESSION_KEY.'.page_no', $pageNo);
                } else {
                    $pageNo = (int) $this->session->get(self::SESSION_KEY.'.page_no', 1);
                }
                $viewData = $this->session->get(self::SESSION_KEY, []);
                $searchData = FormUtil::submitAndGetData($searchForm, $viewData);
                $shouldSearch = true;
            } else {
                $pageNo = 1;
                $viewData = FormUtil::getViewData($searchForm);
                $this->session->set(self::SESSION_KEY, $viewData);
                $this->session->set(self::SESSION_KEY.'.page_no', $pageNo);
            }
        }

        if ($shouldSearch) {
            $eventsQueryBuilder = $this->eventRepository->getQueryBuilderByEntryRegistrationSearchData(
                $searchData
            );
            $events = $eventsQueryBuilder->getQuery()->getResult();

            $allDatas = $this->entryRegistrationScheduleRowBuilder->expandScheduleRows(
                $events,
                !empty($searchData['start_date_from']) ? $searchData['start_date_from'] : null,
                !empty($searchData['start_date_to']) ? $searchData['start_date_to'] : null,
            );
            [$pagination, $datas] = $this->entryRegistrationScheduleRowBuilder->paginateWithRowSpanByEvent(
                $paginator,
                $allDatas,
                $pageNo,
                self::SCHEDULES_PER_PAGE
            );
        }

        return [
            'searchForm' => $searchForm->createView(),
            'pagination' => $pagination,
            'datas' => $datas,
        ];
    }

    /**
     * イベント申込新規（GET: フォーム表示、POST: 登録処理）
     *
     * @return RedirectResponse|array<string, mixed>
     */
    #[Route(path: '/%eccube_admin_route%/entry_registration/new/{eventDetailId}', name: 'admin_entry_new', requirements: ['eventDetailId' => '\d+'], methods: ['GET', 'POST'])]
    #[Template(template: '@admin/Event/EntryRegistration/edit.twig')]
    public function create(Request $request, #[MapEntity(id: 'eventDetailId')] DtbEventDetail $eventDetail): RedirectResponse|array
    {
        $baseInfo = $eventDetail->getEvent()->getBaseInfo();
        if ($baseInfo === null || !$this->getMember()->isEditableShop($baseInfo)) {
            throw $this->createNotFoundException();
        }

        $eventEntry = new DtbEventEntry();
        $eventEntry->setId(0);
        $eventEntry->setEventDetail($eventDetail);

        $form = $this->formFactory->create(EventEntryDetailType::class, $eventEntry, ['registration_mode' => true]);
        $form->get('eventDetailId')->setData((string) $eventDetail->getId());

        $event = new EventArgs(
            [
                'form' => $form,
            ],
            $request
        );
        $this->eventDispatcher->dispatch($event, EccubeEvents::ADMIN_EVENT_ENTRY_REGISTRATION_CREATE_INITIALIZE);

        $form->handleRequest($request);

        $entryPlayer = $form->get('entryPlayer')->getData();
        $submittedPlayerId = is_string($entryPlayer) && $entryPlayer !== '' ? (int) $entryPlayer : 0;

        if ($form->isSubmitted() && $form->isValid()) {
            /** @var DtbEventEntry $FormEventEntry */
            $FormEventEntry = $form->getData();
            $input = new EntryRegistrationStoreInput($FormEventEntry, $eventDetail, $this->getMember(), $submittedPlayerId);
            try {
                $this->entryRegistrationStoreAction->handle($input);

                $event = new EventArgs(
                    [
                        'form' => $form,
                    ],
                    $request
                );
                $this->eventDispatcher->dispatch($event, EccubeEvents::ADMIN_EVENT_ENTRY_REGISTRATION_CREATE_COMPLETE);

                $this->addSuccess('admin.common.save_complete', 'admin');

                return $this->redirectToRoute('admin_event_entry_event_detail', ['event_detail_id' => $eventDetail->getId()]);
            } catch (\InvalidArgumentException $e) {
                $this->addError($e->getMessage(), 'admin');
            } catch (\Exception $e) {
                $this->addError('admin.common.save_error', 'admin');
            }
        }

        $entryPlayer = null;
        if ($submittedPlayerId > 0) {
            $player = $this->playerRepository->find($submittedPlayerId);
            if ($player instanceof DtbPlayer) {
                $entryPlayer = (new DtbEntryPlayer())->setPlayer($player);
            }
        }

        return [
            'form' => $form->createView(),
            'eventEntry' => $eventEntry,
            'entryPlayer' => $entryPlayer,
            'seatNames' => [],
        ];
    }

    /**
     * 申込登録画面: プレイヤー検索モーダル用 HTML 断片
     */
    #[Route(path: '/%eccube_admin_route%/entry_registration/search_player', name: 'admin_entry_registration_search_player', methods: ['GET'])]
    public function searchPlayer(Request $request, PaginatorInterface $paginator): Response
    {
        if (!$request->isXmlHttpRequest()) {
            $emptyQb = $this->playerRepository->createQueryBuilder('pl')->andWhere('1 = 0');
            $emptyPagination = $paginator->paginate(
                $emptyQb,
                1,
                self::ENTRY_PLAYER_SEARCH_PER_PAGE,
                [
                    'pageParameterName' => 'page_no',
                    'wrap-queries' => true,
                ]
            );

            return $this->render('@admin/Event/Entry/search_player_modal_list.twig', [
                'players' => [],
                'pagination' => $emptyPagination,
                'entriedFlgs' => [],
                'selectedPlayers' => [],
            ]);
        }

        $eventDetailIdParam = $request->get('event_detail_id');
        if ($eventDetailIdParam === null || $eventDetailIdParam === '' || (int) $eventDetailIdParam <= 0) {
            throw $this->createNotFoundException();
        }
        $eventDetailId = (int) $eventDetailIdParam;
        $eventDetail = $this->eventDetailRepository->find($eventDetailId);
        if ($eventDetail === null) {
            throw $this->createNotFoundException();
        }

        $keyword = (string) $request->query->get('q', '');
        $pageNo = max(1, $request->query->getInt('page_no', 1));
        $qb = $this->playerRepository->getQueryBuilderByEntrySearchData([
            'search' => $keyword,
        ]);

        $event = new EventArgs(
            [
                'qb' => $qb,
            ],
            $request
        );
        $this->eventDispatcher->dispatch($event, EccubeEvents::ADMIN_EVENT_ENTRY_REGISTRATION_PLAYER_SEARCH);

        $pagination = $paginator->paginate(
            $qb,
            $pageNo,
            self::ENTRY_PLAYER_SEARCH_PER_PAGE,
            [
                'pageParameterName' => 'page_no',
                'wrap-queries' => true,
            ]
        );

        $items = $pagination->getItems();
        $entriedFlgs = [];
        $eventEntryId = (int) $request->get('event_entry_id', 0);
        if ($eventEntryId <= 0) {
            $eventEntryId = (int) $request->get('entry_id', 0);
        }
        $eventEntry = $eventEntryId > 0 ? $this->eventEntryRepository->find($eventEntryId) : null;
        if ($eventEntry !== null && $eventEntry->getEventDetail()->getId() !== $eventDetail->getId()) {
            throw $this->createNotFoundException();
        }
        $excludeEventEntryId = $eventEntry !== null ? $eventEntry->getId() : null;
        foreach ($items as $item) {
            $playerId = match (true) {
                $item instanceof DtbPlayer => (int) $item->getId(),
                is_array($item) => (int) ($item['playerId'] ?? $item['id'] ?? 0),
                default => 0,
            };
            $entriedFlgs[] = $eventDetail->isEntriedByPlayerIdExceptEntry($playerId, $excludeEventEntryId);
        }

        $players = iterator_to_array($pagination);

        $selectedParam = $request->get('selectedPlayers');
        $selectedPlayers = [];
        if ($selectedParam !== null && $selectedParam !== '') {
            $selectedPlayers = is_array($selectedParam)
                ? array_values(array_unique(array_filter(array_map(static fn (mixed $v): int => (int) $v, $selectedParam))))
                : array_values(array_unique(array_filter(array_map(
                    static fn (string $v): int => (int) $v,
                    explode(',', (string) $selectedParam)
                ))));
        }

        return $this->render('@admin/Event/Entry/search_player_modal_list.twig', [
            'players' => $players,
            'pagination' => $pagination,
            'entriedFlgs' => $entriedFlgs,
            'selectedPlayers' => $selectedPlayers,
        ]);
    }
}
