                    ->orderBy('b.id', 'ASC'),
            ])
            ->add('start_date_from', DateType::class, [
                'label' => 'admin.event.start_date_from',
                'required' => false,
                'input' => 'datetime',
                'widget' => 'single_text',
                'data' => (new \DateTime())->setTime(0, 0),
                'constraints' => [
                    new Range([
                        'min' => '1900-01-01',
                        'minMessage' => 'form_error.out_of_range',
                    ]),
                ],
                'attr' => [
                    'class' => 'datetimepicker-input',
                    'data-target' => '#'.$this->getBlockPrefix().'_start_date_from',
                    'data-toggle' => 'datetimepicker',
                ],
            ])
            ->add('start_date_to', DateType::class, [
                'label' => 'admin.event.start_date_to',
                'required' => false,
                'input' => 'datetime',
                'widget' => 'single_text',
                'constraints' => [
                    new Range([
                        'min' => '1900-01-01',
                        'minMessage' => 'form_error.out_of_range',
                    ]),
                ],
                'attr' => [
                    'class' => 'datetimepicker-input',
                    'data-target' => '#'.$this->getBlockPrefix().'_start_date_to',
                    'data-toggle' => 'datetimepicker',
                ],
            ])
            ->addEventListener(FormEvents::POST_SUBMIT, function (FormEvent $event): void {
                $form = $event->getForm();

                $startDateFrom = $form['start_date_from']->getData();
                $startDateTo = $form['start_date_to']->getData();

                if (!empty($startDateFrom) && !empty($startDateTo)) {
                    if ($startDateFrom > $startDateTo) {
                        $form['start_date_to']->addError(new FormError(trans('admin.common.date_range_error')));
                    }
                }
            })
        ;
    }

    #[\Override]
    public function configureOptions(OptionsResolver $resolver): void
    {
        $resolver->setDefaults([
            'base_info_default' => [],
        ]);
        $resolver->setAllowedTypes('base_info_default', 'array');
    }

    #[\Override]
    public function getBlockPrefix(): string
    {
        return 'admin_search_event';
    }
