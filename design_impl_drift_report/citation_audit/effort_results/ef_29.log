    32	
    33	/**
    34	 * CSVからデータを取り込むもの。
    35	 */
    36	class CsvImporter
    37	{
    38	    /** @var int flushPerLines のデフォルト値 */
    39	    public const DEFAULT_FLUSH_PER_LINES = 100;
    40	
    41	    /** @var int 行ロックタイムアウト（秒）の最小値 */
    42	    public const MIN_LOCK_TIMEOUT = 1;
    43	
    44	    /** @var int 行ロックタイムアウト（秒）の最大値 */
    45	    public const MAX_LOCK_TIMEOUT = 30;
    46	
    47	    /** @var EntityManagerInterface */
    48	    private EntityManagerInterface $em;
    49	
    50	    /** @var TranslatorInterface */
    51	    private TranslatorInterface $translator;
    52	
    53	    /** @var EccubeConfig */
    54	    private EccubeConfig $eccubeConfig;
    55	
    56	    /** @var CsvImportHandlerInterface */
    57	    private CsvImportHandlerInterface $handler;
    58	
    59	    /** @var Member ログインユーザー */
    60	    private Member $loginUser;
    61	
    62	    /** @var int この件数の CSV 行数を処理する度に DB に flush する。 */
    63	    private int $flushPerLines;
    64	
    65	    /**
    66	     * @param EntityManagerInterface $em
    67	     * @param TranslatorInterface $translator
    68	     * @param EccubeConfig $eccubeConfig
    69	     * @param CsvImportHandlerInterface $handler 読み込んだファイルを処理するもの
    70	     * @param Member $loginUser ログインユーザー
    71	     */
    72	    public function __construct(
    73	        EntityManagerInterface $em,
    74	        TranslatorInterface $translator,
    75	        EccubeConfig $eccubeConfig,
    76	        CsvImportHandlerInterface $handler,
    77	        Member $loginUser,
    78	    ) {
    79	        $this->em = $em;
    80	        $this->translator = $translator;
    81	        $this->eccubeConfig = $eccubeConfig;
    82	        $this->handler = $handler;
    83	        $this->loginUser = $loginUser;
    84	        $this->flushPerLines = self::DEFAULT_FLUSH_PER_LINES;
    85	    }
    86	
    87	    /**
    88	     * @param int $flushPerLines この件数の CSV 行数を処理する度に DB に flush する。
    89	     *
    90	     * @return self
    91	     */
    92	    public function setFlushPerLines(int $flushPerLines): self
    93	    {
    94	        $this->flushPerLines = max($flushPerLines, 1);
    95	
    96	        return $this;
    97	    }
    98	
    99	    /**
   100	     * ファイルをインポートする。
   101	     *
   102	     * @param UploadedFile $file インポートするファイル
   103	     *
   104	     * @return CsvImportResultInterface 処理結果
   105	     *
   106	     * @throws \Exception
   107	     */
   108	    public function import(UploadedFile $file): CsvImportResultInterface
   109	    {
   110	        $tempFileName = $this->createTempFileName($file);
   111	
   112	        try {
   113	            $importService = $this->createCsvImportService($file, $tempFileName);
   114	
   115	            $errors = $this->validateBeforeImport($importService);
   116	            if (!empty($errors)) {
   117	                $result = new CsvImportResult();
   118	                $result->setErrors($errors);
   119	
   120	                return $result;
   121	            }
   122	
   123	            return $this->importRows($importService);
   124	        } finally {
   125	            $this->deleteTempFile($tempFileName);
   126	        }
   127	    }
   128	
   129	    /**
   130	     * 一時ディレクトリに保存するときのファイル名を生成する。
   131	     *
   132	     * @param UploadedFile $file アップロードされたファイル
   133	     *
   134	     * @return string ファイル名
   135	     */
   136	    protected function createTempFileName(UploadedFile $file): string
   137	    {
   138	        return 'upload_'.StringUtil::random().'.'.$file->getClientOriginalExtension();
   139	    }
   140	
   141	    /**
   142	     * 一時ファイルを削除する。
   143	     *
   144	     * @param string $tempFileName ファイル名
   145	     */
   146	    protected function deleteTempFile(string $tempFileName): void
   147	    {
   148	        try {
   149	            $fs = new Filesystem();
   150	            $fs->remove($this->eccubeConfig['eccube_csv_temp_realdir'].'/'.$tempFileName);
   151	        } catch (\Exception $e) {
   152	            // エラーが発生しても無視する
   153	        }
   154	    }
   155	
   156	    /**
   157	     * CSVImportService を生成する。
   158	     *
   159	     * @param UploadedFile $file インポートするファイル
   160	     * @param string $tempFileName 一時ファイルの名前
   161	     *
   162	     * @return CsvImportService
   163	     */
   164	    protected function createCsvImportService(UploadedFile $file, string $tempFileName): CsvImportService
   165	    {
   166	        // アップロードされたCSVファイルを一時ディレクトリに保存
   167	        $file->move($this->eccubeConfig['eccube_csv_temp_realdir'], $tempFileName);
   168	
   169	        $filePath = $this->eccubeConfig['eccube_csv_temp_realdir'].'/'.$tempFileName;
   170	        $splFile = new \SplFileObject($filePath);
   171	
   172	        $fileExtension = $file->getClientOriginalExtension();
   173	        $delimiter = ($fileExtension === 'tsv') ? "\t" : $this->eccubeConfig['eccube_csv_import_delimiter'];
   174	
   175	        return new CsvImportService($splFile, $delimiter, $this->eccubeConfig['eccube_csv_import_enclosure']);
   176	    }
   177	
   178	    /**
   179	     * 基本的なエラーをチェックする。
   180	     *
   181	     * @param CsvImportService $importService CSVファイル
   182	     *
   183	     * @return array<int, array{message: string}> エラーメッセージ。エラーがない場合は空。
   184	     */
   185	    protected function validateBeforeImport(CsvImportService $importService): array
   186	    {
   187	        $messageStore = new MessageStore($this->translator);
   188	
   189	        // 1行目にヘッダ行がなければエラー
   190	        if (!$importService->setHeaderRowNumber(0)) {
   191	            $messageStore->addHeaderFormatError();
   192	
   193	            return $messageStore->getMessages();
   194	        }
   195	
   196	        // 2行目にデータが存在しない場合はエラー
   197	        $importService->next();
   198	        $hasData = $importService->valid();
   199	        $importService->seek(0);
   200	        if (!$hasData) {
   201	            $messageStore->addNoDataError();
   202	
   203	            return $messageStore->getMessages();
   204	        }
   205	
   206	        // エラーなし
   207	        return [];
   208	    }
   209	
   210	    /**
   211	     * 各行のデータをインポートする。
   212	     *
   213	     * @param CsvImportService $importService
   214	     *
   215	     * @return CsvImportResultInterface
   216	     *
   217	     * @throws \Exception
   218	     */
   219	    protected function importRows(CsvImportService $importService): CsvImportResultInterface
   220	    {
   221	        $headers = $importService->getColumnHeaders();
   222	        $this->em->getConnection()->beginTransaction();
   223	
   224	        try {
   225	            $defaultLockTimeout = SqlUtil::getLockTimeout($this->em);
   226	            SqlUtil::setLockTimeout($this->em, $this->getLockTimeout());
   227	
   228	            $messageStore = new MessageStore($this->translator);
   229	            $this->handler->onBeforeImport();
   230	
   231	            $hasBreak = false;
   232	            $importCount = 0;
   233	            foreach ($importService as $index => $row) {
   234	                $rowNumber = $index + 1;
   235	                $csvRow = new CsvRow($rowNumber, $row);
   236	                $csvRow->setHeaders($headers);
   237	                $event = new ReadCsvRowEvent($csvRow, $messageStore, $this->loginUser);
   238	
   239	                $this->handler->onValidateRow($event);
   240	                if ($event->isBreakAll()) {
   241	                    $hasBreak = true;
   242	                    break;
   243	                }
   244	                if ($event->isSkipRow()) {
   245	                    continue;
   246	                }
   247	
   248	                $event->clearNextAction();
   249	                $isOk = $this->handler->onReadRow($event);
   250	                if ($isOk) {
   251	                    $importCount++;
   252	                }
   253	
   254	                if ($index % $this->flushPerLines === 0) {
   255	                    $this->em->flush();
   256	                    $this->em->clear();
   257	                }
   258	
   259	                // onReadRow()内でbreakAll()が呼ばれる可能性があるため、チェックが必要
   260	                /** @phpstan-ignore-next-line */
   261	                if ($event->isBreakAll()) {
   262	                    $hasBreak = true;
   263	                    break;
   264	                }
   265	            }
   266	
   267	            $this->em->flush();
   268	            $this->em->clear();
   269	
   270	            $isSuccessful = $messageStore->count() === 0 || !$hasBreak;
   271	            if ($isSuccessful) {
   272	                $this->em->getConnection()->commit();
   273	            } else {
   274	                $this->em->getConnection()->rollback();
   275	            }
   276	
   277	            $this->handler->onAfterImport(new AfterReadEvent($isSuccessful, $importCount));
   278	
   279	            SqlUtil::setLockTimeout($this->em, $defaultLockTimeout);
   280	
   281	            $importResult = new CsvImportResult();
   282	            $importResult->setCount($importCount)
   283	                ->setErrors($messageStore->getMessages())
   284	                ->setInfos($messageStore->getInfos());
   285	
   286	            return $importResult;
   287	        } catch (\Exception $e) {
   288	            try {
   289	                $this->em->getConnection()->rollback();
   290	            } catch (ConnectionException $ce) {
   291	                // 元のエラーを throws するため、ロールバック時のエラーは無視する
   292	            }
   293	
   294	            throw $e;
   295	        }
   296	    }
   297	
   298	    /**
   299	     * @return int 行ロックのタイムアウト（秒）
   300	     *

