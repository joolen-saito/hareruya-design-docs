   102	                    ->where('p.id = :id')
   103	                    ->setParameter('id', Payment::EC_ADMIN),
   104	                'disabled' => true,
   105	                'attr' => [
   106	                    'class' => 'form-select',
   107	                ],
   108	            ])
   109	            ->add('price', IntegerType::class, [
   110	                'label' => 'admin.event.entry.price',
   111	                'required' => false,
   112	                'disabled' => true,
   113	                'attr' => [
   114	                    'class' => 'form-control payment',
   115	                ],
   116	            ])
   117	            ->add('search', TextType::class, [
   118	                'mapped' => false,
   119	                'label' => false,
   120	                'required' => false,
   121	                'attr' => [
   122	                    'class' => 'form-control',
   123	                ],
   124	            ])
   125	        ;
   126	
   127	        $builder->addEventListener(FormEvents::PRE_SET_DATA, function (FormEvent $event): void {
   128	            $data = $event->getData();
   129	            if (!$data instanceof DtbEventEntry) {
   130	                return;
   131	            }
   132	            if ($data->getId() !== 0) {
   133	                return;
   134	            }
   135	            $entered = $this->entryStatusRepository->find(MtbEntryStatus::ENTERED);
   136	            if ($entered instanceof MtbEntryStatus) {
   137	                $data->setEntryStatus($entered);
   138	            }
   139	            $payment = $this->paymentRepository->find(Payment::EC_ADMIN);
   140	            if ($payment instanceof Payment) {
   141	                $data->setPayment($payment);
   142	            }
   143	            $eventDetail = $data->getEventDetail();
   144	            $data->setPrice($eventDetail->getEntryFee());
   145	        });
   146	    }
