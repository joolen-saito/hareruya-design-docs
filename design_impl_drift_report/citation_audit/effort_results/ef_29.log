    private ?BaseCsvColumn $bannerUrlEnColumn = null;
    private ?BaseCsvColumn $capacityColumn = null;
    private ?BaseCsvColumn $teamBattleColumn = null;
    private ?BaseCsvColumn $creditCardColumn = null;
    private ?BaseCsvColumn $entryFeeColumn = null;
    private ?BaseCsvColumn $prizeJaColumn = null;
    private ?BaseCsvColumn $prizeEnColumn = null;
    private ?BaseCsvColumn $free1LabelJaColumn = null;
    private ?BaseCsvColumn $free1LabelEnColumn = null;
    private ?BaseCsvColumn $free1ContentJaColumn = null;
    private ?BaseCsvColumn $free1ContentEnColumn = null;
    private ?BaseCsvColumn $free1AccordionColumn = null;
    private ?BaseCsvColumn $free2LabelJaColumn = null;
    private ?BaseCsvColumn $free2LabelEnColumn = null;
    private ?BaseCsvColumn $free2ContentJaColumn = null;
    private ?BaseCsvColumn $free2ContentEnColumn = null;
    private ?BaseCsvColumn $free2AccordionColumn = null;
    private ?BaseCsvColumn $free3LabelJaColumn = null;
    private ?BaseCsvColumn $free3LabelEnColumn = null;
    private ?BaseCsvColumn $free3ContentJaColumn = null;
    private ?BaseCsvColumn $free3ContentEnColumn = null;
    private ?BaseCsvColumn $free3AccordionColumn = null;
    private ?BaseCsvColumn $startTimeColumn = null;
    private ?BaseCsvColumn $receptionColumn = null;
    private ?BaseCsvColumn $receptionTimeFromColumn = null;
    private ?BaseCsvColumn $receptionTimeToColumn = null;
    private ?BaseCsvColumn $deckRegColumn = null;
    private ?BaseCsvColumn $deckDeadlineColumn = null;
    private ?BaseCsvColumn $onlineReceptionColumn = null;
    private ?BaseCsvColumn $onlineReceptionTimeFromColumn = null;
    private ?BaseCsvColumn $onlineReceptionTimeToColumn = null;
    private ?BaseCsvColumn $capacityScheduleColumn = null;
    private ?BaseCsvColumn $entryFeeScheduleColumn = null;
    private ?BaseCsvColumn $publicSchedColumn = null;
    private ?BaseCsvColumn $prizeSchedJaColumn = null;
    private ?BaseCsvColumn $prizeSchedEnColumn = null;

    private int $capacityMin = 1;

    public function __construct(
        private readonly EventEntityManager $eventEntityManager,
        private readonly EventDetailEntityManager $eventDetailEntityManager,
        private readonly PaymentRepository $paymentRepository,
        private readonly BaseInfoRepository $baseInfoRepository,
        private readonly MtbFormatRepository $formatRepository,
        private readonly MtbRelRepository $relRepository,
        private readonly MtbDispRepository $dispRepository,
        private readonly MtbHolidayRepository $holidayRepository,
        private readonly EccubeConfig $eccubeConfig,
        private readonly TranslatorInterface $translator,
        private readonly Member $member,
    ) {
        $this->capacityMin = (int) $this->eccubeConfig['eccube_capacity_min'];
    }

    #[\Override]
    public function onBeforeImport(): void
    {
        $this->initializeColumnDefinitions();
        parent::onBeforeImport();
    }

    #[\Override]
    public function onAfterImport(AfterReadEvent $event): void
    {
        parent::onAfterImport($event);
        $this->clearColumnDefinitions();
    }

    #[\Override]
    public function onValidateRow(ReadCsvRowEvent $event): void
    {
        parent::onValidateRow($event);

        if ($event->isBreakAll() || $event->isSkipRow()) {
            return;
        }

        $row = $event->getRow();
        $ms = $event->getMessageStore();
        $rn = $row->getRowNumber();

        $cap = (int) $this->capacityColumn->getValue($row);
        if ($cap < $this->capacityMin) {
            $ms->addInvalidFormatError($rn, $this->capacityColumn->getLabel());
            $event->breakAll();

            return;
        }

        $fee = (int) $this->entryFeeColumn->getValue($row);
        if ($fee < 0) {
            $ms->addInvalidFormatError($rn, $this->entryFeeColumn->getLabel());
            $event->breakAll();

            return;
        }

        $team = (int) $this->teamBattleColumn->getValue($row);
        if (!\in_array($team, [0, 1], true)) {
            $ms->addRawMessage($this->transError('admin.event.entry.bulk_csv.error.team_battle_invalid', $rn));
            $event->breakAll();

            return;
        }

        $shopName = $this->cellStr($row, $this->shopColumn);
        $baseInfo = $this->resolveBaseInfo($shopName);
        if ($baseInfo === null) {
            $ms->addMasterNotExistsError($rn, '店舗', $shopName);
            $event->breakAll();

            return;
        }

        if (!$this->member->isEditableShop($baseInfo)) {
            $ms->addRawMessage($this->transError('admin.event.entry.bulk_csv.error.shop_not_editable', $rn));
            $event->breakAll();

            return;
        }

        $formatRaw = $this->cellStr($row, $this->formatColumn);
        if (!$this->resolveFormats($formatRaw)) {
            $ms->addRawMessage($this->transError('admin.event.entry.bulk_csv.error.format_not_found', $rn));
            $event->breakAll();

            return;
        }

        $relName = $this->cellStr($row, $this->ruleRelColumn);
        if ($this->resolveRel($relName) === null) {
            $ms->addMasterNotExistsError($rn, 'ルール適用度', $relName);
            $event->breakAll();

            return;
        }

        $publicLabel = $this->cellStr($row, $this->publicDispColumn);
        if ($this->resolveDispByPublicLabel($publicLabel) === null) {
            $ms->addMasterNotExistsError($rn, '公開状態', $publicLabel);
            $event->breakAll();

            return;
        }

        $credit = $this->cellStr($row, $this->creditCardColumn);
        if ($credit !== '' && !\in_array($credit, [self::LABEL_OPTION_YES, self::LABEL_OPTION_NO], true)) {
            $ms->addInvalidChoiceError($rn, $this->creditCardColumn->getLabel());
            $event->breakAll();

            return;
        }

        foreach ([$this->receptionColumn, $this->deckRegColumn, $this->onlineReceptionColumn] as $col) {
            $x = $this->cellStr($row, $col);
            if ($x !== '' && !\in_array($x, [self::LABEL_OPTION_YES, self::LABEL_OPTION_NO], true)) {
                $ms->addInvalidChoiceError($rn, $col->getLabel());
                $event->breakAll();

                return;
            }
        }

        $startRaw = $this->cellStr($row, $this->startTimeColumn);
        $scheduleTouched = $this->hasAnyScheduleCell($row);

        if ($startRaw === '' && $scheduleTouched) {
            $ms->addRawMessage($this->transError('admin.event.entry.bulk_csv.error.schedule_without_start', $rn));
            $event->breakAll();

            return;
        }

        if ($startRaw !== '') {
            $startDt = $this->parseDateTimeYmdHm($startRaw);
            if ($startDt === null) {
                $ms->addInvalidFormatError($rn, $this->startTimeColumn->getLabel());
                $event->breakAll();

                return;
            }

            $receptionCellValue = $this->cellStr($row, $this->receptionColumn);
            if ($receptionCellValue === self::LABEL_OPTION_YES) {
                $recvFrom = $this->cellStr($row, $this->receptionTimeFromColumn);
                $recvTo = $this->cellStr($row, $this->receptionTimeToColumn);
                if ($recvFrom === '' || $recvTo === '') {
                    $ms->addRawMessage($this->transError('admin.event.entry.bulk_csv.error.reception_time_required', $rn));
                    $event->breakAll();

                    return;
                }
                $recvFromDt = $this->combineDayAndHm($startDt, $recvFrom);
                if ($recvFromDt === null) {
                    $ms->addInvalidFormatError($rn, $this->receptionTimeFromColumn->getLabel());
                    $event->breakAll();

                    return;
                }
                $recvToDt = $this->combineDayAndHm($startDt, $recvTo);
                if ($recvToDt === null) {
                    $ms->addInvalidFormatError($rn, $this->receptionTimeToColumn->getLabel());
                    $event->breakAll();

                    return;
                }
                if ($recvFromDt >= $recvToDt) {
                    $ms->addRawMessage($this->transError('admin.event.entry.bulk_csv.error.reception_time_order', $rn));
                    $event->breakAll();

                    return;
                }
                if ($recvToDt > $startDt) {
                    $ms->addRawMessage($this->transError('admin.event.entry.bulk_csv.error.reception_end_after_event_start', $rn));
                    $event->breakAll();

                    return;
                }
            }

            $online = $this->cellStr($row, $this->onlineReceptionColumn);
            if ($online === self::LABEL_OPTION_YES) {
                $onFrom = $this->cellStr($row, $this->onlineReceptionTimeFromColumn);
                $onTo = $this->cellStr($row, $this->onlineReceptionTimeToColumn);
                if ($onFrom === '' || $onTo === '') {
                    $ms->addRawMessage($this->transError('admin.event.entry.bulk_csv.error.online_reception_time_required', $rn));
                    $event->breakAll();

                    return;
                }
                $onlineFromDt = $this->parseReceptionWindowDateTime($onFrom);
                if ($onlineFromDt === null) {
                    $ms->addInvalidFormatError($rn, $this->onlineReceptionTimeFromColumn->getLabel());
                    $event->breakAll();

                    return;
                }
                $onlineToDt = $this->parseReceptionWindowDateTime($onTo);
                if ($onlineToDt === null) {
                    $ms->addInvalidFormatError($rn, $this->onlineReceptionTimeToColumn->getLabel());
                    $event->breakAll();

                    return;
                }
                if ($onlineFromDt >= $onlineToDt) {
                    $ms->addRawMessage($this->transError('admin.event.entry.bulk_csv.error.online_reception_time_order', $rn));
                    $event->breakAll();

                    return;
                }
                if ($onlineToDt >= $startDt) {
                    $ms->addRawMessage($this->transError('admin.event.entry.bulk_csv.error.online_reception_end_not_before_event_start', $rn));
                    $event->breakAll();

                    return;
                }
            }

            $deckDeadlineRaw = $this->cellStr($row, $this->deckDeadlineColumn);
            if ($deckDeadlineRaw !== '' && $this->parseDateTimeYmdHm($deckDeadlineRaw) === null) {
                $ms->addInvalidFormatError($rn, $this->deckDeadlineColumn->getLabel());
                $event->breakAll();

                return;
            }

            $dispS = $this->cellStr($row, $this->publicSchedColumn);
            if ($dispS === '' || $this->resolveDispByPublicLabel($dispS) === null) {
                $ms->addInvalidFormatError($rn, $this->publicSchedColumn->getLabel());
                $event->breakAll();

                return;
            }

            $capSc = $this->capacityScheduleColumn->getValue($row);
            if ($capSc !== null && (int) $capSc < $this->capacityMin) {
                $ms->addInvalidFormatError($rn, $this->capacityScheduleColumn->getLabel());
                $event->breakAll();

                return;
            }

            $feeSc = $this->entryFeeScheduleColumn->getValue($row);
            if ($feeSc !== null && (int) $feeSc < 0) {
                $ms->addInvalidFormatError($rn, $this->entryFeeScheduleColumn->getLabel());
                $event->breakAll();

                return;
            }
        }
    }

    #[\Override]
    public function onReadRow(ReadCsvRowEvent $event): bool
    {
        $row = $event->getRow();

        $baseInfo = $this->resolveBaseInfo($this->cellStr($row, $this->shopColumn));
        $rel = $this->resolveRel($this->cellStr($row, $this->ruleRelColumn));
        $disp = $this->resolveDispByPublicLabel($this->cellStr($row, $this->publicDispColumn));
        \assert($baseInfo !== null && $rel !== null && $disp instanceof MtbDisp);

        $formats = $this->resolveFormatsCollection($this->cellStr($row, $this->formatColumn));

        $prizeJp = $this->cellStr($row, $this->prizeJaColumn) ?: null;
        $prizeEn = $this->cellStr($row, $this->prizeEnColumn) ?: null;
        $bannerJp = $this->cellStr($row, $this->bannerUrlJaColumn) ?: null;
        $bannerEn = $this->cellStr($row, $this->bannerUrlEnColumn) ?: null;

        $payments = new ArrayCollection(
            $this->cellStr($row, $this->creditCardColumn) === self::LABEL_OPTION_YES
            && ($creditPayment = $this->paymentRepository->find(Payment::EC_CREDIT)) instanceof Payment
                ? [$creditPayment]
                : []
        );

        $team = (int) $this->teamBattleColumn->getValue($row);
        $isTeamBattle = $team === 1;

        $dtbEvent = $this->eventEntityManager->save(
            Event: null,
            Rel: $rel,
            Disp: $disp,
            nameJp: $this->cellStr($row, $this->eventNameJaColumn),
            capacity: (int) $this->capacityColumn->getValue($row),
            entryFee: (int) $this->entryFeeColumn->getValue($row),
            Member: $this->member,
            isTeamBattle: $isTeamBattle,
            isFreeTextArea1Accordion: $this->parseAccordion($this->cellStr($row, $this->free1AccordionColumn)),
            isFreeTextArea2Accordion: $this->parseAccordion($this->cellStr($row, $this->free2AccordionColumn)),
            isFreeTextArea3Accordion: $this->parseAccordion($this->cellStr($row, $this->free3AccordionColumn)),
            BaseInfo: $baseInfo,
            nameEn: $this->cellStr($row, $this->eventNameEnColumn),
            prizeJp: $prizeJp,
            prizeEn: $prizeEn,
            bannerUrl: $bannerJp,
            bannerEnUrl: $bannerEn,
            EventScale: null,
            freeTextArea1LabelJp: $this->cellStr($row, $this->free1LabelJaColumn) ?: null,
            freeTextArea1LabelEn: $this->cellStr($row, $this->free1LabelEnColumn) ?: null,
            freeTextArea1ContentJp: $this->cellStr($row, $this->free1ContentJaColumn) ?: null,
            freeTextArea1ContentEn: $this->cellStr($row, $this->free1ContentEnColumn) ?: null,
            freeTextArea2LabelJp: $this->cellStr($row, $this->free2LabelJaColumn) ?: null,
            freeTextArea2LabelEn: $this->cellStr($row, $this->free2LabelEnColumn) ?: null,
            freeTextArea2ContentJp: $this->cellStr($row, $this->free2ContentJaColumn) ?: null,
            freeTextArea2ContentEn: $this->cellStr($row, $this->free2ContentEnColumn) ?: null,
            freeTextArea3LabelJp: $this->cellStr($row, $this->free3LabelJaColumn) ?: null,
            freeTextArea3LabelEn: $this->cellStr($row, $this->free3LabelEnColumn) ?: null,
            freeTextArea3ContentJp: $this->cellStr($row, $this->free3ContentJaColumn) ?: null,
            freeTextArea3ContentEn: $this->cellStr($row, $this->free3ContentEnColumn) ?: null,
            Formats: $formats,
            Payments: $payments,
        );

        $startRaw = $this->cellStr($row, $this->startTimeColumn);
        if ($startRaw !== '') {
            $startDt = $this->parseDateTimeYmdHm($startRaw);
            \assert($startDt !== null);
            $dispSchedule = $this->resolveDispByPublicLabel($this->cellStr($row, $this->publicSchedColumn));
            \assert($dispSchedule instanceof MtbDisp);

            $capEv = (int) $this->capacityColumn->getValue($row);
            $feeEv = (int) $this->entryFeeColumn->getValue($row);
            $capSc = $this->capacityScheduleColumn->getValue($row);
            $feeSc = $this->entryFeeScheduleColumn->getValue($row);
            $capDetail = $capSc === null ? $capEv : (int) $capSc;
            $feeDetail = $feeSc === null ? $feeEv : (int) $feeSc;

            $receptionCellValue = $this->cellStr($row, $this->receptionColumn);
            $entryFlg = $receptionCellValue === self::LABEL_OPTION_YES;

            $entryStart = null;
            $entryEnd = null;
            if ($receptionCellValue === self::LABEL_OPTION_YES) {
                $entryStart = $this->combineDayAndHm($startDt, $this->cellStr($row, $this->receptionTimeFromColumn));
                $entryEnd = $this->combineDayAndHm($startDt, $this->cellStr($row, $this->receptionTimeToColumn));
            }

            $onlineStart = null;
            $onlineEnd = null;
            if ($this->cellStr($row, $this->onlineReceptionColumn) === self::LABEL_OPTION_YES) {
                $onlineStart = $this->parseReceptionWindowDateTime($this->cellStr($row, $this->onlineReceptionTimeFromColumn));
                $onlineEnd = $this->parseReceptionWindowDateTime($this->cellStr($row, $this->onlineReceptionTimeToColumn));
            }

            $deckRegVal = $this->cellStr($row, $this->deckRegColumn);
            $deckFlg = $deckRegVal !== '' && $deckRegVal !== self::LABEL_OPTION_NO;
            $deckDeadline = null;
            if ($deckFlg) {
                $deckDeadlineRaw = $this->cellStr($row, $this->deckDeadlineColumn);
                if ($deckDeadlineRaw !== '') {
