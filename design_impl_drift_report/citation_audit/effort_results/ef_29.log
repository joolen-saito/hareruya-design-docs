    93	                /** @var UploadedFile $formFile */
    94	                $formFile = $form->get('import_file')->getData();
    95	                if ($this->countCsvRows($formFile) > static::ADMIN_CSV_IMPORT_MAX_ROWS) {
    96	                    return [
    97	                        'form' => $form->createView(),
    98	                        'headers' => $headers,
    99	                        'errors' => [
   100	                            $this->translator->trans('admin.csv.error.upload.maxrecord', [
   101	                                '%maxRecord%' => static::ADMIN_CSV_IMPORT_MAX_ROWS,
   102	                            ]),
   103	                        ],
   104	                    ];
   105	                }
   106	                $user = $this->getUser();
   107	                if (!$user instanceof Member) {
   108	                    return [
   109	                        'form' => $form->createView(),
   110	                        'headers' => $headers,
   111	                        'errors' => [$this->translator->trans('admin.common.system_error')],
   112	                    ];
   113	                }
   114	                log_info('イベント一括登録CSV登録開始');
   115	                $handler = new EventBulkCsvImportHandler(
   116	                    $this->eventEntityManager,
   117	                    $this->eventDetailEntityManager,
   118	                    $this->paymentRepository,
   119	                    $this->baseInfoRepository,
   120	                    $this->mtbFormatRepository,
   121	                    $this->mtbRelRepository,
   122	                    $this->mtbDispRepository,
   123	                    $this->mtbHolidayRepository,
   124	                    $this->eccubeConfig,
   125	                    $this->translator,
   126	                    $user,
   127	                );
   128	                $importer = new CsvImporter(
   129	                    $this->entityManager,
   130	                    $this->translator,
   131	                    $this->eccubeConfig,
   132	                    $handler,
   133	                    $user,
   134	                );
   135	                $result = null;
   136	                try {
   137	                    $result = $importer->import($formFile);
   138	                } catch (\Exception $e) {
   139	                    $errors[] = $e->getMessage();
   140	                }
   141	                if ($errors === [] && $result->hasError()) {
   142	                    $errors = array_map(
   143	                        static fn (array $error): string => $error['message'],
   144	                        $result->getErrors()
   145	                    );
   146	                }
   147	                if ($errors === []) {
   148	                    log_info('イベント一括登録CSV登録完了');
   149	
   150	                    $event = new EventArgs(
   151	                        [
   152	                            'form' => $form,
   153	                        ],
   154	                        $request
   155	                    );
   156	                    $this->eventDispatcher->dispatch($event, EccubeEvents::ADMIN_EVENT_ENTRY_BULK_CSV_INDEX_COMPLETE);
   157	
   158	                    $this->addSuccess('admin.common.csv_upload_complete', 'admin');
   159	
   160	                    return $this->redirectToRoute('admin_event_entry_bulk_csv_import');
   161	                }
   162	            } else {
   163	                foreach ($form->getErrors(true) as $error) {
   164	                    $errors[] = $error->getMessage();
   165	                }
   166	            }
   167	        }
   168	
   169	        return [
   170	            'form' => $form->createView(),
   171	            'headers' => $headers,
   172	            'errors' => $errors,
   173	        ];
   174	    }
