class EntryDeckListDisplayBuilder
{
    private const UNKNOWN_CARDTYPE_ID = 0;

    public function __construct(
        private readonly DtbDeckRepository $deckRepository,
        private readonly CardListParserService $cardListParserService,
        private readonly MtbCardRepository $cardRepository,
        private readonly MtbCardtypeRepository $cardtypeRepository,
    ) {
    }

    /**
     * @param iterable<DtbEventEntry> $entries
     *
     * @return list<array<string, mixed>>
     */
    public function build(iterable $entries): array
    {
        $entries = iterator_to_array($entries);
        if ($entries === []) {
            return [];
        }

        $deckMap = $this->buildDeckMap($entries);
        $cardtypes = $this->loadCardtypes();
        $pages = [];

        foreach ($entries as $entry) {
            $eventDetailId = $entry->getEventDetail()->getId();
            foreach ($entry->getEntryPlayers() as $entryPlayer) {
                $deck = $deckMap[$eventDetailId.'-'.$entryPlayer->getPlayer()->getId()] ?? null;
                if ($deck === null) {
                    continue;
                }

                $page = $this->buildPage($deck, $cardtypes);
                if ($page !== null) {
                    $pages[] = $page;
                }
            }
        }

        $totalPages = count($pages);
        foreach ($pages as $i => &$page) {
            $page['pageNo'] = $i + 1;
            $page['totalPages'] = $totalPages;
        }
        unset($page);

        return $pages;
    }

    /**
     * @param list<DtbEventEntry> $entries
     *
     * @return array<string, DtbDeck>
     */
    private function buildDeckMap(array $entries): array
    {
        $eventDetails = [];
        foreach ($entries as $entry) {
            $eventDetails[$entry->getEventDetail()->getId()] = $entry->getEventDetail();
        }

        $map = [];
        foreach ($this->deckRepository->createQueryBuilder('d')
            ->where('d.EventDetail IN (:eventDetails)')
            ->andWhere('d.deletedAt IS NULL')
            ->setParameter('eventDetails', array_values($eventDetails))
            ->getQuery()
            ->getResult() as $deck) {
            $eventDetailId = $deck->getEventDetail()?->getId();
            $playerId = $deck->getPlayer()?->getId();
            if ($eventDetailId !== null && $playerId !== null) {
                $map[$eventDetailId.'-'.$playerId] ??= $deck;
            }
        }

        return $map;
    }

    /** @return list<array{id: int, label: string}> */
    private function loadCardtypes(): array
    {
        $types = [];
        foreach ($this->cardtypeRepository->findBy([], ['sort_no' => 'ASC']) as $cardtype) {
            $types[] = ['id' => $cardtype->getId(), 'label' => $cardtype->getNameJp()];
        }
        $types[] = ['id' => self::UNKNOWN_CARDTYPE_ID, 'label' => ''];

        return $types;
    }

    /**
     * @param list<array{id: int, label: string}> $cardtypes
     *
     * @return array<string, mixed>|null
     */
    private function buildPage(DtbDeck $deck, array $cardtypes): ?array
    {
        $mainCards = $this->resolveMainCards($deck);
        if ($mainCards === []) {
            return null;
        }

        $displayName = $this->resolvePlayerDisplayName($deck);
        $eventDetail = $deck->getEventDetail();

        return [
            'displayName' => $displayName,
            'firstLetter' => $displayName !== '' ? (string) mb_substr(trim($displayName), 0, 1) : '',
            'pageNo' => 1,
            'totalPages' => 1,
            'tableNumber' => '',
            'dciNo' => $deck->getPlayer()?->getDciNo() ?? '',
            'eventName' => $eventDetail?->getEvent()?->getNameJp() ?? '',
            'eventDate' => $eventDetail?->getStartDate()?->format('Y/m/d') ?? '',
            'mainboard' => $this->buildMainboard($mainCards, $cardtypes),
        ];
    }

    /** @return list<array{count: int, cardId: int, name: string, row: int}> */
    private function resolveMainCards(DtbDeck $deck): array
    {
        $decoded = $this->cardListParserService->decodeCardList($deck->getTextMain() ?? '');
        $mainCards = is_array($decoded) ? $decoded : [];
        if ($mainCards !== [] || $deck->getDeckCards()->isEmpty()) {
            return $mainCards;
        }

        $cards = [];
        foreach ($deck->getDeckCards() as $deckCard) {
            if ($deckCard->getBoard()->getId() !== MtbBoard::BOARD_ID_MAIN) {
                continue;
            }
            $mtbCard = $deckCard->getCard();
            $name = trim((string) ($mtbCard->getNameJp() ?? $mtbCard->getNameEn() ?? ''));
            if ($name === '') {
                continue;
            }
            $cards[] = [
                'count' => $deckCard->getCount(),
                'cardId' => $mtbCard->getId(),
                'name' => $name,
                'row' => count($cards) + 1,
            ];
        }

        return $cards;
    }

    /**
     * @param list<array{count: int, cardId: int, name: string, row: int}> $mainCards
     * @param list<array{id: int, label: string}> $cardtypes
     *
     * @return array{totalCount: int, leftSections: list<array<string, mixed>>, rightSections: list<array<string, mixed>>}
     */
    private function buildMainboard(array $mainCards, array $cardtypes): array
    {
        [$cardsById, $cardsByName] = $this->loadCards($mainCards);
        $sortIds = array_values(array_filter(array_column($cardtypes, 'id'), static fn (int $id): bool => $id > 0));

        $sections = [];
        foreach ($cardtypes as $type) {
            $sections[$type['id']] = ['label' => $type['label'], 'count' => 0, 'cards' => []];
        }

        $totalCount = 0;
        foreach ($mainCards as $parsed) {
            $card = $parsed['cardId'] > 0
                ? ($cardsById[$parsed['cardId']] ?? null)
                : ($cardsByName[$parsed['name']] ?? null);
            $typeId = $this->resolveCardtypeId($card, $sortIds);
            if (!isset($sections[$typeId])) {
                $typeId = self::UNKNOWN_CARDTYPE_ID;
            }

            $sections[$typeId]['cards'][] = $this->toDisplayCard($parsed, $card);
            $sections[$typeId]['count'] += $parsed['count'];
            $totalCount += $parsed['count'];
        }

        $leftSections = [];
        $rightSections = [];
        foreach ($cardtypes as $type) {
            $section = $sections[$type['id']];
            if ($section['cards'] === []) {
                continue;
            }
            $item = [
                'cardtypeId' => $type['id'],
                'label' => $section['label'],
                'count' => $section['count'],
                'cards' => $section['cards'],
            ];
            if (in_array($type['id'], [MtbCardtype::LAND_ID, MtbCardtype::CREATURE_ID], true)) {
                $leftSections[] = $item;
            } else {
                $rightSections[] = $item;
            }
        }

        return [
            'totalCount' => $totalCount,
            'leftSections' => $leftSections,
            'rightSections' => $rightSections,
        ];
    }

    /**
     * @param list<array{count: int, cardId: int, name: string, row: int}> $mainCards
     *
     * @return array{array<int, MtbCard>, array<string, MtbCard>}
     */
    private function loadCards(array $mainCards): array
    {
        $ids = $names = [];
        foreach ($mainCards as $parsed) {
            if ($parsed['cardId'] > 0) {
                $ids[$parsed['cardId']] = $parsed['cardId'];
            } else {
                $names[$parsed['name']] = $parsed['name'];
            }
        }

        $cardsById = $cardsByName = [];
        if ($ids === [] && $names === []) {
            return [$cardsById, $cardsByName];
        }

        $qb = $this->cardRepository->createQueryBuilder('c');
        $qb->leftJoin('c.Cardtypes', 'ct')->addSelect('ct');
        $conditions = [];
        if ($ids !== []) {
            $conditions[] = $qb->expr()->in('c.id', ':ids');
            $qb->setParameter('ids', array_values($ids));
        }
        if ($names !== []) {
            $conditions[] = $qb->expr()->in('c.name_jp', ':names');
            $conditions[] = $qb->expr()->in('c.name_en', ':names');
            $qb->setParameter('names', array_values($names));
        }
        $qb->where($qb->expr()->orX(...$conditions));

        foreach ($qb->getQuery()->getResult() as $card) {
            $cardsById[$card->getId()] = $card;
            if (($jp = $card->getNameJp()) !== null && $jp !== '') {
                $cardsByName[$jp] = $card;
            }
            if (($en = $card->getNameEn()) !== null && $en !== '') {
                $cardsByName[$en] = $card;
            }
        }

        return [$cardsById, $cardsByName];
    }

    /** @param list<int> $sortIds */
    private function resolveCardtypeId(?MtbCard $card, array $sortIds): int
    {
        if ($card === null) {
            return self::UNKNOWN_CARDTYPE_ID;
        }
        if ($card->isLand()) {
            return MtbCardtype::LAND_ID;
        }
        if ($card->isCreature()) {
            return MtbCardtype::CREATURE_ID;
        }
        foreach ($sortIds as $id) {
            if ($id === MtbCardtype::LAND_ID || $id === MtbCardtype::CREATURE_ID) {
                continue;
            }
            foreach ($card->getCardTypes() as $cardtype) {
                if ($cardtype->getId() === $id) {
                    return $id;
                }
            }
        }

        return self::UNKNOWN_CARDTYPE_ID;
    }

    /**
     * @param array{count: int, cardId: int, name: string, row: int} $parsed
     *
     * @return array{count: int, nameJp: string, nameEn: string}
     */
    private function toDisplayCard(array $parsed, ?MtbCard $card): array
    {
        if ($card === null) {
            return ['count' => $parsed['count'], 'nameJp' => $parsed['name'], 'nameEn' => ''];
        }

        $nameJp = trim((string) ($card->getNameJp() ?? ''));
        $nameEn = trim((string) ($card->getNameEn() ?? ''));
        if ($nameJp === '' && $nameEn === '') {
            $nameJp = $parsed['name'];
        }
        if ($nameJp === '') {
            $nameJp = $nameEn;
        }
        if ($nameEn === '') {
            $nameEn = $parsed['name'];
        }

        return ['count' => $parsed['count'], 'nameJp' => $nameJp, 'nameEn' => $nameEn];
    }

    private function resolvePlayerDisplayName(DtbDeck $deck): string
    {
        $customer = $deck->getPlayer()?->getCustomer();
        if ($customer !== null) {
            $kana = trim(trim((string) ($customer->getKana01() ?? '')).' '.trim((string) ($customer->getKana02() ?? '')));
            if ($kana !== '') {
                return $kana;
            }
        }

        $player = $deck->getPlayer();
        if ($player !== null) {
            $jpName = trim(trim((string) ($player->getLastNameJp() ?? '')).' '.trim((string) ($player->getFirstNameJp() ?? '')));
            if ($jpName !== '') {
                return $jpName;
            }
        }

        return trim((string) $deck->getPlayerName());
    }
}

    #[Route(path: '/%eccube_admin_route%/event/entry/bulk_update', name: 'admin_event_entry_bulk_update', methods: ['POST'])]
    public function bulkUpdateEntryStatus(Request $request): JsonResponse
    {
        $form = $this->formFactory->create(EventEntryBulkUpdateType::class);
        $form->handleRequest($request);

        if (!$form->isSubmitted() || !$form->isValid()) {
            $msg = trans('admin.common.error_invalid_request');
            foreach ($form->getErrors(true) as $error) {
                $msg = $error->getMessage();
                break;
            }

            return new JsonResponse(['message' => [$msg]], Response::HTTP_BAD_REQUEST);
        }

        $ids = array_values(array_unique(array_filter(array_map('intval', (array) ($request->request->all()['entries'] ?? [])))));
        if ($ids === []) {
            return new JsonResponse(['message' => [trans('admin.event.entry.bulk_update.nothing_selected')]], Response::HTTP_BAD_REQUEST);
        }

        /** @var MtbEntryStatus $entryStatus */
        $entryStatus = $form->get('entryStatus')->getData();

        try {
            $this->entryStatusBulkUpdateAction->handle(new EntryStatusBulkUpdateInput(
                entryIds: $ids,
                EntryStatus: $entryStatus,
                Member: $this->getMember(),
            ));
        } catch (\InvalidArgumentException $e) {
            return new JsonResponse(['message' => [$e->getMessage()]], Response::HTTP_BAD_REQUEST);
        }

        $event = new EventArgs(
            [
                'form' => $form,
            ],
            $request
        );
        $this->eventDispatcher->dispatch($event, EccubeEvents::ADMIN_EVENT_ENTRY_BULK_UPDATE_ENTRY_STATUS_COMPLETE);

        return new JsonResponse(['message' => [trans('admin.event.entry.bulk_update.success', ['%count%' => count($ids)])]]);
    }

    /**
     * イベント申込一覧: 検索条件に一致する申込を CSV 出力（一覧のソート・検索条件と同一）.
     */
    #[Route(path: '/%eccube_admin_route%/event/entry/csv', name: 'admin_event_entry_csv_export', methods: ['GET'])]
    public function exportCsv(Request $request, PaginatorInterface $paginator): StreamedResponse
    {
        set_time_limit(0);
        $this->entityManager->getConfiguration()->setSQLLogger();

        $defaultBaseInfo = $this->getMember()->getDefaultSearchBaseInfo();
        $searchForm = $this->formFactory
            ->createBuilder(SearchEntryType::class, null, [
                'base_info_default' => $defaultBaseInfo ? [$defaultBaseInfo] : [],
            ])
            ->getForm();

        $entrySortKeys = $this->entryRepository->getEntryListSortKeys();
        $viewData = $this->session->get(self::SESSION_KEY, []);
        $isDeckCsv = ($viewData['searchMode'] ?? 'event_entry') === 'deck_registration';
        $activeSortKeys = $isDeckCsv ? $this->deckRepository->getEntryDeckSearchSortKeys() : $entrySortKeys;
        $defaultSortKeyCsv = $isDeckCsv ? DtbDeckRepository::DEFAULT_ENTRY_DECK_SEARCH_SORT_KEY : self::ENTRY_LIST_DEFAULT_SORT_KEY;
        $sortKey = (string) $this->session->get(self::SESSION_KEY.'.sort', $defaultSortKeyCsv);
        $sortKey = isset($activeSortKeys[$sortKey]) ? $sortKey : $defaultSortKeyCsv;
        $order = strtoupper((string) $this->session->get(self::SESSION_KEY.'.order', 'DESC'));
        $order = $order === 'ASC' ? 'ASC' : 'DESC';

        $searchData = FormUtil::submitAndGetData($searchForm, $viewData);
        $searchData['sort'] = $sortKey;
        $searchData['order'] = $order;

        if (($searchData['searchMode'] ?? 'event_entry') === 'deck_registration') {
            $qb = $this->deckRepository->getEntryDeckData($searchData);
        } else {
            $qb = $this->entryRepository->getQueryBuilderByEntrySearchData($searchData);
        }

        $event = new EventArgs(
            [
                'qb' => $qb,
                'searchData' => $searchData,
            ],
            $request
        );
        $this->eventDispatcher->dispatch($event, EccubeEvents::ADMIN_EVENT_ENTRY_CSV_EXPORT);

        return $this->eventEntryCsvExportService->exportByQueryBuilder($qb, $paginator);
    }

    /**
     * イベント申込一覧: イベント情報検索モーダル用
     */
    #[Route(path: '/%eccube_admin_route%/event/entry/search_event', name: 'admin_entry_event_html', methods: ['GET'])]
    #[Route(path: '/%eccube_admin_route%/event/entry/search_event/page/{page_no}', name: 'admin_entry_event_html_page', requirements: ['page_no' => '\d+'], methods: ['GET'])]
    public function entryEventHtml(Request $request, PaginatorInterface $paginator, ?int $page_no = null): Response
    {
        $modalPayload = $request->query->all()['admin_entry_event_modal'] ?? [];
        if (!is_array($modalPayload)) {
            $modalPayload = [];
        }
        $defaultBaseInfo = $this->getMember()->getDefaultSearchBaseInfo();
        $form = $this->formFactory->create(SearchEntryEventModalType::class, null, [
            'base_info_default' => $defaultBaseInfo ? [$defaultBaseInfo] : [],
        ]);

        $event = new EventArgs(
            [
                'form' => $form,
            ],
            $request
        );
        $this->eventDispatcher->dispatch($event, EccubeEvents::ADMIN_EVENT_ENTRY_ENTRY_EVENT_HTML_INITIALIZE);

        $form->submit($modalPayload, false);

        if (!$form->isValid()) {
            return $this->render('@admin/Event/Entry/search_event_modal_list.twig', [
                'datas' => [],
                'pagination' => null,
                'eventModalForm' => $form,
                'modal' => true,
            ]);
        }

        $pageNo = $page_no ?? max(1, (int) $request->query->get('page_no', 1));
        $editableBaseInfoIds = [];
        foreach ($this->getMember()->getMemberBaseInfos() as $mbi) {
            $editableBaseInfoIds[] = $mbi->getBaseInfo()->getId();
        }

        $modalData = $form->getData();
        $selectedBase = $modalData['base_info'] ?? null;
        $rawBases = $selectedBase instanceof BaseInfo ? [$selectedBase] : [];
        $editableBaseInfoSet = array_flip($editableBaseInfoIds);
        $allowedBases = array_filter(
            $rawBases,
            static fn (BaseInfo $b): bool => isset($editableBaseInfoSet[$b->getId()]),
        );

        $events = [];
        if ($rawBases === [] || $allowedBases !== []) {
            $qb = $this->eventRepository->getQueryBuilderByEntryRegistrationSearchData([
                'multi' => $modalData['event_name'] ?? null,
                'start_date_from' => $modalData['start_date_from'] ?? null,
                'start_date_to' => $modalData['start_date_to'] ?? null,
                'base_info' => $allowedBases,
            ]);
            if ($allowedBases === []) {
                $qb->andWhere('IDENTITY(e.BaseInfo) IN (:entryModalEditableBaseInfoIds)')
                    ->setParameter('entryModalEditableBaseInfoIds', $editableBaseInfoIds);
            }
            $events = $qb->getQuery()->getResult();
        }

        [$pagination, $datas] = $this->entryRegistrationScheduleRowBuilder->paginateWithRowSpanByEvent(
            $paginator,
            $this->entryRegistrationScheduleRowBuilder->expandScheduleRows(
                $events,
                !empty($modalData['start_date_from']) ? $modalData['start_date_from'] : null,
                !empty($modalData['start_date_to']) ? $modalData['start_date_to'] : null,
            ),
            $pageNo,
            self::MODAL_EVENT_SEARCH_PER_PAGE,
        );

        return $this->render('@admin/Event/Entry/search_event_modal_list.twig', [
            'datas' => $datas,
            'pagination' => $pagination,
            'eventModalForm' => null,
            'modal' => true,
        ]);
    }

    /**
     * イベント申込一覧モーダル「決定」: サーバーでイベントを解決し JSON でフォーム用データを返す
     */
    #[Route(path: '/%eccube_admin_route%/event/entry/search_event/set', name: 'admin_entry_search_event_by_id', methods: ['POST'])]
    public function searchEventByIdForEntryList(Request $request): JsonResponse
    {
        $token = new CsrfToken(Constant::TOKEN_NAME, (string) $request->request->get(Constant::TOKEN_NAME));
        if (!$this->csrfTokenManager->isTokenValid($token)) {
            return new JsonResponse(['message' => trans('admin.common.csrf_invalid')], Response::HTTP_FORBIDDEN);
        }

        $member = $this->getMember();
        $eventId = (int) $request->request->get('id');
        $detailRaw = $request->request->get('detail');
        $detailId = $detailRaw !== null && $detailRaw !== '' ? (int) $detailRaw : null;

        $event = $this->eventRepository->find($eventId);
        $baseInfo = $event?->getBaseInfo();
        if ($event === null || $baseInfo === null || !$member->isEditableShop($baseInfo)) {
            return new JsonResponse(['message' => 'not found'], Response::HTTP_NOT_FOUND);
        }

        $detail = null;
        if ($detailId !== null && $detailId > 0) {
            $detail = $this->eventDetailRepository->find($detailId);
            if ($detail === null || $detail->getEvent()->getId() !== $event->getId()) {
                return new JsonResponse(['message' => 'bad request'], Response::HTTP_BAD_REQUEST);
            }
        }

        $from = '';
        $to = '';
        if ($detail !== null) {
            $range = $this->entryEventSearchModalRowBuilder->buildSearchDateRangeForDetail($detail);
            $from = $range[0]->format('Y-m-d');
            $to = $range[1]->format('Y-m-d');
        }

        $eventArgs = new EventArgs(
            [
                'Event' => $event,
            ],
            $request
        );
        $this->eventDispatcher->dispatch($eventArgs, EccubeEvents::ADMIN_EVENT_ENTRY_EVENT_BY_ID_FOR_ENTRY_LIST_SEARCH);

        return new JsonResponse([
            'name' => $event->getNameJp(),
            'nameEn' => $event->getNameEn() ?? '',
            'from' => $from,
            'to' => $to,
            'baseInfo' => (string) $baseInfo->getId(),
        ]);
    }

