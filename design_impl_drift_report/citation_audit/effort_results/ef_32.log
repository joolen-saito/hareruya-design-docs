                    <a href="#" class="search-clear">{{ 'admin.deck.search_clear'|trans }}</a>
                </div>
                <button type="submit" class="btn btn-ec-conversion px-5">{{ 'admin.deck.search'|trans }}</button>
            </div>
        </div>

        {# ソート用 #}
        {{ form_widget(searchForm.sortKey) }}
        {{ form_widget(searchForm.sortOrder) }}
    </div>

    {{ form_end(searchForm) }}

    {# 検索結果 #}
    {% if pagination %}
        <div class="mt-3 mb-2">
            <span class="fw-bold">{{ 'admin.common.search_result'|trans({ '%count%': pagination.totalItemCount }) }}</span>
        </div>
        <hr class="mt-0 mb-2">
        <form id="bulk_form" method="post" action="{{ url('admin_deck_bulk_delete') }}">
        <input type="hidden" name="_token" id="bulk_form_token" value="{{ csrf_token('admin_deck_bulk_delete') }}">
        <input type="hidden" id="bulk_delete_token_value" value="{{ csrf_token('admin_deck_bulk_delete') }}">
        <input type="hidden" id="bulk_update_token_value" value="{{ csrf_token('admin_deck_bulk_update') }}">
        <input type="hidden" id="csv_export_token_value" value="{{ csrf_token('admin_deck_csv_export') }}">
        <div class="row justify-content-between align-items-center mb-2">
            <div class="col-auto d-flex align-items-center gap-2">
                <button type="submit" id="csv_export" class="btn btn-ec-conversion" formaction="{{ url('admin_deck_csv_export') }}">{{ 'admin.deck.csv_export'|trans }}</button>
                <button type="submit" id="bulk_delete" class="btn btn-ec-conversion" onclick="return confirm('{{ 'admin.deck.bulk_delete_confirm'|trans|e('js') }}');">{{ 'admin.deck.bulk_delete'|trans }}</button>
                <button type="button" class="btn btn-ec-conversion" id="toggle_bulk_edit">{{ 'admin.deck.bulk_edit'|trans }}</button>
            </div>
            <div class="col-auto d-flex align-items-center gap-2">
                <select id="page_count_pulldown" class="form-select w-auto">
                    {% for pageMax in pageMaxis %}
                        <option {% if pageMax.name == page_count %} selected {% endif %}
                            value="{{ path('admin_deck_search', {'page_no': 1, 'page_count': pageMax.name }) }}">
                            {{ 'admin.common.count'|trans({ '%count%': pageMax.name }) }}
                        </option>
                    {% endfor %}
                </select>
                <span>{{ 'admin.deck.sort_label'|trans }}：</span>
                <select id="sort_key_pulldown" class="form-select w-auto">
                    {% for sortKeyOption in sortKeys|keys %}
                        <option {% if sortKeyOption == sortKey %} selected {% endif %} value="{{ sortKeyOption }}">
                            {{ ('admin.deck.sort.' ~ sortKeyOption)|trans }}
                        </option>
                    {% endfor %}
                </select>
                <select id="sort_order_pulldown" class="form-select w-auto">
                    <option value="ASC" {% if sortOrder == 'ASC' %} selected {% endif %}>{{ 'admin.common.sort_asc'|trans }}</option>
                    <option value="DESC" {% if sortOrder == 'DESC' %} selected {% endif %}>{{ 'admin.common.sort_desc'|trans }}</option>
                </select>
            </div>
        </div>

        {# 一括編集アコーディオン #}
        <div id="bulk_edit_panel" style="display: none;" class="card mb-3 p-3">
            <div class="row">
                <div class="col-4 mb-2">
                    <label><input type="checkbox" class="toggle_bulk_update_check" name="change_flgs[format]"> {{ 'admin.deck.format'|trans }}</label>
                    <div class="bulk_update_form" style="display: none;">
                        {{ form_widget(bulkUpdateForm.format) }}
                    </div>
                </div>
                <div class="col-4 mb-2">
                    <label><input type="checkbox" class="toggle_bulk_update_check" name="change_flgs[archetype]"> {{ 'admin.deck.archetype'|trans }}</label>
                    <div class="bulk_update_form" style="display: none;">
                        {{ form_widget(bulkUpdateForm.archetype) }}
                    </div>
                </div>
            </div>
            <div class="row">
                <div class="col-4 mb-2">
                    <label><input type="checkbox" class="toggle_bulk_update_check" name="change_flgs[disp]"> {{ 'admin.deck.disp'|trans }}</label>
                    <div class="bulk_update_form" style="display: none;">
                        {{ form_widget(bulkUpdateForm.disp) }}
                    </div>
                </div>
                <div class="col-4 mb-2">
                    <label><input type="checkbox" class="toggle_bulk_update_check" name="change_flgs[privateFlg]"> {{ 'admin.deck.private_flg'|trans }}</label>
                    <div class="bulk_update_form" style="display: none;">
                        {{ form_widget(bulkUpdateForm.privateFlg) }}
                    </div>
                </div>
            </div>
            <div class="row">
                <div class="col-4 mb-2">
                    <label><input type="checkbox" class="toggle_bulk_update_check" name="change_flgs[eventNameJp]"> {{ 'admin.deck.event_name_jp'|trans }}</label>
                    <div class="bulk_update_form" style="display: none;">
                        {{ form_widget(bulkUpdateForm.eventNameJp) }}
                    </div>
                </div>
                <div class="col-4 mb-2">
                    <label><input type="checkbox" class="toggle_bulk_update_check" name="change_flgs[eventNameEn]"> {{ 'admin.deck.event_name_en'|trans }}</label>
                    <div class="bulk_update_form" style="display: none;">
                        {{ form_widget(bulkUpdateForm.eventNameEn) }}
                    </div>
                </div>
                <div class="col-4 mb-2">
                    <label><input type="checkbox" class="toggle_bulk_update_check" name="change_flgs[eventDate]"> {{ 'admin.deck.event_date'|trans }}</label>
                    <div class="bulk_update_form" style="display: none;">
                        {{ form_widget(bulkUpdateForm.eventDate) }}
                    </div>
                </div>
            </div>
            <div class="row">
                <div class="col-2 mb-2">
                    <label><input type="checkbox" class="toggle_bulk_update_check" name="change_flgs[ranking]"> {{ 'admin.deck.ranking'|trans }}</label>
                    <div class="bulk_update_form" style="display: none;">
                        {{ form_widget(bulkUpdateForm.ranking) }}
                    </div>
                </div>
                <div class="col-2 mb-2">
                    <label><input type="checkbox" class="toggle_bulk_update_check" name="change_flgs[result]"> {{ 'admin.deck.result'|trans }}</label>
                    <div class="bulk_update_form" style="display: none;">
                        {{ form_widget(bulkUpdateForm.result) }}
                    </div>
                </div>
            </div>
            <div class="row">
                <div class="col-2 mb-2">
                    <label><input type="checkbox" class="toggle_bulk_update_check" name="change_flgs[playerName]"> {{ 'admin.deck.player_name'|trans }}</label>
                    <div class="bulk_update_form" style="display: none;">
                        {{ form_widget(bulkUpdateForm.playerName) }}
                    </div>
                </div>
                <div class="col-2 mb-2">
                    <label><input type="checkbox" class="toggle_bulk_update_check" name="change_flgs[deckTags]"> {{ 'admin.deck.deck_tag'|trans }}</label>
                    <div class="bulk_update_form" style="display: none;">
                        {{ form_widget(bulkUpdateForm.deckTags) }}
                    </div>
                </div>
                <div class="col-2 mb-2">
                    <label><input type="checkbox" class="toggle_bulk_update_check" name="change_flgs[sourceUrl]"> {{ 'admin.deck.source_url'|trans }}</label>
                    <div class="bulk_update_form" style="display: none;">
                        {{ form_widget(bulkUpdateForm.sourceUrl) }}
                    </div>
                </div>
            </div>
            <div>
                <button type="submit" class="btn btn-ec-conversion" formaction="{{ url('admin_deck_bulk_update') }}">{{ 'admin.deck.bulk_edit_execute'|trans }}</button>
            </div>
        </div>

        {% if pagination.totalItemCount %}
            <table class="table table-striped deck-result-table">
                <thead>
                    <tr>
                        <th class="text-center" style="width: 40px;">
                            <input type="checkbox" id="allCheck">
                        </th>
                        <th>{{ 'admin.deck.deck_detail'|trans }}</th>
                        <th style="width: 40px;"></th>
                    </tr>
                </thead>
                <tbody>
                    {% for Deck in pagination %}
                        <tr>
                            <td class="align-middle text-center">
                                <input type="checkbox" name="deckId[]" class="searched_deck_id" value="{{ Deck.id }}">
                            </td>
                            <td>
                                <a href="{{ url('admin_deck_edit', {id: Deck.id}) }}" class="text-decoration-none text-body">
                                    <div class="row">
                                        <div class="col-4">
                                            <div class="row mb-1">
                                                <div class="col-6 text-muted">{{ 'admin.deck.archetype'|trans }}</div>
                                                <div class="col-6">{{ Deck.Archetype ? Deck.Archetype.nameJp : '-' }}</div>
                                            </div>
                                        </div>
                                        <div class="col-4">
                                            <div class="row mb-1">
                                                <div class="col-6 text-muted">{{ 'admin.deck.event_name'|trans }}</div>
                                                <div class="col-6">{{ Deck.eventNameJp ?: '-' }} {{ Deck.eventNameEn ?: '' }}</div>
                                            </div>
                                        </div>
                                        <div class="col-4"></div>
                                        <div class="col-4">
                                            <div class="row mb-1">
                                                <div class="col-6 text-muted">{{ 'admin.deck.player_name'|trans }}</div>
                                                <div class="col-6">{{ Deck.playerName ?: '-' }}</div>
                                            </div>
                                        </div>
                                        <div class="col-4">
                                            <div class="row mb-1">
                                                <div class="col-6 text-muted">{{ 'admin.deck.deck_name'|trans }}</div>
                                                <div class="col-6">{{ Deck.deckName ?: '-' }}</div>
                                            </div>
                                        </div>
                                        <div class="col-4"></div>
                                        <div class="col-4">
                                            <div class="row mb-1">
                                                <div class="col-6 text-muted">{{ 'admin.deck.result'|trans }}</div>
                                                <div class="col-6">
                                                    {% if Deck.ranking %}{{ 'admin.deck.ranking_with_unit'|trans({ '%ranking%': Deck.ranking }) }}{% endif %}
                                                    {{ Deck.result ?: '-' }}
                                                </div>
                                            </div>
                                        </div>
                                        <div class="col-4">
                                            <div class="row mb-1">
                                                <div class="col-6 text-muted">{{ 'admin.deck.participants'|trans }}</div>
                                                <div class="col-6">{{ Deck.participants ? 'admin.deck.participants_with_unit'|trans({ '%count%': Deck.participants }) : '-' }}</div>
                                            </div>
                                        </div>
                                        <div class="col-4">
                                            <div class="row mb-1">
                                                <div class="col-6 text-muted">{{ 'admin.deck.event_date'|trans }}</div>
                                                <div class="col-6">{{ Deck.eventDate ? Deck.eventDate|date('Y/m/d') : '----/--/--' }}</div>
                                            </div>
                                        </div>
                                    </div>
                                </a>
                            </td>
                            <td class="align-middle text-center deck-action-cell">
                                <div class="dropdown">
                                    <i class="dropdown-menu-toggle fa-solid fa-ellipsis text-secondary" data-bs-toggle="dropdown" data-bs-display="static" style="cursor: pointer;"></i>
                                    <ul class="dropdown-menu dropdown-menu-end py-1" style="min-width: auto;">
                                        <li><a class="dropdown-item px-3 py-1" href="{{ url('admin_deck_edit', {id: Deck.id}) }}">{{ 'admin.common.edit'|trans }}</a></li>
                                        <li>
                                            <form method="post" action="{{ url('admin_deck_delete', {id: Deck.id}) }}" style="display: inline;">
                                                <input type="hidden" name="_token" value="{{ csrf_token('admin_deck_delete') }}">
                                                <button type="submit" class="dropdown-item px-3 py-1" onclick="return confirm('{{ 'admin.deck.delete_confirm'|trans|e('js') }}');">{{ 'admin.common.delete'|trans }}</button>
                                            </form>
                                        </li>
                                    </ul>
                                </div>
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>

            {% include "@admin/pager.twig" with { 'pages': pagination.paginationData, 'routes': 'admin_deck_search' } %}
        {% else %}
            <div class="card rounded border-0">
                <div class="card-body p-4 text-center">
                    <div class="text-muted mb-4 h5">{{ 'admin.common.search_no_result'|trans }}</div>
                </div>
            </div>
        {% endif %}
        </form>
    {% endif %}
</div>
