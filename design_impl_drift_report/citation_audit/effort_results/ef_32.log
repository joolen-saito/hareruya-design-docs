namespace Eccube\Controller\Block;

use Eccube\Controller\AbstractController;
use Eccube\Repository\BaseInfoRepository;
use Eccube\Repository\Master\MtbFormatRepository;
use Eccube\Service\BlockTemplateExistCheckService;
use Eccube\Service\Front\Event\EventSearchInput;
use Symfony\Component\HttpFoundation\Request;
use Symfony\Component\HttpFoundation\RequestStack;
use Symfony\Component\HttpFoundation\Response;
use Symfony\Component\Routing\Attribute\Route;

/**
 * イベント検索モーダル
 */
class EventDetailedSearchModalController extends AbstractController
{
    public function __construct(
        private readonly RequestStack $requestStack,
        private readonly BlockTemplateExistCheckService $blockTemplateExistCheckService,
        private readonly MtbFormatRepository $formatRepository,
        private readonly BaseInfoRepository $baseInfoRepository,
    ) {
    }

    #[Route(path: '/block/event_detailed_search_modal', name: 'block_event_detailed_search_modal', methods: ['GET'])]
    public function index(Request $request): Response
    {
        if (!$this->blockTemplateExistCheckService->checkFileExist($request)) {
            return $this->render('Block/null.twig');
        }

        $mainRequest = $this->requestStack->getMainRequest() ?? $this->requestStack->getCurrentRequest();
        $input = EventSearchInput::fromQuery($mainRequest?->query->all() ?? []);

        return $this->render('Block/event_detailed_search_modal.twig', [
            'input' => $input,
            'Formats' => $this->formatRepository->getFormatsAssignedToEvents(),
            'OpenShops' => $this->baseInfoRepository->getOpenShops(),
        ]);
    }
}
