    public function delete(Request $request, MtbCardset $Cardset): RedirectResponse
    {
        $this->isTokenValid();

        log_info('カードセット削除開始', [$Cardset->getId()]);

        if ($symbolImage = $Cardset->getSymbolImage()) {
            // シンボル画像ファイルを削除
            $fileAdapter = $this->fileManager->getAdapter();

            if ($fileAdapter->exists($symbolImage, [])) {
                $fileAdapter->delete($symbolImage, []);
            }
        }

        try {
            $this->cardsetRepository->delete($Cardset);
            $this->entityManager->flush();

            $this->addSuccess('admin.common.delete_complete', 'admin');
            log_info('カードセット削除完了', [$Cardset->getId()]);
        } catch (\Doctrine\DBAL\Exception\ForeignKeyConstraintViolationException $e) {
            log_error('カードセット削除エラー（外部キー制約）', [$Cardset->getId(), $e]);

            $message = trans('admin.card.cardset.error.delete_has_cards', ['%name%' => $Cardset->getNameJp()]);
            $this->addError($message, 'admin');
        } catch (\Exception $e) {
            log_error('カードセット削除エラー', [$Cardset->getId(), $e]);

            $this->addError(trans('admin.common.delete_error'), 'admin');
        }

        $event = new EventArgs(
            [
                'Cardset' => $Cardset,
            ],
            $request
        );
        $this->eventDispatcher->dispatch($event, EccubeEvents::ADMIN_CARD_CARDSET_DELETE_COMPLETE);

        return $this->redirectToRoute('admin_cardset_list');
    }

