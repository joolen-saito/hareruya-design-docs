namespace Eccube\Service\Admin\Cardset;

use Eccube\Entity\Master\MtbCardDetail;
use Eccube\Repository\Master\MtbCardDetailRepository;
use Eccube\Repository\Master\MtbCardImageRepository;
use Eccube\Service\S3AccessService;
use Symfony\Component\Filesystem\Filesystem;

/**
 * 管理画面：カードセット単位のカード画像 ZIP を組み立てる。
 */
class CardsetDownloadAction
{
    private const DOWNLOAD_DIR = 'var/tmp/download/card_image';

    /** ZIP 内の最上位ディレクトリ */
    private const ZIP_ROOT_DIR = 'download';

    public function __construct(
        private readonly MtbCardDetailRepository $cardDetailRepository,
        private readonly MtbCardImageRepository $cardImageRepository,
        private readonly S3AccessService $s3AccessService,
        private readonly Filesystem $filesystem,
        private readonly string $kernelProjectDir,
    ) {
    }

    /**
     * 指定カードセット（またはカードセット未設定のプロモ相当）に紐づく画像を ZIP にまとめ、ファイルパスを返す。
     *
     * 作業ディレクトリは `kernel.project_dir/var/tmp/download/card_image` に固定する。呼び出しのたびに当該ディレクトリを
     * 削除してから再作成する（旧システムの仕様を踏襲）。
     * 同一パスを複数リクエストが並行して使うと競合するため、当機能の同時実行は運用上避ける前提とする。
     * 異常終了時は当該ディレクトリに残骸が残り得るが、次回成功パスの開始時に除去される。
     *
     * $ids が空のときはカードセット未設定のカード詳細のみを対象とする。
     * カード画像は mtb_card_image.language_id 昇順で取得し、$eachLang が false のときは S3 取得に成功した先頭 1 枚のみ ZIP に含める。
     * ZIP 内のパスは `download/{中間フォルダ}/{ファイル名}`。
     * セット別は中間フォルダがセット code またはプロモの name_en（カードセット未設定時）。
     * 言語別は中間フォルダは言語 code のみ（プロモ名・セット略称のフォルダは付けない）。ファイル名は `{F}{カード詳細ID}.jpg`（フォイル時のみ先頭に F）。
     *
     * @param array<int|string> $ids カードセット ID のリスト
     * @param bool $eachLang true のとき言語コードごとのフォルダに全言語分を試行する
     *
     * @return string 生成された ZIP の絶対パス
     *
     * @throws \RuntimeException 追加画像が 0 件、ZIP の生成に失敗した場合、またはフォルダ名にパス区切り等が含まれる場合
     */
    public function execute(array $ids, bool $eachLang = false): string
    {
        set_time_limit(0);

        $this->s3AccessService->setS3Directory('set/');

        $workRoot = $this->kernelProjectDir.'/'.self::DOWNLOAD_DIR;
        if ($this->filesystem->exists($workRoot)) {
            $this->filesystem->remove($workRoot);
        }
        $this->filesystem->mkdir($workRoot, 0777);

        $zipPath = $workRoot.'/card_image.zip';
        $zip = new \ZipArchive();
        if ($zip->open($zipPath, \ZipArchive::CREATE | \ZipArchive::OVERWRITE) !== true) {
            throw new \RuntimeException('admin.card.cardset.error.download_zip_failed');
        }

        $addedCount = 0;

        if ($ids === []) {
            $idList = [null];
        } else {
            $idList = array_values(array_unique(array_filter(
                array_map(
                    static fn (int|string $id): int => filter_var($id, FILTER_VALIDATE_INT) !== false ? (int) $id : 0,
                    $ids
                ),
                static fn (int $id): bool => $id > 0
            )));
        }

        foreach ($idList as $cardsetId) {
            $cardDetails = $this->cardDetailRepository->findWithImagesAndPromotionForDownload($cardsetId);
            if ($cardDetails === []) {
                continue;
            }

            $cardDetailIds = array_map(
                static fn (MtbCardDetail $cd): int => $cd->getId(),
                $cardDetails
            );
            $cardImagesByDetailId = [];
            foreach ($this->cardImageRepository->findByCardDetailIdsForDownloadOrderedByLanguage($cardDetailIds) as $cardImage) {
                $detail = $cardImage->getCardDetail();
                if ($detail === null) {
                    continue;
                }
                $cardImagesByDetailId[$detail->getId()][] = $cardImage;
            }

            foreach ($cardDetails as $cardDetail) {
                $cardImages = $cardImagesByDetailId[$cardDetail->getId()] ?? [];

                foreach ($cardImages as $cardImage) {
                    $language = $cardImage->getLanguage();
                    if ($language === null) {
                        continue;
                    }

                    // 言語別: ZIP は download/{言語コード}/{F}{カード詳細ID}.jpg のみ（プロモ名フォルダは付けない）
                    // セット別: download/{セット略称|プロモ英名}/{先頭1枚の画像ファイル名}
                    if ($eachLang) {
                        $zipMiddleDir = $this->requireSafePathSegment($language->getCode());
                    } elseif ($cardDetail->getCardset() !== null) {
                        $code = $cardDetail->getCardset()->getCode();
                        $zipMiddleDir = $this->requireSafePathSegment($code ?? '');
                    } else {
                        $zipMiddleDir = $this->requireSafePathSegment($cardDetail->getPromotion()->getNameEn());
                    }

                    $dirName = $workRoot.'/'.$zipMiddleDir;
                    if (!$this->filesystem->exists($dirName)) {
                        $this->filesystem->mkdir($dirName, 0777);
                    }

                    $fileName = $this->s3AccessService->downloadCardImageToDirectory(
                        $dirName,
                        $cardImage,
                        $cardDetail->getFoilFlg()
                    );

                    if ($fileName) {
                        $fileName = $this->requireSafeZipEntryFileName($fileName);
                    }

                    if ($fileName && $this->filesystem->exists($dirName.'/'.$fileName)) {
                        $localPath = $dirName.'/'.$fileName;
                        $entryName = self::ZIP_ROOT_DIR.'/'.$zipMiddleDir.'/'.$fileName;
                        if ($zip->addFile($localPath, $entryName)) {
                            ++$addedCount;
                        }

                        // 言語別でない場合は1枚見つかったら次のカードへ（日本語優先）
                        if (!$eachLang) {
                            break;
                        }
                    }
                }
            }
        }

        $closed = $zip->close();

        if ($addedCount === 0) {
            if ($this->filesystem->exists($zipPath)) {
                $this->filesystem->remove($zipPath);
            }

            throw new \RuntimeException('admin.card.cardset.error.download_no_images');
        }

        if (!$closed || !$this->filesystem->exists($zipPath)) {
            throw new \RuntimeException('admin.card.cardset.error.download_zip_failed');
        }

        return $zipPath;
    }

    /**
     * 作業ディレクトリ直下の1段のフォルダ名として安全な文字列か検証する。
     * `/`・`\`・NUL、および trim 後が空・`.`・`..` の値は拒否する（パストラバーサル防止）。
     *
     * @throws \RuntimeException 上記に該当する場合（メッセージキー admin.card.cardset.error.download_unsafe_path_segment）
     */
    private function requireSafePathSegment(string $raw): string
    {
        if (str_contains($raw, "\0")) {
            throw new \RuntimeException('admin.card.cardset.error.download_unsafe_path_segment');
        }
        $segment = trim($raw);
        if ($segment === '' || $segment === '.' || $segment === '..') {
            throw new \RuntimeException('admin.card.cardset.error.download_unsafe_path_segment');
        }
        if (strpbrk($segment, '/\\') !== false) {
            throw new \RuntimeException('admin.card.cardset.error.download_unsafe_path_segment');
        }

        return $segment;
    }

    /**
     * ZIP エントリ内のファイル名成分として安全か検証する（Zip slip 防止）。
     *
     * @throws \RuntimeException ディレクトリ成分を含む場合など
     */
    private function requireSafeZipEntryFileName(string $name): string
    {
        if (str_contains($name, "\0") || strpbrk($name, '/\\') !== false) {
            throw new \RuntimeException('admin.card.cardset.error.download_unsafe_path_segment');
        }
        if ($name === '' || $name === '.' || $name === '..') {
            throw new \RuntimeException('admin.card.cardset.error.download_unsafe_path_segment');
        }
        if (basename($name) !== $name) {
            throw new \RuntimeException('admin.card.cardset.error.download_unsafe_path_segment');
        }
        return $this->redirectToRoute('admin_cardset_list');
    }

    /**
     * カード画像 ZIP（セット別：カード詳細あたり language_id 昇順で最初の 1 枚）をダウンロードする。
     *
     * POST の cardsetIds が空のときはカードセット未設定（プロモ相当）のみを対象とする。
     */
    #[Route('/%eccube_admin_route%/cardset/download', name: 'admin_cardset_download', methods: ['POST'])]
    public function download(Request $request, CardsetDownloadAction $downloadAction): Response
    {
        $ids = $this->getCardsetIdsFromRequest($request);

        try {
            $zipPath = $downloadAction->execute($ids, false);

            $event = new EventArgs([], $request);
            $this->eventDispatcher->dispatch($event, EccubeEvents::ADMIN_CARD_CARDSET_EXPORT);

            return $this->createZipResponse($zipPath);
        } catch (\Exception $e) {
            $this->addError(trans($e->getMessage()), 'admin');

            return $this->redirectToRoute('admin_cardset_list');
        }
    }

    /**
     * カード画像 ZIP（言語別フォルダに全言語分）をダウンロードする。
     */
    #[Route('/%eccube_admin_route%/cardset/download_each_lang', name: 'admin_cardset_download_each_lang', methods: ['POST'])]
    public function downloadEachLang(Request $request, CardsetDownloadAction $downloadAction): Response
    {
        $ids = $this->getCardsetIdsFromRequest($request);

        try {
            $zipPath = $downloadAction->execute($ids, true);

            $event = new EventArgs([], $request);
            $this->eventDispatcher->dispatch($event, EccubeEvents::ADMIN_CARD_CARDSET_DOWNLOAD_EACH_LANG_EXPORT);

            return $this->createZipResponse($zipPath);
        } catch (\Exception $e) {
            $this->addError(trans($e->getMessage()), 'admin');

            return $this->redirectToRoute('admin_cardset_list');
        }
    }

    /**
     * 一時 ZIP を添付したレスポンスを返す。送信完了後に ZIP ファイルのみ削除する（Symfony の deleteFileAfterSend）。
     * 作業ディレクトリ内の展開画像などは、次回 CardsetDownloadAction::execute 開始時にまとめてクリアされる。
     */
    private function createZipResponse(string $filePath): BinaryFileResponse
    {
        $response = new BinaryFileResponse($filePath);
        $response->setContentDisposition(
            ResponseHeaderBag::DISPOSITION_ATTACHMENT,
            'card_image.zip'
        );
        $response->deleteFileAfterSend(true);

        return $response;
    }

    /**
     * POST の cardsetIds を配列で返す。キーが無いときは空配列（execute 側でプロモ向けに解釈される）。
     *
     * @return list<int|string>
     */
    private function getCardsetIdsFromRequest(Request $request): array
    {
        $parameters = $request->request->all();
        if (!\array_key_exists('cardsetIds', $parameters)) {
            return [];
        }
