class CardsetController extends AbstractController
{
    public function __construct(
        private readonly MtbCardsetRepository $cardsetRepository,
        private readonly MtbCardRepository $cardRepository,
        private readonly FileManager $fileManager,
        protected PageMaxRepository $pageMaxRepository,
    ) {
    }

    /**
     * @return array<string, mixed>
     */
    #[Route('/%eccube_admin_route%/cardset', name: 'admin_cardset_list')]
    #[Route('/%eccube_admin_route%/cardset/page/{page_no}', name: 'admin_cardset_list_paged', requirements: ['page_no' => '\d+'])]
    #[Template('@admin/Cardset/index.twig')]
    public function index(Request $request, \Knp\Component\Pager\PaginatorInterface $paginator, int $page_no = 1): array
    {
        // sort の処理
        $sortKeySessionKey = 'eccube.admin.cardset.sort';
        $sortKey = match (true) {
            !empty($request->query->getString('sort_key')) => $request->query->getString('sort_key'),
            ($this->session->get($sortKeySessionKey) !== null) => $this->session->get($sortKeySessionKey),
            default => MtbCardsetRepository::DEFAULT_SORT_KEY,
        };
        $this->session->set($sortKeySessionKey, $sortKey);

        // order の処理
        $sortOrderSessionKey = 'eccube.admin.cardset.order';
        $sortOrder = match (true) {
            !empty($request->query->getString('sort_order')) => $request->query->getString('sort_order'),
            ($this->session->get($sortOrderSessionKey) !== null) => $this->session->get($sortOrderSessionKey),
            default => MtbCardsetRepository::DEFAULT_SORT_ORDER,
        };
        $this->session->set($sortOrderSessionKey, $sortOrder);

        $qb = $this->cardsetRepository->getQueryBuilder([
            'sortKey' => $sortKey,
            'sortOrder' => $sortOrder,
        ]);

        $event = new EventArgs(
            [
                'qb' => $qb,
            ],
            $request
        );
        $this->eventDispatcher->dispatch($event, EccubeEvents::ADMIN_CARD_CARDSET_INDEX_INITIALIZE);

        $pageCountSessionKey = 'eccube.admin.cardset.search.page_count';
        $pageCount = $this->session->get($pageCountSessionKey,
            $this->eccubeConfig->get('eccube_default_page_count'));

        $pageCountParam = $request->query->getInt('page_count');
        $PageMaxis = $this->pageMaxRepository->findAll();
        if ($pageCountParam) {
            foreach ($PageMaxis as $PageMax) {
                $pageMaxNum = (int) $PageMax->getName();
                if ($pageCountParam === $pageMaxNum) {
                    $pageCount = $pageMaxNum;
                    $this->session->set($pageCountSessionKey, $pageCount);
                    break;
                }
            }
        }
        $pagination = $paginator->paginate(
            $qb,
            $page_no,
            $pageCount
        );

        $this->session->set('eccube.admin.cardset.page_no', $page_no);

        return [
            'pagination' => $pagination,
            'pageMaxis' => $PageMaxis,
            'pageCount' => $pageCount,
            'sortKeys' => $this->cardsetRepository->getSortKeys(),
            'sortKey' => $sortKey,
            'sortOrder' => $sortOrder,
        ];
    }

    /**
     * カードセット新規登録画面.
     *
     * @return RedirectResponse|array<string, mixed>
     */
