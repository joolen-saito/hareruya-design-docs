<div class="p-hareruya-search-modal" data-modal="event-search">
    <button class="p-hareruya-search-modal__close" type="button" data-modal-close="event-search" aria-label="{{ 'common.close'|trans }}">
        <i class="icon-hareruya-plus c-hareruya-icon--sm" aria-hidden="true"></i>
    </button>
    <div class="p-hareruya-search-modal__content">
        <form class="p-hareruya-search-form" method="get" action="{{ url('event_search') }}" novalidate>
            <input type="hidden" name="_submitted" value="1">
            <div class="p-hareruya-search-form__header">
                <h2 class="c-hareruya-heading--lev2 p-hareruya-search-form__title">{{ 'front.event.search.modal_title'|trans }}</h2>
            </div>
            <div class="p-hareruya-search-form__body">
                <div class="p-hareruya-form-group">
                    <div class="p-hareruya-form-block p-hareruya-search-form__card-name">
                        <div class="p-hareruya-form-block__label-wrap">
                            <label class="c-hareruya-heading--lev3" for="event-search-term">{{ 'front.event.search.term.label'|trans }}</label>
                        </div>
                        <div class="p-hareruya-form-block__form-list">
                            <div class="p-hareruya-search-form__keyword-wrapper">
                                <div class="c-hareruya-form-input">
                                    <input class="c-hareruya-form-input__field" id="event-search-term" type="text" name="term" placeholder="{{ 'front.event.search.term.placeholder'|trans }}" autocomplete="off" maxlength="255" value="{{ input.term }}">
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="p-hareruya-form-block p-hareruya-search-form__event-date">
                        <fieldset class="p-hareruya-form-block__fieldset">
                            <legend class="p-hareruya-form-block__label-wrap"><span class="c-hareruya-heading--lev3">{{ 'front.event.search.date.label'|trans }}</span></legend>
                            <div class="p-hareruya-form-block__form-list">
                                <div class="p-hareruya-search-form__date-input" data-datepicker-trigger>
                                    <div class="c-hareruya-form-input">
                                        <input class="c-hareruya-form-input__field" type="text" name="from" placeholder="{{ 'front.event.search.date.placeholder'|trans }}" autocomplete="off" readonly data-datepicker-input value="{{ input.from ? input.from|date('Y/m/d') : '' }}">
                                    </div>
                                    <button class="p-hareruya-search-form__date-icon" type="button" aria-label="{{ 'front.event.search.date.from_aria_label'|trans }}" data-datepicker-icon><i class="icon-hareruya-calendar c-hareruya-icon--sm" aria-hidden="true"></i></button>
                                </div>
                                <span class="p-hareruya-search-form__date-separator">〜</span>
                                <div class="p-hareruya-search-form__date-input" data-datepicker-trigger>
                                    <div class="c-hareruya-form-input">
                                        <input class="c-hareruya-form-input__field" type="text" name="to" placeholder="{{ 'front.event.search.date.placeholder'|trans }}" autocomplete="off" readonly data-datepicker-input value="{{ input.to ? input.to|date('Y/m/d') : '' }}">
                                    </div>
                                    <button class="p-hareruya-search-form__date-icon" type="button" aria-label="{{ 'front.event.search.date.to_aria_label'|trans }}" data-datepicker-icon><i class="icon-hareruya-calendar c-hareruya-icon--sm" aria-hidden="true"></i></button>
                                </div>
                            </div>
                        </fieldset>
                    </div>
                    <div class="p-hareruya-form-block p-hareruya-search-form__event-format">
                        <fieldset class="p-hareruya-form-block__fieldset">
                            <legend class="p-hareruya-form-block__label-wrap"><span class="c-hareruya-heading--lev3">{{ 'front.event.search.format.label'|trans }}</span></legend>
                            <div class="p-hareruya-form-block__form-list p-hareruya-search-form__block--3col">
                                {% for Format in Formats %}
                                    <label class="p-hareruya-search-form__checkbox" for="event-search-format-{{ Format.id }}">
                                        <input class="p-hareruya-search-form__checkbox-input" type="checkbox" name="formats[]" value="{{ Format.id }}" id="event-search-format-{{ Format.id }}"{% if Format.id in input.formats %} checked{% endif %}>
                                        <span class="p-hareruya-search-form__checkbox-inner">{{ Format.nameJp }}</span>
                                    </label>
                                {% endfor %}
                            </div>
                        </fieldset>
                    </div>
                    <div class="p-hareruya-form-block p-hareruya-search-form__event-rule">
                        <fieldset class="p-hareruya-form-block__fieldset">
                            <legend class="p-hareruya-form-block__label-wrap"><span class="c-hareruya-heading--lev3">{{ 'front.event.search.category.label'|trans }}</span></legend>
                            <div class="p-hareruya-form-block__form-list p-hareruya-search-form__block--3col">
                                <label class="p-hareruya-search-form__checkbox" for="event-search-category-beginner">
                                    <input class="p-hareruya-search-form__checkbox-input" type="checkbox" name="categories[]" value="beginner" id="event-search-category-beginner"{% if 'beginner' in input.categories %} checked{% endif %}>
                                    <span class="p-hareruya-search-form__checkbox-inner">{{ 'front.event.search.category.beginner'|trans }}</span>
                                </label>
                                <label class="p-hareruya-search-form__checkbox" for="event-search-category-casual">
                                    <input class="p-hareruya-search-form__checkbox-input" type="checkbox" name="categories[]" value="casual" id="event-search-category-casual"{% if 'casual' in input.categories %} checked{% endif %}>
                                    <span class="p-hareruya-search-form__checkbox-inner">{{ 'front.event.search.category.casual'|trans }}</span>
                                </label>
                                <label class="p-hareruya-search-form__checkbox" for="event-search-category-competitive">
                                    <input class="p-hareruya-search-form__checkbox-input" type="checkbox" name="categories[]" value="competitive" id="event-search-category-competitive"{% if 'competitive' in input.categories %} checked{% endif %}>
                                    <span class="p-hareruya-search-form__checkbox-inner">{{ 'front.event.search.category.competitive'|trans }}</span>
                                </label>
                                <label class="p-hareruya-search-form__checkbox" for="event-search-category-reservation">
                                    <input class="p-hareruya-search-form__checkbox-input" type="checkbox" name="categories[]" value="reservation" id="event-search-category-reservation"{% if 'reservation' in input.categories %} checked{% endif %}>
                                    <span class="p-hareruya-search-form__checkbox-inner">{{ 'front.event.search.category.reservation'|trans }}</span>
                                </label>
                            </div>
                        </fieldset>
                    </div>
                    <div class="p-hareruya-form-block p-hareruya-search-form__event-venue">
                        <fieldset class="p-hareruya-form-block__fieldset">
                            <legend class="p-hareruya-form-block__label-wrap"><span class="c-hareruya-heading--lev3">{{ 'front.event.search.venue.label'|trans }}</span></legend>
                            <div class="p-hareruya-form-block__form-list p-hareruya-search-form__block--2col">
                                {% for Shop in OpenShops %}
                                    <label class="p-hareruya-search-form__checkbox" for="event-search-venue-{{ Shop.id }}">
                                        <input class="p-hareruya-search-form__checkbox-input" type="checkbox" name="venues[]" value="{{ Shop.id }}" id="event-search-venue-{{ Shop.id }}"{% if Shop.id in input.venues %} checked{% endif %}>
                                        <span class="p-hareruya-search-form__checkbox-inner">{{ Shop.shopName }}</span>
                                    </label>
                                {% endfor %}
                            </div>
                        </fieldset>
                    </div>
                    <div class="p-hareruya-form-block p-hareruya-search-form__event-detail">
                        <fieldset class="p-hareruya-form-block__fieldset">
                            <legend class="p-hareruya-form-block__label-wrap"><span class="c-hareruya-heading--lev3">{{ 'front.event.search.detail.label'|trans }}</span></legend>
                            <div class="p-hareruya-form-block__form-list p-hareruya-search-form__block--1col">
                                <label class="p-hareruya-search-form__checkbox" for="event-search-weekday">
                                    <input class="p-hareruya-search-form__checkbox-input" type="checkbox" name="isWeekday" value="true" id="event-search-weekday"{% if input.isWeekday %} checked{% endif %}>
                                    <span class="p-hareruya-search-form__checkbox-inner">{{ 'front.event.search.detail.weekday'|trans }}</span>
