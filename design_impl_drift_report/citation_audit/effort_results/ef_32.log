    {
        $builder
            ->add('deck_id', TextType::class, [
                'label' => 'admin.deck.deck_id',
                'required' => false,
                'constraints' => [
                    new Assert\Length(['max' => $this->eccubeConfig['eccube_stext_len']]),
                    new Assert\Regex(['pattern' => '/^[\d,\s　]+$/']),
                ],
            ])
            ->add('deck_name', TextType::class, [
                'label' => 'admin.deck.deck_name',
                'required' => false,
                'constraints' => [
                    new Assert\Length(['max' => $this->eccubeConfig['eccube_stext_len']]),
                ],
            ])
            ->add('formats', EntityType::class, [
                'class' => MtbFormat::class,
                'choice_label' => 'name_jp',
                'label' => 'admin.deck.format',
                'required' => false,
                'multiple' => true,
                'attr' => ['class' => 'select2-select'],
                'query_builder' => function (EntityRepository $er) {
                    return $er->createQueryBuilder('f')
                        ->orderBy('f.rank', 'ASC')
                        ->addOrderBy('f.id', 'ASC');
                },
            ])
            ->add('color', EntityType::class, [
                'class' => MtbColor::class,
                'choice_label' => 'name_jp',
                'label' => 'admin.deck.color',
                'label_attr' => ['class' => 'checkbox-inline'],
                'required' => false,
                'multiple' => true,
                'expanded' => true,
            ])
            ->add('archetypes', EntityType::class, [
                'class' => DtbArchetype::class,
                'choice_label' => 'nameJp',
                'label' => 'admin.deck.archetype',
                'required' => false,
                'multiple' => true,
                'attr' => ['class' => 'select2-select'],
            ])
            ->add('disp', EntityType::class, [
                'class' => MtbDisp::class,
                'choice_label' => 'name',
                'label' => 'admin.deck.disp',
                'required' => false,
                'multiple' => true,
                'expanded' => true,
            ])
            ->add('private_flg', ChoiceType::class, [
                'choices' => [
                    'admin.deck.private_flg.public' => '0',
                    'admin.deck.private_flg.private' => '1',
                ],
                'label' => 'admin.deck.private_flg',
                'required' => false,
                'multiple' => true,
                'expanded' => true,
            ])
            ->add('event_date_from', DateType::class, [
                'label' => 'admin.deck.event_date',
                'required' => false,
                'input' => 'datetime',
                'widget' => 'single_text',
                'data' => (new \DateTime())->modify('-3 months')->setTime(0, 0),
                'attr' => ['class' => 'datetimepicker-input', 'data-bs-toggle' => 'datetimepicker'],
            ])
            ->add('event_date_to', DateType::class, [
                'label' => false,
                'required' => false,
                'input' => 'datetime',
                'widget' => 'single_text',
                'attr' => ['class' => 'datetimepicker-input', 'data-bs-toggle' => 'datetimepicker'],
            ])
            ->add('event_name', TextType::class, [
                'label' => 'admin.deck.event_name',
                'required' => false,
                'constraints' => [
                    new Assert\Length(['max' => $this->eccubeConfig['eccube_stext_len']]),
                ],
            ])
            ->add('ranking_from', IntegerType::class, [
                'label' => 'admin.deck.ranking',
                'required' => false,
                'attr' => ['min' => 1],
            ])
            ->add('ranking_to', IntegerType::class, [
                'label' => false,
                'required' => false,
                'attr' => ['min' => 1],
            ])
            ->add('result', TextType::class, [
                'label' => 'admin.deck.result',
                'required' => false,
                'constraints' => [
                    new Assert\Length(['max' => $this->eccubeConfig['eccube_stext_len']]),
                ],
            ])
            ->add('player_name', TextType::class, [
                'label' => 'admin.deck.player_name',
                'required' => false,
                'constraints' => [
                    new Assert\Length(['max' => $this->eccubeConfig['eccube_stext_len']]),
                ],
            ])
            ->add('deck_tags', EntityType::class, [
                'class' => MtbDeckTag::class,
                'choice_label' => 'nameJp',
                'label' => 'admin.deck.deck_tag',
                'required' => false,
                'multiple' => true,
                'attr' => ['class' => 'select2-select'],
            ])
            ->add('card', TextType::class, [
                'label' => 'admin.deck.card',
                'required' => false,
                'constraints' => [
                    new Assert\Length(['max' => $this->eccubeConfig['eccube_mtext_len']]),
                ],
            ])
