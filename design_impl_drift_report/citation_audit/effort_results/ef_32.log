namespace Eccube\Controller\Admin\Card;

use Eccube\Controller\AbstractController;
use Eccube\Entity\Master\MtbBoard;
use Eccube\Entity\Master\MtbFormat;
use Eccube\Event\EccubeEvents;
use Eccube\Event\EventArgs;
use Eccube\Form\Type\Admin\FormatType;
use Eccube\Repository\Master\MtbFormatRepository;
use Eccube\Service\Admin\Format\ActionInput\FormatSaveInput;
use Eccube\Service\Admin\Format\FormatSaveAction;
use Symfony\Bridge\Twig\Attribute\Template;
use Symfony\Component\HttpFoundation\RedirectResponse;
use Symfony\Component\HttpFoundation\Request;
use Symfony\Component\HttpKernel\Exception\NotFoundHttpException;
use Symfony\Component\Routing\Attribute\Route;

class FormatController extends AbstractController
{
    public function __construct(private readonly MtbFormatRepository $formatRepository)
    {
    }

    /**
     * @return array<string, mixed>
     */
    #[Route('/%eccube_admin_route%/format', name: 'admin_format_list')]
    #[Template('@admin/Format/format_list.twig')]
    public function index(Request $request): array
    {
        $event = new EventArgs([], $request);
        $this->eventDispatcher->dispatch($event, EccubeEvents::ADMIN_CARD_FORMAT_INDEX_INITIALIZE);

        return [
            'Formats' => $this->formatRepository->findBy([], ['rank' => 'ASC']),
        ];
    }

    /**
     * フォーマット登録画面.
     *
     * @return RedirectResponse|array<string, mixed>
     */
    #[Route('/%eccube_admin_route%/format/new', name: 'admin_format_new', methods: ['GET', 'POST'])]
    #[Template('@admin/Format/edit.twig')]
    public function new(Request $request, FormatSaveAction $saveAction): RedirectResponse|array
    {
        $Format = new MtbFormat();
        $builder = $this->formFactory->createBuilder(FormatType::class, $Format, ['format_id' => null]);

        $event = new EventArgs(
            [
                'builder' => $builder,
                'Format' => $Format,
            ],
            $request
        );
        $this->eventDispatcher->dispatch($event, EccubeEvents::ADMIN_CARD_FORMAT_NEW_INITIALIZE);

        $form = $builder->getForm();
        $form->handleRequest($request);

        if ($form->isSubmitted() && $form->isValid()) {
            $Format = $form->getData();
            $saveAction->handle(new FormatSaveInput(
                $Format,
                $form['commandMaxCardCount']->getData(),
                $form['commandMinCardCount']->getData(),
                $form['commanderInMain']->getData(),
            ));

            $event = new EventArgs(
                [
                    'form' => $form,
                    'Format' => $Format,
                ],
                $request
            );
            $this->eventDispatcher->dispatch($event, EccubeEvents::ADMIN_CARD_FORMAT_NEW_COMPLETE);

            $this->addSuccess('admin.common.save_complete', 'admin');

            return $this->redirectToRoute('admin_format_edit', ['id' => $Format->getId()]);
        }

        return [
            'form' => $form->createView(),
            'Format' => $Format,
        ];
    }

    /**
     * フォーマット編集画面.
     *
     * @return RedirectResponse|array<string, mixed>
     */
    #[Route('/%eccube_admin_route%/format/{id}/edit', name: 'admin_format_edit', methods: ['GET', 'POST'])]
    #[Template('@admin/Format/edit.twig')]
    public function edit(Request $request, int $id, FormatSaveAction $saveAction): RedirectResponse|array
    {
        /** @var MtbFormat|null $Format */
        $Format = $this->formatRepository->find($id);
        if (is_null($Format)) {
            throw new NotFoundHttpException();
        }

        $builder = $this->formFactory->createBuilder(FormatType::class, $Format, ['format_id' => $id]);

        $event = new EventArgs(
            [
                'builder' => $builder,
                'Format' => $Format,
            ],
            $request
        );
        $this->eventDispatcher->dispatch($event, EccubeEvents::ADMIN_CARD_FORMAT_EDIT_INITIALIZE);

        $form = $builder->getForm();
        $form->handleRequest($request);

        if ($form->isSubmitted() && $form->isValid()) {
            $Format = $form->getData();
            $saveAction->handle(new FormatSaveInput(
                $Format,
                $form['commandMaxCardCount']->getData(),
                $form['commandMinCardCount']->getData(),
                $form['commanderInMain']->getData(),
            ));

            $event = new EventArgs(
                [
                    'form' => $form,
                    'Format' => $Format,
                ],
                $request
            );
            $this->eventDispatcher->dispatch($event, EccubeEvents::ADMIN_CARD_FORMAT_EDIT_COMPLETE);

            $this->addSuccess('admin.common.save_complete', 'admin');

            return $this->redirectToRoute('admin_format_edit', ['id' => $Format->getId()]);
        }

        // 統率ボード上下限
        if ($CommanderFormatBoard = $Format->getFormatBoardByBoardId(MtbBoard::BOARD_ID_COMMAND)) {
            $form['commanderInMain']->setData($Format->isCommanderInMain());
            $form['commandMaxCardCount']->setData($CommanderFormatBoard->getMaxCardCount());
            $form['commandMinCardCount']->setData($CommanderFormatBoard->getMinCardCount());
        }

        return [
            'form' => $form->createView(),
            'Format' => $Format,
        ];
    }

    #[Route('/%eccube_admin_route%/product/format/{id}/delete', name: 'admin_format_delete', requirements: ['id' => '\d+'], methods: ['DELETE'])]
    public function delete(Request $request, MtbFormat $Format): RedirectResponse
    {
        $this->isTokenValid();

        $formatId = $Format->getId();
        $formatName = $Format->getNameJp();

        log_info('フォーマット削除開始', [$formatId]);

        try {
            // 大会・デッキ・アーキタイプで使用されているなら削除不可とする
            if (!$Format->getEvents()->isEmpty()) {
                $this->addError('admin.product.format.error.delete.registered_event', 'admin');

                return $this->redirectToRoute('admin_format_list');
            }
            if (!$Format->getDecks()->isEmpty()) {
                $this->addError('admin.product.format.error.delete.registered_deck', 'admin');

                return $this->redirectToRoute('admin_format_list');
            }
            if (!$Format->getArchetypes()->isEmpty()) {
                $this->addError('admin.product.format.error.delete.registered_archetype', 'admin');

                return $this->redirectToRoute('admin_format_list');
            }

            $this->entityManager->remove($Format);
            $this->entityManager->flush();

            $this->addSuccess('admin.common.delete_complete', 'admin');

            log_info('フォーマット削除完了', [$formatId]);
        } catch (\Exception $e) {
            log_info('フォーマット削除エラー', [$formatId, $e]);

            $message = trans('admin.common.delete_error_foreign_key', ['%name%' => $Format->getNameJp()]);
            $this->addError($message, 'admin');
        }

        $event = new EventArgs(
            [
                'Format' => $Format,
            ],
            $request
        );
        $this->eventDispatcher->dispatch($event, EccubeEvents::ADMIN_CARD_FORMAT_DELETE_COMPLETE);

        return $this->redirectToRoute('admin_format_list');
    }
}
