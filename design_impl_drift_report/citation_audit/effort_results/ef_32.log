    /**
     * 実 DtbEvent に 1 件以上 設定 されている format のみ id ASC で 取得する。
     *
     * @return list<MtbFormat>
     */
    public function getFormatsAssignedToEvents(): array
    {
        /** @var list<MtbFormat> $formats */
        $formats = $this->createQueryBuilder('f')
            ->innerJoin('f.Events', 'e')
            ->andWhere('e.deletedAt IS NULL')
            ->groupBy('f.id')
            ->orderBy('f.id', 'ASC')
            ->getQuery()
            ->getResult();

        return $formats;
    }
