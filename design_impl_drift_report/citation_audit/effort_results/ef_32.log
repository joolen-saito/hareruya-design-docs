    // archetype form filter
    function archetypeFilter() {
        var formatSelector = "";
        var colorSelector = "";
        var defer = $.Deferred();
        setTimeout(function(){
            //reset filter
            $("#admin_search_deck_archetypes option").prop("disabled", true);
            //filter by formats
            var selectedFormat = $("#admin_search_deck_formats option:selected");
            if (selectedFormat.length === 0) {
                selectedFormat = $("#admin_search_deck_formats option");
            }
            formatSelector = selectedFormat.map(function() {
                return ".format_id_" + $(this).val();
            }).get().join(",");

            //filter by color
            var checkedColors = $("#admin_search_deck_color input:checked");
            colorSelector = checkedColors.map(function() {
                return ".color_id_" + $(this).val();
            }).get().join("");
            if(colorSelector === "") {
                $("#admin_search_deck_archetypes option").filter(formatSelector).prop("disabled", false).prependTo("#admin_search_deck_archetypes");
            } else {
                $("#admin_search_deck_archetypes option").filter(colorSelector).filter(formatSelector).prop("disabled", false).prependTo("#admin_search_deck_archetypes");
            }
            $("#admin_search_deck_archetypes").select2({allowClear: true});

            defer.resolve();
        }, 0);

        return defer.promise();
    }

