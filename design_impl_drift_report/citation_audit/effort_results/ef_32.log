<script{% if csp_nonce is defined %} nonce="{{ csp_nonce }}"{% endif %}>
    (function () {
        const modal = document.querySelector('[data-modal="event-search"]');
        if (!modal) {
            return;
        }
        const form = modal.querySelector('form.p-hareruya-search-form');
        if (!form) {
            return;
        }
        function countConditions() {
            let count = 0;
            const term = form.querySelector('input[name="term"]');
            if (term && term.value.trim() !== '') {
                count += 1;
            }
            const from = form.querySelector('input[name="from"]');
            const to = form.querySelector('input[name="to"]');
            if ((from && from.value.trim() !== '') || (to && to.value.trim() !== '')) {
                count += 1;
            }
            count += form.querySelectorAll('input[name="formats[]"]:checked').length;
            count += form.querySelectorAll('input[name="venues[]"]:checked').length;
            count += form.querySelectorAll('input[name="categories[]"]:checked').length;
            const weekday = form.querySelector('input[name="isWeekday"]');
            const holiday = form.querySelector('input[name="isHoliday"]');
            const weekdayChecked = weekday && weekday.checked;
            const holidayChecked = holiday && holiday.checked;
            if (weekdayChecked !== holidayChecked) {
                count += 1;
            }
            ['allowPast', 'isLarge', 'isFree'].forEach(function (name) {
                const input = form.querySelector('input[name="' + name + '"]');
                if (input && input.checked) {
                    count += 1;
                }
            });
            return count;
        }
        function syncBadges() {
            const badges = document.querySelectorAll('[data-search-condition-badge]');
            if (badges.length === 0) {
                return;
            }
            const count = countConditions();
            badges.forEach(function (badge) {
                badge.textContent = String(count);
                if (count > 0) {
                    badge.removeAttribute('hidden');
                } else {
                    badge.setAttribute('hidden', '');
                }
            });
        }
        form.addEventListener('input', syncBadges);
        form.addEventListener('change', syncBadges);
        const clearButton = form.querySelector('[data-search-clear]');
        if (clearButton) {
            clearButton.addEventListener('click', function () {
                window.setTimeout(function () {
                    form.querySelectorAll('input[type="checkbox"]').forEach(function (cb) {
                        cb.checked = false;
                    });
                    form.querySelectorAll('input[type="text"], input[type="search"]').forEach(function (input) {
                        input.value = '';
                    });
                    syncBadges();
                }, 0);
            });
        }
        syncBadges();
        document.addEventListener('DOMContentLoaded', syncBadges);
    })();
</script>
