    }

    /**
     * 指定店舗 (BaseInfo) で、指定月の範囲に開催日時 (start_date) を持つ公開中イベントを
     * 開催日時昇順 → イベント ID 昇順で取得する。Detail / Formats / EventScale / Rel は eager join。
     * イベント大会TOP (F07-01) の月単位 JSON 取得で利用する。
     *
     * @return DtbEvent[]
     */
    public function getEventsByShopAndMonth(int $baseInfoId, \DateTimeImmutable $monthStart): array
    {
        $monthEnd = $monthStart->modify('+1 month');

        $qb = $this->createQueryBuilder('e');

        return $qb
            ->select('e', 'ed', 'es', 'rel', 'f')
            ->leftJoin('e.Details', 'ed')
            ->leftJoin('e.EventScale', 'es')
            ->leftJoin('e.Rel', 'rel')
            ->leftJoin('e.Formats', 'f')
            ->where($qb->expr()->eq('IDENTITY(e.BaseInfo)', ':baseInfoId'))
            ->andWhere($qb->expr()->eq('IDENTITY(e.Disp)', ':dispShow'))
            ->andWhere($qb->expr()->isNull('e.deletedAt'))
            ->andWhere($qb->expr()->eq('IDENTITY(ed.Disp)', ':dispShow'))
            ->andWhere($qb->expr()->gte('ed.startDate', ':monthStart'))
            ->andWhere($qb->expr()->lt('ed.startDate', ':monthEnd'))
            ->setParameter('baseInfoId', $baseInfoId)
            ->setParameter('dispShow', MtbDisp::DISPLAY_SHOW)
            ->setParameter('monthStart', $monthStart)
            ->setParameter('monthEnd', $monthEnd)
            ->orderBy('ed.startDate', 'ASC')
            ->addOrderBy('e.id', 'ASC')
            ->getQuery()
            ->getResult();
    }

    /**
     * 指定店舗・指定日付範囲の公開中イベントを取得する。
     * イベント大会TOP の dummy 互換 JSON エンドポイント (5 path) で利用。
     *
     * @return DtbEvent[]
     */
    public function getEventsByShopAndDateRange(int $baseInfoId, \DateTimeImmutable $rangeStart, \DateTimeImmutable $rangeEnd): array
    {
        $qb = $this->createQueryBuilder('e');

        return $qb
            ->select('e', 'ed', 'es', 'rel', 'f')
            ->leftJoin('e.Details', 'ed')
            ->leftJoin('e.EventScale', 'es')
            ->leftJoin('e.Rel', 'rel')
            ->leftJoin('e.Formats', 'f')
            ->where($qb->expr()->eq('IDENTITY(e.BaseInfo)', ':baseInfoId'))
            ->andWhere($qb->expr()->eq('IDENTITY(e.Disp)', ':dispShow'))
            ->andWhere($qb->expr()->isNull('e.deletedAt'))
            ->andWhere($qb->expr()->eq('IDENTITY(ed.Disp)', ':dispShow'))
            ->andWhere($qb->expr()->gte('ed.startDate', ':rangeStart'))
            ->andWhere($qb->expr()->lt('ed.startDate', ':rangeEnd'))
            ->setParameter('baseInfoId', $baseInfoId)
            ->setParameter('dispShow', MtbDisp::DISPLAY_SHOW)
            ->setParameter('rangeStart', $rangeStart)
            ->setParameter('rangeEnd', $rangeEnd)
            ->orderBy('ed.startDate', 'ASC')
            ->addOrderBy('e.id', 'ASC')
            ->getQuery()
            ->getResult();
    }

    /**
     * 指定 DtbEventDetail 群について、論理削除されていない DtbEventEntry の件数を detail_id => count の連想配列で返す。
     * イベント大会TOP の受付状況 (4-13) 表示用の予約枠カウント計算で利用する。
     *
     * @param int[] $detailIds
     *
     * @return array<int, int> detail_id => active entry count
     */
    public function countActiveEntriesByDetailIds(array $detailIds): array
    {
        if ($detailIds === []) {
            return [];
        }

        $rows = $this->getEntityManager()
            ->createQueryBuilder()
            ->select('IDENTITY(ee.EventDetail) AS detail_id', 'COUNT(ee.id) AS entry_count')
            ->from(\Eccube\Entity\DtbEventEntry::class, 'ee')
            ->where('IDENTITY(ee.EventDetail) IN (:detailIds)')
            ->andWhere('ee.deletedAt IS NULL')
            ->groupBy('ee.EventDetail')
            ->setParameter('detailIds', $detailIds)
            ->getQuery()
            ->getArrayResult();

        $counts = [];
        foreach ($rows as $row) {
            $counts[(int) $row['detail_id']] = (int) $row['entry_count'];
        }

        return $counts;
    }
}

