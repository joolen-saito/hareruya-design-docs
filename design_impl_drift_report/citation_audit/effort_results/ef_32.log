    public function getDetailsOfADay(\DateTime $day): mixed
    {
        $qb = $this->createQueryBuilder('d');

        $from = $day;
        $from->modify('00:00:00');
        $qb->andWhere($qb->expr()->gte('d.startDate', $qb->expr()->literal($from->format(self::MYSQL_DATE_FORMAT))));
        $to = $day;
        $to->modify('23:59:59');
        $qb->andWhere($qb->expr()->lte('d.startDate', $qb->expr()->literal($to->format(self::MYSQL_DATE_FORMAT))));

        return $qb->getQuery()->execute();
    }

    public function findForFront(int $detailId): ?DtbEventDetail
    {
        $qb = $this->createQueryBuilder('d')
            ->select('d', 'e', 'shop', 'f', 'rel', 'scale')
            ->join('d.Event', 'e')
            ->leftJoin('e.BaseInfo', 'shop')
            ->leftJoin('e.Formats', 'f')
            ->leftJoin('e.Rel', 'rel')
            ->leftJoin('e.EventScale', 'scale')
            ->andWhere('d.id = :detailId')
            ->andWhere('d.deletedAt IS NULL')
            ->andWhere('IDENTITY(d.Disp) = :dispShow')
            ->andWhere('IDENTITY(e.Disp) = :dispShow')
            ->andWhere('e.deletedAt IS NULL')
            ->setParameter('detailId', $detailId)
            ->setParameter('dispShow', MtbDisp::DISPLAY_SHOW);

        /** @var DtbEventDetail|null $result */
        $result = $qb->getQuery()->getOneOrNullResult();

        return $result;
    }

    /**
     * @return list<DtbEventDetail>
     */
    public function searchDetailsForFront(EventSearchInput $input, \DateTimeImmutable $now): array
    {
        $idQb = $this->buildFrontSearchQueryBuilder($input, $now);
        $idQb->select('d.id AS id, d.startDate AS HIDDEN sort_key')
            ->groupBy('d.id')
            ->orderBy('sort_key', 'ASC')
            ->addOrderBy('d.id', 'ASC')
            ->setFirstResult($input->offset())
            ->setMaxResults(EventSearchInput::PER_PAGE);
        /** @var list<array{id: int}> $rows */
        $rows = $idQb->getQuery()->getArrayResult();
        if ($rows === []) {
            return [];
        }
        $ids = array_map(static fn (array $row) => (int) $row['id'], $rows);

        $qb = $this->createQueryBuilder('d')
            ->select('d, e, f, scale, rel, shop')
            ->join('d.Event', 'e')
            ->leftJoin('e.BaseInfo', 'shop')
            ->leftJoin('e.Formats', 'f')
            ->leftJoin('e.EventScale', 'scale')
            ->leftJoin('e.Rel', 'rel')
            ->andWhere('d.id IN (:detail_ids)')
            ->setParameter('detail_ids', $ids);
        /** @var list<DtbEventDetail> $details */
        $details = $qb->getQuery()->getResult();

        $byId = [];
        foreach ($details as $detail) {
            $byId[$detail->getId()] = $detail;
        }
        $sorted = [];
        foreach ($ids as $id) {
            if (isset($byId[$id])) {
                $sorted[] = $byId[$id];
            }
        }

        return $sorted;
    }

    public function countDetailsForFront(EventSearchInput $input, \DateTimeImmutable $now): int
    {
        $qb = $this->buildFrontSearchQueryBuilder($input, $now);
        $qb->select('COUNT(DISTINCT d.id)');

        return (int) $qb->getQuery()->getSingleScalarResult();
    }

