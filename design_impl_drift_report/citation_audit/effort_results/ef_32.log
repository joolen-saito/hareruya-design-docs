                'constraints' => [
                    new Assert\Length(['max' => $this->eccubeConfig['eccube_mtext_len']]),
                ],
            ])
            ->add('event_detail_id', TextType::class, [
                'label' => 'admin.deck.event_detail_id',
                'required' => false,
