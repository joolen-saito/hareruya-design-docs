        $event = new EventArgs(
            [
                'builder' => $builder,
                'Cardset' => $Cardset,
            ],
            $request
        );
        $this->eventDispatcher->dispatch($event, EccubeEvents::ADMIN_CARD_CARDSET_NEW_INITIALIZE);

        $form = $builder->getForm();
        $form->handleRequest($request);

        if ($form->isSubmitted() && $form->isValid()) {
            $Cardset = $form->getData();
            $saveAction->handle($Cardset);

