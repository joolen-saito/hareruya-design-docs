<?php

namespace Plugin\HareruyaEc\Event\Admin;

use Eccube\Event\EventArgs;
use Symfony\Component\Validator\Constraints as Assert;
use Plugin\HareruyaEc\Controller\Admin\CardSetController;

class CardSetEvent
{
    public function __construct(\Eccube\Application $app)
    {
        $this->app = $app;
    }

    /**
     * download ディレクトリを削除
     *
     * @param EventArgs $event
     */
    public function onControllerCardSetDownloadFinish()
    {
        CardSetController::removeAllDirContents(CardSetController::DOWN_LOAD_DIR);
    }
}

