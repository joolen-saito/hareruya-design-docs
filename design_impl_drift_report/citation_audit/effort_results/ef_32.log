{% endblock stylesheet %}

{% block javascript %}
    <script src="{{ asset('assets/js/select2.min.js', 'admin') }}" nonce="{{ csp_nonce }}"></script>
    <script nonce="{{ csp_nonce }}">
        $(function() {
            const multiSelectPlaceholder = '{{ 'admin.deck.multi_select_placeholder'|trans|e('js') }}';
            const bulkUpdateRequiredMessage = '{{ 'admin.deck.bulk_update_required'|trans|e('js') }}';
            const initSelect2 = function($el) {
                const opts = { width: '100%' };
                if ($el.prop('multiple')) {
                    opts.placeholder = multiSelectPlaceholder;
                }
                $el.select2(opts);
            };
            $('.select2-select').each(function() { initSelect2($(this)); });

            $('#page_count_pulldown').on('change', function () {
                const targetUrl = $(this).val();
                if (targetUrl) {
                    window.location.href = targetUrl;
                }
            });

            $('#sort_key_pulldown, #sort_order_pulldown').on('change', function () {
                const sortKey = $('#sort_key_pulldown').val();
                const sortOrder = $('#sort_order_pulldown').val();
                const $searchForm = $('#admin_search_deck');
                $searchForm.find('.hidden_sort_key').val(sortKey);
                $searchForm.find('.hidden_sort_order').val(sortOrder);
                $searchForm.submit();
            });

            $('#date_clear').on('click', function() {
                $('#admin_search_deck_event_date_from').val('');
                $('#admin_search_deck_event_date_to').val('');
            });

            $('#toggle_bulk_edit').on('click', function() {
                $('#bulk_edit_panel').slideToggle(200, function() {
                    $('#bulk_edit_panel .select2-select').each(function() { initSelect2($(this)); });
                });
            });

            $('.toggle_bulk_update_check').on('change', function() {
                const $formArea = $(this).closest('label').siblings('.bulk_update_form');
                $formArea.toggle($(this).prop('checked'));
                $formArea.siblings('.bulk_update_error').remove();
            });

            const BULK_EDIT_STATE_KEY = 'admin_deck_bulk_edit_state';

            const captureBulkEditState = function() {
                const state = {
                    deckIds: $('input.searched_deck_id:checked').map(function() { return $(this).val(); }).get(),
                    changeFlgs: {},
                    fields: {}
                };
                $('.toggle_bulk_update_check:checked').each(function() {
                    const m = ($(this).attr('name') || '').match(/^change_flgs\[(.+)\]$/);
                    if (m) {
                        state.changeFlgs[m[1]] = true;
                    }
                });
                $('#bulk_edit_panel').find('input, select, textarea').each(function() {
                    const name = $(this).attr('name');
                    if (!name || name === '_token' || name.indexOf('change_flgs') === 0) return;
                    const $el = $(this);
                    if ($el.is(':checkbox') || $el.is(':radio')) {
                        if ($el.is(':checked')) {
                            state.fields[name] = $el.val();
                        }
                    } else {
                        const v = $el.val();
                        if (v !== null && v !== '' && !(Array.isArray(v) && v.length === 0)) {
                            state.fields[name] = v;
                        }
                    }
                });
                return state;
            };

            const restoreBulkEditState = function() {
                const raw = sessionStorage.getItem(BULK_EDIT_STATE_KEY);
                if (!raw) return;
                sessionStorage.removeItem(BULK_EDIT_STATE_KEY);
                let state;
                try { state = JSON.parse(raw); } catch (e) { return; }

                if (Array.isArray(state.deckIds)) {
                    state.deckIds.forEach(function(id) {
                        $('input.searched_deck_id[value="' + id + '"]').prop('checked', true);
                    });
                }
                const hasFlgs = state.changeFlgs && Object.keys(state.changeFlgs).length > 0;
                if (hasFlgs) {
                    $('#bulk_edit_panel').show();
                    $('#bulk_edit_panel .select2-select').each(function() { initSelect2($(this)); });
                    Object.keys(state.changeFlgs).forEach(function(key) {
                        const $check = $('input.toggle_bulk_update_check[name="change_flgs[' + key + ']"]');
                        $check.prop('checked', true);
                        $check.closest('label').siblings('.bulk_update_form').show();
                    });
                }
                if (state.fields) {
                    Object.keys(state.fields).forEach(function(name) {
                        const $el = $('#bulk_edit_panel').find('[name="' + name + '"]');
                        if ($el.length === 0) return;
                        if ($el.is(':checkbox') || $el.is(':radio')) {
                            $el.filter('[value="' + state.fields[name] + '"]').prop('checked', true);
                        } else {
                            $el.val(state.fields[name]).trigger('change');
                        }
                    });
                }
            };

            $('button[formaction*="bulk_update"]').on('click', function(e) {
                $('.bulk_update_error').remove();
                let hasError = false;
                $('.toggle_bulk_update_check:checked').each(function() {
                    const $container = $(this).closest('label').siblings('.bulk_update_form');
                    const $input = $container.find('input, select, textarea').first();
                    const val = $input.val();
                    const isRadio = $input.is(':radio');
                    const isEmpty = isRadio
                        ? $container.find('input:radio:checked').length === 0
                        : (val === null || val === '' || (Array.isArray(val) && val.length === 0));
                    if (isEmpty) {
                        $container.after('<div class="bulk_update_error text-danger mt-1">' + bulkUpdateRequiredMessage + '</div>');
                        hasError = true;
                    }
                });
                if (hasError) {
                    e.preventDefault();
                    return;
                }
                // バリデーションエラーで同画面が返ったときに復元できるよう state を保存
                sessionStorage.setItem(BULK_EDIT_STATE_KEY, JSON.stringify(captureBulkEditState()));
            });

            restoreBulkEditState();

            $('#allCheck').on('change', function() {
                $('.searched_deck_id').prop('checked', $(this).prop('checked'));
            });

            $('.search-clear').on('click', function(e) {
                e.preventDefault();
                const $form = $(this).closest('form');
                $form.find('input[type="text"], input[type="number"], input[type="date"]').val('');
                $form.find('input[type="checkbox"], input[type="radio"]').prop('checked', false);
                $form.find('select').val(null).trigger('change');
            });

            // 一括フォームは formaction でアクションを切り替えるため、CSRFトークンも対応する値に差し替える
            $('#bulk_form').on('submit', function(e) {
                var submitter = e.originalEvent && e.originalEvent.submitter ? e.originalEvent.submitter : null;
                var action = submitter ? ($(submitter).attr('formaction') || '') : ($(this).attr('action') || '');
                if (action.indexOf('csv_export') !== -1) {
                    $('#bulk_form_token').val($('#csv_export_token_value').val());
                } else if (action.indexOf('bulk_update') !== -1) {
                    $('#bulk_form_token').val($('#bulk_update_token_value').val());
                } else {
                    $('#bulk_form_token').val($('#bulk_delete_token_value').val());
                }
            });
        });
    </script>
