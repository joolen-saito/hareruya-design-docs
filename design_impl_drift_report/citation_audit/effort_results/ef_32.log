namespace Eccube\Controller\Front;

use Eccube\Controller\AbstractController;
use Eccube\Repository\DtbEventDetailRepository;
use Eccube\Service\Front\Event\EventSearchChipBuilder;
use Eccube\Service\Front\Event\EventSearchInput;
use Symfony\Component\HttpFoundation\Request;
use Symfony\Component\HttpFoundation\Response;
use Symfony\Component\Routing\Attribute\Route;

/**
 * イベント検索結果一覧
 */
class EventSearchController extends AbstractController
{
    public function __construct(
        private readonly DtbEventDetailRepository $eventDetailRepository,
        private readonly EventSearchChipBuilder $chipBuilder,
    ) {
    }

    #[Route(path: '/events/list', name: 'event_search', methods: ['GET'])]
    public function index(Request $request): Response
    {
        $input = EventSearchInput::fromQuery($request->query->all());
        $now = new \DateTimeImmutable();

        $totalCount = $this->eventDetailRepository->countDetailsForFront($input, $now);
        $isOverLimit = $totalCount > EventSearchInput::MAX_RESULT_COUNT;
        $EventDetails = $isOverLimit ? [] : $this->eventDetailRepository->searchDetailsForFront($input, $now);

        $chips = $this->chipBuilder->build($input, $request->getLocale());
        $totalPages = $isOverLimit ? 0 : (int) ceil($totalCount / EventSearchInput::PER_PAGE);

        return $this->render('Event/list.twig', [
            'input' => $input,
            'EventDetails' => $EventDetails,
            'chips' => $chips,
            'totalCount' => $totalCount,
            'isOverLimit' => $isOverLimit,
            'currentPage' => $input->page,
            'totalPages' => $totalPages,
            'perPage' => EventSearchInput::PER_PAGE,
            'maxResultCount' => EventSearchInput::MAX_RESULT_COUNT,
        ]);
    }
}
