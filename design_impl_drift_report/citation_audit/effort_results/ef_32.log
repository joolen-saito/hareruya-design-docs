namespace Eccube\Form\Type\Admin;

use Doctrine\ORM\EntityRepository;
use Eccube\Entity\DtbArchetype;
use Eccube\Entity\Master\MtbColor;
use Eccube\Entity\Master\MtbDeckTag;
use Eccube\Entity\Master\MtbDisp;
use Eccube\Entity\Master\MtbFormat;
use Symfony\Bridge\Doctrine\Form\Type\EntityType;
use Symfony\Component\Form\AbstractType;
use Symfony\Component\Form\Extension\Core\Type\HiddenType;
use Symfony\Component\Form\Extension\Core\Type\TextareaType;
use Symfony\Component\Form\Extension\Core\Type\TextType;
use Symfony\Component\Form\FormBuilderInterface;
use Symfony\Component\OptionsResolver\OptionsResolver;
use Symfony\Component\Validator\Constraints as Assert;

class ArchetypeType extends AbstractType
{
    public function buildForm(FormBuilderInterface $builder, array $options): void
    {
        $builder
            ->add('nameJp', TextType::class, [
                'label' => 'admin.archetype.name_jp',
                'required' => true,
                'empty_data' => '',
                'constraints' => [
                    new Assert\NotBlank(),
                    new Assert\Length(['max' => 255]),
                ],
            ])
            ->add('nameEn', TextType::class, [
                'label' => 'admin.archetype.name_en',
                'required' => true,
                'empty_data' => '',
                'constraints' => [
                    new Assert\NotBlank(),
                    new Assert\Length(['max' => 255]),
                ],
            ])
            ->add('commentJp', TextareaType::class, [
                'label' => 'admin.archetype.comment_jp',
                'required' => false,
                'empty_data' => '',
                'constraints' => [
                    new Assert\Length(['max' => 1024]),
                ],
            ])
            ->add('commentEn', TextareaType::class, [
                'label' => 'admin.archetype.comment_en',
                'required' => false,
                'empty_data' => '',
                'constraints' => [
                    new Assert\Length(['max' => 1024]),
                ],
            ])
            ->add('cardImageId', HiddenType::class, [
                'mapped' => false,
                'required' => false,
            ])
            ->add('Disp', EntityType::class, [
                'class' => MtbDisp::class,
                'choice_label' => 'name',
                'label' => 'admin.archetype.disp',
                'required' => true,
                'empty_data' => ($options['data'] ?? null)?->getDisp(),
                'query_builder' => function (EntityRepository $er) {
                    return $er->createQueryBuilder('d')
                        ->where('d.id <> :limited')
                        ->setParameter('limited', MtbDisp::DISPLAY_LIMITED)
                        ->orderBy('d.rank', 'ASC');
                },
                'constraints' => [
                    new Assert\NotBlank(),
                ],
            ])
            ->add('Colors', EntityType::class, [
                'class' => MtbColor::class,
                'choice_label' => 'name_jp',
                'label' => 'admin.archetype.color',
                'required' => false,
                'multiple' => true,
                'expanded' => true,
            ])
            ->add('Format', EntityType::class, [
                'class' => MtbFormat::class,
                'choice_label' => 'name_jp',
                'label' => 'admin.archetype.format',
                'required' => true,
                'empty_data' => ($options['data'] ?? null)?->getFormat(),
                'query_builder' => function (EntityRepository $er) {
                    return $er->createQueryBuilder('f')
                        ->orderBy('f.rank', 'ASC')
                        ->addOrderBy('f.id', 'ASC');
                },
                'constraints' => [
                    new Assert\NotBlank(),
                ],
            ])
            ->add('DeckTags', EntityType::class, [
                'class' => MtbDeckTag::class,
                'choice_label' => 'nameJp',
                'label' => 'admin.archetype.deck_tag',
                'required' => false,
                'multiple' => true,
                'attr' => ['class' => 'select2-select'],
            ])
        ;
    }

    public function configureOptions(OptionsResolver $resolver): void
    {
        $resolver->setDefaults([
            'data_class' => DtbArchetype::class,
        ]);
    }

    public function getBlockPrefix(): string
    {
        return 'admin_archetype';
    }
}
