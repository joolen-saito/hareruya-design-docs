    /**
     * WordPressの投稿IDを検索条件として、記事情報を1件取得して返却するAPIエンドポイント
     *
     * @param Request $request
     *
     * @return JsonResponse
     */
    #[Route('/article.json', name: 'article_by_params', methods: ['GET'])]
    public function getSingleArticleByParamsAction(Request $request): JsonResponse
    {
        try {
            $wpPostIdParam = $request->query->get('wpPostId');
            if ($wpPostIdParam === null || $wpPostIdParam === '') {
                throw new MissingRequiredParameterException('wpPostIdは必須です');
            }

            if (!is_numeric($wpPostIdParam) || (int) $wpPostIdParam != $wpPostIdParam || (int) $wpPostIdParam < 1) {
                throw new InvalidParameterException('wpPostIdは正の整数である必要があります');
            }

            $Article = $this->dtbArticleRepository->findOneBy(['wpPostId' => (int) $wpPostIdParam]);
            if ($Article === null) {
                throw new NotFoundException('記事が見つかりません');
            }

            return $this->json($this->articleResponseBuilder->build($Article));
        } catch (BaseApiException $e) {
            // APIルートが/%eccube_api_v1_route%/ではなく、ExceptionListenerのエラーハンドリングが動作しないため、直接JSONを返す
            return $this->json([
                'code' => $e->getStatusCode(),
                'errors' => $e->getErrors(),
            ], $e->getStatusCode());
        }
    }

