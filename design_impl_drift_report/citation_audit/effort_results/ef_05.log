    {
        $targetOrderItemConditions = <<<SQL
            o.order_date >= :order_date_ts::timestamptz - INTERVAL '366 days'
            AND o.order_status_id NOT IN (:cancel_status, :processing_status)
            AND bi.is_open_shop = true
            AND oi.order_item_type_id = :product_item_type
            AND oi.product_class_id IS NOT NULL
            SQL;

        $hasSmaregiTransaction = <<<SQL
            o.smaregi_transaction_id IS NOT NULL
            AND o.smaregi_transaction_id != ''
            SQL;

        $isMergedSmaregiOrder = <<<SQL
            {$hasSmaregiTransaction}
            AND merged_order_ids.order_id IS NOT NULL
            SQL;

        $isSmaregiTransactionOrder = <<<SQL
            {$hasSmaregiTransaction}
            AND (o.smaregi_code IS NULL OR o.smaregi_code = '')
            AND merged_order_ids.order_id IS NULL
            SQL;

