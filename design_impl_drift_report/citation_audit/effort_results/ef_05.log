#[ORM\Table(name: 'dtb_stock_up_quantity')]
#[ORM\Entity(repositoryClass: DtbStockUpQuantityRepository::class)]
class DtbStockUpQuantity extends AbstractEntity
{
    // 期間別販売数 販売期間
    public const ORDER_QUANTITY_COLUMN_NUMBER_TODAY = '1';
    public const ORDER_QUANTITY_COLUMN_NUMBER_YESTERDAY = '2';
    public const ORDER_QUANTITY_COLUMN_NUMBER_3DAYS_AGO = '3';
    public const ORDER_QUANTITY_COLUMN_NUMBER_1WEEK_AGO = '4';
