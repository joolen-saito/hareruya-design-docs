    /**
/**
 * 期間別販売数集計バッチ（B02-01）
 *
 * 商品規格・店舗ごとに期間別の販売数を集計し、dtb_sales_quantity を更新する。
 * 現在は EC 受注のみ対象。スマレジ実店舗販売は未実装のため除外される。
 *
 * 【使い方】
 *
 *   bin/console eccube:aggregate-sales
 */
#[AsCommand(name: 'eccube:aggregate-sales', description: '期間別販売数集計バッチ')]
class AggregateSalesCommand extends Command
{
    public function __construct(private readonly BatchAggregateSalesAction $batchAggregateSalesAction)
    {
        parent::__construct();
    }

    #[\Override]
    protected function execute(InputInterface $input, OutputInterface $output): int
    {
        $io = new SymfonyStyle($input, $output);

        try {
            $this->batchAggregateSalesAction->handle();
        } catch (\Exception $e) {
            $io->error('集計処理でエラーが発生しました: '.$e->getMessage());

            return Command::FAILURE;
        }

        $io->success('期間別販売数集計が完了しました。');

        return Command::SUCCESS;
    }
}
        private readonly EntityManagerInterface $entityManager,
    ) {
    }

    /**
     * 期間別販売数を集計し dtb_sales_quantity を更新する。
     *
     * 商品規格・店舗・販売場所（ECCUBE/スマレジ）単位で集計する。
     *
     * @throws \Exception 集計処理で例外が発生した場合
     */
    public function handle(): void
    {
        $connection = $this->entityManager->getConnection();
        $connection->beginTransaction();
        try {
            // 集計前に既存の集計行を削除し、古い販売数が残らないようにする
            $this->salesQuantityRepository->clearSalesQuantityForAggregate();
            $this->salesQuantityRepository->insertSalesQuantityFromAggregate();
            $connection->commit();
        } catch (\Throwable $e) {
            $connection->rollBack();
            throw $e;
        }
    }
}
    /**
     * 集計用の既存行を削除する（base_info_id=0 の人気商品リコメンド行は除外）。
     *
     * 人気商品リコメンド行は CSV から投入され（{@see self::updateRecommend()}）集計バッチの管轄外なので消してはならない。
     */
    public function clearSalesQuantityForAggregate(): void
    {
        $this->getEntityManager()->getConnection()->executeStatement(
            'DELETE FROM dtb_sales_quantity WHERE base_info_id != :popular_shop_id',
            ['popular_shop_id' => self::POPULAR_PRODUCT_RECOMMEND_SHOP_ID]
        );
    }

    /**
     * 期間別販売数を集計し dtb_sales_quantity へ投入する。
     */
    public function insertSalesQuantityFromAggregate(?\DateTimeInterface $orderDate = null): void
    {
        $selectSql = $this->buildSalesForAggregateSql();
        $parameters = $this->buildSalesForAggregateParameters($orderDate);
        $parameters['update_date'] = (new \DateTime())->format('Y/m/d H:i:s');

        $this->getEntityManager()->getConnection()->executeStatement(
            <<<SQL
                INSERT INTO dtb_sales_quantity
                (
                    product_class_id,
                    base_info_id,
                    sales_location,
                    sales_quantity_01,
                    sales_quantity_02,
                    sales_quantity_03,
                    sales_quantity_04,
                    sales_quantity_05,
                    sales_quantity_06,
                    sales_quantity_07,
                    sales_quantity_08,
                    update_date
                )
                SELECT
                    aggregated.product_class_id,
                    aggregated.base_info_id,
                    aggregated.sales_location,
                    0,
                    aggregated.sales_yesterday,
                    aggregated.sales_3day,
                    aggregated.sales_weekly,
                    aggregated.sales_month,
                    aggregated.sales_90day,
                    aggregated.sales_180day,
                    aggregated.sales_365day,
                    :update_date
                FROM ({$selectSql}) aggregated
                SQL,
            $parameters
        );
    }

    /**
     * 人気商品リコメンド取得
     */
    public function getPopularProductRecommend(int $currentBaseInfoId, string $locale, int $limit = 30): mixed
    {
        // サブクエリ セール帯・通常版・日本語・非FOILを各キーとして優先表示
        $sqlPriority = <<<SQL
        CONCAT(
            CASE WHEN pc.sale_flg = :isSale THEN '1' ELSE '0' END,
            CASE WHEN pr.id = :nonPromotion THEN '1' ELSE '0' END,
            CASE WHEN l.id = :japanese THEN '1' ELSE '0' END,
            CASE WHEN cd.foil_flg = :nonFoil THEN '1' ELSE '0' END
        ) AS priority
        SQL;
        $priorities = $this->createQueryBuilder('sq')
            ->select(['pc.id AS productClassId', 'p.id AS productId', 'l.id AS languageId', $sqlPriority])
            ->innerJoin('sq.BaseInfo', 'bi')
            ->innerJoin('sq.ProductClass', 'pc')
            ->innerJoin('pc.Product', 'p')
            ->innerJoin('pc.Language', 'l')
            ->innerJoin('pc.ProductStock', 'ps')
            ->innerJoin('ps.baseInfo', 'psbi')
            ->innerJoin('p.CardDetail', 'cd')
            ->innerJoin('cd.Card', 'c')
            ->innerJoin('cd.Promotion', 'pr')
            ->where('bi.id = :baseInfoId')
            ->andWhere('psbi.id = :currentBaseInfoId')
            ->andWhere('ps.stock > 0')
            ->setParameter('baseInfoId', self::POPULAR_PRODUCT_RECOMMEND_SHOP_ID)
            ->setParameter('currentBaseInfoId', $currentBaseInfoId)
            ->setParameter('isSale', ProductClass::SALE)
            ->setParameter('japanese', MtbLanguage::JP_ID)
            ->setParameter('nonPromotion', MtbPromotion::NON_PROMOTION_ID)
            ->setParameter('nonFoil', MtbCardDetail::NON_FOIL)
            ->orderBy('priority', 'ASC')
            ->getQuery()
            ->getResult();

        $targetProductId = [];
        foreach ($priorities as $priority) {
            // priorityの昇順で並んだものを上書きするので、最終的に最もpriority高いものが残る
