    41	    #[Template(template: '@admin/Data/discount.twig')]
    42	    public function index(Request $request): array
    43	    {
    44	        $event = new EventArgs([], $request);
    45	        $this->eventDispatcher->dispatch($event, EccubeEvents::ADMIN_DATA_DISCOUNT_INDEX_INITIALIZE);
    46	
    47	        $CardConditions = $this->cardConditionRepository->findAll();
    48	        $Discounts = $this->discountRepository->findBy([], ['id' => 'ASC']);
    49	        $DiscountCardConditions = $this->discountCardConditionRepository->findAll();
    50	
    51	        $discountMap = [];
    52	        foreach ($DiscountCardConditions as $DiscountCardCondition) {
    53	            $discountMap[$DiscountCardCondition->getCardConditionId()][$DiscountCardCondition->getDiscountId()] = $DiscountCardCondition->getRate();
    54	        }
    55	
    56	        return [
    57	            'CardConditions' => $CardConditions,
    58	            'Discounts' => $Discounts,
    59	            'discountMap' => $discountMap,
    60	        ];
    61	    }
    62	}
