namespace Eccube\EventListener;

use Eccube\Common\EccubeConfig;
use Symfony\Component\EventDispatcher\EventSubscriberInterface;
use Symfony\Component\HttpFoundation\RedirectResponse;
use Symfony\Component\HttpFoundation\Response;
use Symfony\Component\HttpKernel\Event\ViewEvent;
use Symfony\Component\HttpKernel\KernelEvents;
use Twig\Environment;

/**
 * locale付きテンプレートが存在しない場合、そのロケールのTOPへリダイレクトするリスナー
 *
 * アクセスしたロケールのテンプレート（例: Product/list.en.twig）が存在しない場合、
 * そのロケールのTOPページへ301リダイレクトを行う。
 *
 * TOPページのテンプレート（例: index.en.twig）が存在しない場合は、
 * リダイレクトループを避けるためデフォルトロケールのTOPへリダイレクトする。
 *
 * 例: /en/products/list（list.en.twigがない場合） → /en/
 * 例: /en/（index.en.twigがない場合） → /ja/
 */
class MissingLocaleTemplateRedirectListener implements EventSubscriberInterface
{
    private readonly string $defaultLocale;
    private readonly string $adminRoute;

    public function __construct(EccubeConfig $eccubeConfig, private readonly Environment $twig)
    {
        $this->defaultLocale = $eccubeConfig->get('locale') ?? 'ja';
        $this->adminRoute = $eccubeConfig->get('eccube_admin_route') ?? '';
    }

    #[\Override]
    public static function getSubscribedEvents(): array
    {
        return [
            KernelEvents::VIEW => ['onKernelView', 10],
        ];
    }

    public function onKernelView(ViewEvent $event): void
    {
        if (!$event->isMainRequest()) {
            return;
        }

        $request = $event->getRequest();
        $locale = $request->getLocale();

        // デフォルトロケール（ja）の場合は何もしない
        if ($locale === $this->defaultLocale) {
            return;
        }

        // 管理画面の場合は何もしない
        $route = $request->get('_route') ?? '';
        if ($this->adminRoute && str_starts_with((string) $route, 'admin_')) {
            return;
        }

        // テンプレートアノテーションが設定されていない場合は何もしない
        $templateAttr = $request->get('_template');
        if ($templateAttr === null) {
            return;
        }

        $templateName = $templateAttr->template;
        $templateNameWithoutExtension = preg_replace('/\.twig$/', '', $templateName);
        $templateNameWithLocale = "{$templateNameWithoutExtension}.{$locale}.twig";

        $loader = $this->twig->getLoader();

        // locale付きテンプレートが存在する場合は何もしない
        if ($loader->exists($templateNameWithLocale)) {
            return;
        }

        // TOPページの場合はリダイレクトループを避けるためデフォルトロケールへリダイレクト
        // その他のページはそのlocaleのTOPへリダイレクト
        $redirectLocale = ($route === 'homepage')
            ? $this->defaultLocale
            : $locale;

        $event->setResponse(new RedirectResponse('/'.$redirectLocale.'/', Response::HTTP_MOVED_PERMANENTLY));
    }
}

