    const COMMON_BRANCH_ID = {{ common_branch_id }};

    function updateCommonSettingState() {
        const branchId = $selector.val() || {{ selected_branch_id }};
        const $commonSetting = $('#common-setting');

        if (Number(branchId) === COMMON_BRANCH_ID) {
            $commonSetting.prop('disabled', true);
        } else {
            $commonSetting.prop('disabled', false);
        }
