namespace Eccube\Twig\Extension;

use Eccube\Common\EccubeConfig;
use Eccube\Entity\Member;
use Eccube\Repository\AuthorityRoleRepository;
use Symfony\Bundle\SecurityBundle\Security;
use Symfony\Component\Routing\Generator\UrlGeneratorInterface;
use Twig\Extension\AbstractExtension;
use Twig\TwigFunction;

class IsAccessibleRouteExtension extends AbstractExtension
{
    public function __construct(
        private readonly UrlGeneratorInterface $router,
        private readonly Security $security,
        private readonly AuthorityRoleRepository $authorityRoleRepository,
        private readonly EccubeConfig $eccubeConfig,
    ) {
    }

    /**
     * Twig関数を返します.
     *
     * @return TwigFunction[]
     */
    #[\Override]
    public function getFunctions(): array
    {
        return [
            new TwigFunction('is_accessable_route', $this->isAccessibleRoute(...)),
        ];
    }

    /**
     * ユーザーがアクセス可能なルートかどうかを判定します.
     */
    public function isAccessibleRoute(string $routeName): bool
    {
        $Member = $this->security->getUser();
        if (!$Member instanceof Member) {
            return false;
        }

        /** @phpstan-ignore-next-line $routeCollection - phpstanにgetRouteCollection関数は存在していないと言われているけど、存在している */
        $routeCollection = $this->router->getRouteCollection();
        $route = $routeCollection->get($routeName);
        if ($route === null) {
            return true;
        }

        $path = $route->getPath();
        $AuthorityRoles = $this->authorityRoleRepository->findBy(['Authority' => $Member->getAuthority()]);
        $adminRoute = $this->eccubeConfig->get('eccube_admin_route');

        foreach ($AuthorityRoles as $AuthorityRole) {
            // 許可しないURLが含まれていればアクセス拒否
            try {
                // denyUrlの\d+をプレースホルダー{id}等にもマッチするよう変換し、正規表現でURLチェック
                // AuthorityVoterとは違い、{id}等のプレースホルダーが含まれている場合があるためマッチするように変換
                $denyUrl = str_replace(['\\d+', '/'], ['(\\d+|\\{[^}]+\\})', '\\/'], $AuthorityRole->getDenyUrl());
                if (preg_match("/^(\\/{$adminRoute}{$denyUrl})/i", (string) $path)) {
                    return false;
                }
            } catch (\Exception) {
                // 拒否URLの指定に誤りがある場合、エスケープさせてチェック
                $denyUrl = preg_quote((string) $AuthorityRole->getDenyUrl(), '/');
                if (preg_match("/^(\\/{$adminRoute}{$denyUrl})/i", (string) $path)) {
                    return false;
                }
            }
        }

        return true;
    }
}

