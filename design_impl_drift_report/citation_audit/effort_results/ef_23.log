     */
    #[Route(path: '/%eccube_admin_route%/content/branch_toppage', name: 'admin_content_branch_toppage', methods: ['GET'])]
    #[Template(template: '@admin/Content/branch_toppage.twig')]
    public function index(Request $request): array|RedirectResponse
    {
        $BaseInfo = $this->baseInfoRepository->getMallBaseInfo();
        $builder = $this->formFactory->createBuilder(BranchTopPageManagementType::class, $BaseInfo, [
            'selected_base_info_id' => $BaseInfo->getId(),
        ]);

        $event = new EventArgs(
            [
                'builder' => $builder,
                'BaseInfo' => $BaseInfo,
            ],
            $request
        );
        $this->eventDispatcher->dispatch($event, EccubeEvents::ADMIN_CONTENT_BRANCH_TOP_PAGE_INDEX_INITIALIZE);

        $form = $builder->getForm();
        $form->get('branch_list')->setData($BaseInfo);

        return $this->buildPage($BaseInfo, $form);
    }

    /**
     * 支店トップページ管理の支店選択
     *
     * @param Request $request
     *
     * @return Response
     */
    #[Route(path: '/%eccube_admin_route%/content/branch_toppage/select', name: 'admin_content_branch_toppage_select', methods: ['POST'])]
    public function select(Request $request): Response
    {
        $BaseInfo = $this->resolvePostedBaseInfo($request, false);

        $event = new EventArgs(
            [
                'BaseInfo' => $BaseInfo,
            ],
            $request
        );
        $this->eventDispatcher->dispatch($event, EccubeEvents::ADMIN_CONTENT_BRANCH_TOP_PAGE_SELECT_COMPLETE);

        return $this->renderPage($BaseInfo);
    }

    /**
