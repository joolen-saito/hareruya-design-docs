    public function index(Request $request, PaginatorInterface $paginator, Customer $Customer): RedirectResponse|array
    {
        $this->entityManager->getFilters()->enable('incomplete_order_status_hidden');

        $oldStatusId = $Customer->getStatus()->getId();
        // スマレジ連携対象（氏名・カナ・電話番号）の変更検知用に、フォーム束縛前の値を控える。
        $smaregiFieldSnapshot = [
            $Customer->getName01(),
            $Customer->getName02(),
            $Customer->getKana01(),
            $Customer->getKana02(),
            $Customer->getTel01(),
            $Customer->getTel02(),
            $Customer->getTel03(),
        ];
        $Customer->setPlainPassword($this->eccubeConfig['eccube_default_password']);

        // 会員登録フォーム
        $builder = $this->formFactory
            ->createBuilder(CustomerType::class, $Customer);

        $event = new EventArgs(
            [
                'builder' => $builder,
                'Customer' => $Customer,
            ],
            $request
        );
        $this->eventDispatcher->dispatch($event, EccubeEvents::ADMIN_CUSTOMER_EDIT_INDEX_INITIALIZE);

        $form = $builder->getForm();

        $form->handleRequest($request);
        $page_count = (int) $this->session->get(
            'eccube.admin.customer_edit.order.page_count',
            $this->eccubeConfig->get('eccube_default_page_count')
        );

        $page_count_param = (int) $request->get('page_count');
        $pageMaxis = $this->pageMaxRepository->findAll();

        if ($page_count_param) {
            foreach ($pageMaxis as $pageMax) {
                if ($page_count_param == $pageMax->getName()) {
                    $page_count = $pageMax->getName();
                    $this->session->set('eccube.admin.customer_edit.order.page_count', $page_count);
                    break;
                }
            }
        }
        $page_no = (int) $request->get('page_no', 1);
        $qb = $this->orderRepository->getQueryBuilderByCustomer($Customer);
        $pagination = [];
        if (!is_null($Customer->getId())) {
            $pagination = $paginator->paginate(
                $qb,
                $page_no > 0 ? $page_no : 1,
                $page_count
            );
        }

        // 買取履歴
        $pageCountBuyOrder = (int) $this->session->get(
            'eccube.admin.customer_edit.buy.order.page_count',
            $this->eccubeConfig->get('eccube_default_page_count')
        );

        $pageCountParamBuyOrder = (int) $request->get('page_count_buy_order');
        if ($pageCountParamBuyOrder) {
            foreach ($pageMaxis as $pageMax) {
                if ($pageCountParamBuyOrder == $pageMax->getName()) {
                    $pageCountBuyOrder = $pageMax->getName();
                    $this->session->set('eccube.admin.customer_edit.buy.order.page_count', $pageCountBuyOrder);
                    break;
                }
            }
        }

        $pageNoBuyOrder = (int) $request->get('page_no_buy_order', 1);
        $qbBuyOrder = $this->dtbBuyOrderRepository->getQueryBuilderByCustomer($Customer);
        $paginationBuyOrder = [];
        if (!is_null($Customer->getId())) {
            $paginationBuyOrder = $paginator->paginate(
                $qbBuyOrder,
                $pageNoBuyOrder > 0 ? $pageNoBuyOrder : 1,
                $pageCountBuyOrder
            );
        }

        if ($form->isSubmitted() && $form->isValid()) {
            log_info('会員登録開始', [$Customer->getId()]);

            if ($Customer->getPlainPassword() !== $this->eccubeConfig['eccube_default_password']) {
                $password = $this->passwordHasher->hashPassword($Customer, $Customer->getPlainPassword());
                $Customer->setPassword($password);
            }

            // 退会ステータスに更新の場合、ダミーのアドレスに更新
            $newStatusId = $Customer->getStatus()->getId();
            $isWithdrawing = $oldStatusId !== $newStatusId && $newStatusId === CustomerStatus::WITHDRAWING;
            if ($isWithdrawing) {
                $Customer->setEmail(StringUtil::random(60).'@dummy.dummy');
            }

            $Player = $Customer->getPlayer();
            $Player->setEmail($Customer->getEmail());

            $this->entityManager->persist($Player);

            $this->entityManager->persist($Customer);

            // スマレジ連携対象（氏名・カナ・電話番号）が変わった場合のみ、会員情報更新を非同期連携する。
            // 退会遷移時は連携しない（会員削除は退会フローで扱う）。EC 更新と同一トランザクションでジョブを積み、
            // flush（commit）後に dispatch する（アウトボックス的な順序）。
            $isSmaregiFieldChanged = $smaregiFieldSnapshot !== [
                $Customer->getName01(),
                $Customer->getName02(),
                $Customer->getKana01(),
                $Customer->getKana02(),
                $Customer->getTel01(),
                $Customer->getTel02(),
                $Customer->getTel03(),
            ];
            $smaregiUpdateJob = ($isSmaregiFieldChanged && !$isWithdrawing)
                ? $this->smaregiCustomerUpdateEventService->registerUpdateJob($Customer)
                : null;

            $this->entityManager->flush();

            if ($smaregiUpdateJob !== null) {
                $this->smaregiCustomerUpdateEventService->dispatchUpdateMessage($smaregiUpdateJob, $Customer);
            }

            log_info('会員登録完了', [$Customer->getId()]);

            $event = new EventArgs(
                [
                    'form' => $form,
                    'Customer' => $Customer,
                ],
                $request
            );
            $this->eventDispatcher->dispatch($event, EccubeEvents::ADMIN_CUSTOMER_EDIT_INDEX_COMPLETE);

            $this->addSuccess('admin.common.save_complete', 'admin');

            return $this->redirectToRoute('admin_customer_edit', [
                'id' => $Customer->getId(),
            ]);
        }

        return [
            'form' => $form->createView(),
            'Customer' => $Customer,
            'pagination' => $pagination,
            'pageMaxis' => $pageMaxis,
            'page_no' => $page_no,
            'page_count' => $page_count,
            'paginationBuyOrder' => $paginationBuyOrder,
            'pageNoBuyOrder' => $pageNoBuyOrder,
            'pageCountBuyOrder' => $pageCountBuyOrder,
        ];
    }

    #[Route('/%eccube_admin_route%/customer/{id}/identification/complete', name: 'admin_customer_identification_complete', requirements: ['id' => '\d+'], methods: ['POST'])]
    public function completeIdentification(Request $request, PaginatorInterface $paginator, Customer $Customer): RedirectResponse
    {
        // 身分証有効期限の値を取得
        $paramIdExpirationDate = $request->request->get('id_expiration_date');

        if (!empty($paramIdExpirationDate)) {
            try {
                $date = new \DateTime($paramIdExpirationDate);
            } catch (\Exception) {
                $this->addError('admin.customer.id_expiration_date.error', 'admin');

                return $this->redirectToRoute('admin_customer_edit', [
                    'id' => $Customer->getId(),
                ]);
            }
            $idExpirationDate = $date;
        } else {
            $idExpirationDate = null;
        }

        $Player = $Customer->getPlayer();
        /** @var MtbIdentityConfirmStatus|null $IdentityConfirmedStatus */
        $IdentityConfirmedStatus = $this->mtbIdentityConfirmStatusRepository->find(MtbIdentityConfirmStatus::STATUS_CONFIRMED);

        if ($IdentityConfirmedStatus === null) {
            $this->addError('admin.common.system_error', 'admin');

            return $this->redirectToRoute('admin_customer_edit', [
                'id' => $Customer->getId(),
            ]);
        }

        if ($Player === null) {
            $this->addError('admin.common.system_error', 'admin');

            return $this->redirectToRoute('admin_customer_edit', [
                'id' => $Customer->getId(),
            ]);
        }

        $this->playerEntityManager->save(
            $Player,
            $Player->getDciNo(),
            $Player->getEmail(),
            $Player->getFirstNameJp(),
            $Player->getFirstNameEn(),
            $Player->getLastNameJp(),
            $Player->getLastNameEn(),
            $Player->getCustomer(),
            $Player->getIdentificationFlg(),
            $Player->getCustomerGroup(),
            $Player->getMailMagazineFlg(),
            $Player->getPoint(),
            $Player->getSmaregiId(),
            $Player->getPointContactNumber(),
            $Player->getPointTransferFlg(),
            $Player->getPointLinkedFailureCount(),
            $Player->getExistsSmaregiFlg(),
            $IdentityConfirmedStatus,
            $Player->getNickname(),
            $Player->getDeckUserId(),
            $Player->getProfile(),
            $idExpirationDate,
            $Player->getIdentification(),
        );
        $this->entityManager->flush();

        $event = new EventArgs(
            [
                'Customer' => $Customer,
            ],
            $request
        );
        $this->eventDispatcher->dispatch($event, EccubeEvents::ADMIN_CUSTOMER_EDIT_IDENTIFICATION_COMPLETE);

        $this->addSuccess('admin.common.save_complete', 'admin');

        return $this->redirectToRoute('admin_customer_edit', [
            'id' => $Customer->getId(),
        ]);
    }

