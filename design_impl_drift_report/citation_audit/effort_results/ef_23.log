namespace Eccube\Controller\Admin\Content;

use Eccube\Controller\AbstractController;
use Eccube\Entity\Page;
use Eccube\Entity\PageLayout;
use Eccube\Event\EccubeEvents;
use Eccube\Event\EventArgs;
use Eccube\Exception\CloudFileAccessedBeforeMergeException;
use Eccube\Form\Type\Admin\MainEditType;
use Eccube\Repository\Master\DeviceTypeRepository;
use Eccube\Repository\PageLayoutRepository;
use Eccube\Repository\PageRepository;
use Eccube\Service\Upload\FileManager;
use Eccube\Util\CacheUtil;
use Eccube\Util\StringUtil;
use Symfony\Bridge\Twig\Attribute\Template;
use Symfony\Component\Filesystem\Filesystem;
use Symfony\Component\HttpFoundation\RedirectResponse;
use Symfony\Component\HttpFoundation\Request;
use Symfony\Component\HttpKernel\Exception\NotFoundHttpException;
use Symfony\Component\Routing\Attribute\Route;
use Symfony\Component\Routing\RouterInterface;
use Twig\Environment;
use Twig\Error\LoaderError;

class PageController extends AbstractController
{
    /**
     * デフォルトで登録されているページの場合のパス
     */
    public const DEFAULT_PAGE_PATH = '/app/template/default/';

    /**
     * 新規に追加されたページの場合のパス
     */
    public const USER_DATA_PAGE_PATH = '/app/template/user_data/';

    /**
     * PageController constructor.
     */
    public function __construct(protected PageRepository $pageRepository, protected PageLayoutRepository $pageLayoutRepository, protected DeviceTypeRepository $deviceTypeRepository, protected FileManager $fileManager)
    {
    }

    /**
     * @return array<string, mixed>
     */
    #[Route(path: '/%eccube_admin_route%/content/page', name: 'admin_content_page', methods: ['GET'])]
    #[Template(template: '@admin/Content/page.twig')]
    public function index(Request $request, RouterInterface $router): array
    {
        $Pages = $this->pageRepository->getPageList();

        $event = new EventArgs(
            [
                'Pages' => $Pages,
            ],
            $request
        );
        $this->eventDispatcher->dispatch($event, EccubeEvents::ADMIN_CONTENT_PAGE_INDEX_COMPLETE);

        return [
            'Pages' => $Pages,
            'router' => $router,
        ];
    }

    /**
     * @param string|null $id
     *
     * @return RedirectResponse|array<string, mixed>
     *
     * @throws CloudFileAccessedBeforeMergeException
     * @throws LoaderError
     */
    #[Route(path: '/%eccube_admin_route%/content/page/new', name: 'admin_content_page_new', methods: ['GET', 'POST'])]
    #[Route(path: '/%eccube_admin_route%/content/page/{id}/edit', name: 'admin_content_page_edit', requirements: ['id' => '\d+'], methods: ['GET', 'POST'])]
    #[Template(template: '@admin/Content/page_edit.twig')]
    public function edit(Request $request, Environment $twig, RouterInterface $router, CacheUtil $cacheUtil, $id = null): RedirectResponse|array
    {
        // URLクエリーに付与されているlocaleパラメータのバリデーション (デフォルト: ja)
        $locale = $request->query->get('locale', 'ja');
        if (!in_array($locale, $this->getParameter('kernel.enabled_locales'), true)) {
            throw new NotFoundHttpException();  // localeパラメータがjaでもenでもなければ404ページ表示
        }
        // 日本語は.jaなし（例: foo.twig）、英語は.en付き（例: foo.en.twig）
        $localeSuffix = $locale === 'ja' ? '' : '.'.$locale;
        $this->addInfoOnce('admin.common.restrict_file_upload_info', 'admin');

        if (null === $id) {
            $Page = $this->pageRepository->newPage();
        } else {
            $Page = $this->pageRepository->find($id);
            if ($Page == null) {
                throw new NotFoundHttpException();
            }
        }

        // フォーム生成前に isUserDataPage を確定する
        $isUserDataPage = !($id && $Page->getEditType() >= Page::EDIT_TYPE_DEFAULT);

        $builder = $this->formFactory
            ->createBuilder(MainEditType::class, $Page, [
                'is_user_data_page' => $isUserDataPage,
            ]);

        $event = new EventArgs(
            [
                'builder' => $builder,
                'Page' => $Page,
            ],
            $request
        );
        $this->eventDispatcher->dispatch($event, EccubeEvents::ADMIN_CONTENT_PAGE_EDIT_INITIALIZE);

        $form = $builder->getForm();

        // 更新時
        $fileName = null;
        $namespace = $isUserDataPage ? '@user_data/' : '';
        $PrevPage = clone $Page;
        if ($id) {
            // 編集対象ページに付与するlocale対応のファイル名を生成
            $baseFileName = $Page->getFileName();
            $localeFileName = $baseFileName.$localeSuffix;

            // 上で生成したファイル名のtwigファイルが存在するか探す
            try {
                $source = $twig->getLoader()->getSourceContext($namespace.$localeFileName.'.twig')->getCode();
            } catch (LoaderError $e) {
                // 上で生成したファイル名のtwigファイルが存在しない場合、EC-CUBEデフォルトのtwigファイルを読み込む
                try {
                    $source = $twig->getLoader()->getSourceContext($namespace.$baseFileName.'.twig')->getCode();
                } catch (LoaderError $e2) {
                    // ページが新規作成されたばかりの場合、ファイルが存在しないためエラーになる
                    if (new \DateTime('-2 minutes') < $Page->getCreateDate()) {
                        throw new CloudFileAccessedBeforeMergeException($e2->getMessage());
                    }
                    // ファイルが存在しない場合は空欄で編集画面を表示する
                    $source = '';
                }
            }

            $form->get('tpl_data')->setData($source);

            $fileName = $Page->getFileName();
        } elseif ($request->getMethod() === 'GET' && !$form->isSubmitted()) {
            $source = $twig->getLoader()
                ->getSourceContext('@admin/empty_page.twig')
                ->getCode();
            $form->get('tpl_data')->setData($source);
        }

        $form->handleRequest($request);

        if ($form->isSubmitted() && $form->isValid()) {
            $Page = $form->getData();

            if (!$isUserDataPage) {
                $Page
                    ->setUrl($PrevPage->getUrl())
                    ->setFileName($PrevPage->getFileName())
                    ->setName($Page->getName());
            }

            $Page->setDefaultFileName($Page->getFileName());

            if ($PrevPage->getId() == null || $Page->getFileName() == $PrevPage->getFileName()) {
                $nameChangeFlg = false;
            } else {
                $nameChangeFlg = true;
                $oldfileName = $PrevPage->getFileName().$localeSuffix.'.twig';
            }
            // DB登録
            $this->entityManager->persist($Page);
            $this->entityManager->flush();

            // ファイル生成・更新
            if ($isUserDataPage) {
                $templatePath = $this->getParameter('eccube_theme_user_data_dir');
                $s3_path = $this::USER_DATA_PAGE_PATH;
            } else {
                $templatePath = $this->getParameter('eccube_theme_front_dir');
                $s3_path = $this::DEFAULT_PAGE_PATH;
            }
            // 編集対象ページに付与するlocale対応のファイル名を生成
            $localeFileName = $Page->getFileName().$localeSuffix;
            $filePath = $templatePath.'/'.$localeFileName.'.twig';

            $fs = new Filesystem();
            $pageData = $form->get('tpl_data')->getData();
            $pageData = StringUtil::convertLineFeed($pageData);
            $fileAdapter = $this->fileManager->getAdapter();
            $contentBucketOptions = $this->fileManager->getContentBucketOptions();

            // 既存ページでコードが変更されていない場合はtwigファイルへのダンプをスキップ
            // $pageData はSymfonyのtrimにより末尾空白が除去されているため、$source側も同様にtrimして比較する
            $isCodeChanged = $PrevPage->getId() === null || !isset($source) || $pageData !== trim(StringUtil::convertLineFeed($source));

            if ($isCodeChanged) {
                $fs->dumpFile($filePath, $pageData);

                // localstackへデータを登録（locale対応ファイル名）
                $filename = $Page->getDefaultFileName().$localeSuffix.'.twig';
                $localFilePath = $templatePath.'/'.$Page->getDefaultFileName().$localeSuffix.'.twig';

                // localstackへデータを保存
                $fileAdapter
                    ->upload(
                        $localFilePath,
                        $s3_path,
                        $filename,
                        $contentBucketOptions);

                $Page->saveFile($fileAdapter->toEntitySaveData());
                $this->entityManager->flush();

                // 新規ページ作成時は、もう一方のlocaleファイルも同じ内容で作成する
                if ($PrevPage->getId() === null) {
                    $otherLocale = $locale === 'ja' ? 'en' : 'ja';
                    $otherLocaleSuffix = $otherLocale === 'ja' ? '' : '.'.$otherLocale;
                    $otherLocaleFileName = $Page->getDefaultFileName().$otherLocaleSuffix.'.twig';
                    $otherFilePath = $templatePath.'/'.$otherLocaleFileName;
                    $fs->dumpFile($otherFilePath, $pageData);
                    $fileAdapter->upload($otherFilePath, $s3_path, $otherLocaleFileName, $contentBucketOptions);
                }
            }

            // 更新でファイル名を変更した場合、以前のファイルを削除（locale付きファイル）
            if ($nameChangeFlg) {
                $oldLocaleFileName = $PrevPage->getFileName().$localeSuffix;
                if ($fileAdapter->exists($s3_path.$oldLocaleFileName.'.twig', $contentBucketOptions)) {
                    $fileAdapter->delete($s3_path.$oldLocaleFileName.'.twig', $contentBucketOptions);
                } else {
                    log_error($s3_path.$oldLocaleFileName.'.twig はS3に存在しません');
                }


exec
