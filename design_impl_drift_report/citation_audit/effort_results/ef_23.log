                        || $('#admin_customer_address_pref').val() !== '{{ form.address.pref.vars.value|e('js') }}'
                        || $('#admin_customer_address_addr01').val() !== '{{ form.address.addr01.vars.value|e('js') }}'
                        || $('#admin_customer_address_addr02').val() !== '{{ form.address.addr02.vars.value|e('js') }}'
                        || $('#admin_customer_address_addr03').val() !== '{{ form.address.addr03.vars.value|e('js') }}'
                    )
                ) {
                    return true;
                }

                // 本人ステータスが「確認済み」の場合、名前・誕生日が変更されていたらtrue
                return ('{{ form.Player.IdentityConfirmStatus.vars.value }}' === identityConfirmStatusConfirmed)
                    &&
                    (
                        $('#admin_customer_name_name01').val() !== '{{ form.name.name01.vars.value|e('js') }}'
                        || $('#admin_customer_name_name02').val() !== '{{ form.name.name02.vars.value|e('js') }}'
                        || $('#admin_customer_kana_kana01').val() !== '{{ form.kana.kana01.vars.value|e('js') }}'
                        || $('#admin_customer_kana_kana02').val() !== '{{ form.kana.kana02.vars.value|e('js') }}'
                        || $('#admin_customer_birth').val() !== '{{ form.birth.vars.value|e('js') }}'
                    );
            }

            $('#submit_confirm').click(function(event) {
                event.preventDefault();
                let form = $('<form>', {
                    'method': 'POST',
                    'action': $(this).attr('href')
                });
                form.append($('<input>', {
                    'type': 'hidden',
                    'name': 'id_expiration_date',
                    'value': $('input[name="admin_customer[Player][id_expiration_date]"]').val()
                }));
                $('body').append(form);
                form.submit();
            });
        });
    </script>
{% endblock javascript %}

{% block main %}
    <link rel="stylesheet" href="{{ asset('assets/css/customer.css', 'admin') }}">
    <div class="modal fade modal-online_identification" id="online_identification_detail" tabindex="-1" role="dialog" aria-labelledby="online_identification_detail" aria-hidden="true">
        <div class="modal-dialog" role="document">
            <div class="modal-content">
                <div class="modal-body text-start">
                    <h5 class="modal-title fw-bold">{{ 'admin.customer.online_identification'|trans }}</h5>
                </div>
                    <div class="c-contentsArea__primaryCol modal-top-border">
                        <div class="c-primaryCol">
                            <div class="card rounded border-0">
                </div>
                <div class="modal-footer">
                    <button class="btn btn-ec-sub" type="button" data-bs-dismiss="modal">{{ 'admin.customer.identification.cancel'|trans }}</button>
                    <a href="{{ path('admin_customer_identification_complete', {'id': Customer.id}) }}" class="btn btn-ec-conversion" id="submit_confirm">
                        {{ 'admin.customer.identification.update'|trans }}
                    </a>
                </div>
            </div>
        </div>
    </div>
    <form name="customer_form" role="form" id="customer_form" method="post" class="h-adr"
          action="{{ url('admin_customer_edit', { id : Customer.id }) }}"
          novalidate>
        <span class="p-country-name" style="display:none;">Japan</span>
        {{ form_widget(form._token) }}
        <div class="c-contentsArea__cols">
            <div class="c-contentsArea__primaryCol">
                <div class="c-primaryCol">
                    <div class="card rounded border-0 mb-4">
                        <div class="card-header">
                            <div class="row">
                                <div class="col-8"><span class="card-title">{{ 'admin.customer.customer_info'|trans }}</span>
                                </div>
                                <div class="col-4 text-end">
                                    <a data-bs-toggle="collapse" href="#ordererInfo"
                                       aria-expanded="false" aria-controls="ordererInfo">
                                        <i class="fa fa-angle-up fa-lg"></i>
                                    </a>
                                </div>
                            </div>
                        </div>
                        <div class="collapse show ec-cardCollapse" id="ordererInfo">
                            <div class="card-body">
                                {% if Customer.id %}
                                    <div class="row mb-2">
                                        <div class="col-3">
                                            <div class="d-inline-block" data-bs-toggle="tooltip" data-bs-placement="top"
                                                 title="{{ 'tooltip.customer.customer_id'|trans }}">
                                                <span>{{ 'admin.customer.customer_id'|trans }}</span>
                                                <i class="fa fa-question-circle fa-lg ms-1"></i>
                                            </div>
                                        </div>
                                        <div class="col">
                                            <p>{{ Customer.id }}</p>
                                        </div>
                                    </div>
                                {% endif %}
                                <div class="row mb-2">
                                    <div class="col-3">
                                        <span>{{ 'admin.common.name'|trans }}</span>
                                        <span class="badge bg-primary ms-1">{{ 'admin.common.required'|trans }}</span>
                                    </div>
                                    <div class="col">
                                        <div class="row">
                                            <div class="col">
                                                {{ form_widget(form.name.name01) }}
                                            </div>
                                            <div class="col">
                                                {{ form_widget(form.name.name02) }}
                                            </div>
                                        </div>
                                        <div class="row">
                                            <div class="col">
                                                {{ form_errors(form.name.name01) }}
                                            </div>
                                            <div class="col">
                                                {{ form_errors(form.name.name02) }}
                                            </div>
                                        </div>
                                    </div>
                                </div>
                                <div class="row mb-2">
                                    <div class="col-3">
                                        <span>{{ 'admin.common.kana'|trans }}</span>
                                        <span class="badge bg-primary ms-1"></span>
                                    </div>
                                    <div class="col">
                                        <div class="row">
                                            <div class="col">
                                                {{ form_widget(form.kana.kana01) }}
                                            </div>
                                            <div class="col">
                                                {{ form_widget(form.kana.kana02) }}
                                            </div>
                                        </div>
                                        <div class="row">
                                            <div class="col">
                                                {{ form_errors(form.kana.kana01) }}
                                            </div>
                                            <div class="col">
                                                {{ form_errors(form.kana.kana02) }}
                                            </div>
                                        </div>
                                    </div>
                                </div>
                                <div class="row mb-2">
                                    <div class="col-3">
                                        <span>{{ 'admin.common.company_name'|trans }}</span>
                                    </div>
                                    <div class="col">
                                        {{ form_widget(form.company_name) }}
                                        {{ form_errors(form.company_name) }}
                                    </div>
                                </div>
                                <div class="row mb-2">
                                    <div class="col-3"><span>{{ 'admin.common.address'|trans }}</span><span
                                                class="badge bg-primary ms-1">{{ 'admin.common.required'|trans }}</span>
                                    </div>
                                    <div class="col">
                                        <div class="mb-3 col-12">
                                            <div class="col-auto">
                                                {{ form_widget(form.country) }}
                                                {{ form_errors(form.country) }}
                                            </div>
                                        </div>
                                        <div class="mb-2">
                                            <div class="row justify-content-start">
                                                <div class="col-auto pe-0 align-self-center"><span>{{ 'admin.common.postal_symbol'|trans }}</span></div>
                                                <div class="col-1">
                                                    {{ form_widget(form.postalCode.postalCode01) }}
                                                </div>
                                                -
                                                <div class="col-1">
                                                    {{ form_widget(form.postalCode.postalCode02) }}
                                                </div>
                                                <div class="col-3">
                                                    <span><button type="button" id="zip-search" class="btn btn-ec-conversion px-1 ladda-button">郵便番号から自動入力</button></span>
                                                </div>
                                            </div>
                                        </div>
                                        <div class="mb-2">
                                            <div class="row justify-content-start">
                                                <div class="col-auto pe-0 align-self-center"></div>
                                                {{ form_errors(form.postalCode.postalCode01) }}
                                                {{ form_errors(form.postalCode.postalCode02) }}
                                            </div>
                                        </div>
                                        <div class="mb-3 col-2">
                                            {{ form_widget(form.abroadPostalCode) }}
                                            {{ form_errors(form.abroadPostalCode) }}
                                        </div>
                                        <div class="mb-3">
                                            <div class="row justify-content-start">
                                                <div class="col-auto">
                                                    {{ form_widget(form.address.pref) }}
                                                    {{ form_errors(form.address.pref) }}
                                                </div>
                                            </div>
                                        </div>
                                        <div class="mb-3">
                                            {{ form_widget(form.address.addr01, { attr : { placeholder : 'admin.common.address_sample_01' }} ) }}
