     */
    #[Route(path: '/%eccube_admin_route%/content/branch_toppage/register', name: 'admin_content_branch_toppage_register', methods: ['POST'])]
    public function register(Request $request): Response
    {
        $BaseInfo = $this->resolvePostedBaseInfo($request, true);
        $originalBannerImage = (string) $BaseInfo->getBannerImage();

        $formData = $request->request->all('branch_toppage_management');
        $commonSettingFlg = (bool) ($formData['common_setting_flg'] ?? false);

        if ($this->isCommonBranch($BaseInfo)) {
            $commonSettingFlg = false;
        }

        if ($commonSettingFlg) {
            if (!$this->isCsrfTokenValid('branch_toppage_management', (string) ($formData['_token'] ?? ''))) {
                $this->addError('admin.common.csrf_invalid', 'admin');

                return $this->renderPage($BaseInfo);
            }

            $BaseInfo->setCommonSettingflg(true);
            $this->entityManager->persist($BaseInfo);
            $this->entityManager->flush();
            $this->addSuccess('admin.common.save_complete', 'admin');

            $event = new EventArgs(
                [
                    'BaseInfo' => $BaseInfo,
                ],
                $request
            );
            $this->eventDispatcher->dispatch($event, EccubeEvents::ADMIN_CONTENT_BRANCH_TOP_PAGE_REGISTER_COMPLETE);

            return $this->renderPage($BaseInfo);
        }

        $form = $this->createForm(BranchTopPageManagementType::class, $BaseInfo, [
            'selected_base_info_id' => $BaseInfo->getId(),
        ]);
        $form->get('branch_list')->setData($BaseInfo);
        $form->handleRequest($request);

        if (!$form->isSubmitted() || !$form->isValid()) {
            $this->addError('admin.common.save_error', 'admin');

            return $this->renderPage($BaseInfo, $form);
        }

        if (!$this->validateTopPageManagement($form, $BaseInfo, $originalBannerImage)) {
            return $this->renderPage($BaseInfo, $form);
        }

        $this->entityManager->persist($BaseInfo);
        $this->entityManager->flush();

        $this->addSuccess('admin.common.save_complete', 'admin');

        $event = new EventArgs(
            [
                'form' => $form,
                'BaseInfo' => $BaseInfo,
            ],
            $request
        );
        $this->eventDispatcher->dispatch($event, EccubeEvents::ADMIN_CONTENT_BRANCH_TOP_PAGE_REGISTER_COMPLETE);

        return $this->renderPage($BaseInfo);
    }

