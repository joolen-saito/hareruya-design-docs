namespace Eccube\Controller\Admin\Customer;

use Eccube\Controller\AbstractController;
use Eccube\Entity\DtbCustomerGroup;
use Eccube\Event\EccubeEvents;
use Eccube\Event\EventArgs;
use Eccube\Form\Type\Admin\CustomerGroupType;
use Eccube\Repository\DtbCustomerGroupRepository;
use Eccube\Service\EntityManager\CustomerGroupEntityManager;
use Symfony\Bridge\Twig\Attribute\Template;
use Symfony\Component\HttpFoundation\RedirectResponse;
use Symfony\Component\HttpFoundation\Request;
use Symfony\Component\Routing\Attribute\Route;

class CustomerGroupController extends AbstractController
{
    public function __construct(
        private readonly DtbCustomerGroupRepository $customerGroupRepository,
        private readonly CustomerGroupEntityManager $customerGroupEntityManager,
    ) {
    }

    /**
     * @return RedirectResponse|array<string, mixed>
     */
    #[Route('/%eccube_admin_route%/customer/customer_group', name: 'admin_customer_group_new', methods: ['GET', 'POST'])]
    #[Route('/%eccube_admin_route%/customer/customer_group/{id}', name: 'admin_customer_group', requirements: ['id' => '\d+'], methods: ['GET', 'POST'])]
    #[Template('@admin/CustomerGroup/index.twig')]
    public function index(Request $request, ?DtbCustomerGroup $CustomerGroup): RedirectResponse|array
    {
        if (!$CustomerGroup) {
            $CustomerGroup = new DtbCustomerGroup();
        }

        $CustomerGroups = $this->customerGroupRepository->findBy([], ['id' => 'ASC']);

        $builder = $this->formFactory
            ->createBuilder(CustomerGroupType::class, $CustomerGroup);

        $event = new EventArgs(
            [
                'builder' => $builder,
                'CustomerGroup' => $CustomerGroup,
            ],
            $request
        );
        $this->eventDispatcher->dispatch($event, EccubeEvents::ADMIN_CUSTOMER_GROUP_INDEX_INITIALIZE);

        $form = $builder->getForm();
        $form->handleRequest($request);

        if ($form->isSubmitted() && $form->isValid()) {
            $this->customerGroupEntityManager->save($CustomerGroup);
            $this->entityManager->flush();

            $event = new EventArgs(
                [
                    'form' => $form,
                    'CustomerGroup' => $CustomerGroup,
                ],
                $request
            );
            $this->eventDispatcher->dispatch($event, EccubeEvents::ADMIN_CUSTOMER_GROUP_INDEX_COMPLETE);

            $this->addSuccess('admin.common.save_complete', 'admin');

            return $this->redirectToRoute('admin_customer_group_new');
        }

        return [
            'CustomerGroups' => $CustomerGroups,
            'TargetCustomerGroup' => $CustomerGroup,
            'form' => $form->createView(),
        ];
    }

    #[Route('/%eccube_admin_route%/customer/customer_group/{id}/delete', name: 'admin_customer_group_delete', requirements: ['id' => '\d+'], methods: ['DELETE'])]
    public function delete(Request $request, DtbCustomerGroup $CustomerGroup): RedirectResponse
    {
        $this->isTokenValid();

        log_info('顧客グループ情報削除開始', [$CustomerGroup->getId()]);

        if ($CustomerGroup->getPlayers()->count() > 0) {
            $message = trans('admin.customer.customer_group.delete_failed', ['%name%' => $CustomerGroup->getName()]);
            $this->addError($message, 'admin');

            return $this->redirectToRoute('admin_customer_group_new');
        }

        try {
            $this->customerGroupRepository->delete($CustomerGroup);

            $this->addSuccess('admin.common.delete_complete', 'admin');
            $this->entityManager->flush();

            log_info('顧客グループ情報削除完了', [$CustomerGroup->getId()]);
        } catch (\Exception $e) {
            $message = trans('admin.common.delete_error_foreign_key', ['%name%' => $CustomerGroup->getName()]);
            $this->addError($message, 'admin');

            log_error('顧客グループ情報削除エラー', [$CustomerGroup->getId(), $e]);
        }

        $event = new EventArgs(
            [
                'CustomerGroup' => $CustomerGroup,
            ],
            $request
        );
        $this->eventDispatcher->dispatch($event, EccubeEvents::ADMIN_CUSTOMER_GROUP_DELETE_COMPLETE);

        return $this->redirectToRoute('admin_customer_group_new');
    }
}

