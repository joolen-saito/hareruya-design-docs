   576	        }
   577	
   578	        $Card
   579	            ->setNameEn($normalizedNameEn)
   580	            ->setArenaFormatNameEn(str_replace('//', '/', (string) ($row['arena_format_name_en'] ?? '')))
   581	            ->setTextEn((string) ($row['text_en'] ?? ''))
   582	            ->setManaCost($this->convertManaCost((string) ($row['mana_cost'] ?? '')))
   583	            ->setCmc((float) $this->getCmc($row))
   584	            ->setPower((string) ($row['power'] ?? ''))
   585	            ->setToughness((string) ($row['toughness'] ?? ''))
   586	            ->setLoyalty((string) ($row['loyalty'] ?? ''));
   587	    }
