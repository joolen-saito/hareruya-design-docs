   153	     * @param string $url
   154	     * @param string $postfields
   155	     * @param array|null $header
   156	     * @return array
   157	     */
   158	    private function execCurl($url, $postfields, $header = null)
   159	    {
   160	        $curl = curl_init();
   161	        curl_setopt($curl, CURLOPT_URL, $url);
   162	        curl_setopt($curl, CURLOPT_CUSTOMREQUEST, 'POST');
   163	        curl_setopt($curl, CURLOPT_POSTFIELDS, $postfields);
   164	        curl_setopt($curl, CURLOPT_RETURNTRANSFER, true);
   165	        curl_setopt($curl, CURLOPT_HEADER, true);
   166	        if ($header) {
   167	            curl_setopt($curl, CURLOPT_HTTPHEADER, $header);
   168	        }
   169	
   170	        $response = curl_exec($curl);
   171	        $message = curl_error($curl);
   172	
   173	        $header_size = curl_getinfo($curl, CURLINFO_HEADER_SIZE);
   174	        $body = substr($response, $header_size);
   175	        $result = json_decode($body, true);
   176	        $result['message'] = $message;
   177	
   178	        curl_close($curl);
   179	
   180	        return $result;
   181	    }
