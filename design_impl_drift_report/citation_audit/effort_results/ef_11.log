    #[Route(path: '/mypage/identification/photograph', name: 'mypage_identification_photograph', methods: ['POST'])]
    #[Template(template: 'Mypage/online_identification_photograph.twig')]
    public function identificationPhotograph(Request $request, PaginatorInterface $paginator, MobileDetectorInterface $mobileDetector): array|RedirectResponse
    {
        $Customer = $this->getUser();

        if (!$mobileDetector->isMobile()) {
            return $this->redirectToRoute('mypage_identification');
        }

        $identification = $request->request->all('identification_select');
        if (empty($identification)) {
            return $this->redirectToRoute('mypage_identification');
        }

        $isError = null;
        if (!empty($request->request->get('isError'))) {
            $isError = $request->request->get('isError');
        }

        /** @var FormBuilderInterface $builder */
        $builder = $this->formFactory->createBuilder(
            IdentificationSelectType::class
        );

        /** @var FormInterface $form */
        $form = $builder->getForm();
        $form->handleRequest($request);

        if (!$form->isSubmitted() || !$form->isValid()) {
            return $this->redirectToRoute('mypage_identification');
        }

        /** @var FormBuilderInterface $builder */
        $builder = $this->formFactory->createBuilder(
            IdentificationImageType::class,
            null,
            ['identification' => $identification['Identification']]
        );

        /** @var FormInterface $form */
        $form = $builder->getForm();

        return [
            'Customer' => $Customer,
            'form' => $form->createView(),
            'identification' => $identification['Identification'],
            'isError' => $isError,
        ];
    }

