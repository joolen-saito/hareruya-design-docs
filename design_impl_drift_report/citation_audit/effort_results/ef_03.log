    16	namespace Eccube\Service\App\MTGBuyer\V1\Admin\OtcBuyOrder;
    17	
    18	use Eccube\Dto\App\MTGBuyer\V1\Admin\UpdateOtcBuyOrderDetailDto;
    19	use Eccube\Exception\App\InvalidRequestParameterException;
    20	
    21	final readonly class OtcBuyOrderDetailUpdatePlan
    22	{
    23	    /**
    24	     * @param list<UpdateOtcBuyOrderDetailDto> $details
    25	     * @param list<UpdateOtcBuyOrderDetailDto> $indivisuals
    26	     * @param array<int,int> $productClassQuantities
    27	     * @param array<int,int> $productClassSubtotals
    28	     */
    29	    public function __construct(
    30	        public array $details,
    31	        public array $indivisuals,
    32	        public array $productClassQuantities,
    33	        public array $productClassSubtotals,
    34	        public int $totalPrice,
    35	    ) {
    36	    }
    37	}
    38	
    39	final class BuildOtcBuyOrderDetailUpdatePlan
    40	{
    41	    /** @param list<UpdateOtcBuyOrderDetailDto> $orderDetails */
    42	    public function build(array $orderDetails): OtcBuyOrderDetailUpdatePlan
    43	    {
    44	        $details = [];
    45	        $indivisuals = [];
    46	        $productClassQuantities = [];
    47	        $productClassSubtotals = [];
    48	        $totalPrice = 0;
    49	
    50	        foreach ($orderDetails as $detail) {
    51	            if ($detail->price === null || $detail->quantity === null) {
    52	                // Validationでガードしているが、念のためチェックしている
    53	                throw new InvalidRequestParameterException('価格または数量が指定されていません');
    54	            }
    55	
    56	            $totalPrice += $detail->price * $detail->quantity;
    57	
    58	            if ($detail->productClassId !== null) {
    59	                $details[] = $detail;
    60	                $productClassQuantities[$detail->productClassId] = ($productClassQuantities[$detail->productClassId] ?? 0) + $detail->quantity;
    61	                // MTGBuyerは ”単価 x 数量" で計算しておりbcmath不要。
    62	                $productClassSubtotals[$detail->productClassId] = ($productClassSubtotals[$detail->productClassId] ?? 0) + $detail->price * $detail->quantity;
    63	            } else {
    64	                $indivisuals[] = $detail;
    65	            }
    66	        }
    67	
    68	        return new OtcBuyOrderDetailUpdatePlan($details, $indivisuals, $productClassQuantities, $productClassSubtotals, $totalPrice);
    69	    }
    70	}

