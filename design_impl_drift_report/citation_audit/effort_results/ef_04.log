namespace Eccube\Service\App\MTGBuyer\V1\Admin\BuyOrder;

use Doctrine\ORM\EntityManagerInterface;
use Eccube\Entity\Master\MtbBuyOrderStatus;
use Eccube\Exception\App\InternalException;
use Eccube\Exception\App\InvalidStatusTransitionException;
use Eccube\Service\App\MTGBuyer\V1\Admin\BuyOrder\ActionInput\UpdateStatusInput;
use Eccube\Service\EntityManager\BuyOrderStatusHistoryEntityManager;
use Psr\Log\LoggerInterface;

class UpdateStatusAction
{
    private const FROM_STATUS_TO_ALLOWED_STATUSES = [
        // 商品到着 -> 査定中, 査定中断, 査定再開
        MtbBuyOrderStatus::PRODUCT_ARRIVAL => [
            MtbBuyOrderStatus::ASSESSING,
            MtbBuyOrderStatus::PENDING,
            MtbBuyOrderStatus::RESUMPTION,
        ],
        // 査定中 -> 査定中断, 査定再開
        MtbBuyOrderStatus::ASSESSING => [
            MtbBuyOrderStatus::PENDING,
            MtbBuyOrderStatus::RESUMPTION,
        ],
        // 査定中断 -> 査定中, 査定再開
        MtbBuyOrderStatus::PENDING => [
            MtbBuyOrderStatus::ASSESSING,
            MtbBuyOrderStatus::RESUMPTION,
        ],
        // 査定再開 -> 査定中, 査定中断
        MtbBuyOrderStatus::RESUMPTION => [
            MtbBuyOrderStatus::ASSESSING,
            MtbBuyOrderStatus::PENDING,
        ],
    ];

    public function __construct(
        private readonly EntityManagerInterface $entityManager,
        private readonly LoggerInterface $logger,
        private readonly BuyOrderStatusHistoryEntityManager $buyOrderStatusHistoryEntityManager,
    ) {
    }

    /**
     * ステータスを更新する
     * 更新前ステータス [2: 商品到着, 10: 査定中, 11: 査定中断, 12: 査定再開]
     * 更新後ステータス [10: 査定中, 11: 査定中断, 12: 査定再開]
     * ただし、査定中 -> 査定再開のステータス更新ができるのは BuyOrderの更新者(Member)のみ
     */
    public function handle(UpdateStatusInput $input): void
    {
        $CurrentStatus = $input->BuyOrder->getBuyOrderStatus();
        $currentStatusId = $CurrentStatus->getId();
        $nextStatusId = $input->NewBuyOrderStatus->getId();

        if ($currentStatusId === $nextStatusId) {
            return;
        }

        // 遷移ルールに定義されていないステータスからは変更不可
        // 旧システムとの互換性目的：メッセージを分けているのはクライアント側がAPIのメッセージをそのまま表示するため
        if (!isset(self::FROM_STATUS_TO_ALLOWED_STATUSES[$currentStatusId])) {
            $message = $input->NewBuyOrderStatus->isAssessmentActive()
                ? 'この査定はすでに終了しているため開くことができません。'
                : 'この査定はすでに終了しているためステータスの更新に失敗しました。';

            throw new InvalidStatusTransitionException($message);
        }

        // 遷移ルールに定義されていないステータス先へ変更不可
        if (!in_array($nextStatusId, self::FROM_STATUS_TO_ALLOWED_STATUSES[$currentStatusId], true)) {
            throw new InvalidStatusTransitionException('不正なステータス遷移です');
        }

        // 査定者本人を除き、査定中または査定再開のものは査定アクティブ状態にできない
        if (
            $CurrentStatus->isAssessmentActive()
            && $input->NewBuyOrderStatus->isAssessmentActive()
            && $input->Member !== $input->BuyOrder->getMember()
        ) {
            throw new InvalidStatusTransitionException("この受注は「{$input->BuyOrder->getMember()->getName()}」が査定中です。");
        }

        $this->entityManager->beginTransaction();
        try {
            $now = new \DateTime();
            $input->BuyOrder
                ->setBuyOrderStatus($input->NewBuyOrderStatus)
                ->setMember($input->Member)
                ->setUpdateDate($now);

            $this->buyOrderStatusHistoryEntityManager->save($input->BuyOrder, $input->NewBuyOrderStatus, $input->Member, $now);

            $this->entityManager->flush();
            $this->entityManager->commit();
        } catch (\Throwable $e) {
            $this->entityManager->rollback();
            $this->logger->error('Failed to update buy order status', ['exception' => $e, 'buyOrderId' => $input->BuyOrder->getId(), 'currentStatusId' => $currentStatusId, 'nextStatusId' => $nextStatusId, 'memberId' => $input->Member->getId()]);
            throw new InternalException('システムエラーが発生しました', $e);
        }
    }
}
