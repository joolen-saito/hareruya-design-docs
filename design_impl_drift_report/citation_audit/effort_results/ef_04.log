namespace Eccube\Service\App\MTGBuyer\V1\Admin\BuyOrder;

use Doctrine\ORM\EntityManagerInterface;
use Eccube\Dto\App\MTGBuyer\V1\Admin\UpdateBuyOrderDetailDto;
use Eccube\Entity\DtbBuyMainCard;
use Eccube\Entity\DtbBuyOrder;
use Eccube\Entity\DtbBuyOrderIndivisualInputProduct;
use Eccube\Exception\App\InternalException;
use Eccube\Exception\App\InvalidParameterException;
use Eccube\Repository\DtbBuyMainCardRepository;
use Eccube\Repository\DtbBuyOrderIndivisualInputProductRepository;
use Eccube\Service\App\MTGBuyer\V1\Admin\BuyOrder\ActionInput\UpdateBuyOrderInput;
use Eccube\Service\EntityManager\BuyOrderStatusHistoryEntityManager;
use Eccube\Service\Purchase\BulkPurchaseIdService;
use Psr\Log\LoggerInterface;

class UpdateBuyOrderAction
{
    private const PRICE_ROUNDING_UNIT = 10;

    public function __construct(
        private readonly EntityManagerInterface $entityManager,
        private readonly LoggerInterface $logger,
        private readonly DtbBuyMainCardRepository $buyMainCardRepository,
        private readonly DtbBuyOrderIndivisualInputProductRepository $buyOrderIndivisualInputProductRepository,
        private readonly BulkPurchaseIdService $bulkPurchaseIdService,
        private readonly BuildBuyMainCard $buildBuyMainCard,
        private readonly BuyOrderStatusHistoryEntityManager $buyOrderStatusHistoryEntityManager,
    ) {
    }

    /**
     * 査定終了処理
     *
     * ネット買取の場合はユーザーの買取申込時にカード情報をDBに登録済みのため店頭買取とロジックが異なる。
     * ①査定データと登録済みデータを比較して同じものは上書きする
     * ②言語や状態が異なるなどの場合は新規レコードとする
     * ③査定データに含まれなかったDB登録済みレコードを削除する
     */
    public function handle(UpdateBuyOrderInput $input): void
    {
        $this->entityManager->beginTransaction();

        try {
            $oldStatusId = $input->BuyOrder->getBuyOrderStatus()->getId();
            $bulkPurchaseId = $this->bulkPurchaseIdService->get();

            // 既存データを取得
            /** @var DtbBuyMainCard[] $ExistingBuyMainCards */
            $ExistingBuyMainCards = $this->buyMainCardRepository->findBy(['BuyOrder' => $input->BuyOrder->getId()]);
            $ExistingIndivisualMap = $this->buildExistingIndivisualMap($input->BuyOrder);

            // orderDetailsから保存用のEntityを構築し、洗い替えで保持するIDと小計を取得
            $buildResult = $this->buildOrderDetailEntities(
                $input->BuyOrder,
                $input->orderDetails,
                $ExistingBuyMainCards,
                $ExistingIndivisualMap
            );

            // 構築したEntityを永続化
            foreach ($buildResult['entities'] as $Entity) {
                $this->entityManager->persist($Entity);
            }

            // サプライ/パックは既存レコードを保持し、小計を加算
            [$supplyPackTotal, $keepCardIds] = $this->preserveSupplyPackCards(
                $ExistingBuyMainCards,
                $bulkPurchaseId,
                $buildResult['keepCardIds']
            );

            // 不要レコードを削除
            foreach ($ExistingBuyMainCards as $Card) {
                if (!in_array($Card->getId(), $keepCardIds, true)) {
                    $this->entityManager->remove($Card);
                }
            }
            foreach ($ExistingIndivisualMap as $IndivisualProduct) {
                if (!in_array($IndivisualProduct->getId(), $buildResult['keepIndivisualIds'], true)) {
                    $this->entityManager->remove($IndivisualProduct);
                }
            }

            // BuyOrder更新
            $now = new \DateTime();
            $totalPrice = $this->roundUpPrice($buildResult['totalPrice'] + $supplyPackTotal);
            $input->BuyOrder
                ->setBuyOrderStatus($input->NewBuyOrderStatus)
                ->setTotalPrice($totalPrice)
                ->setMember($input->Member)
                ->setUpdateDate($now);
            $this->entityManager->persist($input->BuyOrder);

            // ステータスが変更された場合、履歴を登録
            if ($oldStatusId !== $input->NewBuyOrderStatus->getId()) {
                $this->buyOrderStatusHistoryEntityManager->save(
                    $input->BuyOrder,
                    $input->NewBuyOrderStatus,
                    $input->Member,
                    $now
                );
            }

            $this->entityManager->flush();
            $this->entityManager->commit();
        } catch (InvalidParameterException $e) {
            $this->entityManager->rollback();
            $this->logger->warning('Invalid parameter in buy order update', [
                'exception' => $e,
                'buyOrderId' => $input->BuyOrder->getId(),
                'memberId' => $input->Member->getId(),
            ]);
            throw $e;
        } catch (\Throwable $e) {
            $this->entityManager->rollback();
            $this->logger->error('Failed to update buy order assessment', [
                'exception' => $e,
