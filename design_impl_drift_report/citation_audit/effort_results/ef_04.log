namespace Eccube\Repository\Master;

use Doctrine\DBAL\Types\Types;
use Doctrine\ORM\EntityNotFoundException;
use Doctrine\ORM\NonUniqueResultException;
use Doctrine\ORM\Query\ResultSetMapping;
use Doctrine\ORM\QueryBuilder;
use Doctrine\Persistence\ManagerRegistry;
use Eccube\Entity\Master\MtbCard;
use Eccube\Entity\Master\MtbCardDetail;
use Eccube\Entity\Master\MtbPromotion;
use Eccube\Repository\AbstractRepository;
use Eccube\Util\SqlUtil;
use Eccube\Util\StringUtil;

/**
 * @extends AbstractRepository<MtbCardDetail>
 */
class MtbCardDetailRepository extends AbstractRepository
{
    /**
     * カード詳細一覧
     * 検索条件に該当するデータを取得
     *
     * @param array{
     * card_name: string|null,
     * cardset: int[]|null,
     * sort: string,
     * order: string
     * } $searchData
     *
     * @return QueryBuilder
     */
    public function getQueryBuilderBySearchDataForAdmin(array $searchData): QueryBuilder
    {
        $sortKey = [
            'cardDetailId' => 'cd.id',
            'cardIdAndCardDetailId' => 'c.id,cd.id',
        ];

        $qb = $this->createQueryBuilder('cd')
            ->select('c', 'cd', 'ci')
            ->join('cd.Card', 'c')
            ->leftJoin('cd.Cardset', 'cs')
            ->leftJoin('cd.CardImages', 'ci');

        // カード名
        $cardName = $searchData['card_name'];
        if (isset($cardName) && StringUtil::isNotBlank($cardName)) {
            // スペース除去
            $cardName = trim(mb_convert_kana($cardName, 's', 'UTF-8'));
            // 半角スペース、全角スペース、カンマで分割
            $texts = preg_split('/[\s,　]+/u', $cardName);
            $searchColumns = [
                'c' => ['name_jp', 'name_en'],
            ];
            SqlUtil::multiTextQuery($qb, $texts, $searchColumns);
        }

        // カードセット
        $cardset = $searchData['cardset'];
        if (!empty($cardset)) {
            $qb->andWhere('cd.Cardset IN (:cardset)')
                ->setParameter('cardset', $cardset);
        }

        // Order By
        $sortkeys = explode(',', $sortKey[$searchData['sort']]);
        foreach ($sortkeys as $sort) {
            $qb->addOrderBy($sort, $searchData['order']);
        }

        return $qb;
    }

    public function __construct(ManagerRegistry $registry)
    {
        parent::__construct($registry, MtbCardDetail::class);
    }

    public function get(int $id = 1): ?MtbCardDetail
    {
        return $this->find($id);
    }

    /**
     * カード詳細IDからカード詳細1件を検索する。
     *
     * エンティティではなく配列の形式で返すことで、メモリの消費を抑える。
     * バッチ処理のときに使用するとよい。
     *
     * @param int $cardDetailId カード詳細ID
     *
     * @return array<string, mixed> カード詳細情報
     *
     * @throws EntityNotFoundException カード詳細情報が見つからなかった場合
     */
    public function findByIdNative(int $cardDetailId): array
    {
        $sql = <<<EOT
            SELECT
                cd.id as card_detail_id,
                c.name_en,
                cs.code as cardset_code,
                cd.foil_flg,
                cd.card_no,
                pr.code AS promotion_code
            FROM
                mtb_card_detail cd
                INNER JOIN mtb_card c
                    ON cd.card_id = c.id
                LEFT JOIN mtb_cardset cs
                    ON cd.cardset_id = cs.id
                LEFT JOIN mtb_promotion pr
                    ON cd.promotion_id = pr.id
            WHERE
                cd.id = :cardDetailId
        EOT;

        $rsm = new ResultSetMapping();
        $rsm->addScalarResult('card_detail_id', 'cardDetailId', Types::INTEGER)
            ->addScalarResult('name_en', 'cardNameEn')
            ->addScalarResult('cardset_code', 'cardsetCode')
            ->addScalarResult('foil_flg', 'foilFlg', Types::INTEGER)
            ->addScalarResult('card_no', 'cardNo')
            ->addScalarResult('promotion_code', 'promotionCode');

        $result = $this->getEntityManager()
            ->createNativeQuery($sql, $rsm)
            ->setParameter('cardDetailId', $cardDetailId)
            ->getResult();

        if (count($result) === 1) {
            return current($result);
        }
    private function isValidDigitParam(array $params, string $field): bool
    {
        if (!isset($params[$field]) || $params[$field] === '') {
            return true;
        }
        if (!is_string($params[$field])) {
            return false;
        }

        return preg_match('/^\d+$/', $params[$field]) === 1;
    }

    #[Route('/api/cards/{id}', name: 'api_deck_builder_card', methods: ['GET', 'OPTIONS'], requirements: ['id' => '\d+'])]
    public function getCard(Request $request, int $id): JsonResponse
    {
        if ($request->isMethod('OPTIONS')) {
            return $this->createCorsResponse(new JsonResponse(null, Response::HTTP_NO_CONTENT));
        }

        $Card = $this->cardRepository->find($id);
        if ($Card === null) {
            return $this->createErrorResponse(
                Response::HTTP_NOT_FOUND,
                trans('api.deck_builder.common.not_found')
            );
        }

        return $this->createCorsResponse(new JsonResponse($Card->toNormalizedArray(), Response::HTTP_OK));
    }

    #[Route('/api/card', name: 'api_deck_builder_card_search', methods: ['GET', 'OPTIONS'])]
    public function getCardByParams(Request $request): JsonResponse
    {
        if ($request->isMethod('OPTIONS')) {
            return $this->createCorsResponse(new JsonResponse(null, Response::HTTP_NO_CONTENT));
        }

        $name = $request->query->get('name');
        $lang = $request->query->get('lang');

        if ($name === null || $name === '') {
            return $this->createErrorResponse(
                Response::HTTP_BAD_REQUEST,
                trans('api.deck_builder.card.name_required')
            );
        }

        $Card = $this->cardRepository->findOneByParams($name, $lang);
        if ($Card === null) {
            return $this->createErrorResponse(
                Response::HTTP_NOT_FOUND,
                trans('api.deck_builder.common.not_found')
            );
        }

        return $this->createCorsResponse(new JsonResponse($Card, Response::HTTP_OK));
    }
