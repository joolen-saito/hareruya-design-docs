namespace Eccube\Controller\App;

use Eccube\Controller\AbstractController;
use Eccube\Exception\App\BaseApiException;
use Eccube\Exception\App\NotFoundException;
use Eccube\Repository\Master\MtbLanguageRepository;
use Eccube\Repository\Master\MtbTopBannerRepository;
use Eccube\Service\App\Content\TopBannerResponseBuilder;
use Eccube\Service\App\Content\TopBannersResponseBuilder;
use Symfony\Component\HttpFoundation\JsonResponse;
use Symfony\Component\HttpFoundation\Request;
use Symfony\Component\HttpFoundation\Response;
use Symfony\Component\Routing\Attribute\Route;

class ContentController extends AbstractController
{
    public function __construct(
        private readonly MtbTopBannerRepository $topBannerRepository,
        private readonly TopBannerResponseBuilder $topBannerResponseBuilder,
        private readonly TopBannersResponseBuilder $topBannersResponseBuilder,
        private readonly MtbLanguageRepository $languageRepository,
    ) {
    }

    /**
     * トップバナーIDを検索条件として、トップバナー情報を1件取得して返却するAPIエンドポイント
     *
     * @param Request $request
     * @param string $topBannerId
     *
     * @return JsonResponse
     */
    #[Route(path: '/topBanner/{topBannerId}', name: 'top_banner_by_top_banner_id', methods: ['GET'])]
    public function getTopBannerByTopBannerId(Request $request, string $topBannerId): JsonResponse
    {
        try {
            if (!preg_match('/^\d+$/', $topBannerId) || (int) $topBannerId < 1) {
                log_warning('topBannerIdは正の整数である必要があります', [
                    'request_url' => $request->getUri(),
                ]);
                throw new NotFoundException('Not Found');
            }

            $TopBanner = $this->topBannerRepository->find((int) $topBannerId);
            if (empty($TopBanner)) {
                log_warning('トップバナーが見つかりません', [
                    'request_url' => $request->getUri(),
                ]);
                throw new NotFoundException('Not Found');
            }

            $response = $this->topBannerResponseBuilder->build($TopBanner);

            return $this->json($response, Response::HTTP_OK);
        } catch (BaseApiException $e) {
            return $this->json([
                'code' => $e->getStatusCode(),
                'errors' => $e->getErrors(),
            ], $e->getStatusCode());
        }
    }

    /**
     * 言語コードを検索条件として、トップバナー情報の一覧を取得して返却するAPIエンドポイント
     *
     * @param Request $request
     * @param string $languageCode
     *
     * @return JsonResponse
     */
    #[Route(path: '/topBanners/{languageCode}.json', name: 'top_banners_by_language_code_json', methods: ['GET'])]
    #[Route(path: '/topBanners/{languageCode}', name: 'top_banners_by_language_code', methods: ['GET'])]
    public function getTopBannersByLanguageCode(Request $request, string $languageCode): JsonResponse
    {
        try {
            $Language = $this->languageRepository->findOneBy([
                'code' => $languageCode,
            ]);

            if (empty($Language)) {
                log_warning('言語情報が見つかりません', [
                    'request_url' => $request->getUri(),
                ]);
                throw new NotFoundException('Not Found');
            }

            $TopBanners = $Language->getTopBanners();
            if ($TopBanners->isEmpty()) {
                log_warning('指定した言語のトップバナーが見つかりません', [
                    'request_url' => $request->getUri(),
                ]);
                throw new NotFoundException('Not Found');
            }

            $response = $this->topBannersResponseBuilder->build($TopBanners);

            return $this->json($response, Response::HTTP_OK);
        } catch (BaseApiException $e) {
            return $this->json([
                'code' => $e->getStatusCode(),
                'errors' => $e->getErrors(),
            ], $e->getStatusCode());
        }
    }
}
