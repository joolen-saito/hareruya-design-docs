namespace Eccube\Repository\Master;

use Doctrine\Persistence\ManagerRegistry;
use Eccube\Entity\Master\MtbLanguage;
use Eccube\Entity\Master\MtbTopBanner;
use Eccube\Repository\AbstractRepository;

/**
 * @extends AbstractRepository<MtbTopBanner>
 */
class MtbTopBannerRepository extends AbstractRepository
{
    public function __construct(ManagerRegistry $registry)
    {
        parent::__construct($registry, MtbTopBanner::class);
    }

    /**
     * 条件に一致する画像URLが空文字でないレコードをすべて返す
     *
     * @param array<int, mixed> $dispTypes
     */
    public function findWhereUrlIsNotEmpty(string $locale, int $limit, array $dispTypes = []): mixed
    {
        // localeとlocaleIdの対応づけ処理
        $localeId = $locale === 'en' ? MtbLanguage::EN_ID : MtbLanguage::JP_ID;

        $qb = $this->createQueryBuilder('tb');
        $query = $qb->join('tb.Languages', 'l')
            ->where($qb->expr()->eq('l.id', ':localeId'))
            ->andWhere($qb->expr()->in('tb.dispType', ':dispTypes'))
            ->andWhere("tb.imageUrl <> ''")
            ->setParameter('localeId', $localeId)
            ->setParameter('dispTypes', $dispTypes)
            ->orderBy('tb.sortNo', 'ASC')
            ->addOrderBy('tb.id', 'ASC')
            ->setMaxResults($limit)
            ->getQuery();

        return $query->execute();
    }
}
