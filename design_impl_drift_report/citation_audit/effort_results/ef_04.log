namespace Eccube\Service\Purchase;

use Eccube\Entity\Master\MtbOption;
use Eccube\Exception\App\InternalException;
use Eccube\Repository\Master\MtbOptionRepository;

class BulkPurchaseIdService
{
    public function __construct(
        private readonly MtbOptionRepository $optionRepository,
    ) {
    }

    /**
     * まとめて買取商品IDを取得
     *
     * @throws InternalException 設定が存在しない、または不正な値の場合
     */
    public function get(): int
    {
        $option = $this->optionRepository->findOneBy(['option_key' => MtbOption::BULK_PURCHASE_ID]);

        if ($option === null) {
            throw new InternalException('まとめて買取商品IDの設定がありません');
        }

        $value = $option->getOptionValue();
        if ($value === '' || !ctype_digit((string) $value)) {
            throw new InternalException('まとめて買取商品IDの設定値が不正です');
        }

        return (int) $value;
    }
}
