     *
     * @param iterable<MtbTopBanner> $TopBanners
     *
     * @return array<int, array<string, mixed>>
     */
    public function build(iterable $TopBanners): array
    {
        $response = [];
        foreach ($TopBanners as $TopBanner) {
            $response[] = $this->topBannerResponseBuilder->build($TopBanner);
        }

        return $response;
    }
