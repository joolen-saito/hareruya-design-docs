        $rarityResponse = null;
        if ($Rarity !== null) {
            $rarityResponse = [
                'id' => $Rarity->getId(),
                'name_jp' => $Rarity->getNameJp(),
                'name_en' => $Rarity->getNameEn(),
                'code' => $Rarity->getCode(),
            ];
        }

        $Cardset = $CardDetail->getCardset();
        $cardsetResponse = null;
        if ($Cardset !== null) {
            $releaseDate = $Cardset->getReleaseDate();
            $cardsetResponse = [
                'id' => $Cardset->getId(),
                'name_jp' => $Cardset->getNameJp(),
                'name_en' => $Cardset->getNameEn(),
                'code' => $Cardset->getCode(),
                'symbol_image' => $Cardset->getSymbolImage(),
                'cardsetblock_id' => $Cardset->getCardsetblock()?->getId(),
                'release_date' => $this->formatDateTime($releaseDate),
                'special_flg' => $Cardset->isSpecialFlg(),
                'branch_display_flg' => $Cardset->isBranchDisplayFlg(),
            ];
        }

        $Illustrator = $CardDetail->getIllustrator();
        $illustratorResponse = null;
        if ($Illustrator !== null) {
            $illustratorResponse = [
                'id' => $Illustrator->getId(),
                'name_jp' => $Illustrator->getNameJp(),
                'name_en' => $Illustrator->getNameEn(),
            ];
        }

        $Promotion = $CardDetail->getPromotion();
        $promotionResponse = null;
        if ($Promotion !== null) {
            $promotionResponse = [
                'id' => $Promotion->getId(),
                'name_jp' => $Promotion->getNameJp(),
                'name_en' => $Promotion->getNameEn(),
                'code' => $Promotion->getCode(),
            ];
        }

        $cardImages = [];
        foreach ($CardDetail->getCardImages() as $CardImage) {
            $Language = $CardImage->getLanguage();
            $languageResponse = null;
            if ($Language !== null) {
                $languageResponse = [
                    'id' => $Language->getId(),
                    'name_jp' => $Language->getNameJp(),
                    'name_en' => $Language->getNameEn(),
                    'code' => $Language->getCode(),
