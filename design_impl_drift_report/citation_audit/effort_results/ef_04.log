                'language' => $languageResponse,
            ];
        }

        return [
            'id' => $CardDetail->getId(),
            'card_id' => $CardDetail->getCard()?->getId(),
            'back_card_detail_id' => $CardDetail->getBackCardDetailId(),
            'cardset_id' => $CardDetail->getCardset()?->getId(),
            'rarity_id' => $CardDetail->getRarity()?->getId(),
            'illustrator_id' => $CardDetail->getIllustrator()?->getId(),
            'flavor_jp' => $CardDetail->getFlavorJp(),
            'flavor_en' => $CardDetail->getFlavorEn(),
            'text_jp' => $CardDetail->getTextJp(),
            'text_en' => $CardDetail->getTextEn(),
            'power' => $CardDetail->getPower(),
            'toughness' => $CardDetail->getToughness(),
            'card_no' => $CardDetail->getCardNo(),
            'foil_flg' => $CardDetail->getFoilFlg(),
            'promotion_flg' => $CardDetail->isPromotionFlg(),
            'update_date' => $this->formatDateTime($CardDetail->getUpdateDate()),
            'create_date' => $this->formatDateTime($CardDetail->getCreateDate()),
            'card_layout' => $cardLayoutResponse,
            'rarity' => $rarityResponse,
            'cardset' => $cardsetResponse,
            'illustrator' => $illustratorResponse,
            'promotion' => $promotionResponse,
            'card_images' => $cardImages,
        ];
    }

