     * @return array<string, string>
     */
    private function getRequiredStockHistoryCsvHeader(): array
    {
        return [
            '商品コード' => '',
            '商品名' => '',
            '言語' => '',
            '状態' => '',
            $qb
                ->andWhere('sh.createDate >= :create_date_from')
                ->setParameter('create_date_from', $date);
        }

        // create_date_to 登録日
        if (isset($searchData['create_date_to']) && StringUtil::isNotBlank($searchData['create_date_to'])) {
            $date = $searchData['create_date_to']->format('Y-m-d 23:59:59');
            $qb
                ->andWhere('sh.createDate <= :create_date_to')
                ->setParameter('create_date_to', $date);
        }

        // 在庫変動区分（子区分）で絞り込み
        $stockChangeTypeDetailIds = [];
        if (isset($searchData['stock_change_type_detail']) && StringUtil::isNotBlank($searchData['stock_change_type_detail'])) {
            // stock_change_type_detail 在庫変動区分（子区分）で絞り込み
            foreach ((array) $searchData['stock_change_type_detail'] as $StockChangeTypeDetail) {
                $stockChangeTypeDetailIds[] = $StockChangeTypeDetail->getId();
            }
        } elseif (isset($searchData['disposal_search']) && StringUtil::isNotBlank($searchData['disposal_search'])) {
            // 欠品検索 ON: 欠品減算(受注)・欠品減算(移動) に限定
            $stockChangeTypeDetailIds = [
                MtbStockChangeTypeDetail::ORDER_STOCKOUT_DECREASE,
                MtbStockChangeTypeDetail::MOVE_SHORTAGE_SUBTRACT,
            ];
        }

        if ($stockChangeTypeDetailIds !== []) {
            $qb
                ->andWhere($qb->expr()->in('IDENTITY(sh.StockChangeTypeDetail)', ':stock_change_type_detail_ids'))
                ->setParameter('stock_change_type_detail_ids', $stockChangeTypeDetailIds);
        }

        // category_id カテゴリ
        if (isset($searchData['category_id']) && StringUtil::isNotBlank($searchData['category_id'])) {
            $qb
                ->leftJoin('p.ProductCategories', 'pca')
                ->andWhere($qb->expr()->in('pca.Category', ':category_id'))
                ->setParameter('category_id', $searchData['category_id']);
        }

        // status 公開種別
        if (isset($searchData['status']) && StringUtil::isNotBlank($searchData['status'])) {
            $qb
                ->andWhere($qb->expr()->in('p.Status', ':Status'))
                ->setParameter('Status', $searchData['status']);
        }

        // cardset エキスパンション
        if (isset($searchData['cardset']) && StringUtil::isNotBlank($searchData['cardset'])) {
                ->andWhere($qb->expr()->in('sh.UpdateMember', ':update_notification_target_members'))
                ->setParameter('update_notification_target_members', $searchData['update_notification_target_members']);
        }

        // update_date_to 最終更新日
        if (isset($searchData['update_date_to']) && StringUtil::isNotBlank($searchData['update_date_to'])) {
            $date = $searchData['update_date_to']->format('Y-m-d 23:59:59');
            $qb
                ->andWhere('sh.updateDate < :update_date_to')
                ->setParameter('update_date_to', $date);
        }

        // stock_change_reason 在庫変動理由・欠品理由
        if (isset($searchData['stock_change_reason']) && StringUtil::isNotBlank($searchData['stock_change_reason'])) {
            $qb
                ->andWhere('sh.stockChangeReason LIKE :likeStockChangeReason')
                ->setParameter('likeStockChangeReason', '%'.str_replace(['%', '_'], ['\\%', '\\_'], $searchData['stock_change_reason']).'%');
        }

        // Order By
        $qb->addSelect('COALESCE(sh.approvalAt, sh.registeredAt, sh.createDate) AS HIDDEN sortDate');
        $qb->addOrderBy('pc.code', 'DESC');
        $qb->addOrderBy('ps.baseInfo', 'DESC');
        $qb->addOrderBy('sortDate', 'DESC');

        return $qb;
    }

