        }

        return $this->redirectToRoute('admin_stock_move_outbound_approval_request', [
            'id' => $stockMoveTransferId,
        ]);
    }

    /**
     * 在庫振替CSV登録
     */
    #[Route(path: '/%eccube_admin_route%/product/stock/move_transfer/transfer_csv_import', name: 'admin_stock_move_transfer_transfer_csv_import', methods: ['POST'])]
    public function importStockTransferCsv(Request $request): RedirectResponse
    {
        /** @var Member $Member */
        $Member = $this->getUser();

    /**
     * CSVインポート種別で履歴のQueryBuilderを取得（ページネーション用）
     *
     * @param int $csvImportTypeId mtb_csv_import_type.id
     */
    public function getQueryBuilderByCsvImportType(int $csvImportTypeId): QueryBuilder
    {
        return $this->createQueryBuilder('cih')
            ->innerJoin('cih.CsvImportType', 'ct')
            ->where('ct.id = :csvImportTypeId')
            ->setParameter('csvImportTypeId', $csvImportTypeId)
            ->orderBy('cih.createDate', 'DESC');
    }

    /**
     * 直近インポートされた履歴を取得
     *
     * @return DtbCsvImportHistory[]
     */
    public function getRecentCsvImportHistory(int $csvImportType, string $fileName): array
    {
        $createDate = (new \DateTime())->modify(self::HISTORY_PERIOD)->format('Y-m-d H:i:s');

        return $this->createQueryBuilder('cih')
            ->where('cih.CsvImportType = :csvImportType')
            ->andWhere('cih.fileName = :fileName')
            ->andWhere('cih.createDate >= :createDate')
            ->setParameters(new ArrayCollection([
                'csvImportType' => $csvImportType,
                'fileName' => $fileName,
                'createDate' => $createDate,
            ]))
            ->getQuery()
            ->getResult();
    }
}

