    /**
     * DtbStockHistoryをCSV出力できる形にコンバート
     *
     * @param array<int, DtbStockHistory> $StockHistories StockHistoryの配列
     *
     * @return array<int, array<string, mixed>>
     */
    public function convertExportCsvRows(array $StockHistories): array
    {
        $csvRows = [];

        foreach ($StockHistories as $StockHistory) {
            $ProductStock = $this->productStockRepository->findOneBy(['id' => $StockHistory->getProductStock()]);
            $ProductClass = $this->productClassRepository->findOneBy(['id' => $ProductStock->getProductClass()]);
            $Product = $this->productRepository->findOneBy(['id' => $ProductClass->getProduct()]);

            $rowBase = [
                '商品コード' => $ProductClass->getCode(),
                '商品名' => $Product->getName(),
                '言語' => $ProductClass->getLanguageNameJp(),
                '状態' => $ProductClass->getCardCondition()->getCode(),
                'Foil' => '',   // TODO - From Foil Master Table
                '店舗' => $ProductStock->getBaseInfo(),
                '在庫場所' => $ProductStock->getLocationName(),
                '登録元' => $StockHistory->getHistorySourceType(),
                '登録元ID' => $StockHistory->getHistorySourceId(),
                '変更前在庫' => $StockHistory->getOldStock(),
                '変更後在庫' => $StockHistory->getStock(),
                '在庫増減数' => $StockHistory->getStockChangeQuantity(),
                '在庫変動理由区分' => $StockHistory->getStockChangeTypeDetail()->getStockChangeType()->getName(),
                '在庫変動理由' => $StockHistory->getStockChangeReason(),
                '変更時販売価格' => $StockHistory->getSellPrice(),
