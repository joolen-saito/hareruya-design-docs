    public function csvStockChangeUpload(Request $request, CacheUtil $cacheUtil): RedirectResponse|array
    {
        // タイムアウトを無効にする
        set_time_limit(0);

        $headers = $this->getStockChangeCsvHeader();

        $builder = $this->formFactory->createBuilder(StockChangeType::class, null, [
        ]);
        $form = $builder->getForm();
        $form->handleRequest($request);

        if (!$form->isSubmitted() || !$form->isValid()) {
            foreach ($form->getErrors(true) as $error) {
                $this->addError($error->getMessage(), 'admin');
            }

            return $this->redirectToRoute('admin_stock_change_csv_list');
        }

        $formData = $form->getData();
        $Member = $this->getMember();

        if (!$Member->isEditableShop($formData['change_base_info'])) {
            $this->addError('admin.stock.change_csv.shop_not_permitted', 'admin');

            return $this->redirectToRoute('admin_stock_change_csv_list');
        }

        /** @var UploadedFile $file */
        $file = $form->get('import_file')->getData();

        // レコード数上限チェック
        if ($this->countCsvRows($file) >= static::ADMIN_CSV_IMPORT_MAX_ROWS) {
            $this->addErrors($this->getCsvImportMaxRowsExceededMessage());

            return [
                'form' => $form->createView(),
                'headers' => $headers,
            ];
        }

        log_info('在庫変更CSV登録開始');

        // UTF-8 BOM 付きファイルをアップロードした場合も処理できるよう、
        // バイトレベルで BOM (\xEF\xBB\xBF) を除去する。
        $filePath = $file->getRealPath();
        if ($filePath !== false) {
            $content = file_get_contents($filePath);
            if ($content !== false && str_starts_with($content, "\xEF\xBB\xBF")) {
                file_put_contents($filePath, substr($content, 3));
            }
        }

        try {
            $extension = $file->getClientOriginalExtension();
            if ($extension === '') {
                $extension = 'csv';
            }
            $tempFileName = 'upload_'.StringUtil::random().'.'.$extension;
            $importFilePath = rtrim((string) $this->eccubeConfig['eccube_csv_temp_realdir'], '/').'/'.$tempFileName;

            $input = new StockChangeCsvImportInput(
                changeBaseInfoId: (int) $formData['change_base_info']->getId(),
                changeStockLocationId: (int) $formData['change_stock_location_id'],
                stockChangeTypeDetailId: (int) $formData['stock_change_type_detail']->getId(),
                stockChangeReason: $formData['stock_change_reason'],
                approvalDepartment: (int) $formData['approval_department'],
                approvalNotificationTargetMembers: (int) $formData['approval_notification_target_members'],
                originalFileName: (string) $file->getClientOriginalName(),
                importFilePath: $importFilePath,
            );

            $handler = new StockChangeCsvImportHandler(
                $this->stockEditApprovalRepository,
                $this->stockEditApprovalDetailRepository,
                $this->baseInfoRepository,
                $this->productStockRepository,
                $this->stockHistorySourceTypeRepository,
                $this->entityManager,
                $this->stockApprovalListEntityManager,
                $this->stockEditCsvRepository,
                $this->fileManager,
