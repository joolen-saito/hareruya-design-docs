            'stockChangeReasonDisplayBuilder' => $this->stockChangeReasonDisplayBuilder,
        ];
    }

    /**
     * 欠品理由の編集
     *
     * @return RedirectResponse|array<mixed>
     */
    #[Route(
        path: '/%eccube_admin_route%/product/stock/history/updated',
        name: 'admin_stock_history_update',
        methods: ['POST']
    )
    ]
    public function update(Request $request): RedirectResponse|array
    {
        // タイムアウトを無効にする
        set_time_limit(0);

        $builder = $this->formFactory->createBuilder(StockHistoryDisposalType::class, null, []);
        $form = $builder->getForm();
        $form->handleRequest($request);
        $formData = $form->getData();
        $Member = $this->getMember();

        log_info('欠品理由の編集');

        try {
            $inputs = [
                'stockHistoryId' => (int) $formData['stock_history_id'],
                'disposalReason' => (string) $formData['disposal_reason'],
                'memberId' => (int) $Member->getId(),
            ];
            $this->stockHistoryRepository->updateDisposalReason($inputs);
        } catch (\Exception $e) {
            $this->addError('admin.common.save_error', 'admin');

            return $this->redirectToRoute('admin_stock_history');
        }

        $event = new EventArgs(
            [
                'form' => $form,
                'formData' => $formData,
                'Member' => $Member,
            ],
            $request
        );
        $this->eventDispatcher->dispatch($event, EccubeEvents::ADMIN_STOCK_HISTORY_UPDATE_COMPLETE);

        $this->addSuccess('admin.common.save_complete', 'admin');

        return $this->redirectToRoute('admin_stock_history');
    }

