namespace Eccube\Service\Csv\Importer;

use Doctrine\DBAL\ConnectionException;
use Doctrine\ORM\EntityManagerInterface;
use Eccube\Common\EccubeConfig;
use Eccube\Entity\Member;
use Eccube\Service\Csv\Importer\Event\AfterReadEvent;
use Eccube\Service\Csv\Importer\Event\CsvImportHandlerInterface;
use Eccube\Service\Csv\Importer\Event\ReadCsvRowEvent;
use Eccube\Service\Csv\Importer\Model\CsvRow;
use Eccube\Service\CsvImportService;
use Eccube\Util\SqlUtil;
use Eccube\Util\StringUtil;
use Symfony\Component\Filesystem\Filesystem;
use Symfony\Component\HttpFoundation\File\UploadedFile;
use Symfony\Contracts\Translation\TranslatorInterface;

/**
 * CSVからデータを取り込むもの。
 */
class CsvImporter
{
    /** @var int flushPerLines のデフォルト値 */
    public const DEFAULT_FLUSH_PER_LINES = 100;

    /** @var int 行ロックタイムアウト（秒）の最小値 */
    public const MIN_LOCK_TIMEOUT = 1;

    /** @var int 行ロックタイムアウト（秒）の最大値 */
    public const MAX_LOCK_TIMEOUT = 30;

    /** @var EntityManagerInterface */
    private EntityManagerInterface $em;

    /** @var TranslatorInterface */
    private TranslatorInterface $translator;

    /** @var EccubeConfig */
    private EccubeConfig $eccubeConfig;

    /** @var CsvImportHandlerInterface */
    private CsvImportHandlerInterface $handler;

    /** @var Member ログインユーザー */
    private Member $loginUser;

    /** @var int この件数の CSV 行数を処理する度に DB に flush する。 */
    private int $flushPerLines;

    /**
     * @param EntityManagerInterface $em
     * @param TranslatorInterface $translator
     * @param EccubeConfig $eccubeConfig
     * @param CsvImportHandlerInterface $handler 読み込んだファイルを処理するもの
     * @param Member $loginUser ログインユーザー
     */
    public function __construct(
        EntityManagerInterface $em,
        TranslatorInterface $translator,
        EccubeConfig $eccubeConfig,
        CsvImportHandlerInterface $handler,
        Member $loginUser,
    ) {
        $this->em = $em;
        $this->translator = $translator;
        $this->eccubeConfig = $eccubeConfig;
        $this->handler = $handler;
        $this->loginUser = $loginUser;
        $this->flushPerLines = self::DEFAULT_FLUSH_PER_LINES;
    }

    /**
     * @param int $flushPerLines この件数の CSV 行数を処理する度に DB に flush する。
     *
     * @return self
     */
    public function setFlushPerLines(int $flushPerLines): self
    {
        $this->flushPerLines = max($flushPerLines, 1);

        return $this;
    }

    /**
     * ファイルをインポートする。
     *
     * @param UploadedFile $file インポートするファイル
     *
     * @return CsvImportResultInterface 処理結果
     *
     * @throws \Exception
     */
    public function import(UploadedFile $file): CsvImportResultInterface
    {
        $tempFileName = $this->createTempFileName($file);

        try {
            $importService = $this->createCsvImportService($file, $tempFileName);

            $errors = $this->validateBeforeImport($importService);
            if (!empty($errors)) {
                $result = new CsvImportResult();
                $result->setErrors($errors);

                return $result;
            }

            return $this->importRows($importService);
        } finally {
            $this->deleteTempFile($tempFileName);
        }
    }

    /**
     * 一時ディレクトリに保存するときのファイル名を生成する。
     * 一時ディレクトリに保存するときのファイル名を生成する。
     *
     * @param UploadedFile $file アップロードされたファイル
     *
     * @return string ファイル名
     */
    protected function createTempFileName(UploadedFile $file): string
    {
        return 'upload_'.StringUtil::random().'.'.$file->getClientOriginalExtension();
    }

    /**
     * 一時ファイルを削除する。
     *
     * @param string $tempFileName ファイル名
     */
    protected function deleteTempFile(string $tempFileName): void
    {
        try {
            $fs = new Filesystem();
            $fs->remove($this->eccubeConfig['eccube_csv_temp_realdir'].'/'.$tempFileName);
        } catch (\Exception $e) {
            // エラーが発生しても無視する
        }
    }

    /**
     * CSVImportService を生成する。
     *
     * @param UploadedFile $file インポートするファイル
     * @param string $tempFileName 一時ファイルの名前
     *
     * @return CsvImportService
     */
    protected function createCsvImportService(UploadedFile $file, string $tempFileName): CsvImportService
    {
        // アップロードされたCSVファイルを一時ディレクトリに保存
