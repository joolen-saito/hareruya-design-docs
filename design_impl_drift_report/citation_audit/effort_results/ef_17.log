    /**
     * CSVデータ1行を取り込む。
     *
     * @param ReadCsvRowEvent $event イベント
     *
     * @return bool 読み込みに成功した場合 true
     */
    public function onReadRow(ReadCsvRowEvent $event): bool
    {
        $this->persistStockChange($event);

        if ($event->isBreakAll()) {
            return false;
        }

        return true;
    }

    /**
     * 列の定義を取得する。
     *
     * @return array<CsvColumnInterface> 列の定義を CsvColumnInterface で返す。
     */
    protected function getColumns(): array
    {
        return [
            $this->productCodeColumn,
            $this->editQuantityColumn,
            $this->purchaseUnitPriceColumn,
        ];
    }

    /**
     * 列を検証するロジックを取得する。
     *
     * @return array<RowValidatorInterface> 列全体を検証する定義を RowValidatorInterface で返す。
     */
    protected function getRowValidators(): array
    {
        return [
            new PriceConsistencyRowValidator(1, 1),
        ];
    }

