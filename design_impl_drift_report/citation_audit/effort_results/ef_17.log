    #[Route(
        path: '/%eccube_admin_route%/product/stock/history/updated',
        name: 'admin_stock_history_update',
        methods: ['POST']
    )
    ]
    public function update(Request $request): RedirectResponse|array
    {
        // タイムアウトを無効にする
        set_time_limit(0);

        $builder = $this->formFactory->createBuilder(StockHistoryDisposalType::class, null, []);
        $form = $builder->getForm();
        $form->handleRequest($request);
        $formData = $form->getData();
        $Member = $this->getMember();

        log_info('欠品理由の編集');

        try {
            $inputs = [
                'stockHistoryId' => (int) $formData['stock_history_id'],
                'disposalReason' => (string) $formData['disposal_reason'],
                'memberId' => (int) $Member->getId(),
            ];
            $this->stockHistoryRepository->updateDisposalReason($inputs);
        } catch (\Exception $e) {
            $this->addError('admin.common.save_error', 'admin');

            return $this->redirectToRoute('admin_stock_history');
        }

        $event = new EventArgs(
            [
                'form' => $form,
                'formData' => $formData,
                'Member' => $Member,
            ],
            $request
        );
        $this->eventDispatcher->dispatch($event, EccubeEvents::ADMIN_STOCK_HISTORY_UPDATE_COMPLETE);

        $this->addSuccess('admin.common.save_complete', 'admin');

        return $this->redirectToRoute('admin_stock_history');
    }

    /**
     * 在庫履歴CSV出力
     *
     * @param Request $request
     *
     * @return StreamedResponse|RedirectResponse
     */
    #[Route(path: '/%eccube_admin_route%/product/stock/history/csv_export', name: 'admin_stock_history_csv_export', methods: ['POST'])]
    public function csvStockHistoryExport(Request $request): StreamedResponse|RedirectResponse
    {
        $params = $request->request->all();
        $ids = $params['ids'] ?? [];
        $stockHistoryIds = \is_array($ids)
            ? array_values(array_filter(array_map('intval', $ids), fn (int $id): bool => $id > 0))
            : [];

        if ($stockHistoryIds === []) {
            return $this->responseNoStockHistoryIdError($request);
        }

        set_time_limit(0);
        $this->entityManager->getConfiguration()->setSQLLogger(null);

        $stockHistoryCsv = new StockHistoryCsv(
            $this->entityManager,
            $this->translator,
            $this->eccubeConfig,
            $this->stockHistoryRepository,
            $this->csvExportService,
            $this->productRepository,
            $this->productClassRepository,
            $this->productStockRepository,
            $this->getStockHistoryCsvHeader(),
            $this->getRequiredStockHistoryCsvHeader()
        );

        $event = new EventArgs(
            [
                'stockHistoryIds' => $stockHistoryIds,
            ],
            $request
        );
        $this->eventDispatcher->dispatch($event, EccubeEvents::ADMIN_STOCK_HISTORY_STOCK_HISTORY_CSV_EXPORT);

        try {
            return $stockHistoryCsv->exportCsv($stockHistoryIds);
        } catch (\RuntimeException $e) {
            $this->addError($e->getMessage(), 'admin');
            $referer = $request->headers->get('referer');
            if ($referer !== null && $referer !== '') {
                return $this->redirect($referer);
            }

            return $this->redirectToRoute('admin_stock_history');
        }
    }

    /**
     * 欠品履歴CSV出力
     *
     * @param Request $request
     *
     * @return StreamedResponse|RedirectResponse
     */
    #[Route(path: '/%eccube_admin_route%/product/stock/history/disposal/csv_export', name: 'admin_stock_history_disposal_csv_export', methods: ['POST'])]
    public function csvStockHistoryDispozalExport(Request $request): StreamedResponse|RedirectResponse
    {
        $params = $request->request->all();
        $ids = $params['ids'] ?? [];
        $stockHistoryIds = \is_array($ids)
            ? array_values(array_filter(array_map('intval', $ids), fn (int $id): bool => $id > 0))
            : [];

        if ($stockHistoryIds === []) {
            return $this->responseNoStockHistoryIdError($request);
        }

        set_time_limit(0);
        $this->entityManager->getConfiguration()->setSQLLogger(null);

        $stockHistoryDisposalCsv = new StockHistoryDisposalCsv(
            $this->entityManager,
            $this->translator,
            $this->eccubeConfig,
            $this->stockHistoryRepository,
            $this->csvExportService,
            $this->productRepository,
            $this->productClassRepository,
            $this->productStockRepository,
            $this->getStockHistoryDisposalCsvHeader(),
            $this->getRequiredStockHistoryCsvHeader()
        );

        $event = new EventArgs(
            [
                'stockHistoryIds' => $stockHistoryIds,
            ],
            $request
        );
        $this->eventDispatcher->dispatch($event, EccubeEvents::ADMIN_STOCK_HISTORY_STOCK_HISTORY_DISPOZAL_CSV_EXPORT);

        try {
            return $stockHistoryDisposalCsv->exportCsv($stockHistoryIds);
        } catch (\RuntimeException $e) {
            $this->addError($e->getMessage(), 'admin');
            $referer = $request->headers->get('referer');
            if ($referer !== null && $referer !== '') {
                return $this->redirect($referer);
            }

            return $this->redirectToRoute('admin_stock_history');
        }
    }

