class StockApprovalListEntityManager
{
    public function __construct(private readonly EntityManagerInterface $entityManager)
    {
    }

    public function save(
        ?DtbStockApprovalList $StockApprovalList,
        BaseInfo $BaseInfo,
        ?int $StockLocationId,
        MtbStockHistorySourceType $HistorySourceType,
        int $historySourceId,
        ?MtbStockChangeTypeDetail $StockTransferTypeDetail,
        int $approvalStatus,
        \DateTime $registeredDate,
        Member $RegisteredMember,
        ?\DateTime $approvedDate = null,
        ?Member $ApprovalMember = null,
        ?int $ProductStockTotalCount = null,
        ?int $InventoryChangeTotalCount = null,
        ?int $TotalCostPriceBefore = null,
    ): DtbStockApprovalList {
        if (empty($StockApprovalList)) {
            $StockApprovalList = new DtbStockApprovalList();
        }
        $StockApprovalList->setStockLocationId($StockLocationId);
        $StockApprovalList->setHistorySourceType($HistorySourceType);
        $StockApprovalList->setHistorySourceId($historySourceId);
        $StockApprovalList->setStockTransferTypeDetail($StockTransferTypeDetail);
        $StockApprovalList->setApprovalStatus($approvalStatus);
        $StockApprovalList->setRegisteredDate($registeredDate);
        $StockApprovalList->setRegisteredMember($RegisteredMember);
        $StockApprovalList->setApprovedDate($approvedDate);
        $StockApprovalList->setApprovalMember($ApprovalMember);
        $StockApprovalList->setProductStockTotalCount($ProductStockTotalCount);
        $StockApprovalList->setInventoryChangeTotalCount($InventoryChangeTotalCount);
        $StockApprovalList->setTotalCostPriceBefore($TotalCostPriceBefore);

        $this->entityManager->persist($StockApprovalList);
        // TenantEventSubscriber が prePersist で base_info_id をセッション値で上書きするため、
        // persist() の後に在庫元の BaseInfo を明示的に再セットする。
        $StockApprovalList->setBaseInfo($BaseInfo);

        return $StockApprovalList;
    }
}
