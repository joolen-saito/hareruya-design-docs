namespace Eccube\Service\Csv;

use Doctrine\ORM\EntityManagerInterface;
use Eccube\Common\EccubeConfig;
use Eccube\Entity\DtbStockHistory;
use Eccube\Repository\DtbStockHistoryRepository;
use Eccube\Repository\ProductClassRepository;
use Eccube\Repository\ProductRepository;
use Eccube\Repository\ProductStockRepository;
use Eccube\Service\CsvExportService;
use Symfony\Component\HttpFoundation\StreamedResponse;
use Symfony\Contracts\Translation\TranslatorInterface;

class StockHistoryDisposalCsv extends AbstractCsvService
{
    public function __construct(
        EntityManagerInterface $entityManager,
        TranslatorInterface $translator,
        EccubeConfig $eccubeConfig,
        private DtbStockHistoryRepository $stockHistoryRepository,
        private CsvExportService $csvExportService,
        private ProductRepository $productRepository,
        private ProductClassRepository $productClassRepository,
        private ProductStockRepository $productStockRepository,
        array $csvHeader = [],
        array $requiredCsvHeader = [],
    ) {
        parent::__construct($entityManager, $translator, $eccubeConfig, $csvHeader, $requiredCsvHeader);
    }

    /**
     * CSVを出力する
     *
     * @param array<int, mixed> $stockHistoryIds
     *
     * @return StreamedResponse
     */
    public function exportCsv(array $stockHistoryIds): StreamedResponse
    {
        if (empty($stockHistoryIds) || !$StockHistories = $this->stockHistoryRepository->getStockHistories($stockHistoryIds)) {
            throw new \RuntimeException($this->translator->trans('admin.csv.error.export.not_registered_stock_history_id'));
        }

        $csvRows = $this->convertExportCsvRows($StockHistories);
        if ($csvRows === []) {
            throw new \RuntimeException($this->translator->trans('admin.csv.error.export.no_stock_history_data'));
        }
        $response = new StreamedResponse();

        $headerKeys = array_keys($this->csvHeader);
        $response->setCallback(function () use ($csvRows, $headerKeys): void {
            $this->csvExportService->fopen();
            $this->csvExportService->fputcsv($headerKeys);
            foreach ($csvRows as $row) {
                $this->csvExportService->fputcsv(array_map(fn (string $key) => $row[$key] ?? '', $headerKeys));
            }
            $this->csvExportService->fclose();
        });

        $filename = $this->createFileName('stock_history_disposal_');
        $this->setCsvResponseHeader($response, $filename);

        log_info('欠品履歴CSV出力ファイル名', [$filename]);

        return $response;
    }

    /**
     * DtbStockHistoryをCSV出力できる形にコンバート
     *
     * @param array<int, DtbStockHistory> $StockHistories StockHistoryの配列
     *
     * @return array<int, array<string, mixed>>
     */
    public function convertExportCsvRows(array $StockHistories): array
    {
        $csvRows = [];

        foreach ($StockHistories as $StockHistory) {
            $ProductStock = $this->productStockRepository->findOneBy(['id' => $StockHistory->getProductStock()]);
            $ProductClass = $this->productClassRepository->findOneBy(['id' => $ProductStock->getProductClass()]);
            $Product = $this->productRepository->findOneBy(['id' => $ProductClass->getProduct()]);

            $rowBase = [
                '商品コード' => $ProductClass->getCode(),
                '商品名' => $Product->getName(),
                '言語' => $ProductClass->getLanguageNameJp(),
                '状態' => $ProductClass->getCardCondition()->getCode(),
                'Foil' => '',   // TODO - From Foil Master Table
                '店舗' => $ProductStock->getBaseInfo(),
                '在庫場所' => $ProductStock->getLocationName(),
                '登録元' => $StockHistory->getHistorySourceType(),
                '登録元ID' => $StockHistory->getHistorySourceId(),
                '欠品点数' => $StockHistory->getStock(),
                '欠品時販売価格' => $StockHistory->getSellPrice(),
                '欠品理由' => $StockHistory->getStockChangeReason(),
                '登録日' => !empty($StockHistory->getRegisteredAt()) ? $StockHistory->getRegisteredAt()->format('Y-m-d H:i') : '',
                '登録者' => $StockHistory->getRegisteredMember(),
                '最終更新日' => !empty($StockHistory->getUpdateDate()) ? $StockHistory->getUpdateDate()->format('Y-m-d H:i') : '',
                '最終更新者' => $StockHistory->getUpdateMember(),
            ];
            $csvRows[] = $rowBase;
        }

        return $csvRows;
    }
}
