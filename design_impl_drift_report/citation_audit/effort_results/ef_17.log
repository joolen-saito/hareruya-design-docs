        }

        $event = new EventArgs(
            [
                'form' => $form,
                'pagination' => $pagination,
            ],
            $request
        );
        $this->eventDispatcher->dispatch($event, EccubeEvents::ADMIN_STOCK_CHANGE_CSV_NEW_COMPLETE);

        return [
            'form' => $form->createView(),
            'headers' => $headers,
