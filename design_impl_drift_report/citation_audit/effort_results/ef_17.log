    /**
     * CSVデータ1行の形式をチェックする。
     *
     * @param ReadCsvRowEvent $event イベント
     */
    public function onValidateRow(ReadCsvRowEvent $event): void
    {
        /** @var array<CsvColumnInterface> $columns */
        $columns = $this->columnsCache->get();
        $row = $event->getRow();

        // 列数が一致しない場合、エラー
        if (count($row) !== count($columns)) {
            $event->getMessageStore()
                ->addInvalidColumnCountError($row->getRowNumber());
            $event->breakAll();

            return;
        }

        // 行内の各データが正しくない場合、エラー
        $messageStore = $event->getMessageStore();

        /** @var CsvColumnInterface $column */
        foreach ($columns as $column) {
            $name = $column->getName();
            if (!$row->exists($name)) {
                $messageStore->addColumnNotExistsError($row->getRowNumber(), $name);
                $event->breakAll();

                return;
            }

            if (!$column->validate($messageStore, $row)) {
                $event->breakAll();

                return;
            }
        }

        // 行全体を検証する
        /** @var array<RowValidatorInterface> $rowValidators */
        $rowValidators = $this->rowValidatorsCache->get();
        if (!empty($rowValidators)) {
            /** @var RowValidatorInterface $rowValidator */
            foreach ($rowValidators as $rowValidator) {
    public function getQueryBuilderBySameStore(ProductStock $productStock, array $searchData): QueryBuilder
    {
        $qb = $this->createQueryBuilder('ps')
            ->innerJoin('ps.ProductClass', 'pc')
            ->innerJoin('pc.Product', 'p')
            ->andWhere('ps.baseInfo = :baseInfo')
            ->setParameter('baseInfo', $productStock->getBaseInfo());

        if (!empty($searchData['id'])) {
            $qb->andWhere('pc.code LIKE :id')
                ->setParameter('id', '%'.str_replace(['%', '_'], ['\\%', '\\_'], (string) $searchData['id']).'%');
        }

        if (!empty($searchData['category_id'])) {
            $qb->innerJoin('p.ProductCategories', 'pcat')
                ->andWhere($qb->expr()->in('pcat.Category', ':categories'))
                ->setParameter('categories', $searchData['category_id']);
        }

        if (!empty($searchData['stock_location_id'])) {
            $qb->andWhere('ps.stockLocationId = :stockLocationId')
                ->setParameter('stockLocationId', (int) $searchData['stock_location_id']);
        }

        $qb->orderBy('pc.id', 'ASC')
            ->addOrderBy('ps.stockLocationId', 'ASC');

        return $qb;
    }

    /**
     * productCodeからproductStockIdを取得する。
     *
     * @return int|null productStockId
     */
    public function getProductStockIdByProductCode(string $productCode, BaseInfo $BaseInfo, int $stockLocationId): ?int
    {
        $qb = $this->createQueryBuilder('ps');
        $qb->select('ps.id')
            ->innerJoin('ps.ProductClass', 'pc')
            ->where('pc.code = :productCode')
            ->setParameter('productCode', $productCode)
            ->andWhere('ps.baseInfo = :baseInfo')
            ->setParameter('baseInfo', $BaseInfo)
            ->andWhere('ps.stockLocationId = :stockLocationId')
            ->setParameter('stockLocationId', $stockLocationId)
            ->setMaxResults(1);

        $result = $qb->getQuery()->getOneOrNullResult();

        return $result ? $result['id'] : null;
    }

