namespace Eccube\Service\Admin\Stock\Util;

use Eccube\Entity\DtbStockApprovalList;
use Eccube\Entity\DtbStockEditApproval;
use Eccube\Entity\DtbStockEditApprovalDetail;
use Eccube\Entity\Member;
use Eccube\Repository\DtbStockHistoryRepository;
use Eccube\Service\EntityManager\ProductStockEntityManager;
use Eccube\Service\EntityManager\StockHistoryEntityManager;

/**
 * 在庫編集承認一覧の明細1行に対する承認処理。
 */
class StockEditApprovalLineItemApprover
{
    public function __construct(
        private readonly DtbStockHistoryRepository $dtbStockHistoryRepository,
        private readonly ProductStockEntityManager $productStockEntityManager,
        private readonly StockHistoryEntityManager $stockHistoryEntityManager,
    ) {
    }

    public function approve(
        DtbStockEditApprovalDetail $Detail,
        DtbStockEditApproval $StockEditApproval,
        DtbStockApprovalList $StockApprovalList,
        Member $ApprovalMember,
        \DateTime $approvedDate,
    ): void {
        $StockChangeTypeDetail = $StockEditApproval->getStockChangeTypeDetail();

        if ($StockChangeTypeDetail->isTypeDisposal()) {
            $this->approveDisposal($Detail, $StockEditApproval, $StockApprovalList, $ApprovalMember, $approvedDate);
        } else {
            $this->approveBeStocked($Detail, $StockApprovalList, $ApprovalMember, $approvedDate);
        }
    }

    /**
     * 廃棄系承認
     *
     * - 申請時に作成済みの在庫履歴を更新
     * - 在庫情報は申請時に反映済みのため更新不要
     */
    private function approveDisposal(
        DtbStockEditApprovalDetail $Detail,
        DtbStockEditApproval $StockEditApproval,
        DtbStockApprovalList $StockApprovalList,
        Member $ApprovalMember,
        \DateTime $approvedDate,
    ): void {
        $ProductStock = $Detail->getProductStock();

        $StockHistory = $this->dtbStockHistoryRepository->findOneBy([
            'historySourceId' => $StockEditApproval->getId(),
            'HistorySourceType' => $StockApprovalList->getHistorySourceType(),
            'ProductStock' => $ProductStock,
        ]);
        if ($StockHistory === null) {
            return;
        }

        $StockHistory->setApprovalMember($ApprovalMember);
        $StockHistory->setApprovalAt($approvedDate);
        $StockHistory->setUpdateMember($ApprovalMember);
    }

    /**
     * 入庫系承認
     *
     * - 在庫数・総原価を更新
     * - 在庫変動履歴を新規作成
     */
    private function approveBeStocked(
        DtbStockEditApprovalDetail $Detail,
        DtbStockApprovalList $StockApprovalList,
        Member $ApprovalMember,
        \DateTime $approvedDate,
    ): void {
        $ProductStock = $Detail->getProductStock();
        $StockEditApproval = $Detail->getStockEditApproval();
        $StockChangeTypeDetail = $StockEditApproval->getStockChangeTypeDetail();

        $beforeEditQuantity = (string) ($Detail->getBeforeEditQuantity() ?? 0);
        $editQuantity = (string) $Detail->getEditQuantity();
        $purchaseUnitPrice = $Detail->getPurchaseUnitPrice();

        // 登録時点の在庫 + 在庫増減数
        $stockAfter = bcadd($beforeEditQuantity, $editQuantity, 0);

        // 入庫時の総原価 = 登録時点の総原価 + (入庫単価 × 数量)
        $totalCostBefore = $ProductStock->getTotalCost();
        $totalCostAfter = bcadd($totalCostBefore, bcmul($purchaseUnitPrice, $editQuantity, 0), 0);
        $unitCostBefore = $ProductStock->getUnitCost();

        $this->productStockEntityManager->save(
            ProductStock: $ProductStock,
            ProductClass: $ProductStock->getProductClass(),
            BaseInfo: $ProductStock->getBaseInfo(),
            stock: $stockAfter,
            pickUpFlg: $ProductStock->getPickUpFlg(),
            stockLocationId: $ProductStock->getStockLocationId(),
            totalCost: $totalCostAfter,
        );

        $this->stockHistoryEntityManager->save(
            ProductStock: $ProductStock,
            StockChangeTypeDetail: $StockChangeTypeDetail,
            oldStock: $beforeEditQuantity,
            stock: $stockAfter,
            stockChangeQuantity: $editQuantity,
            sellPrice: (string) $ProductStock->getProductClass()->getPrice02(),
            unitCostPriceBefore: $unitCostBefore,
            unitCostPriceAfter: $ProductStock->getUnitCost(),
            totalCostPriceBefore: $totalCostBefore,
            totalCostPriceAfter: $totalCostAfter,
            stockChangeReason: $Detail->getStockChangeReason(),
            shortageReason: null,
            HistorySourceType: $StockApprovalList->getHistorySourceType(),
            historySourceId: $StockEditApproval->getId(),
            registeredAt: $StockEditApproval->getRegisteredAt(),
            RegisteredMember: $StockEditApproval->getRegisteredMember(),
            operatorMemberName: $StockEditApproval->getRegisteredMember()->getName(),
            Member: $ApprovalMember,
            ApprovalMember: $ApprovalMember,
            approvalAt: $approvedDate,
            updateDate: $approvedDate,
            UpdateMember: $ApprovalMember,
        );
    }
}
            }

            return $this->redirectToRoute('admin_stock_move_transfer');
        }

        $event = new EventArgs(
            [
                'result' => $result,
            ],
            $request
        );
        $this->eventDispatcher->dispatch($event, EccubeEvents::ADMIN_STOCK_MOVE_TRANSFER_IMPORT_STOCK_MOVE_CSV_COMPLETE);

        $this->addSuccess('admin.register.complete', 'admin');

        log_info('在庫移動CSV登録完了', ['count' => $result->getCount()]);
        $this->csvImportHistoryRepository->insertCsvImportHistory(
            MtbCsvImportType::STOCK_MOVE_IMPORT_CSV_ID,
            $formFile->getClientOriginalName(),
            $Member->getId()
        );

