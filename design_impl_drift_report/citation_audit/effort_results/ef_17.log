        private readonly ProductStockEntityManager $productStockEntityManager,
        private readonly StockEditApprovalEntityManager $stockEditApprovalEntityManager,
        private readonly StockEditApprovalDetailEntityManager $stockEditApprovalDetailEntityManager,
        private readonly StockHistoryEntityManager $stockHistoryEntityManager,
        private readonly MtbStockHistorySourceTypeRepository $stockHistorySourceTypeRepository,
        private readonly StockApprovalListEntityManager $stockApprovalListEntityManager,
    ) {
    }

    public function handle(StockApprovalStoreInput $input): void
    {
        $HistorySourceType = $this->stockHistorySourceTypeRepository->find(MtbStockHistorySourceType::STOCK_EDIT);

        $this->entityManager->beginTransaction();

        try {
            $now = new \DateTime();
            $ProductStock = $input->ProductStock;
            $stockChangeQuantity = $input->stockChangeQuantity;
            $StockChangeTypeDetail = $input->StockChangeTypeDetail;
            $purchaseUnitPrice = ($input->purchasePrice === null || $input->purchasePrice === '') ? '0' : $input->purchasePrice;

            $StockEditApproval = $this->stockEditApprovalEntityManager->save(
                BaseInfo: $ProductStock->getBaseInfo(),
                StockChangeTypeDetail: $StockChangeTypeDetail,
                approvalStatus: 1,// TODO: 承認ステータスのマスター化
                registeredAt: $now,
                RegisteredMember: $input->Member,
                approvedAt: null,
                ApprovalMember: null,
            );

            $this->entityManager->flush();

            $this->stockEditApprovalDetailEntityManager->save(
                StockEditApproval: $StockEditApproval,
                ProductStock: $ProductStock,
                editQuantity: (int) $stockChangeQuantity,
                stockChangeReason: $input->stockChangeReason,
                purchaseUnitPrice: $purchaseUnitPrice,
                outboundTotalCost: $ProductStock->getMovementTotalCost($stockChangeQuantity),
                Member: $input->Member,
                beforeEditQuantity: (int) $ProductStock->getStock(),
                beforePurchaseUnitPrice: $ProductStock->getUnitCost(),
            );

            $totalCostChange = $StockChangeTypeDetail->isTypeBeStocked()
                ? (int) bcmul($purchaseUnitPrice, (string) $stockChangeQuantity, 0)
                : (int) $ProductStock->getMovementTotalCost($stockChangeQuantity);

            if ($StockChangeTypeDetail->isTypeDisposal()) {
                $sellPrice = (string) $ProductStock->getProductClass()->getPrice02();

                $beforeStock = $ProductStock->getStock();
                $totalCostPriceBefore = $ProductStock->getTotalCost();
                $unitCostPriceBefore = $ProductStock->getUnitCost();

                $afterStock = $ProductStock->getStockQuantityAfterChange($stockChangeQuantity);
                $totalCostPriceAfter = $ProductStock->getTotalCostAfterChange($stockChangeQuantity);
                $unitCostPriceAfter = $ProductStock->getUnitCostPriceAfterChange($stockChangeQuantity);

                $this->productStockEntityManager->save(
                    ProductStock: $ProductStock,
                    ProductClass: $ProductStock->getProductClass(),
                    BaseInfo: $ProductStock->getBaseInfo(),
                    stockLocationId: $ProductStock->getStockLocationId(),
                    pickUpFlg: $ProductStock->getPickUpFlg(),
                    stock: $afterStock,
                    totalCost: $totalCostPriceAfter,
                );

                $this->stockHistoryEntityManager->save(
                    ProductStock: $ProductStock,
                    StockChangeTypeDetail: $StockChangeTypeDetail,
                    oldStock: $beforeStock,
                    stock: $afterStock,
                    stockChangeQuantity: $stockChangeQuantity,
                    sellPrice: $sellPrice,
                    unitCostPriceBefore: $unitCostPriceBefore,
                    unitCostPriceAfter: $unitCostPriceAfter,
                    totalCostPriceBefore: $totalCostPriceBefore,
                    totalCostPriceAfter: $totalCostPriceAfter,
                    stockChangeReason: $input->stockChangeReason,
                    shortageReason: null,
                    HistorySourceType: $HistorySourceType,
                    historySourceId: $StockEditApproval->getId(),
                    registeredAt: $now,
                    RegisteredMember: $input->Member,// 登録者
                    operatorMemberName: $input->Member->getName(),
                );
            }

            $this->entityManager->flush();

            $this->stockApprovalListEntityManager->save(
                StockApprovalList: null,
                BaseInfo: $ProductStock->getBaseInfo(),
                StockLocationId: $ProductStock->getStockLocationId(),
                HistorySourceType: $HistorySourceType,
                historySourceId: $StockEditApproval->getId(),
                StockTransferTypeDetail: $this->entityManager->getReference(MtbStockChangeTypeDetail::class, $StockChangeTypeDetail->getId()),
                approvalStatus: DtbStockApprovalList::APPROVAL_STATUS_UNAPPROVED,
                registeredDate: $now,
                RegisteredMember: $input->Member,
                approvedDate: null,
                ApprovalMember: null,
                ProductStockTotalCount: 1,
                InventoryChangeTotalCount: (int) $stockChangeQuantity,
                TotalCostPriceBefore: $totalCostChange,
            );

            $this->entityManager->flush();
            $this->entityManager->commit();
        } catch (\Exception $e) {
            $this->entityManager->rollback();

            throw $e;
        }
    }
}

