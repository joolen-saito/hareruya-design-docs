use Eccube\Service\Upload\FileManager;
use Eccube\Util\StringUtil;

/**
 * 在庫変更CSVをインポートするもの。
 */
class StockChangeCsvImportHandler extends BaseCsvImportHandler
{
    private const S3_PREFIX = 'csv/stock-change/';

    /** @var CsvColumnInterface 列: 商品コード */
    private ?CsvColumnInterface $productCodeColumn = null;

    /** @var CsvColumnInterface 列: 在庫増減数 */
    private ?CsvColumnInterface $editQuantityColumn = null;

    /** @var CsvColumnInterface 列: 仕入単価 */
    private ?CsvColumnInterface $purchaseUnitPriceColumn = null;

    private int $totalInventoryChange = 0;
    private int $totalCostPriceBefore = 0;
    private int $rowCount = 0;

    /** @var int|null CsvImporter トランザクション内で採番される在庫編集承認ID */
    private ?int $stockEditApprovalId = null;

    /**
     * @param StockChangeCsvImportInput $input
     */
    public function __construct(
        private readonly DtbStockEditApprovalRepository $stockEditApprovalRepository,
        private readonly DtbStockEditApprovalDetailRepository $stockEditApprovalDetailRepository,
        private readonly BaseInfoRepository $baseInfoRepository,
        private readonly ProductStockRepository $productStockRepository,
        private readonly MtbStockHistorySourceTypeRepository $stockHistorySourceTypeRepository,
        private readonly EntityManagerInterface $entityManager,
        private readonly StockApprovalListEntityManager $stockApprovalListEntityManager,
        private readonly DtbStockEditCsvRepository $stockEditCsvRepository,
        private readonly FileManager $fileManager,
        private readonly Member $Member,
        private StockChangeCsvImportInput $input,
    ) {
        $this->input = $input;
    }

    public function onBeforeImport(): void
    {
        parent::onBeforeImport();

        $this->initializeColumnDefinitions();
        $this->totalInventoryChange = 0;
        $this->totalCostPriceBefore = 0;
        $this->rowCount = 0;

        // CsvImporter::importRows のトランザクション内で親レコードを作成する。
        $stockEditApprovalId = $this->stockEditApprovalRepository->insertStockChange([
            'stockChangeTypeDetail' => $this->input->stockChangeTypeDetailId,
            'approvalNotificationTargetMembers' => $this->input->approvalNotificationTargetMembers,
            'changeBaseInfo' => $this->input->changeBaseInfoId,
        ]);

        if ($stockEditApprovalId === null) {
            throw new \RuntimeException('Failed to insert stock edit approval.');
        }

        $this->stockEditApprovalId = $stockEditApprovalId;
    }

    /**
     * 在庫編集承認IDを返す。
     */
    public function getStockEditApprovalId(): ?int
    {
        return $this->stockEditApprovalId;
    }

    /**
     * 採番済みの在庫編集承認IDを返す。未採番の場合は例外。
     */
    private function requireStockEditApprovalId(): int
    {
        if ($this->stockEditApprovalId === null) {
            throw new \LogicException('stockEditApprovalId is not initialized.');
        }

        return $this->stockEditApprovalId;
    }

    public function onAfterImport(AfterReadEvent $event): void
    {
        parent::onAfterImport($event);

        if ($this->rowCount > 0 && $event->isSuccessful()) {
            $now = new \DateTime('now', new \DateTimeZone('UTC'));
            $HistorySourceType = $this->stockHistorySourceTypeRepository->find(MtbStockHistorySourceType::STOCK_CHANGE_CSV_IMPORT);
            $BaseInfo = $this->entityManager->getReference(BaseInfo::class, $this->input->changeBaseInfoId);

            $this->stockApprovalListEntityManager->save(
                StockApprovalList: null,
                BaseInfo: $BaseInfo,
                StockLocationId: $this->input->changeStockLocationId,
                HistorySourceType: $HistorySourceType,
                historySourceId: $this->requireStockEditApprovalId(),
                StockTransferTypeDetail: $this->entityManager->getReference(MtbStockChangeTypeDetail::class, $this->input->stockChangeTypeDetailId),
                approvalStatus: DtbStockApprovalList::APPROVAL_STATUS_UNAPPROVED,

        /** @var UploadedFile $file */
        $file = $form->get('import_file')->getData();

        // レコード数上限チェック
        if ($this->countCsvRows($file) >= static::ADMIN_CSV_IMPORT_MAX_ROWS) {
            $this->addErrors($this->getCsvImportMaxRowsExceededMessage());

            return [
                'form' => $form->createView(),
                'headers' => $headers,
            ];
        }

        log_info('在庫変更CSV登録開始');

        // UTF-8 BOM 付きファイルをアップロードした場合も処理できるよう、
        // バイトレベルで BOM (\xEF\xBB\xBF) を除去する。
        $filePath = $file->getRealPath();
        if ($filePath !== false) {
            $content = file_get_contents($filePath);
            if ($content !== false && str_starts_with($content, "\xEF\xBB\xBF")) {
                file_put_contents($filePath, substr($content, 3));
            }
        }

        try {
            $extension = $file->getClientOriginalExtension();
            if ($extension === '') {
                $extension = 'csv';
            }
            $tempFileName = 'upload_'.StringUtil::random().'.'.$extension;
            $importFilePath = rtrim((string) $this->eccubeConfig['eccube_csv_temp_realdir'], '/').'/'.$tempFileName;

            $input = new StockChangeCsvImportInput(
                changeBaseInfoId: (int) $formData['change_base_info']->getId(),
                changeStockLocationId: (int) $formData['change_stock_location_id'],
                stockChangeTypeDetailId: (int) $formData['stock_change_type_detail']->getId(),
                stockChangeReason: $formData['stock_change_reason'],
                approvalDepartment: (int) $formData['approval_department'],
                approvalNotificationTargetMembers: (int) $formData['approval_notification_target_members'],
                originalFileName: (string) $file->getClientOriginalName(),
                importFilePath: $importFilePath,
            );

            $handler = new StockChangeCsvImportHandler(
            ->innerJoin('sa.StockChangeTypeDetail', 'msd')
            ->innerJoin('msd.StockChangeType', 'mst')
            ->innerJoin('sc.Member', 'm')
            ->leftJoin('sa.ApprovalMember', 'am')
            ->innerJoin('sa.baseInfo', 'bi')
            ->addSelect(
                'CASE WHEN sa.approvedAt IS NOT NULL AND (sc.createDate IS NULL OR sa.approvedAt > sc.createDate)'
                .' THEN sa.approvedAt ELSE sc.createDate END AS HIDDEN baseDate'
            )
            ->orderBy('baseDate', 'DESC')
            ->addOrderBy('sa.id', 'DESC');
    }
}
