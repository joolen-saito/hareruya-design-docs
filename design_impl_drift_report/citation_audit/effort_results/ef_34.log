{% block javascript %}
    <script nonce="{{ csp_nonce }}">
        $(function () {
            $('form[name="top_banner_upload"]').on('submit', function (event) {
                const $form = $(this);
                const $fileInput = $form.find('input[type="file"]');
                const $errorBox = $('#top-banner-upload-error');
                if ($errorBox.length) {
                    $errorBox.text('');
                }
                if ($fileInput.length && !$fileInput.val()) {
                    if ($errorBox.length) {
                        $errorBox.text('{{ 'admin.data.top_banner.upload_required'|trans }}');
                    }
                    event.preventDefault();
                }
            });

            function copyString(textString) {
                const $tmpAttr = $('<div></div>');
                $tmpAttr.text(textString);
                $tmpAttr.css({
                    position: 'absolute',
                    left: '-100%',
                });
                $('body').append($tmpAttr);
                const selection = document.getSelection();
                if (selection) {
                    selection.removeAllRanges();
                    selection.selectAllChildren($tmpAttr.get(0));
                }
                const copied = document.execCommand('copy');
                $tmpAttr.remove();
                if (!copied) {
                    if (navigator.clipboard && navigator.clipboard.writeText) {
                        navigator.clipboard.writeText(textString);
                    } else {
                        window.prompt('URL', textString);
                    }
                }
                return copied;
            }

            $(document).on('click', '.js-copy-url', function (event) {
                event.preventDefault();
                const url = $(this).data('url');
                if (!url) {
                    return;
                }
                copyString(url);
            });
        });
    </script>
