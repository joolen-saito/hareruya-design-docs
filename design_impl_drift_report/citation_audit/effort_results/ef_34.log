    #[Route('/%eccube_admin_route%/archetype/csv_import', name: 'admin_archetype_csv_import', methods: ['GET', 'POST'])]
    #[Template('@admin/Archetype/csv_import.twig')]
    public function csv(Request $request): array|RedirectResponse
    {
        $form = $this->createForm(CsvImportType::class);
        $headers = $this->getCsvHeader();

        if (!$request->isMethod('POST')) {
            return $this->renderWithErrors($form, $headers, []);
        }

        $form->handleRequest($request);

        if (!$form->isSubmitted() || !$form->isValid()) {
            return $this->renderWithErrors($form, $headers, []);
        }

        /** @var UploadedFile|null $formFile */
        $formFile = $form->get('import_file')->getData();
        if ($formFile === null) {
            return $this->renderWithErrors($form, $headers, [trans('admin.common.csv_upload_error')]);
        }

        if ($this->countCsvRows($formFile) >= static::ADMIN_CSV_IMPORT_MAX_ROWS) {
            return $this->renderWithErrors($form, $headers, [$this->getCsvImportMaxRowsExceededMessage()]);
        }

        /** @var Member $Member */
        $Member = $this->getUser();

        $handler = new ArchetypeUpdateImportHandler(
            $this->entityManager,
            $this->archetypeRepository,
            $this->formatRepository,
            $this->colorRepository,
            $this->cardImageRepository,
        );
        $importer = new CsvImporter(
            $this->entityManager,
            $this->translator,
            $this->eccubeConfig,
            $handler,
            $Member,
        );

        try {
            $result = $importer->import($formFile);
        } catch (\Exception $e) {
            log_error('archetype csv import error', ['message' => $e->getMessage()]);

            return $this->renderWithErrors($form, $headers, [trans('admin.common.csv_upload_error')]);
        }

        if ($result->hasError()) {
            $errors = array_map(static fn (array $error): string => $error['message'], $result->getErrors());

            return $this->renderWithErrors($form, $headers, $errors);
        }

        $this->addSuccess('admin.common.csv_upload_complete', 'admin');

        return $this->redirectToRoute('admin_archetype_csv_import');
    }

    /**
