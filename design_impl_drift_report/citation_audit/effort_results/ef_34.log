     */
    #[Route('/%eccube_admin_route%/archetype/{id}/delete', name: 'admin_archetype_delete', requirements: ['id' => '\d+'], methods: ['POST'])]
    public function delete(Request $request, DtbArchetype $Archetype): RedirectResponse
    {
        if (!$this->isCsrfTokenValid('admin_archetype_delete', $request->request->get('_token'))) {
            $this->addError('admin.common.csrf_invalid', 'admin');

            return $this->redirectToRoute('admin_archetype_list');
        }

        try {
            $this->deleteAction->handle($Archetype);
        } catch (\RuntimeException $e) {
            $this->addError($e->getMessage(), 'admin');

            return $this->redirectToRoute('admin_archetype_edit', ['id' => $Archetype->getId()]);
        } catch (\Exception $e) {
            log_error('アーキタイプ削除エラー', ['message' => $e->getMessage()]);
            $this->addError('admin.common.delete_error', 'admin');

            return $this->redirectToRoute('admin_archetype_edit', ['id' => $Archetype->getId()]);
        }

        $this->addSuccess('admin.common.delete_complete', 'admin');

        $event = new EventArgs(
            [
                'Archetype' => $Archetype,
            ],
            $request
        );
        $this->eventDispatcher->dispatch($event, EccubeEvents::ADMIN_ARCHETYPE_DELETE_COMPLETE);

        return $this->redirectToRoute('admin_archetype_list');
    }

    /**
     * 保存処理（新規/編集共通）.
     *
     * @return array<string, mixed>|RedirectResponse
     */
    private function save(Request $request, DtbArchetype $Archetype, bool $isNew): array|RedirectResponse
    {
        $form = $this->createForm(ArchetypeType::class, $Archetype);

        if (!$isNew && !$request->isMethod('POST') && $Archetype->getCardImage() !== null) {
            $form->get('cardImageId')->setData((string) $Archetype->getCardImage()->getId());
        }

        $event = new EventArgs(
            [
                'form' => $form,
                'Archetype' => $Archetype,
            ],
            $request
        );
        $this->eventDispatcher->dispatch(
            $event,
            $isNew ? EccubeEvents::ADMIN_ARCHETYPE_NEW_INITIALIZE : EccubeEvents::ADMIN_ARCHETYPE_EDIT_INITIALIZE
        );

        $form->handleRequest($request);

        if ($form->isSubmitted() && $form->isValid()) {
            $User = $this->getUser();
            $Member = $User instanceof \Eccube\Entity\Member ? $User : null;

            $cardImageRaw = $form->get('cardImageId')->getData();
            $cardImageId = ($cardImageRaw !== null && $cardImageRaw !== '') ? (int) $cardImageRaw : null;

            $input = new ArchetypeStoreInput($Archetype, $cardImageId, $Member);

            try {
                $Saved = $this->storeAction->handle($input);

                $event = new EventArgs(
                    [
                        'form' => $form,
                        'Archetype' => $Saved,
                    ],
                    $request
                );
                $this->eventDispatcher->dispatch(
                    $event,
                    $isNew ? EccubeEvents::ADMIN_ARCHETYPE_NEW_COMPLETE : EccubeEvents::ADMIN_ARCHETYPE_EDIT_COMPLETE
                );

                $this->addSuccess('admin.common.save_complete', 'admin');

                return $this->redirectToRoute('admin_archetype_edit', ['id' => $Saved->getId()]);
            } catch (\RuntimeException $e) {
                $this->addError($e->getMessage(), 'admin');
            } catch (\Exception $e) {
                log_error('アーキタイプ保存エラー', ['message' => $e->getMessage()]);
                $this->addError('admin.common.save_error', 'admin');
            }
        }

        return [
            'form' => $form->createView(),
            'Archetype' => $Archetype,
            'isNew' => $isNew,
        ];
    }

    /**
     * 代表カード検索（Ajax）.
     */
    #[Route('/%eccube_admin_route%/archetype/search_card_image', name: 'admin_archetype_search_card_image', methods: ['POST'])]
    public function searchCardImage(Request $request): JsonResponse
    {
        $searchWord = $request->request->getString('search_word');
        $exactMatch = $request->request->getString('exact_match') === '1';
        $cardText = $request->request->getString('card_text');
        $page = max(1, $request->request->getInt('page', 1));
        $limit = 10;

        $qb = $this->archetypeEntityManager->createQueryBuilder()
            ->select('ci.id', 'ci.url', 'c.name_jp', 'c.name_en')
            ->from(\Eccube\Entity\Master\MtbCardImage::class, 'ci')
            ->join('ci.CardDetail', 'cd')
            ->join('cd.Card', 'c')
            ->andWhere('ci.back_flg = false');

        if (!empty($searchWord)) {
            if ($exactMatch) {
                $qb->andWhere($qb->expr()->orX(
                    $qb->expr()->eq('c.name_jp', ':word'),
                    $qb->expr()->eq('c.name_en', ':word'),
                ))
                    ->setParameter('word', $searchWord);
            } else {
                $qb->andWhere($qb->expr()->orX(
                    $qb->expr()->like('c.name_jp', ':word'),
                    $qb->expr()->like('c.name_en', ':word'),
                ))
                    ->setParameter('word', '%'.$searchWord.'%');
            }
        }

        if (!empty($cardText)) {
            $qb->andWhere($qb->expr()->orX(
                $qb->expr()->like('c.text_jp', ':cardText'),
                $qb->expr()->like('c.text_en', ':cardText'),
            ))
                ->setParameter('cardText', '%'.$cardText.'%');
        }

        if ($DeckTags !== null) {
            $Archetype->setDeckTags($DeckTags);
        }

        $this->entityManager->persist($Archetype);

        return $Archetype;
    }

    /**
     * アーキタイプを削除する。
     */
    public function delete(?DtbArchetype $Archetype): void
    {
        if ($Archetype === null) {
            return;
        }

        $this->entityManager->remove($Archetype);
    }
