                            $uploadForm->get('file')->addError(new \Symfony\Component\Form\FormError(
                                trans('admin.common.upload_error')
                            ));
                        }
                    }
                }
            } elseif ($form->isSubmitted() && $form->isValid()) {
                $bannerError = $this->storeTopBanners($form, $TopBanners);
                if ($bannerError === null) {
                    $event = new EventArgs(
                        [
                            'form' => $form,
                        ],
                        $request
                    );
                    $this->eventDispatcher->dispatch($event, EccubeEvents::ADMIN_DATA_TOP_BANNER_INDEX_COMPLETE);

                    $this->addSuccess('admin.common.save_complete', 'admin');

                    return $this->redirectToRoute('admin_data_top_banner', [], 303);
                }
            }
        }

        return [
            'form' => $form->createView(),
            'uploadForm' => $uploadForm->createView(),
            'TopBanners' => $TopBanners,
            'bannerError' => $bannerError,
            'topBannerFiles' => $this->topBannerFileListAction->handle($shopDigit),
            'AllBaseInfos' => $AllBaseInfos,
            'filterBaseInfoDigit' => $filterBaseInfoDigit,
        ];
    }

