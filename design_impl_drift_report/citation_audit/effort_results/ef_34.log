{% block main %}
    <div class="c-contentsArea__cols">
        <div class="c-contentsArea__primaryCol">
            <div class="c-primaryCol">
                <div class="card rounded border-0">
                    <div class="card-body">
                        <div class="table-responsive with-border">
                            <table class="table table-striped buy-price-list-table">
                                <thead>
                                    <tr>
                                        <th rowspan="2">{{ 'admin.data.buy_price_list.nm_price'|trans }}</th>
                                        <th colspan="{{ CardConditions|length }}" class="text-center">{{ 'admin.data.buy_price_list.normal_card'|trans }}</th>
                                        <th colspan="{{ CardConditions|length }}" class="text-center">{{ 'admin.data.buy_price_list.special_card'|trans }}</th>
                                    </tr>
                                    <tr>
                                        {% for CardCondition in CardConditions %}
                                            <th>{{ CardCondition.code }}</th>
                                        {% endfor %}
                                        {% for CardCondition in CardConditions %}
                                            <th>{{ CardCondition.code }}</th>
                                        {% endfor %}
                                    </tr>
                                </thead>
                                <tbody>
                                    {% for nmPrice, buyPriceForFlg in buyPriceMap %}
                                        <tr>
                                            <td>{{ nmPrice|price }}</td>
                                            {% for specialFlg in [0, 1] %}
                                                {% for CardCondition in CardConditions %}
                                                    {% if buyPriceForFlg[specialFlg] is defined and buyPriceForFlg[specialFlg][CardCondition.id] is defined %}
                                                        <td><a href="{{ path('admin_data_buy_price_list_edit', {id: buyPriceForFlg[specialFlg][CardCondition.id].id}) }}">{{ buyPriceForFlg[specialFlg][CardCondition.id].price|price }}</a></td>
                                                    {% else %}
                                                        <td>-</td>
                                                    {% endif %}
                                                {% endfor %}
                                            {% endfor %}
                                        </tr>
                                    {% endfor %}
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
{% endblock main %}

