namespace Eccube\Form\Type;

use Eccube\Common\EccubeConfig;
use Eccube\Form\EventListener\ConvertKanaListener;
use Symfony\Component\Form\AbstractType;
use Symfony\Component\Form\Extension\Core\Type\TextType;
use Symfony\Component\Form\FormBuilderInterface;
use Symfony\Component\Form\FormError;
use Symfony\Component\Form\FormEvents;
use Symfony\Component\Form\FormInterface;
use Symfony\Component\Form\FormView;
use Symfony\Component\OptionsResolver\OptionsResolver;
use Symfony\Component\Validator\Constraints\Length;
use Symfony\Component\Validator\Constraints\NotBlank;
use Symfony\Component\Validator\Constraints\Type;

class FaxNumberType extends AbstractType
{
    /**
     * {@inheritdoc}
     */
    public function __construct(protected EccubeConfig $config)
    {
    }

    /**
     * {@inheritdoc}
     */
    #[\Override]
    public function buildForm(FormBuilderInterface $builder, array $options): void
    {
        $options['fax01_options']['required'] = $options['required'];
        $options['fax02_options']['required'] = $options['required'];
        $options['fax03_options']['required'] = $options['required'];
        // required の場合は NotBlank も追加する
        if ($options['required']) {
            $options['options']['constraints'] = array_merge([new NotBlank([])], $options['options']['constraints']);
        }
        if (!isset($options['options']['error_bubbling'])) {
            $options['options']['error_bubbling'] = $options['error_bubbling'];
        }
        // nameは呼び出しもとで定義したものを使う
        if (empty($options['fax01_name'])) {
            $options['fax01_name'] = $builder->getName().'01';
        }
        if (empty($options['fax02_name'])) {
            $options['fax02_name'] = $builder->getName().'02';
        }
        if (empty($options['fax03_name'])) {
            $options['fax03_name'] = $builder->getName().'03';
        }
        // 全角英数を事前に半角にする
        $builder->addEventSubscriber(new ConvertKanaListener());
        $builder
            ->add($options['fax01_name'], TextType::class, array_merge_recursive($options['options'], $options['fax01_options']))
            ->add($options['fax02_name'], TextType::class, array_merge_recursive($options['options'], $options['fax02_options']))
            ->add($options['fax03_name'], TextType::class, array_merge_recursive($options['options'], $options['fax03_options']))
        ;
        $builder->setAttribute('fax01_name', $options['fax01_name']);
        $builder->setAttribute('fax02_name', $options['fax02_name']);
        $builder->setAttribute('fax03_name', $options['fax03_name']);

        $builder->addEventListener(FormEvents::POST_SUBMIT, function ($event) use ($options) {
            $form = $event->getForm();

            $isFax01Entered = $form[$options['fax01_name']]->getData() !== null;
            $isFax02Entered = $form[$options['fax02_name']]->getData() !== null;
            $isFax03Entered = $form[$options['fax03_name']]->getData() !== null;

            $isFaxNumberComplete = $isFax01Entered && $isFax02Entered && $isFax03Entered;
            $isFaxNumberEmpty = !$isFax01Entered && !$isFax02Entered && !$isFax03Entered;

            if ($isFaxNumberComplete || $isFaxNumberEmpty) {
                return;
            }

            if (!$isFax01Entered) {
                // 一部のみ入力されている場合はエラーとする
                $form[$options['fax01_name']]->addError(new FormError(trans('form.type.all_enter', [], 'validators')));
            }

            if (!$isFax02Entered) {
                // 一部のみ入力されている場合はエラーとする
                $form[$options['fax02_name']]->addError(new FormError(trans('form.type.all_enter', [], 'validators')));
            }

            if (!$isFax03Entered) {
                // 一部のみ入力されている場合はエラーとする
                $form[$options['fax03_name']]->addError(new FormError(trans('form.type.all_enter', [], 'validators')));
            }
        });
    }

    /**
     * {@inheritdoc}
     */
    #[\Override]
    public function buildView(FormView $view, FormInterface $form, array $options): void
    {
        $builder = $form->getConfig();
        $view->vars['fax01_name'] = $builder->getAttribute('fax01_name');
        $view->vars['fax02_name'] = $builder->getAttribute('fax02_name');
        $view->vars['fax03_name'] = $builder->getAttribute('fax03_name');
    }

    /**
     * {@inheritdoc}
     */
    #[\Override]
    public function configureOptions(OptionsResolver $resolver): void
    {
        $resolver->setDefaults([
            'options' => ['constraints' => []],
            'fax01_options' => [
                'constraints' => [
                    new Type(type: 'numeric', message: 'form_error.numeric_only'),
                    new Length(['max' => $this->config['eccube_split_tel_len_max'], 'min' => $this->config['eccube_split_tel_len_min']]),
                ],
            ],
            'fax02_options' => [
                'constraints' => [
                    new Type(type: 'numeric', message: 'form_error.numeric_only'),
                    new Length(['max' => $this->config['eccube_split_tel_len_max'], 'min' => $this->config['eccube_split_tel_len_min']]),
                ],
            ],
            'fax03_options' => [
                'constraints' => [
                    new Type(type: 'numeric', message: 'form_error.numeric_only'),
                    new Length(['max' => $this->config['eccube_split_tel_len_max'], 'min' => $this->config['eccube_split_tel_len_min']]),
                ],
            ],
            'fax01_name' => '',
            'fax02_name' => '',
            'fax03_name' => '',
            'error_bubbling' => false,
            'inherit_data' => true,
            'trim' => true,
        ]);
    }
}
