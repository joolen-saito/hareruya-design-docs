     *
     * @param BaseInfo $BaseInfo
     *
     * @return bool
     */
    private function validateTiles(BaseInfo $BaseInfo): bool
    {
        $sections = [];
        foreach ($BaseInfo->getTiles() as $Tile) {
            if ($this->entityManager->getUnitOfWork()->getEntityState($Tile) === \Doctrine\ORM\UnitOfWork::STATE_NEW) {
                $Tile->setBaseInfo($BaseInfo);
            }

            if (in_array($Tile->getSection(), $sections, true)) {
                $this->addError('admin.content.branch_toppage.duplicate_section', 'admin');

                return false;
            }

            if ($Tile->getTileType()->getId() !== MtbTileType::PICKUP_PRODUCT && $Tile->getTag() === null) {
                $this->addError('admin.content.branch_toppage.tag_required', 'admin');

                return false;
            }

            $sections[] = $Tile->getSection();
        }

        return true;
    }

