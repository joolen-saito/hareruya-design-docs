          </a>
        {% else %}
          <img class="p-hareruya-branch-top__item-banner-img" src="{{ bannerImage }}" alt="{{ 'shop_top.banner.item_list_alt'|trans }}" width="573" height="389" decoding="async" loading="lazy">
