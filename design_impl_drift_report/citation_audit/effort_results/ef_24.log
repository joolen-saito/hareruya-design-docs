        .ui-resizable-se {
            right: -3px;
            bottom: -3px;
        }
    </style>
{% endblock %}

{% block javascript %}
<script nonce="{{ csp_nonce }}">
    $(function() {

        $(window).on('pageshow', function() {
            const tmp_select =  $('#mail_template[name="mail[template]"] option[selected]').val();
            $('#mail_template[name="mail[template]"]').val(tmp_select);
            
            $('#mail_template[name="mail[template]"] option[value=""]').prop('disabled', true);
        });

        $('#mail_template').on('change', function() {
            const id = $(this).val();
            if (id) {
                location.href = '{{ url('admin_mall_auto_mail_edit') }}/' + id;
            } else {
                location.href = '{{ url('admin_mall_auto_mail_edit') }}';
            }
        });

        $('#form1').on('submit', function(e) {
            const mailId = '{{ Mail ? Mail.id : '' }}';
