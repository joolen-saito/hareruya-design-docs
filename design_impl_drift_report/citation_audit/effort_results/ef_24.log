{% extends '@admin/default_frame.twig' %}

{# 設定メニューからも遷移するため、遷移元に応じてナビを変更 #}
{% if app.request.query.get('return') == 'tradelaw' %}
    {% set menus = ['setting', 'basic_info', 'shop_tradelaw'] %}
    {% set page_title = 'admin.setting.shop.tradelaw_setting'|trans %}
    {% set page_sub_title = 'admin.setting.basic_info'|trans %}
{% elseif app.request.query.get('return') == 'agreement' %}
    {% set menus = ['setting', 'basic_info', 'shop_agreement'] %}
    {% set page_title = 'admin.setting.shop.agreement_setting'|trans %}
    {% set page_sub_title = 'admin.setting.basic_info'|trans %}
{% else %}
    {% set menus = ['content', 'page'] %}
    {% set page_title = 'admin.content.page_management'|trans %}
    {% set page_sub_title = 'admin.content.contents_management'|trans %}
{% endif %}

{% block title %}{{ page_title }}{% endblock %}
{% block sub_title %}{{ page_sub_title }}{% endblock %}

{% form_theme form '@admin/Form/bootstrap_4_horizontal_layout.html.twig' %}

{% block stylesheet %}
    {{ parent() }}
    <style>
        .ui-resizable-se {
            right: -3px;
            bottom: -3px;
        }
    </style>
{% endblock %}

{% block javascript %}
    <script nonce="{{ csp_nonce }}">
        ace.require('ace/ext/language_tools');
        var editor = ace.edit('editor');
        editor.session.setMode('ace/mode/twig');
        editor.setTheme('ace/theme/tomorrow');
        editor.setValue('{{ (tpl_data_value is not null ? tpl_data_value : form.tpl_data.vars.value)|escape('js') }}');
        editor.setOptions({
            enableBasicAutocompletion: true,
            enableSnippets: true,
            enableLiveAutocompletion: true,
            showInvisibles: true
        });

        {% if not is_user_data_page %}
        editor.setReadOnly(true);
        editor.container.style.opacity = '0.7';
        editor.container.style.cursor = 'not-allowed';
        {% endif %}

        $("#editor").resizable({
            resize: function (event, ui) {
                editor.resize();
            }
        });

        $('#content_page_form').on('submit', function(elem) {
            $('#main_edit_tpl_data').val(editor.getValue());
        });

        // ページ確認ボタン
        $('#btn-page-preview').on('click', function() {
            const staticUrl = $(this).data('static-url');
            if (staticUrl) {
                window.open(staticUrl, '_blank');
            } else {
                const baseUrl = $(this).data('base-url');
                const pageUrl = $('#main_edit_url').val();
                window.open(baseUrl + pageUrl, '_blank');
            }
        });

        // ロケール切り替え
        $('input[name="options-base"]').on('change', function() {
            const locale = $(this).val();
            const url = new URL(window.location.href);
            url.searchParams.set('locale', locale);
            window.location.href = url.toString();
        });
    </script>
{% endblock %}

{% block main %}
    <form id="content_page_form" method="post"
          action="{%- if page_id is not null %}{{ url('admin_content_page_edit', {id: page_id}) }}{% else %}{{ url('admin_content_page_new') }}{% endif -%}?locale={{ locale }}">
        {{ form_widget(form._token) }}

        <div class="c-contentsArea__cols">
            <div class="c-contentsArea__primaryCol">
                <div class="c-primaryCol">
                    <!-- ページ設定 -->
                    <div class="card rounded border-0 mb-4">
                        <div class="card-header">
                            <div class="row">
                                <div class="col-8"><span class="card-title">{{ 'admin.content.page__card_title'|trans }}</span></div>
                                <div class="col-4 text-end">
                                    <div class="btn-group me-5" role="group">
                                        <input type="radio" class="btn-check" name="options-base" id="locale-ja" value="ja" autocomplete="off" {{ locale == 'ja' ? 'checked' : '' }}>
                                        <label class="btn btn-outline-primary btn-sm" for="locale-ja">{{ 'admin.content.language.japanese'|trans }}</label>
                                        <input type="radio" class="btn-check" name="options-base" id="locale-en" value="en" autocomplete="off" {{ locale == 'en' ? 'checked' : '' }}>
                                        <label class="btn btn-outline-primary btn-sm" for="locale-en">{{ 'admin.content.language.english'|trans }}</label>
                                    </div>
                                    <a data-bs-toggle="collapse" href="#pageDetail" aria-expanded="false" aria-controls="pageDetail">
                                        <i class="fa fa-angle-up fa-lg"></i>
                                    </a>
                                </div>
                            </div>
                        </div>
                        <div class="collapse show ec-cardCollapse" id="pageDetail">
                            <div class="card-body">
                                <!-- ページ名 -->
                                <div class="row mb-2">
                                    <div class="col-2">
                                        <span>{{ 'admin.content.page_name'|trans }}</span>
                                        <span class="badge bg-primary ms-1">{{ 'admin.common.required'|trans }}</span>
                                    </div>
                                    <div class="col-10">
                                        {{ form_widget(form.name) }}
