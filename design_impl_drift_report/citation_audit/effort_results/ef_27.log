{% extends '@admin/default_frame.twig' %}

{% set menus = ['event', 'event_list'] %}

{% block title %}{{ 'admin.event.event_list'|trans }}{% endblock %}
{% block sub_title %}{{ 'admin.event.event_management'|trans }}{% endblock %}

{% block javascript %}
<script src="{{ asset('assets/js/select2.min.js', 'admin') }}"></script>
<script nonce="{{ csp_nonce }}">
    $(function() {
        $('#admin_search_event_base_info').select2({width: '100%'});

        $('.search-clear').on('click', function() {
            $('#admin_search_event_base_info').val(null).trigger('change');
        });

        $('#page_count_pulldown').on('change', function () {
            const targetUrl = $(this).val();
            if (targetUrl) {
                window.location.href = targetUrl;
            }
        });
        $('#sort_by_pulldown, #sort_order_pulldown').on('change', function () {
            const sortkey = $('#sort_by_pulldown').val();
            const sorttype = $('#sort_order_pulldown').val();
            if (sortkey) {
                $('#{{ searchForm.sortkey.vars.id }}').val(sortkey);
                $('#{{ searchForm.sorttype.vars.id }}').val(sorttype);
                $('#search_form').submit();
            }
        });
    });
</script>
{% endblock javascript %}

{% block main %}
<div class="c-outsideBlock search-box-inner">
    <form id='search_form' method="post" action="{{ url('admin_event_index') }}">
        {{ form_widget(searchForm._token) }}
        {{ form_widget(searchForm.sortkey) }}
        {{ form_widget(searchForm.sorttype) }}
        <div class="c-outsideBlock__contents">
            <div class="row justify-content-between align-items-start">
                <div class="col-6">
                    <div class="mb-2">
                        {{ form_widget(searchForm.multi, {'attr': {'placeholder': 'admin.event.multi_search_placeholder'|trans}}) }}
                        {{ form_errors(searchForm.multi) }}
                    </div>
                    <div class="d-inline-block mb-3" data-bs-toggle="collapse" href="#searchDetail"
                         aria-expanded="true" aria-controls="searchDetail">
                        <a><i class="fa fa-minus-square-o fw-bold me-1"></i><span class="fw-bold">{{ 'admin.common.search_detail'|trans }}</span></a>
                    </div>
                </div>
                <div class="col-auto">
                    <a class="btn btn-ec-conversion" href="{{ url('admin_event_create') }}">{{ 'admin.common.create__new'|trans }}</a>
                </div>
            </div>
        </div>
        <div class="c-subContents collapse ec-collapse show" id="searchDetail">
            <div class="row mb-2">
                <div class="col-6">
                    <label class="col-form-label">{{ 'admin.event.search.start_date'|trans }}</label>
                    <div class="row align-items-center">
                        <div class="col">
                            {{ form_widget(searchForm.start_date_from) }}
                            {{ form_errors(searchForm.start_date_from) }}
                        </div>
                        <div class="col-auto"><span>{{ 'admin.common.separator__range'|trans }}</span></div>
                        <div class="col">
                            {{ form_widget(searchForm.start_date_to) }}
                            {{ form_errors(searchForm.start_date_to) }}
                        </div>
                    </div>
                </div>
                <div class="col-6">
                    <label class="col-form-label">{{ 'admin.event.format'|trans }}</label>
                    {{ form_widget(searchForm.formats) }}
                    {{ form_errors(searchForm.formats) }}
                </div>
            </div>
            <div class="row mb-2">
                <div class="col-6">
                    <label class="col-form-label">{{ 'admin.event.base_info'|trans }}</label>
                    {{ form_widget(searchForm.base_info) }}
                    {{ form_errors(searchForm.base_info) }}
                </div>
                <div class="col-6">
                    <label class="col-form-label">{{ 'admin.event.rel'|trans }}</label>
                    {{ form_widget(searchForm.rel) }}
                    {{ form_errors(searchForm.rel) }}
                </div>
            </div>
            <div id="search_box_main__clear" class="col-xs-12 col-sm-12">
                <p class="text-center"><a href="#" class="search-clear">
                    {{ 'admin.customer.clear_search'|trans }}
                </a></p>
            </div>
        </div>
        <div class="c-outsideBlock__contents mb-5">
            <button class="btn btn-ec-conversion px-5" type="submit">{{ 'admin.common.search'|trans }}</button>
            {% if pagination.totalItemCount is defined %}
                <span class="fw-bold ms-2">{{ 'admin.common.search_result'|trans({"%count%":pagination.totalItemCount})|raw }}</span>
            {% endif %}
        </div>
    </form>
</div>

<div class="c-contentsArea__cols">
    <div class="c-contentsArea__primaryCol">
        <div class="c-primaryCol">
            {% if pagination is not empty and pagination.totalItemCount > 0 %}
                <div class="row justify-content-between mb-2">
                    <div class="col-6"></div>
                    <div class="col-5 text-end">
                        <div class="d-flex align-items-center justify-content-end gap-3 flex-wrap">
                            <div class="d-flex align-items-center gap-2">
                                <select id="page_count_pulldown" class="form-select form-select-sm" style="width: auto;">
                                    {% for PageMax in PageMaxis %}
                                        <option {% if PageMax.name == page_count %}selected="" {% endif %}value="{{ path('admin_event_index_page', {'page_no': 1, 'page_count': PageMax.name}) }}">{{ 'admin.common.count'|trans({ '%count%': PageMax.name }) }}</option>
                                    {% endfor %}
                                </select>
                            </div>
                            <div class="d-flex align-items-center gap-2">
                                <label for="sort_by_pulldown" class="col-form-label mb-0 small text-muted">{{ 'admin.common.sort'|trans }}</label>
                                <select id="sort_by_pulldown" class="form-select form-select-sm" style="width: auto;">
                                    <option value="default" {% if (searchForm.sortkey.vars.value|default('default')) == 'default' %}selected{% endif %}>{{ 'admin.event.list.id'|trans }}</option>
                                    <option value="eventName" {% if (searchForm.sortkey.vars.value|default('')) == 'eventName' %}selected{% endif %}>{{ 'admin.event.name'|trans }}</option>
                                </select>
                                <select id="sort_order_pulldown" class="form-select form-select-sm" style="width: auto;">
                                    {% set currentSortType = searchForm.sorttype.vars.value|default('d') %}
                                    <option value="a" {% if currentSortType == 'a' %}selected{% endif %}>{{ 'admin.common.sort_asc'|trans }}</option>
                                    <option value="d" {% if currentSortType != 'a' %}selected{% endif %}>{{ 'admin.common.sort_desc'|trans }}</option>
                                </select>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="card rounded border-0 mb-4 d-block">
                    <div class="card-body p-0">
                        <table class="table table-sm">
                            <thead>
                                <tr>
                                    <th class="border-top-0 pt-2 ps-3 pb-2">{{ 'admin.event.list.id'|trans }}</th>
                                    <th class="border-top-0 pt-2 pb-2">{{ 'admin.event.name'|trans }}</th>
                                    <th class="border-top-0 pt-2 pb-2">{{ 'admin.event.base_info'|trans }}</th>
                                    <th class="border-top-0 pt-2 pb-2">{{ 'admin.event.list.start_date'|trans }}</th>
                                    <th class="border-top-0 pt-2 pb-2 pe-3"></th>
                                </tr>
                            </thead>
                            <tbody>
                            {% for Event in pagination %}
                                <tr id="ex-event-{{ Event.id }}">
                                    <td class="align-middle ps-3">{{ Event.id }}</td>
                                    <td class="align-middle"><a href="{{ url('admin_event_edit', {id: Event.id}) }}">{{ Event.nameJp }}&nbsp;{{ Event.nameEn }}</a></td>
                                    <td class="align-middle">{{ Event.BaseInfo ? Event.BaseInfo.shopName : '-' }}</td>
                                    <td class="align-middle">{% if Event.details|length > 0 %}{{ (Event.details|sort((a, b) => a.startDate <=> b.startDate)|first).startDate|date('Y/m/d H:i') }}{% else %}-{% endif %}</td>
                                    <td class="align-middle pe-3">
                                        <div class="text-end">
                                            {% set canDeleteEvent = Event.details|length == 0 %}
                                            <div class="dropdown">
                                                <button class="btn btn-ec-actionIcon dropdown-menu-toggle" type="button" aria-expanded="false" aria-label="{{ 'admin.common.operation'|trans }}">
                                                    <i class="fa-solid fa-ellipsis fa-lg text-secondary" aria-hidden="true"></i>
                                                </button>
                                                <ul class="dropdown-menu dropdown-menu-end">
                                                    <li class="p-0"><a class="dropdown-item d-block py-2 px-3 text-center" href="{{ url('admin_event_edit', {id: Event.id}) }}"><i class="fa fa-pencil me-1"></i>{{ 'admin.common.edit'|trans }}</a></li>
                                                    {% if Event.BaseInfo and app.user.isEditableShop(Event.BaseInfo) %}
                                                    <li class="p-0"><button type="button" class="dropdown-item d-block w-100 py-2 px-3 text-center border-0 bg-transparent" {% if canDeleteEvent %}data-bs-toggle="modal" data-bs-target="#event_delete_{{ Event.id }}"{% else %}disabled title="{{ 'admin.event.delete.not.schedule_exists'|trans }}"{% endif %}><i class="fa fa-close me-1"></i>{{ 'admin.common.delete'|trans }}</button></li>
                                                    {% endif %}
                                                </ul>
                                            </div>
                                        </div>
                                    </td>
                                </tr>
                            {% endfor %}
                            </tbody>
                        </table>
                    </div>
                    {% if pagination.totalItemCount > 0 %}
                        <div class="row justify-content-md-center mb-4 pb-4">
                            {% include "@admin/pager.twig" with { 'pages' : pagination.paginationData, 'routes' : 'admin_event_index_page' } %}
                        </div>
                    {% endif %}
                </div>
                {% for Event in pagination %}
                {% if Event.details|length == 0 %}
                <div class="modal fade" id="event_delete_{{ Event.id }}" tabindex="-1" role="dialog" aria-labelledby="event_delete_{{ Event.id }}" aria-hidden="true">
                    <div class="modal-dialog" role="document">
                        <div class="modal-content">
                            <div class="modal-header">
                                <h5 class="modal-title fw-bold">{{ 'admin.common.delete_modal__title'|trans }}</h5>
                                <button class="btn-close" type="button" data-bs-dismiss="modal" aria-label="Close"></button>
                            </div>
                            <div class="modal-body text-start">
                                <p class="text-start">{{ 'admin.event.delete.confirm'|trans }}</p>
                            </div>
                            <div class="modal-footer">
                                <button class="btn btn-ec-sub" type="button" data-bs-dismiss="modal">{{ 'admin.common.cancel'|trans }}</button>
                                <a class="btn btn-ec-delete" href="{{ url('admin_event_delete', {id: Event.id}) }}" {{ csrf_token_for_anchor() }} data-method="delete" data-confirm="false">{{ 'admin.common.delete'|trans }}</a>
                            </div>
                        </div>
                    </div>
                </div>
                {% endif %}
                {% endfor %}
            {% elseif pagination is null %}
                {# 初期表示 #}
            {% else %}
                <div class="card rounded border-0">
                    <div class="card-body p-4">
                        <div class="text-center text-muted mb-4 h5">{{ 'admin.common.search_no_result'|trans }}</div>
                        <div class="text-center text-muted">{{ 'admin.common.search_try_change_condition'|trans }}</div>
                    </div>
                </div>
            {% endif %}
        </div>
    </div>
</div>
{% endblock %}
