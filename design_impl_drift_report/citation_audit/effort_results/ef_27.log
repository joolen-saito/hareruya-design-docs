            $name = $tag->getName();
            $tagSales = $this->orderRepository->getFormatTagSalesSummary($inputDate, (int) $tag->getId(), $baseInfoFilter);
            $resultKeys[] = $name;
            $resultInfo[$name] = $this->complementOrderDay(array_column($tagSales, 'price', 'day'), $days);
            $resultDays[] = $resultInfo[$name]['days'];
            unset($resultInfo[$name]['days']);
