namespace Eccube\Repository;

use Doctrine\DBAL\ArrayParameterType;
use Doctrine\ORM\Query\ResultSetMapping;
use Doctrine\Persistence\ManagerRegistry as RegistryInterface;
use Eccube\Entity\Customer;
use Eccube\Entity\Delivery;
use Eccube\Entity\Master\OrderItemType;
use Eccube\Entity\Master\OrderStatus;
use Eccube\Entity\OrderItem;

/**
 * OrderItemRepository
 *
 * This class was generated by the Doctrine ORM. Add your own custom
 * repository methods below.
 *
 * @extends AbstractRepository<OrderItem>
 */
class OrderItemRepository extends AbstractRepository
{
    private const ANALYSIS_DATE_COLUMNS = ['order_date', 'confirm_date', 'payment_date', 'shipping_date', 'closing_date', 'cancel_date'];

    private const ANALYSIS_SORT_COLUMNS = ['order_count' => 'order_count', 'total' => 'total', 'sales' => 'sales'];

    public function __construct(RegistryInterface $registry)
    {
        parent::__construct($registry, OrderItem::class);
    }

    /**
     * 店頭受取注文 (Delivery::OTC_GROUP) のうちスマレジ商品IDが一致する明細を返す。
     *
     * @param list<string> $smaregiProductIds
     *
     * @return list<OrderItem>
     */
    public function findOtcItemsBySmaregiProductIds(array $smaregiProductIds): array
    {
        if ($smaregiProductIds === []) {
            return [];
        }

        return $this->createQueryBuilder('oi')
            ->innerJoin('oi.ProductClass', 'pc')
            ->innerJoin('oi.Shipping', 's')
            ->innerJoin('s.Delivery', 'd')
            ->where('pc.smaregiProductId IN (:productIds)')
            ->andWhere('d.id IN (:deliveryIds)')
            ->setParameter('productIds', $smaregiProductIds)
            ->setParameter('deliveryIds', Delivery::OTC_GROUP)
            ->getQuery()
            ->getResult();
    }

    /**
     * 指定商品と同時購入された商品IDを購入数順で返す（最大10件）。
     *
     * @return list<int>
     */
    public function findRecommendProductIds(int $baseProductId, int $searchDays, int $customerId = 0): array
    {
        $rsm = new ResultSetMapping();
        $rsm->addScalarResult('product_id', 'product_id', 'integer');

        $sql = <<<SQL
            WITH base_card AS (
                SELECT cd.card_id
                FROM dtb_product p
                LEFT JOIN mtb_card_detail cd ON p.card_detail_id = cd.id
                WHERE p.id = :base_product_id
            )
            SELECT oi.product_id
            FROM dtb_order_item oi
            INNER JOIN dtb_order o ON oi.order_id = o.id
            INNER JOIN (
                SELECT DISTINCT order_id
                FROM dtb_order_item
                WHERE product_id = :base_product_id
                  AND order_item_type_id = :product_type
            ) base_orders ON oi.order_id = base_orders.order_id
            LEFT JOIN dtb_product p ON oi.product_id = p.id
            LEFT JOIN mtb_card_detail cd ON p.card_detail_id = cd.id
            WHERE oi.order_item_type_id = :product_type
              AND oi.product_id <> :base_product_id
              AND (
                (SELECT card_id FROM base_card) IS NULL
                OR cd.card_id IS NULL
                OR cd.card_id <> (SELECT card_id FROM base_card)
              )
              AND o.order_date > NOW() - make_interval(days => :search_days)
              AND o.order_status_id <> :processing_status
              AND (
                :customer_id = 0
                OR NOT EXISTS (
                    SELECT 1
                    FROM dtb_order_item oi2
                    INNER JOIN dtb_order o2 ON oi2.order_id = o2.id
                    WHERE o2.customer_id = :customer_id
                      AND oi2.order_item_type_id = :product_type
                      AND oi2.product_id = oi.product_id
                )
              )
            GROUP BY oi.product_id
            ORDER BY SUM(oi.quantity) DESC
            LIMIT 10
        SQL;

        $result = $this->getEntityManager()
            ->createNativeQuery($sql, $rsm)
            ->setParameter('base_product_id', $baseProductId)
            ->setParameter('product_type', OrderItemType::PRODUCT)
            ->setParameter('search_days', $searchDays)
            ->setParameter('processing_status', OrderStatus::PROCESSING)
            ->setParameter('customer_id', $customerId)
            ->getResult();

        return array_column($result, 'product_id');
    }

    /**
     * 会員の直近注文（処理中除く）で最も販売価格の高い商品明細を返す。
     */
    public function findLatestExpensiveItem(Customer $Customer): ?OrderItem
    {
        return $this->createQueryBuilder('oi')
            ->innerJoin('oi.Order', 'o')
            ->where('o.Customer = :customer')
            ->andWhere('o.OrderStatus <> :processing')
            ->andWhere('oi.OrderItemType = :type')
            ->andWhere('oi.Product IS NOT NULL')
            ->setParameter('customer', $Customer)
            ->setParameter('processing', OrderStatus::PROCESSING)
            ->setParameter('type', OrderItemType::PRODUCT)
            ->addOrderBy('o.order_date', 'DESC')
            ->addOrderBy('oi.price', 'DESC')
            ->setMaxResults(1)
            ->getQuery()
            ->getOneOrNullResult();
    }

    /**
     * 売上分析タグを追加する。
     *
     * @param int $orderItemId 注文詳細ID
     * @param array<int, mixed> $tagIds 売上分析タグID
     */
    public function insertTagSalesAnalyses(int $orderItemId, array $tagIds): void
    {
        if (empty($tagIds)) {
            return;
        }

        $sql = <<<EOT
INSERT INTO
    dtb_order_item_tag_sales_analysis
(
    order_item_id,
    tag_sales_analysis_id
)
VALUES
EOT;

        foreach ($tagIds as $tagId) {
            $values[] = "({$orderItemId}, {$tagId})";
        }
        $sql .= implode(',', $values);

        $this->getEntityManager()
            ->getConnection()
            ->executeUpdate($sql);
    }

    /**
     * 受注明細に紐づく売上分析タグ関連を削除する.
     *
     * ManyToMany の所有側が MtbTagSalesAnalysis のため、OrderItem の remove だけでは
     * dtb_order_item_tag_sales_analysis が残り FK 違反になる。
     */
    public function deleteTagSalesAnalyses(int $orderItemId): void
    {
        $this->getEntityManager()
            ->getConnection()
            ->executeStatement(
                'DELETE FROM dtb_order_item_tag_sales_analysis WHERE order_item_id = :orderItemId',
                ['orderItemId' => $orderItemId],
            );
    }

    /**
     * 受注売上分析の集計を行う。
     *
     * @param array<string, mixed> $searchData
     *
     * @return array{result: array<int, array<string, mixed>>, total: array{sales: int, total: int, order_count: int}}
     */
    public function getAnalysisSummary(array $searchData): array
    {
        $summaryType = ($searchData['summary_type'] ?? null) === 'class_category_name' ? 'class_category_name' : 'product_id';
        $dateType = in_array($searchData['date_type'] ?? null, self::ANALYSIS_DATE_COLUMNS, true)
            ? (string) $searchData['date_type']
            : 'order_date';

        $avgPriceExpr = 'SUM(oi.price * oi.quantity) / NULLIF(SUM(oi.quantity), 0)';

        $qb = $this->getEntityManager()->getConnection()->createQueryBuilder()
            ->from('dtb_order_item', 'oi')
            ->innerJoin('oi', 'dtb_order', 'o', 'oi.order_id = o.id')
            ->innerJoin('oi', 'dtb_product', 'p', 'oi.product_id = p.id')
            ->addSelect('SUM(oi.price * oi.quantity) AS total')
            ->addSelect('SUM(oi.quantity) AS sales')
            ->addSelect($avgPriceExpr.' AS price')
            ->addSelect('COUNT(DISTINCT o.id) AS order_count');

        if ($summaryType === 'class_category_name') {
            $qb->addSelect("'' AS code")
                ->addSelect('cat.category_name AS name')
                ->innerJoin('oi', 'dtb_product_category', 'pcat', 'pcat.product_id = oi.product_id')
                ->innerJoin('pcat', 'dtb_category', 'cat', 'cat.id = pcat.category_id')
                ->groupBy('cat.category_name');
        } else {
            $qb->addSelect('oi.product_code AS code')
                ->addSelect('MAX(oi.product_name) AS name')
                ->groupBy('oi.product_code');
        }

        $baseInfoIds = array_values(array_filter(array_map('intval', (array) ($searchData['base_info_ids'] ?? []))));
        if ($baseInfoIds === []) {
            return ['result' => [], 'total' => ['sales' => 0, 'total' => 0, 'order_count' => 0]];
        }
        $qb->andWhere('o.base_info_id IN (:baseInfoIds)')
            ->setParameter('baseInfoIds', $baseInfoIds, ArrayParameterType::INTEGER);

        $qb->andWhere('o.order_date IS NOT NULL');

        if ($dateType === 'cancel_date') {
            $qb->andWhere('o.cancel_date IS NOT NULL')
                ->andWhere('o.order_status_id = :cancelStatus')
                ->setParameter('cancelStatus', OrderStatus::CANCEL);
        } else {
            $qb->andWhere('o.order_status_id != :cancelStatus')
                ->setParameter('cancelStatus', OrderStatus::CANCEL);
        }

        if (!empty($searchData['summary_date_from'])) {
            $qb->andWhere("o.{$dateType} >= :summaryDateFrom")
                ->setParameter('summaryDateFrom', $searchData['summary_date_from']->format('Y-m-d H:i:s'));
        }
        if (!empty($searchData['summary_date_to'])) {
            $qb->andWhere("o.{$dateType} <= :summaryDateTo")
                ->setParameter('summaryDateTo', $searchData['summary_date_to']->format('Y-m-d H:i:s'));
        }

        $multi = isset($searchData['multi']) ? trim((string) $searchData['multi']) : '';
        if ($multi !== '') {
            $qb->leftJoin('p', 'mtb_card_detail', 'cd', 'p.card_detail_id = cd.id')
                ->leftJoin('cd', 'mtb_card', 'c', 'cd.card_id = c.id');
            $terms = preg_split('/[\s,\x{3000}]+/u', $multi, -1, PREG_SPLIT_NO_EMPTY) ?: [];
            foreach ($terms as $index => $term) {
                $param = 'multi'.$index;
                $qb->andWhere("(oi.product_name LIKE :{$param} OR oi.product_code LIKE :{$param} OR p.name_en LIKE :{$param} OR c.name_jp LIKE :{$param} OR c.name_en LIKE :{$param} OR o.message LIKE :{$param} OR o.note LIKE :{$param})")
                    ->setParameter($param, '%'.addcslashes($term, '%_\\').'%');
            }
        }

        if (!empty($searchData['category_id'])) {
            $categoryIds = array_map(static fn ($Category) => $Category->getId(), $searchData['category_id']->getSelfAndDescendants());
            $qb->andWhere('EXISTS (SELECT 1 FROM dtb_product_category pcf WHERE pcf.product_id = oi.product_id AND pcf.category_id IN (:categoryIds))')
                ->setParameter('categoryIds', $categoryIds, ArrayParameterType::INTEGER);
        }

        if (!empty($searchData['card_condition'])) {
            $cardConditionIds = array_values(array_map('intval', (array) $searchData['card_condition']));
            $qb->andWhere('EXISTS (SELECT 1 FROM dtb_product_class pcc WHERE pcc.id = oi.product_class_id AND pcc.card_condition_id IN (:cardConditionIds))')
                ->setParameter('cardConditionIds', $cardConditionIds, ArrayParameterType::INTEGER);
        }

        if (!empty($searchData['tag_sales_analysis']) && count($searchData['tag_sales_analysis']) > 0) {
            $tagIds = array_map(static fn ($Tag) => $Tag->getId(), $searchData['tag_sales_analysis']->toArray());
            $qb->andWhere('EXISTS (SELECT 1 FROM dtb_order_item_tag_sales_analysis oita WHERE oita.order_item_id = oi.id AND oita.tag_sales_analysis_id IN (:tagIds))')
                ->setParameter('tagIds', $tagIds, ArrayParameterType::INTEGER);
        }

        if (!empty($searchData['cardset']) && count($searchData['cardset']) > 0) {
            $cardsetIds = array_map(static fn ($Cardset) => $Cardset->getId(), $searchData['cardset']->toArray());
            $qb->andWhere('EXISTS (SELECT 1 FROM mtb_card_detail cdf WHERE cdf.id = p.card_detail_id AND cdf.cardset_id IN (:cardsetIds))')
                ->setParameter('cardsetIds', $cardsetIds, ArrayParameterType::INTEGER);
        }

        if (!empty($searchData['price_from'])) {
            $qb->andHaving($avgPriceExpr.' >= :priceFrom')->setParameter('priceFrom', (int) $searchData['price_from']);
        }
        if (!empty($searchData['price_to'])) {
            $qb->andHaving($avgPriceExpr.' <= :priceTo')->setParameter('priceTo', (int) $searchData['price_to']);
        }
        if (!empty($searchData['quantity_from'])) {
            $qb->andHaving('SUM(oi.quantity) >= :quantityFrom')->setParameter('quantityFrom', (int) $searchData['quantity_from']);
        }
        if (!empty($searchData['quantity_to'])) {
            $qb->andHaving('SUM(oi.quantity) <= :quantityTo')->setParameter('quantityTo', (int) $searchData['quantity_to']);
        }

        $ascDesc = strtoupper((string) ($searchData['asc_desc'] ?? 'ASC')) === 'DESC' ? 'DESC' : 'ASC';
        $sortKey = $searchData['sort_key'] ?? null;
        if ($sortKey === 'summary_type') {
            $qb->orderBy($summaryType === 'class_category_name' ? 'cat.category_name' : 'oi.product_code', $ascDesc);
        } elseif (isset(self::ANALYSIS_SORT_COLUMNS[$sortKey])) {
            $qb->orderBy(self::ANALYSIS_SORT_COLUMNS[$sortKey], $ascDesc);
        }

        $limit = (int) ($searchData['page_count'] ?? 0);
        if ($limit > 0) {
            $qb->setMaxResults($limit);
        }

        $total = ['sales' => 0, 'total' => 0, 'order_count' => 0];
        $result = [];
        foreach ($qb->executeQuery()->fetchAllAssociative() as $row) {
            $row['total'] = (int) $row['total'];
            $row['sales'] = (int) $row['sales'];
            $row['price'] = (int) $row['price'];
            $row['order_count'] = (int) $row['order_count'];
            $total['sales'] += $row['sales'];
            $total['total'] += $row['total'];
            $total['order_count'] += $row['order_count'];
            $result[] = $row;
        }

        return ['result' => $result, 'total' => $total];
    }
}
