use Eccube\Event\EccubeEvents;
use Eccube\Event\EventArgs;
use Eccube\Form\Type\Admin\EventType;
use Eccube\Form\Type\Admin\SearchEventType;
use Eccube\Repository\DtbEventEntryRepository;
use Eccube\Repository\DtbEventRepository;
use Eccube\Repository\Master\PageMaxRepository;
use Eccube\Service\Admin\Event\ActionInput\EventCreateInput;
use Eccube\Service\Admin\Event\ActionInput\EventEditInput;
use Eccube\Service\Admin\Event\EventCreateAction;
use Eccube\Service\Admin\Event\EventEditAction;
use Eccube\Util\FormUtil;
use Knp\Component\Pager\PaginatorInterface;
use Symfony\Bridge\Doctrine\Attribute\MapEntity;
use Symfony\Bridge\Twig\Attribute\Template;
use Symfony\Component\HttpFoundation\RedirectResponse;
use Symfony\Component\HttpFoundation\Request;
use Symfony\Component\Routing\Attribute\Route;

class EventController extends AbstractController
{
    private const SESSION_SEARCH_KEY = 'eccube.admin.event.search';

    private const SESSION_PAGE_NO_KEY = 'eccube.admin.event.search.page_no';

    private const SESSION_PAGE_COUNT_KEY = 'eccube.admin.event.search.page_count';

    public function __construct(
        protected EccubeConfig $eccubeConfig,
        private readonly DtbEventRepository $eventRepository,
        private readonly DtbEventEntryRepository $eventEntryRepository,
        private readonly PageMaxRepository $pageMaxRepository,
        private readonly EventCreateAction $eventCreateAction,
        private readonly EventEditAction $eventEditAction,
    ) {
    }

    /**
     * @return array<string, mixed>
     */
    #[Route(path: '/%eccube_admin_route%/event', name: 'admin_event_index', methods: ['GET', 'POST'])]
    #[Route(path: '/%eccube_admin_route%/event/page/{page_no}', name: 'admin_event_index_page', methods: ['GET', 'POST'])]
    #[Template(template: '@admin/Event/index.twig')]
    public function index(Request $request, PaginatorInterface $paginator, ?int $page_no = null): array
    {
        $hasExplicitPageParam = $page_no !== null;
        $pageNo = $page_no ?? 1;
        $Member = $this->getMember();
        $DefaultBaseInfo = $Member->getDefaultSearchBaseInfo();
        $builder = $this->formFactory
            ->createBuilder(SearchEventType::class, null, [
                'base_info_default' => $DefaultBaseInfo ? [$DefaultBaseInfo] : [],
            ]);

        $event = new EventArgs(
            [
                'builder' => $builder,
            ],
            $request
        );
        $this->eventDispatcher->dispatch($event, EccubeEvents::ADMIN_EVENT_INDEX_INITIALIZE);

        $searchForm = $builder->getForm();

        $pageCount = $this->session->get(
            self::SESSION_PAGE_COUNT_KEY,
            $this->eccubeConfig->get('eccube_default_page_count')
        );
        $pageCountParam = (int) $request->get('page_count');
        $PageMaxis = $this->pageMaxRepository->findAll();

        if ($pageCountParam) {
            foreach ($PageMaxis as $PageMax) {
                if ((string) $pageCountParam === $PageMax->getName()) {
                    $pageCount = $PageMax->getName();
                    $this->session->set(self::SESSION_PAGE_COUNT_KEY, $pageCount);
                    break;
                }
            }
        }

        $pagination = null;

        if ($request->getMethod() === 'POST') {
            $searchForm->handleRequest($request);

            if ($searchForm->isValid()) {
                $pageNo = 1;
                $searchData = $searchForm->getData();

                $this->session->set(self::SESSION_SEARCH_KEY, FormUtil::getViewData($searchForm));
                $this->session->set(self::SESSION_PAGE_NO_KEY, $pageNo);

                $eventsQueryBuilder = $this->eventRepository->getQueryBuilderBySearchData(
                    $searchData
                );

                $event = new EventArgs(
                    [
                        'qb' => $eventsQueryBuilder,
                        'searchData' => $searchData,
                    ],
                    $request
                );

                $this->eventDispatcher->dispatch($event, EccubeEvents::ADMIN_EVENT_INDEX_SEARCH);

                $pagination = $paginator->paginate(
                    $eventsQueryBuilder,
                    $pageNo,
                    (int) $pageCount
                );
                $pageNo = $this->resolvePageNoAfterSearch($pageNo, $pagination->getTotalItemCount(), (int) $pageCount);
                if ($pageNo !== $pagination->getCurrentPageNumber()) {
                    $this->session->set(self::SESSION_PAGE_NO_KEY, $pageNo);
                    $pagination = $paginator->paginate(
                        $eventsQueryBuilder,
                        $pageNo,
                        (int) $pageCount
                    );
                }
            } else {
                return [
                    'searchForm' => $searchForm->createView(),
                    'pagination' => [],
                    'PageMaxis' => $PageMaxis,
                    'page_no' => $pageNo,
                    'page_count' => $pageCount,
                    'has_errors' => true,
                ];
            }
        } else {
            if ($hasExplicitPageParam || $request->get('resume') !== null) {
                if ($hasExplicitPageParam) {
                    $this->session->set(self::SESSION_PAGE_NO_KEY, $pageNo);
                } else {
                    $pageNo = (int) $this->session->get(self::SESSION_PAGE_NO_KEY, 1);
                }
                $viewData = $this->session->get(self::SESSION_SEARCH_KEY, []);
                $searchData = FormUtil::submitAndGetData($searchForm, $viewData);

                $eventsQueryBuilder = $this->eventRepository->getQueryBuilderBySearchData(
                    $searchData
                );

                $event = new EventArgs(
                    [
                        'qb' => $eventsQueryBuilder,
                        'searchData' => $searchData,
                    ],
                    $request
                );

                $this->eventDispatcher->dispatch($event, EccubeEvents::ADMIN_EVENT_INDEX_SEARCH);

                $pagination = $paginator->paginate(
                    $eventsQueryBuilder,
                    $pageNo,
                    (int) $pageCount
                );
                $pageNo = $this->resolvePageNoAfterSearch($pageNo, $pagination->getTotalItemCount(), (int) $pageCount);
                if ($pageNo !== $pagination->getCurrentPageNumber()) {
                    $this->session->set(self::SESSION_PAGE_NO_KEY, $pageNo);
                    $pagination = $paginator->paginate(
                        $eventsQueryBuilder,
                        $pageNo,
                        (int) $pageCount
                    );
                }
            } else {
                $pageNo = 1;
                $viewData = FormUtil::getViewData($searchForm);

                $this->session->set(self::SESSION_SEARCH_KEY, $viewData);
                $this->session->set(self::SESSION_PAGE_NO_KEY, $pageNo);
            }
        }

        return [
            'searchForm' => $searchForm->createView(),
            'PageMaxis' => $PageMaxis,
            'pagination' => $pagination,
            'page_count' => $pageCount,
        ];
    }

    /**
     * @return RedirectResponse|array<string, mixed>
     */
    #[Route(path: '/%eccube_admin_route%/event/create', name: 'admin_event_create', methods: ['GET', 'POST'])]
    #[Template(template: '@admin/Event/edit.twig')]
    public function create(Request $request): RedirectResponse|array
    {
        $Member = $this->getMember();
        $Event = new DtbEvent();
        $DefaultBaseInfo = $Member->getDefaultSearchBaseInfo();
        if ($DefaultBaseInfo !== null) {
            $Event->setBaseInfo($DefaultBaseInfo);
        }
        $builder = $this->formFactory->createBuilder(EventType::class, $Event, ['Member' => $Member]);

        $event = new EventArgs(
            [
                'builder' => $builder,
                'Event' => $Event,
            ],
            $request
        );
        $this->eventDispatcher->dispatch($event, EccubeEvents::ADMIN_EVENT_CREATE_INITIALIZE);

        $form = $builder->getForm();
        $form->handleRequest($request);

        if ($form->isSubmitted() && $form->isValid()) {
            /** @var DtbEvent $Event */
            $Event = $form->getData();
            $input = new EventCreateInput($Event, $Member, $form->get('payments')->getData() ?? []);
            try {
                $this->eventCreateAction->handle($input);

                $event = new EventArgs(
                    [
                        'form' => $form,
                        'Event' => $Event,
                    ],
                    $request
                );
                $this->eventDispatcher->dispatch($event, EccubeEvents::ADMIN_EVENT_CREATE_COMPLETE);

                $this->addSuccess('admin.common.save_complete', 'admin');

                return $this->redirectToRoute('admin_event_edit', ['id' => $form->getData()->getId()]);
            } catch (\Exception $e) {
                $this->addError('admin.common.save_error', 'admin');
            }
        }

        return [
            'form' => $form->createView(),
            'Event' => $Event,
            'isNew' => true,
            'isEditableBaseInfo' => true,
            'entry' => [],
        ];
    }

    /**
     * @return array<string, mixed>
