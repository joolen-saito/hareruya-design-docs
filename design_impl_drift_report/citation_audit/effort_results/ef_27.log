namespace Eccube\Repository;

use Doctrine\Common\Collections\ArrayCollection;
use Doctrine\ORM\QueryBuilder;
use Doctrine\Persistence\ManagerRegistry;
use Eccube\Entity\BaseInfo;
use Eccube\Entity\DtbEvent;
use Eccube\Entity\DtbEventDetail;
use Eccube\Entity\Master\MtbDisp;
use Eccube\Util\StringUtil;

/**
 * @extends AbstractRepository<DtbEvent>
 */
class DtbEventRepository extends AbstractRepository
{
    public function __construct(ManagerRegistry $registry)
    {
        parent::__construct($registry, DtbEvent::class);
    }

    /**
     * @var array<string, string>
     */
    private array $sortKeys = [
        'default' => 'e.id',
        'eventName' => 'e.nameJp',
    ];

    /**
     * @return array<string, string>
     */
    public function getSortKeys(): array
    {
        return $this->sortKeys;
    }

    /**
     * イベント管理　イベント一覧
     * 検索条件に該当するデータを取得
     *
     * @param array<string, mixed> $searchData
     */
    public function getQueryBuilderBySearchData(array $searchData): QueryBuilder
    {
        // dtb_event
        $qb = $this->createQueryBuilder('e')
            ->leftJoin('e.Details', 'ed')
            ->leftJoin('e.Formats', 'ef');

        // イベント名
        $multi = $searchData['multi'] ?? null;
        if (StringUtil::isNotBlank($multi)) {
            // スペース除去
            $multi = trim(mb_convert_kana($multi, 's', 'UTF-8'));
            // 半角スペース、全角スペース、カンマで分割
            $texts = preg_split('/[\s,　]+/u', $multi);
            $queries = [];
            $searchColumns = ['nameJp', 'nameEn'];

            // 分割した文字列ごとに条件設定
            foreach ($texts as $num => $text) {
                if (empty($text)) {
                    continue;
                }
                $cond = "%{$text}%";
                // 名称、略称の英語、日本語
                foreach ($searchColumns as $column) {
                    $queries[] = "e.{$column} LIKE :{$column}{$num}";
                    $qb->setParameter("{$column}{$num}", $cond);
                }
            }
            if (!empty($queries)) {
                $qb->andWhere('('.implode(' OR ', $queries).')');
            }
        }

        // 開催日From
        $dateFrom = $searchData['start_date_from'] ?? null;
        if (!empty($dateFrom)) {
            $qb->andWhere('ed.startDate >= :start_date_from')
                ->setParameter('start_date_from', $dateFrom);
        }

        // 開催日To
        $dateTo = $searchData['start_date_to'] ?? null;
        if (!empty($dateTo)) {
            $dateTo = (clone $dateTo)->modify('+1 days');
            $qb->andWhere('ed.startDate < :start_date_to')
                ->setParameter('start_date_to', $dateTo);
        }

        // フォーマット
        $format = $searchData['formats'] ?? null;
        if (!empty($format)) {
            $qb->andWhere('ef = :format')
                ->setParameter('format', $format);
        }

        // ルール適用度
        $rel = $searchData['rel'] ?? null;
        if (!empty($rel)) {
            $qb->andWhere('e.Rel = :rel')
                ->setParameter('rel', $rel);
        }

        // 店舗（複数選択可）
        $baseInfos = $searchData['base_info'] ?? [];
        if ($baseInfos !== []) {
            $baseInfoIds = array_map(fn (BaseInfo $baseInfo) => $baseInfo->getId(), $baseInfos);
            $baseInfoIds = array_unique($baseInfoIds);
            if ($baseInfoIds !== []) {
                $qb->andWhere('IDENTITY(e.BaseInfo) IN (:baseInfoIds)')
                    ->setParameter('baseInfoIds', array_values($baseInfoIds));
            }
        }

        // Order By
        $sortKey = $searchData['sortkey'] ?? 'default';
        $sortType = (isset($searchData['sorttype']) && $searchData['sorttype'] === 'a') ? 'ASC' : 'DESC';
        if (isset($this->sortKeys[$sortKey])) {
            $qb->addOrderBy($this->sortKeys[$sortKey], $sortType);
        } else {
            $qb->addOrderBy('e.id', 'DESC');
        }

        return $qb;
    }

    /**
     * 申込登録　検索
     * オンライン受付ありの日程を持つイベントを検索
     *
     * @param array<string, mixed> $searchData
     */
    public function getQueryBuilderByEntryRegistrationSearchData(array $searchData): QueryBuilder
    {
        $qb = $this->createQueryBuilder('e')
            ->distinct()
            ->join('e.Details', 'ed', 'WITH', 'ed.entryFlg = true');

        $multi = $searchData['multi'] ?? null;
        if (StringUtil::isNotBlank($multi)) {
            $multi = trim(mb_convert_kana($multi, 's', 'UTF-8'));
            $texts = preg_split('/[\s,　]+/u', $multi);
            $queries = [];
            $searchColumns = ['nameJp', 'nameEn'];
            foreach ($texts as $num => $text) {
                if (empty($text)) {
                    continue;
                }
                $cond = "%{$text}%";
                foreach ($searchColumns as $column) {
                    $queries[] = "e.{$column} LIKE :{$column}{$num}";
                    $qb->setParameter("{$column}{$num}", $cond);
                }
            }
            if (!empty($queries)) {
                $qb->andWhere('('.implode(' OR ', $queries).')');
            }
        }

        $dateFrom = $searchData['start_date_from'] ?? null;
        $dateTo = $searchData['start_date_to'] ?? null;
        if (!empty($dateFrom)) {
            $qb->andWhere('ed.startDate >= :reg_entry_start_from')
                ->setParameter('reg_entry_start_from', $dateFrom);
        }
        if (!empty($dateTo)) {
            $qb->andWhere('ed.startDate < :reg_entry_start_to')
                ->setParameter('reg_entry_start_to', (clone $dateTo)->modify('+1 days'));
        }

        $baseInfos = $searchData['base_info'] ?? [];
        if ($baseInfos !== []) {
            $baseInfoIds = array_map(fn (BaseInfo $baseInfo) => $baseInfo->getId(), $baseInfos);
            $baseInfoIds = array_unique($baseInfoIds);
            if ($baseInfoIds !== []) {
                $qb->andWhere('IDENTITY(e.BaseInfo) IN (:baseInfoIds)')
                    ->setParameter('baseInfoIds', array_values($baseInfoIds));
            }
        }

        $qb->addOrderBy('e.id', 'DESC');

        return $qb;
    }

    /**
     * イベント管理　イベント一覧の件数を返す
     *
     * TODO: getQueryBuilderBySearchDataのコメントアウトを外すタイミングでここのコメントアウトも外す
     *
     * @param array<string, mixed> $searchData
     */
    public function getCountBySearchData(array $searchData): int
    {
        $qb = $this->getQueryBuilderBySearchData($searchData);

        return $qb->select($qb->expr()->count('e'))
            ->getQuery()
            ->getSingleScalarResult();
    }

    /**
     * 適切なイベントバナーを取得
     *
     * @return DtbEvent[]
     */
    public function getEventBanners(int $baseInfoId, string $locale, int $limit): array
    {
        $qb = $this->createQueryBuilder('e');
        $from = (new \DateTime())->setTime(0, 0, 0);
        $qb->join('e.Details', 'ed')
            ->where($qb->expr()->eq('IDENTITY(e.BaseInfo)', ':baseInfoId'))
            ->andWhere($qb->expr()->eq('IDENTITY(e.Disp)', MtbDisp::DISPLAY_SHOW))
            ->andWhere($qb->expr()->eq('IDENTITY(ed.Disp)', MtbDisp::DISPLAY_SHOW))
            ->andWhere($qb->expr()->gte('ed.startDate', ':from'));
        $locale === 'ja' ? $qb->andWhere("e.bannerUrl != ''") : $qb->andWhere("e.bannerEnUrl != ''");

        $qb->setParameters(new ArrayCollection([
            'from' => $from,
            'baseInfoId' => $baseInfoId,
        ]))
            ->orderBy('ed.startDate', 'ASC')
            ->setMaxResults($limit);

        return $qb->getQuery()->execute();
    }

