namespace Eccube\Service\Csv\Exporter;

use Eccube\Repository\OrderItemRepository;
use Eccube\Service\CsvExportService;
use Symfony\Component\HttpFoundation\StreamedResponse;
use Symfony\Contracts\Translation\TranslatorInterface;

class SalesAnalysisCsvExporterService
{
    public function __construct(
        protected CsvExportService $csvExportService,
        protected OrderItemRepository $orderItemRepository,
        protected TranslatorInterface $translator,
    ) {
    }

    /**
     * @param array<string, mixed> $searchData
     */
    public function exportBySearchData(array $searchData): StreamedResponse
    {
        $isProduct = ($searchData['summary_type'] ?? null) !== 'class_category_name';
        $rows = $this->orderItemRepository->getAnalysisSummary($searchData)['result'];
        $header = $isProduct ? $this->buildProductHeader() : $this->buildCategoryHeader();

        $response = new StreamedResponse(function () use ($rows, $isProduct, $header): void {
            $this->csvExportService->fopen();
            $this->csvExportService->fputcsv($header);

            foreach ($rows as $row) {
                $line = $isProduct ? [(string) ($row['code'] ?? '')] : [];
                $line[] = (string) ($row['name'] ?? '');
                $line[] = (string) ((int) ($row['price'] ?? 0));
                $line[] = (string) ((int) ($row['sales'] ?? 0));
                $line[] = (string) ((int) ($row['total'] ?? 0));
                $line[] = (string) ((int) ($row['order_count'] ?? 0));
                $this->csvExportService->fputcsv($line);
            }

            $this->csvExportService->fclose();
        });

        $filename = 'sales_report_'.(new \DateTime())->format('YmdHis').'.csv';
        $response->headers->set('Content-Type', 'application/octet-stream');
        $response->headers->set('Content-Disposition', 'attachment; filename='.$filename);

        return $response;
    }

    /**
     * @return array<int, string>
     */
    private function buildProductHeader(): array
    {
        return [
            $this->translator->trans('admin.analysis.sales.result.product_code'),
            $this->translator->trans('admin.analysis.sales.result.product_name'),
            $this->translator->trans('admin.analysis.sales.result.avg_price'),
            $this->translator->trans('admin.analysis.sales.result.quantity'),
            $this->translator->trans('admin.analysis.sales.result.total'),
            $this->translator->trans('admin.analysis.sales.result.count'),
        ];
    }

    /**
     * @return array<int, string>
     */
    private function buildCategoryHeader(): array
    {
        return [
            $this->translator->trans('admin.analysis.sales.result.category'),
            $this->translator->trans('admin.analysis.sales.result.avg_price'),
            $this->translator->trans('admin.analysis.sales.result.quantity'),
            $this->translator->trans('admin.analysis.sales.result.total'),
            $this->translator->trans('admin.analysis.sales.result.count'),
        ];
    }
}

