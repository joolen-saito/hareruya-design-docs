namespace Eccube\Controller\Admin\Analysis;

use Eccube\Controller\AbstractController;
use Eccube\Event\EccubeEvents;
use Eccube\Event\EventArgs;
use Eccube\Form\Type\Admin\Analysis\SearchProductRequestType;
use Eccube\Repository\DtbProductRequestRepository;
use Eccube\Service\Csv\Exporter\ProductRequestCsvExportService;
use Eccube\Util\FormUtil;
use Symfony\Bridge\Twig\Attribute\Template;
use Symfony\Component\HttpFoundation\RedirectResponse;
use Symfony\Component\HttpFoundation\Request;
use Symfony\Component\HttpFoundation\StreamedResponse;
use Symfony\Component\Routing\Attribute\Route;

class ProductRequestController extends AbstractController
{
    private const SESSION_KEY = 'eccube.admin.analysis.product_request.search';

    /**
     * @param DtbProductRequestRepository $productRequestRepository
     * @param ProductRequestCsvExportService $productRequestCsvExportService
     */
    public function __construct(
        private readonly DtbProductRequestRepository $productRequestRepository,
        private readonly ProductRequestCsvExportService $productRequestCsvExportService,
    ) {
    }

    /**
     * @return array<string, mixed>
     */
    #[Route(path: '/%eccube_admin_route%/analysis/product-request', name: 'admin_analysis_product_request', methods: ['GET'])]
    #[Template(template: '@admin/Analysis/product_request.twig')]
    public function index(Request $request): array
    {
        $searchForm = $this->createForm(SearchProductRequestType::class);

        $event = new EventArgs(
            [
                'form' => $searchForm,
            ],
            $request
        );
        $this->eventDispatcher->dispatch($event, EccubeEvents::ADMIN_ANALYSIS_PRODUCT_REQUEST_INDEX_INITIALIZE);

        return [
            'searchForm' => $searchForm->createView(),
            'searched' => false,
            'summary' => null,
        ];
    }

    /**
     * @return array<string, mixed>
     */
    #[Route(path: '/%eccube_admin_route%/analysis/product-request/search', name: 'admin_analysis_product_request_search', methods: ['POST'])]
    #[Template(template: '@admin/Analysis/product_request.twig')]
    public function search(Request $request): array
    {
        $searchForm = $this->createForm(SearchProductRequestType::class);
        $searchForm->handleRequest($request);

        if (!$searchForm->isSubmitted() || !$searchForm->isValid()) {
            return [
                'searchForm' => $searchForm->createView(),
                'searched' => false,
                'summary' => null,
            ];
        }

        $searchData = $searchForm->getData();
        $this->session->set(self::SESSION_KEY, FormUtil::getViewData($searchForm));

        $summary = $this->productRequestRepository->getAnalysisSummary($searchData);

        $event = new EventArgs(
            [
                'form' => $searchForm,
                'searchData' => $searchData,
            ],
            $request
        );
        $this->eventDispatcher->dispatch($event, EccubeEvents::ADMIN_ANALYSIS_PRODUCT_REQUEST_SEARCH);

        return [
            'searchForm' => $searchForm->createView(),
            'searched' => true,
            'summary' => $summary ?: null,
        ];
    }

    /**
     * @return StreamedResponse|RedirectResponse
     */
    #[Route(path: '/%eccube_admin_route%/analysis/product-request/export', name: 'admin_analysis_product_request_export', methods: ['GET'])]
    public function export(Request $request): StreamedResponse|RedirectResponse
    {
        $viewData = $this->session->get(self::SESSION_KEY);

        if ($viewData === null) {
            $this->addError('検索条件がありません。先に検索を実行してください。', 'admin');

            return $this->redirectToRoute('admin_analysis_product_request');
        }

        $searchForm = $this->createForm(SearchProductRequestType::class);
        $searchData = FormUtil::submitAndGetData($searchForm, $viewData);

        $event = new EventArgs(
            [
                'form' => $searchForm,
                'searchData' => $searchData,
            ],
            $request
        );
        $this->eventDispatcher->dispatch($event, EccubeEvents::ADMIN_ANALYSIS_PRODUCT_REQUEST_CSV_EXPORT);

        return $this->productRequestCsvExportService->exportBySearchData($searchData);
    }
}
