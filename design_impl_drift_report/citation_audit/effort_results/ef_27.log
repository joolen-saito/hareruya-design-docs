namespace Eccube\Service\Csv\Exporter;

use Eccube\Repository\DtbDeckRepository;
use Eccube\Service\CsvExportService;
use Symfony\Component\HttpFoundation\StreamedResponse;

class UsedCardCsvExportService
{
    private const CSV_HEADER = [
        'product_id' => '商品ID',
        'product_code' => '商品コード',
        'product_name' => '商品名(日)',
        'stock' => '在庫数',
        'price' => '販売価格',
        'buy_price' => '買取価格',
        'language_id' => '言語(ID)',
        'card_name_en' => 'カード名(英)',
        'cardset_code' => 'カードセット略称',
        'rarity_code' => 'レアリティ',
        'foil_flg' => 'Foilフラグ',
        'card_condition_code' => '状態コード',
        'order_quantity_today' => '当日販売数',
        'order_quantity_1week' => '1週間販売数',
        'order_quantity_1month' => '1ヵ月間販売数',
        'totalcount' => '採用枚数',
        'tags' => 'タグ',
    ];

    /** @param CsvExportService $csvExportService @param DtbDeckRepository $deckRepository */
    public function __construct(
        protected CsvExportService $csvExportService,
        protected DtbDeckRepository $deckRepository,
    ) {
    }

    /**
     * 検索条件に合致するカード採用データを CSV でストリーミング出力する。
     * ファイル名は `used_card_product_YmdHis.csv` 形式。
     *
     * @param array<string, mixed> $searchData
     */
    public function exportBySearchData(array $searchData): StreamedResponse
    {
        $response = new StreamedResponse();
        $response->setCallback(function () use ($searchData): void {
            $rows = $this->deckRepository->getUsedCardsCsvExportData($searchData);
            $this->csvExportService->fopen();
            $this->csvExportService->fputcsv(array_values(self::CSV_HEADER));

            foreach ($rows as $row) {
                $orderedRow = array_map(
                    fn (string $key): string => (string) ($row[$key] ?? ''),
                    array_keys(self::CSV_HEADER),
                );
                $this->csvExportService->fputcsv($orderedRow);
            }

            $this->csvExportService->fclose();
        });

        $now = new \DateTime();
        $filename = 'used_card_product_'.$now->format('YmdHis').'.csv';
        $response->headers->set('Content-Type', 'application/octet-stream');
        $response->headers->set('Content-Disposition', 'attachment; filename='.$filename);

        return $response;
    }
}
