class FormatSalesController extends AbstractController
{
    private const SESSION_KEY = 'eccube.admin.analysis.format_sales.search';

    public function __construct(
        private readonly OrderRepository $orderRepository,
        private readonly MtbTagSalesAnalysisRepository $tagSalesAnalysisRepository,
    ) {
    }

    /**
     * フォーマット売上分析の初期表示.
     *
     * @return array<string, mixed>
     */
    #[Route(path: '/%eccube_admin_route%/analysis/format-sales', name: 'admin_analysis_format_sales', methods: ['GET'])]
    #[Template(template: '@admin/Analysis/format_sales.twig')]
    public function index(Request $request): array
    {
        $form = $this->createForm(FormatSalesType::class);
        $form->get('month')->setData((new \DateTime())->format('Y-m'));
        $form->get('mail_order_enabled')->setData(true);
        $form->get('store_enabled')->setData(true);

        $event = new EventArgs(
            [
                'form' => $form,
            ],
            $request
        );
        $this->eventDispatcher->dispatch($event, EccubeEvents::ADMIN_ANALYSIS_FORMAT_SALES_INDEX_INITIALIZE);

        return [
            'searchForm' => $form->createView(),
            'formats' => null,
        ];
    }

    /**
     * フォーマット売上分析を検索する.
     *
     * @return array<string, mixed>
     */
    #[Route(path: '/%eccube_admin_route%/analysis/format-sales/search', name: 'admin_analysis_format_sales_search', methods: ['POST'])]
    #[Template(template: '@admin/Analysis/format_sales.twig')]
    public function search(Request $request): array
    {
        $builder = $this->formFactory->createBuilder(FormatSalesType::class);

        $event = new EventArgs(
            [
                'builder' => $builder,
            ],
            $request
        );
        $this->eventDispatcher->dispatch($event, EccubeEvents::ADMIN_ANALYSIS_FORMAT_SALES_SEARCH_INITIALIZE);

        $form = $builder->getForm();
        $form->handleRequest($request);

        if (!$form->isSubmitted() || !$form->isValid()) {
            return [
                'searchForm' => $form->createView(),
                'formats' => null,
            ];
        }

        $inputDate = new \DateTime((string) $form->get('month')->getData().'-01');
        $baseInfoFilter = $this->resolveBaseInfoFilter(
            (bool) $form->get('mail_order_enabled')->getData(),
            (bool) $form->get('store_enabled')->getData(),
        );
        $this->session->set(self::SESSION_KEY, FormUtil::getViewData($form));
        $result = $this->buildFormatSalesSummary($inputDate, $baseInfoFilter);

        $event = new EventArgs(
            [
                'form' => $form,
                'searchData' => $form->getData(),
            ],
            $request
        );
        $this->eventDispatcher->dispatch($event, EccubeEvents::ADMIN_ANALYSIS_FORMAT_SALES_SEARCH);

        return [
            'searchForm' => $form->createView(),
            'formats' => $result['formats'],
            'formatSales' => $result['formatSales'],
            'daySum' => $result['daySum'],
            'resultCalc' => $result['resultCalc'],
        ];
    }

    /**
     * フォーマット売上分析結果をCSVエクスポートする.
     */
    #[Route(path: '/%eccube_admin_route%/analysis/format-sales/export', name: 'admin_analysis_format_sales_export', methods: ['GET'])]
    public function export(Request $request): StreamedResponse|RedirectResponse
    {
        $viewData = $this->session->get(self::SESSION_KEY);

        if (!is_array($viewData)) {
            $this->addError('検索条件がありません。先に検索を実行してください。', 'admin');

            return $this->redirectToRoute('admin_analysis_format_sales');
        }

        $form = $this->createForm(FormatSalesType::class);
        $form->submit($viewData);
        $inputDate = new \DateTime((string) $form->get('month')->getData().'-01');
        $baseInfoFilter = $this->resolveBaseInfoFilter(
            (bool) $form->get('mail_order_enabled')->getData(),
            (bool) $form->get('store_enabled')->getData(),
        );

        $result = $this->buildFormatSalesSummary($inputDate, $baseInfoFilter);

        $event = new EventArgs(
            [
                'form' => $form,
                'searchData' => $form->getData(),
            ],
            $request
        );
        $this->eventDispatcher->dispatch($event, EccubeEvents::ADMIN_ANALYSIS_FORMAT_SALES_CSV_EXPORT);

        $response = new StreamedResponse(function () use ($result): void {
            $handle = fopen('php://output', 'w');
            if ($handle === false) {
                throw new \RuntimeException('Failed to open output stream');
            }
            fwrite($handle, "\xEF\xBB\xBF");
            fputcsv($handle, array_merge(['日'], $result['formats'], ['合計']));

            foreach ($result['formatSales'] as $day => $sales) {
                $row = [$day];
                foreach ($sales as $sale) {
                    $row[] = $sale;
                }
                $row[] = $result['daySum'][$day];
                fputcsv($handle, $row);
            }

            fclose($handle);
        });

        $filename = 'format_sales_'.(new \DateTime())->format('YmdHis').'.csv';
        $response->headers->set('Content-Type', 'application/octet-stream');
        $response->headers->set('Content-Disposition', 'attachment; filename="'.$filename.'"');

        return $response;
    }

    /**
     * 集計対象の base_info_id フィルタを決定する。
     *
     * null = 全件対象（両方チェック時）
     * 正の値 = 通販のみ
     * 負の値（便宜上）→ 店舗のみは NOT rootId で表現するため専用フラグを使う
     *
     * @return array{mode: 'all'|'mail_order'|'store', rootId: int}
     */
    private function resolveBaseInfoFilter(bool $mailOrder, bool $store): array
    {
        $rootId = (int) $this->eccubeConfig->get('eccube_root_base_info_id');

        if ($mailOrder && $store) {
            return ['mode' => 'all', 'rootId' => $rootId];
        }
        if ($mailOrder) {
            return ['mode' => 'mail_order', 'rootId' => $rootId];
        }

        return ['mode' => 'store', 'rootId' => $rootId];
    }

    /**
     * フォーマット別売上集計データを構築する.
     *
     * @param \DateTimeInterface $inputDate 集計月の1日
     * @param array{mode: 'all'|'mail_order'|'store', rootId: int}|null $baseInfoFilter
     *
     * @return array{formats: list<string>, formatSales: array<int, list<int>>, daySum: array<int, int>, resultCalc: array<string, array{sum: int, average: int}>}
     */
    private function buildFormatSalesSummary(\DateTimeInterface $inputDate, ?array $baseInfoFilter): array
    {
        $lastDay = \DateTime::createFromInterface($inputDate)->modify('last day of this month');
        $days = (int) $lastDay->format('d');

        $resultKeys = [];
        $resultInfo = [];
        $resultDays = [];

