namespace Eccube\Controller\Admin\Analysis;

use Eccube\Controller\AbstractController;
use Eccube\Entity\Member;
use Eccube\Event\EccubeEvents;
use Eccube\Event\EventArgs;
use Eccube\Form\Type\Admin\Analysis\SalesType;
use Eccube\Repository\OrderItemRepository;
use Eccube\Service\Csv\Exporter\SalesAnalysisCsvExporterService;
use Eccube\Util\FormUtil;
use Symfony\Bridge\Twig\Attribute\Template;
use Symfony\Component\HttpFoundation\RedirectResponse;
use Symfony\Component\HttpFoundation\Request;
use Symfony\Component\HttpFoundation\StreamedResponse;
use Symfony\Component\Routing\Attribute\Route;

class SalesAnalysisController extends AbstractController
{
    private const SESSION_KEY = 'eccube.admin.analysis.sales.search';

    public function __construct(
        private readonly OrderItemRepository $orderItemRepository,
        private readonly SalesAnalysisCsvExporterService $salesAnalysisCsvExporterService,
    ) {
    }

    /**
     * @return array<string, mixed>
     */
    #[Route(path: '/%eccube_admin_route%/analysis/sales', name: 'admin_analysis_sales', methods: ['GET'])]
    #[Template(template: '@admin/Analysis/sales.twig')]
    public function index(Request $request): array
    {
        $searchForm = $this->createForm(SalesType::class);
        $searchForm->get('store_sales_targets')->setData($this->resolveMemberShopIds());

        $event = new EventArgs(
            [
                'form' => $searchForm,
            ],
            $request
        );
        $this->eventDispatcher->dispatch($event, EccubeEvents::ADMIN_ANALYSIS_SALES_ANALYSIS_INDEX_INITIALIZE);

        return [
            'searchForm' => $searchForm->createView(),
            'searched' => false,
            'summary' => null,
            'total' => null,
            'summaryType' => 'product_id',
        ];
    }

    /**
     * @return array<string, mixed>
     */
    #[Route(path: '/%eccube_admin_route%/analysis/sales/search', name: 'admin_analysis_sales_search', methods: ['POST'])]
    #[Template(template: '@admin/Analysis/sales.twig')]
    public function search(Request $request): array
    {
        $builder = $this->formFactory->createBuilder(SalesType::class);

        $event = new EventArgs(
            [
                'builder' => $builder,
            ],
            $request
        );
        $this->eventDispatcher->dispatch($event, EccubeEvents::ADMIN_ANALYSIS_SALES_ANALYSIS_SEARCH_INITIALIZE);

        $searchForm = $builder->getForm();
        $searchForm->handleRequest($request);

        if (!$searchForm->isSubmitted() || !$searchForm->isValid()) {
            return [
                'searchForm' => $searchForm->createView(),
                'searched' => false,
                'summary' => null,
                'total' => null,
                'summaryType' => 'product_id',
            ];
        }

        $searchData = $searchForm->getData();
        $this->session->set(self::SESSION_KEY, FormUtil::getViewData($searchForm));

        $searchData['base_info_ids'] = $this->resolveTargetBaseInfoIds(
            (bool) ($searchData['mail_order_enabled'] ?? false),
            is_iterable($searchData['store_sales_targets'] ?? null) ? $searchData['store_sales_targets'] : []
        );
        $summary = $this->orderItemRepository->getAnalysisSummary($searchData);

        $event = new EventArgs(
            [
                'form' => $searchForm,
                'searchData' => $searchData,
            ],
            $request
        );
        $this->eventDispatcher->dispatch($event, EccubeEvents::ADMIN_ANALYSIS_SALES_ANALYSIS_SEARCH);

        return [
            'searchForm' => $searchForm->createView(),
            'searched' => true,
            'summary' => $summary['result'],
            'total' => $summary['total'],
            'summaryType' => $searchData['summary_type'] ?? 'product_id',
        ];
    }

    #[Route(path: '/%eccube_admin_route%/analysis/sales/export', name: 'admin_analysis_sales_export', methods: ['GET'])]
    public function export(Request $request): StreamedResponse|RedirectResponse
    {
        $viewData = $this->session->get(self::SESSION_KEY);
        if ($viewData === null) {
            $this->addError('検索条件がありません。先に検索を実行してください。', 'admin');

            return $this->redirectToRoute('admin_analysis_sales');
        }

        set_time_limit(0);
        $this->entityManager->getConfiguration()->setSQLLogger(null);

        $searchForm = $this->createForm(SalesType::class);
        $searchData = FormUtil::submitAndGetData($searchForm, $viewData);
        $searchData['base_info_ids'] = $this->resolveTargetBaseInfoIds(
            (bool) ($searchData['mail_order_enabled'] ?? false),
            is_iterable($searchData['store_sales_targets'] ?? null) ? $searchData['store_sales_targets'] : []
        );

        $event = new EventArgs(
            [
                'form' => $searchForm,
                'searchData' => $searchData,
            ],
            $request
        );
        $this->eventDispatcher->dispatch($event, EccubeEvents::ADMIN_ANALYSIS_SALES_ANALYSIS_CSV_EXPORT);

        return $this->salesAnalysisCsvExporterService->exportBySearchData($searchData);
    }

    /**
     * @param iterable<mixed> $storeSalesTargets
     *
     * @return list<int>
     */
    private function resolveTargetBaseInfoIds(bool $mailOrderEnabled, iterable $storeSalesTargets): array
    {
        $ids = [];
        if ($mailOrderEnabled) {
            $rootBaseInfoId = (int) $this->eccubeConfig->get('eccube_root_base_info_id');
            $ids[$rootBaseInfoId] = $rootBaseInfoId;
        }

        foreach ($storeSalesTargets as $storeId) {
            $id = (int) $storeId;
            if ($id > 0) {
                $ids[$id] = $id;
            }
        }

        return array_values($ids);
    }

    /**
     * @return list<int>
     */
    private function resolveMemberShopIds(): array
    {
        $Member = $this->getUser();
        if (!$Member instanceof Member) {
            return [];
        }

        $ids = [];
        $baseInfoId = $Member->getBaseInfo()->getId();
        if ($baseInfoId !== null) {
            $ids[$baseInfoId] = $baseInfoId;
        }

        foreach ($Member->getMemberBaseInfos() as $MemberBaseInfo) {
            $id = $MemberBaseInfo->getBaseInfo()->getId();
            if ($id !== null) {
                $ids[$id] = $id;
            }
        }

        return array_values($ids);
    }
}
