    /**
     *
     * @param Application $app
     * @param MtbCard $card
     */
    public function findNameEnById($cardId)
    {
        $qb = $this->createQueryBuilder('c')
            ->select('c.nameEn')
            ->where(Expr::eq('c.id', ':cardId'))
            ->setParameter('cardId', $cardId);

        return $qb->getQuery()->getOneOrNullResult();
    }

    /**
     * カード採用枚数(simple export)
     * @param $array $searchData
     * @return array
     */
    public function getSimpleUsedCardsCountExportBySearchData($searchData)
    {
        $from = $searchData['startDate']->modify('00:00:00');
        $to = $searchData['endDate'] ?? new \DateTime();
        $to->modify('23:59:59');

        $qb = $this->createQueryBuilder('c');
        $qb->select([
                'c.nameJp',
                // cardtypeやspecialtypeが複数紐づく場合は、その数分を割らなければならない
                'SUM(dc.count)/(
                    COUNT(DISTINCT ct.id) *
                    CASE WHEN COUNT(DISTINCT cs.specialtypeId) = 0 THEN 1 ELSE COUNT(DISTINCT cs.specialtypeId) END
                ) AS totalCount',
            ])
            ->join('c.deckCards', 'dc')
            ->join('c.cardtypes', 'ct')
            ->join('dc.deck', 'd', 'with', 'd.formatId IN (:formats) AND d.dispId = :dispId AND (d.eventDate BETWEEN :from AND :to)')
            ->leftJoin('Plugin\HareruyaEc\Entity\DtbCardSpecialtype', 'cs', 'with',  'c.id = cs.cardId')
            ->setParameters([
                'formats' => $searchData['formats']->toArray(),
                'dispId' => Disp::DISPLAY_SHOW,
                'from' => $from,
                'to' => $to,
            ])
            ->groupBy('c.id')
            ->orderBy('totalCount', 'DESC')
            ->addOrderBy('c.colorSequenceId', 'ASC')
            ->addOrderBy('c.nameEn', 'ASC');

        if (!$searchData['includeBasic']) {
            $qb->where(new Orx([
                    $qb->expr()->notIn('cs.specialtypeId', ':basicId'),
                    $qb->expr()->isNull('cs.specialtypeId')
                ]))
                ->setParameter('basicId', MtbSpecialtype::BASIC_ID);
        }

        return $qb->getQuery()->getResult();
    }

    /**
     * カード採用枚数(with product export)
     * @param $array $searchData
     * @return array
     */
    public function getUsedCardsCountExportBySearchData($searchData)
    {
        $from = $searchData['startDate']->modify('00:00:00');
        $to = $searchData['endDate'] ?? new \DateTime();
        $to->modify('23:59:59');

        $params = [
            'formats' => $searchData['formats']->toArray(),
            'dispId' => Disp::DISPLAY_SHOW,
            'from' => $from,
            'to' => $to,
            'deckTypeId' => MtbDeckType::EVENT_ID,
        ];

        $whereConditions = [];
        if (!$searchData['includeBasic']) {
            $whereConditions[] = '(cs.specialtype_id IS NULL OR cs.specialtype_id NOT IN (:basicId))';
            $params['basicId'] = MtbSpecialtype::BASIC_ID;
        }

        $whereConditions = empty($whereConditions) ? '' : 'WHERE ' . implode(' AND ', $whereConditions);
        $query = "
            SELECT
                countView.*,
                p2.product_id,
                pc2.product_code,
                p2.name AS product_name,
                pc2.stock,
                pc2.price02 AS price,
                psc2.buy_price,
                psc2.language_id,
                cs2.code AS cardset_code,
                r.code AS rarity_code,
                cd2.foil_flg,
                cc.code AS card_condtion_code,
                psc2.order_quantity_01 AS order_quantity_today,
                psc2.order_quantity_04 AS order_quantity_1week,
                psc2.order_quantity_05 AS order_quantity_1month,
                GROUP_CONCAT(DISTINCT pt.tag) AS tags
            FROM (
                SELECT
                    c.id AS card_id,
                    c.name_en AS card_name_en,
                    c.color_sequence_id,
                    SUM(dc.count)/(
                        COUNT(DISTINCT cct.cardtype_id) *
                        CASE WHEN COUNT(DISTINCT cs.specialtype_id) = 0 THEN 1 ELSE COUNT(DISTINCT cs.specialtype_id) END
                    ) AS totalCount,
                    (
                        SELECT pc.product_class_id
                        FROM mtb_card_detail cd
                        JOIN mtb_cardset cs ON cs.id = cd.cardset_id
                        JOIN dtb_product_sub ps ON ps.card_detail_id = cd.id
                        JOIN dtb_product p ON p.product_id = ps.product_id AND p.del_flg = 0
                        JOIN dtb_product_class pc ON pc.product_id = ps.product_id AND pc.del_flg = 0
                        JOIN dtb_product_sub_class psc ON psc.product_class_id = pc.product_class_id AND psc.card_condition_id = 1
                        WHERE c.id = cd.card_id
                        ORDER BY cs.special_flg ASC, cd.promotion_flg ASC, cs.release_date DESC, cd.foil_flg ASC, cd.id DESC, psc.language_id ASC
                        LIMIT 1
                    ) AS product_class_id
                FROM mtb_card c
                JOIN dtb_card_cardtype cct ON cct.card_id = c.id
                JOIN dtb_deck_card dc ON c.id = dc.card_id
                JOIN dtb_deck d ON d.deck_id = dc.deck_id AND d.format_id IN (:formats) AND d.disp_id = :dispId AND (d.event_date BETWEEN :from AND :to) AND d.deck_type_id = :deckTypeId
                LEFT JOIN dtb_card_specialtype cs ON c.id = cs.card_id
                {$whereConditions}
                GROUP BY c.id
            ) countView
            JOIN dtb_product_class pc2 ON countView.product_class_id = pc2.product_class_id
            JOIN dtb_product_sub_class psc2 ON pc2.product_class_id = psc2.product_class_id
            JOIN mtb_card_condition cc ON cc.id = psc2.card_condition_id
            JOIN dtb_product p2 ON p2.product_id = pc2.product_id
            LEFT JOIN dtb_product_tag pt ON pt.product_id = p2.product_id
            JOIN dtb_product_sub ps2 ON ps2.product_id = p2.product_id
            JOIN mtb_card_detail cd2 ON cd2.id = ps2.card_detail_id
            LEFT JOIN mtb_cardset cs2 ON cs2.id = cd2.cardset_id
            LEFT JOIN mtb_rarity r ON r.id = cd2.rarity_id
            GROUP BY p2.product_id
            ORDER BY countView.totalCount DESC, countView.color_sequence_id ASC, countView.card_name_en ASC
        ";

        $rsm = new ResultSetMapping();
        foreach (UsedCardController::EXPORT_DATA['product']['column'] as $colName) {
            $rsm->addScalarResult($colName, $colName);
        }

        return $this->getEntityManager()
            ->createNativeQuery($query, $rsm)
            ->setParameters($params)
            ->getResult();
    }

