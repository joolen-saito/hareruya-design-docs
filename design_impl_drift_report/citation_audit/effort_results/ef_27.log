use Symfony\Component\HttpFoundation\Request;
use Symfony\Component\HttpFoundation\StreamedResponse;

class UsedCardController extends AbstractController
{
    const VIEW_KEY = 'admin.used.card';

    const EXPORT_DATA = [
        'product' => [
            'method' => 'getUsedCardsCountExportBySearchData',
            'header' => [
                '商品ID',
                '商品コード',
                '商品名(日)',
                '在庫数',
                '販売価格',
                '買取価格',
                '言語(ID)',
                'カード名(英)',
                'カードセット略称',
                'レアリティ',
                'Foilフラグ',
                '状態コード',
                '当日販売数',
                '1週間販売数',
                '1ヵ月間販売数',
                '採用枚数',
                'タグ',
            ],
            'column' => [
                'product_id',
                'product_code',
                'product_name',
                'stock',
                'price',
                'buy_price',
                'language_id',
                'card_name_en',
                'cardset_code',
                'rarity_code',
                'foil_flg',
                'card_condtion_code',
                'order_quantity_today',
                'order_quantity_1week',
                'order_quantity_1month',
                'totalCount',
                'tags',
            ]
        ],
        'simple' => [
            'method' => 'getSimpleUsedCardsCountExportBySearchData',
            'header' => [
                'カード名',
                '採用枚数',
            ],
            'column' => [
                'nameJp',
                'totalCount',
            ]
        ]
    ];

    /**
     * 検索画面初期表示
     *
     * @param $app Application
     * @param $request Request
     * @return \Symfony\Component\HttpFoundation\Response
     */
    public function index(Application $app, Request $request)
    {
        $request->getSession()->remove(self::VIEW_KEY);
        $form = $app['form.factory']->createBuilder('admin_used_card')->getForm();

        return $app->render('Analysis/used_card.twig', [
            'searchForm' => $form->createView(),
            'isPosted' => false,
        ]);
    }

    /**
     * 検索
     *
     * @param Application $app
     * @param Request $request
     * @return \Symfony\Component\HttpFoundation\Response
     */
    public function search(Application $app, Request $request)
    {
        $form = $app['form.factory']->createBuilder('admin_used_card')->getForm()->handleRequest($request);

        $session = $request->getSession();
        $viewData = FormUtil::getViewData($form);
        $session->set(self::VIEW_KEY, $viewData);

        return $app->render('Analysis/used_card.twig', [
            'searchForm' => $form->createView(),
            'isPosted' => true,
        ]);
    }

    /**
     * Export
     *
     * @param Application $app
     * @param Request $request
     * @param string $mode
     * @return \Symfony\Component\HttpFoundation\Response
     */
    public function export(Application $app, Request $request, $mode)
    {
        $response = new StreamedResponse();
        $response->setCallback(function () use ($app, $request, $mode) {
            $session = $request->getSession();
            $viewData = $session->get(self::VIEW_KEY, []);
            $searchForm = $app['form.factory']->create('admin_used_card', null, ['csrf_protection' => true]);
            $searchData = FormUtil::submitAndGetData($searchForm, $viewData);
            $results = $app['hareruya_ec.repository.card']->{self::EXPORT_DATA[$mode]['method']}($searchData);

            $csvService = $app['eccube.service.csv.export'];
            $csvService->fopen();
            $csvService->putBOM();

            $csvService->fputcsv(self::EXPORT_DATA[$mode]['header']);
            foreach ($results as $result) {
                $row = [];
                foreach (self::EXPORT_DATA[$mode]['column'] as $colName) {
                    $row[] = $result[$colName];
                }
                $csvService->fputcsv($row);
            }
            $csvService->fclose();
        });

        $now = new \DateTime();
        $filename = "used_card_{$mode}_" . $now->format('YmdHis') . '.csv';
        $response->headers->set('Content-Type', 'application/octet-stream');
        $response->headers->set('Content-Disposition', 'attachment; filename=' . $filename);
        $response->send();

        return $response;
    }
}
