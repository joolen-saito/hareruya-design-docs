namespace Eccube\Controller\Admin\Analysis;

use Eccube\Controller\AbstractController;
use Eccube\Event\EccubeEvents;
use Eccube\Event\EventArgs;
use Eccube\Form\Type\Admin\Analysis\SearchUsedCardType;
use Eccube\Service\Csv\Exporter\UsedCardCsvExportService;
use Symfony\Bridge\Twig\Attribute\Template;
use Symfony\Component\HttpFoundation\Request;
use Symfony\Component\HttpFoundation\Response;
use Symfony\Component\Routing\Attribute\Route;

class UsedCardController extends AbstractController
{
    /** @param UsedCardCsvExportService $csvExportService */
    public function __construct(
        private readonly UsedCardCsvExportService $csvExportService,
    ) {
    }

    /**
     * 特集タグ編集CSV ダウンロード画面を表示する。
     *
     * @return array<string, mixed>
     */
    #[Route(path: '/%eccube_admin_route%/analysis/used-card', name: 'admin_analysis_used_card', methods: ['GET'])]
    #[Template(template: '@admin/Analysis/used_card.twig')]
    public function index(Request $request): array
    {
        $searchForm = $this->createForm(SearchUsedCardType::class);

        $event = new EventArgs(
            [
                'form' => $searchForm,
            ],
            $request
        );
        $this->eventDispatcher->dispatch($event, EccubeEvents::ADMIN_ANALYSIS_USED_CARD_INDEX_INITIALIZE);

        return ['searchForm' => $searchForm->createView()];
    }

    /**
     * 検索フォームの入力内容で特集タグ編集CSV をエクスポートする。
     * バリデーションエラー時はフォームを再表示する。
     */
    #[Route(path: '/%eccube_admin_route%/analysis/used-card', name: 'admin_analysis_used_card_export', methods: ['POST'])]
    public function export(Request $request): Response
    {
        $searchForm = $this->createForm(SearchUsedCardType::class);
        $searchForm->handleRequest($request);

        if (!$searchForm->isSubmitted() || !$searchForm->isValid()) {
            return $this->render('@admin/Analysis/used_card.twig', [
                'searchForm' => $searchForm->createView(),
            ]);
        }

        $event = new EventArgs(
            [
                'form' => $searchForm,
            ],
            $request
        );
        $this->eventDispatcher->dispatch($event, EccubeEvents::ADMIN_ANALYSIS_USED_CARD_EXPORT);

        return $this->csvExportService->exportBySearchData($searchForm->getData());
    }
}
