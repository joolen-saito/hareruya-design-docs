        ]);

        $baseInfo = $this->BaseInfoRepository->getMallBaseInfo();
        $message = (new Email())
            ->subject($mailTemplate->getMailSubject())
            ->from(new Address($baseInfo->getEmail01(), $baseInfo->getShopName()))
            ->to($this->convertRFCViolatingEmail($customer->getEmail()))
            ->replyTo($baseInfo->getEmail03())
            ->returnPath($baseInfo->getEmail04())
            ->text($body);

        try {
            $this->mailer->send($message);
        } catch (TransportExceptionInterface $e) {
            log_critical($e->getMessage());

            return;
        }

        $this->mailHistoryEntityManager->save($message, $baseInfo, $customer, $mailTemplate);
        $this->entityManager->flush();

        log_info('ポイント有効期限通知メール送信完了');
    }

