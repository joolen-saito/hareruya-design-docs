namespace Eccube\Service\Smaregi;

use Doctrine\ORM\EntityManagerInterface;
use Eccube\Entity\DtbPointHistory;
use Eccube\Entity\MessengerJob;
use Eccube\Message\SmaregiCustomerPointAddMessage;
use Psr\Log\LoggerInterface;
use Symfony\Component\Messenger\MessageBusInterface;

/**
 * 管理画面ポイント付与をスマレジ会員ポイントへ非同期反映するための連携ジョブを扱う.
 *
 * EC のポイント履歴登録と同一トランザクションで MessengerJob を INSERT し（{@see registerPointAddJob()}）、
 * commit 成功後に {@see dispatchPointAddMessage()} でメッセージを送る（アウトボックス的な順序）。
 */
class SmaregiCustomerPointEventService
{
    public function __construct(
        private readonly MessageBusInterface $messageBus,
        private readonly EntityManagerInterface $entityManager,
        private readonly LoggerInterface $logger,
    ) {
    }

    /**
     * ポイント付与と同一 DB トランザクションで連携ジョブを積む（flush は呼び出し側）.
     *
     * スマレジ未連携（smaregi_id 無し）や増減 0 の場合は連携不要のため null を返す。
     */
    public function registerPointAddJob(DtbPointHistory $pointHistory): ?MessengerJob
    {
        $smaregiId = $pointHistory->getCustomer()->getPlayer()?->getSmaregiId();
        if ($smaregiId === null || $smaregiId === '') {
            return null;
        }

        $pointChange = $pointHistory->getPointChange();
        if ($pointChange === null || $pointChange === 0) {
            return null;
        }

        $job = new MessengerJob();
        $job->setMessageClass(SmaregiCustomerPointAddMessage::class);
        $job->setStatus(MessengerJob::STATUS_PENDING);
        $job->setPayloadSummary(sprintf('smaregiId=%s point=%d', $smaregiId, $pointChange));
        $this->entityManager->persist($job);

        return $job;
    }

    /**
