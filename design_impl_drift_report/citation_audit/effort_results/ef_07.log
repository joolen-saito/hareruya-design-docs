    public function dispatchPointAddMessage(MessengerJob $job, DtbPointHistory $pointHistory): void
    {
        $jobId = (int) $job->getId();
        if ($jobId < 1) {
            $this->logger->error('Smaregi customer point job has no id; cannot dispatch message bus.', [
                'pointHistoryId' => $pointHistory->getId(),
            ]);

            return;
        }

        try {
            $this->messageBus->dispatch(new SmaregiCustomerPointAddMessage($pointHistory->getId(), $jobId));
        } catch (\Throwable $e) {
            try {
                $managed = $this->entityManager->find(MessengerJob::class, $jobId);
                if ($managed instanceof MessengerJob) {
                    $managed->setStatus(MessengerJob::STATUS_FAILED);
                    $managed->setCompletedAt(new \DateTime());
                    $managed->setErrorMessage('メッセージバスへの投入に失敗しました: '.$e->getMessage());
                    $this->entityManager->flush();
                }
            } catch (\Throwable $persistError) {
                // FAILED 永続化にも失敗したためジョブは PENDING のまま残る。再回収できるよう業務IDも記録する。
                $this->logger->error('Failed to persist Smaregi customer point job failure state', [
                    'jobId' => $jobId,
                    'pointHistoryId' => $pointHistory->getId(),
                    'error' => $persistError->getMessage(),
                ]);
            }
            $this->logger->error('Smaregi customer point add message dispatch failed', [
                'exception' => $e,
                'jobId' => $jobId,
                'pointHistoryId' => $pointHistory->getId(),
            ]);
        }
    }
}
            return;
        }

        $this->smaregiMessengerJobContext->setJobId((int) $Job->getId());
        try {
            if (!$this->smaregiMessengerJobProcessingLock->tryBeginProcessingJob($Job)) {
                return;
            }

            $pointHistory = $this->pointHistoryRepository->find($message->getPointHistoryId());
            if ($pointHistory === null) {
                $this->failJob($Job, 'ポイント履歴が見つかりません (pointHistoryId='.$message->getPointHistoryId().').');

                return;
            }

            $smaregiId = $pointHistory->getCustomer()->getPlayer()?->getSmaregiId();
            if ($smaregiId === null || $smaregiId === '') {
                $this->completeJobSkipped($Job, 'スマレジ未連携の会員のためポイント連携をスキップしました。');

                return;
            }

            $pointChange = $pointHistory->getPointChange();
            if ($pointChange === null || $pointChange === 0) {
                $this->completeJobSkipped($Job, '増減ポイントが 0 のためポイント連携をスキップしました。');

                return;
            }

            try {
                $response = $this->smaregiCustomerService->postSmaregiPoint($smaregiId, $pointChange);
            } catch (\Throwable $e) {
                // postSmaregiPoint は通常例外を投げないが、想定外例外は適用有無が不明なため自動リトライせず手動照合へ回す。
                $this->failJob($Job, 'スマレジ会員ポイント更新で想定外の例外が発生しました（適用有無不明・要手動照合）: '.$e->getMessage());

                return;
            }

            if (!array_key_exists('result', $response)) {
                $error = isset($response['error']) && is_string($response['error']) ? $response['error'] : '';

                // ポイント加算API(point/add)は相対加算で非冪等。加算API実行後（statusCode あり）の失敗は
                // 適用済みの可能性があり、自動リトライすると二重加算になりうるため再送出せず FAILED にして手動照合へ回す。
                if (array_key_exists('statusCode', $response)) {
                    $this->failJob($Job, 'スマレジ会員ポイント更新が不確定な状態で失敗しました（自動リトライ不可・要手動照合）: '.$error);

                    return;
                }

                // 加算API実行前の失敗（トークン取得 / customerId 解決）＝外部未適用が確定しているため再送出して再試行する。
                $this->failJob($Job, 'スマレジ会員ポイント更新に失敗しました（外部未適用・再試行）: '.$error);

