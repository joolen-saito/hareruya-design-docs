namespace Eccube\Service\Smaregi\Otc;

use Doctrine\ORM\EntityManagerInterface;
use Eccube\Entity\Order;
use Eccube\Service\Smaregi\Api\SmaregiProductApiClient;
use Psr\Log\LoggerInterface;

/**
 * 手続き完了済みの店頭受取注文に紐づくスマレジ商品を論理削除する同期サービス。
 *
 * 処理フロー:
 *   1. Order.smaregi_del_flg / smaregi_code をスキップ判定
 *   2. productCode (= Order.smaregi_code) で Smaregi 商品 ID を解決
 *      ({@see SmaregiOtcOrderSyncService::resolveProductIdByCode()} と同方針)
 *   3. 解決した productId に対して商品削除 API (DELETE /pos/products/{productId}) を実行
 *   4. 成功または「Smaregi 側に存在しなかった」場合は Order.smaregi_del_flg を ON にする
 *
 * 失敗時は smaregi_error_flg は触らない (OTC sync 側で使う運用と区別)。
 * MessengerJob 側で FAILED 遷移されることで再試行を運用に委ねる方針。
 */
final readonly class SmaregiOtcDeleteService
{
    public function __construct(
        private LoggerInterface $logger,
        private EntityManagerInterface $entityManager,
        private SmaregiProductApiClient $productApiClient,
    ) {
    }

    public function delete(
        Order $Order,
        string $apiUrl,
        string $contractId,
        string $accessToken,
    ): SmaregiOtcDeleteResult {
        if ($Order->isSmaregiDelFlg()) {
            return SmaregiOtcDeleteResult::ALREADY_DELETED;
        }

        $productCode = $Order->getSmaregiCode();
        if ($productCode === null || $productCode === '') {
            $this->logger->warning('Smaregi OTC delete skipped: smaregi_code is empty', [
                'orderId' => $Order->getId(),
            ]);

            return SmaregiOtcDeleteResult::SKIPPED;
        }

        // 商品コード → スマレジ商品 ID を解決
        $listResult = $this->productApiClient->listByProductCode($apiUrl, $contractId, $accessToken, $productCode);
        if (!$this->isHttpSuccess($listResult['statusCode'])) {
            // 通信/サーバ障害 (4xx/5xx) は「Smaregi 側に存在しない」とは区別する。
            // ここでフラグを ON にすると未削除のまま完了扱いになり再試行されないため、
            // フラグは据え置き DELETE_FAILED を返して MessengerJob の再試行に委ねる。
            $this->logger->error('Smaregi product lookup failed', [
                'orderId' => $Order->getId(),
                'productCode' => $productCode,
                'statusCode' => $listResult['statusCode'],
            ]);

            return SmaregiOtcDeleteResult::DELETE_FAILED;
        }

        $productId = $this->extractProductId($listResult['json'], $productCode);
        if ($productId === null) {
            // スマレジ側に該当 productCode の商品が無い (200 だが該当なし = 連携先で既に消えている可能性)。
            // ローカル側の削除フラグだけ ON にして冪等な再試行を可能にする。
            $this->markDeleted($Order);
            $this->logger->info('Smaregi product not found, marked as deleted locally', [
                'orderId' => $Order->getId(),
                'productCode' => $productCode,
            ]);

            return SmaregiOtcDeleteResult::NOT_FOUND_ON_SMAREGI;
        }

        $deleteResult = $this->productApiClient->delete($apiUrl, $contractId, $accessToken, $productId);
        if (!$this->isHttpSuccess($deleteResult['statusCode'])) {
            $this->logger->error('Smaregi product delete failed', [
                'orderId' => $Order->getId(),
                'productCode' => $productCode,
                'productId' => $productId,
                'statusCode' => $deleteResult['statusCode'],
            ]);

            return SmaregiOtcDeleteResult::DELETE_FAILED;
        }

        $this->markDeleted($Order);

        return SmaregiOtcDeleteResult::SUCCESS;
    }

    /**
     * listByProductCode の応答 (HTTP 2xx) から productCode 完全一致行の productId を取り出す。
     * HTTP 失敗の判定は呼び出し側で行い、障害と「未検出」を区別する
     * ({@see SmaregiOtcOrderSyncService::resolveProductIdByCode()} と同等の突合ロジック)。
     *
     * @param mixed $json listByProductCode 応答の json 部
     */
    private function extractProductId(mixed $json, string $productCode): ?string
    {
        if (!is_array($json)) {
            return null;
        }

        foreach ($json as $row) {
            if (($row['productCode'] ?? null) !== $productCode) {
                continue;
            }
            $productId = $row['productId'] ?? null;
            if (is_string($productId) && $productId !== '') {
                return $productId;
            }
        }

        return null;
    }

    private function markDeleted(Order $Order): void
    {
        $Order->setSmaregiDelFlg(true);
        $this->entityManager->flush();
    }

    private function isHttpSuccess(int $statusCode): bool
    {
        return $statusCode >= 200 && $statusCode < 300;
    }
}

