            ->findOneBy(['option_key' => MtbOption::SMAREGI_ERROR_MAIL_ADDRESS])
            ?->getOptionValue() ?? '';

        if ($address === '') {
            log_info('ポイント重複登録通知メールアドレス未設定のため送信せずに終了');

            return;
