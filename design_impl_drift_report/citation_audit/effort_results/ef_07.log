class LostPointsAction
{
    private const NOTE = '有効期限切れによる失効';

    public function __construct(
        private readonly DtbPointHistoryRepository $pointHistoryRepository,
        private readonly MtbPointTypeRepository $pointTypeRepository,
        private readonly SmaregiCustomerPointEventService $smaregiCustomerPointEventService,
        private readonly EntityManagerInterface $entityManager,
        private readonly PointHistoryEntityManager $pointHistoryEntityManager,
        private readonly LoggerInterface $logger,
    ) {
    }

    public function handle(): void
    {
        $lostPointPlayers = $this->pointHistoryRepository->getPlayersForLostPoint();
        $PointType = $this->pointTypeRepository->find(MtbPointType::GRANTED_TYPE);

        if (empty($lostPointPlayers)) {
            $this->logger->info('ポイント失効処理対象なし');

            return;
        }

        foreach ($lostPointPlayers as $lostPointPlayer) {
            $Player = $lostPointPlayer['player'];
            $remainingPoint = (int) $lostPointPlayer['remainingPoint'];
            $losePoint = $remainingPoint - $Player->getPoint();

            if ($losePoint === 0) {
                // 失効分が無ければ EC・スマレジともに更新不要。
                continue;
            }

            $LostPointHistory = new DtbPointHistory();
            $job = null;

            try {
                $this->entityManager->beginTransaction();

                $Player->setPoint($remainingPoint);
                $this->entityManager->persist($Player);

                $this->pointHistoryEntityManager->save(
                    PointHistory: $LostPointHistory,
                    Customer: $Player->getCustomer(),
                    Order: null,
                    PointType: $PointType,
                    pointChange: $losePoint,
                    note: self::NOTE,
                    issueDate: (new \DateTime())->modify('+183 days'),
                    transactionId: null,
                );

                // EC 失効と同一トランザクションでスマレジ連携ジョブを積む（未連携・増減0は null）。
                $job = $this->smaregiCustomerPointEventService->registerPointAddJob($LostPointHistory);

                $this->entityManager->flush();
                $this->entityManager->commit();
            } catch (\Throwable $e) {
                try {
                    if ($this->entityManager->getConnection()->isTransactionActive()) {
                        $this->entityManager->rollback();
                    }
                } catch (\Throwable) {
                    // ロールバック自体の失敗は握りつぶす（下で打ち切り判定する）。
                }

                $this->logger->error('ポイント失効処理に失敗しました', [
                    'player_id' => $Player->getId(),
                    'smaregi_id' => $Player->getSmaregiId(),
                    'message' => $e->getMessage(),
                ]);

                if (!$this->entityManager->isOpen()) {
                    // flush 失敗等で EntityManager が閉じた場合は以降を処理できないため打ち切る（残りは次回実行で再処理）。
                    $this->logger->error('EntityManager が閉じたためポイント失効バッチを中断します（残りは次回実行で再処理）');

                    break;
                }

                continue;
            }

    private function isHttpSuccess(int $statusCode): bool
    {
        return $statusCode >= 200 && $statusCode < 300;
    }

    /**
     * @return array{ok:bool,smaregiId:?string,statusCode:int,alreadyLinked:bool,error:?string}
     */
    private function result(bool $ok, ?string $smaregiId, int $statusCode, bool $alreadyLinked, ?string $error): array
    {
        return [
            'ok' => $ok,
            'smaregiId' => $smaregiId,
            'statusCode' => $statusCode,
            'alreadyLinked' => $alreadyLinked,
            'error' => $error,
        ];
    }

    /**
     * スマレジにポイントを増減させる
     *
     * @return array<string, mixed>
     */
    public function postSmaregiPoint(?string $smaregiId = null, ?int $point = null, bool $isRollback = false): array
    {
        if ($smaregiId === null || $smaregiId === '') {
            // スマレジ未連携の会員は連携対象が無いためスキップ(成功扱い)。
            return ['result' => ['status' => 'skipped']];
        }
        if ($point === null || $point === 0) {
            // 増減が無ければ連携不要。
            return ['result' => ['status' => 'skipped']];
        }

        try {
            $accessToken = $this->accessTokenService->getAccessToken(
                $this->smaregiApiIdUrl,
                $this->smaregiApiContractId,
                $this->smaregiApiClientId,
                $this->smaregiApiClientSecret,
            );
        } catch (\Throwable $e) {
            return ['error' => 'アクセストークン取得に失敗しました: '.$e->getMessage()];
        }

        // ポイント加算APIは customerId 必須だが EC は保持しないため、customer_no から解決する。
        $smaregiCustomerId = $this->resolveSmaregiCustomerId($accessToken, $smaregiId);
        if ($smaregiCustomerId === null) {
            return ['error' => 'customerId を解決できませんでした (smaregiId='.$smaregiId.').'];
        }

        $delta = $isRollback ? -$point : $point;
        $response = $this->customerApiClient->addPoint(
            $this->smaregiApiUrl,
            $this->smaregiApiContractId,
            $accessToken,
            $smaregiCustomerId,
            $delta,
        );

        if (!$this->isHttpSuccess($response['statusCode'])) {
            return [
                'error' => 'スマレジ会員ポイント更新APIが失敗しました (status='.$response['statusCode'].').',
                'statusCode' => $response['statusCode'],
            ];
        }

        // point/add がスマレジ側に生む取引ID。Webhook で戻る echo を抑止するため呼び出し側へ返す。
        $transactionHeadIds = $this->extractTransactionHeadIds($response['json']);
        if ($transactionHeadIds === []) {
            // point/add は成功(2xx)したが取引IDを取得できなかった。echo 抑止の記録ができず Webhook で二重付与に
            // なり得るため、成功扱いにせず statusCode 付きエラーとして返し、手動照合へ回す（point/add は再実行しない）。
            $this->logger->error('Smaregi customer point updated but response has no transactionHeadIds', [
                'smaregiId' => $smaregiId,
                'smaregiCustomerId' => $smaregiCustomerId,
                'point' => $delta,
                'statusCode' => $response['statusCode'],
            ]);

            return [
                'error' => 'スマレジ会員ポイント更新は成功しましたが取引IDを取得できませんでした（echo 抑止不可・要手動照合）。',
                'statusCode' => $response['statusCode'],
            ];
        }

        $this->logger->info('Smaregi customer point updated', [
            'smaregiId' => $smaregiId,
            'smaregiCustomerId' => $smaregiCustomerId,
            'point' => $delta,
        ]);

        return ['result' => ['status' => 'success', 'transactionHeadIds' => $transactionHeadIds]];
    }

    /**
     * point/add 応答（{"transactionHeadIds":["79"]} 等）から取引IDの一覧を取り出す.
     *
     * @param array<string,mixed>|list<array<string,mixed>>|null $json
     *
     * @return array<int,string>
     */
