/**
 * スマレジ POS 会員 API
 */
class SmaregiCustomerApiClient
{
    public function __construct(
        private readonly ClientInterface $httpClient,
        private readonly LoggerInterface $logger,
        private readonly SmaregiPlatformApiCallRecorder $platformApiCallRecorder,
    ) {
    }

    /**
     * 会員一覧取得（customer_code で絞り込み）.
     *
     * コードの完全一致で一意に決まる場合のみ採用すること。候補が 1 件でもコード不一致なら採用しない。
     *
     * @return array{statusCode:int,headers:array<string,array<string>>,body:string,json:array<int,array<string,mixed>>|null}
     */
    public function listByCustomerCode(
        string $apiUrl,
        string $contractId,
        string $accessToken,
        string $customerCode,
    ): array {
        $url = sprintf('%s/%s/pos/customers', rtrim($apiUrl, '/'), $contractId);

        return $this->requestGet(
            SmaregiPlatformApiCallLog::OPERATION_CUSTOMER_LIST,
            $url,
            $accessToken,
            [
                'customer_code' => $customerCode,
            ],
            [
                'customerCode' => $customerCode,
            ],
        );
    }

    /**
     * 会員一覧取得（customer_no で絞り込み）.
     *
     * customerNo は EC 採番の smaregi_id と一致する。会員番号の完全一致で判定すること。
     *
     * @return array{statusCode:int,headers:array<string,array<string>>,body:string,json:array<int,array<string,mixed>>|null}
     */
    public function listByCustomerNo(
        string $apiUrl,
        string $contractId,
        string $accessToken,
        string $customerNo,
    ): array {
        $url = sprintf('%s/%s/pos/customers', rtrim($apiUrl, '/'), $contractId);

        return $this->requestGet(
            SmaregiPlatformApiCallLog::OPERATION_CUSTOMER_LIST,
            $url,
            $accessToken,
            [
                'customer_no' => $customerNo,
            ],
            [
                'customerNo' => $customerNo,
            ],
        );
    }

    /**
     * 会員取得（スマレジ会員IDで存在確認）.
     *
     * @return array{statusCode:int,headers:array<string,array<string>>,body:string,json:array<string,mixed>|list<array<string,mixed>>|null}
     */
    public function get(
        string $apiUrl,
        string $contractId,
        string $accessToken,
        string $smaregiCustomerId,
    ): array {
        $url = sprintf('%s/%s/pos/customers/%s', rtrim($apiUrl, '/'), $contractId, rawurlencode($smaregiCustomerId));

        return $this->request(
            SmaregiPlatformApiCallLog::OPERATION_CUSTOMER_GET,
            'GET',
            $url,
            $accessToken,
            null,
            [
                'smaregiCustomerId' => $smaregiCustomerId,
            ],
        );
    }

    /**
     * 会員新規登録.
     *
     * @param array<string,mixed> $body
     *
     * @return array{statusCode:int,headers:array<string,array<string>>,body:string,json:array<string,mixed>|list<array<string,mixed>>|null}
     */
    public function create(
        string $apiUrl,
        string $contractId,
        string $accessToken,
        array $body,
    ): array {
        $url = sprintf('%s/%s/pos/customers', rtrim($apiUrl, '/'), $contractId);

        return $this->request(
            SmaregiPlatformApiCallLog::OPERATION_CUSTOMER_CREATE,
            'POST',
            $url,
            $accessToken,
            $body,
            [
                'customerCode' => $body['customerCode'] ?? '',
            ],
        );
    }

    /**
     * 会員削除（スマレジ会員IDで削除）.
     *
     * 存在しない会員IDの場合スマレジは 404 を返す。
     *
     * @return array{statusCode:int,headers:array<string,array<string>>,body:string,json:array<string,mixed>|list<array<string,mixed>>|null}
     */
    public function delete(
        string $apiUrl,
        string $contractId,
        string $accessToken,
        string $smaregiCustomerId,
    ): array {
        $url = sprintf('%s/%s/pos/customers/%s', rtrim($apiUrl, '/'), $contractId, rawurlencode($smaregiCustomerId));

        return $this->request(
            SmaregiPlatformApiCallLog::OPERATION_CUSTOMER_DELETE,
            'DELETE',
            $url,
            $accessToken,
            null,
            [
                'smaregiCustomerId' => $smaregiCustomerId,
            ],
        );
    }

    /**
     * 会員情報更新（スマレジ会員IDで PATCH）.
     *
     * 会員更新は冪等のため、呼び出し側は失敗時にそのまま再試行してよい。
     * 存在しない会員IDの場合スマレジは 404 を返す。
     *
     * @param array<string,mixed> $body
