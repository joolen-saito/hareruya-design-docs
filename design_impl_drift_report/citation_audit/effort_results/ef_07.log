    /**
     * 入荷通知メール用の商品詳細URLを生成する。
     */
    private function buildProductDetailAbsoluteUrlForRestockMail(
        Product $Product,
        ?ProductClass $ProductClass,
        string $langCode,
    ): string {
        $routeParams = [
            '_locale' => 'ja',
            'id' => $Product->getId(),
            'lang' => $langCode,
        ];
        if ($ProductClass !== null) {
            $routeParams['class'] = $ProductClass->getId();
        }

        try {
            return $this->router->generate('product_detail', $routeParams, UrlGeneratorInterface::ABSOLUTE_URL);
        } catch (\Throwable $e) {
            log_error('入荷通知メール用の商品詳細URL（絶対）の生成に失敗しました', [
                'exception' => $e,
                'product_id' => $Product->getId(),
                'product_class_id' => $ProductClass?->getId(),
            ]);
        }

        try {
            $path = $this->router->generate('product_detail', $routeParams, UrlGeneratorInterface::ABSOLUTE_PATH);
            $request = $this->requestStack->getMainRequest() ?? $this->requestStack->getCurrentRequest();
            if ($request !== null) {
                return rtrim($request->getSchemeAndHttpHost().$request->getBaseUrl(), '/').$path;
            }
        } catch (\Throwable $e) {
            log_error('入荷通知メール用の商品詳細URL（フォールバック）の生成に失敗しました', [
                'exception' => $e,
                'product_id' => $Product->getId(),
                'product_class_id' => $ProductClass?->getId(),
            ]);
        }

        return '';
    }

