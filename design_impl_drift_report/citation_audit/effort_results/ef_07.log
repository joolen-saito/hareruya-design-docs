namespace Eccube\Service\Smaregi\Api;

use Eccube\Dto\Smaregi\Api\Transaction\TransactionDto;
use Eccube\Entity\SmaregiPlatformApiCallLog;
use Eccube\Service\Smaregi\Api\Util\Transaction\TransactionResponseParser;
use GuzzleHttp\ClientInterface;
use Psr\Log\LoggerInterface;

/**
 * スマレジ POS 取引 API
 */
class SmaregiTransactionApiClient
{
    /**
     * @var array<string,string>
     */
    private const TRANSACTION_GET_FIXED_QUERY = [
        'with_details' => 'all',
        'with_payments' => 'none',
        'with_discounts' => 'all',
        'with_store' => 'all',
        'with_customer' => 'all',
        'with_staff' => 'all',
    ];

    public function __construct(
        private readonly ClientInterface $httpClient,
        private readonly LoggerInterface $logger,
        private readonly SmaregiPlatformApiCallRecorder $platformApiCallRecorder,
        private readonly TransactionResponseParser $responseParser,
    ) {
    }

    /**
     * @return array{statusCode:int,headers:array<string,array<string>>,body:string,json:array<string,mixed>|null,dto:TransactionDto|null}
     */
    public function getTransaction(
        string $apiUrl,
        string $contractId,
        string $accessToken,
        string $transactionHeadId,
    ): array {
        $url = sprintf(
            '%s/%s/pos/transactions/%s',
            rtrim($apiUrl, '/'),
            $contractId,
            rawurlencode($transactionHeadId),
        );

        $response = $this->requestGet(
            SmaregiPlatformApiCallLog::OPERATION_TRANSACTION_GET,
            $url,
            $accessToken,
            self::TRANSACTION_GET_FIXED_QUERY,
            [
                'transactionHeadId' => $transactionHeadId,
            ],
        );

        $dto = null;
        if (is_array($response['json'])) {
            try {
                $dto = $this->responseParser->parse($response['json']);
            } catch (\Throwable $e) {
                $this->logger->error('Smaregi transaction response parse failed', [
                    'transactionHeadId' => $transactionHeadId,
                    'error' => $e->getMessage(),
                ]);
            }
        }

        return $response + ['dto' => $dto];
    }

    /**
     * 取引一覧を取得する（Webhook 未達期間の受信漏れを補完する再連携バッチ等で使用する）.
     *
     * ページング（page / limit）と期間指定は公式 API のクエリキーに準拠して呼び出し側が $query に指定し、
     * ページ送りのループも呼び出し側で制御する（在庫の {@see SmaregiStockApiClient::listStocks} と同方針）。
     * 参考: https://developers.smaregi.dev/platform-api-reference/apis/pos/operations/gettransactions/
     *
     * @param array<string,string> $query page / limit / 期間指定 等の公式クエリキー
     *
     * @return array{statusCode:int,headers:array<string,array<string>>,body:string,json:array<int,array<string,mixed>>|null}
     */
    public function listTransactions(
        string $apiUrl,
        string $contractId,
        string $accessToken,
        array $query = [],
    ): array {
        $url = sprintf('%s/%s/pos/transactions', rtrim($apiUrl, '/'), $contractId);

        return $this->requestGet(
            SmaregiPlatformApiCallLog::OPERATION_TRANSACTION_LIST,
            $url,
            $accessToken,
            $query,
            [
                'queryKeys' => array_keys($query),
            ],
        );
    }

    /**
     * @param array<string,string> $query
     * @param array<string,mixed>  $logContext
     *
     * @return array{statusCode:int,headers:array<string,array<string>>,body:string,json:array<string,mixed>|array<int,array<string,mixed>>|null}
     */
    private function requestGet(
        string $operation,
        string $url,
        string $accessToken,
        array $query,
        array $logContext,
    ): array {
        $headers = [
            'Authorization' => 'Bearer '.$accessToken,
            'Accept' => 'application/json',
        ];
        $queryString = http_build_query($query);
        $requestUrl = $queryString === ''
            ? $url
            : $url.(str_contains($url, '?') ? '&' : '?').$queryString;
        $started = hrtime(true);

        try {
            $response = $this->httpClient->request('GET', $url, [
                'headers' => $headers,
                'query' => $query,
                'http_errors' => false,
            ]);
        } catch (\Throwable $e) {
            $this->recordFailure($operation, 'GET', $requestUrl, $headers, null, $started, $e, $logContext);

            return [
                'statusCode' => 0,
                'headers' => [],
                'body' => '',
                'json' => null,
            ];
        }

        $statusCode = $response->getStatusCode();
        $body = (string) $response->getBody();
        /** @var array<string|int,array<string>> $responseHeaders */
        $responseHeaders = $response->getHeaders();
        $durationMs = (int) ((hrtime(true) - $started) / 1_000_000);

        $decoded = $this->decodeJson($body);

        try {
            $this->platformApiCallRecorder->record(
                $operation,
                'GET',
                $requestUrl,
                $headers,
                '',
                $statusCode,
                $responseHeaders,
                $body,
                $durationMs,
                null,
            );
        } catch (\Throwable $e) {
            $this->logger->error('Smaregi transaction platform API call log (success) record failed', $logContext + [
                'method' => 'GET',
                'url' => $requestUrl,
                'statusCode' => $statusCode,
                'error' => $e->getMessage(),
            ]);
        }

        try {
            $this->logger->info('Smaregi transaction API requested', $logContext + [
                'method' => 'GET',
                'url' => $requestUrl,
                'statusCode' => $statusCode,
            ]);
        } catch (\Throwable $e) {
            $this->logger->error('Smaregi transaction API request success log failed', $logContext + [
                'method' => 'GET',
                'url' => $requestUrl,
                'statusCode' => $statusCode,
                'error' => $e->getMessage(),
            ]);
        }

        return [
            'statusCode' => $statusCode,
            'headers' => $responseHeaders,
            'body' => $body,
            'json' => $decoded,
        ];
    }

