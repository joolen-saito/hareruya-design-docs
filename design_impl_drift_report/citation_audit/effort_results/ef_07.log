/**
 * スマレジ取引取得 + action 別処理を 1 子ジョブとして消化する MessageHandler。
 *
 * 親ジョブ ({@see SmaregiWebhookEventMessageHandler}) は SmaregiWebhookEvent 単位での
 * 受信状態を管理し、本ハンドラは transactionHeadId 単位の処理状態を MessengerJob として管理する。
 *
 * 主な責務:
 *  1. 子 MessengerJob を {@see SmaregiMessengerJobProcessingLock} で悲観ロック + 状態遷移
 *     (PENDING/FAILED → PROCESSING、COMPLETED は skip)
 *  2. スマレジ取引取得 API 呼出
 *  3. updateDateTime ベースの dedup ({@see SmaregiTransactionJobRepository::findLatestCompletedByTransaction()})
 *     により、同一 (transactionHeadId, action) で過去に完了した updateDateTime 以下のリクエストを skip
 *  4. action ('created' / 'edited' / 'canceled' / 'disposed') 別に Pattern Handler / Processor を実行
 *  5. 処理結果を {@see SmaregiTransactionJob} に保存 (updateDateTime と共に)
 *
 * TODO: bulk-* も同パターンで子ジョブ化する
 * TODO: webhook 到着順序が逆転して対応 Order が無い canceled/disposed の救済
 */
#[AsMessageHandler]
final readonly class SmaregiTransactionProcessMessageHandler
{
    public function __construct(
        private LoggerInterface $logger,
        private EntityManagerInterface $entityManager,
        private SmaregiMessengerJobProcessingLock $smaregiMessengerJobProcessingLock,
        private MessengerJobRepository $messengerJobRepository,
        private SmaregiWebhookEventRepository $smaregiWebhookEventRepository,
        private SmaregiTransactionJobRepository $smaregiTransactionJobRepository,
        private SmaregiMessengerJobContext $smaregiMessengerJobContext,
        private SmaregiAccessTokenService $accessTokenService,
        private SmaregiTransactionApiClient $transactionApiClient,
        private PurchasePatternContextBuilder $contextBuilder,
        private PurchasePatternResolver $patternResolver,
        private OtcGuestPatternHandler $otcGuestPatternHandler,
        private OtcMemberPatternHandler $otcMemberPatternHandler,
        private EccubeSmoothOtcPatternHandler $eccubeSmoothOtcPatternHandler,
        private EccubeOtcPatternHandler $eccubeOtcPatternHandler,
        private SmaregiOrderPointApplier $pointApplier,
        private SmaregiPointAdjustmentApplier $pointAdjustmentApplier,
        private SmaregiPointAdjustmentReverter $pointAdjustmentReverter,
        private SmaregiTransactionCanceledProcessor $canceledProcessor,
        private SmaregiTransactionDisposedProcessor $disposedProcessor,
        private SmaregiTransactionEditedProcessor $editedProcessor,
        private string $smaregiApiIdUrl,
        private string $smaregiApiUrl,
        private string $smaregiApiClientId,
        private string $smaregiApiClientSecret,
        private string $smaregiApiContractId,
    ) {
    }

    public function __invoke(SmaregiTransactionProcessMessage $message): void
    {
        $Job = $this->messengerJobRepository->find($message->getJobId());
        if (!$Job instanceof MessengerJob) {
            $this->logger->error('Smaregi transaction process job not found', [
                'jobId' => $message->getJobId(),
            ]);

            return;
        }

        // スマレジ API 呼び出しログを当該子ジョブに紐付けるため、コンテキストへ jobId を設定する。
        // ({@see \Eccube\Service\Smaregi\Api\SmaregiPlatformApiCallRecorder} は本 ID を見て記録の可否を判断する)
        $this->smaregiMessengerJobContext->setJobId((int) $Job->getId());

        try {
            // 悲観ロック + PENDING/FAILED のときのみ PROCESSING へ遷移し、重複実行を抑止する。
            if (!$this->smaregiMessengerJobProcessingLock->tryBeginProcessingJob($Job)) {
                return;
            }

            $Event = $this->smaregiWebhookEventRepository->find($message->getSmaregiWebhookEventId());
            if (!$Event instanceof SmaregiWebhookEvent) {
                throw new \RuntimeException(sprintf('Smaregi webhook event not found (webhookEventId=%d)', $message->getSmaregiWebhookEventId()));
            }

            $this->processTransaction($Job, $Event, $message->getAction(), $message->getTransactionHeadId());

            $Job->setStatus(MessengerJob::STATUS_COMPLETED);
            $Job->setCompletedAt(new \DateTime());
            $Job->setErrorMessage(null);
            $this->entityManager->flush();
        } catch (\Throwable $e) {
            $this->logger->warning('Smaregi transaction process job failed', [
                'jobId' => $Job->getId(),
                'webhookEventId' => $message->getSmaregiWebhookEventId(),
                'action' => $message->getAction(),
                'transactionHeadId' => $message->getTransactionHeadId(),
                'error' => $e->getMessage(),
            ]);
            $this->failJob($Job, $e);

            throw $e;
        } finally {
            $this->smaregiMessengerJobContext->clear();
        }
    }

    private function processTransaction(MessengerJob $Job, SmaregiWebhookEvent $event, string $action, string $transactionHeadId): void
    {
        $accessToken = $this->accessTokenService->getAccessToken(
            $this->smaregiApiIdUrl,
            $this->smaregiApiContractId,
            $this->smaregiApiClientId,
            $this->smaregiApiClientSecret,
        );

        $response = $this->transactionApiClient->getTransaction(
            $this->smaregiApiUrl,
            $this->smaregiApiContractId,
            $accessToken,
            $transactionHeadId,
        );

        $transaction = $response['dto'] ?? null;
        if ($transaction === null) {
            throw new \RuntimeException(sprintf('Failed to fetch Smaregi transaction (transactionHeadId=%s, statusCode=%d)', $transactionHeadId, $response['statusCode']));
        }

        $updateDateTime = $transaction->updateDateTime;

        if ($this->isStaleUpdate($transactionHeadId, $action, $updateDateTime)) {
            $this->logger->info('Skip Smaregi transaction: stale updateDateTime (already processed)', [
                'jobId' => $Job->getId(),
                'webhookEventId' => $event->getId(),
                'action' => $action,
                'transactionHeadId' => $transactionHeadId,
                'updateDateTime' => $updateDateTime,
            ]);
            $this->upsertTransactionJobRecord($Job, $transactionHeadId, $action, $updateDateTime);

            return;
        }

        $this->dispatchByAction($event, $action, $transaction);
        $this->upsertTransactionJobRecord($Job, $transactionHeadId, $action, $updateDateTime);
    }

    private function isStaleUpdate(string $transactionHeadId, string $action, ?string $incomingUpdateDateTime): bool
    {
        if ($incomingUpdateDateTime === null || $incomingUpdateDateTime === '') {
            return false;
        }
        $latest = $this->smaregiTransactionJobRepository->findLatestCompletedByTransaction($transactionHeadId, $action);
        if ($latest === null) {
            return false;
        }
        $stored = $latest->getTransactionUpdateDateTime();
        if ($stored === null || $stored === '') {
            return false;
        }

        return $stored >= $incomingUpdateDateTime;
    }

    private function dispatchByAction(SmaregiWebhookEvent $event, string $action, TransactionDto $transaction): void
    {
        match ($action) {
            CreatedHandler::ACTION => $this->processCreated($event, $transaction),
            EditedHandler::ACTION => $this->editedProcessor->process($event, $transaction),
            CanceledHandler::ACTION => $this->processCanceled($event, $transaction),
            DisposedHandler::ACTION => $this->processDisposed($event, $transaction),
            default => $this->logger->warning('Smaregi transaction action not yet handled in child job', [
                'webhookEventId' => $event->getId(),
                'action' => $action,
                'transactionHeadId' => $transaction->transactionHeadId,
            ]),
        };
    }

    /**
     * 取消(canceled)。ポイント専用取引(区分6/7)は受注が無いためポイントを差し戻し、
     * それ以外は従来どおり受注の取消処理を行う。
