namespace Eccube\Service\Admin\OtcBuyOrder;

use Eccube\Entity\Master\MtbStockChangeTypeDetail;
use Eccube\Entity\ProductStock;
use Eccube\Repository\Master\MtbStockChangeTypeDetailRepository;
use Eccube\Service\Admin\OtcBuyOrder\ActionInput\OtcBuyOrderStockInboundInput;
use Eccube\Service\EntityManager\ProductStockEntityManager;
use Eccube\Service\EntityManager\StockHistoryEntityManager;

/**
 * 店頭買取 在庫入庫処理
 *
 * 単一の店頭買取案件に対して、商品在庫の更新と在庫履歴の登録を行う。
 * flush・トランザクション管理は呼び出し元が担う。
 */
class OtcBuyOrderStockInbound
{
    public function __construct(
        private readonly ProductStockEntityManager $productStockEntityManager,
        private readonly StockHistoryEntityManager $stockHistoryEntityManager,
        private readonly MtbStockChangeTypeDetailRepository $stockChangeTypeDetailRepository,
    ) {
    }

    public function process(OtcBuyOrderStockInboundInput $input): void
    {
        $OtcBuyOrder = $input->OtcBuyOrder;
        $BaseInfo = $OtcBuyOrder->getBaseInfo();

        $StockChangeTypeDetail = $this->stockChangeTypeDetailRepository->find(MtbStockChangeTypeDetail::PURCHASE_OTC);
        $registeredAt = new \DateTime();
        $operatorMemberName = $input->Member?->getName() ?? 'システム';
        $stockChangeReason = "店頭買取による入庫 査定ID：{$OtcBuyOrder->getAssessmentId()}";

        foreach ($OtcBuyOrder->getOtcBuyOrderStocks() as $OtcBuyOrderStock) {
            $ProductClass = $OtcBuyOrderStock->getProductClass();
            $stockChangeQuantity = (string) $OtcBuyOrderStock->getQuantity();

            // 買取店舗に対応するProductStockを取得
            $ProductStock = null;
            foreach ($ProductClass->getProductStocks() as $Stock) {
                if ($Stock->getBaseInfo()->getId() === $BaseInfo->getId()) {
                    $ProductStock = $Stock;
                    break;
                }
            }

            $oldStock = $ProductStock?->getStock() ?? '0';
            $unitCostPriceBefore = $ProductStock?->getUnitCost() ?? '0';
            $totalCostPriceBefore = $ProductStock?->getTotalCost() ?? '0';

            $newStock = $ProductStock !== null
                ? $ProductStock->getStockQuantityAfterChange($stockChangeQuantity)
                : $stockChangeQuantity;

            $newTotalCost = $ProductStock !== null
                ? bcadd($ProductStock->getTotalCost(), (string) $OtcBuyOrderStock->getSubtotal())
                : (string) $OtcBuyOrderStock->getSubtotal();

            $SavedProductStock = $this->productStockEntityManager->save(
                ProductStock: $ProductStock,
                ProductClass: $ProductClass,
                BaseInfo: $BaseInfo,
                stock: $newStock,
                pickUpFlg: $ProductStock?->getPickUpFlg() ?? false,
                stockLocationId: $ProductStock?->getStockLocationId() ?? ProductStock::STOCK_LOCATION_ECCUBE,
                totalCost: $newTotalCost,
            );

            $this->stockHistoryEntityManager->save(
                ProductStock: $SavedProductStock,
                StockChangeTypeDetail: $StockChangeTypeDetail,
                oldStock: $oldStock,
                stock: $newStock,
                stockChangeQuantity: $stockChangeQuantity,
                sellPrice: $ProductClass->getPrice02() ?? '0',
                unitCostPriceBefore: $unitCostPriceBefore,
                unitCostPriceAfter: (string) $OtcBuyOrderStock->getUnitCost(),
                totalCostPriceBefore: $totalCostPriceBefore,
                totalCostPriceAfter: $newTotalCost,
                stockChangeReason: $stockChangeReason,
                shortageReason: null,
                HistorySourceType: $input->HistorySourceType,
                historySourceId: (int) $OtcBuyOrder->getAssessmentId(),
                registeredAt: $registeredAt,
                RegisteredMember: $input->Member,
                operatorMemberName: $operatorMemberName,
            );
        }
    }
}
