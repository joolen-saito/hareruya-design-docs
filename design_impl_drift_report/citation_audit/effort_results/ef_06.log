use Symfony\Component\Process\PhpExecutableFinder;
use Symfony\Component\Process\Process;

/**
 * ユニサーチ商品フィード連携バッチ用のサービス
 */
class UniSearchExportService
{
    private const COMPRESS_GZIP = 'gzip';
    private const BACKUP_KEEP_COUNT = 5;
    private string $workDir;
    private string $lockFile;
    private string $projectDir;
    private string $cdnBaseUrl;
    private string $s3Endpoint;
    private string $awsS3Bucket;
    /**
     * @var array<string, array{hierarchicalCategoryIds: array<int, int>, hierarchicalCategoryName: string, hierarchicalCategoryNameEn: string}>|null
     */
    private ?array $hierarchicalCategories = null;
    private int $workerCount;
    private string $phpBinary;

    public function __construct(
        private readonly ProductClassRepository $productClassRepository,
        private readonly CategoryRepository $categoryRepository,
        private readonly UniSearchSftpService $sftpService,
        private readonly Filesystem $filesystem,
        ParameterBagInterface $params,
        KernelInterface $kernel,
    ) {
        $this->projectDir = $kernel->getProjectDir();
        $this->workDir = $this->projectDir.'/var/unisearch/';
        $this->filesystem->mkdir([$this->workDir]);
        $this->lockFile = $this->workDir.'unisearch.lock';
        $this->cdnBaseUrl = (string) $params->get('cdn_base_url');
        $this->s3Endpoint = (string) $params->get('s3_endpoint');
        $this->awsS3Bucket = (string) $params->get('aws_s3_bucket');
        $this->workerCount = max(1, (int) $params->get('eccube_unisearch_export_workers'));
        $this->phpBinary = (new PhpExecutableFinder())->find() ?: 'php';
    }

    public function exportAndUpload(bool $isManualExecution = false): int
    {
        $executionTime = new \DateTimeImmutable('now');
        $lockHandle = $this->acquireLock();
        if ($lockHandle === null) {
            log_warning('Unisearch 商品フィードTSV出力処理は既に実行中のためスキップしました。');

            return 0;
        }
        $this->deleteExistingOutputFiles();
        $baseFileName = 'feed_hareruyamtgecc_'.$executionTime->format('YmdHis');
        $baseDoneFileName = 'done_hareruyamtgecc_'.$executionTime->format('YmdHis');

        $tsvPath = $this->workDir.$baseFileName.'.tsv';
        $donePath = $this->workDir.$baseDoneFileName.'.txt';

        try {
            $this->deleteOldBackupFiles();

            $total = $this->exportTsvBySql($tsvPath);
            if ($total === 0) {
                $this->filesystem->dumpFile($tsvPath, '');
                log_info('出力対象が0件のため空ファイルを作成しました。', ['path' => $tsvPath]);
            }

            $gzipPath = $this->compressFile($tsvPath, self::COMPRESS_GZIP);

            $md5 = md5_file($gzipPath);
            $this->filesystem->dumpFile($donePath, $md5);
            log_info('.doneファイルを生成しました。', ['path' => $donePath, 'md5' => $md5]);

            log_info('バックアップファイルを作成しました。', ['path' => $gzipPath]);
            $this->applyPermissions([$tsvPath, $gzipPath, $donePath]);

            if (!$isManualExecution) {
                if (!$this->sftpService->deleteRemoteByPrefixes(['feed_hareruyamtg_', 'done_hareruyamtg_'])) {
                    throw new \RuntimeException('SFTP既存ファイルの削除に失敗しました。');
                }
                if (!$this->sftpService->upload($gzipPath)) {
                    throw new \RuntimeException('SFTPアップロードに失敗しました。');
                }
                if (!$this->sftpService->upload($donePath)) {
                    throw new \RuntimeException('SFTPアップロードに失敗しました。');
                }
                log_info('生成したファイルをSFTPにアップロードしました。');
            } else {
                log_info('手動実行モードのため、SFTPアップロードをスキップしました。');
            }
        } catch (\Throwable $e) {
            log_error('ユニサーチ商品フィード連携処理でエラーが発生しました。', [
                'error' => $e->getMessage(),
                'trace' => $e->getTraceAsString(),
            ]);
            throw $e;
        } finally {
            $this->releaseLock($lockHandle);
        }

        return $total;
    }

    /**
     * @return array<int, string>
     */
    public function getHeader(): array
    {
        return [
            'product',
            'product_name',
            'product_name_en',
            'color_sequence',
            'card_name',
            'language',
            'price',
            'image_url',
