                    :stock_up_180day,
                    :stock_up_365day,
                    :stock_up_2week,
                    :stock_up_3week,
                    :update_date
                )';
        } else {
            $query = '
                UPDATE dtb_stock_up_quantity
                SET stock_up_quantity_01 = 0,
