namespace Eccube\Service\Admin\Order;

use Doctrine\ORM\EntityManagerInterface;
use Eccube\Common\EccubeConfig;
use Eccube\Entity\Customer;
use Eccube\Entity\Master\Pref;
use Eccube\Repository\DtbPointHistoryRepository;
use Eccube\Repository\OrderRepository;
use Eccube\Service\MailService;
use Eccube\Service\PointService;
use Eccube\Service\ShoppingService;
use Symfony\Component\Process\Process;

class ResendMailAction
{
    public function __construct(
        private readonly OrderRepository $orderRepository,
        private readonly MailService $mailService,
        private readonly EntityManagerInterface $entityManager,
        private readonly EccubeConfig $eccubeConfig,
        private readonly DtbPointHistoryRepository $pointHistoryRepository,
        private readonly PointService $pointService,
        private readonly ShoppingService $shoppingService,
    ) {
    }

    /**
     * メール再送処理（resendMail）のロックを非ブロッキングで取得し、メールが送られていないオーダーを取得してメールを再送信する
     *
     * @return array{lockAcquired: bool, targetCount: int, processedCount: int, failedCount: int}
     */
    public function handle(): array
    {
        // メール再送処理（resendMail）のロックを非ブロッキングで取得
        if (!$this->orderRepository->getLock('resendMail', 0)) {
            log_info('Resend Mail Batch Not Finished.');

            return [
                'lockAcquired' => false,
                'targetCount' => 0,
                'processedCount' => 0,
                'failedCount' => 0,
            ];
        }
        // メールが送られていないオーダーを取得
        $Orders = $this->orderRepository->getNotSendMailOrders();
        $targetCount = count($Orders);
        $processedCount = 0;
        $failedCount = 0;

        foreach ($Orders as $Order) {
            $shouldUpdateSmaregiPoint = false;
            try {
                $this->entityManager->beginTransaction();
                $Order = $this->orderRepository->find($Order->getId());
                if ($Order === null) {
                    throw new \RuntimeException('Order not found.');
                }
                if ($Order->getSpendedPoints() > 0) {
                    // 利用ポイント履歴の存在を識別して判定する
                    if (!$this->pointHistoryRepository->hasSpendPointHistoryForOrder($Order)) {
                        $this->pointService->spendPoints($Order);
                    }
                    $shouldUpdateSmaregiPoint = true;
                }
                // 注文番号を取得
                $orderNumberEntity = $Order->getOrderNumber();
                // 注文番号を整形して取得
                $orderNumber = $orderNumberEntity !== null && $orderNumberEntity !== ''
                    ? sprintf('%08d', (int) $orderNumberEntity)
                    : '';
                // 在庫履歴と販売数を更新
                $this->shoppingService->updateStock($Order, $orderNumber);
                // メールの再送信
                $this->mailService->resendOrderMail($Order, $this->getLang($Order->getCustomer()));
                $this->entityManager->commit();
                ++$processedCount;

                if (!empty($shouldUpdateSmaregiPoint)) {
                    // スマレジポイント連携を別プロセスで実行
                    $projectDir = $this->eccubeConfig->get('kernel.project_dir');
                    $process = Process::fromShellCommandline(
                        "nohup php {$projectDir}/bin/console eccube:smaregi:update-point {$Order->getId()} &"
                    );
                    $process->run();
                    if (!$process->isSuccessful()) {
                        log_warning("Warning: Smaregi point update failed for Order ID {$Order->getId()}: {$process->getErrorOutput()}\n");
                    }
                }
            } catch (\Exception $e) {
                ++$failedCount;
                log_error('購入完了手続き再処理で受注処理に失敗しました', [
                    'order_id' => $Order->getId(),
                    'message' => $e->getMessage(),
                ]);
                if ($this->entityManager->getConnection()->isTransactionActive()) {
                    $this->entityManager->rollback();
                }
            }
        }

        return [
            'lockAcquired' => true,
            'targetCount' => $targetCount,
            'processedCount' => $processedCount,
            'failedCount' => $failedCount,
        ];
    }

    private function getLang(?Customer $customer): string
    {
        if ($customer === null) {
            return 'ja';
        }

        return $customer->getPref()?->getId() === Pref::PREF_ABROAD ? 'en' : 'ja';
    }
}
