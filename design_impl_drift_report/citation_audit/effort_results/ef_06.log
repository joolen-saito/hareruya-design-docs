    /**
     * 指定 Player のお気に入り商品 (公開中商品に限定) を COUNT する。
     * 一覧 `getQueryBuilderBySearchFavorite` と同じ Status 条件 (DISPLAY_SHOW) に揃える。
     */
    public function countByPlayer(DtbPlayer $Player): int
    {
        $count = $this->createQueryBuilder('fp')
            ->select('COUNT(fp.id)')
            ->innerJoin('fp.Product', 'p')
            ->where('fp.Player = :Player')
            ->andWhere('p.Status = :status')
            ->setParameter('Player', $Player)
            ->setParameter('status', ProductStatus::DISPLAY_SHOW)
            ->getQuery()
            ->getSingleScalarResult();

        return (int) $count;
    }

    /**
     * @param DtbPlayer $Player
     * @param array<string, mixed>|null $searchData
     *
     * @return array<int, DtbFavoriteProduct>
     */
    public function getQueryBuilderBySearchFavorite(DtbPlayer $Player, ?array $searchData): array
    {
        $qb = $this->createQueryBuilder('fp')
            ->addSelect(['p', 'cd', 'pc'])
            ->innerJoin('fp.Product', 'p')
            ->innerJoin('p.ProductClasses', 'pc', Join::WITH, 'pc.Language = fp.Language')
            ->leftJoin('p.CardDetail', 'cd')
            ->leftJoin('cd.Card', 'c')
            ->where('fp.Player = :Player')
            ->andWhere('p.Status = :status')
            ->setParameter('Player', $Player)
            ->setParameter('status', ProductStatus::DISPLAY_SHOW);

        if (isset($searchData['sale_flg']) && $searchData['sale_flg']) {
            $qb
                ->andWhere('pc.sale_flg = :sale_flg')
                ->setParameter('sale_flg', true);
        }

        $orderId = !empty($searchData['orderby']) ? $searchData['orderby']->getId() : null;

        if ($orderId === ProductListOrderBy::PRICE_ROW) {
            // 価格低い順
            $qb
                ->andWhere('pc.visible = true')
                ->addSelect('(SELECT MIN(pc_min.price02) FROM Eccube\Entity\ProductClass pc_min WHERE pc_min.Product = p AND pc_min.Language = fp.Language AND pc_min.visible = true) as HIDDEN price02_min')
                ->orderBy('price02_min', 'ASC');
        } elseif ($orderId === ProductListOrderBy::PRICE_HIGHER) {
            // 価格高い順
            $qb
                ->andWhere('pc.visible = true')
                ->addSelect('(SELECT MAX(pc_max.price02) FROM Eccube\Entity\ProductClass pc_max WHERE pc_max.Product = p AND pc_max.Language = fp.Language AND pc_max.visible = true) as HIDDEN price02_max')
                ->orderBy('price02_max', 'DESC');
        } else {
            // 色順
            $qb->orderBy('c.ColorSequence', 'ASC');
        }

        $qb->addOrderBy('fp.id', 'DESC');

        return $qb->getQuery()->getResult();
    }
}
