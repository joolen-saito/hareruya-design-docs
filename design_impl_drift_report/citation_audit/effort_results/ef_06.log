namespace Eccube\Service\UniSearch;

use Eccube\Common\EccubeConfig;
use Eccube\Entity\Master\MtbOption;
use Eccube\Repository\Master\MtbOptionRepository;
use phpseclib3\Crypt\Common\PrivateKey;
use phpseclib3\Crypt\PublicKeyLoader;
use phpseclib3\Net\SFTP;

/**
 * ユニサーチSFTP接続サービス
 */
class UniSearchSftpService
{
    private string $host;
    private int $port;
    private string $user;
    private string $remoteDir;
    private string $keyPath;

    public function __construct(
        private readonly EccubeConfig $eccubeConfig,
        private readonly MtbOptionRepository $mtbOptionRepository,
    ) {
        $Option = $this->mtbOptionRepository->findOneBy(['option_key' => MtbOption::UNISEARCH_SFTP_HOST]);
        $this->host = $Option->getOptionValue();
        $this->port = $this->eccubeConfig['eccube_unisearch_sftp_port'];
        $this->user = $this->eccubeConfig['eccube_unisearch_sftp_user'];
        $this->remoteDir = $this->eccubeConfig['eccube_unisearch_sftp_upload_dir'];
        $this->keyPath = $this->eccubeConfig['eccube_unisearch_sftp_ssh_key_path'];
    }

    public function upload(string $localPath): bool
    {
        if (!file_exists($localPath)) {
            log_error('SFTPアップロード失敗: ローカルファイルが見つかりません。', ['path' => $localPath]);

            return false;
        }

        $remoteFileName = basename($localPath);
        $remotePath = $this->remoteDir.'/'.$remoteFileName;

        $sftp = $this->createSftp();
        if ($sftp === null) {
            return false;
        }

        log_info('SFTPアップロード開始', ['local' => $localPath, 'remote' => $remotePath]);

        if (!$sftp->put($remotePath, $localPath, SFTP::SOURCE_LOCAL_FILE)) {
            log_error('SFTPアップロードに失敗しました。', ['path' => $remotePath, 'errors' => $sftp->getErrors()]);

            return false;
        }

        log_info('SFTPアップロード成功', ['path' => $remotePath]);

        return true;
    }

    /**
     * @param array<int, string> $prefixes
     */
    public function deleteRemoteByPrefixes(array $prefixes): bool
    {
        $sftp = $this->createSftp();
        if ($sftp === null) {
            return false;
        }

        $list = $sftp->nlist($this->remoteDir);
        if (!is_array($list)) {
            log_error('SFTPリスト取得に失敗しました。', ['dir' => $this->remoteDir]);

            return false;
        }

        foreach ($list as $file) {
            if (!is_string($file) || $file === '.' || $file === '..') {
                continue;
            }
            foreach ($prefixes as $prefix) {
                if (str_starts_with($file, $prefix)) {
                    $path = $this->remoteDir.'/'.$file;
                    if (!$sftp->delete($path)) {
                        log_error('SFTP削除に失敗しました。', ['path' => $path, 'errors' => $sftp->getErrors()]);

                        return false;
                    } else {
                        log_info('SFTP既存ファイルを削除しました。', ['path' => $path]);
                    }
                    break;
                }
            }
        }

        return true;
    }

    private function createSftp(): ?SFTP
    {
        $keyContents = file_get_contents($this->keyPath);
        if ($keyContents === false) {
            log_error('秘密鍵の読み込みに失敗しました。', ['key' => $this->keyPath]);

            return null;
        }

        try {
            $privateKey = PublicKeyLoader::load($keyContents);
        } catch (\Throwable $e) {
            log_error('秘密鍵の読み込みに失敗しました。', ['key' => $this->keyPath, 'ex' => $e->getMessage()]);

            return null;
        }

        if (!($privateKey instanceof PrivateKey)) {
            log_error('秘密鍵の形式が不正です。', ['key' => $this->keyPath]);

            return null;
        }

        $sftp = new SFTP($this->host, $this->port);
        if (!$sftp->login($this->user, $privateKey)) {
            log_error('SFTPログインに失敗しました。', ['host' => $this->host, 'user' => $this->user]);

            return null;
        }

        return $sftp;
    }
}
