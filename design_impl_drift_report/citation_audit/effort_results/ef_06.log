/**
 * @extends AbstractRepository<DtbStockUpQuantity>
 */
class DtbStockUpQuantityRepository extends AbstractRepository
{
    public function __construct(ManagerRegistry $registry)
    {
        parent::__construct($registry, DtbStockUpQuantity::class);
    }

    public function get(int $id = 1): ?DtbStockUpQuantity
    {
        return $this->find($id);
    }

    /**
     * 商品入庫数を更新（ネイティブクエリ対応版）
     *
     * @param array<int, mixed> $stockUpQuantity
     */
    public function updateStockUpQuantityNative(array $stockUpQuantity, bool $isNew): void
    {
        if ($isNew) {
            $query = '
                INSERT INTO dtb_stock_up_quantity
                (
                    product_class_id,
                    base_info_id,
                    stock_up_quantity_01,
                    stock_up_quantity_02,
                    stock_up_quantity_03,
                    stock_up_quantity_04,
                    stock_up_quantity_09,
                    stock_up_quantity_10,
                    stock_up_quantity_05,
                    stock_up_quantity_06,
                    stock_up_quantity_07,
                    stock_up_quantity_08,
                    update_date
                ) VALUES (
                    :product_class_id,
                    :base_info_id,
                    :stock_up_today,
                    :stock_up_yesterday,
                    :stock_up_3day,
                    :stock_up_weekly,
                    :stock_up_2week,
                    :stock_up_3week,
                    :stock_up_month,
                    :stock_up_90day,
                    :stock_up_180day,
                    :stock_up_365day,
                    :update_date
                )';
        } else {
            $query = '
                UPDATE dtb_stock_up_quantity
                SET stock_up_quantity_01 = :stock_up_today,
                    stock_up_quantity_02 = :stock_up_yesterday,
                    stock_up_quantity_03 = :stock_up_3day,
                    stock_up_quantity_04 = :stock_up_weekly,
                    stock_up_quantity_05 = :stock_up_month,
                    stock_up_quantity_06 = :stock_up_90day,
                    stock_up_quantity_07 = :stock_up_180day,
                    stock_up_quantity_08 = :stock_up_365day,
                    stock_up_quantity_09 = :stock_up_2week,
                    stock_up_quantity_10 = :stock_up_3week,
                    update_date = :update_date
                WHERE product_class_id = :product_class_id AND base_info_id = :base_info_id';
        }
        $this->getEntityManager()->getConnection()->executeUpdate($query, $stockUpQuantity);
    }

    /**
     * 集計用の既存行を削除する。
     */
    public function clearStockUpQuantityForAggregate(): void
    {
        $this->getEntityManager()->getConnection()->executeStatement(
            'DELETE FROM dtb_stock_up_quantity'
        );
    }

    /**
     * 期間別入庫数集計バッチ用データ取得
     *
     * 在庫履歴（dtb_stock_history）から入庫分類（入庫・棚卸）のレコードを対象に、
     * 商品規格ID・店舗ID別の期間別入庫数を返す。
     * 閉店店舗は除外する。
     *
     * @return array<int, array{
     *     product_class_id: int,
     *     base_info_id: int,
     *     stock_up_yesterday: int,
     *     stock_up_3day: int,
     *     stock_up_weekly: int,
     *     stock_up_2week: int,
     *     stock_up_3week: int,
     *     stock_up_month: int,
     *     stock_up_90day: int,
     *     stock_up_180day: int,
     *     stock_up_365day: int,
     * }>
     */
    public function getStockUpForAggregate(?\DateTimeInterface $createDate = null): array
    {
        $utc = new \DateTimeZone('UTC');
        $createDateUtc = \DateTimeImmutable::createFromInterface($createDate ?? new \DateTimeImmutable('now', $utc))
            ->setTimezone($utc);

        $rsm = new ResultSetMapping();
        $rsm
            ->addScalarResult('product_class_id', 'product_class_id', 'integer')
            ->addScalarResult('base_info_id', 'base_info_id', 'integer')
            ->addScalarResult('stock_up_yesterday', 'stock_up_yesterday', 'integer')
            ->addScalarResult('stock_up_3day', 'stock_up_3day', 'integer')
            ->addScalarResult('stock_up_weekly', 'stock_up_weekly', 'integer')
            ->addScalarResult('stock_up_2week', 'stock_up_2week', 'integer')
            ->addScalarResult('stock_up_3week', 'stock_up_3week', 'integer')
            ->addScalarResult('stock_up_month', 'stock_up_month', 'integer')
            ->addScalarResult('stock_up_90day', 'stock_up_90day', 'integer')
            ->addScalarResult('stock_up_180day', 'stock_up_180day', 'integer')
            ->addScalarResult('stock_up_365day', 'stock_up_365day', 'integer');

        $beStocked = MtbStockChangeType::BE_STOCKED;
        $inventoryAdjustment = MtbStockChangeType::INVENTORY_ADJUSTMENT;

        $query = <<<SQL
            SELECT
                ps.product_class_id,
                sh.base_info_id,
                SUM(CASE WHEN sh.create_date::date = (:create_date_ts::timestamptz)::date - 1
                    THEN GREATEST(sh.stock - sh.old_stock, 0) ELSE 0 END) AS stock_up_yesterday,
                SUM(CASE WHEN sh.create_date >= :create_date_ts::timestamptz - INTERVAL '3 days'
                    THEN GREATEST(sh.stock - sh.old_stock, 0) ELSE 0 END) AS stock_up_3day,
                SUM(CASE WHEN sh.create_date >= :create_date_ts::timestamptz - INTERVAL '7 days'
                    THEN GREATEST(sh.stock - sh.old_stock, 0) ELSE 0 END) AS stock_up_weekly,
                SUM(CASE WHEN sh.create_date >= :create_date_ts::timestamptz - INTERVAL '14 days'
                    THEN GREATEST(sh.stock - sh.old_stock, 0) ELSE 0 END) AS stock_up_2week,
                SUM(CASE WHEN sh.create_date >= :create_date_ts::timestamptz - INTERVAL '21 days'
                    THEN GREATEST(sh.stock - sh.old_stock, 0) ELSE 0 END) AS stock_up_3week,
                SUM(CASE WHEN sh.create_date >= :create_date_ts::timestamptz - INTERVAL '28 days'
                    THEN GREATEST(sh.stock - sh.old_stock, 0) ELSE 0 END) AS stock_up_month,
                SUM(CASE WHEN sh.create_date >= :create_date_ts::timestamptz - INTERVAL '90 days'
                    THEN GREATEST(sh.stock - sh.old_stock, 0) ELSE 0 END) AS stock_up_90day,
                SUM(CASE WHEN sh.create_date >= :create_date_ts::timestamptz - INTERVAL '180 days'
                    THEN GREATEST(sh.stock - sh.old_stock, 0) ELSE 0 END) AS stock_up_180day,
                SUM(CASE WHEN sh.create_date >= :create_date_ts::timestamptz - INTERVAL '365 days'
                    THEN GREATEST(sh.stock - sh.old_stock, 0) ELSE 0 END) AS stock_up_365day
            FROM dtb_stock_history sh
            JOIN dtb_product_stock ps ON sh.product_stock_id = ps.id
            JOIN dtb_base_info bi ON sh.base_info_id = bi.id
            JOIN mtb_stock_change_type_detail sctd ON sh.stock_change_type_detail_id = sctd.id
            WHERE sh.create_date >= :create_date_ts::timestamptz - INTERVAL '366 days'
              AND sctd.stock_change_type_id IN (:be_stocked, :inventory_adjustment)
              AND bi.is_open_shop = true
            GROUP BY ps.product_class_id, sh.base_info_id
            SQL;

        return $this->getEntityManager()
            ->createNativeQuery($query, $rsm)
            ->setParameter('be_stocked', $beStocked)
            ->setParameter('inventory_adjustment', $inventoryAdjustment)
            ->setParameter('create_date_ts', $createDateUtc->format('Y-m-d H:i:sP'))
            ->getResult();
    }

