namespace Eccube\Controller\Admin\Product;

use Eccube\Controller\AbstractController;
use Eccube\Event\EccubeEvents;
use Eccube\Event\EventArgs;
use Eccube\Service\Admin\Product\UniSearchFeedCreateAction;
use Symfony\Bridge\Twig\Attribute\Template;
use Symfony\Component\HttpFoundation\RedirectResponse;
use Symfony\Component\HttpFoundation\Request;
use Symfony\Component\Routing\Attribute\Route;

class UniSearchFeedController extends AbstractController
{
    public function __construct(
        private readonly UniSearchFeedCreateAction $feedCreateAction,
    ) {
    }

    /**
     * @return array<string, mixed>|RedirectResponse
     */
    #[Route(path: '/%eccube_admin_route%/product/unisearch/feed', name: 'admin_product_unisearch_feed', methods: ['GET', 'POST'])]
    #[Template(template: '@admin/Product/unisearch_feed.twig')]
    public function index(Request $request): array|RedirectResponse
    {
        if ($request->isMethod('POST')) {
            if (!$this->isCsrfTokenValid('unisearch_feed', $request->request->get('_token'))) {
                $this->addError('admin.common.csrf_token_error', 'admin');

                return $this->redirectToRoute('admin_product_unisearch_feed');
            }

            try {
                $result = $this->feedCreateAction->handle();
                if ($result === 0) {
                    $this->addWarning('admin.product.unisearch_feed_running', 'admin');
                } else {
                    $this->addSuccess('admin.product.unisearch_feed_complete', 'admin');
                }

                $event = new EventArgs(
                    [
                        'result' => $result,
                    ],
                    $request
                );
                $this->eventDispatcher->dispatch($event, EccubeEvents::ADMIN_PRODUCT_UNI_SEARCH_FEED_INDEX_COMPLETE);
            } catch (\Exception $e) {
                $this->addError('admin.product.unisearch_feed_failed', 'admin');
            }

            return $this->redirectToRoute('admin_product_unisearch_feed');
        }

        return [];
    }
}

