    /**
     * 本店（base_info_id=TC_TOKYO_ID）の EC-CUBE + スマレジ在庫を商品規格IDごとに合算して返す。
     *
     * @param array<int, int> $productClassIds
     *
     * @return array<int, int> [productClassId => totalStock]
     */
    public function getMainStoreDisplayStockByProductClassIds(array $productClassIds): array
    {
        $productClassIds = array_values(array_unique(array_map('intval', $productClassIds)));
        $productClassIds = array_filter($productClassIds, static fn (int $id): bool => $id > 0);

        if ($productClassIds === []) {
            return [];
        }

        $rows = $this->createQueryBuilder('ps')
            ->select('IDENTITY(ps.ProductClass) AS productClassId')
            ->addSelect('COALESCE(SUM(COALESCE(ps.stock, 0)), 0) AS totalStock')
            ->where('IDENTITY(ps.ProductClass) IN (:productClassIds)')
            ->andWhere(
                '(ps.stockLocationId = :eccubeStockLocationId AND IDENTITY(ps.baseInfo) = :baseInfoId)'
                .' OR ps.stockLocationId = :smaregiStockLocationId'
            )
            ->setParameter('productClassIds', $productClassIds)
            ->setParameter('baseInfoId', BaseInfo::TC_TOKYO_ID)
            ->setParameter('eccubeStockLocationId', ProductStock::STOCK_LOCATION_ECCUBE)
            ->setParameter('smaregiStockLocationId', ProductStock::STOCK_LOCATION_SMAREGI)
            ->groupBy('ps.ProductClass')
            ->getQuery()
            ->getArrayResult();

        $stocks = [];
        foreach ($rows as $row) {
            $stocks[(int) $row['productClassId']] = (int) $row['totalStock'];
        }

        return $stocks;
    }

    /**
     * 本店 EC-CUBE 在庫で、指定商品×言語のいずれかの規格に正の在庫があるか。
     */
    public function hasPositiveEccubeStockForProductAndLanguage(int $productId, int $languageId, int $baseInfoId): bool
    {
        if ($productId < 1 || $languageId < 1 || $baseInfoId < 1) {
            return false;
        }

        $count = (int) $this->createQueryBuilder('ps')
            ->select('COUNT(ps.id)')
            ->innerJoin('ps.ProductClass', 'pc')
            ->where('pc.Product = :productId')
            ->andWhere('pc.Language = :languageId')
            ->andWhere('ps.baseInfo = :baseInfoId')
            ->andWhere('ps.stockLocationId = :stockLocationId')
            ->andWhere('ps.stock IS NOT NULL')
            ->andWhere('ps.stock > 0')
