    /**
     * 対応する本文を取得
     *
     * @param array<string, mixed> $params
     */
    public function getBody(string $view, array $params): string
    {
        $twig = $this->twig;

        // twigファイルのソースコードを読み込み, 文字列化.
        $source = $twig->getLoader()->getSourceContext($view)->getCode();

        // イベントの実行.
        // プラグインにはテンプレートファイル名、文字列化されたtwigファイル、パラメータを渡す
        $event = new \Eccube\Event\TemplateEvent($view, $source, [], null);
        $this->eventDispatcher->dispatch($event, (string) $view);
        $template = $twig->createTemplate($event->getSource());
        $content = $template->render($params);

        return $content;
    }

    /**
     * ポイント重複登録通知メール送信
     *
     * @param array<int, string|null> $orderNumbers
     */
    public function sendOrderDuplicateNotificationMail(array $orderNumbers): void
    {
        log_info('ポイント重複登録通知メール送信開始');

        $address = $this->mtbOptionRepository
            ->findOneBy(['option_key' => MtbOption::SMAREGI_ERROR_MAIL_ADDRESS])
            ?->getOptionValue() ?? '';

        if ($address === '') {
            log_info('ポイント重複登録通知メールアドレス未設定のため送信せずに終了');

            return;
        }

        $lines = array_values(array_filter($orderNumbers, static fn (?string $n) => $n !== null && $n !== ''));
        $text = implode("\n", $lines);

        $body = <<<EOT
        ポイントの重複登録を検知しました。
        注文番号を確認してポイント残高を修正してください。

        注文番号:
        {$text}
        EOT;

        $baseInfo = $this->BaseInfoRepository->getMallBaseInfo();

        $message = (new Email())
            ->subject('ポイント重複登録通知メール')
            ->text($body)
            ->from(new Address($baseInfo->getEmail01(), $baseInfo->getShopName()))
            ->to($this->convertRFCViolatingEmail($address))
            ->replyTo($baseInfo->getEmail03())
            ->returnPath($baseInfo->getEmail04());

        try {
            $this->mailer->send($message);
            log_info('ポイント重複登録通知メール送信完了');
        } catch (TransportExceptionInterface $e) {
            log_critical($e->getMessage());
        }
    }

