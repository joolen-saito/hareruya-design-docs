namespace Eccube\Service\Smaregi;

use Doctrine\ORM\EntityManagerInterface;
use Eccube\Repository\OrderRepository;
use Eccube\Service\Smaregi\Otc\SmaregiOtcSyncDispatcher;

/**
 * 店頭受取注文のスマレジ連携用アクション.
 */
class SmaregiOtcOrderPostAction
{
    public function __construct(
        private readonly OrderRepository $orderRepository,
        private readonly SmaregiOtcSyncDispatcher $dispatcher,
        private readonly EntityManagerInterface $entityManager,
    ) {
    }

    /**
     * 店頭受取注文のスマレジ連携を行う.
     *
     * @param \DateTime $targetDateTime 対象時刻
     */
    public function handle(\DateTime $targetDateTime): void
    {
        // 対象受注を取得
        $Orders = $this->orderRepository->findTargetOrdersForSmaregiPost($targetDateTime);

        if ($Orders === []) {
            log_info('対象受注はありません。', ['targetDateTime' => $targetDateTime]);

            return;
        }

        $failedOrderIds = [];
        foreach ($Orders as $Order) {
            // 抽出条件で店舗情報.スマレジ店舗IDと店舗コードをnot null指定で取得している
            $BaseInfo = $Order->getBaseInfo();
            $smaregiShopId = $BaseInfo->getSmaregiShopId();
            $orderNumber = $Order->getOrderNumber();

            // スマレジ商品用バーコードの採番
            $smaregiCode = $this->getProductBarcode('20', '1', sprintf('%03d', $smaregiShopId), $orderNumber);
            // スマレジ用商品コード(バーコード)登録
            $Order->setSmaregiCode($smaregiCode);
            $this->entityManager->persist($Order);

            try {
                $Job = $this->dispatcher->dispatch($Order);
                log_info('店頭受取注文スマレジ連携ジョブを enqueue しました', [
                    'orderId' => $Order->getId(),
                    'jobId' => $Job->getId(),
                    'smaregiCode' => $smaregiCode,
                ]);
            } catch (\Throwable $e) {
                $failedOrderIds[] = $Order->getId();
                log_error('店頭受取注文スマレジ連携ジョブの enqueue に失敗しました', [
                    'orderId' => $Order->getId(),
                    'error' => $e->getMessage(),
                ]);
            }
        }

        if ($failedOrderIds !== []) {
            throw new \RuntimeException(sprintf('店頭受取注文スマレジ連携ジョブの enqueue に失敗した受注があります (orderIds=%s)', implode(',', $failedOrderIds)));
        }
    }

    /**
     * 注文番号からJANコードを生成する
     *
     * @param string $inStoreCode インストアコード
     * @param string $extension 拡張コード
     * @param string $shopCode スマレジ店舗ID
     * @param string $orderNumber 注文番号
     *
     * @return string
     */
    public function getProductBarcode(string $inStoreCode, string $extension, string $shopCode, string $orderNumber): string
    {
        // CheckDigit付与前のJANコード
        $janCode = $inStoreCode.$extension.$shopCode.substr($orderNumber, -6);
        $oddDigit = 0;
        $evenDigit = 0;

        foreach (str_split($janCode) as $key => $num) {
            // 奇数桁（添字は偶数）
            if ($key % 2 === 0) {
                $oddDigit += intval($num);
            // 偶数桁
            } else {
                $evenDigit += intval($num);
            }
        }

        // 10 - (奇数桁の合計＋偶数桁の合計×3)の下1桁
        $checkDigit = 10 - ($oddDigit + $evenDigit * 3) % 10;

        return $janCode.($checkDigit === 10 ? 0 : $checkDigit);
    }
}
    ) {
    }

    public function __invoke(SmaregiOtcSyncMessage $message): void
    {
        $Job = $this->messengerJobRepository->find($message->getJobId());
        if (!$Job instanceof MessengerJob) {
            $this->logger->error('MessengerJob not found for SmaregiOtcSyncMessage', [
                'jobId' => $message->getJobId(),
                'orderId' => $message->getOrderId(),
            ]);

            return;
        }

        $this->smaregiMessengerJobContext->setJobId((int) $Job->getId());
        try {
            if (!$this->smaregiMessengerJobProcessingLock->tryBeginProcessingJob($Job)) {
                return;
            }

            try {
                $Order = $this->orderRepository->find($message->getOrderId());
                if (!$Order instanceof Order) {
                    $this->failJob($Job, sprintf('受注が見つかりません (orderId=%d).', $message->getOrderId()));

                    return;
                }

                $smaregiShopId = $Order->getBaseInfo()->getSmaregiShopId();
                if ($smaregiShopId === null) {
                    $this->failJob($Job, sprintf('BaseInfo.smaregi_shop_id が未設定のため処理不能 (orderId=%d).', $message->getOrderId()));

                    return;
                }

                $categoryId = $this->resolveSmaregiCategoryId();
                if ($categoryId === '') {
                    $this->failJob($Job, '追加システム設定のスマレジ部門ID (smaregi_category_id) が未設定のため処理不能');

                    return;
                }

                $accessToken = $this->accessTokenService->getAccessToken(
                    $this->smaregiApiIdUrl,
                    $this->smaregiApiContractId,
                    $this->smaregiApiClientId,
                    $this->smaregiApiClientSecret,
                );

                $result = $this->syncService->sync(
                    $Order,
                    $this->smaregiApiUrl,
                    $this->smaregiApiContractId,
                    $accessToken,
                    (string) $smaregiShopId,
                    $categoryId,
                );

                $this->finalizeJob($Job, $result, $message->getOrderId());
            } catch (\Throwable $e) {
                $this->failJob($Job, $e->getMessage());
                $this->logger->error('Smaregi OTC sync handler failed', [
                    'jobId' => $Job->getId(),
                    'orderId' => $message->getOrderId(),
                    'exception' => $e,
                ]);
            }
        } finally {
            $this->smaregiMessengerJobContext->clear();
        }
    }

    private function finalizeJob(MessengerJob $Job, SmaregiOtcSyncResult $result, int $orderId): void
    {
        if (in_array($result, [SmaregiOtcSyncResult::PRODUCT_FAILED, SmaregiOtcSyncResult::STOCK_FAILED], true)) {
            $this->failJob($Job, sprintf('Smaregi OTC sync failed: result=%s', $result->value));

            return;
        }

        $Job->setStatus(MessengerJob::STATUS_COMPLETED);
        $Job->setCompletedAt(new \DateTime());
        $Job->setErrorMessage(null);
        $this->entityManager->flush();

        $this->logger->info('Smaregi OTC sync handler completed', [
            'jobId' => $Job->getId(),
            'orderId' => $orderId,
            'result' => $result->value,
        ]);
    }

    private function resolveSmaregiCategoryId(): string
    {
        $Option = $this->mtbOptionRepository->findOneBy(['option_key' => MtbOption::SMAREGI_CATEGORY_ID]);
        if (!$Option instanceof MtbOption) {
            return '';
        }

        return trim($Option->getOptionValue());
    }

    private function failJob(MessengerJob $Job, string $message): void
    {
        try {
            $Job->setStatus(MessengerJob::STATUS_FAILED);
            $Job->setCompletedAt(new \DateTime());
            $Job->setErrorMessage($message);
            $this->entityManager->flush();
        } catch (\Throwable $persistError) {
            $this->logger->error('Failed to persist Smaregi OTC sync job failure state', [
                'jobId' => $Job->getId(),
                'error' => $persistError->getMessage(),
            ]);
        }
    }
}
