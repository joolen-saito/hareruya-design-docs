namespace Eccube\Command;

use Eccube\Service\Admin\Order\ResendMailAction;
use Symfony\Component\Console\Attribute\AsCommand;
use Symfony\Component\Console\Command\Command;
use Symfony\Component\Console\Input\InputInterface;
use Symfony\Component\Console\Output\OutputInterface;
use Symfony\Component\Console\Style\SymfonyStyle;

/**
 * 購入完了手続き再処理バッチ（B05-02）
 *
 * 購入完了手続きが正常に完了しない場合に、購入完了手続きを再処理する。
 *
 * 【使い方】
 *
 *   bin/console eccube:resend-mail
 */
#[AsCommand(name: 'eccube:resend-mail', description: '購入完了手続き再処理')]
class ResendMailCommand extends Command
{
    public function __construct(
        private readonly ResendMailAction $resendMailAction,
    ) {
        parent::__construct();
    }

    protected function execute(InputInterface $input, OutputInterface $output): int
    {
        $io = new SymfonyStyle($input, $output);
        $io->text('購入完了手続き再処理バッチ開始');

        try {
            $summary = $this->resendMailAction->handle();
        } catch (\Throwable $e) {
            $io->error([
                '購入完了手続き再処理処理でエラーが発生しました',
                $e->getMessage(),
            ]);

            return Command::FAILURE;
        }

        if (!$summary['lockAcquired']) {
            $io->warning('別プロセスで購入完了手続き再処理が実行中のため、処理をスキップしました。');

            return Command::FAILURE;
        }

        if ($summary['targetCount'] === 0) {
            $io->success('購入完了手続き再処理対象の受注はありませんでした。');

            return Command::SUCCESS;
        }

        $message = sprintf(
            '購入完了手続き再処理が完了しました。対象=%d件 成功=%d件 失敗=%d件',
            $summary['targetCount'],
            $summary['processedCount'],
            $summary['failedCount'],
        );

        if ($summary['failedCount'] > 0) {
            $io->error($message);

            return Command::FAILURE;
        }

        $io->success($message);

        return Command::SUCCESS;
    }
}
