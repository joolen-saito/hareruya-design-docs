namespace Eccube\Form\Type\Admin;

use Doctrine\ORM\EntityRepository;
use Eccube\Entity\MailTemplate;
use Eccube\Form\Type\Master\MailTemplateType;
use Eccube\Form\Validator\TwigLint;
use Symfony\Component\Form\AbstractType;
use Symfony\Component\Form\Extension\Core\Type\TextareaType;
use Symfony\Component\Form\Extension\Core\Type\TextType;
use Symfony\Component\Form\FormBuilderInterface;
use Symfony\Component\OptionsResolver\OptionsResolver;
use Symfony\Component\Validator\Constraints\NotBlank;

class CustomerManualMailType extends AbstractType
{
    #[\Override]
    public function buildForm(FormBuilderInterface $builder, array $options): void
    {
        $fileNames = [];
        if (!empty($options['baseFiles'])) {
            $fileNames[] = MailTemplate::BASE_FILES[MailTemplate::BASE_NO_BASE];
        }
        foreach ($options['baseFiles'] as $baseFile) {
            $fileNames[] = MailTemplate::BASE_FILES[$baseFile];
        }
        $fileNames = array_values(array_unique($fileNames));

        $builder
            ->add('mailTemplate', MailTemplateType::class, [
                'required' => false,
                'mapped' => false,
                'data' => $options['MailTemplate'],
                'query_builder' => function (EntityRepository $er) use ($options, $fileNames) {
                    $qb = $er->createQueryBuilder('mt');

                    $qb->where('mt.isAutoSend = :autoSend')
                        ->setParameter('autoSend', $options['autoMail']);

                    if ($fileNames !== []) {
                        $qb->andWhere('mt.file_name IN (:fileNames)')
                            ->setParameter('fileNames', $fileNames);
                    }

                    return $qb->orderBy('mt.name', 'ASC');
                },
            ])
            ->add('mail_subject', TextType::class, [
                'label' => 'タイトル',
                'mapped' => true,
                'required' => true,
                'constraints' => [
                    new NotBlank(),
                ],
            ])
            ->add('body', TextareaType::class, [
                'label' => false,
                'mapped' => true,
                'required' => false,
                'constraints' => [
                    new NotBlank(),
                    new TwigLint(),
                ],
            ])
        ;
    }

    #[\Override]
    public function configureOptions(OptionsResolver $resolver): void
    {
        $resolver->setDefaults([
            'MailTemplate' => null,
            'autoMail' => true,
            'baseFiles' => [],
        ]);
    }

    #[\Override]
    public function getBlockPrefix(): string
    {
        return 'admin_customer_manual_mail';
    }
}
