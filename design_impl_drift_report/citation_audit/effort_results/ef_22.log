{% extends '@admin/default_frame.twig' %}

{% set menus = ['customer', 'customer_edit'] %}

{% block title %}{{ 'admin.customer.manual_mail'|trans }}{% endblock %}
{% block sub_title %}{{ 'admin.customer.customer_management'|trans }}{% endblock %}

{% form_theme form '@admin/Form/bootstrap_4_horizontal_layout.html.twig' %}

{% block stylesheet %}
{% endblock %}

{% block javascript %}
<script nonce="{{ csp_nonce }}">
$(function() {
    $('#template-change').on('change', function() {
        const selectedValue = $(this).val();
        const baseUrl = '{{ url('admin_customer_manual_mail', { 'id': Customer.id, 'template_id': null}) }}/';

        window.location.href = baseUrl + selectedValue;
    });

    $('#confirm').on('click', function(e) {
        e.preventDefault();
        $('#mode').val('confirm');
        $('#manual-mail-form').submit();
    });
});
</script>
{% endblock javascript %}

{% block main %}
<div class="c-contentsArea__cols">
    <div class="c-contentsArea__primaryCol">
        <div class="c-primaryCol">
             <form id="manual-mail-form" class="form-horizontal" method="POST" action="{{ url('admin_customer_manual_mail', { 'id': Customer.id, 'template_id': MailTemplate ? MailTemplate.id : null}) }}">
                {{ form_widget(form._token) }}
                <input id="mode" type="hidden" name="mode">
                <div class="card rounded border-0 mb-4">
                    <div class="card-header">
                        <div class="row">
                            <div class="col-12">
                                <span class="card-title">
                                    {{ 'admin.customer.manual_mail'|trans }}
                                </span>
                            </div>
                        </div>
                    </div>
                    <div class="card-header">
                        <div class="row mb-2">
                            <div class="col-3">
                                <div class="d-inline-block">
                                    <span>{{ 'admin.customer.customer_name'|trans }}</span>
                                </div>
                            </div>
                            <div class="col">
                                {{ Customer.name01 }} {{ Customer.name02 }}
                            </div>
                        </div>
                        <div class="row mb-2">
                            <div class="col-3">
                                <div class="d-inline-block">
                                    <span>{{ 'admin.order.mail_template'|trans }}</span>
                                </div>
                            </div>
                            <div class="col">
                                {{ form_widget(form.mailTemplate, {'id': 'template-change'}) }}
                                {{ form_errors(form.mailTemplate) }}
                            </div>
                        </div>
                        <div class="row mb-2">
                            <div class="col-3">
                                <div class="d-inline-block">
                                    <span>{{ 'admin.customer.mail_template.subject'|trans }}</span>
                                </div>
                            </div>
                            <div class="col">
                                {{ form_widget(form.mail_subject) }}
                                {{ form_errors(form.mail_subject) }}
                            </div>
                        </div>
                    </div>
                    <div class="collapse show ec-cardCollapse">
                        <div class="card-body">
                            {{ form_widget(form.body, { 'attr': { 'rows': 20 }}) }}
                            {{ form_errors(form.body) }}
                        </div>
                    </div>
                    <div class="c-conversionArea">
                        <div class="c-conversionArea__container">
                            <div class="row justify-content-between align-items-center">
                                <div class="col-6">
                                    <div class="c-conversionArea__leftBlockItem">
                                        <a class="c-baseLink" href="{{ url('admin_customer_edit', { id: Customer.id }) }}">
                                            <i class="fa fa-backward" aria-hidden="true"></i>
                                            <span>{{ 'admin.customer.back_to_customer_edit'|trans }}</span></a>
                                    </div>
                                </div>
                                <div class="col-6">
                                    <div class="row align-items-center justify-content-end">
                                        <div class="col-auto">
                                            <button type="button" id="confirm" class="btn btn-ec-conversion px-5">{{ 'admin.common.confirm'|trans }}</button>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>
{% endblock %}
{% extends '@admin/default_frame.twig' %}

{% set menus = ['customer', 'customer_master'] %}

{% block title %}{{'admin.customer.mail'|trans}}{% endblock %}
{% block sub_title %}{{'admin.customer.customer_management'|trans}}{% endblock %}

{% form_theme form '@admin/Form/bootstrap_4_horizontal_layout.html.twig' %}

{% block javascript %}
<script nonce="{{ csp_nonce }}">
$(function() {
    $('#back').on('click', function(e) {
        e.preventDefault();
        $('#mode').val('back');
        $('#customer-mail-form').submit();
        return false;
    });

    $('#complete').on('click', function(e) {
        e.preventDefault();
        $('#mode').val('complete');
        $('#customer-mail-form').submit();
    });
});
</script>
{% endblock javascript %}

{% block main %}
<div class="c-contentsArea__cols">
    <div class="c-contentsArea__primaryCol">
        <div class="c-primaryCol">
            <form id="customer-mail-form" class="form-horizontal" method="POST" action="{{ url('admin_customer_manual_mail', { 'id': Customer.id, 'template_id': MailTemplate ? MailTemplate.id : null}) }}">
                {{ form_widget(form._token) }}
                <input id="mode" type="hidden" name="mode">
                <div class="row">
                    <div class="card rounded border-0 mb-4 col-12">
