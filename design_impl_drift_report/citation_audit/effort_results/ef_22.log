namespace Eccube\Service\EntityManager;

use Doctrine\ORM\EntityManagerInterface;
use Eccube\Entity\BaseInfo;
use Eccube\Entity\Customer;
use Eccube\Entity\DtbBuyOrder;
use Eccube\Entity\MailHistory;
use Eccube\Entity\MailTemplate;
use Eccube\Entity\Order;
use Symfony\Component\Mime\Email;

class MailHistoryEntityManager
{
    public function __construct(private readonly EntityManagerInterface $entityManager)
    {
    }

    public function save(
        Email $Message,
        BaseInfo $BaseInfo,
        Customer|Order|DtbBuyOrder|null $ContextInfo = null,
        ?MailTemplate $MailTemplate = null,
    ): void {
        $MailHistory = new MailHistory();
        $MailHistory
            ->setMailSubject($Message->getSubject())
            ->setBaseInfo($BaseInfo)
            ->setMailBody($Message->getTextBody())
            ->setSendDate(new \DateTime());

        $htmlBody = $Message->getHtmlBody();
        if (!empty($htmlBody)) {
            $MailHistory->setMailHtmlBody($htmlBody);
        }

        if ($MailTemplate !== null) {
            $MailHistory->setMailTemplate($MailTemplate);
        }

        if ($ContextInfo instanceof Customer) {
            $MailHistory->setCustomer($ContextInfo);
        } elseif ($ContextInfo instanceof Order) {
            $MailHistory
                ->setOrder($ContextInfo)
                ->setCustomer($ContextInfo->getCustomer());
        } elseif ($ContextInfo instanceof DtbBuyOrder) {
            $MailHistory
                ->setBuyOrder($ContextInfo)
                ->setCustomer($ContextInfo->getCustomer());
        }

        $this->entityManager->persist($MailHistory);
    }
}

