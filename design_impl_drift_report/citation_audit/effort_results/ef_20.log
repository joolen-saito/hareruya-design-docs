    public function getQueryBuilderBySearchData(array $searchData): QueryBuilder
    {
        $qb = $this->createQueryBuilder('otcs')
            ->leftJoin('otcs.Section', 's')
            ->select([
                's.name AS sectionName',
                's.code AS sectionCode',
                'otcs.summaryDate',
                'SUM(otcs.sellPrice) AS sellPriceTotal',
                'SUM(otcs.buyPrice) AS buyPriceTotal',
            ])
            ->where('otcs.summaryDate >= :summaryDateFrom')
            ->andWhere('otcs.summaryDate <= :summaryDateTo')
            ->setParameter('summaryDateFrom', $searchData['summary_date_from']->format('Y-m-d 00:00:00'))
            ->setParameter('summaryDateTo', $searchData['summary_date_to']->format('Y-m-d 23:59:59'))
            ->groupBy('otcs.summaryDate')
            ->addGroupBy('s.id')
            ->orderBy('otcs.summaryDate', 'ASC')
            ->addOrderBy('s.code', 'ASC')
        ;

        $shop = isset($searchData['shop'])
            ? (is_array($searchData['shop']) ? $searchData['shop'] : $searchData['shop']->toArray())
            : [];
        if (!empty($shop)) {
            $qb->andWhere('otcs.BaseInfo IN (:shop)')
                ->setParameter('shop', $shop);
        }

        $section = isset($searchData['section'])
            ? (is_array($searchData['section']) ? $searchData['section'] : $searchData['section']->toArray())
            : [];
        if (!empty($section)) {
            $qb->andWhere('s.id IN (:section)')
                ->setParameter('section', $section);
        }

        return $qb;
    }

