            $qb->andWhere('obos.id = :otcBuyOrderStatus')->setParameter(
                'otcBuyOrderStatus',
                $searchData->otcBuyOrderStatus->getId(),
            );
        } else {
            // キャンセル以外
            $qb->andWhere('obos.id != :otcBuyOrderStatusCancel')->setParameter(
                'otcBuyOrderStatusCancel',
                self::CANCEL_STATUS_ID,
            );
        }

        // 金額（From/To入れ替え処理）
        $priceFrom = $searchData->priceFrom ?? null;
        $priceTo = $searchData->priceTo ?? null;
        if ($priceFrom !== null && $priceTo !== null && $priceFrom > $priceTo) {
            [$priceFrom, $priceTo] = [$priceTo, $priceFrom];
        }
        if ($priceFrom !== null) {
            $qb->andWhere('obo.totalPrice >= :priceFrom')->setParameter(
                'priceFrom',
                $priceFrom,
            );
        }
        if ($priceTo !== null) {
            $qb->andWhere('obo.totalPrice <= :priceTo')->setParameter(
                'priceTo',
                $priceTo,
            );
        }

        // 申込日（From）
        if (!empty($searchData->applicationDateFrom)) {
            $qb->andWhere(
                'obo.applyDate >= :applicationDateFrom',
            )->setParameter(
                'applicationDateFrom',
                $searchData->applicationDateFrom,
            );
        }

        // 申込日（To）
        if (!empty($searchData->applicationDateTo)) {
            $qb->andWhere('obo.applyDate <= :applicationDateTo')->setParameter(
                'applicationDateTo',
                $searchData->applicationDateTo,
            );
        }

        // 完了日（From）
        if (!empty($searchData->completeDateFrom)) {
            $qb->andWhere(
                '(obos.id = :cancelStatusId AND obo.cancelDate >= :cancelDateFrom) OR
                        (obos.id != :cancelStatusId AND obo.completeDate >= :completeDateFrom)',
            )
                ->setParameter('cancelStatusId', self::CANCEL_STATUS_ID)
                ->setParameter('cancelDateFrom', $searchData->completeDateFrom)
                ->setParameter(
                    'completeDateFrom',
                    $searchData->completeDateFrom,
                );
        }

        // 完了日（To）
        if (!empty($searchData->completeDateTo)) {
            $qb->andWhere(
                '(obos.id = :cancelStatusId AND obo.cancelDate <= :cancelDateTo) OR
                        (obos.id != :cancelStatusId AND obo.completeDate <= :completeDateTo)',
            )
                ->setParameter('cancelStatusId', self::CANCEL_STATUS_ID)
                ->setParameter('cancelDateTo', $searchData->completeDateTo)
                ->setParameter('completeDateTo', $searchData->completeDateTo);
        }

