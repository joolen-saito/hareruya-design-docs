        $Member = $this->getUser();
        if (!$Member instanceof Member) {
            throw new AuthenticationException();
        }
        $OtcBuyOrderBaseInfo = $OtcBuyOrder->getBaseInfo();

        if (!$Member->isEditableShop($OtcBuyOrderBaseInfo)) {
            throw new \InvalidArgumentException('編集可能な店舗と買取情報の買取店舗が一致しません。');
