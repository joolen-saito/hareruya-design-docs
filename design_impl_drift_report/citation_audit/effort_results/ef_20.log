    /**
     * 出荷実績登録処理
     * 対応状況が出荷指示かつ出荷日が入力されている受注情報を更新
     *
     * @param array<string, string> $headers
     * @param CsvImportService<int, array<int|string, string>> $data
     *
     * @return array<int, array{order: Order, player: \Eccube\Entity\DtbPlayer|null}>
     */
    public function registerShippingResult(array $headers, int $headerSize, CsvImportService $data): array
    {
        $requiredHeaders = $this->requiredCsvHeader;

        $updatedOrders = [];
        foreach ($data as $row) {
            $rowIndex = $data->key() + 1;

            // ヘッダーサイズチェック
            $this->checkHeaderSize($headerSize, $row, $rowIndex);
            // CSV必須項目入力チェック
            $this->checkRequiredHeaders($requiredHeaders, $row, $rowIndex);

            $orderNumber = sprintf('%08d', $row['注文番号']);
            $order = $this->orderRepository->findOneBy(['order_number' => $orderNumber]);

            if ($order === null) {
                throw new \RuntimeException(sprintf($this->translator->trans('admin.csv.error.data.not_registered'), '注文番号', $row['注文番号'], $rowIndex));
            }
            if (empty($row['出荷日'])) {
                continue;
            }
            // 非会員の場合エラーを出力
            if ($order->getCustomer() === null) {
                throw new \RuntimeException($this->translator->trans('admin.csv.error.customer.not_member', ['%row%' => $rowIndex]));
            }
            try {
                $shippingDate = new \DateTime($row['出荷日']);
            } catch (\Exception $e) {
                $message = $this->translator->trans('admin.csv.error.exception.datetime', ['%row%' => $rowIndex, '%column%' => '出荷日']);
                throw new \RuntimeException($message, $rowIndex, $e);
            }
            $invoiceNumber = $row['送り状No.'];
            $newStatus = $this->orderStatusRepository->find(OrderStatus::DELIVERED);
            $isPreDeliv = $order->getOrderStatus()?->getId() === OrderStatus::PRE_DELIV;
            if ($isPreDeliv && $order->getShippingDate() === null) {
                $order->setOrderStatus($newStatus);
                $order
                    ->setShippingDate($shippingDate)
                    ->setInvoiceNumber($invoiceNumber);
                $updatedOrders[] = [
                    'order' => $order,
                    'player' => $this->playerRepository->findOneByCustomer($order->getCustomer()),
                ];
            }
            foreach ($order->getShippings() as $shipping) {
                $shipping->setShippingDate($shippingDate);
            }
        }

        $this->entityManager->flush();

        return $updatedOrders;
    }

