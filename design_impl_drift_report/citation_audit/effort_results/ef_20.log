     * 既に出荷日が入っている受注は更新対象外のため、メールを送らないこと
     */
    public function testShippingResultImportDoesNotSendMailWhenAlreadyShipped(): void
    {
        $Customer = $this->generator->createCustomer();
        /** @var Order $Order */
        $Order = $this->generator->createOrder(Customer: $Customer, statusTypeId: OrderStatus::DELIVERED);
        $orderNumber = sprintf('%08d', $Order->getId());
        $Order->setOrderNumber($orderNumber);
        $Order->setShippingDate(new \DateTime('2026-01-01'));
        $this->entityManager->flush();

        $this->submitShippingResultCsv($orderNumber, 'TRACK-TEST-002');

        $this->assertTrue($this->client->getResponse()->isRedirect());
        $this->assertEmailCount(0);
    }

    private function submitShippingResultCsv(string $orderNumber, string $invoiceNumber): void
    {
        $csvContent = "注文番号,出荷日,送り状No.\n";
        $csvContent .= $orderNumber.',2026-07-28,'.$invoiceNumber."\n";

        $tmpFile = tempnam(sys_get_temp_dir(), 'shipping_result_csv_');
        if ($tmpFile === false) {
            self::fail('Failed to create temp file');
        }
        file_put_contents($tmpFile, $csvContent);
        $uploadPath = $tmpFile.'.csv';
        rename($tmpFile, $uploadPath);

        $crawler = $this->client->request(
            Request::METHOD_GET,
            $this->generateUrl('admin_shipping_result_csv_import')
        );
        $this->assertSame(Response::HTTP_OK, $this->client->getResponse()->getStatusCode());

        $form = $crawler->filter('form#upload-form')->form();
        $form['admin_csv_import[import_file]']->upload($uploadPath);
        $this->client->submit($form);

        @unlink($uploadPath);
    }
