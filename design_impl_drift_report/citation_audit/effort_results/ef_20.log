namespace Eccube\Service\Csv\Exporter;

use Eccube\Entity\DtbBuyMainCard;
use Eccube\Repository\DtbBuyOrderRepository;
use Eccube\Service\CsvExportService;
use Symfony\Component\HttpFoundation\StreamedResponse;

class BuyOrderProductListCsvExportService
{
    /**
     * 買取商品一覧CSVヘッダー定義
     *
     * @var array<string, string>
     */
    public const CSV_HEADER = [
        'product_code' => '商品コード',
        'product_count' => '在庫増減数',
        'product_name' => '商品名',
        'standard_price' => '基準価格',
        'buy_price' => '買取価格',
        'language_id' => '言語ID',
        'storage_code' => '略称タグ',
        'rarity_code' => 'レアリティ',
        'condition_code' => '状態',
    ];

    public function __construct(
        protected CsvExportService $csvExportService,
        protected DtbBuyOrderRepository $buyOrderRepository,
    ) {
    }

    /**
     * 買取商品一覧CSVを出力する
     * （通常は在庫増減数、キャンセル時はキャンセル数として同一サービスで出力）
     *
     * @param array<int, int> $buyOrderIds 買取注文IDの配列
     * @param bool $isSale true のとき売却数、false のときキャンセル数
     */
    public function exportByIds(array $buyOrderIds, bool $isSale): StreamedResponse
    {
        $BuyOrders = $this->buyOrderRepository->findBy(
            ['id' => $buyOrderIds],
            ['id' => 'ASC'],
        );

        if ($BuyOrders === []) {
            throw new \RuntimeException('admin.purchase.online.csv_export.not_registered_buy_order_id');
        }

        $saleFlg = $isSale ? DtbBuyMainCard::SALE : DtbBuyMainCard::NOT_SALE;
        $rows = $this->buyOrderRepository->getProductListDataForExportCsv($buyOrderIds, $saleFlg);

        $header = self::CSV_HEADER;
        if (!$isSale) {
            $header = array_merge($header, ['product_count' => 'キャンセル数']);
        }
        $headerKeys = array_keys($header);

        $response = new StreamedResponse();
        $response->setCallback(function () use ($header, $headerKeys, $rows): void {
            $this->csvExportService->fopen();
            $this->csvExportService->fputcsv(array_values($header));

            foreach ($rows as $row) {
                $orderedRow = array_map(
                    fn ($key) => $row[$key] ?? '',
                    $headerKeys,
                );
                $this->csvExportService->fputcsv($orderedRow);
            }

            $this->csvExportService->fclose();
        });


