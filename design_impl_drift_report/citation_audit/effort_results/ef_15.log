class StockMoveTransferEntityManager
{
    public function __construct(
        private readonly EntityManagerInterface $entityManager,
    ) {
    }

    public function save(
        ?DtbStockMoveTransfer $StockMoveTransfer,
        MtbStockMoveTransferStatus $MoveTransferStatus,
        BaseInfo $MoveFromBaseInfo,
        BaseInfo $MoveToBaseInfo,
        ?int $moveFromStockLocationId,
        ?int $moveToStockLocationId,
        ?string $memo,
        Member $RegisteredMember,
        Member $UpdatedMember,
        ?string $rejectedMemo = null,
        ?Member $MoveFromApprovalMember = null,
        ?\DateTime $MoveFromApprovalAt = null,
        ?Member $MoveToApprovalMember = null,
        ?\DateTime $MoveToApprovalAt = null,
        ?int $moveInstructionId = null,
        int $moveTransferType = DtbStockMoveTransfer::MOVE_TRANSFER_TYPE_MOVE,
    ): DtbStockMoveTransfer {
        if ($StockMoveTransfer === null) {
            $StockMoveTransfer = new DtbStockMoveTransfer();
        }
        $StockMoveTransfer->setMoveTransferType($moveTransferType);
        $StockMoveTransfer->setMoveTransferStatus($MoveTransferStatus);
        $StockMoveTransfer->setMoveFromBaseInfo($MoveFromBaseInfo);
        $StockMoveTransfer->setMoveFromStockLocationId($moveFromStockLocationId);
        $StockMoveTransfer->setMoveToBaseInfo($MoveToBaseInfo);
        $StockMoveTransfer->setMoveToStockLocationId($moveToStockLocationId);
        $StockMoveTransfer->setMemo($memo);
        $StockMoveTransfer->setRegisteredMember($RegisteredMember);
        $StockMoveTransfer->setUpdatedMember($UpdatedMember);
        $StockMoveTransfer->setMoveFromApprovalMember($MoveFromApprovalMember);
        $StockMoveTransfer->setMoveFromApprovalAt($MoveFromApprovalAt);
        $StockMoveTransfer->setMoveToApprovalMember($MoveToApprovalMember);
        $StockMoveTransfer->setMoveToApprovalAt($MoveToApprovalAt);
        $StockMoveTransfer->setRejectedMemo($rejectedMemo);
        $StockMoveTransfer->setMoveInstructionId($moveInstructionId);

        $this->entityManager->persist($StockMoveTransfer);

        return $StockMoveTransfer;
    }
}
