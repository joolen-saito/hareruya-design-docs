    /**
     * 振替先の商品規格情報をJSONで返す（振替先セル表示・振替元との差異表示用）
     */
    #[Route(path: '/%eccube_admin_route%/product/stock/transfer/dest-product-class-info', name: 'admin_stock_transfer_dest_product_class_info', methods: ['GET'])]
    public function getDestProductClassInfo(Request $request): JsonResponse
    {
        $productClassId = $request->query->getInt('product_class_id');
        if ($productClassId <= 0) {
            return new JsonResponse([], JsonResponse::HTTP_BAD_REQUEST);
        }

        $ProductClass = $this->productClassRepository->find($productClassId);
        if ($ProductClass === null) {
            return new JsonResponse([], JsonResponse::HTTP_NOT_FOUND);
        }

        $Product = $ProductClass->getProduct();
        $cardCondition = $ProductClass->getCardCondition();

        $data = [
            'product_name' => $Product?->getName() ?? '-',
            'product_code' => $ProductClass->getCode() ?? '-',
            'language' => $ProductClass->getLanguageNameJp(),
            'card_condition' => $cardCondition !== null ? $cardCondition->getCode() : '-',
            'foil' => $Product?->getFoilText() ?? '-',
            'standard_price' => $ProductClass->getStandardPrice() !== null ? '¥'.number_format($ProductClass->getStandardPrice()) : '-',
        ];

        $response = new JsonResponse($data);

        $event = new EventArgs(
            [
                'response' => $response,
                'ProductClass' => $ProductClass,
        return $response;
    }

