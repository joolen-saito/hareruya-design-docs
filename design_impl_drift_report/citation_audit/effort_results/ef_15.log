        $(document).on('change', '.row-check', function() {
            const total = $('.row-check').length;
            const checked = $('.row-check:checked').length;
            $('#checkAll').prop('indeterminate', checked > 0 && checked < total);
            $('#checkAll').prop('checked', checked === total);
            updateActionButtons();
        });


        function isSameShop() {
            const shopIds = $('.row-check:checked').map(function() {
                return $(this).data('shop-id');
            }).get();
            return new Set(shopIds).size <= 1;
        }

        function hasUnauthorizedShop() {
            return $('.row-check:checked').filter(function() {
                return $(this).data('editable') !== true;
            }).length > 0;
        }

        function hasZeroStock() {
            return $('.row-check:checked').filter(function() {
                return parseInt($(this).data('stock'), 10) <= 0;
            }).length > 0;
        }

        function updateActionButtons() {
            const hasChecked = $('.row-check:checked').length > 0;
            // 全ボタン: 1件以上チェックで活性（詳細条件は押下時にアラートで通知）
            $('#bulkEditBtn, #stockMoveBtn, #stockTransferBtn, #stockSplitBtn, #stockJoinBtn').prop('disabled', !hasChecked);
        }

        // 表示件数セレクト: 選択値の URL へ遷移
        $('#page_count_pulldown, #stock_csv_pulldown').on('change', function() {
            const targetUrl = $(this).val();
            if (targetUrl) {
                window.location.href = targetUrl;
            }
        });

        // 在庫一括編集: 権限なし店舗・複数店舗の場合はアラート
        $('#bulkEditBtn').on('click', function() {
            const ids = getCheckedIds();
            if (ids.length === 0) {
                return;
            }
            if (hasUnauthorizedShop()) {
                alert('編集権限を持っていない店舗の在庫が選択されています。\n編集権限のある店舗の在庫のみ選択してください。');
                return;
            }
            if (!isSameShop()) {
                alert('複数の店舗の商品規格が選択されています。\n同一の店舗の在庫のみ選択してください。');
                return;
            }
            const url = $(this).data('url');
            if (!url) {
                return;
            }
            submitBulkApprovalNewPost(url, ids);
        });

        // 在庫移動登録・振替登録: 権限なし店舗・複数店舗・在庫0の場合はアラート
        $('#stockMoveBtn, #stockTransferBtn').on('click', function() {
            const ids = getCheckedIds();
            if (ids.length === 0) {
                return;
            }
            if (hasUnauthorizedShop()) {
                alert('編集権限を持っていない店舗の在庫が選択されています。\n編集権限のある店舗の在庫のみ選択してください。');
                return;
            }
            if (!isSameShop()) {
                alert('複数の店舗の商品規格が選択されています。\n同一の店舗の在庫のみ選択してください。');
                return;
            }
            if (hasZeroStock()) {
                alert('在庫数が0の在庫が選択されています。\n在庫数が1以上の在庫のみ選択してください。');
                return;
            }
            const url = $(this).data('url');
            if (url) {
                submitIdsToUrl(url, ids);
            }
        });

        // 在庫分割登録・結合登録: 選択した1件の ID を含む URL へ GET 遷移
        // ルートは別ブランチで定義済み: /product/stock/{id}/split/new, /product/stock/{id}/join/new
        {% set stockPathBase = path('admin_stock_list') %}
