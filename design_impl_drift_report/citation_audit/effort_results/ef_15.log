namespace Eccube\Service\Csv\Importer\Event;

use Eccube\Common\Constant;
use Eccube\Entity\Master\ProductStatus;
use Eccube\Repository\Master\ProductStatusRepository;
use Eccube\Repository\ProductRepository;
use Eccube\Service\Csv\Importer\Model\BaseCsvColumn;
use Eccube\Service\Csv\Importer\Model\CsvColumnInterface;
use Eccube\Service\Csv\Importer\Validator\ChoiceValidator;
use Eccube\Service\Csv\Importer\Validator\RowValidatorInterface;

class ProductStatusUpdateImportHandler extends BaseCsvImportHandler
{
    private ?CsvColumnInterface $productIdColumn = null;

    private ?CsvColumnInterface $statusColumn = null;

    private ?CsvColumnInterface $isBranchPublishedColumn = null;

    public function __construct(
        private readonly ProductRepository $productRepository,
        private readonly ProductStatusRepository $productStatusRepository,
    ) {
    }

    public function onBeforeImport(): void
    {
        parent::onBeforeImport();

        $this->initializeColumnDefinitions();
    }

    public function onAfterImport(AfterReadEvent $event): void
    {
        parent::onAfterImport($event);

        $this->clearColumnDefinitions();
    }

    /**
     * CSVデータ1行の形式をチェックする。
     */
    public function onValidateRow(ReadCsvRowEvent $event): void
    {
        parent::onValidateRow($event);
        if ($event->isBreakAll() || $event->isSkipRow()) {
            return;
        }

        if (!$this->validateProductExists($event)) {
            $event->breakAll();
        }
    }

    /**
     * CSVデータ1行を取り込む。
     *
     * @return bool 読み込みに成功した場合 true
     */
    public function onReadRow(ReadCsvRowEvent $event): bool
    {
        $row = $event->getRow();
        $productId = (int) $this->productIdColumn->getValue($row);
        $statusValue = (int) $this->statusColumn->getValue($row);
        $isBranchPublishedValue = (int) $this->isBranchPublishedColumn->getValue($row);

        $Product = $this->productRepository->find($productId);
        // 商品がない場合および廃止の場合処理をしない
        if ($Product === null || $Product->getStatus()?->getId() === ProductStatus::DISPLAY_ABOLISHED) {
            return false;
        }

        $ProductStatus = $this->productStatusRepository->find($statusValue);
        $Product->setStatus($ProductStatus);
        $Product->setBranchPublished((bool) $isBranchPublishedValue);

        return true;
    }

    /**
     * 列の定義を取得する。
     *
     * @return array<CsvColumnInterface>
     */
    protected function getColumns(): array
    {
        return [
            $this->productIdColumn,
            $this->statusColumn,
            $this->isBranchPublishedColumn,
        ];
    }

    /**
     * 列を検証するロジックを取得する。
     *
     * @return array<RowValidatorInterface>
     */
    protected function getRowValidators(): array
    {
        return [];
    }

    private function initializeColumnDefinitions(): void
    {
        $this->productIdColumn = (new BaseCsvColumn('商品ID', '商品ID'))->setRequired(true);
        $this->statusColumn = (new BaseCsvColumn('商品公開ステータス', '商品公開ステータス'))
            ->setRequired(true)
            ->addValidator(new ChoiceValidator((string) ProductStatus::DISPLAY_HIDE, (string) ProductStatus::DISPLAY_SHOW));
        $this->isBranchPublishedColumn = (new BaseCsvColumn('支店の商品公開ステータス', '支店の商品公開ステータス'))
            ->setRequired(true)
            ->addValidator(new ChoiceValidator((string) Constant::DISABLED, (string) Constant::ENABLED));
    }

    private function clearColumnDefinitions(): void
    {
        $this->productIdColumn = null;
        $this->statusColumn = null;
        $this->isBranchPublishedColumn = null;
    }

    private function validateProductExists(ReadCsvRowEvent $event): bool
    {
        $row = $event->getRow();
        $productId = (int) $this->productIdColumn->getValue($row);

        if (!$this->productRepository->isProductExists($productId)) {
            $event->getMessageStore()
                ->addProductNotExistsError(
                    $row->getRowNumber(),
                    $this->productIdColumn->getLabel()
                );
            $event->breakAll();

            return false;
        }

        return true;
    }
}
    #[Route(path: '/%eccube_admin_route%/product/category/{id}/edit', name: 'admin_product_category_update', requirements: ['id' => '\d+'], methods: ['POST'])]
    public function update(Request $request, CacheUtil $cacheUtil, #[MapEntity(id: 'id')] Category $Category): Response
    {
        $Parent = $Category->getParent();
        $TargetCategory = $Category;
        $CloneCategory = clone $Category;
        $this->entityManager->detach($CloneCategory);

        $form = $this->createCategoryForm(
            $TargetCategory,
            $Parent,
            $request,
            $this->resolveCategoryFormActionForUpdate($TargetCategory),
        );
        $form->handleRequest($request);

        if (!$form->isSubmitted() || !$form->isValid()) {
            return $this->render(
                '@admin/Product/category.twig',
                $this->buildCategoryIndexViewData($request, $Parent, $TargetCategory, $form, true)
            );
        }

        return $this->completeCategorySave(
            $form,
            $TargetCategory,
            $Parent,
            $request,
            $cacheUtil,
            $CloneCategory,
            EccubeEvents::ADMIN_PRODUCT_CATEGORY_UPDATE_COMPLETE,
        );
    }

