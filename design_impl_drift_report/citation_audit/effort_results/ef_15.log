                historySourceId: $StockTransfer->getId(),
                StockTransferTypeDetail: $this->entityManager->getReference(MtbStockChangeTypeDetail::class, MtbStockChangeTypeDetail::TRANSFER_OUTBOUND),
                approvalStatus: DtbStockApprovalList::APPROVAL_STATUS_UNAPPROVED,
                registeredDate: new \DateTime(),
                RegisteredMember: $input->Member,
                approvedDate: null,
