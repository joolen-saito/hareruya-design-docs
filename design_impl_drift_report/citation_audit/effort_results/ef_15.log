/**
 * 在庫分割結合（一覧・検索画面）
 */
class StockSplitJoinController extends AbstractController
{
    public function __construct(
        private readonly StockSplitJoinIndexAction $indexAction,
        private readonly StockJoinRegisterAction $stockJoinRegisterAction,
        private readonly StockJoinMoveToShortageEntryAction $stockJoinMoveToShortageEntryAction,
        private readonly StockSplitRegisterAction $stockSplitRegisterAction,
        private readonly StockSplitApplyApprovalAction $stockSplitApplyApprovalAction,
        private readonly ProductStockRepository $productStockRepository,
        private readonly BaseInfoRepository $baseInfoRepository,
        private readonly MemberRepository $memberRepository,
        private readonly StockSplitJoinCsvExportService $stockSplitJoinCsvExportService,
        private readonly MailService $mailService,
        private readonly SearchStockSplitJoinType $searchStockSplitJoinType,
    ) {
    }

    /**
     * 在庫分割・結合のステータス照会（別タブ・他画面での更新後に画面を再読込するための軽量 GET）
     */
    #[Route(path: '/%eccube_admin_route%/product/stock/split-join/{id}/status-snapshot', name: 'admin_stock_split_join_status_snapshot', requirements: ['id' => '\d+'], methods: ['GET'])]
    public function statusSnapshot(Request $request, #[MapEntity(id: 'id')] DtbStockSplitJoin $StockSplitJoin): JsonResponse
    {
        $this->entityManager->refresh($StockSplitJoin);

        $response = new JsonResponse([
            'ok' => true,
            'status_id' => $StockSplitJoin->getStockSplitJoinStatus()->getId(),
        ]);

        $event = new EventArgs(
            [
                'response' => $response,
                'StockSplitJoin' => $StockSplitJoin,
            ],
            $request
        );
        $this->eventDispatcher->dispatch($event, EccubeEvents::ADMIN_STOCK_SPLIT_JOIN_STATUS_SNAPSHOT_COMPLETE);

        return $response;
    }

    /**
     * 在庫分割結合一覧（検索・一覧表示）
     *
     * @return array<string, mixed>
     */
    #[Route(path: '/%eccube_admin_route%/product/stock/split-join', name: 'admin_stock_split_join_list', methods: ['GET', 'POST'])]
    #[Template(template: '@admin/Stock/stock_split_join_index.twig')]
    public function index(Request $request): array|RedirectResponse
    {
        $session = $request->getSession();

        if ($request->query->getBoolean('clear')) {
            $session->remove(StockSplitJoinIndexAction::SESSION_KEY_SEARCH);

            return $this->redirectToRoute('admin_stock_split_join_list');
        }

        $builder = $this->formFactory->createBuilder(SearchStockSplitJoinType::class);

        $event = new EventArgs(
            [
                'builder' => $builder,
            ],
            $request
        );
        $this->eventDispatcher->dispatch($event, EccubeEvents::ADMIN_STOCK_SPLIT_JOIN_INDEX_INITIALIZE);

        $searchForm = $builder->getForm();
        $rawFormPayload = [];

        if ($request->isMethod('POST')) {
            $searchForm->handleRequest($request);
            if ($searchForm->isSubmitted() && $searchForm->isValid()) {
                $session->set(StockSplitJoinIndexAction::SESSION_KEY_SEARCH, FormUtil::getViewData($searchForm));
            }
            $rawFormPayload = $request->request->all('admin_search_stock_split_join');
        } elseif ($request->query->getBoolean('resume')) {
            $viewData = $session->get(StockSplitJoinIndexAction::SESSION_KEY_SEARCH, []);
            FormUtil::submitAndGetData($searchForm, $viewData);
        } else {
            $editableBaseInfos = $this->getEditableBaseInfos();
            $BaseInfo = $editableBaseInfos[0] ?? $this->baseInfoRepository->get();
            $splitCsvForm = $this->formFactory->createBuilder(StockSplitCsvUploadType::class, null, [
                'BaseInfo' => $BaseInfo,
                'editableBaseInfos' => $editableBaseInfos,
                'approval_notification_required' => true,
            ])->getForm();
            $joinCsvForm = $this->formFactory->createBuilder(StockJoinCsvUploadType::class, null, [
                'BaseInfo' => $BaseInfo,
                'editableBaseInfos' => $editableBaseInfos,
            ])->getForm();

            return [
                'searchForm' => $searchForm->createView(),
                'StockSplitJoins' => [],
                'stockSplitJoinSearchPerformed' => false,
                'pager' => null,
                'membersByShopJson' => $this->searchStockSplitJoinType->buildMembersByShopJson(),
                'splitCsvModal' => [
                    'form' => $splitCsvForm->createView(),
                ],
                'joinCsvModal' => [
                    'form' => $joinCsvForm->createView(),
                ],
            ];
        }

        $raw = $searchForm->getData();
        $searchData = \is_array($raw) ? $raw : [];
        $StockSplitJoins = $this->indexAction->handle(new StockSplitJoinIndexInput($searchData, $rawFormPayload));

        $editableBaseInfos = $this->getEditableBaseInfos();
        $BaseInfo = $editableBaseInfos[0] ?? $this->baseInfoRepository->get();
        $splitCsvForm = $this->formFactory->createBuilder(StockSplitCsvUploadType::class, null, [
            'BaseInfo' => $BaseInfo,
            'editableBaseInfos' => $editableBaseInfos,
        ])->getForm();
        $joinCsvForm = $this->formFactory->createBuilder(StockJoinCsvUploadType::class, null, [
            'BaseInfo' => $BaseInfo,
            'editableBaseInfos' => $editableBaseInfos,
        ])->getForm();

        return [
            'searchForm' => $searchForm->createView(),
            'StockSplitJoins' => $StockSplitJoins,
            'stockSplitJoinSearchPerformed' => true,
            'pager' => null,
            'membersByShopJson' => $this->searchStockSplitJoinType->buildMembersByShopJson(),
            'splitCsvModal' => [
                'form' => $splitCsvForm->createView(),
            ],
            'joinCsvModal' => [
                'form' => $joinCsvForm->createView(),
            ],
        ];
    }

