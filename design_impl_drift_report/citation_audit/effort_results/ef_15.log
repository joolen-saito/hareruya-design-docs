    {
        $trackingNoValue = $trackingNo !== '' ? $trackingNo : null;
        $Instruction->setTrackingNo($trackingNoValue);
        $Instruction->setUpdateDate(new \DateTime());
        $Instruction->setUpdateMember($UpdateMember);

        $Transfers = $this->stockMoveTransferRepository->findBy(
            ['moveInstructionId' => $Instruction->getId()],
            ['id' => 'ASC']
        );
        $MovingStatus = $trackingNoValue !== null
            ? $this->entityManager->find(MtbStockMoveTransferStatus::class, MtbStockMoveTransferStatus::STATUS_MOVING)
            : null;
        foreach ($Transfers as $Transfer) {
            $Transfer->setTrackingNo($trackingNoValue);
            if ($MovingStatus !== null) {
                $Transfer->setMoveTransferStatus($MovingStatus);
            }
        }

        $this->entityManager->flush();
    }
}
