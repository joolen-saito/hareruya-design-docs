    #[Route(path: '/%eccube_admin_route%/product/stock/stock-bulk-approval/new', name: 'admin_stock_bulk_approval_new', methods: ['GET', 'POST'])]
    #[Template(template: '@admin/Stock/bulkapproval.twig')]
    public function new(Request $request): RedirectResponse|array
    {
        $ids = $this->extractProductStockIds($request);

        $ProductStocks = $this->productStockRepository->findBy(['id' => $ids], ['id' => 'ASC']);

        if ($ProductStocks === []) {
            $this->addError('admin.stock.bulk_approval.no_product_stocks', 'admin');

            return $this->redirectToRoute('admin_stock_bulk_approval_new');
        }

        if (!$this->isSameBaseInfo($ProductStocks)) {
            $this->addError('admin.stock.bulk_approval.mixed_base_info', 'admin');

            return $this->redirectToRoute('admin_stock_list');
        }

        // 取得した在庫をキーに、画面表示用の商品規格・店舗情報・商品情報を取得する
        $ProductClasses = array_map(fn (ProductStock $ps) => $ps->getProductClass(), $ProductStocks);
        $BaseInfos = array_map(fn (ProductStock $ps) => $ps->getBaseInfo(), $ProductStocks);
        $Products = array_map(fn ($pc) => $pc->getProduct(), $ProductClasses);

        $builder = $this->formFactory->createBuilder(StockBulkApprovalType::class, null, [
            'BaseInfo' => $BaseInfos[0],
            'ProductStocks' => $ProductStocks,
        ]);

        $event = new EventArgs(
            [
                'builder' => $builder,
                'ProductStocks' => $ProductStocks,
            ],
            $request
        );
        $this->eventDispatcher->dispatch($event, EccubeEvents::ADMIN_STOCK_BULK_APPROVAL_NEW_INITIALIZE);

        $form = $builder->getForm();
        $form->handleRequest($request);

        $event = new EventArgs(
            [
                'form' => $form,
                'ProductStocks' => $ProductStocks,
            ],
            $request
        );
        $this->eventDispatcher->dispatch($event, EccubeEvents::ADMIN_STOCK_BULK_APPROVAL_NEW_COMPLETE);

        return $this->buildBulkApprovalView($form, $ProductStocks, $ProductClasses, $BaseInfos, $Products);
    }

