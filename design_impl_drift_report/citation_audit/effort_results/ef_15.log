    public const LIST_EXPORT_TYPE_RETURN = 'return';

    public function __construct(ManagerRegistry $registry)
    {
        parent::__construct($registry, DtbStockMoveTransfer::class);
    }

    /**
     * 在庫移動・振替一覧の検索条件でQueryBuilderを返す.
     *
     * @param array<string, mixed> $searchData
     */
    public function getQueryBuilderBySearchData(array $searchData): QueryBuilder
    {
        $qb = $this->createQueryBuilder('s')
            ->select('s')
            ->leftJoin('s.MoveFromBaseInfo', 'fromBase')->addSelect('fromBase')
            ->leftJoin('s.MoveToBaseInfo', 'toBase')->addSelect('toBase')
            ->leftJoin('s.MoveTransferStatus', 'st')->addSelect('st')
            ->leftJoin('s.RegisteredMember', 'reg')->addSelect('reg')
            ->orderBy('s.createDate', 'DESC')
            ->addOrderBy('s.id', 'DESC');

        $stockMoveTransferId = isset($searchData['stock_move_transfer_id']) ? trim((string) $searchData['stock_move_transfer_id']) : '';
        if ($stockMoveTransferId !== '') {
            if (ctype_digit($stockMoveTransferId)) {
                $qb->andWhere('s.id = :smt_id_exact')
                    ->setParameter('smt_id_exact', (int) $stockMoveTransferId);
            } else {
                $qb->andWhere('CONCAT(s.id, \'\') LIKE :smt_id_like')
                    ->setParameter('smt_id_like', '%'.addcslashes($stockMoveTransferId, '%_').'%');
            }
        }

        $moveInstructionId = isset($searchData['move_instruction_id']) ? trim((string) $searchData['move_instruction_id']) : '';
        if ($moveInstructionId !== '') {
            $qb->andWhere('s.moveInstructionId IS NOT NULL AND CONCAT(s.moveInstructionId, \'\') LIKE :move_instr_like')
                ->setParameter('move_instr_like', '%'.addcslashes($moveInstructionId, '%_').'%');
        }

            $StockTransfer = $this->stockMoveTransferEntityManager->save(
