    #[Route(path: '/%eccube_admin_route%/product/stock/move_transfer', name: 'admin_stock_move_transfer', methods: ['GET', 'POST'])]
    #[Route(path: '/%eccube_admin_route%/product/stock/move_transfer/page/{page_no}', name: 'admin_stock_move_transfer_page', requirements: ['page_no' => '\d+'], methods: ['GET'])]
    #[Template(template: '@admin/Stock/MoveTransfer/index.twig')]
    public function index(Request $request, PaginatorInterface $paginator, ?int $page_no = null): array
    {
        $BaseInfos = $this->baseInfoRepository->findAll();
        $builder = $this->formFactory->createBuilder(SearchStockMoveTransferType::class, null, [
            'base_info' => $BaseInfos,
        ]);

        $event = new EventArgs(
            [
                'builder' => $builder,
            ],
            $request
        );
        $this->eventDispatcher->dispatch($event, EccubeEvents::ADMIN_STOCK_MOVE_TRANSFER_INDEX_INITIALIZE);

        $searchForm = $builder->getForm();

        $stockMoveCsvImportForm = $this->createForm(StockMoveCsvImportType::class)->createView();
        $stockTransferCsvImportForm = $this->createForm(StockTransferCsvImportType::class)->createView();

        $pageMaxis = $this->pageMaxRepository->findAll();

        $page_count = $this->session->get(
            self::SESSION_KEY_PAGE_COUNT,
            $this->eccubeConfig->get('eccube_default_page_count')
        );

        $page_count_param = (int) $request->get('page_count');
        if ($page_count_param) {
            foreach ($pageMaxis as $pageMax) {
                if ($page_count_param == $pageMax->getName()) {
                    $page_count = $pageMax->getName();
                    $this->session->set(self::SESSION_KEY_PAGE_COUNT, $page_count);

                    break;
                }
            }
        }

        $pageCount = (int) $page_count;

        if ($request->isMethod('POST')) {
            $searchForm->handleRequest($request);

            if (!$searchForm->isSubmitted() || !$searchForm->isValid()) {
                return [
                    'searchForm' => $searchForm->createView(),
                    'stockMoveCsvImportForm' => $stockMoveCsvImportForm,
                    'stockTransferCsvImportForm' => $stockTransferCsvImportForm,
                    'pagination' => null,
                    'stockMoveTransferAggregates' => [],
                    'has_errors' => true,
                    'pageMaxis' => $pageMaxis,
                    'page_count' => $page_count,
                    'csvMoveTransferRegisterBaseInfos' => $BaseInfos,
                ];
            }

            $this->session->set(self::SESSION_KEY_SEARCH, FormUtil::getViewData($searchForm));
            $this->session->set(self::SESSION_KEY_PAGE_NO, 1);

            $page_no = 1;
            $searchData = $searchForm->getData();
        } else {
            if ($request->query->get('resume')) {
                // resumeパラメータがある場合はセッションからページ番号と検索条件を復元する
                $page_no = (int) $this->session->get(self::SESSION_KEY_PAGE_NO, 1);
                $viewData = $this->session->get(self::SESSION_KEY_SEARCH, []);
                $searchData = FormUtil::submitAndGetData($searchForm, $viewData);
            } elseif ($page_no !== null) {
                // ページ番号がある場合はセッションに保存し、検索条件を復元する
                $this->session->set(self::SESSION_KEY_PAGE_NO, $page_no);
                $viewData = $this->session->get(self::SESSION_KEY_SEARCH, []);

                // 検索条件が空の場合はデフォルト値を設定する
                if ($viewData === []) {
                    $viewData = FormUtil::getViewData($searchForm);
                    $this->session->set(self::SESSION_KEY_SEARCH, $viewData);
                }

                $searchData = FormUtil::submitAndGetData($searchForm, $viewData);
            } else {
                // ページ番号がない場合はデフォルト値を設定し、検索条件を保存する
                $page_no = 1;
                $viewData = FormUtil::getViewData($searchForm);
                $searchData = FormUtil::submitAndGetData($searchForm, $viewData);

                $this->session->set(self::SESSION_KEY_SEARCH, $viewData);
                $this->session->set(self::SESSION_KEY_PAGE_NO, $page_no);
            }
        }

        // 検索条件をもとに在庫移動・振替一覧を取得する
        $qb = $this->stockMoveTransferRepository->getQueryBuilderBySearchData($searchData);

        $event = new EventArgs(
            [
                'qb' => $qb,
                'searchData' => $searchData,
            ],
            $request
        );
        $this->eventDispatcher->dispatch($event, EccubeEvents::ADMIN_STOCK_MOVE_TRANSFER_INDEX_SEARCH);

        $pagination = $paginator->paginate($qb, (int) $page_no, $pageCount);

        $stockMoveTransferIds = [];
        foreach ($pagination as $stockMoveTransfer) {
            if ($stockMoveTransfer instanceof DtbStockMoveTransfer) {
                $stockMoveTransferIds[] = $stockMoveTransfer->getId();
            }
        }

        // 在庫移動・振替IDごとの移動点数・基準価格合計を取得する
        $stockMoveTransferAggregates = $this->stockMoveTransferDetailRepository->getAggregatesByStockMoveTransferIds($stockMoveTransferIds);

        return [
            'searchForm' => $searchForm->createView(),
            'stockMoveCsvImportForm' => $stockMoveCsvImportForm,
            'stockTransferCsvImportForm' => $stockTransferCsvImportForm,
            'pagination' => $pagination,
            'stockMoveTransferAggregates' => $stockMoveTransferAggregates,
            'has_errors' => false,
            'pageMaxis' => $pageMaxis,
            'page_count' => $page_count,
            'csvMoveTransferRegisterBaseInfos' => $BaseInfos,
            'MOVE_TRANSFER_TYPE_MOVE' => DtbStockMoveTransfer::MOVE_TRANSFER_TYPE_MOVE,
            'MOVE_TRANSFER_TYPE_TRANSFER' => DtbStockMoveTransfer::MOVE_TRANSFER_TYPE_TRANSFER,
        ];
    }

