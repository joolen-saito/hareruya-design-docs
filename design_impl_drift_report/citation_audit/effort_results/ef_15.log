                        const destName = (destData.product_name || '-').trim();
                        const destCode = (destData.product_code || '-').trim();
                        const nameDiff = sourceName !== destName;
                        const codeDiff = sourceCode !== destCode;
                        const nameHtml = nameDiff ? '<span class="text-danger">' + escapeHtml(destName) + '</span>' : escapeHtml(destName);
                        const codeHtml = codeDiff ? '<span class="text-danger">' + escapeHtml(destCode) + '</span>' : escapeHtml(destCode);
                        $destCell.html(nameHtml + '<br><small>' + codeHtml + '</small>');
                    } else {
                        const sourceText = $sourceCell.text().replace(/\s+/g, ' ').trim();
                        const destText = (destData[destKey] ?? '-').toString().trim();
                        $destCell.text(destText);
                        $destCell.toggleClass('text-danger', sourceText !== destText);
                    }
