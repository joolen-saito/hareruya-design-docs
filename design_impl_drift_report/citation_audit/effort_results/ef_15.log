     *     redirectUrl: string,
     *     hasError: bool,
     * }
     */
    private function validateReturnListExportRequest(Request $request): array
    {
        $stockMoveTransferIds = array_filter(array_map('intval', $request->request->all('ids')));
        $pageNo = (int) $request->getSession()->get(self::SESSION_KEY_PAGE_NO, 1);
        $redirectUrl = $this->generateUrl('admin_stock_move_transfer_page', ['page_no' => $pageNo]);

        if ($stockMoveTransferIds === []) {
            $this->addError(
                $this->translator->trans('admin.stock.move_transfer.return_list_csv_export.no_selection'),
                'admin',
            );

            return [
                'stockMoveTransferIds' => [],
                'redirectUrl' => $redirectUrl,
                'hasError' => true,
            ];
        }

        /** @var Member $Member */
        $Member = $this->getUser();
        $errors = $this->stockMoveTransferReturnListCsvExportService->validateReturnListExportIds(
            $stockMoveTransferIds,
            $Member,
        );

        if ($errors !== []) {
            foreach ($errors as $error) {
                $this->addError($error, 'admin');
            }

            return [
                'stockMoveTransferIds' => [],
                'redirectUrl' => $redirectUrl,
                'hasError' => true,
            ];
        }

        return [
            'stockMoveTransferIds' => $stockMoveTransferIds,
            'redirectUrl' => $redirectUrl,
            'hasError' => false,
        ];
    }
        $prefix = 'stock_move_transfer_return_list_'.sprintf('%07d', min($stockMoveTransferIds)).'_';
        $filename = $prefix.(new \DateTime())->format('YmdHis').'.csv';
        $response->headers->set('Content-Type', 'application/octet-stream');
        $response->headers->set(
            'Content-Disposition',
            'attachment; filename='.$filename,
        );

        log_info('在庫移動・振替 戻しリストCSV出力完了. ファイル名: '.$filename);

        return $response;
    }

    /**
     * 戻しリストCSV用バリデーション
     *
     * @param array<int, int> $stockMoveTransferIds
     *
     * @return list<string>
     */
    public function validateReturnListExportIds(array $stockMoveTransferIds, Member $Member): array
    {
        $uniqueStockMoveTransferIds = array_values(array_unique($stockMoveTransferIds));
        $stockMoveTransfers = $this->stockMoveTransferRepository->getMoveToBaseInfoAndStatusByIds($uniqueStockMoveTransferIds);

        if ($stockMoveTransfers === []) {
            return ['対象のデータが見つかりません。'];
        }

        $errors = [];

        $editableShopIds = $Member
            ->getMemberBaseInfos()
            ->map(fn ($mbi) => $mbi->getBaseInfo()->getId())
            ->toArray();

        $shopIds = [];
        $moveTransferIds = [];

        foreach ($stockMoveTransfers as $stockMoveTransfer) {
            $moveTransferIds[] = $stockMoveTransfer['transferId'];
            $shopId = $stockMoveTransfer['shopId'];

            if ($shopId !== null) {
                $shopIds[] = $shopId;
            }

            if ($shopId === null) {
                $errors[] = sprintf(
                    'ID: %d は入庫先店舗が設定されていません。',
                    $stockMoveTransfer['transferId'],
                );
            } elseif (!in_array($shopId, $editableShopIds, true)) {
                $errors[] = sprintf(
                    'ID: %d は権限のない店舗のデータです。',
                    $stockMoveTransfer['transferId'],
                );
            }

            if (!in_array($stockMoveTransfer['statusId'], self::ALLOWED_STATUS_IDS, true)) {
                $errors[] = sprintf(
                    'ID: %d は対象外のステータスです。',
                    $stockMoveTransfer['transferId'],
                );
            }
        }

        foreach ($uniqueStockMoveTransferIds as $uniqueStockMoveTransferId) {
            if (!in_array($uniqueStockMoveTransferId, $moveTransferIds, true)) {
                $errors[] = sprintf('ID: %d は存在しません。', $uniqueStockMoveTransferId);
            }
        }

        if (count(array_unique($shopIds)) > 1) {
            $errors[] = '複数店舗の在庫移動・振替情報を同時に処理することはできません。';
        }

        return $errors;
    }
}
