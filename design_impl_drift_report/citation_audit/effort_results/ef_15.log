                e.preventDefault();
                e.stopImmediatePropagation();
                const $row = $(this).closest('tr');
                const product_id = $(this).data('product-id');
                const type = $(this).data('order-item-type');
                let product_name = $(this).data('product-name');

                if (typeof product_name === 'string' && product_name.indexOf('\\') >= 0) {
                    try {
                        product_name = JSON.parse('"' + product_name + '"');
                    } catch (err) {}
                }

                if (typeof fnSelectItem !== 'function') {
                    return;
                }

                fnSelectItem($row, product_id, type, product_name, function(product_id, product_name, product_class_id, price, quantity, type) {
                    if (!window.currentTransferDestInput || !window.currentTransferDestInput.length || !product_class_id) {
                        return;
