            );

            $this->entityManager->flush();

            $persistedDetailCount = 0;

            foreach ($input->transferDetails as $detail) {
                $moveFromProductStockId = (int) $detail['move_from_product_stock_id'];
                $destProductCode = trim((string) $detail['dest_product_code']);
                $moveTransferQuantity = (int) $detail['move_transfer_quantity'];

                if ($moveTransferQuantity <= 0 || $destProductCode === '') {
                    continue;
                }

                $FromProductStock = $this->productStockRepository->find($moveFromProductStockId);
                if ($FromProductStock === null) {
                    throw new \Exception('振替元の商品在庫が見つかりません');
                }

                $ProductClass = $this->productClassRepository->findOneBy(['code' => $destProductCode]);
                if ($ProductClass === null) {
                    throw new \Exception(sprintf('振替先の商品コード「%s」が見つかりません', $destProductCode));
                }

                $ToProductStock = $this->productStockRepository->findOneBy([
                    'ProductClass' => $ProductClass,
                    'baseInfo' => $input->BaseInfo,
                    'stockLocationId' => $input->stockLocationId,
                ]);
                if ($ToProductStock === null) {
                    throw new \Exception(sprintf('振替先の商品在庫（商品コード: %s）が見つかりません', $destProductCode));
                }

                $moveQuantity = (string) $moveTransferQuantity;

                $standardPrice = $ProductClass->getStandardPrice();
                $standardTotalPrice = bcmul((string) $standardPrice, $moveQuantity, 0);

                $fromOutboundTotalCost = $FromProductStock->getMovementTotalCost($moveQuantity);

                $this->stockMoveTransferDetailEntityManager->save(
                    StockMoveTransferDetail: null,
                    StockMoveTransfer: $StockTransfer,
                    MoveFromProductStock: $FromProductStock,
                    MoveToProductStock: $ToProductStock,
                    moveTransferQuantity: $moveTransferQuantity,
                    standardTotalPrice: (string) $standardTotalPrice,
                    outboundTotalCost: (string) $fromOutboundTotalCost,
                );

                $afterFromStock = $FromProductStock->getStockQuantityAfterChange(bcmul($moveQuantity, '-1', 0));
                $afterFromTotalCost = $FromProductStock->getTotalCostAfterChange(bcmul($moveQuantity, '-1', 0));

                $this->stockHistoryEntityManager->save(
                    ProductStock: $FromProductStock,
                    StockChangeTypeDetail: $this->stockChangeTypeDetailRepository->find(MtbStockChangeTypeDetail::TRANSFER_OUTBOUND),
                    oldStock: $FromProductStock->getStock(),
                    stock: $afterFromStock,
                    stockChangeQuantity: $moveQuantity,
                    sellPrice: $ProductClass->getPrice02(),
                    unitCostPriceBefore: $FromProductStock->getUnitCost(),
                    unitCostPriceAfter: $FromProductStock->getUnitCostPriceAfterChange($moveQuantity),
                    totalCostPriceBefore: $FromProductStock->getTotalCost(),
                    totalCostPriceAfter: $FromProductStock->getTotalCostAfterChange($moveQuantity),
                    stockChangeReason: '',
                    shortageReason: null,
                    HistorySourceType: $this->stockHistorySourceTypeRepository->find(MtbStockHistorySourceType::STOCK_TRANSFER_EDIT),
                    historySourceId: $StockTransfer->getId(),
                    registeredAt: new \DateTime(),
                    RegisteredMember: $input->Member,
                    operatorMemberName: $input->Member->getName(),
                );

                $this->productStockEntityManager->save(
                    ProductStock: $FromProductStock,
                    ProductClass: $FromProductStock->getProductClass(),
                    BaseInfo: $FromProductStock->getBaseInfo(),
                    stock: $afterFromStock,
                    pickUpFlg: $FromProductStock->getPickUpFlg(),
                    stockLocationId: $FromProductStock->getStockLocationId(),
                    totalCost: $afterFromTotalCost,
                );

                ++$persistedDetailCount;
            }

            if ($persistedDetailCount === 0) {
                throw new \Exception('登録可能な振替明細がありません');
            }

            // 在庫承認一覧用のデータを作成
            $this->stockApprovalListEntityManager->save(
                StockApprovalList: null,
                BaseInfo: $input->BaseInfo,
