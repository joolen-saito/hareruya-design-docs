    /**
     * 店舗ごとのメンバーリスト JSON を生成する（JS でのフィルタリング用）
     *
     * @return string JSON: {shopId: [{id, name}, ...], ...}
     */
    public function buildMembersByShopJson(): string
    {
        /** @var Member[] $members */
        $members = $this->memberRepository->findBy([], ['name' => 'ASC']);

        $groups = [];
        $seenNames = [];

        foreach ($members as $member) {
            $memberId = $member->getId();
            if ($memberId === null) {
                continue;
            }
            $id = (string) $memberId;
            $name = $member->getName() ?? '';
            $shopId = (string) $member->getBaseInfo()->getId();

            $nameKey = $shopId.'|'.$name;
            $displayName = $name;
            if (isset($seenNames[$nameKey])) {
                $displayName = $name.'(ID:'.$id.')';
            } else {
                $seenNames[$nameKey] = true;
            }

            $groups[$shopId][] = ['id' => $id, 'name' => $displayName];
        }

        return json_encode($groups, JSON_THROW_ON_ERROR);
    }

