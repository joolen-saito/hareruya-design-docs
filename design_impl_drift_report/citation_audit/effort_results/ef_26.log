    }

    public function setMember(?Member $member): DtbStockHistory
    {
        $this->Member = $member;

        return $this;
    }

    #[ORM\Column(name: 'stock', type: Types::INTEGER, options: ['unsigned' => true, 'comment' => '在庫数'])]
    private int $stock;

    public function getStock(): int
    {
        return $this->stock;
    }

    public function setStock(int $stock): DtbStockHistory
