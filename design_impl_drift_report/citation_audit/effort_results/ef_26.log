<?php

namespace Plugin\HareruyaEc\Controller\Admin\Analysis;

use DateTime;
use Eccube\Application;
use Eccube\Controller\AbstractController;
use Eccube\Util\FormUtil;
use Symfony\Component\HttpFoundation\Request;
use Symfony\Component\HttpFoundation\StreamedResponse;
use Plugin\HareruyaEc\Form\Type\Admin\Analysis\SalesType;

class SalesController extends AbstractController
{
    const VIEW_KEY = 'admin.sales.search';
    const EXPORT_HEADER = ['平均単価', '数量', '合計', '件数'];

    /**
     * 検索画面初期表示
     *
     * @param $app Application
     * @param $request Request
     * @return \Symfony\Component\HttpFoundation\Response
     */
    public function index(Application $app, Request $request)
    {
        $request->getSession()->remove(self::VIEW_KEY);
        $builder = $app['form.factory']->createBuilder('admin_sales');
        $form = $builder->getForm();
        $dateFrom = new Datetime('first day of this month');
        $dateTo = new Datetime('last day of this month');
        $form->get('date_from')->setData($dateFrom);
        $form->get('date_to')->setData($dateTo);
        $form->get('date_type')->setData('order_date');
        $form->get('summary_type')->setData('product_id');
        $form->get('asc_desc')->setData('asc');

        // 検索画面表示
        $renderArr = [
            'searchForm' => $form->createView(),
            'summary' => null,
        ];

        return $app->render('Analysis/sales.twig', $renderArr);
    }

    /**
     * 検索
     *
     * @param Application $app
     * @param Request $request
     * @return \Symfony\Component\HttpFoundation\Response
     */
    public function search(Application $app, Request $request)
    {
        $builder = $app['form.factory']->createBuilder('admin_sales');
        $form = $builder->getForm();
        $form->handleRequest($request);

        $session = $request->getSession();
        $viewData = FormUtil::getViewData($form);
        $session->set(self::VIEW_KEY, $viewData);

        // 集計
        $result = $app['hareruya_ec.repository.order_detail']->getQueryBuilderBySearchData($form->getData());

        // 検索画面表示
        $renderArr = [
            'searchForm' => $form->createView(),
            'summary' => $result['result'],
            'total' => $result['total'],
            'summary_type' => SalesType::SUMMARY_TYPE,
        ];

        return $app->render('Analysis/sales.twig', $renderArr);
    }

    /**
     * Export
     *
     * @param Application $app
     * @param Request $request
     * @return \Symfony\Component\HttpFoundation\Response
     */
    public function export(Application $app, Request $request)
    {
        $response = new StreamedResponse();
        $response->setCallback(function () use ($app, $request) {
            $session = $request->getSession();
            $viewData = $session->get(self::VIEW_KEY, []);
            $searchForm = $app['form.factory']->create('admin_sales', null, ['csrf_protection' => true]);
            $searchData = FormUtil::submitAndGetData($searchForm, $viewData);
            $summryType = $searchData['summary_type'];
            $isProduct = $searchData['summary_type'] === 'product_id';
            $headers = self::EXPORT_HEADER;

            // 集計
            $result = $app['hareruya_ec.repository.order_detail']->getQueryBuilderBySearchData($searchData, true);

            $csvService = $app['eccube.service.csv.export'];
            $csvService->fopen();
            $csvService->putBOM();

            // ヘッダ行出力
            if ($isProduct) {
                $header = array_merge(['商品','商品名'], $headers);
            } else {
                $header = array_merge([SalesType::SUMMARY_TYPE[$summryType]], $headers);
            }
            $csvService->fputcsv($header);

            // データ出力
            foreach ($result['result'] as $data) {
                $row = [];
                if ($isProduct) {
                    $row[] = $data['code'];
                }
                $row[] = $data['name'];
                $row[] = $data['sales'] != 0 ? floor($data['total'] / $data['sales']) : 0;
                $row[] = $data['sales'];
                $row[] = $data['total'];
                $row[] = $data['order_count'];

                $csvService->fputcsv($row);
            }
            $csvService->fclose();
        });

        $now = new \DateTime();
        $filename = 'sales_report_' . $now->format('YmdHis') . '.csv';
        $response->headers->set('Content-Type', 'application/octet-stream');
        $response->headers->set('Content-Disposition', 'attachment; filename=' . $filename);
        $response->send();

        return $response;
    }
}
