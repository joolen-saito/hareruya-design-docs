        // category
        $category = $searchData['product']['category_id'];
        if (!empty($category)) {
            $categories = $category->getSelfAndDescendants();
            $qb->join('p.ProductCategories', 'pct', Join::WITH, $qb->expr()->in('pct.Category', ':categories'))
                ->setParameter('categories', $categories);
        }

        $pref = $searchData['customer']['pref'];
        // Pref
        if (!empty($pref) && $pref) {
            $qb
                ->andWhere('o.Pref = :pref')
                ->setParameter('pref', $pref->getId());
        }

        // sex
        $sex = $searchData['customer']['sex'];
        if (!empty($sex) && count($sex) > 0) {
            $sexs = [];
            foreach ($sex as $value) {
                $sexs[] = $value->getId();
            }
            $qb
                ->andWhere($qb->expr()->in('o.Sex', ':sexs'))
                ->setParameter('sexs', $sexs);
        }

        $birthFrom = $searchData['birth_from'];
        $birthTo = $searchData['birth_to'];
        // 誕生日From
        if (!empty($birthFrom)) {
            $birthFrom = $birthFrom->format('Y-m-d H:i:s');
            $qb->andWhere("o.birth >= :order_birth_from")
                ->setParameter("order_birth_from", $birthFrom);
        }
        // 誕生日To
        if (!empty($birthTo)) {
            $birthTo = $birthTo->modify('+1 days')->format('Y-m-d H:i:s');
            $qb->andWhere("o.birth < :order_birth_to")
                ->setParameter("order_birth_to", $birthTo);
        }

        // 利用端末
        $deviceType = $searchData['device_type'];
        if (!empty($deviceType) && count($deviceType) > 0) {
            $deviceTypeIds = [];
            foreach ($deviceType as $type) {
                $deviceTypeIds[] = $type->getId();
            }
            $qb->leftJoin('o.DeviceType', 'dt')
                ->andWhere('dt.id in (:device_types)')
                ->setParameter('device_types', $deviceTypeIds);
        }

        // tagSalesAnalyses
        if (!empty($searchData['tagSalesAnalyses']) && count($searchData['tagSalesAnalyses']) > 0) {
            $qb->join('Plugin\HareruyaEc\Entity\DtbOrderDetailSub', 'ods', 'WITH', 'od.id = ods.orderDetailId')
                ->join('ods.tagSalesAnalyses', 'tsa', 'with', $qb->expr()->in('tsa.id', ':tagSalesAnalyses'))
                ->setParameter('tagSalesAnalyses', $searchData['tagSalesAnalyses']->toArray());
        }

        // カードセット
        if (!empty($searchData['cardsets']) && count($searchData['cardsets']) > 0) {
            if (!SqlUtil::hasJoin($qb, 'ps')) {
                $qb->join('p.productSub', 'ps', 'with', 'ps.cardDetailId IS NOT NULL');
            }
            if (!SqlUtil::hasJoin($qb, 'cd')) {
                $qb->join('ps.cardDetail', 'cd');
            }
            $qb->andWhere($qb->expr()->in('cd.cardsetId', ':cardsets'))
                ->setParameter('cardsets', $searchData['cardsets']->toArray());
        }

        // 状態
        $cardCondition = $searchData['card_condition'];
        if (!empty($cardCondition) && count($cardCondition) > 0) {
            $conditions = [];
            foreach ($cardCondition as $type) {
                $conditions[] = $type->getId();
            }
            $qb->join('od.ProductClass', 'pc')
                ->join('Plugin\HareruyaEc\Entity\DtbProductSubClass', 'psc', 'with', 'pc.id = psc.productClassId')
                ->andWhere('psc.cardConditionId in (:card_condition)')
                ->setParameter('card_condition', $conditions);
        }

        // 平均単価
        $priceFrom = $searchData['price_from'];
        $priceTo = $searchData['price_to'];
        if (isset($priceFrom) && Str::isNotBlank($priceFrom) && is_numeric($priceFrom)) {
            $qb->andHaving('price >= :price_from')
                ->setParameter('price_from', $priceFrom);
        }
        if (isset($priceTo) && Str::isNotBlank($priceTo) && is_numeric($priceTo)) {
            $qb->andHaving('price <= :price_to')
                ->setParameter('price_to', $priceTo);
        }

        // 数量
        $salesFrom = $searchData['sales_from'];
        $salesTo = $searchData['sales_to'];
        if (isset($salesFrom) && Str::isNotBlank($salesFrom) && is_numeric($salesFrom)) {
            $qb->andHaving('sales >= :sales_from')
                ->setParameter('sales_from', $salesFrom);
        }
        if (isset($salesTo) && Str::isNotBlank($salesTo) && is_numeric($salesTo)) {
            $qb->andHaving('sales <= :sales_to')
                ->setParameter('sales_to', $salesTo);
        }

        // Order By
        $sort = $searchData['sort'];
        if (!empty($sort) && !empty($summaryType)) {
            if ('summary_type' === $sort) {
                $sort = self::SUMMARY_GROUP_NAMES[$summaryType]['key'];
            }
            $qb->addOrderBy($sort, $searchData['asc_desc']);
        }

        if ($isExport) {
            // CSV出力時は件数制限なし
            $result = $qb->getQuery()->getResult();

            return ['result' => $result];
        }

        // limit
        $qb->setMaxResults($searchData['limit']);
        $result = $qb->getQuery()->getResult();

        // Set total columns
        $total = [
            'sales' => 0,
            'total' => 0,
            'order_count' => 0,
        ];

        foreach ($qb->getQuery()->getResult() as $row) {
            $total['sales'] += $row['sales'];
            $total['total'] += $row['total'];
            $total['order_count'] += $row['order_count'];
        }

        $calcResult = [];
        foreach ($qb->getQuery()->getResult() as $row) {
            $row['sales_rate'] = $total['sales'] !== 0 ? floor($row['sales'] / $total['sales'] * 100) : 0;
            $row['total_rate'] = $total['total'] !== 0 ? floor($row['total'] / $total['total'] * 100) : 0;
            $row['order_rate'] = $total['order_count'] !== 0 ? floor($row['order_count'] / $total['order_count'] * 100) : 0;
            $row['price'] = floor($row['price']);
            $calcResult[] = $row;
        }

        return ['result' => $calcResult, 'total' => $total];
    }

