     * @param list<int> $targetBaseInfoIds 空配列の場合は店舗絞り込みなし（全店舗）
     *
     * @return array<int, array<string, mixed>>
     */
    public function fetchSummaryRowsByDateRangeAndTargets(
        \DateTimeInterface $from,
        \DateTimeInterface $to,
        array $targetBaseInfoIds,
    ): array {
        $qb = $this->createQueryBuilder('s');

        $qb
            ->select(
                's.summaryDate AS summary_date',
                'b.id AS base_info_id',
                'b.short_name_jp AS short_name_jp',
                'b.shop_name AS shop_name',
                's.grossSales AS gross_sales',
                's.totalCost AS total_cost',
                's.grossProfit AS gross_profit',
                's.saleQuantity AS sale_quantity',
                's.saleCount AS sale_count',
                's.saleAverage AS sale_average',
                's.purchaseCount AS purchase_count',
                's.purchaseAmount AS purchase_amount',
                's.wasteCount AS waste_count',
                's.shortageCount AS shortage_count',
            )
            ->innerJoin('s.BaseInfo', 'b')
            ->where('s.summaryDate >= :from')
            ->andWhere('s.summaryDate <= :to')
            ->orderBy('s.summaryDate', 'ASC')
            ->addOrderBy('b.id', 'ASC')
            ->setParameter('from', $from->format('Y-m-d'))
            ->setParameter('to', $to->format('Y-m-d'));

        if ($targetBaseInfoIds !== []) {
            $qb
                ->andWhere($qb->expr()->in('b.id', ':targetIds'))
                ->setParameter('targetIds', $targetBaseInfoIds);
        }

        return $qb->getQuery()->getResult();
    }
}
