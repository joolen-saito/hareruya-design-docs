<?php

namespace Plugin\HareruyaEc\Controller\Admin\Analysis;

use DateTime;
use Eccube\Application;
use Eccube\Controller\AbstractController;
use Eccube\Util\FormUtil;
use Symfony\Component\HttpFoundation\Request;
use Symfony\Component\HttpFoundation\StreamedResponse;

class SummaryController extends AbstractController
{
    const VIEW_KEY = 'admin.summary.search';
    const COLUMNS_DETAIL = [
        'count' => '件数',
        'amount' => '金額',
        'average' => '平均単価',
    ];
    const COLUMN_NAMES = [
        'visitor_count' => ['name' => ['visitor_count' => '来客数', 'buyer_count' => '購買数', 'buyer_rate' => '購買率']],
        'order' => ['name' => '注文', 'detail' => self::COLUMNS_DETAIL],
        'repeat_order_count' => 'リピート注文者数',
        'account' => ['name' => ['account' => '新規会員登録数', 'mail_magazine_account' => 'メールニュース登録数']],
        'confirm' => ['name' => '注文確認', 'detail' => self::COLUMNS_DETAIL],
        'payment' => ['name' => '入金', 'detail' => self::COLUMNS_DETAIL],
        'standby' => ['name' => '出荷指示', 'detail' => self::COLUMNS_DETAIL],
        'shipped' => ['name' => '出荷', 'detail' => self::COLUMNS_DETAIL],
        'cancel' => ['name' => 'キャンセル', 'detail' => self::COLUMNS_DETAIL],
    ];

    /**
     * 検索画面初期表示
     *
     * @param $app Application
     * @param $request Request
     * @return \Symfony\Component\HttpFoundation\Response
     */
    public function index(Application $app, Request $request)
    {
        $request->getSession()->remove(self::VIEW_KEY);

        $builder = $app['form.factory']->createBuilder('admin_summary');
        $form = $builder->getForm();
        $dateFrom = new Datetime('first day of this month');
        $dateTo = new Datetime('last day of this month');
        if (strpos($request->getRequestUri(), 'daily')) {
            $form->get('summary_type')->setData('daily');
        } else {
            $dateFrom->modify('-2 months');
            $form->get('summary_type')->setData('monthly');
        }
        $form->get('summary_date_from')->setData($dateFrom);
        $form->get('summary_date_to')->setData($dateTo);

        // 検索画面表示
        $renderArr = [
            'searchForm' => $form->createView(),
            'summary' => [],
        ];

        return $app->render('Analysis/summary.twig', $renderArr);
    }

    /**
     * 集計結果表示
     * @param Application $app
     * @param Request $request
     * @return Response
     */
    public function result(Application $app, Request $request)
    {
        $builder = $app['form.factory']->createBuilder('admin_summary');
        $form = $builder->getForm();
        $form->handleRequest($request);

        $session = $request->getSession();
        $viewData = FormUtil::getViewData($form);
        $session->set(self::VIEW_KEY, $viewData);

        // 表示項目設定
        $dispColumns = $this->getDispColumns($form->getData());

        // 集計
        $result = $app['hareruya_ec.repository.order']->getOrderSummary($app, $form->getData(), $dispColumns);

        // 検索画面表示
        $renderArr = [
            'searchForm' => $form->createView(),
            'summary' => $result['result'],
            'total' => $result['total'],
            'columns' => $dispColumns,
        ];

        return $app->render('Analysis/summary.twig', $renderArr);
    }

    public function export(Application $app, Request $request)
    {
        $response = new StreamedResponse();
        $response->setCallback(function () use ($app, $request) {

            $session = $request->getSession();
            $viewData = $session->get(self::VIEW_KEY, []);
            $searchForm = $app['form.factory']->create('admin_summary', null, ['csrf_protection' => true]);
            $searchData = FormUtil::submitAndGetData($searchForm, $viewData);
            $headers = $this->getDispColumns($searchData);

            // 集計
            $result = $app['hareruya_ec.repository.order']->getOrderSummary($app, $searchData, $headers);

            $csvService = $app['eccube.service.csv.export'];
            $csvService->fopen();
            $csvService->putBOM();

            $csvService->fputcsv(array_merge(['日付'], $headers));

            // データ出力
            foreach ($result['result'] as $data) {
                $row = [$data['order_date']];
                foreach ($headers as $key => $column) {
                    if ($key === 'buyer_rate') {
                        $row[] = $data[$key] . '%';
                    } else {
                        $row[] = $data[$key];
                    }
                }
                $csvService->fputcsv($row);
            }
            $csvService->fclose();
        });

        $now = new \DateTime();
        $filename = 'report_summary_' . $now->format('YmdHis') . '.csv';
        $response->headers->set('Content-Type', 'application/octet-stream');
        $response->headers->set('Content-Disposition', 'attachment; filename=' . $filename);
        $response->send();

        return $response;
    }

    /**
     * 表示項目取得
     * @param array $form
     * @return array
     */
    private function getDispColumns($form)
    {
        $dispColumns = [];
        foreach (['order', 'product'] as $columnType) {
            $sub = $columnType === 'product' ? '商品別' : '';
            $columns = $form["columns_{$columnType}"];
            foreach ($columns as $column) {
                $columnNames = self::COLUMN_NAMES[$column];
                if (is_array($columnNames) && isset($columnNames['detail'])) {
                    foreach ($columnNames['detail'] as $detailKey => $detailValue) {
                        $dispColumns["{$columnType}_{$detailKey}_{$column}"] = $sub . $columnNames['name'] . $detailValue;
                    }
                } elseif (is_array($columnNames)) {
                    foreach ($columnNames['name'] as $key => $name) {
                        $dispColumns[$key] = $name;
                    }
                } else {
                    $dispColumns[$column] = $columnNames;
                }
            }
        }

        return $dispColumns;
    }
}

    /**
     * 受注の件数を返す
     *
     * @param array $searchData 検索条件
     * @param string|null $cacheKey 件数をキャッシュするときのキー。未指定の場合はキャッシュしない
     * @param int $lifetime キャッシュの生存期間（秒）
     * @return int 件数
     */
    public function getCountBySearchDataForAdmin($searchData, $cacheKey = null, $lifetime = 10)
    {
        $qb = $this->getQueryBuilderBySearchDataForAdmin($searchData);
        $query = $qb->select($qb->expr()->count('o'))
            ->getQuery();

        if (!is_null($cacheKey) && $lifetime > 0) {
            $query->useQueryCache(true)
                ->useResultCache(true, $lifetime, $cacheKey);
        }

        return $query->getSingleScalarResult();
    }

