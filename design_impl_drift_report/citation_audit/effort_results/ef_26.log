    /**
     * 在庫変動理由を編集可能かどうかを判定する.
     *
     * 在庫編集・一括編集由来かつ、在庫変動区分が入庫・廃棄の場合のみ編集可能.
     */
    public function isStockChangeReasonEditable(): bool
    {
        $sourceTypeId = $this->getHistorySourceType()?->getId();
        if (!in_array($sourceTypeId, [
            MtbStockHistorySourceType::STOCK_EDIT,
            MtbStockHistorySourceType::STOCK_BULK_EDIT,
        ], true)) {
            return false;
        }

        return $this->getStockChangeTypeDetail()->isTypeBeStocked()
            || $this->getStockChangeTypeDetail()->isTypeDisposal();
    }

