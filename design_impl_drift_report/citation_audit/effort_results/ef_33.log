    70	
    71	        if (!$request->isMethod('POST')) {
    72	            return $this->renderWithErrors($form, []);
    73	        }
    74	
    75	        $form->handleRequest($request);
    76	
    77	        if (!$form->isSubmitted() || !$form->isValid()) {
    78	            $errors = [];
    79	            foreach ($form->getErrors(true) as $error) {
    80	                $errors[] = $error->getMessage();
    81	            }
