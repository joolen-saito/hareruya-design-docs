    86	        /** @var UploadedFile|null $formFile */
    87	        $formFile = $form->get('import_file')->getData();
    88	        if ($formFile === null) {
    89	            return $this->renderWithErrors($form, [$this->translator->trans('admin.csv.error.upload.require')]);
    90	        }
    91	
    92	        if ($this->countCsvRows($formFile) >= static::ADMIN_CSV_IMPORT_MAX_ROWS) {
    93	            return $this->renderWithErrors($form, [
    94	                $this->translator->trans('admin.csv.error.upload.maxrecord', [
    95	                    '%maxRecord%' => static::ADMIN_CSV_IMPORT_MAX_ROWS,
    96	                ]),
    97	            ]);
    98	        }
    99	
   100	        $extension = strtolower($formFile->getClientOriginalExtension());
   101	        if ($extension !== 'csv') {
   102	            return $this->renderWithErrors($form, [$this->translator->trans('admin.common.csv_upload_error')]);
   103	        }
   104	
   105	        $User = $this->getUser();
   106	        if (!$User instanceof Member) {
   107	            return $this->renderWithErrors($form, [$this->translator->trans('admin.common.system_error')]);
   108	        }
   109	
   110	        log_info('admin.deck.csv.import.start');
   111	
   112	        $handler = new DeckUpdateImportHandler(
