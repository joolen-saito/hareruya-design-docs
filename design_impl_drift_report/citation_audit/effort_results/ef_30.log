    /**
     * 指定したカードセットに州力されたカードを取得用のクエリビルダー
     */
    public function getQueryBuilderByCardset(MtbCardset $Cardset): QueryBuilder
    {
        return $this->createQueryBuilder('card')
            ->join('card.CardDetails', 'cardDetail')
            ->andWhere('cardDetail.Cardset = :Cardset')
            ->setParameter('Cardset', $Cardset)
            ->orderBy('card.id', 'ASC');
    }

    /**
     * 検索条件からQueryBuilderを取得
     *
     * @param array<string, mixed> $searchData 検索条件の配列
     */
    public function getQueryBuilderBySearchData(array $searchData): QueryBuilder
    {
        $qb = $this->createQueryBuilder('c')
            ->select('c');

        // キーワード検索 (multi)
        if (isset($searchData['multi']) && StringUtil::isNotBlank($searchData['multi'])) {
            $multi = $searchData['multi'];
            $qb->andWhere('c.name_jp LIKE :multi OR c.name_en LIKE :multi OR c.text_jp LIKE :multi OR c.text_en LIKE :multi')
                ->setParameter('multi', '%'.$multi.'%');
        }

        // 1. 色 (ManyToMany: Colors)
        if ($this->isNotEmpty($searchData['color'] ?? null)) {
            $qb->innerJoin('c.Colors', 'color')
                ->andWhere('color IN (:colors)')
                ->setParameter('colors', $searchData['color']);
        }

        // 2. マナコスト (CMC) 検索
        if (isset($searchData['cmc']) && StringUtil::isNotBlank((string) $searchData['cmc'])) {
            $qb->andWhere('c.cmc = :cmc')
                ->setParameter('cmc', (float) $searchData['cmc']);
        }

        // 3. カードタイプ (ManyToMany: Cardtypes)
        if ($this->isNotEmpty($searchData['cardtype'] ?? null)) {
            $qb->innerJoin('c.Cardtypes', 'ct')
                ->andWhere('ct IN (:cardtypes)')
                ->setParameter('cardtypes', $searchData['cardtype']);
        }

        // 4. サブタイプ (ManyToMany: Subtypes)
        if ($this->isNotEmpty($searchData['subtype'] ?? null)) {
            $qb->innerJoin('c.Subtypes', 'st')
                ->andWhere('st IN (:subtypes)')
                ->setParameter('subtypes', $searchData['subtype']);
        }

        // 5. 特殊タイプ (ManyToMany: Specialtypes)
        if ($this->isNotEmpty($searchData['specialtype'] ?? null)) {
            $qb->innerJoin('c.Specialtypes', 'spt')
                ->andWhere('spt IN (:specialtypes)')
                ->setParameter('specialtypes', $searchData['specialtype']);
        }

        // 6. カード詳細に関連する項目 (OneToMany: CardDetails)
        if ($this->isNotEmpty($searchData['cardset'] ?? null)
            || $this->isNotEmpty($searchData['rarity'] ?? null)
            || $this->isNotEmpty($searchData['layout'] ?? null)
            || $this->isNotEmpty($searchData['illustrator'] ?? null)
            || $this->isNotEmpty($searchData['promotion'] ?? null)
            || $this->isNotEmpty($searchData['foil'] ?? null)
            || $this->isNotEmpty($searchData['frame'] ?? null)
        ) {
            $qb->innerJoin('c.CardDetails', 'cd');

            if ($this->isNotEmpty($searchData['cardset'] ?? null)) {
                $qb->andWhere('cd.Cardset IN (:cardsets)')
                    ->setParameter('cardsets', $searchData['cardset']);
