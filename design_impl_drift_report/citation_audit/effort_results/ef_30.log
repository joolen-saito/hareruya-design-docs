class SearchCardType extends AbstractType
{
    public function buildForm(FormBuilderInterface $builder, array $options): void
    {
        $builder
            ->add('multi', TextType::class, [
                'label' => false,
                'required' => false,
                'attr' => [
                    'placeholder' => 'admin.card.multi_search_placeholder',
                ],
            ])
            ->add('color', EntityType::class, [
                'class' => MtbColor::class,
                'choice_label' => 'name_jp',
                'label' => 'admin.card.color',
                'label_attr' => ['class' => 'checkbox-inline'],
                'multiple' => true,
                'expanded' => true,
                'required' => false,
            ])
            ->add('color_identity', EntityType::class, [
                'class' => MtbColor::class,
                'choice_label' => 'name_jp',
                'label' => 'admin.card.color_identity',
                'label_attr' => ['class' => 'checkbox-inline'],
                'multiple' => true,
                'expanded' => true,
                'required' => false,
            ])
            ->add('cmc', TextType::class, [
                'label' => 'admin.card.cmc',
                'required' => false,
                'constraints' => [
                    new Assert\Regex([
                        'pattern' => '/^\d+(\.\d+)?$/', // 正の整数または小数を許可する正規表現
                        'message' => 'form_error.numeric_only',
                    ]),
                ],
            ])
            ->add('cardtype', EntityType::class, [
                'class' => MtbCardtype::class,
                'choice_label' => 'name_jp',
                'label' => 'admin.card.cardtype',
                'label_attr' => ['class' => 'checkbox-inline'],
                'multiple' => true,
                'required' => false,
                'attr' => ['class' => 'select2-select'],
            ])
            ->add('subtype', EntityType::class, [
                'class' => MtbSubtype::class,
                'choice_label' => fn (MtbSubtype $s) => $s->getNameEn().' / '.$s->getNameJp(),
                'label' => 'admin.card.subtype',
                'multiple' => true,
                'required' => false,
                'attr' => ['class' => 'select2-select'],
                'query_builder' => fn (EntityRepository $er) => $er->createQueryBuilder('s')->orderBy('s.name_en', 'ASC'),
            ])
            ->add('specialtype', EntityType::class, [
                'class' => MtbSpecialtype::class,
                'choice_label' => 'name_jp',
                'label' => 'admin.card.specialtype',
                'multiple' => true,
                'required' => false,
                'attr' => ['class' => 'select2-select'],
            ])
            ->add('cardset', EntityType::class, [
                'class' => MtbCardset::class,
                'choice_label' => 'name_jp',
                'label' => 'admin.product.cardset',
                'multiple' => true,
                'required' => false,
                'attr' => ['class' => 'select2-select'],
                'query_builder' => fn (EntityRepository $er) => $er->createQueryBuilder('cs')->orderBy('cs.release_date', 'DESC'),
            ])
            ->add('rarity', EntityType::class, [
                'class' => MtbRarity::class,
                'choice_label' => 'name_jp',
                'label' => 'admin.product.rarity',
                'label_attr' => ['class' => 'checkbox-inline'],
                'multiple' => true,
                'expanded' => true,
                'required' => false,
            ])
            ->add('layout', EntityType::class, [
                'class' => MtbCardLayout::class,
                'choice_label' => 'name_jp',
                'label' => 'admin.card.layout',
                'label_attr' => ['class' => 'checkbox-inline'],
                'multiple' => true,
                'expanded' => true,
                'required' => false,
            ])
            ->add('illustrator', EntityType::class, [
                'class' => MtbIllustrator::class,
                'query_builder' => function (EntityRepository $er) {
                    return $er->createQueryBuilder('i')->orderBy('i.name_en', 'ASC');
                },
                'label' => 'admin.card.illustrator',
                'multiple' => true,
                'required' => false,
                'attr' => ['class' => 'select2-select'],
            ])
            ->add('promotion', EntityType::class, [
                'class' => MtbPromotion::class,
                'choice_label' => 'name_jp',
                'label' => 'admin.product.promotion',
                'multiple' => true,
                'required' => false,
                'attr' => ['class' => 'select2-select'],
                'query_builder' => fn (EntityRepository $er) => $er->createQueryBuilder('p')->orderBy('p.name_jp', 'ASC'),
            ])
            ->add('format', EntityType::class, [
                'class' => MtbFormat::class,
                'choice_label' => 'name_jp',
                'label' => 'admin.card.legal_format',
                'multiple' => true,
                'required' => false,
                'attr' => ['class' => 'select2-select'],
                'query_builder' => fn (EntityRepository $er) => $er->createQueryBuilder('f')->orderBy('f.rank', 'ASC')->addOrderBy('f.id', 'ASC'),
            ])
            ->add('restriction', EntityType::class, [
                'class' => MtbRestriction::class,
                'choice_label' => 'name_jp',
                'label' => false,
                'label_attr' => ['class' => 'checkbox-inline'],
                'multiple' => true,
                'expanded' => true,
                'required' => false,
                'query_builder' => function (EntityRepository $er) {
                    return $er->createQueryBuilder('r')
                        ->orderBy('r.id', 'ASC');
                },
            ])
            ->add('foil', ChoiceType::class, [
                'choices' => [
                    'admin.product.foil__non_foil' => MtbCardDetail::NON_FOIL,
                    'admin.product.foil__normal' => MtbCardDetail::FOIL,
                    'admin.product.foil__special' => MtbCardDetail::FOIL_SPECIAL,
                ],
                'label' => 'admin.product.foil',
                'label_attr' => ['class' => 'checkbox-inline'],
                'multiple' => true,
                'expanded' => true,
                'required' => false,
            ])
            ->add('frame', ChoiceType::class, [
                'choices' => [
                    'admin.product.frame__normal' => MtbCardDetail::FRAME_NORMAL,
                    'admin.product.frame__special' => MtbCardDetail::FRAME_SPECIAL,
                ],
                'label' => 'admin.product.frame',
                'label_attr' => ['class' => 'checkbox-inline'],
                'multiple' => true,
                'expanded' => true,
                'required' => false,
            ])

            // ソート用
            ->add('sortKey', HiddenType::class, [
                'attr' => ['class' => 'hidden_sort_key'],
            ])
            ->add('sortOrder', HiddenType::class, [
                'attr' => ['class' => 'hidden_sort_order'],
            ])
        ;
    }

    public function configureOptions(OptionsResolver $resolver): void
    {
        $resolver->setDefaults([
            'csrf_protection' => true,
            'allow_extra_fields' => true,
        ]);
    }

    public function getBlockPrefix(): string
    {
        return 'admin_search_card';
    }
