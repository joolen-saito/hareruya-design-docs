class CardController extends AbstractController
{
    use SearchControllerTrait;

    public function __construct(
        protected PaginatorInterface $paginator,
        protected readonly PageMaxRepository $pageMaxRepository,
        protected readonly CsrfTokenManagerInterface $csrfTokenManager,
        private readonly CardNameListService $cardNameListService,
        private readonly MtbCardRepository $cardRepository,
        private readonly MtbCardDetailRepository $cardDetailRepository,
    ) {
        // SearchControllerTraitが内部で使用するプロパティへの代入
        $this->repository = $this->cardRepository;
        $this->sessionKey = 'card';
        $this->formType = SearchCardType::class;
        $this->formName = 'admin_search_card';
        $this->defaultOrder = 'DESC';
    }

    /**
     * カード一覧・検索画面.
     *
     * @return array<string, mixed>
     */
    #[Route('/%eccube_admin_route%/card', name: 'admin_card_list', methods: ['GET', 'POST'])]
    #[Route('/%eccube_admin_route%/card/search/{page_no}', name: 'admin_card_search', requirements: ['page_no' => '\d+'], methods: ['GET', 'POST'])]
    #[Template('@admin/Card/index.twig')]
    public function index(Request $request, PaginatorInterface $paginator, int $page_no = 1): array
    {
        $searchForm = $this->getForm();

        $event = new EventArgs(
            [
                'form' => $searchForm,
            ],
            $request
        );
        $this->eventDispatcher->dispatch($event, EccubeEvents::ADMIN_CARD_INDEX_INITIALIZE);

        if ($request->isMethod('POST')) {
            $searchForm->handleRequest($request);

            if (!$searchForm->isValid()) {
                return [
                    'searchForm' => $searchForm->createView(),
                    'pagination' => null,
                    'is_search_filter_active' => true,
                ];
            }

            $page_no = 1;
            $viewData = FormUtil::getViewData($searchForm);

            $this->session->set($this->sessionKey, $viewData);
            $this->session->set($this->sessionKey.'.page_no', $page_no);
        } else {
            $pageNoAttr = $request->attributes->get('page_no');
            if ($request->query->getInt('resume') === Constant::ENABLED || $pageNoAttr !== null) {
                if ($pageNoAttr !== null) {
                    $page_no = (int) $pageNoAttr;
                    $this->session->set($this->sessionKey.'.page_no', $page_no);
                } else {
                    $page_no = $this->session->get($this->sessionKey.'.page_no', 1);
                }
                $viewData = $this->session->get($this->sessionKey, []);
                FormUtil::submitAndGetData($searchForm, $viewData);
            } else {
                $viewData = FormUtil::getViewData($searchForm);
                $this->session->set($this->sessionKey, $viewData);
                $this->session->set($this->sessionKey.'.page_no', 1);

                return [
                    'searchForm' => $searchForm->createView(),
                    'pagination' => null,
                    'is_search_filter_active' => false,
                ];
            }
        }

        $responseData = $this->search($request, null, $page_no);

        // 詳細検索項目に値がある場合のみアコーディオンを開く判定を行う
        $searchData = $searchForm->getData();
        $responseData['is_search_filter_active'] = $this->checkSearchFilterActive($searchData);

        $responseData['sortKeys'] = $this->cardRepository->getSortKeys();
        $responseData['sortKey'] = $searchData['sortKey'] ?? $this->cardRepository::DEFAULT_SORT_KEY;
        $responseData['sortOrder'] = $searchData['sortOrder'] ?? $this->cardRepository::DEFAULT_SORT_ORDER;

        return $responseData;
    }

    /**
     * 詳細検索項目が入力されているかチェックする.
     *
     * @param array<string, mixed> $searchData 検索条件
     *
     * @return bool 詳細検索項目に入力がある場合 true
     */
    private function checkSearchFilterActive(array $searchData): bool
    {
        // 判定から除外する項目（これらのみの場合は詳細検索を閉じさせる）
        $excludeKeys = ['multi', 'sortKey', 'sortOrder'];

        foreach ($searchData as $key => $value) {
            if (in_array($key, $excludeKeys, true)) {
                continue;
            }

            if ($value !== null && $value !== '') {
                // 配列（EntityTypeの複数選択など）の場合は中身があるか確認
                if (is_iterable($value)) {
                    foreach ($value as $_) {
                        return true;
                    }
                    continue;
                }

                return true;
            }
        }

        return false;
    }

    /**
     * カード名リスト生成実行 (Ajax専用)
     */
    #[Route('/%eccube_admin_route%/card/generate_list', name: 'admin_card_generate_list', methods: ['POST'])]
    public function generateList(Request $request): JsonResponse
    {
        $tokenValue = $request->request->get('_token');
        $token = new CsrfToken('create_card_name_list', $tokenValue);
        if (!$this->csrfTokenManager->isTokenValid($token)) {
            return new JsonResponse([
                'result' => 'failure',
                'message' => trans('admin.common.csrf_invalid'),
            ]);
        }

        try {
            $result = $this->cardNameListService->create();

            $event = new EventArgs([], $request);
            $this->eventDispatcher->dispatch($event, EccubeEvents::ADMIN_CARD_GENERATE_LIST_COMPLETE);

            return new JsonResponse([
                'result' => ($result[0] === 0) ? 'success' : 'failure',
                'message' => ($result[0] === 0) ? trans('admin.common.save_complete') : $result[1],
            ]);
        } catch (\Exception $e) {
            return new JsonResponse([
                'result' => 'failure',
                'message' => $e->getMessage(),
            ]);
        }
    }

    /**
     * カード新規登録画面.
     *
     * @return array<string, mixed>|RedirectResponse
     */
    #[Route('/%eccube_admin_route%/card/new', name: 'admin_card_new', methods: ['GET', 'POST'])]
    #[Template('@admin/Card/edit.twig')]
    public function new(Request $request): RedirectResponse|array
    {
        return $this->save($request, new MtbCard());
    }

    /**
     * カード編集画面.
     *
     * @return array<string, mixed>|RedirectResponse
     */
    #[Route('/%eccube_admin_route%/card/{id}/edit', name: 'admin_card_edit', requirements: ['id' => '\d+'], methods: ['GET', 'POST'])]
    #[Template('@admin/Card/edit.twig')]
    public function edit(Request $request, MtbCard $card): RedirectResponse|array
    {
        return $this->save($request, $card);
    }

    /**
     * 保存処理（登録・更新共通）
     *
     * @return array<string, mixed>|RedirectResponse
     */
    private function save(Request $request, MtbCard $card): array|RedirectResponse
    {
        $isNew = $card->getId() === null;
        $form = $this->createForm(CardType::class, $card);

        $event = new EventArgs(
            [
                'form' => $form,
                'Card' => $card,
            ],
            $request
        );
        $this->eventDispatcher->dispatch(
            $event,
            $isNew ? EccubeEvents::ADMIN_CARD_NEW_INITIALIZE : EccubeEvents::ADMIN_CARD_EDIT_INITIALIZE
        );

        $form->handleRequest($request);

        // 商品が紐付いている詳細情報は削除不可とするためのIDリスト取得
        $noDeletableCardDetailIds = $card->getId()
            ? $this->cardDetailRepository->getCardDetailIdsHaveProduct($card)
            : [];

        if ($form->isSubmitted() && $form->isValid()) {
            $submittedCardDetailIds = [];
            foreach ($card->getCardDetails() as $cardDetail) {
                if ($cardDetail->getId() !== null) {
                    $submittedCardDetailIds[] = $cardDetail->getId();
                }
            }

            if (array_diff($noDeletableCardDetailIds, $submittedCardDetailIds) !== []) {
                $this->addError('admin.common.delete_error', 'admin');

                return [
                    'form' => $form->createView(),
                    'card' => $card,
                    'noDeletableCardDetailIds' => $noDeletableCardDetailIds,
                ];
            }

