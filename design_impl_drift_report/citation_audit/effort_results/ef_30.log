use Symfony\Component\Routing\Attribute\Route;

/**
 * 管理画面のイベントバナー（画像・表示設定）の一覧表示・保存・アップロード・削除を扱う。
 */
class BannerController extends AbstractController
{
    /**
     * 管理画面イベントバナー用の依存を注入する。
     */
    public function __construct(
        private readonly MtbBannerRepository $bannerRepository,
        private readonly BaseInfoRepository $baseInfoRepository,
        private readonly EventBannerStorageService $eventBannerStorage,
        private readonly EventBannerStoreAction $eventBannerStoreAction,
    ) {
    }

    /**
     * バナー一覧・設定画面を表示する。
     *
     * @return array<string, mixed>
     */
    #[Route(path: '/%eccube_admin_route%/event/banner', name: 'admin_event_banner', methods: ['GET'])]
    #[Route(path: '/%eccube_admin_route%/event/banner/{htmlClass}', name: 'admin_event_banner_narrow', requirements: ['htmlClass' => '[a-zA-Z0-9_-]+'], methods: ['GET'])]
    #[Template(template: '@admin/Event/banner.twig')]
    public function index(Request $request, ?string $htmlClass = null): array
    {
        $page = $this->createFreshBannerPageState($htmlClass);

        $event = new EventArgs(
            [
                'form' => $page['settingForm'],
            ],
            $request
        );
        $this->eventDispatcher->dispatch($event, EccubeEvents::ADMIN_EVENT_BANNER_INDEX_INITIALIZE);

        return $this->buildBannerTwigViewData($page);
    }

    /**
     * イベントバナー設定フォームを POST で受け取り、検証成功時は永続化して一覧へリダイレクトする（Post-Redirect-Get）。
     * 検証失敗時は同一画面を再表示する。
     */
    #[Route(path: '/%eccube_admin_route%/event/banner/settings', name: 'admin_event_banner_settings', methods: ['POST'])]
    #[Route(path: '/%eccube_admin_route%/event/banner/{htmlClass}/settings', name: 'admin_event_banner_settings_narrow', requirements: ['htmlClass' => '[a-zA-Z0-9_-]+'], methods: ['POST'])]
    public function saveSettings(Request $request, ?string $htmlClass = null): Response|RedirectResponse
    {
        $page = $this->createFreshBannerPageState($htmlClass);
        $page['settingForm']->handleRequest($request);

        if ($page['settingForm']->isSubmitted() && $page['settingForm']->isValid()) {
            $this->eventBannerStoreAction->handle($page['settingForm']);

            $event = new EventArgs(
                [
                    'form' => $page['settingForm'],
                ],
                $request
            );
            $this->eventDispatcher->dispatch($event, EccubeEvents::ADMIN_EVENT_BANNER_SAVE_SETTINGS_COMPLETE);

            $this->addSuccess('admin.common.save_complete', 'admin');

            return $this->redirectAfterSave($htmlClass);
        }

        return $this->render('@admin/Event/banner.twig', $this->buildBannerTwigViewData($page));
    }

    /**
     * バナー画像を S3 にアップロードする（フォーム送信）。
     */
    #[Route(path: '/%eccube_admin_route%/event/banner/image/upload', name: 'admin_event_banner_image_upload', methods: ['POST'])]
    #[Route(path: '/%eccube_admin_route%/event/banner/{htmlClass}/image/upload', name: 'admin_event_banner_image_upload_narrow', requirements: ['htmlClass' => '[a-zA-Z0-9_-]+'], methods: ['POST'])]
    public function uploadImage(Request $request, ?string $htmlClass = null): Response|RedirectResponse
    {
        $page = $this->createFreshBannerPageState($htmlClass);
        $page['uploadForm']->handleRequest($request);

        $uploadError = null;
        if ($page['uploadForm']->isSubmitted() && $page['uploadForm']->isValid()) {
            /** @var BaseInfo|null $uploadTargetShop */
            $uploadTargetShop = $page['uploadForm']->get('baseInfos')->getData();
            $uploadTargetShops = $uploadTargetShop !== null ? [$uploadTargetShop] : [];
            $uploadError = $this->eventBannerStorage->processUpload(
                $this->getMember(),
                $page['uploadForm']->get('file')->getData(),
                $uploadTargetShops
            );
            if ($uploadError === null) {
                $event = new EventArgs(
                    [
                        'form' => $page['uploadForm'],
                    ],
                    $request
                );
                $this->eventDispatcher->dispatch($event, EccubeEvents::ADMIN_EVENT_BANNER_UPLOAD_IMAGE_COMPLETE);

                $this->addSuccess('admin.common.upload_complete', 'admin');

                return $this->redirectAfterUploadForSelectedShop($uploadTargetShop, $htmlClass);
            }
        }

        return $this->render('@admin/Event/banner.twig', $this->buildBannerTwigViewData($page, $uploadError));
    }

    /**
     * S3 上のバナー画像を削除する（CSRF 検証後）。
     */
    #[Route(path: '/%eccube_admin_route%/event/banner/delete', name: 'admin_event_banner_delete', methods: ['DELETE'])]
    public function delete(Request $request): RedirectResponse
    {
        $this->isTokenValid();
        $Member = $this->getMember();
        $htmlClass = $this->eventBannerStorage->normalizeNarrowHtmlClassQuery($request->query->get('htmlClass'));

        $narrowBaseInfo = null;
        if ($htmlClass !== null) {
            $narrowBaseInfo = $this->baseInfoRepository->findByHtmlClassName($htmlClass);
            if ($narrowBaseInfo === null) {
                throw new NotFoundHttpException();
            }
            if (!$Member->isEditableShop($narrowBaseInfo)) {
                $this->addError('admin.event.banner.delete_shop_not_permitted', 'admin');

                return $this->redirectAfterBannerDelete($htmlClass);
            }
        }

        $selectFile = $this->eventBannerStorage->normalizeObjectKey($request->query->get('select_file'));
        if ($selectFile === null) {
            return $this->redirectAfterBannerDelete($htmlClass);
        }

        if (!$this->eventBannerStorage->isObjectKeyUnderNarrowShop($narrowBaseInfo, $selectFile)) {
            return $this->redirectAfterBannerDelete($htmlClass);
        }

        if (!$this->eventBannerStorage->canMemberDeleteObject($Member, $selectFile)) {
            $this->addError('admin.event.banner.delete_shop_not_permitted', 'admin');

            return $this->redirectAfterBannerDelete($htmlClass);
        }

        $this->eventBannerStorage->deleteObjectIfExists($selectFile);

        $event = new EventArgs([], $request);
        $this->eventDispatcher->dispatch($event, EccubeEvents::ADMIN_EVENT_BANNER_DELETE_COMPLETE);

        $this->addSuccess('admin.common.delete_complete', 'admin');

        return $this->redirectAfterBannerDelete($htmlClass);
    }

    /**
     * 画面表示用の店舗一覧・選択店舗・アップロードフォームの初期状態を組み立てる。
     *
     * @return array{
     *     bannerSettingSlots: list<?MtbBanner>,
     *     baseInfos: list<BaseInfo>,
     *     selectedBaseInfo: ?BaseInfo,
     *     settingForm: FormInterface,
     *     uploadForm: FormInterface,
     *     htmlClass: ?string
     * }
     */
    private function createFreshBannerPageState(?string $htmlClass): array
    {
        $bannerSettingSlots = array_values($this->bannerRepository->findBy([], ['id' => 'ASC']));
        $baseInfos = $this->getAllBaseInfosOrdered();
        $selectedBaseInfo = $this->resolveSelectedBaseInfo($htmlClass);
        $Member = $this->getMember();
        $uploadChoiceBaseInfos = $this->filterBaseInfosEditableByMember($Member, $baseInfos);
        $initialUploadShop = null;
        if ($selectedBaseInfo !== null && $Member->isEditableShop($selectedBaseInfo)) {
            $initialUploadShop = $selectedBaseInfo;
        }

        return [
            'bannerSettingSlots' => $bannerSettingSlots,
            'baseInfos' => $baseInfos,
            'selectedBaseInfo' => $selectedBaseInfo,
            'settingForm' => $this->createSettingForm($bannerSettingSlots, $baseInfos),
            'uploadForm' => $this->createUploadForm($initialUploadShop, $uploadChoiceBaseInfos),
            'htmlClass' => $htmlClass,
        ];
    }

    /**
     * Twig に渡す連想配列（フォームビュー・S3 一覧等）をまとめる。
