namespace Eccube\Service\Admin\Event;

use Eccube\Entity\BaseInfo;
use Eccube\Entity\Member;
use Eccube\Repository\BaseInfoRepository;
use Eccube\Service\S3AccessService;
use Symfony\Component\HttpFoundation\File\UploadedFile;

class EventBannerStorageService
{
    private const S3_BANNER_PREFIX = 'banner/event/';

    private const MAX_UPLOAD_BYTES = 520000;

    public function __construct(
        private readonly BaseInfoRepository $baseInfoRepository,
        private readonly S3AccessService $s3AccessService,
    ) {
    }

    /**
     * S3 のバナー配下ファイル一覧を取得し、更新日時の新しい順に並べる。
     *
     * @return list<array<string, mixed>>
     */
    public function loadSortedFileList(?string $htmlClass): array
    {
        $s3Prefix = $this->resolveListPrefix($htmlClass);
        try {
            $rawFiles = $this->s3AccessService->getFiles($s3Prefix);
        } catch (\Throwable $e) {
            log_error('イベントバナー: S3一覧取得に失敗しました', ['exception' => $e]);
            $rawFiles = [];
        }

        return $this->sortAndLimitFiles($this->normalizeS3FileRows($rawFiles));
    }

    /**
     * 画像の検証と、指定店舗ごとの S3 アップロードを行う。エラー時は翻訳キー付き配列を返す。
     *
     * @param list<BaseInfo> $targetShops
     *
     * @return array{message: string, params?: array<string, string>}|null
     */
    public function processUpload(Member $Member, ?UploadedFile $file, array $targetShops): ?array
    {
        if ($file === null || !$file->isValid()) {
            return ['message' => 'admin.event.banner.upload_no_file'];
        }

        if ($targetShops === []) {
            return ['message' => 'admin.event.banner.upload_shops_required'];
        }

        foreach ($targetShops as $BaseInfo) {
            if (!$Member->isEditableShop($BaseInfo)) {
                return ['message' => 'admin.event.banner.upload_shop_not_permitted'];
            }
        }

        if ($file->getSize() > self::MAX_UPLOAD_BYTES) {
            return [
                'message' => 'admin.event.banner.upload_size_over',
                'params' => ['%max%' => (string) self::MAX_UPLOAD_BYTES],
            ];
        }

        $path = $file->getPathname();
        $imageType = @exif_imagetype($path);
        if ($imageType === false || $imageType < 1 || $imageType > 3) {
            return ['message' => 'admin.event.banner.upload_not_image'];
        }

        $extension = $file->guessExtension() ?? 'jpg';
        foreach ($targetShops as $BaseInfo) {
            $uploadDirectory = self::S3_BANNER_PREFIX.$BaseInfo->getHtmlClassName().'/';
            $this->s3AccessService->setS3Directory($uploadDirectory);
            $this->s3AccessService->putFile([
                'extension' => $extension,
                'file' => $path,
            ]);
        }

        return null;
    }

    /**
     * 削除リクエストのクエリ htmlClass を検証し、許可された形式ならその文字列を返す。
     */
    public function normalizeNarrowHtmlClassQuery(mixed $htmlClass): ?string
    {
        if (!is_string($htmlClass) || $htmlClass === '') {
            return null;
        }

        if (preg_match('/^[a-zA-Z0-9_-]+$/', $htmlClass) !== 1) {
            return null;
        }

        return $htmlClass;
    }

    /**
     * 削除対象の S3 キー（select_file）を検証し、バナープレフィックス配下なら返す。
     */
    public function normalizeObjectKey(mixed $selectFile): ?string
    {
        if (!is_string($selectFile) || $selectFile === '' || $selectFile === '/') {
            return null;
        }

        if (!str_starts_with($selectFile, self::S3_BANNER_PREFIX)) {
            return null;
        }

        return $selectFile;
    }

    /**
     * 店舗ナロー時、キーが当該店舗のバナー prefix 配下か。
     */
    public function isObjectKeyUnderNarrowShop(?BaseInfo $narrowBaseInfo, string $key): bool
    {
        if ($narrowBaseInfo === null) {
            return true;
        }

        $expectedPrefix = self::S3_BANNER_PREFIX.$narrowBaseInfo->getHtmlClassName().'/';

        return str_starts_with($key, $expectedPrefix);
    }

    /**
     * メンバーが当該バナー S3 キーに紐づく店舗を編集できるか。
     */
    public function canMemberDeleteObject(Member $Member, string $key): bool
    {
        $BaseInfo = $this->resolveBaseInfoFromBannerS3Key($key);

        return $BaseInfo !== null && $Member->isEditableShop($BaseInfo);
    }

    /**
     * キーが存在すれば S3 オブジェクトを削除する。
     */
    public function deleteObjectIfExists(string $key): void
    {
        if ($this->s3AccessService->isFileExist($key)) {
            $this->s3AccessService->deleteFile($key);
        }
    }

    /**
     * 一覧取得用の S3 キープレフィックス（店舗ナロー時は店舗別パス）を返す。
     */
    private function resolveListPrefix(?string $htmlClass): string
    {
        if ($htmlClass === null || $htmlClass === '') {
            return self::S3_BANNER_PREFIX;
        }

        return self::S3_BANNER_PREFIX.$htmlClass.'/';
    }


