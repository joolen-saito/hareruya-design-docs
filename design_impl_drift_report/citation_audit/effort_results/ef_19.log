     *
     * @return RedirectResponse|null 登録完了してリダイレクトするときのみ Response。再表示のときは null
     */
    private function handleSubmittedOrderEdit(
        Request $request,
        RouterInterface $router,
        FormInterface $form,
        FormBuilderInterface $builder,
        Order $TargetOrder,
        Order $OriginOrder,
        ArrayCollection $OriginItems,
        PurchaseContext $purchaseContext,
        ?array $beforeSnapshot,
    ): ?RedirectResponse {
        if (!$form->isSubmitted() || !$form['OrderItems']->isValid()) {
            return null;
        }

        $mode = $request->get('mode');
        if (\in_array($mode, ['status_change', 'clear_date', 'register'], true)
            && !$this->canMutateOrder($OriginOrder)) {
            $this->addError('admin.common.error_invalid_request', 'admin');

            return $this->redirectToRoute('admin_order_edit', ['id' => $TargetOrder->getId()]);
        }

        // 店頭受取かつ入金済みの受注は、設計上一部キャンセル（数量減）不可。全キャンセルのみ可。
        // register / status_change のいずれでも数量減付きの flush を防ぐため、mode 分岐前に検証する.
        if (\in_array($mode, ['status_change', 'register'], true)
            && $this->isForbiddenOtcPaidPartCancel($TargetOrder, $OriginOrder)) {
            $this->addError('admin.order.otc_paid_part_cancel.forbidden', 'admin');

            return null;
        }

        if ($mode === 'status_change') {
            return $this->tryCommitOrderStatusChange($TargetOrder, $OriginOrder, $form, $beforeSnapshot);
        }

        if ($mode === 'clear_date') {
            return $this->tryClearOrderDate($request, $TargetOrder, $beforeSnapshot);
        }

        $event = new EventArgs(
            [
                'builder' => $builder,
                'OriginOrder' => $OriginOrder,
                'TargetOrder' => $TargetOrder,
                'PurchaseContext' => $purchaseContext,
            ],
            $request
        );
        $this->eventDispatcher->dispatch($event, EccubeEvents::ADMIN_ORDER_EDIT_INDEX_PROGRESS);

        $rollbackStockoutChanges = $this->applyStockoutChangesBeforeOrderPurchaseFlowValidate($TargetOrder, $OriginOrder);

        $rollbackTemporaryItems = $this->appendTemporaryFinancialOrderItemsForFlow($TargetOrder);
        try {
            $flowResult = $this->orderPurchaseFlow->validate($TargetOrder, $purchaseContext);
        } finally {
            $rollbackTemporaryItems();
        }

        if ($flowResult->hasWarning()) {
            foreach ($flowResult->getWarning() as $warning) {
                $this->addWarning($warning->getMessage(), 'admin');
            }
        }

        if ($flowResult->hasError()) {
            $rollbackStockoutChanges();
            foreach ($flowResult->getErrors() as $error) {
                $this->addError($error->getMessage(), 'admin');
            }
        }

        if ($mode === 'register') {
            return $this->tryCommitOrderRegister(
                $request,
                $router,
                $form,
                $TargetOrder,
                $OriginOrder,
                $OriginItems,
                $purchaseContext,
                $flowResult,
                $beforeSnapshot,
            );
        }

        return null;
    }

    /**
     * ログインメンバーが受注の所属店舗を編集可能か判定する.
     *
     * 画面側（Twig）の isEditableShop ガードと同等の検証をサーバ側でも行う.
     */
    private function isOrderEditableByLoginMember(Order $Order): bool
    {
        return $this->getMember()->isEditableShop($Order->getBaseInfo());
    }

    /**
     * 受注の更新系操作（register / status_change / clear_date）が許可されるか判定する.
     *
     * 編集可能店舗外、またはスマレジ連携受注（smaregi_transaction_id あり）は更新不可.
     */
    private function canMutateOrder(Order $Order): bool
    {
        if (!$this->isOrderEditableByLoginMember($Order)) {
            return false;
        }

        // スマレジから連携された受注は EC-CUBE 管理画面では更新しない（スマレジ側で編集）
        return !$Order->hasSmaregiTransactionId();
    }

    /**
     * 「登録」ボタン（`mode=register`）押下時の確定処理。PurchaseFlow prepare/commit、ステータス遷移、永続化、リダイレクトまでを行う.
     *
     * @param Request                         $request         リクエスト（`return_link` 等）
