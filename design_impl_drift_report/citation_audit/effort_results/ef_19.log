                    }
                    $isFirstCancellation = $statusChangedToCancel && $TargetOrder->getCancelDate() === null;
                    if ($isFirstCancellation) {
                        $TargetOrder->setCancelDate(new \DateTime());
                    }
                    // ピック中への初回遷移時は注文確定日を登録（status_change 経路と同等）
                    if ($statusChangedToPicking && $TargetOrder->getConfirmDate() === null) {
                        $TargetOrder->setConfirmDate(new \DateTime());
                    }
                    // 店頭予約への初回遷移時は店頭予約日を登録（status_change 経路と同等）
                    if ($statusChangedToOtcRsv && $TargetOrder->getOtcRsvDate() === null) {
                        $TargetOrder->setOtcRsvDate(new \DateTime());
                    }
                    $TargetOrder->setOrderStatus($OldOrderStatus);
                    $this->orderStateMachine->apply($TargetOrder, $NewOrderStatus);
                    if ($isFirstCancellation) {
                        $this->pointService->cancelOrderPoints($TargetOrder);
                    }
                }

                $now = new \DateTime();
                if ($TargetOrder->getId() === null) {
                    $TargetOrder->setCreateDate($now);
                    $TargetOrder->setUpdateDate($now);

                    foreach ($TargetOrder->getShippings() as $Shipping) {
                        if ($Shipping->getId() === null) {
                            $Shipping->setCreateDate($now);
                            $Shipping->setUpdateDate($now);
                        }
                    }
                } else {
                    $TargetOrder->setUpdateDate($now);
                }

