        // 承認日範囲 (approved_date_start / approved_date_end):
        if (!empty($searchData['approved_date_start'])) {
            $qb
                ->andWhere('a.approvedDate >= :approved_date_start')
                ->setParameter('approved_date_start', $searchData['approved_date_start']->format('Y-m-d 00:00:00'));
        }
        if (!empty($searchData['approved_date_end'])) {
            $qb
                ->andWhere('a.approvedDate < :approved_date_end')
                ->setParameter('approved_date_end', $searchData['approved_date_end']->format('Y-m-d 23:59:59'));
        }

        // 在庫編集承認ID (idで受け取り、history_source_idにセット)
    ];

    /**
     * エンティティ一覧を表示用の行配列に変換する。
     *
     * @param iterable<DtbStockApprovalList> $StockApprovalLists
     *
     * @return list<array<string, mixed>>
     */
    public function build(iterable $StockApprovalLists): array
    {
        $rows = [];
        $locationNames = ProductStock::STOCK_LOCATION_ID_TO_NAME;

        foreach ($StockApprovalLists as $ApprovalList) {
            $typeId = $ApprovalList->getHistorySourceTypeId();

            $approvalTargetLabel = $ApprovalList->getApprovalTargetLabel();
            $approvalTargetLink = '#';
            $approvalTargetLinkOpenType = '_self';

            // 在庫移動振替の場合はラベル・リンク先を移動・振替に細分化
            if (in_array($typeId, [MtbStockHistorySourceType::STOCK_MOVE_EDIT, MtbStockHistorySourceType::STOCK_TRANSFER_EDIT], true)) {
                $stockChangeTypeId = $ApprovalList->getStockChangeTypeId();
                if ($stockChangeTypeId === MtbStockChangeType::MOVE) {
                    $approvalTargetLabel = 'admin.stock.approval_list.approval_target_stock_move';
                    $approvalTargetLink = $this->urlGenerator->generate('admin_stock_move', ['id' => $ApprovalList->getHistorySourceId()]);
                } elseif ($stockChangeTypeId === MtbStockChangeType::TRANSFER) {
                    $approvalTargetLabel = 'admin.stock.approval_list.approval_target_stock_transfer';
                    $approvalTargetLink = $this->urlGenerator->generate('admin_stock_transfer', ['id' => $ApprovalList->getHistorySourceId()]);
                }

                $approvalTargetLinkOpenType = '_blank';
            } elseif ($typeId === MtbStockHistorySourceType::STOCK_SPLIT_EDIT) {
                $approvalTargetLink = $this->urlGenerator->generate('admin_stock_split_approval', ['id' => $ApprovalList->getHistorySourceId()]);
                $approvalTargetLinkOpenType = '_blank';
            } elseif ($typeId === MtbStockHistorySourceType::STOCK_JOIN_EDIT) {
                $approvalTargetLink = $this->urlGenerator->generate('admin_stock_join_approval', ['id' => $ApprovalList->getHistorySourceId()]);
                $approvalTargetLinkOpenType = '_blank';
            }

            /** @var ?Member $user */
            $user = $this->context->getCurrentUser();
            $currentMemberId = $user?->getId();

            $isBulkActionable = in_array($typeId, self::BULK_ACTIONABLE_HISTORY_SOURCE_TYPE_IDS, true)
                && $ApprovalList->getApprovalStatus() === DtbStockApprovalList::APPROVAL_STATUS_UNAPPROVED
                && $ApprovalList->getRegisteredMember()->getId() !== $currentMemberId; // 登録者と現在のログインユーザーが違う場合のみ一括操作を可能にする

            $storeName = $ApprovalList->getBaseInfo()->getShopName() ?? '-';

            $registeredMemberName = $ApprovalList->getRegisteredMember()->getName() ?? '-';

            $ApprovalMember = $ApprovalList->getApprovalMember();
            $approvalMemberName = $ApprovalMember !== null ? ($ApprovalMember->getName() ?? null) : null;

            // 編集・一括編集・変更CSV・分割・結合、合計在庫増減数・合計総原価増減数・在庫変動区分を表示
            if ($typeId === MtbStockHistorySourceType::STOCK_EDIT
                || $typeId === MtbStockHistorySourceType::STOCK_BULK_EDIT
                || $typeId === MtbStockHistorySourceType::STOCK_CHANGE_CSV_IMPORT
                || $typeId === MtbStockHistorySourceType::STOCK_SPLIT_EDIT
                || $typeId === MtbStockHistorySourceType::STOCK_JOIN_EDIT) {
                $totalChangeQuantity = $ApprovalList->getInventoryChangeTotalCount();
                $totalCostChange = '¥'.number_format($ApprovalList->getTotalCostPriceBefore());
                $changeTypeDetailName = $ApprovalList->getChangeTypeParentLabel().'/'.$ApprovalList->getChangeTypeChildLabel();
            } else {
                $totalChangeQuantity = '-';
                $totalCostChange = '-';
                $changeTypeDetailName = '-';
            }

            $rows[] = [
                'id' => $ApprovalList->getId(),
                'approval_status_id' => $ApprovalList->getApprovalStatus(),
                'approval_status_label' => $ApprovalList->getApprovalStatusLabel(),
                'approval_target_label' => $approvalTargetLabel,
                'approval_target_link' => $approvalTargetLink,
                'approval_target_link_open_type' => $approvalTargetLinkOpenType,
                'is_bulk_actionable' => $isBulkActionable,
                'store_name' => $storeName,
                'stock_location_id' => $ApprovalList->getStockLocationId(),
