                    $statusChangedToDelivered = $NewOrderStatus->getId() === OrderStatus::DELIVERED;
                    $statusChangedToCancel = $NewOrderStatus->getId() === OrderStatus::CANCEL;
                    $statusChangedToPicking = $NewOrderStatus->getId() === OrderStatus::PICKING;
                    $statusChangedToOtcRsv = $NewOrderStatus->getId() === OrderStatus::OTC_RSV;

                    if ($statusChangedToDelivered) {
                        $TargetOrder->getShippings()->map(function (Shipping $Shipping): void {
                            if (!$Shipping->isShipped()) {
                                $Shipping->setShippingDate(new \DateTime());
                            }
