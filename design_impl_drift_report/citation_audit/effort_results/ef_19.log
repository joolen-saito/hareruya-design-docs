use Symfony\Component\Serializer\SerializerInterface;

/**
 * 受注情報履歴（編集不可の表示専用画面）.
 */
class HistoryController extends AbstractController
{
    public function __construct(
        private readonly OrderRepository $orderRepository,
        private readonly DtbOrderHistoryRepository $orderHistoryRepository,
        private readonly OrderHistorySnapshotHydrator $snapshotHydrator,
        private readonly DeliveryRepository $deliveryRepository,
        private readonly MtbOptionRepository $optionRepository,
        private readonly ProductClassRepository $productClassRepository,
        private readonly SerializerInterface $serializer,
    ) {
    }

    /**
     * @return array<string, mixed>
     */
    #[Route(
        path: '/%eccube_admin_route%/order/{orderId}/history/{historyId}',
        name: 'admin_order_history',
        requirements: ['orderId' => '\d+', 'historyId' => '\d+'],
        methods: ['GET'],
    )]
    #[Template(template: '@admin/Order/edit.twig')]
    public function index(Request $request, int $orderId, int $historyId): array
    {
        $CurrentOrder = $this->orderRepository->find($orderId);
        if (!$CurrentOrder instanceof Order) {
            throw new NotFoundHttpException();
        }

        $History = $this->orderHistoryRepository->findOneByOrderAndId($CurrentOrder, $historyId);
        if (!$History instanceof DtbOrderHistory) {
            throw new NotFoundHttpException();
        }

        $hydrated = $this->snapshotHydrator->hydrate($History->getSnapshot());
        $TargetOrder = $hydrated['Order'];

        $builder = $this->formFactory->createBuilder(OrderType::class, $TargetOrder, [
            'disabled' => true,
        ]);
        $form = $builder->getForm();

        $searchCustomerModalForm = $this->formFactory->createBuilder(SearchCustomerType::class)->getForm();
        $searchProductModalForm = $this->formFactory->createBuilder(SearchProductType::class)->getForm();

        return [
            'form' => $form->createView(),
            'searchCustomerModalForm' => $searchCustomerModalForm->createView(),
            'searchProductModalForm' => $searchProductModalForm->createView(),
            'selectedBaseInfo' => $TargetOrder->getBaseInfo(),
            'Order' => $TargetOrder,
            'id' => $orderId,
            'arrQuantity' => [],
            'arrStockout' => [],
            'arrDifferentPrice' => [],
            'isHistoryView' => true,
            'OrderHistory' => $History,
            'orderHistories' => [],
            'shippingDeliveryTimes' => $this->buildShippingDeliveryTimesJson(),
            'thresholdPrice1' => $this->getThresholdPrice(MtbOption::ORDER_LIST_THRESHOLD_PRICE_1),
            'thresholdPrice2' => $this->getThresholdPrice(MtbOption::ORDER_LIST_THRESHOLD_PRICE_2),
            'waitingNumber' => $hydrated['waitingNumber'],
            'linkedEcOrderNumbers' => $hydrated['linkedEcOrderNumbers'],
            'productNameAndSubInfos' => $this->buildProductNameAndSubInfos($TargetOrder),
        ];
    }

    private function buildShippingDeliveryTimesJson(): string
    {
        $times = [];
        foreach ($this->deliveryRepository->findAll() as $Delivery) {
            foreach ($Delivery->getDeliveryTimes() as $DeliveryTime) {
                $times[$Delivery->getId()][$DeliveryTime->getId()] = $DeliveryTime->getDeliveryTime();
            }
        }

        return $this->serializer->serialize($times, 'json');
    }

    private function getThresholdPrice(string $optionKey): int
    {
        $option = $this->optionRepository->findOneBy(['option_key' => $optionKey]);

        return $option !== null ? (int) $option->getOptionValue() : 0;
    }

    /**
     * @return array<int|string, array<string, mixed>>
     */
    private function buildProductNameAndSubInfos(Order $Order): array
    {
        $productClassIds = [];
        foreach ($Order->getOrderItems() as $OrderItem) {
            if (!$OrderItem->isProduct()) {
                continue;
            }
            $classId = $OrderItem->getProductClass()?->getId();
            if ($classId !== null) {
                $productClassIds[] = $classId;
            }
        }

        $subInfosByProductClass = $productClassIds === []
            ? []
            : $this->productClassRepository->getSubInfosByProductClassIds($productClassIds);

        $productNameAndSubInfos = [];
        foreach ($Order->getOrderItems() as $index => $OrderItem) {
            if (!$OrderItem->isProduct()) {
                continue;
            }
            $key = $OrderItem->getId() ?? $index;
            $productName = $OrderItem->getProductName();
            $classId = $OrderItem->getProductClass()?->getId();
            if ($classId === null || !isset($subInfosByProductClass[$classId])) {
                $productNameAndSubInfos[$key]['productName'] = $productName;
                continue;
            }
            $subInfo = $subInfosByProductClass[$classId];
            $pattern = '/【'.$subInfo['languageCode'].'\/([^】]+)】/u';
            if (preg_match($pattern, $productName, $matches)) {
                $subInfo['conditionLabel'] = $matches[1];
            } else {
                $subInfo['conditionLabel'] = $subInfo['conditionCode'];
            }
            $productNameAndSubInfos[$key]['productName'] = preg_replace($pattern, '', $productName);
            $productNameAndSubInfos[$key]['subInfo'] = $subInfo;
        }

        return $productNameAndSubInfos;
     * @param RouterInterface $router  `return_link` からのリダイレクト先解決に使用
     * @param int             $id      受注 ID
     *
     * @return RedirectResponse|array<string, mixed> 登録成功時は RedirectResponse、表示時は Twig へ渡す連想配列
     *
     * @throws NotFoundHttpException 指定 ID の受注が存在しない場合
     */
    #[Route(path: '/%eccube_admin_route%/order/{id}/edit', name: 'admin_order_edit', requirements: ['id' => '\d+'], methods: ['GET', 'POST'])]
    #[Template(template: '@admin/Order/edit.twig')]
    public function index(Request $request, RouterInterface $router, int $id): RedirectResponse|array
    {
        $TargetOrder = $this->loadTargetOrderForEdit($id);
        // フォーム反映・欠品処理より前に変更前スナップショットを固定する（Shipping 共有のため clone 後では不可）
        $beforeSnapshot = $request->isMethod('POST')
            ? $this->orderHistoryRecorder->capture($TargetOrder)
            : null;
        [$OriginOrder, $OriginItems] = $this->cloneOriginOrderAndItems($TargetOrder);

        $builder = $this->formFactory->createBuilder(OrderType::class, $TargetOrder);
        $this->dispatchOrderEditIndexInitialize($builder, $OriginOrder, $TargetOrder, $request);

        $form = $builder->getForm();
        $lineDisplay = $this->presetOrderItemRowsForDisplay($form);
        $form->handleRequest($request);

        $purchaseContext = new PurchaseContext($OriginOrder, $OriginOrder->getCustomer());
        $this->ensureTaxDisplayTypesOnOrderItems($TargetOrder);

        $redirect = $this->handleSubmittedOrderEdit(
            $request,
            $router,
            $form,
            $builder,
            $TargetOrder,
            $OriginOrder,
            $OriginItems,
            $purchaseContext,
            $beforeSnapshot,
        );
        if ($redirect instanceof RedirectResponse) {
            return $redirect;
        }

        [$searchCustomerModalForm, $searchProductModalForm] = $this->createSearchModalForms($request, $OriginOrder, $TargetOrder);
        $viewContext = $this->buildAdminOrderEditViewContext($TargetOrder);

        return array_merge(
            [
                'form' => $form->createView(),
                'searchCustomerModalForm' => $searchCustomerModalForm->createView(),
                'searchProductModalForm' => $searchProductModalForm->createView(),
                'selectedBaseInfo' => $TargetOrder->getBaseInfo(),
                'Order' => $TargetOrder,
                'id' => $id,
                'arrQuantity' => $lineDisplay['arrQuantity'],
                'arrStockout' => $lineDisplay['arrStockout'],
                'arrDifferentPrice' => $lineDisplay['arrDifferentPrice'],
                'isHistoryView' => false,
                'orderHistories' => $this->orderHistoryRepository->findByOrderDesc($TargetOrder),
            ],
            $viewContext
        );
    }

    /**
