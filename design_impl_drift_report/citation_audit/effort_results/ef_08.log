{% set visibleClasses = Product.ProductClasses|filter(pc => pc.visible) %}
{% set hasSale = visibleClasses|filter(pc => pc.saleFlg)|length > 0 %}
{% set hasStock = ProductClass.getStockFind(BaseInfo) %}
{% set eccubeStock = ProductClass.resolveEccubeProductStockForShop(BaseInfo) %}
{% set stockCount = eccubeStock ? eccubeStock.stock|default(0) : 0 %}
{% set isFavorited = favorites is defined and favorites[Product.id] is defined %}
{% set languageCode = ProductClass.Language.code|default('JP') %}
{% set form = forms is defined ? forms[Product.id]|default(null) : null %}
{% set displayName = app.request.locale == 'en' and Product.nameEn ? Product.nameEn : Product.name %}
{% set _show_customer_favorite = (showFavoriteButton is not defined or showFavoriteButton) and isMainShop and (not app.user or (app.user.isNotOtcGroupPlayer and app.user.isNotOtcShitenGroupPlayer)) %}
<div class="p-hareruya-product-card{{ cardModifier is defined and cardModifier ? ' ' ~ cardModifier : '' }}{{ not hasStock ? ' is-soldout' : '' }}">
  <div class="p-hareruya-product-card__img-section">
    <button class="p-hareruya-product-card__img-wrap" type="button" data-js-target="product-img-zoom" aria-label="{{ 'front.product.zoom_image'|trans }}">
      <img class="p-hareruya-product-card__img" src="{{ image_path(Product.main_list_image|no_image_product) }}" alt="{{ displayName }}" width="128" height="179" decoding="async" loading="lazy">
      <span class="p-hareruya-product-card__img-overlay"><span class="p-hareruya-product-card__img-zoom-text">{{ 'front.product.zoom_image'|trans }}</span></span>
      {% if hasSale %}
      <span class="p-hareruya-product-card__sale-label c-hareruya-label--sale">{{ 'front.top.product_card.sale_label'|trans }}</span>
      {% endif %}
      <span class="p-hareruya-product-card__expand-icon"><i class="icon-hareruya-expand-arrows c-hareruya-icon--xs"></i></span>
    </button>
  </div>
  <div class="p-hareruya-product-card__info">
    <div class="p-hareruya-product-card__details">
      <a class="p-hareruya-product-card__name" href="{{ url('product_detail', { id: Product.id }) }}">
        {% if Product.CardDetail %}
        <span class="p-hareruya-product-card__language-label c-hareruya-label--language">{{ languageCode }}</span>
        {% endif %}
        <span class="p-hareruya-product-card__name-text">
          {% if Product.CardDetail and Product.CardDetail.foil_flg %}{{ 'front.product.foil_prefix'|trans }}{% endif %}
          {{ displayName }}
        </span>
      </a>
      {% if showStock is not defined or showStock %}
      <div class="p-hareruya-product-card__stock-info">
        {% if Product.CardDetail %}
        <p class="p-hareruya-product-card__condition">{{ ProductClass.memo ? ProductClass.memo : ProductClass.CardCondition.code|default('') }}</p>
        {% endif %}
        <p class="p-hareruya-product-card__stock">
          {% if ProductClass.stockUnlimited %}
            {{ 'admin.product.stock_unlimited__short'|trans }}
          {% else %}
            {{ 'front.top.product_card.stock'|trans({ '%count%': stockCount|number_format }) }}
          {% endif %}
        </p>
      </div>
      {% endif %}
      <div class="p-hareruya-product-card__price-wrap">
        <p class="p-hareruya-product-card__price"><span class="p-hareruya-product-card__price-symbol">¥</span>{{ ProductClass.price02|number_format }}</p>
      </div>
      {% if hasStock and form %}
      {% set maxQty = ProductClass.stockUnlimited ? 999 : stockCount %}
      <form class="p-hareruya-product-card__cart-form" action="{{ url('product_add_cart', { id: Product.id }) }}" method="post">
        <div class="p-hareruya-product-card__actions">
          <div class="p-hareruya-product-card__quantity-controls" data-stock="{{ maxQty }}">
            <button class="c-hareruya-btn-quantity" type="button" aria-label="{{ 'front.top.product_card.decrease_qty'|trans }}"><i class="icon-hareruya-minus c-hareruya-icon--xs"></i></button>
            <input class="p-hareruya-product-card__quantity-input" type="text" name="quantity" min="0" max="{{ maxQty }}" value="1" aria-label="{{ 'front.top.product_card.input_qty'|trans }}">
            <button class="c-hareruya-btn-quantity" type="button" aria-label="{{ 'front.top.product_card.increase_qty'|trans }}"><i class="icon-hareruya-plus c-hareruya-icon--xs"></i></button>
          </div>
        </div>
        {{ form_widget(form.ProductClass) }}
        {{ form_widget(form.product_id) }}
        {{ form_widget(form._token) }}
      </form>
      {% else %}
      <div class="p-hareruya-product-card__actions" style="visibility: hidden">
        <div class="p-hareruya-product-card__quantity-controls">
          <button class="c-hareruya-btn-quantity" type="button" disabled="disabled"><i class="icon-hareruya-minus c-hareruya-icon--xs"></i></button>
          <input class="p-hareruya-product-card__quantity-input" type="text" value="0" disabled="disabled">
          <button class="c-hareruya-btn-quantity" type="button" disabled="disabled"><i class="icon-hareruya-plus c-hareruya-icon--xs"></i></button>
        </div>
      </div>
      {% endif %}
      {% if _show_customer_favorite %}
      <div class="p-hareruya-product-card__btn-group">
        <button type="button" class="p-hareruya-product-card__btn-favorite c-hareruya-btn-favorite btn-favorite js-product-list-favorite{{ isFavorited ? ' is-selected' : '' }}" data-product-id="{{ Product.id }}" data-language="{{ languageCode }}" data-js-target="favorite-btn" data-aria-add="{{ 'front.product.favorite_product.add.title'|trans|e('html_attr') }}" data-aria-remove="{{ 'front.product.favorite_product.remove.title'|trans|e('html_attr') }}" aria-pressed="{{ isFavorited ? 'true' : 'false' }}" aria-label="{{ isFavorited ? 'front.product.favorite_product.remove.title'|trans : 'front.product.favorite_product.add.title'|trans }}">
          <i class="icon-hareruya-favorite c-hareruya-icon"></i>
          <img src="{{ asset('assets/hareruya/img/share/icon-hareruya-favorite-full.webp') }}" alt="" width="24" height="24" loading="lazy" decoding="async">
        </button>
        {% if hasStock and form %}
        <button class="p-hareruya-product-card__btn-cart c-hareruya-btn--md c-hareruya-btn--primary u-hareruya-w-full add-cart" type="button" data-product-id="{{ Product.id }}" aria-label="{{ 'front.product.add_cart'|trans }}">
          <i class="icon-hareruya-cart_plus c-hareruya-icon"></i>
        </button>
        {% endif %}
      </div>
      {% endif %}
    </div>
    {% if showWeeklySales is not defined or showWeeklySales %}
    {% set weeklySales = 0 %}
    {% for sq in ProductClass.ShopSalesQuantities %}
      {% if sq.BaseInfo is null or sq.BaseInfo.id == 0 %}
        {% set weeklySales = weeklySales + sq.salesQuantity_04 %}
      {% endif %}
    {% endfor %}
    {% if weeklySales > 0 %}
    <p class="p-hareruya-product-card__sales">{{ 'front.top.product_card.weekly_sales_prefix'|trans }}<span class="p-hareruya-product-card__sales-number">{{ weeklySales|number_format }}</span>{{ 'front.top.product_card.weekly_sales_suffix'|trans }}</p>
    {% endif %}
    {% endif %}
  </div>
</div>
