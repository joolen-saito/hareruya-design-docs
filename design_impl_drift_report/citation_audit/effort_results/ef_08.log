    public function findMostAppositeOneByEmail(string $email): ?Customer
    {
        $qb = $this->createQueryBuilder('c')
            ->addSelect('(CASE WHEN s.id = :active_customer THEN 1 ELSE 0 END) AS HIDDEN active_status')
            ->innerJoin('c.Status', 's')
            ->where('c.email = :email')
            ->andWhere('c.delFlg = :del_flg')
            ->orderBy('c.delFlg', 'ASC')
            ->addOrderBy('active_status', 'DESC')
            ->setParameter('email', $email)
            ->setParameter('active_customer', CustomerStatus::REGULAR)
            ->setParameter('del_flg', 0)
            ->setMaxResults(1);

        return $qb->getQuery()->getOneOrNullResult();
    }

