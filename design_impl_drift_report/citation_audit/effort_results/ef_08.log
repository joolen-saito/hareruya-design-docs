    /**
     * ポイント有効期限通知メール送信
     *
     * @param DtbPlayer $player
     * @param int $point
     * @param \DateTimeInterface $expireDate
     */
    public function sendPointExpireNotificationMail(DtbPlayer $player, int $point, \DateTimeInterface $expireDate): void
    {
        log_info('ポイント有効期限通知メール送信開始');

        $customer = $player->getCustomer();
        $isAbroad = $customer->getPref()?->getId() === Pref::PREF_ABROAD;
        $templateId = $isAbroad ? MailTemplate::POINT_EXPIRE_NOTIFICATION_EN : MailTemplate::POINT_EXPIRE_NOTIFICATION_JP;
        $mailTemplate = $this->mailTemplateRepository->find($templateId);

        $body = $this->twig->render($mailTemplate->getFileName(), [
            'header' => $mailTemplate->getHeader(),
            'footer' => $mailTemplate->getFooter(),
            'point' => $point,
            'expireDate' => $expireDate,
        ]);

        $baseInfo = $this->BaseInfoRepository->getMallBaseInfo();
        $message = (new Email())
            ->subject($mailTemplate->getMailSubject())
            ->from(new Address($baseInfo->getEmail01(), $baseInfo->getShopName()))
            ->to($this->convertRFCViolatingEmail($customer->getEmail()))
            ->replyTo($baseInfo->getEmail03())
            ->returnPath($baseInfo->getEmail04())
            ->text($body);

        try {
            $this->mailer->send($message);
        } catch (TransportExceptionInterface $e) {
            log_critical($e->getMessage());

            return;
        }

        $this->mailHistoryEntityManager->save($message, $baseInfo, $customer, $mailTemplate);
        $this->entityManager->flush();

        }
    }

    /**
     * ポイント差分発生通知メール送信
     *
     * @param array<int, array{customerId: int, pointHistoryTotal: int, point: int, pointVariance: int}> $pointVarianceList
     */
    public function sendAdjustPointVarianceMail(array $pointVarianceList): void
    {
        log_info('ポイント差分発生通知メール送信開始');

        $address = $this->mtbOptionRepository
            ->findOneBy(['option_key' => MtbOption::ADJUST_POINT_VARIANCE_MAIL_ADDRESS])
            ?->getOptionValue() ?? '';

        if (empty($address)) {
            log_info('ポイント差分発生通知メールアドレス未設定のため送信せずに終了');

            return;
        }

        $lines = [];
        foreach ($pointVarianceList as $pointVariance) {
            $lines[] = sprintf(
                '%d, %d, %d, %d',
                $pointVariance['customerId'],
                $pointVariance['pointHistoryTotal'],
                $pointVariance['point'],
                $pointVariance['pointVariance'],
            );
        }

        $text = implode("\n", $lines);
        $body = <<<EOT
        以下のポイント差分が発生したため自動調整されました。
        会員ID, 履歴合計値, 現在のポイント, 差分
        {$text}
        EOT;

        $baseInfo = $this->BaseInfoRepository->getMallBaseInfo();

        $message = (new Email())
            ->subject('ポイント差分発生通知メール')
            ->text($body)
            ->from(new Address($baseInfo->getEmail01(), $baseInfo->getShopName()))
            ->to($this->convertRFCViolatingEmail($address))
            ->replyTo($baseInfo->getEmail03())
            ->returnPath($baseInfo->getEmail04());

        try {
            $this->mailer->send($message);
            log_info('ポイント差分発生通知メール送信完了');
        } catch (TransportExceptionInterface $e) {
            log_critical($e->getMessage());
        }
    }

