    /**
     * イベント決済確認エラー通知メール送信（決済処理中チェックバッチ）
     */
    public function sendEventPaymentErrorAlertMail(DtbEventEntry $EventEntry, ?string $message = null): Email
    {
        log_info('イベント決済確認エラー通知メール送信開始（決済処理中チェックバッチ）');

        $templateId = MailTemplate::EVENTENTRY_CREDIT_ERROR;

        /** @var ?MailTemplate $MailTemplate */
        $MailTemplate = $this->mailTemplateRepository->find($templateId);
        if ($MailTemplate === null) {
            throw new \LogicException('イベント決済確認エラー通知メールテンプレートが存在しません。templateId='.$templateId);
        }

        $body = $this->twig->render($MailTemplate->getFileName(), [
            'entry' => $EventEntry,
            'message' => $message,
            'header' => $MailTemplate->getHeader(),
            'footer' => $MailTemplate->getFooter(),
        ]);

        $alertMailAddress = trim((string) $this->mtbOptionRepository
            ->findOneBy(['option_key' => MtbOption::ALERT_CHECK_PAYMENT_ERROR_MAIL_ADDRESS])
            ?->getOptionValue());
        if ($alertMailAddress === '') {
            throw new \LogicException('イベント決済確認エラー通知メールアドレスが設定されていません。');
        }

        $emailMessage = (new Email())
            ->subject('['.$this->BaseInfo->getShopName().'] '.$MailTemplate->getMailSubject())
            ->from(new Address($this->BaseInfo->getEmail01(), $this->BaseInfo->getShopName()))
            ->to($this->convertRFCViolatingEmail($alertMailAddress))
            ->bcc($this->BaseInfo->getEmail01())
            ->replyTo($this->BaseInfo->getEmail03())
            ->returnPath($this->BaseInfo->getEmail04())
            ->text($body);

        try {
            $this->mailer->send($emailMessage);
            log_info('イベント決済確認エラー通知メール送信完了（決済処理中チェックバッチ）');

            $BaseInfo = $this->BaseInfoRepository->find(1);
            $this->mailHistoryEntityManager->save($emailMessage, $BaseInfo, null, $MailTemplate);
            $this->entityManager->flush();
        } catch (TransportExceptionInterface $e) {
            log_critical($e->getMessage());
            throw $e;
        }

        return $emailMessage;
    }

