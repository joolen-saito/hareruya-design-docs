    /**
     * 特定のステータスで現在時刻よりも申込日時が指定した時間前の申込を取得（決済処理中チェックバッチ用）
     *
     * @param array<int, mixed> $payments
     */
    public function getBeforeMinutesEntry(int $beforeMinute, array $payments = [], int $entryStatusId = ES::PROCESSING_PAYMENT): mixed
    {
        $time = new \DateTime();
        // dtb_event_entry
        $qb = $this->createQueryBuilder('ee');
        $qb->where($qb->expr()->eq('IDENTITY(ee.EntryStatus)', ':entryStatusId'))
            ->andWhere($qb->expr()->lte('ee.createDate', ':beforeTime'))
            ->andWhere('ee.paymentNo IS NOT NULL')
            ->andWhere('ee.deletedAt IS NULL')
            ->setParameter('entryStatusId', $entryStatusId)
            ->setParameter('beforeTime', $time->modify("-{$beforeMinute} minute"))
            ->orderBy('ee.paymentNo');

        if (count($payments) > 0) {
            $qb->andWhere($qb->expr()->in('IDENTITY(ee.Payment)', ':payments'))
                ->setParameter('payments', $payments);
        }
        $query = $qb->getQuery();

        return $query->getResult();
    }

