            throw new BadRequestHttpException();
        }

        $images = $request->files->get('admin_product');
        $allowExtensions = ['gif', 'jpg', 'jpeg', 'png'];
        $files = [];
        $fileAdapter = $this->fileManager->getAdapter();
        if (count($images) > 0) {
            foreach ($images as $img) {
                /** @var UploadedFile $image */
                foreach ($img as $image) {
                    // ファイルフォーマット検証
                    $mimeType = $image->getMimeType();
                    if (!str_starts_with((string) $mimeType, 'image')) {
                        throw new UnsupportedMediaTypeHttpException();
                    }

                    // 拡張子
                    $extension = $image->getClientOriginalExtension();
                    if (!in_array(strtolower((string) $extension), $allowExtensions)) {
                        throw new UnsupportedMediaTypeHttpException();
                    }

                    $filename = date('mdHis').uniqid('_').'.'.$extension;
                    $fileAdapter->upload($image->getRealPath(), $this->eccubeConfig->get('preferred_temp_product_image_path'), $filename);
                    $files[] = $filename;
                }
            }
        }

        $event = new EventArgs(
            [
                'images' => $images,
                'files' => $files,
            ],
            $request
        );
        $this->eventDispatcher->dispatch($event, EccubeEvents::ADMIN_PRODUCT_ADD_IMAGE_COMPLETE);
