    /**
     * ユニサーチ doc 1件から ProductClass を解決する。
     * product_class があればその ID を優先（商品 ID・price02・visible・公開ステータスの整合を確認）。
     *
     * @param array<string, mixed> $doc
     */
    public function resolveProductClassForUnisearchDoc(array $doc): ?ProductClass
    {
        $pcId = $this->getProductClassIdFromUnisearchDoc($doc);
        if ($pcId !== null) {
            $pc = $this->find($pcId);
            if ($pc !== null) {
                $Product = $pc->getProduct();
                $productStatus = $Product !== null ? $Product->getStatus() : null;
                if (
                    $Product !== null
                    && $Product->getId() === (int) $doc['product']
                    && (int) $pc->getPrice02() > 0
                    && $pc->isVisible()
                    && $productStatus !== null
                    && $productStatus->getId() === ProductStatus::DISPLAY_SHOW
                ) {
                    return $pc;
                }
            }
        }

        $rawHighPriceCode = $doc['high_price_code'] ?? null;
        $highPriceCode = ($rawHighPriceCode !== null && (string) $rawHighPriceCode !== '')
            ? (string) $rawHighPriceCode
            : null;

        return $this->searchProductById([
            'id' => $doc['product'],
            'highPriceCode' => $highPriceCode,
            'languageId' => (int) ($doc['language'] ?? 0),
        ]);
    }
    /**
     * 移植元: pf-eccube3/app/Eccube/Repository/DtbProductSubClassRepository.php::searchProductById
     *
     * @param array<string, mixed> $keys id, languageId, highPriceCode（null または空文字は通常価格。フロント相当: visible かつ商品ステータス公開のみヒット）
     */
    public function searchProductById(array $keys): ?ProductClass
    {
        $qb = $this->createQueryBuilder('pc')
            ->innerJoin('pc.Product', 'p');

        $highPriceCode = $keys['highPriceCode'] ?? null;
        if ($highPriceCode === null || $highPriceCode === '') {
            $qb->where($qb->expr()->eq('p.id', ':id'))
                ->andWhere($qb->expr()->eq('IDENTITY(pc.Language)', ':languageId'))
                ->andWhere('pc.price02 > 0')
                ->andWhere('(pc.high_price_code IS NULL OR pc.high_price_code = :emptyHighPriceCode)')
                ->andWhere('pc.visible = true')
                ->andWhere('IDENTITY(p.Status) = :productStatusShowId')
                ->setParameter('id', $keys['id'])
                ->setParameter('languageId', $keys['languageId'])
                ->setParameter('emptyHighPriceCode', '')
                ->setParameter('productStatusShowId', ProductStatus::DISPLAY_SHOW);
        } else {
            $qb->where($qb->expr()->eq('p.id', ':id'))
                ->andWhere($qb->expr()->eq('IDENTITY(pc.Language)', ':languageId'))
                ->andWhere($qb->expr()->eq('pc.high_price_code', ':highPriceCode'))
                ->andWhere('pc.price02 > 0')
                ->andWhere('pc.visible = true')
                ->andWhere('IDENTITY(p.Status) = :productStatusShowId')
                ->setParameter('id', $keys['id'])
                ->setParameter('languageId', $keys['languageId'])
                ->setParameter('highPriceCode', (string) $keys['highPriceCode'])
                ->setParameter('productStatusShowId', ProductStatus::DISPLAY_SHOW);
        }

        $qb->setMaxResults(1);

        return $qb->getQuery()->getOneOrNullResult();
    }

