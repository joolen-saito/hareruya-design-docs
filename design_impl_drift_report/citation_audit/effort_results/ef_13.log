namespace Eccube\Service\Admin\Product;

use Doctrine\DBAL\Exception\ForeignKeyConstraintViolationException;
use Doctrine\ORM\EntityManagerInterface;
use Eccube\Entity\MessengerJob;
use Eccube\Entity\ProductClass;
use Eccube\Repository\DtbPriceHistoryRepository;
use Eccube\Repository\DtbProductClassImageRepository;
use Eccube\Service\Smaregi\SmaregiProductClassEventService;

class ProductClassDeleteAction
{
    public function __construct(
        private readonly EntityManagerInterface $entityManager,
        private readonly DtbPriceHistoryRepository $priceHistoryRepository,
        private readonly DtbProductClassImageRepository $productClassImageRepository,
        private readonly SmaregiProductClassEventService $smaregiProductClassEventService,
    ) {
    }

    /**
     * @throws ForeignKeyConstraintViolationException
     */
    public function handle(ProductClass $ProductClass): void
    {
        $productClassId = (int) $ProductClass->getId();
        $Product = $ProductClass->getProduct();
        $productId = $Product !== null ? (int) $Product->getId() : 0;
        $smaregiAlignmentFlg = $ProductClass->getSmaregiAlignmentFlg();
        $smaregiProductIdForDelete = $ProductClass->getSmaregiProductId();
        $trimmedSmaregiProductId = ($smaregiProductIdForDelete !== null && trim($smaregiProductIdForDelete) !== '')
            ? trim($smaregiProductIdForDelete)
            : null;

        $this->entityManager->beginTransaction();

        $smaregiDeleteJob = null;
        try {
            if ($smaregiAlignmentFlg && $productId > 0 && $trimmedSmaregiProductId !== null) {
                $smaregiDeleteJob = $this->smaregiProductClassEventService->registerDeleteJob(
                    $productClassId,
                    $productId,
                    $trimmedSmaregiProductId,
                );
            }

            // 商品規格に関連するレコードを削除する
            $this->priceHistoryRepository->deleteByProductClass($ProductClass);
            $this->productClassImageRepository->deleteByProductClass($ProductClass);

            $this->entityManager->remove($ProductClass);
            $this->entityManager->flush();

            $this->entityManager->commit();

            if ($smaregiDeleteJob instanceof MessengerJob && $trimmedSmaregiProductId !== null) {
                $this->smaregiProductClassEventService->dispatchDeleteMessage(
                    $smaregiDeleteJob,
                    $productClassId,
                    $productId,
                    $trimmedSmaregiProductId,
                );
            }
        } catch (\Exception $e) {
            if ($this->entityManager->getConnection()->isTransactionActive()) {
                $this->entityManager->rollback();
            }

            throw $e;
        }
    }
}

