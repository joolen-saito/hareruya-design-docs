<?php

namespace Plugin\HareruyaEc\Service;

use Eccube\Application;
use Firebase\JWT\JWT;
use Plugin\HareruyaEc\Entity\DtbBranchUpdateError;

class BranchUpdateService
{
    const TYPE_CARD = 'card';
    const TYPE_CUSTOMER = 'customer';
    const TYPE_PRODUCT = 'product';

    /** @var \Eccube\Application */
    public $app;

    /**
     * Constructor
     *
     * @param Application $app
     */
    public function __construct(Application $app)
    {
        $this->app = $app;
    }

    /**
     * 登録・更新したカード情報を支店システムへ連携
     * @param array $updateCardIds
     */
    public function noticeCardUpdate($updateCardIds)
    {
        $result = $this->cURLNoticeUpdate(self::TYPE_CARD, $updateCardIds);
        if (isset($result['success']) && $result['success']) {
            log_info('支店システムへのカード情報更新成功 ID: ' . implode(',', $updateCardIds));
        } else {
            $message = json_encode($result);
            $this->addBranchUpdateError(self::TYPE_CARD, $updateCardIds, $message);
            log_info('支店システムへのカード情報更新失敗 ID: ' . implode(',', $updateCardIds));
            log_info('message: ' . $message);
        }
    }

    /**
     * 登録・更新した顧客情報を支店システムへ連携
     * @param array $updateCustomerIds
     */
    public function noticeCustomerUpdate($updateCustomerIds)
    {
        $result = $this->cURLNoticeUpdate(self::TYPE_CUSTOMER, $updateCustomerIds);
        if (isset($result['success']) && $result['success']) {
            log_info('支店システムへの顧客情報更新成功 ID: ' . implode(',', $updateCustomerIds));
        } else {
            $message = json_encode($result);
            $this->addBranchUpdateError(self::TYPE_CUSTOMER, $updateCustomerIds, $message);
            log_info('支店システムへの顧客情報更新失敗 ID: ' . implode(',', $updateCustomerIds));
            log_info('message: ' . $message);
        }
    }

    /**
     * 登録・更新した商品情報を支店システムへ連携
     * @param array $updateProductIds
     */
    public function noticeProductUpdate($updateProductIds)
    {
        $result = $this->cURLNoticeUpdate(self::TYPE_PRODUCT, $updateProductIds);
        if (isset($result['success']) && $result['success']) {
            log_info('支店システムへの商品情報更新成功 ID: ' . implode(',', $updateProductIds));
        } else {
            $message = json_encode($result);
            $this->addBranchUpdateError(self::TYPE_PRODUCT, $updateProductIds, $message);
            log_info('支店システムへの商品情報更新失敗 ID: ' . implode(',', $updateProductIds));
            log_info('message: ' . $message);
        }
    }

    /**
     * 登録・更新した在庫情報を支店システムへ連携
     * @param array $params
     */
    public function noticeStockUpdate($params)
    {
        $result = $this->cURLStockUpdate($params);
        if (isset($result['success']) && $result['success']) {
            log_info('支店システムへの在庫情報更新成功 ID: ' . implode(',', array_keys($params)));
        } else {
            log_info('支店システムへの在庫情報更新失敗 ID: ' . implode(',', array_keys($params)));
            log_info('message: ' . json_encode($result));
        }
    }

    /**
     * 支店連携に失敗したレコードを再連携
     * @param DtbBranchUpdateError $branchUpdateError
     */
    public function noticeUpdateError($branchUpdateError)
    {
        $ids = $branchUpdateError->getTargetIds();
        $result = $this->cURLNoticeUpdate($branchUpdateError->getTargetType(), explode(',', $ids));
        if (isset($result['success']) && $result['success']) {
            log_info('支店システムへの再連携成功 ID: ' . $ids);
            $this->app['orm.em']->remove($branchUpdateError);
        } else {
            log_info('支店システムへの再連携失敗 ID: ' . $ids);
            $branchUpdateError->setMessage(json_encode($result));
            $this->app['orm.em']->persist($branchUpdateError);
        }
        $this->app['orm.em']->flush($branchUpdateError);
    }

    /**
     * 支店システム側の更新通知API連携
     *
     * @param  string $type
     * @param  array $ids
     * @return array
     */
    public function cURLNoticeUpdate($type, $ids)
    {
        $app = $this->app;
        $url = $app['hareruya_ec.config.api']['branch_api_url'] . sprintf($app['hareruya_ec.config.api']['endpoint_notice_update'], $type);
        $idParam = 'ids[]=' . implode('&ids[]=', $ids);
        $result = $this->execCurl($url, $idParam);

        return $result;
    }

    /**
     * 支店システム側の本店在庫更新API連携
     *
     * @param array $params
     * @return array
     */
    private function cURLStockUpdate($params)
    {
        $app = $this->app;
        $url = $app['hareruya_ec.config.api']['branch_api_url'] . $app['hareruya_ec.config.api']['endpoint_stock_update'];
        $header = [
            'Content-Type: application/json',
            'X-Admin-Authentication: ' . $this->createToken(),
	];
	log_info('JSON内容: ' . json_encode($params));
        $result = $this->execCurl($url, json_encode($params), $header);

        return $result;
    }

    /**
     * cURLを実行して結果を返す
     *
     * @param string $url
     * @param string $postfields
     * @param array|null $header
     * @return array
     */
    private function execCurl($url, $postfields, $header = null)
    {
        $curl = curl_init();
        curl_setopt($curl, CURLOPT_URL, $url);
        curl_setopt($curl, CURLOPT_CUSTOMREQUEST, 'POST');
        curl_setopt($curl, CURLOPT_POSTFIELDS, $postfields);
        curl_setopt($curl, CURLOPT_RETURNTRANSFER, true);
        curl_setopt($curl, CURLOPT_HEADER, true);
        if ($header) {
            curl_setopt($curl, CURLOPT_HTTPHEADER, $header);
        }

        $response = curl_exec($curl);
        $message = curl_error($curl);

        $header_size = curl_getinfo($curl, CURLINFO_HEADER_SIZE);
        $body = substr($response, $header_size);
        $result = json_decode($body, true);
        $result['message'] = $message;

        curl_close($curl);

        return $result;
    }

    /**
     * 支店API用のJWTトークンを取得する
     *
     * @return string
     */
    private function createToken(): string
    {
        $payload = [
            'iss' => $this->app['hareruya_ec.config.branch']['jwt_issuer'],
            'aud' => $this->app['hareruya_ec.config.branch']['jwt_aud'],
        ];

        return JWT::encode($payload, $this->app['hareruya_ec.config.branch']['jwt_token_key']);
    }

    /**
     * 支店連携エラーをレコードに追加
     *
     * @param string $type
     * @param array $ids
     * @param string $message
     */
    private function addBranchUpdateError($type, $ids, $message)
    {
        $em = $this->app['orm.em'];

        $branchUpdateError = new DtbBranchUpdateError();
        $branchUpdateError
            ->setTargetIds(implode(',', $ids))
            ->setTargetType($type)
            ->setMessage($message)
            ->setCreateDate(new \DateTime())
        ;

        $em->persist($branchUpdateError);
        $em->flush();
    }
}

