namespace Eccube\Service\Smaregi;

use Doctrine\ORM\EntityManagerInterface;
use Eccube\Entity\MessengerJob;
use Eccube\Entity\ProductClass;
use Eccube\Message\SmaregiProductClassDeleteMessage;
use Eccube\Message\SmaregiProductClassUpsertMessage;
use Psr\Log\LoggerInterface;
use Symfony\Component\Messenger\MessageBusInterface;

class SmaregiProductClassEventService
{
    public function __construct(
        private readonly MessageBusInterface $messageBus,
        private readonly EntityManagerInterface $entityManager,
        private readonly LoggerInterface $logger,
    ) {
    }

    public function dispatchUpsert(ProductClass $productClass): void
    {
        if (!$productClass->getSmaregiAlignmentFlg()) {
            return;
        }

        $smaregiProductCode = $productClass->getSmaregiProductCode();
        if ($smaregiProductCode === null || trim($smaregiProductCode) === '') {
            return;
        }

        $id = $productClass->getId();
        if ($id === null) {
            return;
        }

        $job = new MessengerJob();
        $job->setMessageClass(SmaregiProductClassUpsertMessage::class);
        $job->setStatus(MessengerJob::STATUS_PENDING);
        $job->setPayloadSummary(sprintf(
            'productClassId=%d productId=%s smaregiProductId=%s',
            $id,
            (string) ($productClass->getProduct()?->getId() ?? ''),
            (string) ($productClass->getSmaregiProductId() ?? ''),
        ));
        $this->entityManager->persist($job);
        $this->entityManager->flush();

        try {
            $this->messageBus->dispatch(new SmaregiProductClassUpsertMessage(
                $id,
                (int) $job->getId(),
            ));
        } catch (\Throwable $e) {
            try {
                $job->setStatus(MessengerJob::STATUS_FAILED);
                $job->setCompletedAt(new \DateTime());
                $job->setErrorMessage('メッセージバスへの投入に失敗しました: '.$e->getMessage());
                $this->entityManager->flush();
            } catch (\Throwable $persistError) {
                $this->logger->error('Failed to persist Smaregi product class upsert job failure state', [
                    'jobId' => $job->getId(),
                    'productClassId' => $id,
                    'error' => $persistError->getMessage(),
                ]);
            }
            $this->logger->error('Smaregi product class upsert message dispatch failed', [
                'exception' => $e,
                'jobId' => $job->getId(),
                'productClassId' => $id,
            ]);

            throw $e;
        }
    }

    /**
     * 商品規格削除と同一 DB トランザクションで呼ぶこと（flush は呼び出し側）.
     * コミット後に {@see dispatchDeleteMessage()} を実行する.
     */
    public function registerDeleteJob(int $productClassId, int $productId, string $smaregiProductId): MessengerJob
    {
        $job = new MessengerJob();
        $job->setMessageClass(SmaregiProductClassDeleteMessage::class);
        $job->setStatus(MessengerJob::STATUS_PENDING);
        $job->setPayloadSummary(sprintf(
            'productClassId=%d productId=%d smaregiProductId=%s',
            $productClassId,
            $productId,
            $smaregiProductId,
        ));
        $this->entityManager->persist($job);

        return $job;
    }

    /**
     * registerDeleteJob の flush / commit 成功後にのみ呼ぶ。
     * メッセージバス投入に失敗しても例外は投げず、ジョブを FAILED にしてログする（EC 側処理は既に確定している想定）。
     * FAILED 更新時の {@see EntityManagerInterface::flush()} が失敗しても例外は伝播させない.
     */
    public function dispatchDeleteMessage(MessengerJob $job, int $productClassId, int $productId, string $smaregiProductId): void
    {
        $jobId = (int) $job->getId();
        if ($jobId < 1) {
            $this->logger->error('Smaregi delete job has no id; cannot dispatch message bus.', [
                'productClassId' => $productClassId,
                'productId' => $productId,
            ]);

            return;
        }

        try {
            $this->messageBus->dispatch(new SmaregiProductClassDeleteMessage(
                $productClassId,
                $productId,
                $smaregiProductId,
                $jobId,
            ));
        } catch (\Throwable $e) {
            try {
                $managed = $this->entityManager->find(MessengerJob::class, $jobId);
                if ($managed instanceof MessengerJob) {
                    $managed->setStatus(MessengerJob::STATUS_FAILED);
                    $managed->setCompletedAt(new \DateTime());
                    $managed->setErrorMessage('メッセージバスへの投入に失敗しました: '.$e->getMessage());
                    $this->entityManager->flush();
                }
            } catch (\Throwable $persistError) {
                $this->logger->error('Failed to persist Smaregi delete job failure state', [
                    'jobId' => $jobId,
                    'productClassId' => $productClassId,
                    'productId' => $productId,
                    'error' => $persistError->getMessage(),
                ]);
            }
            $this->logger->error('Smaregi product class delete message dispatch failed', [
                'exception' => $e,
                'jobId' => $jobId,
                'productClassId' => $productClassId,
                'productId' => $productId,
            ]);
        }
    }
