    #[Route(path: '/%eccube_admin_route%/product/category/icon/image/load', name: 'admin_product_category_icon_image_load', methods: ['GET'])]
    public function iconImageLoad(Request $request): Response
    {
        if (!$request->isXmlHttpRequest()) {
            throw new BadRequestHttpException();
        }

        $source = (string) $request->get('source');

        if ($source === '') {
            throw new BadRequestHttpException();
        }

        $fileAdapter = $this->fileManager->getAdapter();
        $tmpDir = rtrim((string) $this->eccubeConfig->get('preferred_temp_category_icon_image_path'), '/').'/';

        $Category = $this->categoryRepository->findOneByIconImageObjectKey($source);

        if ($Category !== null) {
            if ($fileAdapter->exists($source, []) === false) {
                throw new NotFoundHttpException();
            }

            $file = $fileAdapter->get($source, []);
            $fileKey = basename($source);
        } else {
            $tempFile = $tmpDir.$source;

            if ($fileAdapter->exists($tempFile, []) === false) {
                throw new NotFoundHttpException();
            }

            $file = $fileAdapter->get($tempFile, []);
            $fileKey = $source;
        }

        $event = new EventArgs(
            [
                'fileKey' => $fileKey,
            ],
            $request
        );
        $this->eventDispatcher->dispatch($event, EccubeEvents::ADMIN_PRODUCT_CATEGORY_ICON_IMAGE_LOAD_COMPLETE);

        return new Response(
            $file->getContents(),
            Response::HTTP_OK,
            [
                'Access-Control-Expose-Headers' => 'Content-Disposition, Content-Length, X-Content-Transfer-Id',
                'Content-Type' => $fileAdapter->getAdditionalFileInformation()['ContentType'],
                'Content-Disposition' => 'inline; filename="'.$fileKey.'"',
            ]
        );
    }

