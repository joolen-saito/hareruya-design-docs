 */
class DtbCsvExtensionRepository extends AbstractRepository
{
    public function __construct(ManagerRegistry $registry)
    {
        parent::__construct($registry, DtbCsvExtension::class);
    }

    /**
     * @return DtbCsvExtension[]
     */
    public function findActiveByCsvTypeId(int $csvTypeId): array
    {
        return $this->createQueryBuilder('e')
            ->innerJoin('e.CsvType', 't')
            ->where('t.id = :csvTypeId')
            ->andWhere('e.deleted_at IS NULL')
            ->setParameter('csvTypeId', $csvTypeId)
            ->orderBy('e.id', 'ASC')
            ->getQuery()
            ->getResult();
    }
}
