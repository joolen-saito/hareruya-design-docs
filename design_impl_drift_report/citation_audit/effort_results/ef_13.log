    /**
     * ページタイトルの設定
     *
     * @param  array<mixed>|null $searchData
     */
    protected function getPageTitle(?array $searchData): string
    {
        if (!empty($searchData['product'])) {
            return trans('front.product.search_result');
        } elseif (isset($searchData['category']) && $searchData['category']) {
            $names = array_map(
                fn ($Category) => $Category->getName(),
                $searchData['category']->getPath()
            );
            if (count($names) >= 3 && str_contains($names[2], $names[1])) {
                array_splice($names, 1, 1);
            }

            return implode(' / ', $names);
        } else {
            return trans('front.product.all_products');
        }
    }

