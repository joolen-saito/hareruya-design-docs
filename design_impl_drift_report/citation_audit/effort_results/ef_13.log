    /**
     * @return array{0: Category|null, 1: Category}
     */
    private function resolveCategoryContext(?Category $Parent): array
    {
        $TargetCategory = new Category();
        $TargetCategory->setParent($Parent);
        if ($Parent) {
            $TargetCategory->setHierarchy($Parent->getHierarchy() + 1);
        } else {
            $TargetCategory->setHierarchy(1);
        }

        return [$Parent, $TargetCategory];
    }

    private function createCategoryForm(
        Category $TargetCategory,
        ?Category $Parent,
        Request $request,
        ?string $formAction = null,
