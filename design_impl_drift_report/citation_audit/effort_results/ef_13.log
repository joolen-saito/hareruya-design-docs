    private function collectPurchaseFlowMessagesForCartAdd(PurchaseFlowResult $result, array $targetProductClasses): array
    {
        $messages = [];
        foreach ($result->getErrors() as $error) {
            $messages[] = $error->getMessage();
        }

        $warningsByLabel = [];
        foreach ($targetProductClasses as $pc) {
            $label = $this->purchaseFlowProductLabelForCartMessage($pc);
            if ($label !== '') {
                $warningsByLabel[$label] = [];
            }
        }

        foreach ($result->getWarning() as $warning) {
            $msg = $warning->getMessage();
            if ($msg === null) {
                continue;
            }
            $matchedLabel = null;
            foreach (array_keys($warningsByLabel) as $label) {
                if (str_contains($msg, $label)) {
                    $matchedLabel = $label;
                    break;
                }
            }
            if ($matchedLabel === null) {
                log_info('カート検証警告（今回追加以外の明細）', ['message' => $msg]);

                continue;
            }
            $warningsByLabel[$matchedLabel][] = $msg;
        }

        foreach ($warningsByLabel as $msgs) {
            if ($msgs === []) {
                continue;
            }
            $messages[] = $this->chooseSingleStockWarningMessage($msgs);
        }

        return array_values(array_unique($messages));
    }

