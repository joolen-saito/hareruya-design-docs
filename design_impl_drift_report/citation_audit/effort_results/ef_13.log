        $source = (string) $request->get('source');
        /** @var ProductImage|null $fileData */
        $fileData = $this->productImageRepository->findOneBy(['objectKey' => $source]);
        $fileAdapter = $this->fileManager->getAdapter();
        if ($fileData === null) {
            if ($fileAdapter->exists($this->eccubeConfig->get('preferred_temp_product_image_path').$source, []) === true) {
                $file = $fileAdapter->get($this->eccubeConfig['preferred_temp_product_image_path'].$source, []);
                $fileKey = $source;
            } elseif (str_starts_with($source, 'img/goods/') && !str_contains($source, '..') && $fileAdapter->exists($source, []) === true) {
                // カード詳細画像を FilePond プレビュー用に配信する。
                // card_detail_image_set() で pond.addFile(url, { type: 'local' }) を呼ぶと
                // FilePond がこのエンドポイントへ img/goods/... パスでリクエストを送る。
                $file = $fileAdapter->get($source, []);
                $fileKey = $source;
            } else {
                throw new NotFoundHttpException();
            }
        } else {
            $file = $fileAdapter->get($fileData->getFileKey(), $fileData->getAdapterInformation());
            $fileKey = $fileData->getFileKey();
        }

        $event = new EventArgs(
            [
                'fileKey' => $fileKey,
            ],
            $request
        );
        $this->eventDispatcher->dispatch($event, EccubeEvents::ADMIN_PRODUCT_IMAGE_LOAD_COMPLETE);

        return new Response(
            $file,
            Response::HTTP_OK,
            [
                'Access-Control-Expose-Headers: Content-Disposition, Content-Length, X-Content-Transfer-Id',
                'Content-Type' => $fileAdapter->getAdditionalFileInformation()['ContentType'],
                'Content-Disposition: inline; filename="'.$fileKey.'"',
            ]
        );
    }

    /**
     * アップロード画像をすぐ削除する際にコールされるメソッド.
     *
     * @see https://pqina.nl/filepond/docs/api/server/#revert
     *
     * @throws BadRequestHttpException|NotFoundHttpException
     */
    #[Route(path: '/%eccube_admin_route%/product/product/image/revert', name: 'admin_product_image_revert', methods: ['DELETE'])]
    public function imageRevert(Request $request): Response
    {
        if (!($request->isXmlHttpRequest() && $this->isTokenValid())) {
            throw new BadRequestHttpException();
        }

        $tempFile = $this->eccubeConfig['preferred_temp_product_image_path'].$request->getContent();

        $fileAdapter = $this->fileManager->getAdapter();
        if ($this->fileManager->getAdapter()->exists($tempFile, [])) {
            $fileAdapter->delete($tempFile, []);

            $event = new EventArgs(
                [
                    'tempFile' => $tempFile,
                ],
                $request
            );
            $this->eventDispatcher->dispatch($event, EccubeEvents::ADMIN_PRODUCT_IMAGE_REVERT_COMPLETE);

            return new Response(null, Response::HTTP_NO_CONTENT);
        }
        throw new NotFoundHttpException();
    }

    /**
     * @param int|string|null $id
     *
     * @return RedirectResponse|array<string, mixed>
     *
     * @throws NotFoundHttpException|\Exception
     */
    #[Route(path: '/%eccube_admin_route%/product/product/new', name: 'admin_product_product_new', methods: ['GET', 'POST'])]
    #[Route(path: '/%eccube_admin_route%/product/product/{id}/edit', name: 'admin_product_product_edit', requirements: ['id' => '\d+'], methods: ['GET', 'POST'])]
    #[Template(template: '@admin/Product/product.twig')]
    public function edit(
        Request $request,
        RouterInterface $router,
        CacheUtil $cacheUtil,
        SmaregiProductClassEventService $smaregiProductClassEventService,
        $id = null,
    ): RedirectResponse|array {
        // NOTE: 商品新規登録は不要機能のため使用禁止として404を返す
        if ($id === null) {
            throw new NotFoundHttpException();
        }

        $has_class = false;
        $tmpDir = $this->eccubeConfig->get('preferred_temp_product_image_path');
        $imgDir = $this->eccubeConfig->get('preferred_product_image_path');
        $Product = $this->productRepository->findWithSortedClassCategories($id);
        $ProductClass = null;

        if (!$Product) {
            throw new NotFoundHttpException();
        }

        // 規格無しの商品の場合は、デフォルト規格を表示用に取得する
        $has_class = $Product->hasProductClass();
        if (!$has_class) {
            $ProductClasses = $Product->getProductClasses();
            foreach ($ProductClasses as $pc) {
                if (!is_null($pc->getClassCategory1())) {
                    continue;
                }

                if ($pc->isVisible()) {
                    $ProductClass = $pc;
                    break;
                }
            }

            if ($this->MallBaseInfo->isOptionProductTaxRule() && $ProductClass->getTaxRule()) {
                $ProductClass->setTaxRate($ProductClass->getTaxRule()->getTaxRate());
            }
        }

        $builder = $this->formFactory
            ->createBuilder(ProductType::class, $Product);

        $event = new EventArgs(
            [
                'builder' => $builder,
                'Product' => $Product,
            ],
            $request
        );
        $this->eventDispatcher->dispatch($event, EccubeEvents::ADMIN_PRODUCT_EDIT_INITIALIZE);

        $form = $builder->getForm();

        // ファイルの登録
        $images = [];
        $ProductImages = $Product->getProductImage();
        foreach ($ProductImages as $ProductImage) {
            $images[] = $ProductImage->getObjectKey();
        }
        $form['images']->setData($images);

        $categories = [];
        $ProductCategories = $Product->getProductCategories();
        foreach ($ProductCategories as $ProductCategory) {
            /** @var ProductCategory $ProductCategory */
            $categories[] = $ProductCategory->getCategory();
        }
        $form['Category']->setData($categories);

        $Tags = $Product->getTags();
        $form['Tag']->setData($Tags);

        $Cardset = $this->cardsetRepository->find($Product->getCardsetId());
        $form['Cardset']->setData($Cardset);

        $form['isBranchPublished']->setData((int) $Product->isBranchPublished());

        if ('POST' === $request->getMethod()) {
            $previousProductName = $Product->getName();
            $form->handleRequest($request);
            if ($form->isValid()) {
                $fileAdapter = $this->fileManager->getAdapter();
                log_info('商品登録開始', [$id]);
                /** @var Product $Product */
                $Product = $form->getData();

                // カード詳細情報の登録
                $cardDetailId = $form->get('CardDetail')->getData();
                if (isset($cardDetailId)) {
                    $CardDetail = $this->cardDetailRepository->find($cardDetailId);
                    $Product->setCardDetail($CardDetail);
                }

                // カテゴリの登録
                // 一度クリア
                foreach ($Product->getProductCategories() as $ProductCategory) {
                    $Product->removeProductCategory($ProductCategory);
                    $this->entityManager->remove($ProductCategory);
                }
                $this->entityManager->persist($Product);
                $this->entityManager->flush();

                $count = 1;
                $Categories = $form->get('Category')->getData();
                $categoriesIdList = [];
                foreach ($Categories as $Category) {
                    foreach ($Category->getPath() as $ParentCategory) {
                        if (!isset($categoriesIdList[$ParentCategory->getId()])) {
                            $ProductCategory = $this->createProductCategory($Product, $ParentCategory);
                            $this->entityManager->persist($ProductCategory);
                            $count++;
                            /** @var Product $Product */
                            $Product->addProductCategory($ProductCategory);
                            $categoriesIdList[$ParentCategory->getId()] = true;
                        }
                    }
                    if (!isset($categoriesIdList[$Category->getId()])) {
                        $ProductCategory = $this->createProductCategory($Product, $Category);
                        $this->entityManager->persist($ProductCategory);
                        $count++;
                        /** @var Product $Product */
                        $Product->addProductCategory($ProductCategory);
                        $categoriesIdList[$Category->getId()] = true;
                    }
                }

                // 画像の登録
                $add_images = $form->get('add_images')->getData();
                foreach ($add_images as $add_image) {
                    // 移動
                    $fileAdapter->move(
                        $tmpDir.$add_image,
                        FilesystemUtil::convertRawPathToDynamicPath(['id', 'name'], $Product, $imgDir),
                        $add_image,
                        []
                    );
                    $ProductImage = new ProductImage();
                    $ProductImage
                        ->saveFile($fileAdapter->toEntitySaveData())
                        ->setProduct($Product)
                        ->setSortNo(1);
                    $Product->addProductImage($ProductImage);
                    $this->entityManager->persist($ProductImage);
                }

                // カード詳細画像を商品画像としてコピー登録
                // 旧システム参照: pf-eccube3/app/Plugin/HareruyaEc/Controller/Admin/Product/ProductController.php::copyProductImage()
                $copy_images = $form->get('copy_images')->getData();
                $existingFileNames = $Product->getProductImage()->map(
                    fn (ProductImage $pi) => basename($pi->getFileName())
                )->toArray();
                foreach ($copy_images as $copy_image) {
                    if (!is_string($copy_image)
                        || !str_starts_with($copy_image, 'img/goods/')
                        || str_contains($copy_image, '..')
                    ) {
                        continue;
                    }
                    $filename = basename($copy_image);
                    if (in_array($filename, $existingFileNames, true)) {
                        continue;
                    }
                    $destPath = FilesystemUtil::convertRawPathToDynamicPath(['id', 'name'], $Product, $imgDir);
                    try {
                        $fileAdapter->copy($copy_image, $destPath, $filename, []);
                    } catch (\RuntimeException $e) {
                        log_error('カード詳細画像のS3コピーに失敗しました。', [
                            'path' => $copy_image,
                            'message' => $e->getMessage(),
                        ]);
                        continue;
                    }
                    $ProductImage = new ProductImage();
                    $ProductImage
                        ->saveFile($fileAdapter->toEntitySaveData())
                        ->setProduct($Product)
                        ->setSortNo(1);
                    $Product->addProductImage($ProductImage);
                    $this->entityManager->persist($ProductImage);
                    $existingFileNames[] = $filename;
                }

                // 画像の削除
                $delete_images = $form->get('delete_images')->getData();
                $fs = new Filesystem();
                $fileAdapter = $this->fileManager->getAdapter();
                foreach ($delete_images as $delete_image) {
                    /** @var ProductImage|null $ProductImage */
                    $ProductImage = $this->productImageRepository->findOneBy([
                        'Product' => $Product,
                        'objectKey' => $delete_image,
                    ]);

                    if ($ProductImage instanceof ProductImage) {
                        $ImageDetails = $ProductImage->getAdapterInformation();
                        $Product->removeProductImage($ProductImage);
                        $this->entityManager->remove($ProductImage);
                        $this->entityManager->flush();
                        $fileAdapter->delete($ProductImage->getFileKey(), $ImageDetails);
                    } else {
                        $fileAdapter->delete($tmpDir.$delete_image, []);
                    }
                }

                // CDNキャッシュクリア
                try {
                    $cdn = $this->cdnManager->getCDN();
                    if ($cdn === null) {
                        log_info('CDNキャッシュクリアをスキップしました。');
                    } else {
                        log_info('CDNキャッシュクリアを実行します。');
                        $cdn->clearCache([
                            $tmpDir,
                            FilesystemUtil::convertRawPathToDynamicPath(['id', 'name'], $Product, $imgDir),
                        ]
                        );
                        log_info('CDNキャッシュクリアが完了しました。');
                    }
                } catch (\Exception $e) {
                    log_error('CDNキャッシュクリアに失敗しました。', [
                        'message' => $e->getMessage(),
                        'file' => $e->getFile(),
                        'line' => $e->getLine(),
                        'stack' => $e->getTraceAsString(),
                    ]);
                }

                $this->entityManager->flush();

                /**
                 * @var array<string, Product>|Product[]|null $admin_product
                 */
                $admin_product = $request->request->all()['admin_product'] ?? null;
                if (is_array($admin_product) && array_key_exists('product_image', $admin_product)) {
                    /**
                     * @var array<int, ProductImage>|ProductImage[] $product_image
                     */
                    $product_image = $admin_product['product_image'];
                    foreach ($product_image as $sortNo => $filename) {
                        $ProductImage = $this->productImageRepository
                            ->findOneBy([
                                'file_name' => pathinfo((string) $filename, PATHINFO_BASENAME),
                                'Product' => $Product,
                            ]);
                        if ($ProductImage !== null) {
                            $ProductImage->setSortNo($sortNo);
                            $this->entityManager->persist($ProductImage);
                        }
                    }
                    $this->entityManager->flush();
                }

                // 商品タグの登録
                // 商品タグを一度クリア
                $ProductTags = $Product->getProductTag();
                foreach ($ProductTags as $ProductTag) {
                    $Product->removeProductTag($ProductTag);
                    $this->entityManager->remove($ProductTag);
                }

                // 商品タグの登録
                $Tags = $form->get('Tag')->getData();
                foreach ($Tags as $Tag) {
                    $ProductTag = new ProductTag();
                    $ProductTag
                        ->setProduct($Product)
                        ->setBaseInfo($Product->getBaseInfo())
                        ->setTag($Tag);
                    $Product->addProductTag($ProductTag);
                    $this->entityManager->persist($ProductTag);
                }

                // カードセット
                if ($Product->getCardDetail() !== null) {
                    $Product->setCardsetId($Product->getCardDetail()->getCardset()?->getId());
                } else {
                    $Cardset = $form->get('Cardset')->getData();
                    $Product->setCardsetId($Cardset?->getId());
                }

                // 売上分析タグ
                $this->productRepository->deleteAllTagSalesAnalyses($Product->getId());
                $this->productRepository->insertTagSalesAnalyses(
                    $Product->getId(),
                    $form->get('TagSalesAnalysis')->getViewData() ?: []
                );

                // 支店の商品公開ステータス
                $Product->setBranchPublished((bool) $form->get('isBranchPublished')->getData());

                $Product->setUpdateDate(new \DateTime());
                $this->entityManager->flush();

                if ($Product->getName() !== $previousProductName) {
                    foreach ($Product->getProductClasses() as $ProductClass) {
                        if (!$ProductClass->getSmaregiAlignmentFlg()) {
                            continue;
                        }
                        $smaregiCode = $ProductClass->getSmaregiProductCode();
                        if ($smaregiCode === null || trim($smaregiCode) === '') {
                            continue;
                        }
                        if ($ProductClass->getId() === null) {
                            continue;
                        }
                        try {
                            $smaregiProductClassEventService->dispatchUpsert($ProductClass);
                        } catch (\Throwable $e) {
                            log_error('スマレジ連携タスクの投入に失敗しました。', [
                                'product_id' => $Product->getId(),
                                'product_class_id' => $ProductClass->getId(),
                                'message' => $e->getMessage(),
                                'file' => $e->getFile(),
                                'line' => $e->getLine(),
                                'stack' => $e->getTraceAsString(),
                            ]);
                        }
                    }
                }

                log_info('商品登録完了', [$id]);

                $event = new EventArgs(
                    [
                        'form' => $form,
                        'Product' => $Product,
                    ],
                    $request
                );
                $this->eventDispatcher->dispatch($event, EccubeEvents::ADMIN_PRODUCT_EDIT_COMPLETE);

                $this->addSuccess('admin.common.save_complete', 'admin');

                if ($returnLink = $form->get('return_link')->getData()) {
                    try {
                        // $returnLinkはpathの形式で渡される. pathが存在するかをルータでチェックする.
                        $pattern = '/^'.preg_quote($request->getBasePath(), '/').'/';
                        $returnLink = preg_replace($pattern, '', (string) $returnLink);
                        $result = $router->match($returnLink);
                        // パラメータのみ抽出
                        $params = array_filter($result, fn ($key) => !str_starts_with((string) $key, '_'), ARRAY_FILTER_USE_KEY);

                        // pathからurlを再構築してリダイレクト.
                        return $this->redirectToRoute($result['_route'], $params);
                    } catch (\Exception) {
                        // マッチしない場合はログ出力してスキップ.
                        log_warning('URLの形式が不正です。');
                    }
                }

                $cacheUtil->clearDoctrineCache();

                return $this->redirectToRoute('admin_product_product_edit', ['id' => $Product->getId()]);
            }
