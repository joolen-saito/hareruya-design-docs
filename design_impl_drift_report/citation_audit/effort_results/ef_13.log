            'label' => '売上分析タグ(ID)',
            'labelEn' => 'tag_sales_analyses_id',
            'column' => 'MAX(p.id) as tag_sales_analyses_id',
        ],
        'tag_sales_analyses_name' => [
            'label' => '売上分析タグ名称',
            'labelEn' => 'tag_sales_analyses_name',
            'column' => 'MAX(p.id) as tag_sales_analyses_name',
        ],
        array $csvHeader = [],
        array $requiredCsvHeader = [],
    ) {
        $csvHeader = $csvHeader !== [] ? $csvHeader : self::DEFAULT_CSV_HEADER;
        $requiredCsvHeader = $requiredCsvHeader !== [] ? $requiredCsvHeader : self::DEFAULT_REQUIRED_CSV_HEADER;
        parent::__construct($entityManager, $translator, $eccubeConfig, $csvHeader, $requiredCsvHeader);
    }

    /**
     * 略称コードの登録処理
     *
     * @param array<int, string> $headers
     * @param int $headerSize
     * @param \Iterator<array<string, string>> $data
     *
     * @throws \RuntimeException
     * @throws \Throwable
     */
    public function register(array $headers, int $headerSize, \Iterator $data): void
    {
        $requiredHeaders = $this->requiredCsvHeader;
        $this->importedRanks = [];

        $this->entityManager->getConnection()->beginTransaction();

        try {
            $i = 0;
            foreach ($data as $row) {
                $rowIndex = $i + 2;

                if (end($row) === '') {
                    array_pop($row);
                }

                $this->checkHeaderSize($headerSize, $row, $rowIndex);
                $this->checkRequiredHeaders($requiredHeaders, $row, $rowIndex);

                $rank = $row['並び順'] ?? '';
                if (isset($this->importedRanks[$rank])) {
                    $message = $this->translator->trans(
                        'admin.storagecode.duplicate_csv_rank_error',
                        ['%row%' => $rowIndex],
                        'messages'
                    );
                    throw new \RuntimeException($message);
                }

                $existingByName = $this->storageCodeRepository->findOneBy(['name' => $row['名称']]);
                $rowId = isset($row['ID']) ? (int) $row['ID'] : null;
                if ($existingByName !== null && $existingByName->getId() !== $rowId) {
                    $message = $this->translator->trans(
                        'admin.storagecode.duplicate_error',
                        ['%row%' => $rowIndex],
                        'messages'
                    );
                    throw new \RuntimeException($message);
                }

                $mtbStorageCode = null;
                if ($rowId !== null && $rowId !== 0) {
                    $mtbStorageCode = $this->storageCodeRepository->find($rowId);
                }

                if ($mtbStorageCode === null) {
                    $mtbStorageCode = new MtbStorageCode();
                }

                $mtbStorageCode
                    ->setName($row['名称'])
                    ->setRank((int) $row['並び順']);

                $this->entityManager->persist($mtbStorageCode);
                $this->importedRanks[$row['並び順']] = true;

                if ($rowIndex % 100 === 0) {
                    $this->entityManager->flush();
                    $this->clearCache();
                }
                $i++;
            }

            $this->entityManager->flush();
            $this->entityManager->getConnection()->commit();
            $this->clearCache();
        } catch (\Throwable $e) {
            if ($this->entityManager->getConnection()->isTransactionActive()) {
                $this->entityManager->getConnection()->rollBack();
            }
            throw $e;
        }
    }
}
    #[Route(path: '/%eccube_admin_route%/product/storage_code/export', name: 'admin_product_storage_code_export', methods: ['GET'])]
    public function export(Request $request): StreamedResponse
    {
        $response = new StreamedResponse();
        $response->setCallback(function () {
            $this->csvExportService->fopen();
            $this->csvExportService->fputcsv(self::EXPORT_HEADER);
            $results = $this->storageCodeRepository->findBy([], ['rank' => 'ASC']);

            foreach ($results as $result) {
                $row = [
                    $result->getId(),
                    $result->getName(),
                    $result->getRank(),
                ];
                $this->csvExportService->fputcsv($row);
            }

            $this->csvExportService->fclose();
        });

        $now = new \DateTime();
        $filename = 'storage_code_'.$now->format('YmdHis').'.csv';
        $response->headers->set('Content-Type', 'application/octet-stream');
        $response->headers->set('Content-Disposition', 'attachment; filename='.$filename);

        $event = new EventArgs(
            [
                'response' => $response,
            ],
            $request
        );
        $this->eventDispatcher->dispatch($event, EccubeEvents::ADMIN_PRODUCT_STORAGE_CODE_CSV_EXPORT);

        return $response;
    }

