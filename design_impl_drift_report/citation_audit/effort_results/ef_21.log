r=json.loads((base/'effort_results/ef_21.json').read_text())
pids=[x['rowId'] for x in p['findings']]
rids=[x['rowId'] for x in r['results']]
assert p['packetId']==r['packetId']=='ef_21'
assert pids==rids, (set(pids)-set(rids),set(rids)-set(pids))
pa={x['rowId']:x['authorCat'] for x in p['findings']}
for x in r['results']:
    assert x['authorCat']==pa[x['rowId']]
    assert x['verdict'] in {'UPHELD','REFUTED','UNSURE'}
    assert (x['correctedCat'] is not None)==(x['verdict']=='REFUTED')
    assert x['confidence'] in {'high','medium','low'}
    assert isinstance(x['effortDays'],(int,float)) and x['effortDays']>=0
from collections import Counter
c=Counter(x['verdict'] for x in r['results'])
print(f\"count={len(rids)} verdicts={dict(c)} effort={sum(x['effortDays'] for x in r['results']):.2f}\")
print('refuted=' + ','.join(str(x['rowId'])+':'+x['authorCat']+'>'+x['correctedCat'] for x in r['results'] if x['verdict']=='REFUTED'))
PY

