        $data = $options['data'] ?? null;
        $EventDetail = $data instanceof DtbEventDetail ? $data : null;
        $eventDetailId = ($options['is_new'] ?? true) ? null : ($EventDetail?->getId() ?? null);

        $builder
            ->add('eventId', TextType::class, [
                'mapped' => false,
                'data' => $Event->getId(),
                'label' => 'admin.event.event_id',
                'disabled' => true,
                'attr' => ['readonly' => true],
            ])
            ->add('eventDetailId', TextType::class, [
                'mapped' => false,
                'data' => $eventDetailId,
                'label' => 'admin.event.event_detail_id',
                'disabled' => true,
                'attr' => ['readonly' => true],
            ])
            ->add('eventNameJp', TextType::class, [
                'mapped' => false,
                'data' => $Event->getNameJp(),
                'label' => 'admin.event.name_jp',
                'disabled' => true,
                'attr' => ['readonly' => true],
            ])
            ->add('repeatStartDate', DateType::class, [
                'label' => 'admin.event.repeat_schedule.period_from',
                'widget' => 'single_text',
                'constraints' => [
                    new NotBlank(),
                ],
            ])
            ->add('repeatEndDate', DateType::class, [
                'label' => 'admin.event.repeat_schedule.period_to',
                'widget' => 'single_text',
                'constraints' => [
                    new NotBlank(),
                ],
            ])
            ->add('week', ChoiceType::class, [
                'choices' => [
                    'common.weekday.mon' => 1,
                    'common.weekday.tue' => 2,
                    'common.weekday.wed' => 3,
                    'common.weekday.thu' => 4,
                    'common.weekday.fri' => 5,
                    'common.weekday.sat' => 6,
                    'common.weekday.sun' => 0,
                ],
                'multiple' => true,
