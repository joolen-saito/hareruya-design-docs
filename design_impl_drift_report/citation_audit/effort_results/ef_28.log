   199	                }
   200	
   201	                $buildEventDateTime = function (int $daysBefore, ?\DateTimeInterface $time) use ($values): ?\DateTimeInterface {
   202	                    if ($time === null) {
   203	                        return null;
   204	                    }
   205	
   206	                    return Carbon::parse($values['repeatStartDate'])
   207	                        ->subDays($daysBefore)
   208	                        ->setTimeFromTimeString($time->format('H:i:s'));
   209	                };
   210	
   211	                $eventStart = $buildEventDateTime(0, $values['startTime']);
   212	
   213	                $toComparable = function (?\DateTimeInterface $dt, bool $isTimeOnly) use ($values): ?\DateTimeInterface {
   214	                    if ($dt === null) {
   215	                        return null;
   216	                    }
   217	                    if ($isTimeOnly) {
   218	                        return Carbon::parse($values['repeatStartDate'])->setTimeFromTimeString($dt->format('H:i'));
   219	                    }
   220	
   221	                    return Carbon::parse($dt);
   222	                };
   223	
   224	                $label = fn (string $fieldName) => trans($form->get($fieldName)->getConfig()->getOption('label') ?? $fieldName);
   225	
   226	                foreach (self::DATE_RELATION_RULES as [$field, $target, $op, $msgKey]) {
   227	                    $fieldVal = $values[$field] ?? null;
   228	                    $targetVal = $values[$target] ?? null;
   229	                    if ($fieldVal === null || $targetVal === null) {
   230	                        continue;
   231	                    }
   232	
   233	                    $timeOnlyFields = [...self::TIME_ONLY_FIELDS, ...self::TIME_ONLY_FOR_COMPARISON];
   234	                    $fieldTimeOnly = in_array($field, $timeOnlyFields, true);
   235	                    $targetTimeOnly = in_array($target, $timeOnlyFields, true);
   236	                    $after = $toComparable($fieldVal, $fieldTimeOnly);
   237	                    $before = $toComparable($targetVal, $targetTimeOnly);
   238	                    if ($after === null || $before === null) {
   239	                        continue;
   240	                    }
   241	
   242	                    $valid = match ($op) {
   243	                        '<' => $after < $before,
   244	                        '<=' => $after <= $before,
   245	                    };
   246	                    if (!$valid) {
   247	                        $form->get($field)->addError(new FormError(trans($msgKey, ['%field1%' => $label($field), '%field2%' => $label($target)], 'validators')));
   248	                    }
   249	                }
