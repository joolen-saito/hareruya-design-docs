   341	    #[Route(path: '/%eccube_admin_route%/event/entry/bulk_update', name: 'admin_event_entry_bulk_update', methods: ['POST'])]
   342	    public function bulkUpdateEntryStatus(Request $request): JsonResponse
   343	    {
   344	        $form = $this->formFactory->create(EventEntryBulkUpdateType::class);
   345	        $form->handleRequest($request);
   346	
   347	        if (!$form->isSubmitted() || !$form->isValid()) {
   348	            $msg = trans('admin.common.error_invalid_request');
   349	            foreach ($form->getErrors(true) as $error) {
   350	                $msg = $error->getMessage();
   351	                break;
   352	            }
   353	
   354	            return new JsonResponse(['message' => [$msg]], Response::HTTP_BAD_REQUEST);
   355	        }
   356	
   357	        $ids = array_values(array_unique(array_filter(array_map('intval', (array) ($request->request->all()['entries'] ?? [])))));
   358	        if ($ids === []) {
   359	            return new JsonResponse(['message' => [trans('admin.event.entry.bulk_update.nothing_selected')]], Response::HTTP_BAD_REQUEST);
   360	        }
   361	
   362	        /** @var MtbEntryStatus $entryStatus */
   363	        $entryStatus = $form->get('entryStatus')->getData();
   364	
   365	        try {
   366	            $this->entryStatusBulkUpdateAction->handle(new EntryStatusBulkUpdateInput(
   367	                entryIds: $ids,
   368	                EntryStatus: $entryStatus,
   369	                Member: $this->getMember(),
   370	            ));
   371	        } catch (\InvalidArgumentException $e) {
   372	            return new JsonResponse(['message' => [$e->getMessage()]], Response::HTTP_BAD_REQUEST);
   373	        }
   374	
   375	        $event = new EventArgs(
   376	            [
   377	                'form' => $form,
   378	            ],
   379	            $request
   380	        );
