namespace Eccube\Controller\Admin\Event;

use Eccube\Controller\AbstractController;
use Eccube\Entity\DtbEvent;
use Eccube\Event\EccubeEvents;
use Eccube\Event\EventArgs;
use Eccube\Form\Type\Admin\RepeatScheduleType;
use Eccube\Service\Admin\Event\ActionInput\RepeatScheduleStoreInput;
use Eccube\Service\Admin\Event\RepeatScheduleStoreAction;
use Symfony\Bridge\Doctrine\Attribute\MapEntity;
use Symfony\Bridge\Twig\Attribute\Template;
use Symfony\Component\HttpFoundation\RedirectResponse;
use Symfony\Component\HttpFoundation\Request;
use Symfony\Component\Routing\Attribute\Route;

class RepeatScheduleController extends AbstractController
{
    public function __construct(
        private readonly RepeatScheduleStoreAction $repeatScheduleStoreAction,
    ) {
    }

    /**
     * @return RedirectResponse|array<string, mixed>
     */
    #[Route(path: '/%eccube_admin_route%/event/{eventId}/repeatSchedule/create', name: 'admin_repeat_schedule_create', requirements: ['eventId' => '\d+'], methods: ['GET', 'POST'])]
    #[Template(template: '@admin/Event/RepeatSchedule/create.twig')]
    public function create(Request $request, #[MapEntity(id: 'eventId')] DtbEvent $Event): RedirectResponse|array
    {
        $builder = $this->formFactory->createBuilder(RepeatScheduleType::class, null, ['event' => $Event, 'is_new' => true]);

        $event = new EventArgs(
            [
                'builder' => $builder,
                'Event' => $Event,
            ],
            $request
        );
        $this->eventDispatcher->dispatch($event, EccubeEvents::ADMIN_EVENT_REPEAT_SCHEDULE_CREATE_INITIALIZE);

        $form = $builder->getForm();
        $form->handleRequest($request);

        $Member = $this->getMember();
        $isEditableBaseInfo = $Event->getBaseInfo() !== null && $Member->isEditableShop($Event->getBaseInfo());
        if (!$isEditableBaseInfo) {
            $this->addError('admin.common.error_invalid_request', 'admin');

            return $this->redirectToRoute('admin_repeat_schedule_create', ['eventId' => $Event->getId()]);
        }

        if ($form->isSubmitted() && $form->isValid()) {
            $data = $form->getData();
            $input = new RepeatScheduleStoreInput(
                Event: $Event,
                formData: $data,
                Member: $this->getMember(),
            );

            try {
                $this->repeatScheduleStoreAction->handle($input);

                $event = new EventArgs(
                    [
                        'form' => $form,
                        'Event' => $Event,
                    ],
                    $request
                );
                $this->eventDispatcher->dispatch($event, EccubeEvents::ADMIN_EVENT_REPEAT_SCHEDULE_CREATE_COMPLETE);

                $this->addSuccess('admin.common.save_complete', 'admin');

                return $this->redirectToRoute('admin_event_edit', ['id' => $Event->getId()]);
            } catch (\Exception $e) {
                $this->addError('admin.common.save_error', 'admin');
            }
        }

        return [
            'form' => $form->createView(),
            'Event' => $Event,
            'isEditableBaseInfo' => $isEditableBaseInfo,
        ];
    }
}

