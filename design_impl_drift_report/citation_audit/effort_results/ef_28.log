                    if ($time === null) {
                        return null;
                    }

                    return Carbon::parse($values['repeatStartDate'])
                        ->subDays($daysBefore)
                        ->setTimeFromTimeString($time->format('H:i:s'));
                };

                $eventStart = $buildEventDateTime(0, $values['startTime']);

