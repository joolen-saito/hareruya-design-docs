     * @param array<string, mixed> $options
     */
    #[\Override]
    public function buildForm(FormBuilderInterface $builder, array $options): void
    {
        /** @var DtbEvent $Event */
        $Event = $options['data'];
        /** @var Member|null $Member */
        $Member = $options['Member'] ?? null;

        $hasEntry = $Event->getDetails()->exists(fn (int $key, DtbEventDetail $EventDetail) => $EventDetail->getEventEntries()->count() > 0);
        $paymentsFormData = [];
        foreach ($Event->getPayments() as $p) {
            if ($p->getId() === Payment::EC_CREDIT) {
                $paymentsFormData[] = Payment::EC_CREDIT;
            }
        }

        $builder
            ->add('nameJp', TextType::class, [
                'constraints' => [
                    new NotBlank(),
                    new Length(['max' => $this->eccubeConfig['eccube_stext_len']]),
                ],
            ])
            ->add('nameEn', TextType::class, [
                'constraints' => [
                    new NotBlank(),
                    new Length(['max' => $this->eccubeConfig['eccube_stext_len']]),
                ],
            ])
            ->add('baseInfo', EntityType::class, [
                'class' => BaseInfo::class,
                'query_builder' => fn (EntityRepository $er) => $er->createQueryBuilder('b')
                    ->orderBy('b.id', 'ASC'),
            ])
            ->add('formats', EntityType::class, [
                'class' => MtbFormat::class,
                'multiple' => true,
                'expanded' => false,
                'query_builder' => fn (EntityRepository $er) => $er->createQueryBuilder('f')
                    ->orderBy('f.id', 'ASC'),
            ])
            ->add('eventScale', EntityType::class, [
                'class' => MtbEventScale::class,
                'expanded' => false,
                'multiple' => false,
                'constraints' => [
                    new NotBlank(),
                ],
                'query_builder' => fn (EntityRepository $er) => $er->createQueryBuilder('e')
                    ->orderBy('e.id', 'ASC'),
            ])
            ->add('rel', EntityType::class, [
                'class' => MtbRel::class,
                'constraints' => [
                    new NotBlank(),
                ],
                'query_builder' => fn (EntityRepository $er) => $er->createQueryBuilder('r')
                    ->orderBy('r.id', 'ASC'),
            ])
            ->add('disp', EntityType::class, [
                'class' => MtbDisp::class,
                'expanded' => false,
                'constraints' => [
                    new NotBlank(),
                ],
                'query_builder' => fn (EntityRepository $er) => $er->createQueryBuilder('d')
                    ->orderBy('d.id', 'ASC'),
            ])
            ->add('bannerUrl', TextType::class, [
                'required' => false,
                'constraints' => [
                    new Length(['max' => $this->eccubeConfig['eccube_stext_len']]),
                    new Regex([
                        'pattern' => '/admin\.hareruyamtg\.com/',
                        'match' => false,
                        'message' => 'admin.banner.regex_error',
                    ]),
                ],
            ])
            ->add('bannerEnUrl', TextType::class, [
                'required' => false,
                'constraints' => [
                    new Length(['max' => $this->eccubeConfig['eccube_stext_len']]),
                    new Regex([
                        'pattern' => '/admin\.hareruyamtg\.com/',
                        'match' => false,
                        'message' => 'admin.banner.regex_error',
                    ]),
                ],
            ])
            ->add('capacity', IntegerType::class, [
                'constraints' => [
                    new Range(['min' => $this->eccubeConfig['eccube_capacity_min']]),
                    new Length(['max' => $this->eccubeConfig['eccube_int_len']]),
                ],
            ])
            ->add('isTeamBattle', CheckboxType::class, [
                'required' => false,
                'label' => 'admin.event.is_team_battle',
            ])
            ->add('payments', ChoiceType::class, [
                'required' => false,
                'mapped' => false,
                'expanded' => true,
                'multiple' => true,
                'data' => $paymentsFormData,
                'disabled' => $hasEntry,
                'choices' => [
                    Payment::EC_CREDIT_METHOD => Payment::EC_CREDIT,
                ],
            ])
            ->add('entryFee', IntegerType::class, [
                'constraints' => [
                    new Length(['max' => $this->eccubeConfig['eccube_price_len']]),
                    new PositiveOrZero(),
                ],
            ])
            ->add('prizeJp', TextareaType::class, [
                'required' => false,
                'constraints' => [
                    new Length(['max' => $this->eccubeConfig['eccube_construct_format_board_max_card_count']]),
                ],
            ])
            ->add('prizeEn', TextareaType::class, [
                'required' => false,
                'constraints' => [
                    new Length(['max' => $this->eccubeConfig['eccube_construct_format_board_max_card_count']]),
                ],
            ])
            ->add('freeTextArea1LabelJp', TextType::class, [
                'required' => false,
                'constraints' => [
                    new Length(['max' => $this->eccubeConfig['eccube_stext_len']]),
                ],
            ])
            ->add('freeTextArea1LabelEn', TextType::class, [
                'required' => false,
                'constraints' => [
                    new Length(['max' => $this->eccubeConfig['eccube_stext_len']]),
                ],
            ])
            ->add('freeTextArea1ContentJp', TextareaType::class, [
                'required' => false,
                'constraints' => [
                    new Length(['max' => $this->eccubeConfig['eccube_construct_format_board_max_card_count']]),
                ],
            ])
            ->add('freeTextArea1ContentEn', TextareaType::class, [
                'required' => false,
                'constraints' => [
                    new Length(['max' => $this->eccubeConfig['eccube_construct_format_board_max_card_count']]),
                ],
            ])
            ->add('isFreeTextArea1Accordion', CheckboxType::class, [
                'required' => false,
                'label' => 'admin.event.free_text_area_accordion',
            ])
            ->add('freeTextArea2LabelJp', TextType::class, [
                'required' => false,
                'constraints' => [
                    new Length(['max' => $this->eccubeConfig['eccube_stext_len']]),
                ],
            ])
            ->add('freeTextArea2LabelEn', TextType::class, [
                'required' => false,
                'constraints' => [
                    new Length(['max' => $this->eccubeConfig['eccube_stext_len']]),
                ],
            ])
            ->add('freeTextArea2ContentJp', TextareaType::class, [
                'required' => false,
                'constraints' => [
                    new Length(['max' => $this->eccubeConfig['eccube_construct_format_board_max_card_count']]),
                ],
            ])
            ->add('freeTextArea2ContentEn', TextareaType::class, [
                'required' => false,
                'constraints' => [
                    new Length(['max' => $this->eccubeConfig['eccube_construct_format_board_max_card_count']]),
                ],
            ])
            ->add('isFreeTextArea2Accordion', CheckboxType::class, [
                'required' => false,
                'label' => 'admin.event.free_text_area_accordion',
            ])
            ->add('freeTextArea3LabelJp', TextType::class, [
                'required' => false,
                'constraints' => [
                    new Length(['max' => $this->eccubeConfig['eccube_stext_len']]),
                ],
            ])
            ->add('freeTextArea3LabelEn', TextType::class, [
                'required' => false,
                'constraints' => [
                    new Length(['max' => $this->eccubeConfig['eccube_stext_len']]),
                ],
            ])
            ->add('freeTextArea3ContentJp', TextareaType::class, [
                'required' => false,
                'constraints' => [
                    new Length(['max' => $this->eccubeConfig['eccube_construct_format_board_max_card_count']]),
                ],
            ])
            ->add('freeTextArea3ContentEn', TextareaType::class, [
                'required' => false,
                'constraints' => [
                    new Length(['max' => $this->eccubeConfig['eccube_construct_format_board_max_card_count']]),
                ],
            ])
            ->add('isFreeTextArea3Accordion', CheckboxType::class, [
                'required' => false,
                'label' => 'admin.event.free_text_area_accordion',
            ])
            ->addEventListener(FormEvents::POST_SUBMIT, function (FormEvent $event) use ($Member): void {
                $form = $event->getForm();
                /** @var DtbEvent $Event */
                $Event = $form->getData();

                // 支払方法をオフで更新しようとした時は、紐づく日程データをチェックし、
                // 参加費が有料かつオンライン受付がありの日程が存在する場合はエラーとする。
                // （新規作成時は日程がないためスキップ。getId()は未初期化でエラーになるため使用しない）
                if ($Event->getDetails()->count() > 0) {
                    $paymentIds = $form->get('payments')->getData() ?? [];
                    if ($form->isSubmitted() && $paymentIds === []) {
                        $hasPaidOnlineEntrySchedule = $Event->getDetails()->exists(
                            fn (int $key, DtbEventDetail $EventDetail) => $EventDetail->getOnlineEntryStartDate() !== null && ($EventDetail->getEntryFee() ?? 0) > 0
                        );
                        if ($hasPaidOnlineEntrySchedule) {
                            $form->get('payments')->addError(new FormError(trans('form_error.payment_off_paid_online_schedule_error', [], 'validators')));
                        }
                    }
                }

                // ログインユーザー編集可能店舗のイベントのみ、登録可能
                $BaseInfo = $Event->getBaseInfo();
                if ($BaseInfo !== null && $Member !== null) {
                    if (!$Member->isEditableShop($BaseInfo)) {
                        $form->get('baseInfo')->addError(new FormError(trans('form_error.event_not_editable', [], 'validators')));
                    }
                }
            })
        ;
    }

    /**
     * {@inheritdoc}
     */
    #[\Override]
    public function configureOptions(OptionsResolver $resolver): void
    {
        $resolver->setDefaults([
            'data_class' => DtbEvent::class,
            'Member' => null,
        ]);
    }

    /**
     * {@inheritdoc}
     */
    #[\Override]
    public function getBlockPrefix(): string
    {
        return 'admin_event';
    }
}
