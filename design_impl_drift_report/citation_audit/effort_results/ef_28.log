   265	    /**
   266	     * イベント申込詳細・編集（GET: 表示、POST: 更新）
   267	     *
   268	     * @return RedirectResponse|array<string, mixed>
   269	     */
   270	    #[Route(path: '/%eccube_admin_route%/event/entry/{eventEntry}/edit', name: 'admin_event_entry_edit', requirements: ['eventEntry' => '\d+'], methods: ['GET', 'POST'])]
   271	    #[Template(template: '@admin/Event/EntryRegistration/edit.twig')]
   272	    public function edit(Request $request, #[MapEntity(id: 'eventEntry')] DtbEventEntry $eventEntry): RedirectResponse|array
   273	    {
   274	        $baseInfo = $eventEntry->getEventDetail()->getEvent()->getBaseInfo();
   275	        if ($baseInfo === null || !$this->getMember()->isEditableShop($baseInfo)) {
   276	            throw $this->createNotFoundException();
   277	        }
   278	
   279	        $form = $this->formFactory->create(EventEntryDetailType::class, $eventEntry, [
   280	            'registration_mode' => false,
   281	            'entry_status_editable' => true,
   282	        ]);
   283	        $form->get('eventDetailId')->setData((string) $eventEntry->getEventDetail()->getId());
   284	        $form->get('eventEntryId')->setData((string) $eventEntry->getId());
   285	
   286	        $event = new EventArgs(
   287	            [
   288	                'form' => $form,
   289	                'EventEntry' => $eventEntry,
   290	            ],
   291	            $request
   292	        );
   293	        $this->eventDispatcher->dispatch($event, EccubeEvents::ADMIN_EVENT_ENTRY_EDIT_INITIALIZE);
   294	
   295	        $form->handleRequest($request);
   296	
   297	        if ($form->isSubmitted() && $form->isValid()) {
   298	            $submittedPlayerId = (int) $form->get('entryPlayer')->getData();
   299	
   300	            try {
   301	                $input = new EntryUpdateInput(
   302	                    EventEntry: $eventEntry,
   303	                    Member: $this->getMember(),
   304	                    playerId: $submittedPlayerId,
   305	                );
   306	                $this->entryUpdateAction->handle($input);
   307	
   308	                $event = new EventArgs(
   309	                    [
   310	                        'form' => $form,
   311	                        'EventEntry' => $eventEntry,
   312	                    ],
   313	                    $request
   314	                );
   315	                $this->eventDispatcher->dispatch($event, EccubeEvents::ADMIN_EVENT_ENTRY_EDIT_COMPLETE);
   316	
   317	                $this->addSuccess('admin.common.save_complete', 'admin');
   318	
   319	                return $this->redirectToRoute('admin_event_entry_edit', ['eventEntry' => $eventEntry->getId()]);
   320	            } catch (\InvalidArgumentException $e) {
   321	                $this->addError($e->getMessage(), 'admin');
   322	            } catch (\Exception $e) {
   323	                $this->addError('admin.common.save_error', 'admin');
   324	            }
   325	        }
   326	
   327	        $players = $eventEntry->getEntryPlayers();
   328	        if ($players->isEmpty()) {
   329	            throw $this->createNotFoundException();
   330	        }
   331	        $entryPlayer = $players->first();
   332	
   333	        return [
   334	            'form' => $form->createView(),
   335	            'eventEntry' => $eventEntry,
   336	            'entryPlayer' => $entryPlayer,
   337	            'seatNames' => [],
   338	        ];
   339	    }
