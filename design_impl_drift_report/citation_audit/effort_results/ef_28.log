        // オンライン受付開始時間 < オンライン受付終了時間
        ['onlineEntryStartDate', 'onlineEntryEndDate', '<', 'form_error.schedule_date_before'],
        // オンライン受付終了時間 < 開始時間
        ['onlineEntryEndDate', 'startDate', '<', 'form_error.schedule_date_before'],
    ];

