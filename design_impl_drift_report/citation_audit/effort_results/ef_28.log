namespace Eccube\Controller\Admin\Event;

use Eccube\Controller\AbstractController;
use Eccube\Entity\DtbEvent;
use Eccube\Entity\DtbEventDetail;
use Eccube\Event\EccubeEvents;
use Eccube\Event\EventArgs;
use Eccube\Form\Type\Admin\ScheduleType;
use Eccube\Service\Admin\Event\ActionInput\ScheduleStoreInput;
use Eccube\Service\Admin\Event\ActionInput\ScheduleUpdateInput;
use Eccube\Service\Admin\Event\ScheduleStoreAction;
use Eccube\Service\Admin\Event\ScheduleUpdateAction;
use Symfony\Bridge\Doctrine\Attribute\MapEntity;
use Symfony\Bridge\Twig\Attribute\Template;
use Symfony\Component\HttpFoundation\RedirectResponse;
use Symfony\Component\HttpFoundation\Request;
use Symfony\Component\Routing\Attribute\Route;

class ScheduleController extends AbstractController
{
    public function __construct(
        private readonly ScheduleStoreAction $scheduleStoreAction,
        private readonly ScheduleUpdateAction $scheduleUpdateAction,
    ) {
    }

    /**
     * スケジュール新規登録（GET: フォーム表示、POST: 登録処理）
     *
     * @return RedirectResponse|array<string, mixed>
     */
    #[Route(path: '/%eccube_admin_route%/event/{eventId}/schedule/create', name: 'admin_schedule_create', requirements: ['eventId' => '\d+'], methods: ['GET', 'POST'])]
    #[Template(template: '@admin/Event/Schedule/edit.twig')]
    public function create(Request $request, #[MapEntity(id: 'eventId')] DtbEvent $Event): RedirectResponse|array
    {
        $EventDetail = new DtbEventDetail($Event);

        $builder = $this->formFactory->createBuilder(ScheduleType::class, $EventDetail, ['event' => $Event, 'is_new' => true]);

        $event = new EventArgs(
            [
                'builder' => $builder,
                'Event' => $Event,
            ],
            $request
        );
        $this->eventDispatcher->dispatch($event, EccubeEvents::ADMIN_EVENT_SCHEDULE_CREATE_INITIALIZE);

        $form = $builder->getForm();
        $form->handleRequest($request);

        if ($form->isSubmitted() && $form->isValid()) {
            /** @var DtbEventDetail $FormEventDetail */
            $FormEventDetail = $form->getData();
            $input = new ScheduleStoreInput($Event, $FormEventDetail, $this->getMember());

            try {
                $EventDetail = $this->scheduleStoreAction->handle($input);

                $event = new EventArgs(
                    [
                        'form' => $form,
                        'Event' => $Event,
                    ],
                    $request
                );
                $this->eventDispatcher->dispatch($event, EccubeEvents::ADMIN_EVENT_SCHEDULE_CREATE_COMPLETE);

                $this->addSuccess('admin.common.save_complete', 'admin');

                return $this->redirectToRoute('admin_schedule_edit', ['eventId' => $Event->getId(), 'eventDetailId' => $EventDetail->getId()]);
            } catch (\Exception $e) {
                $this->addError('admin.common.save_error', 'admin');
            }
        }

        $Member = $this->getMember();
        $isEditableBaseInfo = $Event->getBaseInfo() && $Member->isEditableShop($Event->getBaseInfo());

        return [
            'form' => $form->createView(),
            'Event' => $Event,
            'EventDetail' => $EventDetail,
            'isNew' => true,
            'isEditableBaseInfo' => $isEditableBaseInfo,
        ];
    }

    /**
     * スケジュール編集（GET: フォーム表示、POST: 更新処理）
     *
     * @return RedirectResponse|array<string, mixed>
     */
    #[Route(path: '/%eccube_admin_route%/event/{eventId}/schedule/{eventDetailId}/edit', name: 'admin_schedule_edit', requirements: ['eventId' => '\d+', 'eventDetailId' => '\d+'], methods: ['GET', 'POST'])]
    #[Template(template: '@admin/Event/Schedule/edit.twig')]
    public function edit(Request $request, #[MapEntity(id: 'eventId')] DtbEvent $Event, #[MapEntity(id: 'eventDetailId')] DtbEventDetail $EventDetail): RedirectResponse|array
    {
        if ($EventDetail->getEvent()->getId() !== $Event->getId()) {
            $this->addError('admin.common.error_invalid_request', 'admin');

            return $this->redirectToRoute('admin_event_edit', ['id' => $Event->getId()]);
        }

        $builder = $this->formFactory->createBuilder(ScheduleType::class, $EventDetail, ['event' => $Event, 'is_new' => false]);

        $event = new EventArgs(
            [
                'builder' => $builder,
                'Event' => $Event,
            ],
            $request
        );
        $this->eventDispatcher->dispatch($event, EccubeEvents::ADMIN_EVENT_SCHEDULE_EDIT_INITIALIZE);

        $form = $builder->getForm();
        $form->handleRequest($request);

        if ($form->isSubmitted() && $form->isValid()) {
            /** @var DtbEventDetail $EventDetail */
            $EventDetail = $form->getData();
            $input = new ScheduleUpdateInput($EventDetail, $this->getMember());

            try {
                $this->scheduleUpdateAction->handle($input);

                $event = new EventArgs(
                    [
                        'form' => $form,
                        'Event' => $Event,
                    ],
                    $request
                );
                $this->eventDispatcher->dispatch($event, EccubeEvents::ADMIN_EVENT_SCHEDULE_EDIT_COMPLETE);

                $this->addSuccess('admin.common.save_complete', 'admin');
            } catch (\Exception $e) {
                $this->addError('admin.common.save_error', 'admin');
            }
        }

        $Member = $this->getMember();
        $isEditableBaseInfo = $Event->getBaseInfo() && $Member->isEditableShop($Event->getBaseInfo());

        return [
            'form' => $form->createView(),
            'Event' => $Event,
            'EventDetail' => $EventDetail,
            'isNew' => false,
            'isEditableBaseInfo' => $isEditableBaseInfo,
        ];
    }

    /**
     * スケジュール削除（デッキ登録・申込がある場合は削除不可）
     */
    #[Route(path: '/%eccube_admin_route%/event/{eventId}/schedule/{eventDetailId}/delete', name: 'admin_schedule_delete', requirements: ['eventId' => '\d+', 'eventDetailId' => '\d+'], methods: ['DELETE'])]
    public function delete(Request $request, #[MapEntity(id: 'eventId')] DtbEvent $Event, #[MapEntity(id: 'eventDetailId')] DtbEventDetail $EventDetail): RedirectResponse
    {
        $isEditableShop = $this->getMember()->isEditableShop($Event->getBaseInfo());
        if (!$isEditableShop) {
            $this->addError('admin.common.error_invalid_request', 'admin');

            return $this->redirectToRoute('admin_event_edit', ['id' => $Event->getId()]);
        }

        if ($EventDetail->getEvent()->getId() !== $Event->getId()) {
            $this->addError('admin.common.error_invalid_request', 'admin');

            return $this->redirectToRoute('admin_event_edit', ['id' => $Event->getId()]);
        }

        if ($EventDetail->getDecks()->count() > 0) {
            $this->addError('admin.event.delete.deckerror', 'admin');

            return $this->redirectToRoute('admin_event_edit', ['id' => $Event->getId()]);
        }

        if ($EventDetail->getEventEntries()->count() > 0) {
            $this->addError('admin.event.delete.entryerror', 'admin');

            return $this->redirectToRoute('admin_event_edit', ['id' => $Event->getId()]);
        }

        $Event->getDetails()->removeElement($EventDetail);
        $this->entityManager->remove($EventDetail);
        $this->entityManager->flush();

        $event = new EventArgs(
            [
                'Event' => $Event,
            ],
            $request
        );
        $this->eventDispatcher->dispatch($event, EccubeEvents::ADMIN_EVENT_SCHEDULE_DELETE_COMPLETE);

        $this->addSuccess('admin.common.delete_complete', 'admin');

        return $this->redirectToRoute('admin_event_edit', ['id' => $Event->getId()]);
    }

    /**
     * スケジュール一括削除
     */
    #[Route(path: '/%eccube_admin_route%/event/{eventId}/schedule/bulk_delete', name: 'admin_schedule_bulk_delete', requirements: ['eventId' => '\d+'], methods: ['POST'])]
    public function bulkDelete(Request $request, #[MapEntity(id: 'eventId')] DtbEvent $Event): RedirectResponse
    {
        $this->isTokenValid();

        $isEditableShop = $this->getMember()->isEditableShop($Event->getBaseInfo());
        if (!$isEditableShop) {
            $this->addError('admin.common.error_invalid_request', 'admin');

            return $this->redirectToRoute('admin_event_edit', ['id' => $Event->getId()]);
        }

        $ids = $request->request->all('event_detail_ids');
        if ($ids === []) {
            $this->addError('admin.event.schedule.bulk_delete.nothing_selected', 'admin');

            return $this->redirectToRoute('admin_event_edit', ['id' => $Event->getId()]);
        }

        $deletedCount = 0;
        foreach ($ids as $eventDetailId) {
            $EventDetail = $this->entityManager->getRepository(DtbEventDetail::class)->find((int) $eventDetailId);
            if ($EventDetail === null || $EventDetail->getEvent()->getId() !== $Event->getId()) {
                continue;
            }
            if ($EventDetail->getDecks()->count() > 0 || $EventDetail->getEventEntries()->count() > 0) {
                $this->addError($this->translator->trans('admin.event.schedule.bulk_delete.error', ['%count%' => 1]), 'admin');

                return $this->redirectToRoute('admin_event_edit', ['id' => $Event->getId()]);
            }
            $Event->getDetails()->removeElement($EventDetail);
            $this->entityManager->remove($EventDetail);
            $deletedCount++;
        }

        if ($deletedCount > 0) {
            $this->entityManager->flush();

            $event = new EventArgs(
                [
                    'Event' => $Event,
                ],
                $request
            );
            $this->eventDispatcher->dispatch($event, EccubeEvents::ADMIN_EVENT_SCHEDULE_BULK_DELETE_COMPLETE);

            $this->addSuccess($this->translator->trans('admin.event.schedule.bulk_delete.complete', ['%count%' => $deletedCount]), 'admin');
        }

        return $this->redirectToRoute('admin_event_edit', ['id' => $Event->getId()]);
    }
}
