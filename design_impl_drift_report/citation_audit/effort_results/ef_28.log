class RepeatScheduleType extends AbstractType
{
    private const TIME_ONLY_FIELDS = ['entryStartTime', 'entryEndTime', 'startTime'];
    private const TIME_ONLY_FOR_COMPARISON = [];
    private const DATE_FIELDS = ['repeatStartDate', 'repeatEndDate', 'startTime', 'entryStartTime', 'entryEndTime'];

    private const DATE_RELATION_RULES = [
        ['repeatStartDate', 'repeatEndDate', '<', 'form_error.schedule_date_before'],
        ['entryStartTime', 'entryEndTime', '<', 'form_error.schedule_date_before'],
        ['entryEndTime', 'startTime', '<=', 'form_error.schedule_date_before'],
    ];

    public function __construct(
