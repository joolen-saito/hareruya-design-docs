    #[\Override]
    public function buildForm(FormBuilderInterface $builder, array $options): void
    {
        /** @var BaseInfo $BaseInfo */
        $BaseInfo = $options['BaseInfo'];
        /** @var list<BaseInfo> $editableBaseInfos */
        $editableBaseInfos = $options['editableBaseInfos'];
        $allBaseInfos = $editableBaseInfos !== [] ? $editableBaseInfos : [$BaseInfo];

        $approvalConstraints = $options['approval_notification_required']
            ? [new NotBlank(['message' => 'admin.stock.split_join.form.approval_notification_target_required'])]
            : [];

        $builder
            ->add('store', ChoiceType::class, [
                'label' => 'admin.stock.split_csv_modal.store',
                'required' => true,
                'placeholder' => 'admin.stock.split_csv_modal.store_placeholder',
                'choices' => $this->getStoreChoices($allBaseInfos),
            ])
            ->add('inventory_category', ChoiceType::class, [
                'label' => 'admin.stock.split_csv_modal.inventory_category',
                'required' => true,
                'expanded' => true,
                'choices' => [
                    'admin.stock.split_join.inventory_category_ec_cube' => self::INVENTORY_CATEGORY_EC_CUBE,
                    'admin.stock.split_join.inventory_category_smaregi' => self::INVENTORY_CATEGORY_SMAREGI,
                ],
                'choice_translation_domain' => 'messages',
                'constraints' => [new NotBlank(['message' => 'admin.stock.split_csv_modal.inventory_category_required'])],
            ])
            ->add('approval_department', ChoiceType::class, [
                'label' => 'admin.stock.split_join.form.approval_department',
                'required' => false,
                'mapped' => false,
                'choices' => $this->getDepartmentChoices($allBaseInfos[0]),
                'placeholder' => 'admin.common.select__unspecified',
            ])
            ->add('approval_notification_target_members', ChoiceType::class, [
                'label' => false,
                'required' => false,
                'multiple' => true,
                'choices' => $this->buildMemberChoices($allBaseInfos[0]),
                'choice_attr' => function (string $choice, string $key, mixed $value) {
                    $Member = $this->memberRepository->find((int) $value);
                    $dept = $Member?->getDepartment()?->getName() ?? '';

                    return ['data-department' => $dept];
                },
                'placeholder' => 'admin.stock.form.approval_members_empty',
                'empty_data' => [],
                'constraints' => $approvalConstraints,
            ])
            ->add('import_file', FileType::class, [
