    /**
     * @param list<string> $headers
     */
    private function buildCsvTemplateResponse(array $headers, string $filename): StreamedResponse
    {
        $out = fopen('php://temp', 'r+');
        if ($out === false) {
            throw new \RuntimeException('Failed to open temp stream.');
        }
        fputcsv($out, $headers, ',', '"', '\\');
        rewind($out);
        $content = stream_get_contents($out);
        fclose($out);
        $response = new StreamedResponse(function () use ($content): void {
            echo "\xEF\xBB\xBF".($content !== false ? $content : '');
        });
        $response->headers->set('Content-Type', 'application/octet-stream');
        $response->headers->set('Content-Disposition', 'attachment; filename="'.$filename.'"');

        return $response;
    }

    #[Route(path: '/%eccube_admin_route%/product/stock/split-join/csv-export', name: 'admin_stock_split_join_csv_export', methods: ['GET'])]
    public function csvExport(Request $request): StreamedResponse
    {
        $viewData = $request->getSession()->get(StockSplitJoinIndexAction::SESSION_KEY_SEARCH, []);
        $searchForm = $this->formFactory->createBuilder(SearchStockSplitJoinType::class)->getForm();
        FormUtil::submitAndGetData($searchForm, $viewData);
        $raw = $searchForm->getData();
        $searchData = \is_array($raw) ? $raw : [];

        $response = $this->stockSplitJoinCsvExportService->exportBySearchData($searchData);

        $event = new EventArgs(
            [
                'response' => $response,
                'searchData' => $searchData,
            ],
            $request
        );
        $this->eventDispatcher->dispatch($event, EccubeEvents::ADMIN_STOCK_SPLIT_JOIN_CSV_EXPORT);

        return $response;
    }

    #[Route(path: '/%eccube_admin_route%/product/stock/split-join/list-split-csv-import', name: 'admin_stock_split_join_list_split_csv_import', methods: ['POST'])]
    public function listSplitCsvImport(Request $request): RedirectResponse
    {
        $csvBag = $request->request->all('admin_stock_split_csv_upload');
        $token = isset($csvBag['_token']) ? (string) $csvBag['_token'] : '';
        if (!$this->isCsrfTokenValid('admin_stock_split_csv_upload', $token)) {
            $this->addError('admin.common.csrf_invalid', 'admin');

            return $this->redirectToRoute('admin_stock_split_join_list');
        }

        $splitFiles = $request->files->get('admin_stock_split_csv_upload');
        $file = \is_array($splitFiles) ? ($splitFiles['import_file'] ?? null) : null;
        if (!$file instanceof UploadedFile || !$file->isValid()) {
            $this->addError(trans('admin.common.csv_upload_error'), 'admin');

            return $this->redirectToRoute('admin_stock_split_join_list');
        }

        $storeId = isset($csvBag['store']) ? (int) $csvBag['store'] : 0;
        $BaseInfo = $storeId > 0 ? $this->baseInfoRepository->find($storeId) : $this->baseInfoRepository->get();
        if ($BaseInfo === null) {
            $this->addError(trans('admin.common.csv_upload_error'), 'admin');

            return $this->redirectToRoute('admin_stock_split_join_list');
        }

        $stockLocationId = isset($csvBag['inventory_category']) ? (int) $csvBag['inventory_category'] : 0;
        $allowedInventoryIds = [StockSplitCsvUploadType::INVENTORY_CATEGORY_EC_CUBE, StockSplitCsvUploadType::INVENTORY_CATEGORY_SMAREGI];
        if (!in_array($stockLocationId, $allowedInventoryIds, true)) {
            $this->addError(trans('admin.common.csv_upload_error'), 'admin');

            return $this->redirectToRoute('admin_stock_split_join_list');
        }

        $Member = $this->getUser();
        if (!$Member instanceof Member) {
            $this->addError(trans('admin.stock.split.login_required'), 'admin');

            return $this->redirectToRoute('admin_stock_split_join_list');
        }

        $handler = new StockSplitListCsvImportHandler(
            $this->productStockRepository,
            $this->stockSplitRegisterAction,
            $this->stockSplitApplyApprovalAction,
            $this->entityManager,
            $BaseInfo,
            $stockLocationId,
            $Member,
        );

        $importer = new CsvImporter(
            $this->entityManager,
            $this->translator,
            $this->eccubeConfig,
            $handler,
            $Member,
        );

        try {
            $result = $importer->import($file);
        } catch (\Throwable $e) {
            $detail = sprintf('[%s] %s', get_class($e), $e->getMessage());
            log_error('在庫分割CSV取り込みに失敗しました: '.$detail, [$e]);
            error_log('在庫分割CSV取り込みエラー: '.$detail.' in '.$e->getFile().':'.$e->getLine());
            $this->addError(trans('admin.common.csv_import_error').': '.$detail, 'admin');

            return $this->redirectToRoute('admin_stock_split_join_list');
        }

        foreach ($result->getErrors() as $error) {
            $this->addError($error['message'], 'admin');
        }
        foreach ($handler->getFlashErrors() as $msg) {
            $this->addError($msg, 'admin');
        }
        foreach ($handler->getFlashSuccesses() as $msg) {
            $this->addSuccess($msg, 'admin');
        }

        // 承認通知先メールの送信（取り込み成功時のみ）
        if ($handler->getFlashSuccesses() !== []) {
            $this->sendApprovalNotificationMails($csvBag['approval_notification_target_members'] ?? []);
        }

        $event = new EventArgs([], $request);
        $this->eventDispatcher->dispatch($event, EccubeEvents::ADMIN_STOCK_SPLIT_JOIN_LIST_SPLIT_CSV_IMPORT_COMPLETE);

        return $this->redirectToRoute('admin_stock_split_join_list');
    }

    #[Route(path: '/%eccube_admin_route%/product/stock/split-join/list-join-csv-import', name: 'admin_stock_split_join_list_join_csv_import', methods: ['POST'])]
    public function listJoinCsvImport(Request $request): RedirectResponse
    {
        $csvBag = $request->request->all('admin_stock_join_csv_upload');
        $token = isset($csvBag['_token']) ? (string) $csvBag['_token'] : '';
        if (!$this->isCsrfTokenValid('admin_stock_join_csv_upload', $token)) {
            $this->addError('admin.common.csrf_invalid', 'admin');

            return $this->redirectToRoute('admin_stock_split_join_list');
        }

        $joinFiles = $request->files->get('admin_stock_join_csv_upload');
        $file = \is_array($joinFiles) ? ($joinFiles['import_file'] ?? null) : null;
        if (!$file instanceof UploadedFile || !$file->isValid()) {
            $this->addError(trans('admin.common.csv_upload_error'), 'admin');

            return $this->redirectToRoute('admin_stock_split_join_list');
        }

        $storeId = isset($csvBag['store']) ? (int) $csvBag['store'] : 0;
        $BaseInfo = $storeId > 0 ? $this->baseInfoRepository->find($storeId) : $this->baseInfoRepository->get();
        if ($BaseInfo === null) {
            $this->addError(trans('admin.common.csv_upload_error'), 'admin');

            return $this->redirectToRoute('admin_stock_split_join_list');
        }

        $destinationStockLocationId = isset($csvBag['inventory_category']) ? (int) $csvBag['inventory_category'] : 0;
        if ($destinationStockLocationId < 1) {
            $this->addError(trans('admin.common.csv_upload_error'), 'admin');

            return $this->redirectToRoute('admin_stock_split_join_list');
        }

        $Member = $this->getUser();
        if (!$Member instanceof Member) {
            $this->addError(trans('admin.stock.split.login_required'), 'admin');

            return $this->redirectToRoute('admin_stock_split_join_list');
        }

        $handler = new StockJoinListCsvImportHandler(
            $this->productStockRepository,
            $this->stockJoinRegisterAction,
            $this->stockJoinMoveToShortageEntryAction,
            $this->entityManager,
            $BaseInfo,
            $destinationStockLocationId,
            $Member,
        );

        $event = new EventArgs([], $request);
        $this->eventDispatcher->dispatch($event, EccubeEvents::ADMIN_STOCK_SPLIT_JOIN_LIST_JOIN_CSV_IMPORT_COMPLETE);

        return $this->redirectToRoute('admin_stock_split_join_list');
    }

    /**
     * 承認通知先メンバーにメールを送信する。
     *
     * @param mixed $rawIds POST データから取得したメンバー ID 配列
     */
    private function sendApprovalNotificationMails(mixed $rawIds): void
    {
        if (!\is_array($rawIds) || $rawIds === []) {
            return;
        }

        $approvalUrl = $this->generateUrl('admin_stock_split_join_list', [], UrlGeneratorInterface::ABSOLUTE_URL);

        foreach ($rawIds as $approvalMemberId) {
            $approvalMember = $this->entityManager->getReference(Member::class, (int) $approvalMemberId);
            $this->mailService->sendStockApprovalAlertMail($approvalMember, $approvalUrl);
        }
    }

