            $dept = $Member->getDepartment();
            $deptName = $dept !== null ? $dept->getName() : null;
            $deptId = $dept !== null ? (string) $dept->getId() : '0';

            // 選択肢ラベルの同名 ID 補完
            $label = $name;
            if (isset($seenOptionLabels[$label])) {
                $label .= '(ID:'.$memberId.')';
            } else {
                $seenOptionLabels[$label] = true;
            }
            $options[] = ['value' => $memberId, 'label' => $label];

            // マトリクス（チップ UI 表示名）の同名 ID 補完はグローバルで判定
            $nameKey = $name;
            $displayName = $name;
            if (isset($seenMatrixNames[$nameKey])) {
                $displayName = $name.'(ID:'.$memberId.')';
            } else {
                $seenMatrixNames[$nameKey] = true;
