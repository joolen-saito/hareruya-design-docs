<script>
(function () {
    const $membersSelect = $('#{{ form.approval_notification_target_members.vars.id }}');
    {% if form.approval_department is defined %}
    const $deptSelect = $('#{{ form.approval_department.vars.id }}');
    {% endif %}

    const initialSelected = $membersSelect.val() || [];

    const allMembers = [];
    $membersSelect.find('option[value!=""]').each(function () {
        const $opt = $(this);
        allMembers.push({
            value: $opt.val(),
            text: $opt.text(),
            departmentId: $opt.data('department'),
        });
        {% if form.approval_department is defined %}
        $opt.remove();
        {% endif %}
    });

    $membersSelect.select2({ width: '100%', placeholder: '{{ 'common.select__unspecified'|trans }}' });

    {% if form.approval_department is defined %}
    function repopulateMembers(selectedDept, previousSelected) {
        previousSelected = previousSelected || [];
        $membersSelect.find('option[value!=""]').remove();

        allMembers.forEach(function (member) {
            if (!selectedDept || member.departmentId === selectedDept) {
                $membersSelect.append(
                    $('<option>').attr('value', member.value).text(member.text).attr('data-department-id', member.departmentId)
                );
            }
        });

        $membersSelect.select2({ width: '100%', placeholder: '{{ 'common.select__unspecified'|trans }}' });

        if (previousSelected.length > 0) {
            const available = $membersSelect.find('option[value!=""]').map(function () { return $(this).val(); }).get();
            const toRestore = previousSelected.filter(function (id) { return available.indexOf(id) !== -1; });
            if (toRestore.length > 0) {
                $membersSelect.val(toRestore).trigger('change');
            }
        }
    }

    $deptSelect.on('change', function () {
        const selectedDept = $(this).val() || null;
        repopulateMembers(selectedDept, $membersSelect.val() || []);
    });

    const initialDept = $deptSelect.val() || null;
    repopulateMembers(initialDept, initialSelected);
    {% endif %}
}());
</script>
