    public function importStockMoveCsv(Request $request): RedirectResponse
    {
        /** @var Member $Member */
        $Member = $this->getUser();

        $form = $this->createForm(StockMoveCsvImportType::class);
        $form->handleRequest($request);

        if (!$form->isSubmitted() || !$form->isValid()) {
            foreach ($form->getErrors() as $error) {
                $this->addError($error->getMessage(), 'admin');
            }

            return $this->redirectToRoute('admin_stock_move_transfer');
        }

        /** @var UploadedFile|null $formFile */
        $formFile = $form->get('import_file')->getData();

        if ($formFile === null) {
            $this->addError('admin.common.csv_invalid_format', 'admin');

            return $this->redirectToRoute('admin_stock_move_transfer');
        }

        if ($this->countCsvRows($formFile) >= static::ADMIN_CSV_IMPORT_MAX_ROWS) {
            $this->addError($this->getCsvImportMaxRowsExceededMessage(), 'admin');

            return $this->redirectToRoute('admin_stock_move_transfer');
        }

        $MoveFromBaseInfo = $form->get('move_from_base_info')->getData();
        $MoveToBaseInfo = $form->get('move_to_base_info')->getData();
        $moveFromStockLocationId = (int) $form->get('move_from_stock_location_id')->getData();
        $moveToStockLocationId = (int) $form->get('move_to_stock_location_id')->getData();

        if ($MoveFromBaseInfo !== null && !$Member->isEditableShop($MoveFromBaseInfo)) {
            $this->addError('admin.stock.move_transfer.not_editable_store', 'admin');

            return $this->redirectToRoute('admin_stock_move_transfer');
        }

        $handler = new StockMoveCsvImportHandler(
            $this->productClassRepository,
            $this->productStockRepository,
            $MoveFromBaseInfo,
            $MoveToBaseInfo,
            $moveFromStockLocationId,
            $moveToStockLocationId,
            $Member,
            $this->stockMoveTransferStatusRepository,
            $this->entityManager,
            $this->productStockEntityManager,
            $this->stockHistoryEntityManager,
            $this->stockMoveTransferDetailEntityManager,
            $this->stockMoveTransferEntityManager,
            $this->stockChangeTypeDetailRepository,
            $this->stockHistorySourceTypeRepository,
        );
        $importer = new StockMoveCsvImporter(
            $this->entityManager,
            $this->translator,
            $this->eccubeConfig,
            $handler,
            $Member,
        );
        $result = $importer->import($formFile);

        if ($result->hasError()) {
            log_info('在庫移動CSV登録 異常終了');
            foreach ($result->getErrors() as $error) {
