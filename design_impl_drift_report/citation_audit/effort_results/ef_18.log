namespace Eccube\Service\Admin\Stock;

use Doctrine\DBAL\LockMode;
use Doctrine\ORM\EntityManagerInterface;
use Eccube\Entity\DtbStockApprovalList;
use Eccube\Entity\Master\MtbStockChangeTypeDetail;
use Eccube\Entity\Master\MtbStockHistorySourceType;
use Eccube\Entity\Master\MtbStockSplitJoinStatus;
use Eccube\Repository\DtbStockSplitJoinDetailRepository;
use Eccube\Repository\Master\MtbStockChangeTypeDetailRepository;
use Eccube\Repository\Master\MtbStockHistorySourceTypeRepository;
use Eccube\Repository\Master\MtbStockSplitJoinStatusRepository;
use Eccube\Service\Admin\Stock\ActionInput\StockJoinApplyApprovalInput;
use Eccube\Service\EntityManager\ProductStockEntityManager;
use Eccube\Service\EntityManager\StockApprovalListEntityManager;
use Eccube\Service\EntityManager\StockHistoryEntityManager;
use Eccube\Service\EntityManager\StockSplitJoinStatusHistoryEntityManager;

/**
 * 在庫結合の承認申請（ステータスを「結合承認待ち」に変更）
 *
 * 欠品が入力されている場合、承認申請と同時に欠品調整を行う。
 * 欠品調整：欠品数量を欠品加算[40]で原価付きで戻し、同額を欠品減算[39]で引く。
 * 在庫数・総原価ともに net ±0。欠品原価は廃棄として処理され source 単価は変動しない。
 */
class StockJoinApplyApprovalAction
{
    public function __construct(
        private readonly DtbStockSplitJoinDetailRepository $stockSplitJoinDetailRepository,
        private readonly MtbStockChangeTypeDetailRepository $stockChangeTypeDetailRepository,
        private readonly MtbStockHistorySourceTypeRepository $stockHistorySourceTypeRepository,
        private readonly MtbStockSplitJoinStatusRepository $statusRepository,
        private readonly EntityManagerInterface $entityManager,
        private readonly ProductStockEntityManager $productStockEntityManager,
        private readonly StockHistoryEntityManager $stockHistoryEntityManager,
        private readonly StockApprovalListEntityManager $stockApprovalListEntityManager,
        private readonly StockSplitJoinStatusHistoryEntityManager $statusHistoryEntityManager,
    ) {
    }

    /**
     * @return array{stockSplitJoinId: int, successMessage: string}|array{errorMessage: string}
     */
    public function handle(StockJoinApplyApprovalInput $input): array
    {
        $StockSplitJoin = $input->StockSplitJoin;
        $Member = $input->Member;

        if (!$StockSplitJoin->isJoin()) {
            return ['errorMessage' => 'admin.stock.join.source_not_found'];
        }

        $currentStatusId = $StockSplitJoin->getStockSplitJoinStatus()->getId();
        if ($currentStatusId !== MtbStockSplitJoinStatus::JOIN_SOURCE_REGISTERED) {
            return ['errorMessage' => 'admin.stock.join.apply_approval_invalid_status'];
        }

        $sources = $this->stockSplitJoinDetailRepository->findByStockSplitJoin($StockSplitJoin);
        if ($sources === []) {
            return ['errorMessage' => 'admin.stock.join.source_required'];
        }

        // 欠品数量を入力から確定し、有効結合数（plannedTotal）を事前検証する
        /** @var array<int, int> $shortageByDetailId */
        $shortageByDetailId = [];
        $plannedTotal = 0;
        foreach ($sources as $detail) {
            $detailId = (int) $detail->getId();
            $shortageQty = isset($input->shortageQuantities[$detailId]) ? \max(0, (int) $input->shortageQuantities[$detailId]) : 0;
            $shortageByDetailId[$detailId] = $shortageQty;
            $plannedTotal += \max(0, $detail->getSplitJoinQuantity() - $shortageQty);
        }
        if ($plannedTotal < 1) {
            return ['errorMessage' => 'admin.stock.join.apply_approval_zero_quantity'];
        }

        $joinShortageAddType = $this->stockChangeTypeDetailRepository->find(MtbStockChangeTypeDetail::JOIN_SHORTAGE_ADD);
        $joinShortageSubtractType = $this->stockChangeTypeDetailRepository->find(MtbStockChangeTypeDetail::JOIN_SHORTAGE_SUBTRACT);
        $HistorySourceType = $this->stockHistorySourceTypeRepository->find(MtbStockHistorySourceType::STOCK_JOIN_EDIT);
        $StatusPending = $this->statusRepository->find(MtbStockSplitJoinStatus::JOIN_APPROVAL_WAITING);

        if ($joinShortageAddType === null || $joinShortageSubtractType === null) {
            throw new \LogicException('StockJoinApplyApprovalAction requires JOIN_SHORTAGE_ADD and JOIN_SHORTAGE_SUBTRACT type masters.');
        }
        if ($HistorySourceType === null) {
            throw new \LogicException('StockJoinApplyApprovalAction requires STOCK_JOIN_EDIT in master.');
        }
        if ($StatusPending === null) {
            throw new \LogicException('StockJoinApplyApprovalAction requires JOIN_APPROVAL_WAITING status in master.');
        }

        $now = new \DateTime();

        $this->entityManager->beginTransaction();
        try {
            $this->entityManager->lock($StockSplitJoin, LockMode::PESSIMISTIC_WRITE);
            $this->entityManager->refresh($StockSplitJoin);

            $sources = $this->stockSplitJoinDetailRepository->findByStockSplitJoin($StockSplitJoin);

            foreach ($sources as $detail) {
                $detailId = (int) $detail->getId();
                $shortageQty = $shortageByDetailId[$detailId] ?? 0;
                $splitJoinQty = $detail->getSplitJoinQuantity();
                $effectiveQty = \max(0, $splitJoinQty - $shortageQty);

                $detail->setShortageQuantity($shortageQty);
                $detailCostPrice = $detail->getCostPrice() ?? '0';

                if ($shortageQty <= 0) {
                    $detail->setMissingMember(null);
                    continue;
                }

                $detail->setMissingMember($Member);

                $SrcPs = $detail->getSubjectProductStock();
                $this->entityManager->lock($SrcPs, LockMode::PESSIMISTIC_WRITE);
                $this->entityManager->refresh($SrcPs);

                $ProductClass = $SrcPs->getProductClass();
                $sellPrice = (int) ($ProductClass->getPrice02() ?? 0);
                $shortageQtyStr = (string) $shortageQty;

                // 欠品加算[40]：欠品数量分だけ在庫数を戻す（原価は欠品数×明細単価分を加算）
                $shortageAddCost = \bcmul($detailCostPrice, $shortageQtyStr, 2);
                $stockBefore1 = $SrcPs->getStock() ?? '0';
                $totalCostBefore1 = $SrcPs->getTotalCost();
                $unitCostBefore1 = $SrcPs->getUnitCost();
                $stockAfter1 = \bcadd($stockBefore1, $shortageQtyStr, 0);
                $totalCostAfter1 = \bcadd($totalCostBefore1, $shortageAddCost, 2);
                $unitCostAfter1 = \bccomp($stockAfter1, '0', 0) > 0
                    ? \bcround(\bcdiv($totalCostAfter1, $stockAfter1, 8), 0)
                    : '0';

                $this->productStockEntityManager->save(
                    ProductStock: $SrcPs,
                    ProductClass: $ProductClass,
                    BaseInfo: $SrcPs->getBaseInfo(),
                    stock: $stockAfter1,
                    pickUpFlg: $SrcPs->getPickUpFlg(),
                    stockLocationId: $SrcPs->getStockLocationId(),
                    totalCost: $totalCostAfter1,
                );

                $this->stockHistoryEntityManager->save(
                    ProductStock: $SrcPs,
                    StockChangeTypeDetail: $joinShortageAddType,
                    oldStock: $stockBefore1,
                    stock: $stockAfter1,
                    stockChangeQuantity: $shortageQtyStr,
                    sellPrice: $sellPrice,
                    unitCostPriceBefore: $unitCostBefore1,
                    unitCostPriceAfter: $unitCostAfter1,
                    totalCostPriceBefore: $totalCostBefore1,
                    totalCostPriceAfter: $totalCostAfter1,
                    stockChangeReason: '',
                    shortageReason: null,
                    HistorySourceType: $HistorySourceType,
                    historySourceId: (int) $StockSplitJoin->getId(),
                    registeredAt: $now,
                    RegisteredMember: $Member,
                    operatorMemberName: $Member->getName(),
                );

                // 欠品減算[39]：欠品加算で増やしたコスト（shortageAddCost）を逆算して減算する。
                // 在庫数・総原価ともに net ±0 となり、欠品原価は廃棄として処理されて source 単価は変動しない。
                // save() でエンティティのstock/totalCostはインメモリ更新済み
                $stockBefore2 = $SrcPs->getStock() ?? '0';
                $totalCostBefore2 = $SrcPs->getTotalCost();
                $unitCostBefore2 = $SrcPs->getUnitCost();
                $stockAfter2 = \bcsub($stockBefore2, $shortageQtyStr, 0);
                $totalCostAfter2 = \bcsub($totalCostBefore2, $shortageAddCost, 2);
                $unitCostAfter2 = \bccomp($stockAfter2, '0', 0) > 0
                    ? \bcround(\bcdiv($totalCostAfter2, $stockAfter2, 8), 0)
                    : '0';

                $this->productStockEntityManager->save(
                    ProductStock: $SrcPs,
                    ProductClass: $ProductClass,
                    BaseInfo: $SrcPs->getBaseInfo(),
                    stock: $stockAfter2,
                    pickUpFlg: $SrcPs->getPickUpFlg(),
                    stockLocationId: $SrcPs->getStockLocationId(),
                    totalCost: $totalCostAfter2,
                );

                $this->stockHistoryEntityManager->save(
                    ProductStock: $SrcPs,
                    StockChangeTypeDetail: $joinShortageSubtractType,
                    oldStock: $stockBefore2,
                    stock: $stockAfter2,
                    stockChangeQuantity: '-'.$shortageQtyStr,
                    sellPrice: $sellPrice,
                    unitCostPriceBefore: $unitCostBefore2,
                    unitCostPriceAfter: $unitCostAfter2,
                    totalCostPriceBefore: $totalCostBefore2,
                    totalCostPriceAfter: $totalCostAfter2,
                    stockChangeReason: '',
                    shortageReason: null,
                    HistorySourceType: $HistorySourceType,
                    historySourceId: (int) $StockSplitJoin->getId(),
                    registeredAt: $now,
                    RegisteredMember: $Member,
                    operatorMemberName: $Member->getName(),
                );

                // 同一 SrcPs を参照する別 Detail が後続する場合に備え、都度 flush して DB 値を確定する
                $this->entityManager->flush();
            }

            $StockSplitJoin->setSplitJoinMemo($input->splitJoinMemo);
            $StockSplitJoin->setStockSplitJoinStatus($StatusPending);
            $StockSplitJoin->setMoveToApprovalAt($now);
            $StockSplitJoin->setMoveToApprovalMember($Member);

