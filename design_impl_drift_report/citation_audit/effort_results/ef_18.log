    public function getListExportRows(array $stockMoveTransferIds, string $listExportType): iterable
    {
        if ($stockMoveTransferIds === []) {
            return new \ArrayIterator([]);
        }

        if ($listExportType === self::LIST_EXPORT_TYPE_PICK) {
            $productStockJoinColumn = 'd.move_from_product_stock_id';
            $baseInfoJoinColumn = 'smt.move_from_base_info_id';
            $quantityExpression = 'd.move_transfer_quantity - COALESCE(d.stockout_quantity, 0)';
            $havingClause = 'HAVING SUM('.$quantityExpression.') > 0';
        } elseif ($listExportType === self::LIST_EXPORT_TYPE_RETURN) {
            $productStockJoinColumn = 'd.move_to_product_stock_id';
            $baseInfoJoinColumn = 'smt.move_to_base_info_id';
            $quantityExpression = 'd.move_transfer_quantity';
            $havingClause = '';
        } else {
            throw new \InvalidArgumentException('Invalid list export type: '.$listExportType);
        }

        $connection = $this->getEntityManager()->getConnection();
        $connection->executeStatement("SET TIME ZONE 'Asia/Tokyo'");

