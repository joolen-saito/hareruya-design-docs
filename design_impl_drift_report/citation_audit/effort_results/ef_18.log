use Symfony\Component\Validator\Context\ExecutionContextInterface;

/**
 * 棚卸計画（新規作成・更新）
 */
class InventoryPlanType extends AbstractType
{
    private const NAME_MAX_LENGTH = 255;

    private const MEMO_MAX_LENGTH = 1024;

    public function __construct(
        private readonly DtbInventoryPlanRepository $inventoryPlanRepository,
        private readonly BaseInfoRepository $baseInfoRepository,
    ) {
    }

    /**
     * @param array<string, mixed> $options
     */
    #[\Override]
    public function buildForm(FormBuilderInterface $builder, array $options): void
    {
        $builder
            ->add('name', TextType::class, [
                'label' => '棚卸名',
                'required' => true,
                'constraints' => [
                    new Assert\Length(['max' => self::NAME_MAX_LENGTH]),
                    new Assert\Callback($this->validateUniqueName(...)),
                ],
            ])
            ->add('memo', TextareaType::class, [
                'label' => '備考',
                'required' => false,
                'constraints' => [
                    new Assert\Length(['max' => self::MEMO_MAX_LENGTH]),
                ],
            ]);

        if ($options['isNew']) {
            /** @var Member|null $Member */
            $Member = $options['Member'];

            $builder
                ->add('BaseInfo', EntityType::class, [
                    'class' => BaseInfo::class,
                    'choice_label' => 'shop_name',
                    'label' => 'admin.stock.list.base_info',
                    'required' => true,
                    'placeholder' => 'admin.common.select',
                    'query_builder' => fn () => $this->baseInfoRepository->createQueryBuilder('bi')
                        ->andWhere('bi.isOpenShop = :isOpenShop')
                        ->setParameter('isOpenShop', BaseInfo::SHOP_OPEN),
                    'constraints' => [
                        new Assert\NotBlank(),
                    ],
                ])
                ->add('stockLocationId', ChoiceType::class, [
                    'label' => 'admin.stock.list.stock_zone',
                    'required' => true,
                    'expanded' => true,
                    'choices' => [
                        'admin.stock.list.stock_zone__eccube' => ProductStock::STOCK_LOCATION_ECCUBE,
                        'admin.stock.list.stock_zone__smaregi' => ProductStock::STOCK_LOCATION_SMAREGI,
                    ],
                    'choice_translation_domain' => 'messages',
                    'constraints' => [
                        new Assert\NotBlank(),
                    ],
                ])
                ->addEventListener(FormEvents::POST_SUBMIT, function (FormEvent $event) use ($Member): void {
                    $form = $event->getForm();
                    /** @var DtbInventoryPlan $InventoryPlan */
                    $InventoryPlan = $form->getData();
                    $BaseInfo = $InventoryPlan->getBaseInfo();

                    if ($BaseInfo === null || $Member === null) {
                        return;
                    }

                    if (!$Member->isEditableShop($BaseInfo)) {
                        $form->get('BaseInfo')->addError(
                            new FormError(trans('form_error.event_not_editable', [], 'validators'))
                        );
                    }
                });
        } else {
            /** @var Member|null $Member */
            $Member = $options['Member'];

            $builder->addEventListener(FormEvents::POST_SUBMIT, function (FormEvent $event) use ($Member): void {
                if ($Member === null) {
                    return;
                }

                $form = $event->getForm();
                /** @var DtbInventoryPlan $InventoryPlan */
                $InventoryPlan = $form->getData();

                if (!$InventoryPlan->isEditableBy($Member)) {
                    $form->get('name')->addError(
                        new FormError(trans('form_error.event_not_editable', [], 'validators'))
                    );
                }
            });
        }
    }

    public function validateUniqueName(mixed $value, ExecutionContextInterface $context): void
    {
        if (!is_string($value) || $value === '') {
            return;
        }

        /** @var DtbInventoryPlan $InventoryPlan */
        $InventoryPlan = $context->getRoot()->getData();

        if ($this->inventoryPlanRepository->existsByName($value, $InventoryPlan)) {
            $context->buildViolation('この棚卸名は既に使用されています。')
                ->addViolation();
        }
    }

    #[\Override]
    public function configureOptions(OptionsResolver $resolver): void
    {
        $resolver->setDefaults([
            'data_class' => DtbInventoryPlan::class,
            'isNew' => false,
            'Member' => null,
        ]);
        $resolver->setAllowedTypes('Member', [Member::class, 'null']);
    }

    #[\Override]
    public function getBlockPrefix(): string
    {
        return 'admin_stock_inventory_plan';
    }
