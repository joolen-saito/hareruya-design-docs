            SELECT
                p.name AS "rawProductName",
                sc.name AS "storageCodeName",
                lng.code AS "languageCode",
                cond.code AS "conditionCode",
                (
                    SELECT STRING_AGG(cl.name_jp, '' ORDER BY cl.id)
                    FROM dtb_card_color dcc
                    JOIN mtb_color cl ON cl.id = dcc.color_id
                    WHERE dcc.card_id = c.id
                ) AS "colorName",
                r.code AS "rarityCode",
                COALESCE(cd.foil_flg, 0) AS "foilFlg",
                SUM({$quantityExpression}) AS "quantity",
                pc.standard_price AS "standardPrice",
                bi.expensive_threshold1 AS "threshold1",
                bi.expensive_threshold2 AS "threshold2",
                bi.expensive_threshold3 AS "threshold3",
                -- カテゴリ判定を EXISTS に分離: 1:N JOIN による数量重複を防ぐ
                CASE WHEN EXISTS (
                    SELECT 1 FROM dtb_product_category pcat
                    WHERE pcat.product_id = p.id
                      AND pcat.category_id IN (:goods_category_id, :reserved_goods_category_id)
                ) THEN 1 ELSE 0 END AS "isSupply",
                -- ピッキング区分ソート: 円未満(1) → 円以上~円未満(2) → 円以上(3) → サプライ(99)
