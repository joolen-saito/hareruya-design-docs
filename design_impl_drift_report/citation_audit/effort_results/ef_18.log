        }

        if ($rowErrors !== []) {
            $ms->addRawMessage($rowErrors);
            $this->hasErrors = true;
            $event->skipRow();
        }
    }

    public function onReadRow(ReadCsvRowEvent $event): bool
    {
        $row = $event->getRow();

        $this->pendingRows[] = [
            'dest_code' => trim($row->getValue(self::COL_DEST_CODE)),
            'join_qty' => trim($row->getValue(self::COL_JOIN_QTY)),
            'src_code' => trim($row->getValue(self::COL_SRC_CODE)),
            'src_cat' => trim($row->getValue(self::COL_SRC_CAT)),
            'src_qty' => trim($row->getValue(self::COL_SRC_QTY)),
        ];

        return true;
    }

    public function onAfterImport(AfterReadEvent $event): void
    {
        parent::onAfterImport($event);

        try {
            if (!$event->isSuccessful() || $this->hasErrors || $this->pendingRows === []) {
                $this->entityManager->rollback();

                return;
            }

            // 結合先商品コード・結合数が未指定の場合はエラー
            if ($this->globalDestCode === '' || $this->globalJoinQty === '') {
                $this->flashErrors[] = '結合先商品コードまたは結合数が指定されていません。いずれかの行に結合先商品コードと結合数を指定してください。';
                $this->entityManager->rollback();

                return;
            }

            // em->clear() 後、$this->member は UnitOfWork から完全に除外されて detach 状態になる。
            // SaveEventSubscriber が prePersist/preUpdate で getCurrentUser()（= $this->member と
            // 同一オブジェクト）を setCreator() に渡すため、flush() 時に
            // getEntityIdentifier($this->member) が EntityNotFoundException を投げる。
            // 対策: ① registerManaged で identity map へ再登録（originalEntityData は空で初期化）
            //       ② refresh で DB 値を同期し originalEntityData を正しく設定（不要な UPDATE を防ぐ）
            // em->find() を先に呼ぶと別オブジェクトが identity map に入り EntityIdentityCollisionException
            // になるため、registerManaged → refresh の順序を厳守する。
            $uow = $this->entityManager->getUnitOfWork();
            $uow->registerManaged(
                $this->member,
                $this->entityManager->getClassMetadata(Member::class)->getIdentifierValues($this->member),
                [],
            );
            $this->entityManager->refresh($this->member);
            $member = $this->member;

            // em->clear() により baseInfo が detach されているため再取得する（在庫区分はプルダウン店舗を維持）
            $baseInfo = $this->entityManager->find(BaseInfo::class, $this->baseInfo->getId());
            if ($baseInfo === null) {
                $this->entityManager->rollback();

                return;
            }

            $groups = $this->buildGroups();
            $successCount = 0;
            $businessHasError = false;

            foreach ($groups as $groupRows) {
                $result = $this->processGroup($groupRows, $member, $baseInfo);
                if ($result['ok']) {
                    ++$successCount;
                } else {
                    $businessHasError = true;
                    $this->flashErrors = array_merge($this->flashErrors, $result['errors']);
                }
            }

            if ($businessHasError) {
                $this->entityManager->rollback();

                return;
            }

            if ($successCount > 0) {
                $this->flashSuccesses[] = trans('admin.stock.split_join.list_csv_join_import_done', ['%count%' => (string) $successCount]);
            }

            $this->entityManager->flush();
            $this->entityManager->commit();
        } catch (\Exception $e) {
            try {
                $this->entityManager->rollback();
            } catch (\Throwable $t) {
                // ロールバック失敗は無視して元の例外を伝播させる
            }
            throw $e;
        }
    }

    /** @return list<string> */
    public function getFlashErrors(): array
    {
        return $this->flashErrors;
    }

    /** @return list<string> */
    public function getFlashSuccesses(): array
    {
        return $this->flashSuccesses;
    }

    /**
     * @return array<CsvColumnInterface>
     */
    protected function getColumns(): array
    {
        return [
            new BaseCsvColumn(self::COL_DEST_CODE, self::COL_DEST_CODE),
            new BaseCsvColumn(self::COL_JOIN_QTY, self::COL_JOIN_QTY),
            new BaseCsvColumn(self::COL_SRC_CODE, self::COL_SRC_CODE),
            new BaseCsvColumn(self::COL_SRC_CAT, self::COL_SRC_CAT),
            new BaseCsvColumn(self::COL_SRC_QTY, self::COL_SRC_QTY),
        ];
    }

    /**
     * @return array<RowValidatorInterface>
     */
    protected function getRowValidators(): array
    {
        return [];
    }

    /**
     * 全行を1グループとしてまとめる（1ファイル=1結合）。
     * dest_code/join_qty が空の行はグローバル値を使用する。
     *
     * @return array<string, list<array{dest_code: string, join_qty: int, src_code: string, src_cat: string, src_qty: int}>>
     */
    private function buildGroups(): array
    {
        $groups = [];
        $destCode = $this->globalDestCode;
        $joinQty = (int) $this->globalJoinQty;
        $k = $destCode."\0".$joinQty;

        foreach ($this->pendingRows as $row) {
            if ($row['src_code'] === '') {
                continue;
            }
            $groups[$k][] = [
                'dest_code' => $destCode,
                'join_qty' => $joinQty,
                'src_code' => $row['src_code'],
                'src_cat' => $row['src_cat'],
                'src_qty' => (int) $row['src_qty'],
            ];
        }

        return $groups;
    }

    /**
     * @param list<array{dest_code: string, join_qty: int, src_code: string, src_cat: string, src_qty: int}> $groupRows
     *
     * @return array{ok: bool, errors: list<string>}
     */
    private function processGroup(array $groupRows, Member $member, BaseInfo $baseInfo): array
    {
        $errors = [];
        $first = $groupRows[0];
        $destCode = $first['dest_code'];
        $joinQuantity = $first['join_qty'];

        $destPs = $this->productStockRepository->findOneByProductCodeAndBaseInfoAndStockLocation(
            $destCode,
            $baseInfo,
            $this->destinationStockLocationId
        );
        if ($destPs === null) {
            $errors[] = sprintf('結合先商品コード「%s」が同一店舗・在庫区分で見つかりません。', $destCode);

            return ['ok' => false, 'errors' => $errors];
        }

        /** @var array<int, array{ProductStock: ProductStock, quantity: int}> $sourceByPsId */
        $sourceByPsId = [];
        foreach ($groupRows as $gr) {
            $srcCode = $gr['src_code'];
            $cat = $gr['src_cat'];
            $srcLoc = $this->resolveSourceStockLocation($cat);
            if ($srcLoc === null) {
                $errors[] = sprintf('結合先 %s 結合元 %s: 在庫区分が不正です（%s）。', $destCode, $srcCode, $cat);

                return ['ok' => false, 'errors' => $errors];
            }
            $srcPs = $this->productStockRepository->findOneByProductCodeAndBaseInfoAndStockLocation(
                $srcCode,
                $baseInfo,
                $srcLoc
            );
            if ($srcPs === null) {
                $errors[] = sprintf('結合元商品コード「%s」（在庫区分 %s）が見つかりません。', $srcCode, $cat);

                return ['ok' => false, 'errors' => $errors];
            }
            if ($srcPs->getId() === $destPs->getId()) {
                $errors[] = sprintf('結合先と結合元が同一在庫です（%s）。', $destCode);

                return ['ok' => false, 'errors' => $errors];
            }
            $psId = (int) $srcPs->getId();
            if (isset($sourceByPsId[$psId])) {
                $sourceByPsId[$psId]['quantity'] += $gr['src_qty'];
            } else {
                $sourceByPsId[$psId] = ['productStockId' => $psId, 'quantity' => $gr['src_qty']];
            }
        }

        if ($sourceByPsId === []) {
            $errors[] = sprintf('結合先 %s: 結合元が空です。', $destCode);

            return ['ok' => false, 'errors' => $errors];
        }

        $registerInput = new StockJoinRegisterInput(
            $destPs,
            $member,
            max(0, $joinQuantity),
        );

        try {
            $regResult = $this->stockJoinRegisterAction->handle($registerInput);
        } catch (\LogicException $e) {
            $errors[] = sprintf('結合先 %s: %s', $destCode, trans($e->getMessage()));

            return ['ok' => false, 'errors' => $errors];
        }

        $joinId = (int) $regResult->getId();
        if ($joinId < 1) {
            $errors[] = sprintf('結合先 %s: 登録に失敗しました。', $destCode);

            return ['ok' => false, 'errors' => $errors];
        }

        try {
            $this->stockJoinMoveToShortageEntryAction->handle(
                new StockJoinMoveToShortageEntryInput(
                    ProductStock: $destPs,
                    stockSplitJoinId: $joinId,
                    Member: $member,
                    sessionSources: array_map(static fn ($v) => ['quantity' => $v['quantity']], $sourceByPsId),
                )
            );
