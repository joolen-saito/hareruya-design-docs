    public function onBeforeImport(): void
    {
        parent::onBeforeImport();

        $this->initializeColumnDefinitions();
    }

    public function onAfterImport(AfterReadEvent $event): void
    {
        parent::onAfterImport($event);

        $this->clearColumnDefinitions();
    }

    /**
     * 行ごとにバリデーションし、エラー時はその行をスキップして処理を継続する。
     * 全行の個別エラーを収集するため、breakAll() ではなく skipRow() を使用する。
     */
    public function onValidateRow(ReadCsvRowEvent $event): void
    {
        $columns = $this->getColumns();
        $row = $event->getRow();
        $messageStore = $event->getMessageStore();

        if (count($row) !== count($columns)) {
            $messageStore->addInvalidColumnCountError($row->getRowNumber());
            $event->skipRow();

            return;
        }

        foreach ($columns as $column) {
            $name = $column->getName();
            if (!$row->exists($name)) {
                $messageStore->addColumnNotExistsError($row->getRowNumber(), $name);
                $event->skipRow();

                return;
            }
            if (!$column->validate($messageStore, $row)) {
                $event->skipRow();

                return;
            }
        }

        $rowValidators = $this->getRowValidators();
        foreach ($rowValidators as $rowValidator) {
            if (!$rowValidator->validate($messageStore, $row)) {
                $event->skipRow();

                return;
            }
        }
    }

    /**
     * CSVデータ1行を取り込む。
     */
    public function onReadRow(ReadCsvRowEvent $event): bool
    {
        $row = $event->getRow();
        $messageStore = $event->getMessageStore();
        $rowNumber = $row->getRowNumber();

        $instructionIdValue = $this->instructionIdColumn->getValue($row);
        $instructionId = is_numeric($instructionIdValue) ? (int) $instructionIdValue : 0;
        if ($instructionId <= 0) {
            $messageStore->addRawMessage(
                $rowNumber.'行目: '.$this->translator->trans('admin.stock.move_instruction.csv_tracking_error_instruction_not_found', [], 'messages')
            );

            return false;
        }

        $Instruction = $this->stockMoveInstructionRepository->find($instructionId);
        if ($Instruction === null) {
            $messageStore->addRawMessage(
                $rowNumber.'行目: '.$this->translator->trans('admin.stock.move_instruction.csv_tracking_error_instruction_not_found', [], 'messages')
            );

            return false;
        }

        $moveFromShop = $this->trimOrNull((string) $this->moveFromShopColumn->getValue($row));
        $moveToShop = $this->trimOrNull((string) $this->moveToShopColumn->getValue($row));
        $fromShop = $Instruction->getMoveFromBaseInfo()->getShopName();
        $toShop = $Instruction->getMoveToBaseInfo()->getShopName();

        if ($moveFromShop !== null && $moveFromShop !== '' && (string) $fromShop !== $moveFromShop) {
            $messageStore->addRawMessage(
                $rowNumber.'行目: '.$this->translator->trans('admin.stock.move_instruction.csv_tracking_error_shop_mismatch_from', [], 'messages')
            );

            return false;
        }
        if ($moveToShop !== null && $moveToShop !== '' && (string) $toShop !== $moveToShop) {
            $messageStore->addRawMessage(
                $rowNumber.'行目: '.$this->translator->trans('admin.stock.move_instruction.csv_tracking_error_shop_mismatch_to', [], 'messages')
            );

            return false;
        }

        $trackingNoRaw = (string) $this->trackingNoColumn->getValue($row);
        $trackingNoTrimmed = $this->trimOrNull($trackingNoRaw);
        if ($trackingNoTrimmed === null || $trackingNoTrimmed === '') {
            $messageStore->addRawMessage(
                $rowNumber.'行目: '.$this->translator->trans('admin.stock.move_instruction.csv_tracking_error_tracking_no_empty', [], 'messages')
            );

            return false;
        }

        $maxLen = (int) $this->eccubeConfig['eccube_text_type_column_max_len'];
        if (mb_strlen($trackingNoTrimmed) > $maxLen) {
            $messageStore->addRawMessage(
                $rowNumber.'行目: '.$this->translator->trans('admin.stock.move_instruction.tracking_no_max_length', [
                    '%max%' => $maxLen,
                ], 'messages')
            );

            return false;
        }

        $this->persistTrackingNo($Instruction, $trackingNoTrimmed, $event->getUpdateUser());

        return true;
    }
