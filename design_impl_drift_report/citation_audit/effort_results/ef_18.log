    {
        return self::createStringColumn($name, '振替先商品コード');
    }

    /**
     * @param string $name 列名
     *
     * @return BaseCsvColumn 在庫振替CSVの振替点数列
     */
    public static function stockTransferQuantity(string $name = '振替点数'): BaseCsvColumn
    {
        return self::createUnsignedNumericColumn($name, '振替点数');
    }

    /**
     * @param string $name 列名
     *
     * @return BaseCsvColumn 商品IDの列定義
     */
    public static function productId(string $name = '商品ID'): BaseCsvColumn
    {
        return self::createUnsignedNumericColumn($name, '商品ID');
    }

    /**
