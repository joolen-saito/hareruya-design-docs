namespace Eccube\Form\Type\Admin;

use Eccube\Entity\BaseInfo;
use Eccube\Entity\Member;
use Symfony\Bridge\Doctrine\Form\Type\EntityType;
use Symfony\Bundle\SecurityBundle\Security;
use Symfony\Component\Form\AbstractType;
use Symfony\Component\Form\Extension\Core\Type\DateType;
use Symfony\Component\Form\FormBuilderInterface;
use Symfony\Component\Form\FormError;
use Symfony\Component\Form\FormEvent;
use Symfony\Component\Form\FormEvents;
use Symfony\Component\OptionsResolver\OptionsResolver;
use Symfony\Component\Validator\Constraints as Assert;

class BarcodeReplacementListType extends AbstractType
{
    public function __construct(
        private readonly Security $security,
    ) {
    }

    #[\Override]
    public function buildForm(FormBuilderInterface $builder, array $options): void
    {
        $yesterday = (new \DateTime('yesterday'))->setTime(0, 0, 0);
        $today = (new \DateTime('today'))->setTime(0, 0, 0);

        $builder
            ->add('base_info', EntityType::class, [
                'label' => 'admin.stock.barcode_replacement_list.base_info',
                'class' => BaseInfo::class,
                'required' => true,
                'expanded' => false,
                'multiple' => false,
                'placeholder' => 'admin.stock.barcode_replacement_list.base_info_empty',
                'data' => $this->getMemberDefaultSearchBaseInfo(),
                'constraints' => [
                    new Assert\NotBlank(),
                ],
            ])
            ->add('price_change_period_from', DateType::class, [
                'label' => 'admin.stock.barcode_replacement_list.price_change_period',
                'required' => true,
                'input' => 'datetime',
                'widget' => 'single_text',
                'data' => $yesterday,
                'constraints' => [
                    new Assert\NotBlank(),
                ],
            ])
            ->add('price_change_period_to', DateType::class, [
                'required' => true,
                'input' => 'datetime',
                'widget' => 'single_text',
                'data' => $today,
                'constraints' => [
                    new Assert\NotBlank(),
                ],
            ]);

        $builder->addEventListener(FormEvents::POST_SUBMIT, function (FormEvent $event): void {
            $form = $event->getForm();
            $from = $form->get('price_change_period_from')->getData();
            $to = $form->get('price_change_period_to')->getData();

            if (!$from instanceof \DateTimeInterface || !$to instanceof \DateTimeInterface) {
                return;
            }

            $fromComparable = \DateTimeImmutable::createFromInterface($from)->setTime(0, 0, 0);
            $toComparable = \DateTimeImmutable::createFromInterface($to)->setTime(0, 0, 0);

            if ($fromComparable > $toComparable) {
                $form->get('price_change_period_to')->addError(
                    new FormError(trans('admin.stock.barcode_replacement_list.price_change_period_invalid')),
                );
            }
        });
    }

    #[\Override]
    public function configureOptions(OptionsResolver $resolver): void
    {
        $resolver->setDefaults([
            'csrf_protection' => true,
        ]);
    }

    #[\Override]
    public function getBlockPrefix(): string
    {
        return 'admin_barcode_replacement_list';
    }

    private function getMemberDefaultSearchBaseInfo(): ?BaseInfo
    {
        $Member = $this->security->getUser();

        if (!$Member instanceof Member) {
            return null;
        }

        try {
            return $Member->getDefaultSearchBaseInfo();
        } catch (\Error $e) {
            return null;
        }
    }
}

