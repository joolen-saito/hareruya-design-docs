namespace Eccube\Service\Admin\Stock;

use Doctrine\ORM\EntityManagerInterface;
use Eccube\Entity\Master\MtbStockMoveTransferStatus;
use Eccube\Repository\DtbStockMoveTransferRepository;
use Eccube\Service\Admin\Stock\ActionInput\StockMoveInstructionDetailUpdateInput;

/**
 * 在庫移動指示詳細更新（送り状Noを紐づく Transfer に同期）
 */
readonly class StockMoveInstructionDetailUpdateAction
{
    public function __construct(
        private EntityManagerInterface $EntityManager,
        private DtbStockMoveTransferRepository $stockMoveTransferRepository,
    ) {
    }

    public function handle(StockMoveInstructionDetailUpdateInput $input): void
    {
        $instruction = $input->Instruction;
        $instruction->setUpdateDate(new \DateTime());
        $instruction->setUpdateMember($input->UpdateMember);

        $trackingNo = $instruction->getTrackingNo();
        $Transfers = $this->stockMoveTransferRepository->findBy(
            ['moveInstructionId' => $instruction->getId()],
            ['id' => 'ASC']
        );
        $MovingStatus = $trackingNo !== null && $trackingNo !== ''
            ? $this->EntityManager->find(MtbStockMoveTransferStatus::class, MtbStockMoveTransferStatus::STATUS_MOVING)
            : null;
        foreach ($Transfers as $Transfer) {
            $Transfer->setTrackingNo($trackingNo);
            if ($MovingStatus !== null) {
                $Transfer->setMoveTransferStatus($MovingStatus);
            }
        }

        $this->EntityManager->flush();
    }
}
{% extends '@admin/default_frame.twig' %}

{% set menus = ['product_stock', 'stock_move_instruction'] %}

{% block title %}{{ 'admin.stock.move_instruction.detail_title'|trans }}{% endblock %}
{% block sub_title %}{{ 'admin.stock.move_instruction.detail_subtitle'|trans }}{% endblock %}

{% block main %}
    <div class="c-contentsArea__cols">
        <div class="c-contentsArea__primaryCol">
            <div class="c-primaryCol">
                <div class="card rounded border-0 mb-4">
                    <div class="card-header">
                        <span class="card-title align-middle fw-bold">{{ 'admin.stock.move_instruction.detail_section_title'|trans }}</span>
                    </div>
                    <div class="card-body">
                        <form name="admin_stock_move_instruction_detail" method="post" action="{{ url('admin_stock_move_instruction_detail', { id: instruction.id }) }}">
                            {{ form_widget(form._token) }}
                            <div class="row mb-3">
                                {# 左カラム: 基本情報（読取＋送り状No は入力） #}
                                <div class="col-md-6 mb-4 mb-md-0">
                                    <div class="mb-3">
                                        <label class="form-label fw text-muted small">{{ 'admin.stock.move_instruction.instruction_id'|trans }}</label>
                                        <p class="mb-0">{{ instruction.id }}</p>
                                    </div>
                                    <div class="mb-3">
                                        <label class="form-label fw text-muted small">{{ 'admin.stock.move_instruction.shipment_status'|trans }}</label>
                                        <p class="mb-0">{% if instruction.trackingNo %}{{ 'admin.stock.move_instruction.shipment_status_done'|trans }}{% else %}{{ 'admin.stock.move_instruction.shipment_status_not_done'|trans }}{% endif %}</p>
                                    </div>
                                    <div class="mb-3">
                                        <label class="form-label fw text-muted small">{{ 'admin.stock.move_instruction.move_from_base_info'|trans }}</label>
                                        <p class="mb-0">{{ instruction.moveFromBaseInfo.shopName|default('-') }}</p>
                                    </div>
                                    <div class="mb-3">
                                        <label class="form-label fw text-muted small">{{ 'admin.stock.move_instruction.move_to_base_info'|trans }}</label>
                                        <p class="mb-0">{{ instruction.moveToBaseInfo.shopName|default('-') }}</p>
                                    </div>
                                    <div class="mb-3">
                                        <label class="form-label fw text-muted small">{{ 'admin.stock.move_instruction.create_date'|trans }}</label>
                                        <p class="mb-0">{{ instruction.createDate|date('Y/n/j H:i:s') }}</p>
                                    </div>
                                    <div class="mb-3">
                                        <label class="form-label fw text-muted small">{{ 'admin.stock.move_instruction.registered_member'|trans }}</label>
                                        <p class="mb-0">{{ instruction.registeredMember.name|default('-') }}</p>
                                    </div>
                                    <div class="mb-3">
                                        <label class="form-label fw text-muted small">{{ 'admin.stock.move_instruction.update_date'|trans }}</label>
                                        <p class="mb-0">{{ instruction.updateDate ? instruction.updateDate|date('Y/n/j H:i:s') : '-' }}</p>
                                    </div>
                                    <div class="mb-3">
                                        <label class="form-label fw text-muted small">{{ 'admin.common.last_updater'|trans }}</label>
                                        <p class="mb-0">{{ instruction.updateMember ? instruction.updateMember.name : '-' }}</p>
                                    </div>
                                    <div class="mb-3">
                                        {{ form_row(form.trackingNo, { 'attr': { 'class': 'form-control', 'rows': 2 } }) }}
                                    </div>
                                </div>
                                {# 右カラム: 集計情報（読取のみ） #}
                                <div class="col-md-6">
                                    <div class="mb-3">
                                        <label class="form-label fw text-muted small">{{ 'admin.stock.move_instruction.standard_total_price'|trans }}</label>
                                        <p class="mb-0 text-end">¥{{ instruction.standardTotalPrice|number_format(0, '.', ',') }}</p>
                                    </div>
                                    <div class="mb-3">
                                        <label class="form-label fw text-muted small">{{ 'admin.stock.move_instruction.outbound_total_cost'|trans }}</label>
                                        <p class="mb-0 text-end">¥{{ outboundTotalCost|number_format(0, '.', ',') }}</p>
                                    </div>
                                    <div class="mb-3">
                                        <label class="form-label fw text-muted small">¥{{ instruction.moveFromPriceThreshold|number_format(0, '.', ',') }}{{ 'admin.stock.move_instruction.high_total_price_label_suffix'|trans }}</label>
                                        <p class="mb-0 text-end">¥{{ highTotalPrice|number_format(0, '.', ',') }}</p>
                                    </div>
                                    <div class="mb-3">
                                        <label class="form-label fw text-muted small">¥{{ instruction.moveFromPriceThreshold|number_format(0, '.', ',') }}{{ 'admin.stock.move_instruction.regular_total_price_label_suffix'|trans }}</label>
                                        <p class="mb-0 text-end">¥{{ regularTotalPrice|number_format(0, '.', ',') }}</p>
                                    </div>
                                </div>
                            </div>
                            {# 備考: 全幅 #}
                            <div class="mb-3">
                                {{ form_row(form.memo, { 'attr': { 'class': 'form-control', 'rows': 2 } }) }}
                            </div>
                            <div class="mt-3 d-flex justify-content-center align-items-center gap-2">
                                <button type="submit" class="btn btn-ec-conversion">{{ 'admin.stock.move_instruction.register'|trans }}</button>
                                {% if instruction.trackingNo %}
                                    <button type="button" class="btn btn-ec-delete" disabled title="{{ 'admin.stock.move_instruction.delete_disabled_after_tracking'|trans }}">{{ 'admin.stock.move_instruction.delete'|trans }}</button>
                                {% else %}
                                    <button type="button" class="btn btn-ec-delete" data-bs-toggle="modal" data-bs-target="#deleteInstructionModal">{{ 'admin.stock.move_instruction.delete'|trans }}</button>
                                {% endif %}
                            </div>
                        </form>
                    </div>
                </div>

                {# 在庫移動一覧（在庫移動指示に紐づく在庫移動） #}
                {% set List = Moves|default([]) %}
                <div class="card rounded border-0 mb-4">
                    <div class="card-header">
                        <span class="card-title align-middle fw-bold">{{ 'admin.stock.move_instruction.stock_move_list_title'|trans }}</span>
                    </div>
                    <div class="card-body p-0">
                        {% if List|length > 0 %}
                        <div class="table-responsive">
                            <table class="table table-sm table-hover mb-0">
                                <thead class="table-active">
                                    <tr>
                                        <th class="border-top-0 pt-2 pb-2">{{ 'admin.stock.move_instruction.col_stock_move_id'|trans }}</th>
                                        <th class="border-top-0 pt-2 pb-2">{{ 'admin.stock.move_instruction.move_from_base_info'|trans }}</th>
                                        <th class="border-top-0 pt-2 pb-2">{{ 'admin.stock.move_instruction.move_to_base_info'|trans }}</th>
                                        <th class="border-top-0 pt-2 pb-2">{{ 'admin.stock.move_instruction.col_stock_location'|trans }}</th>
                                        <th class="border-top-0 pt-2 pb-2 text-end">{{ 'admin.stock.move_instruction.standard_total_price'|trans }}</th>
                                        <th class="border-top-0 pt-2 pb-2 text-end">{{ 'admin.stock.move_instruction.outbound_total_cost'|trans }}</th>
                                        <th class="border-top-0 pt-2 pb-2 text-end">{{ 'admin.stock.move_instruction.high_total_price_col'|trans }}</th>
                                        <th class="border-top-0 pt-2 pb-2 text-end">{{ 'admin.stock.move_instruction.regular_total_price_col'|trans }}</th>
                                        <th class="border-top-0 pt-2 pb-2 text-end">{{ 'admin.stock.move_instruction.col_move_quantity'|trans }}</th>
                                        <th class="border-top-0 pt-2 pb-2">{{ 'admin.stock.move_instruction.create_date'|trans }}</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    {% for Item in List %}
                                    {% set agg = moveAggregates[Item.id] ?? null %}
                                    <tr>
                                        <td class="align-middle"><a href="{{ url('admin_stock_move', { id: Item.id }) }}">{{ Item.id }}</a></td>
                                        <td class="align-middle">{{ Item.moveFromBaseInfo ? Item.moveFromBaseInfo.shopName : '-' }}</td>
                                        <td class="align-middle">{{ Item.moveToBaseInfo ? Item.moveToBaseInfo.shopName : '-' }}</td>
                                        <td class="align-middle">{% if Item.moveFromStockLocationId == constant('Eccube\\Entity\\ProductStock::STOCK_LOCATION_ECCUBE') %}{{ 'admin.stock.move.stock_location_ec_cube'|trans }}{% elseif Item.moveFromStockLocationId == constant('Eccube\\Entity\\ProductStock::STOCK_LOCATION_SMAREGI') %}{{ 'admin.stock.move.stock_location_smaregi'|trans }}{% else %}-{% endif %}</td>
                                        <td class="align-middle text-end">¥{{ agg ? agg.standard_total|number_format(0, '.', ',') : 0 }}</td>
                                        <td class="align-middle text-end">¥{{ agg ? agg.outbound_total_cost|number_format(0, '.', ',') : 0 }}</td>
                                        <td class="align-middle text-end">¥{{ agg ? agg.high_total|number_format(0, '.', ',') : 0 }}</td>
                                        <td class="align-middle text-end">¥{{ agg ? agg.regular_total|number_format(0, '.', ',') : 0 }}</td>
                                        <td class="align-middle text-end">{{ agg ? agg.quantity|number_format : 0 }}点</td>
                                        <td class="align-middle">{{ Item.createDate ? Item.createDate|date('Y/n/j') : '-' }}</td>
                                    </tr>
                                    {% endfor %}
                                </tbody>
                            </table>
                        </div>
                        {% else %}
                        <p class="p-4 mb-0 text-muted">{{ 'admin.stock.move_instruction.linked_moves_empty'|trans }}</p>
                        {% endif %}
                    </div>
                </div>

                {# 削除確認モーダル（送り状No未登録時のみ表示される削除ボタンから表示） #}
                {% if not instruction.trackingNo %}
                <div class="modal fade" id="deleteInstructionModal" tabindex="-1" role="dialog" aria-labelledby="deleteInstructionModalLabel" aria-hidden="true">
                    <div class="modal-dialog" role="document">
                        <div class="modal-content">
                            <div class="modal-header">
                                <h5 class="modal-title fw-bold" id="deleteInstructionModalLabel">{{ 'admin.common.delete_modal__title'|trans }}</h5>
                                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                            </div>
                            <div class="modal-body text-start">
                                <p class="mb-0">{{ 'admin.stock.move_instruction.delete_confirm_message'|trans({ '%id%': instruction.id }) }}</p>
                            </div>
                            <div class="modal-footer">
                                <button type="button" class="btn btn-ec-sub" data-bs-dismiss="modal">{{ 'admin.common.cancel'|trans }}</button>
                                <form method="post" action="{{ url('admin_stock_move_instruction_delete', { id: instruction.id }) }}" class="d-inline">
                                    <input type="hidden" name="{{ constant('Eccube\\Common\\Constant::TOKEN_NAME') }}" value="{{ csrf_token(constant('Eccube\\Common\\Constant::TOKEN_NAME')) }}">
                                    <button type="submit" class="btn btn-ec-delete">{{ 'admin.common.delete'|trans }}</button>
                                </form>
                            </div>
                        </div>
                    </div>
                </div>
                {% endif %}

                <div class="c-conversionArea">
                    <div class="c-conversionArea__container">
                        <div class="row justify-content-between align-items-center">
                            <div class="col-6">
                                <div class="c-conversionArea__leftBlockItem">
                                    <a href="{{ url('admin_stock_move_instruction_list') }}" class="c-baseLink">
                                        <i class="fa fa-backward" aria-hidden="true"></i>
                                        <span>{{ 'admin.stock.move_instruction.back_to_list'|trans }}</span>
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
{% endblock %}

