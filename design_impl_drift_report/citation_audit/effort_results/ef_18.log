    <script nonce="{{ csp_nonce }}">
        (function() {
            const approvalMembersUrl = '{{ url('admin_stock_split_join_approval_members') }}';

            let modalSplitCsv = document.getElementById('modalSplitCsv');
            let modalJoinCsv = document.getElementById('modalJoinCsv');

            function reloadApprovalMembers(storeId) {
                if (!storeId) { return; }
                fetch(approvalMembersUrl + '?store_id=' + encodeURIComponent(storeId), {
                    headers: { 'X-Requested-With': 'XMLHttpRequest' },
                })
                    .then(function(r) { return r.ok ? r.json() : Promise.reject(r.status); })
                    .then(function(data) {
                        // native select を ID で直接取得して再構築
                        const nativeSelect = document.getElementById('admin_stock_split_csv_upload_approval_notification_target_members');
                        if (!nativeSelect) { return; }
                        while (nativeSelect.options.length > 0) { nativeSelect.remove(0); }
                        (data.options || []).forEach(function(opt) {
                            const o = document.createElement('option');
                            o.value = opt.value;
                            o.textContent = opt.label;
                            nativeSelect.appendChild(o);
                        });
                        // チップ UI のマトリクスを更新して再初期化
                        const root = nativeSelect.closest('[data-stock-approval-ui]');
                        if (!root) { return; }
                        const matrixEl = root.querySelector('.js-stock-approval-matrix');
                        if (matrixEl) {
                            matrixEl.textContent = JSON.stringify(data.matrix || []);
                        }
                        root.removeAttribute('data-stock-approval-ui-inited');
                        if (window.eccubeInitStockApprovalUi) {
                            window.eccubeInitStockApprovalUi(root);
                        }
                    })
                    .catch(function(err) {
                        console.error('承認通知先の読み込みに失敗しました', err);
                    });
            }

            if (modalSplitCsv) {
                modalSplitCsv.addEventListener('show.bs.modal', function() {
                    let form = document.getElementById('form-stock-split-csv-upload');
                    if (!form || !window.eccubeInitStockApprovalUi) {
                        return;
                    }
                    form.querySelectorAll('[data-stock-approval-ui]').forEach(function(root) {
                        root.removeAttribute('data-stock-approval-ui-inited');
                        window.eccubeInitStockApprovalUi(root);
                    });
                });

                // 店舗ドロップダウン: ID で直接 change リスナーを登録
                const storeSelect = document.getElementById('admin_stock_split_csv_upload_store');
                if (storeSelect) {
                    storeSelect.addEventListener('change', function() {
                        reloadApprovalMembers(storeSelect.value);
                    });
                }
            }

            document.addEventListener('change', function(e) {
                if (!e.target.name || e.target.name.indexOf('import_file') === -1) {
                    return;
                }
                if (modalSplitCsv && modalSplitCsv.contains(e.target)) {
                    let span = modalSplitCsv.querySelector('.js-csv-file-name');
                    if (span) span.textContent = e.target.files && e.target.files.length ? e.target.files[0].name : '{{ 'admin.stock.split_csv_modal.no_file_selected'|trans }}';
                }
                if (modalJoinCsv && modalJoinCsv.contains(e.target)) {
                    let spanJ = modalJoinCsv.querySelector('.js-csv-file-name');
                    if (spanJ) spanJ.textContent = e.target.files && e.target.files.length ? e.target.files[0].name : '{{ 'admin.stock.split_csv_modal.no_file_selected'|trans }}';
                }
            }, true);
        })();
    </script>

