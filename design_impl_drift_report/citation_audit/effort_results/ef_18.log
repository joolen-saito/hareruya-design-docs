class StockMoveInstructionController extends AbstractController
{
    private const SESSION_KEY_SEARCH = 'admin.stock.move_instruction.search';
    private const SESSION_KEY_PAGE_NO = 'admin.stock.move_instruction.page_no';
    private const SESSION_KEY_PAGE_COUNT = 'admin.stock.move_instruction.page_count';

    public function __construct(
        protected DtbStockMoveInstructionRepository $stockMoveInstructionRepository,
        protected DtbStockMoveTransferRepository $stockMoveTransferRepository,
        protected EntityManagerInterface $entityManager,
        protected StockMoveInstructionDetailUpdateAction $detailUpdateAction,
        protected StockMoveInstructionTrackingRegisterAction $trackingRegisterAction,
        protected StockMoveInstructionCsvUploadAction $csvUploadAction,
        protected StockMoveInstructionLabelCsvExporterService $stockMoveInstructionLabelCsvExporterService,
        protected PageMaxRepository $pageMaxRepository,
    ) {
    }

    /**
     * 在庫移動指示一覧（検索・全件表示）
     *
     * @return array<string, mixed>
     */
    #[Route(path: '/%eccube_admin_route%/product/stock/move-instruction', name: 'admin_stock_move_instruction_list', methods: ['GET', 'POST'])]
    #[Route(path: '/%eccube_admin_route%/product/stock/move-instruction/page/{page_no}', name: 'admin_stock_move_instruction_list_page', requirements: ['page_no' => '\d+'], methods: ['GET'])]
    #[Template(template: '@admin/Stock/stock_move_instruction_index.twig')]
    public function index(Request $request, PaginatorInterface $paginator, ?int $page_no = null): array
    {
        $session = $this->session;

        $builder = $this->formFactory->createBuilder(SearchStockMoveInstructionType::class);

        $event = new EventArgs(
            [
                'builder' => $builder,
            ],
            $request
        );
        $this->eventDispatcher->dispatch($event, EccubeEvents::ADMIN_STOCK_MOVE_INSTRUCTION_INDEX_INITIALIZE);

        $searchForm = $builder->getForm();

        $pageMaxis = $this->pageMaxRepository->findAll();
        $page_count = (int) $session->get(
            self::SESSION_KEY_PAGE_COUNT,
            $this->eccubeConfig->get('eccube_default_page_count')
        );

        $page_count_param = (int) $request->get('page_count');
        if ($page_count_param) {
            foreach ($pageMaxis as $pageMax) {
                if ((string) $page_count_param === $pageMax->getName()) {
                    $page_count = $pageMax->getName();
                    $session->set(self::SESSION_KEY_PAGE_COUNT, $page_count);
                    break;
                }
            }
        }

        $searchData = [];

        if ($request->isMethod('POST')) {
            $searchForm->handleRequest($request);
            if (!$searchForm->isSubmitted() || !$searchForm->isValid()) {
                return [
                    'searchForm' => $searchForm->createView(),
                    'pagination' => null,
                    'pageMaxis' => $pageMaxis,
                    'page_count' => $page_count,
                    'has_errors' => true,
                    'is_search_filter_active' => true,
                ];
            }

            $searchData = $searchForm->getData();
            $session->set(self::SESSION_KEY_SEARCH, FormUtil::getViewData($searchForm));
            $session->set(self::SESSION_KEY_PAGE_NO, 1);
            $page_no = 1;
        } else {
            if ($request->query->get('resume')) {
                $page_no = (int) $session->get(self::SESSION_KEY_PAGE_NO, 1);
                $viewData = $session->get(self::SESSION_KEY_SEARCH, []);
                $searchData = FormUtil::submitAndGetData($searchForm, $viewData);
            } elseif ($page_no !== null) {
                $session->set(self::SESSION_KEY_PAGE_NO, $page_no);
                $viewData = $session->get(self::SESSION_KEY_SEARCH, []);
                if ($viewData === []) {
                    $viewData = FormUtil::getViewData($searchForm);
                    $session->set(self::SESSION_KEY_SEARCH, $viewData);
                }
                $searchData = FormUtil::submitAndGetData($searchForm, $viewData);
            } else {
                $page_no = 1;
                $viewData = FormUtil::getViewData($searchForm);
                $searchData = FormUtil::submitAndGetData($searchForm, $viewData);
                $session->set(self::SESSION_KEY_SEARCH, $viewData);
                $session->set(self::SESSION_KEY_PAGE_NO, $page_no);
            }
        }

        $qb = $this->stockMoveInstructionRepository->getQueryBuilderBySearchData($searchData);

        $event = new EventArgs(
            [
                'qb' => $qb,
                'searchData' => $searchData,
            ],
            $request
        );
        $this->eventDispatcher->dispatch($event, EccubeEvents::ADMIN_STOCK_MOVE_INSTRUCTION_INDEX_SEARCH);

        $pagination = $paginator->paginate($qb, (int) $page_no, $page_count);

        $instructionIds = [];
        foreach ($pagination as $item) {
            if ($item instanceof DtbStockMoveInstruction) {
                $instructionIds[] = $item->getId();
            }
        }
        $outboundTotalCostMap = $this->stockMoveInstructionRepository->getOutboundTotalCostByIds($instructionIds);

        return [
            'searchForm' => $searchForm->createView(),
            'pagination' => $pagination,
            'outboundTotalCostMap' => $outboundTotalCostMap,
            'pageMaxis' => $pageMaxis,
            'page_count' => $page_count,
            'has_errors' => false,
            'is_search_filter_active' => $this->isSearchFilterActive($searchData),
        ];
    }

    /**
     * 在庫移動指示詳細（表示・送り状No・備考の編集）
     *
     * @return array<string, mixed>|RedirectResponse
     */
    #[Route(path: '/%eccube_admin_route%/product/stock/move-instruction/{id}', name: 'admin_stock_move_instruction_detail', requirements: ['id' => '\d+'], methods: ['GET', 'POST'])]
    #[Template(template: '@admin/Stock/stock_move_instruction_detail.twig')]
    public function detail(Request $request, int $id): array|RedirectResponse
    {
        $Instruction = $this->stockMoveInstructionRepository->find($id);
        if ($Instruction === null) {
            throw new NotFoundHttpException();
        }

        $originalTrackingNo = $Instruction->getTrackingNo();
        $builder = $this->formFactory->createBuilder(StockMoveInstructionDetailType::class, $Instruction);

        $event = new EventArgs(
            [
                'builder' => $builder,
                'Instruction' => $Instruction,
            ],
            $request
        );
        $this->eventDispatcher->dispatch($event, EccubeEvents::ADMIN_STOCK_MOVE_INSTRUCTION_DETAIL_INITIALIZE);

        $form = $builder->getForm();
        $form->handleRequest($request);

        if ($form->isSubmitted() && $form->isValid()) {
            $newTrackingNo = trim($Instruction->getTrackingNo() ?? '');
            if ($originalTrackingNo !== null && $originalTrackingNo !== '' && $newTrackingNo === '') {
                $form->get('trackingNo')->addError(
                    new FormError(
                        $this->translator->trans('admin.stock.move_instruction.detail_tracking_no_cannot_be_cleared', [], 'messages')
                    )
                );
            } else {
                $input = new StockMoveInstructionDetailUpdateInput(
                    $Instruction,
                    $this->getMember(),
                );
                $this->detailUpdateAction->handle($input);

                $event = new EventArgs(
                    [
                        'Instruction' => $Instruction,
                    ],
                    $request
                );
                $this->eventDispatcher->dispatch($event, EccubeEvents::ADMIN_STOCK_MOVE_INSTRUCTION_DETAIL_COMPLETE);

                $this->addSuccess('admin.common.save_complete', 'admin');

                return $this->redirectToRoute('admin_stock_move_instruction_detail', ['id' => $id]);
            }
        }

        $Moves = $this->stockMoveTransferRepository->findBy(
            ['moveInstructionId' => $Instruction->getId()],
            ['id' => 'ASC']
        );

        $moveIds = array_map(static fn ($m) => $m->getId(), $Moves);
        $moveAggregates = $this->stockMoveInstructionRepository->getTransferAggregatesByTransferIds(
            $moveIds,
            $Instruction->getMoveFromPriceThreshold()
        );

        $outboundTotalCost = '0';
        $highTotalPrice = '0';
        $regularTotalPrice = '0';
        foreach ($moveAggregates as $agg) {
            $outboundTotalCost = bcadd($outboundTotalCost, $agg['outbound_total_cost'], 2);
            $highTotalPrice = bcadd($highTotalPrice, $agg['high_total'], 2);
            $regularTotalPrice = bcadd($regularTotalPrice, $agg['regular_total'], 2);
        }

        return [
            'instruction' => $Instruction,
            'form' => $form->createView(),
            'Moves' => $Moves,
            'moveAggregates' => $moveAggregates,
            'outboundTotalCost' => $outboundTotalCost,
            'highTotalPrice' => $highTotalPrice,
            'regularTotalPrice' => $regularTotalPrice,
        ];
    }

    /**
     * 送り状No.登録（一覧画面からモーダルで登録）
     */
    #[Route(path: '/%eccube_admin_route%/product/stock/move-instruction/{id}/tracking', name: 'admin_stock_move_instruction_register_tracking', requirements: ['id' => '\d+'], methods: ['POST'])]
    public function registerTracking(Request $request, int $id): RedirectResponse
    {
        $this->isTokenValid();

        $Instruction = $this->stockMoveInstructionRepository->find($id);
        if ($Instruction === null) {
            throw new NotFoundHttpException();
        }

        $trackingNo = $request->request->get('tracking_no');
        $trackingNo = is_string($trackingNo) ? trim($trackingNo) : '';

        $originalTrackingNo = $Instruction->getTrackingNo();
        if ($originalTrackingNo !== null && $originalTrackingNo !== '' && $trackingNo === '') {
            $this->addError('admin.stock.move_instruction.detail_tracking_no_cannot_be_cleared', 'admin');

            return $this->redirectToRoute('admin_stock_move_instruction_list', array_merge($request->query->all(), ['resume' => '1']));
        }

        $Member = $this->getMember();
        $maxLen = (int) $this->eccubeConfig['eccube_text_type_column_max_len'];
        if ($trackingNo !== '' && mb_strlen($trackingNo) > $maxLen) {
            $this->addError(
                $this->translator->trans(
                    'admin.stock.move_instruction.tracking_no_max_length',
                    ['%max%' => (string) $maxLen],
                    'messages'
                ),
                'admin'
            );

            return $this->redirectToRoute('admin_stock_move_instruction_list', array_merge($request->query->all(), ['resume' => '1']));
        }

        $this->trackingRegisterAction->handle($Instruction, $trackingNo, $Member);

        $event = new EventArgs(
            [
                'Instruction' => $Instruction,
            ],
            $request
        );
        $this->eventDispatcher->dispatch($event, EccubeEvents::ADMIN_STOCK_MOVE_INSTRUCTION_REGISTER_TRACKING_COMPLETE);

        $this->addSuccess('admin.stock.move_instruction.tracking_register_success', 'admin');

        return $this->redirectToRoute('admin_stock_move_instruction_list', array_merge($request->query->all(), ['resume' => '1']));
    }

    /**
     * 在庫移動指示削除（送り状No登録後は削除不可）
     */
    #[Route(path: '/%eccube_admin_route%/product/stock/move-instruction/{id}/delete', name: 'admin_stock_move_instruction_delete', requirements: ['id' => '\d+'], methods: ['POST'])]
    public function delete(Request $request, int $id): RedirectResponse
    {
        $this->isTokenValid();

        $Instruction = $this->stockMoveInstructionRepository->find($id);
        if ($Instruction === null) {
            throw new NotFoundHttpException();
        }

        try {
            $this->deleteInstruction($Instruction);
        } catch (StockMoveInstructionDeleteException) {
            $this->addError('admin.stock.move_instruction.delete_error_after_tracking', 'admin');

            return $this->redirectToRoute('admin_stock_move_instruction_detail', ['id' => $id]);
        }

        $event = new EventArgs(
            [
                'Instruction' => $Instruction,
            ],
            $request
        );
        $this->eventDispatcher->dispatch($event, EccubeEvents::ADMIN_STOCK_MOVE_INSTRUCTION_DELETE_COMPLETE);

        $this->addSuccess('admin.common.delete_complete', 'admin');

        return $this->redirectToRoute('admin_stock_move_instruction_list', ['resume' => '1']);
    }

    /**
     * 在庫移動指示一覧検索
     *
     * @param array<string, mixed> $searchData
     *
     * @return list<DtbStockMoveInstruction>
     */
    /**
     * 在庫移動指示削除（送り状No未登録のみ可。紐づく Transfer の move_instruction_id / luggage_no を null にしてから削除）
     *
     * @throws StockMoveInstructionDeleteException 送り状No.登録済みの場合は削除不可
     */
    private function deleteInstruction(DtbStockMoveInstruction $Instruction): void
    {
        $trackingNo = $Instruction->getTrackingNo();
        if ($trackingNo !== null && $trackingNo !== '') {
            throw new StockMoveInstructionDeleteException();
        }

        $Moves = $this->stockMoveTransferRepository->findBy(
            ['moveInstructionId' => $Instruction->getId()],
            ['id' => 'ASC']
        );
        foreach ($Moves as $Move) {
            $Move->setTrackingNo(null);
            $Move->setMoveInstructionId(null);
        }

