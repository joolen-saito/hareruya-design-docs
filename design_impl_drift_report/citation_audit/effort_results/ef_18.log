namespace Eccube\Service\Admin\Stock;

use Doctrine\DBAL\LockMode;
use Doctrine\ORM\EntityManagerInterface;
use Eccube\Entity\DtbStockSplitJoin;
use Eccube\Entity\DtbStockSplitJoinDetail;
use Eccube\Entity\Master\MtbStockChangeTypeDetail;
use Eccube\Entity\Master\MtbStockHistorySourceType;
use Eccube\Entity\Master\MtbStockSplitJoinStatus;
use Eccube\Entity\Member;
use Eccube\Entity\ProductStock;
use Eccube\Exception\Admin\Stock\StockJoinMoveToShortageValidationException;
use Eccube\Repository\DtbStockSplitJoinDetailRepository;
use Eccube\Repository\DtbStockSplitJoinRepository;
use Eccube\Repository\Master\MtbStockChangeTypeDetailRepository;
use Eccube\Repository\Master\MtbStockHistorySourceTypeRepository;
use Eccube\Repository\Master\MtbStockSplitJoinStatusRepository;
use Eccube\Repository\ProductStockRepository;
use Eccube\Service\Admin\Stock\ActionInput\StockJoinMoveToShortageEntryInput;
use Eccube\Service\EntityManager\ProductStockEntityManager;
use Eccube\Service\EntityManager\StockHistoryEntityManager;
use Eccube\Service\EntityManager\StockSplitJoinStatusHistoryEntityManager;

/**
 * 在庫結合の欠品入力遷移（結合元登録ステータスへ遷移）を行う。
 * NEWステータスの場合は Session の結合元データから DtbStockSplitJoinDetail を作成して在庫操作も実施する。
 * リダイレクト先は Controller が決定する（本 Action は結果のみ返す）。
 */
class StockJoinMoveToShortageEntryAction
{
    public function __construct(
        private readonly DtbStockSplitJoinRepository $stockSplitJoinRepository,
        private readonly DtbStockSplitJoinDetailRepository $stockSplitJoinDetailRepository,
        private readonly MtbStockSplitJoinStatusRepository $statusRepository,
        private readonly EntityManagerInterface $entityManager,
        private readonly StockSplitJoinStatusHistoryEntityManager $statusHistoryEntityManager,
        private readonly ProductStockRepository $productStockRepository,
        private readonly ProductStockEntityManager $productStockEntityManager,
        private readonly StockHistoryEntityManager $stockHistoryEntityManager,
        private readonly MtbStockChangeTypeDetailRepository $stockChangeTypeDetailRepository,
        private readonly MtbStockHistorySourceTypeRepository $stockHistorySourceTypeRepository,
    ) {
    }

    /**
     * @return array{joinId: int}
     *
     * @throws StockJoinMoveToShortageValidationException
     */
    public function handle(StockJoinMoveToShortageEntryInput $input): array
    {
        $ProductStock = $input->ProductStock;
        $Member = $input->Member !== null
            ? $this->entityManager->find(Member::class, $input->Member->getId())
            : null;

        if ($Member === null) {
            throw new StockJoinMoveToShortageValidationException('admin.stock.split_join.login_required', 'admin_stock_join_new', ['productStockId' => $ProductStock->getId()]);
        }

        $StockSplitJoin = $this->resolveStockSplitJoin($input);
        $statusId = $StockSplitJoin->getStockSplitJoinStatus()->getId();

        if ($statusId === MtbStockSplitJoinStatus::NEW) {
            $this->validateForNew($StockSplitJoin, $input->sessionSources);
            $this->createDetailsFromSession($StockSplitJoin, $input->sessionSources, $Member);
        } else {
            $this->validateForRegistered($StockSplitJoin);
        }

        $Status = $this->statusRepository->find(MtbStockSplitJoinStatus::JOIN_SOURCE_REGISTERED);
        if ($Status === null) {
            throw new \LogicException('StockJoinMoveToShortageEntryAction requires JOIN_SOURCE_REGISTERED status in master.');
        }

        $now = new \DateTime();
        $StockSplitJoin->setStockSplitJoinStatus($Status);
        $StockSplitJoin->setMoveToApprovalAt($now);
        $StockSplitJoin->setMoveToApprovalMember($Member);
        $StockSplitJoin->setUpdater($Member);
        $StockSplitJoin->setUpdateDate($now);

        $this->statusHistoryEntityManager->save(null, $StockSplitJoin, $Status, $Member, $now);
        $this->entityManager->flush();

        return ['joinId' => (int) $StockSplitJoin->getId()];
    }

    /**
     * NEWステータス用バリデーション（Session データを検証）
     *
     * @param array<int, array{quantity: int}> $sessionSources
     *
     * @throws StockJoinMoveToShortageValidationException
     */
    private function validateForNew(DtbStockSplitJoin $StockSplitJoin, array $sessionSources): void
    {
        if ($sessionSources === []) {
            throw new StockJoinMoveToShortageValidationException('admin.stock.join.require_at_least_one_source', 'admin_stock_join_edit', ['id' => $StockSplitJoin->getId()]);
        }

        $plannedTotal = 0;
        foreach ($sessionSources as $data) {
            $plannedTotal += \max(0, $data['quantity']);
        }
        if ($plannedTotal < 1) {
            throw new StockJoinMoveToShortageValidationException('admin.stock.join.apply_approval_zero_quantity', 'admin_stock_join_edit', ['id' => $StockSplitJoin->getId()]);
        }
    }

    /**
     * JOIN_SOURCE_REGISTERED ステータス用バリデーション（DB の Detail を検証）
     *
     * @throws StockJoinMoveToShortageValidationException
     */
    private function validateForRegistered(DtbStockSplitJoin $StockSplitJoin): void
    {
        $sources = $this->stockSplitJoinDetailRepository->findByStockSplitJoin($StockSplitJoin);
        if (\count($sources) < 1) {
            throw new StockJoinMoveToShortageValidationException('admin.stock.join.require_at_least_one_source', 'admin_stock_join_edit', ['id' => $StockSplitJoin->getId()]);
        }

        $plannedJoinTotal = 0;
        foreach ($sources as $SourceDetail) {
            $plannedJoinTotal += \max(0, $SourceDetail->getSourceStock() - $SourceDetail->getShortageQuantity());
        }
        if ($plannedJoinTotal < 1) {
            throw new StockJoinMoveToShortageValidationException('admin.stock.join.apply_approval_zero_quantity', 'admin_stock_join_edit', ['id' => $StockSplitJoin->getId()]);
        }
    }

    /**
     * Session データから DtbStockSplitJoinDetail を作成し、在庫を操作する（単一トランザクション）
     *
     * @param array<int, array{quantity: int}> $sessionSources
     */
    private function createDetailsFromSession(DtbStockSplitJoin $StockSplitJoin, array $sessionSources, Member $Member): void
    {
        $joinOutboundType = $this->stockChangeTypeDetailRepository->find(MtbStockChangeTypeDetail::JOIN_OUTBOUND);
        $historySourceType = $this->stockHistorySourceTypeRepository->find(MtbStockHistorySourceType::STOCK_JOIN_EDIT);
        if ($joinOutboundType === null || $historySourceType === null) {
            throw new \LogicException('StockJoinMoveToShortageEntryAction requires JOIN_OUTBOUND and history source type masters.');
        }

        $now = new \DateTime();

        $this->entityManager->beginTransaction();
        try {
            $this->entityManager->lock($StockSplitJoin, LockMode::PESSIMISTIC_WRITE);

            /** @var list<DtbStockSplitJoinDetail> $createdDetails */
            $createdDetails = [];

            $destCode = (string) ($StockSplitJoin->getProductStock()->getProductClass()->getCode() ?? '');
            $srcCodes = [];
            foreach (array_keys($sessionSources) as $srcPsId) {
                $srcPs = $this->productStockRepository->find((int) $srcPsId);
                if ($srcPs instanceof ProductStock) {
                    $srcCodes[] = (string) ($srcPs->getProductClass()->getCode() ?? '');
                }
            }
            $joinOutboundReason = '在庫結合による減算 結合元：'.implode('、', array_filter($srcCodes)).' 結合先：'.$destCode.' 在庫結合分割番号：'.$StockSplitJoin->getId();

            foreach ($sessionSources as $psId => $data) {
                $SrcPs = $this->productStockRepository->find((int) $psId);
                if (!$SrcPs instanceof ProductStock) {
                    continue;
                }
                $this->entityManager->lock($SrcPs, LockMode::PESSIMISTIC_WRITE);
                $this->entityManager->refresh($SrcPs);

                $quantity = \min(\max(0, $data['quantity']), (int) ($SrcPs->getStock() ?? 0));
                if ($quantity <= 0) {
                    continue;
                }

                $ProductClass = $SrcPs->getProductClass();
                $basePrice = (string) ($ProductClass->getStandardPrice() ?? 0);
                $sourceStock = (int) ($SrcPs->getStock() ?? 0);

