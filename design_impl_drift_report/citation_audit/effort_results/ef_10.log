    /**
     * 買取商品検索一覧（UniSearch）。
     *
     * @return array<string, mixed>
     */
    #[Route(path: '/purchase/search', name: 'purchase_search', methods: ['GET'])]
    #[Route(path: '/purchase/search/cate/{categoryId}/tag/{tagId}', name: 'purchase_search_category_tag', requirements: ['categoryId' => '\d+', 'tagId' => '\d+(?:-\d+)*'], methods: ['GET'])]
    #[Route(path: '/purchase/search/cate/{categoryId}', name: 'purchase_search_category', requirements: ['categoryId' => '\d+'], methods: ['GET'])]
    #[Route(path: '/purchase/search/tag/{tagId}', name: 'purchase_search_tag', requirements: ['tagId' => '\d+(?:-\d+)*'], methods: ['GET'])]
    #[Template(template: 'Purchase/search.twig')]
    public function search(Request $request, ?int $categoryId = null, ?string $tagId = null): array
    {
        if ($categoryId !== null) {
            $request->query->set('category', (string) $categoryId);
        }

        if ($tagId !== null) {
            $request->query->set('tags', array_values(array_filter(explode('-', $tagId), static fn (string $v): bool => $v !== '')));
        }

        // 検索条件がなければフォームだけ返す
        if (!$this->frontProductSearchRequestQueryNormalizer->hasMeaningfulSearchCriteria($request)) {
            return $this->buildPurchaseSearchFormContext($request);
        }

        // UniSearch API URL が設定されていることを確認
        $this->assertUnisearchApiUrlConfigured();

        $unisearchList = $this->buildPurchaseUnisearchListFromRequest($request);

        // 詳細検索モーダル
        $quickSearchModalForm = $this->createPurchaseQuickSearchForm();
        $quickSearchModalForm->handleRequest($request);

        // パンくずリストを組み立て
        $breadcrumbVariables = $this->buildPurchaseSearchBreadcrumbVariables(
            $request,
            $unisearchList['searchData'],
            $unisearchList['quickSearchData'],
        );

        // ソート順リストを組み立て
        $orderByChoicesForList = PurchaseProductListOrderBy::toolbarChoices($this->translator);

        // カテゴリリストを組み立て
        $locale = $request->getLocale() ?: 'ja';
        $categoryGroups = $this->topCategoryListBuilder->build($locale, CategorySidebarLinkContext::forPurchase());
        $categoryFormatGroups = [
            ['type' => TopCategoryListBuilder::GROUP_STANDARD, 'items' => $categoryGroups[TopCategoryListBuilder::GROUP_STANDARD]['items']],
            ['type' => TopCategoryListBuilder::GROUP_PIONEER, 'items' => $categoryGroups[TopCategoryListBuilder::GROUP_PIONEER]['items']],
            ['type' => TopCategoryListBuilder::GROUP_MODERN, 'items' => $categoryGroups[TopCategoryListBuilder::GROUP_MODERN]['items']],
            ['type' => TopCategoryListBuilder::GROUP_LEGACY, 'items' => $categoryGroups[TopCategoryListBuilder::GROUP_LEGACY]['items']],
            ['type' => TopCategoryListBuilder::GROUP_COMMANDER, 'items' => $categoryGroups[TopCategoryListBuilder::GROUP_COMMANDER]['items']],
        ];

        return [
            'search_form' => $unisearchList['searchForm']->createView(),
            'quick_search_form' => $unisearchList['quickSearchForm']->createView(),
            'quick_search_modal_form' => $quickSearchModalForm->createView(),
            'default_product_list_max' => $unisearchList['defaultListMax'],
            'product_list_order_by_choices' => $orderByChoicesForList,
            'current_product_list_order_by_id' => $unisearchList['currentOrderById'],
            'unisearch_purchase_list_query' => $unisearchList['unisearchQueryString'],
            'purchase_list_unisearch_max_rows' => UniSearchService::MAX_ROWS_SIZE,
            'purchase_list_limit' => $unisearchList['listLimit'],
            'purchase_list_unisearch_load_failed_message' => $this->translator->trans('front.product.unisearch_load_failed'),
            'purchaseCartMaxQtyPerLine' => PurchaseCartService::MAX_QUANTITY_PER_LINE,
            'is_purchase_search_executed' => true,
            'Category' => $breadcrumbVariables['category'],
            'product_list_detailed_search_breadcrumb_text' => $breadcrumbVariables['productListDetailedSearchBreadcrumbText'],
            'latestSetItems' => $categoryGroups[TopCategoryListBuilder::GROUP_LATEST_SET]['items'],
            'formatGroups' => $categoryFormatGroups,
            'othersItems' => $categoryGroups[TopCategoryListBuilder::GROUP_OTHERS]['items'],
            'bulkPurchaseProductId' => $this->resolveBulkPurchaseProductId(),
            'purchase_search_form_action' => $this->resolvePurchaseSearchFormAction($request),
        ];
    }

    /**
     * 買取一覧: フォーム serialize から UniSearch クエリ文字列とパンくず HTML を返す（Ajax 部分更新用）。
     */
    #[Route(path: '/purchase/products/search/unisearch/query', name: 'purchase_product_search_unisearch_query', methods: ['GET'])]
{#
  買取商品検索一覧
#}
{% extends 'default_frame.twig' %}

{% set body_class = 'purchase purchase_page purchase_search' %}
{% if Category is defined and Category %}
    {% set _purchase_names = [] %}
    {% for _cat in Category.path %}
        {% set _purchase_names = _purchase_names|merge([_cat.name]) %}
    {% endfor %}
    {% if _purchase_names|length >= 3 and _purchase_names[1] in _purchase_names[2] %}
        {% set _purchase_names = [_purchase_names[0], _purchase_names[2]] %}
    {% endif %}
    {% set subtitle = _purchase_names|join(' / ') ~ ('front.seo.purchase_list.subtitle_suffix'|trans) %}
{% else %}
    {% set subtitle = 'front.seo.purchase_list.subtitle_default'|trans %}
{% endif %}

{% block stylesheet %}
    <link rel="stylesheet" href="{{ asset('assets/hareruya/css/hareruya-products-list.css') }}">
{% endblock %}

{% block javascript %}
    {{ include('Block/js/Purchase/purchase_js.twig') }}
    {% if is_purchase_search_executed|default(false) %}
    <script src="{{ asset('assets/hareruya/js/hareruya-unisearch-related-keywords.js') }}"></script>
    <script src="{{ asset('assets/hareruya/js/hareruya-unisearch-list-client-core.js') }}"></script>
    <script src="{{ asset('assets/hareruya/js/hareruya-products.js') }}" defer></script>
    {% endif %}
{% endblock %}

{% block main %}
<div class="ec-layoutRole__main">
    {% if is_purchase_search_executed|default(false) %}
        {% set purchase_unisearch_loading_html -%}
<div class="ec-purchaseSearch__results-status purchase-list-unisearch-loading" style="grid-column: 1 / -1; text-align: center; padding: 2rem;"><img src="{{ asset('assets/img/ajax-loader.gif') }}" alt="" width="24" height="24"></div>
        {%- endset %}
        {% set purchase_unisearch_client_config = {
            query: unisearch_purchase_list_query|default(''),
            page: app.request.query.get('pageno')|default(1),
            pageSize: purchase_list_limit|default(60),
            maxRows: purchase_list_unisearch_max_rows|default(4000),
            queryUrl: path('purchase_product_search_unisearch_query'),
            apiUrl: path('product_search_unisearch_api'),
            tempUrl: path('purchase_product_search_unisearch_temp'),
            lazyUrl: path('purchase_product_search_unisearch_lazy_load'),
            countTpl: 'front.product_list.product_count'|trans({ '%count%': '__COUNT__' }),
            loadFailedMsg: purchase_list_unisearch_load_failed_message|default('Failed to load.'),
            pagerPrev: 'common.prev'|trans,
            pagerNext: 'common.next'|trans,
            pagerNavAria: 'common.pager.nav_aria'|trans,
            pagerPrevAria: 'common.pager.prev_aria'|trans,
            pagerNextAria: 'common.pager.next_aria'|trans,
            pagerPageAria: 'common.pager.page_aria'|trans({'%page%': '__PAGE__'}),
            emptyResultMsg: 'front.product.search__product_not_found'|trans,
            fallbackNotFoundTpl: 'front.product.unisearch_fallback_not_found'|trans({ '%original%': '__ORIGINAL__' }),
            fallbackShowingTpl: 'front.product.unisearch_fallback_showing'|trans({ '%fallback%': '__FALLBACK__' }),
            loadingHtml: purchase_unisearch_loading_html,
            loggedInUserHash: app.user ? hash_login_id(app.user.id) : '',
        } %}
        <div class="p-hareruya-product-list">
            <div class="p-hareruya-product-list__layout">
                <aside class="p-hareruya-product-list__sidebar">
                    <div class="p-hareruya-product-list__sidebar-inner">
                        <div class="p-hareruya-product-list__sidebar-button">
                            {% if quick_search_form is defined %}
                                <button class="c-hareruya-btn c-hareruya-btn--tall u-hareruya-w-full" type="button" id="purchase-search-detailed-search" data-modal-open="purchase-search"><i class="icon-hareruya-shosai c-hareruya-icon" aria-hidden="true"></i><span class="p-hareruya-product-list__sidebar-button-text">{{ 'front.product_search.detailed_search'|trans }}</span></button>
                            {% else %}
                                <a href="{{ url('purchase_search', { purchaseFlg: true }) }}" class="c-hareruya-btn c-hareruya-btn--tall u-hareruya-w-full"><i class="icon-hareruya-shosai c-hareruya-icon" aria-hidden="true"></i><span class="p-hareruya-product-list__sidebar-button-text">{{ 'front.product_search.detailed_search'|trans }}</span></a>
                            {% endif %}
                        </div>
                        {% include 'Block/product_list_category_sidebar.twig' %}
                    </div>
                </aside>
                <div class="p-hareruya-product-list__main">
                    <div class="ec-purchaseSearch"
                         data-js-unisearch-purchase-list
                         data-unisearch-config="{{ purchase_unisearch_client_config|json_encode|e('html_attr') }}">
                        <div class="p-hareruya-product-list__breadcrumb-wrap">
                            <div class="ec-searchnavRole__topicpath">
                                {% include 'breadcrumb_nav.twig' %}
                            </div>
                        </div>
                        <div class="p-hareruya-product-list__keywords"
                             id="purchase-list-related-keywords"
                             data-unisearch-related-keywords
                             data-rword-api-url="{{ path('product_search_unisearch_rword_api') }}"
                             data-search-url-base="{{ url('purchase_search') }}"
                             data-search-url-params="purchaseFlg=1&amp;product="
                             data-unisearch-query="{{ unisearch_purchase_list_query|default('')|e('html_attr') }}"
                             hidden>
                            <p class="p-hareruya-product-list__keywords-title">{% if app.locale == 'ja' %}関連キーワード{% else %}Related keywords{% endif %}</p>
                        </div>
                        <form id="purchase-search-form" name="purchase_search_form" method="get" action="{{ purchase_search_form_action|default(url('purchase_search')) }}">
                <input type="hidden" name="purchaseFlg" value="1">
                {% if app.request.query.get('cardId') %}
                    <input type="hidden" name="cardId" value="{{ app.request.query.get('cardId') }}">
                {% endif %}
                {% for item in search_form %}
                    {% if item.vars.name not in ['disp_number', 'orderby', 'tags', 'pageno'] %}
                        <input type="hidden" id="{{ item.vars.id }}" name="{{ item.vars.full_name }}"{% if item.vars.value is not empty %} value="{{ item.vars.value }}"{% endif %}>
                    {% endif %}
                {% endfor %}
                {% if search_form.tags|length > 0 %}
                    <div class="d-none" aria-hidden="true">
                        {{ form_widget(search_form.tags) }}
                    </div>
                {% endif %}
                {% if default_product_list_max is defined %}
--- terms flow ---
                        <div class="p-hareruya-shipping__row">
                            <div class="p-hareruya-shipping__heading-wrap">
                                <h2 class="c-hareruya-heading--lev3">{{ 'front.purchase.fill.section_invoice'|trans }}</h2>
                            </div>
                            <div class="p-hareruya-shipping__content">
                                <div class="p-hareruya-purchase-confirm__field">
                                    <fieldset class="p-hareruya-purchase-confirm__radio-fieldset">
                                        <legend class="p-hareruya-purchase-confirm__field-label">{{ 'front.purchase.fill.invoice_question'|trans }}</legend>
                                        <div class="p-hareruya-form-block__fields--row">
                                            <label class="c-hareruya-radio" for="isQualifiedInvoiceIssuer_true">
                                                <input class="c-hareruya-radio__input" id="isQualifiedInvoiceIssuer_true" type="radio" name="isQualifiedInvoiceIssuer" value="true" {% if isQualifiedInvoiceIssuerAccount %}checked{% endif %} required>
                                                <span class="c-hareruya-text">{{ 'front.purchase.fill.invoice_yes'|trans }}</span>
                                            </label>
                                            <label class="c-hareruya-radio" for="isQualifiedInvoiceIssuer_false">
                                                <input class="c-hareruya-radio__input" id="isQualifiedInvoiceIssuer_false" type="radio" name="isQualifiedInvoiceIssuer" value="false" {% if not isQualifiedInvoiceIssuerAccount %}checked{% endif %} required>
                                                <span class="c-hareruya-text">{{ 'front.purchase.fill.invoice_no'|trans }}</span>
                                            </label>
                                        </div>
                                    </fieldset>
                                </div>
                                <div class="p-hareruya-purchase-confirm__invoice-code-wrap">
                                    <div class="p-hareruya-form-block__fields--row">
                                        <div class="c-hareruya-form-input u-hareruya-w-240">
                                            {{ form_widget(invoiceForm.qualifiedInvoiceIssuerCode, { 'attr': { 'class': 'c-hareruya-form-input__field', 'maxlength': 14, 'data-js-invoice-code-validation': '' } }) }}
                                        </div>
                                        <p class="c-hareruya-text">{{ 'front.purchase.fill.invoice_code_hint'|trans }}</p>
{% set modalLabelId = modal_id ~ 'Label' %}

