namespace Plugin\HareruyaEc\Controller\Mypage;

use Eccube\Application;
use Symfony\Component\HttpFoundation\Request;
use Plugin\HareruyaEc\Util\CookieUtil;
use Plugin\HareruyaEc\Util\LoginUtil;
use Plugin\HareruyaEc\Util\OrderUtil;

class MypageController extends \Eccube\Controller\Mypage\MypageController
{
    const DEFAULT_PAGE = 1;
    const PAGE_SIZE = 10;

    /**
     * マイページイベント申し込み履歴
     * @params Application $app
     * @return \Symfony\Component\HttpFoundation\Response
     *
     */
    public function eventHistory(Application $app)
    {
        $player = $app['hareruya_ec.repository.player']->findOneByCustomerId($app->user()['id']);
        //ユーザのイベント申し込みリスト取得
        $entries = $app['hareruya_ec.repository.event_entry']->getEntriesByPlayerId($player['playerid']);

        return $app->render('Mypage/event_history.twig', [
            'entries' => $entries,
        ]);
    }

    /**
     * マイページデッキ登録
     * デッキ登録可能なイベントを全て表示する
     * @params Application $app
     * @param Request $request
     * @return \Symfony\Component\HttpFoundation\Response
     *
     */
    public function deckentryList(Application $app, Request $request)
    {
        $shopId = CookieUtil::getTopShopId(filter_input(INPUT_GET, 'shop'), $request);
        $event = $request->get('event');
        $player = $app['hareruya_ec.repository.player']->findOneByCustomerId($app->user()['id']);
        //デッキ登録可能なイベント詳細を取得
        $eventDetails = $app['hareruya_ec.repository.event_detail']->getDetailsThatCanBeRegisteredDeckentry($shopId, $event);

        //ユーザーのイベント申込みリスト取得
        $enteredEventDetails = $app['hareruya_ec.repository.event_detail']->getEntryEvents($player['playerid']);

        //登録済みのデッキとイベント詳細の組を取得
        $decks = $app['hareruya_ec.repository.deck']->getDetailsAndDecksByPlayerId($player['playerid']);
        $deckEventDetailIds = array_column($decks, 'deckId', 'eventDetailId');
        // イベント絞り込みフォームを取得
        $form = $app['form.factory']->createBuilder('mypage_deckentry_search')->getForm()->handleRequest($request);

        // マイデッキ情報の取得
        $myDeckId = $request->get('deckId');
        $myDeck = $app['hareruya_ec.repository.deck']->findOneBy(['deckId' => $myDeckId, 'player' => $player]);

        return $app->render('Mypage/deckentry_list.twig', [
            'eventDetails' => $eventDetails,
            'enteredEventDetails' => $enteredEventDetails,
            'deckEventDetailIds' => $deckEventDetailIds,
            'form' => $form->createView(),
            'currentShopId' => $shopId,
            'myDeckName' => $myDeck ? $myDeck->getDeckName() : '',
        ]);
    }

    /**
     * マイページチームメンバー変更
     * チームメンバー変更可能なイベントを全て表示する
     * @params Application $app
     * @return \Symfony\Component\HttpFoundation\Response
     *
     */
    public function changeTeamList(Application $app)
    {
        $player = $app['hareruya_ec.repository.player']->findOneByCustomerId($app->user()['id']);
        //ユーザのイベント申し込みリスト取得
        $entries = $app['hareruya_ec.repository.event_entry']->getTeamEntriesByPlayerId($player['playerid']);

        return $app->render('Mypage/change_team_list.twig', [
            'entries' => $entries,
            'seats' => $app['config']['HareruyaEc']['const']['seat'],
        ]);
    }

