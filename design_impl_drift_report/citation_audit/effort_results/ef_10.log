                    <button class="p-hareruya-product-carousel__nav-next" type="button" aria-label="{{ 'front.top.carousel.next'|trans }}"><i class="icon-hareruya-slide-arrow-right c-hareruya-icon--lg" aria-hidden="true"></i></button>
