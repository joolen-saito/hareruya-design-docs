     *
     * @param  array<string, mixed> $searchData
     */
    private function resolveSearchListBannerHtml(array $searchData, Request $request): ?string
    {
        $preferEnglish = str_starts_with(strtolower($request->getLocale()), 'en');

        $pickLocalizedHtml = static function (?string $jp, ?string $en) use ($preferEnglish): ?string {
            $primary = $preferEnglish ? $en : $jp;
            if (StringUtil::isNotBlank($primary)) {
                return $primary;
            }
            if (StringUtil::isNotBlank($jp)) {
                return $jp;
            }
            if (StringUtil::isNotBlank($en)) {
                return $en;
            }

            return null;
        };

        $tagIds = $searchData['tags'] ?? [];
        foreach ($tagIds as $tagId) {
            $Tag = $this->tagRepository->find($tagId);
            if ($Tag !== null) {
                $html = $pickLocalizedHtml($Tag->getFreeAreaJp(), $Tag->getFreeAreaEn());
                if ($html !== null) {
                    return $html;
                }
            }
        }

        $Category = $searchData['category'] ?? null;
        if ($Category instanceof Category) {
            return $pickLocalizedHtml($Category->getHtmlJa(), $Category->getHtmlEn());
        }

        return null;
    }

