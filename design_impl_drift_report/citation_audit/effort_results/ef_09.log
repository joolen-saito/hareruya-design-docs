        /**
         * シェア用に商品名を指定文字数で切り詰める（全角89文字を超える場合は「…」で省略）.
         */
        public function getTruncatedNameForShare(int $maxLength = self::SNS_SHARE_PRODUCT_NAME_MAX_LENGTH): string
        {
            $name = (string) $this->name;
            if (mb_strlen($name, 'UTF-8') <= $maxLength) {
                return $name;
