{% extends 'default_frame.twig' %}

{% set body_class = 'shop_page' %}

{% block stylesheet %}
<link rel="stylesheet" href="{{ url('assets', {path: 'css/shoppage.css'}) }}">
{% endblock %}

{% block javascript %}
{{ include('Block/js/shoppage_js.twig') }}
{% endblock javascript %}

{% block main %}
<div class="store">
    <!--店舗ヘッダ-->
    <section class="storeHeader">
        <h1>
            {% if values.pc_image_file %}
            <img src="{{ values.pc_image_file }}" class="l-pc" alt="{{ values.pc_image_alt_text }}">
            {% endif %}
            {% if values.smp_image_file %}
            <img src="{{ values.smp_image_file }}" class="tablet" alt="{{ values.smp_image_alt_text }}">
            {% endif %}
            {% if values.event_link_link %}
            <div class="top_to_link">
                <a href="{{ values.event_link_link }}">大会情報はこちら</a>
            </div>
            {% endif %}
        </h1>
    </section>

    <!--SMP店舗カラム-->
    <section class="storeList tablet">

        <!--店舗一覧(SMP)-->
        {% if shops %}
        <ul class="storeList-listOuter">
            <p>
                閲覧店舗を選択
            </p>
            {% for shop in shops %}
            <li class="storeList-listInner {% if shop.id == shopId %}selected{% endif %}">
                <a href="{{ url('shop_page', { name: shop.htmlClassName}) }}">{{ shop.nameJp }}</a>
            </li>
            {% endfor %}
        </ul>
        {% endif %}

    </section>

    <!--店舗左カラム-->
    <div class="storeLeft l-pc">

        <!--店舗一覧-->
        {% if shops %}
        <section class="storeList">
            <h2 class="storeList-head storeHead">店舗一覧</h2>
            <ul class="storeList-listOuter">
                {% for shop in shops %}
                <li class="storeList-listInner storeList-listInner--{{ shop.htmlClassName }} {% if shop.id == shopId %}selected{% endif %}">
                    <a href="{{ url('shop_page', { name: shop.htmlClassName}) }}">晴れる屋 {{ shop.nameJp }}</a>
                </li>
                {% endfor %}
            </ul>
        </section>
        {% endif %}

        <!--晴れる屋ポイントの確認等バナー-->
        <section class="storeLeftBanner">
            <p id="modal-open" class="button-link">
                <img src="https://files.hareruyamtg.com/img/usr/store_info/point_banner_renew.png" alt="晴れる屋ポイントの確認はこちらから">
            </p>
        </section>

        <!--twitter-->
        {% if values.twitter_account %}
        <section class="storeTwitter">
            <h2 class="storeTwitter-head storeHead">Twitter</h2>
            <div class="storeTwitter-outer">
                <div class="storeTwitter-inner">
                    <a class="twitter-timeline" data-chrome="nofooter" data-lang="ja" data-height="400" data-theme="light" href="https://twitter.com/{{ values.twitter_account }}?ref_src=twsrc%5Etfw">Tweets by hareruya_TC</a> <script async src="https://platform.twitter.com/widgets.js" charset="utf-8"></script>
                </div>
            </div>
        </section>
        {% endif %}

    </div>

    <!--店舗右カラム-->
    <div class="storeRight">

        <!--ナビゲーション-->
        {% if rightColumns %}
        
            <nav class="storeNav">
                <ul class="storeNavList">
                    {% if 'shop_guide' in rightColumns %}<li {% if 'shop_guide' == lastElement %}class="NavLast"{% endif %}><a href="#storeGuide">店舗案内</a></li>{% endif %}
                    {% if 'handson_session' in rightColumns %}<li {% if 'handson_session' == lastElement %}class="NavLast"{% endif %}><a href="#storeAd">初心者講習会</a></li>{% endif %}
                    {% if 'selection' in rightColumns %}<li {% if 'selection' == lastElement %}class="NavLast"{% endif %}><a href="#storeItem">取り扱い商品</a></li>{% endif %}
                    {% if 'buying' in rightColumns %}<li {% if 'buying' == lastElement %}class="NavLast"{% endif %}><a href="#storePurchase">買取</a></li>{% endif %}
                    {% if 'staff' in rightColumns %}<li {% if 'staff' == lastElement %}class="NavLast"{% endif %}><a href="#storeStaff">スタッフ</a></li>{% endif %}
                    {% if 'other' in rightColumns %}<li {% if 'other' == lastElement %}class="NavLast"{% endif %}><a href="#storeOther">その他</a></li>{% endif %}
                    {% if 'access' in rightColumns %}<li {% if 'access' == lastElement %}class="NavLast"{% endif %}><a href="#storeAccess">アクセス</a></li>{% endif %}
                </ul>
            </nav>

            <!--フリーバナー-->
            {% if values.free_banner_file and values.free_banner_link %}
            <section class="storeAd">
                <a href="{{ values.free_banner_link }}">
                    <img src="{{ values.free_banner_file }}" alt="{{ values.free_banner_alt_text }}">
                </a>
            </section>
            {% endif %}

            <!--店頭受取バナー-->
            {% if values.store_uketori_file and values.store_uketori_link %}
            <section class="storeAd">
                <a href="{{ values.store_uketori_link }}" target="_blank">
                    <img src="{{ values.store_uketori_file }}" alt="{{ values.store_uketori_alt_text }}">
                </a>
            </section>
            {% endif %}

