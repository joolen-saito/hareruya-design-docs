    /**
     * 言語ごとに、数量をデフォルト1とする商品規格IDのリストを返す。
     *
     * @param array<string, array<int|string, mixed>> $productsByLanguage
     *
     * @return array<string, int>
     */
    private function buildDefaultQuantityClassIdsByLanguage(array $productsByLanguage): array
    {
        $shopForStock = $this->getShop();
        $conditionDisplayMinPrice = (int) $this->eccubeConfig['condition_display_min_price'];
        $defaultQuantityClassIdsByLanguage = [];

        foreach ($productsByLanguage as $languageCode => $languageProducts) {
            $displayableProductClasses = [];

            foreach ($languageProducts as $languageProductKey => $productClass) {
                if ($languageProductKey === 'back' || !$productClass instanceof ProductClass) {
                    continue;
                }

                if (!$productClass->isVisible()) {
                    continue;
                }

                $cardConditionCode = $productClass->getCardCondition()?->getCode();

                if ($cardConditionCode !== MtbCardCondition::CODE_NEAR_MINT
                    && (int) $productClass->getPrice02() < $conditionDisplayMinPrice) {
                    continue;
                }

                $displayableProductClasses[] = $productClass;
            }
