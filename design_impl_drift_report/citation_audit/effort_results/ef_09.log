namespace Eccube\Service\Block;

use Eccube\Repository\ProductRepository;
use Eccube\Service\BaseInfoService;
use Symfony\Component\HttpFoundation\RequestStack;

/**
 * recently_viewed ブロック用の Twig payload を構築する。
 */
class RecentlyViewedBlockPayloadBuilder
{
    private const MAX_HISTORY_COUNT = 15;

    public function __construct(
        private readonly ProductRepository $productRepository,
        private readonly BaseInfoService $baseInfoService,
        private readonly RequestStack $requestStack,
    ) {
    }

    /**
     * @return array{
     *     ProductClasses: array<int, \Eccube\Entity\ProductClass>,
     *     layout: string
     * }
     */
    public function build(string $route): array
    {
        $mainRequest = $this->requestStack->getMainRequest() ?? $this->requestStack->getCurrentRequest();

        if ($mainRequest === null) {
            throw new \RuntimeException('Request is not available.');
        }

        $historyCookie = $mainRequest->cookies->get('history', '');
        if ($historyCookie === '') {
            return [
                'ProductClasses' => [],
                'layout' => $this->resolveLayout($route),
            ];
        }

        $productIds = array_filter(
            array_map('intval', explode(',', $historyCookie)),
            static fn (int $id): bool => $id > 0,
        );

        if ($productIds === []) {
            return [
                'ProductClasses' => [],
                'layout' => $this->resolveLayout($route),
            ];
        }

        $productIds = array_slice($productIds, 0, self::MAX_HISTORY_COUNT);
        $baseInfoId = $this->baseInfoService->getByRequestShop()->getId();
        $ProductClasses = $this->productRepository->findPublicByIds(
            $productIds,
            $mainRequest->getLocale(),
            $baseInfoId,
        );

        $orderMap = array_flip($productIds);
        usort($ProductClasses, static fn ($a, $b) => ($orderMap[$a->getProduct()->getId()] ?? PHP_INT_MAX) <=> ($orderMap[$b->getProduct()->getId()] ?? PHP_INT_MAX));

        return [
            'ProductClasses' => $ProductClasses,
            'layout' => $this->resolveLayout($route),
        ];
    }

    private function resolveLayout(string $route): string
    {
        return match ($route) {
            'homepage' => 'top',
            'product_list' => 'list',
            default => 'detail',
        };
    }
}
