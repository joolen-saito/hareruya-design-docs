namespace Eccube\Service;

use Eccube\Entity\Category;
use Eccube\Repository\CategoryRepository;
use Eccube\Service\App\Category\CategorySidebarLinkContext;
use Eccube\Service\App\Category\CategoryTreeCardsetSyntheticChildrenGenerator;
use Eccube\Service\Front\ProductListSearchUrlBuilder;
use Eccube\Twig\Extension\EccubeExtension;

class TopCategoryListBuilder
{
    public const GROUP_LATEST_SET = 'latest-set';
    public const GROUP_STANDARD = 'standard';
    public const GROUP_PIONEER = 'pioneer';
    public const GROUP_MODERN = 'modern';
    public const GROUP_LEGACY = 'legacy';
    public const GROUP_COMMANDER = 'commander';
    public const GROUP_OTHERS = 'others';

    /** @var array<int, string> */
    private const FORMAT_CATEGORY_ID_TO_GROUP = [
        Category::NAV_STANDARD_ID => self::GROUP_STANDARD,
        Category::NAV_PIONEER_ID => self::GROUP_PIONEER,
        Category::NAV_MODERN_ID => self::GROUP_MODERN,
        Category::NAV_LEGACY_ID => self::GROUP_LEGACY,
        Category::NAV_COMMANDER_ID => self::GROUP_COMMANDER,
    ];

    public function __construct(
        private readonly CategoryRepository $categoryRepository,
        private readonly \Symfony\Component\HttpFoundation\RequestStack $requestStack,
        private readonly CategoryTreeCardsetSyntheticChildrenGenerator $cardsetGenerator,
        private readonly EccubeExtension $eccubeExtension,
        private readonly ProductListSearchUrlBuilder $productListSearchUrlBuilder,
    ) {
    }

    private function isBranchShopContext(): bool
    {
        $request = $this->requestStack->getCurrentRequest();
        if ($request === null) {
            return false;
        }

        return trim((string) $request->attributes->get('_shop', ''), '/') !== '';
    }

    /**
     * 第一階層のカテゴリを最新セット / フォーマット別 / その他 にグルーピングして返す。
     *
     * 各アイテムの href は $linkContext が指すルート（販売: product_list / product_category、買取: purchase_search）で生成する。
     *
     * @param CategorySidebarLinkContext $linkContext サイドバー各リンクの生成先ルート
     *
     * @return array<string, array{items: array<int, array<string, mixed>>}>
     */
    public function build(string $locale, CategorySidebarLinkContext $linkContext): array
    {
        $result = [
            'all' => ['items' => []],
            self::GROUP_LATEST_SET => ['items' => []],
            self::GROUP_STANDARD => ['items' => []],
            self::GROUP_PIONEER => ['items' => []],
            self::GROUP_MODERN => ['items' => []],
            self::GROUP_LEGACY => ['items' => []],
            self::GROUP_COMMANDER => ['items' => []],
            self::GROUP_OTHERS => ['items' => []],
        ];

        $firstLevelCategories = $this->categoryRepository->getList();
        $isBranch = $this->isBranchShopContext();

        // N+1 回避: 第一階層配下の全カテゴリIDを先にプリロード
        $categoryIds = array_values(array_filter(array_map(
            static fn (Category $c): ?int => $c->getId(),
            $firstLevelCategories
        )));
        $this->cardsetGenerator->beginPreloadForSubtree($categoryIds, $isBranch);

        foreach ($firstLevelCategories as $Category) {
            if ($Category->getFrontSearchHideFlg()) {
                continue;
            }
            if ($isBranch && $Category->getBranchHideFlg()) {
                continue;
            }

            $categoryId = $Category->getId();

            if ($categoryId === Category::NAV_LATEST_SET_ID) {
                foreach ($this->categoryRepository->getList($Category) as $Child) {
                    if ($Child->getFrontSearchHideFlg()) {
                        continue;
                    }
                    if ($isBranch && $Child->getBranchHideFlg()) {
                        continue;
                    }
                    $item = $this->buildCategoryItem($Child, $locale, $linkContext);
                    $result[self::GROUP_LATEST_SET]['items'][] = $item;
                    $result['all']['items'][] = $item;
                }
                // 最新セット自身に紐づくカードセット合成子要素（例: ギルドキット系）を直接アイテムとして追加
                foreach ($this->cardsetGenerator->generate($Category, $isBranch, $linkContext) as $cardsetNode) {
                    $item = $this->convertCardsetNode($cardsetNode, $locale);
                    $result[self::GROUP_LATEST_SET]['items'][] = $item;
                    $result['all']['items'][] = $item;
                }
            } elseif ($categoryId !== null && isset(self::FORMAT_CATEGORY_ID_TO_GROUP[$categoryId])) {
                $item = $this->buildCategoryItem($Category, $locale, $linkContext);
                $result[self::FORMAT_CATEGORY_ID_TO_GROUP[$categoryId]]['items'][] = $item;
                $result['all']['items'][] = $item;
            } else {
                $item = $this->buildCategoryItem($Category, $locale, $linkContext);
                $result[self::GROUP_OTHERS]['items'][] = $item;
                $result['all']['items'][] = $item;
            }
        }

        $this->cardsetGenerator->endPreload();

        return $result;
    }

    /**
     * @return array<string, mixed>
     */
    private function buildCategoryItem(Category $Category, string $locale, CategorySidebarLinkContext $linkContext): array
    {
        $searchParametersRaw = (string) ($Category->getSearchParameters() ?? '');
        $queryParams = $this->productListSearchUrlBuilder->parseSearchParameters($searchParametersRaw);
        // マスタの検索パラメータにカテゴリIDがあるのは運用エラーなので、取り除く。
        unset($queryParams['category']);
        $categoryIdForPath = $Category->getId();
        if ($queryParams !== []) {
