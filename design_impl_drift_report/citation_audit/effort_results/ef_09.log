    /**
     * お届け先登録処理（新規追加・既存編集の両方）
     *
     * @return RedirectResponse
     */
    #[Route(path: '/shopping/shipping_edit/{id}/complete/{addressId}', name: 'shopping_shipping_edit_complete', requirements: ['id' => '\d+', 'addressId' => '\d+'], defaults: ['addressId' => null], methods: ['POST'])]
    public function shippingEditComplete(Request $request, int $id, ?int $addressId = null): Response|RedirectResponse
    {
        $isEdit = $addressId !== null;

        // ログイン状態のチェック.
        if ($this->orderHelper->isLoginRequired()) {
            return $this->redirectToRoute('shopping_login');
        }

        // 受注の存在チェック
        $preOrderId = $this->cartService->getPreOrderId();
