        $builder = $this->formFactory->createBuilder(ShoppingShippingType::class, $CustomerAddress);

        $event = new EventArgs(
            [
                'builder' => $builder,
                'Order' => $Order,
                'Shipping' => $Shipping,
                'CustomerAddress' => $CustomerAddress,
                'id' => $Shipping->getId(),
            ],
            $request
        );
        $this->eventDispatcher->dispatch($event, EccubeEvents::FRONT_SHOPPING_SHIPPING_EDIT_INITIALIZE);

        $form = $builder->getForm();

        // セッションから入力データを復元
        $session = $request->getSession();
        $inputData = $session->get('eccube.front.shopping.shipping.input');
        $isRestored = false;
        if ($inputData && isset($inputData['shopping_shipping'])) {
            $form->submit($inputData['shopping_shipping']);
            $session->remove('eccube.front.shopping.shipping.input');
            $isRestored = true;
        } else {
            $form->handleRequest($request);
        }

        // フォームが送信されて、かつ復元されていない場合、かつバリデーションが通った場合
        if (!$isRestored && $form->isSubmitted() && $form->isValid()) {
            // 確認画面を表示
            return $this->render('Shopping/delivery_confirm.twig', [
                'form' => $form->createView(),
