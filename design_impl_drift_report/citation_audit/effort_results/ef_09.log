{% endblock javascript %}

{% block main %}
    {% set delivery = Order.Shippings.0.Delivery %}
    {% set isDeliveryOTC = delivery.id is defined and delivery.id in constant('Eccube\\Entity\\Delivery::OTC_GROUP') %}
    {% set canUsePoint = delivery.id is defined and delivery.id != constant('Eccube\\Entity\\Delivery::OTC') %}
    {% set creditPaymentMethods = [
        constant('Eccube\\Entity\\Payment::EC_CREDIT_METHOD'),
        constant('Eccube\\Entity\\Payment::EC_REGIST_CREDIT_METHOD'),
    ] %}
    {% set isCreditPaymentSelected = Order.Payment is not null and Order.Payment.method in creditPaymentMethods %}
    {% set selectedPaymentMethod = Order.Payment is not null ? Order.Payment.method : null %}
    {% if selectedPaymentMethod in creditPaymentMethods %}
        {% set checkoutButtonLabel = 'front.shopping.checkout.credit'|trans %}
    {% elseif selectedPaymentMethod == constant('Eccube\\Entity\\Payment::EC_CVS_METHOD') %}
        {% set checkoutButtonLabel = 'front.shopping.checkout.cvs'|trans %}
    {% else %}
        {% set checkoutButtonLabel = 'front.shopping.checkout'|trans %}
    {% endif %}

    <div class="p-hareruya-shipping p-hareruya-checkout">
        <div class="p-hareruya-shipping__container">
            <h1 class="c-hareruya-heading--lev1">{{ 'front.shopping.title'|trans }}</h1>

            <div class="p-hareruya-checkout__progress-wrap">
                <nav class="p-hareruya-cart-progress" aria-label="{{ 'front.cart.progress_aria_label'|trans }}">
                                    {{ form_widget(form.accept_order, { 'attr': { 'class': 'c-hareruya-checkbox__input', 'data-js-payment-confirm-checkbox': '' }, 'label': false }) }}
                                    <span class="c-hareruya-checkbox__label p-hareruya-shipping__checkbox-text">{{ 'front.shopping.accept_order'|trans }}</span>
                                </label>
                                {{ form_errors(form.accept_order) }}
                            </div>
                            <div class="p-hareruya-shipping__summary-buttons">
                                <button type="submit" class="c-hareruya-btn c-hareruya-btn--lg c-hareruya-btn--primary p-hareruya-shipping__submit-btn" disabled data-js-payment-submit>
                                    {{ checkoutButtonLabel }}
                                    <i class="c-hareruya-icon c-hareruya-icon--xs icon-hareruya-arrow-right" aria-hidden="true"></i>
                                </button>
                                <a class="c-hareruya-btn c-hareruya-btn--lg" href="{{ url('cart') }}">{{ 'front.shopping.back_to_cart'|trans }}</a>
                            </div>
                        </div>
                        <span itemprop="name">{{ 'front.shopping.title'|trans }}</span>
                    </a>
                    <meta itemprop="position" content="2"/>
                </li>
                <li class="p-hareruya-breadcrumb__item p-hareruya-breadcrumb__item--current" itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem">
                    <span class="p-hareruya-breadcrumb__current" aria-current="page">
                        <span itemprop="name">{{ 'front.shopping.shipping_edit_title_management'|trans }}</span>
                    </span>
                    <meta itemprop="position" content="3"/>
                </li>
            </ol>
        </nav>
        <div class="p-hareruya-entry__container">
            <div class="p-hareruya-entry__title">
                <h1 class="c-hareruya-heading--lev1">{{ 'front.shopping.shipping_edit_title_management'|trans }}</h1>
            </div>
            <div class="p-hareruya-entry__content">
                <form class="p-hareruya-entry__form h-adr" method="post" action="{{ url('shopping_shipping_edit', isEdit is defined and isEdit ? {'id': shippingId, 'addressId': addressId} : {'id': shippingId}) }}" novalidate>
                    <div class="p-hareruya-entry__form-body">
                        <span class="p-country-name" style="display:none;">Japan</span>
                        {{ form_widget(form._token) }}

                        <div class="p-hareruya-form-group">
                            <div class="p-hareruya-form-block p-hareruya-entry__delivery-name">
                                <div class="p-hareruya-form-block__label-wrap">
                                    <label class="p-hareruya-form-block__label c-hareruya-heading--lev4" for="{{ form.address_name.vars.id }}">{{ 'front.shopping.shipping.address_name'|trans }}</label>
                                    <span class="c-hareruya-label--required">{{ 'common.required'|trans }}</span>
                                </div>
                                <div class="p-hareruya-form-block__form-list">
                                    <div class="c-hareruya-form-input{% if has_errors(form.address_name) %} c-hareruya-form-input--error{% endif %}">
                                        {{ form_widget(form.address_name, { attr: { class: 'c-hareruya-form-input__field', placeholder: 'front.shopping.shipping.address_name.placeholder' } }) }}
                                        {{ form_errors(form.address_name) }}
                                    </div>
                                </div>
                            </div>
        }

        // 登録処理
        log_info('お届け先登録処理開始', ['order_id' => $Order->getId(), 'shipping_id' => $Shipping->getId(), 'is_edit' => $isEdit]);

        $Shipping->setFromCustomerAddress($CustomerAddress);

        // 新規追加時のみ登録上限をチェックし永続化指示を行う（編集時は既存エンティティのため不要）
        if (!$isEdit && $this->isGranted('IS_AUTHENTICATED_FULLY')) {
            /** @var Customer $Customer */
            $Customer = $this->getUser();
            $addressCurrNum = count($Customer->getCustomerAddresses());
            $addressMax = $this->eccubeConfig['eccube_deliv_addr_max'];
            if ($addressCurrNum >= $addressMax) {
                throw new NotFoundHttpException();
            }
            $this->entityManager->persist($CustomerAddress);
        }

        // 合計金額の再計算
        $flowResult = $this->executePurchaseFlow($Order, false);

        if ($flowResult->hasError()) {
            // flush 前のため DB は未更新。メモリ上の Shipping / Order（validate で変更された合計など）を取り消す
            $this->entityManager->refresh($Shipping);
            $this->entityManager->refresh($Order);

            return $this->redirectToRoute('shopping_error');
        }

        $this->entityManager->flush();
            ->add('address', AddressType::class)
            ->add('tel', SplitPhoneNumberType::class, [
                'required' => true,
            ])
            ->add('is_country_change', HiddenType::class, [
                'data' => '0',
                'mapped' => false,
            ])
        ;

        $builder->addEventListener(FormEvents::POST_SET_DATA, function (FormEvent $event): void {
            $data = $event->getData();
            $form = $event->getForm();

            if (!$data || $data->getCountry() === null) {
                $Country = $this->countryRepository->find(Country::JAPAN);
                $form->get('country')->setData($Country);
            }
        });

        $builder->addEventListener(FormEvents::POST_SUBMIT, function (FormEvent $event): void {
            $form = $event->getForm();
            /** @var CustomerAddress $CustomerAddress */
            $CustomerAddress = $event->getData();

            $zip1 = $form->get('postalCode')->get('postalCode01')->getData() ?: '';
            $zip2 = $form->get('postalCode')->get('postalCode02')->getData() ?: '';

            $postalCode = empty($zip1) || empty($zip2)
                ? null
                : $zip1.$zip2;

            $CustomerAddress->setPostalCode($postalCode);
        });

        $builder->addEventListener(FormEvents::POST_SUBMIT, function (FormEvent $event): void {
            $form = $event->getForm();
            /** @var CustomerAddress $CustomerAddress */
            $CustomerAddress = $event->getData();

            if ($CustomerAddress->getCountry()->isJapan()) {
                if (empty($form->get('postalCode')->get('postalCode01')->getData())) {
                    $form['postalCode']['postalCode01']->addError(new FormError(trans('form.type.select.notselect', [], 'validators')));
                }

                if (empty($form->get('postalCode')->get('postalCode02')->getData())) {
                    $form['postalCode']['postalCode02']->addError(new FormError(trans('form.type.select.notselect', [], 'validators')));
                }
            } else {
                if (empty($form->get('abroadPostalCode')->getData())) {
                    $form['abroadPostalCode']->addError(new FormError(trans('form.type.select.notselect', [], 'validators')));
                }

                // 海外の場合、都道府県 = 国外を固定で設定
                $CustomerAddress->setPref($this->prefRepository->find(Pref::PREF_ABROAD));
            }
        });
    }

    /**
     * {@inheritdoc}
     */
    #[\Override]
    public function configureOptions(OptionsResolver $resolver): void
    {
        $resolver->setDefaults([
            'data_class' => CustomerAddress::class,
        ]);
    }

