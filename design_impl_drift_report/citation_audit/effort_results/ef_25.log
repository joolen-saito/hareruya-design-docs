namespace Eccube\Controller\Admin\Setting\Shop;

use Eccube\Common\EccubeConfig;
use Eccube\Controller\AbstractController;
use Eccube\Entity\Master\MtbOption;
use Eccube\Entity\Member;
use Eccube\Event\EccubeEvents;
use Eccube\Event\EventArgs;
use Eccube\Form\Type\Admin\AdditionalSystemFormType;
use Eccube\Repository\Master\MtbOptionRepository;
use Symfony\Bridge\Twig\Attribute\Template;
use Symfony\Component\HttpFoundation\RedirectResponse;
use Symfony\Component\HttpFoundation\Request;
use Symfony\Component\Routing\Attribute\Route;

class AdditionalSystemController extends AbstractController
{
    public function __construct(
        EccubeConfig $eccubeConfig,
        private readonly MtbOptionRepository $optionRepository,
    ) {
        $this->eccubeConfig = $eccubeConfig;
    }

    /**
     * @return array<string, mixed>
     */
    #[Route('/%eccube_admin_route%/setting/shop/additional_system', name: 'admin_setting_shop_additional_system', methods: ['GET'])]
    #[Template('@admin/Setting/Shop/additional_system.twig')]
    public function index(Request $request): array
    {
        /** @var MtbOption[] $options */
        $options = $this->optionRepository->findAll();
        $settings = array_reduce($options, function (array $carray, MtbOption $Option): array {
            $carray[$Option->getOptionKey()] = $Option->getOptionValue();

            return $carray;
        }, []);

        $builder = $this->formFactory->createBuilder(AdditionalSystemFormType::class, $settings, ['settings' => $settings]);

        $event = new EventArgs(
            [
                'builder' => $builder,
            ],
            $request
        );
        $this->eventDispatcher->dispatch($event, EccubeEvents::ADMIN_SETTING_SHOP_ADDITIONAL_SYSTEM_INDEX_INITIALIZE);

        $form = $builder->getForm();
        $form->handleRequest($request);

        return [
            'form' => $form->createView(),
        ];
    }

    /**
     * @return RedirectResponse|array<string, mixed>
     */
    #[Route('/%eccube_admin_route%/setting/shop/additional_system/update', name: 'admin_setting_shop_additional_system_update', methods: ['POST'])]
    #[Template('@admin/Setting/Shop/additional_system.twig')]
    public function update(Request $request): RedirectResponse|array
    {
        /** @var MtbOption[] $options */
        $options = $this->optionRepository->findAll();
        $settings = array_reduce($options, function (array $carray, MtbOption $Option): array {
            $carray[$Option->getOptionKey()] = $Option->getOptionValue();

            return $carray;
        }, []);

        $form = $this->formFactory->createBuilder(AdditionalSystemFormType::class, $settings, ['settings' => $settings])->getForm();
        $form->handleRequest($request);

        if (!$form->isSubmitted() || !$form->isValid()) {
            return [
                'form' => $form->createView(),
            ];
        }

        $formData = $form->getData();
        /** @var Member $Member */
        $Member = $this->getUser();

        foreach ($options as $Option) {
            $keyName = $Option->getOptionKey();

            if (array_key_exists($keyName, $formData) && (string) $formData[$keyName] !== (string) $Option->getOptionValue()) {
                $Option->setOptionValue((string) $formData[$keyName]);
                $Option->setMember($Member);
                $Option->setUpdateDate(new \DateTime());

                $this->entityManager->persist($Option);
            }
        }

        $this->entityManager->flush();

        $event = new EventArgs(
            [
                'form' => $form,
            ],
            $request
        );
        $this->eventDispatcher->dispatch($event, EccubeEvents::ADMIN_SETTING_SHOP_ADDITIONAL_SYSTEM_UPDATE_COMPLETE);

        $this->addSuccess('admin.common.save_complete', 'admin');

        return $this->redirectToRoute('admin_setting_shop_additional_system');
    }
}
