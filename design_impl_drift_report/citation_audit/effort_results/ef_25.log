use Eccube\Repository\MemberRepository;
use Eccube\Service\Admin\Setting\System\ActionInput\MemberCreateInput;
use Symfony\Component\PasswordHasher\Hasher\UserPasswordHasherInterface;

class MemberCreateAction
{
    public function __construct(
        private readonly EntityManagerInterface $entityManager,
        private readonly UserPasswordHasherInterface $passwordHasher,
        private readonly MemberRepository $memberRepository,
        private readonly MemberBaseInfoRepository $memberBaseInfoRepository,
    ) {
    }

    /**
     * @throws \Exception
     */
    public function handle(MemberCreateInput $input): void
    {
        $Member = $input->Member;
        $BaseInfo = $input->BaseInfo;
        $editableBaseInfoIds = $input->editableBaseInfoIds;

        $this->entityManager->beginTransaction();

        try {
            $password = $Member->getPlainPassword();
            $hashedPassword = $this->passwordHasher->hashPassword($Member, $password);
            $Member->setPassword($hashedPassword);

            $Member->setBaseInfo($BaseInfo);

            $this->memberRepository->save($Member);

            $this->memberBaseInfoRepository->insertMemberBaseInfos($Member, $editableBaseInfoIds);

            $this->entityManager->commit();
        } catch (\Exception $e) {
            $this->entityManager->rollback();

            throw $e;
        }
    }
}
