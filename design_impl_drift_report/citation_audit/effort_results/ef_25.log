    /**
     * テンプレートファイルを解析し、{{ header }} と {{ footer }} の間の本文部分を返す
     *
     * @param string $body テンプレートファイルの内容
     * @param MailTemplate $mail メールテンプレート
     * @param string $formName フォーム名
     * @param bool $isForm フォームを使用するかどうか
     *
     * @return string 本文部分
     */
    public function replaceBody(string $body, MailTemplate $mail, string $formName = 'mail', bool $isForm = true): string
    {
        $orderContentText = $this->getOrderContentText();
        $body = str_replace(
            [
                "{{ include('Mail/order_content.twig', {'data': data}) }}",
                "{{ include('Mail/order_content.en.twig', {'data': data}) }}",
            ],
            [
                $orderContentText['ja'],
                $orderContentText['en'],
            ],
            $body
        );

        $body = preg_replace(['/\n/', '/\{#.*?#\}/'], ['<br>', ''], $body);
        // isFormがtrueの場合はtextareaで入力可能にし、falseの場合はhtmlに変換(defaultはtrue)
        if ($isForm) {
            $headerForm = <<< HF
<div class="form-group">
    <div class="col-sm-12">
        <textarea id="mail_header" name="{$formName}[header]" class="form-control" rows="10">{$mail->getHeader()}</textarea>
    </div>
</div>
HF;

            $footerForm = <<< FF
<div class="form-group">
    <div class="col-sm-12">
        <textarea id="mail_footer" name="{$formName}[footer]" class="form-control" rows="10">{$mail->getFooter()}</textarea>
    </div>
</div>
FF;
        } else {
            $headerForm = <<< HF
<div class="form-group">
    <div class="col-sm-12">
        {$mail->getHeader()}
    </div>
</div>
HF;

            $footerForm = <<< FF
<div class="form-group">
    <div class="col-sm-12">
        {$mail->getFooter()}
    </div>
</div>
FF;
            $headerForm = preg_replace(['/\n/', '/\{#.*?#\}/'], ['<br>', ''], $headerForm);
            $footerForm = preg_replace(['/\n/', '/\{#.*?#\}/'], ['<br>', ''], $footerForm);
        }

        return str_replace(
            [
                '{{ header }}',
                '{{ footer }}',
            ],
            [
                $headerForm,
                $footerForm,
            ],
            $body
        );
