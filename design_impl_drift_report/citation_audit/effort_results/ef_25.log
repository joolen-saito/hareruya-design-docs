            'mail_key' => $mailKey,
        ]);

        $body = $this->twig->render($MailTemplate->getFileName(), [
            'header' => $MailTemplate->getHeader(),
            'footer' => $MailTemplate->getFooter(),
            'data' => $formData,
            'BaseInfo' => $this->BaseInfo,
            'Customer' => $Customer,
        ]);

        $subjectEmail = null;
        /** @var mixed $subject */
        $subject = $formData['subject'] ?? null;
        if ($subject instanceof MtbContactSubject) {
            $subjectEmail = $subject->getEmail();
        }

        $baseEmail02 = (string) $this->BaseInfo->getEmail02();

        $adminEmail = ($subjectEmail !== null && $subjectEmail !== '')
            ? $subjectEmail
            : $baseEmail02;

        $adminEmail = (string) $adminEmail;
        if ($adminEmail === '') {
            throw new \LogicException('from,bcc,reply toに設定するメールアドレスが取得できませんでした。');
        }

        // 問い合わせ者にメール送信
        $message = (new Email())
            ->subject('['.$this->BaseInfo->getShopName().'] '.$MailTemplate->getMailSubject())
            ->from(new Address($adminEmail, $this->BaseInfo->getShopName()))
            ->to($this->convertRFCViolatingEmail($formData['email']))
            ->bcc($adminEmail)
            ->replyTo($adminEmail)
            ->returnPath($this->BaseInfo->getEmail04());

        // HTMLテンプレートが存在する場合
