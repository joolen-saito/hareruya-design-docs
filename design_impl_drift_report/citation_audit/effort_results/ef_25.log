namespace Plugin\HareruyaEc\Controller;
use Eccube\Application;
use Symfony\Component\Form\FormInterface;
use Symfony\Component\HttpKernel\Exception\AccessDeniedHttpException;
use Symfony\Component\Security\Csrf\CsrfToken;
use Eccube\Common\Constant;

trait FormValidHelper
{

    /**
     * @param Application $app
     * @param FormInterface $form
     * @return boolean
     */
    private function isFormValid($app, FormInterface $form)
    {
        $this->checkCsrfValid($app, $form);

        return $form->isValid();
    }

    /**
     * @param Application $app
     * @param FormInterface $form or null
     */
    private function refreshToken($app, FormInterface $form = null)
    {
        $tokenId = is_null($form) ? Constant::TOKEN_NAME : $form->getName();
        $app['form.csrf_provider']->refreshToken($tokenId);
    }

    /**
     * @param Application $app
     * @param FormInterface $form or null
     */
    private function checkCsrfValid($app, FormInterface $form = null)
    {
        $tokenId = is_null($form) ? Constant::TOKEN_NAME : $form->getName();
        $token = is_null($form) ? $app['request']->request->get($tokenId) : $app['request']->request->get($tokenId)[Constant::TOKEN_NAME];

        if (!$app['form.csrf_provider']->isTokenValid(new CsrfToken($tokenId, $token))) {
            throw new AccessDeniedHttpException('CSRF token is invalid.');
        }

        $this->refreshToken($app, $form);
    }

