                ]);
        log_info('お問い合わせ受付メール送信開始');

        $mailKey = $this->context->isLocaleJa() ? $this->eccubeConfig['eccube_contact_mail_template_id'] : $this->eccubeConfig['eccube_contact_en_mail_template_id'];

