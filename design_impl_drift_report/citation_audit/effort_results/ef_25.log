            ])
            ->add(Option::ADJUST_POINT_VARIANCE_MAIL_ADDRESS, TextType::class, [
                'required' => false,
                'constraints' => [
                    new Email(null, null, $this->eccubeConfig['eccube_rfc_email_check'] ? 'strict' : null),
                    new Length(['max' => $this->eccubeConfig['eccube_stext_len']]),
                ],
            ])
            ->add(Option::ALERT_SHOPPING_ERROR_MAIL_ADDRESS, TextType::class, [
                'required' => false,
                'constraints' => [
                    new Email(null, null, $this->eccubeConfig['eccube_rfc_email_check'] ? 'strict' : null),
                    new Length(['max' => $this->eccubeConfig['eccube_stext_len']]),
                ],
            ])
            ->add(Option::ALERT_CHECK_PAYMENT_ERROR_MAIL_ADDRESS, TextType::class, [
                'required' => false,
                'constraints' => [
                    new Email(null, null, $this->eccubeConfig['eccube_rfc_email_check'] ? 'strict' : null),
                    new Length(['max' => $this->eccubeConfig['eccube_stext_len']]),
                ],
            ])
            ->add(Option::CHECK_ID_EXPIRED_CUSTOMER_MAIL_ADDRESS, TextType::class, [
                'required' => false,
                'constraints' => [
                    new Email(null, null, $this->eccubeConfig['eccube_rfc_email_check'] ? 'strict' : null),
                    new Length(['max' => $this->eccubeConfig['eccube_stext_len']]),
                ],
            ])
            ->add(Option::WEEKLY_STOCK_HISTORY_ERROR_MAIL_ADDRESS, TextType::class, [
                'required' => false,
                'constraints' => [
                    new Email(null, null, $this->eccubeConfig['eccube_rfc_email_check'] ? 'strict' : null),
                    new Length(['max' => $this->eccubeConfig['eccube_stext_len']]),
                ],
            ])
            ->add(Option::OTC_BUY_ORDER_ACCOUNTING_PAYMENT_PENDING_MAIL_ADDRESS, TextType::class, [
                'required' => true,
                'constraints' => [
                    new Email(null, null, $this->eccubeConfig['eccube_rfc_email_check'] ? 'strict' : null),
                    new Length(['max' => $this->eccubeConfig['eccube_stext_len']]),
                ],
            ])
            ->add(Option::SMALL_PACKET_MAX_PRICE, IntegerType::class, [
                'required' => true,
                'constraints' => [
                    new NotBlank(),
                    new GreaterThanOrEqual(0),
                ],
                'data' => $options['settings'][Option::SMALL_PACKET_MAX_PRICE] ?? Option::SMALL_PACKET_MAX_PRICE_DEFAULT,
            ])
            ->add(Option::SLIDER_EN_ONLY_TAG_ID, IntegerType::class, [
                'required' => true,
                'constraints' => [
                    new NotBlank(),
                    new GreaterThanOrEqual(0),
                ],
            ])
            ->add(Option::AUTO_LOGOUT_TIME, IntegerType::class, [
                'required' => true,
                'constraints' => [
                    new NotBlank(),
                    new GreaterThanOrEqual(0),
                ],
                'data' => $options['settings'][Option::AUTO_LOGOUT_TIME] ?? Option::AUTO_LOGOUT_TIME_DEFAULT,
            ])
            ->add(Option::UNISEARCH_SFTP_HOST, TextType::class, [
                'required' => true,
                'constraints' => [
                    new NotBlank(),
                    new Length(['max' => $this->eccubeConfig['eccube_stext_len']]),
                ],
            ]);
    }

    /**
     * {@inheritdoc}
     */
    #[\Override]
    public function configureOptions(OptionsResolver $resolver): void
    {
        $resolver->setDefaults([
            'data_class' => null,
            'settings' => [],
        ]);
    }

    /**
     * {@inheritdoc}
     */
    #[\Override]
    public function getBlockPrefix(): string
    {
        return 'add_system';
    }
}
