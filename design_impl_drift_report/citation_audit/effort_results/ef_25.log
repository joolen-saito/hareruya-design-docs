    public function autoSendMail(Application $app, Request $request, $id = null)
    {
        $mail = null;
        if ($id) {
            $criteria = new Criteria();
            $criteria->andWhere($criteria->expr()->eq('id', $id))
                ->andWhere($criteria->expr()->in('id', MailTemplate::AUTO_SEND_MAILS));
            // Memberへのフィルターをはずして、del_flg=1のデータを取得可能とする
            $softDeleteFilter = $app['orm.em']->getFilters()->getFilter('soft_delete');
            $oldExcludes = $softDeleteFilter->getExcludes();
            $softDeleteFilter->setExcludes([
                'Eccube\Entity\Member',
            ]);

            $mail = $app['eccube.repository.mail_template']->matching($criteria)->first();
            if (!$mail) {
                throw new NotFoundHttpException();
            }
            $app['twig.loader']->addLoader(new \Twig_Loader_Filesystem([__DIR__.'/../../../../Resource/template/default']));

            $body = $app['twig']->getLoader()->getSourceContext($mail->getFileName())->getCode();
            $body = $app['hareruya_ec.service.mail']->replaceBody($body, $mail);
        }

        $form = $app['form.factory']
            ->createBuilder('mail', $mail)
            ->getForm();

        $form['template']->setData($mail);

        if ('POST' === $request->getMethod()) {
            $form->handleRequest($request);

            // 新規登録は現時点では未実装とする.
            if (is_null($mail)) {
                $app->addError('admin.shop.mail.save.error', 'admin');

                return $app->redirect($app->path('admin_setting_shop_auto_mail'));
            }

            if ($this->isFormValid($app, $form)) {
                $mail->setCreator($app['security']->getToken()->getUser())
                    ->setUpdateDate(new \DateTime());

                $app['orm.em']->persist($mail);
                $app['orm.em']->flush();
                $app->addSuccess('admin.shop.mail.save.complete', 'admin');

                return $app->redirect($app->path('admin_setting_shop_auto_mail_edit', ['id' => $id]));
            }
        }

        return $app->render('Setting/Shop/auto_mail.twig', [
            'form' => $form->createView(),
            'id' => $id,
            'body' => $body ?? '',
            'mail' => $mail,
        ]);
    }

    public function mailList(Application $app, Request $request)
    {
        $criteria = new Criteria();
        // ソートは編集画面のプルダウンメニューに合わせてnameの昇順とする
        $criteria->andWhere($criteria->expr()->notIn('id', MailTemplate::AUTO_SEND_MAILS))
            ->orderBy(['name' => Criteria::ASC]);
        // Memberへのフィルターをはずして、del_flg=1のデータを取得可能とする
        $softDeleteFilter = $app['orm.em']->getFilters()->getFilter('soft_delete');
        $softDeleteFilter->setExcludes([
            'Eccube\Entity\Member',
        ]);

        $mails = $app['eccube.repository.mail_template']->matching($criteria);
        $templates = [];
        $app['twig.loader']->addLoader(new \Twig_Loader_Filesystem([__DIR__.'/../../../../Resource/template/default']));
        foreach($mails as $mail) {
            $body = $app['twig']->getLoader()->getSourceContext($mail->getFileName())->getCode();
            $body = $app['hareruya_ec.service.mail']->replaceBody($body, $mail, 'mail', false);
            // templatesにmail情報とbody情報を格納
            $templates[] = [
                'mail' => $mail,
                'body' => $body,
            ];
        }

        return $app->render('Setting/Shop/mail_list.twig', [
            'templates' => $templates,
        ]);
    }
