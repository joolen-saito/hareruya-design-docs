class MemberController extends AbstractController
{
    /**
     * MemberController constructor.
     */
    public function __construct(
        protected UserPasswordHasherInterface $passwordHasher,
        protected MemberRepository $memberRepository,
        protected TokenStorageInterface $tokenStorage,
        private readonly BaseInfoRepository $baseInfoRepository,
        private readonly MemberCreateAction $memberCreateAction,
        private readonly MemberEditAction $memberEditAction,
        private readonly AuthorityRepository $authorityRepository,
        private readonly DepartmentRepository $departmentRepository,
    ) {
    }

    /**
     * @return array<string, mixed>
     */
    #[Route(path: '/%eccube_admin_route%/setting/system/member', name: 'admin_setting_system_member', methods: ['GET', 'PUT'])]
    #[Template(template: '@admin/Setting/System/member.twig')]
    public function index(Request $request): array
    {
        $Members = $this->memberRepository->findBy([], ['sort_no' => 'DESC']);

        $builder = $this->formFactory->createBuilder();

        $event = new EventArgs(
            [
                'builder' => $builder,
                'Members' => $Members,
            ],
            $request
        );
        $this->eventDispatcher->dispatch($event, EccubeEvents::ADMIN_SETTING_SYSTEM_MEMBER_INDEX_INITIALIZE);

        $form = $builder->getForm();

        $Departments = $this->departmentRepository->findBy([], ['sort_no' => 'ASC']);
        $Authorities = $this->authorityRepository->findBy([], ['sort_no' => 'ASC']);

        return [
            'form' => $form->createView(),
            'Members' => $Members,
            'Departments' => $Departments,
            'Authorities' => $Authorities,
        ];
    }

    /**
     * @return RedirectResponse|array<string, mixed>
     */
    #[Route(path: '/%eccube_admin_route%/setting/system/member/new', name: 'admin_setting_system_member_new', methods: ['GET', 'POST'])]
    #[Template(template: '@admin/Setting/System/member_edit.twig')]
    public function create(Request $request): RedirectResponse|array
    {
        $Member = new Member();
        $Member->setBaseInfo($this->getMember()->getBaseInfo());
        $builder = $this->formFactory
            ->createBuilder(MemberType::class, $Member, [
                'current_member_level' => $this->getMember()->getAuthority()->getId(),
            ]);

        $event = new EventArgs([
            'builder' => $builder,
            'Member' => $Member,
        ], $request);
        $this->eventDispatcher->dispatch($event, EccubeEvents::ADMIN_SETTING_SYSTEM_MEMBER_EDIT_INITIALIZE);

        $form = $builder->getForm();
        $form->get('editableBaseInfos')->setData(
            $Member->getMemberBaseInfos()->map(fn ($mb) => $mb->getBaseInfo())->toArray()
        );
        $form->handleRequest($request);

        if ($form->isSubmitted() && $form->isValid()) {
            $BaseInfo = $Member->isTenantGroup()
                ? $form->get('baseInfo')->getData()
                : $this->baseInfoRepository->getMallBaseInfo();

            $editableBaseInfoIds = $this->extractEditableBaseInfoIds($form->get('editableBaseInfos')->getData());

            $input = new MemberCreateInput(
                Member: $Member,
                BaseInfo: $BaseInfo,
                editableBaseInfoIds: $editableBaseInfoIds,
            );

            try {
                $this->memberCreateAction->handle($input);
                $this->addSuccess('admin.common.save_complete', 'admin');
            } catch (\Exception $e) {
                $this->addError('admin.common.save_error', 'admin');
            }

            $event = new EventArgs(
                [
                    'form' => $form,
                    'Member' => $Member,
                ],
                $request
            );
            $this->eventDispatcher->dispatch($event, EccubeEvents::ADMIN_SETTING_SYSTEM_MEMBER_EDIT_COMPLETE);

            return $this->redirectToRoute('admin_setting_system_member_edit', ['id' => $Member->getId()]);
        }

        return [
            'form' => $form->createView(),
            'Member' => $Member,
        ];
    }
    }

    /**
     * @return array<string, mixed>
     */
    #[Route(path: '/%eccube_admin_route%/setting/system/member/{id}/edit', name: 'admin_setting_system_member_edit', requirements: ['id' => '\d+'], methods: ['GET'])]
    #[Template(template: '@admin/Setting/System/member_edit.twig')]
    public function edit(Request $request, Member $Member): array
    {
        $Member->setPlainPassword($this->eccubeConfig['eccube_default_password']);

        $builder = $this->formFactory
            ->createBuilder(MemberType::class, $Member, [
                'current_member_level' => $this->getMember()->getAuthority()->getId(),
            ]);

        $event = new EventArgs(
            [
                'builder' => $builder,
                'Member' => $Member,
            ],
            $request
        );
        $this->eventDispatcher->dispatch($event, EccubeEvents::ADMIN_SETTING_SYSTEM_MEMBER_EDIT_INITIALIZE);

        $form = $builder->getForm();
        if ($Member->isTenantGroup()) {
            $form->get('baseInfo')->setData($Member->getBaseInfo());
        }
        $form->get('editableBaseInfos')->setData(
            $Member->getMemberBaseInfos()->map(fn ($mb) => $mb->getBaseInfo())->toArray()
        );

        return [
            'form' => $form->createView(),
            'Member' => $Member,
        ];
    }

    #[Route(path: '/%eccube_admin_route%/setting/system/member/{id}/update', name: 'admin_setting_system_member_update', requirements: ['id' => '\d+'], methods: ['POST'])]
