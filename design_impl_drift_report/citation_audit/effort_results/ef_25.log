    public function index(Request $request): RedirectResponse|array
    {
        $Authorities = $this->authorityRepository->findBy(
            ['isViewable' => true],
            ['sort_no' => 'ASC']
        );

        $AuthorityRoles = $this->authorityRoleRepository->findAllSort();

        $ExistingAuthorityRoles = $this->authorityRoleRepository->findAll();

        $builder = $this->formFactory->createBuilder(AuthorityMatrixType::class, [
            'AuthorityRoles' => $AuthorityRoles,
        ]);

        $event = new EventArgs(
            [
                'builder' => $builder,
                'AuthorityRoles' => $AuthorityRoles,
            ],
            $request
        );
        $this->eventDispatcher->dispatch($event, EccubeEvents::ADMIN_SETTING_SYSTEM_AUTHORITY_INDEX_INITIALIZE);

        $form = $builder->getForm();

        $form->handleRequest($request);

        if ($form->isSubmitted() && $form->isValid()) {
            $requestData = $request->request->all();
            $authorityRequestData = $requestData['authority'] ?? [];
            $newAuthorityNames = $requestData['new_authority_name'] ?? [];

            $input = new AuthorityIndexInput(
                authorityRequestData: $authorityRequestData,
                newAuthorityNames: $newAuthorityNames,
                existingAuthorityRoles: $ExistingAuthorityRoles,
            );

            try {
                $this->authorityIndexAction->handle($input);

                $event = new EventArgs(
                    [
                        'form' => $form,
                        'AuthorityRoles' => $AuthorityRoles,
                    ],
                    $request
                );
                $this->eventDispatcher->dispatch($event, EccubeEvents::ADMIN_SETTING_SYSTEM_AUTHORITY_INDEX_COMPLETE);

                $this->addSuccess('admin.common.save_complete', 'admin');
            } catch (\Exception $e) {
                $this->addError($e->getMessage(), 'admin');
                $this->addError('admin.common.save_error', 'admin');
            }

            return $this->redirectToRoute('admin_setting_system_authority');
        }

