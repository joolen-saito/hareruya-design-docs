class AuthorityController extends AbstractController
{
    protected AuthorityRoleRepository $authorityRoleRepository;

    protected AuthorityRepository $authorityRepository;

    protected PermissionAccessUrlRepository $permissionAccessUrlRepository;

    protected AuthorityIndexAction $authorityIndexAction;

    public function __construct(
        AuthorityRoleRepository $authorityRoleRepository,
        AuthorityRepository $authorityRepository,
        PermissionAccessUrlRepository $permissionAccessUrlRepository,
        AuthorityIndexAction $authorityIndexAction,
    ) {
        $this->authorityRoleRepository = $authorityRoleRepository;
        $this->authorityRepository = $authorityRepository;
        $this->permissionAccessUrlRepository = $permissionAccessUrlRepository;
        $this->authorityIndexAction = $authorityIndexAction;
    }

    /**
     * @return array<string, mixed>|RedirectResponse
     */
    #[Route(path: '/%eccube_admin_route%/setting/system/authority', name: 'admin_setting_system_authority', methods: ['GET', 'POST'])]
