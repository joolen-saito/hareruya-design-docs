namespace Eccube\Controller\Admin\Mall;

use Eccube\Common\EccubeConfig;
use Eccube\Controller\AbstractController;
use Eccube\Entity\MailTemplate;
use Eccube\Event\EccubeEvents;
use Eccube\Event\EventArgs;
use Eccube\Form\Type\Admin\AutoMailType;
use Eccube\Repository\BaseInfoRepository;
use Eccube\Util\CacheUtil;
use Symfony\Bridge\Twig\Attribute\Template;
use Symfony\Component\HttpFoundation\RedirectResponse;
use Symfony\Component\HttpFoundation\Request;
use Symfony\Component\HttpKernel\Exception\BadRequestHttpException;
use Twig\Environment;

class MallAutoMailController extends AbstractController
{
    public const MAIL_PATH = '/app/template/default/';

    public function __construct(
        private readonly BaseInfoRepository $baseInfoRepository,
        EccubeConfig $eccubeConfig,
    ) {
        $this->eccubeConfig = $eccubeConfig;
    }

    /**
     * モール側で設定するメールテンプレート設定画面のcontroller
     *
     * @return array<string, mixed>|RedirectResponse
     */
    #[\Symfony\Component\Routing\Attribute\Route(path: '/%eccube_admin_route%/mall/auto_mail', name: 'admin_mall_auto_mail', methods: ['GET', 'POST'])]
    #[\Symfony\Component\Routing\Attribute\Route(path: '/%eccube_admin_route%/mall/auto_mail/{Mail}', name: 'admin_mall_auto_mail_edit', methods: ['GET', 'POST'])]
    #[Template(template: '@admin/mall/AutoMail/detail.twig')]
    public function index(
        Request $request,
        Environment $twig,
        CacheUtil $cacheUtil,
        ?MailTemplate $Mail = null,
    ): array|RedirectResponse {
        $Mall = $this->baseInfoRepository->find($this->eccubeConfig->get('eccube_root_base_info_id'));

        $builder = $this->formFactory
            ->createBuilder(AutoMailType::class, $Mail, [
                'baseInfo' => $Mall,
            ]);

        $event = new EventArgs(
            [
                'builder' => $builder,
                'Mail' => $Mail,
            ],
            $request
        );
        $this->eventDispatcher->dispatch($event, EccubeEvents::ADMIN_SETTING_SHOP_MAIL_INDEX_INITIALIZE);

        $form = $builder->getForm();

        $parsed = [
            'header_prefix' => '',
            'body' => '',
            'footer_suffix' => '',
        ];

        if ($Mail !== null && $Mail->getId() !== null) {
            $form['template']->setData($Mail);
            $source = $twig->getLoader()
                ->getSourceContext($Mail->getFileName())
                ->getCode();

            $parsed = $this->replaceBody($source);
            $form->get('tpl_data')->setData($parsed['body']);
        }

        if ($request->getMethod() === 'POST') {
            if ($Mail->getId() === null) {
                throw new BadRequestHttpException(trans('admin.setting.shop.custom_automail.new'));
            }

            $form->handleRequest($request);

            if ($form->isSubmitted() && $form->isValid()) {
                $Mail = $form->getData();

                $this->entityManager->persist($Mail);
                $this->entityManager->flush();

                $event = new EventArgs(
                    [
                        'form' => $form,
                        'Mail' => $Mail,
                    ],
                    $request
                );
                $this->eventDispatcher->dispatch($event, EccubeEvents::ADMIN_MALL_AUTO_MAIL_INDEX_COMPLETE);

                $this->addSuccess('admin.common.save_complete', 'admin');

                $cacheUtil->clearTwigCache();

                return $this->redirectToRoute('admin_mall_auto_mail_edit', ['Mail' => $Mail->getId()]);
            }
        }

        return [
            'baseInfo' => $Mall,
            'form' => $form->createView(),
            'id' => $Mail !== null ? $Mail->getId() : null,
            'Mail' => $Mail,
            'template_header' => $parsed['header_prefix'] ?? '',
            'template_footer' => $parsed['footer_suffix'] ?? '',
        ];
    }

    /**
     * テンプレートファイルを解析して、header、本文、footerに分割
     *
     * @param string $source テンプレートファイルの内容
     *
     * @return array<string, string> ['header_prefix' => string, 'body' => string, 'footer_suffix' => string]
     */
    private function replaceBody(string $source): array
    {
        $headerPrefix = '';
        $body = $source;
        $footerSuffix = '';

        $headerPos = strpos($source, '{{ header }}');
        if ($headerPos !== false) {
            $headerPrefix = substr($source, 0, $headerPos);
            $body = substr($source, $headerPos + strlen('{{ header }}'));
        }

        $footerPos = strpos($body, '{{ footer }}');
        if ($footerPos !== false) {
            $footerSuffix = substr($body, $footerPos + strlen('{{ footer }}'));
            $body = substr($body, 0, $footerPos);
        }

        return [
            'header_prefix' => $headerPrefix,
            'body' => $body,
            'footer_suffix' => $footerSuffix,
        ];
    }
}
