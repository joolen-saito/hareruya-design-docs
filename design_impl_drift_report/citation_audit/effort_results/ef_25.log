            $editableBaseInfoIds = $this->extractEditableBaseInfoIds($form->get('editableBaseInfos')->getData());

            $input = new MemberEditInput(
                Member: $Member,
                defaultPassword: $this->eccubeConfig['eccube_default_password'],
                BaseInfo: $BaseInfo,
                editableBaseInfoIds: $editableBaseInfoIds,
            );

            try {
                $this->memberEditAction->handle($input);

                $event = new EventArgs(
                    [
                        'form' => $form,
                        'Member' => $Member,
                    ],
                    $request
                );
