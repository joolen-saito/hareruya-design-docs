use Symfony\Component\Validator\Constraints\GreaterThanOrEqual;
use Symfony\Component\Validator\Constraints\Length;
use Symfony\Component\Validator\Constraints\NotBlank;
use Symfony\Component\Validator\Constraints\Regex;

class AdditionalSystemFormType extends AbstractType
{
    public function __construct(private EccubeConfig $eccubeConfig)
    {
    }

    /**
     * {@inheritdoc}
     *
     * @param array<string, mixed> $options
     */
    #[\Override]
    public function buildForm(FormBuilderInterface $builder, array $options): void
    {
        $builder
            ->add(Option::ARRIVAL_ALERT_MAX, IntegerType::class, [
                'required' => true,
                'constraints' => [
                    new NotBlank(),
                    new GreaterThanOrEqual(0),
                ],
                'data' => $options['settings'][Option::ARRIVAL_ALERT_MAX] ?? Option::ARRIVAL_ALERT_MAX_DEFAULT,
            ])
            ->add(Option::PURCHASE_MAIL_ADDRESS, TextType::class, [
                'required' => true,
                'constraints' => [
                    new NotBlank(),
                    new Email(null, null, $this->eccubeConfig['eccube_rfc_email_check'] ? 'strict' : null),
                    new Length(['max' => $this->eccubeConfig['eccube_stext_len']]),
                ],
                'data' => $options['settings'][Option::PURCHASE_MAIL_ADDRESS] ?? Option::PURCHASE_MAIL_ADDRESS_DEFAULT,
            ])
            ->add(Option::RECOMMEND_SEARCH_DAYS, IntegerType::class, [
                'required' => true,
                'constraints' => [
                    new NotBlank(),
                    new GreaterThanOrEqual(0),
                ],
                'data' => $options['settings'][Option::RECOMMEND_SEARCH_DAYS] ?? Option::RECOMMEND_SEARCH_DAYS_DEFAULT,
            ])
            ->add(Option::OTCBUY_ORDER_RETURN_SECONDS, IntegerType::class, [
                'required' => false,
                'data' => $options['settings'][Option::OTCBUY_ORDER_RETURN_SECONDS] ?? Option::OTCBUY_ORDER_RETURN_SECONDS_DEFAULT,
            ])
            ->add(Option::OTC_SHOPPING_ORDER_RETURN_SECONDS, IntegerType::class, [
                'required' => false,
                'data' => $options['settings'][Option::OTC_SHOPPING_ORDER_RETURN_SECONDS] ?? Option::OTC_SHOPPING_ORDER_RETURN_SECONDS_DEFAULT,
            ])
            ->add(Option::SMAREGI_STORE_ID, TextType::class, [
                'required' => false,
                'constraints' => [
                    new Regex(['pattern' => '/^([!-~]*)$/']),
                ],
            ])
            ->add(Option::SMAREGI_ACCESS_TOKEN, TextType::class, [
                'required' => false,
                'constraints' => [
                    new Regex(['pattern' => '/^([!-~]*)$/']),
                ],
            ])
            ->add(Option::SMAREGI_REQUEST_URL, TextType::class, [
                'required' => false,
                'constraints' => [
                    new Regex(['pattern' => '/^(https?|ftp)(:\/\/[-_.!~*\'()a-zA-Z0-9;\/?:\@&=+\$,%#]+)$/']),
                ],
                'data' => $options['settings'][Option::SMAREGI_REQUEST_URL] ?? Option::SMAREGI_REQUEST_URL_DEFAULT,
            ])
            ->add(Option::SMAREGI_CATEGORY_ID, TextType::class, [
                'required' => false,
                'constraints' => [
                    new Regex([
                        'pattern' => "/^\d+$/",
                        'message' => 'form_error.numeric_only',
                    ]),
                ],
            ])
            ->add(Option::ORDER_TIMING_BODER, TextType::class, [
                'required' => true,
                'constraints' => [
                    new NotBlank(),
                    new Regex(['pattern' => '/^([01][0-9]|2[0-3]):[0-5][0-9]$/']),
                ],
                'data' => $options['settings'][Option::ORDER_TIMING_BODER] ?? Option::ORDER_TIMING_BODER_DEFAULT,
            ])
            ->add(Option::SEND_NOTIFICATION_ARRIVAL_MAIL, ChoiceType::class, [
                'required' => true,
                'constraints' => [
                    new NotBlank(),
                ],
                'choices' => [
                    'common.send' => Option::SEND_NOTIFICATION_ARRIVAL_MAIL_SEND,
                    'common.not_send' => Option::SEND_NOTIFICATION_ARRIVAL_MAIL_NOT_SEND,
                ],
            ])
            ->add(Option::BULK_PURCHASE_ID, TextType::class, [ // 空を許容するためTextTypeを使用
                'required' => false,
                'constraints' => [
                    new GreaterThanOrEqual(0),
                ],
            ])
            ->add(Option::FIXED_PRICE_SECTION, IntegerType::class, [
                'required' => true,
                'constraints' => [
                    new NotBlank(),
                    new GreaterThanOrEqual(1),
                ],
            ])
            ->add(Option::OTC_SUMMARY_MAIL_ADDRESS, TextType::class, [
                'required' => false,
                'constraints' => [
                    new Email(null, null, $this->eccubeConfig['eccube_rfc_email_check'] ? 'strict' : null),
                    new Length(['max' => $this->eccubeConfig['eccube_stext_len']]),
                ],
            ])
            ->add(Option::CHECK_BLANK_REQUIRED_ITEM_CUSTOMER_MAIL_ADDRESS, TextType::class, [
                'required' => false,
                'constraints' => [
                    new Email(null, null, $this->eccubeConfig['eccube_rfc_email_check'] ? 'strict' : null),
                    new Length(['max' => $this->eccubeConfig['eccube_stext_len']]),
                ],
            ])
            ->add(Option::CHECK_NOT_REFLECTED_POINT_USAGE_MAIL_ADDRESS, TextType::class, [
                'required' => false,
                'constraints' => [
                    new Email(null, null, $this->eccubeConfig['eccube_rfc_email_check'] ? 'strict' : null),
                    new Length(['max' => $this->eccubeConfig['eccube_stext_len']]),
