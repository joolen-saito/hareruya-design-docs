use Symfony\Component\OptionsResolver\OptionsResolver;
use Symfony\Component\Validator\Constraints\NotBlank;

class CustomCsvType extends AbstractType
{
    public const CSV_TYPES = [
        CsvType::CSV_TYPE_PRODUCT,
        CsvType::CSV_TYPE_CUSTOMER,
        CsvType::CSV_TYPE_ORDER,
        CsvType::CSV_TYPE_SHIPPING,
        CsvType::CSV_TYPE_STOCK,
        CsvType::CSV_TYPE_STOCK_MOVE,
        CsvType::CSV_TYPE_STOCK_SPLIT,
    ];

    private CsvRepository $csvRepository;

    public function __construct(
        CsvRepository $csvRepository,
    ) {
        $this->csvRepository = $csvRepository;
    }

    public function buildForm(FormBuilderInterface $builder, array $options): void
    {
        $CsvType = $options['csvType'];
        $CsvExtension = $options['csvExtension'];
        $isCsvExtensionExisting = $CsvExtension->getId() !== null;

        $csvOutput = [];
        $csvOutputIds = [];
        if ($isCsvExtensionExisting) {
            $CsvCsvExtensions = $CsvExtension->getCsvCsvExtensions()->toArray();
            usort($CsvCsvExtensions, function (DtbCsvCsvExtension $a, DtbCsvCsvExtension $b) {
                return $a->getRank() <=> $b->getRank();
            });
            $csvOutput = array_map(function (DtbCsvCsvExtension $CsvCsvExtension) {
                return $CsvCsvExtension->getCsv();
            }, $CsvCsvExtensions);
            $csvOutputIds = array_map(function (Csv $Csv) {
                return $Csv->getId();
            }, $csvOutput);
        }

        $criteria = new Criteria();
        if (!empty($csvOutputIds)) {
            $criteria->where($criteria->expr()->notIn('id', $csvOutputIds));
        }
        $criteria->andWhere($criteria->expr()->eq('CsvType', $CsvType))
            ->orderBy(['sort_no' => 'ASC']);
        $csvNotOutput = $this->csvRepository->matching($criteria);

        $builder
            ->add('csv_type', EntityType::class, [
                'class' => 'Eccube\Entity\Master\CsvType',
                'required' => true,
                'constraints' => [
                    new NotBlank(),
                ],
                'query_builder' => function (EntityRepository $er) {
                    return $er->createQueryBuilder('c')
                        ->where('c.id IN (:csvIds)')
                        ->setParameter('csvIds', self::CSV_TYPES);
                },
                'data' => $CsvType,
            ])
            ->add('csv_extensions', EntityType::class, [
                'class' => 'Eccube\Entity\DtbCsvExtension',
                'required' => false,
                'query_builder' => function (EntityRepository $er) use ($CsvType) {
                    return $er->createQueryBuilder('ce')
                        ->join('ce.CsvType', 'ct', 'WITH', 'ct = :csvType')
                        ->setParameter('csvType', $CsvType);
                },
                'placeholder' => '新規作成',
                'data' => $isCsvExtensionExisting ? $CsvExtension : null,
            ])
            ->add('name', TextType::class, [
                'required' => true,
                'constraints' => [
                    new NotBlank(),
                ],
                'attr' => [
                    'placeholder' => 'カスタムCSV名称',
                ],
                'data' => $isCsvExtensionExisting ? $CsvExtension->getName() : null,
            ])
            ->add('csv_not_output', EntityType::class, [
                'class' => 'Eccube\Entity\Csv',
                'choice_label' => 'disp_name',
                'required' => false,
                'expanded' => false,
                'multiple' => true,
        $this->csvRepository = $csvRepository;
        $this->csvExtensionEntityManager = $csvExtensionEntityManager;
        $this->csvCsvExtensionEntityManager = $csvCsvExtensionEntityManager;
    }

    /**
     * @param DtbCsvExtension $CsvExtension
     * @param CsvType $CsvType
     * @param array<string, mixed> $requestData
     * @param Member $member
     */
    public function handle(
        DtbCsvExtension $CsvExtension,
        CsvType $CsvType,
        array $requestData,
        Member $member,
    ): void {
        $this->entityManager->beginTransaction();

        try {
            $this->csvExtensionEntityManager->save(
                $CsvExtension,
                $CsvType,
                $requestData['name'],
                $member
            );
            $this->entityManager->flush();

            if ($CsvExtension->getCsvCsvExtensions()->count() > 0) {
                $this->csvCsvExtensionRepository->deleteByCsvExtensionId($CsvExtension->getId());
            }

            $csvIds = isset($requestData['csv_output']) ? $requestData['csv_output'] : [];
            $Csvs = $this->csvRepository->findBy(['id' => $csvIds]);

            foreach ($Csvs as $key => $Csv) {
                $CsvCsvExtension = new DtbCsvCsvExtension();
                $this->csvCsvExtensionEntityManager->save($CsvCsvExtension, $CsvExtension, $Csv, $key);
            }
            $this->entityManager->flush();
            $this->entityManager->commit();
        } catch (\Exception $e) {
            $this->entityManager->rollback();

            throw $e;
        }
    }
}
