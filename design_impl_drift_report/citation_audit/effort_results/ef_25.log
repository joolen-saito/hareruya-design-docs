            /** @var Member $Member */
            $Member = $event->getData();
            $BaseInfo = $event->getForm()->get('baseInfo')->getData();

            if (
                !empty($Member->getAuthority()) && (
                    $Member->getAuthority()->getId() === Authority::TENANT_OPERATOR_ID
                    || $Member->getAuthority()->getId() === Authority::TENANT_OWNER_ID
                )) {
                if ($BaseInfo === null) {
                    $form = $event->getForm();
                    $form['baseInfo']->addError(new FormError(trans('enterprise.form.type.member.tenant_not_selected')));
                }
            }
        });

        // login idの入力は新規登録時のみとし、編集時はdisabledにする
        $builder->addEventListener(FormEvents::PRE_SET_DATA, function (FormEvent $event): void {
            $form = $event->getForm();
            $data = $event->getData();

            $options = [
                'constraints' => [
                    new Length([
                        'min' => $this->eccubeConfig['eccube_id_min_len'],
                        'max' => $this->eccubeConfig['eccube_id_max_len'],
                    ]),
                    new Regex([
                        'pattern' => '/^[[:graph:][:space:]]+$/i',
                        'message' => 'form_error.graph_only',
                    ]),
                ],
            ];

            if ($data->getId() === null) {
                $options['constraints'][] = new NotBlank();
            } else {
                $options['required'] = false;
                $options['mapped'] = false;
                $options['attr'] = [
                    'disabled' => 'disabled',
                ];
                $options['empty_data'] = $data->getLoginId();
                $options['data'] = $data->getLoginId();
            }

            $form->add('login_id', TextType::class, $options);
        });

        $builder->addEventListener(FormEvents::POST_SUBMIT, function (FormEvent $event): void {
            /** @var Member $Member */
            $Member = $event->getData();
            $form = $event->getForm();

            // 編集時に, 非稼働で更新した場合にチェック.
            if ($Member->getId() && $Member->getWork()->getId() == Work::NON_ACTIVE) {
                // 自身を除いた稼働メンバーの件数
                $count = $this->memberRepository
                    ->createQueryBuilder('m')
                    ->select('COUNT(m)')
                    ->innerJoin('m.Authority', 'a')
                    ->where('m.Work = :Work AND a.id = :AuthorityId AND m.id <> :MemberId')
                    ->setParameter('Work', Work::ACTIVE)
                    ->setParameter('AuthorityId', Authority::SYSTEM_ID)
                    ->setParameter('MemberId', $Member->getId())
                    ->getQuery()
                    ->getSingleScalarResult();

                if ($count < 1) {
                    $form['Work']->addError(new FormError(trans('admin.setting.system.member.work_can_not_change')));
                }
            }

            if ($Member->getId() === null && $this->memberNameCheckViewRepository->isLoginIdExists($Member->getLoginId()) === true) {
                $form['login_id']->addError(new FormError(trans('enterprise.form.type.member_already_exists')));
            }
        });

        // 権限はテナント権限以上の場合、店舗IDをモールIDに変更する
        $builder->addEventListener(FormEvents::POST_SUBMIT, function (FormEvent $event) {
            /** @var Member $Member */
            $Member = $event->getData();

            if ($Member->getAuthority() === null) {
                return;
            }

            if ($Member->getAuthority()->getId() < Authority::TENANT_OWNER_ID) {
                $Member->setBaseInfo($this->baseInfoRepository->find((int) $this->eccubeConfig->get('eccube_root_base_info_id')));
            }
        });
    }

