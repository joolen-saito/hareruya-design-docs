namespace Eccube\Service\Admin\Setting\System;

use Doctrine\ORM\EntityManagerInterface;
use Eccube\Entity\MemberBaseInfo;
use Eccube\Repository\MemberBaseInfoRepository;
use Eccube\Service\Admin\Setting\System\ActionInput\MemberEditInput;
use Eccube\Service\EntityManager\MemberEntityManager;

class MemberEditAction
{
    public function __construct(
        private readonly EntityManagerInterface $entityManager,
        private readonly MemberEntityManager $memberEntityManager,
        private readonly MemberBaseInfoRepository $memberBaseInfoRepository,
    ) {
    }

    /**
     * @throws \Exception
     */
    public function handle(MemberEditInput $input): void
    {
        $Member = $input->Member;
        $defaultPassword = $input->defaultPassword;
        $BaseInfo = $input->BaseInfo;
        $editableBaseInfoIds = $input->editableBaseInfoIds;

        $this->entityManager->beginTransaction();

        try {
            $this->memberEntityManager->save(
                $Member,
                $defaultPassword,
                $BaseInfo,
            );

            /** @var MemberBaseInfo[] $ExistingMemberBaseInfos */
            $ExistingMemberBaseInfos = $this->memberBaseInfoRepository->findBy([
                'Member' => $Member,
            ]);

            $existingBaseInfoMap = [];
            foreach ($ExistingMemberBaseInfos as $MemberBaseInfo) {
                $baseInfoId = (int) $MemberBaseInfo->getBaseInfo()->getId();
                $existingBaseInfoMap[$baseInfoId] = $MemberBaseInfo;

                if (!in_array($baseInfoId, $editableBaseInfoIds, true)) {
                    $this->entityManager->remove($MemberBaseInfo);
                }
            }

            $baseInfoIds = array_diff($editableBaseInfoIds, array_keys($existingBaseInfoMap));
            $this->memberBaseInfoRepository->insertMemberBaseInfos($Member, $baseInfoIds);

            $this->entityManager->flush();
            $this->entityManager->commit();
        } catch (\Exception $e) {
            $this->entityManager->rollback();

            throw $e;
        }
    }
}
