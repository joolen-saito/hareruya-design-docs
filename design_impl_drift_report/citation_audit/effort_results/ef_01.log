    public function onAfterImport(AfterReadEvent $event): void
    {
        parent::onAfterImport($event);

        if ($this->rowCount > 0 && $event->isSuccessful()) {
            $now = new \DateTime('now', new \DateTimeZone('UTC'));
            $HistorySourceType = $this->stockHistorySourceTypeRepository->find(MtbStockHistorySourceType::STOCK_CHANGE_CSV_IMPORT);
            $BaseInfo = $this->entityManager->getReference(BaseInfo::class, $this->input->changeBaseInfoId);

            $this->stockApprovalListEntityManager->save(
                StockApprovalList: null,
                BaseInfo: $BaseInfo,
                StockLocationId: $this->input->changeStockLocationId,
                HistorySourceType: $HistorySourceType,
                historySourceId: $this->requireStockEditApprovalId(),
                StockTransferTypeDetail: $this->entityManager->getReference(MtbStockChangeTypeDetail::class, $this->input->stockChangeTypeDetailId),
                approvalStatus: DtbStockApprovalList::APPROVAL_STATUS_UNAPPROVED,
                registeredDate: $now,
                RegisteredMember: $this->entityManager->getReference(Member::class, $this->Member->getId()),
                approvedDate: null,
                ApprovalMember: null,
                ProductStockTotalCount: $this->rowCount,
                InventoryChangeTotalCount: $this->totalInventoryChange,
                TotalCostPriceBefore: $this->totalCostPriceBefore,
            );

            // S3へのアップロード処理
            $importFilePath = $this->input->importFilePath;
            if (!is_file($importFilePath)) {
                throw new \RuntimeException('Failed to upload CSV file to S3.');
            }

            $s3ObjectKey = null;

            try {
                $s3Path = sprintf(
                    '%s%s/%s/%d',
                    self::S3_PREFIX,
                    $now->format('Y'),
                    $now->format('m'),
                    $this->requireStockEditApprovalId(),
                );
                $s3Filename = 'upload_'.StringUtil::random().'.csv';

                $fileAdapter = $this->fileManager->getAdapter();
                $contentBucketOptions = $this->fileManager->getContentBucketOptions();
                $fileAdapter->upload($importFilePath, $s3Path, $s3Filename, $contentBucketOptions);

                $entitySaveData = $fileAdapter->toEntitySaveData();
                $s3ObjectKey = (string) ($entitySaveData['s3_object_key'] ?? '');
                if ($s3ObjectKey === '') {
                    throw new \RuntimeException('Failed to upload CSV file to S3.');
                }

                $this->entityManager->flush();
                $this->stockEditCsvRepository->insertCsvFilename([
                    'fileName' => $this->input->originalFileName,
                    's3ObjectKey' => $s3ObjectKey,
                    'memberId' => (int) $this->Member->getId(),
                    'stockEditApprovalId' => $this->requireStockEditApprovalId(),
                ]);
            } catch (\Throwable $e) {
                if ($s3ObjectKey !== null && str_starts_with($s3ObjectKey, self::S3_PREFIX)) {
                    $fileAdapter = $this->fileManager->getAdapter();
                    $contentBucketOptions = $this->fileManager->getContentBucketOptions();

                    if ($fileAdapter->exists($s3ObjectKey, $contentBucketOptions)) {
                        $fileAdapter->delete($s3ObjectKey, $contentBucketOptions);
                    }
                }

                throw $e;
            }
        }

        $this->clearColumnDefinitions();
    }

