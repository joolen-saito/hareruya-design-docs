namespace Eccube\Service\Admin\Order;

use Doctrine\ORM\EntityManagerInterface;
use Eccube\Entity\Master\OrderStatus;
use Eccube\Repository\BaseInfoRepository;
use Eccube\Repository\Master\OrderStatusRepository;
use Eccube\Repository\OrderRepository;
use Eccube\Service\Admin\Order\ActionInput\UpdatePrintedOrderStatusInput;
use Psr\Log\LoggerInterface;

class UpdatePrintedOrderStatusAction
{
    public function __construct(
        private readonly EntityManagerInterface $entityManager,
        private readonly BaseInfoRepository $baseInfoRepository,
        private readonly OrderStatusRepository $orderStatusRepository,
        private readonly OrderRepository $orderRepository,
        private readonly LoggerInterface $logger,
    ) {
    }

    /**
     * 印刷が完了した受注のステータスを更新する
     *
     * @param UpdatePrintedOrderStatusInput $input
     *
     * @throws \Exception
     */
    public function handle(UpdatePrintedOrderStatusInput $input): void
    {
        $responseFile = $input->responseFile;

        $xml = @simplexml_load_string($responseFile);
        if ($xml === false) {
            $this->logger->error($responseFile);
            $this->logger->error('XMLパースエラー');

            return;
        }
        if ((string) $xml->ServerDirectPrint === 'false' || count($xml->ePOSPrint) < 1) {
            $this->logger->error($responseFile);

            return;
        }

        $BaseInfo = $this->baseInfoRepository->find($input->base_info_id);
        $pickingStatus = $this->orderStatusRepository->find(OrderStatus::PICKING);

        if (!$BaseInfo) {
            $this->logger->error("ステータス更新エラー：BaseInfo（ID: {$input->base_info_id}）が存在しません。");

            return;
        }

        if (!$pickingStatus) {
            $this->logger->error('ステータス更新エラー：PICKINGステータスが存在しません。');

            return;
        }

        $this->entityManager->beginTransaction();
        try {
            foreach ($xml->ePOSPrint as $print) {
                $orderId = explode('_', (string) $print->Parameter->printjobid)[0];

                $Order = $this->orderRepository->find($orderId);
                if (!$Order) {
                    $this->logger->error("ステータス更新エラー：受注ID{$orderId}が存在しません。");

                    continue;
                }
                if ($Order->isBrowserPrintFlg()) {
                    $Order->setBrowserPrintFlg(false);
                } else {
                    $Order->setOrderStatus($pickingStatus);
                    if ($BaseInfo->isMainShop()) {
                        // 本店の場合、注文確定日を更新
                        $Order->setConfirmDate(new \DateTime());
                    } else {
                        // 支店の場合、ピック開始日を更新
                        $Order->setPickingDate(new \DateTime());
                    }
                }
                $this->entityManager->persist($Order);
                $this->entityManager->flush();
            }

            $this->entityManager->commit();
        } catch (\Throwable $e) {
            $this->entityManager->rollback();

            throw $e;
        }
    }
}
     *
     * @return array<int, mixed>
     */
    public function generateResultCsv(array $orderIdList): array
    {
        $qb = $this->getEntityManager()->createQueryBuilder()
            ->from('Eccube\Entity\Order', 'o')
            ->select([
                'o.order_number',
                'c.id AS customer_id',
                'c.name01 AS customer_name01',
                'c.name02 AS customer_name02',
                'c.kana01 AS customer_kana01',
                'c.kana02 AS customer_kana02',
                'c.company_name AS customer_company_name',
                // TODO：顧客郵便番号はテーブルでカラムが01，02に分かれていない。一旦ここで分割して出力する。
                'SUBSTRING(c.postal_code, 1, 3) AS customer_zip01',
                'SUBSTRING(c.postal_code, 4, 4) AS customer_zip02',
                'cp.id AS customer_pref_id',
                'cp.name AS customer_pref_name',
                'c.addr01 AS customer_addr01',
                'c.addr02 AS customer_addr02',
                'c.addr03 AS customer_addr03',
                'c.email AS customer_email',
                'c.tel01 AS customer_tel01',
                'c.tel02 AS customer_tel02',
                'c.tel03 AS customer_tel03',
                'c.fax01 AS customer_fax01',
                'c.fax02 AS customer_fax02',
                'c.fax03 AS customer_fax03',
                'cs.id AS customer_sex_id',
                'cs.name AS customer_sex',
                'cj.id AS customer_job_id',
                'cj.name AS customer_job',
                'c.birth AS customer_birth',
                'c.note AS customer_note',
                'o.subtotal',
                'o.discount',
                'o.delivery_fee_total',
                'o.tax',
                'o.total',
                'o.payment_total',
                'ost.id AS status_id',
                'ost.name AS status',
                'py.id AS payment_id',
                'py.method',
                'o.order_date',
                'o.confirmDate',
                'o.payment_date',
                'o.commitDate',
                'o.shippingDate',
                's.name01 AS shipping_name01',
                's.name02 AS shipping_name02',
                's.kana01 AS shipping_kana01',
                's.kana02 AS shipping_kana02',
                's.company_name AS shipping_company_name',
                // TODO：配送先郵便番号はテーブルでカラムが01，02に分かれていない。一旦ここで分割して出力する。
                'SUBSTRING(s.postal_code, 1, 3) AS shipping_zip01',
                'SUBSTRING(s.postal_code, 4, 4) AS shipping_zip02',
                'sp.id AS shipping_pref_id',
                'sp.name AS shipping_pref_name',
                's.addr01 AS shipping_addr01',
                's.addr02 AS shipping_addr02',
                's.addr03 AS shipping_addr03',
                's.tel01 AS shipping_tel01',
                's.tel02 AS shipping_tel02',
                's.tel03 AS shipping_tel03',
                // TODO：配送先Fax番号はテーブルにカラムなし。一旦空文字を出力する。
                "'' AS shipping_fax01",
                "'' AS shipping_fax02",
                "'' AS shipping_fax03",
                'd.id AS delivery_id',
                'd.name AS delivery_name',
                'o.invoiceNumber',
                't.id AS delivery_time_id',
                't.delivery_time',
            ])
            ->join('o.Pref', 'op')
            ->leftJoin('o.Country', 'oc')
            ->join('o.Customer', 'c')
            ->leftJoin('c.Sex', 'cs')
            ->leftJoin('c.Job', 'cj')
            ->join('c.Pref', 'cp')
            ->leftjoin('c.Country', 'cc')
            ->join('o.Payment', 'py')
            ->join('o.OrderStatus', 'ost')
            ->leftJoin('o.Shippings', 's')
            ->join('s.Pref', 'sp')
            ->join('s.Delivery', 'd')
            ->leftJoin('d.DeliveryTimes', 't', 'WITH', 't.id = s.time_id')
            ->where('o IN (:orders)')
            ->setParameter('orders', $orderIdList)
            ->groupBy('
                o.id,
                c.id,
                cp.id,
                cs.id,
                cj.id,
                ost.id,
                py.id,
                py.id,
                sp.id,
                s.name01,
                s.name02,
                s.kana01,
                s.kana02,
                s.company_name,
                s.postal_code,
                s.addr01,
                s.addr02,
                s.addr03,
                s.tel01,
                s.tel02,
                s.tel03,
                d.id,
                t.id
            ');

        $result = $qb
            ->getQuery()
            ->getResult();

        array_walk_recursive($result, function (&$item) {
            if ($item instanceof \DateTime) {
                $item = $item->format(self::CSV_DATE_FORMAT);
            }
        });

        return $result;
    }

