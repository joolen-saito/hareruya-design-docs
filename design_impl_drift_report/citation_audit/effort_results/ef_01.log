    /**
     * 商品IDからポップアップ用の商品情報を1件取得する
     *
     * @param int $productId
     * @param string $languageCode
     * @param int|null $stockBaseInfoId 在庫参照店舗（未指定時は本店）
     *
     * @return array<string, mixed>|null
     */
    public function findPopupProductByProductId(int $productId, string $languageCode, ?int $stockBaseInfoId = null): ?array
    {
        $stockBaseInfoId ??= (int) $this->eccubeConfig->get('eccube_root_base_info_id');

        // 現行 pf-api の LANG_RANK に合わせた画像ランク優先度（ja→2, en→1）
        $langRank = $languageCode === 'EN' ? 1 : 2;

        $sql = <<<SQL
SELECT
    p.id AS productId,
    p.name AS productName,
    p.name_en AS nameEn,
    pc.id AS productClassId,
    pc.price01 AS price01,
    pc.price02 AS price02,
    pstock.stock AS stock,
    COALESCE(lang.code, :languageCode) AS languageCode,
    CASE WHEN pc.memo IS NOT NULL AND pc.memo != '' THEN pc.memo ELSE cc.code END AS conditionCode,
    cd.foil_flg AS foilFlg,
    pimg.file_name AS imageFileName,
    (SELECT COALESCE(SUM(sq.sales_quantity_04), 0)
     FROM dtb_product_class pc2
     LEFT JOIN mtb_language lang2 ON pc2.language_id = lang2.id
     LEFT JOIN dtb_sales_quantity sq ON sq.product_class_id = pc2.id
         AND sq.base_info_id = :mainBaseInfoId
         AND sq.sales_location = :ecSalesLocation
     WHERE pc2.product_id = p.id
       AND pc2.visible = true
       AND lang2.code = :languageCode) AS weeklySold
FROM dtb_product p
    INNER JOIN dtb_product_class pc ON p.id = pc.product_id AND pc.visible = true AND pc.price02 > 0
    LEFT JOIN dtb_product_stock pstock ON pstock.product_class_id = pc.id
        AND pstock.base_info_id = :stockBaseInfoId
        AND pstock.stock_location_id = :eccubeStockLocationId
    LEFT JOIN mtb_language lang ON pc.language_id = lang.id
    LEFT JOIN mtb_card_condition cc ON pc.card_condition_id = cc.id
    LEFT JOIN dtb_product_class_image pci ON pci.product_class_id = pc.id
    LEFT JOIN dtb_product_image pimg ON pci.product_image_id = pimg.id
    INNER JOIN mtb_card_detail cd ON p.card_detail_id = cd.id
WHERE p.id = :productId
  AND p.product_status_id = :statusId

            $products = $this->productRepository->findProductsByProductIdAndLanguage($productIdLanguagePairs);
            if (empty($products)) {
                log_warning('商品詳細データが見つかりません', [
                    'product_name' => $productName,
                    'request_url' => $request->getUri(),
                ]);
                throw new NotFoundException('Not Found');
            }

            $response = $this->productSearchResponseBuilder->build($products);

            return $this->json($response, Response::HTTP_OK);
        } catch (BaseApiException $e) {
            return $this->json([
                'code' => $e->getCode(),
                'message' => $e->getMessage(),
            ], $e->getCode());
        } catch (\Throwable $e) {
            log_error('商品検索処理中にエラーが発生しました', [
                'product_name' => $productName,
                'error' => $e->getMessage(),
                'request_url' => $request->getUri(),
            ]);

            return $this->json([
                'code' => Response::HTTP_INTERNAL_SERVER_ERROR,
                'message' => 'システムエラーが発生しました',
            ], Response::HTTP_INTERNAL_SERVER_ERROR);
        }
    }

