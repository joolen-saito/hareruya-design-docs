namespace Eccube\Service\Admin\Order;

use Eccube\Repository\BaseInfoRepository;
use Eccube\Repository\OrderRepository;
use Eccube\Service\Admin\Order\ActionInput\OrderDirectPrintInput;

class OrderDirectPrintAction
{
    public function __construct(
        private readonly BaseInfoRepository $baseInfoRepository,
        private readonly OrderRepository $orderRepository,
    ) {
    }

    /**
     * 印刷データを取得する
     *
     * @param OrderDirectPrintInput $input
     *
     * @throws \Exception
     */
    public function handle(OrderDirectPrintInput $input): string
    {
        $uri = $input->uri;
        $base_info_id = $input->base_info_id;

        $BaseInfo = $this->baseInfoRepository->find($base_info_id);

        if ($BaseInfo && $BaseInfo->isMainShop()) {
            $OrderDataList = $this->orderRepository->getPrintOrderListMainShop($base_info_id);
        } else {
            $OrderDataList = $this->orderRepository->getDirectPrintOrderList($base_info_id);
        }

        if (empty($OrderDataList)) {
            return '';
        }

        $PrintList = [];
        foreach ($OrderDataList as $OrderData) {
            $PrintList[] = $this->getPrintData($OrderData, $uri);
        }
        $xmlData = $this->getXmlData($PrintList);

        return $xmlData;
    }

    /**
     * スタック用紙の受注1つ分の印刷データ生成
     *
     * @param array<string, mixed> $Order
     * @param string $uri
     *
     * @return string
     */
    private function getPrintData(array $Order, string $uri): string
    {
        $orderDate = $Order['order_date'] !== null ? $Order['order_date']->format('Y/m/d H:i') : '';
        $paymentTotal = $Order['payment_total'];
        $orderName = htmlspecialchars($Order['name_kana'] ?: $Order['name'], ENT_XML1, 'UTF-8');
        $contactText = $Order['hasMessage'] ? '問い合わせ有' : '';
        $orderNumber = htmlspecialchars((string) $Order['order_number'], ENT_XML1, 'UTF-8');
        $smaregiCode = htmlspecialchars((string) $Order['smaregi_code'], ENT_XML1, 'UTF-8');

        return <<<EOX
          <ePOSPrint>
            <Parameter>
              <devid>local_printer</devid>
              <timeout>10000</timeout>
              <printjobid>{$Order['order_id']}</printjobid>
            </Parameter>
            <PrintData>
              <epos-print xmlns="http://www.epson-pos.com/schemas/2011/03/epos-print">
                <text lang="ja"/>
                <page>
                  <area x="0" y="0" width="512" height="751"/>
                  <rectangle x1="0" y1="0" x2="511" y2="200" style="thin"/>
                  <position x="18" y="25"/>
                  <text>店頭注文番号</text>
                  <rectangle x1="0" y1="0" x2="511" y2="200" style="thin"/>
                  <position x="200" y="150"/>
                  <text width="5" height="5">{$orderNumber}</text>
                  <rectangle x1="0" y1="200" x2="511" y2="400" style="thin"/>
                  <rectangle x1="0" y1="200" x2="175" y2="400" style="thin"/>
                  <position x="18" y="225"/>
                  <text width="1" height="1">注文詳細URL</text>
                  <position x="14" y="243"/>
                  <symbol type="qrcode_model_2" level="default" width="5" height="0" size="0">{$uri}admin/order/{$Order['order_id']}/edit</symbol>
                  <position x="179" y="230"/>
                  <text>備考　　{$contactText}</text>
                  <rectangle x1="0" y1="400" x2="210" y2="450" style="thin"/>
                  <position x="25" y="434"/>
                  <text>注文日</text>
                  <rectangle x1="210" y1="400" x2="511" y2="450" style="thin"/>
                  <position x="235" y="434"/>
                  <text>{$orderDate}</text>
                  <rectangle x1="0" y1="450" x2="210" y2="500" style="thin"/>
                  <position x="25" y="484"/>
                  <text>注文番号</text>
                  <rectangle x1="210" y1="450" x2="511" y2="500" style="thin"/>
                  <position x="235" y="484"/>
                  <text>{$orderNumber}</text>
                  <rectangle x1="0" y1="500" x2="210" y2="550" style="thin"/>
                  <position x="25" y="534"/>
                  <text>お客様名</text>
                  <rectangle x1="210" y1="500" x2="511" y2="550" style="thin"/>
                  <position x="235" y="534"/>
                  <text>{$orderName}</text>
                  <rectangle x1="0" y1="550" x2="210" y2="600" style="thin"/>
                  <position x="25" y="584"/>
                  <text>合計金額</text>
                  <rectangle x1="210" y1="550" x2="511" y2="600" style="thin"/>
                  <position x="235" y="584"/>
                  <text>{$paymentTotal}</text>
                  <rectangle x1="0" y1="600" x2="210" y2="650" style="thin"/>
                  <position x="25" y="634"/>
                  <text>変更後金額</text>
                  <rectangle x1="210" y1="600" x2="511" y2="650" style="thin"/>
                  <position x="8" y="720"/>
                  <barcode type="jan13" hri="below" font="font_b" width="2" height="50">{$smaregiCode}</barcode>
                  <position x="225" y="684"/>
                  <text>高額　　{$Order['expensive']}</text>
                  <position x="370" y="684"/>
                  <text>サプライ □</text>
                  <position x="225" y="734"/>
                  <text>欠品　　□</text>
                  <position x="370" y="734"/>
                  <text>Wチェック□</text>
                </page>
                <cut type="feed"/>
              </epos-print>
            </PrintData>
          </ePOSPrint>
        EOX;
    }

    /**
     * スタック用紙のXMLデータ生成
     *
     * @param array<int, string> $PrintList
     *
     * @return string
     */
    private function getXmlData(array $PrintList): string
    {
        $xml = implode('', $PrintList);

        return <<<EOX
            <?xml version="1.0" encoding="utf-8"?>
            <PrintRequestInfo Version="3.00">
                {$xml}
            </PrintRequestInfo>
            EOX;
    }
}
