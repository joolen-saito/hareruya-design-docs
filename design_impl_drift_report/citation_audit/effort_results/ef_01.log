<?php
namespace App\Repository;

use Doctrine\ORM\EntityRepository;
use Doctrine\ORM\Query\Expr;

/**
 * DtbProductClassRepository
 */
class DtbProductClassRepository extends EntityRepository
{
    /**
     * 商品情報・商品規格いずれかの更新日時が指定期間内のものを取得
     *
     * @param Datetime $fromDate
     * @param Datetime $toDate
     * @return array
     */
    public function getProductClassesByUpdateDate($fromDate, $toDate)
    {
        $qb = $this->createQueryBuilder('productClass');
        $qb->join('productClass.productSubClass', 'productSubClass')
            ->join('productClass.product', 'product')
            ->join('product.productSub', 'productSub')
            ->join('product.status', 'status')
            ->leftJoin('product.categories', 'category')
            ->leftJoin('productSub.storageCode', 'storageCode')
            ->leftJoin('productSubClass.cardCondition', 'cardCondition')
            ->leftJoin('productSubClass.language', 'language')
            ->leftJoin('productSubClass.productSubClassImages', 'productSubClassImage')
            ->leftJoin('productSubClassImage.productImage', 'productImage')
            ->leftJoin('productSub.cardDetail', 'cardDetail')
            ->leftJoin('cardDetail.cardset', 'cardset')
            ->select('
                product.productId,
                productClass.productCode,
                product.name,
                productSub.nameEn,
                product.descriptionDetail,
                productSub.descriptionDetailEn,
                status.id AS statusId,
                status.name AS statusName,
                productClass.stock,
                productClass.price02,
                GROUP_CONCAT(DISTINCT productImage.fileName) AS imageFileName,
                GROUP_CONCAT(DISTINCT category.categoryId ORDER BY category.categoryId) AS categoryId,
                GROUP_CONCAT(DISTINCT category.categoryName ORDER BY category.categoryId) AS categoryName,
                storageCode.id AS strageCodeId,
                storageCode.name AS storageCodeName,
                language.code AS languageCode,
                cardset.code AS cardsetCode,
                cardCondition.code AS cardConditionCode,
                productClass.updateDate AS productClassUpdateDate,
                product.updateDate AS productUpdateDate
            ')
            ->where('product.delFlg = 0')
            ->andWhere('productClass.delFlg = 0')
            ->andWhere($qb->expr()->orX(
                $qb->expr()->andX(
                    $qb->expr()->gte('product.updateDate', ':fromDate'),
                    $qb->expr()->lte('product.updateDate', ':toDate')
                ),
                $qb->expr()->andX(
                    $qb->expr()->gte('productClass.updateDate', ':fromDate'),
                    $qb->expr()->lte('productClass.updateDate', ':toDate')
                )
            ))
            ->groupBy('productClass.productClassId')
            ->setParameter('fromDate', $fromDate)
            ->setParameter('toDate', $toDate)
            ;

        return $qb->getQuery()->getResult();
    }
}

