namespace Eccube\Repository;

use Doctrine\ORM\QueryBuilder;
use Doctrine\Persistence\ManagerRegistry;
use Eccube\Entity\DtbStockEditCsv;
use Eccube\Util\SqlUtil;

/**
 * @extends AbstractRepository<DtbStockEditCsv>
 */
class DtbStockEditCsvRepository extends AbstractRepository
{
    public function __construct(
        ManagerRegistry $registry,
    ) {
        parent::__construct($registry, DtbStockEditCsv::class);
    }

    /**
     * CSVファイル名を登録する。
     *
     * @param array{
     *     fileName: string,
     *     s3ObjectKey: string,
     *     memberId: int,
     *     stockEditApprovalId: int,
     * } $inputs 登録する情報
     *
     * @return ?int 在庫編集情報CSVファイルID
     */
    public function insertCsvFilename(array $inputs): ?int
    {
        $sql = <<<EOT
INSERT INTO
    dtb_stock_edit_csv
(
    file_name,
    s3_object_key,
    create_date,
    member_id,
    stock_edit_id
)
VALUES
(
    ?,
    ?,
    ?,
    ?,
    ?
)
EOT;

        $connection = $this->getEntityManager()->getConnection();
        $connection->executeStatement(
            $sql,
            [
                $inputs['fileName'],
                $inputs['s3ObjectKey'],
                SqlUtil::timestamp(new \DateTime('now', new \DateTimeZone('UTC'))),
                $inputs['memberId'],
                $inputs['stockEditApprovalId'],
            ]
        );
        $stockEditCsvId = (int) $connection->lastInsertId() ?: null;

        return $stockEditCsvId;
    }

    /**
     * 在庫編集IDに紐づく CSV レコードを取得する。
     */
    public function findByStockEditApprovalId(int $stockEditApprovalId): ?DtbStockEditCsv
    {
        $StockEditCsv = $this->createQueryBuilder('sc')
            ->innerJoin('sc.StockEdit', 'sa')
            ->where('sa.id = :stockEditApprovalId')
            ->setParameter('stockEditApprovalId', $stockEditApprovalId)
            ->getQuery()
            ->getOneOrNullResult();

        return $StockEditCsv;
    }

    /**
     * 在庫変更CSV登録履歴一覧用 QueryBuilder.
     *
     * 並び順は登録日時（sc.createDate）と承認日時（sa.approvedAt）のうち後の日時（基準日時）の降順。
     * 承認日時が未設定の場合は登録日時を基準日時とする。
     */
    public function getStockChangeHistoryQueryBuilder(): QueryBuilder
    {
        return $this->createQueryBuilder('sc')
            ->select('sc', 'sa', 'msd', 'mst', 'm', 'am', 'bi')
            ->innerJoin('sc.StockEdit', 'sa')
            ->innerJoin('sa.StockChangeTypeDetail', 'msd')
            ->innerJoin('msd.StockChangeType', 'mst')
            ->innerJoin('sc.Member', 'm')
            ->leftJoin('sa.ApprovalMember', 'am')
            ->innerJoin('sa.baseInfo', 'bi')
            ->addSelect(
                'CASE WHEN sa.approvedAt IS NOT NULL AND (sc.createDate IS NULL OR sa.approvedAt > sc.createDate)'
                .' THEN sa.approvedAt ELSE sc.createDate END AS HIDDEN baseDate'
            )
            ->orderBy('baseDate', 'DESC')
            ->addOrderBy('sa.id', 'DESC');
    }
}

