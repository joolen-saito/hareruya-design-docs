namespace Eccube\Service\Smaregi\Stock;

use Eccube\Repository\DtbStockHistoryRepository;
use Eccube\Service\Smaregi\Api\SmaregiAccessTokenService;
use Eccube\Service\Smaregi\Api\SmaregiStockApiClient;
use Eccube\Service\Smaregi\Webhook\Stock\SmaregiStockProcessDispatcher;
use Psr\Log\LoggerInterface;

/**
 * スマレジ在庫変動 Webhook 連携エラー再連携バッチの本体。
 *
 * スマレジ側 Webhook にリトライ機構が無いため、受信失敗した在庫変動を後追いで補完する。
 * 在庫変動履歴API は productId / storeId 単位でしか取得できないため、在庫一覧API で対象の
 * (productId, storeId) を列挙し、対象日 (target_date) の在庫変動履歴を問い合わせる。
 *
 * 取得した在庫変動履歴のうち、まだ EC-CUBE に取り込まれていない (在庫変動履歴IDが未保存の) ものを
 * Webhook 受信経路と同じ子ジョブ ({@see \Eccube\Message\SmaregiStockProcessMessage}) として enqueue し、
 * 反映処理を既存ハンドラ・{@see \Eccube\Service\Smaregi\Webhook\Stock\SmaregiStockChangeApplier} に委譲する。
 */
final readonly class SmaregiStockBackfillAction
{
    /** バッチ起点の子ジョブであることを示す action ラベル (Webhook 受信は 'edited')。 */
    public const ACTION_BACKFILL = 'backfill';

    /** API 取得 1 ページあたりの件数。 */
    private const PAGE_LIMIT = 1000;

    /** ページング暴走防止のための最大ページ数。 */
    private const MAX_PAGES = 1000;

    public function __construct(
        private LoggerInterface $logger,
        private SmaregiAccessTokenService $accessTokenService,
        private SmaregiStockApiClient $stockApiClient,
        private DtbStockHistoryRepository $stockHistoryRepository,
        private SmaregiStockProcessDispatcher $stockProcessDispatcher,
        private string $smaregiApiIdUrl,
        private string $smaregiApiUrl,
        private string $smaregiApiClientId,
        private string $smaregiApiClientSecret,
        private string $smaregiApiContractId,
    ) {
    }

    /**
     * @param string|null $targetDate 取得対象日 (未指定時は駆動日)。スマレジ在庫変動履歴API の target_date に渡す。
     *
     * @return array{targetDate:string,pairs:int,fetched:int,enqueued:int,skipped:int,failed:int}
     */
    public function handle(?string $targetDate = null): array
    {
        $targetDate = ($targetDate === null || $targetDate === '')
            ? (new \DateTime())->format('Y-m-d')
            : $targetDate;

        $accessToken = $this->accessTokenService->getAccessToken(
            $this->smaregiApiIdUrl,
            $this->smaregiApiContractId,
            $this->smaregiApiClientId,
            $this->smaregiApiClientSecret,
        );

        $pairs = $this->collectStockPairs($accessToken);

        $summary = [
            'targetDate' => $targetDate,
            'pairs' => count($pairs),
            'fetched' => 0,
            'enqueued' => 0,
            'skipped' => 0,
            'failed' => 0,
        ];

        foreach ($pairs as $pair) {
            $this->backfillPair($accessToken, $pair['productId'], $pair['storeId'], $targetDate, $summary);
        }

        $this->logger->info('Smaregi stock backfill finished', $summary);

        return $summary;
    }

    /**
     * 在庫一覧API をページングで全件取得し、対象の (productId, storeId) を列挙する。
     *
     * @return list<array{productId:string,storeId:string}>
     */
    private function collectStockPairs(string $accessToken): array
    {
        $pairs = [];
        $seen = [];

        $reachedEnd = false;
        for ($page = 1; $page <= self::MAX_PAGES; $page++) {
            $response = $this->stockApiClient->listStocks(
                $this->smaregiApiUrl,
                $this->smaregiApiContractId,
                $accessToken,
                [
                    'page' => (string) $page,
                    'limit' => (string) self::PAGE_LIMIT,
                ],
            );

            $statusCode = $response['statusCode'];
            if ($statusCode < 200 || $statusCode >= 300) {
                throw new \RuntimeException(sprintf('Failed to list Smaregi stocks (page=%d, statusCode=%d)', $page, $statusCode));
            }

            $rows = $this->extractRows($response['json']);
            foreach ($rows as $row) {
                $productId = $this->stringOrNull($row['productId'] ?? null);
                $storeId = $this->stringOrNull($row['storeId'] ?? null);
                if ($productId === null || $storeId === null) {
                    continue;
                }
                $key = $productId.'|'.$storeId;
                if (isset($seen[$key])) {
                    continue;
                }
                $seen[$key] = true;
                $pairs[] = ['productId' => $productId, 'storeId' => $storeId];
            }

            if (count($rows) < self::PAGE_LIMIT) {
                $reachedEnd = true;
                break;
            }
        }

        if (!$reachedEnd) {
            // MAX_PAGES に達しても各ページが PAGE_LIMIT 件で埋まり続けている＝未取得の在庫が残っている
            // 可能性があるため、対象の取りこぼしを黙って無視せず例外で失敗させる。
            throw new \RuntimeException(sprintf('Smaregi stock list exceeded max pages (maxPages=%d, limit=%d); not all stock data retrieved.', self::MAX_PAGES, self::PAGE_LIMIT));
        }

        return $pairs;
    }

    /**
     * 1 つの (productId, storeId) について、対象日の在庫変動履歴を取得し、未保存分を子ジョブへ enqueue する。
     *
     * @param array{targetDate:string,pairs:int,fetched:int,enqueued:int,skipped:int,failed:int} $summary
     */
    private function backfillPair(
        string $accessToken,
        string $productId,
        string $storeId,
        string $targetDate,
        array &$summary,
    ): void {
        $reachedEnd = false;
        for ($page = 1; $page <= self::MAX_PAGES; $page++) {
            $response = $this->stockApiClient->listStockChanges(
                $this->smaregiApiUrl,
                $this->smaregiApiContractId,
                $accessToken,
                $productId,
                $storeId,
                [
                    'target_date' => $targetDate,
                    'page' => (string) $page,
                    'limit' => (string) self::PAGE_LIMIT,
                ],
            );

            $statusCode = $response['statusCode'];
            if ($statusCode < 200 || $statusCode >= 300) {
                // 1 ペアの失敗で全体を止めず、件数だけ記録して次のペアへ進む。
                $summary['failed']++;
                $this->logger->warning('Failed to list Smaregi stock changes', [
                    'productId' => $productId,
                    'storeId' => $storeId,
                    'targetDate' => $targetDate,
                    'page' => $page,
                    'statusCode' => $statusCode,
                ]);

                return;
            }

            $rows = $this->extractRows($response['json']);
            foreach ($rows as $row) {
                $summary['fetched']++;
                $this->enqueueIfUnsaved($row, $productId, $storeId, $summary);
            }

            if (count($rows) < self::PAGE_LIMIT) {
                $reachedEnd = true;
                break;
            }
        }

        if (!$reachedEnd) {
            // MAX_PAGES に達しても各ページが PAGE_LIMIT 件で埋まり続けている＝未取得の在庫変動が残っている
            // 可能性があるため、当該ペアを失敗として記録する (全体は止めず次のペアへ進む)。
            $summary['failed']++;
            $this->logger->warning('Smaregi stock changes exceeded max pages; some changes may be unprocessed', [
                'productId' => $productId,
                'storeId' => $storeId,
                'targetDate' => $targetDate,
                'maxPages' => self::MAX_PAGES,
            ]);
        }
    }

    /**
     * 在庫変動履歴1件が未保存なら子ジョブを enqueue する。
     *
     * @param array<string,mixed>                                                                $row
     * @param array{targetDate:string,pairs:int,fetched:int,enqueued:int,skipped:int,failed:int} $summary
     */
