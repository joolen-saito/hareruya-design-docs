namespace Eccube\Entity;

use Doctrine\DBAL\Types\Types;
use Doctrine\ORM\Mapping as ORM;
use Eccube\Repository\DtbOrderNumberRepository;

#[ORM\Table(name: 'dtb_order_number')]
#[ORM\Entity(repositoryClass: DtbOrderNumberRepository::class)]
class DtbOrderNumber extends AbstractEntity
{
    public const NORMAL = 1;
    public const SCG = 2;
    public const OTC = 3;
    public const SEKAPPY = 4;

    public function __construct(#[ORM\JoinColumn(name: 'base_info_id', referencedColumnName: 'id')]
        #[ORM\ManyToOne(targetEntity: BaseInfo::class)]
        private ?BaseInfo $BaseInfo)
    {
        $this->value = 0;
        $this->updateDate = new \DateTime();
    }

    #[ORM\Column(name: 'id', type: Types::INTEGER, nullable: false, options: ['unsigned' => true])]
    #[ORM\Id]
    #[ORM\GeneratedValue(strategy: 'IDENTITY')]
    private int $id;

    public function getId(): int
    {
        return $this->id;
    }

    #[ORM\Column(name: 'value', type: Types::INTEGER, nullable: false, options: ['unsigned' => true, 'default' => 0, 'comment' => '店頭注文番号'])]
    private int $value;

    public function getValue(): int
    {
        return $this->value;
    }

    public function setValue(int $value): DtbOrderNumber
    {
        $this->value = $value;

        return $this;
    }

    public function getBaseInfo(): ?BaseInfo
    {
        return $this->BaseInfo;
    }

    public function setBaseInfo(?BaseInfo $BaseInfo): DtbOrderNumber
    {
        $this->BaseInfo = $BaseInfo;

        return $this;
    }

    #[ORM\Column(name: 'update_date', type: Types::DATETIMETZ_MUTABLE, nullable: false, options: ['comment' => '最終更新日時'])]
    private \DateTime $updateDate;

    public function getUpdateDate(): \DateTime
    {
        return $this->updateDate;
    }

    public function setUpdateDate(\DateTime $updateDate): DtbOrderNumber
    {
        $this->updateDate = $updateDate;

        return $this;
    }

    /**
     * 次の注文番号
     */
    public function nextValue(): DtbOrderNumber
    {
        return (clone $this)->setValue($this->value + 1);
    }
}
