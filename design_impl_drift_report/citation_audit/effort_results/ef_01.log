namespace Eccube\Service\Smaregi\Api;

use Eccube\Entity\SmaregiPlatformApiCallLog;
use GuzzleHttp\ClientInterface;
use Psr\Log\LoggerInterface;

/**
 * スマレジ POS 在庫 API。
 *
 * 店頭受取注文商品スマレジ連携バッチで「商品登録後の在庫登録(在庫数=1 固定など)」や
 * 在庫変動webhook受信時に在庫変動履歴を取得する際に使用する。
 */
class SmaregiStockApiClient
{
    public function __construct(
        private readonly ClientInterface $httpClient,
        private readonly LoggerInterface $logger,
        private readonly SmaregiPlatformApiCallRecorder $platformApiCallRecorder,
    ) {
    }

    /**
     * 指定 storeId / productId の在庫数を加算する。
     * 参考: https://developers.smaregi.dev/platform-api-reference/apis/pos/operations/poststockproductidadd/
     *
     * @return array{statusCode:int,headers:array<string,array<string>>,body:string,json:array<string,mixed>|null}
     */
    public function add(
        string $apiUrl,
        string $contractId,
        string $accessToken,
        string $storeId,
        string $productId,
        int $quantity,
    ): array {
        if ($quantity <= 0) {
            throw new \InvalidArgumentException(sprintf('Stock add quantity must be positive. given=%d', $quantity));
        }

        $url = sprintf(
            '%s/%s/pos/stock/%s/add',
            rtrim($apiUrl, '/'),
            $contractId,
            rawurlencode($productId),
        );

        $body = [
            'storeId' => $storeId,
            'stockAmount' => (string) $quantity,
        ];

        return $this->requestPost(
            SmaregiPlatformApiCallLog::OPERATION_STOCK_ADD,
            $url,
            $accessToken,
            $body,
            [
                'storeId' => $storeId,
                'productId' => $productId,
                'quantity' => $quantity,
            ],
        );
    }

    /**
     * 在庫変動履歴の取得
     * 参考: https://developers.smaregi.dev/platform-api-reference/apis/pos/operations/getstockchangesproductidstoreid/
     *
     * @return array{statusCode:int,headers:array<string,array<string>>,body:string,json:array<string,mixed>|array<int,array<string,mixed>>|null}
     */
    public function getStockChange(
        string $apiUrl,
        string $contractId,
        string $accessToken,
        string $stockChangeId,
        string $productId,
        string $storeId,
    ): array {
        $url = sprintf(
            '%s/%s/pos/stock/changes/%s/%s',
            rtrim($apiUrl, '/'),
            $contractId,
            rawurlencode($productId),
            rawurlencode($storeId),
        );

        return $this->requestGet(
            SmaregiPlatformApiCallLog::OPERATION_STOCK_CHANGE_GET,
            $url,
            $accessToken,
            [
                'id' => $stockChangeId,
            ],
            [
                'stockChangeId' => $stockChangeId,
                'productId' => $productId,
                'storeId' => $storeId,
            ],
        );
    }

    /**
     * スマレジに登録されている在庫一覧を取得
     *
     * Webhook 連携エラー再連携バッチで、在庫変動履歴を問い合わせる対象 (productId, storeId) を
     * 列挙するために使用する。ページングは呼び出し側で page / limit を渡して制御する。
     * 参考: https://developers.smaregi.dev/platform-api-reference/apis/pos/operations/getstock/
     *
     * @param array<string,string> $query page / limit 等
     *
     * @return array{statusCode:int,headers:array<string,array<string>>,body:string,json:array<string,mixed>|array<int,array<string,mixed>>|null}
     */
    public function listStocks(
        string $apiUrl,
        string $contractId,
        string $accessToken,
        array $query = [],
    ): array {
        $url = sprintf('%s/%s/pos/stock', rtrim($apiUrl, '/'), $contractId);

        return $this->requestGet(
            SmaregiPlatformApiCallLog::OPERATION_STOCK_LIST,
            $url,
            $accessToken,
            $query,
            [
                'queryKeys' => array_keys($query),
            ],
        );
    }

    /**
     * 店舗ID、商品IDに基づく在庫変動履歴一覧を取得
     *
     * Webhook 連携エラー再連携バッチで、対象日 (target_date) の在庫変動履歴を取得するために使用する。
     * ページングは呼び出し側で page / limit を渡して制御する。
     * 参考: https://developers.smaregi.dev/platform-api-reference/apis/pos/operations/getstockchangesproductidstoreid/
     *
     * @param array<string,string> $query target_date / page / limit 等
     *
     * @return array{statusCode:int,headers:array<string,array<string>>,body:string,json:array<string,mixed>|array<int,array<string,mixed>>|null}
     */
    public function listStockChanges(
        string $apiUrl,
        string $contractId,
