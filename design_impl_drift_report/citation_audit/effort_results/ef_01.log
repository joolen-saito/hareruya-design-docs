namespace Eccube\Entity;

use Doctrine\DBAL\Types\Types;
use Doctrine\ORM\Mapping as ORM;
use Eccube\Repository\DtbStockEditCsvRepository;

#[ORM\Table(name: 'dtb_stock_edit_csv')]
#[ORM\Entity(repositoryClass: DtbStockEditCsvRepository::class)]
class DtbStockEditCsv extends AbstractEntity
{
    public const CSV_DOWNLOAD_RETENTION_PERIOD = '1 year';

    #[ORM\Column(name: 'id', type: Types::INTEGER, options: ['unsigned' => true, 'comment' => '在庫編集情報CSVファイルID'])]
    #[ORM\Id]
    #[ORM\GeneratedValue(strategy: 'IDENTITY')]
    private int $id;

    public function getId(): int
    {
        return $this->id;
    }

    #[ORM\Column(name: 'file_name', type: Types::TEXT, nullable: false, options: ['comment' => 'CSVファイル名'])]
    private ?string $fileName = null;

    public function getFileName(): ?string
    {
        return $this->fileName;
    }

    public function setFileName(?string $fileName): DtbStockEditCsv
    {
        $this->fileName = $fileName;

        return $this;
    }

    #[ORM\Column(name: 's3_object_key', type: Types::TEXT, nullable: true, options: ['comment' => 'S3オブジェクトキー'])]
    private ?string $s3ObjectKey = null;

    public function getS3ObjectKey(): ?string
    {
        return $this->s3ObjectKey;
    }

    public function setS3ObjectKey(?string $s3ObjectKey): DtbStockEditCsv
    {
        $this->s3ObjectKey = $s3ObjectKey;

        return $this;
    }

    #[ORM\Column(name: 'create_date', type: Types::DATETIMETZ_MUTABLE, nullable: true, options: ['comment' => '作成日時'])]
    private ?\DateTime $createDate = null;

    public function setCreateDate(?\DateTime $createDate): DtbStockEditCsv
    {
        $this->createDate = $createDate;

        return $this;
    }

    public function getCreateDate(): ?\DateTime
    {
        return $this->createDate;
    }

    #[ORM\JoinColumn(name: 'member_id', referencedColumnName: 'id', nullable: false, options: ['comment' => '登録者ID'])]
    #[ORM\ManyToOne(targetEntity: Member::class)]
    private Member $Member;

    public function getMember(): Member
    {
        return $this->Member;
    }

    public function setMember(Member $Member): DtbStockEditCsv
    {
        $this->Member = $Member;

        return $this;
    }

    #[ORM\JoinColumn(name: 'stock_edit_id', referencedColumnName: 'id', nullable: false, options: ['comment' => '在庫編集ID'])]
    #[ORM\ManyToOne(targetEntity: DtbStockEditApproval::class)]
    private DtbStockEditApproval $StockEdit;

    public function getStockEdit(): DtbStockEditApproval
    {
        return $this->StockEdit;
    }

    public function setStockEdit(DtbStockEditApproval $StockEdit): DtbStockEditCsv
    {
        $this->StockEdit = $StockEdit;

        return $this;
    }

    /**
     * S3 保存済みかつ登録日から1年以内であればダウンロード可能。
     */
    public function isDownloadable(): bool
    {
        if ($this->s3ObjectKey === null || $this->s3ObjectKey === '') {
            return false;
        }

        if ($this->createDate === null) {
            return false;
        }

        $createDateTime = \DateTimeImmutable::createFromInterface($this->createDate);
        $downloadDeadline = $createDateTime->modify('+'.self::CSV_DOWNLOAD_RETENTION_PERIOD);
        $now = new \DateTimeImmutable('now', new \DateTimeZone('UTC'));

        return $downloadDeadline > $now;
    }
}
