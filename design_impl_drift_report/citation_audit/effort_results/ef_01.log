     WHERE pc2.product_id = p.id
       AND pc2.visible = true
       AND lang2.code = :languageCode) AS weeklySold
FROM dtb_product p
    INNER JOIN dtb_product_class pc ON p.id = pc.product_id AND pc.visible = true AND pc.price02 > 0
    LEFT JOIN dtb_product_stock pstock ON pstock.product_class_id = pc.id
