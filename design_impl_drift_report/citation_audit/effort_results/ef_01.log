            rtrim($apiUrl, '/'),
            $contractId,
            rawurlencode($productId),
            rawurlencode($storeId),
        );

        return $this->requestGet(
            SmaregiPlatformApiCallLog::OPERATION_STOCK_CHANGE_LIST,
            $url,
            $accessToken,
            $query,
            [
                'queryKeys' => array_keys($query),
            ],
        );
    }

    /**
