    /**
     * 商品IDからポップアップ用の商品情報を1件取得する
     *
     * @param string $lang
     * @param string $productId
     *
     * @return JsonResponse
     */
    #[Route(path: '/api/popup/product/{lang}/{productId}', name: 'popup_product_by_product_id', methods: ['GET'])]
    public function getPopupProductByProductId(string $lang, string $productId): JsonResponse
    {
        try {
            if (!preg_match('/^\d+$/', $productId) || (int) $productId < 1) {
                throw new NotFoundException('Not Found');
            }

            $languageCode = match (strtolower($lang)) {
                'ja' => 'JP',
                'en' => 'EN',
                default => throw new NotFoundException('Not Found'),
            };

            $result = $this->productRepository->findPopupProductByProductId((int) $productId, $languageCode, $this->getShop()->getId());
            if ($result === null) {
                throw new NotFoundException('Not Found');
            }

            $locale = $result['languageCode'] === 'EN' ? 'en' : 'ja';
            $productUrl = $this->generateUrl(
                'product_detail',
                ['id' => (int) $productId, '_locale' => $locale],
                UrlGeneratorInterface::ABSOLUTE_URL
            );

            return $this->json($this->popupResponseBuilder->build($result, $productUrl), Response::HTTP_OK);
        } catch (BaseApiException $e) {
            return $this->json([
                'code' => $e->getStatusCode(),
                'errors' => $e->getErrors(),
            ], $e->getStatusCode());
        } catch (\Throwable $e) {
            log_error('ポップアップ商品取得処理中にエラーが発生しました', [
                'lang' => $lang,
                'product_id' => $productId,
                'error' => $e->getMessage(),
            ]);

            return $this->json([
                'code' => Response::HTTP_INTERNAL_SERVER_ERROR,
                'errors' => ['Internal Server Error'],
            ], Response::HTTP_INTERNAL_SERVER_ERROR);
        }
    }

    /**
     * 更新日時が指定期間内の商品規格一覧を返却するAPIエンドポイント
     *
     * @param string $strFromDate
     * @param string $strToDate
     *
     * @return JsonResponse
     */
    #[Route(path: '/updateProducts/{strFromDate}/{strToDate}', name: 'updated_product_classes', requirements: ['strFromDate' => '[^./]+', 'strToDate' => '[^./]+'], methods: ['GET'])]
    #[Route(path: '/updateProducts/{strFromDate}/{strToDate}.json', name: 'updated_product_classes_json', requirements: ['strFromDate' => '[^./]+', 'strToDate' => '[^./]+'], methods: ['GET'])]
    public function getUpdatedProductClasses(string $strFromDate, string $strToDate): JsonResponse
    {
        $fromDate = \DateTime::createFromFormat('Y-m-d', $strFromDate);
        $fromDateErrors = \DateTime::getLastErrors();
        $toDate = \DateTime::createFromFormat('Y-m-d', $strToDate);
        $toDateErrors = \DateTime::getLastErrors();
        if ($fromDateErrors === false) {
            $fromDateErrors = ['warning_count' => 0, 'error_count' => 0];
        }
        if ($toDateErrors === false) {
            $toDateErrors = ['warning_count' => 0, 'error_count' => 0];
        }
        if (
            $fromDate === false
            || $toDate === false
            || $fromDateErrors['warning_count'] > 0
            || $fromDateErrors['error_count'] > 0
            || $toDateErrors['warning_count'] > 0
            || $toDateErrors['error_count'] > 0
        ) {
            return $this->json(['code' => Response::HTTP_NOT_FOUND, 'errors' => ['Not Found']], Response::HTTP_NOT_FOUND);
        }
        $fromDate->setTime(0, 0, 0);
        $toDate->setTime(23, 59, 59);

        try {
            $results = $this->productRepository->findProductClassesByUpdateDate($fromDate, $toDate);

            return $this->json([
                'count' => count($results),
                'result' => $results,
            ], Response::HTTP_OK);
        } catch (BaseApiException $e) {
            return $this->json([
                'code' => $e->getStatusCode(),
                'errors' => $e->getErrors(),
            ], $e->getStatusCode());
        } catch (\Throwable $e) {
            log_error('更新商品規格取得処理中にエラーが発生しました', [
                'from_date' => $strFromDate,
                'to_date' => $strToDate,
                'error' => $e->getMessage(),
            ]);

            return $this->json([
                'code' => Response::HTTP_INTERNAL_SERVER_ERROR,
                'errors' => ['Internal Server Error'],
            ], Response::HTTP_INTERNAL_SERVER_ERROR);
        }
    }

