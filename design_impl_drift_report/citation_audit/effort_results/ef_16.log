            StockTransferTypeDetail: $this->entityManager->getReference(MtbStockChangeTypeDetail::class, MtbStockChangeTypeDetail::SPLIT_OUTBOUND),
            approvalStatus: DtbStockApprovalList::APPROVAL_STATUS_UNAPPROVED,
            registeredDate: $now,
            RegisteredMember: $historyMember,
            ProductStockTotalCount: count($Destinations) + 1,
            InventoryChangeTotalCount: $destinationTotalQuantity,
            TotalCostPriceBefore: $splitTransferCost,
        );

        $this->entityManager->flush();

        return [
            'stockSplitJoinId' => $StockSplitJoin->getId(),
            'successMessage' => 'admin.stock.split.apply_approval_success',
        ];
    }

