/**
 * 在庫分割結合一覧（検索）
 *
 * handleRequest / {@see \Eccube\Util\FormUtil::submitAndGetData()} は Controller 側で実施済みであること。
 * ビューモデル構築（createView / フォーム生成）・セッション保存は Controller 側で行う。
 *
 * @return list<\Eccube\Entity\DtbStockSplitJoin>
 */
class StockSplitJoinIndexAction
{
    public const SESSION_KEY_SEARCH = 'admin.stock.split_join.search';

    public function __construct(
        private readonly DtbStockSplitJoinRepository $stockSplitJoinRepository,
    ) {
    }

    /**
     * @return list<\Eccube\Entity\DtbStockSplitJoin>
     */
    public function handle(StockSplitJoinIndexInput $input): array
    {
        $formData = $input->searchData;

        return $this->stockSplitJoinRepository->findBySearchData(
            $this->normalizeSearchData($formData, $input->rawFormPayload)
        );
    }

    /**
     * タイプ・ステータス未選択時は全件検索になるよう検索データを正規化する。
     * フォームでチェックなし送信だとキーが送られず null になる等で条件が付くのを防ぐ。
     *
     * @param array<string, mixed> $data
     * @param array<string, mixed> $rawFormPayload POST 時の admin_search_stock_split_join 生データ（POST 以外は []）
     *
     * @return array<string, mixed>
     */
    private function normalizeSearchData(array $data, array $rawFormPayload = []): array
    {
        $normalized = $data;

        $type = $data['split_join_type'] ?? null;
        if ($type === null || (is_array($type) && $type === [])) {
            $normalized['split_join_type'] = '';
        } elseif (is_array($type)) {
            $filtered = array_values(array_filter($type, fn ($v) => is_scalar($v) && $v !== ''));
            $normalized['split_join_type'] = array_map('strval', $filtered);
        } elseif (is_string($type)) {
            $normalized['split_join_type'] = $type;
        } else {
            $normalized['split_join_type'] = (string) $type;
        }

        // admin_search_stock_split_join[stock_split_join_status][] が空で送られると PHP で ['']
        // になることがあり、そのままだと 0 件になるため、実質未選択は必ず [] に正規化する。
        // 1つ以上チェック時は Entity または ID(数値) が渡るので両方通す。
        $status = $data['stock_split_join_status'] ?? null;
        if ($status === null || (is_array($status) && $status === [])) {
            $normalized['stock_split_join_status'] = [];
        } elseif (is_array($status)) {
            $filtered = array_values(array_filter($status, function ($v) {
                if ($v === null || $v === '') {
                    return false;
                }
                if (is_numeric($v)) {
                    return true;
                }
                if (is_object($v) && method_exists($v, 'getId')) {
                    return true;
                }

                return false;
            }));
            $normalized['stock_split_join_status'] = $filtered;
        } else {
            // セッション復元や送信形式の揺れで配列以外の1件だけ渡る場合がある
            $normalized['stock_split_join_status'] = ($status === '') ? [] : [$status];
        }

        // POST 時はチェックボックスの value（数値 ID）をリクエストから直接採用する。
        // EntityType の変換失敗やテンプレの value 不整合で getData() のステータスが空になると条件が付かず全件になるため。
        if ($rawFormPayload !== [] && \array_key_exists('stock_split_join_status', $rawFormPayload) && \is_array($rawFormPayload['stock_split_join_status'])) {
            $idsFromRaw = [];
            foreach ($rawFormPayload['stock_split_join_status'] as $x) {
                if ($x === null || $x === '') {
                    continue;
                }
                if (\is_numeric($x)) {
                    $idsFromRaw[] = (int) $x;
                }
            }
            $normalized['stock_split_join_status'] = array_values(array_unique($idsFromRaw));
        }

        return $normalized;
    }
}
        $this->eventDispatcher->dispatch($event, EccubeEvents::ADMIN_STOCK_HISTORY_UPDATE_COMPLETE);

        $this->addSuccess('admin.common.save_complete', 'admin');

