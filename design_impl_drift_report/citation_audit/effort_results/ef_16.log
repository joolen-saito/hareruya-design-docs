    /**
     * @param array<string, mixed> $options
     */
    #[\Override]
    public function buildForm(FormBuilderInterface $builder, array $options): void
    {
        /** @var ProductStock $ProductStock */
        $ProductStock = $options['ProductStock'];
        $BaseInfo = $ProductStock->getBaseInfo();

        $builder
            ->add('split_join_memo', TextareaType::class, [
                'label' => 'admin.stock.split_join.form.split_join_memo',
                'required' => false,
            ])
            ->add('approval_notification_department', ChoiceType::class, [
                'label' => false,
                'required' => false,
                'mapped' => false,
                'choices' => $this->getDepartmentChoices($BaseInfo),
                'placeholder' => 'common.select__unspecified',
                'translation_domain' => 'messages',
            ])
            ->add('approval_notification_target_members', ChoiceType::class, [
                'label' => false,
                'required' => $options['approval_required'],
                'multiple' => true,
                'choices' => $this->getMemberChoices($BaseInfo),
                'choice_attr' => function (string $choice, string $key, mixed $value) {
                    $Member = $this->memberRepository->find((int) $value);
                    $dept = $Member?->getDepartment()?->getName() ?? '';

                    return ['data-department' => $dept];
                },
                'placeholder' => 'admin.stock.form.approval_members_empty',
                'empty_data' => [],
                'constraints' => $options['approval_required'] ? [
                    new Assert\Count(['min' => 1, 'minMessage' => 'admin.stock.split_join.form.approval_notification_required']),
                ] : [],
            ]);
    }

