use Eccube\Entity\AbstractEntity;
use Eccube\Repository\Master\MtbStockSplitJoinStatusRepository;

#[ORM\Table(name: 'mtb_stock_split_join_status')]
#[ORM\Entity(repositoryClass: MtbStockSplitJoinStatusRepository::class)]
class MtbStockSplitJoinStatus extends AbstractEntity implements \Stringable
{
    /** 新規登録 */
    public const NEW = 1;
    /** 結合元登録 */
    public const JOIN_SOURCE_REGISTERED = 2;
    /** 分割承認待ち */
    public const SPLIT_APPROVAL_WAITING = 3;
    /** 結合承認待ち */
    public const JOIN_APPROVAL_WAITING = 4;
    /** 入庫済み */
    public const RECEIPT_COMPLETED = 5;
    /** 却下 */
    public const REJECTED = 6;

    #[ORM\Column(name: 'id', type: Types::INTEGER, options: ['unsigned' => true, 'comment' => '分割・結合ステータスID'])]
    #[ORM\Id]
    #[ORM\GeneratedValue(strategy: 'IDENTITY')]
    private int $id;

    #[ORM\Column(name: 'name', type: Types::TEXT, options: ['comment' => 'ステータス名'])]
    private string $name;

    public function getId(): int
    {
        return $this->id;
    }

    public function getName(): string
    {
        return $this->name;
    }

    public function setName(string $name): self
    {
        $this->name = $name;

        return $this;
    }

    #[\Override]
    public function __toString(): string
    {
        return $this->getName();
    }
