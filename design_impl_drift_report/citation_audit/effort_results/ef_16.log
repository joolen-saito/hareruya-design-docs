        function clearFieldValue($field) {
            if ($field.is('select')) {
                $field.val(null).trigger('change');
            } else if ($field.is(':checkbox') || $field.is(':radio')) {
                $field.prop('checked', false);
            } else {
                $field.val('');
            }
        }

        function setFieldDisabled($field, isDisabled) {
            $field.prop('disabled', isDisabled);
            if ($field.is('select') && $field.hasClass('select2-hidden-accessible')) {
                $field.trigger('change.select2');
            }
        }

        function isDisposalSearchChecked() {
            return $disposalSearchCheckbox.is(':checked');
        }

        function applyDisposalSearchMode(isChecked) {
            if (isChecked) {
                $stockChangeTypeDetail.val(disposalStockChangeTypeDetailIds).trigger('change');
                setFieldDisabled($stockChangeTypeDetail, true);

                disposalSearchClearFieldSelectors.forEach(function(selector) {
                    const $field = $(selector);
                    clearFieldValue($field);
                    setFieldDisabled($field, true);
                });
            } else {
                clearFieldValue($stockChangeTypeDetail);
                setFieldDisabled($stockChangeTypeDetail, false);

                disposalSearchClearFieldSelectors.forEach(function(selector) {
                    setFieldDisabled($(selector), false);
                });
            }
        }

        $disposalSearchCheckbox.on('change', function() {
            applyDisposalSearchMode(isDisposalSearchChecked());
        });

        $('.search-clear').on('click', function() {
            window.setTimeout(function() {
                applyDisposalSearchMode(isDisposalSearchChecked());
            }, 0);
        });

        applyDisposalSearchMode(isDisposalSearchChecked());
