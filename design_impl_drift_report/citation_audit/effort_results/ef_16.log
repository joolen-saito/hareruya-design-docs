            if ($destPs === null) {
                $errors[] = "{$lineNum}行目: 商品コード「{$code}」は同一店舗・在庫区分で見つかりません。";
                if (count($errors) >= self::MAX_ERROR_COUNT) {
                    break;
                }
                continue;
            }

            if ($destPs->getId() === $sourcePsId) {
                $productName = $destPs->getProductClass()->getProduct()?->getName() ?? '';
                $errors[] = "{$lineNum}行目: 「{$productName}」は分割元と同一の在庫のため分割先に指定できません。";
                if (count($errors) >= self::MAX_ERROR_COUNT) {
                    break;
                }
                continue;
            }

            $destinations[(int) $destPs->getId()] = ['quantity' => (int) $qtyRaw];
            ++$count;
        }

        if ($errors !== []) {
            return ['ok' => false, 'errors' => $errors];
