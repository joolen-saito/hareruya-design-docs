            }

            if ($rowIndex > self::MAX_ROWS) {
                $errors[] = '登録上限（'.self::MAX_ROWS.'件）を超えています。';
                break;
            }

            $code = trim($rowData['商品コード']);
            if ($code === '') {
                $errors[] = "{$lineNum}行目: 商品コードが空です。";
                if (count($errors) >= self::MAX_ERROR_COUNT) {
                    break;
                }
                continue;
            }

            $qtyRaw = trim($rowData['分割先在庫数']);
            if ($qtyRaw === '' || !ctype_digit($qtyRaw)) {
                $errors[] = "{$lineNum}行目: 商品コード「{$code}」の分割先在庫数が不正です。";
                if (count($errors) >= self::MAX_ERROR_COUNT) {
                    break;
