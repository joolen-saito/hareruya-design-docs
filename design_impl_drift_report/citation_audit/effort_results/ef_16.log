    public function index(Request $request): array|RedirectResponse
    {
        $session = $request->getSession();

        if ($request->query->getBoolean('clear')) {
            $session->remove(StockSplitJoinIndexAction::SESSION_KEY_SEARCH);

            return $this->redirectToRoute('admin_stock_split_join_list');
        }

        $builder = $this->formFactory->createBuilder(SearchStockSplitJoinType::class);

        $event = new EventArgs(
            [
                'builder' => $builder,
            ],
            $request
        );
        $this->eventDispatcher->dispatch($event, EccubeEvents::ADMIN_STOCK_SPLIT_JOIN_INDEX_INITIALIZE);

        $searchForm = $builder->getForm();
        $rawFormPayload = [];

        if ($request->isMethod('POST')) {
            $searchForm->handleRequest($request);
            if ($searchForm->isSubmitted() && $searchForm->isValid()) {
                $session->set(StockSplitJoinIndexAction::SESSION_KEY_SEARCH, FormUtil::getViewData($searchForm));
            }
            $rawFormPayload = $request->request->all('admin_search_stock_split_join');
        } elseif ($request->query->getBoolean('resume')) {
            $viewData = $session->get(StockSplitJoinIndexAction::SESSION_KEY_SEARCH, []);
            FormUtil::submitAndGetData($searchForm, $viewData);
        } else {
            $editableBaseInfos = $this->getEditableBaseInfos();
            $BaseInfo = $editableBaseInfos[0] ?? $this->baseInfoRepository->get();
            $splitCsvForm = $this->formFactory->createBuilder(StockSplitCsvUploadType::class, null, [
                'BaseInfo' => $BaseInfo,
                'editableBaseInfos' => $editableBaseInfos,
                'approval_notification_required' => true,
            ])->getForm();
            $joinCsvForm = $this->formFactory->createBuilder(StockJoinCsvUploadType::class, null, [
                'BaseInfo' => $BaseInfo,
                'editableBaseInfos' => $editableBaseInfos,
            ])->getForm();

            return [
                'searchForm' => $searchForm->createView(),
                'StockSplitJoins' => [],
                'stockSplitJoinSearchPerformed' => false,
                'pager' => null,
                'membersByShopJson' => $this->searchStockSplitJoinType->buildMembersByShopJson(),
                'splitCsvModal' => [
                    'form' => $splitCsvForm->createView(),
                ],
                'joinCsvModal' => [
                    'form' => $joinCsvForm->createView(),
                ],
            ];
        }

        $raw = $searchForm->getData();
        $searchData = \is_array($raw) ? $raw : [];
        $StockSplitJoins = $this->indexAction->handle(new StockSplitJoinIndexInput($searchData, $rawFormPayload));

        $editableBaseInfos = $this->getEditableBaseInfos();
        $BaseInfo = $editableBaseInfos[0] ?? $this->baseInfoRepository->get();
        $splitCsvForm = $this->formFactory->createBuilder(StockSplitCsvUploadType::class, null, [
            'BaseInfo' => $BaseInfo,
            'editableBaseInfos' => $editableBaseInfos,
        ])->getForm();
        $joinCsvForm = $this->formFactory->createBuilder(StockJoinCsvUploadType::class, null, [
            'BaseInfo' => $BaseInfo,
            'editableBaseInfos' => $editableBaseInfos,
        ])->getForm();

        return [
            'searchForm' => $searchForm->createView(),
            'StockSplitJoins' => $StockSplitJoins,
            'stockSplitJoinSearchPerformed' => true,
            'pager' => null,
            'membersByShopJson' => $this->searchStockSplitJoinType->buildMembersByShopJson(),
            'splitCsvModal' => [
                'form' => $splitCsvForm->createView(),
            ],
            'joinCsvModal' => [
                'form' => $joinCsvForm->createView(),
            ],
        ];
     * @param list<string> $headers
     */
    private function buildCsvTemplateResponse(array $headers, string $filename): StreamedResponse
    {
        $out = fopen('php://temp', 'r+');
        if ($out === false) {
            throw new \RuntimeException('Failed to open temp stream.');
        }
        fputcsv($out, $headers, ',', '"', '\\');
        rewind($out);
        $content = stream_get_contents($out);
        fclose($out);
        $response = new StreamedResponse(function () use ($content): void {
            echo "\xEF\xBB\xBF".($content !== false ? $content : '');
        });
        $response->headers->set('Content-Type', 'application/octet-stream');
        $response->headers->set('Content-Disposition', 'attachment; filename="'.$filename.'"');

        return $response;
    }

    #[Route(path: '/%eccube_admin_route%/product/stock/split-join/csv-export', name: 'admin_stock_split_join_csv_export', methods: ['GET'])]
    public function csvExport(Request $request): StreamedResponse
    {
        $viewData = $request->getSession()->get(StockSplitJoinIndexAction::SESSION_KEY_SEARCH, []);
        $searchForm = $this->formFactory->createBuilder(SearchStockSplitJoinType::class)->getForm();
        FormUtil::submitAndGetData($searchForm, $viewData);
        $raw = $searchForm->getData();
        $searchData = \is_array($raw) ? $raw : [];

        $response = $this->stockSplitJoinCsvExportService->exportBySearchData($searchData);

        $event = new EventArgs(
            [
                'response' => $response,
                'searchData' => $searchData,
            ],
            $request
        );
        $this->eventDispatcher->dispatch($event, EccubeEvents::ADMIN_STOCK_SPLIT_JOIN_CSV_EXPORT);

        return $response;
    }

