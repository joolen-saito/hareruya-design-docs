namespace Eccube\Service\Admin\Stock\Util;

use Doctrine\ORM\EntityManagerInterface;
use Eccube\Entity\DtbStockSplitJoin;
use Eccube\Entity\DtbStockSplitJoinDetail;

/**
 * POSTされた振向数量を明細に適用し、0件の明細を削除して残存明細リストを返す。
 * ヘッダーの split_join_quantity（結合先数量）はユーザー入力値を保持するため変更しない。
 */
final class StockJoinApplyPostedSourceStocks
{
    /**
     * @param list<DtbStockSplitJoinDetail> $destinations
     * @param array<int, int> $postedMap detailId → posted source_stock value
     *
     * @return list<DtbStockSplitJoinDetail>
     */
    public static function applyPostedAndRemoveZeroLines(
        DtbStockSplitJoin $StockSplitJoin,
        array $destinations,
        array $postedMap,
        EntityManagerInterface $entityManager,
    ): array {
        $finalDetails = [];
        foreach ($destinations as $Detail) {
            $detailId = $Detail->getId();
            if ($detailId === null || !\array_key_exists($detailId, $postedMap)) {
                $finalDetails[] = $Detail;
                continue;
            }
            $posted = $postedMap[$detailId];
            if ($posted <= 0) {
                $entityManager->remove($Detail);
                continue;
            }
            $Detail->setSplitJoinQuantity($posted);
            $finalDetails[] = $Detail;
        }

        return $finalDetails;
    }
}

