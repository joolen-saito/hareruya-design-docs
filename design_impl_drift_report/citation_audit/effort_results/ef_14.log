    /**
     * 列の定義を取得する。
     *
     * @return array 列の定義を CsvColumnInterface で返す。
     */
    protected function getColumns()
    {
        return [
            $this->productIdColumn,
            $this->statusIdColumn,
            $this->nameJpColumn,
            $this->nameEnColumn,
            $this->sizeColumn,
            $this->weightColumn,
            $this->descriptionJpColumn,
            $this->descriptionEnColumn,
            $this->buyDescriptionJpColumn,
            $this->buyDescriptionEnColumn,
            $this->searchWordColumn,
            $this->productDelFlgColumn,
            $this->productImageListColumn,
            $this->productCategoryIdListColumn,
            $this->sellGroupIdByNameColumn,
            $this->discountIdColumn,
            $this->buyDiscountIdColumn,
            $this->storageCodeIdColumn,
            $this->tagSalesAnalysisIdListColumn,
            $this->productTagIdListColumn,
            $this->deliveryDateIdColumn,
            $this->saleLimitColumn,
            $this->sellPriceColumn,
            $this->buyPriceColumn,
            $this->languageIdColumn,
            $this->cardDetailIdColumn,
            $this->cardNameEnColumn,
            $this->cardsetNameEnColumn,
            $this->foilFlgColumn,
            $this->promotionIdByNameJpColumn,
            $this->regionRestrictionIdColumn,
            $this->freeAreaColumn,
        ];
    }

    /**
     * 列を検証するロジックを取得する。
     *
     * @return array 列全体を検証する定義を RowValidatorInterface で返す。
     */
    protected function getRowValidators()
    {
        return [
            new PriceConsistencyRowValidator($this->sellPriceColumn, $this->buyPriceColumn),
            $this->createCardInfoExistsValidator(),
        ];
    }

    /**
     * 列の定義を初期化する。
     */
    private function initializeColumnDefinitions()
    {
        $this->productIdColumn = ColumnDefinitions::productId();
        $this->statusIdColumn = ColumnDefinitions::statusId()->setRequired(true);
        $this->nameJpColumn = ColumnDefinitions::productNameJp()->setRequired(true);
        $this->nameEnColumn = ColumnDefinitions::productNameEn()->setRequired(true);
        $this->sizeColumn = ColumnDefinitions::size()->setRequired(true);
        $this->weightColumn = ColumnDefinitions::weight()->setRequired(true);
        $this->descriptionJpColumn = ColumnDefinitions::descriptionJp();
        $this->descriptionEnColumn = ColumnDefinitions::descriptionEn();
        $this->buyDescriptionJpColumn = ColumnDefinitions::buyDescriptionJp();
        $this->buyDescriptionEnColumn = ColumnDefinitions::buyDescriptionEn();
        $this->searchWordColumn = ColumnDefinitions::searchWord();
        $this->productDelFlgColumn = ColumnDefinitions::productDelFlg();
        $this->productImageListColumn = ColumnDefinitions::productImageList();

        $validCategories = $this->categoryMap->getDescendantAndSelfCategories(
            Category::SINGLE_ID,
            Category::RESERVED_SINGLE_ID,
            Category::INFORMATION_PRODUCT_ID
        );
        $this->productCategoryIdListColumn = ColumnDefinitions::productCategoryIdList($this->categoryMap)
            ->addValidator(new ChoiceValidator(
                array_map(
                    function ($v) {
                        return strval($v);
                    },
                    $validCategories
                )
            ))
            ->setRequired(true);

        $this->sellGroupIdByNameColumn = ColumnDefinitions::sellGroupIdByName($this->app)
            ->setRequired(true);
        $this->discountIdColumn = ColumnDefinitions::discountId($this->em)->setRequired(true);
        $this->buyDiscountIdColumn = ColumnDefinitions::buyDiscountId($this->em);

