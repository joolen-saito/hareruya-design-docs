namespace Eccube\Service\Csv;

use Doctrine\ORM\EntityManagerInterface;
use Eccube\Common\EccubeConfig;
use Eccube\Entity\Master\MtbStorageCode;
use Eccube\Repository\Master\MtbStorageCodeRepository;
use Symfony\Contracts\Translation\TranslatorInterface;

/**
 * 本店ソースから移植
 */
class StorageCodeCsv extends AbstractCsvService
{
    /** @var array<int|string, true> CSV 内で使用済みの並び順 */
    private array $importedRanks = [];

    /** @var array<string, string> */
    private const DEFAULT_CSV_HEADER = ['ID' => 'ID', '名称' => '名称', '並び順' => '並び順'];

    /** @var array<string, string> */
    private const DEFAULT_REQUIRED_CSV_HEADER = ['名称' => '名称', '並び順' => '並び順'];

    /**
     * @param EntityManagerInterface $entityManager
     * @param TranslatorInterface $translator
     * @param EccubeConfig $eccubeConfig
     * @param array<string, string> $csvHeader
     * @param array<string, string> $requiredCsvHeader
     */
    public function __construct(
        EntityManagerInterface $entityManager,
        TranslatorInterface $translator,
        EccubeConfig $eccubeConfig,
        private MtbStorageCodeRepository $storageCodeRepository,
        array $csvHeader = [],
        array $requiredCsvHeader = [],
    ) {
        $csvHeader = $csvHeader !== [] ? $csvHeader : self::DEFAULT_CSV_HEADER;
        $requiredCsvHeader = $requiredCsvHeader !== [] ? $requiredCsvHeader : self::DEFAULT_REQUIRED_CSV_HEADER;
        parent::__construct($entityManager, $translator, $eccubeConfig, $csvHeader, $requiredCsvHeader);
    }

    /**
     * 略称コードの登録処理
     *
     * @param array<int, string> $headers
     * @param int $headerSize
     * @param \Iterator<array<string, string>> $data
     *
     * @throws \RuntimeException
     * @throws \Throwable
     */
    public function register(array $headers, int $headerSize, \Iterator $data): void
    {
        $requiredHeaders = $this->requiredCsvHeader;
        $this->importedRanks = [];

        $this->entityManager->getConnection()->beginTransaction();

        try {
            $i = 0;
            foreach ($data as $row) {
                $rowIndex = $i + 2;

                if (end($row) === '') {
                    array_pop($row);
                }

                $this->checkHeaderSize($headerSize, $row, $rowIndex);
                $this->checkRequiredHeaders($requiredHeaders, $row, $rowIndex);

                $rank = $row['並び順'] ?? '';
                if (isset($this->importedRanks[$rank])) {
                    $message = $this->translator->trans(
                        'admin.storagecode.duplicate_csv_rank_error',
                        ['%row%' => $rowIndex],
                        'messages'
                    );
                    throw new \RuntimeException($message);
                }

                $existingByName = $this->storageCodeRepository->findOneBy(['name' => $row['名称']]);
                $rowId = isset($row['ID']) ? (int) $row['ID'] : null;
                if ($existingByName !== null && $existingByName->getId() !== $rowId) {
                    $message = $this->translator->trans(
                        'admin.storagecode.duplicate_error',
                        ['%row%' => $rowIndex],
                        'messages'
                    );
                    throw new \RuntimeException($message);
                }

                $mtbStorageCode = null;
                if ($rowId !== null && $rowId !== 0) {
                    $mtbStorageCode = $this->storageCodeRepository->find($rowId);
                }

                if ($mtbStorageCode === null) {
                    $mtbStorageCode = new MtbStorageCode();
                }

                $mtbStorageCode
                    ->setName($row['名称'])
                    ->setRank((int) $row['並び順']);

                $this->entityManager->persist($mtbStorageCode);
                $this->importedRanks[$row['並び順']] = true;

                if ($rowIndex % 100 === 0) {
                    $this->entityManager->flush();
                    $this->clearCache();
                }
                $i++;
            }

            $this->entityManager->flush();
            $this->entityManager->getConnection()->commit();
            $this->clearCache();
        } catch (\Throwable $e) {
            if ($this->entityManager->getConnection()->isTransactionActive()) {
                $this->entityManager->getConnection()->rollBack();
            }
            throw $e;
        }
    }
}
        if (!$storageCodeCsv->checkFormValid($form)) {
            foreach ($storageCodeCsv->getErrors() as $error) {
                $this->addError($error->getMessage(), 'admin');
            }
            $storageCodeCsv->deleteTempData();

            return $this->redirectToRoute('admin_product_storage_code_csv');
        }

        $formFile = $storageCodeCsv->getFormFile($form);
        if ($formFile === null) {
            $this->addError('admin.common.csv_invalid_format', 'admin');
            $storageCodeCsv->deleteTempData();

            return $this->redirectToRoute('admin_product_storage_code_csv');
        }

        log_info('略称タグCSV登録開始');
        $data = $storageCodeCsv->getImportData($formFile);

        if ($data === false) {
            $this->addError('admin.common.csv_invalid_format', 'admin');
            $storageCodeCsv->deleteTempData();
            log_info('略称タグCSVインポートでエラーが発生しました');

            return $this->redirectToRoute('admin_product_storage_code_csv');
        }

        try {
            $headers = $this->getCsvHeader();
            $columnHeaders = array_filter($data->getColumnHeaders());
            $storageCodeCsv->checkHeaderValues(array_keys($headers), $columnHeaders, $this->getNotRequiredCsvHeader());
            $headerSize = count($columnHeaders);
            $storageCodeCsv->checkDataSize($data);
            $this->entityManager->getConnection()->getConfiguration()->setSQLLogger(null);

            $storageCodeCsv->register(array_keys($headers), $headerSize, $data);
        } catch (\Throwable $e) {
            log_info('エラーが発生しました', [$e->getMessage()]);
            $this->addError($e->getMessage(), 'admin');
            $storageCodeCsv->deleteTempData();

            return $this->redirectToRoute('admin_product_storage_code_csv');
        }

        log_info('略称タグCSV登録完了');
        $this->addSuccess('admin.register.complete', 'admin');
        $storageCodeCsv->deleteTempData();

        $event = new EventArgs(
            [
                'form' => $form,
            ],
            $request
        );
        $this->eventDispatcher->dispatch($event, EccubeEvents::ADMIN_PRODUCT_STORAGE_CODE_IMPORT_COMPLETE);

        return $this->redirectToRoute('admin_product_storage_code_csv');
    }

    /**
     * @param int $pageNo
     * @param int $pageCount
     *
     * @return \Knp\Component\Pager\Pagination\PaginationInterface<int, MtbStorageCode>
     */
    private function createStorageCodesPagination(int $pageNo, int $pageCount): \Knp\Component\Pager\Pagination\PaginationInterface
    {
        $qb = $this->storageCodeRepository->createQueryBuilder('s')->orderBy('s.rank', 'ASC');

        return $this->paginator->paginate($qb, $pageNo, $pageCount);
    }

    /**
