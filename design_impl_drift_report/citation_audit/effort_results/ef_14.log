    /**
     * 行処理時に呼ぶ。連携ONかつスマレジ商品コードが空でない場合のみバッファする。
     */
    public function deferIfEligible(int $productClassId, int $smaregiAlignmentFlg, ?string $smaregiProductCode): void
    {
        if ($smaregiAlignmentFlg !== Constant::ENABLED) {
            return;
        }
        if ($smaregiProductCode === null || trim($smaregiProductCode) === '') {
            return;
        }
        $this->deferredProductClassIds[$productClassId] = true;
    }

