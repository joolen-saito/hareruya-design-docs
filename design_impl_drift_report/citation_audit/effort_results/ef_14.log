<?php

namespace Plugin\HareruyaEc\Service\Csv\Importer\Event;

use Doctrine\DBAL\Types\Type;
use Doctrine\ORM\EntityManager;
use Doctrine\ORM\Query\ResultSetMapping;
use Eccube\Application;
use Eccube\Common\Constant;
use Plugin\HareruyaEc\Service\BranchUpdateService;
use Plugin\HareruyaEc\Service\Csv\Importer\Model\ColumnDefinitions;
use Plugin\HareruyaEc\Service\Csv\Importer\Model\CsvColumnInterface;

/**
 * 略称タグ更新CSVをインポートするもの。
 */
class StorageCodeImportHandler extends BaseCsvImportHandler
{
    /** @var Application $app */
    private $app;

    /** @var EntityManager $em */
    private $em;

    /** @var CsvColumnInterface $productIdColumn 列： 商品ID */
    private $productIdColumn;

    /** @var CsvColumnInterface $storageCodeColumn 列: 略称タグ*/
    private $storageCodeColumn;

    /** @var array $importedIds インポート済みのIdの配列 */
    private $importedIds;

    /** @var array $importedIds インポート済みの略称タグ -> IDの配列 */
    private $storageCodeIds;

    /**
     * @param Application $app
     */
    public function __construct(Application $app)
    {
        $this->app = $app;
        $this->em = $app['orm.em'];
    }

    public function onBeforeImport()
    {
        parent::onBeforeImport();

        // インポート直前までメモリを節約するため、ここで初期化する
        $this->productIdColumn = ColumnDefinitions::productId()->setRequired(true);
        $this->storageCodeColumn = ColumnDefinitions::storageCode()->setRequired(true);
        $this->importedIds = [];
        $this->storageCodeIds = [];
    }

    public function onAfterImport(AfterReadEvent $event)
    {
        parent::onAfterImport($event);

        // インポート成功の場合、支店システムと連携
        if ($event->isSuccessful()) {
            $this->em->commit(); // $this->emのトランザクションをcommitしないと支店側が最新化されない
            $branchUpdate = new BranchUpdateService($this->app);
            $branchUpdate->noticeProductUpdate(array_unique($this->importedIds));
        }
        // メモリを開放する
        $this->productIdColumn = null;
        $this->storageCodeColumn = null;
        $this->importedIds = null;
        $this->storageCodeIds = null;
    }

    /**
     * CSVデータ1行の形式をチェックする。
     *
     * @param ReadCsvRowEvent $event イベント
     */
    public function onValidateRow(ReadCsvRowEvent $event)
    {
        parent::onValidateRow($event);
        if ($event->isBreakAll() || $event->isSkipRow()) {
            // 既にエラーが発生している。何もしない
            return;
        }

        // DBへのアクセスを伴うチェックを実施する
        if (!$this->validateProductExists($event)) {
            $event->breakAll();

            return;
        }
    }

    /**
     * CSVデータ1行を取り込む。
     *
     * @param ReadCsvRowEvent $event イベント
     * @return bool 読み込みに成功した場合 true
     */
    public function onReadRow(ReadCsvRowEvent $event)
    {
        $this->updateProductSub($event);

        return true;
    }

    /**
     * 列の定義を取得する。
     *
     * @return array 列の定義を CsvColumnInterface で返す。
     */
    protected function getColumns()
    {
        return [
            $this->productIdColumn,
            $this->storageCodeColumn,
        ];
    }

    /**
     * 列を検証するロジックを取得する。
     *
     * @return array 列全体を検証する定義を RowValidatorInterface で返す。
     */
    protected function getRowValidators()
    {
        return [];
    }

    /**
     * 商品の有無をチェックし、エラーがあればメッセージを設定する。
     *
     * @param ReadCsvRowEvent $event イベント
     * @return bool 商品が存在する場合 true
     */
    private function validateProductExists(ReadCsvRowEvent $event)
    {
        $row = $event->getRow();

        // 商品がなければエラー
        $productId = $this->productIdColumn->getValue($row);
        $storageCode = $this->storageCodeColumn->getValue($row);
        if (!$this->isProductExists($productId)) {
            $event->getMessageStore()
                ->addProductNotExistsError(
                    $row->getRowNumber(),
                    $this->productIdColumn->getLabel()
                );
            $event->breakAll();

            return false;
        }
        // 略称コードを記録、なければエラー
        if (!$this->setStorageCodeId($storageCode)) {
            $event->getMessageStore()
                ->addStorageCodeNotExistsError(
                    $row->getRowNumber(),
                    $this->storageCodeColumn->getLabel()
                );
            $event->breakAll();

            return false;
        }

        return true;
    }

    /**
     * @param int $productId 商品ID
     * @return bool 商品が存在する場合 true
     */
    private function isProductExists(int $productId)
    {
        $sql = <<<EOT
            SELECT
                p.product_id
            FROM
                dtb_product p
            WHERE
                p.product_id = :productId
                AND p.del_flg = :delFlg
        EOT;

        $rsm = new ResultSetMapping();
        $rsm->addScalarResult('product_id', 'productId', Type::INTEGER);

        $query = $this->em->createNativeQuery($sql, $rsm)
            ->setParameter('productId', $productId)
            ->setParameter('delFlg', Constant::DISABLED);
        $result = $query->getOneOrNullResult();

        return !empty($result);
    }

    /**
     * @param string $storageCode 略称タグ文字列
     * @return bool 略称タグが存在する場合 true
     */
    private function setStorageCodeId(string $storageCode)
    {
        if ($this->storageCodeIds[$storageCode]) {
            return true;
        }

        $sql = <<<EOT
            SELECT
                sc.id
            FROM
                mtb_storage_code sc
            WHERE
                sc.name = :storageCode
        EOT;

        $rsm = new ResultSetMapping();
        $rsm->addScalarResult('id', 'storageCodeId', Type::INTEGER);

        $query = $this->em->createNativeQuery($sql, $rsm)
            ->setParameter('storageCode', $storageCode)
        ;
        $result = $query->getOneOrNullResult();

        if (!empty($result)) {
            $this->storageCodeIds[$storageCode] = $result['storageCodeId'];

            return true;
        }

        return false;
    }

    /**
     * (略称タグIDが含まれる)商品サブ情報を更新する。
     *
     * @param ReadCsvRowEvent $event イベント
     */
    private function updateProductSub(ReadCsvRowEvent $event)
    {
        /** @var DtbProductSubRepository $repository */
        $repository = $this->app['hareruya_ec.repository.product_sub'];
        $row = $event->getRow();
        $productId = $this->productIdColumn->getvalue($row);
        $oldProductSub = $repository->getProductSubByProductId($productId);
        $productSub = [
            'productId' => $productId,
            'cardDetailId' => $oldProductSub->getCardDetailId(),
            'nameEn' => $oldProductSub->getNameEn(),
            'descriptionDetailEn' => $oldProductSub->getDescriptionDetailEn(),
            'buyDescriptionDetail' => $oldProductSub->getBuyDescriptionDetail(),
            'buyDescriptionDetailEn' => $oldProductSub->getBuyDescriptionDetailEn(),
            'sellGroupId' => $oldProductSub->getSellGroupId(),
            'size' => $oldProductSub->getSize(),
            'weight' => $oldProductSub->getWeight(),
            'discountId' => $oldProductSub->getDiscountId(),
            'storageCodeId' => $this->storageCodeIds[$this->storageCodeColumn->getValue($row)],
            'regionRestrictionId' => $oldProductSub->getRegionRestrictionId(),
        ];

        $repository->updateProductSub($productSub);

        // インポート成功したidを記録(重複を避ける)
        $this->importedIds[] = $productId;
    }

}
1790:          <div class="table-wrap"><table><thead><tr><th>項目名</th><th>必須／任意</th><th>最大長</th><th>初期値</th><th>保存先・扱い</th></tr></thead><tbody><tr><td>商品名（日／英）</td><td>任意</td><td>フォーム上は桁制約なし（<code>messages</code> のプレースホルダのみ）</td><td>空</td><td><code>dtb_product.name</code> に対する部分一致。セッションキー <code>product_name</code>。</td></tr><tr><td>カード名（日／英）</td><td>任意</td><td>同上</td><td>空</td><td>関連カードの日本語名に対する存在サブクエリでの部分一致。キー <code>card_name</code>。</td></tr><tr><td>ID</td><td>任意</td><td>実装上は 10 桁数字のみがフィルタ対象（それ以外の入力は無視）</td><td>空</td><td>文字列として商品 ID の一部一致。キー <code>product_id</code>。</td></tr><tr><td>コード</td><td>任意</td><td>フォーム上は桁制約なし</td><td>空</td><td><code>dtb_product_class.code</code> の部分一致。キー <code>product_code</code>。</td></tr><tr><td>カテゴリ</td><td>任意</td><td>—</td><td>プレースホルダ「すべての商品」相当（未選択）</td><td>複数選択。選択済みエンティティと子孙カテゴリで IN。キー <code>category_id</code>。</td></tr><tr><td>公開状態</td><td>任意</td><td>—</td><td>公開のみ選択済み</td><td>複数チェック。廃止ステータスはクエリから除外される選択肢。キー <code>status</code>。</td></tr><tr><td>エキスパンション</td><td>任意</td><td>—</td><td>無選択</td><td>複数 SELECT。発売日降順でマスタを読む。キー <code>cardset</code>。</td></tr><tr><td>レアリティ</td><td>任意</td><td>—</td><td>無選択</td><td>複数チェック。キー <code>rarity</code>。</td></tr><tr><td>言語</td><td>任意</td><td>—</td><td>無選択</td><td>日本語／英語／その他言語のチェック。キー <code>language</code>。</td></tr><tr><td>状態</td><td>任意</td><td>—</td><td>NM のみ選択済み</td><td>NM／SP／MP／HP／その他。キー <code>card_condition</code>。</td></tr><tr><td>Foil</td><td>任意</td><td>—</td><td>無選択</td><td>非 Foil／ノーマル／特殊。キー <code>foil</code>。</td></tr><tr><td>フレーム</td><td>任意</td><td>—</td><td>無選択</td><td>通常／特殊。キー <code>frame</code>。</td></tr><tr><td>プロモ</td><td>任意</td><td>—</td><td>無選択</td><td>プロモ／ノーマルの二択チェック（既定オプション）。キー <code>promotion</code>。</td></tr><tr><td>タグ</td><td>任意</td><td>—</td><td>無選択</td><td>複数 SELECT。タグごとの EXISTS。キー <code>tag_id</code>。</td></tr><tr><td>略称タグ</td><td>任意</td><td>—</td><td>無選択</td><td>複数 SELECT。<code>dtb_product</code> の略称タグ ID。キー <code>storage_code_id</code>。</td></tr><tr><td>販売価格（開始）</td><td>任意</td><td>桁は設定 <code>eccube_price_len</code>（確認値 8）に合わせた Symfony Length</td><td>空</td><td><code>price02</code> の下限。フォームキー <code>sell_price_from</code>。</td></tr><tr><td>販売価格（終了）</td><td>任意</td><td>同上</td><td>空</td><td><code>price02</code> の上限。<code>sell_price_to</code>。</td></tr><tr><td>基準価格（開始）</td><td>任意</td><td>同上</td><td>空</td><td>フォームおよびセッションには載るが、<code>getQueryBuilderBySearchDataForAdmin</code> 本体では参照しない（確認値）。キー <code>standard_price_from</code>。</td></tr><tr><td>基準価格（終了）</td><td>任意</td><td>同上</td><td>空</td><td>同上。<code>standard_price_to</code>。</td></tr><tr><td>買取価格（開始）</td><td>任意</td><td>同上</td><td>空</td><td>同上。<code>buy_price_from</code>。</td></tr><tr><td>買取価格（終了）</td><td>任意</td><td>同上</td><td>空</td><td>同上。<code>buy_price_to</code>。</td></tr><tr><td>在庫（開始）</td><td>任意</td><td>HTML の <code>maxlength</code> は <code>eccube_int_len</code>（確認値 9）、最小 0</td><td>空</td><td><code>dtb_product_stock.stock</code> の下限。<code>stock_from</code>。</td></tr><tr><td>在庫（終了）</td><td>任意</td><td>同上</td><td>空</td><td>同上の上限。<code>stock_to</code>。</td></tr><tr><td>期間別販売数 販売期間</td><td>任意</td><td>—</td><td>未指定プレースホルダ</td><td>ラジオ。昨日〜365 日前までの列番号。<code>order_date</code>。</td></tr><tr><td>期間別販売数 販売数（開始）</td><td>任意</td><td><code>eccube_int_len</code> に合わせた maxlength</td><td>空</td><td><code>order_quantity_*</code> 下限。<code>order_quantity_from</code>。</td></tr><tr><td>期間別販売数 販売数（終了）</td><td>任意</td><td>同上</td><td>空</td><td>上限。<code>order_quantity_to</code>。</td></tr><tr><td>規格更新日（開始）</td><td>任意</td><td><code>yyyy-MM-dd</code> の単一行日付</td><td>空</td><td><code>pc.update_date</code> の下限。Symfony の下限レンジ <code>1900-01-01</code>。<code>update_date_from</code>。</td></tr><tr><td>規格更新日（終了）</td><td>任意</td><td>同上</td><td>空</td><td>終日 inclusive。終了が開始より前ならフォームエラー。<code>update_date_to</code>。</td></tr><tr><td>売上分析タグ</td><td>任意</td><td>—</td><td>無選択</td><td>複数 SELECT。中間テーブル経由で IN。<code>tag_sales_analysis</code>。</td></tr><tr><td>高額商品</td><td>任意</td><td>—</td><td>「高額商品を除外する」のみ</td><td>いずれか一方だけチェックされたときだけ high_price_code で絞る。<code>expensive</code>。</td></tr><tr><td>部門</td><td>任意</td><td>—</td><td>無選択</td><td>複数 SELECT。<code>section</code>。</td></tr><tr><td>棚番号</td><td>任意</td><td>—</td><td>無選択</td><td>複数 SELECT。<code>shelf_number</code>。</td></tr><tr><td>商品名（日／英）・カード名（日／英）・商品 ID・商品コード</td><td>任意</td><td>フォーム上は桁制約なし</td><td>空（一覧 Twig では非表示）</td><td>ID が数値のみのときは ID 完全一致、それ以外は商品名（日・英）、規格コード、カード名（日・英）への OR 部分一致。キー <code>id</code>。</td></tr><tr><td>一覧ソート列</td><td>任意</td><td>—</td><td>空</td><td>隠し入力 <code>sortkey</code>。</td></tr><tr><td>一覧ソート向き</td><td>任意</td><td>—</td><td>空</td><td>隠し入力 <code>sorttype</code>。値 <code>a</code> 以外は降順扱い。</td></tr></tbody></table></div>
1805:          <div class="table-wrap"><table><thead><tr><th>テーブル</th><th>列</th><th>メモ</th></tr></thead><tbody><tr><td>dtb_product</td><td>id, name, name_en, product_status_id, update_date, create_date, storage_code_id, card_detail_id, cardset_id</td><td>名称・状態・略称タグ・カード詳細参照（移行先は商品本体へ統合）</td></tr><tr><td>dtb_product_class</td><td>code, price02, update_date, order_quantity_*, high_price_code, language_id, card_condition_id, section_id, shelf_number_id</td><td>規格単位の条件・並び</td></tr><tr><td>dtb_product_stock</td><td>stock</td><td>在庫帯</td></tr><tr><td>mtb_card_detail（現行 dtb_card_detail）</td><td>cardset_id, rarity_id, foil_flg, frame_flg, promotion_flg</td><td>カード属性。移行先はカード詳細マスタ</td></tr><tr><td>dtb_product_category</td><td>category_id</td><td>カテゴリ</td></tr><tr><td>dtb_product_tag</td><td>tag_id（現行 tag）</td><td>タグ EXISTS</td></tr><tr><td>mtb_card（カードマスタ）</td><td>name_jp, name_en</td><td>カード名検索</td></tr></tbody></table></div>
2135:          <div class="table-wrap"><table><thead><tr><th>対象</th><th>現行（pf-eccube3）</th><th>移行先（ec-cube-enterprise）</th></tr></thead><tbody><tr><td>商品付加情報</td><td>別テーブル <code>dtb_product_sub</code>（商品名（英）・各説明（英・買取）・カード詳細参照・購入グループ・略称タグ・割引率・買取減額率・販売制限・サイズ・重量など）に分離</td><td><code>dtb_product</code> 本体へ統合。<code>name_en</code>・<code>description_detail_en</code>・<code>buy_description_detail</code>・<code>buy_description_detail_en</code>・<code>card_detail_id</code>・<code>sell_group_id</code>・<code>storage_code_id</code>・<code>discount_id</code>・<code>buy_discount_id</code>・<code>region_restriction_id</code>・<code>size</code>・<code>weight</code>・<code>cardset_id</code> を商品本体が直接保持し、<code>dtb_product_sub</code> は存在しない</td></tr><tr><td>カード詳細参照</td><td><code>dtb_card_detail</code> を参照</td><td>カード詳細マスタ <code>mtb_card_detail</code> を <code>dtb_product.card_detail_id</code> から参照</td></tr><tr><td>商品タグ</td><td><code>dtb_product_tag.tag</code>（タグ列）</td><td><code>dtb_product_tag.tag_id</code>（FK列）</td></tr><tr><td>商品カテゴリの並び順</td><td><code>dtb_product_category.rank</code> を保持</td><td><code>dtb_product_category</code> は <code>rank</code> 列を持たず、本店／支店を表す <code>base_info_id</code> を持つ。並び順列は移行先では持たない</td></tr><tr><td>商品画像の並び順</td><td><code>dtb_product_image.rank</code></td><td><code>dtb_product_image.sort_no</code></td></tr></tbody></table></div>
2139:          <div class="table-wrap"><table><thead><tr><th>用語</th><th>説明</th></tr></thead><tbody><tr><td>商品本体</td><td>商品ID・商品名・商品説明・カテゴリ・タグ・検索ワード・ステータス・ショップ用メモなど、コア商品テーブルが持つ基本データ。</td></tr><tr><td>商品付加情報</td><td>本プラグインが商品に付与する拡張データ。商品名（英）、各説明（英・買取）、カード詳細情報、購入グループ、サイズ、重量、割引率、買取減額率、販売制限、略称タグ、売上分析タグなどを持つ。現行（pf-eccube3）は別テーブル <code>dtb_product_sub</code> に対応し、移行先（ec-cube-enterprise）は <code>dtb_product</code> 本体へ統合する。</td></tr><tr><td>カード詳細情報</td><td>商品に紐づくカードの版・レアリティ等を指す参照。商品編集画面ではモーダルで指定し、隠しフィールドにIDを保持する。</td></tr><tr><td>SHOP専用備考欄</td><td>画面右下のショップ用メモ欄。フロントへ出さない管理用メモを保存する。</td></tr><tr><td>規格設定</td><td>商品規格（規格単位の価格・在庫・状態）の編集導線。本画面からは別画面へ遷移する。</td></tr></tbody></table></div>
2175:          <div class="table-wrap"><table><thead><tr><th>テーブル</th><th>列</th><th>メモ</th></tr></thead><tbody><tr><td><code>dtb_product</code></td><td><code>name</code></td><td>商品名。</td></tr><tr><td><code>dtb_product</code></td><td><code>description_detail</code></td><td>商品説明。</td></tr><tr><td><code>dtb_product</code></td><td><code>search_word</code></td><td>検索ワード。</td></tr><tr><td><code>dtb_product</code></td><td><code>free_area</code></td><td>サブ情報（フリーエリア）。</td></tr><tr><td><code>dtb_product</code></td><td><code>note</code></td><td>ショップ用メモ欄。</td></tr><tr><td><code>dtb_product</code></td><td><code>product_status_id</code></td><td>商品ステータス（公開状態）。</td></tr><tr><td><code>dtb_product</code></td><td><code>update_date</code></td><td>更新時に現在時刻へ更新する。</td></tr><tr><td><code>dtb_product</code>（現行 <code>dtb_product_sub</code>）</td><td><code>name_en</code></td><td>商品名（英）。移行先は商品本体へ統合。</td></tr><tr><td><code>dtb_product</code>（現行 <code>dtb_product_sub</code>）</td><td><code>description_detail_en</code>、<code>buy_description_detail</code>、<code>buy_description_detail_en</code></td><td>各説明（英・買取）。</td></tr><tr><td><code>dtb_product</code>（現行 <code>dtb_product_sub</code>）</td><td><code>card_detail_id</code></td><td>カード詳細情報の参照。移行先はカード詳細マスタ <code>mtb_card_detail</code> を参照。</td></tr><tr><td><code>dtb_product</code>（現行 <code>dtb_product_sub</code>）</td><td><code>sell_group_id</code>、<code>storage_code_id</code>、<code>discount_id</code>、<code>buy_discount_id</code>、<code>region_restriction_id</code></td><td>購入グループ・略称タグ・割引率・買取減額率・販売制限の参照。</td></tr><tr><td><code>dtb_product</code>（現行 <code>dtb_product_sub</code>）</td><td><code>size</code>、<code>weight</code></td><td>サイズ・重量。</td></tr><tr><td><code>dtb_product_category</code></td><td><code>product_id</code>、<code>category_id</code>、<code>base_info_id</code>（現行は並び順列 <code>rank</code> を持つ）</td><td>カテゴリ全削除・再登録の対象。移行先は <code>base_info_id</code> で本店／支店を保持し並び順列を持たない。</td></tr><tr><td><code>dtb_product_tag</code></td><td><code>product_id</code>、<code>tag_id</code>（現行 <code>tag</code>）</td><td>タグ全削除・再登録の対象。</td></tr><tr><td><code>dtb_product_image</code></td><td><code>product_id</code>、<code>file_name</code>、<code>sort_no</code>（現行 <code>rank</code>）</td><td>画像登録・削除・並び順。</td></tr></tbody></table></div>
2860:          <div class="table-wrap"><table><thead><tr><th>項目名</th><th>必須／任意</th><th>最大長</th><th>初期値</th><th>保存先・扱い</th></tr></thead><tbody><tr><td>商品ID</td><td>任意</td><td>符号なし整数（桁は共通バリデータにより上限あり）</td><td>空は新規登録</td><td><code>dtb_product.id</code>。指定時は UPDATE、未指定時は INSERT</td></tr><tr><td>言語(ID)</td><td>必須</td><td>マスタに存在する ID のみ</td><td>—</td><td>規格・画像処理・コード生成の言語軸</td></tr><tr><td>商品公開ステータス</td><td>必須</td><td>公開／非公開／廃止のいずれかの整数コード</td><td>—</td><td><code>dtb_product</code> およびスマレジ連携フラグ判定に利用</td></tr><tr><td>支店の商品公開ステータス</td><td>必須</td><td>0 または 1</td><td>—</td><td>支店公開フラグ</td></tr><tr><td>商品名(日)</td><td>必須</td><td>文字列（CSV インポータ単体では文字数上限検証なし。DB 制約は別）</td><td>—</td><td>商品名</td></tr><tr><td>商品名(英)</td><td>必須</td><td>同上</td><td>—</td><td>商品名（英）</td></tr><tr><td>サイズ</td><td>必須</td><td>符号なし整数・最大 9 桁</td><td>—</td><td>サイズ</td></tr><tr><td>重量</td><td>必須</td><td>符号なし整数・最大 9 桁（グラムの運用前提を説明列に記載）</td><td>—</td><td>重量</td></tr><tr><td>商品説明(日)</td><td>任意</td><td>文字列</td><td>空可</td><td>詳細説明</td></tr><tr><td>商品説明(英)</td><td>任意</td><td>文字列</td><td>空可</td><td>詳細説明（英）</td></tr><tr><td>買取商品説明(日)</td><td>任意</td><td>文字列</td><td>空可</td><td>買取説明</td></tr><tr><td>買取商品説明(英)</td><td>任意</td><td>文字列</td><td>空可</td><td>買取説明（英）</td></tr><tr><td>検索ワード</td><td>任意</td><td>文字列</td><td>空可</td><td>検索ワード</td></tr><tr><td>規格画像</td><td>任意</td><td>カンマ区切り複数。各要素は画像 URL 形式の検証あり</td><td>空のとき画像置換はスキップ</td><td>規格画像の差し替え</td></tr><tr><td>商品カテゴリ(ID)</td><td>必須</td><td>カンマ区切りの複数 ID。単体カード・予約シングル・インフォメーション商品の subtree に入る ID のみ許容</td><td>—</td><td>親カテゴリも含めて <code>dtb_product_category</code> を置換</td></tr><tr><td>購入グループ名称</td><td>必須</td><td>マスタ名称から ID へ変換</td><td>—</td><td>購入グループ</td></tr><tr><td>割引率(ID)</td><td>必須</td><td>割引マスタに存在する ID</td><td>—</td><td>商品に紐付け、規格生成 SQL の前提にする</td></tr><tr><td>買取減額率(ID)</td><td>任意</td><td>未入力は検証スキップ。入力時はマスタ存在必須</td><td>空可</td><td>買取減額</td></tr><tr><td>略称タグ(ID)</td><td>任意</td><td>マスタ存在検証あり</td><td>空可</td><td>略称タグ</td></tr><tr><td>売上分析タグ(ID)</td><td>任意</td><td>カンマ区切り複数・各要素はマスタ検証</td><td>空可</td><td>売上分析タグの置換</td></tr><tr><td>タグ(ID)</td><td>任意</td><td>カンマ区切り複数・各要素はマスタ検証</td><td>空可</td><td>商品タグの置換</td></tr><tr><td>発送日目安(ID)</td><td>任意</td><td>ダミー列（文字列として読むが保存処理では未使用）</td><td>空可</td><td>現状ロジックでは更新に使わない</td></tr><tr><td>販売制限数</td><td>任意</td><td>符号なし整数・最大 9 桁</td><td>空の扱いは列定義に従う</td><td>規格へ反映</td></tr><tr><td>基準価格</td><td>必須</td><td>符号なし整数・最大 9 桁</td><td>—</td><td><code>standard_price</code>。セール中でない規格の販売価格更新にも利用</td></tr><tr><td>販売価格</td><td>必須</td><td>符号なし整数・最大 9 桁</td><td>—</td><td>割引率適用後のベース。セール中規格は既存販売価格を維持し得る</td></tr><tr><td>買取価格</td><td>必須</td><td>符号なし整数・最大 9 桁</td><td>—</td><td>状態別買取計算の入力</td></tr><tr><td>カード詳細(ID)</td><td>必須</td><td>符号なし整数</td><td>—</td><td>商品へ紐付け。ネイティブ検索で一意または不存在を判定</td></tr><tr><td>地域別販売制限</td><td>任意</td><td>未入力は検証スキップ。入力時は <code>mtb_region_restriction</code> に存在する ID</td><td>空は説明どおり「両サイト」系の扱いへマッピング</td><td>地域別制限</td></tr><tr><td>フリーエリア</td><td>任意</td><td>文字列</td><td>空可</td><td>フリーエリア</td></tr></tbody></table></div>
3049:          <div class="table-wrap"><table><thead><tr><th>対象</th><th>現行（pf-eccube3）</th><th>移行先（ec-cube-enterprise）</th></tr></thead><tbody><tr><td>商品名(英)・各説明(英・買取)・略称タグ・割引率・買取減額率・販売制限・サイズ・重量・購入グループ</td><td>別テーブル <code>dtb_product_sub</code> から取得</td><td><code>dtb_product</code> 本体へ統合（<code>name_en</code>・<code>description_detail_en</code>・<code>buy_description_detail</code>・<code>buy_description_detail_en</code>・<code>storage_code_id</code>・<code>discount_id</code>・<code>buy_discount_id</code>・<code>region_restriction_id</code>・<code>size</code>・<code>weight</code>・<code>sell_group_id</code>）。<code>dtb_product_sub</code> は存在しない</td></tr><tr><td>カード詳細(ID)</td><td><code>dtb_card_detail</code> を参照</td><td>カード詳細マスタ <code>mtb_card_detail</code> を <code>dtb_product.card_detail_id</code> から参照</td></tr><tr><td>タグ(ID)</td><td><code>dtb_product_tag.tag</code></td><td><code>dtb_product_tag.tag_id</code></td></tr></tbody></table></div>
