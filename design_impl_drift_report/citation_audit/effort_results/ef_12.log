{% extends 'default_frame.twig' %}

{% set body_class = 'front_page p-hareruya-event-entry' %}
{% set eventName = Event.nameJp %}

{% block stylesheet %}
    <link rel="stylesheet" href="{{ asset('assets/hareruya/css/hareruya-event.css') }}">
{% endblock %}

{% block javascript %}
    <script src="{{ asset('assets/hareruya/js/hareruya-event.js') }}" defer{% if csp_nonce is defined %} nonce="{{ csp_nonce }}"{% endif %}></script>
{% endblock %}

{% block main %}
    <div class="p-hareruya-event-entry">
        <nav class="p-hareruya-breadcrumb" aria-label="{{ 'front.breadcrumb.aria_label'|trans }}">
            <ol class="p-hareruya-breadcrumb__list" itemscope itemtype="http://schema.org/BreadcrumbList">
                <li class="p-hareruya-breadcrumb__item" itemprop="itemListElement" itemscope itemtype="http://schema.org/ListItem">
                    <a class="p-hareruya-breadcrumb__link" href="{{ url('homepage') }}" itemprop="item" aria-label="{{ 'front.breadcrumb.home'|trans }}">
                        <i class="icon-hareruya-home c-hareruya-icon--sm" aria-hidden="true"></i>
                        <span class="u-hareruya-dsp-visually-hidden" itemprop="name">{{ 'front.breadcrumb.home'|trans }}</span>
                    </a>
                    <meta itemprop="position" content="1">
                </li>
                <li class="p-hareruya-breadcrumb__item" itemprop="itemListElement" itemscope itemtype="http://schema.org/ListItem">
                    <a class="p-hareruya-breadcrumb__link" href="{{ url('event_top') }}" itemprop="item">
                        <span itemprop="name">{{ 'front.event.breadcrumb.event_top'|trans }}</span>
                    </a>
                    <meta itemprop="position" content="2">
                </li>
                <li class="p-hareruya-breadcrumb__item p-hareruya-breadcrumb__item--current" itemprop="itemListElement" itemscope itemtype="http://schema.org/ListItem">
                    <span class="p-hareruya-breadcrumb__current" aria-current="page">
                        <span itemprop="name">{{ 'front.event.entry.breadcrumb_current'|trans }}</span>
                    </span>
                    <meta itemprop="position" content="3">
                </li>
            </ol>
        </nav>
        <div class="p-hareruya-event-entry__inner">
            <h1 class="c-hareruya-heading--lev1">{{ 'front.event.entry.title'|trans }}</h1>

            <form id="filter_form" action="{{ url('event_entry_confirm') }}" method="post">
                <input type="hidden" name="detail" value="{{ Detail.id }}">

                <div class="p-hareruya-event-entry__selected">
                    <h2 class="c-hareruya-heading--lev2">{{ 'front.event.entry.selected_event'|trans }}</h2>
                    <div class="c-hareruya-event-card c-hareruya-event-card--selected">
                        <input class="c-hareruya-event-card__checkbox" type="checkbox" id="event-{{ Detail.id }}" checked disabled>
                        <label class="c-hareruya-event-card__content c-hareruya-event-card__content--disabled" for="event-{{ Detail.id }}">
                            <span class="c-hareruya-event-card__title">{{ eventName }}</span>
                            <span class="c-hareruya-event-card__details">
                                <span class="c-hareruya-event-card__detail c-hareruya-event-card__detail--with-bottom-margin">
                                    <span class="c-hareruya-event-card__detail-label">{{ 'front.event.entry.date'|trans }}</span>
                                    <span class="c-hareruya-event-card__detail-value c-hareruya-event-card__detail-value--wrap">{{ Detail.startDate|date('Y/n/j H:i') }}</span>
                                </span>
                                <span class="c-hareruya-event-card__detail c-hareruya-event-card__detail--with-bottom-margin">
                                    <span class="c-hareruya-event-card__detail-label">{{ 'front.event.entry.entry_fee'|trans }}</span>
                                    <span class="c-hareruya-event-card__detail-value c-hareruya-event-card__detail-value--wrap">{{ 'front.event.entry.yen'|trans }}{{ Detail.entryFee|default(0)|number_format }}</span>
                                </span>
                            </span>
                        </label>
                    </div>
                </div>

                {% if others is not empty %}
                    <div class="p-hareruya-event-entry__alternative">
                        <h2 class="c-hareruya-heading--lev2">{{ 'front.event.entry.other_schedules'|trans }}</h2>
                        <div class="p-hareruya-event-entry__alternative-list">
                            {% for Other in others %}
                                <div class="c-hareruya-event-card c-hareruya-event-card--selectable">
                                    <input class="c-hareruya-event-card__checkbox" type="checkbox" id="alternative-event-{{ Other.id }}" name="details[]" value="{{ Other.id }}">
                                    <label class="c-hareruya-event-card__content c-hareruya-event-card__content--clickable" for="alternative-event-{{ Other.id }}">
                                        <span class="c-hareruya-event-card__title">{{ eventName }}</span>
                                        <span class="c-hareruya-event-card__details">
                                            <span class="c-hareruya-event-card__detail c-hareruya-event-card__detail--with-bottom-margin">
                                                <span class="c-hareruya-event-card__detail-label">{{ 'front.event.entry.date'|trans }}</span>
                                                <span class="c-hareruya-event-card__detail-value c-hareruya-event-card__detail-value--wrap">{{ Other.startDate|date('Y/n/j H:i') }}</span>
                                            </span>
                                            <span class="c-hareruya-event-card__detail c-hareruya-event-card__detail--with-bottom-margin">
                                                <span class="c-hareruya-event-card__detail-label">{{ 'front.event.entry.entry_fee'|trans }}</span>
                                                <span class="c-hareruya-event-card__detail-value c-hareruya-event-card__detail-value--wrap">{{ 'front.event.entry.yen'|trans }}{{ Other.entryFee|default(0)|number_format }}</span>
                                            </span>
                                        </span>
                                    </label>
                                </div>
                            {% endfor %}
                        </div>
                    </div>
                {% endif %}

                <div class="p-hareruya-event-entry__payment">
                    {% if hasChargeableOption %}
                    <div class="p-hareruya-event-entry__payment-header">
                        <label class="c-hareruya-heading--lev4" for="payment-method">{{ 'front.event.entry.payment_method'|trans }}</label>
                        <button class="p-hareruya-event-entry__payment-help" type="button" data-js-modal-trigger="payment-help-modal" aria-controls="payment-help-modal">
                            <span class="p-hareruya-event-entry__payment-help-text">{{ 'front.event.entry.about_payment'|trans }}<i class="icon-hareruya-help c-hareruya-icon--md"></i></span>
                        </button>
                        <div class="p-hareruya-event-entry__payment-select">
                            <select class="p-hareruya-event-entry__payment-select-field" name="payment" id="payment-method" required>
                                {% for Payment in payments %}
                                    <option value="{{ Payment.id }}"{% if loop.first %} selected{% endif %}>{{ Payment.method }}</option>
                                {% endfor %}
                            </select>
                        </div>
                    </div>
                    {% endif %}
                    <div class="p-hareruya-event-entry__payment-notice">
                        <p class="p-hareruya-event-entry__payment-notice-text">
                            {{ 'front.event.entry.cancel_notice_deadline'|trans }}<br>
                            ※<a class="c-hareruya-text--link" href="{{ url('user_data', { route: 'help_event' }) }}#block_event_cancel_policy" target="_blank">{{ 'front.event.entry.cancel_policy_link'|trans }}</a>
                        </p>
                    </div>
                    <div class="p-hareruya-event-entry__payment-confirm">
                        <input class="p-hareruya-event-entry__payment-confirm-checkbox" type="checkbox" id="payment-confirm" name="agree" value="1" data-js-payment-confirm-checkbox>
                        <label class="p-hareruya-event-entry__payment-confirm-label" for="payment-confirm">{{ 'front.event.entry.agree_label'|trans }}</label>
                    </div>
                    <div class="p-hareruya-event-entry__payment-actions">
                        <input type="hidden" name="{{ constant('Eccube\\Common\\Constant::TOKEN_NAME') }}" value="{{ csrf_token(constant('Eccube\\Common\\Constant::TOKEN_NAME')) }}">
                        <button class="c-hareruya-btn c-hareruya-btn--lg c-hareruya-btn--primary p-hareruya-event-entry__payment-submit" type="submit" data-js-payment-submit disabled>{{ 'front.event.entry.proceed_to_payment'|trans }}<i class="icon-hareruya-arrow-right c-hareruya-icon--xs"></i></button>
                        <a class="c-hareruya-btn c-hareruya-btn--lg" href="{{ url('event_detail', {detailId: Detail.id}) }}">{{ 'front.event.entry.cancel'|trans }}</a>
                    </div>
                </div>
            </form>
        </div>
    </div>
    <div class="p-hareruya-modal p-hareruya-modal--sm" id="payment-help-modal" data-js-modal aria-hidden="true" role="dialog" aria-modal="true">
        <div class="p-hareruya-modal__container">
            <button class="p-hareruya-modal__close" type="button" data-js-modal-close aria-label="{{ 'front.event.entry.close'|trans }}"><i class="icon-hareruya-plus c-hareruya-icon--xs"></i></button>
            <div class="p-hareruya-modal__wrapper">
                <div class="p-hareruya-modal__header">
                    <div class="p-hareruya-modal__title">
                        <h3 class="c-hareruya-heading--lev3">{{ 'front.event.entry.payment_info.title'|trans }}</h3>
                    </div>
                </div>
                <div class="p-hareruya-modal__body">
                    <p class="c-hareruya-text">{{ 'front.event.entry.payment_info.credit_only'|trans|raw }}</p>
                    <ul>
                        <li>・Visa</li>
                        <li>・JCB</li>
                        <li>・Mastercard</li>
                        <li>・American Express</li>
                        <li>・Diner's Club</li>
                    </ul>
                    <p class="c-hareruya-text">{{ 'front.event.entry.payment_info.statement_name'|trans }}</p>
                    <p class="c-hareruya-text u-hareruya-mt15">{{ 'front.event.entry.payment_info.notes'|trans|raw }}</p>
                </div>
            </div>
        </div>
    </div>
{% endblock %}
