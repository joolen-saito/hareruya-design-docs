namespace Eccube\EventListener;

use Eccube\Entity\Customer;
use Eccube\Request\Context;
use Symfony\Component\EventDispatcher\Attribute\AsEventListener;
use Symfony\Component\HttpFoundation\RedirectResponse;
use Symfony\Component\HttpKernel\Event\RequestEvent;
use Symfony\Component\HttpKernel\KernelEvents;
use Symfony\Component\Routing\Generator\UrlGeneratorInterface;
use Symfony\Component\Security\Core\Authentication\Token\Storage\TokenStorageInterface;

/**
 * パスワードポリシー未準拠の会員をパスワード変更画面へ誘導するリスナー.
 *
 * ログイン時に EccubeAuthenticationSuccessHandler がセッションフラグを立て、
 * フラグが残っている間は除外ルート以外へのアクセスをパスワード変更画面へリダイレクトする。
 */
#[AsEventListener(event: KernelEvents::REQUEST, method: 'onKernelRequest', priority: 6)]
class PasswordPolicyListener
{
    /** ログイン時にパスワードポリシー未準拠と判定された場合にセッションに保存するキー */
    public const string SESSION_KEY = 'eccube.customer.password_policy_non_compliant';

    /**
     * リダイレクトを行わない除外ルート.
     *
     * @var array<string>
     */
    private const array ROUTE_EXCLUDE = [
        'mypage_password_change',
        'mypage_password_change_complete',
        'mypage_login',
        'mypage_logout',
    ];

    /**
     * @param Context $requestContext
     * @param TokenStorageInterface $tokenStorage
     * @param UrlGeneratorInterface $router
     */
    public function __construct(
        private readonly Context $requestContext,
        private readonly TokenStorageInterface $tokenStorage,
        private readonly UrlGeneratorInterface $router,
    ) {
    }

    /**
     * パスワードポリシー未準拠フラグをチェックし、必要に応じてリダイレクトする.
     */
    public function onKernelRequest(RequestEvent $event): void
    {
        if (!$event->isMainRequest()) {
            return;
        }

        if ($this->requestContext->isAdmin()) {
            return;
        }

        $request = $event->getRequest();
        $route = $request->attributes->get('_route');

        if (in_array($route, self::ROUTE_EXCLUDE, true)) {
            return;
        }

        $token = $this->tokenStorage->getToken();
        if ($token === null) {
            return;
        }

        if (!$token->getUser() instanceof Customer) {
            return;
        }

        if ($request->getSession()->get(self::SESSION_KEY)) {
            $event->setResponse(new RedirectResponse($this->router->generate('mypage_password_change')));
        }
    }
}
