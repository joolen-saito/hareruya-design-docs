            $shopId,
            $request->getLocale(),
            self::SPECIAL_BANNER_LIMIT,
            [MtbBanner::SHOW_BOTH, MtbBanner::SHOW_ONLY_CAMPAIGN],
        );
        $OpenShops = $this->baseInfoRepository->getOpenShops();

        $response = $this->render('Event/index.twig', [
            'Shop' => $Shop,
            'OpenShops' => $OpenShops,
            'Banners' => $Banners,
            'SpecialBanners' => $SpecialBanners,
        ]);

        if ((string) $request->cookies->get(self::COOKIE_SHOP_KEY, '') !== (string) $shopId) {
            $response->headers->setCookie(Cookie::create(self::COOKIE_SHOP_KEY)
                ->withValue((string) $shopId)
                ->withPath('/'));
