namespace Eccube\Entity;

use Doctrine\Common\Collections\ArrayCollection;
use Doctrine\Common\Collections\Collection;
use Doctrine\DBAL\Types\Types;
use Doctrine\ORM\Mapping as ORM;
use Eccube\Repository\DtbShelfNumberRepository;

#[ORM\Table(name: 'dtb_shelf_number')]
#[ORM\HasLifecycleCallbacks]
#[ORM\Entity(repositoryClass: DtbShelfNumberRepository::class)]
class DtbShelfNumber extends AbstractEntity implements \Stringable
{
    #[ORM\Column(name: 'id', type: Types::INTEGER, options: ['unsigned' => true, 'comment' => '棚番号ID'])]
    #[ORM\Id]
    #[ORM\GeneratedValue(strategy: 'IDENTITY')]
    private ?int $id = null;

    #[ORM\Column(name: 'name', type: Types::STRING, length: 255, unique: true, options: ['comment' => '名称'])]
    private string $name;

    #[ORM\Column(name: 'sort_no', type: Types::INTEGER, options: ['unsigned' => true, 'comment' => '並び順'])]
    private int $sortNo;

    /**
     * @var Collection<int, ProductClass>
     */
    #[ORM\OneToMany(targetEntity: ProductClass::class, mappedBy: 'ShelfNumber')]
    private Collection $ProductClasses;

    public function __construct()
    {
        $this->ProductClasses = new ArrayCollection();
    }

    #[\Override]
    public function __toString(): string
    {
        return $this->name;
    }

    public function getId(): ?int
    {
        return $this->id;
    }

    public function setName(string $name): DtbShelfNumber
    {
        $this->name = $name;

        return $this;
    }

    public function getName(): string
    {
        return $this->name;
    }

    public function setSortNo(int $sortNo): DtbShelfNumber
    {
        $this->sortNo = $sortNo;

        return $this;
    }

    public function getSortNo(): int
    {
        return $this->sortNo;
    }

    /**
     * @param Collection<int, ProductClass> $ProductClasses
     */
    public function setProductClasses(Collection $ProductClasses): DtbShelfNumber
    {
        $this->ProductClasses = $ProductClasses;

        return $this;
    }

    /**
     * @return Collection<int, ProductClass>
     */
    public function getProductClasses(): Collection
    {
        return $this->ProductClasses;
    }
}

