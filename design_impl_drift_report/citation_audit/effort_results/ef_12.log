    }

    /**
     * @param array<string, mixed> $options
     */
    #[\Override]
    public function buildForm(FormBuilderInterface $builder, array $options): void
    {
        /** @var list<?MtbBanner> $bannerSettingSlots */
        $bannerSettingSlots = $options['banner_setting_slots'];
        $slotCount = count($bannerSettingSlots);

        /** @var BaseInfo[] $baseInfos */
        $baseInfos = $options['base_infos'];

        $Languages = $this->languageRepository->findBy([
            'id' => MtbLanguage::CONSTANT_LANG_IDS,
        ], ['id' => 'ASC']);

        $languageChoices = [];
        foreach ($Languages as $Language) {
            $languageChoices[$Language->getNameJp()] = $Language->getId();
        }

        for ($slot = 1; $slot <= $slotCount; ++$slot) {
            $Banner = $bannerSettingSlots[$slot - 1] ?? null;
            $image = 'image_url_'.$slot;
            $link = 'link_'.$slot;
            $dispType = 'disp_type_'.$slot;
            $imageAlt = 'image_alt_'.$slot;
            $language = 'language_'.$slot;
            $sortNo = 'sort_no_'.$slot;
            $baseInfo = 'base_info_'.$slot;

            $builder
                ->add($image, TextType::class, [
                    'required' => false,
                    'label' => 'admin.event.banner.image_url',
                    'data' => $Banner instanceof MtbBanner ? $Banner->getImageUrl() : '',
                    'constraints' => [
                        new Length(['max' => $this->eccubeConfig['eccube_stext_len']]),
                        new Regex([
                            'pattern' => '/admin\.hareruyamtg\.com/',
                            'match' => false,
                            'message' => 'admin.data.top_banner.image_url__regex_error',
                        ]),
                        new Regex([
                            'pattern' => '/\A[a-zA-Z0-9\-._~:\/\?#\[\]@!$&\'()*+,;=%]*\z/',
                            'message' => 'admin.data.top_banner.link_url__regex_error',
                        ]),
                    ],
                ])
                ->add($link, TextType::class, [
                    'required' => false,
                    'label' => 'admin.event.banner.link_url',
                    'data' => $Banner instanceof MtbBanner ? $Banner->getLink() : '',
                    'constraints' => [
                        new Length(['max' => $this->eccubeConfig['eccube_stext_len']]),
                        new Regex([
                            'pattern' => '/\A[a-zA-Z0-9\-._~:\/\?#\[\]@!$&\'()*+,;=%]*\z/',
                            'message' => 'admin.data.top_banner.link_url__regex_error',
                        ]),
                    ],
                ])
                ->add($dispType, ChoiceType::class, [
                    'required' => true,
                    'label' => 'admin.event.banner.display_type',
                    'choices' => array_flip(MtbBanner::DISP_TYPES),
                    'data' => $Banner instanceof MtbBanner ? $Banner->getDispType() : MtbBanner::HIDE_BOTH,
                    'placeholder' => false,
                ])
                ->add($imageAlt, TextType::class, [
                    'required' => false,
                    'label' => 'admin.event.banner.image_alt',
                    'data' => $Banner instanceof MtbBanner ? ($Banner->getImageAlt() ?? '') : '',
                ])
                ->add($language, ChoiceType::class, [
                    'label_attr' => [
                        'class' => 'checkbox-inline',
                    ],
                    'required' => false,
                    'label' => 'admin.event.banner.language',
                    'multiple' => true,
                    'expanded' => true,
                    'choices' => $languageChoices,
                    'data' => $Banner instanceof MtbBanner ? $Banner->getLanguages()->map(
                        static fn (MtbLanguage $Language): int => $Language->getId()
                    )->toArray() : [],
                ])
                ->add($baseInfo, EntityType::class, [
                    'class' => BaseInfo::class,
                    'choices' => $baseInfos,
                    'choice_label' => self::formatBaseInfoChoiceLabel(...),
                    'required' => false,
                    'label' => 'admin.event.banner.display_shops',
                    'multiple' => true,
                    'expanded' => false,
                    'data' => $Banner instanceof MtbBanner ? $Banner->getBaseInfos()->toArray() : [],
                    'attr' => [
                        'class' => 'js-event-banner-setting-shops',
                    ],
                ])
                ->add($sortNo, IntegerType::class, [
                    'required' => true,
                    'label' => 'admin.event.banner.sort_no',
                    'data' => $slot,
                ]);
        }

        $builder->addEventListener(
            FormEvents::POST_SUBMIT,
            fn (FormEvent $e) => $this->validateSortNumbers($e, $slotCount)
        );
    }

