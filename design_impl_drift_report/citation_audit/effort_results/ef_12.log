{% extends 'default_frame.twig' %}

{% set body_class = 'event_detail_page' %}
{% set locale = app.request.locale %}
{% set isEn = locale == 'en' %}
{% set Shop = Event.BaseInfo %}
{% set Rel = Event.Rel %}
{% set eventName = isEn and Event.nameEn ? Event.nameEn : Event.nameJp %}
{% set bannerUrl = isEn and Event.bannerEnUrl ? Event.bannerEnUrl : Event.bannerUrl %}
{% set shopName = Shop ? (isEn and Shop.shopNameEng ? Shop.shopNameEng : Shop.shopName) : '' %}
{% set prize = isEn and Detail.prizeEn ? Detail.prizeEn : Detail.prizeJp %}
{% set _event_shop_str = shopName ? '（' ~ shopName ~ '）' : '' %}
{% set subtitle = 'front.seo.event_detail.subtitle'|trans({'%name%': eventName, '%shop%': _event_shop_str, '%date%': Detail.startDate|date('Y/n/j H:i')}) %}

{% block stylesheet %}
    <link rel="stylesheet" href="{{ asset('assets/hareruya/css/hareruya-event.css') }}">
{% endblock %}

{% block main %}
    <div class="p-hareruya-event-detail">
        <nav class="p-hareruya-breadcrumb" aria-label="{{ 'front.breadcrumb.aria_label'|trans }}">
            <ol class="p-hareruya-breadcrumb__list" itemscope itemtype="http://schema.org/BreadcrumbList">
                <li class="p-hareruya-breadcrumb__item" itemprop="itemListElement" itemscope itemtype="http://schema.org/ListItem">
                    <a class="p-hareruya-breadcrumb__link" href="{{ url('homepage') }}" itemprop="item" aria-label="{{ 'front.breadcrumb.home'|trans }}">
                        <i class="icon-hareruya-home c-hareruya-icon--sm" aria-hidden="true"></i>
                        <span class="u-hareruya-dsp-visually-hidden" itemprop="name">{{ 'front.breadcrumb.home'|trans }}</span>
                    </a>
                    <meta itemprop="position" content="1">
                </li>
                <li class="p-hareruya-breadcrumb__item" itemprop="itemListElement" itemscope itemtype="http://schema.org/ListItem">
                    <a class="p-hareruya-breadcrumb__link" href="{{ url('event_top') }}" itemprop="item">
                        <span itemprop="name">{{ 'front.event.breadcrumb.event_top'|trans }}</span>
                    </a>
                    <meta itemprop="position" content="2">
                </li>
                {% set breadcrumbPos = 2 %}
                {% if shopName %}
                    {% set breadcrumbPos = breadcrumbPos + 1 %}
                    <li class="p-hareruya-breadcrumb__item" itemprop="itemListElement" itemscope itemtype="http://schema.org/ListItem">
                        <a class="p-hareruya-breadcrumb__link" href="{{ url('event_search') }}" itemprop="item">
                            <span itemprop="name">{{ shopName }}</span>
                        </a>
                        <meta itemprop="position" content="{{ breadcrumbPos }}">
                    </li>
                {% endif %}
                {% set firstFormat = Event.Formats|first %}
                {% if firstFormat %}
                    {% set breadcrumbPos = breadcrumbPos + 1 %}
                    <li class="p-hareruya-breadcrumb__item" itemprop="itemListElement" itemscope itemtype="http://schema.org/ListItem">
                        <a class="p-hareruya-breadcrumb__link" href="{{ url('event_search') }}" itemprop="item">
                            <span itemprop="name">{{ isEn and firstFormat.nameEn ? firstFormat.nameEn : firstFormat.nameJp }}</span>
                        </a>
                        <meta itemprop="position" content="{{ breadcrumbPos }}">
                    </li>
                {% endif %}
                {% set breadcrumbPos = breadcrumbPos + 1 %}
                <li class="p-hareruya-breadcrumb__item p-hareruya-breadcrumb__item--current" itemprop="itemListElement" itemscope itemtype="http://schema.org/ListItem">
                    <span class="p-hareruya-breadcrumb__current" aria-current="page">
                        <span itemprop="name">{{ eventName }}</span>
                    </span>
                    <meta itemprop="position" content="{{ breadcrumbPos }}">
                </li>
            </ol>
        </nav>
        <div class="p-hareruya-event-detail__inner">
            {% if bannerUrl %}
                <div class="p-hareruya-event-detail__mv">
                    <picture class="p-hareruya-event-detail__mv-img">
                        <img src="{{ bannerUrl }}" alt="{{ eventName }}" width="500" height="360" decoding="async">
                    </picture>
                </div>
            {% endif %}
            <h1 class="c-hareruya-heading--lev1">{{ eventName }}</h1>
            {% if Rel %}
                <div class="p-hareruya-event-detail__tags">
                    <div class="p-hareruya-event-detail__tag">
                        <i class="icon-hareruya-player c-hareruya-icon--sm" aria-hidden="true"></i>
                        <span class="p-hareruya-event-detail__tag-text">{{ isEn and Rel.nameEn ? Rel.nameEn : Rel.nameJp }}</span>
                    </div>
                </div>
            {% endif %}
            <dl class="p-hareruya-event-detail__info">
                {% if shopName %}
                    <div class="p-hareruya-event-detail__info-row">
                        <dt class="p-hareruya-event-detail__info-label">{{ 'front.event.detail.info.shop'|trans }}</dt>
                        <dd class="p-hareruya-event-detail__info-value">{{ shopName }}</dd>
                    </div>
                {% endif %}
                <div class="p-hareruya-event-detail__info-row">
                    <dt class="p-hareruya-event-detail__info-label">{{ 'front.event.detail.info.start_date'|trans }}</dt>
                    <dd class="p-hareruya-event-detail__info-value">
                        <time datetime="{{ Detail.startDate|date('Y-m-d\\TH:i') }}">{{ Detail.startDate|date('Y/n/j H:i') }}</time>
                    </dd>
                </div>
                {% if Detail.entryStartDate and Detail.entryEndDate %}
                    <div class="p-hareruya-event-detail__info-row">
                        <dt class="p-hareruya-event-detail__info-label">{{ 'front.event.detail.info.entry_period'|trans }}</dt>
                        <dd class="p-hareruya-event-detail__info-value">
                            <time datetime="{{ Detail.entryStartDate|date('Y-m-d\\TH:i') }}">{{ Detail.entryStartDate|date('Y/n/j H:i') }}</time>
                            &nbsp;～&nbsp;
                            <time datetime="{{ Detail.entryEndDate|date('Y-m-d\\TH:i') }}">{{ Detail.entryEndDate|date('Y/n/j H:i') }}</time>
                        </dd>
                    </div>
                {% endif %}
                {% if Event.Formats|length > 0 %}
                    <div class="p-hareruya-event-detail__info-row">
                        <dt class="p-hareruya-event-detail__info-label">{{ 'front.event.detail.info.format'|trans }}</dt>
                        <dd class="p-hareruya-event-detail__info-value">
                            {%- for Format in Event.Formats -%}
                                {{- loop.first ? '' : ' / ' -}}{{- isEn and Format.nameEn ? Format.nameEn : Format.nameJp -}}
                            {%- endfor -%}
                        </dd>
                    </div>
                {% endif %}
                <div class="p-hareruya-event-detail__info-row">
{#
This file is part of EC-CUBE

Copyright(c) EC-CUBE CO.,LTD. All Rights Reserved.

http://www.ec-cube.co.jp/

For the full copyright and license information, please view the LICENSE
file that was distributed with this source code.
#}
{% set startDateUtc = Detail.startDate|date('Ymd\\THis\\Z', 'UTC') %}
{% set endDateUtc = Detail.startDate|date('Ymd', 'Asia/Tokyo') ~ 'T145900Z' %}
{% set shareUrl = url('event_detail', {'detailId': Detail.id}) %}
{% set shareTitle = eventName %}
{% set shareDateLabel = Detail.startDate|date('Y/n/j') %}
{% set xShareText = shareTitle ~ ' / ' ~ (shopName ? shopName ~ ' / ' : '') ~ shareDateLabel %}
{% set googleCalDetails = 'front.event.detail.share.google_calendar_details'|trans({'%url%': shareUrl}) %}
{% set googleCalUrl = 'https://calendar.google.com/calendar/render?action=TEMPLATE'
    ~ '&text=' ~ shareTitle|url_encode
    ~ '&dates=' ~ startDateUtc ~ '/' ~ endDateUtc
    ~ '&location=' ~ shopName|url_encode
    ~ '&details=' ~ googleCalDetails|url_encode %}
{% set xIntentUrl = 'https://twitter.com/intent/post?text=' ~ xShareText|url_encode ~ '&url=' ~ shareUrl|url_encode %}
{% set lineShareText = xShareText ~ ' ' ~ shareUrl %}
{% set lineShareUrl = 'https://line.me/R/msg/text/' ~ lineShareText|url_encode %}
<div class="p-hareruya-event-detail__actions">
    <div class="p-hareruya-event-detail__actions-buttons">
        {% if buttonState.canApply %}
            <a class="c-hareruya-btn c-hareruya-btn--lg c-hareruya-btn--primary c-hareruya-btn--full" href="{{ url('event_entry', {detailId: Detail.id}) }}">
                {{ 'front.event.detail.actions.apply'|trans }}<i class="icon-hareruya-arrow-right c-hareruya-icon--xs"></i>
            </a>
        {% elseif buttonState.canCancel %}
            <a class="c-hareruya-btn c-hareruya-btn--lg c-hareruya-btn--cancel c-hareruya-btn--full" href="{{ url('contact', {eventDetailId: Detail.id}) }}">
                {{ 'front.event.detail.actions.cancel'|trans }}<i class="icon-hareruya-arrow-right c-hareruya-icon--xs"></i>
            </a>
        {% endif %}
        {% if buttonState.canDeckRegist %}
            <a class="c-hareruya-btn c-hareruya-btn--lg c-hareruya-btn--link c-hareruya-btn--full" href="{{ url('mypage_deckentry_edit', {eventDetailId: Detail.id}) }}">
                {{ 'front.event.detail.actions.deck_regist'|trans }}<i class="icon-hareruya-arrow-right c-hareruya-icon--xs"></i>
            </a>
        {% endif %}
        <a class="c-hareruya-btn c-hareruya-btn--lg c-hareruya-btn--full p-hareruya-event-detail__calendar-btn" href="{{ googleCalUrl }}" target="_blank" rel="noopener noreferrer">
            <img class="p-hareruya-event-detail__calendar-icon" src="{{ asset('assets/hareruya/img/share/icon-google-calendar.webp') }}" alt="" width="24" height="24" loading="lazy">
            <span>{{ 'front.event.detail.actions.google_calendar'|trans }}</span>
        </a>
        <div class="p-hareruya-event-detail__share">
            <p class="p-hareruya-event-detail__share-label">{{ 'front.event.detail.actions.share_label'|trans }}</p>
            <div class="p-hareruya-event-detail__share-buttons">
                <a class="p-hareruya-event-detail__share-btn p-hareruya-event-detail__share-btn--x" href="{{ xIntentUrl }}" target="_blank" rel="noopener noreferrer" aria-label="{{ 'front.event.detail.actions.x_share_aria_label'|trans }}">
                    <img src="{{ asset('assets/hareruya/img/share/icon-x.webp') }}" alt="X" width="24" height="24" loading="lazy" decoding="async">
                </a>
                <a class="p-hareruya-event-detail__share-btn p-hareruya-event-detail__share-btn--line" href="{{ lineShareUrl }}" target="_blank" rel="noopener noreferrer" aria-label="{{ 'front.event.detail.actions.line_share_aria_label'|trans }}">
                    <img src="{{ asset('assets/hareruya/img/share/icon-line.webp') }}" alt="LINE" width="24" height="24" loading="lazy" decoding="async">
                </a>
                <button class="p-hareruya-event-detail__share-btn p-hareruya-event-detail__share-btn--other" type="button" aria-label="{{ 'front.event.detail.actions.link_share_aria_label'|trans }}" data-js-share-button data-share-url="{{ shareUrl }}" data-share-title="{{ shareTitle }}" data-share-text="{{ xShareText }}">
                    <img src="{{ asset('assets/hareruya/img/share/icon-share.webp') }}" alt="" width="24" height="24" loading="lazy" decoding="async">
                </button>
            </div>
        </div>
        <a class="c-hareruya-btn c-hareruya-btn--lg c-hareruya-btn--full" href="{{ url('event_top') }}">{{ 'front.event.detail.actions.back'|trans }}</a>
    </div>
</div>

