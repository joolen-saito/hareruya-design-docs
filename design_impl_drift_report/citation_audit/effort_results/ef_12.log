                ->setParameter('stock_location_id', (int) $searchData['stock_location_id']);
        }

        // stock_to （dtb_product_stock.stock）
        if (isset($searchData['stock_to']) && StringUtil::isNotBlank($searchData['stock_to'])) {
            $qb
                ->andWhere('ps.stock <= :stock_to')
