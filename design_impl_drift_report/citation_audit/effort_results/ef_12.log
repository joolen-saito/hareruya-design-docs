    /**
     * 買取サイトマップ用に最終更新日時が最も新しい商品を1件取得する。
     */
    public function getLatestProductForPurchaseSitemap(): ?Product
    {
        return $this->createPurchaseSitemapQueryBuilder()
            ->select('p')
            ->setMaxResults(1)
            ->getQuery()
            ->getOneOrNullResult();
    }

    /**
     * 買取サイトマップ用の QueryBuilder を返す。
     */
    public function getPurchaseSitemapQueryBuilder(): QueryBuilder
    {
        return $this->createPurchaseSitemapQueryBuilder();
    }

    /**
     * 買取サイトマップ用の基本 QueryBuilder を生成する。
     * フロント買取ページに表示可能な商品を更新日時降順で返す。
     */
    private function createPurchaseSitemapQueryBuilder(): QueryBuilder
    {
        return $this->createQueryBuilder('p')
            ->innerJoin('p.ProductClasses', 'pc')
            ->andWhere('IDENTITY(p.Status) = :statusId')
            ->andWhere('IDENTITY(pc.CardCondition) = :cardConditionId')
            ->andWhere('pc.high_price_code IS NULL')
            ->andWhere('pc.buy_price > 0')
            ->andWhere('pc.visible = true')
            ->setParameter('statusId', ProductStatus::DISPLAY_SHOW)
            ->setParameter('cardConditionId', MtbCardCondition::NM)
            ->groupBy('p.id')
            ->orderBy('p.update_date', 'DESC')
            ->addOrderBy('p.id', 'DESC');
    }

