        if (isset($searchData['storage_code_id']) && $this->isAdminSearchFieldActive($searchData['storage_code_id'])) {
            $qb
                ->andWhere($qb->expr()->in('p.StorageCode', ':storage_code_id'))
                ->setParameter('storage_code_id', $searchData['storage_code_id']);
        }

        // sell_price_from 販売価格
        if (isset($searchData['sell_price_from']) && StringUtil::isNotBlank($searchData['sell_price_from'])) {
            $qb
                ->andWhere('pc.price02 >= :sell_price_from')
                ->setParameter('sell_price_from', $searchData['sell_price_from']);
        }

        // sell_price_to 販売価格
        if (isset($searchData['sell_price_to']) && StringUtil::isNotBlank($searchData['sell_price_to'])) {
            $qb
                ->andWhere('pc.price02 <= :sell_price_to')
                ->setParameter('sell_price_to', $searchData['sell_price_to']);
        }

