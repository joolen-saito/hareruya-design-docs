    #[\Override]
    public function findAll(): array
    {
        $query = $this->createQueryBuilder('b')
            ->select(['b', 's'])
            ->leftJoin('b.BaseInfos', 's')
            ->getQuery();

        return $query->execute();
    }

    /**
     * 条件に一致する画像URLが空文字でないレコードをすべて返す
     *
     * @param array<int, mixed> $dispTypes
     */
    public function findWhereUrlIsNotEmpty(int $baseInfoId, string $locale, int $limit, array $dispTypes = []): mixed
    {
        // localeとlocaleIdの対応づけ処理
        $localeId = $locale === 'en' ? MtbLanguage::EN_ID : MtbLanguage::JP_ID;

        $qb = $this->createQueryBuilder('b');
        $query = $qb->join('b.BaseInfos', 's')
            ->join('b.Languages', 'l')
            ->where($qb->expr()->eq('s.id', ':baseInfoId'))
            ->andWhere($qb->expr()->eq('l.id', ':localeId'))
            ->andWhere($qb->expr()->in('b.dispType', ':dispTypes'))
            ->andWhere("b.imageUrl <> ''")
            ->setParameter('baseInfoId', $baseInfoId)
            ->setParameter('localeId', $localeId)
            ->setParameter('dispTypes', $dispTypes)
            ->setMaxResults($limit)
            ->getQuery();

        return $query->execute();
    }
}

