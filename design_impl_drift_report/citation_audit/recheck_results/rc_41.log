     */
    public function getList(): ?array
    {
        $qb = $this->createQueryBuilder('t')
            ->orderBy('t.apply_date', 'DESC')
            ->where('t.Product IS NULL AND t.ProductClass IS NULL');

        return $qb
            ->getQuery()
            ->getResult();
    }

