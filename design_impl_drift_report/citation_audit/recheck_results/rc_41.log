    /**
     * 対応する本文を取得
     *
     * @param String $view
     * @param array $params
     * @return String
     */
    public function getBody($view, $params)
    {
        $twig = $this->app['twig'];

        // twigファイルのソースコードを読み込み, 文字列化.
        $source = $twig->getLoader()->getSource($view);

        // イベントの実行.
        // プラグインにはテンプレートファイル名、文字列化されたtwigファイル、パラメータを渡す
        $event = new \Eccube\Event\TemplateEvent($view, $source, [], null);
        $this->app['eccube.event.dispatcher']->dispatch($event->getView(), $event);
        $template = $twig->createTemplate($event->getSource());
        $content = $template->render($params);

        return $content;
    }

    public function replaceBody($body, $mail, $formName = 'mail', $isForm = true)
    {
        list($orderContent, $orderEnContent) = $this->getOrderContentText();
        $body = str_replace(
            [
                "{{ include('Mail/order_content.twig', {'data': data}) }}",
                "{{ include('Mail/order_content.en.twig', {'data': data}) }}",
            ],
            [
                $orderContent,
                $orderEnContent,
            ],
            $body
        );

        $body = preg_replace(['/\n/', '/\{#.*?#\}/'], ['<br>', ''], $body);
        // isFormがtrueの場合はtextareaで入力可能にし、falseの場合はhtmlに変換(defaultはtrue)
        if ($isForm) {
            $headerForm = <<< HF
<div class="form-group">
    <div class="col-sm-12">
        <textarea id="mail_header" name="{$formName}[header]" class="form-control">{$mail->getHeader()}</textarea>
    </div>
</div>
HF;

            $footerForm = <<< FF
<div class="form-group">
    <div class="col-sm-12">
        <textarea id="mail_footer" name="{$formName}[footer]" class="form-control">{$mail->getFooter()}</textarea>
    </div>
</div>
FF;
        } else {
            $headerForm = <<< HF
<div class="form-group">
    <div class="col-sm-12">
        {$mail->getHeader()}
    </div>
</div>
HF;

            $footerForm = <<< FF
<div class="form-group">
    <div class="col-sm-12">
        {$mail->getFooter()}
    </div>
</div>
FF;
            $headerForm = preg_replace(['/\n/', '/\{#.*?#\}/'], ['<br>', ''], $headerForm);
            $footerForm = preg_replace(['/\n/', '/\{#.*?#\}/'], ['<br>', ''], $footerForm);
        }

        return str_replace(
            [
                '{{ header }}',
                '{{ footer }}',
            ],
            [
                $headerForm,
                $footerForm,
            ],
            $body
        );
    }

