              <thead>
                <tr><th><span class="src-cell" data-excel-book="0209" data-excel-sheet="メール設定" data-excel-ref="0209:メール設定!B56">識別ID</span></th><th><span class="src-cell" data-excel-book="0209" data-excel-sheet="メール設定" data-excel-ref="0209:メール設定!E56">ラベル</span></th><th><span class="src-cell" data-excel-book="0209" data-excel-sheet="メール設定" data-excel-ref="0209:メール設定!M56">書式・制限</span></th><th><span class="src-cell" data-excel-book="0209" data-excel-sheet="メール設定" data-excel-ref="0209:メール設定!T56">必須</span></th><th><span class="src-cell" data-excel-book="0209" data-excel-sheet="メール設定" data-excel-ref="0209:メール設定!V56">最大値</span></th><th><span class="src-cell" data-excel-book="0209" data-excel-sheet="メール設定" data-excel-ref="0209:メール設定!Z56">初期値</span></th><th><span class="src-cell" data-excel-book="0209" data-excel-sheet="メール設定" data-excel-ref="0209:メール設定!AG56">画面部品の説明</span></th></tr>
              </thead>
