namespace Eccube\Form\Type\Admin;

use Doctrine\ORM\EntityRepository;
use Eccube\Common\EccubeConfig;
use Eccube\Entity\MailTemplate;
use Eccube\Form\Type\Master\MailTemplateType;
use Eccube\Form\Validator\TwigLint;
use Eccube\Repository\BaseInfoRepository;
use Eccube\Repository\MailTemplateRepository;
use Symfony\Component\Form\AbstractType;
use Symfony\Component\Form\Extension\Core\Type\TextareaType;
use Symfony\Component\Form\Extension\Core\Type\TextType;
use Symfony\Component\Form\FormBuilderInterface;
use Symfony\Component\Form\FormError;
use Symfony\Component\Form\FormEvent;
use Symfony\Component\Form\FormEvents;
use Symfony\Component\OptionsResolver\OptionsResolver;
use Symfony\Component\Validator\Constraints as Assert;
use Symfony\Component\Validator\Context\ExecutionContextInterface;

class MailType extends AbstractType
{
    public function __construct(private readonly MailTemplateRepository $mailTemplateRepository, private EccubeConfig $eccubeConfig, private readonly BaseInfoRepository $baseInfoRepository)
    {
    }

    /**
     * {@inheritdoc}
     *
     * @param array<string, mixed> $options
     */
    #[\Override]
    public function buildForm(FormBuilderInterface $builder, array $options): void
    {
        $builder
            ->add('template', MailTemplateType::class, [
                'required' => false,
                'mapped' => false,
                'query_builder' => fn (EntityRepository $er) => $er->createQueryBuilder('mt')
                    ->where('mt.baseInfo = :baseInfo')
                    ->andWhere('mt.isAutoSend = false')
                    ->setParameter('baseInfo', $options['baseInfo'])
                    ->orderBy('mt.id', 'ASC'),
            ])
            ->add('name', TextType::class, [
                'constraints' => [
                    new Assert\NotBlank(),
                    new Assert\Length(['max' => $this->eccubeConfig['eccube_stext_len']]),
                ],
            ])
            ->add('mail_subject', TextType::class, [
                'required' => true,
                'constraints' => [
                    new Assert\NotBlank(),
                    new Assert\Length(['max' => $this->eccubeConfig['eccube_stext_len']]),
                ],
            ])
            ->add('tpl_data', TextareaType::class, [
                'label' => false,
                'mapped' => false,
                'required' => false,
                'constraints' => [
                    new TwigLint(),
                ],
            ])
            ->add('html_tpl_data', TextareaType::class, [
                'label' => false,
                'mapped' => false,
                'required' => false,
                'constraints' => [
                    new TwigLint(),
                ],
            ])
            ->add('mail_key', TextType::class, [
                'required' => true,
                'constraints' => [
                    new Assert\NotBlank(),
                ],
            ])
        ;

        $builder->addEventListener(FormEvents::POST_SET_DATA, function (FormEvent $event): void {
            $data = $event->getData();
            if (null === $data->getId()) {
                $form = $event->getForm();
                $form->add('file_name', TextType::class, [
                    'constraints' => [
                        new Assert\NotBlank(),
                        new Assert\Regex(['pattern' => '/^[0-9a-z_-]+$/']),
                        new Assert\Length(['max' => $this->eccubeConfig['eccube_stext_len']]),
                    ],
                ]);
            }
        });

        $builder->addEventListener(FormEvents::POST_SUBMIT, function (FormEvent $event): void {
            $data = $event->getData();
            if (null === $data->getId()) {
                $filename = 'Mail/Mall/'.$data->getFileName().'.twig';
                $MailTemplate = $this->mailTemplateRepository->findBy(['file_name' => $filename]);
                if ($MailTemplate) {
                    $form = $event->getForm();
                    $form['file_name']->addError(new FormError(trans('admin.setting.shop.mail.file_exists')));
                } else {
                    $data->setFileName('Mail/Mall/'.$data->getFileName().'.twig');
                }
            }
        });
    }

    /**
     * {@inheritdoc}
     */
    #[\Override]
    public function configureOptions(OptionsResolver $resolver): void
    {
        $constraints = $resolver->resolve()['constraints'];
        $constraints[] = new Assert\Callback($this->checkDuplicateMailKey(...));

        $resolver->setDefaults([
            'data_class' => MailTemplate::class,
            'baseInfo' => $this->baseInfoRepository->getMallData(),
            'constraints' => $constraints,
        ]);
    }

    public function checkDuplicateMailKey(MailTemplate $data, ExecutionContextInterface $context): void
    {
        /** @var MailTemplate $Mail */
        $Mail = $data;
        if ($Mail->getId() && !$Mail->isDeletable()) {
            // ここに突入する場合は既存データなので判定を行わない
            return;
        }

        $target = $this->mailTemplateRepository->findBy(['mail_key' => $Mail->getMailKey()]);
        switch (count($target)) {
            case 0:
                return;
            case 1:
                if ($target[0]->getId() == $Mail->getId()) {
                    return;
                }
                break;
            default:
        }

        // ここにたどり着く場合、メールキーが重複しているためバリデーションエラーを発生させる
        $context
            ->buildViolation('既に使用されているメールキーです')
            ->atPath('mail_key')
            ->addViolation();
    }

    /**
     * {@inheritdoc}
     */
    #[\Override]
    public function getBlockPrefix(): string
    {
        return 'mail';
    }
}
