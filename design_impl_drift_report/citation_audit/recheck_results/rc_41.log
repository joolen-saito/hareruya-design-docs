    public function buildForm(FormBuilderInterface $builder, array $options)
    {
        $config = $this->app['config'];

        $builder
            ->add('name', 'text', [
                'label' => 'テンプレ名称',
                'constraints' => [
                    new Assert\Length(['max' => $config['stext_len']]),
                ],
            ])
            ->add('template', 'mail_template', [
                'label' => 'テンプレ選択',
                'required' => true,
                'constraints' => [
                    new Assert\NotBlank(),
                ],
                'mapped' => false,
                'query_builder' => function (EntityRepository $er) use ($options) {
                    $qb = $er->createQueryBuilder('mt');
                    $parameters = [];

                    $options['autoMail'] ? $qb->where('mt.id IN (:ids)') : $qb->where('mt.id NOT IN (:ids)');
                    $parameters['ids'] = MailTemplate::AUTO_SEND_MAILS;

                    if (!empty($options['baseFiles'])) {
                        $parameters['fileNames'][] = MailTemplate::BASE_FILES[MailTemplate::BASE_NO_BASE];
                    }
                    foreach ($options['baseFiles'] as $baseFile) {
                        $qb->andWhere('mt.file_name IN (:fileNames)');
                        $parameters['fileNames'][] = MailTemplate::BASE_FILES[$baseFile];
                    }

                    $qb->setParameters($parameters)
                        ->orderBy('mt.name', 'ASC');

                    return $qb;
                }
            ])
            ->add('header', 'textarea', [
                'label' => 'ヘッダー',
                'required' => false,
            ])
            ->add('footer', 'textarea', [
                'label' => 'フッター',
                'required' => false,
            ])
        ;
    }

