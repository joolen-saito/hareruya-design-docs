llapse\" id\u003d\"addComment\"\u003e\n                                    \u003cdiv class\u003d\"row bg-ec-formGray pt-3 mb-2\"\u003e\n                                        \u003cdiv class\u003d\"col-3\"\u003e\n                                            \u003cdiv class\u003d\"d-inline-block\" data-bs-toggle\u003d\"tooltip\" data-bs-placement\u003d\"top\"\n                                                 title\u003d\"商品一覧ページに表示される商品説明文です。未設定の場合、商品一覧画面に説明は表示されません。\"\u003e\n                                                \u003cspan\u003e商品説明(一覧)\u003c/span\u003e\n                                                \u003ci class\u003d\"fa fa-question-circle fa-lg ms-1\"\u003e\u003c/i\u003e\n                                            \u003c/div\u003e\n                                        \u003c/div\u003e\n                                        \u003cdiv class\u003d\"col mb-4\"\u003e\n                                            \u003cdiv\u003e\n                                                \u003ctextarea id\u003d\"admin_product_description_list\" name\u003d\"admin_product[description_list]\" rows\u003d\"4\" class\u003d\"form-control\"\u003e\u003c/textarea\u003e\n                                                \n                                            \u003c/div\u003e\n                                        \u003c/div\u003e\n                                    \u003c/div\u003e\n                                \u003c/div\u003e\n                                                                    \u003cdiv class\u003d\"row\"\u003e\n                                        \u003cdiv class\u003d\"col-3\"\u003e\n                                            \u003cdiv class\u003d\"d-inline-block\"\u003e\n                                                \u003cspan\u003e販売価格\u003c/span\u003e\n                                                \u003cspan class\u003d\"badge bg-primary ms-1\"\u003e\n                                                    必須\n                                                \u003c/span\u003e\n                                            \u003c/div\u003e\n                                        \u003c/div\u003e\n                                        \u003cdiv class\u003d\"col mb-2\"\u003e\n                                            \u003cdiv\u003e\n                                                \u003cdiv class\u003d\"input-group \"\u003e\u003cspan class\u003d\"input-group-text\"\u003e￥ \u003c/span\u003e\u003cinput type\u003d\"text\" id\u003d\"admin_product_class_price02\" name\u003d\"admin_product[class][price02]\" required\u003d\"required\" class\u003d\"form-control\" value\u003d\"1\" /\u003e\u003c/div\u003e\n                                                \n                                            \u003c/div\u003e\n                                        \u003c/div\u003e\n                                    \u003c/div\u003e\n                                    \u003cdiv class\u003d\"row\"\u003e\n                                        \u003cdiv class\u003d\"col-3\"\u003e\n                                            \u003cdiv class\u003d\"d-inline-block\" data-bs-toggle\u003d\"tooltip\" data-bs-placement\u003d\"top\"\n                                                 title\u003d\"販売価格が特別な価格である場合、通常価格を併せて表示することができます。\"\u003e\n                                                \u003cspan\u003e通常価格\u003c/span\u003e\n                                                \u003ci class\u003d\"fa fa-question-circle fa-lg ms-1\"\u003e\u003c/i\u003e\n                                            \u003c/div\u003e\n                                        \u003c/div\u003e\n                                        \u003cdiv class\u003d\"col mb-2\"\u003e\n                                            \u003cdiv\u003e\n                                                \u003cdiv class\u003d\"input-group \"\u003e\u003cspan class\u003d\"input-group-text\"\u003e￥ \u003c/span\u003e\u003cinput type\u003d\"text\" id\u003d\"admin_product_class_price01\" name\u003d\"admin_product[class][price01]\" class\u003d\"form-control\" /\u003e\u003c/div\u003e\n                                                \n                                            \u003c/div\u003e\n                                        \u003c/div\u003e\n                                    \u003c/div\u003e\n                                    \u003cdiv class\u003d\"row\"\u003e\n                                        \u003cdiv class\u003d\"col-3\"\u003e\n                                            \u003cdiv class\u003d\"d-inline-block\"\u003e\n                                                \u003cspan\u003e在庫数\u003c/span\u003e\n                                                \u003cspan class\u003d\"badge bg-primary ms-1\"\u003e\n                                                    必須\n                                                \u003c/span\u003e\n                                            \u003c/div\u003e\n                                        \u003c/div\u003e\n                                        \u003cdiv class\u003d\"col\"\u003e\n                                            \u003cdiv\u003e\n                                                \u003cinput type\u003d\"text\" id\u003d\"admin_product_class_stock\" name\u003d\"admin_product[class][stock]\" inputmode\u003d\"decimal\" class\u003d\"form-control\" /\u003e\n                                                \n                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                \u003cdiv class\u003d\"form-check\"\u003e\u003cinput type\u003d\"checkbox\" id\u003d\"admin_product_class_stock_unlimited\" name\u003d\"admin_product[class][stock_unlimited]\" class\u003d\"form-check-input\" value\u003d\"1\" checked\u003d\"checked\" /\u003e\n        \u003clabel class\u003d\"form-check-label\" for\u003d\"admin_product_class_stock_unlimited\"\u003e無制限\u003c/label\u003e\u003c/div\u003e\n                                                \n                                            \u003c/div\u003e\n                                        \u003c/div\u003e\n                                    \u003c/div\u003e\n                                                                \u003cdiv class\u003d\"row\"\u003e\n                                    \u003cdiv class\u003d\"col-3\"\u003e\n                                        \u003cdiv class\u003d\"d-inline-block\" data-bs-toggle\u003d\"tooltip\" data-bs-placement\u003d\"top\"\n                                             title\u003d\"サイト内検索で利用されるキーワードです。\"\u003e\n                                            \u003cspan\u003e検索ワード\u003c/span\u003e\n                                            \u003ci class\u003d\"fa fa-question-circle fa-lg ms-1\"\u003e\u003c/i\u003e\n                                        \u003c/div\u003e\n                                    \u003c/div\u003e\n                                    \u003cdiv class\u003d\"col mb-2\"\u003e\n                                        \u003cdiv\u003e\n                                            \u003cinput type\u003d\"text\" id\u003d\"admin_product_search_word\" name\u003d\"admin_product[search_word]\" class\u003d\"form-control\" /\u003e\n                                            \n                                        \u003c/div\u003e\n                                    \u003c/div\u003e\n                                \u003c/div\u003e\n\n                                                                    \u003cdiv class\u003d\"row\"\u003e\n                                        \u003cdiv class\u003d\"col-3\"\u003e\n                                            \u003cdiv class\u003d\"d-inline-block\" data-bs-toggle\u003d\"tooltip\" data-bs-placement\u003d\"top\"\n                                                 title\u003d\"自由に設定できる商品コードです。\"\u003e\n                                                \u003cspan\u003e商品コード\u003c/span\u003e\n                                                \u003ci class\u003d\"fa fa-question-circle fa-lg ms-1\"\u003e\u003c/i\u003e\n                                            \u003c/div\u003e\n                                        \u003c/div\u003e\n                                        \u003cdiv class\u003d\"col mb-2\"\u003e\n                                            \u003cdiv\u003e\n                                                \u003cinput type\u003d\"text\" id\u003d\"admin_product_class_code\" name\u003d\"admin_product[class][code]\" class\u003d\"form-control\" /\u003e\n                                                \n                                            \u003c/div\u003e\n                                        \u003c/div\u003e\n                                    \u003c/div\u003e\n                                    \u003cdiv class\u003d\"row\"\u003e\n                                        \u003cdiv class\u003d\"col-3\"\u003e\n                                            \u003cdiv class\u003d\"d-inline-block\" data-bs-toggle\u003d\"tooltip\" data-bs-placement\u003d\"top\"\n                                                 title\u003d\"購入者が一度に購入できる個数を制限することができます。\"\u003e\n                                                \u003cspan\u003e販売制限数\u003c/span\u003e\n                                                \u003ci class\u003d\"fa fa-question-circle fa-lg ms-1\"\u003e\u003c/i\u003e\n                                            \u003c/div\u003e\n                                        \u003c/div\u003e\n                                        \u003cdiv class\u003d\"col mb-2\"\u003e\n                                            \u003cdiv\u003e\n                                                \u003cinput type\u003d\"text\" id\u003d\"admin_product_class_sale_limit\" name\u003d\"admin_product[class][sale_limit]\" inputmode\u003d\"decimal\" class\u003d\"form-control\" /\u003e\n                                                \n                                            \u003c/div\u003e\n                                        \u003c/div\u003e\n                                    \u003c/div\u003e\n                                    \u003cdiv class\u003d\"row\"\u003e\n                                        \u003cdiv class\u003d\"col-3\"\u003e\n                                            \u003cdiv class\u003d\"d-inline-block\" data-bs-toggle\u003d\"tooltip\" data-bs-placement\u003d\"top\"\n                                                 title\u003d\"発送日の目安期間を商品ごとに登録できます。\"\u003e\n                                                \u003cspan\u003e発送日目安\u003c/span\u003e\n                                                \u003ci class\u003d\"fa fa-question-circle fa-lg ms-1\"\u003e\u003c/i\u003e\n                                            \u003c/div\u003e\n                                        \u003c/div\u003e\n                                        \u003cdiv class\u003d\"col mb-2\"\u003e\n                                            \u003cdiv\u003e\n                                                            \u003cselect id\u003d\"admin_product_class_delivery_duration\" name\u003d\"admin_product[class][delivery_duration]\" class\u003d\"form-select\"\u003e\u003coption value\u003d\"\"\u003e指定なし\u003c/option\u003e\u003coption value\u003d\"1\"\u003e即日\u003c/option\u003e\u003coption value\u003d\"2\"\u003e1～2日後\u003c/option\u003e\u003coption value\u003d\"3\"\u003e3～4日後\u003c/option\u003e\u003coption value\u003d\"4\"\u003e1週間以降\u003c/option\u003e\u003coption value\u003d\"5\"\u003e2週間以降\u003c/option\u003e\u003coption va