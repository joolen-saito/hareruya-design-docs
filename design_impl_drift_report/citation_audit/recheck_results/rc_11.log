lapse show ec-cardCollapse\" id\u003d\"basicConfig\"\u003e\n                            \u003cdiv class\u003d\"card-body\"\u003e\n                                                                    \u003cdiv class\u003d\"row\"\u003e\n                                        \u003cdiv class\u003d\"col-3\"\u003e\n                                            \u003cdiv class\u003d\"d-inline-block\" data-bs-toggle\u003d\"tooltip\" data-bs-placement\u003d\"top\" title\u003d\"自動的に採番される商品のIDです。\"\u003e\n                                                \u003cspan\u003e商品ID\u003c/span\u003e\n                                                \u003ci class\u003d\"fa fa-question-circle fa-lg ms-1\"\u003e\u003c/i\u003e\n                                            \u003c/div\u003e\n                                        \u003c/div\u003e\n                                        \u003cdiv class\u003d\"col\"\u003e\n                                            \u003cp\u003e3\u003c/p\u003e\n                                        \u003c/div\u003e\n                                    \u003c/div\u003e\n                                                                \u003cdiv class\u003d\"row\"\u003e\n                                    \u003cdiv class\u003d\"col-3\"\u003e\n                                        \u003cdiv class\u003d\"d-inline-block\"\u003e\n                                            \u003cspan\u003e商品名\u003c/span\u003e\n                                            \u003cspan class\u003d\"badge bg-primary ms-1\"\u003e\n                                                必須\n                                            \u003c/span\u003e\n                                        \u003c/div\u003e\n                                    \u003c/div\u003e\n                                    \u003cdiv class\u003d\"col mb-2\"\u003e\n                                        \u003cinput type\u003d\"text\" id\u003d\"admin_product_name\" name\u003d\"admin_product[name]\" required\u003d\"required\" class\u003d\"form-control\" value\u003d\"test\" /\u003e\n                                        \n                                    \u003c/div\u003e\n                                \u003c/div\u003e\n                                                                    \u003cdiv class\u003d\"row\"\u003e\n                                        \u003cdiv class\u003d\"col-3\"\u003e\n                                            \u003cdiv class\u003d\"d-inline-block\" data-bs-toggle\u003d\"tooltip\" data-bs-placement\u003d\"top\" title\u003d\"通常商品やダウンロード商品といった販売方法が異なる場合に利用します。販売種別のリストは［マスターデータ管理］のmtb_sale_typeから編集できます。\"\u003e\n                                                \u003cspan\u003e販売種別\u003c/span\u003e\n                                                \u003ci class\u003d\"fa fa-question-circle fa-lg ms-1\"\u003e\u003c/i\u003e\n                                                \u003cspan class\u003d\"badge bg-primary ms-1\"\u003e\n                                                    必須\n                                                \u003c/span\u003e\n                                            \u003c/div\u003e\n                                        \u003c/div\u003e\n                                        \u003cdiv class\u003d\"col mb-2\"\u003e\n                                                        \u003cselect id\u003d\"admin_product_class_sale_type\" name\u003d\"admin_product[class][sale_type]\" class\u003d\"form-select\"\u003e\u003coption value\u003d\"1\" selected\u003d\"selected\"\u003e販売種別A\u003c/option\u003e\u003coption value\u003d\"2\"\u003e販売種別B\u003c/option\u003e\u003c/select\u003e\n    \n                                            \n                                        \u003c/div\u003e\n                                    \u003c/div\u003e\n                                                                \u003cdiv class\u003d\"row\"\u003e\n                                    \u003cdiv class\u003d\"col-3\"\u003e\n                                        \u003cdiv class\u003d\"d-inline-block\" data-bs-toggle\u003d\"tooltip\" data-bs-placement\u003d\"top\" title\u003d\"複数の商品画像をドラッグ＆ドロップで登録できます。\"\u003e\n                                            \u003cspan\u003e商品画像\u003c/span\u003e\n                                            \u003ci class\u003d\"fa fa-question-circle fa-lg ms-1\"\u003e\u003c/i\u003e\n                                            \u003cbr\u003e推奨サイズ : 600px x 600px以上\n                                        \u003c/div\u003e\n                                    \u003c/div\u003e\n                                    \u003cdiv class\u003d\"col mb-2\"\u003e\n                                        \u003cp id\u003d\"message\"\u003e\u003c/p\u003e\n                                        \u003cdiv id\u003d\"upload-zone\" class\u003d\"rounded\"\u003e\n                                            \u003cinput type\u003d\"file\" id\u003d\"admin_product_product_image\" name\u003d\"admin_product[product_image][]\" multiple\u003d\"multiple\" style\u003d\"display:none;\" class\u003d\"form-control-file\" /\u003e\n                                            \n                                        \u003c/div\u003e\u003c!-- /#upload-zone --\u003e\n                                        \u003cspan class\u003d\"invalid-feedback\" id\u003d\"product_image_error\" style\u003d\"display: none\"\u003e\n                                            \u003cspan class\u003d\"d-block\"\u003e\n                                                \u003cspan class\u003d\"form-error-icon badge bg-danger text-uppercase\"\u003eエラー\u003c/span\u003e\n                                                \u003cspan class\u003d\"form-error-message\"\u003e\u003c/span\u003e\n                                            \u003c/span\u003e\n                                        \u003c/span\u003e\n                                    \u003c/div\u003e\n                                \u003c/div\u003e\n                                \u003cdiv class\u003d