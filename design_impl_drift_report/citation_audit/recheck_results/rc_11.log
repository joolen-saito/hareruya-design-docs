   \u003c/button\u003e\n    \u003c/div\u003e\n\n\n            \u003c!-- 移動確認モーダル--\u003e\n    \u003cdiv class\u003d\"modal fade\" id\u003d\"confirmFormChangeModal\" tabindex\u003d\"-1\" role\u003d\"dialog\"\n         aria-labelledby\u003d\"confirmFormChangeModal\" aria-hidden\u003d\"true\"\u003e\n        \u003cdiv class\u003d\"modal-dialog\" role\u003d\"document\"\u003e\n            \u003cdiv class\u003d\"modal-content\"\u003e\n                \u003cdiv class\u003d\"modal-header\"\u003e\n                    \u003ch5 class\u003d\"modal-title\"\u003eページを移動します\u003c/h5\u003e\n                    \u003cbutton class\u003d\"btn-close\" type\u003d\"button\" data-bs-dismiss\u003d\"modal\" aria-label\u003d\"Close\"\u003e\n\n                    \u003c/button\u003e\n                \u003c/div\u003e\n                \u003cdiv class\u003d\"modal-body\"\u003e\n                    \u003cp class\u003d\"screen-name\"\u003e\u003c/p\u003e\n                \u003c/div\u003e\n                \u003cdiv class\u003d\"modal-footer\"\u003e\n                    \u003ca class\u003d\"btn btn-ec-conversion\" data-action\u003d\"save\" href\u003d\"javascript:void(0)\"\u003e\n                        保存して移動\n                    \u003c/a\u003e\n                    \u003ca class\u003d\"btn btn-ec-sub\" data-action\u003d\"cancel\" href\u003d\"javascript:void(0)\"\u003e\n                        保存せずに移動\n                    \u003c/a\u003e\n                \u003c/div\u003e\n            \u003c/div\u003e\n        \u003c/div\u003e\n    \u003c/div\u003e\n    \u003cform role\u003d\"form\" name\u003d\"form1\" id\u003d\"form1\" method\u003d\"post\" action\u003d\"\" novalidate enctype\u003d\"multipart/form-data\"\u003e\n        \u003cinput type\u003d\"hidden\" id\u003d\"admin_product__token\" name\u003d\"admin_product[_token]\" value\u003d\"c29c6230c51e6a.LQ6sjKuAOtah8LRJiLghuRdmP_izz4iibhumyu6PpTE.TE-a-s2yDpH4kfgL_IhA128nbbrL-N_RVjbH593QwF1qVt7H58xfpZO-9Q\" /\u003e\n        \u003cinput type\u003d\"hidden\" id\u003d\"admin_product_return_link\" name\u003d\"admin_product[return_link]\" /\u003e\n        \u003cdiv class\u003d\"c-contentsArea__cols\"\u003e\n            \u003cdiv class\u003d\"c-contentsArea__primaryCol\"\u003e\n                \u003cdiv class\u003d\"c-primaryCol\"\u003e\n                    \u003cdiv class\u003d\"card rounded border-0 mb-4\"\u003e\n                        \u003cdiv class\u003d\"card-header\"\u003e\n                            \u003cdiv class\u003d\"row\"\u003e\n                                \u003cdiv class\u003d\"col-8\"\u003e\n                                    \u003cdiv class\u003d\"d-inline-block\"\u003e\n                                    \u003cspan class\u003d\"card-title\"\u003e\n                                        商品情報\n                                    \u003c/span\u003e\n                                    \u003c/div\u003e\n                                \u003c/div\u003e\n                                \u003cdiv class\u003d\"col-4 text-end\"\u003e\n                                    \u003ca data-bs-toggle\u003d\"collapse\" href\u003d\"#basicConfig\" aria-expanded\u003d\"false\"\n                                       aria-controls\u003d\"basicConfig\"\u003e\n                                        \u003ci class\u003d\"fa fa-angle-up fa-lg\"\u003e\u003c/i\u003e\n                                    \u003c/a\u003e\n                                \u003c/div\u003e\n                            \u003c/div\u003e\n                        \u003c/div\u003e\n                        \u003cdiv class\u003d\"collapse show ec-cardCollapse\" id\u003d\"basicConfig\"\u003e\n                            \u003cdiv class\u003d\"card-body\"\u003e\n                                                                \u003cdiv class\u003d\"row\"\u003e\n                                    \u003cdiv class\u003d\"col-3\"\u003e\n                                        \u003cdiv class\u003d\"d-inline-block\"\u003e\n                                            \u003cspan\u003e商品名\u003c/span\u003e\n                                            \u003cspan class\u003d\"badge bg-primary ms-1\"\u003e\n                                                必須\n                                            \u003c/span\u003e\n                                        \u003c/div\u003e\n                                    \u003c/div\u003e\n                                    \u003cdiv class\u003d\"col mb-2\"\u003e\n                                        \u003cinput type\u003d\"text\" id\u003d\"admin_product_name\" name\u003d\"admin_product[name]\" required\u003d\"required\" class\u003d\"form-control\" /\u003e\n                                        \n                                    \u003c/div\u003e\n                                \u003c/div\u003e\n                                                                    \u003cdiv class\u003d\"row\"\u003e\n                                        \u003cdiv class\u003d\"col-3\"\u003e\n                                            \u003cdiv class\u003d\"d-inline-block\" data-bs-toggle\u003d\"tooltip\" data-bs-placement\u003d\"top\" title\u003d\"通常商品やダウンロード商品といった販売方法が異なる場合に利用します。販売種別のリストは［マスターデータ管理］のmtb_sale_typeから編集できます。\"\u003e\n                                                \u003cspan\u003e販売種別\u003c/span\u003e\n                                                \u003ci class\u003d\"fa fa-question-circle fa-lg ms-1\"\u003e\u003c/i\u003e\n                                                \u003cspan class\u003d\"badge bg-primary ms-1\"\u003e\n                                                    必須\n                                                \u003c/span\u003e\n                                            \u003c/div\u003e\n                                        \u003c/div\u003e\n                                        \u003cdiv class\u003d\"col mb-2\"\u003e\n                                                        \u003cselect id\u003d\"admin_product_class_sale_type\" name\u003d\"admin_product[class][sale_type]\" class\u003d\"form-select\"\u003e\u003coption value\u003d\"1\"\u003e販売種別A\u003c/option\u003e\u003coption value\u003d\"2\"\u003e販売種別B\u003c/option\u003e\u003c/select\u003e\n    \n                                            \n                                        \u003c/div\u003e\n                                    \u003c/div\u003e\n                                                                \u003cdiv class\u003d\"row\"\u003e\n                                    \u003cdiv class\u003d\"col-3\"\u003e\n                                        \u003cdiv class\u003d\"d-inline-block\" data-bs-toggle\u003d\"tooltip\" data-bs-placement\u003d\"top\" title\u003d\"複数の商品画像をドラッグ＆ドロップで登録できます。\"\u003e\n                                            \u003cspan\u003e商品画像\u003c/span\u003e\n                                            \u003ci class\u003d\"fa fa-question-circle fa-lg ms-1\"\u003e\u003c/i\u003e\n                                            \u003cbr\u003e推奨サイズ : 600px x 600px以上\n                                        \u003c/div\u003e\n                                    \u003c/div\u003e\n                                    \u003cdiv class\u003d\"col mb-2\"\u003e\n                                        \u003cp id\u003d\"message\"\u003e\u003c/p\u003e\n                                        \u003cdiv id\u003d\"upload-zone\" class\u003d\"rounded\"\u003e\n                                            \u003cinput type\u003d\"file\" id\u003d\"admin_product_product_image\" name\u003d\"admin_product[product_image][]\" multiple\u003d\"multiple\" style\u003d\"display:none;\" class\u003d\"form-control-file\" /\u003e\n                                            \n                                        \u003c/div\u003e\u003c!-- /#upload-zone --\u003e\n                                        \u003cspan class\u003d\"invalid-feedback\" id\u003d\"product_image_error\" style\u003d\"display: none\"\u003e\n                                            \u003cspan class\u003d\"d-block\"\u003e\n                                                \u003cspan class\u003d\"form-error-icon badge bg-danger text-uppercase\"\u003eエラー\u003c/span\u003e\n                                                \u003cspan class\u003d\"form-error-message\"\u003e\u003c/span\u003e\n                                            \u003c/span\u003e\n                                        \u003c/span\u003e\n                                    \u003c/div\u003e\n                                \u003c/div\u003e\n                                \u003cdiv class\u003d\"row\"\u003e\n                                    \u003cdiv class\u003d\"col-3\"\u003e\n                                        \u003cdiv class\u003d\"d-inline-block\" data-bs-toggle\u003d\"tooltip\" data-bs-placement\u003d\"top\"\n                                             title\u003d\"商品ページに表示される説明文です。HTMLタグが利用可能です。\"\u003e\n                                            \u003cspan\u003e商品説明\u003c/span\u003e\n                                            \u003ci class\u003d\"fa fa-question-circle fa-lg ms-1\"\u003e\u003c/i\u003e\n                                        \u003c/div\u003e\n                                    \u003c/div\u003e\n                                    \u003cdiv class\u003d\"col\"\u003e\n                                        \u003ctextarea id\u003d\"admin_product_description_detail\" name\u003d\"admin_product[description_detail]\" required\u003d\"required\" rows\u003d\"8\" class\u003d\"form-control\"\u003e\u003c/textarea\u003e\n                                        \n                                        \u003cdiv class\u003d\"d-inline-block mb-2\" data-bs-toggle\u003d\"collapse\" href\u003d\"#addComment\"\n                                             role\u003d\"button\" aria-expanded\u003d\"false\" aria-controls\u003d\"addComment\"\u003e\n                                            \u003ca\u003e\n                                                \u003ci class\u003d\"fa fa-plus-square-o fw-bold me-1\"\u003e\u003c/i\u003e\n                                                \u003cspan class\u003d\"fw-bold text-ec-black\"\u003e\n                                                    商品説明(一覧)を追加\n                                                \u003c/span\u003e\n                                            \u003c/a\u003e\n                                        \u003c/div\u003e\n                                    \u003c/div\u003e\n                                \u003c/div\u003e\n                                \u003cdiv class\u003d\"collapse ec-collapse\" id\u003d\"addComment\"\u003e\n                                    \u003cdiv class\u003d\"row bg-ec-formGray pt-3 mb-2\"\u003e\n                                        \u003cdiv class\u003d\"col-3\"\u003e\n                                            \u003cdiv class\u003d\"d-inline-block\" data-bs-toggle\u003d\"tooltip\" data-bs-placement\u003d\"top\"\n                                                 title\u003d\"商品一覧ページに表示される商品説明文です。未設定の場合、商品一覧画面に説明は表示されません。\"\u003e\n                                                \u003cspan\u003e商品説明(一覧)\u003c/span\u003e\n                                                \u003ci class\u003d\"fa fa-question-circle fa-lg ms-1\"\u003e\u003c/i\u003e\n                                            \u003c/div\u003e\n                                        \u003c/div\u003e\n                                        \u003cdiv class\u003d\"col mb-4\"\u003e\n                                            \u003cdiv\u003e\n                                                \u003ctextarea id\u003d\"admin_product_description_list\" name\u003d\"admin_product[description_list]\" rows\u003d\"4\" class\u003d\"form-control\"\u003e\u003c/textarea\u003e\n                                                \n                                            \u003c/div\u003e\n                                        \u003c/div\u003e\n                                    \u003c/div\u003e\n                                \u003c/div\u003e\n                                                                    \u003cdiv class\u003d\"row\"\u003e\n                                        \u003cdiv class\u003d\"col-3\"\u003e\n                                            \u003cdiv class\u003d\"d-inline-block\"\u003e\n                                                \u003cspan\u003e販売価格\u003c/span\u003e\n                                                \u003cspan class\u003d\"badge bg-primary ms-1\"\u003e\n                                                    必須\n                                                \u003c/span\u003e\n                                            \u003c/div\u003e\n                                        \u003c/div\u003e\n                                        \u003cdiv class\u003d\"col mb-2\"\u003e\n                                            \u003cdiv\u003e\n                                                \u003cdiv class\u003d\"input-group \"\u003e\u003cspan class\u003d\"input-group-text\"\u003e￥ \u003c/span\u003e\u003cinput type\u003d\"text\" id\u003d\"admin_product_class_price02\" name\u003d\"admin_product[class][price02]\" required\u003d\"required\" class\u003d\"form-control\" /\u003e\u003c/div\u003e\n                                                \n                                            \u003c/div\u003e\n                                        \u003c/div\u003e\n                                    \u003c/div\u003e\n                                    \u003cdiv class\u003d\"row\"\u003e\n                                        \u003cdiv class\u003d\"col-3\"\u003e\n                                            \u003cdiv class\u003d\"d-inline-block\" data-bs-toggle\u003d\"tooltip\" data-bs-placement\u003d\"top\"\n                                                 title\u003d\"販売価格が特別な価格である場合、通常価格を併せて表示することができます。\"\u003e\n                                                \u003cspan\u003e通常価格\u003c/span\u003e\n                                                \u003ci class\u003d\"fa fa-question-circle fa-lg ms-1\"\u003e\u003c/i\u003e\n                                            \u003c/div\u003e\n                                        \u003c/div\u003e\n                                        \u003cdiv class\u003d\"col mb-2\"\u003e\n                                            \u003cdiv\u003e\n                                                \u003cdiv class\u003d\"input-group \"\u003e\u003cspan class\u003d\"input-group-text\"\u003e￥ \u003c/span\u003e\u003cinput type\u003d\"text\" id\u003d\"admin_product_class_price01\" name\u003d\"admin_product[class][price01]\" class\u003d\"form-control\" /\u003e\u003c/div\u003e\n                                                \n                                            \u003c/div\u003e\n                                        \u003c/div\u003e\n                                    \u003c/div\u003e\n                                    \u003cdiv class\u003d\"row\"\u003e\n                                        \u003cdiv class\u003d\"col-3\"\u003e\n                                            \u003cdiv class\u003d\"d-inline-block\"\u003e\n                                                \u003cspan\u003e在庫数\u003c/span\u003e\n                                                \u003cspan class\u003d\"badge bg-primary ms-1\"\u003e\n                                                    必須\n                                                \u003c/span\u003e\n                                            \u003c/div\u003e\n                                        \u003c/div\u003e\n                                        \u003cdiv class\u003d\"col\"\u003e\n                                            \u003cdiv\u003e\n                                                \u003cinput type\u003d\"text\" id\u003d\"admin_product_class_stock\" name\u003d\"admin_product[class][stock]\" inputmode\u003d\"decimal\" class\u003d\"form-control\" /\u003e\n                                                \n                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                \u003cdiv class\u003d\"form-check\"\u003e\u003cinput type\u003d\"checkbox\" id\u003d\"admin_product_class_stock_unlimited\" name\u003d\"admin_product[class][stock_unlimited]\" class\u003d\"form-check-input\" value\u003d\"1\" checked\u003d\"checked\" /\u003e\n        \u003clabel class\u003d\"form-check-label\" for\u003d\"admin_product_class_stock_unlimited\"\u003e無制限\u003c/label\u003e\u003c/div\u003e\n                                                \n                                            \u003c/div\u003e\n                                        \u003c/div\u003e\n                                    \u003c/div\u003e\n                                                                \u003cdiv class\u003d\"row\"\u003e\n                                    \u003cdiv class\u003d\"col-3\"\u003e\n                                        \u003cdiv class\u003d\"d-inline-block\" data-bs-toggle\u003d\"tooltip\" data-bs-placement\u003d\"top\"\n                                             title\u003d\"サイト内検索で利用されるキーワードです。\"\u003e\n                                            \u003cspan\u003e検索ワード\u003c/span\u003e\n                                            \u003ci class\u003d\"fa fa-question-circle fa-lg ms-1\"\u003e\u003c/i\u003e\n                                        \u003c/div\u003e\n                                    \u003c/div\u003e\n                                    \u003cdiv class\u003d\"col mb-2\"\u003e\n                                        \u003cdiv\u003e\n                                            \u003cinput type\u003d\"text\" id\u003d\"admin_product_search_word\" name\u003d\"admin_product[search_word]\" class\u003d\"form-control\" /\u003e\n                                            \n                                        \u003c/div\u003e\n                                    \u003c/div\u003e\n                                \u003c/div\u003e\n\n                                                                    \u003cdiv class\u003d\"row\"\u003e\n                                        \u003cdiv class\u003d\"col-3\"\u003e\n                                            \u003cdiv class\u003d\"d-inline-block\" data-bs-toggle\u003d\"tooltip\" data-bs-placement\u003d\"top\"\n                                                 title\u003d\"自由に設定できる商品コードです。\"\u003e\n                                                \u003cspan\u003e商品コード\u003c/span\u003e\n                                                \u003ci class\u003d\"fa fa-question-circle fa-lg ms-1\"\u003e\u003c/i\u003e\n                                            \u003c/div\u003e\n                                        \u003c/div\u003e\n                                        \u003cdiv class\u003d\"col mb-2\"\u003e\n                                            \u003cdiv\u003e\n                                                \u003cinput type\u003d\"text\" id\u003d\"admin_product_class_code\" name\u003d\"admin_product[class][code]\" class\u003d\"form-control\" /\u003e\n                                                \n                                            \u003c/div\u003e\n                                        \u003c/div\u003e\n                                    \u003c/div\u003e\n                                    \u003cdiv class\u003d\"row\"\u003e\n                                        \u003cdiv class\u003d\"col-3\"\u003e\n                                            \u003cdiv class\u003d\"d-inline-block\" data-bs-toggle\u003d\"tooltip\" data-bs-placement\u003d\"top\"\n                                                 title\u003d\"購入者が一度に購入できる個数を制限することができます。\"\u003e\n                                                \u003cspan\u003e販売制限数\u003c/span\u003e\n                                                \u003ci class\u003d\"fa fa-question-circle fa-lg ms-1\"\u003e\u003c/i\u003e\n                                            \u003c/div\u003e\n                                        \u003c/div\u003e\n                                        \u003cdiv class\u003d\"col mb-2\"\u003e\n                                            \u003cdiv\u003e\n                                                \u003cinput type\u003d\"text\" id\u003d\"admin_product_class_sale_limit\" name\u003d\"admin_product[class][sale_limit]\" inputmode\u003d\"decimal\" class\u003d\"form-control\" /\u003e\n                                                \n                                            \u003c/div\u003e\n                                        \u003c/div\u003e\n                                    \u003c/div\u003e\n                                    \u003cdiv class\u003d\"row\"\u003e\n                                        \u003cdiv class\u003d\"col-3\"\u003e\n                                            \u003cdiv class\u003d\"d-inline-block\" data-bs-toggle\u003d\"tooltip\" data-bs-placement\u003d\"top\"\n                                                 title\u003d\"発送日の目安期間を商品ごとに登録できます。\"\u003e\n                                                \u003cspan\u003e発送日目安\u003c/span\u003e\n                                                \u003ci class\u003d\"fa fa-question-circle fa-lg ms-1\"\u003e\u003c/i\u003e\n                                            \u003c/div\u003e\n                                        \u003c/div\u003e\n                                        \u003cdiv class\u003d\"col mb-2\"\u003e\n                                            \u003cdiv\u003e\n                                     