        if ($Order->isSmaregiDelFlg()) {
            return SmaregiOtcSyncResult::SKIPPED;
        }
        if ($Order->isSmaregiProductFlg() && $Order->isSmaregiStockFlg()) {
            return SmaregiOtcSyncResult::ALREADY_SYNCED;
        }

        $orderNumber = (string) ($Order->getOrderNumber() ?? '');
        if ($orderNumber === '') {
            $this->logger->warning('Smaregi OTC sync skipped: order_number is empty', [
                'orderId' => $Order->getId(),
            ]);

            return SmaregiOtcSyncResult::SKIPPED;
        }

