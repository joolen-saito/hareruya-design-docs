namespace Eccube\Service\Admin\Product;

use Eccube\Service\UniSearch\UniSearchExportService;

class UniSearchFeedCreateAction
{
    public function __construct(
        private readonly UniSearchExportService $exportService,
    ) {
    }

    public function handle(): int
    {
        return $this->exportService->exportAndUpload(false);
    }
}
