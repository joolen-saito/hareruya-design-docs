namespace Eccube\Service\Smaregi\Otc;

/**
 * 店頭受取注文用スマレジ商品コード採番。
 *
 * フォーマット:
 * `20(固定2桁) + 1(固定1桁) + スマレジ店舗ID(3桁0埋め) + 注文番号(8桁0埋め後の末尾6桁) + チェックデジット(1桁)` = 計13桁
 *
 * チェックディジットは EAN-13 互換 (左から 1,3,5,...×1 + 2,4,6,...×3 の合計を 10 の補数で丸める)。
 *
 * 採番衝突 (同一コードが ECCUBE 内に既存) の検出は本サービスのスコープ外で、
 * 利用側 (同期サービス) で既存検索した上でエラー処理する想定。
 */
final readonly class SmaregiOtcProductCodeGenerator
{
    private const FIXED_PREFIX = '201';
    private const STORE_ID_LENGTH = 3;
    private const ORDER_NUMBER_PAD_LENGTH = 8;
    private const ORDER_NUMBER_TAIL_LENGTH = 6;
    private const TOTAL_LENGTH = 13;

    /**
     * 店舗 ID と注文番号から 13 桁の商品コードを生成する。
     *
     * @throws \InvalidArgumentException 入力が要件を満たさない場合 (数値以外、桁数超過)
     */
    public function generate(string $storeId, string $orderNumber): string
    {
        $storeIdPart = $this->normalizeStoreId($storeId);
        $orderNumberPart = $this->normalizeOrderNumber($orderNumber);

        $base = self::FIXED_PREFIX.$storeIdPart.$orderNumberPart;
        $checkDigit = $this->calculateCheckDigit($base);

        $code = $base.$checkDigit;
        if (strlen($code) !== self::TOTAL_LENGTH) {
            throw new \LogicException(sprintf('Generated Smaregi OTC code length is invalid: %s', $code));
        }

        return $code;
    }

    private function normalizeStoreId(string $storeId): string
    {
        if ($storeId === '' || !ctype_digit($storeId)) {
            throw new \InvalidArgumentException(sprintf('Store ID must be a non-empty numeric string. given=%s', $storeId));
        }
        if (strlen($storeId) > self::STORE_ID_LENGTH) {
            throw new \InvalidArgumentException(sprintf('Store ID exceeds %d digits. given=%s', self::STORE_ID_LENGTH, $storeId));
        }

        return str_pad($storeId, self::STORE_ID_LENGTH, '0', STR_PAD_LEFT);
    }

    private function normalizeOrderNumber(string $orderNumber): string
    {
        if ($orderNumber === '' || !ctype_digit($orderNumber)) {
            throw new \InvalidArgumentException(sprintf('Order number must be a non-empty numeric string. given=%s', $orderNumber));
        }

        $padded = str_pad($orderNumber, self::ORDER_NUMBER_PAD_LENGTH, '0', STR_PAD_LEFT);

        return substr($padded, -self::ORDER_NUMBER_TAIL_LENGTH);
    }

    private function calculateCheckDigit(string $base12): string
    {
        $sum = 0;
        for ($i = 0; $i < 12; $i++) {
            $d = (int) $base12[$i];
            $sum += ($i % 2 === 0) ? $d : ($d * 3);
        }

        return (string) ((10 - ($sum % 10)) % 10);
    }
