namespace Eccube\Command;

use Eccube\Service\Product\BatchUpdateWeeklyStockHistoryAction;
use Symfony\Component\Console\Attribute\AsCommand;
use Symfony\Component\Console\Command\Command;
use Symfony\Component\Console\Input\InputInterface;
use Symfony\Component\Console\Output\OutputInterface;
use Symfony\Component\Console\Style\SymfonyStyle;

/**
 * 週間在庫履歴更新バッチ（B02-07）
 *
 * リコメンドで使用する週間在庫履歴を更新する。
 * 全店舗の在庫変動履歴から 1〜11 週間前時点の在庫数を取得し、週間在庫履歴テーブルを洗い替えする。
 *
 * 【使い方】
 *
 *   bin/console eccube:update-weekly-stock-history
 */
#[AsCommand(name: 'eccube:update-weekly-stock-history', description: '週間在庫履歴更新バッチ')]
class UpdateWeeklyStockHistoryCommand extends Command
{
    public function __construct(private readonly BatchUpdateWeeklyStockHistoryAction $batchUpdateWeeklyStockHistoryAction)
    {
        parent::__construct();
    }

    #[\Override]
    protected function execute(InputInterface $input, OutputInterface $output): int
    {
        $io = new SymfonyStyle($input, $output);

        try {
            $this->batchUpdateWeeklyStockHistoryAction->handle();
        } catch (\Throwable $e) {
            $io->error('週間在庫履歴の更新でエラーが発生しました: '.$e->getMessage());

            return Command::FAILURE;
        }

        $io->success('週間在庫履歴の更新が完了しました。');

        return Command::SUCCESS;
    }
}
