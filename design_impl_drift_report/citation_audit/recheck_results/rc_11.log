     */
    public function testHandleFailure(): void
    {
        $waitingNumberRepository = $this->createMock(DtbWaitingNumberRepository::class);
        $waitingNumberRepository
            ->expects($this->once())
            ->method('truncateWaitingNumber')
            ->willThrowException(new \Exception('テスト用例外'));

        $waitingNumberCounterRepository = $this->createMock(DtbWaitingNumberCounterRepository::class);
        $waitingNumberCounterRepository
            ->expects($this->never())
            ->method('truncateWaitingNumberCounter');

        $baseInfoRepository = $this->createMock(BaseInfoRepository::class);
        $baseInfoRepository
            ->expects($this->never())
            ->method('findAll');

        $entityManager = $this->createMock(EntityManagerInterface::class);
        $entityManager->expects($this->once())->method('beginTransaction');
        $entityManager->expects($this->once())->method('rollback');
        $entityManager->expects($this->never())->method('persist');
        $entityManager->expects($this->never())->method('flush');
        $entityManager->expects($this->never())->method('commit');

        $this->expectException(\Exception::class);
        $this->expectExceptionMessage('テスト用例外');

        $action = new TruncateWaitingNumberAction(
            $waitingNumberRepository,
            $waitingNumberCounterRepository,
            $baseInfoRepository,
            $entityManager,
        );

        $action->handle();
    }
}

