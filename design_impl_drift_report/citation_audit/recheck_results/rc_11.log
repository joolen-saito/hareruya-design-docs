namespace Eccube\Service\UniSearch;

use Eccube\Repository\CategoryRepository;
use Eccube\Repository\ProductClassRepository;
use Symfony\Component\DependencyInjection\ParameterBag\ParameterBagInterface;
use Symfony\Component\Filesystem\Filesystem;
use Symfony\Component\HttpKernel\KernelInterface;
use Symfony\Component\Process\PhpExecutableFinder;
use Symfony\Component\Process\Process;

/**
 * ユニサーチ商品フィード連携バッチ用のサービス
 */
class UniSearchExportService
{
    private const COMPRESS_GZIP = 'gzip';
    private const BACKUP_KEEP_COUNT = 5;
    private string $workDir;
    private string $lockFile;
    private string $projectDir;
    private string $cdnBaseUrl;
    private string $s3Endpoint;
    private string $awsS3Bucket;
    /**
     * @var array<string, array{hierarchicalCategoryIds: array<int, int>, hierarchicalCategoryName: string, hierarchicalCategoryNameEn: string}>|null
     */
    private ?array $hierarchicalCategories = null;
    private int $workerCount;
    private string $phpBinary;

    public function __construct(
        private readonly ProductClassRepository $productClassRepository,
        private readonly CategoryRepository $categoryRepository,
        private readonly UniSearchSftpService $sftpService,
        private readonly Filesystem $filesystem,
        ParameterBagInterface $params,
        KernelInterface $kernel,
    ) {
        $this->projectDir = $kernel->getProjectDir();
        $this->workDir = $this->projectDir.'/var/unisearch/';
        $this->filesystem->mkdir([$this->workDir]);
        $this->lockFile = $this->workDir.'unisearch.lock';
        $this->cdnBaseUrl = (string) $params->get('cdn_base_url');
        $this->s3Endpoint = (string) $params->get('s3_endpoint');
        $this->awsS3Bucket = (string) $params->get('aws_s3_bucket');
        $this->workerCount = max(1, (int) $params->get('eccube_unisearch_export_workers'));
        $this->phpBinary = (new PhpExecutableFinder())->find() ?: 'php';
    }

    public function exportAndUpload(bool $isManualExecution = false): int
    {
        $executionTime = new \DateTimeImmutable('now');
        $lockHandle = $this->acquireLock();
        if ($lockHandle === null) {
            log_warning('Unisearch 商品フィードTSV出力処理は既に実行中のためスキップしました。');

            return 0;
        }
        $this->deleteExistingOutputFiles();
        $baseFileName = 'feed_hareruyamtgecc_'.$executionTime->format('YmdHis');
        $baseDoneFileName = 'done_hareruyamtgecc_'.$executionTime->format('YmdHis');

        $tsvPath = $this->workDir.$baseFileName.'.tsv';
        $donePath = $this->workDir.$baseDoneFileName.'.txt';

        try {
            $this->deleteOldBackupFiles();

            $total = $this->exportTsvBySql($tsvPath);
            if ($total === 0) {
                $this->filesystem->dumpFile($tsvPath, '');
                log_info('出力対象が0件のため空ファイルを作成しました。', ['path' => $tsvPath]);
            }

            $gzipPath = $this->compressFile($tsvPath, self::COMPRESS_GZIP);

            $md5 = md5_file($gzipPath);
            $this->filesystem->dumpFile($donePath, $md5);
            log_info('.doneファイルを生成しました。', ['path' => $donePath, 'md5' => $md5]);

            log_info('バックアップファイルを作成しました。', ['path' => $gzipPath]);
            $this->applyPermissions([$tsvPath, $gzipPath, $donePath]);

            if (!$isManualExecution) {
                if (!$this->sftpService->deleteRemoteByPrefixes(['feed_hareruyamtg_', 'done_hareruyamtg_'])) {
                    throw new \RuntimeException('SFTP既存ファイルの削除に失敗しました。');
                }
                if (!$this->sftpService->upload($gzipPath)) {
                    throw new \RuntimeException('SFTPアップロードに失敗しました。');
                }
                if (!$this->sftpService->upload($donePath)) {
                    throw new \RuntimeException('SFTPアップロードに失敗しました。');
                }
                log_info('生成したファイルをSFTPにアップロードしました。');
            } else {
                log_info('手動実行モードのため、SFTPアップロードをスキップしました。');
            }
        } catch (\Throwable $e) {
            log_error('ユニサーチ商品フィード連携処理でエラーが発生しました。', [
                'error' => $e->getMessage(),
                'trace' => $e->getTraceAsString(),
            ]);
            throw $e;
        } finally {
            $this->releaseLock($lockHandle);
        }

        return $total;
    }

    /**
     * @return array<int, string>
     */
    public function getHeader(): array
    {
        return [
            'product',
            'product_name',
            'product_name_en',
            'color_sequence',
            'card_name',
            'language',
            'price',
            'image_url',
            'tag',
            'cardset',
            'cardset_name',
            'cardset_name_en',
            'release_date',
            'color',
            'mana_cost',
            'rarity',
            'card_type',
            'subtype',
            'format',
            'illustrator',
            'foil_flg',
            'text_jp',
            'text_en',
            'stock',
            'weekly_sales',
            'category_id',
            'category_name',
            'category_name_en',
            'product_class',
            'card_condition',
            'sale_flg',
            'high_price_code',
            'belt_url',
            'color_identity',
            'product_code',
            'is_branch_published',
            'frame_flg',
            'buy_price',
            'reservation_flg',
            'search_word',
        ];
    }

    private function exportTsvBySql(string $tsvPath): int
    {
        if ($this->workerCount <= 1) {
            return $this->exportTsvBySqlSequential($tsvPath);
        }

        return $this->exportTsvBySqlParallel($tsvPath);
    }

    private function exportTsvBySqlSequential(string $tsvPath): int
    {
        $file = new \SplFileObject($tsvPath, 'w');
        $file->fwrite($this->buildTsvLine($this->normalizeRowToUtf8($this->getHeader())));

        $count = 0;
        foreach ($this->buildExportRanges() as $range) {
            $count = $this->writeSqlRows(
                $file,
                $this->productClassRepository->iterateUniSearchFeedRows(
                    $range['high_price_only'],
                    $range['min_id'],
                    $range['max_id']
                ),
                $count
            );
        }

        if ($count === 0) {
            $file->ftruncate(0);
        }

        return $count;
    }

    private function exportTsvBySqlParallel(string $tsvPath): int
    {
        $this->filesystem->dumpFile($tsvPath, $this->buildTsvLine($this->normalizeRowToUtf8($this->getHeader())));

        $ranges = $this->buildExportRanges();
        $partFiles = [];
        $queue = new \SplQueue();
        foreach ($ranges as $index => $range) {
            $partPath = $this->workDir.'feed_part_'.$index.'.tsv';
            $partFiles[$index] = $partPath;
            $queue->enqueue([
                'index' => $index,
    {
        $conn = $this->getEntityManager()->getConnection();
        $sql = $this->getUniSearchFeedSql($highPriceOnly);

        $params = [
            'status' => ProductStatus::DISPLAY_SHOW,
            'min_price' => 1,
            'card_condition_nm' => MtbCardCondition::CODE_NEAR_MINT,
            'empty_value' => '',
            'ban_id' => MtbRestriction::BAN_ID,
            'min_id' => $minId,
            'max_id' => $maxId,
            'mainBaseInfoId' => BaseInfo::TC_TOKYO_ID,
            'ecSalesLocation' => DtbSalesQuantity::SALES_LOCATION_ECCUBE,
        ];

        return $conn->iterateAssociative($sql, $params);
    }

    private function getUniSearchFeedSql(bool $highPriceOnly): string
    {
        $eccubeStockLocationId = ProductStock::STOCK_LOCATION_ECCUBE;

        $highPriceCondition = $highPriceOnly
            ? '(pc.high_price_code IS NOT NULL AND pc.high_price_code <> :empty_value)'
            : '((pc.high_price_code IS NULL OR pc.high_price_code = :empty_value) AND cc.code = :card_condition_nm)';

        $stockCte = $highPriceOnly
            ? <<<SQL
stock_agg AS (
    SELECT
        pc.id AS product_class_id,
        string_agg(
            DISTINCT ps.base_info_id::text,
            E'\\x01' ORDER BY ps.base_info_id::text
        ) FILTER (
            WHERE ps.base_info_id IS NOT NULL
                AND (pc.stock_unlimited OR COALESCE(ps.stock, 0) >= 1)
        ) AS stock
    FROM dtb_product_class pc
    LEFT JOIN dtb_product_stock ps ON ps.product_class_id = pc.id
        AND ps.stock_location_id = {$eccubeStockLocationId}
    WHERE pc.high_price_code IS NOT NULL AND pc.high_price_code <> :empty_value
    GROUP BY pc.id
),
SQL
            : <<<SQL
stock_agg AS (
    SELECT
        s.product_id,
        s.language_id,
        string_agg(
            DISTINCT s.base_info_id::text,
            E'\\x01' ORDER BY s.base_info_id::text
        ) FILTER (WHERE s.base_info_id IS NOT NULL AND (s.stock_unlimited OR s.stock >= 1)) AS stock
    FROM (
        SELECT
            pc.product_id,
            pc.language_id,
            ps.base_info_id,
            SUM(COALESCE(ps.stock, 0)) AS stock,
            BOOL_OR(pc.stock_unlimited) AS stock_unlimited
        FROM dtb_product_class pc
        LEFT JOIN dtb_product_stock ps ON ps.product_class_id = pc.id
            AND ps.stock_location_id = {$eccubeStockLocationId}
        WHERE pc.high_price_code IS NULL OR pc.high_price_code = :empty_value
        GROUP BY pc.product_id, pc.language_id, ps.base_info_id
    ) s
    GROUP BY s.product_id, s.language_id
),
SQL;
        $stockJoin = $highPriceOnly
            ? 'LEFT JOIN stock_agg stock ON stock.product_class_id = pc.id'
            : 'LEFT JOIN stock_agg stock ON stock.product_id = pc.product_id AND stock.language_id = pc.language_id';

        /** @lang SQL */
        return <<<SQL
        WITH category_agg AS (
            SELECT
                c.product_id,
                string_agg(c.category_id::text, ',' ORDER BY c.category_id::text) AS category_id,
                string_agg(c.category_name, ',' ORDER BY c.category_id::text) AS category_name,
                string_agg(c.category_name_en, ',' ORDER BY c.category_id::text) AS category_name_en
            FROM (
                SELECT DISTINCT
                    pct.product_id,
                    pct.category_id,
                    ct.category_name,
                    ct.category_name_en
                FROM dtb_product_category pct
                JOIN dtb_category ct ON ct.id = pct.category_id
            ) c
            GROUP BY c.product_id
        ),
        tag_agg AS (
            SELECT
                pt.product_id,
                string_agg(DISTINCT pt.tag_id::text, E'\\x01') AS tag
            FROM dtb_product_tag pt
            GROUP BY pt.product_id
        ),
        color_agg AS (
            SELECT
                dcc.card_id,
                string_agg(DISTINCT dcc.color_id::text, E'\\x01') AS color
            FROM dtb_card_color dcc
            GROUP BY dcc.card_id
        ),
        color_identity_agg AS (
            SELECT
                dcci.card_id,
                string_agg(DISTINCT dcci.color_id::text, E'\\x01') AS color_identity
            FROM dtb_card_color_identity dcci
            GROUP BY dcci.card_id
        ),
        cardtype_agg AS (
            SELECT
                dct.card_id,
                string_agg(DISTINCT dct.cardtype_id::text, E'\\x01') AS card_type
            FROM dtb_card_cardtype dct
            GROUP BY dct.card_id
        ),
        subtype_agg AS (
            SELECT
                dst.card_id,
                string_agg(DISTINCT dst.subtype_id::text, E'\\x01') AS subtype
            FROM dtb_card_subtype dst
            GROUP BY dst.card_id
        ),
        format_agg AS (
            SELECT
                cf.card_id,
                string_agg(
                    DISTINCT (cf.format_id::text || CASE WHEN cf.restriction_id = :ban_id THEN 'BAN' ELSE 'LEGAL' END),
                    E'\\x01'
                ) AS format
            FROM dtb_card_format cf
            GROUP BY cf.card_id
        ),
        {$stockCte}
        image_first AS (
            SELECT DISTINCT ON (pi.product_id)
                pi.product_id,
                pi.file_name,
                pi.object_key
            FROM dtb_product_image pi
            ORDER BY pi.product_id, pi.sort_no ASC, pi.id ASC
        ),
        class_image_first AS (
            SELECT DISTINCT ON (pci.product_class_id)
                pci.product_class_id,
                pi.file_name,
                pi.object_key
            FROM dtb_product_class_image pci
            JOIN dtb_product_image pi ON pi.id = pci.product_image_id
            ORDER BY pci.product_class_id, pci.rank ASC, pci.product_image_id ASC
        )
        SELECT
            p.id AS product,
            p.name AS product_name,
            p.name_en AS product_name_en,
            c.color_sequence_id AS color_sequence,
            c.name_en AS card_name,
            pc.language_id AS language,
            pc.price02 AS price,
            COALESCE(ci.file_name, img.file_name) AS image_file_name,
            COALESCE(ci.object_key, img.object_key) AS image_object_key,
            tag.tag AS tag,
            cs.id AS cardset,
            cs.name_jp AS cardset_name,
            cs.name_en AS cardset_name_en,
            cs.release_date AS release_date,
            color.color AS color,
            c.cmc AS mana_cost,
            cd.rarity_id AS rarity,
            cardtype.card_type AS card_type,
            subtype.subtype AS subtype,
            fmt.format AS format,
            cd.illustrator_id AS illustrator,
            cd.foil_flg AS foil_flg,
            cd.text_jp AS text_jp,
            cd.text_en AS text_en,
            stock.stock AS stock,
            COALESCE((
                SELECT sq.sales_quantity_04
                FROM dtb_sales_quantity sq
                WHERE sq.product_class_id = pc.id
                  AND sq.base_info_id = :mainBaseInfoId
                  AND sq.sales_location = :ecSalesLocation
            ), 0) AS weekly_sales,
            category.category_id AS category_id,
            category.category_name AS category_name,
            category.category_name_en AS category_name_en,
            pc.id AS product_class,
            pc.card_condition_id AS card_condition,
            CASE WHEN pc.sale_flg THEN '1' ELSE '0' END AS sale_flg,
            pc.high_price_code AS high_price_code,
            pc.belt_url AS belt_url,
            color_identity.color_identity AS color_identity,
            pc.product_code AS product_code,
            CASE WHEN p.is_branch_published THEN '1' ELSE '0' END AS is_branch_published,
            cd.frame_flg AS frame_flg,
            pc.buy_price AS buy_price,
            CASE WHEN sg.reservation_flg = 1 THEN '1' ELSE '0' END AS reservation_flg,
            p.search_word AS search_word
        FROM dtb_product_class pc
        JOIN dtb_product p ON p.id = pc.product_id
        LEFT JOIN mtb_card_condition cc ON cc.id = pc.card_condition_id
        LEFT JOIN mtb_card_detail cd ON cd.id = p.card_detail_id
        LEFT JOIN mtb_card c ON c.id = cd.card_id
        LEFT JOIN mtb_cardset cs ON cs.id = cd.cardset_id
        LEFT JOIN mtb_sell_group sg ON sg.id = p.sell_group_id
        LEFT JOIN tag_agg tag ON tag.product_id = p.id
        LEFT JOIN category_agg category ON category.product_id = p.id
        LEFT JOIN color_agg color ON color.card_id = c.id
        LEFT JOIN color_identity_agg color_identity ON color_identity.card_id = c.id
        LEFT JOIN cardtype_agg cardtype ON cardtype.card_id = c.id
        LEFT JOIN subtype_agg subtype ON subtype.card_id = c.id
        LEFT JOIN format_agg fmt ON fmt.card_id = c.id
        {$stockJoin}
        LEFT JOIN image_first img ON img.product_id = p.id
        LEFT JOIN class_image_first ci ON ci.product_class_id = pc.id
        WHERE
            pc.visible = true
            AND p.product_status_id = :status
            AND pc.price02 >= :min_price
            AND p.id > COALESCE(:min_id, 0)
            AND p.id <= COALESCE(:max_id, 2147483647)
            AND {$highPriceCondition}
        ORDER BY pc.id ASC
        SQL;

