                                       \u003c/div\u003e\n                                                                                    \u003cdiv class\u003d\"d-inline-block mb-2 me-2\"\u003e\n                                                \u003cbutton class\u003d\"btn btn-outline-secondary\" type\u003d\"button\"\n                                                        data-tag-id\u003d\"1\"\u003e新商品\u003c/button\u003e\n                                            \u003c/div\u003e\n                                                                            \n                                    \u003cdiv class\u003d\"d-block mb-3\" data-bs-toggle\u003d\"collapse\" href\u003d\"#allTags\" role\u003d\"button\"\n                                         aria-expanded\u003d\"false\" aria-controls\u003d\"allTags\"\u003e\u003c/div\u003e\n                                \u003c/div\u003e\n\n                                \u003cdiv class\u003d\"d-block text-center\"\u003e\n                                    \u003ca href\u003d\"/admin/product/tag\"\n                                       class\u003d\"btn w-100 btn-ec-regular\"\n                                       data-action\u003d\"confirm\"\n                                       title\u003d\"タグ管理に移動します。編集内容を保存してから移動しますか？\"\u003eタグの追加・編集\u003c/a\u003e\n                                \u003c/div\u003e\n                            \u003c/div\u003e\n                        \u003c/div\u003e\n                    \u003c/div\u003e\n                    \u003cdiv class\u003d\"card rounded border-0 mb-4\"\u003e\n                        \u003cdiv class\u003d\"card-header\"\u003e\n                            \u003cdiv class\u003d\"row\"\u003e\n                                \u003cdiv class\u003d\"col-8\"\u003e\n                                    \u003cspan class\u003d\"card-title\"\u003e登録日・更新日\u003c/span\u003e\n                                \u003c/div\u003e\n                                \u003cdiv class\u003d\"col-4 text-e