namespace Eccube\Repository;

use Doctrine\DBAL\ParameterType;
use Doctrine\Persistence\ManagerRegistry;
use Eccube\Entity\BaseInfo;
use Eccube\Entity\DtbWaitingNumberCounter;

/**
 * @extends AbstractRepository<DtbWaitingNumberCounter>
 */
class DtbWaitingNumberCounterRepository extends AbstractRepository
{
    public function __construct(ManagerRegistry $registry)
    {
        parent::__construct($registry, DtbWaitingNumberCounter::class);
    }

    /**
     * 店別の店舗販売用整理番号番号を発番する
     *
     * 本メソッド内では追加のアプリケーション排他は行わない。
     * （PostgreSQLのON CONFLICTによるアトミックな排他制御のみを利用）
     *
     * @param BaseInfo $BaseInfo
     *
     * @return int
     */
    public function nextValue(BaseInfo $BaseInfo): int
    {
        $connection = $this->getEntityManager()->getConnection();

        $sql = <<<'SQL'
INSERT INTO dtb_waiting_number_counter (base_info_id, current_value)
VALUES (:base_info_id, 1)
ON CONFLICT (base_info_id)
DO UPDATE SET current_value = dtb_waiting_number_counter.current_value + 1
RETURNING current_value
SQL;

        $nextValue = $connection->fetchOne(
            $sql,
            ['base_info_id' => $BaseInfo->getId()],
            ['base_info_id' => ParameterType::INTEGER]
        );

        return (int) $nextValue;
    }

    /**
     * 店舗販売用整理番号カウンタを初期化
     *
     * @return void
     */
    public function truncateWaitingNumberCounter(): void
    {
        $connection = $this->getEntityManager()->getConnection();
        $connection->executeStatement('TRUNCATE TABLE dtb_waiting_number_counter');
    }
}
