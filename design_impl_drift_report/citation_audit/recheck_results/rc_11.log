        // 商品IDの最大値を取得
        $maxProductId= $app['hareruya_ec.repository.product']->getMaxProductId();
        // 一回で取得する商品IDの範囲
        $batchSize = (int)($maxProductId / self::BATCH_NUMBER);

        // TSVファイルの作成
        fputcsv($fpTsv, self::TSV_HEADER, "\t");
        for ($i = 0; $i <= self::BATCH_NUMBER; $i++) {
            $min = $i * $batchSize;
            $max = $min + $batchSize;
            $products = $app['hareruya_ec.repository.product_sub_class']->getProductUnicodeFeed($min, $max);
            foreach ($products as $counter => $record) {
                $product = $record[$counter];
                $hierarchicalCategoryIds = [];
                $hierarchicalCategoryNames = [];
                $imageUrls = explode(',', $product['image_url']);
                if (!empty($imageUrls)) {
                    $product['image_url'] = $this->getS3RootPath($imageUrls[0]);
                }
                $product['product_name'] = str_replace(["\t", "\r\n", "\n", "\r"], '', $product['product_name']);
                $product['product_name_en'] = str_replace(["\t", "\r\n", "\n", "\r"], '', $product['product_name_en']);
                $product['text_jp'] = str_replace(["\t"], '', str_replace(["\r\n", "\n", "\r"], '\n', $product['text_jp']));
                $product['tag'] = implode("\x01", explode(',', $product['tag']));
                $product['color'] = implode("\x01", explode(',', $product['color']));
                $product['color_identity'] = implode("\x01", explode(',', $product['color_identity']));
                $product['card_type'] = implode("\x01", explode(',', $product['card_type']));
                $product['subtype'] = implode("\x01", explode(',', $product['subtype']));
                $product['format'] = implode("\x01", explode(',', $product['format']));
                $search_word = str_replace(["\t", "\r\n", "\n", "\r"], '', $product['search_word']);
                $product['search_word'] = implode("\x01", explode(',', $search_word));

                // カテゴリの処理
                $categoryIds = explode(',', $product['category_id']);
                // 各カテゴリの親カテゴリのIdリストの配列を作成
                foreach ($categoryIds as $categoryId) {
                    $hierarchicalCategoryIds[] = $hierarchicalCategories[$categoryId]['hierarchicalCategoryIds'];
                }
                // Idリストの長い順にソート
                array_multisort(array_map("count", $hierarchicalCategoryIds), SORT_DESC, $hierarchicalCategoryIds);
                // 階層が重複しないカテゴリIDの配列を作成
                $uniqueCategoryIdsArray = [];
                foreach ($hierarchicalCategoryIds as $caregoryIdList) {
                    $isInclude = false;
                    foreach ($uniqueCategoryIdsArray as $includeIdList) {
                        if (in_array($caregoryIdList[array_key_last($caregoryIdList)], $includeIdList, true)) {
                            $isInclude = true;
                            break;
                        }
                    }
                    if (!$isInclude) {
                        $uniqueCategoryIdsArray[] = $caregoryIdList;
                        $hierarchicalCategoryNames[] = $hierarchicalCategories[$caregoryIdList[array_key_last($caregoryIdList)]]['hierarchicalCategoryName'];
                    }
