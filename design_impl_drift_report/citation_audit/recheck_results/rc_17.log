from html.parser import HTMLParser
from pathlib import Path
import base64, re
TARGET={11,12,13,15,17,18}
out=Path('/tmp/rc17_images'); out.mkdir(exist_ok=True)
class P(HTMLParser):
    def __init__(self):
        super().__init__(); self.sheet=None; self.fig=None; self.count={x:0 for x in TARGET}
    def handle_starttag(self,tag,attrs):
        a=dict(attrs)
        if tag=='section' and a.get('id','').startswith('sheet-'):
            try: self.sheet=int(a['id'].split('-')[1])
            except: self.sheet=None
        if self.sheet not in TARGET: return
        if tag=='figure' and 'sheet-image' in a.get('class','').split():
            self.count[self.sheet]+=1
            self.fig={'n':self.count[self.sheet],'ref':a.get('data-excel-ref')}
        elif tag=='img' and self.fig:
            src=a.get('src',''); ref=self.fig['ref']; n=self.fig['n']
            print(f\"sheet-{self.sheet} fig{n} ref={ref} alt={a.get('alt')} width={a.get('width')} data={src.startswith('data:')}\")
