    d=dict(a)
    if t=='span' and d.get('data-excel-ref'): self.ref=d['data-excel-ref']; self.buf=[]
  def handle_data(self,d):
    if self.ref: self.buf.append(d)
  def handle_endtag(self,t):
    if t=='span' and self.ref:
      v=' '.join(''.join(self.buf).split())
