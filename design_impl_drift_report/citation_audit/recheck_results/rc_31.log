@@ -0,0 +1,77 @@
+import base64
+import pathlib
+import re
+import sys
+from html.parser import HTMLParser
+
+
+class SheetExtractor(HTMLParser):
+    def __init__(self, target_id: str, out_dir: pathlib.Path, prefix: str):
+        super().__init__(convert_charrefs=True)
+        self.target_id = target_id
+        self.out_dir = out_dir
+        self.prefix = prefix
+        self.depth = 0
+        self.in_target = False
+        self.target_depth = None
+        self.img_count = 0
+        self.src_depths = []
+        self.src_refs = []
+        self.src_text = []
+
+    def handle_starttag(self, tag, attrs):
+        self.depth += 1
+        values = dict(attrs)
+        if tag == "section" and values.get("id") == self.target_id:
+            self.in_target = True
+            self.target_depth = self.depth
+        if not self.in_target:
+            return
+        classes = values.get("class", "").split()
+        if tag == "span" and "src-cell" in classes:
+            self.src_depths.append(self.depth)
+            self.src_refs.append(values.get("data-excel-ref", ""))
+            self.src_text.append("")
+        if tag == "img" and "image-layer-img" in classes:
+            src = values.get("src", "")
+            if src.startswith("data:image/") and ";base64," in src:
+                header, encoded = src.split(",", 1)
+                ext = header.split("/")[1].split(";")[0]
+                self.img_count += 1
+                path = self.out_dir / f"{self.prefix}_{self.target_id}_{self.img_count}.{ext}"
+                path.write_bytes(base64.b64decode(encoded))
+
+    def handle_data(self, data):
+        if self.in_target and self.src_depths:
+            self.src_text[-1] += data
+
+    def handle_endtag(self, tag):
+        if self.in_target and tag == "span" and self.src_depths and self.src_depths[-1] == self.depth:
+            ref = self.src_refs.pop()
+            text = self.src_text.pop().strip()
+            self.src_depths.pop()
+            if text:
+                print(f"{ref}\t{text}")
+        if self.in_target and tag == "section" and self.depth == self.target_depth:
+            self.in_target = False
+        self.depth -= 1
+
+
+html_path = pathlib.Path(sys.argv[1])
+target_id = sys.argv[2]
+out_dir = pathlib.Path(sys.argv[3])
+out_dir.mkdir(parents=True, exist_ok=True)
+source = html_path.read_text(encoding="utf-8")
+start_match = re.search(
+    rf'<section class="sheet-panel" id="{re.escape(target_id)}">', source
+)
+if start_match is None:
+    raise SystemExit(f"sheet not found: {target_id}")
+next_match = re.search(
+    r'<section class="sheet-panel" id="sheet-\d+">', source[start_match.end():]
+)
+end = start_match.end() + next_match.start() if next_match else len(source)
+fragment = source[start_match.start():end]
+parser = SheetExtractor(target_id, out_dir, html_path.stem[:4])
+parser.feed(fragment)
+print(f"IMAGES\t{parser.img_count}", file=sys.stderr)

