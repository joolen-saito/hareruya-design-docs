   303	
   304	        $outerQb = $connection->createQueryBuilder();
   305	        $outerQb
   306	            ->select('*')
   307	            ->from('('.$innerQb->getSQL().')', 'modal_line_items_limited')
   308	            ->setParameters($innerQb->getParameters(), $innerQb->getParameterTypes())
   309	            ->orderBy('modal_line_items_limited.sort_approved_date', 'DESC')
   310	            ->addOrderBy('modal_line_items_limited.sort_registered_date', 'ASC')
   311	            ->addOrderBy('modal_line_items_limited.sort_sal_id', 'ASC')
   312	            ->addOrderBy('modal_line_items_limited.sort_sad_id', 'DESC');
   313	
   314	        return $outerQb;
   315	    }
