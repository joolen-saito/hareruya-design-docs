   296	    public function createDbalQueryBuilderForStockEditLineItems(array $approvalListIds, int $limit): DbalQueryBuilder
   297	    {
   298	        $connection = $this->getEntityManager()->getConnection();
   299	
   300	        $innerQb = $this->createStockEditLineItemsQueryBuilder($approvalListIds);
   301	        // サブクエリで全体件数を制限した上で、KnpPaginatorによってページングさせる
