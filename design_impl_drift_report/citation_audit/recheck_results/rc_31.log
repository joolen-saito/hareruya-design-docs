    19	use Eccube\Entity\DtbCsvExtension;
    20	
    21	/**
    22	 * @extends AbstractRepository<DtbCsvExtension>
    23	 */
    24	class DtbCsvExtensionRepository extends AbstractRepository
    25	{
    26	    public function __construct(ManagerRegistry $registry)
    27	    {
    28	        parent::__construct($registry, DtbCsvExtension::class);
    29	    }
    30	
    31	    /**
    32	     * @return DtbCsvExtension[]
    33	     */
    34	    public function findActiveByCsvTypeId(int $csvTypeId): array
    35	    {
    36	        return $this->createQueryBuilder('e')
    37	            ->innerJoin('e.CsvType', 't')
    38	            ->where('t.id = :csvTypeId')
    39	            ->andWhere('e.deleted_at IS NULL')
    40	            ->setParameter('csvTypeId', $csvTypeId)
    41	            ->orderBy('e.id', 'ASC')
    42	            ->getQuery()
    43	            ->getResult();
    44	    }
    45	}

