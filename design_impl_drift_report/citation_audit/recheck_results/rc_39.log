    /**
     * 商品一覧画面.
     *
     * path を pf-eccube3 に合わせて /products/search に変更している。
     * name と twig が path に一致していないが、影響範囲が広い為 list のままとしている。
     *
     * @return array<string, mixed> product_list_page_products: 当ページの Product 配列（list.twig は pagination オブジェクトを使わない）.
     */
    #[Route(path: '/products/search', name: 'product_list', methods: ['GET'])]
    #[Route(path: '/products/search/cate/{categoryId}/tag/{tagId}', name: 'product_list_category_tag', requirements: ['categoryId' => '\d+', 'tagId' => '\d+(?:-\d+)*'], methods: ['GET'])]
    #[Route(path: '/products/search/cate/{categoryId}', name: 'product_list_category', requirements: ['categoryId' => '\d+'], methods: ['GET'])]
    #[Route(path: '/products/search/tag/{tagId}', name: 'product_list_tag', requirements: ['tagId' => '\d+(?:-\d+)*'], methods: ['GET'])]
    #[Template(template: 'Product/list.twig')]
    public function index(Request $request, PaginatorInterface $paginator, ?int $categoryId = null, ?string $tagId = null): array
    {
        if ($categoryId !== null) {
            $request->query->set('category', (string) $categoryId);
        }

        if ($tagId !== null) {
            // 単一ID(例: 1)/複数ID(例: 1-2-3)に関わらず、パスの {tagId} を tags[] 配列へ正規化する。
            // ここで用意したタグ配列がユニサーチパラメータの fq.tag に implode されて送信される。
            $request->query->set('tags', array_values(array_filter(explode('-', $tagId), static fn (string $v): bool => $v !== '')));
        }

        $this->frontProductSearchRequestQueryNormalizer->normalize($request);

        // Doctrine SQLFilter
        if ($this->BaseInfo->isOptionNostockHidden()) {
            $this->entityManager->getFilters()->enable('option_nostock_hidden');
        }

        // handleRequestは空のqueryの場合は無視するため
        if ($request->getMethod() === 'GET') {
            $request->query->set('pageno', $request->query->get('pageno', ''));
        }

        // フロント商品一覧は設計書に基づき、明示的な指定がない場合のデフォルト表示件数を 60 件とする。
        // マスタデータの sort_no 順に依存すると購入検索等の他画面にも影響するため、本画面のみで制御する。
        if (!$request->query->has('disp_number')) {
            $request->query->set('disp_number', (string) self::PAGE_SIZE);
        }

        // searchForm
        /** @var FormBuilderInterface $builder */
        $builder = $this->formFactory->createNamedBuilder('', SearchProductType::class);

     * @param FormInterface $form
     * @param BaseInfo $BaseInfo
     * @param string $originalBannerImage
     *
     * @return string|null
     */
    private function storeBannerImage(FormInterface $form, BaseInfo $BaseInfo, string $originalBannerImage): ?string
    {
        /** @var UploadedFile|null $imageFile */
        $imageFile = $form->get('image_file')->getData();
        if (empty($imageFile)) {
            return $BaseInfo->getBannerImage();
        }

        $adapter = $this->fileManager->getAdapter($this->eccubeConfig->get('default_file_adapter'));

        $extension = strtolower((string) $imageFile->getClientOriginalExtension());
        if ($extension === '') {
            $extension = 'jpg';
        }

        $fileName = sprintf('%s%d.%s', uniqid(), random_int(100, 999), $extension);
        $uploadDir = $this->eccubeConfig->get('branch_top_banner_directory').'/'.$BaseInfo->getHtmlClassName();

        try {
            $this->fileManager->uploadFile(
                $imageFile->getPathname(),
                $uploadDir,
                $fileName,
                $this->eccubeConfig->get('default_file_adapter'),
            );

            if ($originalBannerImage !== '' && $adapter->exists($originalBannerImage, [])) {
                $adapter->delete($originalBannerImage, []);
            }

            return $uploadDir.'/'.$fileName;
        } catch (\Throwable $e) {
            log_error('バナー画像のアップロードに失敗しました', ['exception' => $e->getMessage()]);

            return null;
        }
    }
