        $this->eventDispatcher->dispatch($event, EccubeEvents::ADMIN_CONTENT_BLOCK_EDIT_INITIALIZE);
        $html = $event->getArgument('html');

        $form = $builder->getForm();
        $form->get('block_html')->setData($html);

        $form->handleRequest($request);

        if ($form->isSubmitted() && $form->isValid()) {
            $Block = $form->getData();
            $Block->setDefaultFileName($Block->getFileName());
            $this->entityManager->persist($Block);
            $this->entityManager->flush();

            $dir = sprintf('%s/app/template/%s/Block',
                $this->getParameter('kernel.project_dir'),
                $this->getParameter('eccube.theme'));

            // ロケール対応ファイル名でダンプ・アップロード
            $localeFileName = $Block->getFileName().$localeSuffix;
            $file = $dir.'/'.$localeFileName.'.twig';

            $source = $form->get('block_html')->getData();
            $source = StringUtil::convertLineFeed($source);
            $fs->dumpFile($file, $source);

            $fileAdapter = $this->fileManager->getAdapter();
            $contentBucketOptions = $this->fileManager->getContentBucketOptions();
            $fileAdapter
                ->upload(
                    $file,
                    $this::BLOCK_PATH,
                    $localeFileName.'.twig',
                    $contentBucketOptions);

            $Block->saveFile($fileAdapter->toEntitySaveData());
            $Block->setPath($Block->getFileName());
            $Block->setFileName($Block->getDefaultFileName());
            $this->entityManager->flush();

            // 新規ブロック作成時は、もう一方のlocaleファイルも同じ内容で作成する
            if ($previousFileName === null) {
                $otherLocale = $locale === 'ja' ? 'en' : 'ja';
                $otherLocaleSuffix = '.'.$otherLocale;
                $otherLocaleFileName = $Block->getDefaultFileName().$otherLocaleSuffix.'.twig';
                $otherFilePath = $dir.'/'.$otherLocaleFileName;
                $fs->dumpFile($otherFilePath, $source);
                $fileAdapter->upload($otherFilePath, $this::BLOCK_PATH, $otherLocaleFileName, $contentBucketOptions);
            }

            // 更新でファイル名を変更した場合、以前のロケール対応ファイルを削除
            if (null !== $previousFileName && $Block->getFileName() !== $previousFileName) {
                $oldLocaleFileName = $previousFileName.$localeSuffix.'.twig';
                $old = $dir.'/'.$oldLocaleFileName;
                if ($fs->exists($old)) {
                    $fs->remove($old);
                }
                if ($fileAdapter->exists($this::BLOCK_PATH.$oldLocaleFileName, $contentBucketOptions)) {
                    $fileAdapter->delete($this::BLOCK_PATH.$oldLocaleFileName, $contentBucketOptions);
                } else {
                    log_error($this::BLOCK_PATH.$oldLocaleFileName.' はS3に存在しません');
                }
            }

            // キャッシュの削除
            $cacheUtil->clearTwigCache();
            $cacheUtil->clearDoctrineCache();

            $event = new EventArgs(
                [
                    'form' => $form,
                    'Block' => $Block,
                ],
                $request
            );
            $this->eventDispatcher->dispatch($event, EccubeEvents::ADMIN_CONTENT_BLOCK_EDIT_COMPLETE);

            $this->addSuccess('admin.common.save_complete', 'admin');

            return $this->redirectToRoute('admin_content_block_edit', ['id' => $Block->getId(), 'locale' => $locale]);

