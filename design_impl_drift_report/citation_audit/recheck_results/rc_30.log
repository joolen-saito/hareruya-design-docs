   143	        $fromShop = $Instruction->getMoveFromBaseInfo()->getShopName();
   144	        $toShop = $Instruction->getMoveToBaseInfo()->getShopName();
   145	
   146	        if ($moveFromShop !== null && $moveFromShop !== '' && (string) $fromShop !== $moveFromShop) {
   147	            $messageStore->addRawMessage(
   148	                $rowNumber.'行目: '.$this->translator->trans('admin.stock.move_instruction.csv_tracking_error_shop_mismatch_from', [], 'messages')
   149	            );
   150	
   151	            return false;
   152	        }
   153	        if ($moveToShop !== null && $moveToShop !== '' && (string) $toShop !== $moveToShop) {
   154	            $messageStore->addRawMessage(
   155	                $rowNumber.'行目: '.$this->translator->trans('admin.stock.move_instruction.csv_tracking_error_shop_mismatch_to', [], 'messages')
   156	            );
   157	
   158	            return false;
   159	        }
   160	
   161	        $trackingNoRaw = (string) $this->trackingNoColumn->getValue($row);
   162	        $trackingNoTrimmed = $this->trimOrNull($trackingNoRaw);
   163	        if ($trackingNoTrimmed === null || $trackingNoTrimmed === '') {
   164	            $messageStore->addRawMessage(
   165	                $rowNumber.'行目: '.$this->translator->trans('admin.stock.move_instruction.csv_tracking_error_tracking_no_empty', [], 'messages')
   166	            );
   167	
   168	            return false;
   169	        }
   170	
   171	        $maxLen = (int) $this->eccubeConfig['eccube_text_type_column_max_len'];
   172	        if (mb_strlen($trackingNoTrimmed) > $maxLen) {
   173	            $messageStore->addRawMessage(
   174	                $rowNumber.'行目: '.$this->translator->trans('admin.stock.move_instruction.tracking_no_max_length', [
   175	                    '%max%' => $maxLen,
   176	                ], 'messages')
   177	            );
   178	
   179	            return false;
   180	        }
   181	
   182	        $this->persistTrackingNo($Instruction, $trackingNoTrimmed, $event->getUpdateUser());
   183	
   184	        return true;
   185	    }
   186	
   187	    /**
   188	     * 列の定義を取得する。
   189	     *
   190	     * @return array<CsvColumnInterface>
   200	        if (!$hasData) {
   201	            $messageStore->addNoDataError();
   202	
   203	            return $messageStore->getMessages();
   204	        }
   205	
   206	        // エラーなし
   207	        return [];
   208	    }
   209	
   210	    /**
   211	     * 各行のデータをインポートする。
   212	     *
   213	     * @param CsvImportService $importService
   214	     *
   215	     * @return CsvImportResultInterface
   216	     *
   217	     * @throws \Exception
   218	     */
   219	    protected function importRows(CsvImportService $importService): CsvImportResultInterface
   220	    {
   221	        $headers = $importService->getColumnHeaders();
   222	        $this->em->getConnection()->beginTransaction();
   223	
   224	        try {
   225	            $defaultLockTimeout = SqlUtil::getLockTimeout($this->em);
   226	            SqlUtil::setLockTimeout($this->em, $this->getLockTimeout());
   227	
   228	            $messageStore = new MessageStore($this->translator);
   229	            $this->handler->onBeforeImport();
   230	
   231	            $hasBreak = false;
   232	            $importCount = 0;
   233	            foreach ($importService as $index => $row) {
   234	                $rowNumber = $index + 1;
   235	                $csvRow = new CsvRow($rowNumber, $row);
   236	                $csvRow->setHeaders($headers);
   237	                $event = new ReadCsvRowEvent($csvRow, $messageStore, $this->loginUser);
   238	
   239	                $this->handler->onValidateRow($event);
   240	                if ($event->isBreakAll()) {
   241	                    $hasBreak = true;
   242	                    break;
   243	                }
   244	                if ($event->isSkipRow()) {
   245	                    continue;
   246	                }
   247	
   248	                $event->clearNextAction();
   249	                $isOk = $this->handler->onReadRow($event);
   250	                if ($isOk) {
   251	                    $importCount++;
   252	                }
   253	
   254	                if ($index % $this->flushPerLines === 0) {
   255	                    $this->em->flush();
   256	                    $this->em->clear();
   257	                }
   258	
   259	                // onReadRow()内でbreakAll()が呼ばれる可能性があるため、チェックが必要
   260	                /** @phpstan-ignore-next-line */
   261	                if ($event->isBreakAll()) {
   262	                    $hasBreak = true;
   263	                    break;
   264	                }
   265	            }
   266	
   267	            $this->em->flush();
   268	            $this->em->clear();
   269	
   270	            $isSuccessful = $messageStore->count() === 0 || !$hasBreak;
   271	            if ($isSuccessful) {
   272	                $this->em->getConnection()->commit();
   273	            } else {
   274	                $this->em->getConnection()->rollback();
   275	            }
   276	
   277	            $this->handler->onAfterImport(new AfterReadEvent($isSuccessful, $importCount));
   278	
   279	            SqlUtil::setLockTimeout($this->em, $defaultLockTimeout);
   280	
   281	            $importResult = new CsvImportResult();
   282	            $importResult->setCount($importCount)
   283	                ->setErrors($messageStore->getMessages())
   284	                ->setInfos($messageStore->getInfos());
   285	
   286	            return $importResult;
   287	        } catch (\Exception $e) {
   288	            try {
   289	                $this->em->getConnection()->rollback();
   290	            } catch (ConnectionException $ce) {
   291	                // 元のエラーを throws するため、ロールバック時のエラーは無視する
   292	            }
   293	
   294	            throw $e;
   295	        }

diff --git a//tmp/extract_excel_images.py b//tmp/extract_excel_images.py
new file mode 100644
index 0000000000000000000000000000000000000000..df800433539ce7c307766061064c1efc4831a921
--- /dev/null
+++ b//tmp/extract_excel_images.py
@@ -0,0 +1,61 @@
+#!/usr/bin/env python3
+import base64
+import os
+import re
+import sys
+from html.parser import HTMLParser
+
+
+class ExcelImageParser(HTMLParser):
+    def __init__(self, output_dir, targets):
+        super().__init__(convert_charrefs=True)
+        self.output_dir = output_dir
+        self.targets = set(targets)
+        self.figure = None
+        self.figure_depth = 0
+        self.counts = {}
+
+    def handle_starttag(self, tag, attrs):
+        attrs = dict(attrs)
+        if tag == "figure":
+            sheet = attrs.get("data-excel-sheet")
+            self.figure_depth += 1
+            if sheet in self.targets:
+                self.figure = {
+                    "sheet": sheet,
+                    "ref": attrs.get("data-excel-ref", "unknown"),
+                    "order": attrs.get("data-image-order", "unknown"),
+                }
+        elif tag == "img" and self.figure:
+            src = attrs.get("src", "")
+            match = re.fullmatch(r"data:image/([^;]+);base64,(.*)", src, re.S)
+            if not match:
+                return
+            ext = "jpg" if match.group(1) == "jpeg" else match.group(1)
+            key = (self.figure["sheet"], self.figure["order"])
+            self.counts[key] = self.counts.get(key, 0) + 1
+            safe_sheet = re.sub(r"[^0-9A-Za-zぁ-んァ-ン一-龥_-]+", "_", self.figure["sheet"])
+            safe_ref = re.sub(r"[^0-9A-Za-z_-]+", "_", self.figure["ref"].split("!")[-1])
+            name = f"{safe_sheet}_order-{self.figure['order']}_{safe_ref}_layer-{self.counts[key]}.{ext}"
+            path = os.path.join(self.output_dir, name)
+            with open(path, "wb") as out:
+                out.write(base64.b64decode(match.group(2)))
+            print(path)
+
+    def handle_endtag(self, tag):
+        if tag == "figure":
+            if self.figure_depth == 1:
+                self.figure = None
+            self.figure_depth = max(0, self.figure_depth - 1)
+
+
+if len(sys.argv) < 4:
+    raise SystemExit("usage: extract_excel_images.py HTML OUTPUT_DIR SHEET...")
+
+html_path, output_dir, *targets = sys.argv[1:]
+os.makedirs(output_dir, exist_ok=True)
+parser = ExcelImageParser(output_dir, targets)
+with open(html_path, encoding="utf-8") as source:
+    for chunk in iter(lambda: source.read(1024 * 1024), ""):
+        parser.feed(chunk)
+parser.close()

