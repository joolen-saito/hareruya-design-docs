diff --git a//tmp/extract_excel_images.py b//tmp/extract_excel_images.py
new file mode 100644
index 0000000000000000000000000000000000000000..df800433539ce7c307766061064c1efc4831a921
--- /dev/null
+++ b//tmp/extract_excel_images.py
@@ -0,0 +1,61 @@
+#!/usr/bin/env python3
+import base64
+import os
+import re
+import sys
+from html.parser import HTMLParser
+
+
+class ExcelImageParser(HTMLParser):
+    def __init__(self, output_dir, targets):
+        super().__init__(convert_charrefs=True)
+        self.output_dir = output_dir
+        self.targets = set(targets)
+        self.figure = None
+        self.figure_depth = 0
+        self.counts = {}
+
+    def handle_starttag(self, tag, attrs):
+        attrs = dict(attrs)
+        if tag == "figure":
+            sheet = attrs.get("data-excel-sheet")
+            self.figure_depth += 1
+            if sheet in self.targets:
+                self.figure = {
+                    "sheet": sheet,
+                    "ref": attrs.get("data-excel-ref", "unknown"),
+                    "order": attrs.get("data-image-order", "unknown"),
+                }
+        elif tag == "img" and self.figure:
+            src = attrs.get("src", "")
+            match = re.fullmatch(r"data:image/([^;]+);base64,(.*)", src, re.S)
+            if not match:
+                return
+            ext = "jpg" if match.group(1) == "jpeg" else match.group(1)
+            key = (self.figure["sheet"], self.figure["order"])
+            self.counts[key] = self.counts.get(key, 0) + 1
+            safe_sheet = re.sub(r"[^0-9A-Za-zぁ-んァ-ン一-龥_-]+", "_", self.figure["sheet"])
+            safe_ref = re.sub(r"[^0-9A-Za-z_-]+", "_", self.figure["ref"].split("!")[-1])
+            name = f"{safe_sheet}_order-{self.figure['order']}_{safe_ref}_layer-{self.counts[key]}.{ext}"
+            path = os.path.join(self.output_dir, name)
+            with open(path, "wb") as out:
+                out.write(base64.b64decode(match.group(2)))
+            print(path)
+
+    def handle_endtag(self, tag):
+        if tag == "figure":
+            if self.figure_depth == 1:
+                self.figure = None
+            self.figure_depth = max(0, self.figure_depth - 1)
+
+
+if len(sys.argv) < 4:
+    raise SystemExit("usage: extract_excel_images.py HTML OUTPUT_DIR SHEET...")
+
+html_path, output_dir, *targets = sys.argv[1:]
+os.makedirs(output_dir, exist_ok=True)
+parser = ExcelImageParser(output_dir, targets)
+with open(html_path, encoding="utf-8") as source:
+    for chunk in iter(lambda: source.read(1024 * 1024), ""):
+        parser.feed(chunk)
+parser.close()

