1952-                  <tr data-shape-index="6" data-shape-ref="D37" data-excel-book="0505" data-excel-sheet="スマレジ受信処理" data-excel-ref="0505:スマレジ受信処理!D37"><td class="shape-ref">D37</td><td>取引完了</td></tr>
