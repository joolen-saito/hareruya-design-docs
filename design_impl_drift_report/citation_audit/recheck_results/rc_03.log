    31	    public function postPrintDirectAction(Request $request)
    32	    {
    33	        $connectionType = $request->get('ConnectionType');
    34	        if ($connectionType === 'GetRequest') {
    35	            // 印刷データ送信処理
    36	            $uri = $request->getUriForPath('/');
    37	            $xmlData = $this->sendXmlData($uri);
    38	
