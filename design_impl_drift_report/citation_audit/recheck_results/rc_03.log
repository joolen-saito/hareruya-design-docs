    67	    /**
    68	     * 印刷データを取得する
    69	     *
    70	     * @param string $uri
    71	     * @return string
    72	     */
    73	    private function sendXmlData(string $uri) : string
    74	    {
    75	        $orderDataList = $this->getDoctrine()->getRepository(DtbOrder::class)->getPrintOrderList();
    76	        if (empty($orderDataList)) {
    77	            return '';
    78	        }
    79	        $printList = [];
    80	        foreach ($orderDataList as $orderData) {
    81	            $printList[] = $this->getPrintData($orderData, $uri);
    82	        }
    83	        $xmlData = $this->getXmlData($printList);
    84	
    85	        return $xmlData;
    86	    }
