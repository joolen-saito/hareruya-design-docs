    29	
    30	/**
    31	 * disposed (廃棄返品) スマレジ取引に対する ECCUBE 受注側の取消反映を行う。
    32	 *
    33	 * 廃棄取引の transactionHeadId は廃棄取引自体の ID なので、
    34	 * disposeServerTransactionHeadId を打消元 (元取引) のキーに使って Order を引き当てる。
    35	 *
    36	 * canceled と挙動は同一 (OrderItem 全件 rollback + status CANCEL)。
    37	 * ついで買い分の在庫整合性はスマレジから別途送られる在庫変動 webhook で取られる前提。
    38	 */
    39	final readonly class SmaregiTransactionDisposedProcessor
    40	{
    41	    public function __construct(
    42	        private LoggerInterface $logger,
    43	        private EntityManagerInterface $entityManager,
    44	        private OrderRepository $orderRepository,
    45	        private OrderStatusRepository $orderStatusRepository,
    46	        private StockReduceProcessor $stockReduceProcessor,
    47	    ) {
    48	    }
    49	
    50	    public function process(SmaregiWebhookEvent $event, TransactionDto $transaction): void
    51	    {
    52	        $transactionHeadId = $transaction->transactionHeadId ?? '';
    53	        if ($transactionHeadId === '') {
    54	            $this->logger->warning('Smaregi disposed processor received a transaction with no transactionHeadId', [
    55	                'webhookEventId' => $event->getId(),
    56	            ]);
    57	
    58	            return;
    59	        }
    60	
    61	        if (!$transaction->isDisposed()) {
    62	            $this->logger->info('Smaregi disposed webhook received but disposeDivision is not 2, skipping', [
    63	                'webhookEventId' => $event->getId(),
    64	                'transactionHeadId' => $transactionHeadId,
    65	                'disposeDivision' => $transaction->disposeDivision,
    66	            ]);
    67	
    68	            return;
    69	        }
    70	
    71	        $originTransactionHeadId = $transaction->disposeServerTransactionHeadId;
    72	        if ($originTransactionHeadId === null || $originTransactionHeadId === '') {
    73	            $this->logger->warning('Smaregi disposed transaction has no disposeServerTransactionHeadId', [
    74	                'webhookEventId' => $event->getId(),
    75	                'transactionHeadId' => $transactionHeadId,
    76	            ]);
    77	
    78	            return;
    79	        }
    80	
    81	        $Order = $this->orderRepository->findOneBy(['smaregiTransactionId' => $originTransactionHeadId]);
    82	        if (!$Order instanceof Order) {
    83	            // TODO: webhook の到着順序が前後し、created がまだ届いていない場合のリカバリは別 PR (進捗管理 issue 候補参照)
    84	            $this->logger->warning('No matching ECCUBE order for disposed Smaregi transaction', [
    85	                'webhookEventId' => $event->getId(),
    86	                'transactionHeadId' => $transactionHeadId,
    87	                'disposeServerTransactionHeadId' => $originTransactionHeadId,
    88	            ]);
    89	
    90	            return;
    91	        }
    92	
    93	        if ($Order->getOrderStatus()?->getId() === OrderStatus::CANCEL) {
    94	            $this->logger->info('Order is already canceled, skipping', [
    95	                'webhookEventId' => $event->getId(),
    96	                'transactionHeadId' => $transactionHeadId,
    97	                'disposeServerTransactionHeadId' => $originTransactionHeadId,
    98	                'orderId' => $Order->getId(),
    99	            ]);
   100	
   101	            return;
   102	        }
   103	
   104	        $CancelStatus = $this->orderStatusRepository->find(OrderStatus::CANCEL);
   105	        if (!$CancelStatus instanceof OrderStatus) {
   106	            throw new \RuntimeException('OrderStatus CANCEL is not found.');
   107	        }
   108	
   109	        $this->stockReduceProcessor->rollback($Order, new PurchaseContext());
   110	        $Order->setOrderStatus($CancelStatus);
   111	        $this->entityManager->flush();
   112	
   113	        // CANCEL への遷移を反映して会員のスマレジ累計を洗い替える (打消分は集計対象から外れる)。
   114	        $Customer = $Order->getCustomer();
   115	        if ($Customer instanceof Customer) {
   116	            $this->orderRepository->updateSmaregiOrderSummary($Customer);
   117	            $this->entityManager->flush();
   118	        }
   119	
   120	        $this->logger->info('Smaregi disposed: order stock restored and status updated to CANCEL', [
   121	            'webhookEventId' => $event->getId(),
   122	            'transactionHeadId' => $transactionHeadId,
   123	            'disposeServerTransactionHeadId' => $originTransactionHeadId,
   124	            'orderId' => $Order->getId(),
   125	        ]);
   126	    }
   127	}
