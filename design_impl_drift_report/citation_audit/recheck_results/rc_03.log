    42	                if (!is_dir($dir)) {
    43	                    mkdir($dir, 0777, true);
    44	                }
    45	                $filename = $dir . 'print_' . date('Ymd_His') . '_' . uniqid() . '.xml';;
    46	                // ステータスがピック中だが未印刷という不具合再現待ちで停止
    47	                file_put_contents($filename, $xmlData);
    48	            }
    49	
    50	            $response = new StreamedResponse();
