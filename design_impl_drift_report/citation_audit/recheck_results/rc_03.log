/bin/bash -lc "python3 - <<'PY'
import re,html,pathlib
root=pathlib.Path('hareruya-design-docs/excel_to_html/output')
terms=['dtb_order_number','DtbOrderNumber','waiting_number','待ち番号','店頭注文番号','point_change','transaction_id','ポイント履歴','削除','認証','IP制限','アクセス制限','キャッシュ','CORS','Access-Control-Allow-Origin','application/json;charset','params','TransactionHead','try-catch','例外ハンドラ','悲観ロック','楽観ロック','排他','Cookie','ログ出力']
pat=re.compile(r'<["'^>]*data-excel-ref="([''^"]+)"[''^>]*>(.*?)</[''^>]+>'"',re.S)
for p in sorted(root.glob('*.html')):
 s=p.read_text(encoding='utf-8',errors='replace')
 hits=[]
 for m in pat.finditer(s):
  txt=' '.join(html.unescape(re.sub(r'<["'^>]+>'"',' ',m.group(2))).split())
  if any(t.lower() in txt.lower() for t in terms): hits.append((m.group(1),txt))
 if hits:
  print('\\nFILE',p.name)
  for ref,txt in hits: print(ref,repr(txt))
