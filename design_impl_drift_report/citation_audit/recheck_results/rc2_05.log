    /**
     * CSVデータ1行の形式をチェックする。
     *
     * @param ReadCsvRowEvent $event イベント
     */
    public function onValidateRow(ReadCsvRowEvent $event): void
    {
        parent::onValidateRow($event);

        if ($event->isBreakAll() || $event->isSkipRow()) {
            return;
        }

        // 振替元と振替先の商品が存在することを検証する。
        if (!$this->validateProductExists($event)) {
            $event->breakAll();
        }

        if (!$this->validateTransferQuantity($event)) {
            $event->breakAll();
        }
    }

    /**
     * CSVデータ1行を取り込む。
     *
     * @param ReadCsvRowEvent $event イベント
     *
     * @return bool 読み込みに成功した場合 true
     */
    public function onReadRow(ReadCsvRowEvent $event): bool
    {
        $row = $event->getRow();
        $fromProductCode = trim((string) $this->fromProductCodeColumn->getValue($row));
        $toProductCode = trim((string) $this->toProductCodeColumn->getValue($row));
        $quantity = trim((string) $this->transferQuantityColumn->getValue($row));

        $FromProductClass = $this->productClassRepository->findOneBy(
            [
                'code' => $fromProductCode,
            ]
        );

        $FromProductStock = $this->productStockRepository->findOneBy([
            'ProductClass' => $FromProductClass,
            'baseInfo' => $this->TransferBaseInfo,
            'stockLocationId' => $this->transferStockLocationId,
        ]);

        if ($FromProductStock === null) {
            throw new \Exception('振替元の商品在庫が見つかりません');
        }

        $ToProductClass = $this->productClassRepository->findOneBy(
            [
                'code' => $toProductCode,
            ]
        );

        $ToProductStock = $this->productStockRepository->findOneBy([
            'ProductClass' => $ToProductClass,
            'baseInfo' => $this->TransferBaseInfo,
            'stockLocationId' => $this->transferStockLocationId,
        ]);

        if ($ToProductStock === null) {
            throw new \Exception('振替先の商品在庫が見つかりません');
        }

        $transferQuantity = (string) $quantity;

        $standardPrice = $FromProductClass->getStandardPrice();
        $standardTotalPrice = bcmul((string) $standardPrice, $transferQuantity, 0);

        $fromOutboundTotalCost = $FromProductStock->getMovementTotalCost($transferQuantity);

        // 在庫振替明細を作成
        $this->stockMoveTransferDetailEntityManager->save(
            StockMoveTransferDetail: null,
            StockMoveTransfer: $this->StockMoveTransfer,
            MoveFromProductStock: $FromProductStock,
            MoveToProductStock: $ToProductStock,
            moveTransferQuantity: (int) $transferQuantity,
            standardTotalPrice: (string) $standardTotalPrice,
            outboundTotalCost: (string) $fromOutboundTotalCost,
        );

        $afterFromStock = $FromProductStock->getStockQuantityAfterChange(bcmul($transferQuantity, '-1', 0));
        $afterFromTotalCost = $FromProductStock->getTotalCostAfterChange(bcmul($transferQuantity, '-1', 0));

        // 在庫変動履歴を作成
        $this->stockHistoryEntityManager->save(
            ProductStock: $FromProductStock,
            StockChangeTypeDetail: $this->stockChangeTypeDetailRepository->find(MtbStockChangeTypeDetail::TRANSFER_OUTBOUND),
            oldStock: $FromProductStock->getStock(),
            stock: $afterFromStock,
            stockChangeQuantity: $transferQuantity,
            sellPrice: $FromProductClass->getPrice02(),
            unitCostPriceBefore: $FromProductStock->getUnitCost(),
            unitCostPriceAfter: $FromProductStock->getUnitCostPriceAfterChange($transferQuantity),
            totalCostPriceBefore: $FromProductStock->getTotalCost(),
            totalCostPriceAfter: (string) $afterFromTotalCost,
            stockChangeReason: '',
            shortageReason: null,
            HistorySourceType: $this->stockHistorySourceTypeRepository->find(MtbStockHistorySourceType::STOCK_TRANSFER_EDIT),
            historySourceId: $this->StockMoveTransfer->getId(),
            registeredAt: new \DateTime(),
            RegisteredMember: $this->Member,
            operatorMemberName: $this->Member->getName(),
        );

        // 在庫を更新
        $this->productStockEntityManager->save(
            ProductStock: $FromProductStock,
            ProductClass: $FromProductStock->getProductClass(),
            BaseInfo: $FromProductStock->getBaseInfo(),
            stock: $afterFromStock,
            pickUpFlg: $FromProductStock->getPickUpFlg(),
            stockLocationId: $FromProductStock->getStockLocationId(),
            totalCost: $afterFromTotalCost,
        );

        return true;
    }

    /**
     * 列の定義を取得する。
     *
     * @return array<CsvColumnInterface>
     */
    protected function getColumns(): array
    {
        return [
            $this->fromProductCodeColumn,
            $this->toProductCodeColumn,
            $this->transferQuantityColumn,
        ];
    }

    /**
     * 列を検証するロジックを取得する。
     *
     * @return array<RowValidatorInterface>
     */
    protected function getRowValidators(): array
    {
        return [];
    }

    private function initializeColumnDefinitions(): void
    {
        $this->fromProductCodeColumn = ColumnDefinitions::stockTransferFromProductCode()->setRequired(true);
        $this->toProductCodeColumn = ColumnDefinitions::stockTransferToProductCode()->setRequired(true);
        $this->transferQuantityColumn = ColumnDefinitions::stockTransferQuantity()->setRequired(true);
    }

    private function clearColumnDefinitions(): void
    {
        $this->fromProductCodeColumn = null;
        $this->toProductCodeColumn = null;
        $this->transferQuantityColumn = null;
    }

    /**
     * 商品の有無を検証する。
     */
    private function validateProductExists(ReadCsvRowEvent $event): bool
    {
        $row = $event->getRow();

        // 振替元の商品が存在することを検証する。
        $fromProductCode = trim((string) $this->fromProductCodeColumn->getValue($row));
        if (!$this->productClassRepository->existsByProductCode($fromProductCode)) {
            $event->getMessageStore()
                ->addProductNotExistsError(
                    $row->getRowNumber(),
                    $this->fromProductCodeColumn->getLabel()
                );
            $event->breakAll();

            return false;
        }


