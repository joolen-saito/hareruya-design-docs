                'placeholder' => ['year' => '----', 'month' => '--', 'day' => '--'],
                'constraints' => [
                    new Assert\Range([
                        'min' => '1900-01-01',
                        'minMessage' => 'form_error.out_of_range',
                        showStockHistoryReasonAlert(response.message || saveErrorMsg, true);
                    }
                }).fail(function(xhr) {
                    restoreReasonEditSnapshot($reasonEditContainer, $reasonDisplay, $reasonTextarea);
                    let message = saveErrorMsg;
                    if (xhr.responseJSON && xhr.responseJSON.message) {
                        message = xhr.responseJSON.message;
                    }
                    showStockHistoryReasonAlert(message, true);
                }).always(function() {
                    $reasonEditContainer.removeClass('is-saving');
                    setReasonEditToggleLoading($toggle, false);
                });
            });
        });
        const select2Ids = [
            '#admin_stock_history_base_info',
            '#admin_stock_history_stock_change_type_detail',
            '#admin_stock_history_category_id',
            '#admin_stock_history_cardset',
            '#admin_stock_history_create_source',
            '#admin_stock_history_create_department',
            '#admin_stock_history_create_notification_target_members',
            '#admin_stock_history_approval_department',
            '#admin_stock_history_approval_notification_target_members',
            '#admin_stock_history_update_department',
            '#admin_stock_history_update_notification_target_members',
        ];
        const select2Selector = $(select2Ids.join(','));
        select2Selector.select2({width:'100%'});

        const disposalStockChangeTypeDetailIds = [
            {{ constant('Eccube\\Entity\\Master\\MtbStockChangeTypeDetail::ORDER_STOCKOUT_DECREASE') }},
            {{ constant('Eccube\\Entity\\Master\\MtbStockChangeTypeDetail::MOVE_SHORTAGE_SUBTRACT') }},
        ];
        const $stockChangeTypeDetail = $('#admin_stock_history_stock_change_type_detail');
        const $disposalSearchCheckbox = $('input[name="admin_stock_history[disposal_search][]"]');
        const disposalSearchClearFieldSelectors = [
            '#admin_stock_history_purchase_unit_price_from',
            '#admin_stock_history_purchase_unit_price_to',
            '#admin_stock_history_stock_change_from',
            '#admin_stock_history_stock_change_to',
            '#admin_stock_history_unit_cost_from',
            '#admin_stock_history_unit_cost_to',
            '#admin_stock_history_cost_rate_from',
            '#admin_stock_history_cost_rate_to',
            '#admin_stock_history_approval_date_from',
            '#admin_stock_history_approval_date_to',
            '#admin_stock_history_approval_department',
            '#admin_stock_history_approval_notification_target_members',
        ];

        function clearFieldValue($field) {
            if ($field.is('select')) {
                $field.val(null).trigger('change');
            } else if ($field.is(':checkbox') || $field.is(':radio')) {
                $field.prop('checked', false);
            } else {
                $field.val('');
            }
        }

        function setFieldDisabled($field, isDisabled) {
            $field.prop('disabled', isDisabled);
            if ($field.is('select') && $field.hasClass('select2-hidden-accessible')) {
                $field.trigger('change.select2');
            }
        }

        function isDisposalSearchChecked() {
            return $disposalSearchCheckbox.is(':checked');
        }

        function applyDisposalSearchMode(isChecked) {
            if (isChecked) {
                $stockChangeTypeDetail.val(disposalStockChangeTypeDetailIds).trigger('change');
                setFieldDisabled($stockChangeTypeDetail, true);

                disposalSearchClearFieldSelectors.forEach(function(selector) {
                    const $field = $(selector);
                    clearFieldValue($field);
                    setFieldDisabled($field, true);
                });
            } else {
                clearFieldValue($stockChangeTypeDetail);
                setFieldDisabled($stockChangeTypeDetail, false);

                disposalSearchClearFieldSelectors.forEach(function(selector) {
                    setFieldDisabled($(selector), false);
                });
            }

diff --git a//tmp/extract_layouts_rc2_05.py b//tmp/extract_layouts_rc2_05.py
new file mode 100644
index 0000000000000000000000000000000000000000..50ef563e2c963227a46e0eb22abfd866da2e4a3f
--- /dev/null
+++ b//tmp/extract_layouts_rc2_05.py
@@ -0,0 +1,23 @@
+import base64
+import re
+from pathlib import Path
+
+source = Path("/home/y-saito/Developments/hareruya-design-docs/excel_to_html/output/0202_基本設計仕様書(在庫管理機能).html")
+output = Path("/tmp/rc2_05_layouts")
+output.mkdir(parents=True, exist_ok=True)
+html = source.read_text(encoding="utf-8")
+
+for sheet_id in (22, 23, 25):
+    start = html.index(f'<section class="sheet-panel" id="sheet-{sheet_id}">')
+    next_section = html.find('<section class="sheet-panel"', start + 1)
+    section = html[start:next_section if next_section >= 0 else None]
+    matches = re.findall(
+        r'<img(?: class="image-layer-img")? src="data:image/([a-zA-Z0-9.+-]+);base64,([^"]+)"',
+        section,
+    )
+    for index, (extension, payload) in enumerate(matches, 1):
+        if extension == "jpeg":
+            extension = "jpg"
+        destination = output / f"sheet_{sheet_id}_{index}.{extension}"
+        destination.write_bytes(base64.b64decode(payload))
+        print(destination)

