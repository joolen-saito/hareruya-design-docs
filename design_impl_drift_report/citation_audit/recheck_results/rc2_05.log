                'multiple' => true,
                'expanded' => false,
                'query_builder' => fn (EntityRepository $er) => $er->createQueryBuilder('cs')
                    ->orderBy('cs.id', 'ASC'),
            ])
            ->add('create_source_id', IntegerType::class, [
                'label' => 'admin.product.create_source_id',
                'required' => false,
                'attr' => [
                    'min' => 0,
                    'maxlength' => $this->eccubeConfig['eccube_int_len'],
                ],
            ])
            ->add('create_date_from', DateType::class, [
                'label' => 'admin.common.create_date__start',
                'required' => false,
                'input' => 'datetime',
                'widget' => 'single_text',
                'placeholder' => ['year' => '----', 'month' => '--', 'day' => '--'],
                'constraints' => [
                    new Assert\Range([
                        'min' => '1900-01-01',
                        'minMessage' => 'form_error.out_of_range',
                    ]),
                ],
                'attr' => [
                    'class' => 'datetimepicker-input',
                    'data-target' => '#'.$this->getBlockPrefix().'_create_date_from',
                    'data-toggle' => 'datetimepicker',
                ],
