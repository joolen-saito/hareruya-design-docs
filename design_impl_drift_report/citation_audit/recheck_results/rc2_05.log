    #[Route(path: '/%eccube_admin_route%/product/stock/split-join/list-join-csv-import', name: 'admin_stock_split_join_list_join_csv_import', methods: ['POST'])]
    public function listJoinCsvImport(Request $request): RedirectResponse
    {
        $csvBag = $request->request->all('admin_stock_join_csv_upload');
        $token = isset($csvBag['_token']) ? (string) $csvBag['_token'] : '';
        if (!$this->isCsrfTokenValid('admin_stock_join_csv_upload', $token)) {
            $this->addError('admin.common.csrf_invalid', 'admin');

            return $this->redirectToRoute('admin_stock_split_join_list');
        }

        $joinFiles = $request->files->get('admin_stock_join_csv_upload');
        $file = \is_array($joinFiles) ? ($joinFiles['import_file'] ?? null) : null;
        if (!$file instanceof UploadedFile || !$file->isValid()) {
            $this->addError(trans('admin.common.csv_upload_error'), 'admin');

            return $this->redirectToRoute('admin_stock_split_join_list');
        }

        $storeId = isset($csvBag['store']) ? (int) $csvBag['store'] : 0;
        $BaseInfo = $storeId > 0 ? $this->baseInfoRepository->find($storeId) : $this->baseInfoRepository->get();
        if ($BaseInfo === null) {
            $this->addError(trans('admin.common.csv_upload_error'), 'admin');

            return $this->redirectToRoute('admin_stock_split_join_list');
        }

        $destinationStockLocationId = isset($csvBag['inventory_category']) ? (int) $csvBag['inventory_category'] : 0;
        if ($destinationStockLocationId < 1) {
            $this->addError(trans('admin.common.csv_upload_error'), 'admin');

            return $this->redirectToRoute('admin_stock_split_join_list');
        }

        $Member = $this->getUser();
        if (!$Member instanceof Member) {
            $this->addError(trans('admin.stock.split.login_required'), 'admin');

            return $this->redirectToRoute('admin_stock_split_join_list');
        }

        $handler = new StockJoinListCsvImportHandler(
            $this->productStockRepository,
            $this->stockJoinRegisterAction,
            $this->stockJoinMoveToShortageEntryAction,
            $this->entityManager,
            $BaseInfo,
            $destinationStockLocationId,
            $Member,
        );

        $importer = new CsvImporter(
            $this->entityManager,
            $this->translator,
            $this->eccubeConfig,
            $handler,
            $Member,
        );

        try {
            $result = $importer->import($file);
        } catch (\Throwable $e) {
            $detail = sprintf('[%s] %s', get_class($e), $e->getMessage());
            log_error('在庫結合CSV取り込みに失敗しました: '.$detail, [$e]);
            error_log('在庫結合CSV取り込みエラー: '.$detail.' in '.$e->getFile().':'.$e->getLine());
            $this->addError(trans('admin.common.csv_import_error').': '.$detail, 'admin');

            return $this->redirectToRoute('admin_stock_split_join_list');
        }

        foreach ($result->getErrors() as $error) {
            $this->addError($error['message'], 'admin');
        }
        foreach ($handler->getFlashErrors() as $msg) {
            $this->addError($msg, 'admin');
        }
        foreach ($handler->getFlashSuccesses() as $msg) {
            $this->addSuccess($msg, 'admin');
        }

                return ['ok' => false, 'errors' => $errors];
            }
            $psId = (int) $srcPs->getId();
            if (isset($sourceByPsId[$psId])) {
                $sourceByPsId[$psId]['quantity'] += $gr['src_qty'];
            } else {
                $sourceByPsId[$psId] = ['productStockId' => $psId, 'quantity' => $gr['src_qty']];
            }
        }

        if ($sourceByPsId === []) {
            $errors[] = sprintf('結合先 %s: 結合元が空です。', $destCode);

            return ['ok' => false, 'errors' => $errors];
        }

        $registerInput = new StockJoinRegisterInput(
            $destPs,
            $member,
            max(0, $joinQuantity),
        );

        try {
            $regResult = $this->stockJoinRegisterAction->handle($registerInput);
        } catch (\LogicException $e) {
            $errors[] = sprintf('結合先 %s: %s', $destCode, trans($e->getMessage()));

            return ['ok' => false, 'errors' => $errors];
        }

        $joinId = (int) $regResult->getId();
        if ($joinId < 1) {
            $errors[] = sprintf('結合先 %s: 登録に失敗しました。', $destCode);

            return ['ok' => false, 'errors' => $errors];
        }

        try {
            $this->stockJoinMoveToShortageEntryAction->handle(
                new StockJoinMoveToShortageEntryInput(
                    ProductStock: $destPs,
                    stockSplitJoinId: $joinId,
                    Member: $member,
                    sessionSources: array_map(static fn ($v) => ['quantity' => $v['quantity']], $sourceByPsId),
                )
            );
        } catch (StockJoinMoveToShortageValidationException $e) {
            $errors[] = sprintf('結合先 %s（欠品入力へ）: %s', $destCode, trans($e->getMessage()));

            return ['ok' => false, 'errors' => $errors];
        }

        return ['ok' => true, 'errors' => []];
    }

