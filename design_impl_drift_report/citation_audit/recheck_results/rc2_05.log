    /**
     * 在庫履歴検索/一覧 画面表示
     *
     * @param int|null $page_no
     * @param int|null $page_count
     *
     * @return array<string,mixed>
     */
    #[Route(path: '/%eccube_admin_route%/product/stock/history', name: 'admin_stock_history', methods: ['GET', 'POST'])]
    #[Route(path: '/%eccube_admin_route%/product/stock/history/page/{page_no}', name: 'admin_stock_history_page', requirements: ['page_no' => '\d+'], methods: ['POST', 'GET'])]
    #[Route(path: '/%eccube_admin_route%/product/stock/history/page/{page_no}/count/{page_count}', name: 'admin_stock_history_page_count', requirements: ['page_no' => '\d+'], methods: ['POST', 'GET'])]
    #[Template(template: '@admin/Stock/history.twig')]
    public function new(Request $request, PaginatorInterface $paginator, $page_no = null, $page_count = null): array
    {
        $session = $this->session;

        $builder = $this->formFactory->createBuilder(StockHistoryType::class, null, [
        ]);

        $event = new EventArgs(
            [
                'builder' => $builder,
            ],
            $request
        );
        $this->eventDispatcher->dispatch($event, EccubeEvents::ADMIN_STOCK_HISTORY_NEW_INITIALIZE);

        $searchForm = $builder->getForm();

        $Member = $this->getMember();

        /**
         * ページの表示件数は, 以下の順に優先される.
         * - リクエストパラメータ
         * - セッション
         * - デフォルト値
         * また, セッションに保存する際は mtb_page_maxと照合し, 一致した場合のみ保存する.
         **/
        $sessionKeyPageNo = 'eccube.admin.stock.stock_history.pageNo';
        $sessionKeyPageCount = 'eccube.admin.stock.stock_history.page_count';
        $sessionKeyDisplayMode = 'eccube.admin.stock.stock_history.display_mode';
        $sessionKeySearch = 'eccube.admin.stock.stock_history.search';

        $pageNo = (int) ($page_no ?? $session->get($sessionKeyPageNo, 1));
        $pageCount = (int) ($page_count ?? $session->get($sessionKeyPageCount, $this->eccubeConfig['eccube_default_page_count']));

        $pageCountParam = (int) $request->get('page_count');
        $pageMaxis = $this->pageMaxRepository->findAll();

        if ($pageCountParam) {
            foreach ($pageMaxis as $pageMax) {
                if ($pageCountParam == $pageMax->getName()) {
                    $pageCount = $pageMax->getName();
                    $this->session->set($sessionKeyPageCount, $pageCount);
                    break;
                }
            }
        }

        /**
         * 表示データ切り替えは, 以下の順に優先される.
         * - リクエストパラメータ
         * - セッション
         **/
        $displayMode = $this->session->get($sessionKeyDisplayMode);
        $displayModeParam = (int) $request->get('mode');
        if ($displayModeParam) {
            $displayMode = $displayModeParam;
            $this->session->set($sessionKeyDisplayMode, $displayMode);
        }

        if ($request->getMethod() === 'POST') {
            $searchForm->handleRequest($request);
            $hasSearchDisposal = !empty($searchForm['disposal_search']) ? true : false;

            if ($searchForm->isValid()) {
                /**
                 * 検索が実行された場合は, セッションに検索条件を保存する.
                 * ページ番号は最初のページ番号に初期化する.
                 */
                $pageNo = 1;
                $searchData = $searchForm->getData();

                // 検索条件, ページ番号をセッションに保持.
                $this->session->set($sessionKeySearch, FormUtil::getViewData($searchForm));
                $this->session->set($sessionKeyPageNo, $pageNo);
            } else {
                // 検索エラーの際は, 詳細検索枠を開いてエラー表示する.
                return [
                    'form' => $searchForm->createView(),
                    'pagination' => [],
                    'pageMaxis' => $pageMaxis,
                    'pageNo' => $pageNo,
                    'page_count' => $pageCount,
                    'has_errors' => true,
                    'has_search_details' => true,
                    'has_search_disposal' => $hasSearchDisposal,
                    'display_mode' => $displayMode,
                    'stockChangeReasonDisplayBuilder' => $this->stockChangeReasonDisplayBuilder,
                ];
            }
        } else {
            // 他画面（在庫一覧等）からのクエリパラメータをセッションにマージ
            if ($request->query->has('product_code') || $request->query->has('stock_location_id') || $request->query->has('base_info_id')) {
                $mergeData = $this->session->get($sessionKeySearch, []);
                if ($request->query->has('product_code')) {
                    $mergeData['product_name'] = $request->query->get('product_code');
                }
                if ($request->query->has('stock_location_id')) {
                    $mergeData['stock_location_id'] = [$request->query->get('stock_location_id')];
                }
                if ($request->query->has('base_info_id')) {
                    $mergeData['base_info'] = [$request->query->get('base_info_id')];
                }
                $this->session->set($sessionKeySearch, $mergeData);
                $this->session->set($sessionKeyPageNo, 1);
                $pageNo = 1;
            }

            if ($pageNo > 0 || $request->get('resume')) {
                /*
                 * ページ送りの場合または、他画面から戻ってきた場合は, セッションから検索条件を復旧する.
                 */
                if ($pageNo) {
                    // ページ送りで遷移した場合.
                    $this->session->set($sessionKeyPageNo, (int) $pageNo);
                } else {
                    // 他画面から遷移した場合.
                    $pageNo = $this->session->get($sessionKeyPageNo, 1);
                }
                $viewData = $this->session->get($sessionKeySearch, []);
                $searchData = FormUtil::submitAndGetData($searchForm, $viewData);
            } else {
                /**
                 * 初期表示の場合.
                 */
                $pageNo = 1;
                // submit default value
                $viewData = FormUtil::getViewData($searchForm);
                $searchData = FormUtil::submitAndGetData($searchForm, $viewData);

                // セッション中の検索条件, ページ番号を初期化.
                $this->session->set($sessionKeySearch, $viewData);
                $this->session->set($sessionKeyPageNo, $pageNo);

                return [
                    'form' => $searchForm->createView(),
                    'pagination' => [],
                    'pageMaxis' => $pageMaxis,
                    'pageNo' => $pageNo,
                    'page_count' => $pageCount,
                    'has_errors' => false,
                    'has_search_details' => true,
                    'has_search_disposal' => false,
                    'display_mode' => $displayMode,
                    'stockChangeReasonDisplayBuilder' => $this->stockChangeReasonDisplayBuilder,
                ];
            }
        }

        $qb = $this->stockHistoryRepository->getQueryBuilderBySearchDataForAdmin($searchData);

        $event = new EventArgs(
            [
                'qb' => $qb,
                'searchData' => $searchData,
            ],
            $request
        protected EccubeConfig $eccubeConfig,
        protected MtbCardConditionRepository $mtbCardConditionRepository,
        protected MemberRepository $memberRepository,
        private readonly BaseInfoRepository $baseInfoRepository,
    ) {
    }

    /**
     * {@inheritdoc}
     *
     * @param array<string, mixed> $options
     */
    #[\Override]
    public function buildForm(FormBuilderInterface $builder, array $options): void
    {
        $purchasePriceMin = $this->eccubeConfig['eccube_product_stock_purchase_price_min'];
        $purchasePriceMax = $this->eccubeConfig['eccube_product_stock_purchase_price_max'];

        $builder
            ->add('product_name', TextType::class, [
                'label' => 'admin.product.multi_search_label',
