                                            <th class="border-top-0 pt-2 pb-2">{{ 'admin.stock.history.sale_price'|trans }}</th>
                                            <th class="border-top-0 pt-2 pb-2">{{ 'admin.stock.history.purchase_price'|trans }}</th>
