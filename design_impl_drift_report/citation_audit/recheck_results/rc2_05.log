diff --git a//tmp/extract_layouts_rc2_05.py b//tmp/extract_layouts_rc2_05.py
new file mode 100644
index 0000000000000000000000000000000000000000..50ef563e2c963227a46e0eb22abfd866da2e4a3f
--- /dev/null
+++ b//tmp/extract_layouts_rc2_05.py
@@ -0,0 +1,23 @@
+import base64
+import re
+from pathlib import Path
+
+source = Path("/home/y-saito/Developments/hareruya-design-docs/excel_to_html/output/0202_基本設計仕様書(在庫管理機能).html")
+output = Path("/tmp/rc2_05_layouts")
+output.mkdir(parents=True, exist_ok=True)
+html = source.read_text(encoding="utf-8")
+
+for sheet_id in (22, 23, 25):
+    start = html.index(f'<section class="sheet-panel" id="sheet-{sheet_id}">')
+    next_section = html.find('<section class="sheet-panel"', start + 1)
+    section = html[start:next_section if next_section >= 0 else None]
+    matches = re.findall(
+        r'<img(?: class="image-layer-img")? src="data:image/([a-zA-Z0-9.+-]+);base64,([^"]+)"',
+        section,
+    )
+    for index, (extension, payload) in enumerate(matches, 1):
+        if extension == "jpeg":
+            extension = "jpg"
+        destination = output / f"sheet_{sheet_id}_{index}.{extension}"
+        destination.write_bytes(base64.b64decode(payload))
+        print(destination)

