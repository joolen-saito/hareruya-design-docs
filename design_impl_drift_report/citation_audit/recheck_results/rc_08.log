     */
    public function postAction(Request $request)
    {
        $this->authAdminToken($request);
        $ids = $request->get('ids');
        $buyOrderIds = explode(',', $ids);
        $buyMainCards = $this->getDoctrine()
            ->getRepository(DtbBuyMainCard::class)
            ->findByBuyOrderIds($buyOrderIds);

        $buyMainCardIds = [];
        foreach ($buyMainCards as $buyMainCard) {
            $buyMainCardIds[] = $buyMainCard['buyMainCardId'];
        }

        $applicationPrices = $this->getDoctrine()
            ->getRepository(DtbApplicationPrice::class)
            ->findByBuyMainCardIds($buyMainCardIds);

        foreach ($buyMainCards as $index => $buyMainCard) {
            foreach ($applicationPrices as $applicationPrice) {
                if ($buyMainCard['buyMainCardId'] === $applicationPrice['buyMainCardId']) {
                    $buyMainCards[$index]['applicationPrice'][$applicationPrice['code']] = $applicationPrice['applicationPrice'];
                }
            }
        }

        return $buyMainCards;
    }
}
