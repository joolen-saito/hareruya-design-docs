class ArticleController extends FOSRestController
{
    /**
     * 記事情報登録
     * 
     * @param Request $request
     * @return integer
     */
    public function postArticleAction(Request $request)
    {
        /* 
         * Symfony4.4へアップデートの影響?で、メモリーオーバーとなるwpPostIdとならないIDが存在
         * 原因は不明かつ実害が少なそうなので、一時的に記事登録機能を停止
         */
        return 1;

        $em = $this->getDoctrine()->getManager();
        $data = json_decode($request->getContent(), true);

        $decks = $em->getRepository(DtbDeck::class)->findByDeckId($data['decks']);
        unset($data['decks']);
    
        // すでにwpPostIdが存在すれば上書き、そうでなければ新規作成
        $article = $em->getRepository(DtbArticle::class)->findOneByWpPostId($data['wpPostId']);
        if (empty($article)) {
            $article = new DtbArticle;
        }

        $form = $this->createForm(DtbArticleType::class, $article, [
            'csrf_protection' => false,
        ]);

        $form->submit($data);
        $article->setDecks($decks);

        if (!$form->isValid()) {
            $view = View::create($form, 400);

            return $this->get('fos_rest.view_handler')->handle($view);
        }

        $em->persist($article);
        $em->flush();

        return $article->getArticleId();
    }

    /**
     * 記事情報取得
     * 
     * @param integer $id
     * @return array
     */
    public function getArticleAction($id)
    {
        $article = $this->getDoctrine()
            ->getRepository(DtbArticle::class)
            ->find($id);

        if (empty($article)) {
            $view = View::create([
                "code" => 404,
                "message" => 'Not Found'
            ], 404);

            return $this->get('fos_rest.view_handler')->handle($view);
        }

        return $article;
    }

    /**
     * 検索クエリに一致する記事を一件取得
     * 
     * @QueryParam(name="wpPostId", description="article")
     * @param ParamFetcher $paramFetcher
     * @return array
     */
    public function getSingleArticleByParamsAction(ParamFetcher $paramFetcher)
    {
        $article = $this->getDoctrine()
            ->getRepository(DtbArticle::class)
            ->findOneByParams($paramFetcher->all());

        if (empty($article)) {
            $view = View::create([
                "code" => 404,
                "message" => 'Not Found'
            ], 404);

            return $this->get('fos_rest.view_handler')->handle($view);
        }

        return $article;
    }

    /**
     * 関連記事を取得
     * 
     * @param integer $id
     * @return array
     */
    public function getRelatedArticlesAction($id, Request $request)
    {
        $em = $this->getDoctrine()->getManager();
        $articles = $em->getRepository(DtbArticle::class)->getRelatedArticles($id, $request->get('limit'));

        if (empty($articles)) {
            $view = View::create([
                "code" => 404,
                "message" => 'Not Found'
            ], 404);

            return $this->get('fos_rest.view_handler')->handle($view);
        }

        return $articles;
    }

