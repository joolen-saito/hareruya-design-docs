/**
 * MtbTopBannerRepository
 */
class MtbTopBannerRepository extends EntityRepository
{
    /**
     * 画像URLが空文字でないレコードをすべて返す
     *
     * @param string $languageCode
     * @return array
     */
    public function findAllWhereUrlIsNotEmpty($languageCode = null)
    {
        $qb = $this->createQueryBuilder('tb')
            ->where("tb.imageUrl <> ''")
            ->andWhere("tb.imageUrl <> ''")
            ->andWhere("tb.dispType <> 0");
        if ($languageCode) {
            $qb->join('tb.languages', 'l')
            ->andWhere("l.code = :languageCode")
            ->setParameter('languageCode', $languageCode);
        }
        $qb->orderBy('tb.id', 'ASC');

        return $qb->getQuery()->execute();
    }
}
