namespace Eccube\Controller\App;

use Eccube\Controller\AbstractController;
use Eccube\Exception\App\BaseApiException;
use Eccube\Exception\App\InternalException;
use Eccube\Exception\App\InvalidParameterException;
use Eccube\Exception\App\MissingRequiredParameterException;
use Eccube\Exception\App\NotFoundException;
use Eccube\Repository\DtbArticleRepository;
use Eccube\Service\App\Article\ArticleResponseBuilder;
use Symfony\Component\HttpFoundation\JsonResponse;
use Symfony\Component\HttpFoundation\Request;
use Symfony\Component\Routing\Attribute\Route;

class ArticleController extends AbstractController
{
    public function __construct(
        private readonly DtbArticleRepository $dtbArticleRepository,
        private readonly ArticleResponseBuilder $articleResponseBuilder,
    ) {
    }

    /**
     * WordPressの投稿IDを検索条件として、記事情報を1件取得して返却するAPIエンドポイント
     *
     * @param Request $request
     *
     * @return JsonResponse
     */
    #[Route('/article.json', name: 'article_by_params', methods: ['GET'])]
    public function getSingleArticleByParamsAction(Request $request): JsonResponse
    {
        try {
            $wpPostIdParam = $request->query->get('wpPostId');
            if ($wpPostIdParam === null || $wpPostIdParam === '') {
                throw new MissingRequiredParameterException('wpPostIdは必須です');
            }

            if (!is_numeric($wpPostIdParam) || (int) $wpPostIdParam != $wpPostIdParam || (int) $wpPostIdParam < 1) {
                throw new InvalidParameterException('wpPostIdは正の整数である必要があります');
            }

            $Article = $this->dtbArticleRepository->findOneBy(['wpPostId' => (int) $wpPostIdParam]);
            if ($Article === null) {
                throw new NotFoundException('記事が見つかりません');
            }

            return $this->json($this->articleResponseBuilder->build($Article));
        } catch (BaseApiException $e) {
            // APIルートが/%eccube_api_v1_route%/ではなく、ExceptionListenerのエラーハンドリングが動作しないため、直接JSONを返す
            return $this->json([
                'code' => $e->getStatusCode(),
                'errors' => $e->getErrors(),
            ], $e->getStatusCode());
        }
    }

    /**
     * 指定された記事IDを基準として、関連する記事のリストを取得して返却するAPIエンドポイント
     *
     * @param string $id 基準記事のWordPress投稿ID
     * @param Request $request
     *
     * @return JsonResponse
     */
    #[Route('/article/related/{id}', name: 'article_related', methods: ['GET'])]
    public function getRelatedArticlesAction(string $id, Request $request): JsonResponse
    {
        try {
            if (!preg_match('/^\d+$/', $id) || (int) $id < 1) {
                throw new InvalidParameterException('idは正の整数である必要があります');
            }

            $limitParam = $request->query->get('limit', '');
            $limit = $this->eccubeConfig->get('eccube_article_related_api_default_limit');
            if ($limitParam !== '') {
                if (!is_numeric($limitParam) || (int) $limitParam != $limitParam || (int) $limitParam < 1) {
                    throw new InvalidParameterException('limitは正の整数である必要があります');
                }
                $limit = (int) $limitParam;
            }

            $relatedArticles = $this->dtbArticleRepository->getRelatedArticles((int) $id, $limit);

            if (empty($relatedArticles)) {
                throw new NotFoundException('関連記事が見つかりません');
            }

            return new JsonResponse($relatedArticles, 200);
        } catch (BaseApiException $e) {
            throw $e;
        } catch (\Throwable $e) {
            throw new InternalException('システムエラーが発生しました', $e);
        }
    }
}
