namespace Eccube\Entity;

use Doctrine\Common\Collections\ArrayCollection;
use Doctrine\Common\Collections\Collection;
use Doctrine\DBAL\Types\Types;
use Doctrine\ORM\Mapping as ORM;
use Eccube\Entity\Master\MtbCardCondition;
use Eccube\Entity\Master\MtbLanguage;
use Eccube\Repository\DtbBuyMainCardRepository;

#[ORM\Table(name: 'dtb_buy_main_card')]
#[ORM\HasLifecycleCallbacks]
#[ORM\Entity(repositoryClass: DtbBuyMainCardRepository::class)]
class DtbBuyMainCard extends AbstractEntity
{
    public const SALE = true;
    public const NOT_SALE = false;
    public const SELECT_TYPE = 1;
    public const BULK_TYPE = 2;

    public const FOIL_NONE = 0;     // なし
    public const FOIL_NORMAL = 1;   // 通常
    public const FOIL_SPECIAL = 2;  // 特殊

    #[ORM\Column(name: 'id', type: Types::INTEGER, options: ['unsigned' => true, 'comment' => '買取代表カードID'])]
    #[ORM\Id]
    #[ORM\GeneratedValue(strategy: 'IDENTITY')]
    private int $id;

    #[ORM\JoinColumn(name: 'buy_order_id', referencedColumnName: 'id', onDelete: 'CASCADE', nullable: false)]
    #[ORM\ManyToOne(targetEntity: DtbBuyOrder::class, inversedBy: 'BuyMainCards')]
    private DtbBuyOrder $BuyOrder;

    #[ORM\Column(name: 'count', type: Types::INTEGER, nullable: true, options: ['default' => 1, 'unsigned' => true, 'comment' => '枚数'])]
    private ?int $count = 1;

    #[ORM\Column(name: 'price', type: Types::INTEGER, nullable: true, options: ['unsigned' => true, 'comment' => '査定金額'])]
    private ?int $price = null;

    #[ORM\JoinColumn(name: 'product_id', nullable: false, referencedColumnName: 'id', options: ['unsigned' => true, 'comment' => '商品ID'])]
    #[ORM\ManyToOne(targetEntity: Product::class)]
    private Product $Product;

    #[ORM\JoinColumn(name: 'language_id', nullable: true, referencedColumnName: 'id', options: ['unsigned' => true, 'comment' => '言語ID'])]
    #[ORM\ManyToOne(targetEntity: MtbLanguage::class, inversedBy: 'BuyMainCards')]
    private ?MtbLanguage $Language = null;

    #[ORM\Column(name: 'foil_flg', type: Types::SMALLINT, nullable: true, options: ['unsigned' => true, 'comment' => 'Foil区分（0:なし, 1:通常, 2:特殊）'])]
    private ?int $foilFlg = null;

    #[ORM\Column(name: 'sale_flg', type: Types::BOOLEAN, nullable: true, options: ['default' => 1, 'comment' => '売却フラグ'])]
    private ?bool $saleFlg = null;

    #[ORM\JoinColumn(name: 'card_condition_id', nullable: true, referencedColumnName: 'id', options: ['unsigned' => true, 'comment' => 'カード状態ID'])]
    #[ORM\ManyToOne(targetEntity: MtbCardCondition::class)]
    private ?MtbCardCondition $CardCondition = null;

    #[ORM\Column(name: 'purchase_category', type: Types::INTEGER, options: ['unsigned' => true, 'comment' => '買取区分'])]
    private int $purchaseCategory = self::SELECT_TYPE;

    /**
     * @var Collection<int, DtbApplicationPrice>
     */
    #[ORM\OneToMany(targetEntity: DtbApplicationPrice::class, mappedBy: 'BuyMainCard', cascade: ['persist', 'remove'])]
    private Collection $ApplicationPrices;

    public function __construct()
    {
        // Collection の初期化
        $this->ApplicationPrices = new ArrayCollection();
    }

    public function getId(): int
    {
        return $this->id;
    }

    /**
     * DB に id が採番済みかどうか（フォーム上の未保存明細では false）。
     */
    public function hasPersistedId(): bool
    {
        return isset($this->id);
    }

    public function setId(int $id): DtbBuyMainCard
    {
        $this->id = $id;

        return $this;
    }

    public function setCount(?int $count): DtbBuyMainCard
    {
        $this->count = $count;

        return $this;
    }

    public function getCount(): ?int
    {
        return $this->count;
    }

    public function setPrice(?int $price): DtbBuyMainCard
    {
        $this->price = $price;

        return $this;
    }

    public function getPrice(): ?int
    {
        return $this->price;
    }

    public function setFoilFlg(?int $foilFlg): DtbBuyMainCard
    {
        $this->foilFlg = $foilFlg;

        return $this;
    }

    public function getFoilFlg(): ?int
    {
        return $this->foilFlg;
    }

    public function setSaleFlg(?bool $saleFlg): DtbBuyMainCard
    {
        $this->saleFlg = $saleFlg;

        return $this;
    }

    public function getSaleFlg(): ?bool
    {
        return $this->saleFlg;
    }

    public function setPurchaseCategory(int $purchaseCategory): DtbBuyMainCard
    {
        $this->purchaseCategory = $purchaseCategory;

        return $this;
    }

    public function getPurchaseCategory(): int
    {
        return $this->purchaseCategory;
    }

    /**
     * まとめて買取に個別表示する価格未満かどうか.
     */
    public function isLowPriceBulkAgreementLine(): bool
    {
        if ($this->purchaseCategory !== self::BULK_TYPE) {
            return false;
        }
        $price = $this->price;

        return $price !== null && $price < DtbBuyOrder::BULK_MIN_PRICE;
    }


