namespace Eccube\Controller\App;

use Eccube\Controller\AbstractController;
use Eccube\Exception\App\BaseApiException;
use Eccube\Exception\App\InternalException;
use Eccube\Service\App\PointGranter\PointGranterAction;
use Eccube\Service\App\PointGranter\PointGranterInput;
use Eccube\Service\Smaregi\SmaregiApiService;
use Symfony\Component\HttpFoundation\JsonResponse;
use Symfony\Component\HttpFoundation\Request;
use Symfony\Component\HttpFoundation\Response;
use Symfony\Component\Routing\Attribute\Route;

class PointGranterController extends AbstractController
{
    /**
     * 解析用キャプチャログで値をマスクする既知のPIIフィールド名.
     *
     * フィールド名（キー）は構造把握のため残し、値のみをマスクする。
     * pointAttr など解析対象の項目は含めない。
     *
     * @var array<int, string>
     */
    private const CAPTURE_MASK_KEYS = [
        'customerId',
        'customerCode',
        'customerNo',
        'customerPinCode',
        'memo',
        'receiptMemo',
    ];

    public function __construct(
        private readonly PointGranterAction $action,
        private readonly SmaregiApiService $smaregiApiService,
        private readonly bool $pointGranterRequestCapture = false,
    ) {
    }

    /**
     * PointGranterからのリクエストをSmaregi APIに中継するAPIエンドポイント
     *
     * @param Request $request
     *
     * @return JsonResponse
     */
    #[Route('/admin_api/point_granter', name: 'point_granter', methods: ['POST'])]
    public function processPointGranter(Request $request): JsonResponse
    {
        $contractId = (string) $request->headers->get('X-Contract-Id', '');
        $accessToken = (string) $request->headers->get('X-Access-Token', '');
        $procName = (string) $request->request->get('proc_name', '');
        $params = (string) $request->request->get('params', '');

        // 旧スマレジAPI用の proc_name / params（pointAttr 等の独自項目を含む）の実値を
        // 開発環境で解析するための受信キャプチャ。POINT_GRANTER_REQUEST_CAPTURE=true のときのみ出力する。
        $this->captureRequestForAnalysis($request, $procName, $params);

        try {
            if ($contractId === '' || $accessToken === '' || $procName === '' || $params === '') {
                log_warning('必要なヘッダーまたはパラメータが不足しています', [
                    'headerKeys' => array_keys($request->headers->all()),
                    'hasContractId' => $contractId !== '',
                    'hasAccessToken' => $accessToken !== '',
                    'procName' => $procName,
                ]);

                return $this->jsonResponse([], Response::HTTP_BAD_REQUEST);
            }

            $result = $this->smaregiApiService->postRegisterTransaction(
                $contractId,
                $accessToken,
                (string) $procName,
                (string) $params
            );

            if (!array_key_exists('result', $result)) {
                log_warning('スマレジAPIのレスポンスにresultキーが存在しません', [
                    'request' => $request->request->all(),
                    'response' => $result,
                ]);

                return $this->jsonResponse($result, Response::HTTP_BAD_REQUEST);
            }

            if ($procName !== 'transaction_upd') {
                return $this->jsonResponse($result, Response::HTTP_OK);
            }

            $row = $this->extractRow((string) $params);
            if (!is_array($row) || !isset($row['customerId'])) {
                return $this->jsonResponse($result, Response::HTTP_OK);
            }

            $input = new PointGranterInput(
                procName: (string) $procName,
                row: $row,
                smaregiResult: $result
            );
            $this->action->handle($input);
            log_info('ポイント付与処理が正常に完了しました', [
                'request' => $request->request->all(),
                'result' => $result,
            ]);

            return $this->jsonResponse($result, Response::HTTP_OK);
        } catch (BaseApiException $e) {
            return $this->jsonResponse([
                'code' => $e->getStatusCode(),
                'errors' => $e->getErrors(),
            ], $e->getStatusCode());
        } catch (\Throwable $e) {
            log_error('ポイント付与処理中にエラーが発生しました', [
                'error' => $e->getMessage(),
                'request' => $request->request->all(),
            ]);
            throw new InternalException('システムエラーが発生しました', $e);
        }
    }

    /**
     * PointGranter からの受信リクエストを解析用にログ出力する.
     *
     * 旧スマレジAPI（transaction_upd 等）のパラメータ仕様が資料で確定できないため、
     * 開発環境で実リクエストを収集して proc_name / params の実値（pointAttr 等の
     * スマレジ標準外項目を含む）を解析することを目的とする。
     * アクセストークンは秘匿情報のため値を出力せず、契約IDはマスクする。
     *
     * @param Request $request
     * @param string $procName
     * @param string $params
     *
     * @return void
     */
    private function captureRequestForAnalysis(Request $request, string $procName, string $params): void
    {
        if ($this->pointGranterRequestCapture === false) {
            return;
        }

        try {
            // 生の params は customerId 等のPIIを含むため、フィールド名は残しつつ
            // 既知のPII列（CAPTURE_MASK_KEYS）の値のみマスクした構造を出力する。
            log_info('[PointGranter capture] 受信リクエスト', [
                'procName' => $procName,
                'sourceIp' => $request->getClientIp(),
                'headerKeys' => array_keys($request->headers->all()),
                'contractId' => $this->maskSecret((string) $request->headers->get('X-Contract-Id', '')),
                'hasAccessToken' => (string) $request->headers->get('X-Access-Token', '') !== '',
                'paramsSanitized' => $this->sanitizeParamsForCapture(json_decode($params, true)),
            ]);
        } catch (\Throwable $e) {
            // 解析用ログの失敗で本処理を止めない。
            log_warning('[PointGranter capture] 受信リクエストのログ出力に失敗しました', [
                'error' => $e->getMessage(),
            ]);
        }
    }

    /**
     * 解析用キャプチャ向けに params を再帰的にサニタイズする.
     *
     * 構造把握のためキー（フィールド名）はすべて残し、CAPTURE_MASK_KEYS に一致する
     * キーの値のみをマスクする。pointAttr 等の解析対象はそのまま出力する。
     *
     * @param mixed $value
     *
     * @return mixed
     */
