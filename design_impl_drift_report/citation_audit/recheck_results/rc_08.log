class BannerController extends FOSRestController
{
    /**
     * トップバナー情報取得
     *
     * @param integer $id
     * @return array
     */
    public function getTopBannerAction($id)
    {
        $topBanner = $this->getDoctrine()
            ->getRepository(MtbTopBanner::class)
            ->find($id);

        if (empty($topBanner)) {
            $view = View::create([
                "code" => 404,
                "message" => 'Not Found'
            ], 404);

            return $this->get('fos_rest.view_handler')->handle($view);
        }

        return $topBanner;
    }

    /**
     * 設定済みトップバナー一覧取得
     *
     * @param string $languageCode
     * @return array
     */
    public function getTopBannersAction($languageCode)
    {
        $topBanners = $this->getDoctrine()
            ->getRepository(MtbTopBanner::class)
            ->findAllWhereUrlIsNotEmpty($languageCode);

        if (empty($topBanners) &&
            empty($this->getDoctrine()->getRepository(MtbLanguage::class)->findByCode($languageCode))) {

            $view = View::create([
                "code" => 404,
                "message" => 'Language code is not found'
            ], 404);

            return $this->get('fos_rest.view_handler')->handle($view);
        }

        return $topBanners;
    }
}
