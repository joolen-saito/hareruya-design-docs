<?php
namespace App\Repository;

use App\Entity\DtbBuyMainCard;
use Doctrine\ORM\EntityRepository;
use Doctrine\ORM\Query\Expr;

/**
 * DtbBuyMainCardRepository
 */
class DtbBuyMainCardRepository extends EntityRepository
{
    /**
     * ネット買取の買取代表カード情報を取得する
     */
    public function findByBuyOrderIds(array $buyOrderIds) : array
    {
        $qb = $this->createQueryBuilder('buyMainCard');
        $qb
            ->select(
                'buyMainCard.buyMainCardId',
                'buyMainCard.buyOrderId',
                'buyMainCard.productId',
                'buyMainCard.languageId',
                'buyMainCard.foilFlg',
                'buyMainCard.count',
                'buyMainCard.price',
                'buyMainCard.cardConditionId',
                'buyMainCard.saleFlg',
                'buyMainCard.purchaseCategory',
            )
            ->andWhere($qb->expr()->in('buyMainCard.buyOrderId', ':buyOrderIds'))
            ->setParameter('buyOrderIds', $buyOrderIds);

        return $qb->getQuery()->getResult();
    }

    /**
     * 状態以外同じ商品規格の買取代表カードIDを取得する
     */
    public function getSameProductBuyMainCardId(int $buyOrderId, int $productId, ?int $languageId = null, ?bool $foilFlg = null) : ?int
    {
        $results = $this->createQueryBuilder('bmc')
            ->select('bmc.buyMainCardId')
            ->where('bmc.buyOrderId = :buyOrderId
                AND bmc.productId = :productId
                AND bmc.languageId = :languageId
                AND bmc.foilFlg = :foilFlg
                AND bmc.purchaseCategory = :selectType'
            )
            ->setParameters([
                'buyOrderId' => $buyOrderId,
                'productId' => $productId,
                'languageId' => $languageId,
                'foilFlg' => $foilFlg,
                'selectType' => DtbBuyMainCard::SELECT_TYPE,
            ])
            ->getQuery()
            ->getResult();

        return !empty($results) ? $results[0]['buyMainCardId'] : null;
    }

}
