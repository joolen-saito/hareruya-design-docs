namespace Eccube\Controller\App\MTGBuyer\V1\Admin;

use Eccube\Controller\AbstractController;
use Eccube\Entity\DtbBuyOrderIndivisualInputProduct;
use Eccube\Repository\DtbBuyOrderIndivisualInputProductRepository;
use Symfony\Component\HttpFoundation\JsonResponse;
use Symfony\Component\HttpFoundation\Request;
use Symfony\Component\Routing\Attribute\Route;
use Symfony\Component\Security\Http\Attribute\IsGranted;

#[IsGranted('IS_AUTHENTICATED_FULLY')]
class BuyOrderIndivisualInputProductController extends AbstractController
{
    public function __construct(
        private readonly DtbBuyOrderIndivisualInputProductRepository $repository,
    ) {
    }

    /**
     * 複数ネット買取IDから個別入力商品の一覧を取得
     */
    #[Route(path: '/%eccube_api_v1_route%/admin/buyOrderIndivisualInputProduct.json', name: 'api_admin_buy_order_indivisual_input_product', methods: ['POST'])]
    public function getByBuyOrderIds(Request $request): JsonResponse
    {
        $ids = $request->request->get('ids');

        // 旧システム互換目的：クライアントAppが空のリクエストを送信する可能性があり、400エラーで返すとハンドリングできないため空配列を返す
        if ($ids === null || $ids === '') {
            return new JsonResponse([]);
        }

        // カンマ区切りを配列に変換し、数字のみをフィルタリング
        $buyOrderIds = array_filter(
            explode(',', $ids),
            static fn (string $id) => preg_match('/^\d+$/', trim($id)) === 1
        );
        $buyOrderIds = array_map('intval', $buyOrderIds);

        // 有効なIDがない場合は空配列を返す
        if (empty($buyOrderIds)) {
            return new JsonResponse([]);
        }

        $BuyOrderIndivisualInputProducts = $this->repository->findBy(['BuyOrder' => $buyOrderIds]);

        $response = array_map(
            static fn (DtbBuyOrderIndivisualInputProduct $Product) => [
                'buyOrderIndivisualInputProductId' => $Product->getId(),
                'buyOrderId' => $Product->getBuyOrder()->getId(),
                'name' => $Product->getName(),
                'price' => $Product->getPrice(),
                'count' => $Product->getQuantity(),
                'saleFlg' => $Product->isSaleFlg(),
            ],
            $BuyOrderIndivisualInputProducts
        );

        return new JsonResponse($response);
    }
}
