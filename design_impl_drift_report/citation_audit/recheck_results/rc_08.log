namespace Eccube\Service\App\Article;

use Doctrine\Common\Collections\Collection;
use Eccube\Entity\DtbArchetype;
use Eccube\Entity\DtbArticle;
use Eccube\Entity\DtbDeck;
use Eccube\Entity\DtbEventDetail;
use Eccube\Entity\Master\MtbCard;
use Eccube\Entity\Master\MtbCardDetail;
use Eccube\Entity\Master\MtbFormat;

class ArticleResponseBuilder
{
    /**
     * @param DtbArticle $Article
     *
     * @return array<string, mixed>
     */
    public function build(DtbArticle $Article): array
    {
        return [
            'article_id' => $Article->getId(),
            'wp_post_id' => $Article->getWpPostId(),
            'wp_type_id' => $Article->getWpTypeId(),
            'url' => $Article->getUrl(),
            'update_date' => $this->formatDateTime($Article->getUpdateDate()),
            'create_date' => $this->formatDateTime($Article->getCreateDate()),
            'cards' => $this->buildCards($Article->getCards()),
            'archetypes' => $this->buildArchetypes($Article->getArchetypes()),
            'decks' => $this->buildDecks($Article->getDecks()),
            'event_details' => $this->buildEventDetails($Article->getEventDetails()),
        ];
    }

    /**
     * @param \DateTimeInterface $dateTime
     *
     * @return string
     */
    private function formatDateTime(\DateTimeInterface $dateTime): string
    {
        return $dateTime->format('Y-m-d\TH:i:sP');
    }

    /**
     * @param Collection<int, MtbCard> $Cards
     *
     * @return array<int, array<string, mixed>>
     */
    private function buildCards(Collection $Cards): array
    {
        $result = [];
        foreach ($Cards as $Card) {
            $result[] = $this->buildCard($Card);
        }

        return $result;
    }

    /**
     * @param MtbCard $Card
     *
     * @return array<string, mixed>
     */
    private function buildCard(MtbCard $Card): array
    {
        $cardTypes = [];
        foreach ($Card->getCardTypes() as $CardType) {
            $cardTypes[] = [
                'id' => $CardType->getId(),
                'name_jp' => $CardType->getNameJp(),
                'name_en' => $CardType->getNameEn(),
                'product_search_flg' => $CardType->getProductSearchFlg(),
            ];
        }

        $subtypes = [];
        foreach ($Card->getSubtypes() as $Subtype) {
            $subtypes[] = [
                'id' => $Subtype->getId(),
                'name_jp' => $Subtype->getNameJp(),
                'name_en' => $Subtype->getNameEn(),
            ];
        }

        $specialtypes = [];
        foreach ($Card->getSpecialtypes() as $Specialtype) {
            $specialtypes[] = [
                'id' => $Specialtype->getId(),
                'name_jp' => $Specialtype->getNameJp(),
                'name_en' => $Specialtype->getNameEn(),
            ];
        }

        $colors = [];
        foreach ($Card->getColors() as $Color) {
            $colors[] = [
                'id' => $Color->getId(),
                'name_jp' => $Color->getNameJp(),
                'name_en' => $Color->getNameEn(),
            ];
        }

        $cardDetails = [];
        foreach ($Card->getCardDetails() as $CardDetail) {
            $cardDetails[] = $this->buildCardDetail($CardDetail);
        }

        $cardFormats = [];
        foreach ($Card->getCardFormats() as $CardFormat) {
            $cardFormats[] = [
                'id' => $CardFormat->getId(),
                'format_id' => $CardFormat->getFormat()?->getId(),
                'restriction_id' => $CardFormat->getRestriction()?->getId(),
            ];
        }

        $ColorSequence = $Card->getColorSequence();
        $colorSequenceResponse = null;
        if ($ColorSequence !== null) {
            $colorSequenceResponse = [
                'id' => $ColorSequence->getId(),
                'name' => $ColorSequence->getName(),
                'sort_no' => $ColorSequence->getSortNo(),
            ];
        }

        return [
            'id' => $Card->getId(),
            'name_jp' => $Card->getNameJp(),
            'name_en' => $Card->getNameEn(),
            'arena_format_name_jp' => $Card->getArenaFormatNameJp() ?? '',
            'arena_format_name_en' => $Card->getArenaFormatNameEn() ?? '',
            'text_jp' => $Card->getTextJp(),
            'text_en' => $Card->getTextEn(),
            'mana_cost' => $Card->getManaCost(),
            'cmc' => $Card->getCmc(),
            'power' => $Card->getPower(),
            'toughness' => $Card->getToughness(),
            'loyalty' => $Card->getLoyalty(),
            'old_product_id' => $Card->getOldProductId(),
            'old_en_product_id' => $Card->getOldEnProductId(),
            'update_date' => $this->formatDateTime($Card->getUpdateDate()),
            'create_date' => $this->formatDateTime($Card->getCreateDate()),
            'cardtypes' => $cardTypes,
            'subtypes' => $subtypes,
            'specialtypes' => $specialtypes,
            'colors' => $colors,
            'card_details' => $cardDetails,
            'card_formats' => $cardFormats,
            'color_sequence' => $colorSequenceResponse,
        ];
    }

