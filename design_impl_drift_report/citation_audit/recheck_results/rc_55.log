<?php

namespace Plugin\HareruyaEc\Form\Type\Admin;

use Symfony\Component\Form\AbstractType;
use Symfony\Component\Form\Extension\Core\Type;
use Symfony\Component\Form\FormBuilderInterface;
use Symfony\Component\Validator\Constraints as Assert;
use Plugin\HareruyaEc\Form\Type\Admin\CsvMimeType;

class CsvImportType extends AbstractType
{
    public $app;

    public function __construct(\Silex\Application $app)
    {
        $this->app = $app;
    }

    /**
     * {@inheritdoc}
     */
    public function buildForm(FormBuilderInterface $builder, array $options)
    {
        $app = $this->app;

        $builder
            ->add('import_file', 'file', [
                'label' => false,
                'mapped' => false,
                'required' => true,
                'constraints' => [
                    new Assert\NotBlank(['message' => $app->trans('admin.csv.error.upload.require')]),
                    new Assert\File([
                        'maxSize' => $app['config']['csv_size'] . 'M',
                        'maxSizeMessage' => sprintf($app->trans('admin.csv.error.upload.maxsize'), $app['config']['csv_size']),
                    ]),
                    new CsvMimeType($this->app),
                ],
            ]);
    }

    /**
     * {@inheritdoc}
     */
    public function getName()
    {
        return 'admin_csv_import';
    }
}
<?php
namespace Plugin\HareruyaEc\Form\Type\Admin;

use Symfony\Component\HttpFoundation\File\UploadedFile;
use Symfony\Component\Validator\ConstraintValidator;
use Symfony\Component\Validator\Constraint;
use Eccube\Entity\Master\Disp;

class CsvMimeTypeValidator extends ConstraintValidator
{
    /**
     * validate
     *
     * @param UploadedFile $value
     * @param Constraint $constraint
     */
    public function validate($value, Constraint $constraint)
    {
        if ($value instanceof UploadedFile && $value->isValid()) {
            $mimeTypes = ['text/plain', 'text/csv', 'text/tab-separated-values', 'application/vnd.ms-excel'];
            $mime = $value->getClientMimeType();
            foreach ($mimeTypes as $mimeType) {
                if ($mimeType === $mime) {
                    return;
                }
            }

            $this->context->buildViolation($constraint->app->trans('admin.csv.error.upload.mime'))
                ->setParameter('{{ type }}', $mime)
                ->setParameter('{{ types }}', implode(', ', $mimeTypes))
                ->addViolation();
        }
    }
}
app/Plugin/HareruyaEc/Service/Csv/AbstractCsvService.php:208:    public function checkHeaderValues($keys, $columnHeaders, $notRequiredHeaders)
     * @param $columnHeaders
     * @param $notRequiredHeaders
     */
    public function checkHeaderValues($keys, $columnHeaders, $notRequiredHeaders)
    {
        if (array_values(array_diff($keys, $notRequiredHeaders)) !== array_values(array_diff($columnHeaders, $notRequiredHeaders))) {
            throw new \RuntimeException('admin.csv.error.format.header');
        }
    }

    /**
     * CSVデータが空でないかチェックする処理
     *
     * @param $data
     */
    public function checkDataSize($data)
    {
        if (count($data) < 1) {
            throw new \RuntimeException('admin.csv.error.data.empty');
        }
    }

    /**
     * CSVヘッダーのカラム数とデータの個数が等しいかチェックする処理
     *
     * @param Integer $headerSize
     * @param Array $row
     * @param Integer $rowIndex
     */
    public function checkHeaderSize($headerSize, $row, $rowIndex)
    {
        if ($headerSize !== count($row)) {
            throw new \RuntimeException(sprintf($this->app->trans('admin.csv.error.format.body'), $rowIndex));
        }
    }

    /**
     * CSV必須項目の入力をチェックする処理
     *
     * @param Array $requiredHeaders
     * @param Array $row
     * @param Integer $rowIndex
     */
    public function checkRequiredHeaders($requiredHeaders, $row, $rowIndex)
    {
        foreach ($requiredHeaders as $key => $requiredHeader) {
            if ($row[$key] === '') {
                throw new \RuntimeException(sprintf($this->app->trans('admin.csv.error.data.require'), $requiredHeader, $rowIndex));
            }
        }
    }

