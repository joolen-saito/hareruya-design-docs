    #[Route('/%eccube_admin_route%/deck/csv_import', name: 'admin_deck_csv_import', methods: ['GET', 'POST'])]
    public function index(Request $request): Response|RedirectResponse
    {
        $form = $this->createForm(CsvImportType::class);

        $event = new EventArgs(
            [
                'form' => $form,
            ],
            $request
        );
        $this->eventDispatcher->dispatch($event, EccubeEvents::ADMIN_DECK_CSV_INDEX_INITIALIZE);

        if (!$request->isMethod('POST')) {
            return $this->renderWithErrors($form, []);
        }

        $form->handleRequest($request);

        if (!$form->isSubmitted() || !$form->isValid()) {
            $errors = [];
            foreach ($form->getErrors(true) as $error) {
                $errors[] = $error->getMessage();
            }

            return $this->renderWithErrors($form, $errors);
        }

        /** @var UploadedFile|null $formFile */
        $formFile = $form->get('import_file')->getData();
        if ($formFile === null) {
            return $this->renderWithErrors($form, [$this->translator->trans('admin.csv.error.upload.require')]);
        }

        if ($this->countCsvRows($formFile) >= static::ADMIN_CSV_IMPORT_MAX_ROWS) {
            return $this->renderWithErrors($form, [
                $this->translator->trans('admin.csv.error.upload.maxrecord', [
                    '%maxRecord%' => static::ADMIN_CSV_IMPORT_MAX_ROWS,
                ]),
