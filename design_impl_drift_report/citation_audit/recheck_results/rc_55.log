from html.parser import HTMLParser
from pathlib import Path
class P(HTMLParser):
 def __init__(self):
  super().__init__(); self.sid=None; self.stack=[]; self.rows=[]
 def handle_starttag(self, tag, attrs):
  a=dict(attrs)
  if tag=='section' and a.get('id','').startswith('sheet-'): self.sid=a['id']
  ref=a.get('data-excel-ref')
  self.stack.append([tag, ref, []])
 def handle_endtag(self, tag):
  if not self.stack: return
  i=len(self.stack)-1
  while i>=0 and self.stack[i][0]"'!=tag: i-=1
  if i<0: return
  item=self.stack.pop(i); txt='"' '.join(''.join(item[2]).split())
  if item[1] and txt and self.sid in {'sheet-5','sheet-6','sheet-7','sheet-13'}:
   self.rows.append((self.sid,item[1],txt))
  if self.stack: self.stack[-1][2].append(txt+' ')
 def handle_data(self,data):
  if self.stack: self.stack[-1][2].append(data)
p=P(); p.feed(Path('hareruya-design-docs/excel_to_html/output/0212_基本設計仕様書(デッキ管理).html').read_text())
seen=set()
for row in p.rows:
 if row not in seen:
  seen.add(row); print('\\t'.join(row))
