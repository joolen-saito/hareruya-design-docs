<?php

namespace Plugin\HareruyaEc\Controller\Admin;

use Eccube\Application;
use Eccube\Controller\AbstractController;
use Symfony\Component\HttpFoundation\Request;
use Plugin\HareruyaEc\Service\Csv\DeckCsv;

class DeckCsvController extends AbstractController
{
    private $importTwig = 'HareruyaEc/Resource/template/admin/Deck/deck_csv_import.twig';

    private $sessionKey = 'deck'; // デッキ管理のセッションキー

    /**
     * CSVアップロード画面
     *
     * @param Application $app
     * @param Request $request
     * @return \Symfony\Component\HttpFoundation\Response
     */
    public function csv(Application $app, Request $request)
    {
        $form = $app['form.factory']
            ->createBuilder('admin_csv_import')
            ->add('strict', 'checkbox', [
                'required' => false,
                'label' => 'form.deck.strict',
            ])
            ->getForm()
            ->handleRequest($request);

        $headers = $this->getCsvHeader();

        return $app->render($this->importTwig, [
            'form' => $form->createView(),
            'headers' => $headers
        ]);
    }

    /**
     * デッキ登録CSVアップロード
     *
     * @param Application $app
     * @param Request $request
     * @return \Symfony\Component\HttpFoundation\Response
     */
    public function import(Application $app, Request $request)
    {
        $deckCsv = new DeckCsv($app, $this->importTwig, $this->sessionKey, $this->getCsvHeader(), $this->getRequiredCsvHeader());

        $form = $app['form.factory']
            ->createBuilder('admin_csv_import')
            ->add('strict', 'checkbox', [
                'required' => false,
                'label' => 'form.deck.strict',
            ])
            ->getForm()
            ->handleRequest($request);

        $deckCsv->setIsStrict($form['strict']->getData())
            ->checkFormValid($form);
        try {
            $formFile = $deckCsv->getFormFile($form);
        } catch (\LogicException $e) {
            log_info('エラーが発生しました', [$e->getMessage()]);
            $app->addError($e->getMessage(), 'admin');

            return $deckCsv->render();
        }

        log_info('デッキCSV登録開始');
        $data = $deckCsv->getImportData($formFile);
        if ($data === false) {
            return $deckCsv->render();
        }

        try {
            // ヘッダーの値が一致するかチェック
            $headers = $this->getCsvHeader();
            $columnHeaders = $data->getColumnHeaders();
            $deckCsv->checkHeaderValues(array_keys($headers), $columnHeaders, $this->getNotRequiredCsvHeader());
            $headerSize = count($columnHeaders);

            // CSVデータが空でないかチェック
            $deckCsv->checkDataSize($data);

            $app['orm.em']->getConfiguration()->setSQLLogger(null);
            $app['orm.em']->beginTransaction();

            // CSVファイルの登録処理
            $deckCsv->register($headers, $headerSize, $data);
        } catch (\LogicException | \RuntimeException $e) {
            // 登録失敗時の処理
            $app['orm.em']->rollback();
            log_info('エラーが発生しました', [$e->getMessage()]);
            $app->addError($e->getMessage(), 'admin');

            return $deckCsv->render();
        }

        log_info('デッキCSV登録完了');
        $app->addSuccess('admin.register.complete', 'admin');

        return $deckCsv->render();
    }

    /**
     * CSVエクスポート
     *
     * @param Application $app
     * @param Request $request
     * @return \Symfony\Component\HttpFoundation\Response
     */
{% extends 'default_frame.twig' %}

{% set menus = ['deck_menu', 'deck_list'] %}

{% block title %}デッキ管理{% endblock %}
{% block sub_title %}デッキ登録CSV, TSVアップロード{% endblock %}


{% form_theme form 'Form/bootstrap_3_horizontal_layout.html.twig' %}

{% block javascript %}
<script src="{{ app.config.admin_urlpath }}/assets/js/vendor/spin.min.js"></script>
<script src="{{ path('admin_assets', {'path': 'js/card-csvimport.js'}) }}"></script>
{% endblock javascript %}

{% block main %}
<div id="upload_wrap" class="row">
    <div id="upload_file_box" class="col-md-12">
        <form id="upload-form" class="form-inline" method="post" action="{{ url('admin_deck_csv_import') }}" {{ form_enctype(form) }}>
            {{ form_widget(form._token) }}
            <div id="upload_file_box__body" class="box">
                <div id="upload_file_box__header" class="box-header">
                    <h3 class="box-title">デッキ登録CSV, TSV</h3>
                </div><!-- /.box-header -->
                <div id="upload_file_box__body_inner" class="box-body">
                    <div id="upload_file_box__upload_box" class="form-group">
                        <label class="col-sm-5 control-label">CSV, TSVファイル選択</label>
                        <div id="upload_file_box__import_file" class="col-sm-7">
                            {{ form_widget(form.import_file, {'attr': {'accept': '.csv, text/csv, .tsv, text/tsv'}}) }}
                            {{ form_errors(form.import_file) }}
                        </div>
                        <div class="col-sm-4">
                            {{ form_widget(form.strict, {'attr': {'checked': 'checked'}}) }}
                        </div>
                    </div>
                    <div id="spinner"></div>
                </div><!-- /.box-body -->
                <div id="button_box__upload_button" class="box-footer text-center">
