    /**
     * デッキカード登録
     *
     * デッキのボード毎にカードを登録する
     *
     * @param Application $app
     * @param array $cardArray
     * @param dtbDeck $deck
     * @param integer $boardId
     */
    public static function setDeckCards(Application $app, $cardArray, DtbDeck $deck, $boardId)
    {
        $deckId = $deck->getDeckId();
        foreach ($cardArray as $card) {
            // 不明なカード名である場合は飛ばす
            if ($card['cardId'] === self::UNKNOWN_NAME) {
                continue;
            }

            $deckCard = new DtbDeckCard();
            $deckCard->setDeck($deck)
                ->setCard($app['hareruya_ec.repository.card']->find($card['cardId']))
                ->setBoardId($boardId)
                ->setCount($card['count']);

            $app['orm.em']->persist($deckCard);
        }
    }

    /**
     * 文字列からカードの画像や枚数、エラー行番号などの情報を得る
     *
     * @param Application $app
     * @param string $cardListText
     * @param integer $formatId
     * @param array $beforeList	サイドのチェックを行う場合はメインリストが$beforeに入る
     * @param boolean $isFront	フロントなら画像リストも取得する
     * @return array
     */
    public static function getCardsAndImagesList(Application $app, $cardListText, $formatId, $beforeList = null, $isFront = false)
    {
        // 不明扱いカード名(非管理者は不明カードを登録できない)
        $unknownCard = $isFront ? null : $app['config']['HareruyaEc']['const']['deck']['unknown_card'];
                    throw new \RuntimeException(sprintf($this->app->trans('admin.csv.error.format.too_many'), $rowIndex, $headers['side_list'], $sideMaxCardCount));
                }
                $sideMinCardCount = $mtbFormat->getSideMinCardCount();
                if ($this->isStrict && $sideMinCardCount > $sideCardCount) {
                    throw new \RuntimeException(sprintf($this->app->trans('admin.csv.error.format.too_few'), $rowIndex, $headers['side_list'], $sideMinCardCount));
                }
            }

            // 既存データ検索
            $dtbDeck = $this->app['hareruya_ec.repository.deck']->findOneByDeckId($row['deck_id']);
            $insertFlg = !$dtbDeck;
            if ($insertFlg) {
                $dtbDeck = new DtbDeck();
                $this->em->persist($dtbDeck);
            }

            /** CSVデータ登録 */
            $dtbDeck->setPlayerName($row['player_name'])
                ->setFormat($mtbFormat)
                ->setArchetype($dtbArchetype)
                ->setEventDetail($dtbEventDetail)
                ->setDeckName($row['deck_name'])
                ->setWinCount($row['win_count'] === '' ? null : $row['win_count'])
                ->setLossCount($row['loss_count'] === '' ? null : $row['loss_count'])
                ->setDrawCount($row['draw_count'] === '' ? null : $row['draw_count'])
                ->setRanking($row['ranking'] === '' ? null : $row['ranking'])
                ->setResult($row['result'])
                ->setDciNo($row['dci_no'] === '' ? null : $row['dci_no'])
                ->setEventNameEn($row['event_name_en'])
                ->setEventNameJp($row['event_name_jp'])
                ->setEventDate($eventDate)
                ->setSourceUrl($row['source_url'])
                ->setParticipants($row['participants'] === '' ? null : $row['participants'])
                ->setDisp($this->app['eccube.repository.master.disp']->findOneById(Disp::CSV_TO_DISPID[$dispFlg]))
                ->setPrivateFlg($privateFlg)
                ->setTextMain($row['main_list'])
                ->setTextSide($row['side_list'])
                ->setTextCommand(!empty($commander) ? '1 ' . $row['commander'] : null)
                ->setOldDeckId($oldDeckId)
            ;

            if (!empty($row['image_card_name'])) {
                $dtbDeck->setCardImage($this->app['hareruya_ec.repository.card_image']->getOptimalCardImageByCardNameEn($row['image_card_name']));
            }
            // アーキタイプから代表カードを取得
            else {
                $dtbDeck->setCardImage($dtbArchetype->getCardImage());
            }

            $dtbDeck->setMemberId($this->app['security']->getToken()->getUser()->getId());
            if (is_null($dtbDeck->getDeckType())) {
                $dtbDeck->setDeckType($this->app['hareruya_ec.repository.deck_type']->find(MtbDeckType::EVENT_ID));
            }
            $this->em->persist($dtbDeck);

            // デッキリスト公開の場合はデッキリストをDtbDeckCardに登録する
            if ($isDisplayAndNotPrivate) {
                CardUtil::setDeckCards($this->app, $main, $dtbDeck, MtbBoard::BOARD_ID_MAIN);
                CardUtil::setDeckCards($this->app, $side, $dtbDeck, MtbBoard::BOARD_ID_SIDE);
            }
            if (!empty($commander)) {
                CardUtil::setDeckCards($this->app, $commander, $dtbDeck, MtbBoard::BOARD_ID_COMMAND);
            }

            if ($rowIndex % 100 === 0 || $insertFlg) {
                $this->em->flush();
                $this->clearCache();
            }
        }

        $this->em->flush();

