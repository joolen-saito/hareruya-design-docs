            $this->entityManager,
            $this->translator,
            $this->eccubeConfig,
            $handler,
            $User,
        );

        try {
            $result = $importer->import($formFile);
        } catch (\Exception $e) {
            return $this->renderWithErrors($form, [$e->getMessage()]);
        }

        if ($result->hasError()) {
            $errors = array_map(static fn (array $error): string => $error['message'], $result->getErrors());

            return $this->renderWithErrors($form, $errors);
        }

