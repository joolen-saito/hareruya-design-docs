    /**
     * @param list<array{count: int, Card: MtbCard|null, name?: string}> $cards
     */
    private function saveDeckCards(array $cards, DtbDeck $Deck, int $boardId): void
    {
        $Board = $this->em->getReference(MtbBoard::class, $boardId);

        foreach ($cards as $cardData) {
            $Card = $cardData['Card'] ?? null;
            if ($Card === null) {
                continue;
            }

            $DeckCard = new DtbDeckCard();
            $DeckCard->setDeck($Deck)
                ->setCard($Card)
                ->setBoard($Board)
                ->setCount($cardData['count']);
            $this->em->persist($DeckCard);
        }
    }

    private function deleteDeckCards(DtbDeck $Deck): void
    {
        foreach ($this->deckCardRepository->findBy(['Deck' => $Deck]) as $DeckCard) {
            $this->em->remove($DeckCard);
        }
    }

