    public function onReadRow(ReadCsvRowEvent $event): bool
    {
        $row = $event->getRow();
        $playerName = (string) $this->columns['player_name']->getValue($row);
        $formatName = trim((string) $this->columns['format']->getValue($row));
        $archetypeName = trim((string) $this->columns['archetype']->getValue($row));
        $eventDetailId = trim((string) $this->columns['event_detail_id']->getValue($row));
        $deckName = (string) $this->columns['deck_name']->getValue($row);
        $ranking = (string) $this->columns['ranking']->getValue($row);
        $result = (string) $this->columns['result']->getValue($row);
        $tags = (string) $this->columns['tags']->getValue($row);
        $eventNameEn = (string) $this->columns['event_name_en']->getValue($row);
        $eventNameJp = (string) $this->columns['event_name_jp']->getValue($row);
        $eventDateStr = trim((string) $this->columns['event_date']->getValue($row));
        $sourceUrl = (string) $this->columns['source_url']->getValue($row);
        $participants = (string) $this->columns['participants']->getValue($row);
        $dispFlg = trim((string) $this->columns['disp_flg']->getValue($row));
        $privateFlg = trim((string) $this->columns['private_flg']->getValue($row));
        $mainList = (string) $this->columns['main_list']->getValue($row);
        $sideList = (string) $this->columns['side_list']->getValue($row);
        $commanderName = trim((string) $this->columns['commander']->getValue($row));
        $deckId = trim((string) $this->columns['deck_id']->getValue($row));
        $imageCardName = (string) $this->columns['image_card_name']->getValue($row);

        $Format = $this->em->getRepository(MtbFormat::class)->find($this->formatNameToId[$formatName]);
        \assert($Format instanceof MtbFormat);
        $Archetype = $this->findArchetype($archetypeName, $Format);
        \assert($Archetype instanceof DtbArchetype);
        $EventDetail = $eventDetailId !== '' ? $this->eventDetailRepository->find((int) $eventDetailId) : null;

        $commanderCard = null;
        if ($Format->getUseCommandFlg() === true) {
            $commanderCard = $this->findCardByName($commanderName);
        }

        $isDisplayAndPublic = ($dispFlg === self::CSV_DISP_SHOW && $privateFlg === self::CSV_PRIVATE_SHOW);

        $mainCards = [];
        $sideCards = [];
        if ($isDisplayAndPublic) {
            $mainList = str_replace(' // ', '/', $mainList);
            $mainCards = $this->decodeCardList($mainList, $event, $this->columns['main_list']->getLabel());
            if ($event->isBreakAll()) {
                return false;
            }

            if ($commanderCard !== null) {
                $mainCards = $this->removeCommanderFromList($commanderCard, $mainCards);
                $mainList = $this->convertCardsToText($mainCards);
            }

            $sideList = str_replace(' // ', '/', $sideList);
            $sideCards = $this->decodeCardList($sideList, $event, $this->columns['side_list']->getLabel());
            /** @phpstan-ignore-next-line */
            if ($event->isBreakAll()) {
                return false;
            }
        }

        $Deck = null;
        $insertFlg = true;
        if ($deckId !== '') {
            $Deck = $this->deckRepository->find((int) $deckId);
        }
        if ($Deck !== null) {
            $insertFlg = false;
        } else {
            $Deck = new DtbDeck();
            $this->em->persist($Deck);
        }

        $Disp = $this->dispRepository->find(
            $dispFlg === self::CSV_DISP_SHOW ? MtbDisp::DISPLAY_SHOW : MtbDisp::DISPLAY_HIDE
        );

        $Member = $this->em->getRepository(Member::class)->find($this->loginMember->getId());

        $eventDate = $this->parseEventDate($eventDateStr);
        \assert($eventDate instanceof \DateTime);

        $Deck->setPlayerName($playerName)
            ->setFormat($Format)
            ->setArchetype($Archetype)
            ->setEventDetail($EventDetail)
            ->setDeckName($deckName !== '' ? $deckName : null)
            ->setRanking($ranking !== '' ? (int) $ranking : null)
            ->setResult($result !== '' ? $result : null)
            ->setEventNameEn($eventNameEn)
            ->setEventNameJp($eventNameJp)
            ->setEventDate($eventDate)
            ->setSourceUrl($sourceUrl !== '' ? $sourceUrl : null)
            ->setParticipants($participants !== '' ? (int) $participants : null)
            ->setDisp($Disp)
            ->setPrivateFlg($privateFlg === self::CSV_PRIVATE_HIDE)
            ->setTextMain($mainList)
            ->setTextSide($sideList)
            ->setTextCommand($commanderCard !== null ? '1 '.$commanderName : null)
            ->setMember($Member);

        $this->setDeckTags($Deck, $tags);
        $this->setCardImage($Deck, $imageCardName, $Archetype);

        if ($insertFlg) {
            $DeckType = $this->deckTypeRepository->find(MtbDeckType::EVENT_ID);
            if ($DeckType !== null) {
                $Deck->setDeckType($DeckType);
            }
        }

        $now = new \DateTime();
        if ($insertFlg) {
            $Deck->setCreateDate($now);
        }
        $Deck->setUpdateDate($now);

        $this->deleteDeckCards($Deck);
        if ($isDisplayAndPublic) {
            $this->saveDeckCards($mainCards, $Deck, MtbBoard::BOARD_ID_MAIN);
            $this->saveDeckCards($sideCards, $Deck, MtbBoard::BOARD_ID_SIDE);
            if ($commanderCard !== null) {
                $this->saveDeckCards([['count' => 1, 'Card' => $commanderCard]], $Deck, MtbBoard::BOARD_ID_COMMAND);
            }
        }

        return true;
    }

