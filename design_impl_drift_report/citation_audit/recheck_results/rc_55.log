     * @param array<int, DtbCardFormat>                               $cardFormatMap
     *
     * @return array{key: string, params: array<string, scalar>}|null
     */
    private function validateCard(array $card, array $cardFormatMap, bool $isHighlander): ?array
    {
        $baseParams = ['%row%' => $card['row'], '%name%' => $card['name']];

        if ($card['cardId'] === CardListParserService::UNKNOWN_NAME || $card['cardId'] === CardListParserService::UNKNOWN_CARD) {
            return ['key' => 'admin.deck.validation.unknown_card', 'params' => $baseParams];
        }

        $CardFormat = $cardFormatMap[$card['cardId']] ?? null;
        if ($CardFormat === null) {
            return ['key' => 'admin.deck.validation.out_of_range', 'params' => $baseParams];
        }

        $Restriction = $CardFormat->getRestriction();
        if ($Restriction !== null) {
            if ($Restriction->getId() === MtbRestriction::BAN_ID) {
                return ['key' => 'admin.deck.validation.banned', 'params' => $baseParams];
            }
            if ($Restriction->getId() === MtbRestriction::RESTRICTION_ID && $card['count'] > 1) {
                return ['key' => 'admin.deck.validation.restricted', 'params' => $baseParams];
            }
        }

        if ($isHighlander && $card['count'] > 1) {
            return ['key' => 'admin.deck.validation.highlander_only', 'params' => $baseParams];
        }

        if (!$isHighlander && $card['count'] > self::MAX_COUNT_PER_CARD) {
            return [
                'key' => 'admin.deck.validation.more_than_max',
                'params' => array_merge($baseParams, ['%count%' => self::MAX_COUNT_PER_CARD]),
            ];
        }

        return null;
    }

