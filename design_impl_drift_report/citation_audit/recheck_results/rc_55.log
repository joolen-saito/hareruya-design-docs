        $event = new EventArgs(
            [
                'form' => $form,
            ],
            $request
        );
        $this->eventDispatcher->dispatch($event, EccubeEvents::ADMIN_DECK_CSV_INDEX_COMPLETE);

        $this->addSuccess('admin.common.csv_upload_complete', 'admin');

        return $this->redirectToRoute('admin_deck_csv_import');
    }

