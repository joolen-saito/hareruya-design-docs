                  <tr data-excel-ref="0211:受注売上分析 集計一覧(検索結果-集計単位 商品)!AS38" data-pin-no="9" data-pin-status="matched" data-item-candidates="1" data-pin-duplicates="1"><td>(9)</td><td>0211:受注売上分析 集計一覧(検索結果-集計単位 商品)!AS38</td><td>image 1</td><td>matched</td><td>0211:受注売上分析 集計一覧(検索結果-集計単位 商品)!B78</td><td></td></tr>
                  <tr data-excel-ref="0211:受注売上分析 集計一覧(検索結果-集計単位 商品)!AM38" data-pin-no="7" data-pin-status="matched" data-item-candidates="1" data-pin-duplicates="1"><td>(7)</td><td>0211:受注売上分析 集計一覧(検索結果-集計単位 商品)!AM38</td><td>image 1</td><td>matched</td><td>0211:受注売上分析 集計一覧(検索結果-集計単位 商品)!B76</td><td></td></tr>
