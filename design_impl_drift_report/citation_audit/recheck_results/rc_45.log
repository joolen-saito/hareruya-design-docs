   118	    /**
   119	     * 売上の無い日にちを補完する
   120	     *
   121	     * @param  array $order
   122	     * @param  integer $days
   123	     * @return array
   124	     */
   125	    private function complementOrderDay($order, $days)
   126	    {
   127	        $resultSum = 0;
   128	        for ($i = 1; $i < $days + 1; $i++) {
   129	            if (array_key_exists($i, $order)) {
   130	                $resultSum += $order[$i];
   131	            } else {
   132	                $order[$i] = 0;
   133	            }
   134	        }
   135	
   136	        ksort($order);
   137	
   138	        return [
   139	            'days' => $order,
   140	            'sum' => $resultSum,
   141	            'average' => intval($resultSum / $days),
   142	        ];
   143	    }
