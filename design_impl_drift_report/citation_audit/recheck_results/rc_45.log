from html.parser import HTMLParser
from pathlib import Path
import re
root=Path('/home/y-saito/Developments/hareruya-design-docs/excel_to_html/output')
terms=[
 ('date-bound', re.compile(r'集計日|当月末日|23:59:59|未満|上限')),
 ('session-empty', re.compile(r'検索条件|セッション|保存.*無|保存.*ない|空条件')),
 ('csv-unlimited', re.compile(r'全件|件数制限|表示件数|CSV出力|CSVダウンロード')),
 ('format-sales', re.compile(r'フォーマット売上分析|format_sales|集計月|初期値')),
]
class P(HTMLParser):
 def __init__(self):
  super().__init__(convert_charrefs=True); self.stack=[]; self.hits=[]
 def handle_starttag(self,tag,attrs):
  a=dict(attrs); parent=self.stack[-1] if self.stack else None
  active=(a.get('class','').split() and 'src-cell' in a.get('class','').split())
  self.stack.append({'active':active,'ref':a.get('data-excel-ref') if active else None,'buf':[]})
 def handle_startendtag(self,tag,attrs):
  pass
 def handle_data(self,d):
  for x in self.stack:
   if x['active']: x['buf'].append(d)
 def handle_endtag(self,tag):
  if not self.stack:return
  x=self.stack.pop()
  if x['active']:
   t=' '.join(''.join(x['buf']).split())
   if t:self.hits.append((x['ref'],t))

wanted=[]
for p in root.glob('*.html'):
 if any(k in p.name for k in ('0211','0210','0209','0212','0216','管理メニュー')):
  wanted.append(p)
for p in sorted(wanted):
 parser=P(); parser.feed(p.read_text(errors='replace'))
 rows=[]
 for ref,text in parser.hits:
  labs=[lab for lab,rx in terms if rx.search(text)]
  if labs: rows.append((ref,text,labs))
 if rows:
  print('\\nFILE',p.name)
  for ref,text,labs in rows:
   if any(x in text for x in ('未満','当月末日','23:59:59','検索条件','セッション','全件','件数制限','表示件数','CSV出力','CSVダウンロード','フォーマット売上分析','format_sales','集計月','初期値')):
    print(ref, '|', text, '|', ','.join(labs))
