   178	                $csvService->fputcsv($row);
   179	            }
   180	
   181	            $csvService->fclose();
   182	        });
   183	
   184	        $now = new \DateTime();
   185	        $filename = 'format_sales_report_' . $now->format('YmdHis') . '.csv';
