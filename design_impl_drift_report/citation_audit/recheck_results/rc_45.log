    16	namespace Eccube\Controller\Admin\Analysis;
    17	
    18	use Eccube\Controller\AbstractController;
    19	use Eccube\Entity\Member;
    20	use Eccube\Event\EccubeEvents;
    21	use Eccube\Event\EventArgs;
    22	use Eccube\Form\Type\Admin\Analysis\SalesType;
    23	use Eccube\Repository\OrderItemRepository;
    24	use Eccube\Service\Csv\Exporter\SalesAnalysisCsvExporterService;
    25	use Eccube\Util\FormUtil;
    26	use Symfony\Bridge\Twig\Attribute\Template;
    27	use Symfony\Component\HttpFoundation\RedirectResponse;
    28	use Symfony\Component\HttpFoundation\Request;
    29	use Symfony\Component\HttpFoundation\StreamedResponse;
    30	use Symfony\Component\Routing\Attribute\Route;
    31	
    32	class SalesAnalysisController extends AbstractController
    33	{
    34	    private const SESSION_KEY = 'eccube.admin.analysis.sales.search';
    35	
    36	    public function __construct(
    37	        private readonly OrderItemRepository $orderItemRepository,
    38	        private readonly SalesAnalysisCsvExporterService $salesAnalysisCsvExporterService,
    39	    ) {
    40	    }
    41	
    42	    /**
    43	     * @return array<string, mixed>
    44	     */
    45	    #[Route(path: '/%eccube_admin_route%/analysis/sales', name: 'admin_analysis_sales', methods: ['GET'])]
    46	    #[Template(template: '@admin/Analysis/sales.twig')]
    47	    public function index(Request $request): array
    48	    {
    49	        $searchForm = $this->createForm(SalesType::class);
    50	        $searchForm->get('store_sales_targets')->setData($this->resolveMemberShopIds());
    51	
    52	        $event = new EventArgs(
    53	            [
    54	                'form' => $searchForm,
    55	            ],
    56	            $request
    57	        );
    58	        $this->eventDispatcher->dispatch($event, EccubeEvents::ADMIN_ANALYSIS_SALES_ANALYSIS_INDEX_INITIALIZE);
    59	
    60	        return [
    61	            'searchForm' => $searchForm->createView(),
    62	            'searched' => false,
    63	            'summary' => null,
    64	            'total' => null,
    65	            'summaryType' => 'product_id',
    66	        ];
    67	    }
    68	
    69	    /**
    70	     * @return array<string, mixed>
    71	     */
    72	    #[Route(path: '/%eccube_admin_route%/analysis/sales/search', name: 'admin_analysis_sales_search', methods: ['POST'])]
    73	    #[Template(template: '@admin/Analysis/sales.twig')]
    74	    public function search(Request $request): array
    75	    {
    76	        $builder = $this->formFactory->createBuilder(SalesType::class);
    77	
    78	        $event = new EventArgs(
    79	            [
    80	                'builder' => $builder,
    81	            ],
    82	            $request
    83	        );
    84	        $this->eventDispatcher->dispatch($event, EccubeEvents::ADMIN_ANALYSIS_SALES_ANALYSIS_SEARCH_INITIALIZE);
    85	
    86	        $searchForm = $builder->getForm();
    87	        $searchForm->handleRequest($request);
    88	
    89	        if (!$searchForm->isSubmitted() || !$searchForm->isValid()) {
    90	            return [
    91	                'searchForm' => $searchForm->createView(),
    92	                'searched' => false,
    93	                'summary' => null,
    94	                'total' => null,
    95	                'summaryType' => 'product_id',
    96	            ];
    97	        }
    98	
    99	        $searchData = $searchForm->getData();
   100	        $this->session->set(self::SESSION_KEY, FormUtil::getViewData($searchForm));
   101	
   102	        $searchData['base_info_ids'] = $this->resolveTargetBaseInfoIds(
   103	            (bool) ($searchData['mail_order_enabled'] ?? false),
   104	            is_iterable($searchData['store_sales_targets'] ?? null) ? $searchData['store_sales_targets'] : []
   105	        );
   106	        $summary = $this->orderItemRepository->getAnalysisSummary($searchData);
   107	
   108	        $event = new EventArgs(
   109	            [
   110	                'form' => $searchForm,
   111	                'searchData' => $searchData,
   112	            ],
   113	            $request
   114	        );
   115	        $this->eventDispatcher->dispatch($event, EccubeEvents::ADMIN_ANALYSIS_SALES_ANALYSIS_SEARCH);
   116	
   117	        return [
   118	            'searchForm' => $searchForm->createView(),
   119	            'searched' => true,
   120	            'summary' => $summary['result'],
   121	            'total' => $summary['total'],
   122	            'summaryType' => $searchData['summary_type'] ?? 'product_id',
   123	        ];
   124	    }
   125	
   126	    #[Route(path: '/%eccube_admin_route%/analysis/sales/export', name: 'admin_analysis_sales_export', methods: ['GET'])]
   127	    public function export(Request $request): StreamedResponse|RedirectResponse
   128	    {
   129	        $viewData = $this->session->get(self::SESSION_KEY);
   130	        if ($viewData === null) {
   131	            $this->addError('検索条件がありません。先に検索を実行してください。', 'admin');
   132	
   133	            return $this->redirectToRoute('admin_analysis_sales');
   134	        }
   135	
   136	        set_time_limit(0);
   137	        $this->entityManager->getConfiguration()->setSQLLogger(null);
   138	
   139	        $searchForm = $this->createForm(SalesType::class);
   140	        $searchData = FormUtil::submitAndGetData($searchForm, $viewData);
   141	        $searchData['base_info_ids'] = $this->resolveTargetBaseInfoIds(
   142	            (bool) ($searchData['mail_order_enabled'] ?? false),
   143	            is_iterable($searchData['store_sales_targets'] ?? null) ? $searchData['store_sales_targets'] : []
   144	        );
   145	
   146	        $event = new EventArgs(
   147	            [
   148	                'form' => $searchForm,
   149	                'searchData' => $searchData,
   150	            ],
   151	            $request
   152	        );
   153	        $this->eventDispatcher->dispatch($event, EccubeEvents::ADMIN_ANALYSIS_SALES_ANALYSIS_CSV_EXPORT);
   154	
   155	        return $this->salesAnalysisCsvExporterService->exportBySearchData($searchData);
   156	    }
   157	
   158	    /**
   159	     * @param iterable<mixed> $storeSalesTargets
   160	     *
   161	     * @return list<int>
   162	     */
   163	    private function resolveTargetBaseInfoIds(bool $mailOrderEnabled, iterable $storeSalesTargets): array
   164	    {
   165	        $ids = [];
   166	        if ($mailOrderEnabled) {
   167	            $rootBaseInfoId = (int) $this->eccubeConfig->get('eccube_root_base_info_id');
   168	            $ids[$rootBaseInfoId] = $rootBaseInfoId;
   169	        }
   170	
   171	        foreach ($storeSalesTargets as $storeId) {
   172	            $id = (int) $storeId;
   173	            if ($id > 0) {
   174	                $ids[$id] = $id;
   175	            }
   176	        }
   177	
   178	        return array_values($ids);
   179	    }
   180	
   181	    /**
   182	     * @return list<int>
   183	     */
   184	    private function resolveMemberShopIds(): array
   185	    {
   186	        $Member = $this->getUser();
   187	        if (!$Member instanceof Member) {
   188	            return [];
   189	        }
   190	
   191	        $ids = [];
   192	        $baseInfoId = $Member->getBaseInfo()->getId();
   193	        if ($baseInfoId !== null) {
   194	            $ids[$baseInfoId] = $baseInfoId;
   195	        }
   196	
   197	        foreach ($Member->getMemberBaseInfos() as $MemberBaseInfo) {
   198	            $id = $MemberBaseInfo->getBaseInfo()->getId();
   199	            if ($id !== null) {
   200	                $ids[$id] = $id;
   201	            }
   202	        }
   203	
   204	        return array_values($ids);
   205	    }
   206	}
