    84	        foreach ($resultNoTagKeys as $resultNoTagKey) {
    85	            $noTagSales_single = $app['hareruya_ec.repository.order']->getFormatNoTagSalesSummary($app, $inputDate, $resultNoTagKey === 'その他(カード)' ? "not" : null);
    86	            $resultInfo[$resultNoTagKey] = $this->complementOrderDay(array_column($noTagSales_single, 'price', 'day'), $days);
    87	            $resultDays[] = $resultInfo[$resultNoTagKey]['days'];
    88	            unset($resultInfo[$resultNoTagKey]['days']);
    89	        }
    90	
    91	        // 日にち毎の売上情報に変換＆日にち毎の合計算出
    92	        $formatSales = [];
    93	        $daySum = array_fill(1, $days, 0);
    94	        foreach ($resultDays as $sales) {
    95	            foreach ($sales as $key => $value) {
    96	                $formatSales[$key][] = $value;
    97	                $daySum[$key] += $value;
    98	            }
