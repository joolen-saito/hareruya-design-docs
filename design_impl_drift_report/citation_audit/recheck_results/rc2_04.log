    public function csv(Request $request): Response
    {
        $form = $this->createForm(CsvImportType::class);
        $form->handleRequest($request);

        $pagination = $this->getCsvImportHistoryPaginationParams(
            $request,
            'admin.product.product_standard_price_csv.page_count',
            'admin.product.product_standard_price_csv.page_no',
        );
        $pageCount = $pagination['pageCount'];
        $pageNo = $pagination['pageNo'];
        $pageCountOptions = $pagination['pageCountOptions'];

        $qb = $this->csvImportHistoryRepository->getQueryBuilderByCsvImportType(MtbCsvImportType::PRODUCT_STANDARD_PRICE_IMPORT_CSV_ID);
        $importHistoriesPagination = $this->paginator->paginate($qb, $pageNo, $pageCount);

        $headers = $this->getCsvHeader();

        return $this->render('@admin/Product/csv_product_standard_price.twig', [
            'form' => $form->createView(),
            'headers' => $headers,
            'csv_required_header_keys' => array_keys($this->getRequiredCsvHeader()),
            'csv_box_title' => 'admin.product.product_standard_price_csv_upload_title',
            'csv_format_title' => 'admin.product.product_standard_price_csv_format_title',
            'form_action_route' => 'admin_product_product_standard_price_import',
            'template_download_route' => 'admin_product_product_standard_price_csv_template',
            'import_histories_pagination' => $importHistoriesPagination,
            'history_page_route' => 'admin_product_product_standard_price_csv_upload',
            'page_no' => $pageNo,
            'page_count' => $pageCount,
            'pageMax' => $pageCountOptions,
        ]);
    }

    /**
     * 基準価格変更CSV取込
     *
     * @param Request $request
     *
     * @return RedirectResponse
     */
    #[Route(path: '/%eccube_admin_route%/product/product_standard_price/import', name: 'admin_product_product_standard_price_import', methods: ['POST'])]
    public function import(Request $request): RedirectResponse
    {
        /** @var Member $Member */
        $Member = $this->getUser();

        $form = $this->formFactory->createBuilder(CsvImportType::class)->getForm();
        $form->handleRequest($request);

        if (!$form->isValid()) {
            foreach ($form->getErrors() as $error) {
                $this->addError($error->getMessage(), 'admin');
            }

            return $this->redirectToRoute('admin_product_product_standard_price_csv_upload');
        }
        /** @var UploadedFile|null $formFile */
        $formFile = $form['import_file']->getData();

        if ($formFile === null) {
            $this->addError('admin.common.csv_invalid_format', 'admin');

            return $this->redirectToRoute('admin_product_product_standard_price_csv_upload');
        }

        if ($this->countCsvRows($formFile) >= static::ADMIN_CSV_IMPORT_MAX_ROWS) {
            $this->addError($this->getCsvImportMaxRowsExceededMessage(), 'admin');

            return $this->redirectToRoute('admin_product_product_standard_price_csv_upload');
        }

        log_info('基準価格変更CSV登録開始');

        $handler = new ProductStandardPriceImportHandler(
            $this->productRepository,
            $this->productClassRepository,
            $this->dtbPriceHistoryRepository,
            $this->smaregiProductClassCsvImportUpsertCoordinatorFactory->create('基準価格変更CSVインポート後'),
            $this->standardPriceCalculator,
            $this->discountBuyPriceCalculator,
        );
        $importer = new CsvImporter(
            $this->entityManager,
            $this->translator,
            $this->eccubeConfig,
            $handler,
            $Member
        );
        $result = $importer->import($formFile);

        if ($result->hasError()) {
            log_info('基準価格変更CSV登録 異常終了');
            foreach ($result->getErrors() as $error) {
                $this->addError($error['message'], 'admin');
            }
        } else {
            $this->addSuccess('admin.register.complete', 'admin');
            log_info('基準価格変更CSV登録完了', ['count' => $result->getCount()]);
            foreach ($result->getInfos() as $info) {
                $this->addWarning($info['message'], 'admin');
            }
            $this->csvImportHistoryRepository->insertCsvImportHistory(
                MtbCsvImportType::PRODUCT_STANDARD_PRICE_IMPORT_CSV_ID,
                $formFile->getClientOriginalName(),
                $Member->getId()
            );

            $event = new EventArgs(
                [
                    'form' => $form,
                    'result' => $result,
                ],
                $request
            );
            $this->eventDispatcher->dispatch($event, EccubeEvents::ADMIN_PRODUCT_CSV_PRODUCT_STANDARD_PRICE_CSV_IMPORT_COMPLETE);
        }

        return $this->redirectToRoute('admin_product_product_standard_price_csv_upload');
    }

