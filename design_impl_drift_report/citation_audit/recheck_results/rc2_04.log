    33	    }
    34	
    35	    public function dispatchUpsert(ProductClass $productClass): void
    36	    {
    37	        if (!$productClass->getSmaregiAlignmentFlg()) {
    38	            return;
    39	        }
    40	
    41	        $smaregiProductCode = $productClass->getSmaregiProductCode();
    42	        if ($smaregiProductCode === null || trim($smaregiProductCode) === '') {
    43	            return;
    44	        }
    45	
    46	        $id = $productClass->getId();
    47	        if ($id === null) {
    48	            return;
    49	        }
    50	
    51	        $job = new MessengerJob();
    52	        $job->setMessageClass(SmaregiProductClassUpsertMessage::class);
    53	        $job->setStatus(MessengerJob::STATUS_PENDING);
    54	        $job->setPayloadSummary(sprintf(
    55	            'productClassId=%d productId=%s smaregiProductId=%s',
    56	            $id,
    57	            (string) ($productClass->getProduct()?->getId() ?? ''),
    58	            (string) ($productClass->getSmaregiProductId() ?? ''),
    59	        ));
    60	        $this->entityManager->persist($job);
    61	        $this->entityManager->flush();
    62	
    63	        try {
    64	            $this->messageBus->dispatch(new SmaregiProductClassUpsertMessage(
    65	                $id,
    66	                (int) $job->getId(),
    67	            ));
    68	        } catch (\Throwable $e) {
    69	            try {
    70	                $job->setStatus(MessengerJob::STATUS_FAILED);
    71	                $job->setCompletedAt(new \DateTime());
    72	                $job->setErrorMessage('メッセージバスへの投入に失敗しました: '.$e->getMessage());
    73	                $this->entityManager->flush();
    74	            } catch (\Throwable $persistError) {
    75	                $this->logger->error('Failed to persist Smaregi product class upsert job failure state', [
    76	                    'jobId' => $job->getId(),
    77	                    'productClassId' => $id,
    78	                    'error' => $persistError->getMessage(),
    79	                ]);
    80	            }
    81	            $this->logger->error('Smaregi product class upsert message dispatch failed', [
    82	                'exception' => $e,
    83	                'jobId' => $job->getId(),
    84	                'productClassId' => $id,
    85	            ]);
    86	
    87	            throw $e;
    88	        }
    89	    }
    90	
    91	    /**
    92	     * 商品規格削除と同一 DB トランザクションで呼ぶこと（flush は呼び出し側）.
    93	     * コミット後に {@see dispatchDeleteMessage()} を実行する.
    94	     */
    95	    public function registerDeleteJob(int $productClassId, int $productId, string $smaregiProductId): MessengerJob
    96	    {
    97	        $job = new MessengerJob();
    98	        $job->setMessageClass(SmaregiProductClassDeleteMessage::class);
    99	        $job->setStatus(MessengerJob::STATUS_PENDING);
   100	        $job->setPayloadSummary(sprintf(
   101	            'productClassId=%d productId=%d smaregiProductId=%s',
   102	            $productClassId,
   103	            $productId,
   104	            $smaregiProductId,
   105	        ));
   106	        $this->entityManager->persist($job);
   107	
   108	        return $job;
   109	    }
   110	
   111	    /**
   112	     * registerDeleteJob の flush / commit 成功後にのみ呼ぶ。
   113	     * メッセージバス投入に失敗しても例外は投げず、ジョブを FAILED にしてログする（EC 側処理は既に確定している想定）。
   114	     * FAILED 更新時の {@see EntityManagerInterface::flush()} が失敗しても例外は伝播させない.
   115	     */
   116	    public function dispatchDeleteMessage(MessengerJob $job, int $productClassId, int $productId, string $smaregiProductId): void
   117	    {
   118	        $jobId = (int) $job->getId();
   119	        if ($jobId < 1) {
   120	            $this->logger->error('Smaregi delete job has no id; cannot dispatch message bus.', [
   121	                'productClassId' => $productClassId,
   122	                'productId' => $productId,
   123	            ]);
   124	
   125	            return;
   126	        }
   127	
   128	        try {
   129	            $this->messageBus->dispatch(new SmaregiProductClassDeleteMessage(
   130	                $productClassId,
   131	                $productId,
   132	                $smaregiProductId,
   133	                $jobId,
   134	            ));
   135	        } catch (\Throwable $e) {
   136	            try {
   137	                $managed = $this->entityManager->find(MessengerJob::class, $jobId);
   138	                if ($managed instanceof MessengerJob) {
   139	                    $managed->setStatus(MessengerJob::STATUS_FAILED);
