index 0000000000000000000000000000000000000000..f4dc0339e10108dd4c8113ae31ba435d679573e8
--- /dev/null
+++ b//tmp/extract_sheet_images.py
@@ -0,0 +1,45 @@
+#!/usr/bin/env python3
+import base64
+import html
+import pathlib
+import re
+import sys
+
+
+def main() -> None:
+    source = pathlib.Path(sys.argv[1])
+    outdir = pathlib.Path(sys.argv[2])
+    sheets = sys.argv[3:]
+    raw = source.read_text(encoding="utf-8")
+    outdir.mkdir(parents=True, exist_ok=True)
+    for sheet in sheets:
+        start_match = re.search(
+            rf'<section class="sheet-panel" id="{re.escape(sheet)}">',
+            raw,
+        )
+        if not start_match:
+            print(f"{sheet}: section not found")
+            continue
+        end_match = re.search(
+            r'<section class="sheet-panel" id="sheet-\d+">',
+            raw[start_match.end():],
+        )
+        end = start_match.end() + end_match.start() if end_match else len(raw)
+        section = raw[start_match.start():end]
+        tags = re.findall(r'<img\b[^>]*>', section)
+        print(f"{sheet}: {len(tags)} image(s)")
+        for index, tag in enumerate(tags, 1):
+            src_match = re.search(r'src="data:image/([a-zA-Z0-9.+-]+);base64,([^"]+)"', tag)
+            ref_match = re.search(r'data-excel-ref="([^"]+)"', tag)
+            if not src_match:
+                print(f"  {index}: no embedded source")
+                continue
+            kind = src_match.group(1).lower()
+            suffix = "jpg" if kind in {"jpeg", "jpg"} else kind
+            target = outdir / f"{source.stem}_{sheet}_{index}.{suffix}"
+            target.write_bytes(base64.b64decode(html.unescape(src_match.group(2))))
+            print(f"  {target} ref={html.unescape(ref_match.group(1)) if ref_match else '-'}")
+
+
+if __name__ == "__main__":
+    main()

