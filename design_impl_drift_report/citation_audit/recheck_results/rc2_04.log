   125	    /**
   126	     * 基準価格変更CSV取込
   127	     *
   128	     * @param Request $request
   129	     *
   130	     * @return RedirectResponse
   131	     */
   132	    #[Route(path: '/%eccube_admin_route%/product/product_standard_price/import', name: 'admin_product_product_standard_price_import', methods: ['POST'])]
   133	    public function import(Request $request): RedirectResponse
   134	    {
   135	        /** @var Member $Member */
   136	        $Member = $this->getUser();
   137	
   138	        $form = $this->formFactory->createBuilder(CsvImportType::class)->getForm();
   139	        $form->handleRequest($request);
   140	
   141	        if (!$form->isValid()) {
   142	            foreach ($form->getErrors() as $error) {
   143	                $this->addError($error->getMessage(), 'admin');
   144	            }
   145	
   146	            return $this->redirectToRoute('admin_product_product_standard_price_csv_upload');
   147	        }
   148	        /** @var UploadedFile|null $formFile */
   149	        $formFile = $form['import_file']->getData();
   150	
   151	        if ($formFile === null) {
   152	            $this->addError('admin.common.csv_invalid_format', 'admin');
   153	
   154	            return $this->redirectToRoute('admin_product_product_standard_price_csv_upload');
   155	        }
   156	
   157	        if ($this->countCsvRows($formFile) >= static::ADMIN_CSV_IMPORT_MAX_ROWS) {
   158	            $this->addError($this->getCsvImportMaxRowsExceededMessage(), 'admin');
   159	
   160	            return $this->redirectToRoute('admin_product_product_standard_price_csv_upload');
   161	        }
   162	
   163	        log_info('基準価格変更CSV登録開始');
   164	
   165	        $handler = new ProductStandardPriceImportHandler(
   166	            $this->productRepository,
   167	            $this->productClassRepository,
   168	            $this->dtbPriceHistoryRepository,
   169	            $this->smaregiProductClassCsvImportUpsertCoordinatorFactory->create('基準価格変更CSVインポート後'),
   170	            $this->standardPriceCalculator,
   171	            $this->discountBuyPriceCalculator,
   172	        );
   173	        $importer = new CsvImporter(
   174	            $this->entityManager,
   175	            $this->translator,
   176	            $this->eccubeConfig,
   177	            $handler,
   178	            $Member
   179	        );
   180	        $result = $importer->import($formFile);
   181	
   182	        if ($result->hasError()) {
   183	            log_info('基準価格変更CSV登録 異常終了');
   184	            foreach ($result->getErrors() as $error) {
   185	                $this->addError($error['message'], 'admin');
   186	            }
   187	        } else {
   188	            $this->addSuccess('admin.register.complete', 'admin');
   189	            log_info('基準価格変更CSV登録完了', ['count' => $result->getCount()]);
   190	            foreach ($result->getInfos() as $info) {
   191	                $this->addWarning($info['message'], 'admin');
   192	            }
   193	            $this->csvImportHistoryRepository->insertCsvImportHistory(
   194	                MtbCsvImportType::PRODUCT_STANDARD_PRICE_IMPORT_CSV_ID,
   195	                $formFile->getClientOriginalName(),
   196	                $Member->getId()
   197	            );
   198	
   199	            $event = new EventArgs(
   200	                [
   201	                    'form' => $form,
   202	                    'result' => $result,
   203	                ],
   204	                $request
   205	            );
   206	            $this->eventDispatcher->dispatch($event, EccubeEvents::ADMIN_PRODUCT_CSV_PRODUCT_STANDARD_PRICE_CSV_IMPORT_COMPLETE);
   207	        }
   208	
   209	        return $this->redirectToRoute('admin_product_product_standard_price_csv_upload');
   210	    }
