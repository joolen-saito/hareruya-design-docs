    89	    #[Route(path: '/%eccube_admin_route%/product/product_standard_price_csv_upload', name: 'admin_product_product_standard_price_csv_upload', methods: ['GET'])]
    90	    public function csv(Request $request): Response
    91	    {
    92	        $form = $this->createForm(CsvImportType::class);
    93	        $form->handleRequest($request);
    94	
    95	        $pagination = $this->getCsvImportHistoryPaginationParams(
    96	            $request,
    97	            'admin.product.product_standard_price_csv.page_count',
    98	            'admin.product.product_standard_price_csv.page_no',
    99	        );
   100	        $pageCount = $pagination['pageCount'];
   101	        $pageNo = $pagination['pageNo'];
   102	        $pageCountOptions = $pagination['pageCountOptions'];
   103	
   104	        $qb = $this->csvImportHistoryRepository->getQueryBuilderByCsvImportType(MtbCsvImportType::PRODUCT_STANDARD_PRICE_IMPORT_CSV_ID);
   105	        $importHistoriesPagination = $this->paginator->paginate($qb, $pageNo, $pageCount);
   106	
   107	        $headers = $this->getCsvHeader();
   108	
   109	        return $this->render('@admin/Product/csv_product_standard_price.twig', [
   110	            'form' => $form->createView(),
   111	            'headers' => $headers,
   112	            'csv_required_header_keys' => array_keys($this->getRequiredCsvHeader()),
   113	            'csv_box_title' => 'admin.product.product_standard_price_csv_upload_title',
   114	            'csv_format_title' => 'admin.product.product_standard_price_csv_format_title',
   115	            'form_action_route' => 'admin_product_product_standard_price_import',
   116	            'template_download_route' => 'admin_product_product_standard_price_csv_template',
   117	            'import_histories_pagination' => $importHistoriesPagination,
   118	            'history_page_route' => 'admin_product_product_standard_price_csv_upload',
   119	            'page_no' => $pageNo,
