    /**
     * 更新者として設定する連携用アカウント (dtb_member.smaregi_member_flg=true) を解決する。
     * smaregi_member_flg は一意保証が無いため、id 昇順で決定的に1件目を採用し、複数該当は
     * 運用設定ミスとして警告ログを残す。該当アカウントが無ければ更新者を設定せず null を返す。
     */
    private function resolveSmaregiOperator(): ?Member
    {
        $operators = $this->memberRepository->findBy(['smaregi_member_flg' => true], ['id' => 'ASC']);
        if ($operators === []) {
            $this->logger->warning('No Smaregi operator member (smaregi_member_flg) found; order operator will not be set');

            return null;
        }

        if (count($operators) > 1) {
            $this->logger->warning('Multiple Smaregi operator members (smaregi_member_flg) found; using the smallest id', [
                'memberIds' => array_map(static fn (Member $operator): ?int => $operator->getId(), $operators),
            ]);
        }

        return $operators[0];
    /**
     * 更新者として設定するスマレジ用アカウント (dtb_member.smaregi_member_flg=true) を解決する。
     * フラグの立ったアカウントが無い場合は更新者を変更せず null を返す。
     */
    private function resolveSmaregiOperator(): ?Member
    {
        $SmaregiOperator = $this->memberRepository->findOneBy(['smaregi_member_flg' => true]);
        if (!$SmaregiOperator instanceof Member) {
            $this->logger->warning('No Smaregi operator member (smaregi_member_flg) found; order operator will not be updated');

            return null;
        }

        return $SmaregiOperator;

