    <script nonce="{{ csp_nonce }}">
        $(function () {
            $('form[name="top_banner_upload"]').on('submit', function (event) {
                const $form = $(this);
                const $fileInput = $form.find('input[type="file"]');
                const $errorBox = $('#top-banner-upload-error');
                if ($errorBox.length) {
                    $errorBox.text('');
                }
                if ($fileInput.length && !$fileInput.val()) {
                    if ($errorBox.length) {
                        $errorBox.text('{{ 'admin.data.top_banner.upload_required'|trans }}');
                    }
                    event.preventDefault();
                }
            });

            function copyString(textString) {
                const $tmpAttr = $('<div></div>');
                $tmpAttr.text(textString);
                $tmpAttr.css({
                    position: 'absolute',
                    left: '-100%',
                });
                $('body').append($tmpAttr);
                const selection = document.getSelection();
                if (selection) {
                    selection.removeAllRanges();
                    'choices' => $languageChoices,
                    'data' => $TopBanner->getLanguages()->map(
                        static fn (MtbLanguage $Language): int => $Language->getId()
                    )->toArray(),
                ])
                ->add($sortNo, IntegerType::class, [
                    'label' => 'admin.data.top_banner.sort_no',
                    'data' => $TopBanner->getId(),
                ]);
        }

        $builder->addEventListener(FormEvents::POST_SUBMIT, function (FormEvent $event) use ($TopBanners): void {
            $form = $event->getForm();
            $sortNoValues = [];
            foreach ($TopBanners as $TopBanner) {
                $fieldName = 'sort_no_'.$TopBanner->getId();
                $sortNo = $form->get($fieldName)->getData();
                if ($sortNo === null || $sortNo === '') {
                    $form->get($fieldName)->addError(new FormError(
                        trans('admin.data.top_banner.sort_no_required', [], 'validators')
                    ));
                    continue;
                }
                $sortNoValues[(int) $sortNo][] = $fieldName;
            }

            foreach ($sortNoValues as $fieldNames) {
                if (count($fieldNames) > 1) {
                    foreach ($fieldNames as $fieldName) {
                        $form->get($fieldName)->addError(new FormError(
                            trans('admin.data.top_banner.sort_no_duplicate', [], 'validators')
                        ));
                    }
                }
            }
        });
    }
}
