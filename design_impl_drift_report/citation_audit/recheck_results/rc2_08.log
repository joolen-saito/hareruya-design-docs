import base64, pathlib, re
root = pathlib.Path('/home/y-saito/Developments/hareruya-design-docs/excel_to_html/output')
out = pathlib.Path('/tmp/rc2_08_images')
out.mkdir(exist_ok=True)
targets = {
 '0201_基本設計仕様書(システム設定).html': [4],
 '0208_基本設計仕様書(カード管理).html': [10,11,12],
 '0212_基本設計仕様書(デッキ管理).html': [5],
 '0213_基本設計仕様書(データ管理).html': [3,5,10],
 '0214_基本設計仕様書(イベント管理).html': [9,19,20],
}
for name, sheets in targets.items():
    raw=(root/name).read_text()
    book=name[:4]
    for sheet in sheets:
        start=raw.index(f'<section class=\"sheet-panel\" id=\"sheet-{sheet}\">')
        m=re.search(r'<section class=\"sheet-panel\" id=\"sheet-\\d+\">', raw[start+1:])
        end=start+1+m.start() if m else len(raw)
        section=raw[start:end]
        imgs=re.findall(r'<img["'^>]+src="data:image/(png|jpeg);base64,([A-Za-z0-9+/=]+)"[''^>]*alt="([''^"]*)"'"', section)
        for i,(ext,data,alt) in enumerate(imgs,1):
            p=out/f'{book}_sheet-{sheet}_{i}.{\"jpg\" if ext==\"jpeg\" else ext}'
            p.write_bytes(base64.b64decode(data))
            print(f'{p}\\t{alt}')
