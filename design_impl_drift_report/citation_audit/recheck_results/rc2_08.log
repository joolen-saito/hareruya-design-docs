    /**
     * デッキCSV出力.
     */
    #[Route('/%eccube_admin_route%/deck/csv_export', name: 'admin_deck_csv_export', methods: ['POST'])]
    public function csvExport(Request $request): StreamedResponse|RedirectResponse
    {
        $token = $request->request->get('_token');
        if (!$this->isCsrfTokenValid('admin_deck_csv_export', $token)) {
            $this->addError('admin.common.csrf_invalid', 'admin');

            return $this->redirectToRoute('admin_deck_list');
        }

        $pageNo = $this->session->get($this->sessionKey.'.page_no', 1);

        /** @var array<int, string> $rawDeckIds */
        $rawDeckIds = $request->request->all('deckId');
        $deckIds = array_values(array_unique(array_filter(array_map('intval', $rawDeckIds), fn (int $id): bool => $id > 0)));

        if ($deckIds === []) {
            $this->addError('admin.deck.csv_export_no_selection', 'admin');

            return $this->redirectToRoute('admin_deck_search', ['page_no' => $pageNo]);
        }

        if ($this->deckRepository->findByDeckIds($deckIds) === []) {
            $this->addError('admin.deck.csv_export_no_selection', 'admin');

            return $this->redirectToRoute('admin_deck_search', ['page_no' => $pageNo]);
        }

        $event = new EventArgs([], $request);
        $this->eventDispatcher->dispatch($event, EccubeEvents::ADMIN_DECK_CSV_EXPORT);

        return $this->deckCsvExporterService->exportByIds('deck', $deckIds);
    }

    // TODO: ECCUBE_HARERUYA-107 デッキ登録CSV
