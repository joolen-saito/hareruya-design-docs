import re
class P(HTMLParser):
    def __init__(self, targets, patterns):
        super().__init__(convert_charrefs=True); self.targets={f'sheet-{x}' for x in targets}; self.patterns=re.compile(patterns); self.stack=[]; self.active=None; self.embed=0; self.cap=None
    def handle_starttag(self,tag,attrs):
        a=dict(attrs)
        if tag=='section':
            sid=a.get('id'); self.stack.append(sid)
            if sid in self.targets:self.active=sid
            if self.active and 'function-design-embed' in a.get('class','').split():self.embed+=1
        if tag=='span' and self.active and not self.embed and 'src-cell' in a.get('class','').split():
            self.cap=[self.getpos()[0],a.get('data-excel-ref'),[]]
    def handle_data(self,data):
        if self.cap:self.cap[2].append(data)
    def handle_endtag(self,tag):
