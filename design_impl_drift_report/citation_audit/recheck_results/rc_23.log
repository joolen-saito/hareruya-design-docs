from html.parser import HTMLParser
from pathlib import Path
import base64, tempfile

out=Path(tempfile.mkdtemp(prefix='rc23_images_',dir='/tmp'))
class P(HTMLParser):
    def __init__(self, targets, label):
        super().__init__(convert_charrefs=True)
        self.targets={f'sheet-{x}' for x in targets}; self.label=label
        self.section_stack=[]; self.active=None; self.embed=0; self.counts={}
    def handle_starttag(self, tag, attrs):
        a=dict(attrs)
        if tag=='section':
            sid=a.get('id')
            self.section_stack.append(sid)
            if sid in self.targets: self.active=sid
            if self.active and 'function-design-embed' in a.get('class','').split(): self.embed+=1
        if tag=='img' and self.active and not self.embed and 'image-layer-img' in a.get('class','').split():
            src=a.get('src','')
            if src.startswith('data:image/') and ';base64,' in src:
                mime,dat=src.split(';base64,',1)
                ext=mime.rsplit('/',1)[-1].replace('jpeg','jpg')
                n=self.counts.get(self.active,0)+1; self.counts[self.active]=n
                p=out/f'{self.label}_{self.active}_{n}.{ext}'
                p.write_bytes(base64.b64decode(dat))
                print(p)
    def handle_endtag(self, tag):
        if tag=='section':
            sid=self.section_stack.pop() if self.section_stack else None
            if self.active and self.embed and sid and sid.startswith('function-design-'):
                self.embed-=1
            if sid==self.active: self.active=None

for fn, ids, label in [
