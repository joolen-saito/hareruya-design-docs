            line,ref,parts=self.cap; txt=' '.join(''.join(parts).split())
            if self.patterns.search(txt):print(f'{self.active}:{line}\\t{ref}\\t{txt}')
            self.cap=None
        if tag=='section':
            sid=self.stack.pop() if self.stack else None
            if self.active and self.embed and sid and sid.startswith('function-design-'):self.embed-=1
            if sid==self.active:self.active=None
