    #[Route(path: '/%eccube_admin_route%/product/storage_code/csv', name: 'admin_product_storage_code_csv', methods: ['GET'])]
    public function csv(Request $request): Response
    {
        $form = $this->createForm(CsvImportType::class);
        $form->handleRequest($request);

        $headers = $this->getCsvHeader();

        return $this->render('@admin/Product/csv_product_storage_code.twig', [
            'form' => $form->createView(),
            'headers' => $headers,
        ]);
    }

    /**
     * 略称タグCSV入力
     *
     * @param Request $request
     *
     * @return RedirectResponse
     */
    #[Route(path: '/%eccube_admin_route%/product/storage_code/import', name: 'admin_product_storage_code_import', methods: ['POST'])]
    public function import(Request $request): RedirectResponse
    {
        $storageCodeCsv = new StorageCodeCsv(
            $this->entityManager,
            $this->translator,
            $this->eccubeConfig,
            $this->storageCodeRepository,
            $this->getCsvHeader(),
            $this->getRequiredCsvHeader()
        );

        $form = $this->formFactory->createBuilder(CsvImportType::class)->getForm();
        $form->handleRequest($request);

        if (!$storageCodeCsv->checkFormValid($form)) {
            foreach ($storageCodeCsv->getErrors() as $error) {
                $this->addError($error->getMessage(), 'admin');
            }
            $storageCodeCsv->deleteTempData();

            return $this->redirectToRoute('admin_product_storage_code_csv');
        }

        $formFile = $storageCodeCsv->getFormFile($form);
        if ($formFile === null) {
            $this->addError('admin.common.csv_invalid_format', 'admin');
            $storageCodeCsv->deleteTempData();

            return $this->redirectToRoute('admin_product_storage_code_csv');
        }

        log_info('略称タグCSV登録開始');
        $data = $storageCodeCsv->getImportData($formFile);

        if ($data === false) {
            $this->addError('admin.common.csv_invalid_format', 'admin');
            $storageCodeCsv->deleteTempData();
            log_info('略称タグCSVインポートでエラーが発生しました');

            return $this->redirectToRoute('admin_product_storage_code_csv');
        }

        try {
            $headers = $this->getCsvHeader();
            $columnHeaders = array_filter($data->getColumnHeaders());
            $storageCodeCsv->checkHeaderValues(array_keys($headers), $columnHeaders, $this->getNotRequiredCsvHeader());
            $headerSize = count($columnHeaders);
            $storageCodeCsv->checkDataSize($data);
            $this->entityManager->getConnection()->getConfiguration()->setSQLLogger(null);

            $storageCodeCsv->register(array_keys($headers), $headerSize, $data);
        } catch (\Throwable $e) {
            log_info('エラーが発生しました', [$e->getMessage()]);
            $this->addError($e->getMessage(), 'admin');
            $storageCodeCsv->deleteTempData();

            return $this->redirectToRoute('admin_product_storage_code_csv');
        }

        log_info('略称タグCSV登録完了');
        $this->addSuccess('admin.register.complete', 'admin');
        $storageCodeCsv->deleteTempData();

        $event = new EventArgs(
            [
        return $this->paginator->paginate($qb, $pageNo, $pageCount);
    }

    /**
     * 略称タグCSVヘッダー定義
     *
     * @return array<string, string>
     */
    private function getCsvHeader(): array
    {
        return [
            'ID' => 'ID',
            '名称' => '名称',
            '並び順' => '並び順',
        ];
    }

    /**
     * 略称タグCSV必須ヘッダー定義
     *
     * @return array<string, string>
     */
    private function getRequiredCsvHeader(): array
    {
        return [
            '名称' => '名称',
            '並び順' => '並び順',
        ];
    }

    /**
     * 略称タグCSV必須外ヘッダー（比較から除外）
     *
     * @return array<int, string>
     */
    private function getNotRequiredCsvHeader(): array
    {
        return ['ID'];
    }
}
     *
     * @param array<int, string> $headers
     * @param int $headerSize
     * @param \Iterator<array<string, string>> $data
     *
     * @throws \RuntimeException
     * @throws \Throwable
     */
    public function register(array $headers, int $headerSize, \Iterator $data): void
    {
        $requiredHeaders = $this->requiredCsvHeader;
        $this->importedRanks = [];

        $this->entityManager->getConnection()->beginTransaction();

        try {
            $i = 0;
            foreach ($data as $row) {
                $rowIndex = $i + 2;

                if (end($row) === '') {
                    array_pop($row);
                }

                $this->checkHeaderSize($headerSize, $row, $rowIndex);
                $this->checkRequiredHeaders($requiredHeaders, $row, $rowIndex);

                $rank = $row['並び順'] ?? '';
                if (isset($this->importedRanks[$rank])) {
                    $message = $this->translator->trans(
                        'admin.storagecode.duplicate_csv_rank_error',
                        ['%row%' => $rowIndex],
                        'messages'
                    );
                    throw new \RuntimeException($message);
                }

                $existingByName = $this->storageCodeRepository->findOneBy(['name' => $row['名称']]);
                $rowId = isset($row['ID']) ? (int) $row['ID'] : null;
                if ($existingByName !== null && $existingByName->getId() !== $rowId) {
                    $message = $this->translator->trans(
                        'admin.storagecode.duplicate_error',
                        ['%row%' => $rowIndex],
                        'messages'
                    );
                    throw new \RuntimeException($message);
                }

                $mtbStorageCode = null;
                if ($rowId !== null && $rowId !== 0) {
                    $mtbStorageCode = $this->storageCodeRepository->find($rowId);
                }

                if ($mtbStorageCode === null) {
                    $mtbStorageCode = new MtbStorageCode();
                }

                $mtbStorageCode
                    ->setName($row['名称'])
                    ->setRank((int) $row['並び順']);

                $this->entityManager->persist($mtbStorageCode);
                $this->importedRanks[$row['並び順']] = true;

                if ($rowIndex % 100 === 0) {
                    $this->entityManager->flush();
                    $this->clearCache();
                }
                $i++;
            }

            );

            $event = new EventArgs(
                [
                    'form' => $form,
                    'result' => $result,
                ],
                $request
            );
            $this->eventDispatcher->dispatch($event, EccubeEvents::ADMIN_PRODUCT_CSV_PRODUCT_STATUS_CSV_IMPORT_COMPLETE);
        }

        return $this->redirectToRoute('admin_product_status_csv_upload');
    }

    /**
     * 商品公開CSVヘッダー定義
     *
     * @return array<string, string>
     */
    private function getCsvHeader(): array
    {
        return [
            '商品ID' => '',
            '商品公開ステータス' => '2:非公開 1:公開',
            '支店の商品公開ステータス' => '0:非公開 1:公開',
        ];
    }

    /**
     * 商品公開CSV必須ヘッダー定義
     *
     * @return array<string, string>
     */
    private function getRequiredCsvHeader(): array
    {
        return [
            '商品ID' => '商品ID',
            '商品公開ステータス' => '商品公開ステータス',
            '支店の商品公開ステータス' => '支店の商品公開ステータス',
        ];
    }
}
    /**
     * CSVデータ1行を取り込む。
     *
     * @return bool 読み込みに成功した場合 true
     */
    public function onReadRow(ReadCsvRowEvent $event): bool
    {
        $row = $event->getRow();
        $productId = (int) $this->productIdColumn->getValue($row);
        $statusValue = (int) $this->statusColumn->getValue($row);
        $isBranchPublishedValue = (int) $this->isBranchPublishedColumn->getValue($row);

        $Product = $this->productRepository->find($productId);
        // 商品がない場合および廃止の場合処理をしない
        if ($Product === null || $Product->getStatus()?->getId() === ProductStatus::DISPLAY_ABOLISHED) {
            return false;
        }

        $ProductStatus = $this->productStatusRepository->find($statusValue);
        $Product->setStatus($ProductStatus);
        $Product->setBranchPublished((bool) $isBranchPublishedValue);

        return true;
    }

    /**
     * 列の定義を取得する。
     *
     * @return array<CsvColumnInterface>
     */
    protected function getColumns(): array
    {
        return [
            $this->productIdColumn,
            $this->statusColumn,
            $this->isBranchPublishedColumn,
        ];
    }

