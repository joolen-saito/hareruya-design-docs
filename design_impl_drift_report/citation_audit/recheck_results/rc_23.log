    public function build(string $locale, CategorySidebarLinkContext $linkContext): array
    {
        $result = [
            'all' => ['items' => []],
            self::GROUP_LATEST_SET => ['items' => []],
            self::GROUP_STANDARD => ['items' => []],
            self::GROUP_PIONEER => ['items' => []],
            self::GROUP_MODERN => ['items' => []],
            self::GROUP_LEGACY => ['items' => []],
            self::GROUP_COMMANDER => ['items' => []],
            self::GROUP_OTHERS => ['items' => []],
        ];

        $firstLevelCategories = $this->categoryRepository->getList();
        $isBranch = $this->isBranchShopContext();

        // N+1 回避: 第一階層配下の全カテゴリIDを先にプリロード
        $categoryIds = array_values(array_filter(array_map(
            static fn (Category $c): ?int => $c->getId(),
            $firstLevelCategories
        )));
        $this->cardsetGenerator->beginPreloadForSubtree($categoryIds, $isBranch);

        foreach ($firstLevelCategories as $Category) {
            if ($Category->getFrontSearchHideFlg()) {
                continue;
            }
            if ($isBranch && $Category->getBranchHideFlg()) {
                continue;
            }

            $categoryId = $Category->getId();

            if ($categoryId === Category::NAV_LATEST_SET_ID) {
                foreach ($this->categoryRepository->getList($Category) as $Child) {
                    if ($Child->getFrontSearchHideFlg()) {
                        continue;
                    }
                    if ($isBranch && $Child->getBranchHideFlg()) {
                        continue;
                    }
                    $item = $this->buildCategoryItem($Child, $locale, $linkContext);
                    $result[self::GROUP_LATEST_SET]['items'][] = $item;
                    $result['all']['items'][] = $item;
                }
                // 最新セット自身に紐づくカードセット合成子要素（例: ギルドキット系）を直接アイテムとして追加
                foreach ($this->cardsetGenerator->generate($Category, $isBranch, $linkContext) as $cardsetNode) {
                    $item = $this->convertCardsetNode($cardsetNode, $locale);
                    $result[self::GROUP_LATEST_SET]['items'][] = $item;
                    $result['all']['items'][] = $item;
                }
            } elseif ($categoryId !== null && isset(self::FORMAT_CATEGORY_ID_TO_GROUP[$categoryId])) {
                $item = $this->buildCategoryItem($Category, $locale, $linkContext);
                $result[self::FORMAT_CATEGORY_ID_TO_GROUP[$categoryId]]['items'][] = $item;

        $item = [
            'id' => $Category->getId(),
            'text' => $locale === 'en'
                ? (string) ($Category->getCategoryNameEn() ?? '')
                : $Category->getName(),
            'href' => $this->productListSearchUrlBuilder->build(
                $linkContext->getListRouteName(),
                $categoryIdForPath,
                $routeParams,
            ),
        ];

        $item['image'] = $Category->getBannerImage();
        $item['icon'] = $Category->getIconImage();

        $item['children'] = [];
        $isBranch = $this->isBranchShopContext();
        foreach ($Category->getChildren() as $Child) {
            if ($Child->getFrontSearchHideFlg()) {
                continue;
            }
            if ($isBranch && $Child->getBranchHideFlg()) {
                continue;
            }
            $item['children'][] = $this->buildCategoryItem($Child, $locale, $linkContext);
        }

        // mtb_cardset 紐づきのカードセット合成子要素を追加
        foreach ($this->cardsetGenerator->generate($Category, $isBranch, $linkContext) as $cardsetNode) {
            $item['children'][] = $this->convertCardsetNode($cardsetNode, $locale);
        }

        if (empty($item['children'])) {
            unset($item['children']);
        }
