    /**
     * 検索パターン保存（display_key='在庫一覧' で保存）
     */
    #[Route(path: '/%eccube_admin_route%/product/stock/save-pattern', name: 'admin_stock_list_save_pattern', methods: ['POST'])]
    public function savePattern(Request $request): RedirectResponse
    {
        $searchForm = $this->formFactory->createBuilder(SearchStockListType::class)->getForm();
        $searchForm->handleRequest($request);

        if (!$searchForm->isSubmitted() || !$searchForm->isValid()) {
            $this->addError('admin.common.csrf_invalid', 'admin');

            return $this->redirectToRoute('admin_stock_list');
        }

        $viewData = FormUtil::getViewData($searchForm);

        if (empty($viewData['pattern_name'])) {
            $this->addError('admin.common.save_pattern.error.name_empty', 'admin');

            return $this->redirectToRoute('admin_stock_list');
        }

        $baseInfo = $this->getMember()->getBaseInfo();

        // 同じ名前のパターンがあれば上書き、なければ新規作成
        $searchPattern = $this->dtbSearchPatternRepository->findOneBy([
            'name' => $viewData['pattern_name'],
            'display_key' => self::PATTERN_DISPLAY_KEY,
            'BaseInfo' => $baseInfo,
        ]) ?? new DtbSearchPattern();

        $dataToStore = $viewData;
        unset($dataToStore['_token'], $dataToStore['base_info']); // トークン・店舗は保存しない

        $searchPattern
            ->setPattern(serialize($dataToStore))
            ->setName($viewData['pattern_name'])
            ->setDisplayKey(self::PATTERN_DISPLAY_KEY)
            ->setBaseInfo($baseInfo);

        $this->entityManager->persist($searchPattern);
        $this->entityManager->flush();

        $event = new EventArgs(
            [
                'searchPattern' => $searchPattern,
                'viewData' => $viewData,
            ],
            ->add('card_name', TextType::class, [
                'label' => 'admin.stock.list.card_name',
                'required' => false,
                'constraints' => [
                    new Assert\Length(['max' => 255]),
                ],
            ])
            // 1-3: ID（商品ID、部分一致）
            ->add('product_id', TextType::class, [
                'label' => 'admin.stock.list.product_id',
                'required' => false,
                'constraints' => [
                    new Assert\Length(['max' => 255]),
                ],
            ])
            // 1-4: コード（商品コード、部分一致）
            ->add('product_code', TextType::class, [
                'label' => 'admin.product.product_code',
                'required' => false,
                'constraints' => [
                    new Assert\Length(['max' => 255]),
                ],
            ])
            // 1-5: 店舗（セレクトボックス）
            ->add('base_info', EntityType::class, [
                'label' => 'admin.stock.list.base_info',
                'class' => BaseInfo::class,
                'choice_label' => 'shop_name',
                'required' => false,
                'multiple' => true,
                'expanded' => false,
                if ($sellPriceFrom !== null && $sellPriceTo !== null && $sellPriceFrom > $sellPriceTo) {
                    $form['sell_price_to']->addError(new FormError(trans('admin.common.price_range_error')));
                }

                $stockFrom = $form['stock_from']->getData();
                $stockTo = $form['stock_to']->getData();
                if ($stockFrom !== null && $stockTo !== null && $stockFrom > $stockTo) {
                    $form['stock_to']->addError(new FormError(trans('admin.common.price_range_error')));
                }

                $updateDateFrom = $form['update_date_from']->getData();
                $updateDateTo = $form['update_date_to']->getData();
                if ($updateDateFrom !== null && $updateDateTo !== null && $updateDateFrom > $updateDateTo) {
                    $form['update_date_to']->addError(new FormError(trans('admin.common.date_range_error')));
                }
            })
        ;
    }

