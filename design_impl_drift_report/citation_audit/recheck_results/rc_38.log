        if ($isRegisteredEmail || $isEqualEmailAndPassword) {
            return $this->render('OtcBuy/register_customer.twig', [
                'form' => $form->createView(),
                'shop' => $shop,
                'isRegisteredEmail' => $isRegisteredEmail,
                'isEqualEmailAndPassword' => $isEqualEmailAndPassword,
            ]);
        }

        if ($request->get('mode') === 'confirm') {
            $form = $this->createForm(OtcBuyOrderType::class, $otcBuyOrder, [
                'locale' => $request->getLocale(),
            ]);
            $form->handleRequest($request);

            $invoiceForm = $this->createOtcBuyQualifiedInvoiceForm($request, $form, $dtbQualifiedInvoiceIssuerAccount);

            return $this->render('OtcBuy/confirm.twig', [
                'form' => $form->createView(),
                'invoiceForm' => $invoiceForm->createView(),
                'shop' => $shop,
                'withEntry' => !is_null($email),
                'isQualifiedInvoiceIssuer' => $dtbQualifiedInvoiceIssuerAccount->getQualifiedInvoiceIssuerCode() !== '',
            ]);
        }

        // 会員情報登録処理
        $registerResult = self::NO_ENTRY;
        if ($request->get('mode') === 'entry') {
            $registerResult = $this->registerCustomer($form) ? self::ENTRY_SUCCESS : self::ENTRY_FAILED;
        }

        $this->session->remove(self::ENTRY_SESSION_KEY);
        // 追加設定値
        $applyDate = new \DateTime();
        $otcBuyOrder->setOtcBuyOrderStatus(
            $this->entityManager->getReference(MtbOtcBuyOrderStatus::class, MtbOtcBuyOrderStatus::STATUS_ASSESSMENT_PENDING)
        )
            ->setAdultFlg(MemberUtil::isAdult($otcBuyOrder->getBirth()))
            ->setApplyDate($applyDate)
            ->setUpdateDate($applyDate)
            ->setBaseInfo($shop);
        if (!$otcBuyOrder->getLastNameKana()) {
            $otcBuyOrder->setLastNameKana($otcBuyOrder->getLastName())
                ->setFirstNameKana($otcBuyOrder->getFirstName());
        }
        if ($otcBuyOrder->getCountry()->getId() !== Country::JAPAN) {
            $otcBuyOrder->setPref($this->entityManager->getRepository(Pref::class)->find(Pref::PREF_ABROAD));
        }
        if ($dtbQualifiedInvoiceIssuerAccount->getQualifiedInvoiceIssuerCode() !== '') {
            $otcBuyOrder
                ->setQualifiedInvoiceIssuerAccount($dtbQualifiedInvoiceIssuerAccount)
                ->setFreeComment(
                    ($otcBuyOrder->getFreeComment() ? $otcBuyOrder->getFreeComment()."\r\n" : '').
                        $this->eccubeConfig['eccube_qualified_invoice_issuer_comment']
                );
            $this->entityManager->persist($dtbQualifiedInvoiceIssuerAccount);
            $this->entityManager->flush();
        }
        if ($this->isGranted('ROLE_USER')) {
            // ログイン中ユーザーのcustomer_idを保存
            /** @var Customer $customer */
            $customer = $this->getUser();
            $otcBuyOrder->setCustomer($customer);
        }

        // v3ではdtb_otc_buy_orderテーブルをロックしていたが、'LOCK TABLES' はPostgreSQLには存在しない ('LOCK TABLE' は存在する)。
        // 処理内容からトランザクション内の処理で問題ないと思われるので変更
        $this->entityManager->beginTransaction();

        $assessmentNumber = $this->otcBuyOrderRepository->getAssessmentNumber($applyDate, $shop->getId());
        $otcBuyOrder->setAssessmentId(implode('-', [
            $applyDate->format('Ymd'),
            sprintf('%02d', $shop->getId()),
            $assessmentNumber,
        ]));
        $this->entityManager->persist($otcBuyOrder);
        $this->entityManager->flush();
        $this->entityManager->commit();

        // ステータス履歴の登録
        $this->otcBuyOrderStatusHistoryRepository->insertOtcBuyOrderStatusHistory($otcBuyOrder, MtbOtcBuyOrderStatus::STATUS_ASSESSMENT_PENDING);
        $this->entityManager->flush();

        $this->session->set(self::OTC_BUY_ORDER_ID_SESSION_KEY, $otcBuyOrder->getId());
        $urlComplete = $this->generateUrl('otc_buy_complete', ['name' => $name]);
        if ($registerResult !== self::NO_ENTRY) {
            $urlComplete = $urlComplete.'?register='.$registerResult;
        }

        return $this->redirect($urlComplete);
    }

    /**
     * 店頭買取査定申込完了
     *
     * @param Request $request
     * @param string $name `BaseInfo`の`html_class_name`フィールドに設定された文字列
     *
     * @return RedirectResponse|array<string, mixed>
     *
     * @throws NotFoundHttpException
     */
    #[Route(path: '/otcbuy/{name}/complete', name: 'otc_buy_complete', requirements: ['name' => '\w+'], methods: ['GET', 'POST'])]
    #[Template(template: 'OtcBuy/complete.twig')]
     *
     * @param FormInterface $form
     *
     * @return bool
     */
    private function registerCustomer(FormInterface $form): bool
    {
        $Customer = $this->customerRepository->newCustomer();

        // TODO: 会員登録処理のログ出力は v4 のロガーに合わせて実装する
        log_info('会員登録開始');

        $Customer
            // TODO: salt, secretKey設定?
            // ->setSalt($app['eccube.repository.customer']->createSalt(5))
            // ->setSecretKey($app['eccube.repository.customer']->getUniqueSecretKey($app))
            ->setSecretKey($this->customerRepository->getUniqueSecretKey())
            ->setEmail($form->get('email')->getData())
            ->setPlainPassword($form->get('password')->getData())
            ->setCountry($form->get('country')->getData())
            ->setName01($form->get('lastName')->getData())
            ->setName02($form->get('firstName')->getData())
            ->setKana01($form->get('lastNameKana')->getData())
            ->setKana02($form->get('firstNameKana')->getData())
            ->setPostalCode($form->get('zipcode')->getData())
            ->setPref($form->get('pref')->getData())
            ->setAddr01($form->get('addr01')->getData())
            ->setAddr02($form->get('addr02')->getData())
            ->setAddr03($form->get('addr03')->getData())
            ->setTel01($form->get('tel01')->getData())
            ->setTel02($form->get('tel02')->getData())
            ->setTel03($form->get('tel03')->getData())
            ->setBirth($form->get('birth')->getData())
            ->setJob($form->get('job')->getData())
        ;

        // Countryが日本以外の場合、Prefを日本国外に設定
        if ($Customer->getCountry()->getId() !== Country::JAPAN) {
            $Customer->setPref($this->entityManager->getRepository(Pref::class)->find(Pref::PREF_ABROAD));
        }

        // パスワードの暗号化
        $plainPassword = $Customer->getPlainPassword();
        $password = $this->passwordHasher->hashPassword($Customer, $plainPassword);
        $Customer->setPassword($password);

        // カナが設定されていない場合（英語ページの場合）氏名と同じに設定
        if (is_null($Customer->getKana01()) && is_null($Customer->getKana02())) {
            $Customer->setKana01($Customer->getName01())
                ->setKana02($Customer->getName02());
        }

        // ブラックリストに登録されている場合は会員登録を行わない
        $blacklists = $this->dtbBlacklistRepository->findBlacklistByCustomer($Customer);
        if (count($blacklists) > 0) {
            foreach ($blacklists as $blacklist) {
                log_info('ブラックリスト登録あり  '.$blacklist->getBlacklistTag()->getName().' : '.$blacklist->getKeyword());
            }
            log_info('ブラックリスト登録があるため会員登録不可');

            return false;
        }

        $CustomerAddress = new CustomerAddress();
        $CustomerAddress->setFromCustomer($Customer)
            ->setCountry($form->get('country')->getData())
            ->setAddressName($this->eccubeConfig['eccube_customer_address_default_name'])
            ->setDefaultFlg(true);
        if (!is_null($Customer->getPref()) && $Customer->getPref()->getId() === Pref::PREF_ABROAD) {
            $CustomerAddress->setAbroadPostalCode($form->get('zipcode')->getData());
        }
        $Customer->addCustomerAddress($CustomerAddress);

        // 登録したCustomer_idからdtbPlayer登録
        $dtbPlayer = new DtbPlayer();
