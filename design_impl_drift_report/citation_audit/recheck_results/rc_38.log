    /**
     * 配送先情報CSVアップロード画面
     *
     * @return array<string, mixed>
     */
    #[Route(path: '/%eccube_admin_route%/customer/address_csv', name: 'admin_customer_address_csv', methods: ['GET', 'POST'])]
    #[Template(template: '@admin/Customer/customer_address_csv.twig')]
    public function index(Request $request): array
    {
        $builder = $this->formFactory->createBuilder(CsvImportType::class);

        $event = new EventArgs(
            [
                'builder' => $builder,
            ],
            $request
        );
        $this->eventDispatcher->dispatch($event, EccubeEvents::ADMIN_CUSTOMER_ADDRESS_CSV_INDEX_INITIALIZE);

        $form = $builder->getForm();
        $errors = [];

        $form->handleRequest($request);
        if ($form->isSubmitted() && $form->isValid()) {
            $formFile = $form['import_file']->getData();

            if (!empty($formFile)) {
                $this->entityManager->getConfiguration()->setSQLLogger();

                $Member = $this->getMember();
                $importer = new CsvImporter(
                    $this->entityManager,
                    $this->translator,
                    $this->eccubeConfig,
                    $this->handler,
                    $Member,
                );

                try {
                    $result = $importer->import($formFile);
                } catch (\Exception $e) {
                    log_error('customer address csv import error', ['message' => $e->getMessage()]);

                    return [
                        'form' => $form->createView(),
                        'headers' => CustomerAddressCsvImportHandler::getColumnDefs(),
                        'errors' => [$this->translator->trans('admin.common.csv_upload_error')],
                    ];
                }

                if ($result->hasError()) {
                    $errors = array_map(static fn (array $e): string => $e['message'], $result->getErrors());
                } else {
                    $this->addInfo('admin.common.csv_upload_complete', 'admin');
                }
            }
        }

        return [
            'form' => $form->createView(),
            'headers' => CustomerAddressCsvImportHandler::getColumnDefs(),
            'errors' => $errors,
        ];
    }
