/bin/bash -lc "python3 - <<'PY'
from html.parser import HTMLParser
from pathlib import Path
terms=['404','会員・選手','選手情報','ページが見つから','customer/point','update/{type}','admin_customer_point_update','customer/{id}/mail_history','mail_history','customer/manual_mail','customerId','templateId']
class P(HTMLParser):
 def __init__(self): super().__init__(); self.cap=None; self.h=[]
 def handle_starttag(self,t,attrs):
  a=dict(attrs)
  if 'src-cell' in a.get('class','').split() and a.get('data-excel-ref'): self.cap=[a['data-excel-ref'],[]]
 def handle_data(self,d):
  if self.cap:self.cap[1].append(d)
 def handle_endtag(self,t):
  if self.cap and t=='span':
   x=' '.join(''.join(self.cap[1]).split())
   for q in terms:
    if q.lower() in x.lower(): self.h.append((q,self.cap[0],x))
   self.cap=None
p=P(); p.feed(Path('hareruya-design-docs/excel_to_html/output/0207_基本設計仕様書(会員管理機能).html').read_text())
for q in terms:
 hs=[x for x in p.h if x[0]==q]
 print(q,len(hs))
 for x in hs: print(' ',x[1],repr(x[2]))
