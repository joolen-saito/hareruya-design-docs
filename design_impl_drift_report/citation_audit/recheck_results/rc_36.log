class P(HTMLParser):
 def __init__(self,path): super().__init__(); self.path=path; self.cap=None; self.hits=[]
 def handle_starttag(self,tag,attrs):
  a=dict(attrs)
  if 'src-cell' in a.get('class','').split() and a.get('data-excel-ref'): self.cap=[a['data-excel-ref'],[]]
 def handle_data(self,d):
  if self.cap:self.cap[1].append(d)
 def handle_endtag(self,tag):
  if self.cap and tag=='span':
   txt=' '.join(''.join(self.cap[1]).split())
   for term in terms:
    if term.lower() in txt.lower(): self.hits.append((term,self.cap[0],txt))
   self.cap=None
files=list(Path('hareruya-design-docs/excel_to_html/output').glob('*.html'))
allhits=[]
for f in files:
 p=P(f); p.feed(f.read_text(errors='replace'))
 allhits += [(f.name,*x) for x in p.hits]
for term in terms:
 hs=[h for h in allhits if h[1]==term]
 print('\\nTERM',term,'COUNT',len(hs))
 for h in hs[:30]: print(h[0],h[2],repr(h[3]))
 if len(hs)>30: print('...')
