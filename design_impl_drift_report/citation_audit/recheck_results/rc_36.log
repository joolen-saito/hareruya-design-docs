from html.parser import HTMLParser
from pathlib import Path
import base64
class P(HTMLParser):
    def __init__(self): super().__init__(); self.section=None; self.stack=[]; self.n={}
    def handle_starttag(self,tag,attrs):
        a=dict(attrs); self.stack.append((tag,a))
        if tag=='section' and a.get('id') in {'sheet-11','sheet-12'} and a.get('class')=='sheet-panel': self.section=a['id']
        if self.section and tag=='img' and a.get('src','').startswith('data:image/png;base64,'):
            self.n[self.section]=self.n.get(self.section,0)+1
            out=Path('/tmp')/f'rc36_{self.section}_{self.n[self.section]}.png'
            out.write_bytes(base64.b64decode(a['src'].split(',',1)[1])); print(out)
    def handle_endtag(self,tag):
        if self.stack:
            opened,a=self.stack.pop()
            if opened=='section' and a.get('id')==self.section and a.get('class')=='sheet-panel': self.section=None
p=P(); p.feed(Path('hareruya-design-docs/excel_to_html/output/0207_基本設計仕様書(会員管理機能).html').read_text())
