from lxml import html
from pathlib import Path
p=Path('hareruya-design-docs/excel_to_html/output/0207_基本設計仕様書(会員管理機能).html')
t=html.parse(str(p))
for sid in ['sheet-10','sheet-11','sheet-12','sheet-13','sheet-14','sheet-15']:
