  2378	    CASE WHEN cd.promotion_flg THEN 1 ELSE 2 END ASC,
  2379	    cs.release_date DESC NULLS LAST,
  2380	    cd.foil_flg ASC,
  2381	    CASE WHEN pstock.stock > 0 THEN 1 ELSE 2 END ASC,
  2382	    CASE WHEN lang.code = :languageCode THEN 1 ELSE 2 END ASC,
  2383	    pc.card_condition_id ASC NULLS LAST,
  2384	    pci.rank ASC NULLS LAST,
  2385	    CASE WHEN pimg.file_name IS NOT NULL THEN 1 ELSE 2 END ASC
  2386	LIMIT 1
  2387	SQL;
  2388	
  2389	        $rsm = new ResultSetMapping();
  2390	        $rsm->addScalarResult('productid', 'productId', 'integer');
  2391	        $rsm->addScalarResult('productname', 'productName', 'string');
  2392	        $rsm->addScalarResult('nameen', 'nameEn', 'string');
  2393	        $rsm->addScalarResult('productclassid', 'productClassId', 'integer');
  2394	        $rsm->addScalarResult('price01', 'price01', 'integer');
  2395	        $rsm->addScalarResult('price02', 'price02', 'integer');
  2396	        $rsm->addScalarResult('stock', 'stock', 'integer');
  2397	        $rsm->addScalarResult('languagecode', 'languageCode', 'string');
  2398	        $rsm->addScalarResult('conditioncode', 'conditionCode', 'string');
