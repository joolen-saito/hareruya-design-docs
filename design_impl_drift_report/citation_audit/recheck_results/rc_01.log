  2403	        $query = $this->getEntityManager()->createNativeQuery($sql, $rsm);
  2404	        $query->setParameter('cardId', $cardId);
  2405	        $query->setParameter('languageCode', $languageCode);
  2406	        $query->setParameter('statusId', ProductStatus::DISPLAY_SHOW);
  2407	        $query->setParameter('stockBaseInfoId', $stockBaseInfoId);
  2408	        $query->setParameter('eccubeStockLocationId', ProductStock::STOCK_LOCATION_ECCUBE);
  2409	        $query->setParameter('mainBaseInfoId', BaseInfo::TC_TOKYO_ID);
  2410	        $query->setParameter('ecSalesLocation', DtbSalesQuantity::SALES_LOCATION_ECCUBE);
  2414	
  2415	    /**
  2416	     * 旧商品IDからポップアップ用の商品情報を1件取得する
  2417	     *
  2418	     * @param string $oldProductId
  2419	     * @param string $languageCode
  2420	     * @param int|null $stockBaseInfoId 在庫参照店舗（未指定時は本店）
  2421	     *
  2422	     * @return array<string, mixed>|null
  2423	     */
  2424	    public function findPopupProductByOldProductId(string $oldProductId, string $languageCode, ?int $stockBaseInfoId = null): ?array
  2425	    {
  2426	        $stockBaseInfoId ??= (int) $this->eccubeConfig->get('eccube_root_base_info_id');
  2427	
  2428	        // 現行 pf-api の LANG_RANK に合わせた画像ランク優先度（ja→2, en→1）
  2429	        $langRank = $languageCode === 'EN' ? 1 : 2;
  2430	
  2431	        $sql = <<<SQL
  2432	SELECT
  2433	    p.id AS productId,
  2434	    p.name AS productName,
  2435	    p.name_en AS nameEn,
  2436	    pc.id AS productClassId,
  2437	    pc.price01 AS price01,
  2438	    pc.price02 AS price02,
  2439	    pstock.stock AS stock,
  2440	    COALESCE(lang.code, :languageCode) AS languageCode,
  2441	    CASE WHEN pc.memo IS NOT NULL AND pc.memo != '' THEN pc.memo ELSE cc.code END AS conditionCode,
  2442	    pc.belt_url AS beltUrl,
  2443	    pimg.file_name AS imageFileName,
  2444	    (SELECT COALESCE(SUM(sq.sales_quantity_04), 0)
  2445	     FROM dtb_product_class pc2
  2446	     LEFT JOIN mtb_language lang2 ON pc2.language_id = lang2.id
  2447	     LEFT JOIN dtb_sales_quantity sq ON sq.product_class_id = pc2.id
  2448	         AND sq.base_info_id = :mainBaseInfoId
  2449	         AND sq.sales_location = :ecSalesLocation
  2450	     WHERE pc2.product_id = p.id
  2451	       AND pc2.visible = true
  2452	       AND lang2.code = :languageCode) AS weeklySold
  2453	FROM dtb_product p
  2454	    INNER JOIN dtb_product_class pc ON p.id = pc.product_id AND pc.visible = true
  2455	    LEFT JOIN dtb_product_stock pstock ON pstock.product_class_id = pc.id
  2456	        AND pstock.base_info_id = :stockBaseInfoId
  2457	        AND pstock.stock_location_id = :eccubeStockLocationId
  2458	    LEFT JOIN mtb_language lang ON pc.language_id = lang.id
  2459	    LEFT JOIN mtb_card_condition cc ON pc.card_condition_id = cc.id
  2460	    LEFT JOIN dtb_product_class_image pci ON pci.product_class_id = pc.id
  2461	    LEFT JOIN dtb_product_image pimg ON pci.product_image_id = pimg.id
  2462	    INNER JOIN mtb_card_detail cd ON p.card_detail_id = cd.id
  2463	    INNER JOIN mtb_card c ON cd.card_id = c.id
  2464	    LEFT JOIN mtb_cardset cs ON cd.cardset_id = cs.id
  2465	WHERE (c.old_product_id = :oldProductId OR c.old_en_product_id = :oldProductId)
  2466	  AND p.product_status_id = :statusId
  2467	ORDER BY
  2468	    CASE WHEN cs.special_flg THEN 1 ELSE 2 END ASC,
  2469	    CASE WHEN cd.promotion_flg THEN 1 ELSE 2 END ASC,
  2470	    COALESCE(cs.release_date, '1900-01-01'::timestamptz) DESC,
  2471	    cd.foil_flg ASC,
  2472	    CASE WHEN pstock.stock > 0 THEN 1 ELSE 2 END ASC,
  2473	    CASE WHEN lang.code = :languageCode THEN 1 ELSE 2 END ASC,
  2474	    pc.card_condition_id ASC NULLS LAST,
  2475	    CASE WHEN pci.rank = :langRank THEN 1 ELSE 2 END ASC,
  2476	    pci.rank ASC NULLS LAST,
  2477	    pc.id ASC
  2478	LIMIT 1
  2479	SQL;
  2480	
  2481	        $rsm = new ResultSetMapping();
  2482	        $rsm->addScalarResult('productid', 'productId', 'integer');
  2483	        $rsm->addScalarResult('productname', 'productName', 'string');
  2484	        $rsm->addScalarResult('nameen', 'nameEn', 'string');
  2485	        $rsm->addScalarResult('productclassid', 'productClassId', 'integer');
  2486	        $rsm->addScalarResult('price01', 'price01', 'integer');
  2487	        $rsm->addScalarResult('price02', 'price02', 'integer');
  2488	        $rsm->addScalarResult('stock', 'stock', 'integer');
  2489	        $rsm->addScalarResult('languagecode', 'languageCode', 'string');
  2490	        $rsm->addScalarResult('conditioncode', 'conditionCode', 'string');
  2491	        $rsm->addScalarResult('belturl', 'beltUrl', 'string');
  2492	        $rsm->addScalarResult('imagefilename', 'imageFileName', 'string');
  2493	        $rsm->addScalarResult('weeklysold', 'weeklySold', 'integer');
  2494	
  2495	        $query = $this->getEntityManager()->createNativeQuery($sql, $rsm);
  2496	        $query->setParameter('oldProductId', $oldProductId);
  2497	        $query->setParameter('languageCode', $languageCode);
  2498	        $query->setParameter('langRank', $langRank);
  2499	        $query->setParameter('statusId', ProductStatus::DISPLAY_SHOW);
  2500	        $query->setParameter('stockBaseInfoId', $stockBaseInfoId);
  2501	        $query->setParameter('eccubeStockLocationId', ProductStock::STOCK_LOCATION_ECCUBE);
  2502	        $query->setParameter('mainBaseInfoId', BaseInfo::TC_TOKYO_ID);
  2503	        $query->setParameter('ecSalesLocation', DtbSalesQuantity::SALES_LOCATION_ECCUBE);
  2504	
  2505	        return $query->getOneOrNullResult();
  2508	    /**
  2509	     * 旧商品IDからポップアップ表示する商品を一件取得
  2510	     *
  2511	     * @param string $oldProductId
  2512	     * @param int|null $stockBaseInfoId 在庫参照店舗（未指定時は本店）
  2513	     *
  2514	     * @return array<string, mixed>|null
  2515	     */
  2516	    public function findPopupProductByOldProductIdWithoutLang(string $oldProductId, ?int $stockBaseInfoId = null): ?array
  2517	    {
  2518	        $stockBaseInfoId ??= (int) $this->eccubeConfig->get('eccube_root_base_info_id');
  2519	
  2520	        $sql = <<<SQL
  2521	SELECT
  2522	    p.id AS productId,
  2523	    p.name AS productName,
  2524	    p.name_en AS nameEn,
  2525	    pc.id AS productClassId,
  2526	    pc.price01 AS price01,
  2527	    pc.price02 AS price02,
  2528	    pstock.stock AS stock,
  2529	    COALESCE(lang.code, CASE WHEN c.old_product_id = :oldProductId THEN 'JP' ELSE 'EN' END) AS languageCode,
  2530	    CASE WHEN pc.memo IS NOT NULL AND pc.memo != '' THEN pc.memo ELSE cc.code END AS conditionCode,
  2531	    pc.belt_url AS beltUrl,
  2532	    pimg.file_name AS imageFileName,
  2533	    (SELECT COALESCE(SUM(sq.sales_quantity_04), 0)
  2534	     FROM dtb_product_class pc2
  2535	     LEFT JOIN mtb_language lang2 ON pc2.language_id = lang2.id
  2536	     LEFT JOIN dtb_sales_quantity sq ON sq.product_class_id = pc2.id
  2537	         AND sq.base_info_id = :mainBaseInfoId
  2538	         AND sq.sales_location = :ecSalesLocation
  2539	     WHERE pc2.product_id = p.id
  2540	       AND pc2.visible = true
  2541	       AND lang2.code = CASE WHEN c.old_product_id = :oldProductId THEN 'JP' ELSE 'EN' END) AS weeklySold
  2542	FROM dtb_product p
  2543	    INNER JOIN dtb_product_class pc ON p.id = pc.product_id AND pc.visible = true
  2544	    LEFT JOIN dtb_product_stock pstock ON pstock.product_class_id = pc.id
  2545	        AND pstock.base_info_id = :stockBaseInfoId
  2546	        AND pstock.stock_location_id = :eccubeStockLocationId
  2547	    LEFT JOIN mtb_language lang ON pc.language_id = lang.id
  2548	    LEFT JOIN mtb_card_condition cc ON pc.card_condition_id = cc.id
  2549	    LEFT JOIN dtb_product_class_image pci ON pci.product_class_id = pc.id
  2550	    LEFT JOIN dtb_product_image pimg ON pci.product_image_id = pimg.id
  2551	    INNER JOIN mtb_card_detail cd ON p.card_detail_id = cd.id
  2552	    INNER JOIN mtb_card c ON cd.card_id = c.id
  2553	    LEFT JOIN mtb_cardset cs ON cd.cardset_id = cs.id
  2554	WHERE (c.old_product_id = :oldProductId OR c.old_en_product_id = :oldProductId)
  2555	  AND p.product_status_id = :statusId
  2556	ORDER BY
  2557	    CASE WHEN cs.special_flg THEN 1 ELSE 2 END ASC,
  2558	    CASE WHEN cd.promotion_flg THEN 1 ELSE 2 END ASC,
  2559	    COALESCE(cs.release_date, '1900-01-01'::timestamptz) DESC,
  2560	    cd.foil_flg ASC,
  2561	    CASE WHEN lang.code = CASE WHEN c.old_product_id = :oldProductId THEN 'JP' ELSE 'EN' END THEN 1 ELSE 2 END ASC,
  2562	    CASE WHEN pci.rank = CASE WHEN c.old_product_id = :oldProductId THEN 2 ELSE 1 END THEN 1 ELSE 2 END ASC
  2563	LIMIT 1
  2564	SQL;
  2565	
  2566	        $rsm = new ResultSetMapping();
  2567	        $rsm->addScalarResult('productid', 'productId', 'integer');
  2568	        $rsm->addScalarResult('productname', 'productName', 'string');
  2569	        $rsm->addScalarResult('nameen', 'nameEn', 'string');
  2570	        $rsm->addScalarResult('productclassid', 'productClassId', 'integer');
  2571	        $rsm->addScalarResult('price01', 'price01', 'integer');
  2572	        $rsm->addScalarResult('price02', 'price02', 'integer');
  2573	        $rsm->addScalarResult('stock', 'stock', 'integer');
  2574	        $rsm->addScalarResult('languagecode', 'languageCode', 'string');
  2575	        $rsm->addScalarResult('conditioncode', 'conditionCode', 'string');
  2576	        $rsm->addScalarResult('belturl', 'beltUrl', 'string');
  2577	        $rsm->addScalarResult('imagefilename', 'imageFileName', 'string');
  2578	        $rsm->addScalarResult('weeklysold', 'weeklySold', 'integer');
  2579	
  2580	        $query = $this->getEntityManager()->createNativeQuery($sql, $rsm);
  2581	        $query->setParameter('oldProductId', $oldProductId);
  2582	        $query->setParameter('statusId', ProductStatus::DISPLAY_SHOW);
  2583	        $query->setParameter('stockBaseInfoId', $stockBaseInfoId);
  2584	        $query->setParameter('eccubeStockLocationId', ProductStock::STOCK_LOCATION_ECCUBE);
  2585	        $query->setParameter('mainBaseInfoId', BaseInfo::TC_TOKYO_ID);
  2586	        $query->setParameter('ecSalesLocation', DtbSalesQuantity::SALES_LOCATION_ECCUBE);
  2587	
  2588	        return $query->getOneOrNullResult();
  2589	    }
  2590	}

