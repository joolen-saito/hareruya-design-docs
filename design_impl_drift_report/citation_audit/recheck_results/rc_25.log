   601	                'admin',
   602	            );
   603	
   604	            return [
   605	                'stockMoveTransferIds' => [],
   606	                'redirectUrl' => $redirectUrl,
   607	                'hasError' => true,
   608	            ];
   609	        }
   610	
   611	        /** @var Member $Member */
   612	        $Member = $this->getUser();
   613	        $errors = $this->stockMoveTransferReturnListCsvExportService->validateReturnListExportIds(
   614	            $stockMoveTransferIds,
   615	            $Member,
   616	        );
   617	
   618	        if ($errors !== []) {
   619	            foreach ($errors as $error) {
   620	                $this->addError($error, 'admin');
   621	            }
   622	
   623	            return [
   624	                'stockMoveTransferIds' => [],
   625	                'redirectUrl' => $redirectUrl,
   680	                'hasError' => true,
   681	            ];
   682	        }
   683	
   684	        return [
   685	            'stockMoveTransferIds' => $stockMoveTransferIds,
   686	            'redirectUrl' => $redirectUrl,
   687	            'hasError' => false,
   688	        ];
   689	    }
