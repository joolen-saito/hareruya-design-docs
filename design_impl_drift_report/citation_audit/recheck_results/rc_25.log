   691	    /**
   692	     * 移動指示作成
   693	     * チェックした移動を対象に在庫移動指示を作成し、在庫移動指示一覧へ遷移する
   694	     */
   695	    #[Route(path: '/%eccube_admin_route%/product/stock/move_transfer/create_instruction', name: 'admin_stock_move_transfer_create_instruction', methods: ['POST'])]
   696	    public function createMoveInstruction(Request $request): RedirectResponse
   697	    {
   698	        $token = $request->request->get(Constant::TOKEN_NAME);
   699	        if (!$this->isCsrfTokenValid(Constant::TOKEN_NAME, $token)) {
   700	            $this->addError('admin.common.csrf_invalid', 'admin');
   701	
   702	            return $this->redirectToRoute('admin_stock_move_transfer', array_merge($request->query->all(), ['resume' => '1']));
   703	        }
   704	
   705	        $rawIds = $request->request->all('ids');
   706	        foreach ($rawIds as $rawId) {
   707	            if (!is_string($rawId) || !ctype_digit($rawId) || (int) $rawId <= 0) {
   708	                $this->addError('admin.stock.move_transfer.create_instruction.no_selection', 'admin');
   709	
   710	                return $this->redirectToRoute('admin_stock_move_transfer', array_merge($request->query->all(), ['resume' => '1']));
   711	            }
   712	        }
   713	
   714	        $stockMoveTransferIds = array_unique(array_map('intval', $rawIds));
   715	        if ($stockMoveTransferIds === []) {
   716	            $this->addError('admin.stock.move_transfer.create_instruction.no_selection', 'admin');
   717	
   718	            return $this->redirectToRoute('admin_stock_move_transfer', array_merge($request->query->all(), ['resume' => '1']));
   719	        }
   720	
   721	        $StockMoveTransfers = $this->stockMoveTransferRepository->findBy(['id' => $stockMoveTransferIds]);
   722	        if (count($StockMoveTransfers) !== count($stockMoveTransferIds)) {
   723	            $this->addError('admin.stock.move_transfer.create_instruction.no_selection', 'admin');
   724	
   725	            return $this->redirectToRoute('admin_stock_move_transfer', array_merge($request->query->all(), ['resume' => '1']));
   726	        }
   727	
   728	        $input = new StockMoveInstructionCreateInput(
   729	            StockMoveTransfers: $StockMoveTransfers,
   730	            Member: $this->getMember(),
   731	        );
   732	
   733	        try {
   734	            $Instruction = $this->stockMoveInstructionCreateAction->handle($input);
   735	        } catch (StockMoveInstructionCreateException $e) {
   736	            $this->addError($e->getMessage(), 'admin');
   737	
   738	            return $this->redirectToRoute('admin_stock_move_transfer', array_merge($request->query->all(), ['resume' => '1']));
   739	        }
   740	
   741	        $event = new EventArgs(
   742	            [
   743	                'Instruction' => $Instruction,
   744	            ],
   745	            $request
   746	        );
   747	        $this->eventDispatcher->dispatch($event, EccubeEvents::ADMIN_STOCK_MOVE_TRANSFER_CREATE_MOVE_INSTRUCTION_COMPLETE);
   748	
   749	        $this->addSuccess('admin.stock.move_transfer.create_instruction.success', 'admin');
   750	
   751	        return $this->redirectToRoute('admin_stock_move_instruction_detail', ['id' => $Instruction->getId()]);
   752	    }
