   319	    /**
   320	     * 選択されている在庫移動・振替の入庫先店舗とステータスを取得
   321	     *
   322	     * @param array<int, int> $stockMoveTransferIds
   323	     *
   324	     * @return list<array{transferId: int, shopId: int|null, statusId: int}>
   325	     */
   326	    public function getMoveToBaseInfoAndStatusByIds(array $stockMoveTransferIds): array
   327	    {
   328	        if ($stockMoveTransferIds === []) {
   329	            return [];
   330	        }
   331	
   332	        $qb = $this->createQueryBuilder('smt');
   333	        $qb->leftJoin('smt.MoveToBaseInfo', 'bi')
   334	            ->join('smt.MoveTransferStatus', 'status')
   335	            ->select(
   336	                'smt.id AS transferId',
   337	                'bi.id AS shopId',
   338	                'status.id AS statusId',
   339	            )
   340	            ->where($qb->expr()->in('smt.id', ':ids'))
   341	            ->setParameter('ids', $stockMoveTransferIds);
   342	
   343	        return $qb->getQuery()->getResult();
   344	    }
   345	
   346	    /**
   347	     * 選択された在庫移動・振替 ID 一覧をもとに、バーコード印刷用CSV出力のバリデーション用データを取得する。
   348	     *
   349	     * @param array<int, int> $stockMoveTransferIds
   350	     *
   108	    /**
   109	     * 戻しリストCSV用バリデーション
   110	     *
   111	     * @param array<int, int> $stockMoveTransferIds
   112	     *
   113	     * @return list<string>
   114	     */
   115	    public function validateReturnListExportIds(array $stockMoveTransferIds, Member $Member): array
   116	    {
   117	        $uniqueStockMoveTransferIds = array_values(array_unique($stockMoveTransferIds));
   118	        $stockMoveTransfers = $this->stockMoveTransferRepository->getMoveToBaseInfoAndStatusByIds($uniqueStockMoveTransferIds);
   119	
   120	        if ($stockMoveTransfers === []) {
   121	            return ['対象のデータが見つかりません。'];
   122	        }
   123	
   124	        $errors = [];
   125	
   126	        $editableShopIds = $Member
   127	            ->getMemberBaseInfos()
   128	            ->map(fn ($mbi) => $mbi->getBaseInfo()->getId())
   129	            ->toArray();
   130	
   131	        $shopIds = [];
   132	        $moveTransferIds = [];
   133	
   134	        foreach ($stockMoveTransfers as $stockMoveTransfer) {
   135	            $moveTransferIds[] = $stockMoveTransfer['transferId'];
   136	            $shopId = $stockMoveTransfer['shopId'];
   137	
   138	            if ($shopId !== null) {
   139	                $shopIds[] = $shopId;
   140	            }
   141	
   142	            if ($shopId === null) {
   143	                $errors[] = sprintf(
   144	                    'ID: %d は入庫先店舗が設定されていません。',
   145	                    $stockMoveTransfer['transferId'],
   146	                );
   147	            } elseif (!in_array($shopId, $editableShopIds, true)) {
   148	                $errors[] = sprintf(
   149	                    'ID: %d は権限のない店舗のデータです。',
   150	                    $stockMoveTransfer['transferId'],
   151	                );
