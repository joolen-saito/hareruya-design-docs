class DtbStockEditApprovalRepository extends AbstractRepository
{
    public function __construct(
        ManagerRegistry $registry,
    ) {
        parent::__construct($registry, DtbStockEditApproval::class);
    }

    /**
     * 在庫変更情報を登録する。
     * EntityManager にキャッシュされないため、バッチ処理などに適する。
     *
     * @param array{
     *     stockChangeTypeDetail: int,
     *     approvalNotificationTargetMembers: int,
     *     changeBaseInfo: int|null,
     * } $stockChange 登録する情報
     *
     * @return ?int 在庫編集ID
     */
    public function insertStockChange(array $stockChange): ?int
    {
        $sql = <<<EOT
INSERT INTO
    dtb_stock_edit_approval
(
    stock_change_type_detail_id,
    registered_member_id,
    base_info_id,
    approval_status,
    registered_at
)
VALUES
(
    ?,
    ?,
    ?,
    ?,
    ?
)
EOT;

        $changeBaseInfoId = $stockChange['changeBaseInfo'] ?? $this->eccubeConfig->get('eccube_root_base_info_id');

        $connection = $this->getEntityManager()->getConnection();
        $connection->executeStatement(
            $sql,
            [
                $stockChange['stockChangeTypeDetail'],
                $stockChange['approvalNotificationTargetMembers'],
                $changeBaseInfoId,
                DtbStockEditApproval::APPROVAL_STATUS_UNAPPROVED,
                new \DateTime('now', new \DateTimeZone('UTC')),
            ],
            [
                ParameterType::INTEGER,
                ParameterType::INTEGER,
                ParameterType::INTEGER,
                ParameterType::INTEGER,
                Types::DATETIMETZ_MUTABLE,
            ],
        );
        $stockEditApprovalId = (int) $connection->lastInsertId() ?: null;

        return $stockEditApprovalId;
    }
}
