   130	    /**
   131	     * @param ReadCsvRowEvent $event
   132	     * @return bool 読み込みに成功した場合 true
   133	     */
   134	    public function onReadRow(ReadCsvRowEvent $event)
   135	    {
   136	        $row = $event->getRow();
   137	        $diffStock = $this->diffStockColumn->getValue($row);
   138	
   139	        // 在庫増減数が 0 の場合は更新不要。スキップする。
   140	        if ($diffStock === 0) {
   141	            return true;
   142	        }
   143	
   144	        // ProductStock に更新ロックをかけたうえで、商品規格情報を取得する。
   145	        $productData = $this->tryLockFindProductClass($event);
   146	        if (is_null($productData)) {
   147	            $event->breakAll();
   148	
   149	            return false;
   150	        }
   151	
   152	        $productClass = $productData['productClass'];
   153	        // 商品コードが見つからない場合、エラー（admin.csv.error.product.not_exists）
   154	        if (empty($productClass)) {
   155	            $event->getMessageStore()
   156	                ->addMasterNotExistsError(
   157	                    $row->getRowNumber(),
   158	                    $this->productCodeColumn->getLabel(),
   159	                    $this->productCodeColumn->getValue($row)
   160	                );
   161	            $event->breakAll();
   162	
   163	            return false;
   164	        }
   165	
   166	        $productStock = $productData['productStock'];
   167	        if (is_null($productStock)) {
   168	            $event->breakAll();
   169	
   170	            return false;
   171	        }
   172	
   173	        $stockBefore = $productStock['stock'];
   174	
   175	        // 更新後の在庫個数が0未満になる場合はエラーと扱う
   176	        $stockAfter = $stockBefore + $diffStock;
   177	        if ($stockAfter < 0) {
   178	            $event->getMessageStore()
   179	                ->addOutOfStockError(
   180	                    $row->getRowNumber(),
   181	                    $this->productCodeColumn->getLabel(),
   182	                    $this->productCodeColumn->getValue($row)
   183	                );
   184	            $event->breakAll();
   185	
   186	            return false;
   187	        }
   188	
   189	        // 更新後の在庫が上限を超える場合、エラーとなる
   190	        if (!$this->validateStockAfter($event, $stockAfter)) {
   191	            $event->breakAll();
   192	
   193	            return false;
   194	        }
   195	
   196	        // 在庫数を更新する
   197	        $productClassId = $productClass['productClassId'];
   198	        $this->app['hareruya_ec.repository.product_sub_class']->stockUpProduct($productClassId, $diffStock);
   199	        $this->updateProductStock($productClassId, $stockAfter);
   200	        $this->updateProductClass($productClassId, $stockAfter);
   201	
   202	        // 在庫履歴を追加する
   203	        $history = new DtbStockHistory();
   204	        $history->setStockChangeTypeId(MtbStockChangeType::MASTER_UPDATE);
   205	        $history->setProductClassId($productClassId);
   206	        $history->setStock($stockAfter);
   207	        $history->setOldStock($stockBefore);
   208	        $history->setSellPrice($productClass['price02']);
   209	        $history->setMemo($this->memo);
   210	        $history->setMemberId($event->getUpdateUser()->getId());
   211	        $this->addStockHistory($history);
   212	
   213	        if ($stockBefore === '0' && $stockAfter > 0) {
   214	            // 「在庫なし」から「在庫あり」に変化したので入荷通知の対象にする
   215	            $this->arrivalProductClasses[] = $productClassId;
   216	        }
   217	
   218	        // 支店に本店在庫の更新を通知
   219	        $this->productStocks[$productClassId] = isset($this->productStocks[$productClassId])
   220	            ? $this->productStocks[$productClassId] + $stockAfter : $stockAfter;
   221	
   222	        return true;
   223	    }
