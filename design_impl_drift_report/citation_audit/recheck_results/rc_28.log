use Eccube\Entity\Master\MtbStockHistorySourceType;
use Eccube\Util\SqlUtil;

/**
 * @extends AbstractRepository<DtbStockEditApprovalDetail>
 */
class DtbStockEditApprovalDetailRepository extends AbstractRepository
{
    public function __construct(
        ManagerRegistry $registry,
    ) {
        parent::__construct($registry, DtbStockEditApprovalDetail::class);
    }

    /**
     * 在庫変更情報詳細を登録する。
     * EntityManager にキャッシュされないため、バッチ処理などに適する。
     *
     * @param array{
     *     productStockId: int,
     *     editQuantity: int,
     *     purchaseUnitPrice: int,
     *     changeBaseInfoId: int,
     *     changeStockLocationId: int,
     *     stockChangeTypeDetailId: int,
     *     stockChangeReason: string,
     *     approvalDepartment: int,
     *     approvalNotificationTargetMembers: int,
     *     stockEditApprovalId: int,
     *     memberId: int,
     *     beforeEditQuantity?: int|null,
     *     beforePurchaseUnitPrice?: string|null,
     * } $stockChange 登録する情報
     *
     * @return ?int 在庫編集ID
     */
    public function insertStockChangeDetail(array $stockChange): ?int
    {
        $sql = <<<EOT
INSERT INTO
    dtb_stock_edit_approval_detail
(
    product_stock_id,
    stock_edit_approval_id,
    edit_quantity,
    stock_change_reason,
    purchase_unit_price,
    before_edit_quantity,
    before_purchase_unit_price,
    outbound_total_cost,
    create_date,
    update_date,
    member_id
)
VALUES
(
    ?,
    ?,
    ?,
    ?,
    ?,
    ?,
    ?,
    ?,
    ?,
    ?,
    ?
)
EOT;

        $outboundTotalCost = $stockChange['purchaseUnitPrice'] * $stockChange['editQuantity'];
        $now = new \DateTime('now', new \DateTimeZone('UTC'));

        $connection = $this->getEntityManager()->getConnection();
        $connection->executeStatement(
            $sql,
            [
                $stockChange['productStockId'],
                $stockChange['stockEditApprovalId'],
                $stockChange['editQuantity'],
                $stockChange['stockChangeReason'],
                $stockChange['purchaseUnitPrice'],
                $stockChange['beforeEditQuantity'] ?? null,
                $stockChange['beforePurchaseUnitPrice'] ?? null,
                $outboundTotalCost,
                SqlUtil::timestamp($now),
                SqlUtil::timestamp($now),
                $stockChange['memberId'],
            ]
        );

        return (int) $connection->lastInsertId() ?: null;
    }

    /**
     * 承認待ちの入庫（在庫履歴未作成）の在庫編集詳細を取得する.
     *
     * 入庫は承認完了まで dtb_stock_history に反映されないため、次をすべて満たす行のみ対象とする.
     * - 変動区分が入庫（BE_STOCKED）
     * - 承認待ち一覧（dtb_stock_approval_list）上で未承認状態である
     * - 同一承認・同一在庫に紐づく在庫履歴がまだ存在しない
     *
     * @return list<DtbStockEditApprovalDetail>
     */
    public function findPendingInboundByProductStockId(int $productStockId): array
    {
        $stockEditSourceTypeIds = [
            MtbStockHistorySourceType::STOCK_EDIT,
            MtbStockHistorySourceType::STOCK_BULK_EDIT,
        ];

        /** @var list<DtbStockEditApprovalDetail> $result */
        $result = $this->createQueryBuilder('sad')
            ->innerJoin('sad.StockEditApproval', 'sa')->addSelect('sa')
            ->innerJoin('sa.StockChangeTypeDetail', 'sctd')->addSelect('sctd')
            ->innerJoin('sctd.StockChangeType', 'sct')->addSelect('sct')
            ->innerJoin('sa.RegisteredMember', 'rm')->addSelect('rm')
            ->innerJoin(
                DtbStockApprovalList::class,
                'sal',
                Join::WITH,
                'sal.historySourceId = sa.id
                AND sal.approvalStatus = :approvalListUnapproved
                AND IDENTITY(sal.HistorySourceType) IN (:stockEditSourceTypeIds)'
            )
            ->leftJoin(
                DtbStockHistory::class,
                'sh',
                Join::WITH,
                'sh.historySourceId = sa.id
                AND sh.ProductStock = sad.ProductStock
                AND IDENTITY(sh.HistorySourceType) IN (:stockEditSourceTypeIds)'
            )
            ->andWhere('sad.ProductStock = :productStockId')
            ->andWhere('sct.id = :beStockedTypeId')
            ->andWhere('sh.id IS NULL')
            ->setParameter('productStockId', $productStockId)
            ->setParameter('beStockedTypeId', MtbStockChangeType::BE_STOCKED)
            ->setParameter('approvalListUnapproved', DtbStockApprovalList::APPROVAL_STATUS_UNAPPROVED)
            ->setParameter('stockEditSourceTypeIds', $stockEditSourceTypeIds)
            ->getQuery()
            ->getResult();

        return $result;
    }

