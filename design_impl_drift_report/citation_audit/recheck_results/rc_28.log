namespace Eccube\Service\EntityManager;

use Doctrine\ORM\EntityManagerInterface;
use Eccube\Entity\BaseInfo;
use Eccube\Entity\DtbStockApprovalList;
use Eccube\Entity\Master\MtbStockChangeTypeDetail;
use Eccube\Entity\Master\MtbStockHistorySourceType;
use Eccube\Entity\Member;

class StockApprovalListEntityManager
{
    public function __construct(private readonly EntityManagerInterface $entityManager)
    {
    }

    public function save(
        ?DtbStockApprovalList $StockApprovalList,
        BaseInfo $BaseInfo,
        ?int $StockLocationId,
        MtbStockHistorySourceType $HistorySourceType,
        int $historySourceId,
        ?MtbStockChangeTypeDetail $StockTransferTypeDetail,
        int $approvalStatus,
        \DateTime $registeredDate,
        Member $RegisteredMember,
        ?\DateTime $approvedDate = null,
        ?Member $ApprovalMember = null,
        ?int $ProductStockTotalCount = null,
        ?int $InventoryChangeTotalCount = null,
        ?int $TotalCostPriceBefore = null,
    ): DtbStockApprovalList {
        if (empty($StockApprovalList)) {
            $StockApprovalList = new DtbStockApprovalList();
        }
        $StockApprovalList->setStockLocationId($StockLocationId);
        $StockApprovalList->setHistorySourceType($HistorySourceType);
        $StockApprovalList->setHistorySourceId($historySourceId);
        $StockApprovalList->setStockTransferTypeDetail($StockTransferTypeDetail);
        $StockApprovalList->setApprovalStatus($approvalStatus);
        $StockApprovalList->setRegisteredDate($registeredDate);
        $StockApprovalList->setRegisteredMember($RegisteredMember);
        $StockApprovalList->setApprovedDate($approvedDate);
        $StockApprovalList->setApprovalMember($ApprovalMember);
        $StockApprovalList->setProductStockTotalCount($ProductStockTotalCount);
        $StockApprovalList->setInventoryChangeTotalCount($InventoryChangeTotalCount);
        $StockApprovalList->setTotalCostPriceBefore($TotalCostPriceBefore);

        $this->entityManager->persist($StockApprovalList);
        // TenantEventSubscriber が prePersist で base_info_id をセッション値で上書きするため、
        // persist() の後に在庫元の BaseInfo を明示的に再セットする。
        $StockApprovalList->setBaseInfo($BaseInfo);

        return $StockApprovalList;
    }
}

    public function setProductStockTotalCount(int $productStockTotalCount): DtbStockApprovalList
    {
        $this->productStockTotalCount = $productStockTotalCount;

        return $this;
    }

    #[ORM\Column(name: 'inventory_change_total_count', type: Types::INTEGER, options: ['comment' => '合計在庫増減数'])]
    private int $inventoryChangeTotalCount;

    public function getInventoryChangeTotalCount(): int
    {
        return $this->inventoryChangeTotalCount;
    }

    public function setInventoryChangeTotalCount(int $inventoryChangeTotalCount): DtbStockApprovalList
    {
        $this->inventoryChangeTotalCount = $inventoryChangeTotalCount;

        return $this;
    }

    #[ORM\Column(name: 'total_cost_price_before', type: Types::INTEGER, options: ['comment' => '合計総原価増減数'])]
    private int $totalCostPriceBefore;

    public function getTotalCostPriceBefore(): int
    {
        return $this->totalCostPriceBefore;
    }

    public function setTotalCostPriceBefore(int $totalCostPriceBefore): DtbStockApprovalList
    {
        $this->totalCostPriceBefore = $totalCostPriceBefore;

        return $this;
    }

    /**
     * 承認ステータスのラベルを取得する
     */
    public function getApprovalStatusLabel(): string
    {
        return self::APPROVAL_STATUS_LABELS[$this->approvalStatus] ?? self::APPROVAL_STATUS_LABEL_DEFAULT;
    }

    /**
     * 承認対象のラベルを取得する
     */
    public function getApprovalTargetLabel(): string
    {
        return self::APPROVAL_TARGET_LABELS[$this->getHistorySourceTypeId()] ?? self::APPROVAL_TARGET_LABEL_DEFAULT;
    }

    /**
     * 在庫変動区分（親区分）のIDを取得する
     */
    public function getStockChangeTypeId(): int
    {
        return $this->getStockTransferTypeDetail()->getStockChangeType()->getId();
    }

    /**
     * 在庫変動区分（親区分）のラベルを取得する
     */
    public function getChangeTypeParentLabel(): string
    {
        return $this->getStockTransferTypeDetail()->getStockChangeType()->getName();
    }

