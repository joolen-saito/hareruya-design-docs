namespace Eccube\Service\EntityManager;

use Doctrine\ORM\EntityManagerInterface;
use Eccube\Entity\BaseInfo;
use Eccube\Entity\DtbStockEditApproval;
use Eccube\Entity\Master\MtbStockChangeTypeDetail;
use Eccube\Entity\Member;

class StockEditApprovalEntityManager
{
    public function __construct(private readonly EntityManagerInterface $entityManager)
    {
    }

    public function save(
        BaseInfo $BaseInfo,
        MtbStockChangeTypeDetail $StockChangeTypeDetail,
        int $approvalStatus,
        \DateTime $registeredAt,
        Member $RegisteredMember,
        ?\DateTime $approvedAt = null,
        ?Member $ApprovalMember = null,
    ): DtbStockEditApproval {
        $StockEditApproval = new DtbStockEditApproval();
        $StockEditApproval->setBaseInfo($BaseInfo);
        $StockEditApproval->setStockChangeTypeDetail($StockChangeTypeDetail);
        $StockEditApproval->setApprovalStatus($approvalStatus);
        $StockEditApproval->setRegisteredAt($registeredAt);
        $StockEditApproval->setRegisteredMember($RegisteredMember);
        $StockEditApproval->setApprovedAt($approvedAt);
        $StockEditApproval->setApprovalMember($ApprovalMember);

        $this->entityManager->persist($StockEditApproval);

        return $StockEditApproval;
    }
}
