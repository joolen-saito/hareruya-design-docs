namespace Eccube\Entity;

use Doctrine\DBAL\Types\Types;
use Doctrine\ORM\Mapping as ORM;
use Eccube\Entity\Master\MtbStockChangeTypeDetail;
use Eccube\Entity\Traits\TenantTrait;
use Eccube\Repository\DtbStockEditApprovalRepository;

#[ORM\Table(name: 'dtb_stock_edit_approval')]
#[ORM\Entity(repositoryClass: DtbStockEditApprovalRepository::class)]
class DtbStockEditApproval extends AbstractEntity
{
    use TenantTrait;

    public const APPROVAL_STATUS_UNAPPROVED = 1;
    public const APPROVAL_STATUS_APPROVED = 2;
    public const APPROVAL_STATUS_REJECTED = 3;

    public const APPROVAL_STATUS_TO_LABELS = [
        self::APPROVAL_STATUS_UNAPPROVED => 'admin.stock.edit_approval.unapproved',
        self::APPROVAL_STATUS_APPROVED => 'admin.stock.edit_approval.approved',
        self::APPROVAL_STATUS_REJECTED => 'admin.stock.edit_approval.rejected',
    ];

    public const APPROVAL_STATUS_LABEL_DEFAULT = 'admin.stock.edit_approval.unapproved';

    #[ORM\Column(name: 'id', type: Types::INTEGER, options: ['unsigned' => true, 'comment' => '在庫編集承認ID'])]
    #[ORM\Id]
    #[ORM\GeneratedValue(strategy: 'IDENTITY')]
    private int $id;

    public function getId(): int
    {
        return $this->id;
    }

    #[ORM\JoinColumn(name: 'stock_change_type_detail_id', referencedColumnName: 'id', nullable: false)]
    #[ORM\ManyToOne(targetEntity: MtbStockChangeTypeDetail::class)]
    private MtbStockChangeTypeDetail $StockChangeTypeDetail;

    public function getStockChangeTypeDetail(): MtbStockChangeTypeDetail
    {
        return $this->StockChangeTypeDetail;
    }

    public function setStockChangeTypeDetail(MtbStockChangeTypeDetail $StockChangeTypeDetail): DtbStockEditApproval
    {
        $this->StockChangeTypeDetail = $StockChangeTypeDetail;

        return $this;
    }

    #[ORM\Column(name: 'approval_status', type: Types::INTEGER, options: ['unsigned' => true, 'comment' => '承認ステータス'])]
    private int $approvalStatus;

    public function getApprovalStatus(): int
    {
        return $this->approvalStatus;
    }

    public function setApprovalStatus(int $approvalStatus): DtbStockEditApproval
    {
        $this->approvalStatus = $approvalStatus;

        return $this;
    }

    /**
     * 承認ステータスのラベルを取得する。
     */
    public function getApprovalStatusLabel(): string
    {
        return self::APPROVAL_STATUS_TO_LABELS[$this->approvalStatus] ?? self::APPROVAL_STATUS_LABEL_DEFAULT;
    }

    #[ORM\Column(name: 'registered_at', type: Types::DATETIMETZ_MUTABLE, options: ['comment' => '登録日'])]
    private \DateTime $registeredAt;

    public function getRegisteredAt(): \DateTime
    {
        return $this->registeredAt;
    }

    public function setRegisteredAt(\DateTime $registeredAt): DtbStockEditApproval
    {
        $this->registeredAt = $registeredAt;

        return $this;
    }

    #[ORM\JoinColumn(name: 'registered_member_id', referencedColumnName: 'id', nullable: false)]
    #[ORM\ManyToOne(targetEntity: Member::class)]
    private Member $RegisteredMember;

    public function getRegisteredMember(): Member
    {
        return $this->RegisteredMember;
    }

    public function setRegisteredMember(Member $RegisteredMember): DtbStockEditApproval
    {
        $this->RegisteredMember = $RegisteredMember;

        return $this;
    }

    #[ORM\Column(name: 'approved_at', type: Types::DATETIMETZ_MUTABLE, nullable: true, options: ['comment' => '承認日'])]
    private ?\DateTime $approvedAt = null;

    public function getApprovedAt(): ?\DateTime
    {
        return $this->approvedAt;
    }

    public function setApprovedAt(?\DateTime $approvedAt): DtbStockEditApproval
    {
        $this->approvedAt = $approvedAt;

        return $this;
    }

    #[ORM\JoinColumn(name: 'approval_member_id', referencedColumnName: 'id', nullable: true)]
    #[ORM\ManyToOne(targetEntity: Member::class)]
    private ?Member $ApprovalMember = null;

    public function getApprovalMember(): ?Member
    {
        return $this->ApprovalMember;
    }

    public function setApprovalMember(?Member $ApprovalMember): DtbStockEditApproval
    {
        $this->ApprovalMember = $ApprovalMember;

        return $this;
    }

    #[ORM\Column(name: 'rejected_memo', type: Types::TEXT, nullable: true, options: ['comment' => '却下メモ'])]
    private ?string $rejectedMemo = null;

    public function getRejectedMemo(): ?string
    {
        return $this->rejectedMemo;
    }

    public function setRejectedMemo(?string $rejectedMemo): DtbStockEditApproval
    {
        $this->rejectedMemo = $rejectedMemo;

        return $this;
    }
}
