                $productCode, $BaseInfo, $stockLocationId
            );

            if ($productStockId === null) {
                $errors[] = ['row' => $rowNum, 'message' => sprintf('商品コード「%s」が見つかりません', $productCode)];
                continue;
            }

            $ProductStock = $this->productStockRepository->find($productStockId);
            if ($ProductStock === null) {
                continue;
            }

            $currentStock = (int) $ProductStock->getStock();
            $afterStock = $currentStock + $editQuantity;

            if ($editQuantity < 0 && $afterStock < 0) {
                $errors[] = ['row' => $rowNum, 'message' => sprintf(
                    '在庫数を超える減算です（現在庫: %s、変動後: %s）',
                    number_format($currentStock), number_format($afterStock)
                )];
            } elseif ($afterStock > 99_999_999) {
                $errors[] = ['row' => $rowNum, 'message' => sprintf(
                    '在庫上限（99,999,999）を超えます（変動後: %s）',
                    number_format($afterStock)
                )];
            } elseif ($afterStock < -99_999_999) {
                $errors[] = ['row' => $rowNum, 'message' => sprintf(
                    '在庫下限（-99,999,999）を下回ります（変動後: %s）',
                    number_format($afterStock)
                )];
            }
        }

        $event = new EventArgs(
            [
                'errors' => $errors,
            ],
            $request
        );
        $this->eventDispatcher->dispatch($event, EccubeEvents::ADMIN_STOCK_CHANGE_CSV_PRE_VALIDATE_COMPLETE);

        return $this->json(['errors' => $errors]);
    }

