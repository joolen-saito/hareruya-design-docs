    <script src="/template/admin/assets/js/select2.min.js"></script>
    <script nonce="{{ csp_nonce }}">
        $(function() {
            $('#file-select').click(function() {
                $('#admin_stock_change_csv_list_import_file').click();
                $('#admin_stock_change_csv_list_import_file').on('change', function() {
                    const files = $(this).prop('files');
                    if (files.length) {
                        $('#admin_stock_change_csv_list_import_file_name').text(files[0].name);
                        $('#upload-button').prop('disabled', false);
                    }
                });
            });
            $('#page_count_pulldown').on('change', function () {
                const targetUrl = $(this).val();
                if (targetUrl) {
                    window.location.href = targetUrl;
                }
            });

            const $membersSelect = $('#admin_stock_change_csv_list_approval_notification_target_members');
            const membersApiUrl = '{{ url('admin_stock_change_csv_members') }}';

            function initMembersSelect2() {
                $membersSelect.select2({width: '100%'});
            }

            let currentRequest = null;

            function updateMembers(baseInfoId) {
                if (currentRequest) {
                    currentRequest.abort();
                    currentRequest = null;
                }
                $membersSelect.empty();
                if (!baseInfoId) {
                    initMembersSelect2();
                    return;
                }
                currentRequest = $.getJSON(membersApiUrl, {base_info_id: baseInfoId}, function(members) {
                    currentRequest = null;
                    members.forEach(function(member) {
                        $membersSelect.append($('<option></option>').val(member.id).text(member.name));
                    });
                    initMembersSelect2();
                });
            }

            const $baseInfoSelect = $('#admin_stock_change_csv_list_change_base_info');
            $baseInfoSelect.on('change', function() {
                updateMembers($(this).val());
            });

            initMembersSelect2();
        });
    </script>
