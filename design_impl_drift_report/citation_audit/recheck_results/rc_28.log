   270	    }
   271	
   272	    /**
   273	     * 商品規格情報を取得し、更新ロックをかける。
   274	     *
   275	     * @param ReadCsvRowEvent $event イベント。エラーがある場合、エラーメッセージを設定する
   276	     * @return array|null 商品規格の情報。 エラーがあった場合は null
   277	     */
   278	    private function tryLockFindProductClass(ReadCsvRowEvent $event)
   279	    {
   280	        $row = $event->getRow();
   281	        $productCode = $this->productCodeColumn->getValue($row);
   282	        $productClass = null;
   283	        try {
   284	            $productClassId = $this->findProductClassIdByProductCode($productCode);
   285	
   286	        } catch (NonUniqueResultException $e) {
   287	            $event->getMessageStore()
   288	                ->addProductCodeDuplicatedError($row->getRowNumber(), $productCode);
   289	
   290	            return null;
   291	        }
   292	
   293	        if (empty($productClassId)) {
   294	            // 商品が見つからなかった。
   295	            $event->getMessageStore()
   296	                ->addMasterNotExistsError(
   297	                    $row->getRowNumber(),
   298	                    sprintf(
   299	                        '%s(%s)',
   300	                        $this->productCodeColumn->getLabel(),
   301	                        $this->productCodeColumn->getName()
   302	                    ),
   303	                    $productCode
   304	                );
   305	
   306	            return null;
   307	        }
   308	
   309	        $lockedProductStock = $this->getProductStockRepository()->tryLockAndGetByProductClassId([$productClassId]);
   310	        if (is_null($lockedProductStock)) {
   311	            // 更新ロックをかけるのに失敗。
   312	            $event->getMessageStore()
   313	                ->addProductUpdateLockTimeoutError($row->getRowNumber());
   314	
   315	            return null;
   316	        }
   317	
   318	        $productClass = $this->findProductClassById($productClassId);
   319	        if (empty($productClass)) {
   320	            // ロックをかけた後に再検索したら、商品が見つからなかった。
   321	            $event->getMessageStore()
   322	                ->addMasterNotExistsError(
   323	                    $row->getRowNumber(),
   324	                    sprintf(
   325	                        '%s(%s)',
   326	                        $this->productCodeColumn->getLabel(),
   327	                        $this->productCodeColumn->getName()
   328	                    ),
   329	                    $productCode
   330	                );
   331	
   332	            return null;
   333	
   334	        }
   335	
   336	        return [
   337	                'productClass' => $productClass,
   338	                'productStock' => $lockedProductStock,
   339	            ];
   340	    }
