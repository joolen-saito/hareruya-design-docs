    (function() {
        'use strict';

        const PRE_VALIDATE_URL = '{{ url('admin_stock_change_csv_pre_validate') }}';
        const MAX_ROWS = 10000;
        const MAX_ABS_QUANTITY = 99999999;
        const MAX_PRICE = 999999999;
        const LARGE_CHANGE_THRESHOLD = 100;

        /** エラーリストを画面上に表示する */
        function showErrors(errors) {
            const container = document.getElementById('csv-validate-errors');
            const list = document.getElementById('csv-validate-error-list');
            list.innerHTML = '';
            errors.forEach(function(err) {
                const li = document.createElement('li');
                li.textContent = err.row > 0 ? ('行 ' + err.row + ': ' + err.message) : err.message;
                list.appendChild(li);
            });
            container.classList.remove('d-none');
            container.scrollIntoView({ behavior: 'smooth', block: 'start' });
        }

        function hideErrors() {
            document.getElementById('csv-validate-errors').classList.add('d-none');
        }

        /** UTF-8/BOM 対応のシンプルなCSV行パーサー */
        function parseCSV(text) {
            text = text.replace(/^﻿/, '');
            const lines = text.split(/\r\n|\r|\n/);
            return lines
                .filter(function(line) { return line.trim() !== ''; })
                .map(function(line) {
                    const fields = [];
                    let field = '';
                    let inQ = false;
                    for (let i = 0; i < line.length; i++) {
                        const c = line[i];
                        if (c === '"') {
                            if (inQ && line[i + 1] === '"') { field += '"'; i++; }
                            else { inQ = !inQ; }
                        } else if (c === ',' && !inQ) {
                            fields.push(field);
                            field = '';
                        } else {
                            field += c;
                        }
                    }
                    fields.push(field);
                    return fields;
                });
        }

        /** ボタンを読み込み中状態にする */
        function setButtonLoading(btn, loading) {
            btn.disabled = loading;
            btn.textContent = loading ? '検証中...' : '{{ 'admin.common.bulk_registration'|trans|e('js') }}';
        }

        document.getElementById('upload-form').addEventListener('submit', function(e) {
            e.preventDefault();
            hideErrors();

            const form = e.target;
            const btn = document.getElementById('upload-button');
            const fileInput = document.getElementById('admin_stock_change_csv_list_import_file');

            if (!fileInput || !fileInput.files || fileInput.files.length === 0) {
                showErrors([{ row: 0, message: 'CSVファイルを選択してください' }]);
                return;
            }

            setButtonLoading(btn, true);

            const reader = new FileReader();
            reader.onload = function(ev) {
                const text = ev.target.result;
                const allRows = parseCSV(text);

                // ヘッダー行を除いたデータ行
                const dataRows = allRows.slice(1).filter(function(r) {
                    return r.some(function(f) { return f.trim() !== ''; });
                });

                const errors = [];

                // 2-4-1: 件数上限
                if (dataRows.length === 0) {
                    errors.push({ row: 0, message: 'CSVにデータがありません' });
                } else if (dataRows.length > MAX_ROWS) {
                    errors.push({ row: 0, message: MAX_ROWS.toLocaleString() + '件を超えています（' + dataRows.length.toLocaleString() + '件）' });
                }

                if (errors.length > 0) {
                    setButtonLoading(btn, false);
                    showErrors(errors);
                    return;
                }

                let hasLargeChange = false;
                const rowsForAjax = [];

                // 2-4: フォーマット・範囲チェック（全行）
                dataRows.forEach(function(fields, idx) {
                    const rowNum = idx + 2;
                    const productCode = (fields[0] || '').trim();
                    const editQuantityStr = (fields[1] || '').trim();
                    const purchasePriceStr = (fields[2] || '').trim();

                    if (!productCode) {
                        errors.push({ row: rowNum, message: '商品コードは必須です' });
                    }

                    let validQty = null;
                    if (!editQuantityStr) {
                        errors.push({ row: rowNum, message: '在庫増減数は必須です' });
                    } else if (!/^-?\d+$/.test(editQuantityStr)) {
                        errors.push({ row: rowNum, message: '在庫増減数は整数で入力してください' });
                    } else {
                        const qty = parseInt(editQuantityStr, 10);
                        if (qty === 0) {
                            // 0は未入力扱い
                        } else if (qty < -MAX_ABS_QUANTITY || qty > MAX_ABS_QUANTITY) {
                            errors.push({ row: rowNum, message: '在庫増減数は ' + (-MAX_ABS_QUANTITY).toLocaleString() + '〜' + MAX_ABS_QUANTITY.toLocaleString() + ' の範囲で入力してください' });
                        } else {
                            validQty = qty;
                            if (Math.abs(qty) >= LARGE_CHANGE_THRESHOLD) { hasLargeChange = true; }
                            if (productCode) {
                                rowsForAjax.push({ row: rowNum, product_code: productCode, edit_quantity: qty });
                            }
                        }
                    }

                    if (purchasePriceStr !== '') {
                        if (!/^\d+$/.test(purchasePriceStr)) {
                            errors.push({ row: rowNum, message: '仕入単価は0以上の整数で入力してください' });
                        } else {
                            const price = parseInt(purchasePriceStr, 10);
                            if (price === 0) {
                                // 0は未入力扱い
                            } else if (price >= MAX_PRICE) {
                                errors.push({ row: rowNum, message: '仕入単価は ' + (MAX_PRICE - 1).toLocaleString() + ' 以下で入力してください' });
                            } else if (validQty !== null) {
                                // 仕入単価 × 増減数の絶対値 = 行の合計総単価チェック
                                const rowTotalCost = price * Math.abs(validQty);
                                if (rowTotalCost > MAX_PRICE) {
                                    errors.push({ row: rowNum, message: '合計総単価が上限（' + MAX_PRICE.toLocaleString() + ' 円）を超えています（仕入単価 ' + price.toLocaleString() + ' × 数量 ' + Math.abs(validQty).toLocaleString() + ' = ' + rowTotalCost.toLocaleString() + ' 円）' });
                                }
                            }
                        }
                    }
                });

                // 2-5-1: フォーマットエラーがあれば全て表示して停止
                if (errors.length > 0) {
                    setButtonLoading(btn, false);
                    showErrors(errors);
                    return;
                }

                // Phase 2: AJAX在庫チェック（在庫上限・ゼロ以下）
                const baseInfoEl = document.getElementById('admin_stock_change_csv_list_change_base_info');
                const baseInfoId = baseInfoEl ? parseInt(baseInfoEl.value, 10) || 0 : 0;
                const stockLocationEl = document.querySelector('input[name="admin_stock_change_csv_list[change_stock_location_id]"]:checked');
                const stockLocationId = stockLocationEl ? parseInt(stockLocationEl.value, 10) || 0 : 0;

                fetch(PRE_VALIDATE_URL, {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'X-Requested-With': 'XMLHttpRequest',
                    },
                    body: JSON.stringify({
                        base_info_id: baseInfoId,
                        stock_location_id: stockLocationId,
                        rows: rowsForAjax,
                    }),
                })
                    .then(function(r) { return r.ok ? r.json() : Promise.reject(r.status); })
                    .then(function(data) {
                        setButtonLoading(btn, false);
                        const ajaxErrors = data.errors || [];
                        if (ajaxErrors.length > 0) {
                            showErrors(ajaxErrors);
                            return;
                        }

                        // Phase 3: 1件でも±100点以上の在庫変動がある場合の確認モーダル
                        if (hasLargeChange) {
                            const modalEl = document.getElementById('largeChangeConfirmModal');
                            const modal = new bootstrap.Modal(modalEl);
                            const okBtn = document.getElementById('large-change-confirm-ok');
                            const okHandler = function() {
                                modal.hide();
                'description' => trans('admin.product.stock_change_csv.stock_purchase_price_description'),
                'required' => true,
            ],
        ];
    }

