/bin/bash -lc "python3 - <<'PY'
from pathlib import Path
import re, html
terms=[r'更新ロック',r'ロック取得',r'商品コード.{0,20}重複',r'2件以上',r'在庫増減数.{0,10}0',r'更新不要',r'スキップ',r'商品登録CSVファイルをアップロードしました',r'dtb_product_stock',r'dtb_product_class',r'規格ごとに在庫変更履歴',r'同一更新',r'アップロードしました']
rx=re.compile('|'.join(terms),re.I)
tag=re.compile(r'<(?P<tag>["'^ >]+)(?P<attrs>[''^>]*data-excel-ref="(?P<ref>[''^"]+)"[''^>]*)>(?P<body>.*?)</(?P=tag)>'"',re.S)
for p in Path('hareruya-design-docs/excel_to_html/output').glob('*.html'):
    t=p.read_text(errors='replace')
    for m in tag.finditer(t):
        body=html.unescape(re.sub(r'\\s+',' ',re.sub(r'<["'^>]+>'"',' ',m.group('body')))).strip()
        if body and rx.search(body):
            print(f'{p.name}\\t{m.group(\"ref\")}\\t{body[:500]}')
