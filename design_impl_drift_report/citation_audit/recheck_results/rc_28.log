namespace Eccube\Service\Csv\Importer\Validator;

use Eccube\Service\Csv\Importer\MessageStore;
use Eccube\Service\Csv\Importer\Model\CsvColumnInterface;
use Eccube\Service\Csv\Importer\Model\CsvRowInterface;

/**
 * 売値と買値の大小関係を検証するもの。
 */
class PriceConsistencyRowValidator implements RowValidatorInterface
{
    /** @var CsvColumnInterface|int|float 売値 */
    private CsvColumnInterface|int|float $sellPrice;

    /** @var CsvColumnInterface|int|float 買値 */
    private CsvColumnInterface|int|float $buyPrice;

    /**
     * @param CsvColumnInterface|int|float $sellPrice 売値の値、または列
     * @param CsvColumnInterface|int|float $buyPrice 買値の値、または列
     */
    public function __construct(CsvColumnInterface|int|float $sellPrice, CsvColumnInterface|int|float $buyPrice)
    {
        $this->sellPrice = $this->verifyPriceType($sellPrice, 'sellPrice');
        $this->buyPrice = $this->verifyPriceType($buyPrice, 'buyPrice');
    }

    /**
     * 価格の大小を検証する。
     *
     * @param MessageStore $errors メッセージの格納先
     * @param CsvRowInterface $row 検証する行
     *
     * @return bool 値が正しい場合 true
     */
    public function validate(MessageStore $errors, CsvRowInterface $row): bool
    {
        $sellPrice = $this->getPriceValue($this->sellPrice, $row);
        $buyPrice = $this->getPriceValue($this->buyPrice, $row);

        // 買取価格が販売価格を上回っている場合、エラー
        if ($buyPrice > $sellPrice) {
            $errors->addMessage('admin.csv.error.product.price_valid', $row->getRowNumber());

            return false;
        }

        return true;
    }

    /**
     * 価格の型を検証し、型が間違っていれば例外を投げる。
     *
     * @param mixed $price 価格の値、または価格の列
     * @param string $argumentName 例外に含める引数の名前
     *
     * @return CsvColumnInterface|int|float $price を返す。
     */
    private function verifyPriceType(mixed $price, string $argumentName): CsvColumnInterface|int|float
    {
        if (is_int($price) || is_float($price) || $price instanceof CsvColumnInterface) {
            return $price;
        }

        throw new \InvalidArgumentException(sprintf('%s には int, float または CsvColumnInterface を指定してください。', $argumentName));
    }

    /**
     * 価格を取得する。
     *
     * @param CsvColumnInterface|int|float $price 価格の値、または価格の列
     * @param CsvRowInterface $row CSVの行
     *
     * @return int 売値
     */
    private function getPriceValue(CsvColumnInterface|int|float $price, CsvRowInterface $row): int
    {
        if ($price instanceof CsvColumnInterface) {
            $value = $price->getValue($row);
            if (is_int($value) || is_float($value)) {
                return (int) $value;
            }

            throw new \LogicException(sprintf('%s から数値を取得できません。数値を返却する列を指定してください。', $price->getLabel()));
        }

        return (int) $price;
    }
}
