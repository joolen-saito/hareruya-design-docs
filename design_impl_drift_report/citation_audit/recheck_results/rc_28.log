namespace Eccube\Service\Csv\Importer\Event;

use Doctrine\ORM\EntityManagerInterface;
use Eccube\Entity\BaseInfo;
use Eccube\Entity\DtbStockApprovalList;
use Eccube\Entity\Master\MtbStockChangeTypeDetail;
use Eccube\Entity\Master\MtbStockHistorySourceType;
use Eccube\Entity\Member;
use Eccube\Repository\BaseInfoRepository;
use Eccube\Repository\DtbStockEditApprovalDetailRepository;
use Eccube\Repository\DtbStockEditApprovalRepository;
use Eccube\Repository\DtbStockEditCsvRepository;
use Eccube\Repository\Master\MtbStockHistorySourceTypeRepository;
use Eccube\Repository\ProductStockRepository;
use Eccube\Service\Admin\Stock\HandlerInput\StockChangeCsvImportInput;
use Eccube\Service\Csv\Importer\Model\ColumnDefinitions;
use Eccube\Service\Csv\Importer\Model\CsvColumnInterface;
use Eccube\Service\Csv\Importer\Validator\PriceConsistencyRowValidator;
use Eccube\Service\Csv\Importer\Validator\RowValidatorInterface;
use Eccube\Service\EntityManager\StockApprovalListEntityManager;
use Eccube\Service\Upload\FileManager;
use Eccube\Util\StringUtil;

/**
 * 在庫変更CSVをインポートするもの。
 */
class StockChangeCsvImportHandler extends BaseCsvImportHandler
{
    private const S3_PREFIX = 'csv/stock-change/';

    /** @var CsvColumnInterface 列: 商品コード */
    private ?CsvColumnInterface $productCodeColumn = null;

    /** @var CsvColumnInterface 列: 在庫増減数 */
    private ?CsvColumnInterface $editQuantityColumn = null;

    /** @var CsvColumnInterface 列: 仕入単価 */
    private ?CsvColumnInterface $purchaseUnitPriceColumn = null;

    private int $totalInventoryChange = 0;
    private int $totalCostPriceBefore = 0;
    private int $rowCount = 0;

    /** @var int|null CsvImporter トランザクション内で採番される在庫編集承認ID */
    private ?int $stockEditApprovalId = null;

    /**
     * @param StockChangeCsvImportInput $input
     */
    public function __construct(
        private readonly DtbStockEditApprovalRepository $stockEditApprovalRepository,
        private readonly DtbStockEditApprovalDetailRepository $stockEditApprovalDetailRepository,
        private readonly BaseInfoRepository $baseInfoRepository,
        private readonly ProductStockRepository $productStockRepository,
        private readonly MtbStockHistorySourceTypeRepository $stockHistorySourceTypeRepository,
        private readonly EntityManagerInterface $entityManager,
        private readonly StockApprovalListEntityManager $stockApprovalListEntityManager,
        private readonly DtbStockEditCsvRepository $stockEditCsvRepository,
        private readonly FileManager $fileManager,
        private readonly Member $Member,
        private StockChangeCsvImportInput $input,
    ) {
        $this->input = $input;
    }

    public function onBeforeImport(): void
    {
        parent::onBeforeImport();

        $this->initializeColumnDefinitions();
        $this->totalInventoryChange = 0;
        $this->totalCostPriceBefore = 0;
        $this->rowCount = 0;

        // CsvImporter::importRows のトランザクション内で親レコードを作成する。
        $stockEditApprovalId = $this->stockEditApprovalRepository->insertStockChange([
            'stockChangeTypeDetail' => $this->input->stockChangeTypeDetailId,
            'approvalNotificationTargetMembers' => $this->input->approvalNotificationTargetMembers,
            'changeBaseInfo' => $this->input->changeBaseInfoId,
        ]);

        if ($stockEditApprovalId === null) {
            throw new \RuntimeException('Failed to insert stock edit approval.');
        }

        $this->stockEditApprovalId = $stockEditApprovalId;
    }

    /**
     * 在庫編集承認IDを返す。
     */
    public function getStockEditApprovalId(): ?int
    {
        return $this->stockEditApprovalId;
    }

    /**
     * 採番済みの在庫編集承認IDを返す。未採番の場合は例外。
     */
    private function requireStockEditApprovalId(): int
    {
        if ($this->stockEditApprovalId === null) {
            throw new \LogicException('stockEditApprovalId is not initialized.');
        }

        return $this->stockEditApprovalId;
    }

    public function onAfterImport(AfterReadEvent $event): void
    {
        parent::onAfterImport($event);

        if ($this->rowCount > 0 && $event->isSuccessful()) {
            $now = new \DateTime('now', new \DateTimeZone('UTC'));
            $HistorySourceType = $this->stockHistorySourceTypeRepository->find(MtbStockHistorySourceType::STOCK_CHANGE_CSV_IMPORT);
            $BaseInfo = $this->entityManager->getReference(BaseInfo::class, $this->input->changeBaseInfoId);

            $this->stockApprovalListEntityManager->save(
                StockApprovalList: null,
                BaseInfo: $BaseInfo,
                StockLocationId: $this->input->changeStockLocationId,
                HistorySourceType: $HistorySourceType,
                historySourceId: $this->requireStockEditApprovalId(),
                StockTransferTypeDetail: $this->entityManager->getReference(MtbStockChangeTypeDetail::class, $this->input->stockChangeTypeDetailId),
                approvalStatus: DtbStockApprovalList::APPROVAL_STATUS_UNAPPROVED,
                registeredDate: $now,
                RegisteredMember: $this->entityManager->getReference(Member::class, $this->Member->getId()),
                approvedDate: null,
                ApprovalMember: null,
                ProductStockTotalCount: $this->rowCount,
                InventoryChangeTotalCount: $this->totalInventoryChange,
                TotalCostPriceBefore: $this->totalCostPriceBefore,
            );

            // S3へのアップロード処理
            $importFilePath = $this->input->importFilePath;
            if (!is_file($importFilePath)) {
                throw new \RuntimeException('Failed to upload CSV file to S3.');
            }

            $s3ObjectKey = null;

            try {
                $s3Path = sprintf(
                    '%s%s/%s/%d',
                    self::S3_PREFIX,
                    $now->format('Y'),
                    $now->format('m'),
                    $this->requireStockEditApprovalId(),
                );
                $s3Filename = 'upload_'.StringUtil::random().'.csv';

                $fileAdapter = $this->fileManager->getAdapter();
                $contentBucketOptions = $this->fileManager->getContentBucketOptions();
                $fileAdapter->upload($importFilePath, $s3Path, $s3Filename, $contentBucketOptions);

                $entitySaveData = $fileAdapter->toEntitySaveData();
                $s3ObjectKey = (string) ($entitySaveData['s3_object_key'] ?? '');
                if ($s3ObjectKey === '') {
                    throw new \RuntimeException('Failed to upload CSV file to S3.');
                }

                $this->entityManager->flush();
                $this->stockEditCsvRepository->insertCsvFilename([
                    'fileName' => $this->input->originalFileName,
                    's3ObjectKey' => $s3ObjectKey,
                    'memberId' => (int) $this->Member->getId(),
                    'stockEditApprovalId' => $this->requireStockEditApprovalId(),
                ]);
            } catch (\Throwable $e) {
                if ($s3ObjectKey !== null && str_starts_with($s3ObjectKey, self::S3_PREFIX)) {
                    $fileAdapter = $this->fileManager->getAdapter();
                    $contentBucketOptions = $this->fileManager->getContentBucketOptions();

                    if ($fileAdapter->exists($s3ObjectKey, $contentBucketOptions)) {
                        $fileAdapter->delete($s3ObjectKey, $contentBucketOptions);
                    }
                }

                throw $e;
            }
        }

        $this->clearColumnDefinitions();
    }

    /**
     * CSVデータ1行を取り込む。
     *
     * @param ReadCsvRowEvent $event イベント
     *
     * @return bool 読み込みに成功した場合 true
     */
    public function onReadRow(ReadCsvRowEvent $event): bool
    {
        $this->persistStockChange($event);

        if ($event->isBreakAll()) {
            return false;
        }

        return true;
    }

    /**
     * 列の定義を取得する。
     *
     * @return array<CsvColumnInterface> 列の定義を CsvColumnInterface で返す。
     */
    protected function getColumns(): array
    {
        return [
            $this->productCodeColumn,
            $this->editQuantityColumn,
            $this->purchaseUnitPriceColumn,
        ];
    }

    /**
     * 列を検証するロジックを取得する。
     *
     * @return array<RowValidatorInterface> 列全体を検証する定義を RowValidatorInterface で返す。
     */
    protected function getRowValidators(): array
    {
        return [
            new PriceConsistencyRowValidator(1, 1),
        ];
    }

    /**
     * 列の定義を初期化する。
     */
    private function initializeColumnDefinitions(): void
    {
        $this->productCodeColumn = ColumnDefinitions::productCode()->setRequired(true);
        $this->editQuantityColumn = ColumnDefinitions::editQuantity()->setRequired(true);
        $this->purchaseUnitPriceColumn = ColumnDefinitions::purchaseUnitPrice()->setRequired(true);
    }

    /**
     * 列の定義を削除し、メモリを開放する。
     */
    private function clearColumnDefinitions(): void
    {
        $this->productCodeColumn = null;
        $this->editQuantityColumn = null;
        $this->purchaseUnitPriceColumn = null;
    }

    /**
     * 在庫変更情報を更新または登録する。
     *
     * @param ReadCsvRowEvent $event イベント
     *
     * @return int 在庫変更ID
     */
    private function persistStockChange(ReadCsvRowEvent $event): int
    {
        /** @var DtbStockEditApprovalDetailRepository $repository */
        $repository = $this->stockEditApprovalDetailRepository;

        $row = $event->getRow();
        $productCode = $this->productCodeColumn->getValue($row);

        // productCodeからproductStockIdを取得
        $BaseInfo = $this->baseInfoRepository->find($this->input->changeBaseInfoId);
        if ($BaseInfo === null) {
            $event->getMessageStore()->addRawMessage(
                sprintf('%d行目: 変更元拠点（ID: %d）が見つかりません', $row->getRowNumber(), $this->input->changeBaseInfoId)
            );
            $event->breakAll();

            return 0;
        }
        $productStockId = $this->productStockRepository->getProductStockIdByProductCode($productCode, $BaseInfo, $this->input->changeStockLocationId);
        if ($productStockId === null || $productStockId === 0) {
            $event->getMessageStore()->addRawMessage(
                sprintf('%d行目: 商品コード「%s」が見つかりません', $row->getRowNumber(), $productCode)
            );
            $event->breakAll();

            return 0;
        }

        $ProductStock = $this->productStockRepository->find($productStockId);

        $stock = [
            'productStockId' => $productStockId,
            'editQuantity' => $this->editQuantityColumn->getValue($row),
            'purchaseUnitPrice' => $this->purchaseUnitPriceColumn->getValue($row),
            'beforeEditQuantity' => $ProductStock !== null ? (int) $ProductStock->getStock() : null,
            'beforePurchaseUnitPrice' => $ProductStock !== null ? $ProductStock->getUnitCost() : null,
            'changeBaseInfoId' => $this->input->changeBaseInfoId,
            'changeStockLocationId' => $this->input->changeStockLocationId,
            'stockChangeTypeDetailId' => $this->input->stockChangeTypeDetailId,
            'stockChangeReason' => $this->input->stockChangeReason,
            'approvalDepartment' => $this->input->approvalDepartment,
            'approvalNotificationTargetMembers' => $this->input->approvalNotificationTargetMembers,
            'stockEditApprovalId' => $this->requireStockEditApprovalId(),
            'memberId' => $this->Member->getId(),
        ];

        $stockChangeId = $repository->insertStockChangeDetail($stock);

        $this->totalInventoryChange += (int) $this->editQuantityColumn->getValue($row);
        $this->totalCostPriceBefore += $ProductStock !== null ? (int) $ProductStock->getTotalCost() : 0;
        ++$this->rowCount;

        return $stockChangeId;
    }
}
            'pageMaxis' => $pageMaxis,
            'page_no' => $pageNo,
            'page_count' => $pageCount,
        ];
    }

    /**
     * 在庫変更CSV登録アップロード
     *
     * @return RedirectResponse|array<mixed>
     */
    #[Route(
        path: '/%eccube_admin_route%/product/stock/change/upload',
        name: 'admin_stock_change_csv_upload',
        methods: ['POST'])
    ]
    #[Template(template: '@admin/Stock/change.twig')]
    public function csvStockChangeUpload(Request $request, CacheUtil $cacheUtil): RedirectResponse|array
    {
        // タイムアウトを無効にする
        set_time_limit(0);

        $headers = $this->getStockChangeCsvHeader();

        $builder = $this->formFactory->createBuilder(StockChangeType::class, null, [
        ]);
        $form = $builder->getForm();
        $form->handleRequest($request);

        if (!$form->isSubmitted() || !$form->isValid()) {
            foreach ($form->getErrors(true) as $error) {
                $this->addError($error->getMessage(), 'admin');
            }

            return $this->redirectToRoute('admin_stock_change_csv_list');
        }

        $formData = $form->getData();
        $Member = $this->getMember();

        if (!$Member->isEditableShop($formData['change_base_info'])) {
            $this->addError('admin.stock.change_csv.shop_not_permitted', 'admin');

            return $this->redirectToRoute('admin_stock_change_csv_list');
        }

        /** @var UploadedFile $file */
        $file = $form->get('import_file')->getData();

        // レコード数上限チェック
        if ($this->countCsvRows($file) >= static::ADMIN_CSV_IMPORT_MAX_ROWS) {
            $this->addErrors($this->getCsvImportMaxRowsExceededMessage());

            return [
                'form' => $form->createView(),
                'headers' => $headers,
            ];
        }

        log_info('在庫変更CSV登録開始');

        // UTF-8 BOM 付きファイルをアップロードした場合も処理できるよう、
        // バイトレベルで BOM (\xEF\xBB\xBF) を除去する。
        $filePath = $file->getRealPath();
        if ($filePath !== false) {
            $content = file_get_contents($filePath);
            if ($content !== false && str_starts_with($content, "\xEF\xBB\xBF")) {
                file_put_contents($filePath, substr($content, 3));
            }
        }

        try {
            $extension = $file->getClientOriginalExtension();
            if ($extension === '') {
                $extension = 'csv';
            }
            $tempFileName = 'upload_'.StringUtil::random().'.'.$extension;
            $importFilePath = rtrim((string) $this->eccubeConfig['eccube_csv_temp_realdir'], '/').'/'.$tempFileName;

            $input = new StockChangeCsvImportInput(
                changeBaseInfoId: (int) $formData['change_base_info']->getId(),
                changeStockLocationId: (int) $formData['change_stock_location_id'],
                stockChangeTypeDetailId: (int) $formData['stock_change_type_detail']->getId(),
                stockChangeReason: $formData['stock_change_reason'],
                approvalDepartment: (int) $formData['approval_department'],
                approvalNotificationTargetMembers: (int) $formData['approval_notification_target_members'],
                originalFileName: (string) $file->getClientOriginalName(),
                importFilePath: $importFilePath,
            );

            $handler = new StockChangeCsvImportHandler(
                $this->stockEditApprovalRepository,
                $this->stockEditApprovalDetailRepository,
                $this->baseInfoRepository,
                $this->productStockRepository,
                $this->stockHistorySourceTypeRepository,
                $this->entityManager,
                $this->stockApprovalListEntityManager,
                $this->stockEditCsvRepository,
                $this->fileManager,
                $Member,
                $input,
            );

            $importer = new StockChangeCsvImporter(
                $this->entityManager,
                $this->translator,
                $this->eccubeConfig,
                $handler,
                $Member,
                $tempFileName,
            );

            $result = $importer->import($file);

            if ($result->hasError()) {
                foreach ($result->getErrors() as $error) {
                    $this->addError($error['message'], 'admin');
                }

                return $this->redirectToRoute('admin_stock_change_csv_list');
            }

            $stockEditId = $result->getStockEditApprovalId();

            // 承認者に対して在庫管理承認通知メールを送信
            if (!empty($formData['approval_notification_target_members'])) {
                foreach ($formData['approval_notification_target_members'] as $approvalMemberId) {
                    $approvalMember = $this->entityManager->getReference(Member::class, $approvalMemberId);
                    $this->mailService->sendStockApprovalAlertMail($approvalMember, $this->generateUrl('admin_stock_approval_list', [], UrlGeneratorInterface::ABSOLUTE_URL));
                }
            }
        } catch (\Exception) {
            $this->addError('admin.common.save_error', 'admin');

            return $this->redirectToRoute('admin_stock_change_csv_list');
        }

        $event = new EventArgs(
            [
                'form' => $form,
                'formData' => $formData,
                'Member' => $Member,
                'stockEditId' => $stockEditId,
            ],
            $request
        );
        $this->eventDispatcher->dispatch($event, EccubeEvents::ADMIN_STOCK_CHANGE_CSV_STOCK_CHANGE_UPLOAD_COMPLETE);

        $this->addSuccess('admin.common.save_complete', 'admin');

        return $this->redirectToRoute('admin_stock_change_csv_list');
    }

    /**
     * エラー画面表示
     */
    protected function addErrors(string $message): void
    {
        $this->errors[] = $message;
    }

    /**
     * @return string[]
     */
    protected function getErrors(): array
    {
        return $this->errors;
    }

