#!/usr/bin/env python3
import base64
import html
import pathlib
import re
import sys


def main() -> None:
    source = pathlib.Path(sys.argv[1])
    outdir = pathlib.Path(sys.argv[2])
    sheets = sys.argv[3:]
    raw = source.read_text(encoding="utf-8")
    outdir.mkdir(parents=True, exist_ok=True)
    for sheet in sheets:
        start_match = re.search(
            rf'<section class="sheet-panel" id="{re.escape(sheet)}">',
            raw,
        )
        if not start_match:
            print(f"{sheet}: section not found")
            continue
        end_match = re.search(
            r'<section class="sheet-panel" id="sheet-\d+">',
            raw[start_match.end():],
        )
        end = start_match.end() + end_match.start() if end_match else len(raw)
        section = raw[start_match.start():end]
        tags = re.findall(r'<img\b[^>]*>', section)
        print(f"{sheet}: {len(tags)} image(s)")
        for index, tag in enumerate(tags, 1):
            src_match = re.search(r'src="data:image/([a-zA-Z0-9.+-]+);base64,([^"]+)"', tag)
            ref_match = re.search(r'data-excel-ref="([^"]+)"', tag)
            if not src_match:
                print(f"  {index}: no embedded source")
                continue
            kind = src_match.group(1).lower()
            suffix = "jpg" if kind in {"jpeg", "jpg"} else kind
            target = outdir / f"{source.stem}_{sheet}_{index}.{suffix}"
            target.write_bytes(base64.b64decode(html.unescape(src_match.group(2))))
            print(f"  {target} ref={html.unescape(ref_match.group(1)) if ref_match else '-'}")


if __name__ == "__main__":
    main()
#!/usr/bin/env python3
import base64
import os
import re
import sys
from html.parser import HTMLParser


class ExcelImageParser(HTMLParser):
    def __init__(self, output_dir, targets):
        super().__init__(convert_charrefs=True)
        self.output_dir = output_dir
        self.targets = set(targets)
        self.figure = None
        self.figure_depth = 0
        self.counts = {}

    def handle_starttag(self, tag, attrs):
        attrs = dict(attrs)
        if tag == "figure":
            sheet = attrs.get("data-excel-sheet")
            self.figure_depth += 1
            if sheet in self.targets:
                self.figure = {
                    "sheet": sheet,
                    "ref": attrs.get("data-excel-ref", "unknown"),
                    "order": attrs.get("data-image-order", "unknown"),
                }
        elif tag == "img" and self.figure:
            src = attrs.get("src", "")
            match = re.fullmatch(r"data:image/([^;]+);base64,(.*)", src, re.S)
            if not match:
                return
            ext = "jpg" if match.group(1) == "jpeg" else match.group(1)
            key = (self.figure["sheet"], self.figure["order"])
            self.counts[key] = self.counts.get(key, 0) + 1
            safe_sheet = re.sub(r"[^0-9A-Za-zぁ-んァ-ン一-龥_-]+", "_", self.figure["sheet"])
            safe_ref = re.sub(r"[^0-9A-Za-z_-]+", "_", self.figure["ref"].split("!")[-1])
            name = f"{safe_sheet}_order-{self.figure['order']}_{safe_ref}_layer-{self.counts[key]}.{ext}"
            path = os.path.join(self.output_dir, name)
            with open(path, "wb") as out:
                out.write(base64.b64decode(match.group(2)))
            print(path)

    def handle_endtag(self, tag):
        if tag == "figure":
            if self.figure_depth == 1:
                self.figure = None
            self.figure_depth = max(0, self.figure_depth - 1)


if len(sys.argv) < 4:
    raise SystemExit("usage: extract_excel_images.py HTML OUTPUT_DIR SHEET...")

html_path, output_dir, *targets = sys.argv[1:]
os.makedirs(output_dir, exist_ok=True)
parser = ExcelImageParser(output_dir, targets)
with open(html_path, encoding="utf-8") as source:
    for chunk in iter(lambda: source.read(1024 * 1024), ""):
        parser.feed(chunk)
parser.close()
import pathlib
import re
import sys

root = pathlib.Path(sys.argv[1])
terms = sys.argv[2:]
embed = re.compile(
    r"<!-- function-design-embed:start.*?<!-- function-design-embed:end.*?-->",
    re.DOTALL,
)

for term in terms:
    print(f"TERM\t{term}")
    count = 0
    for path in sorted(root.glob("*.html")):
        text = path.read_text(encoding="utf-8")
        excel = embed.sub("", text)
        for match in re.finditer(re.escape(term), excel, re.IGNORECASE):
            count += 1
            line = excel.count("\n", 0, match.start()) + 1
            start = excel.rfind("\n", 0, match.start()) + 1
            end = excel.find("\n", match.end())
            if end < 0:
                end = len(excel)
            snippet = re.sub(r"<[^>]+>", " ", excel[start:end])
            snippet = re.sub(r"\s+", " ", snippet).strip()
            print(f"{path.name}:{line}\t{snippet[:300]}")
    print(f"COUNT\t{count}")

