diff --git a//tmp/extract_rc46_images.py b//tmp/extract_rc46_images.py
new file mode 100644
index 0000000000000000000000000000000000000000..ad31246b61fd257935dee42858b2aea665025fa7
--- /dev/null
+++ b//tmp/extract_rc46_images.py
@@ -0,0 +1,54 @@
+import base64
+import re
+from pathlib import Path
+
+
+OUT = Path("/tmp/rc46_images")
+OUT.mkdir(exist_ok=True)
+
+JOBS = [
+    (
+        Path(
+            "/home/y-saito/Developments/hareruya-design-docs/excel_to_html/output/"
+            "0211_基本設計仕様書(分析・集計管理機能)_詳細設計.html"
+        ),
+        [
+            "フォーマット売上分析 集計一覧(検索項目)",
+            "フォーマット売上分析 集計一覧(検索結果) ",
+            "フォーマット売上分析 CSV出力",
+            "特集タグ編集CSVダウンロード(検索項目)",
+            "特集タグ編集CSVダウンロード CSV出力",
+        ],
+    ),
+    (
+        Path(
+            "/home/y-saito/Developments/hareruya-design-docs/excel_to_html/output/"
+            "0214_基本設計仕様書(イベント管理).html"
+        ),
+        ["イベント一覧(検索入力)", "イベント一覧(検索結果)"],
+    ),
+]
+
+for html_path, sheets in JOBS:
+    source = html_path.read_text()
+    for sheet in sheets:
+        figures = re.findall(
+            rf'<figure\b(?=[^>]*data-excel-sheet="{re.escape(sheet)}")[^>]*>.*?</figure>',
+            source,
+            flags=re.S,
+        )
+        count = 0
+        for figure in figures:
+            for media_type, payload in re.findall(
+                r'<img\b[^>]*src="data:image/([^;]+);base64,([^"]+)"',
+                figure,
+                flags=re.S,
+            ):
+                count += 1
+                safe = re.sub(r"[^0-9A-Za-zぁ-んァ-ヶ一-龠_-]+", "_", sheet)
+                suffix = "jpg" if media_type in {"jpeg", "jpg"} else media_type
+                output = OUT / f"{html_path.name[:4]}_{safe}_{count}.{suffix}"
+                output.write_bytes(base64.b64decode(payload))
+                print(f"{sheet}\t{output}\t{len(payload)}")
+        if count == 0:
+            print(f"{sheet}\tNO_IMAGE")
