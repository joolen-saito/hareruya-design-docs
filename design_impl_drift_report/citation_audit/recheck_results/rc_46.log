正本画像の確認で重要な反証が出ました。イベント検索結果画像には実際に「検索結果 14件が該当しました」と「開催店舗」があり、row 816 の「具体文言は正本にない」は誤りです。一方、特集タグCSV画像は結果画面ではなく、入力欄＋単一の「特集タグ編集CSVダウンロード」ボタンを示しています。
exec
/bin/bash -lc "python3 - <<'PY'
import html,re
from pathlib import Path
root=Path('/home/y-saito/Developments/hareruya-design-docs/excel_to_html/output')
terms=[
 'format_sales_report_', 'format_sales/export', 'format-sales/export', 'YmdHis', 'BOM', 'セッション', '送信値',
 'used_card', 'used-card', 'export/{mode}', 'admin_used_card', 'CSRF', 'なりすまし', '検索結果', '条件を保持', '出力条件',
 '検索結果 N件が該当しました', '検索条件に該当するデータがありませんでした', '開催店舗', '開催日(From)>開催日(To)',
 '範囲整合', 'admin.error.sort', 'admin.event.sort', 'admin.event.search'
]
records=[]
for p in root.glob('*.html'):
 s=p.read_text(errors='replace')
 s=re.sub(r'<"'!-- function-design-embed:start.*?<!-- function-design-embed:end.*?-->'"', '', s, flags=re.S)
 for m in re.finditer(r'<span\\b(?=["'^>]*'"\\bsrc-cell\\b)(?=["'^>]*data-excel-ref="([''^"]+)")[''^>]*>(.*?)</span>'"',s,re.S):
  ref=m.group(1); txt=re.sub('<["'^>]+>'"',' ',m.group(2)); txt=' '.join(html.unescape(txt).split())
  records.append((p.name,ref,txt))
 for m in re.finditer(r'<tr\\b(?=["'^>]*data-excel-ref="([''^"]+)")[''^>]*>(.*?)</tr>'"',s,re.S):
  ref=m.group(1); txt=re.sub('<["'^>]+>'"',' ',m.group(2)); txt=' '.join(html.unescape(txt).split())
  records.append((p.name,ref,txt))
for term in terms:
 hits=[]; seen=set()
 for rec in records:
  if term.casefold() in rec[2].casefold() and rec not in seen:
   hits.append(rec); seen.add(rec)
 print(f'\\n## {term} => {len(hits)}')
 for p,ref,txt in hits[:25]: print(p,'|',ref,'|',txt)
