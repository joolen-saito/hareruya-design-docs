    38	use Symfony\Component\HttpFoundation\RedirectResponse;
    39	use Symfony\Component\HttpFoundation\Request;
    40	use Symfony\Component\Routing\Attribute\Route;
    41	
    42	class EventController extends AbstractController
    43	{
    44	    private const SESSION_SEARCH_KEY = 'eccube.admin.event.search';
    45	
    46	    private const SESSION_PAGE_NO_KEY = 'eccube.admin.event.search.page_no';
    47	
    48	    private const SESSION_PAGE_COUNT_KEY = 'eccube.admin.event.search.page_count';
    49	
    50	    public function __construct(
    51	        protected EccubeConfig $eccubeConfig,
    52	        private readonly DtbEventRepository $eventRepository,
    53	        private readonly DtbEventEntryRepository $eventEntryRepository,
    54	        private readonly PageMaxRepository $pageMaxRepository,
    55	        private readonly EventCreateAction $eventCreateAction,
    56	        private readonly EventEditAction $eventEditAction,
    57	    ) {
    58	    }
    59	
    60	    /**
    61	     * @return array<string, mixed>
    62	     */
    63	    #[Route(path: '/%eccube_admin_route%/event', name: 'admin_event_index', methods: ['GET', 'POST'])]
    64	    #[Route(path: '/%eccube_admin_route%/event/page/{page_no}', name: 'admin_event_index_page', methods: ['GET', 'POST'])]
    65	    #[Template(template: '@admin/Event/index.twig')]
    66	    public function index(Request $request, PaginatorInterface $paginator, ?int $page_no = null): array
    67	    {
    68	        $hasExplicitPageParam = $page_no !== null;
    69	        $pageNo = $page_no ?? 1;
    70	        $Member = $this->getMember();
    71	        $DefaultBaseInfo = $Member->getDefaultSearchBaseInfo();
    72	        $builder = $this->formFactory
    73	            ->createBuilder(SearchEventType::class, null, [
    74	                'base_info_default' => $DefaultBaseInfo ? [$DefaultBaseInfo] : [],
    75	            ]);
    76	
    77	        $event = new EventArgs(
    78	            [
    79	                'builder' => $builder,
    80	            ],
    81	            $request
    82	        );
    83	        $this->eventDispatcher->dispatch($event, EccubeEvents::ADMIN_EVENT_INDEX_INITIALIZE);
    84	
    85	        $searchForm = $builder->getForm();
    86	
    87	        $pageCount = $this->session->get(
    88	            self::SESSION_PAGE_COUNT_KEY,
    89	            $this->eccubeConfig->get('eccube_default_page_count')
    90	        );
    91	        $pageCountParam = (int) $request->get('page_count');
    92	        $PageMaxis = $this->pageMaxRepository->findAll();
    93	
    94	        if ($pageCountParam) {
    95	            foreach ($PageMaxis as $PageMax) {
    96	                if ((string) $pageCountParam === $PageMax->getName()) {
    97	                    $pageCount = $PageMax->getName();
    98	                    $this->session->set(self::SESSION_PAGE_COUNT_KEY, $pageCount);
    99	                    break;
   100	                }
   101	            }
   102	        }
   103	
   104	        $pagination = null;
   105	
   106	        if ($request->getMethod() === 'POST') {
   107	            $searchForm->handleRequest($request);
   108	
   109	            if ($searchForm->isValid()) {
   110	                $pageNo = 1;
   111	                $searchData = $searchForm->getData();
   112	
   113	                $this->session->set(self::SESSION_SEARCH_KEY, FormUtil::getViewData($searchForm));
   114	                $this->session->set(self::SESSION_PAGE_NO_KEY, $pageNo);
   115	
   116	                $eventsQueryBuilder = $this->eventRepository->getQueryBuilderBySearchData(
   117	                    $searchData
   118	                );
   119	
   120	                $event = new EventArgs(
   121	                    [
   122	                        'qb' => $eventsQueryBuilder,
   123	                        'searchData' => $searchData,
   124	                    ],
   125	                    $request
   126	                );
   127	
   128	                $this->eventDispatcher->dispatch($event, EccubeEvents::ADMIN_EVENT_INDEX_SEARCH);
   129	
   130	                $pagination = $paginator->paginate(
   131	                    $eventsQueryBuilder,
   132	                    $pageNo,
   133	                    (int) $pageCount
   134	                );
   135	                $pageNo = $this->resolvePageNoAfterSearch($pageNo, $pagination->getTotalItemCount(), (int) $pageCount);
   136	                if ($pageNo !== $pagination->getCurrentPageNumber()) {
   137	                    $this->session->set(self::SESSION_PAGE_NO_KEY, $pageNo);
   138	                    $pagination = $paginator->paginate(
   139	                        $eventsQueryBuilder,
   140	                        $pageNo,
   141	                        (int) $pageCount
   142	                    );
   143	                }
   144	            } else {
   145	                return [
   146	                    'searchForm' => $searchForm->createView(),
   147	                    'pagination' => [],
   148	                    'PageMaxis' => $PageMaxis,
   149	                    'page_no' => $pageNo,
   150	                    'page_count' => $pageCount,
   151	                    'has_errors' => true,
   152	                ];
   153	            }
   154	        } else {
   155	            if ($hasExplicitPageParam || $request->get('resume') !== null) {
   156	                if ($hasExplicitPageParam) {
   157	                    $this->session->set(self::SESSION_PAGE_NO_KEY, $pageNo);
   158	                } else {
   159	                    $pageNo = (int) $this->session->get(self::SESSION_PAGE_NO_KEY, 1);
   160	                }
   161	                $viewData = $this->session->get(self::SESSION_SEARCH_KEY, []);
   162	                $searchData = FormUtil::submitAndGetData($searchForm, $viewData);
   163	
   164	                $eventsQueryBuilder = $this->eventRepository->getQueryBuilderBySearchData(
   165	                    $searchData
   166	                );
   167	
   168	                $event = new EventArgs(
   169	                    [
   170	                        'qb' => $eventsQueryBuilder,
   171	                        'searchData' => $searchData,
   172	                    ],
   173	                    $request
   174	                );
   175	
   176	                $this->eventDispatcher->dispatch($event, EccubeEvents::ADMIN_EVENT_INDEX_SEARCH);
   177	
   178	                $pagination = $paginator->paginate(
   179	                    $eventsQueryBuilder,
   180	                    $pageNo,
   181	                    (int) $pageCount
   182	                );
   183	                $pageNo = $this->resolvePageNoAfterSearch($pageNo, $pagination->getTotalItemCount(), (int) $pageCount);
   184	                if ($pageNo !== $pagination->getCurrentPageNumber()) {
   185	                    $this->session->set(self::SESSION_PAGE_NO_KEY, $pageNo);
   186	                    $pagination = $paginator->paginate(
   187	                        $eventsQueryBuilder,
   188	                        $pageNo,
   189	                        (int) $pageCount
   190	                    );
   191	                }
   192	            } else {
   193	                $pageNo = 1;
   194	                $viewData = FormUtil::getViewData($searchForm);
   195	
   196	                $this->session->set(self::SESSION_SEARCH_KEY, $viewData);
   197	                $this->session->set(self::SESSION_PAGE_NO_KEY, $pageNo);
   198	            }
   199	        }
   200	
   201	        return [
   202	            'searchForm' => $searchForm->createView(),
   203	            'PageMaxis' => $PageMaxis,
   204	            'pagination' => $pagination,
   205	            'page_count' => $pageCount,
   206	        ];
   207	    }
