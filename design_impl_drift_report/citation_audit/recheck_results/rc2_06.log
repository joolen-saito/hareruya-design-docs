        '出荷日' => '出荷日',
        '配送先_お名前(姓)' => '配送先_お名前(姓)',
        '配送先_お名前(名)' => '配送先_お名前(名)',
        '配送先_お名前(セイ)' => '配送先_お名前(セイ)',
        '配送先_お名前(メイ)' => '配送先_お名前(メイ)',
