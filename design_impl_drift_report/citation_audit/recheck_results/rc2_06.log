        // 永続化結果に依存しないためトランザクション外で算出する。
        $clonedItemCount = array_sum(array_map(
            static fn (Order $o): int => $o->getOrderItems()->count(),
            $matchedOrders,
        ));

        $this->entityManager->wrapInTransaction(function () use ($newOrder, $matchedOrders, $passed): void {
            $this->entityManager->persist($newOrder);
            foreach ($newOrder->getOrderItems() as $item) {
