namespace Eccube\Controller\Admin\Stock;

use Eccube\Controller\AbstractController;
use Eccube\Entity\BaseInfo;
use Eccube\Event\EccubeEvents;
use Eccube\Event\EventArgs;
use Eccube\Form\Type\Admin\BarcodeReplacementListType;
use Eccube\Service\Csv\Exporter\BarcodeReplacementListCsvExportService;
use Symfony\Bridge\Twig\Attribute\Template;
use Symfony\Component\HttpFoundation\RedirectResponse;
use Symfony\Component\HttpFoundation\Request;
use Symfony\Component\HttpFoundation\StreamedResponse;
use Symfony\Component\Routing\Attribute\Route;

class BarcodeReplacementListController extends AbstractController
{
    public function __construct(
        private readonly BarcodeReplacementListCsvExportService $barcodeReplacementListCsvExportService,
    ) {
    }

    /**
     * バーコード貼替リスト画面
     *
     * @return array<string, mixed>
     */
    #[Route(
        path: '/%eccube_admin_route%/product/stock/barcode_replacement_list',
        name: 'admin_stock_barcode_replacement_list',
        methods: ['GET'],
    )]
    #[Template(template: '@admin/Stock/barcode_replacement_list.twig')]
    public function index(Request $request): array
    {
        $builder = $this->formFactory->createBuilder(BarcodeReplacementListType::class);

        $event = new EventArgs(
            [
                'builder' => $builder,
            ],
            $request
        );
        $this->eventDispatcher->dispatch($event, EccubeEvents::ADMIN_STOCK_BARCODE_REPLACEMENT_LIST_INDEX_INITIALIZE);

        $form = $builder->getForm()->createView();

        return [
            'form' => $form,
        ];
    }

    /**
     * バーコード貼替リストCSV出力
     */
    #[Route(
        path: '/%eccube_admin_route%/product/stock/barcode_replacement_list/csv_export',
        name: 'admin_stock_barcode_replacement_list_csv_export',
        methods: ['POST'],
    )]
    public function csvExport(Request $request): StreamedResponse|RedirectResponse
    {
        $this->isTokenValid();

        $form = $this->createForm(BarcodeReplacementListType::class);
        $form->handleRequest($request);

        if (!$form->isSubmitted() || !$form->isValid()) {
            foreach ($form->getErrors(true) as $error) {
                $this->addError($error->getMessage(), 'admin');
            }

            return $this->redirectToRoute('admin_stock_barcode_replacement_list');
        }

        /** @var BaseInfo $baseInfo */
        $baseInfo = $form->get('base_info')->getData();

        /** @var \DateTimeInterface $periodFrom */
        $periodFrom = $form->get('price_change_period_from')->getData();
        /** @var \DateTimeInterface $periodTo */
        $periodTo = $form->get('price_change_period_to')->getData();

        $priceChangePeriodFrom = \DateTimeImmutable::createFromInterface($periodFrom)->setTime(0, 0, 0);
        $priceChangePeriodTo = \DateTimeImmutable::createFromInterface($periodTo)->setTime(23, 59, 59);

        $event = new EventArgs(
            [
                'form' => $form,
                'BaseInfo' => $baseInfo,
            ],
            $request
        );
        $this->eventDispatcher->dispatch($event, EccubeEvents::ADMIN_STOCK_BARCODE_REPLACEMENT_LIST_CSV_EXPORT);

        return $this->barcodeReplacementListCsvExportService->export(
            $baseInfo,
            $priceChangePeriodFrom,
            $priceChangePeriodTo,
        );
    }
}

