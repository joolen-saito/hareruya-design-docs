    /**
     * 一括用手動メール送信
     *
     * @param array{mail: array{subject: string}} $content
     *
     * @return bool 送信成功時 true。SMTP 障害等で送信できなかった場合は false
     */
    public function sendManualMailForBulk(Order $order, MailTemplate $template, string $body, array $content): bool
    {
        $message = (new Email())
            ->subject($content['mail']['subject'])
            ->from(new Address($this->BaseInfo->getEmail01(), $this->BaseInfo->getShopName()))
            ->to(new Address($order->getEmail()))
            ->bcc(new Address($this->BaseInfo->getEmail01()))
            ->replyTo(new Address($this->BaseInfo->getEmail03()))
            ->returnPath(new Address($this->BaseInfo->getEmail04()))
            ->text($body);

        MailUtil::convertMessage($this->eccubeConfig, $message);
        MailUtil::setParameterForCharset($this->eccubeConfig, $message);

        try {
            $this->mailer->send($message);
        } catch (TransportExceptionInterface $e) {
            log_critical($e->getMessage(), [
                'order_id' => $order->getId(),
                'mail_template_id' => $template->getId(),
            ]);

            return false;
        }

        $this->saveUserMailHistory($message, $template, $order);

        return true;
    }

    /**
     * Save user mail history
     */

