namespace Eccube\Service\Csv\Importer\Event;

use Doctrine\ORM\EntityManagerInterface;
use Eccube\Common\EccubeConfig;
use Eccube\Entity\DtbStockMoveInstruction;
use Eccube\Entity\Master\MtbStockMoveTransferStatus;
use Eccube\Entity\Member;
use Eccube\Repository\DtbStockMoveInstructionRepository;
use Eccube\Repository\DtbStockMoveTransferRepository;
use Eccube\Service\Csv\Importer\Converter\IntConverter;
use Eccube\Service\Csv\Importer\Model\BaseCsvColumn;
use Eccube\Service\Csv\Importer\Model\CsvColumnInterface;
use Eccube\Service\Csv\Importer\Validator\NumericValidator;
use Eccube\Service\Csv\Importer\Validator\RequiredValidator;
use Eccube\Service\Csv\Importer\Validator\RowValidatorInterface;
use Symfony\Contracts\Translation\TranslatorInterface;

/**
 * 在庫移動実績CSV（送り状No.一括登録）をインポートするもの。
 */
class StockMoveInstructionCsvImportHandler extends BaseCsvImportHandler
{
    private const COL_INSTRUCTION_ID = '移動指示ID';
    private const COL_MOVE_FROM_SHOP = '出庫元店舗(名称)';
    private const COL_MOVE_TO_SHOP = '入庫先店舗(名称)';
    private const COL_TRACKING_NO = '送り状No.';

    private ?CsvColumnInterface $instructionIdColumn = null;
    private ?CsvColumnInterface $moveFromShopColumn = null;
    private ?CsvColumnInterface $moveToShopColumn = null;
    private ?CsvColumnInterface $trackingNoColumn = null;

    public function __construct(
        private readonly EntityManagerInterface $entityManager,
        private readonly DtbStockMoveInstructionRepository $stockMoveInstructionRepository,
        private readonly DtbStockMoveTransferRepository $stockMoveTransferRepository,
        private readonly TranslatorInterface $translator,
        private readonly EccubeConfig $eccubeConfig,
    ) {
    }

    public function onBeforeImport(): void
    {
        parent::onBeforeImport();

        $this->initializeColumnDefinitions();
    }

    public function onAfterImport(AfterReadEvent $event): void
    {
        parent::onAfterImport($event);

        $this->clearColumnDefinitions();
    }

    /**
     * 行ごとにバリデーションし、エラー時はその行をスキップして処理を継続する。
     * 全行の個別エラーを収集するため、breakAll() ではなく skipRow() を使用する。
     */
    public function onValidateRow(ReadCsvRowEvent $event): void
    {
        $columns = $this->getColumns();
        $row = $event->getRow();
        $messageStore = $event->getMessageStore();

        if (count($row) !== count($columns)) {
            $messageStore->addInvalidColumnCountError($row->getRowNumber());
            $event->skipRow();

            return;
        }

        foreach ($columns as $column) {
            $name = $column->getName();
            if (!$row->exists($name)) {
                $messageStore->addColumnNotExistsError($row->getRowNumber(), $name);
                $event->skipRow();

                return;
            }
            if (!$column->validate($messageStore, $row)) {
                $event->skipRow();

                return;
            }
        }

        $rowValidators = $this->getRowValidators();
        foreach ($rowValidators as $rowValidator) {
            if (!$rowValidator->validate($messageStore, $row)) {
                $event->skipRow();

                return;
            }
        }
    }

    /**
     * CSVデータ1行を取り込む。
     */
    public function onReadRow(ReadCsvRowEvent $event): bool
    {
        $row = $event->getRow();
        $messageStore = $event->getMessageStore();
        $rowNumber = $row->getRowNumber();

        $instructionIdValue = $this->instructionIdColumn->getValue($row);
        $instructionId = is_numeric($instructionIdValue) ? (int) $instructionIdValue : 0;
        if ($instructionId <= 0) {
            $messageStore->addRawMessage(
                $rowNumber.'行目: '.$this->translator->trans('admin.stock.move_instruction.csv_tracking_error_instruction_not_found', [], 'messages')
            );

            return false;
        }

        $Instruction = $this->stockMoveInstructionRepository->find($instructionId);
        if ($Instruction === null) {
            $messageStore->addRawMessage(
                $rowNumber.'行目: '.$this->translator->trans('admin.stock.move_instruction.csv_tracking_error_instruction_not_found', [], 'messages')
            );

            return false;
        }

        $moveFromShop = $this->trimOrNull((string) $this->moveFromShopColumn->getValue($row));
        $moveToShop = $this->trimOrNull((string) $this->moveToShopColumn->getValue($row));
        $fromShop = $Instruction->getMoveFromBaseInfo()->getShopName();
        $toShop = $Instruction->getMoveToBaseInfo()->getShopName();

        if ($moveFromShop !== null && $moveFromShop !== '' && (string) $fromShop !== $moveFromShop) {
            $messageStore->addRawMessage(
                $rowNumber.'行目: '.$this->translator->trans('admin.stock.move_instruction.csv_tracking_error_shop_mismatch_from', [], 'messages')
            );

            return false;
        }
        if ($moveToShop !== null && $moveToShop !== '' && (string) $toShop !== $moveToShop) {
            $messageStore->addRawMessage(
                $rowNumber.'行目: '.$this->translator->trans('admin.stock.move_instruction.csv_tracking_error_shop_mismatch_to', [], 'messages')
            );

            return false;
        }

        $trackingNoRaw = (string) $this->trackingNoColumn->getValue($row);
        $trackingNoTrimmed = $this->trimOrNull($trackingNoRaw);
        if ($trackingNoTrimmed === null || $trackingNoTrimmed === '') {
            $messageStore->addRawMessage(
                $rowNumber.'行目: '.$this->translator->trans('admin.stock.move_instruction.csv_tracking_error_tracking_no_empty', [], 'messages')
            );

            return false;
        }

        $maxLen = (int) $this->eccubeConfig['eccube_text_type_column_max_len'];
        if (mb_strlen($trackingNoTrimmed) > $maxLen) {
            $messageStore->addRawMessage(
                $rowNumber.'行目: '.$this->translator->trans('admin.stock.move_instruction.tracking_no_max_length', [
                    '%max%' => $maxLen,
                ], 'messages')
            );

            return false;
        }

        $this->persistTrackingNo($Instruction, $trackingNoTrimmed, $event->getUpdateUser());

        return true;
    }

    /**
     * 列の定義を取得する。
     *
     * @return array<CsvColumnInterface>
     */
    protected function getColumns(): array
    {
        return [
            $this->instructionIdColumn,
            $this->moveFromShopColumn,
            $this->moveToShopColumn,
            $this->trackingNoColumn,
        ];
    }

    /**
     * 列を検証するロジックを取得する。
     *
     * @return array<RowValidatorInterface>
     */
    protected function getRowValidators(): array
    {
        return [];
    }

    private function initializeColumnDefinitions(): void
    {
        $this->instructionIdColumn = (new BaseCsvColumn(self::COL_INSTRUCTION_ID, self::COL_INSTRUCTION_ID))
            ->setRequired(true)
            ->setConverter(new IntConverter())
            ->addValidator(new NumericValidator());
        $this->moveFromShopColumn = new BaseCsvColumn(self::COL_MOVE_FROM_SHOP, self::COL_MOVE_FROM_SHOP);
        $this->moveToShopColumn = new BaseCsvColumn(self::COL_MOVE_TO_SHOP, self::COL_MOVE_TO_SHOP);
        $this->trackingNoColumn = (new BaseCsvColumn(self::COL_TRACKING_NO, self::COL_TRACKING_NO))
            ->setRequired(true)
            ->addValidator(new RequiredValidator());
    }

    private function clearColumnDefinitions(): void
    {
        $this->instructionIdColumn = null;
        $this->moveFromShopColumn = null;
        $this->moveToShopColumn = null;
        $this->trackingNoColumn = null;
    }

    private function trimOrNull(string $value): ?string
    {
        $s = trim($value);

        return $s === '' ? null : $s;
    }

    private function persistTrackingNo(DtbStockMoveInstruction $Instruction, string $trackingNo, Member $UpdateMember): void
    {
        $Instruction->setTrackingNo($trackingNo);
        $Instruction->setUpdateDate(new \DateTime());
        $Instruction->setUpdateMember($UpdateMember);

        $Transfers = $this->stockMoveTransferRepository->findBy(
            ['moveInstructionId' => $Instruction->getId()],
            ['id' => 'ASC']
        );
        $MovingStatus = $this->entityManager->find(
            MtbStockMoveTransferStatus::class,
            MtbStockMoveTransferStatus::STATUS_MOVING
        );
        foreach ($Transfers as $Transfer) {
            $Transfer->setTrackingNo($trackingNo);
            if ($MovingStatus !== null) {
                $Transfer->setMoveTransferStatus($MovingStatus);
            }
        }
    }
}

    private TranslatorInterface $translator;

    public function __construct(
        EntityManagerInterface $em,
        TranslatorInterface $translator,
        EccubeConfig $eccubeConfig,
        CsvImportHandlerInterface $handler,
        Member $loginUser,
    ) {
        parent::__construct($em, $translator, $eccubeConfig, $handler, $loginUser);
        $this->eccubeConfig = $eccubeConfig;
        $this->translator = $translator;
    }

    /**
     * 在庫移動実績CSV用のバリデーション。ヘッダーのみでデータ行が0件でもエラーにしない。
     *
     * @param CsvImportService $importService CSVファイル
     *
     * @return array<int, array{message: string}> エラーメッセージ。エラーがない場合は空。
     */
    protected function validateBeforeImport(CsvImportService $importService): array
    {
        $messageStore = new MessageStore($this->translator);

        if (!$importService->setHeaderRowNumber(0)) {
            $messageStore->addHeaderFormatError();

            return $messageStore->getMessages();
        }

        return [];
    }

    /**
     * 在庫移動実績CSV用の CsvImportService（BOM除去・列数パディング対応）を返す。
     */
    protected function createCsvImportService(UploadedFile $file, string $tempFileName): CsvImportService
    {
        $file->move($this->eccubeConfig['eccube_csv_temp_realdir'], $tempFileName);

        $filePath = $this->eccubeConfig['eccube_csv_temp_realdir'].'/'.$tempFileName;
        $splFile = new \SplFileObject($filePath);

        $fileExtension = $file->getClientOriginalExtension();
        $delimiter = ($fileExtension === 'tsv') ? "\t" : $this->eccubeConfig['eccube_csv_import_delimiter'];

        return new StockMoveInstructionCsvImportService(
            $splFile,
            $delimiter,
            $this->eccubeConfig['eccube_csv_import_enclosure']
        );
    }
}
