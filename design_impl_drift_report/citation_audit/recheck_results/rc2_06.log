namespace Eccube\Repository;

use Doctrine\ORM\QueryBuilder;
use Doctrine\Persistence\ManagerRegistry;
use Eccube\Entity\DtbStockMoveInstruction;

/**
 * @extends AbstractRepository<DtbStockMoveInstruction>
 */
class DtbStockMoveInstructionRepository extends AbstractRepository
{
    public function __construct(ManagerRegistry $registry)
    {
        parent::__construct($registry, DtbStockMoveInstruction::class);
    }

    /**
     * 検索条件でQueryBuilderを取得
     *
     * @param array<string, mixed> $searchData 検索条件
     */
    public function getQueryBuilderBySearchData(array $searchData): QueryBuilder
    {
        $qb = $this->createQueryBuilder('s')
            ->select('s')
            ->leftJoin('s.MoveFromBaseInfo', 'mfrom')
            ->leftJoin('s.MoveToBaseInfo', 'mto')
            ->leftJoin('s.RegisteredMember', 'reg_member')
            ->addSelect('mfrom', 'mto', 'reg_member')
            ->orderBy('s.createDate', 'DESC');

        if (!empty($searchData['move_from_base_info'])) {
            $qb
                ->andWhere('s.MoveFromBaseInfo = :move_from_base_info')
                ->setParameter('move_from_base_info', $searchData['move_from_base_info']);
        }

        if (!empty($searchData['move_to_base_info'])) {
            $qb
                ->andWhere('s.MoveToBaseInfo = :move_to_base_info')
                ->setParameter('move_to_base_info', $searchData['move_to_base_info']);
        }

        $instructionId = isset($searchData['instruction_id']) ? trim((string) $searchData['instruction_id']) : '';
        if ($instructionId !== '') {
            $qb
                ->andWhere('CONCAT(s.id, \'\') LIKE :instruction_id')
                ->setParameter('instruction_id', '%'.addcslashes($instructionId, '%_').'%');
        }

        $stockMoveTransferId = isset($searchData['stock_move_transfer_id']) ? trim((string) $searchData['stock_move_transfer_id']) : '';
        if ($stockMoveTransferId !== '') {
            $qb->leftJoin(
                'Eccube\Entity\DtbStockMoveTransfer',
                't',
                'WITH',
                't.moveInstructionId = s.id'
            )
                ->andWhere('CONCAT(t.id, \'\') = :stock_move_transfer_id')
                ->setParameter('stock_move_transfer_id', $stockMoveTransferId)
                ->distinct();
        }

        if (!empty($searchData['create_date_start'])) {
            $qb
                ->andWhere('s.createDate >= :create_date_start')
                ->setParameter('create_date_start', $searchData['create_date_start']);
        }

        if (!empty($searchData['create_date_end'])) {
            $date = clone $searchData['create_date_end'];
            $date->modify('+1 days');
            $qb
                ->andWhere('s.createDate < :create_date_end')
                ->setParameter('create_date_end', $date);
        }

        if (!empty($searchData['update_date_start'])) {
            $qb
                ->andWhere('s.updateDate >= :update_date_start')
                ->setParameter('update_date_start', $searchData['update_date_start']);
        }

        if (!empty($searchData['update_date_end'])) {
            $date = clone $searchData['update_date_end'];
            $date->modify('+1 days');
            $qb
                ->andWhere('s.updateDate < :update_date_end')
                ->setParameter('update_date_end', $date);
        }

        // 発送状況: 送り状Noの有無で「済」「未」を判定（チェックしたものだけ絞り込み）
        $done = !empty($searchData['shipment_status_done']);
        $notDone = !empty($searchData['shipment_status_not_done']);
        if ($done && !$notDone) {
            $qb->andWhere('s.trackingNo IS NOT NULL AND s.trackingNo != :empty_str')
                ->setParameter('empty_str', '');
        }
        if ($notDone && !$done) {
            $qb->andWhere('s.trackingNo IS NULL OR s.trackingNo = :empty_str_not_done')
                ->setParameter('empty_str_not_done', '');
        }

        return $qb;
    }

    /**
     * 在庫移動指示IDごとの移動原価合計（DtbStockMoveTransferDetail の集計値）.
     *
     * DtbStockMoveInstruction.outboundTotalCost は作成時点では 0 のため、
     * 表示時は転送明細から実績値を集計して使用する。
     *
     * @param list<int> $instructionIds
     *
     * @return array<int, string> [instructionId => outbound_total_cost]

