namespace Eccube\Form\Type\Admin;

use Eccube\Common\EccubeConfig;
use Eccube\Entity\DtbStockMoveInstruction;
use Symfony\Component\Form\AbstractType;
use Symfony\Component\Form\Extension\Core\Type\TextareaType;
use Symfony\Component\Form\FormBuilderInterface;
use Symfony\Component\OptionsResolver\OptionsResolver;
use Symfony\Component\Validator\Constraints as Assert;

class StockMoveInstructionDetailType extends AbstractType
{
    public function __construct(private readonly EccubeConfig $eccubeConfig)
    {
    }

    /**
     * @param array<string, mixed> $options
     */
    #[\Override]
    public function buildForm(FormBuilderInterface $builder, array $options): void
    {
        $maxTrackingNoLen = (int) $this->eccubeConfig['eccube_text_type_column_max_len'];

        $builder
            ->add('trackingNo', TextareaType::class, [
                'label' => 'admin.stock.move_instruction.tracking_no',
                'required' => false,
                'attr' => [
                    'rows' => 2,
                    'maxlength' => $maxTrackingNoLen,
                ],
                'constraints' => [
                    new Assert\Length(['max' => $maxTrackingNoLen]),
                ],
            ])
            ->add('memo', TextareaType::class, [
                'label' => 'admin.common.note',
                'required' => false,
            ]);
    }

    #[\Override]
    public function configureOptions(OptionsResolver $resolver): void
    {
        $resolver->setDefaults([
            'data_class' => DtbStockMoveInstruction::class,
            'csrf_protection' => true,
            'csrf_field_name' => '_token',
            'csrf_token_id' => 'stock_move_instruction_detail',
        ]);
    }

    #[\Override]
    public function getBlockPrefix(): string
    {
        return 'admin_stock_move_instruction_detail';
    }
}
