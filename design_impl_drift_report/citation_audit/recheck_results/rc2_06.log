{% extends '@admin/default_frame.twig' %}

{% set menus = ['order', 'order_master'] %}

{% block title %}{{ 'admin.order.order_management'|trans }}{% endblock %}
{% block sub_title %}{{ 'admin.order.manual_mail'|trans }}{% endblock %}

{% form_theme form '@admin/Form/bootstrap_4_horizontal_layout.html.twig' %}

{% block stylesheet %}
    {{ parent() }}
    <style>
        body[id^="page_admin_order_manual_mail_all"] .c-pageTitle__titles {
            display: flex;
            align-items: center;
            width: 100%;
        }

        body[id^="page_admin_order_manual_mail_all"] .c-pageTitle__subTitle {
            display: flex;
            flex: 1;
            align-items: center;
        }
    </style>
{% endblock %}

{% set backUrl = path('admin_order_manual_mail_all_edit', {'templateId': id}) %}
{% set idsQuery = '' %}
{% for sid in shippingIds %}
    {% set idsQuery = idsQuery ~ 'ids%5B%5D=' ~ sid ~ (loop.last ? '' : '&') %}
{% endfor %}

{% block javascript %}
    {{ parent() }}
    <script nonce="{{ csp_nonce }}" src="{{ asset('assets/js/manual_mail.js', 'admin') }}"></script>
{% endblock %}

{% block main %}
    <form name="form1" id="form1" method="post" action="{{ path('admin_order_manual_mail_all_edit', {'templateId': id}) }}?{{ idsQuery }}">
        {{ form_widget(form._token) }}
        {# Ladda が submit を disabled にすると button の name=mode が送られないため、hidden で固定する #}
        <input type="hidden" name="mode" value="complete">
        <input type="hidden" name="mail[template]" value="{{ mail.id }}">
        <input type="hidden" name="mail[subject]" value="{{ previewSubject }}">
        <div class="d-none" aria-hidden="true">
            {{ form_widget(form.header) }}
            {{ form_widget(form.footer) }}
        </div>

        <div class="c-contentsArea__cols">
            <div class="c-contentsArea__primaryCol">
                <div class="c-primaryCol">
                    <div class="card rounded border-0 mb-4">
                        <div class="card-header">
                            <div class="row">
                                <div class="col">
                                    <span class="card-title">{{ 'admin.order.manual_mail.box_title'|trans }}</span>
                                </div>
                            </div>
                        </div>
                        <div class="card-body">
                            <div class="col mb-4">
                                <div class="d-inline-block" >
                                <span class="card-title">
                                    <div id="order_info">
                                        {{ 'admin.order.manual_mail_all'|trans }}
                                    </div>
                                </span> 
                                </div>
                            </div>

                            <div class="row mb-3">
                                <label class="col-sm-2 col-form-label">{{ 'admin.order.manual_mail.template'|trans }}</label>
                                <div class="col-sm-10">
                                    {{ mail.name }}
                                </div>
                            </div>
                            <div class="row mb-3">
                                <label class="col-sm-2 col-form-label">{{ 'admin.order.mail_subject'|trans }}</label>
                                <div class="col-sm-10">
                                    {{ previewSubject }}
                                </div>
                            </div>
                            <div class="row mb-3">
                                <label class="col-sm-2 col-form-label">{{ 'admin.order.manual_mail_body'|trans }}</label>
                                <div class="col-sm-10">
                                    <pre class="m-0 p-3">{{ previewBody }}</pre>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="c-contentsArea__secondaryCol">
                <div class="c-secondaryCol">
                    <div class="card rounded border-0 mb-4">
                        <div class="card-body">
                            <div id="common_info_box" class="box">
                                <div id="common_info_box__header" class="box-header">
                                    <h4>{{ 'admin.order.manual_mail_destination_info'|trans }}</h4>
                                </div>
                                <div id="common_info_box__body" class="box-body">
                                    <table class="table table-striped">
                                        <thead>
                                        <tr>
                                            <th>{{ 'admin.order.order_number'|trans }}</th>
                                            <th>{{ 'admin.order.orderer_name'|trans }}</th>
                                        </tr>
                                        </thead>
                                        <tbody>
                                        {% for Order in Orders %}
                                            <tr>
                                                <td>
                                                    {{ attribute(orderNumbers, Order.id) }}
                                                    {% for shipping in Order.Shippings %}
                                                        {% if shipping.id in shippingIds %}
                                                            <input type="hidden" name="ids[]" value="{{ shipping.id }}">
                                                        {% endif %}
                                                    {% endfor %}
                                                </td>
                                                <td>
                                                    {{ Order.customer.name01 }} {{ Order.customer.name02 }}
                                                </td>
                                            </tr>
                                        {% endfor %}
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="c-conversionArea">
            <div class="c-conversionArea__container">
                <div class="row justify-content-between align-items-center">
                    <div class="col-6">
                        <div class="c-conversionArea__leftBlockItem">
                            <a class="c-baseLink"
                               href="{{ backUrl }}?{{ idsQuery }}">
