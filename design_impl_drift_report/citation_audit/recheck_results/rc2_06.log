    private function getOrderContentText(): array
    {
        return [
            'ja' => $this->twig->getLoader()->getSourceContext('Mail/order_content.twig')->getCode(),
            'en' => $this->twig->getLoader()->getSourceContext('Mail/order_content.en.twig')->getCode(),
