    public function getQueryBuilderBySearchDataForAdmin(array $searchData): QueryBuilder
    {
        $qb = $this->createQueryBuilder('o')
            ->select('o, s')
            ->addSelect('oi', 'pref')
            ->leftJoin('o.OrderItems', 'oi')
            ->leftJoin('o.Pref', 'pref')
            ->innerJoin('o.Shippings', 's')
            ->innerJoin('s.Country', 'sc')
            ->innerJoin('s.Pref', 'sp')
            // 非会員(ゲスト)受注は Customer を持たないため leftJoin とする。
            // スマレジの純店頭購入(非会員)受注を管理受注検索から欠落させないための対応。
            // CustomerDeleteFilter の `c.del_flg = 0` は leftJoin の ON 句に付与されるため、
            // ゲスト受注(c が null)は除外されない。customer_group 検索は `c.Player` を別途 join するため
            // その条件指定時のみ会員受注に絞られる(ゲストが除外されるのは意図どおり)。
            ->leftJoin('o.Customer', 'c');

        // tenants
        if (!empty($searchData['tenants'])) {
            $tenants = $this->findAllOpenTenantsForSearch($searchData['tenants']);
            if ($tenants === []) {
                $qb->andWhere('1 = 0');
            } else {
                $qb
                    ->andWhere($qb->expr()->in('s.baseInfo', ':BaseInfo'))
                    ->setParameter('BaseInfo', $tenants);
            }
        }

        // order_number
        if (isset($searchData['order_number']) && StringUtil::isNotBlank($searchData['order_number'])) {
            $qb
                ->andWhere('o.order_number LIKE :order_number')
                ->setParameter('order_number', '%'.$searchData['order_number'].'%');
        }

        // name_multi
        if (isset($searchData['name_multi']) && StringUtil::isNotBlank($searchData['name_multi'])) {
            // 半角スペース、全角スペース、カンマで分割
            $texts = preg_split('/[\s, ]+/u', $searchData['name_multi']);
            $searchColumns = [
                'o' => ['name01', 'name02', 'kana01', 'kana02'],
            ];
            SqlUtil::multiTextQuery($qb, $texts, $searchColumns);
        }

        // multi
        if (isset($searchData['multi']) && StringUtil::isNotBlank($searchData['multi'])) {
            // 半角スペース、全角スペース、カンマで分割
            $texts = preg_split('/[\s, ]+/u', $searchData['multi']);
            $searchColumns = [
                'o' => ['company_name', 'message', 'note'],
                'oi' => ['product_code'],
            ];
            SqlUtil::multiTextQuery($qb, $texts, $searchColumns);
        }

        // status
        $filterStatus = false;
        if (isset($searchData['status']) && count($searchData['status']) > 0) {
            $qb
                ->andWhere($qb->expr()->in('o.OrderStatus', ':status'))
                ->setParameter('status', $searchData['status']);
            $filterStatus = true;
        }

        if (!$filterStatus) {
            // 未選択時のデフォルト検索: 購入処理中・キャンセル・引き渡し済み・対応中・返品以外を対象とする.
            // ※ 決済処理中(PENDING)・購入処理中(PROCESSING)は OrderStatusFilter により常時除外される.
            // ※ ステータス明示指定時は IN 条件を優先する（CANCEL は UI から選択可。
            //    IN_PROGRESS / PASSED / RETURNED は検索フォームから除外済み）.
            $qb->andWhere($qb->expr()->notIn('o.OrderStatus', ':status'))
        // shipping_tel
        if (!empty($searchData['shipping_tel'])) {
            $qb
                ->andWhere('CONCAT(COALESCE(s.tel01, \'\'), COALESCE(s.tel02, \'\'), COALESCE(s.tel03, \'\')) LIKE :shipping_tel')
                ->setParameter('shipping_tel', '%'.$searchData['shipping_tel'].'%');
        }

        // shipping_country
        if (!empty($searchData['shipping_country'])) {
            $qb
                ->andWhere('sc = :shipping_country')
                ->setParameter('shipping_country', $searchData['shipping_country']);
        }

        // shipping_pref
        if (!empty($searchData['shipping_pref'])) {
            $qb
                ->andWhere('sp = :shipping_pref')
                ->setParameter('shipping_pref', $searchData['shipping_pref']);
        }

        // waiting_number
        if (!empty($searchData['waiting_number'])) {
            $qb
                ->andWhere('o.waitingNumber = :waiting_number')
                ->setParameter('waiting_number', $searchData['waiting_number']);
        }

        // smaregi_transaction_id (完全一致)
        if (!empty($searchData['smaregi_transaction_id'])) {
            $qb
                ->andWhere('o.smaregiTransactionId = :smaregi_transaction_id')
                ->setParameter('smaregi_transaction_id', $searchData['smaregi_transaction_id']);
        }

        // 店頭受取→スマレジ取引で統合された旧受注（next_order_id が設定されている行）は除外し、
        // スマレジ取り込み側の受注を優先表示する（購入履歴 getShoppingHistoryQueryBuilderByCustomer と同趣旨）。
        $qb->andWhere('o.nextOrderId IS NULL');

        // Order By
        if (isset($searchData['sortkey']) && !empty($searchData['sortkey'])) {
            $sortOrder = (isset($searchData['sorttype']) && $searchData['sorttype'] == 'a') ? 'ASC' : 'DESC';

            $qb->orderBy(self::COLUMNS[$searchData['sortkey']], $sortOrder);
            $qb->addOrderBy('o.update_date', 'DESC');
            $qb->addOrderBy('o.id', 'DESC');
        } else {
            $qb->orderBy('o.update_date', 'DESC');
            $qb->addorderBy('o.id', 'DESC');
        }

            ->addSelect('CASE WHEN oi.price < :price1 THEN 1 ELSE 0 END AS HIDDEN class1')
            ->addSelect('CASE WHEN oi.price < :price2 THEN 1 ELSE 0 END AS HIDDEN class2')
            ->setParameter('price1', $thresholdPrice1)
            ->setParameter('price2', $thresholdPrice2)
            ->groupBy('o, op, oc, s, sp, sc, d, oi, p, pc, stc, cd, lng, sn, r, c, cs, psc');

        $this->sortProduct($qb2);

        $items = $qb2->getQuery()->getArrayResult();

        /** @var BaseInfoRepository $baseInfoRepository */
        $baseInfoRepository = $this->getEntityManager()->getRepository(BaseInfo::class);
        $qualifiedInvoiceIssuerCode = $baseInfoRepository->get()->getInvoiceRegistrationNumber();

        $result = [];
        foreach (array_keys($items) as $key) {
            $summary[$key]['hareruyaQualifiedInvoiceIssuerCode'] = $qualifiedInvoiceIssuerCode;
            $result[$key] = array_merge($summary[$key], $items[$key]);
            if (isset($result[$key]['OrderItems'])) {
                $result[$key]['OrderDetails'] = $result[$key]['OrderItems'];
            }
        }

        return $result;
    }

    /**
     * 引数の受注 ID のうち、他受注の next_order_id（移行先 ID）として参照されている ID を返す。
     *
     * 購入履歴区分 ①（スマレジ取引）と ②(A)（統合受注）を区別するために使う。
     *
     * @param list<int> $orderIds
     *
     * @return list<int>
     */
    public function findOrderIdsReferencedAsNextOrder(array $orderIds): array
    {
        if ($orderIds === []) {
            return [];
        }

        /** @var list<int|string|null> $referencedOrderIds */
        $referencedOrderIds = $this->createQueryBuilder('o')
            ->select('DISTINCT o.nextOrderId')
            ->where('o.nextOrderId IN (:orderIds)')
            ->setParameter('orderIds', $orderIds)
            ->getQuery()
            ->getSingleColumnResult();

        return array_values(array_map(
            static fn (int|string|null $orderId): int => (int) $orderId,
            ->andWhere('o.order_date IS NOT NULL')
            ->setParameter('nextOrderIds', $nextOrderIds)
            ->groupBy('o.nextOrderId')
            ->getQuery()
            ->getResult();

        $lookup = [];
        foreach ($rows as $row) {
            $newestOrderDate = $row['newestOrderDate'];
            if ($newestOrderDate instanceof \DateTime) {
                $lookup[(int) $row['nextOrderId']] = $newestOrderDate;

                continue;
            }
            if ($newestOrderDate instanceof \DateTimeInterface) {
                $lookup[(int) $row['nextOrderId']] = \DateTime::createFromInterface($newestOrderDate);

                continue;
            }
            $lookup[(int) $row['nextOrderId']] = new \DateTime((string) $newestOrderDate);
        }

        return $lookup;
    }

    /**
     * next_order_id ごとに、統合グループに含まれる全受注の order_number を id 昇順で返す。
     * 旧受注（next_order_id = 統合受注 ID）と統合受注本体の両方を含める。
     *
     * @param list<int> $nextOrderIds
     *
     * @return array<int, list<string>>
     */
    private function findOtcOrderNumbersByNextOrderIds(array $nextOrderIds): array
    {
        if ($nextOrderIds === []) {
            return [];
        }

        $nextOrderIdLookup = array_flip($nextOrderIds);

