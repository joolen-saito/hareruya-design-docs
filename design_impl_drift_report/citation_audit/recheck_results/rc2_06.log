--- /dev/null
+++ b//tmp/extract_layouts_rc2_06.py
@@ -0,0 +1,33 @@
+import base64
+import re
+from pathlib import Path
+
+sources = {
+    "0202": (
+        Path("/home/y-saito/Developments/hareruya-design-docs/excel_to_html/output/0202_基本設計仕様書(在庫管理機能).html"),
+        (32, 33, 34, 36, 37, 45),
+    ),
+    "0203": (
+        Path("/home/y-saito/Developments/hareruya-design-docs/excel_to_html/output/0203_基本設計仕様書(受注管理機能).html"),
+        (3, 10, 24),
+    ),
+}
+output = Path("/tmp/rc2_06_layouts")
+output.mkdir(parents=True, exist_ok=True)
+
+for book, (source, sheet_ids) in sources.items():
+    html = source.read_text(encoding="utf-8")
+    for sheet_id in sheet_ids:
+        marker = f'<section class="sheet-panel" id="sheet-{sheet_id}">'
+        start = html.index(marker)
+        next_section = html.find('<section class="sheet-panel"', start + len(marker))
+        section = html[start:next_section if next_section >= 0 else None]
+        matches = re.findall(
+            r'<img class="image-layer-img" src="data:image/([a-zA-Z0-9.+-]+);base64,([^"]+)"[^>]*alt="([^"]*)"',
+            section,
+        )
+        for index, (extension, payload, alt) in enumerate(matches, 1):
+            extension = "jpg" if extension == "jpeg" else extension
+            destination = output / f"{book}_sheet_{sheet_id}_{index}.{extension}"
+            destination.write_bytes(base64.b64decode(payload))
+            print(f"{destination}\t{alt}")

