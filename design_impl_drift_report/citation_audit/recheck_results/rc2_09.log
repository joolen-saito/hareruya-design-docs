{% extends 'default_frame.twig' %}

{% set menus = ['data_menu', 'discount_list'] %}

{% block title %}割引率管理{% endblock %}
{% block sub_title %}割引率一覧{% endblock %}

{% block main %}
    <div id="discount_list_box__body" class="box">
        <div id="discount_list_box__body_inner" class="box-body">
            <div id="discount_list_box__list_box" class="table_list">
                <div id="discount_list_box__list" class="table-responsive with-border">
                    <table class="table table-striped">
                        <thead>
                            <tr id="news_list_box__list_header">
                                <th id="discount_list_box__header_name">名称</th>
                                {% for condition in cardConditions %}
                                    <th id="discount_list_box__header_{{ condition.code }}">{{ condition.code }}</th>
                                {% endfor %}
                            </tr>
                        </thead>
                        <tbody>
                        {% for discount in discounts %}
                            <tr id="discount_list_box__item--{{ discount.id }}">
                                <td id="discount_list_box__name--{{ discount.id }}">{{ discount.name }}</td>
                                {% for condition in cardConditions %}
