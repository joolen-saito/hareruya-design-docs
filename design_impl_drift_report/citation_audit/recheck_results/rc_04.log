  1082	                <tr><td><span class="src-cell" data-excel-book="0506" data-excel-sheet="買取アプリ用ログイン" data-excel-ref="0506:買取アプリ用ログイン!B65">memberId</span></td><td><span class="src-cell" data-excel-book="0506" data-excel-sheet="買取アプリ用ログイン" data-excel-ref="0506:買取アプリ用ログイン!J65">文字列</span></td><td><span class="src-cell" data-excel-book="0506" data-excel-sheet="買取アプリ用ログイン" data-excel-ref="0506:買取アプリ用ログイン!R65">ログイン者のID</span></td></tr>
  1083	                <tr><td><span class="src-cell" data-excel-book="0506" data-excel-sheet="買取アプリ用ログイン" data-excel-ref="0506:買取アプリ用ログイン!B66">shopName</span></td><td><span class="src-cell" data-excel-book="0506" data-excel-sheet="買取アプリ用ログイン" data-excel-ref="0506:買取アプリ用ログイン!J66">文字列</span></td><td><span class="src-cell" data-excel-book="0506" data-excel-sheet="買取アプリ用ログイン" data-excel-ref="0506:買取アプリ用ログイン!R66">ログイン者の所属店舗</span></td></tr>
  1084	                <tr><td><span class="src-cell" data-excel-book="0506" data-excel-sheet="買取アプリ用ログイン" data-excel-ref="0506:買取アプリ用ログイン!B67">shopAddr</span></td><td><span class="src-cell" data-excel-book="0506" data-excel-sheet="買取アプリ用ログイン" data-excel-ref="0506:買取アプリ用ログイン!J67">文字列</span></td><td><span class="src-cell" data-excel-book="0506" data-excel-sheet="買取アプリ用ログイン" data-excel-ref="0506:買取アプリ用ログイン!R67">ログイン者の所属店舗の住所</span></td></tr>
  1085	                <tr><td><span class="src-cell" data-excel-book="0506" data-excel-sheet="買取アプリ用ログイン" data-excel-ref="0506:買取アプリ用ログイン!B68">jwtToken</span></td><td><span class="src-cell" data-excel-book="0506" data-excel-sheet="買取アプリ用ログイン" data-excel-ref="0506:買取アプリ用ログイン!J68">文字列</span></td><td><span class="src-cell" data-excel-book="0506" data-excel-sheet="買取アプリ用ログイン" data-excel-ref="0506:買取アプリ用ログイン!R68">初回ログイン以降、APIを呼び出す際に一緒にヘッダ情報として送るトークン、トークンが正しければAPIにアクセス可能</span></td></tr>
  1086	              </tbody>
