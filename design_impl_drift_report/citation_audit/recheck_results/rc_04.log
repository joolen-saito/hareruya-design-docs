  1231	          <div class="doc-flow">
  1232	            <p class="doc-p" style="--lv:0"><span class="src-cell" data-excel-book="0506" data-excel-sheet="店頭買取情報取得" data-excel-ref="0506:店頭買取情報取得!B6">GET</span>　<span class="src-cell" data-excel-book="0506" data-excel-sheet="店頭買取情報取得" data-excel-ref="0506:店頭買取情報取得!C6">POST</span>　<span class="src-cell" data-excel-book="0506" data-excel-sheet="店頭買取情報取得" data-excel-ref="0506:店頭買取情報取得!D6">PUT</span>　<span class="src-cell" data-excel-book="0506" data-excel-sheet="店頭買取情報取得" data-excel-ref="0506:店頭買取情報取得!E6">DELETE</span>　<span class="src-cell" data-excel-book="0506" data-excel-sheet="店頭買取情報取得" data-excel-ref="0506:店頭買取情報取得!F6">PATCH</span>　<span class="src-cell" data-excel-book="0506" data-excel-sheet="店頭買取情報取得" data-excel-ref="0506:店頭買取情報取得!G6">OPTIONS</span>　<span class="src-cell" data-excel-book="0506" data-excel-sheet="店頭買取情報取得" data-excel-ref="0506:店頭買取情報取得!H6">HEAD</span>　<span class="src-cell" data-excel-book="0506" data-excel-sheet="店頭買取情報取得" data-excel-ref="0506:店頭買取情報取得!K6">有</span>　<span class="src-cell" data-excel-book="0506" data-excel-sheet="店頭買取情報取得" data-excel-ref="0506:店頭買取情報取得!L6">無</span>　<span class="src-cell" data-excel-book="0506" data-excel-sheet="店頭買取情報取得" data-excel-ref="0506:店頭買取情報取得!O6">〇</span></p>
