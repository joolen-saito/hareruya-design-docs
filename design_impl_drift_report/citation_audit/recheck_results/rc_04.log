     3	namespace App\Controller\Admin;
     4	
     5	use FOS\RestBundle\Controller\FOSRestController;
     6	use FOS\RestBundle\Controller\Annotations as Rest;
     7	use FOS\RestBundle\View\View;
     8	use Symfony\Component\HttpFoundation\Request;
     9	use Symfony\Component\HttpFoundation\Response;
    10	
    11	class LoginController extends FOSRestController
    12	{
    13	    /**
    14	     * @param Request $request
    15	     */
    16	    public function postAction(Request $request)
    17	    {
    18	        $loginCheckUrl = $this->container->getParameter('admin_login_check_url') ?? ('http://' . filter_input(INPUT_SERVER, 'HTTP_HOST') . '/admin/login_check');
    19	        $loginUrl = $this->container->getParameter('admin_login_url') ?? ('http://' . filter_input(INPUT_SERVER, 'HTTP_HOST') . '/admin/login');
    20	        $loginId = $request->get('login_id');
    21	        $cookieFile = "/tmp/login{$loginId}.cookie";
    22	
    23	        // Get cookie
    24	        $ch = curl_init();
    25	        $options = [
    26	            CURLOPT_URL => $loginUrl,
    27	            CURLOPT_CUSTOMREQUEST => 'GET',
    28	            CURLOPT_RETURNTRANSFER => true,
    29	            CURLOPT_HEADER => true,
    30	            CURLOPT_COOKIEJAR => $cookieFile,
    31	        ];
    32	        curl_setopt_array($ch, $options);
    33	
    34	        $response = curl_exec($ch);
    35	        curl_close($ch);
    36	
    37	        // Login check
    38	        $chCheck = curl_init();
    39	        $requestData = [
    40	            'login_id' => $loginId,
    41	            'password' => $request->get('password'),
    42	        ];
    43	        $fields = http_build_query($requestData);
    44	
    45	        $options = [
    46	            CURLOPT_URL => $loginCheckUrl,
    47	            CURLOPT_POST => true,
    48	            CURLOPT_RETURNTRANSFER => true,
    49	            CURLOPT_FOLLOWLOCATION => true,
    50	            CURLOPT_COOKIEFILE => $cookieFile,
    51	            CURLOPT_POSTFIELDS => $fields,
    52	        ];
    53	        curl_setopt_array($chCheck, $options);
    54	        $response = curl_exec($chCheck);
    55	        curl_close($chCheck);
    56	        unlink($cookieFile);
    57	        $content = json_decode($response, true);
    58	
    59	        if (empty($content)) {
    60	            $pattern = '/<span class="text-danger">([^"]*)<\/span>/';
    61	            preg_match($pattern, $response, $result);
    62	
    63	            $view = View::create([
    64	                "code" => Response::HTTP_UNAUTHORIZED,
    65	                "message" => str_replace('<br>', '', $result[1]),
    66	            ], Response::HTTP_UNAUTHORIZED);
    67	
    68	            return $this->get('fos_rest.view_handler')->handle($view);
    69	        }
    70	
    71	        return $content;
    72	    }
    73	}
