    92	            'kernel.request' => ['onKernelRequest', 512],
    93	        ];
    94	    }
    95	}
    35	    public static function getSubscribedEvents(): array
    36	    {
    37	        return [
    38	            // 本体のSecurityListenerと同じイベントを購読する
    39	            SecurityEvents::INTERACTIVE_LOGIN => 'onInteractiveLogin',
    40	        ];
    41	    }
    42	
    43	    public function onInteractiveLogin(InteractiveLoginEvent $event): void
    44	    {
    45	        $Customer = $event->getAuthenticationToken()->getUser();
    46	        if (!$Customer instanceof Customer) {
    47	            return;
    48	        }
    49	
    50	        if ($Customer->isNotOtcGroupPlayer() && $Customer->isNotOtcShitenGroupPlayer()) {
    51	            return;
    52	        }
    53	
    54	        $clientIpAddress = $event->getRequest()->getClientIp();
    55	        if ($clientIpAddress === null || $clientIpAddress === '') {
    56	            $this->redirectToLogout();
    57	
    58	            return;
    59	        }
    60	
    61	        $BaseInfo = $this->baseInfoService->getByRequestShop();
    62	        if (!$this->isAllowedClientIp($clientIpAddress, $BaseInfo)) {
    63	            $this->redirectToLogout();
    64	        }
    65	    }
    66	
    67	    private function isAllowedClientIp(string $clientIpAddress, BaseInfo $BaseInfo): bool
    68	    {
    69	        $globalIpAddress = $BaseInfo->getGlobalIpAddress();
    70	        if ($globalIpAddress === null || trim($globalIpAddress) === '') {
    71	            return false;
    72	        }
    73	
    74	        $allowedIps = array_map('trim', explode(',', $globalIpAddress));
    75	
    76	        return in_array($clientIpAddress, $allowedIps, true);
    77	    }
    78	
    79	    private function redirectToLogout(): void
    80	    {
    81	        $response = new RedirectResponse($this->urlGenerator->generate('logout'));
    82	        $response->send();
    83	    }
    84	}
