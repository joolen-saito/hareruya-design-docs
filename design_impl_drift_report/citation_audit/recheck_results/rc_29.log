diff --git a//tmp/extract_rc29_layout_images.py b//tmp/extract_rc29_layout_images.py
new file mode 100644
index 0000000000000000000000000000000000000000..dc56bc1e602bc7483f20391073aeb163629b8b16
--- /dev/null
+++ b//tmp/extract_rc29_layout_images.py
@@ -0,0 +1,43 @@
+from __future__ import annotations
+
+import base64
+import re
+from pathlib import Path
+
+
+SOURCE = Path(
+    "/home/y-saito/Developments/hareruya-design-docs/"
+    "excel_to_html/output/0202_基本設計仕様書(在庫管理機能).html"
+)
+OUTPUT = Path("/tmp/rc29-layout-images")
+TARGET_REFS = {
+    "0202:在庫変更CSV登録!C82",
+    "0202:在庫分割CSV登録!C7",
+    "0202:在庫結合CSV登録!C8",
+}
+
+
+html = SOURCE.read_text(encoding="utf-8")
+OUTPUT.mkdir(parents=True, exist_ok=True)
+
+figures = re.findall(r"<figure\b.*?</figure>", html, flags=re.DOTALL)
+written = []
+for figure in figures:
+    ref_match = re.search(r'data-excel-ref="([^"]+)"', figure)
+    if not ref_match or ref_match.group(1) not in TARGET_REFS:
+        continue
+    ref = ref_match.group(1)
+    tags = re.findall(r"<img\b[^>]+>", figure)
+    for index, tag in enumerate(tags, start=1):
+        src_match = re.search(r'src="data:image/([^;]+);base64,([^"]+)"', tag)
+        alt_match = re.search(r'alt="([^"]*)"', tag)
+        if not src_match:
+            continue
+        ext = "jpg" if src_match.group(1) == "jpeg" else src_match.group(1)
+        safe_ref = re.sub(r"[^0-9A-Za-z_-]+", "_", ref)
+        path = OUTPUT / f"{safe_ref}_{index}.{ext}"
+        path.write_bytes(base64.b64decode(src_match.group(2)))
+        written.append((path, alt_match.group(1) if alt_match else ""))
+
+for path, alt in written:
+    print(f"{path}\t{alt}")

