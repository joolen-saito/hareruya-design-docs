from pathlib import Path
import base64,re,shutil
out=Path('/tmp/rc16_layout_images2')
if out.exists(): shutil.rmtree(out)
out.mkdir()
specs=[
(Path('/home/y-saito/Developments/hareruya-design-docs/excel_to_html/output/0306_基本設計仕様書(フロント_会員).html'), ['sheet-7','sheet-8','sheet-9','sheet-10']),
(Path('/home/y-saito/Developments/hareruya-design-docs/excel_to_html/output/0305_基本設計仕様書(フロント_ネット買取).html'), ['sheet-10']),
]
for path,ids in specs:
    s=path.read_text()
    starts=[(m.start(),m.group(1)) for m in re.finditer(r'<section class=\"sheet-panel\" id=\"(["'^"]+)"'"',s)]
    bounds={sid:(pos, starts[i+1][0] if i+1<len(starts) else len(s)) for i,(pos,sid) in enumerate(starts)}
    for sid in ids:
        a,b=bounds[sid]; chunk=s[a:b]
        imgs=list(re.finditer(r'<img\\s+(["'^>]*?)src="(data:image/([''^;]+);base64,([''^"]+))"([''^>]*)>'"',chunk,re.S))
        print(path.name,sid,'images',len(imgs))
        for i,m in enumerate(imgs,1):
            attrs=m.group(1)+m.group(5); ext='jpg' if m.group(3) in ('jpeg','jpg') else m.group(3)
            dest=out/f'{path.name[:4]}_{sid}_{i:02d}.{ext}'
            dest.write_bytes(base64.b64decode(m.group(4)))
            alt=(re.search(r'alt=\"(["'^"]*)"'"',attrs) or [None,''])[1]
            cls=(re.search(r'class=\"(["'^"]*)"'"',attrs) or [None,''])[1]
            print(' ',dest.name,alt,cls)
