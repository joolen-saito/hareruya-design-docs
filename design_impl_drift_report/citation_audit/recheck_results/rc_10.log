   419	    /**
   420	     * 基準店舗の ProductStock を新店舗用に複製する（在庫数0で初期化）。
   421	     *
   422	     * @param int $sourceBaseInfoId 基準店舗ID（複製元）
   423	     * @param int $targetBaseInfoId 新店舗ID（複製先）
   424	     *
   425	     * @return int 作成件数
   426	     */
   427	    public function copyStockForNewShop(int $sourceBaseInfoId, int $targetBaseInfoId): int
   428	    {
   429	        $now = new \DateTime();
   430	
   431	        $sql = <<<SQL
   432	            INSERT INTO dtb_product_stock
   433	                (product_class_id, base_info_id, creator_id, stock, stock_location_id, total_cost, pick_up_flg, create_date, update_date)
   434	            SELECT
   435	                product_class_id, :target_base_info_id, 1, 0, stock_location_id, 0, false, :now, :now
   436	            FROM
   437	                dtb_product_stock
   438	            WHERE
   439	                base_info_id = :source_base_info_id
   440	            SQL;
   441	
   442	        return $this->getEntityManager()->getConnection()->executeStatement(
   443	            $sql,
   444	            [
   445	                'target_base_info_id' => $targetBaseInfoId,
   446	                'source_base_info_id' => $sourceBaseInfoId,
   447	                'now' => $now,
   448	            ],
   449	            [
   450	                'target_base_info_id' => ParameterType::INTEGER,
   451	                'source_base_info_id' => ParameterType::INTEGER,
   452	                'now' => Types::DATETIMETZ_MUTABLE,
   453	            ],
   454	        );
   455	    }
