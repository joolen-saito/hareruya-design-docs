    public function buildForm(FormBuilderInterface $builder, array $options): void
    {
        $DefaultShop = $this->getMemberDefaultSearchBaseInfo();

        $builder
            ->add('summary_date_from', DateType::class, [
                'required' => true,
                'input' => 'datetime',
                'widget' => 'single_text',
            ])
            ->add('summary_date_to', DateType::class, [
                'required' => true,
                'input' => 'datetime',
                'widget' => 'single_text',
            ])
            ->add('shop', EntityType::class, [
                'required' => false,
                'expanded' => false,
                'multiple' => true,
                'class' => BaseInfo::class,
                'data' => $DefaultShop !== null ? [$DefaultShop] : [],
            ])
            ->add('section', EntityType::class, [
                'required' => false,
                'expanded' => false,
                'multiple' => true,
                'class' => MtbSection::class,
            ])
        ;
    }

    /**
     * {@inheritdoc}
     */
    #[\Override]
    public function getBlockPrefix(): string
    {
        return 'admin_otc_buy_order_summary';
    }

    /**
     * メンバーのデフォルト検索表示店舗を取得
     */
    private function getMemberDefaultSearchBaseInfo(): ?BaseInfo
    {
        $Member = $this->security->getUser();

        if (!$Member instanceof Member) {
            return null;
        }

        try {
            return $Member->getDefaultSearchBaseInfo();
        } catch (\Error $e) {
            // プロパティが未初期化の場合
            return null;
        }
    }
}
