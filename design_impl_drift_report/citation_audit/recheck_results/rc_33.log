    public function testUpdateOtcBuyOrderSuccess(): void
    {
        // Arrange
        $OtcBuyOrder = $this->generator->createDtbOtcBuyOrder();
        $ProductClass1 = $this->generator->createProductClass();
        $ProductClass2 = $this->generator->createProductClass();
        $updateOtcBuyOrderRequest = [
            'order_status' => MtbOtcBuyOrderStatus::STATUS_COMPLETE,
            'qualified_invoice_issuer_confirmation_flg' => true,
            'smaregi_transaction_id' => 1,
            'order_details' => [
                ['product_class_id' => $ProductClass1->getId(), 'name' => 'test', 'quantity' => 1, 'price' => 100, 'sell_price' => 100, 'section_id' => 1],
                ['product_class_id' => $ProductClass2->getId(), 'name' => 'test2', 'quantity' => 2, 'price' => 200, 'sell_price' => 200, 'section_id' => 2],
            ],
        ];
        $token = $this->jwtTokenService->createToken($this->Member->getId());

        // Act
        $this->client->request(Request::METHOD_PUT, '/api/v1/admin/otcBuyOrder/'.$OtcBuyOrder->getId().'.json', [], [], ['HTTP_JWT_TOKEN' => $token, 'CONTENT_TYPE' => 'application/json'], json_encode($updateOtcBuyOrderRequest));

        // Assert
        $this->assertSame(Response::HTTP_OK, $this->client->getResponse()->getStatusCode());
    }

