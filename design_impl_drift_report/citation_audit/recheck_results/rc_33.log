/bin/bash -lc "python3 - <<'PY'
from html.parser import HTMLParser
from pathlib import Path
import base64, re
jobs = [
 ('0205','hareruya-design-docs/excel_to_html/output/0205_基本設計仕様書(店頭買取管理).html', {'sheet-4','sheet-11','sheet-15'}),
 ('0601','hareruya-design-docs/excel_to_html/output/0601_基本設計仕様書(その他_MTGBuyer).html', {'sheet-3'}),
 ('0206','hareruya-design-docs/excel_to_html/output/0206_基本設計仕様書(ネット買取管理機能).html', {'sheet-3'}),
]
class P(HTMLParser):
 def __init__(self, book, wanted):
  super().__init__(convert_charrefs=True); self.book=book; self.wanted=wanted; self.section=None; self.count={}
 def handle_starttag(self, tag, attrs):
  a=dict(attrs)
  if tag=='section' and a.get('class','').split().count('sheet-panel'):
   self.section=a.get('id')
  if tag=='img' and self.section in self.wanted and a.get('src','').startswith('data:image'):
   self.count[self.section]=self.count.get(self.section,0)+1
   n=self.count[self.section]
   head,data=a['src'].split(',',1)
   ext='png' if 'png' in head else 'jpg'
   out=Path(f'/tmp/{self.book}_{self.section}_{n}.{ext}')
   out.write_bytes(base64.b64decode(data))
   print(out, a.get('alt'), a.get('data-excel-ref'))
for book,fn,wanted in jobs:
 p=P(book,wanted); p.feed(Path(fn).read_text())
