        requirements: ['otcBuyOrderId' => "\d+"],
        methods: ['POST']
    )]
    public function statusUpdateAccountTeamPaid(Request $request, int $otcBuyOrderId): Response
    {
        // CSRFトークンの検証
        if (!$this->isCsrfTokenValid('account_team_paid', $request->request->get('_token'))) {
            $this->addError('admin.common.csrf_token_error', 'admin');

            return $this->redirectToRoute('admin_otcbuyorder_detail', ['otcBuyOrderId' => $otcBuyOrderId]);
        }

        $OtcBuyOrder = $this->otcBuyOrderRepository->find($otcBuyOrderId);
        if (!$OtcBuyOrder) {
            throw $this->createNotFoundException();
        }
        // Memberの編集可能店舗権限のチェック
        $Member = $this->getUser();
        if (!$Member instanceof Member) {
            throw new AuthenticationException();
        }
        $OtcBuyOrderBaseInfo = $OtcBuyOrder->getBaseInfo();

        if (!$Member->isEditableShop($OtcBuyOrderBaseInfo)) {
            throw new \InvalidArgumentException('編集可能な店舗と買取情報の買取店舗が一致しません。');
        }

        if (!$this->isAccessibleRouteExtension->isAccessibleRoute('admin_otcbuyorder_update_status_account_team_paid')) {
            $this->addError('exception.error_message_restrict_url', 'admin');

            return $this->redirectToRoute('admin_otcbuyorder_detail', [
                'otcBuyOrderId' => $otcBuyOrderId,
            ]);
        }

