    #[ORM\Table(name: 'dtb_member')]
    #[ORM\HasLifecycleCallbacks]
    #[ORM\Entity(repositoryClass: MemberRepository::class)]
    #[UniqueEntity(fields: 'login_id', message: 'form_error.member_already_exists')]
    class Member extends AbstractEntity implements UserInterface, PasswordAuthenticatedUserInterface, LegacyPasswordAuthenticatedUserInterface, \Serializable, \Stringable
    {
        public function __construct()
        {
            $this->MemberBaseInfos = new ArrayCollection();
        }

        #[\Override]
        public function __toString(): string
        {
            return (string) $this->getName();
        }

        /**
         * {@inheritdoc}
         */
        #[\Override]
        public function getRoles(): array
        {
            $AuthorityName = $this->Authority->getRoleKey();

            return [
                'ROLE_ADMIN',
                'ROLE_'.strtoupper($AuthorityName),
            ];
        }

        public function getUsername(): string
        {
            return $this->login_id;
        }

        /**
         * @var int[]|null 編集可能な店舗IDのキャッシュ
         */
        private ?array $editableShopIds = null;

        /**
         * 編集可能店舗かどうか判定します
         */
        public function isEditableShop(BaseInfo $TargetBaseInfo): bool
        {
            // 1. 最初の一回だけ、全許可店舗のIDを配列にまとめる

            if ($this->editableShopIds === null) {
                $this->editableShopIds = [];

                foreach ($this->getMemberBaseInfos() as $MemberBaseInfo) {
                    $this->editableShopIds[] = $MemberBaseInfo->getBaseInfo()->getId();
                }
            }

            return in_array($TargetBaseInfo->getId(), $this->editableShopIds, true);
        }

        /**
         * {@inheritdoc}
         */
        #[\Override]
        #[\Deprecated(message: 'eraseCredentials() is empty as we moved the logic to __serialize()', since: 'eccube/eccube 7.3')]
        public function eraseCredentials(): void
        {
        }

        #[ORM\Column(name: 'id', type: Types::INTEGER, options: ['unsigned' => true])]
        #[ORM\Id]
        #[ORM\GeneratedValue(strategy: 'IDENTITY')]
        private ?int $id = null;

        #[ORM\Column(name: 'name', type: Types::STRING, length: 255, nullable: true)]
        private ?string $name = null;

        #[ORM\ManyToOne(targetEntity: Department::class)]
        #[ORM\JoinColumn(name: 'department_id', referencedColumnName: 'id', nullable: false)]
        private Department $Department;

        #[ORM\Column(name: 'email', type: Types::STRING, length: 255)]
        private string $email;

        #[ORM\ManyToOne(targetEntity: BaseInfo::class)]
        #[ORM\JoinColumn(name: 'default_search_base_info_id', referencedColumnName: 'id', nullable: true, options: ['comment' => 'デフォルト検索表示店舗'])]
        private ?BaseInfo $DefaultSearchBaseInfo = null;

