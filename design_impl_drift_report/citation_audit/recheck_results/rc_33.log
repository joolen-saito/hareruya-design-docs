     *
     * @group HARERUYA
     */
    public function testStatusUpdateAccountTeamPaidWithDeniedRouteRedirectsToDetailWithError(): void
    {
        $OtcBuyOrder = $this->createOtcBuyOrderWithBaseInfo(
            MtbOtcBuyOrderStatus::STATUS_ACCOUNTING_PAYMENT_PENDING,
        );
        $this->generator->createAuthorityRole(
            self::DENY_URL_OTC_BUY_ORDER_ACCOUNT_TEAM_PAID,
            $this->Member->getAuthority(),
            $this->Member,
        );

        /** @var CsrfTokenManagerInterface $csrfTokenManager */
        $csrfTokenManager = static::getContainer()->get('security.csrf.token_manager');

        $this->client->request(
            Request::METHOD_POST,
            $this->generateUrl('admin_otcbuyorder_update_status_account_team_paid', [
                'otcBuyOrderId' => $OtcBuyOrder->getId(),
            ]),
            [
                '_token' => $csrfTokenManager->getToken('account_team_paid')->getValue(),
            ],
        );

        $this->assertTrue($this->client->getResponse()->isRedirect(
            $this->generateUrl('admin_otcbuyorder_detail', ['otcBuyOrderId' => $OtcBuyOrder->getId()]),
        ));

        $session = $this->createSession($this->client);
        $errorMessages = $session->getFlashBag()->get('eccube.admin.error');
        $this->assertContains('exception.error_message_restrict_url', $errorMessages);
    }
