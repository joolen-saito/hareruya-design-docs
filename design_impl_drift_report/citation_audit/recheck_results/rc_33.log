    public function status(Request $request, int $otcBuyOrderId): array|Response
    {
        $OtcBuyOrder = $this->otcBuyOrderRepository->find($otcBuyOrderId);
        if (!$OtcBuyOrder) {
            throw $this->createNotFoundException();
        }

        if (!$this->isAccessibleRouteExtension->isAccessibleRoute('admin_otcbuyorder_status')) {
            $this->addError('exception.error_message_restrict_url', 'admin');

            return $this->redirectToRoute('admin_otcbuyorder_detail', [
                'otcBuyOrderId' => $otcBuyOrderId,
            ]);
        }

        $builder = $this->formFactory->createBuilder(OtcBuyOrderStatusType::class);

        $event = new EventArgs(
            [
                'builder' => $builder,
                'OtcBuyOrder' => $OtcBuyOrder,
            ],
            $request
        );
        $this->eventDispatcher->dispatch($event, EccubeEvents::ADMIN_OTC_BUY_ORDER_STATUS_INITIALIZE);

        $form = $builder->getForm();

        return [
            'form' => $form->createView(),
            'OtcBuyOrder' => $OtcBuyOrder,
        ];
    }

    /**
     * ステータス変更処理
     *
     * @return array<string, mixed>|Response
     */
    #[Template(template: '@admin/OtcBuyOrder/status.twig')]
    #[Route(
        path: '/%eccube_admin_route%/otcbuyorder/status/{otcBuyOrderId}/update',
        name: 'admin_otcbuyorder_status_update',
        requirements: ['otcBuyOrderId' => "\d+"],
        methods: ['POST']
    )]
    public function statusUpdate(Request $request, int $otcBuyOrderId): array|Response
    {
        $OtcBuyOrder = $this->otcBuyOrderRepository->find($otcBuyOrderId);
        if (!$OtcBuyOrder) {
            throw $this->createNotFoundException();
        }

        if (!$this->isAccessibleRouteExtension->isAccessibleRoute('admin_otcbuyorder_status_update')) {
            $this->addError('exception.error_message_restrict_url', 'admin');

            return $this->redirectToRoute('admin_otcbuyorder_detail', [
                'otcBuyOrderId' => $otcBuyOrderId,
            ]);
        }

        $form = $this->createForm(OtcBuyOrderStatusType::class);
        $form->handleRequest($request);

        if ($form->isSubmitted() && $form->isValid()) {
            $NextStatus = $form->get('otc_buy_order_status')->getData();

            try {
                $this->updateStatusAction->handle(new UpdateStatusInput(
                    OtcBuyOrder: $OtcBuyOrder,
                    NextStatus: $NextStatus,
                    Member: $this->getMember(),
                ));
            } catch (\InvalidArgumentException $e) {
                $this->addError($e->getMessage(), 'admin');

                return $this->redirectToRoute('admin_otcbuyorder_status', [
                    'otcBuyOrderId' => $OtcBuyOrder->getId(),
                ]);
            }

            $event = new EventArgs(
                [
                    'form' => $form,
                    'OtcBuyOrder' => $OtcBuyOrder,
                ],
                $request
            );
            $this->eventDispatcher->dispatch($event, EccubeEvents::ADMIN_OTC_BUY_ORDER_STATUS_UPDATE_COMPLETE);

            $this->addSuccess('admin.common.save_complete', 'admin');

            return $this->redirectToRoute('admin_otcbuyorder_detail', [
                'otcBuyOrderId' => $OtcBuyOrder->getId(),
            ]);
        }

        return [
            'form' => $form->createView(),
            'OtcBuyOrder' => $OtcBuyOrder,
        ];
    }

    /**
     * ステータスを「経理払出し待ち」-> 「買取完了」に変更する
     */
    #[Route(
