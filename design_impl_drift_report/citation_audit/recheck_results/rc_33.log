        // MemberBaseInfo を紐づけた Member でログインする
        $this->Member = $this->createMember();
        $BaseInfo = $this->entityManager->find(BaseInfo::class, 1);
        $MemberBaseInfo = new MemberBaseInfo();
        $MemberBaseInfo->setMember($this->Member)->setBaseInfo($BaseInfo);
        $this->entityManager->persist($MemberBaseInfo);
        $this->Member->getMemberBaseInfos()->add($MemberBaseInfo);
        $this->entityManager->flush();

        $this->loginTo($this->Member);
    }

    /**
     * ステータス変更画面表示 - 正常系
     * GET でステータス変更画面が表示されること
     *
     * @group HARERUYA
     */
    public function testStatusPageRendersSuccessfully(): void
    {
        // Arrange
        $OtcBuyOrder = $this->createOtcBuyOrderWithBaseInfo(
            MtbOtcBuyOrderStatus::STATUS_ASSESSMENT_PENDING,
        );

        // Act
        $this->client->request(
            Request::METHOD_GET,
            $this->generateUrl('admin_otcbuyorder_status', ['otcBuyOrderId' => $OtcBuyOrder->getId()]),
        );

        // Assert
        $this->assertTrue($this->client->getResponse()->isSuccessful());
    }

    /**
     * status - 異常系
     * 拒否URLが設定されている場合、AuthorityVoter により 403 が返ること
     *
     * @group HARERUYA
     */
    public function testStatusPageWithDeniedRouteReturnsForbidden(): void
    {
        $OtcBuyOrder = $this->createOtcBuyOrderWithBaseInfo(
            MtbOtcBuyOrderStatus::STATUS_ASSESSMENT_PENDING,
        );
        $this->generator->createAuthorityRole(
            self::DENY_URL_OTC_BUY_ORDER_STATUS,
            $this->Member->getAuthority(),
            $this->Member,
        );

        $this->client->request(
            Request::METHOD_GET,
            $this->generateUrl('admin_otcbuyorder_status', ['otcBuyOrderId' => $OtcBuyOrder->getId()]),
        );

        $this->assertEquals(Response::HTTP_FORBIDDEN, $this->client->getResponse()->getStatusCode());
    }

    /**
     * ステータス変更 - 正常系
     * ステータスが更新され、詳細画面にリダイレクトされること
     *
     * @group HARERUYA
     */
    public function testStatusUpdateSuccess(): void
    {
        // Arrange
        $OtcBuyOrder = $this->createOtcBuyOrderWithBaseInfo(
            MtbOtcBuyOrderStatus::STATUS_ASSESSMENT_PENDING,
        );

        // Act
        $this->submitStatusForm($OtcBuyOrder, MtbOtcBuyOrderStatus::STATUS_ASSESSMENT_IN_PROGRESS);

        // Assert: 詳細画面にリダイレクト
        $this->assertTrue($this->client->getResponse()->isRedirect(
            $this->generateUrl('admin_otcbuyorder_detail', ['otcBuyOrderId' => $OtcBuyOrder->getId()]),
        ));

        // Assert: ステータスが更新されている
        $this->entityManager->clear();
        $UpdatedOtcBuyOrder = $this->entityManager->find(DtbOtcBuyOrder::class, $OtcBuyOrder->getId());
        $this->assertSame(
            MtbOtcBuyOrderStatus::STATUS_ASSESSMENT_IN_PROGRESS,
            $UpdatedOtcBuyOrder->getOtcBuyOrderStatus()->getId(),
        );

        // Assert: 履歴が作成されている
        $History = $this->entityManager->getRepository(DtbOtcBuyOrderStatusHistory::class)
            ->findOneBy(['OtcBuyOrder' => $UpdatedOtcBuyOrder]);
        $this->assertNotNull($History);
        $this->assertSame(
            MtbOtcBuyOrderStatus::STATUS_ASSESSMENT_IN_PROGRESS,
            $History->getOtcBuyOrderStatusId(),
        );
    }

    /**
     * ステータス変更 - 異常系
     * 入庫済みから管理者取消以外への変更はエラーになり、ステータス変更画面にリダイレクトされること
     *
     * @group HARERUYA
     */
    public function testStatusUpdateFromStockingCompleteToNonRevokedRedirectsWithError(): void
    {
        // Arrange
        $OtcBuyOrder = $this->createOtcBuyOrderWithBaseInfo(
            MtbOtcBuyOrderStatus::STATUS_STOCKING_COMPLETE,
        );

        // Act
        $this->submitStatusForm($OtcBuyOrder, MtbOtcBuyOrderStatus::STATUS_ASSESSMENT_IN_PROGRESS);

        // Assert: ステータス変更画面にリダイレクト
        $this->assertTrue($this->client->getResponse()->isRedirect(
            $this->generateUrl('admin_otcbuyorder_status', ['otcBuyOrderId' => $OtcBuyOrder->getId()]),
        ));

        // Assert: ステータスが変更されていない
        $this->entityManager->clear();
        $UnchangedOtcBuyOrder = $this->entityManager->find(DtbOtcBuyOrder::class, $OtcBuyOrder->getId());
        $this->assertSame(
            MtbOtcBuyOrderStatus::STATUS_STOCKING_COMPLETE,
            $UnchangedOtcBuyOrder->getOtcBuyOrderStatus()->getId(),
        );
    }

    /**
     * ステータス変更 - 正常系
     * 入庫済みから管理者取消への変更は成功すること
     *
     * @group HARERUYA
     */
    public function testStatusUpdateFromStockingCompleteToRevokedByAdminSuccess(): void
    {
        // Arrange
        $OtcBuyOrder = $this->createOtcBuyOrderWithBaseInfo(
            MtbOtcBuyOrderStatus::STATUS_STOCKING_COMPLETE,
        );

        // Act
        $this->submitStatusForm($OtcBuyOrder, MtbOtcBuyOrderStatus::STATUS_REVOKED_BY_ADMIN);

            [
