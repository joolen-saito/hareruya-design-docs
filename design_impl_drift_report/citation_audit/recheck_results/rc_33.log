        private readonly OtcBuyOrderEntityManager $otcBuyOrderEntityManager,
        private readonly OtcBuyOrderStatusHistoryEntityManager $otcBuyOrderStatusHistoryEntityManager,
        private readonly MailService $mailService,
    ) {
    }

    public function handle(UpdateOtcBuyOrderActionInput $input): void
    {
        $OtcBuyOrderStatus = $this->entityManager->find(MtbOtcBuyOrderStatus::class, $input->UpdateOtcBuyOrderDto->orderStatusId);
        if (!$OtcBuyOrderStatus) {
            throw new InvalidRequestParameterException('Invalid order status id');
        }

        $PrevStatus = $input->OtcBuyOrder->getOtcBuyOrderStatus();

        // 商品規格IDの有無により、注文詳細と注文個別入力商品に分類
        $updatePlan = $this->buildOtcBuyOrderDetailUpdatePlan->build($input->UpdateOtcBuyOrderDto->orderDetails);

        // 以降前システムにて、複数Entity間で同じ時間がsetされていた。意図は不明だが踏襲する
        $currentTime = new \DateTime();

        $this->entityManager->beginTransaction();
        try {
            $OrderDetails = $this->rebuildOtcBuyOrderDetail->rebuild(new RebuildOtcBuyOrderDetailInput($input->OtcBuyOrder, $updatePlan->details));
            $IndivisualInputProducts = $this->rebuildOtcBuyOrderIndivisualInputProduct->rebuild(new RebuildOtcBuyOrderIndivisualInputProductInput($input->OtcBuyOrder, $updatePlan->indivisuals));
            $OtcBuyOrderStocksAndHistories = $this->rebuildOtcBuyOrderStockAndHistory->rebuild(new RebuildOtcBuyOrderStockAndHistoryInput($input->OtcBuyOrder, $updatePlan->productClassQuantities, $updatePlan->productClassSubtotals, $input->Member, $currentTime));

            // 以降前システムの仕様に合わせて、10円単位に切り上げる。bcmatchを使うルールに従う。
            $totalPrice = (int) bcceil(bcdiv((string) $updatePlan->totalPrice, '10', 10)) * 10;
            $this->otcBuyOrderEntityManager->update(
                $input->OtcBuyOrder,
                $OtcBuyOrderStatus,
                $input->UpdateOtcBuyOrderDto->qualifiedInvoiceIssuerConfirmationFlg,
                $input->UpdateOtcBuyOrderDto->smaregiTransactionId,
                $totalPrice,
                new ArrayCollection($OrderDetails),
                new ArrayCollection($IndivisualInputProducts),
                new ArrayCollection($OtcBuyOrderStocksAndHistories),
                $input->Member,
                $currentTime
            );

            // 以降前システムの仕様に合わせて、ステータスが変更された場合のみステータス履歴を保存する
            if ($PrevStatus !== $OtcBuyOrderStatus) {
                $this->otcBuyOrderStatusHistoryEntityManager->save($input->OtcBuyOrder, $OtcBuyOrderStatus, $input->Member, $currentTime);
            }
            // 買取成立の場合は2段階目のステータス更新と履歴保存を行う
            // (合わせて2件の履歴が必要のため、上記と分けて更新を行なっている)
            if ($OtcBuyOrderStatus->isComplete()) {
                $PostCompleteStatus = $this->entityManager->find(
                    MtbOtcBuyOrderStatus::class,
                    $input->OtcBuyOrder->resolvePostCompleteStatusId(),
                );
                $this->otcBuyOrderEntityManager->updateStatusWithHistory($input->OtcBuyOrder, $PostCompleteStatus, $input->Member, $currentTime);
            }
            $this->entityManager->flush();
            $this->entityManager->commit();

            // 経理払出し待ちの場合は、経理チームにメールを送信する
            if ($OtcBuyOrderStatus->isAccountingPaymentPending()) {
                $this->mailService->sendOtcBuyOrderAccountingPaymentPendingMail($input->OtcBuyOrder);
            }
        } catch (\Exception $e) {
            $this->entityManager->rollback();
            $this->logger->error('Failed to update otc buy order', ['exception' => $e, 'otcBuyOrderId' => $input->OtcBuyOrder->getId(), 'memberId' => $input->Member->getId()]);
            throw $e;
    public function getFunctions(): array
    {
        return [
            new TwigFunction('is_accessable_route', $this->isAccessibleRoute(...)),
        ];
    }

    /**
     * ユーザーがアクセス可能なルートかどうかを判定します.
     */
    public function isAccessibleRoute(string $routeName): bool
    {
        $Member = $this->security->getUser();
        if (!$Member instanceof Member) {
            return false;
        }

        /** @phpstan-ignore-next-line $routeCollection - phpstanにgetRouteCollection関数は存在していないと言われているけど、存在している */
        $routeCollection = $this->router->getRouteCollection();
        $route = $routeCollection->get($routeName);
        if ($route === null) {
            return true;
        }

        $path = $route->getPath();
        $AuthorityRoles = $this->authorityRoleRepository->findBy(['Authority' => $Member->getAuthority()]);
        $adminRoute = $this->eccubeConfig->get('eccube_admin_route');

        foreach ($AuthorityRoles as $AuthorityRole) {
            // 許可しないURLが含まれていればアクセス拒否
            try {
                // denyUrlの\d+をプレースホルダー{id}等にもマッチするよう変換し、正規表現でURLチェック
                // AuthorityVoterとは違い、{id}等のプレースホルダーが含まれている場合があるためマッチするように変換
                $denyUrl = str_replace(['\\d+', '/'], ['(\\d+|\\{[^}]+\\})', '\\/'], $AuthorityRole->getDenyUrl());
                if (preg_match("/^(\\/{$adminRoute}{$denyUrl})/i", (string) $path)) {
                    return false;
                }
            } catch (\Exception) {
                // 拒否URLの指定に誤りがある場合、エスケープさせてチェック
                $denyUrl = preg_quote((string) $AuthorityRole->getDenyUrl(), '/');
                if (preg_match("/^(\\/{$adminRoute}{$denyUrl})/i", (string) $path)) {
                    return false;
                }
            }
        }

        return true;
    }
}
