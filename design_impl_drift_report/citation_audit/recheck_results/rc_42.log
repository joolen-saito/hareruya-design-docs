          <nav class="sheet-jump" aria-label="シート内ジャンプ">
            <a href="#sheet-12-spec-1">処理概要</a>
            <a href="#sheet-12-shapes">図形・テキストボックス内テキスト（9件）</a>
          </nav>
          <div class="doc-flow">
            <h3 class="doc-h doc-h-section" style="--lv:0"><span class="src-cell" data-excel-book="0209" data-excel-sheet="カスタムCSV出力設定" data-excel-ref="0209:カスタムCSV出力設定!B6">レイアウト図</span></h3>
          </div>
          <div class="image-block">
            <figure class="sheet-image wf-frame" data-excel-book="0209" data-excel-sheet="カスタムCSV出力設定" data-excel-ref="0209:カスタムCSV出力設定!L7" data-image-order="1">
