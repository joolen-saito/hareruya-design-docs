            ->add(Option::ARRIVAL_ALERT_MAX, IntegerType::class, [
                'required' => true,
                'constraints' => [
                    new NotBlank(),
                    new GreaterThanOrEqual(0),
                ],
                'data' => $options['settings'][Option::ARRIVAL_ALERT_MAX] ?? Option::ARRIVAL_ALERT_MAX_DEFAULT,
            ])
            ->add(Option::PURCHASE_MAIL_ADDRESS, TextType::class, [
                'required' => true,
                'constraints' => [
                    new NotBlank(),
                    new Email(null, null, $this->eccubeConfig['eccube_rfc_email_check'] ? 'strict' : null),
                    new Length(['max' => $this->eccubeConfig['eccube_stext_len']]),
                ],
                'data' => $options['settings'][Option::PURCHASE_MAIL_ADDRESS] ?? Option::PURCHASE_MAIL_ADDRESS_DEFAULT,
            ])
            ->add(Option::RECOMMEND_SEARCH_DAYS, IntegerType::class, [
                'required' => true,
                'constraints' => [
                    new NotBlank(),
                    new GreaterThanOrEqual(0),
                ],
                'data' => $options['settings'][Option::RECOMMEND_SEARCH_DAYS] ?? Option::RECOMMEND_SEARCH_DAYS_DEFAULT,
            ])
            ->add(Option::OTCBUY_ORDER_RETURN_SECONDS, IntegerType::class, [
                'required' => false,
                'data' => $options['settings'][Option::OTCBUY_ORDER_RETURN_SECONDS] ?? Option::OTCBUY_ORDER_RETURN_SECONDS_DEFAULT,
            ])
            ->add(Option::OTC_SHOPPING_ORDER_RETURN_SECONDS, IntegerType::class, [
                'required' => false,
                'data' => $options['settings'][Option::OTC_SHOPPING_ORDER_RETURN_SECONDS] ?? Option::OTC_SHOPPING_ORDER_RETURN_SECONDS_DEFAULT,
            ])
            ->add(Option::SMAREGI_STORE_ID, TextType::class, [
                'required' => false,
                'constraints' => [
                    new Regex(['pattern' => '/^([!-~]*)$/']),
                ],
            ])
            ->add(Option::SMAREGI_ACCESS_TOKEN, TextType::class, [
                'required' => false,
                'constraints' => [
                    new Regex(['pattern' => '/^([!-~]*)$/']),
                ],
            ])
            ->add(Option::SMAREGI_REQUEST_URL, TextType::class, [
                'required' => false,
                'constraints' => [
                    new Regex(['pattern' => '/^(https?|ftp)(:\/\/[-_.!~*\'()a-zA-Z0-9;\/?:\@&=+\$,%#]+)$/']),
                ],
                'data' => $options['settings'][Option::SMAREGI_REQUEST_URL] ?? Option::SMAREGI_REQUEST_URL_DEFAULT,
            ])
            ->add(Option::SMAREGI_CATEGORY_ID, TextType::class, [
                'required' => false,
                'constraints' => [
                    new Regex([
                        'pattern' => "/^\d+$/",
                        'message' => 'form_error.numeric_only',
                    ]),
                ],
            ])
            ->add(Option::ORDER_TIMING_BODER, TextType::class, [
                'required' => true,
                'constraints' => [
                    new NotBlank(),
                    new Regex(['pattern' => '/^([01][0-9]|2[0-3]):[0-5][0-9]$/']),
                ],
                'data' => $options['settings'][Option::ORDER_TIMING_BODER] ?? Option::ORDER_TIMING_BODER_DEFAULT,
            ])
            ->add(Option::SEND_NOTIFICATION_ARRIVAL_MAIL, ChoiceType::class, [
                'required' => true,
                'constraints' => [
                    new NotBlank(),
                ],
                'choices' => [
                    'common.send' => Option::SEND_NOTIFICATION_ARRIVAL_MAIL_SEND,
                    'common.not_send' => Option::SEND_NOTIFICATION_ARRIVAL_MAIL_NOT_SEND,
                ],
            ])
            ->add(Option::BULK_PURCHASE_ID, TextType::class, [ // 空を許容するためTextTypeを使用
                'required' => false,
                'constraints' => [
                    new GreaterThanOrEqual(0),
                ],
            ])
            ->add(Option::FIXED_PRICE_SECTION, IntegerType::class, [
                'required' => true,
                'constraints' => [
                    new NotBlank(),
                    new GreaterThanOrEqual(1),
                ],
            ])
            ->add(Option::OTC_SUMMARY_MAIL_ADDRESS, TextType::class, [
                'required' => false,
                'constraints' => [
                    new Email(null, null, $this->eccubeConfig['eccube_rfc_email_check'] ? 'strict' : null),
                    new Length(['max' => $this->eccubeConfig['eccube_stext_len']]),
                ],
            ])
        private readonly MtbOptionRepository $optionRepository,
    ) {
        $this->eccubeConfig = $eccubeConfig;
    }

    /**
     * @return array<string, mixed>
     */
    #[Route('/%eccube_admin_route%/setting/shop/additional_system', name: 'admin_setting_shop_additional_system', methods: ['GET'])]
    #[Template('@admin/Setting/Shop/additional_system.twig')]
    public function index(Request $request): array
    {
        /** @var MtbOption[] $options */
        $options = $this->optionRepository->findAll();
        $settings = array_reduce($options, function (array $carray, MtbOption $Option): array {
            $carray[$Option->getOptionKey()] = $Option->getOptionValue();

            return $carray;
        }, []);

        $builder = $this->formFactory->createBuilder(AdditionalSystemFormType::class, $settings, ['settings' => $settings]);

        $event = new EventArgs(
            [
                'builder' => $builder,
            ],
            $request
        );
        $this->eventDispatcher->dispatch($event, EccubeEvents::ADMIN_SETTING_SHOP_ADDITIONAL_SYSTEM_INDEX_INITIALIZE);

        $form = $builder->getForm();
        $form->handleRequest($request);

        return [
            'form' => $form->createView(),
        ];
    }

    /**
     * @return RedirectResponse|array<string, mixed>
     */
    #[Route('/%eccube_admin_route%/setting/shop/additional_system/update', name: 'admin_setting_shop_additional_system_update', methods: ['POST'])]
    #[Template('@admin/Setting/Shop/additional_system.twig')]
    public function update(Request $request): RedirectResponse|array
    {
        /** @var MtbOption[] $options */
        $options = $this->optionRepository->findAll();
        $settings = array_reduce($options, function (array $carray, MtbOption $Option): array {
            $carray[$Option->getOptionKey()] = $Option->getOptionValue();

            return $carray;
        }, []);

        $form = $this->formFactory->createBuilder(AdditionalSystemFormType::class, $settings, ['settings' => $settings])->getForm();
        $form->handleRequest($request);

        if (!$form->isSubmitted() || !$form->isValid()) {
            return [
                'form' => $form->createView(),
            ];
        }

        $formData = $form->getData();
        /** @var Member $Member */
        $Member = $this->getUser();

        foreach ($options as $Option) {
            $keyName = $Option->getOptionKey();

            if (array_key_exists($keyName, $formData) && (string) $formData[$keyName] !== (string) $Option->getOptionValue()) {
                $Option->setOptionValue((string) $formData[$keyName]);
                $Option->setMember($Member);
                $Option->setUpdateDate(new \DateTime());

                $this->entityManager->persist($Option);
            }
        }

        $this->entityManager->flush();

        $event = new EventArgs(
            [
                'form' => $form,
            ],
            $request
        );
        $this->eventDispatcher->dispatch($event, EccubeEvents::ADMIN_SETTING_SHOP_ADDITIONAL_SYSTEM_UPDATE_COMPLETE);

        $this->addSuccess('admin.common.save_complete', 'admin');

        return $this->redirectToRoute('admin_setting_shop_additional_system');
    }
}
