+from html.parser import HTMLParser
+import base64
+from pathlib import Path
+
+
+class Extractor(HTMLParser):
+    def __init__(self):
+        super().__init__()
+        self.current_sheet = None
+        self.depth = 0
+        self.counts = {}
+
+    def handle_starttag(self, tag, attrs):
+        attrs = dict(attrs)
+        if tag == "section" and attrs.get("id") in {
+            "sheet-3",
+            "sheet-10",
+            "sheet-11",
+            "sheet-12",
+            "sheet-14",
+        }:
+            self.current_sheet = attrs["id"]
+            self.depth = 1
+            return
+        if self.current_sheet:
+            if tag == "section":
+                self.depth += 1
+            if tag == "img" and attrs.get("src", "").startswith("data:image/"):
+                self.counts[self.current_sheet] = self.counts.get(self.current_sheet, 0) + 1
+                index = self.counts[self.current_sheet]
+                encoded = attrs["src"].split(",", 1)[1]
+                target = OUTPUT / f"{self.current_sheet}_{index}.png"
+                target.write_bytes(base64.b64decode(encoded))
+                print(target)
+
+    def handle_endtag(self, tag):
+        if self.current_sheet and tag == "section":
+            self.depth -= 1
+            if self.depth == 0:
+                self.current_sheet = None
+
+
+SOURCE = Path(
+    "/home/y-saito/Developments/hareruya-design-docs/"
+    "excel_to_html/output/0209_基本設計仕様書(基本情報設定).html"
+)
+OUTPUT = Path("/tmp/rc42_images")
