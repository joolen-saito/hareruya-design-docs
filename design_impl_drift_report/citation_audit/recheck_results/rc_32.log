                1 => 'low',
            ],
        ];
        foreach ($pickingItems as $item) {
            $item['quantitySubtotal'] = $item['polyquantity'] / $item['colorCount'] / $item['categoryCount'];
            $item['cardsetName'] = $item['storageCode'] ?? '';
            $productName = $item['product_name'];
            // サプライ品でない場合は商品名から略称・言語・状態・色・レアリティを取り除く
            if (intval($item['categoryId']) !== Category::GOODS_ID && intval($item['categoryId']) !== Category::RESERVED_GOODS_ID) {
                if (preg_match('/\[' . $item['cardsetName'] . '\]/', $productName, $matchedSetName)) {
                    $productName = str_replace($matchedSetName[0], '', $productName);
                } else {
                    // 商品名内に[略称タグ]が含まれない場合は[～]を削除
                    $productName = preg_replace('/\[.+?\]/', '', $productName);
                }
                $productName = str_replace('【' . $item['languageCode'] . '/' . $item['conditionCode'] . '】', '', $productName);
                // マッチした各パターンごとに商品名を修正する(色のみの場合は余計なところまで置換する可能性があるため)
                $item['abbreviationColorRarity'] = '';
                if (preg_match(self::COLOR_RARITY_END_PATTERN, $productName, $matchedString)) {
                    $item['abbreviationColorRarity'] = $matchedString[0];
                    $productName = preg_replace(self::COLOR_RARITY_END_PATTERN, '', $productName);
                } elseif (preg_match(self::COLOR_RARITY_BRANCKET_PATTERN, $productName, $matchedString)) {
                    $item['abbreviationColorRarity'] = str_replace('(', '', $matchedString[0]);
                    $productName = preg_replace(self::COLOR_RARITY_BRANCKET_PATTERN, '(', $productName);
                } elseif (preg_match(self::COLOR_RARITY_IN_MIDDLE, $productName, $matchedString)) {
                    $item['abbreviationColorRarity'] = trim($matchedString[0]);
                    $productName = preg_replace(self::COLOR_RARITY_IN_MIDDLE, ' ', $productName);
                } elseif (preg_match(self::COLOR_RARITY_OLD_TOKEN, $productName, $matchedString)) {
                    $item['abbreviationColorRarity'] = str_replace('[', '', $matchedString[0]);
                    $productName = preg_replace(self::COLOR_RARITY_OLD_TOKEN, '[', $productName);
                }
                $c = $class[$item['class1']][$item['class2']];
            } else {
                $c = 'goods';
            }
            $item['product_name'] = $productName;
            $pickingList[$c]['items'][] = $item;
            $pickingList[$c]['total_quantity'] += $item['quantitySubtotal'];
        }

        return $app->render('HareruyaEc/Resource/template/admin/ShippingStandby/picking_list.twig', [
     * @param integer $standbyId
     * @param integer[] $orderIdList
     * @return array
     */
    public function generatePickingList($standbyId, $orderIdList = [])
    {
        $config = $this->getEntityManager()->getConfiguration();
        $config->addCustomStringFunction('GROUP_CONCAT', 'DoctrineExtensions\Query\Mysql\GroupConcat');

        $thresholdPrices = $this->getEntityManager()->getRepository('Plugin\HareruyaEc\Entity\MtbOption')
            ->findByOptionKey([
                MtbOption::ORDER_LIST_THRESHOLD_PRICE_1,
                MtbOption::ORDER_LIST_THRESHOLD_PRICE_2
            ]);

        $qb = $this->createQueryBuilder('ss')
        ->select(
            'CASE WHEN cc IS NOT NULL THEN COUNT(DISTINCT cc.id) ELSE 1 END AS colorCount',
            'CASE WHEN ct IS NOT NULL THEN COUNT(DISTINCT ct.category_id) ELSE 1 END AS categoryCount',
            'od.product_name',
            'SUM(od.quantity) AS polyquantity',
            'pc.price02 AS price',
            'cc.nameJp AS colorName',
            'r.code AS rarityCode',
            'prm.code AS promotionCode',
            'lng.code AS languageCode',
            'ccd.code AS conditionCode',
            'stc.name AS storageCode',
            'MIN(ct.category_id) AS categoryId',
            'sn.name AS shelfNumberName'
        )
        ->addSelect('CASE WHEN od.price < :price1 THEN 1 ELSE 0 END AS class1')
        ->addSelect('CASE WHEN od.price < :price2 THEN 1 ELSE 0 END AS class2')
        ->join('ss.Orders', 'o', 'WITH', 'ss = :standbyId AND o IN (:orders)')
        ->join('o.OrderDetails', 'od')
        ->join('od.Product', 'p')
        ->join('od.ProductClass', 'pc')
        ->join('Plugin\HareruyaEc\Entity\DtbProductSub', 'ps', 'WITH', 'p.id = ps.productId')
        ->join('Plugin\HareruyaEc\Entity\DtbProductSubClass', 'psc', 'WITH', 'pc.id = psc.productClassId')
        ->join('p.ProductCategories', 'ct')
        ->leftJoin('ps.storageCode', 'stc')
        ->leftJoin('ps.cardDetail', 'cd')
        ->leftJoin('psc.language', 'lng')
        ->leftJoin('psc.cardCondition', 'ccd')
        ->leftJoin('psc.shelfNumber', 'sn')
        ->leftJoin('cd.rarity', 'r')
        ->leftJoin('cd.promotion', 'prm')
        ->leftJoin('cd.card', 'c')
        ->leftJoin('c.colors', 'cc')
        ->leftJoin('c.colorSequence', 'cs')
        ->groupBy('pc.id, od.product_name')
        ->setParameters([
            'standbyId' => $standbyId,
            'orders' => $orderIdList,
            'price1' => $thresholdPrices[0]->getOptionValue(),
            'price2' => $thresholdPrices[1]->getOptionValue(),
        ]);

        $this->sortProduct($qb, ['foilFlg']);

        return $qb->getQuery()->getResult();
    }

