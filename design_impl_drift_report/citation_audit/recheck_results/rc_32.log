    /**
     * CSVヘッダーの値が一致するかチェック
     *
     * @param array<int, string> $keys 期待するヘッダーキー
     * @param array<int, string> $columnHeaders CSVのヘッダー行
     * @param array<int, string> $notRequiredHeaders 必須外ヘッダー（比較から除外）
     */
    public function checkHeaderValues(array $keys, array $columnHeaders, array $notRequiredHeaders): void
    {
        $keysFiltered = array_values(array_diff($keys, $notRequiredHeaders));
        $headersFiltered = array_values(array_diff($columnHeaders, $notRequiredHeaders));
        if ($keysFiltered !== $headersFiltered) {
            throw new \RuntimeException($this->translator->trans('admin.csv.error.format.header'));
        }
    }

    /**
     * CSVデータが空でないかチェック
     *
     * @param \Countable $data
     */
    public function checkDataSize(\Countable $data): void
    {
        if ($data->count() < 1) {
            throw new \RuntimeException($this->translator->trans('admin.csv.error.data.empty'));
        }
    }

    /**
     * CSV ヘッダー列数とデータ列数が一致するかチェック
     *
     * @param int $headerSize
     * @param array<string, string> $row
     * @param int $rowIndex
     */
    protected function checkHeaderSize(int $headerSize, array $row, int $rowIndex): void
    {
        if ($headerSize !== count($row)) {
            $message = sprintf(
                $this->translator->trans('admin.csv.error.format.body', [], 'messages'),
                $rowIndex
            );
            throw new \RuntimeException($message);
        }
    }

    /**
     * 必須項目が入力されているかチェック
     *
     * @param array<string, string> $requiredHeaders 必須ヘッダー（表示名 => キー）
     * @param array<string, string> $row
     * @param int $rowIndex
     */
    protected function checkRequiredHeaders(array $requiredHeaders, array $row, int $rowIndex): void
    {
        foreach ($requiredHeaders as $key => $label) {
            $value = $row[$key] ?? '';
            if ((string) $value === '') {
                $message = sprintf(
                    $this->translator->trans('admin.csv.error.data.require', [], 'messages'),
                    $label,
                    $rowIndex
                );
                throw new \RuntimeException($message);
            }
        }
    }

