    /**
     * 出荷実績CSVアップロード画面
     *
     * @param Request $request
     *
     * @return Response
     */
    #[Route(
        path: '/%eccube_admin_route%/order/shipping_result_csv/import',
        name: 'admin_shipping_result_csv_import',
        methods: ['GET'])
    ]
    #[Template(template: '@admin/Order/shipping_result_csv_import.twig')]
    public function shippingResultCsv(Request $request)
    {
        $builder = $this->formFactory->createBuilder(CsvImportType::class);

        $event = new EventArgs(
            [
                'builder' => $builder,
            ],
            $request
        );
        $this->eventDispatcher->dispatch($event, EccubeEvents::ADMIN_ORDER_CSV_SHIPPING_RESULT_CSV_INITIALIZE);

        $form = $builder->getForm();
        $headers = self::CSV_HEADER;

        return $this->render('@admin/Order/shipping_result_csv_import.twig', [
            'form' => $form->createView(),
            'headers' => $headers,
            'errors' => [],
            'warnings' => [],
        ]);
    }

    /**
     * 出荷実績CSVアップロード
     *
     * @param Request $request
     *
     * @return Response
     */
    #[Route(path: '/%eccube_admin_route%/order/shipping_result_csv/import', name: 'admin_shipping_result_csv_upload', methods: ['POST'], ),]
    public function shippingResultImport(Request $request)
    {
        $builder = $this->formFactory->createBuilder(CsvImportType::class);

        $event = new EventArgs(
            [
                'builder' => $builder,
            ],
            $request
        );
        $this->eventDispatcher->dispatch($event, EccubeEvents::ADMIN_ORDER_CSV_SHIPPING_RESULT_CSV_INITIALIZE);

        $form = $builder->getForm();
        $form->handleRequest($request);

        $this->orderCsv->checkFormValid($form);
        $formFile = $this->orderCsv->getFormFile($form);
        if ($formFile === null) {
            $this->orderCsv->render();

            return $this->redirectToRoute('admin_shipping_result_csv_import');
        }

        $data = $this->orderCsv->getImportData($formFile);
        if ($data === false) {
            $this->orderCsv->render();

            return $this->redirectToRoute('admin_shipping_result_csv_import');
        }

        if (!$this->orderRepository->isFree('registerShippingResult')) {
            $this->orderCsv->render();

            $message = trans('admin.csv.error.data.already_executing', ['%csvName%' => '出荷実績CSV']);
            $this->addError($message, 'admin');

            return $this->redirectToRoute('admin_shipping_result_csv_import');
        }

        $lockName = 'registerShippingResult';
        $gainPointDispatch = [];
        $shippingCompleteOrders = [];
        $locked = false;
        try {
            if (!$this->orderRepository->getLock($lockName)) {
                throw new \RuntimeException(trans('admin.csv.error.data.lock_failed'));
            }
            $locked = true;
            // ヘッダーの値が一致するかチェック
            $headers = self::CSV_HEADER;
            $notRequiredCsvHeader = self::NOT_REQUIRED_CSV_HEADER;
            $columnHeaders = $data->getColumnHeaders();
            $this->orderCsv->checkHeaderValues(array_keys($headers), $columnHeaders, array_keys($notRequiredCsvHeader));
            $headerSize = count($columnHeaders);

            // CSVデータが空でないかチェック
            $this->orderCsv->checkDataSize($data);

            $this->entityManager->getConfiguration()->setSQLLogger(null);
            $this->entityManager->beginTransaction();

     * @param CsvImportService<int, array<int|string, string>> $data
     *
     * @return array<int, array{order: Order, player: \Eccube\Entity\DtbPlayer|null}>
     */
    public function registerShippingResult(array $headers, int $headerSize, CsvImportService $data): array
    {
        $requiredHeaders = $this->requiredCsvHeader;

        $updatedOrders = [];
        foreach ($data as $row) {
            $rowIndex = $data->key() + 1;

            // ヘッダーサイズチェック
            $this->checkHeaderSize($headerSize, $row, $rowIndex);
            // CSV必須項目入力チェック
            $this->checkRequiredHeaders($requiredHeaders, $row, $rowIndex);

            $orderNumber = sprintf('%08d', $row['注文番号']);
            $order = $this->orderRepository->findOneBy(['order_number' => $orderNumber]);

            if ($order === null) {
                throw new \RuntimeException(sprintf($this->translator->trans('admin.csv.error.data.not_registered'), '注文番号', $row['注文番号'], $rowIndex));
            }
            if (empty($row['出荷日'])) {
                continue;
            }
            // 非会員の場合エラーを出力
            if ($order->getCustomer() === null) {
                throw new \RuntimeException($this->translator->trans('admin.csv.error.customer.not_member', ['%row%' => $rowIndex]));
            }
            try {
                $shippingDate = new \DateTime($row['出荷日']);
            } catch (\Exception $e) {
                $message = $this->translator->trans('admin.csv.error.exception.datetime', ['%row%' => $rowIndex, '%column%' => '出荷日']);
                throw new \RuntimeException($message, $rowIndex, $e);
            }
            $invoiceNumber = $row['送り状No.'];
            $newStatus = $this->orderStatusRepository->find(OrderStatus::DELIVERED);
            $isPreDeliv = $order->getOrderStatus()?->getId() === OrderStatus::PRE_DELIV;
            if ($isPreDeliv && $order->getShippingDate() === null) {
                $order->setOrderStatus($newStatus);
                $order
                    ->setShippingDate($shippingDate)
                    ->setInvoiceNumber($invoiceNumber);
                $updatedOrders[] = [
                    'order' => $order,
                    'player' => $this->playerRepository->findOneByCustomer($order->getCustomer()),
                ];
            }
            foreach ($order->getShippings() as $shipping) {
                $shipping->setShippingDate($shippingDate);
            }
        }

        $this->entityManager->flush();

        return $updatedOrders;
    }

