    }

    /**
     * 入力CSVファイルをフォームから取得する
     *
     * @param FormInterface $form
     *
     * @return UploadedFile|null
     */
    public function getFormFile(FormInterface $form): ?UploadedFile
    {
        $formFile = $form->get('import_file')->getData();
        if ($formFile === null || $formFile->getSize() === 0) {
            return null;
        }

        return $formFile;
    }

