    /**
     * 商品規格ID配列から、商品規格IDごとに言語、状態、フォイル、フレーム情報を取得
     *
     * @param array<int, mixed> $productClassIds
     *
     * @return array<int, mixed>
     */
    public function getSubInfosByProductClassIds(array $productClassIds): array
    {
        $qb = $this->createQueryBuilder('pc')
            ->join('pc.Language', 'l')
            ->join('pc.CardCondition', 'cc')
            ->join('pc.Product', 'p')
            ->join('p.CardDetail', 'cd');
        $results = $qb->select([
            'pc.id',
            'l.code AS languageCode',
            'l.name_jp AS languageName',
            'cc.code AS conditionCode',
            'cd.foil_flg AS foilFlg',
            'cd.frameFlg AS frameFlg',
        ])
            ->where($qb->expr()->in('pc.id', ':productClassIds'))
            ->setParameter('productClassIds', $productClassIds)
            ->getQuery()
            ->getResult();

        $subInfos = [];
        foreach ($results as $result) {
            $subInfos[$result['id']] = $result;
        }

        return $subInfos;
    }

    /**
     * 商品のサイズリストを取得
     *
     * @param array<int, mixed> $productClassIdList
     *
     * @return int[]
     */
     *
     * @param int $standbyId
     * @param int[] $orderIdList
     *
     * @return array <mixed> $data>>
     */
    public function generatePickingList(int $standbyId, array $orderIdList = []): array
    {
        $option1 = $this->optionRepository->findOneBy([
            'option_key' => MtbOption::ORDER_LIST_THRESHOLD_PRICE_1,
        ]);
        $thresholdPrice1 = $option1 !== null ? (int) $option1->getOptionValue() : 0;

        $option2 = $this->optionRepository->findOneBy([
            'option_key' => MtbOption::ORDER_LIST_THRESHOLD_PRICE_2,
        ]);
        $thresholdPrice2 = $option2 !== null ? (int) $option2->getOptionValue() : 0;

        $qb = $this->createQueryBuilder('ss')
        ->select(
            'CASE WHEN cc.id IS NOT NULL THEN COUNT(DISTINCT cc.id) ELSE 1 END AS colorCount',
            // 重複を除いたカテゴリ数がNULLなら1を返し、NULLでなければその数をcategoryCountとして返す
            'COALESCE(NULLIF(COUNT(DISTINCT ct.category_id), 0), 1) AS categoryCount',
            'oi.product_name',
            'SUM(oi.quantity) AS polyquantity',
            'psc.id AS productClassId',
            'psc.price02 AS price',
            'cc.name_jp AS colorName',
            'r.code AS rarityCode',
            'prm.code AS promotionCode',
            'lng.code AS languageCode',
            'ccd.code AS conditionCode',
            'stc.name AS storageCode',
            'MIN(ct.category_id) AS categoryId',
            'sn.name AS shelfNumberName',
        )
        ->addSelect('CASE WHEN oi.price < :price1 THEN 1 ELSE 0 END AS class1')
        ->addSelect('CASE WHEN oi.price < :price2 THEN 1 ELSE 0 END AS class2')
        ->join('ss.Orders', 'o', 'WITH', 'ss = :standbyId AND o IN (:orders)')
        ->join('o.OrderItems', 'oi')
        ->join('oi.Product', 'p')
        ->Join('oi.ProductClass', 'psc')
        ->leftjoin('p.ProductCategories', 'ct')
        ->leftJoin('p.StorageCode', 'stc')
        ->leftJoin('p.CardDetail', 'cd')
        ->leftJoin('psc.Language', 'lng')
        ->leftJoin('psc.CardCondition', 'ccd')
        ->leftJoin('psc.ShelfNumber', 'sn')
        ->leftJoin('cd.Rarity', 'r')
        ->leftJoin('cd.Promotion', 'prm')
        ->leftJoin('cd.Card', 'c')
        ->leftJoin('c.Colors', 'cc')
        ->leftJoin('c.ColorSequence', 'cs')
        ->groupBy('cc.id')
        ->addGroupBy('oi.product_name')
        ->addGroupBy('oi.quantity')
        ->addGroupBy('psc.price02')
        ->addGroupBy('cc.name_jp')
        ->addGroupBy('r.code')
        ->addGroupBy('prm.code')
        ->addGroupBy('lng.code')
        ->addGroupBy('ccd.code')
        ->addGroupBy('psc.id')
        ->addGroupBy('stc.name')
        ->addGroupBy('sn.name')
        ->addGroupBy('oi.price')
        ->addGroupBy('stc.rank')
        ->addGroupBy('lng.id')
        ->addGroupBy('cd.foil_flg')
        ->addGroupBy('r.id')
        ->addGroupBy('stc.alphabet_sort_flg')
        ->addGroupBy('cd.card_no')
        ->addGroupBy('cs.sort_no')
        ->addGroupBy('c.name_en')
        ->addGroupBy('cd.id')
        ->addGroupBy('sn.sortNo')
        ->addGroupBy('psc.CardCondition')
        ->setParameter('standbyId', $standbyId)
        ->setParameter('orders', $orderIdList)
        ->setParameter('price1', $thresholdPrice1)
        ->setParameter('price2', $thresholdPrice2)
        ;

        $this->sortProduct($qb, ['foilFlg']);

        $result = [];
