     3	namespace Plugin\HareruyaEc\Controller;
     4	use Eccube\Application;
     5	use Symfony\Component\Form\FormInterface;
     6	use Symfony\Component\HttpKernel\Exception\AccessDeniedHttpException;
     7	use Symfony\Component\Security\Csrf\CsrfToken;
     8	use Eccube\Common\Constant;
     9	
    10	trait FormValidHelper
    11	{
    12	
    13	    /**
    14	     * @param Application $app
    15	     * @param FormInterface $form
    16	     * @return boolean
    17	     */
    18	    private function isFormValid($app, FormInterface $form)
    19	    {
    20	        $this->checkCsrfValid($app, $form);
    21	
    22	        return $form->isValid();
    23	    }
    24	
    25	    /**
    26	     * @param Application $app
    27	     * @param FormInterface $form or null
    28	     */
    29	    private function refreshToken($app, FormInterface $form = null)
    30	    {
    31	        $tokenId = is_null($form) ? Constant::TOKEN_NAME : $form->getName();
    32	        $app['form.csrf_provider']->refreshToken($tokenId);
    33	    }
    34	
    35	    /**
    36	     * @param Application $app
    37	     * @param FormInterface $form or null
    38	     */
    39	    private function checkCsrfValid($app, FormInterface $form = null)
    40	    {
    41	        $tokenId = is_null($form) ? Constant::TOKEN_NAME : $form->getName();
    42	        $token = is_null($form) ? $app['request']->request->get($tokenId) : $app['request']->request->get($tokenId)[Constant::TOKEN_NAME];
    43	
    44	        if (!$app['form.csrf_provider']->isTokenValid(new CsrfToken($tokenId, $token))) {
    45	            throw new AccessDeniedHttpException('CSRF token is invalid.');
    46	        }
    47	
    48	        $this->refreshToken($app, $form);
    49	    }
    50	
    51	}

