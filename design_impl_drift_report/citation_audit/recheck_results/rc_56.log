   105	                'form' => $form->createView(),
   106	                'mainCardModalForm' => $mainCardModalForm->createView(),
   107	                'cardImage' => $cardImage,
   108	                'id' => $id
   109	            ]);
   110	        }
   111	
   112	        $dtbArchetype->setCardImage($cardImage);
   113	
   114	        $app['orm.em']->persist($dtbArchetype);
   115	        $app['orm.em']->flush();
   116	        $app->addSuccess('admin.register.complete', 'admin');
   117	
   118	        return $app->redirect($app->url('admin_archetype_edit', ['id' => $dtbArchetype->getArchetypeId()]));
   119	    }
   120	
   121	    /**
   122	     * 代表カードを検索する
   123	     *
   124	     * @param Application $app
   125	     * @param Request $request
   126	     * @return \Symfony\Component\HttpFoundation\Response
   127	     */
   128	    public function searchMainCardHtml(Application $app, Request $request, $page_no = null)
   129	    {
   130	        $pageNo = $page_no;
   131	        $session = $request->getSession();
   132	        $data = [];
   133	        $pagination = [];
   134	        if ($request->isXmlHttpRequest()) {
   135	            $pageCount = $app['config']['default_page_count'];
   136	            // フォーム取得
   137	            $builder = $app['form.factory']->createBuilder('admin_search_card');
   138	            // 検索ボタンから遷移
   139	            if ('POST' === $request->getMethod()) {
   140	                $pageNo = 1;
   141	                $searchData = [
   142	                    'multi' => $request->get('search_word'),
   143	                    'cardName' => $request->get('search_name'),
   144	                    'perfectMatch' => $request->get('perfect_match'),
   145	                    'cardText' => $request->get('search_text'),
   146	                ];
   147	                // Sessionに追加
   148	                $session->set('admin.archetype.main_card.search', $searchData);
   149	                $session->set('admin.archetype.main_card.search.page_no', $pageNo);
   150	            // ページ番号からの遷移
   151	            } else {
   152	                $searchData = (array)$session->get('admin.archetype.main_card.search');
   153	                // ページ番号が取得できない場合Sessionから取得
   154	                if (is_null($pageNo)) {
   155	                    $pageNo = intval($session->get('admin.archetype.main_card.search.page_no'));
   156	                } else {
   157	                    $session->set('admin.archetype.main_card.search.page_no', $pageNo);
   158	                }
   159	            }
   160	
   161	            // 代表カード検索
   162	            $qb = $app['hareruya_ec.repository.card_image']->getCardImagesBySearchData($searchData);
   163	            $pagination = $app['paginator']()->paginate(
   164	                $qb,
   165	                $pageNo,
   166	                $pageCount,
   167	                ['wrap-queries' => true]
   168	            );
   169	        }
   170	
   171	        return $app->render('HareruyaEc/Resource/template/admin/Archetype/search_main_card.twig', [
   172	            'pagination' => $pagination,
   173	            'modal' => ($request->get('modal') === 'true'),
   174	        ]);
   175	    }
   176	
   177	    /**
   178	     * カード画像IDをもとに結果表示に必要な情報を得る
   179	     *
   180	     * @param Application $app
   181	     * @param Request $request
   182	     * @return \Symfony\Component\HttpFoundation\jsonResponse
   183	     */
   184	    public function searchMainCardById(Application $app, Request $request)
   185	    {
   186	        $data = [];
   187	        if ($request->isXmlHttpRequest()) {
   188	            // 検索
   189	            $cardImage = $app['hareruya_ec.repository.card_image']->find($request->get('id'));
   190	            if (is_null($cardImage)) {
   191	                return $app->json([], 404);
   192	            }
   193	
   194	            $data['name'] = $cardImage->getCardDetail()->getCard()->getMixName();
   195	            $data['imageId'] = $request->get('id');
   196	            $data['imageUrl'] =  $cardImage->getUrl();
   197	        }
   198	
   199	        return $app->json($data);
   200	    }
   201	
   202	    /**
   203	     * アーキタイプ削除
   204	     *
   205	     * @param Application $app
   206	     * @param Request $request
   207	     * @return \Symfony\Component\HttpFoundation\jsonResponse
   208	     */
   209	    public function delete(Application $app, Request $request, $id = null)
   210	    {
   211	        $this->checkCsrfValid($app);
   212	        $this->app = $app;
   213	
   214	        if (is_null($id) || !$mtbArchetype = $app['hareruya_ec.repository.archetype']->find($id)) {
   215	            return $app->abort(404);
   216	        }
   217	        if ($app['hareruya_ec.repository.archetype']->getDeckCountOfArchetype(['id' => $id]) > 0) {
   218	            $app->addError('admin.archetype.delete.failed', 'admin');
   219	
   220	            return $app->redirect($app->url('admin_archetype_search', ['page_no' => 1]));
   221	        }
   222	
   223	        // dtb_archetype削除
   224	        $app['orm.em']->remove($mtbArchetype);
   225	        $app['orm.em']->flush($mtbArchetype);
   226	
   227	        $app->addSuccess('admin.delete.complete', 'admin');
   228	        $pageNo = $request->getSession()->get("admin.{$this->sessionKey}.search.page_no");
   229	
   230	        return !empty($pageNo) ? $app->redirect($app->url('admin_archetype_search', ['page_no' => $pageNo ])) : $app->redirect($app->url('admin_archetype_list'));
   231	    }
   232	
   233	    /**
   234	     * ソート参照用のレポジトリをセットする
   235	     * @param Application $app
   236	     */
   237	    protected function setRepository(Application $app)
   238	    {
   239	        $this->repository = $app['hareruya_ec.repository.archetype'];
   240	    }
   241	}
     1	{% extends 'default_frame.twig' %}
     2	
     3	{% set menus = ['deck_menu', 'archetype_list'] %}
     4	
     5	{% block title %}アーキタイプ管理{% endblock %}
     6	{% block sub_title %}
     7	<a href="{{ url('admin_archetype_new') }}">
     8	    <button type="button" id="edit" class="btn btn-primary btn-sm edit">{{ trans('admin.btn.new') }}</button>
     9	</a>
    10	<a href="{{ url('admin_archetype_csv') }}">
    11	    <button type="button" id="csvimport" class="btn btn-primary btn-sm edit">{{ trans('admin.btn.csvimport') }}</button>
    12	</a>
    13	{% endblock %}
    14	    {% form_theme searchForm 'Form/bootstrap_3_horizontal_layout.html.twig' %}
    15	
    16	{% block stylesheet %}
    17	    <link href="https://cdnjs.cloudflare.com/ajax/libs/select2/4.0.6-rc.0/css/select2.min.css" rel="stylesheet" />
    18	    <link href="{{ app.config.root_urlpath }}/admin/assets/css/eventlist.css" rel="stylesheet" />
    19	{% endblock stylesheet %}
    20	
    21	{% block javascript %}
    22	    <script src="https://cdnjs.cloudflare.com/ajax/libs/select2/4.0.6-rc.0/js/select2.min.js"></script>
    23	    <script src="{{ app.config.root_urlpath }}/admin/assets/js/archetype-search.js"></script>
    24	    <script src="{{ app.config.root_urlpath }}/admin/assets/js/sort-method-display.js"></script>
    25	{% endblock javascript %}
    26	
    27	{% block main %}
    28	    <form name="search_form" id="search_form" method="post" action="{{ url('admin_archetype_search', { 'page_no': 1}) }}">
    29	        <!--検索条件設定テーブルここから-->
    30	        <div id="search_wrap" class="search-box">
    31	            <div id="search_box" class="row">
    32	                <div id="search_box_main" class="col-md-12 accordion">
    33	                    {{ form_widget(searchForm.multi, { attr: { placeholder: trans('form.archetype.multi.label'), class : 'input_search' } } ) }}
    34	                    <a id="search_box_main__toggle" href="#" class="toggle"><svg class="cb cb-minus"> <use xlink:href="#cb-minus"/></svg> <svg class="cb cb-minus"> <use xlink:href="#cb-minus"/></svg></a>
    35	                    <div id="search_box_main__body" class="search-box-inner accpanel">
    36	                        <div class="row">
    37	                            <div id="format" class="col-xs-12 col-md-6">
    38	                                <label class="col-xs-12 col-md-12">{{ trans('form.format.label') }}</label>
    39	                                <div class="col-xs-12 col-md-12">
    40	                                    {{ form_widget(searchForm.format) }}
    41	                                </div>
    42	                            </div>
    43	                            <div class="col-xs-12 col-md-6">
    44	                                <div id="archetype_color" class="form-group">
    45	                                    <label class="col-xs-12 col-md-12" >{{ trans('form.color.label') }}</label>
    46	                                    <div class="col-xs-12 col-md-12">
    47	                                        {{ form_widget(searchForm.colors) }}
    48	                                    </div>
    49	                                </div>
    50	                            </div>
    51	                        </div>
    52	                        <div class="row">
    53	                            <div id="deck_tag" class="col-xs-12 col-md-6">
    54	                                <label class="col-xs-12 col-md-12">{{ trans('form.deck_tag.label') }}</label>
    55	                                <div class="col-xs-12 col-md-12">
    56	                                    {{ form_widget(searchForm.deckTags) }}
    57	                                </div>
    58	                            </div>
    59	                            <div id="old_archetype_id" class="col-xs-12 col-md-6">
    60	                                <label class="col-xs-12 col-md-12">{{ trans('form.archetype.old_archetype_id.label') }}</label>
    61	                                <div class="col-xs-12 col-md-12">
    62	                                    {{ form_widget(searchForm.oldArchetypeId) }}
    63	                                </div>
    64	                            </div>
    65	                        </div>
    66	                    </div>
    67	                </div>
    68	            </div>
    69	            <div id="search_box_footer" class="row btn_area">
    70	                <div id="search_box_footer__button_area" class="col-xs-8 col-xs-offset-2 col-sm-4 col-sm-offset-4 text-center">
    71	                    <button type="submit" class="btn btn-primary btn-block btn-lg">
    72	                        {{ trans('search.excute') }} <svg class="cb cb-angle-right"><use xlink:href="#cb-angle-right"></svg>
    73	                    </button>
    74	                </div>
    75	            </div>
    76	        </div>
    77	        <!--検索条件設定テーブルここまで-->
    78	        <div id="result_list_main" class="box">
    79	            {% if pagination and pagination.totalItemCount > 0 %}
    80	                <div id="result_list_main__header" class="box-header with-arrow">
    81	                    <h3 class="box-title">検索結果 <span class="normal"><strong>{{ pagination.totalItemCount }} 件</strong> が該当しました</span></h3>
    82	                </div><!-- /.box-header -->
    83	                <div id="result_list_main__body" class="box-body">
    84	                    <div id="result_list_main__menu" class="row">
    85	                        <div class="col-xs-12 col-md-12">
    86	                            <ul class="sort-dd">
    87	                                <li id="result_list_main__pagemax_menu" class="dropdown">
    88	                                    {% for pageMax in pageMaxis if pageMax.name == page_count %}
    89	                                        <a class="dropdown-toggle" data-toggle="dropdown">{{ pageMax.name|e }}件<svg class="cb cb-angle-down icon_down"><use xlink:href="#cb-angle-down"></svg></a>
    90	                                    {% endfor %}
    91	                                    <ul class="dropdown-menu">
    92	                                        {% for pageMax in pageMaxis if pageMax.name != page_count %}
    93	                                            <li><a href="{{ path('admin_archetype_search', {'page_no': 1, 'page_count': pageMax.name}) }}">{{ pageMax.name|e }}件</a></li>
    94	                                        {% endfor %}
    95	                                    </ul>
    96	                                </li>
    97	                                <li id="result_list_main__sort_menu" class="dropdown">
    98	                                    <a class="dropdown-toggle" data-toggle="dropdown">
    99	                                        {{ trans('admin.btn.sort') }}：{{ trans('admin.btn.archetype.' ~ sort_key) }} | {{ trans('admin.btn.' ~ order_key) }}
   100	                                        <svg class="cb cb-angle-down icon_down"><use xlink:href="#cb-angle-down"></svg>
   101	                                    </a>
   102	                                    <ul class="dropdown-menu">
   103	                                    {% for sortKey in sortKeys %}
   104	                                        <li id="toggle-{{ sortKey }}" class="toggle-sort-key" data-name="{{ sortKey }}">
   105	                                            <a data-toggle="dropdown">{{ trans('admin.btn.archetype.' ~ sortKey) }}</a>
   106	                                        </li>
   107	                                            <ul class="dropdown-menu dropdown-menu-sort sub" id="dropdown-menu-{{ sortKey }}">
   108	                                                <li><a href="{{ url('admin_archetype_search', {'page_no': 1, 'sort': sortKey, 'order': 'ASC'}) }}">{{ trans('admin.btn.ASC') }}</a></li>
   109	                                                <li><a href="{{ url('admin_archetype_search', {'page_no': 1, 'sort': sortKey, 'order': 'DESC'}) }}">{{ trans('admin.btn.DESC') }}</a></li>
   110	                                            </ul>
   111	                                    {% endfor %}
   112	                                    </ul>
   113	                                </li>
   114	                            </ul>
   115	                        </div>
   116	                    </div>
   117	
   118	                    {% if pagination %}
   119	                        <div id="result_list_main" class="box">
   120	                            <div id="result_list__body" class="box-body no-padding">
   121	                                <div id="result_list__menu" class="row">
   122	                                </div>
   123	                                <div id="result_list__list" class="item_list">
   124	                                    <div class="tableish tableish-striped">
   125	                                        <table class="table table-striped">
   126	                                            <thead>
   127	                                                <tr>
   128	                                                    <th rowspan="2">代表カード画像</th>
   129	                                                    <th>ID</th>
   130	                                                    <th>アーキタイプ名</th>
   131	                                                    <th>アーキタイプカラー</th>
   132	                                                    <th>フォーマット名</th>
   133	                                                    <th>登録デッキ数</th>
   134	                                                    <th rowspan="2">&nbsp;</th>
   135	                                                </tr>
   136	                                                <tr>
   137	                                                    <th colspan="5">アーキタイプ説明</th>
   138	                                                </tr>
   139	                                            </thead>
   140	                                            <tbody>
   141	                                            {% for data in pagination %}
   142	                                                <tr>
   143	                                                    <td rowspan="2">
   144	                                                        {% if data.url %}
   145	                                                        <img src="{{ image_path(data.url) }}" width="100px" />
   146	                                                        {% endif %}
   147	                                                    </td>
   148	                                                    <td>{{ data.archetypeId }}</td>
   149	                                                    <td><a href="{{ url('admin_archetype_edit', {id: data.archetypeId}) }}" >{{ data.archetypeNameJp }} / {{ data.archetypeNameEn }}</a></td>
   150	                                                    <td>{{ data.colorNames }}</td>
   151	                                                    <td>{{ data.formatName }}</td>
   152	                                                    <td>{{ data.registeredDeckCount }}</td>
   153	                                                    <td class="icon_edit" rowspan="2">
   154	                                                        <div class="dropdown">
   155	                                                            <a class="dropdown-toggle" data-toggle="dropdown" aria-expanded="false"><svg class="cb cb-ellipsis-h"> <use xlink:href="#cb-ellipsis-h" /></svg></a>
   156	                                                            <ul class="dropdown-menu dropdown-menu-right">
   157	                                                                <li><a href="{{ url('admin_archetype_delete', {id: data.archetypeId}) }}" {{ csrf_token_for_anchor() }} data-method="delete" data-message="{{ trans('admin.confirm.delete')|format(data.archetypeNameJp) }}">{{ trans('admin.btn.delete') }}</a></li>
   158	                                                            </ul>
   159	                                                        </div>
   160	                                                    </td>
   161	                                                </tr>
   162	                                                <tr>
   163	                                                    <td colspan="5">{{ data.commentJp }}</td>
   164	                                                </tr>
   165	                                            {% endfor %}
   166	                                            </tbody>
   167	                                        </table>
   168	                                    </div>
   169	                                </div>
   170	                            </div><!-- /.box-body -->
   171	                        {% if pagination.totalItemCount > 0 %}
   172	                            {% include "pager.twig" with { 'pages' : pagination.paginationData, 'routes' : 'admin_archetype_search' } %}
   173	                        {% endif %}
   174	                        </div><!-- /.box -->
   175	                    {% endif %}
   176	                </div>
   177	            {% else %}
   178	                {% if pagination.totalItemCount is defined %}
   179	                    <div id="result_list_main__header" class="box-header with-arrow">
   180	                    <h3 class="box-title">検索条件に該当するデータがありませんでした。</h3>
   181	                    </div><!-- /.box-header -->
   182	                {% endif %}
   183	            {% endif %}
   184	        </div>
   185	    </form>
   186	{% endblock main %}

diff --git a//tmp/extract_rc56_images.py b//tmp/extract_rc56_images.py
new file mode 100644
index 0000000000000000000000000000000000000000..f7681c06b1c537ba6150dba70165867df0f9ae49
--- /dev/null
+++ b//tmp/extract_rc56_images.py
@@ -0,0 +1,27 @@
+import base64
+import re
+from pathlib import Path
+
+
+source = Path(
+    "/home/y-saito/Developments/hareruya-design-docs/"
+    "excel_to_html/output/0212_基本設計仕様書(デッキ管理).html"
+)
+output = Path("/tmp/rc56_layout_images")
+output.mkdir(exist_ok=True)
+html = source.read_text(encoding="utf-8")
+
+for sheet_id in (7, 9, 10, 11):
+    start = html.index(f'<section class="sheet-panel" id="sheet-{sheet_id}">')
+    next_match = re.search(r'<section class="sheet-panel" id="sheet-\d+">', html[start + 1 :])
+    end = start + 1 + next_match.start() if next_match else len(html)
+    section = html[start:end]
+    images = re.findall(
+        r'<img[^>]+src="data:image/([^;]+);base64,([^"]+)"',
+        section,
+    )
+    for index, (extension, payload) in enumerate(images, 1):
+        suffix = "jpg" if extension == "jpeg" else extension
+        target = output / f"sheet-{sheet_id}-{index}.{suffix}"
+        target.write_bytes(base64.b64decode(payload))
+        print(target)

