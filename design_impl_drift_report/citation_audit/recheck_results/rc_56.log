    31	class SearchArchetypeType extends AbstractType
    32	{
    33	    public function __construct(private readonly EccubeConfig $eccubeConfig)
    34	    {
    35	    }
    36	
    37	    public function buildForm(FormBuilderInterface $builder, array $options): void
    38	    {
    39	        $builder
    40	            ->add('multi', TextType::class, [
    41	                'label' => 'admin.archetype.archetype_name',
    42	                'required' => false,
    43	                'constraints' => [
    44	                    new Assert\Length(['max' => $this->eccubeConfig['eccube_stext_len']]),
    45	                ],
    46	            ])
    47	            ->add('formats', EntityType::class, [
    48	                'class' => MtbFormat::class,
    49	                'choice_label' => 'name_jp',
    50	                'label' => 'admin.archetype.format',
    51	                'required' => false,
    52	                'multiple' => true,
    53	                'attr' => ['class' => 'select2-select'],
    54	                'query_builder' => function (EntityRepository $er) {
    55	                    return $er->createQueryBuilder('f')
    56	                        ->orderBy('f.rank', 'ASC')
    57	                        ->addOrderBy('f.id', 'ASC');
    58	                },
    59	            ])
    60	            ->add('colors', EntityType::class, [
    61	                'class' => MtbColor::class,
    62	                'choice_label' => 'name_jp',
    63	                'label' => 'admin.archetype.color',
    64	                'label_attr' => ['class' => 'checkbox-inline'],
    65	                'required' => false,
    66	                'multiple' => true,
    67	                'expanded' => true,
    68	            ])
    69	            ->add('deck_tags', EntityType::class, [
    70	                'class' => MtbDeckTag::class,
    71	                'choice_label' => 'nameJp',
    72	                'label' => 'admin.archetype.deck_tag',
    73	                'required' => false,
    74	                'multiple' => true,
    75	                'attr' => ['class' => 'select2-select'],
    76	            ])
    77	            ->add('sortKey', HiddenType::class, [
    78	                'attr' => ['class' => 'hidden_sort_key'],
    79	            ])
    80	            ->add('sortOrder', HiddenType::class, [
    81	                'attr' => ['class' => 'hidden_sort_order'],
    82	            ])
    83	        ;
    84	    }
    85	
    86	    public function configureOptions(OptionsResolver $resolver): void
    87	    {
    88	        $resolver->setDefaults([
    89	            'csrf_protection' => true,
    90	            'allow_extra_fields' => true,
    91	        ]);
    92	    }
    93	
    94	    public function getBlockPrefix(): string
    95	    {
    96	        return 'admin_search_archetype';
    97	    }
    98	}
    45	    use SearchControllerTrait;
    46	
    47	    public function __construct(
    48	        protected PaginatorInterface $paginator,
    49	        protected readonly PageMaxRepository $pageMaxRepository,
    50	        protected readonly CsrfTokenManagerInterface $csrfTokenManager,
    51	        private readonly EntityManagerInterface $archetypeEntityManager,
    52	        private readonly DtbArchetypeRepository $archetypeRepository,
    53	        private readonly ArchetypeStoreAction $storeAction,
    54	        private readonly ArchetypeDeleteAction $deleteAction,
    55	    ) {
    56	        $this->repository = $this->archetypeRepository;
    57	        $this->sessionKey = 'archetype';
    58	        $this->formType = SearchArchetypeType::class;
    59	        $this->formName = 'admin_search_archetype';
    60	        $this->defaultOrder = 'DESC';
