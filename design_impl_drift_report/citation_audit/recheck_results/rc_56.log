+++ b//tmp/extract_rc56_images.py
@@ -0,0 +1,27 @@
+import base64
+import re
+from pathlib import Path
+
+
+source = Path(
+    "/home/y-saito/Developments/hareruya-design-docs/"
+    "excel_to_html/output/0212_基本設計仕様書(デッキ管理).html"
+)
+output = Path("/tmp/rc56_layout_images")
+output.mkdir(exist_ok=True)
+html = source.read_text(encoding="utf-8")
+
+for sheet_id in (7, 9, 10, 11):
+    start = html.index(f'<section class="sheet-panel" id="sheet-{sheet_id}">')
+    next_match = re.search(r'<section class="sheet-panel" id="sheet-\d+">', html[start + 1 :])
+    end = start + 1 + next_match.start() if next_match else len(html)
+    section = html[start:end]
+    images = re.findall(
+        r'<img[^>]+src="data:image/([^;]+);base64,([^"]+)"',
+        section,
+    )
+    for index, (extension, payload) in enumerate(images, 1):
+        suffix = "jpg" if extension == "jpeg" else extension
+        target = output / f"sheet-{sheet_id}-{index}.{suffix}"
+        target.write_bytes(base64.b64decode(payload))
+        print(target)

