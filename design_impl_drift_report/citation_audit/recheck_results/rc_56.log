    22	class ArchetypeDeleteAction
    23	{
    24	    public function __construct(
    25	        private readonly EntityManagerInterface $entityManager,
    26	        private readonly ArchetypeEntityManager $archetypeEntityManager,
    27	    ) {
    28	    }
    29	
    30	    /**
    31	     * @throws \RuntimeException アーキタイプに紐付くデッキが存在する場合
    32	     * @throws \Exception 削除処理で例外が発生した場合
    33	     */
    34	    public function handle(DtbArchetype $Archetype): void
    35	    {
    36	        $deckCount = (int) $this->entityManager->createQueryBuilder()
    37	            ->select('COUNT(d.id)')
    38	            ->from(\Eccube\Entity\DtbDeck::class, 'd')
    39	            ->where('d.Archetype = :archetype')
    40	            ->setParameter('archetype', $Archetype)
    41	            ->getQuery()
    42	            ->getSingleScalarResult();
    43	
    44	        if ($deckCount > 0) {
    45	            throw new \RuntimeException('admin.archetype.delete_error_deck_exists');
    46	        }
    47	
    48	        $this->entityManager->beginTransaction();
    49	        try {
    50	            $this->archetypeEntityManager->delete($Archetype);
    51	            $this->entityManager->flush();
    52	            $this->entityManager->commit();
    53	        } catch (\Exception $e) {
    54	            $this->entityManager->rollback();
    55	            throw $e;
    56	        }
    57	    }
    58	}
