4735-                <tr id="item-sheet-18-16"><td><a class="item-no" href="#pin-sheet-18-16"><span class="src-cell" data-excel-book="0207" data-excel-sheet="オンライン本人確認" data-excel-ref="0207:オンライン本人確認!B75">16</span></a></td><td><span class="src-cell" data-excel-book="0207" data-excel-sheet="オンライン本人確認" data-excel-ref="0207:オンライン本人確認!E75">身分証有効期限</span></td><td><span class="src-cell" data-excel-book="0207" data-excel-sheet="オンライン本人確認" data-excel-ref="0207:オンライン本人確認!M75">日時(yyyy/mm/dd)</span></td><td><span class="src-cell" data-excel-book="0207" data-excel-sheet="オンライン本人確認" data-excel-ref="0207:オンライン本人確認!T75">-</span></td><td><span class="src-cell" data-excel-book="0207" data-excel-sheet="オンライン本人確認" data-excel-ref="0207:オンライン本人確認!V75">-</span></td><td><span class="src-cell" data-excel-book="0207" data-excel-sheet="オンライン本人確認" data-excel-ref="0207:オンライン本人確認!Z75">-</span></td><td></td></tr>
4736-                <tr id="item-sheet-18-17"><td><a class="item-no" href="#pin-sheet-18-17"><span class="src-cell" data-excel-book="0207" data-excel-sheet="オンライン本人確認" data-excel-ref="0207:オンライン本人確認!B76">17</span></a></td><td><span class="src-cell" data-excel-book="0207" data-excel-sheet="オンライン本人確認" data-excel-ref="0207:オンライン本人確認!E76">取消ボタン</span></td><td><span class="src-cell" data-excel-book="0207" data-excel-sheet="オンライン本人確認" data-excel-ref="0207:オンライン本人確認!M76">ボタン</span></td><td><span class="src-cell" data-excel-book="0207" data-excel-sheet="オンライン本人確認" data-excel-ref="0207:オンライン本人確認!T76">-</span></td><td><span class="src-cell" data-excel-book="0207" data-excel-sheet="オンライン本人確認" data-excel-ref="0207:オンライン本人確認!V76">-</span></td><td><span class="src-cell" data-excel-book="0207" data-excel-sheet="オンライン本人確認" data-excel-ref="0207:オンライン本人確認!Z76">-</span></td><td><span class="src-cell" data-excel-book="0207" data-excel-sheet="オンライン本人確認" data-excel-ref="0207:オンライン本人確認!AG76">ポップアップ画面を閉じる</span></td></tr>
