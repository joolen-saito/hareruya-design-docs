diff --git a//tmp/excel_sheet_evidence.py b//tmp/excel_sheet_evidence.py
new file mode 100644
index 0000000000000000000000000000000000000000..86dc7ee4c6a9a2012a6b3075c939dc833c1eb659
--- /dev/null
+++ b//tmp/excel_sheet_evidence.py
@@ -0,0 +1,80 @@
+from __future__ import annotations
+
+import sys
+from html.parser import HTMLParser
+from pathlib import Path
+
+
+class SheetEvidenceParser(HTMLParser):
+    def __init__(self, target_sheet: str) -> None:
+        super().__init__(convert_charrefs=True)
+        self.target_sheet = target_sheet
+        self.section_depth = 0
+        self.in_target = False
+        self.embed_depth = 0
+        self.element_stack: list[tuple[bool, str, list[str]]] = []
+        self.rows: list[tuple[str, str]] = []
+        self.images: list[tuple[str, str]] = []
+
+    def handle_comment(self, data: str) -> None:
+        marker = data.strip()
+        if marker.startswith("function-design-embed:start"):
+            self.embed_depth += 1
+        elif marker.startswith("function-design-embed:end") and self.embed_depth:
+            self.embed_depth -= 1
+
+    def handle_starttag(self, tag: str, attrs: list[tuple[str, str | None]]) -> None:
+        attr = {key: value or "" for key, value in attrs}
+        if tag == "section":
+            if self.in_target:
+                self.section_depth += 1
+            elif attr.get("id") == self.target_sheet:
+                self.in_target = True
+                self.section_depth = 1
+        if not self.in_target:
+            return
+        if tag == "img":
+            self.images.append(
+                (
+                    attr.get("data-excel-ref", ""),
+                    f"class={attr.get('class', '')} alt={attr.get('alt', '')}",
+                )
+            )
+        if tag in {"img", "br", "hr", "input", "meta", "link", "source", "area", "base", "col", "embed", "param", "track", "wbr"}:
+            return
+        is_evidence = (
+            self.embed_depth == 0
+            and ("src-cell" in attr.get("class", "").split() or "data-excel-ref" in attr)
+            and tag != "img"
+        )
+        self.element_stack.append((is_evidence, attr.get("data-excel-ref", ""), []))
+
+    def handle_data(self, data: str) -> None:
+        if self.in_target:
+            for _, _, parts in self.element_stack:
+                parts.append(data)
+
+    def handle_endtag(self, tag: str) -> None:
+        if self.in_target and self.element_stack:
+            is_evidence, ref, parts = self.element_stack.pop()
+            if is_evidence:
+                text = " ".join("".join(parts).split())
+                if text:
+                    self.rows.append((ref, text))
+        if self.in_target and tag == "section":
+            self.section_depth -= 1
+            if self.section_depth == 0:
+                self.in_target = False
+
+
+html_path = Path(sys.argv[1])
+sheet = sys.argv[2]
+terms = sys.argv[3:]
+parser = SheetEvidenceParser(sheet)
+parser.feed(html_path.read_text())
+print(f"IMAGES {len(parser.images)}")
+for ref, alt in parser.images:
+    print(f"IMAGE\t{ref}\t{alt}")
+for ref, text in parser.rows:
+    if not terms or any(term.casefold() in text.casefold() for term in terms):
+        print(f"CELL\t{ref}\t{text}")
