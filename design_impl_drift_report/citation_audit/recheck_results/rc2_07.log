namespace Eccube\Controller\Admin;

use Eccube\Controller\AbstractController;
use Eccube\Entity\Master\CsvType;
use Eccube\Event\EccubeEvents;
use Eccube\Event\EventArgs;
use Eccube\Repository\DtbCsvCsvExtensionRepository;
use Eccube\Repository\DtbCsvExtensionRepository;
use Eccube\Service\CsvExportService;
use Symfony\Component\HttpFoundation\Request;
use Symfony\Component\HttpFoundation\StreamedResponse;
use Symfony\Component\Routing\Attribute\Route;

class CustomExportCsvController extends AbstractController
{
    // CSV種別毎にクエリビルダ・CsvExportServiceのデータ出力関数・ファイルプレフィクスを設定
    public const FUNCTIONS = [
        CsvType::CSV_TYPE_PRODUCT => [
            'queryBuilder' => 'getProductQueryBuilder',
            'exporter' => 'exportProduct',
            'fileName' => 'product_',
        ],
        CsvType::CSV_TYPE_ORDER => [
            'queryBuilder' => 'getOrderQueryBuilder',
            'exporter' => 'exportOrder',
            'fileName' => 'order_',
        ],
        CsvType::CSV_TYPE_SHIPPING => [
            'queryBuilder' => 'getOrderQueryBuilder',
            'exporter' => 'exportShipping',
            'fileName' => 'shipping_',
        ],
        CsvType::CSV_TYPE_STOCK => [
            'queryBuilder' => 'getStockQueryBuilder',
            'exporter' => 'exportStock',
            'fileName' => 'stock_',
        ],
    ];

    /**
     * OrderController constructor.
     *
     * @param CsvExportService $csvExportService
     * @param DtbCsvExtensionRepository $dtbCsvExtensionRepository
     * @param DtbCsvCsvExtensionRepository $dtbCsvCsvExtensionRepository
     */
    public function __construct(protected CsvExportService $csvExportService, protected DtbCsvExtensionRepository $dtbCsvExtensionRepository, protected DtbCsvCsvExtensionRepository $dtbCsvCsvExtensionRepository)
    {
    }

    /**
     * カスタムCSV出力
     * 商品・受注・配送・在庫共通のCSV出力を行う。
     *
     * @param int $csvExtensionId
     *
     * @return StreamedResponse
     */
    #[Route(path: '/%eccube_admin_route%/custom_csv/export/{csvExtensionId}', name: 'admin_custom_export', methods: ['GET', 'POST'])]
    public function index(Request $request, int $csvExtensionId): StreamedResponse
    {
        if (!$CsvExtension = $this->dtbCsvExtensionRepository->find($csvExtensionId)) {
            throw $this->createNotFoundException();
        }
        $CsvExtension->setCsvs($this->dtbCsvCsvExtensionRepository->findCsvOrderbyRank($csvExtensionId));
        set_time_limit(0);
        // sql loggerを無効にする.
        $em = $this->entityManager;
        $em->getConfiguration()->setSQLLogger(null);

        $CsvType = $CsvExtension->getCsvType();

        $response = new StreamedResponse();
        $response->setCallback(function () use ($request, $CsvExtension, $CsvType) {
            // CSV拡張情報を元に初期化.
            $this->csvExportService->setCsvsAndCsvType($CsvExtension);
            // ヘッダ行の出力.
            $this->csvExportService->exportHeader();
            // クエリビルダを取得.
            $qb = $this->csvExportService->{self::FUNCTIONS[$CsvType->getId()]['queryBuilder']}($request);
            // データ行の出力.
            $this->csvExportService->setExportQueryBuilder($qb);
            $this->csvExportService->exportData(function ($entity, CsvExportService $csvService) use ($request, $CsvExtension) {
                $this->csvExportService->{self::FUNCTIONS[$CsvExtension->getCsvType()->getId()]['exporter']}($entity, $csvService, $request);
            });
        });

        $now = new \DateTime();
        $filename = self::FUNCTIONS[$CsvType->getId()]['fileName'].$now->format('YmdHis').'.csv';
        $response->headers->set('Content-Type', 'application/octet-stream');
        $response->headers->set('Content-Disposition', 'attachment; filename='.$filename);

        log_info('カスタムCSV出力ファイル名', [$filename]);

        $event = new EventArgs([], $request);
        $this->eventDispatcher->dispatch($event, EccubeEvents::ADMIN_CUSTOM_EXPORT_CSV_EXPORT);

        return $response;
    }
}
use Symfony\Component\OptionsResolver\OptionsResolver;
use Symfony\Component\Validator\Constraints\NotBlank;

class CustomCsvType extends AbstractType
{
    public const CSV_TYPES = [
        CsvType::CSV_TYPE_PRODUCT,
        CsvType::CSV_TYPE_CUSTOMER,
        CsvType::CSV_TYPE_ORDER,
        CsvType::CSV_TYPE_SHIPPING,
        CsvType::CSV_TYPE_STOCK,
        CsvType::CSV_TYPE_STOCK_MOVE,
        CsvType::CSV_TYPE_STOCK_SPLIT,
    ];

    private CsvRepository $csvRepository;

    public function __construct(
        CsvRepository $csvRepository,
    ) {
        $this->csvRepository = $csvRepository;
    /**
     * 在庫情報カスタムCSV出力（M04-01）
     */
    #[Route(path: '/%eccube_admin_route%/product/stock/custom-csv/{csvExtensionId}', name: 'admin_stock_list_custom_csv', requirements: ['csvExtensionId' => '\d+'], methods: ['GET'])]
    public function exportCustomCsv(Request $request, int $csvExtensionId): StreamedResponse|RedirectResponse
    {
        $viewData = $this->session->get(self::SESSION_KEY_SEARCH, []);
        if ($viewData === []) {
            $this->addError('admin.stock.list.search_required_for_csv', 'admin');

            return $this->redirectToRoute('admin_stock_list');
        }

        /** @var DtbCsvExtension|null $csvExtension */
        $csvExtension = $this->csvExtensionRepository->find($csvExtensionId);
        if ($csvExtension === null || $csvExtension->getCsvType()?->getId() !== CsvType::CSV_TYPE_STOCK) {
            throw $this->createNotFoundException();
        }

        $searchForm = $this->formFactory->createBuilder(SearchStockListType::class)->getForm();
        try {
            $input = StockListSearchInput::fromFormData(FormUtil::submitAndGetData($searchForm, $viewData));
        } catch (\Throwable $e) {
            log_error('在庫カスタムCSV出力: セッションの検索条件が不正なためリセットします', [$e->getMessage()]);
            $this->session->remove(self::SESSION_KEY_SEARCH);
            $this->addError('admin.stock.list.search_required_for_csv', 'admin');

