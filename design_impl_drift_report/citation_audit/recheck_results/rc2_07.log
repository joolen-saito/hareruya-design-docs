use Eccube\Service\Csv\OrderCsv;
use Eccube\Service\CsvExportService;
use Eccube\Service\MailService;
use Eccube\Service\PointService;
use Eccube\Service\Smaregi\SmaregiOrderGainPointEventService;
use Symfony\Bridge\Twig\Attribute\Template;
use Symfony\Component\HttpFoundation\Request;
use Symfony\Component\HttpFoundation\Response;
use Symfony\Component\Routing\Attribute\Route;

class OrderCsvController extends AbstractController
{
    public function __construct(
        protected OrderCsv $orderCsv,
        protected CsvExportService $csvExportService,
        protected OrderRepository $orderRepository,
        protected OrderStatusRepository $orderStatusRepository,
        private readonly PointService $pointService,
        private readonly SmaregiOrderGainPointEventService $smaregiOrderGainPointEventService,
        private readonly MailService $mailService,
    ) {
    }

    public const CSV_HEADER = [
        '注文番号' => '注文番号',
        '会員ID' => '会員ID',
        'お名前(姓)' => 'お名前(姓)',
        'お名前(名)' => 'お名前(名)',
        'お名前(セイ)' => 'お名前(セイ)',
        'お名前(メイ)' => 'お名前(メイ)',
        '会社名' => '会社名',
        '郵便番号1' => '郵便番号1',
        $lockName = 'registerShippingResult';
        $gainPointDispatch = [];
        $shippingCompleteOrders = [];
        $locked = false;
        try {
            if (!$this->orderRepository->getLock($lockName)) {
                throw new \RuntimeException(trans('admin.csv.error.data.lock_failed'));
            }
            $locked = true;
            // ヘッダーの値が一致するかチェック
            $headers = self::CSV_HEADER;
            $notRequiredCsvHeader = self::NOT_REQUIRED_CSV_HEADER;
            $columnHeaders = $data->getColumnHeaders();
            $this->orderCsv->checkHeaderValues(array_keys($headers), $columnHeaders, array_keys($notRequiredCsvHeader));
            $headerSize = count($columnHeaders);

            // CSVデータが空でないかチェック
            $this->orderCsv->checkDataSize($data);

            $this->entityManager->getConfiguration()->setSQLLogger(null);
            $this->entityManager->beginTransaction();

            // CSVファイルの登録処理
            $updatedOrders = $this->orderCsv->registerShippingResult($headers, $headerSize, $data);
            foreach ($updatedOrders as $updateOrder) {
                $this->pointService->gainPoints($updateOrder['order']);
                // 出荷完了メールは commit 後に送る（ロールバック時に送信しない）.
                $shippingCompleteOrders[] = $updateOrder['order'];
                // 発生ポイントのスマレジ連携ジョブを同一トランザクションで積む（dispatch は commit 後）.
                $gainPointJob = $this->smaregiOrderGainPointEventService->registerGainPointJob($updateOrder['order']);
                if ($gainPointJob !== null) {
                    $gainPointDispatch[] = ['job' => $gainPointJob, 'order' => $updateOrder['order']];
                }
            }
            $this->entityManager->flush();
            $this->entityManager->commit();
        } catch (\Throwable $e) {
            if ($this->entityManager->getConnection()->isTransactionActive()) {
                // トランザクション内でエラーが発生した場合はロールバック
                $this->entityManager->rollback();
            }

            $this->addError($e->getMessage(), 'admin');

            $this->orderCsv->render();

            return $this->redirectToRoute('admin_shipping_result_csv_import');
        } finally {
            if ($locked) {
                $this->orderRepository->releaseLock($lockName);
            }
        }

        // commit 成功後に出荷完了メールを送信し、送信日時を記録する.
        $mailSendDateUpdated = false;
        foreach ($shippingCompleteOrders as $Order) {
            // pf: sendShippingCompleteMail(Order) — 受注単位・国内外テンプレ分岐
            if (!$this->mailService->sendShippingCompleteMail($Order)) {
                continue;
            }
            foreach ($Order->getShippings() as $Shipping) {
                $Shipping->setMailSendDate(new \DateTime());
            }
            $mailSendDateUpdated = true;
        }
        if ($mailSendDateUpdated) {
            $this->entityManager->flush();
        }

        // commit 成功後に発生ポイント連携メッセージを送信する（アウトボックス的な順序）。
        // 送信は取込結果と切り離し、失敗しても取込自体は成功として扱う（取込はコミット済み）。
        try {
            foreach ($gainPointDispatch as $gainPointEntry) {
                $this->smaregiOrderGainPointEventService->dispatchGainPointMessage($gainPointEntry['job'], $gainPointEntry['order']);
            }
        } catch (\Throwable $e) {
            log_error('スマレジ発生ポイント連携メッセージの送信に失敗しました', ['error' => $e->getMessage()]);
        }

        $event = new EventArgs(
            [
                'form' => $form,
            ],
            $request
        );
        $this->eventDispatcher->dispatch($event, EccubeEvents::ADMIN_ORDER_CSV_SHIPPING_RESULT_IMPORT_COMPLETE);

        $this->addSuccess('admin.register.complete', 'admin');

        $this->orderCsv->render();

        return $this->redirectToRoute('admin_shipping_result_csv_import');
    }
