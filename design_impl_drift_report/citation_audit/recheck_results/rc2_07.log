+class SheetImageParser(HTMLParser):
+    def __init__(self, target_sheet: str) -> None:
+        super().__init__(convert_charrefs=True)
+        self.target_sheet = target_sheet
+        self.section_depth = 0
+        self.in_target = False
+        self.images: list[dict[str, str]] = []
+
+    def handle_starttag(self, tag: str, attrs: list[tuple[str, str | None]]) -> None:
+        attr = {key: value or "" for key, value in attrs}
+        if tag == "section":
+            if self.in_target:
+                self.section_depth += 1
+            elif attr.get("id") == self.target_sheet:
+                self.in_target = True
+                self.section_depth = 1
+        if self.in_target and tag == "img":
+            self.images.append(attr)
+
+    def handle_endtag(self, tag: str) -> None:
+        if self.in_target and tag == "section":
+            self.section_depth -= 1
+            if self.section_depth == 0:
+                self.in_target = False
 
 
-if __name__ == "__main__":
-    main()
+html_path = Path(sys.argv[1])
+sheet = sys.argv[2]
+output_dir = Path(sys.argv[3])
+parser = SheetImageParser(sheet)
+parser.feed(html_path.read_text())
+output_dir.mkdir(parents=True, exist_ok=True)
+for index, image in enumerate(parser.images, 1):
+    source = image["src"]
+    match = re.fullmatch(r"data:image/([^;,]+);base64,(.*)", source, re.DOTALL)
+    if not match:
+        continue
+    extension = "jpg" if match.group(1) == "jpeg" else match.group(1)
+    output_path = output_dir / f"{html_path.stem}_{sheet}_{index}.{extension}"
+    output_path.write_bytes(base64.b64decode(match.group(2)))
+    print(output_path, image.get("data-excel-ref", ""), image.get("alt", ""))

