   372	    public function delete(Application $app, Request $request, $id = null)
   373	    {
   374	        $this->checkCsrfValid($app);
   375	        $pageNo = $request->getSession()->get("admin.{$this->sessionKey}.search.page_no");
   376	
   377	        $ids = !is_null($id) ? [$id] : $request->request->get('deckId');
   378	
   379	        if (is_null($ids)) {
   380	            return !empty($pageNo) ? $app->redirect($app->url('admin_deck_search', ['page_no' => $pageNo ])) : $app->redirect($app->url('admin_deck_list'));
   381	        }
   382	
   383	        foreach ($ids as $id) {
   384	            if (!$deck = $app['hareruya_ec.repository.deck']->find($id)) {
   385	                return $app->abort(404);
   386	            }
   387	            // 削除可否確認
   388	            // ・記事
   389	            if ($deck->getArticles()->count()) {
   390	                $app->addError('admin.deck.is_used.article', 'admin');
   391	
   392	                return $app->redirect($request->headers->get('referer'));
   393	            }
   394	            // デッキ内カード削除
   395	            foreach ($deck->getDeckCards() as $deckCard) {
   396	                $app['orm.em']->remove($deckCard);
   397	            }
   398	            // 削除者記録
   399	            $deck->setMemberId($app['security']->getToken()->getUser()->getId());
   400	            $app['orm.em']->persist($deck);
   401	            $app['orm.em']->flush();
   402	            // デッキ削除
   403	            $app['orm.em']->remove($deck);
   404	            $app['orm.em']->flush();
   405	        }
   406	        $app->addSuccess('admin.delete.complete', 'admin');
   407	
   408	        return !empty($pageNo) ? $app->redirect($app->url('admin_deck_search', ['page_no' => $pageNo ])) : $app->redirect($app->url('admin_deck_list'));
   409	    }
