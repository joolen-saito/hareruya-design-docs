namespace Eccube\Service\Admin\Event;

use Doctrine\ORM\EntityManagerInterface;
use Eccube\Entity\DtbEventDetail;
use Eccube\Repository\Master\MtbHolidayRepository;
use Eccube\Service\Admin\Event\ActionInput\ScheduleStoreInput;
use Eccube\Service\EntityManager\EventDetailEntityManager;

class ScheduleStoreAction
{
    public function __construct(
        private readonly EntityManagerInterface $entityManager,
        private readonly EventDetailEntityManager $eventDetailEntityManager,
        private readonly MtbHolidayRepository $mtbHolidayRepository,
    ) {
    }

    public function handle(ScheduleStoreInput $input): DtbEventDetail
    {
        $EventDetail = $input->EventDetail;

        $EventDetail = $this->eventDetailEntityManager->save(
            EventDetail: null,
            Event: $input->Event,
            startDate: $EventDetail->getStartDate(),
            endDate: $EventDetail->getEndDate(),
            Disp: $EventDetail->getDisp(),
            Member: $input->Member,
            deadlineFlg: $EventDetail->getDeadlineFlg(),
            deckRegistFlg: $EventDetail->getDeckRegistFlg(),
            entryFlg: $EventDetail->getEntryFlg(),
            holidayFlg: $this->mtbHolidayRepository->isHoliday($EventDetail->getStartDate()),
            entryStartDate: $EventDetail->getEntryStartDate(),
            entryEndDate: $EventDetail->getEntryEndDate(),
            onlineEntryStartDate: $EventDetail->getOnlineEntryStartDate(),
            onlineEntryEndDate: $EventDetail->getOnlineEntryEndDate(),
            deckRegistDeadline: $EventDetail->getDeckRegistDeadline(),
            capacity: $EventDetail->getCapacity(),
            entryFee: $EventDetail->getEntryFee(),
            prizeJp: $EventDetail->getPrizeJp(),
            prizeEn: $EventDetail->getPrizeEn(),
            deletedAt: $EventDetail->getDeletedAt(),
        );

        $input->Event->getDetails()->add($EventDetail);

        $this->entityManager->flush();

        return $EventDetail;
    }
