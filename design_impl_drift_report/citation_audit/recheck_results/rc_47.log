    #[Template(template: '@admin/Event/edit.twig')]
    public function edit(Request $request, DtbEvent $Event, bool $isCopy = false): array
    {
        $Member = $this->getMember();
        if ($isCopy) {
            $Event->setDetails(new ArrayCollection());
        }
        $builder = $this->formFactory->createBuilder(EventType::class, $Event, ['Member' => $Member]);

        $event = new EventArgs(
            [
                'builder' => $builder,
                'Event' => $Event,
            ],
            $request
        );
        $this->eventDispatcher->dispatch($event, EccubeEvents::ADMIN_EVENT_EDIT_INITIALIZE);

        $form = $builder->getForm();
        $form->handleRequest($request);
        $isEditableBaseInfo = $Member->isEditableShop($Event->getBaseInfo());

        if ($form->isSubmitted() && $form->isValid()) {
            /** @var DtbEvent $Event */
            $Event = $form->getData();
            $input = new EventEditInput($Event, $Member, $form->get('payments')->getData() ?? []);
            try {
                $this->eventEditAction->handle($input);

                $event = new EventArgs(
                    [
                        'form' => $form,
                        'Event' => $Event,
                    ],
                    $request
                );
                $this->eventDispatcher->dispatch($event, EccubeEvents::ADMIN_EVENT_EDIT_COMPLETE);

                $this->addSuccess('admin.common.save_complete', 'admin');
            } catch (\Exception $e) {
                $this->addError('admin.common.save_error', 'admin');
            }
        }

        if (!$isCopy && $Event->getId()) {
            $Event->setDetails(new ArrayCollection(
                $this->entityManager->getRepository(DtbEventDetail::class)->findBy(
                    ['Event' => $Event],
                    ['startDate' => 'DESC']
                )
            ));
        }

        $entry = [];
        foreach ($Event->getDetails() as $detail) {
            $entry[$detail->getId()] = 0;
        }
        ];
    }

