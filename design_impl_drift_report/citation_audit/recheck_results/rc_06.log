   100	    public function getByCardName(Request $request): JsonResponse
   101	    {
   102	        $cardName = $request->request->get('name', '');
   103	
   104	        if (empty($cardName)) {
   105	            return new JsonResponse(['cards' => []]);
   106	        }
   107	
   108	        $Member = $this->getUser();
   109	        if (!$Member instanceof Member) {
   110	            throw new UnauthenticatedException('認証エラー');
   111	        }
   112	
   113	        [$storeId, $stockLocationId] = $this->resolveBuyingStockContext($Member);
   114	
   115	        $cards = $this->mtbCardRepository->getBuyingCardsByCardName($cardName, $storeId, $stockLocationId);
   116	
   117	        return new JsonResponse($this->buyingCardsFormatter->format($cards));
   118	    }
