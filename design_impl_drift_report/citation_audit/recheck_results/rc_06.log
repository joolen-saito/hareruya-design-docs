    24	class UpdateDoubleCheckMemberAction
    25	{
    26	    public function __construct(
    27	        private readonly EntityManagerInterface $entityManager,
    28	        private readonly LoggerInterface $logger,
    29	        private readonly OtcBuyOrderApproverEntityManager $otcBuyOrderApproverEntityManager,
    30	    ) {
    31	    }
    32	
    33	    public function handle(UpdateDoubleCheckMemberInput $input): void
    34	    {
    35	        // 更新者とダブルチェック者が同じ場合はエラーを返す
    36	        if ($input->Member->getId() === $input->DoubleCheckMember->getId()) {
    37	            throw new InvalidMemberAssignmentException('更新者とダブルチェック者に同一のメンバーを割り当てることはできません');
    38	        }
    39	
    40	        $this->entityManager->beginTransaction();
    41	        try {
    42	            $input->OtcBuyOrder
    43	                ->setMember($input->Member)
    44	                ->setUpdateDate(new \DateTime());
    45	            $this->entityManager->persist($input->OtcBuyOrder);
    46	
    47	            $this->otcBuyOrderApproverEntityManager->saveDoubleCheckApproval($input->OtcBuyOrder, $input->DoubleCheckMember, $input->Member);
    48	
    49	            $this->entityManager->flush();
    50	            $this->entityManager->commit();
    51	        } catch (\Exception $e) {
    52	            $this->entityManager->rollback();
    53	            $this->logger->error('Failed to update double check member', ['exception' => $e, 'otcBuyOrderId' => $input->OtcBuyOrder->getId(), 'memberId' => $input->Member->getId(), 'doubleCheckMemberId' => $input->DoubleCheckMember->getId()]);
    54	            throw new \RuntimeException('システムエラーが発生しました');
    55	        }
    56	    }
    57	}
