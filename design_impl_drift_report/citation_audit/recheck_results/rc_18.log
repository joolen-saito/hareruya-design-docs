diff --git a//tmp/extract_rc18_images.py b//tmp/extract_rc18_images.py
new file mode 100644
index 0000000000000000000000000000000000000000..f1ec25f6d47c3337cb66f7b69fa56c24b119d67a
--- /dev/null
+++ b//tmp/extract_rc18_images.py
@@ -0,0 +1,50 @@
+import base64
+import os
+import re
+import sys
+from html.parser import HTMLParser
+
+
+class Parser(HTMLParser):
+    def __init__(self, target_sheet, out_dir):
+        super().__init__(convert_charrefs=True)
+        self.target_sheet = target_sheet
+        self.out_dir = out_dir
+        self.in_sheet = False
+        self.depth = 0
+        self.counter = 0
+
+    def handle_starttag(self, tag, attrs):
+        attrs = dict(attrs)
+        if tag == "section" and attrs.get("id") == self.target_sheet:
+            self.in_sheet = True
+            self.depth = 1
+        elif self.in_sheet and tag not in {"area", "base", "br", "col", "embed", "hr", "img", "input", "link", "meta", "param", "source", "track", "wbr"}:
+            self.depth += 1
+        if self.in_sheet and tag == "img":
+            src = attrs.get("src", "")
+            match = re.match(r"data:image/([^;,]+);base64,(.*)", src, re.S)
+            if not match:
+                return
+            self.counter += 1
+            ext = {"jpeg": "jpg", "svg+xml": "svg"}.get(match.group(1), match.group(1))
+            ref = re.sub(r"[^0-9A-Za-z._-]+", "_", attrs.get("data-excel-ref", "unknown"))
+            order = attrs.get("data-image-order", "x")
+            path = os.path.join(self.out_dir, f"{self.target_sheet}_{self.counter:02d}_ord{order}_{ref}.{ext}")
+            with open(path, "wb") as fh:
+                fh.write(base64.b64decode(match.group(2)))
+            print(path, attrs.get("alt", ""), attrs.get("style", ""), sep="\t")
+
+    handle_startendtag = handle_starttag
+
+    def handle_endtag(self, tag):
+        if self.in_sheet:
+            self.depth -= 1
+            if self.depth == 0:
+                self.in_sheet = False
+
+
+path, sheet, out_dir = sys.argv[1:4]
+os.makedirs(out_dir, exist_ok=True)
+with open(path, encoding="utf-8") as fh:
+    Parser(sheet, out_dir).feed(fh.read())
diff --git a//tmp/search_excel_cells.py b//tmp/search_excel_cells.py
new file mode 100644
index 0000000000000000000000000000000000000000..21f6851ff73ff0638b4aae68400c752d3db7a4e2
--- /dev/null
+++ b//tmp/search_excel_cells.py
@@ -0,0 +1,12 @@
+import html
+import re
+import sys
+
+
+path, pattern = sys.argv[1], sys.argv[2]
+raw = open(path, encoding="utf-8").read()
+for match in re.finditer(r'<[^>]*class="[^"]*\bsrc-cell\b[^"]*"[^>]*data-excel-ref="([^"]+)"[^>]*>(.*?)</[^>]+>', raw, re.S):
+    text = html.unescape(re.sub(r"<[^>]+>", "", match.group(2))).strip()
+    if re.search(pattern, text, re.I):
+        line = raw.count("\n", 0, match.start()) + 1
+        print(f"{line}\t{match.group(1)}\t{text}")

