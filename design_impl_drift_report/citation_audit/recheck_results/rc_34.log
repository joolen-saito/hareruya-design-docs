    /**
     * 手動メール送信(買取)
     */
    public function sendManualPurchaseMail(SendManualPurchaseMailInput $input): void
    {
        $PurchaseMailOption = $this->mtbOptionRepository->findOneBy(['option_key' => MtbOption::PURCHASE_MAIL_ADDRESS]);
        if ($PurchaseMailOption === null) {
            log_critical('買取メール送信元が設定されていません。option_key='.MtbOption::PURCHASE_MAIL_ADDRESS);

            return;
        }

        $purchaseMailAddress = new Address(
            $PurchaseMailOption->getOptionValue(),
            $this->BaseInfo->getShopName()
        );

        $message = (new Email())
            ->subject($input->mailSubject)
            ->from($purchaseMailAddress)
            ->to($this->convertRFCViolatingEmail($input->BuyOrder->getEmail()))
            ->bcc($purchaseMailAddress)
            ->replyTo($purchaseMailAddress)
            ->returnPath($this->BaseInfo->getEmail04())
            ->text($input->body);

        try {
            $this->mailer->send($message);
            log_info('ネット買取手動メール送信完了', ['buyOrderId' => $input->BuyOrder->getId()]);
        } catch (TransportExceptionInterface $e) {
            log_critical($e->getMessage());

            return;
        }

        $BaseInfo = $this->BaseInfoRepository->getMallBaseInfo();
        $this->mailHistoryEntityManager->save($message, $BaseInfo, $input->BuyOrder, $input->MailTemplate);
    }

