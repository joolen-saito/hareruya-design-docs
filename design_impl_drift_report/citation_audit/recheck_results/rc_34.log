$(function () {
    $(document).on("click", "#allCheck", function () {
        const checked = $(this).prop("checked");
        $(this).closest("form").find("input[type=checkbox][buyOrderId]").prop("checked", checked);
    });

    $("#admin_purchase_list_buy_order_status").select2();
    $(".search-clear").click(function () {
        $("#admin_purchase_list_buy_order_status").val(null).trigger("change");
    });

    // csv export
    $("#csvexport, #csvexport_deposit, #csvexport_product_list, #csv_export_return_list, #csv_export_product_cancel").on(
        "click",
        function () {
            if ($(".searched_buy_order_id:checked").length === 0) {
                alert("CSV出力する買取注文情報をひとつ以上選択してください。");

                return false;
            }
            setTimeout(function () {
                $("#csvexport, #csvexport_deposit, #csvexport_product_list, #csv_export_return_list, #csv_export_product_cancel").prop("disabled", false);
            }, 500);
        }
    );

    $("#pdf_export_return_list").on("click", function (event) {
        event.preventDefault();
        if ($(".searched_buy_order_id:checked").length === 0) {
            alert("PDF出力する買取注文情報をひとつ以上選択してください。");

            return false;
        }
        const exportUrl = $(this).attr("data-export-url");
        if (!exportUrl) {
            return false;
        }
        const popupWindow = window.open(
            "about:blank",
            "purchase_return_list_pdf_" + String(Date.now()),
            "toolbar=no,location=no,directories=no,status=no,menubar=no,scrollbars=yes,resizable=yes,width=900,height=800"
        );
        if (!popupWindow) {
            alert("ポップアップがブロックされているため、PDFを開けませんでした。ブラウザの設定を確認してください。");

            return false;
        }
        $.ajax({
            url: exportUrl,
            type: "POST",
            data: $("#bulk_csv_export").serialize(),
            dataType: "json",
        })
            .done(function (response) {
                if (response && response.ok === true && response.html) {
                    popupWindow.document.open();
                    popupWindow.document.write(response.html);
                    popupWindow.document.close();

                    // ポップアップは親画面の CSP が効くため、HTML 内の nonce 付き inline script は実行されない
                    const printButton = popupWindow.document.getElementById("printButton");
                    if (printButton) {
                        printButton.addEventListener("click", function () {
                            popupWindow.print();
                        });
                    }

                    return;
                }
                popupWindow.close();
                if (response && response.redirectUrl) {
                    window.location.href = response.redirectUrl;

                    return;
                }
                alert("PDF用データの取得に失敗しました。");
            })
            .fail(function () {
                popupWindow.close();
                alert("PDF用データの取得に失敗しました。");
            });

        return false;
    });

    $(".post_name").click(function () {
        $("#admin_purchase_list_buy_order_status").val(null).trigger("change");
        $("#admin_purchase_list_name_multi").val($(this).text());
        $("#search_form").submit();

        return false;
    });
});
