    /**
     * 手動メール送信(買取)
     *
     * @param Customer | Order | DtbBuyOrder $data
     * @param MailTemplate $template
     * @param array $content
     */
    public function sendManualPurchaseMail($data, $template, $content)
    {
        $purchaseMailAddress = [$this->app['hareruya_ec.repository.option']->findOneByOptionKey(MtbOption::PURCHASE_MAIL_ADDRESS)->getOptionValue() => $this->baseInfo->getShopName()];

        $message = \Swift_Message::newInstance()
            ->setSubject($content['mail']['subject'])
            ->setFrom($purchaseMailAddress)
            ->setTo([$data->getEmail()])
            ->setBcc($purchaseMailAddress)
            ->setReplyTo($purchaseMailAddress)
            ->setReturnPath($this->baseInfo->getEmail04())
            ->setBody($content['mail_body']);

        MailUtil::convertMessage($this->app, $message);
        MailUtil::setParameterForCharset($this->app, $message);

        $this->app->mail($message);
        $this->saveUserMailHistory($message, $template, $data);

        return;
    }

    /**
     * 一括用手動メール送信
     *
     * @param Customer | Order | DtbBuyOrder $data
        ];
    }

    /**
     * Save user mail history
     *
     * @param array $message
     * @param MailTemplate | null $mailTemplate
     * @param Customer | Order | DtbBuyOrder | null $info
     * @param \Eccube\Entity\Member | null $creator
     */
    private function saveUserMailHistory($message, $mailTemplate = null, $info = null, \Eccube\Entity\Member $creator = null)
    {
        $mailHistory = new MailHistory();
        $mailHistory
            ->setSubject($message->getSubject())
            ->setMailBody($message->getBody())
            ->setSendDate(new \DateTime())
            ->setCreator($creator);

        if (!is_null($mailTemplate)) {
            $mailHistory->setMailTemplate($mailTemplate);
        }
        if ($info instanceof Customer) {
            $mailHistory->setCustomer($info);
        } elseif ($info instanceof Order) {
            $mailHistory
                ->setOrder($info)
                ->setCustomer($info->getCustomer());
        } elseif ($info instanceof DtbBuyOrder) {
            $mailHistory
                ->setBuyOrder($info)
                ->setCustomer($info->getCustomer());
        }

        $this->app['orm.em']->persist($mailHistory);
        $this->app['orm.em']->flush($mailHistory);
    }

