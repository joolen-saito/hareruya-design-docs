    /**
     * 買取商品一覧出力用データ取得
     * 売却する用、キャンセル用のいずれからも利用する
     * Note: 集計クエリでパフォーマンス考慮のため、DBAL + iterateAssociative を使用する
     *
     * @param array<int, int> $buyOrderIds
     *
     * @return \Traversable<int, array<string, mixed>>
     */
    public function getProductListDataForExportCsv(array $buyOrderIds, bool $saleFlg): iterable
    {
        if ($buyOrderIds === []) {
            return new \ArrayIterator([]);
        }

        $sql = <<<SQL
        (
            -- 通常買取商品（状態あり）
            SELECT
                pc.product_code AS product_code,
                SUM(bmc.count) AS product_count,
                p.name AS product_name,
                pc.standard_price AS standard_price,
                bmc.price AS buy_price,
                bmc.language_id AS language_id,
                sc.name AS storage_code,
                r.code AS rarity_code,
                cc.code AS condition_code,
                (CASE WHEN pc.product_code IS NULL THEN 1 ELSE 0 END) AS product_code_null_sort,
                cc.id AS card_condition_id,
                p.id AS product_id,
                0 AS indivisual_input_product_sort
            FROM
                dtb_buy_order bo
            JOIN
                dtb_buy_main_card bmc ON bmc.buy_order_id = bo.id
                AND bmc.sale_flg = :saleFlg
            JOIN
                dtb_product p ON p.id = bmc.product_id
            JOIN
                dtb_product_class pc ON pc.product_id = p.id
                AND pc.product_status_id IN (:productStatusIds)
                AND pc.language_id = bmc.language_id
                AND pc.card_condition_id = bmc.card_condition_id
                AND pc.high_price_code IS NULL
            JOIN
                mtb_card_condition cc ON cc.id = bmc.card_condition_id
            LEFT JOIN
                mtb_storage_code sc ON sc.id = p.storage_code_id
            LEFT JOIN
                mtb_card_detail cd ON cd.id = p.card_detail_id
            LEFT JOIN
                mtb_rarity r ON r.id = cd.rarity_id
            WHERE
                bo.id IN (:buyOrderIds)
                AND (:saleFlg = true OR bo.buy_order_status_id != :cancelledStatusId) -- 売却しない抽出のときは、買取ステータス「キャンセル」を除外する
            GROUP BY
                pc.id, bmc.price, pc.product_code, p.name, pc.standard_price, bmc.language_id, sc.name, r.code, cc.code, cc.id, p.id
        )
        UNION ALL
        (
            -- 個別入力商品
            SELECT
                '' AS product_code,
                iip.quantity AS product_count,
                iip.name AS product_name,
                NULL AS standard_price,
                iip.price AS buy_price,
                1 AS language_id,
                '' AS storage_code,
                '' AS rarity_code,
                '' AS condition_code,
                2 AS product_code_null_sort,
                NULL AS card_condition_id,
                NULL AS product_id,
                1 AS indivisual_input_product_sort
            FROM
                dtb_buy_order_indivisual_input_product iip
            JOIN
                dtb_buy_order bo_iip ON bo_iip.id = iip.buy_order_id
            WHERE
                iip.buy_order_id IN (:buyOrderIds)
                AND iip.sale_flg = :saleFlg
                AND (:saleFlg = true OR bo_iip.buy_order_status_id != :cancelledStatusId) -- 売却しない抽出のときは、買取ステータス「キャンセル」を除外する
        )
        UNION ALL
        (
            -- 通常商品（状態なし）
            SELECT
                '' AS product_code,
                SUM(bmc.count) AS product_count,
                p.name AS product_name,
                NULL AS standard_price,
                bmc.price AS buy_price,
                bmc.language_id AS language_id,
                sc.name AS storage_code,
                r.code AS rarity_code,
                '' AS condition_code,
                1 AS product_code_null_sort,
                NULL AS card_condition_id,
                p.id AS product_id,
                0 AS indivisual_input_Product_sort
            FROM
                dtb_buy_order bo
            JOIN
                dtb_buy_main_card bmc ON bmc.buy_order_id = bo.id
                AND bmc.sale_flg = :saleFlg
            JOIN
                dtb_product p ON p.id = bmc.product_id
            LEFT JOIN
                mtb_storage_code sc ON sc.id = p.storage_code_id
            LEFT JOIN
                mtb_card_detail cd ON cd.id = p.card_detail_id
            LEFT JOIN
                mtb_rarity r ON r.id = cd.rarity_id
            WHERE
                bo.id IN (:buyOrderIds)
                AND bmc.card_condition_id IS NULL
                AND (:saleFlg = true OR bo.buy_order_status_id != :cancelledStatusId) -- 売却しない抽出のときは、買取ステータス「キャンセル」を除外する
            GROUP BY
                bmc.product_id, p.name, bmc.price, bmc.language_id, sc.name, r.code, p.id
        )
        ORDER BY
            indivisual_input_product_sort ASC, product_id ASC, product_code_null_sort ASC, card_condition_id ASC
        SQL;

        $conn = $this->getEntityManager()->getConnection();

        return $conn->iterateAssociative(
            $sql,
            [
                'buyOrderIds' => $buyOrderIds,
                'saleFlg' => $saleFlg,
                'productStatusIds' => [ProductStatus::DISPLAY_SHOW, ProductStatus::DISPLAY_HIDE], // 商品状態が公開または非公開の商品（論理削除に相当する「廃止」を除く）
                'cancelledStatusId' => MtbBuyOrderStatus::CANCELED,
            ],
            [
