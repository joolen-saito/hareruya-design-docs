import pathlib,re,html
root=pathlib.Path('/home/y-saito/Developments/hareruya-design-docs/excel_to_html/output')
pats=['pageCount','sortSelect','resume','admin_cardset_page','admin_cardset_download_lang','download_lang','filename*','RFC 5987','aplication/octet-stream','Content-Disposition','Referer','新規タブ','target=\"_blank\"','同一 rank','id 昇順','このカードセットを削除してもよろしいですか']
hits={p:[] for p in pats}
rx=re.compile(r'<span["'^>]*class="[''^"]*src-cell[''^"]*"[''^>]*data-excel-ref="([''^"]+)"[''^>]*>(.*?)</span>'"',re.S)
for path in root.glob('*.html'):
    text=path.read_text(errors='replace')
    for m in rx.finditer(text):
        cell=html.unescape(re.sub(r'<["'^>]+>'"',' ',m.group(2)))
        for pat in pats:
            if pat.lower() in cell.lower():
                hits[pat].append((path.name,m.group(1),' '.join(cell.split())))
for pat in pats:
    print(f'PATTERN {pat} HITS {len(hits[pat])}')
    for row in hits[pat][:8]:
        print(' | '.join(row))
