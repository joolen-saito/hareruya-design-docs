index 0000000000000000000000000000000000000000..7f6686ad5443dd3f02936c286d79603de25a7636
--- /dev/null
+++ b//tmp/rc24_extract_images.py
@@ -0,0 +1,37 @@
+import base64
+import re
+from pathlib import Path
+
+
+SOURCE = Path(
+    "/home/y-saito/Developments/hareruya-design-docs/excel_to_html/output/"
+    "0202_基本設計仕様書(在庫管理機能).html"
+)
+OUTPUT = Path("/tmp/rc24-images")
+
+text = SOURCE.read_text()
+sections = list(re.finditer(r'<section[^>]+id="(sheet-\d+)"[^>]*>', text))
+OUTPUT.mkdir(exist_ok=True)
+
+for sheet_id in ("sheet-4", "sheet-5", "sheet-6", "sheet-7"):
+    section_index = next(
+        index for index, match in enumerate(sections) if match.group(1) == sheet_id
+    )
+    start = sections[section_index].start()
+    end = (
+        sections[section_index + 1].start()
+        if section_index + 1 < len(sections)
+        else len(text)
+    )
+    chunk = text[start:end]
+    for image_index, tag in enumerate(re.findall(r"<img[^>]+>", chunk), start=1):
+        source_match = re.search(
+            r'src="data:image/([^;]+);base64,([^"]+)"', tag
+        )
+        if source_match is None:
+            continue
+        extension = "jpg" if source_match.group(1) == "jpeg" else source_match.group(1)
+        target = OUTPUT / f"{sheet_id}-{image_index}.{extension}"
+        target.write_bytes(base64.b64decode(source_match.group(2)))
+        alt_match = re.search(r'alt="([^"]*)"', tag)
+        print(target, alt_match.group(1) if alt_match else "")

