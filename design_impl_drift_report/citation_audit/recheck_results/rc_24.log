            }

            if ($conditions !== []) {
                $qb->andWhere('('.implode(' OR ', $conditions).')');
            }
        }

        $qb->orderBy('p.id', 'DESC')
            ->addOrderBy('ps.stockLocationId', 'ASC');

        return $qb;
    }

