        // 言語フィルター
        // JP_ID(1)            → pc.Language = 1
        // EN_ID(2)            → pc.Language = 2
        // NOT_JP_EN_LANG_ID   → pc.Language NOT IN (1, 2)（日本語・英語以外）
        // 複数選択時は OR で結合
        if ($input->languages !== []) {
            $hasJp = in_array(MtbLanguage::JP_ID, $input->languages, true);
            $hasEn = in_array(MtbLanguage::EN_ID, $input->languages, true);
            $hasOther = in_array(MtbLanguage::NOT_JP_EN_LANG_ID, $input->languages, true);

            $conditions = [];
            if ($hasJp) {
                $conditions[] = 'IDENTITY(pc.Language) = '.MtbLanguage::JP_ID;
            }
            if ($hasEn) {
                $conditions[] = 'IDENTITY(pc.Language) = '.MtbLanguage::EN_ID;
            }
            if ($hasOther) {
                $conditions[] = '(pc.Language IS NOT NULL AND IDENTITY(pc.Language) NOT IN (:stockListConstantLangIds))';
