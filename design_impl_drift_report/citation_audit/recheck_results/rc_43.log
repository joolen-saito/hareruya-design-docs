   816	     * 店舗×部門単位の買取集計データを取得
   817	     *
   818	     * 3つのデータソースを UNION ALL で結合:
   819	     * 1. OtcBuyOrderDetail（明細）のセクション別集計
   820	     * 2. OtcBuyOrderIndivisualInputProduct（個別入力商品）のセクション別集計
   821	     * 3. 端数調整（total_price - 明細合計 - 個別入力合計）を固定セクションに計上
   822	     *
   823	     * @return array<int, array{base_info_id: int, section_id: int, total_buy_price: int, total_sell_price: int}>
   824	     */
   825	    public function getSectionSummary(\DateTime $summaryDate, int $fixedPriceSection): array
   826	    {
   827	        $from = (clone $summaryDate)->modify('00:00:00');
   828	        $to = (clone $summaryDate)->modify('23:59:59');
   829	
   830	        $statusIds = implode(',', MtbOtcBuyOrderStatus::SUMMARY_STATUSES);
   831	
   832	        $sql = <<<EOT
   833	            SELECT
   834	                sub.base_info_id,
   835	                sub.section_id,
   836	                CAST(SUM(sub.buy_price) AS INTEGER) AS total_buy_price,
   837	                CAST(SUM(sub.sell_price) AS INTEGER) AS total_sell_price
   838	            FROM
   839	                (
   840	                    SELECT
   841	                        obo.base_info_id AS base_info_id,
   842	                        obod.section_id AS section_id,
   843	                        (obod.price * obod.original_quantity) AS buy_price,
   844	                        (obod.sell_price * obod.original_quantity) AS sell_price
   845	                    FROM
   846	                        dtb_otc_buy_order obo
   847	                    JOIN
   848	                        dtb_otc_buy_order_detail obod ON obod.otc_buy_order_id = obo.id
   849	                        AND obod.original_quantity > 0
   850	                    WHERE
   851	                        obo.otc_buy_order_status_id IN ({$statusIds})
   852	                        AND obo.complete_date >= ?
   853	                        AND obo.complete_date <= ?
   854	                    UNION ALL
   855	                    SELECT
   856	                        obo.base_info_id AS base_info_id,
   857	                        oboi.section_id AS section_id,
   858	                        (oboi.price * oboi.quantity) AS buy_price,
   859	                        (oboi.sell_price * oboi.quantity) AS sell_price
   860	                    FROM
   861	                        dtb_otc_buy_order obo
   862	                    JOIN
   863	                        dtb_otc_buy_order_indivisual_input_product oboi ON oboi.otc_buy_order_id = obo.id
   864	                        AND oboi.quantity > 0
   865	                    WHERE
   866	                        obo.otc_buy_order_status_id IN ({$statusIds})
   867	                        AND obo.complete_date >= ?
   868	                        AND obo.complete_date <= ?
   869	                    UNION ALL
   870	                    SELECT
   871	                        obo.base_info_id AS base_info_id,
   872	                        {$fixedPriceSection} AS section_id,
   873	                        -- 端数調整額 = total_price - 明細合計 - 個別入力合計
   874	                        -- detail × individual の LEFT JOIN で直積になるため、
   875	                        -- 各 SUM を相手テーブルの DISTINCT 行数で割って正味の合計に戻す
   876	                        (obo.total_price
   877	                            - SUM(COALESCE(obod.price, 0) * COALESCE(obod.original_quantity, 0)) /
   878	                              (CASE WHEN COUNT(DISTINCT oboi.id) > 0
