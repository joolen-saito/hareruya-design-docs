   880	                            - SUM(COALESCE(oboi.price, 0) * COALESCE(oboi.quantity, 0)) /
   881	                              (CASE WHEN COUNT(DISTINCT obod.id) > 0
   882	                                THEN COUNT(DISTINCT obod.id) ELSE 1 END)
   883	                        ) AS buy_price,
   884	                        0 AS sell_price
   885	                    FROM
   886	                        dtb_otc_buy_order obo
   887	                    LEFT JOIN
   888	                        dtb_otc_buy_order_detail obod ON obod.otc_buy_order_id = obo.id
   889	                    LEFT JOIN
   890	                        dtb_otc_buy_order_indivisual_input_product oboi ON oboi.otc_buy_order_id = obo.id
   891	                    WHERE
   892	                        obo.otc_buy_order_status_id IN ({$statusIds})
   893	                        AND obo.complete_date >= ?
   894	                        AND obo.complete_date <= ?
   895	                    GROUP BY
   896	                        obo.id, obo.base_info_id, obo.total_price
