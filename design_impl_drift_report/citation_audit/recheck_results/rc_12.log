    16	namespace Eccube\Service\Admin\Purchase;
    17	
    18	use Doctrine\ORM\EntityManagerInterface;
    19	use Eccube\Entity\Master\MtbBuyOrderStatus;
    20	use Eccube\Entity\Master\MtbStockHistorySourceType;
    21	use Eccube\Repository\BaseInfoRepository;
    22	use Eccube\Repository\DtbBuyOrderRepository;
    23	use Eccube\Repository\Master\MtbStockHistorySourceTypeRepository;
    24	use Eccube\Service\Admin\Purchase\ActionInput\BuyOrderStockInboundInput;
    25	use Eccube\Service\Stock\RestockNotificationMailSender;
    26	
    27	/**
    28	 * ネット買取 自動入庫バッチ Action
    29	 *
    30	 * 「入庫待ち」ステータスのネット買取案件を対象に、メインショップの商品在庫を更新し、
    31	 * 在庫履歴を登録したうえで、ステータスを「入庫済み」に変更する。
    32	 */
    33	class BatchAutoStockAction
    34	{
    35	    public function __construct(
    36	        private readonly EntityManagerInterface $entityManager,
    37	        private readonly DtbBuyOrderRepository $buyOrderRepository,
    38	        private readonly BaseInfoRepository $baseInfoRepository,
    39	        private readonly MtbStockHistorySourceTypeRepository $stockHistorySourceTypeRepository,
    40	        private readonly BuyOrderStockInbound $buyOrderStockInbound,
    41	        private readonly RestockNotificationMailSender $restockNotificationMailSender,
    42	    ) {
    43	    }
    44	
    45	    public function handle(): void
    46	    {
    47	        // ネット買取はメインショップの在庫に入庫する
    48	        $MainBaseInfo = $this->baseInfoRepository->getMallBaseInfo();
    49	
    50	        $HistorySourceType = $this->stockHistorySourceTypeRepository->find(MtbStockHistorySourceType::PURCHASE_AUTO_IMPORT_BATCH);
    51	        $BuyOrders = $this->buyOrderRepository->findBy(['BuyOrderStatus' => MtbBuyOrderStatus::WAITING_FOR_STOCK]);
    52	
    53	        foreach ($BuyOrders as $BuyOrder) {
    54	            $this->entityManager->beginTransaction();
    55	            try {
    56	                // 二重入庫（手動処理と同時実行された場合など）を避けるためにStatusを先に変更する。
    57	                // ※ステータス更新は updateStatusIfWaitingForStock 内で行われる
    58	                $affected = $this->buyOrderRepository->updateStatusIfWaitingForStock($BuyOrder->getId());
    59	                if ($affected === 0) {
    60	                    $this->entityManager->rollback();
    61	                    continue;
    62	                }
    63	
    64	                $this->buyOrderStockInbound->process(new BuyOrderStockInboundInput(
    65	                    BuyOrder: $BuyOrder,
    66	                    MainBaseInfo: $MainBaseInfo,
    67	                    HistorySourceType: $HistorySourceType,
    68	                    Member: null,
    69	                ));
    70	
    71	                $this->entityManager->flush();
    72	                $this->entityManager->commit();
    73	            } catch (\Exception $e) {
    74	                $this->entityManager->rollback();
    75	                throw $e;
    76	            }
    77	
    78	            $this->restockNotificationMailSender->processQueueAfterCommit();
    79	        }
    80	    }
