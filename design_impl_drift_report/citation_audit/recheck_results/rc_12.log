   551	    public function setStockUpdate($em, Order $Order)
   552	    {
   553	        // デッドロック回避のため、productClassId順にソート
   554	        $orderDetails = $em->getRepository('Eccube\Entity\OrderDetail')->findBy(['Order' => $Order], ['ProductClass' => 'ASC']);
   555	
   556	        // 在庫情報更新
   557	        foreach ($orderDetails as $orderDetail) {
   558	            // 在庫が無制限かチェックし、制限ありなら在庫数を更新
   559	            if ($orderDetail->getProductClass()->getStockUnlimited() == Constant::DISABLED) {
   560	                $productStock = $em->getRepository('Eccube\Entity\ProductStock')->find(
   561	                    $orderDetail->getProductClass()->getProductStock()->getId(), LockMode::PESSIMISTIC_WRITE
   562	                );
   563	
   564	                // 在庫情報の在庫数を更新
   565	                $stock = $productStock->getStock() - $orderDetail->getQuantity();
   566	                $productStock->setStock($stock);
   567	
   568	                // 商品規格情報の在庫数を更新
   569	                $orderDetail->getProductClass()->setStock($stock);
   570	            }
   571	        }
   572	    }
