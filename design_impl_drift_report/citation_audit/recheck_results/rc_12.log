    16	namespace Eccube\Service\Admin\OtcBuyOrder;
    17	
    18	use Doctrine\ORM\EntityManagerInterface;
    19	use Eccube\Entity\Master\MtbOtcBuyOrderStatus;
    20	use Eccube\Entity\Master\MtbStockHistorySourceType;
    21	use Eccube\Repository\DtbOtcBuyOrderRepository;
    22	use Eccube\Repository\Master\MtbStockHistorySourceTypeRepository;
    23	use Eccube\Service\Admin\OtcBuyOrder\ActionInput\OtcBuyOrderStockInboundInput;
    24	use Eccube\Service\Stock\RestockNotificationMailSender;
    25	
    26	/**
    27	 * 店頭買取 自動入庫バッチ Action
    28	 *
    29	 * 「入庫待ち」ステータスの店頭買取案件を対象に、商品在庫を更新し在庫履歴を登録したうえで
    30	 * ステータスを「入庫済み」に変更する。
    31	 */
    32	class BatchAutoStockAction
    33	{
    34	    public function __construct(
    35	        private readonly EntityManagerInterface $entityManager,
    36	        private readonly DtbOtcBuyOrderRepository $otcBuyOrderRepository,
    37	        private readonly MtbStockHistorySourceTypeRepository $stockHistorySourceTypeRepository,
    38	        private readonly OtcBuyOrderStockInbound $otcBuyOrderStockInbound,
    39	        private readonly RestockNotificationMailSender $restockNotificationMailSender,
    40	    ) {
    41	    }
    42	
    43	    public function handle(): void
    44	    {
    45	        $OtcBuyOrders = $this->otcBuyOrderRepository->findBy(['OtcBuyOrderStatus' => MtbOtcBuyOrderStatus::STATUS_STOCKING_PENDING]);
    46	
    47	        $HistorySourceType = $this->stockHistorySourceTypeRepository->find(MtbStockHistorySourceType::PURCHASE_AUTO_IMPORT_BATCH);
    48	
    49	        foreach ($OtcBuyOrders as $OtcBuyOrder) {
    50	            $this->entityManager->beginTransaction();
    51	            try {
    52	                // ２重入庫（手動処理と同時実行された場合など）を避けるためにStatusを先に変更する。
    53	                // ※ステータス更新は updateStatusIfStockingPending 内で行われる
    54	                $affected = $this->otcBuyOrderRepository->updateStatusIfStockingPending($OtcBuyOrder->getId());
    55	                if ($affected === 0) {
    56	                    $this->entityManager->rollback();
    57	                    continue;
    58	                }
    59	
    60	                $this->otcBuyOrderStockInbound->process(new OtcBuyOrderStockInboundInput(
    61	                    OtcBuyOrder: $OtcBuyOrder,
    62	                    HistorySourceType: $HistorySourceType,
    63	                    Member: null,
    64	                ));
    65	
    66	                $this->entityManager->flush();
    67	                $this->entityManager->commit();
    68	            } catch (\Exception $e) {
    69	                $this->entityManager->rollback();
    70	                throw $e;
    71	            }
    72	
    73	            $this->restockNotificationMailSender->processQueueAfterCommit();
    74	        }
    75	    }
    76	}
