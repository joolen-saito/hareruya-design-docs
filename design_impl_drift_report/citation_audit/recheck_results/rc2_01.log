   492	                WHERE {$targetOrderItemConditions}
   493	                  -- スマレジ由来受注へ置き換わった用済みの元注文はスマレジ由来受注側で計上するため除外する。
   494	                  AND o.next_order_id IS NULL
   495	                  -- 統合受注の計上は別クエリで行うため除外する。
   496	                  AND NOT ({$isMergedSmaregiOrder})
   497	            ),
   498	            -- 統合受注の商品規格別数量。複製元を差し引く前の総量。
   499	            merged_order_sales AS (
