   214	            CanceledHandler::ACTION => $this->processCanceled($event, $transaction),
   215	            DisposedHandler::ACTION => $this->processDisposed($event, $transaction),
   216	            default => $this->logger->warning('Smaregi transaction action not yet handled in child job', [
   217	                'webhookEventId' => $event->getId(),
   218	                'action' => $action,
   219	                'transactionHeadId' => $transaction->transactionHeadId,
