   190	    }
   191	
   192	    private function isStaleUpdate(string $transactionHeadId, string $action, ?string $incomingUpdateDateTime): bool
   193	    {
   194	        if ($incomingUpdateDateTime === null || $incomingUpdateDateTime === '') {
   195	            return false;
   196	        }
   197	        $latest = $this->smaregiTransactionJobRepository->findLatestCompletedByTransaction($transactionHeadId, $action);
   198	        if ($latest === null) {
   199	            return false;
   200	        }
   201	        $stored = $latest->getTransactionUpdateDateTime();
   202	        if ($stored === null || $stored === '') {
   203	            return false;
   204	        }
   205	
   206	        return $stored >= $incomingUpdateDateTime;
   207	    }
