   310	        $order->setSmaregiReceiptNo($transaction->transactionUuid);
   311	        $order->setSmaregiMemo($transaction->memo);
   312	        $order->setOrderDate($this->parseDateTime($transaction->terminalTranDateTime) ?? new \DateTime());
   313	        $order->setPaymentMethod(self::SMAREGI_PAYMENT_METHOD);
   314	        $order->setSubtotal($transaction->subtotal ?? '0');
   315	        $order->setTotal($transaction->total ?? '0');
   316	        $order->setPaymentTotal($transaction->total ?? '0');
   317	        // Order.tax は deprecated (Order.php の setTax docblock 参照)。
   318	        // 税額は OrderItem 単位で taxIncludeProportional + taxExcludeProportional から算出する。
   319	        $order->setTaxFree($transaction->taxFreeTotal === null ? null : (int) $transaction->taxFreeTotal);
   320	        // 小計値引き/割引 (with_discounts) が連携されていれば、その区分名称と値引額を反映する。
   321	        // クーポン値引額も整合のため discounts.discountPrice を優先し、無ければ取引ヘッダの couponDiscount を用いる。
   322	        $subtotalDiscount = $transaction->getSubtotalDiscount();
   323	        $couponDiscount = $subtotalDiscount !== null ? $subtotalDiscount->discountPrice : $transaction->couponDiscount;
   324	        $order->setCouponDiscount($couponDiscount === null ? null : (int) $couponDiscount);
   325	        $order->setSubtotalDiscountDivision($subtotalDiscount?->discountDivisionName);
   326	
   327	        return $order;
   328	    }
