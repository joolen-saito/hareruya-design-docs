    30	class StockApprovalStoreAction
    31	{
    32	    public function __construct(
    33	        private readonly EntityManagerInterface $entityManager,
    34	        private readonly ProductStockEntityManager $productStockEntityManager,
    35	        private readonly StockEditApprovalEntityManager $stockEditApprovalEntityManager,
    36	        private readonly StockEditApprovalDetailEntityManager $stockEditApprovalDetailEntityManager,
    37	        private readonly StockHistoryEntityManager $stockHistoryEntityManager,
    38	        private readonly MtbStockHistorySourceTypeRepository $stockHistorySourceTypeRepository,
    39	        private readonly StockApprovalListEntityManager $stockApprovalListEntityManager,
    40	    ) {
    41	    }
    42	
    43	    public function handle(StockApprovalStoreInput $input): void
    44	    {
    45	        $HistorySourceType = $this->stockHistorySourceTypeRepository->find(MtbStockHistorySourceType::STOCK_EDIT);
    46	
    47	        $this->entityManager->beginTransaction();
    48	
    49	        try {
    50	            $now = new \DateTime();
    51	            $ProductStock = $input->ProductStock;
    52	            $stockChangeQuantity = $input->stockChangeQuantity;
    53	            $StockChangeTypeDetail = $input->StockChangeTypeDetail;
    54	            $purchaseUnitPrice = ($input->purchasePrice === null || $input->purchasePrice === '') ? '0' : $input->purchasePrice;
    55	
    56	            $StockEditApproval = $this->stockEditApprovalEntityManager->save(
    57	                BaseInfo: $ProductStock->getBaseInfo(),
    58	                StockChangeTypeDetail: $StockChangeTypeDetail,
    59	                approvalStatus: 1,// TODO: 承認ステータスのマスター化
    60	                registeredAt: $now,
    61	                RegisteredMember: $input->Member,
    62	                approvedAt: null,
    63	                ApprovalMember: null,
    64	            );
    65	
    66	            $this->entityManager->flush();
    67	
    68	            $this->stockEditApprovalDetailEntityManager->save(
    69	                StockEditApproval: $StockEditApproval,
    70	                ProductStock: $ProductStock,
    71	                editQuantity: (int) $stockChangeQuantity,
    72	                stockChangeReason: $input->stockChangeReason,
    73	                purchaseUnitPrice: $purchaseUnitPrice,
    74	                outboundTotalCost: $ProductStock->getMovementTotalCost($stockChangeQuantity),
    75	                Member: $input->Member,
    76	                beforeEditQuantity: (int) $ProductStock->getStock(),
    77	                beforePurchaseUnitPrice: $ProductStock->getUnitCost(),
    78	            );
    79	
    80	            $totalCostChange = $StockChangeTypeDetail->isTypeBeStocked()
    81	                ? (int) bcmul($purchaseUnitPrice, (string) $stockChangeQuantity, 0)
    82	                : (int) $ProductStock->getMovementTotalCost($stockChangeQuantity);
    83	
    84	            if ($StockChangeTypeDetail->isTypeDisposal()) {
    85	                $sellPrice = (string) $ProductStock->getProductClass()->getPrice02();
    86	
    87	                $beforeStock = $ProductStock->getStock();
    88	                $totalCostPriceBefore = $ProductStock->getTotalCost();
    89	                $unitCostPriceBefore = $ProductStock->getUnitCost();
    90	
    91	                $afterStock = $ProductStock->getStockQuantityAfterChange($stockChangeQuantity);
    92	                $totalCostPriceAfter = $ProductStock->getTotalCostAfterChange($stockChangeQuantity);
    93	                $unitCostPriceAfter = $ProductStock->getUnitCostPriceAfterChange($stockChangeQuantity);
    94	
    95	                $this->productStockEntityManager->save(
    96	                    ProductStock: $ProductStock,
    97	                    ProductClass: $ProductStock->getProductClass(),
    98	                    BaseInfo: $ProductStock->getBaseInfo(),
    99	                    stockLocationId: $ProductStock->getStockLocationId(),
   100	                    pickUpFlg: $ProductStock->getPickUpFlg(),
   101	                    stock: $afterStock,
   102	                    totalCost: $totalCostPriceAfter,
   103	                );
   104	
   105	                $this->stockHistoryEntityManager->save(
   106	                    ProductStock: $ProductStock,
   107	                    StockChangeTypeDetail: $StockChangeTypeDetail,
   108	                    oldStock: $beforeStock,
   109	                    stock: $afterStock,
   110	                    stockChangeQuantity: $stockChangeQuantity,
   111	                    sellPrice: $sellPrice,
   112	                    unitCostPriceBefore: $unitCostPriceBefore,
   113	                    unitCostPriceAfter: $unitCostPriceAfter,
   114	                    totalCostPriceBefore: $totalCostPriceBefore,
   115	                    totalCostPriceAfter: $totalCostPriceAfter,
   116	                    stockChangeReason: $input->stockChangeReason,
   117	                    shortageReason: null,
   118	                    HistorySourceType: $HistorySourceType,
   119	                    historySourceId: $StockEditApproval->getId(),
   120	                    registeredAt: $now,
   121	                    RegisteredMember: $input->Member,// 登録者
   122	                    operatorMemberName: $input->Member->getName(),
   123	                );
   124	            }
   125	
   126	            $this->entityManager->flush();
   127	
   128	            $this->stockApprovalListEntityManager->save(
   129	                StockApprovalList: null,
   130	                BaseInfo: $ProductStock->getBaseInfo(),
   131	                StockLocationId: $ProductStock->getStockLocationId(),
   132	                HistorySourceType: $HistorySourceType,
   133	                historySourceId: $StockEditApproval->getId(),
   134	                StockTransferTypeDetail: $this->entityManager->getReference(MtbStockChangeTypeDetail::class, $StockChangeTypeDetail->getId()),
   135	                approvalStatus: DtbStockApprovalList::APPROVAL_STATUS_UNAPPROVED,
   136	                registeredDate: $now,
   137	                RegisteredMember: $input->Member,
   138	                approvedDate: null,
   139	                ApprovalMember: null,
   140	                ProductStockTotalCount: 1,
   141	                InventoryChangeTotalCount: (int) $stockChangeQuantity,
   142	                TotalCostPriceBefore: $totalCostChange,
   143	            );
   144	
   145	            $this->entityManager->flush();
   146	            $this->entityManager->commit();
   147	        } catch (\Exception $e) {
   148	            $this->entityManager->rollback();
   149	
   150	            throw $e;
   151	        }
   152	    }
   153	}
