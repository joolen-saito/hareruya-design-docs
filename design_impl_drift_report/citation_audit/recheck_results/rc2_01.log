    17	
    18	final class PurchasePatternResolver
    19	{
    20	    public function resolve(PurchasePatternContext $context): PurchasePattern
    21	    {
    22	        // 既存受注が突合した場合は、その受注の顧客グループ (OTC / OTC_SHITEN か) で
    23	        // 店頭受取 (Pattern 1-3) と店頭PC購入 (Pattern 4-7) を分岐する。
    24	        // どちらも配送方法は店頭受取で登録されるため、突合できたか否かだけでは区別できない。
    25	        if ($context->hasEccubePurchase) {
    26	            return $context->isOtcPcPurchase
    27	                ? $this->resolveOtcPcPurchase($context)
    28	                : $this->resolveEccubePurchase($context);
    29	        }
    30	
    31	        // 既存受注が無いレジ単独購入は会員状態で Pattern 8/9 に分岐する。
    32	        return $context->isMember
    33	            ? PurchasePattern::OTC_MEMBER
    34	            : PurchasePattern::OTC_GUEST;
    35	    }
    36	
    37	    private function resolveEccubePurchase(PurchasePatternContext $context): PurchasePattern
    38	    {
    39	        if ($context->pickupMethod === PickupMethod::SMOOTH_OTC) {
    40	            return PurchasePattern::ECCUBE_SMOOTH_OTC;
    41	        }
    42	
    43	        return $context->hasAddOnPurchase
    44	            ? PurchasePattern::ECCUBE_OTC_WITH_ADD_ON
    45	            : PurchasePattern::ECCUBE_OTC;
    46	    }
    47	
    48	    private function resolveOtcPcPurchase(PurchasePatternContext $context): PurchasePattern
    49	    {
    50	        if ($context->isMember) {
    51	            return $context->hasAddOnPurchase
    52	                ? PurchasePattern::OTC_PC_MEMBER_WITH_ADD_ON
    53	                : PurchasePattern::OTC_PC_MEMBER;
    54	        }
    55	
    56	        return $context->hasAddOnPurchase
    57	            ? PurchasePattern::OTC_PC_GUEST_WITH_ADD_ON
    58	            : PurchasePattern::OTC_PC_GUEST;
    59	    }
    60	}

