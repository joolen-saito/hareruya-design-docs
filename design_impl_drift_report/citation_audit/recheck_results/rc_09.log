from html.parser import HTMLParser
from pathlib import Path
import re
class P(HTMLParser):
 def __init__(self):super().__init__();self.active=False;self.ref='';self.buf=[];self.rows=[]
 def handle_starttag(self,t,a):
  a=dict(a)
  if 'src-cell' in a.get('class','').split():self.active=True;self.ref=a.get('data-excel-ref','');self.buf=[]
 def handle_data(self,d):
  if self.active:self.buf.append(d)
 def handle_endtag(self,t):
  if self.active and t=='span':
   s=' '.join(''.join(self.buf).split());self.rows.append((self.ref,s));self.active=False
patterns={
 'api_error': re.compile(r'Not Found|[\"{]message[\"}]|code.{0,20}message|message.{0,20}code',re.I),
 'sales_status': re.compile(r'処理中|キャンセル.*処理|処理.*キャンセル'),
 'no_target': re.compile(r'対象.{0,8}(無|な)[いく].{0,20}(更新|終了|完了)|更新.{0,20}(行わ|しな).{0,20}(終了|完了)'),
 'console': re.compile(r'コンソール|実行開始|実行終了|開始.{0,12}完了|完了.{0,12}開始|日時付'),
 'sales_storage': re.compile(r'order_quantity_0|dtb_product_class|dtb_sales_quantity|補助表'),
 'stock_command': re.compile(r'product:batch|updateProductSummaryForStockUp|eccube:aggregate-stock-up'),
 'stock_chunks': re.compile(r'100件|flush|キャッシュ.{0,8}クリア|部分反映|ロールバック'),
}
roots=list(Path('hareruya-design-docs/excel_to_html/output').glob('*.html'))
for name,rx in patterns.items():
 print('\\n###',name)
 hits=[]
 for f in roots:
  p=P();p.feed(f.read_text(errors='replace'))
  for ref,text in p.rows:
   if rx.search(text):hits.append((str(f),ref,text))
 print('count',len(hits))
 for f,r,t in hits[:120]:print(f,r,repr(t))
