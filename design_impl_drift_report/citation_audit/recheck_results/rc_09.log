    33	/**
    34	 * @extends AbstractRepository<DtbSalesQuantity>
    35	 */
    36	class DtbSalesQuantityRepository extends AbstractRepository
    37	{
    38	    // 人気商品リコメンド用レコード店舗ID
    39	    public const POPULAR_PRODUCT_RECOMMEND_SHOP_ID = 0;
    40	
    41	    // 一度に書き込むリコメンド数
    42	    public const RECOMMEND_BULK_QUANTITY = 1000;
    43	
    44	    public function __construct(
    45	        ManagerRegistry $registry,
    46	        EccubeConfig $eccubeConfig,
    47	    ) {
    48	        parent::__construct($registry, DtbSalesQuantity::class);
    49	
    50	        $this->eccubeConfig = $eccubeConfig;
    51	    }
    52	
    53	    public function get(int $id = 1): ?DtbSalesQuantity
    54	    {
    55	        return $this->find($id);
    56	    }
    57	
    58	    /**
    59	     * 商品規格IDをキーに、本店ベース集計（BaseInfo IS NULL または BaseInfo = POPULAR_PRODUCT_RECOMMEND_SHOP_ID）の週間販売数を返す。
    60	     *
    61	     * @param int[] $productClassIds
    62	     *
    63	     * @return array<int, int> productClassId => 週間販売数
    64	     */
    65	    public function findWeeklySalesByProductClassIds(array $productClassIds): array
    66	    {
    67	        if ($productClassIds === []) {
    68	            return [];
    69	        }
    70	
    71	        $rows = $this->createQueryBuilder('sq')
    72	            ->select('pc.id AS productClassId', 'SUM(sq.sales_quantity_04) AS weeklySales')
    73	            ->innerJoin('sq.ProductClass', 'pc')
    74	            ->where('pc.id IN (:productClassIds)')
    75	            ->andWhere('sq.BaseInfo IS NULL OR sq.BaseInfo = :popularShopId')
    76	            ->groupBy('pc.id')
    77	            ->setParameter('productClassIds', $productClassIds)
    78	            ->setParameter('popularShopId', self::POPULAR_PRODUCT_RECOMMEND_SHOP_ID)
    79	            ->getQuery()
    80	            ->getArrayResult();
    81	
    82	        $map = [];
    83	        foreach ($rows as $row) {
    84	            $map[(int) $row['productClassId']] = (int) $row['weeklySales'];
    85	        }
    86	
    87	        return $map;
    88	    }
    89	
    90	    /**
    91	     * 集計用の既存行を削除する（base_info_id=0 の人気商品リコメンド行は除外）。
    92	     */
    93	    public function clearSalesQuantityForAggregate(): void
    94	    {
    95	        $this->getEntityManager()->getConnection()->executeStatement(
    96	            'DELETE FROM dtb_sales_quantity WHERE base_info_id != :popular_shop_id',
    97	            ['popular_shop_id' => self::POPULAR_PRODUCT_RECOMMEND_SHOP_ID]
    98	        );
    99	    }
   100	
   101	    /**
   102	     * Update salesQuantity clumns
   103	     *
   104	     * @param array<string, mixed> $salesQuantity
   105	     */
   106	    public function updateSalesQuantityColumns(array $salesQuantity): void
   107	    {
   108	        $date = (new \DateTime())->format('Y/m/d H:i:s');
   109	        $salesQuantity['update_date'] = $date;
   110	        $salesQuantity['sales_location'] = DtbSalesQuantity::SALES_LOCATION_ECCUBE;
   111	        $salesQuantityEntry = $this->findOneBy(['ProductClass' => $salesQuantity['product_class_id'], 'BaseInfo' => $salesQuantity['base_info_id']]);
   112	        if (empty($salesQuantityEntry)) {
   113	            $query = '
   114	                INSERT INTO dtb_sales_quantity
   115	                (
   116	                    product_class_id,
   117	                    base_info_id,
   118	                    sales_location,
   119	                    sales_quantity_01,
   120	                    sales_quantity_02,
   121	                    sales_quantity_03,
   122	                    sales_quantity_04,
   123	                    sales_quantity_05,
   124	                    sales_quantity_06,
   125	                    sales_quantity_07,
   126	                    sales_quantity_08,
   127	                    update_date
   128	                ) VALUES (
   129	                    :product_class_id,
   130	                    :base_info_id,
   131	                    :sales_location,
   132	                    0,
   133	                    :sales_yesterday,
   134	                    :sales_3day,
   135	                    :sales_weekly,
   136	                    :sales_month,
   137	                    :sales_90day,
   138	                    :sales_180day,
   139	                    :sales_365day,
   140	                    :update_date
   141	                )';
   142	        } else {
   143	            $query = '
   144	                UPDATE dtb_sales_quantity
   145	                SET sales_location = :sales_location,
   146	                    sales_quantity_01 = 0,
   147	                    sales_quantity_02 = :sales_yesterday,
   148	                    sales_quantity_03 = :sales_3day,
   149	                    sales_quantity_04 = :sales_weekly,
   150	                    sales_quantity_05 = :sales_month,
   151	                    sales_quantity_06 = :sales_90day,
   152	                    sales_quantity_07 = :sales_180day,
   153	                    sales_quantity_08 = :sales_365day,
   154	                    update_date = :update_date
   155	                WHERE product_class_id = :product_class_id AND base_info_id = :base_info_id';
   156	        }
   157	        $this->getEntityManager()->getConnection()->executeUpdate($query, $salesQuantity);
   158	    }
   159	
   160	    /**
   161	     * 人気商品リコメンド取得
   162	     */
   163	    public function getPopularProductRecommend(int $currentBaseInfoId, string $locale, int $limit = 30): mixed
   164	    {
   165	        // サブクエリ セール帯・通常版・日本語・非FOILを各キーとして優先表示
   166	        $sqlPriority = <<<SQL
   167	        CONCAT(
   168	            CASE WHEN pc.sale_flg = :isSale THEN '1' ELSE '0' END,
   169	            CASE WHEN pr.id = :nonPromotion THEN '1' ELSE '0' END,
   170	            CASE WHEN l.id = :japanese THEN '1' ELSE '0' END,
   171	            CASE WHEN cd.foil_flg = :nonFoil THEN '1' ELSE '0' END
   172	        ) AS priority
   173	        SQL;
   174	        $priorities = $this->createQueryBuilder('sq')
   175	            ->select(['pc.id AS productClassId', 'p.id AS productId', 'l.id AS languageId', $sqlPriority])
   176	            ->innerJoin('sq.BaseInfo', 'bi')
   177	            ->innerJoin('sq.ProductClass', 'pc')
   178	            ->innerJoin('pc.Product', 'p')
   179	            ->innerJoin('pc.Language', 'l')
   180	            ->innerJoin('pc.ProductStock', 'ps')
   420	        $orderDateUtc = \DateTimeImmutable::createFromInterface($orderDate ?? new \DateTimeImmutable('now', $utc))
   421	            ->setTimezone($utc);
   422	
   423	        $rsm = new ResultSetMapping();
   424	        $rsm
   425	            ->addScalarResult('product_class_id', 'product_class_id', 'integer')
   426	            ->addScalarResult('base_info_id', 'base_info_id', 'integer')
   427	            ->addScalarResult('sales_yesterday', 'sales_yesterday', 'integer')
   428	            ->addScalarResult('sales_3day', 'sales_3day', 'integer')
   429	            ->addScalarResult('sales_weekly', 'sales_weekly', 'integer')
   430	            ->addScalarResult('sales_month', 'sales_month', 'integer')
   431	            ->addScalarResult('sales_90day', 'sales_90day', 'integer')
   432	            ->addScalarResult('sales_180day', 'sales_180day', 'integer')
   433	            ->addScalarResult('sales_365day', 'sales_365day', 'integer');
   434	
   435	        $cancelStatus = OrderStatus::CANCEL;
   436	        $productItemType = OrderItemType::PRODUCT;
