from html.parser import HTMLParser
from pathlib import Path
class P(HTMLParser):
    def __init__(self, sheet): super().__init__(); self.sheet=sheet; self.insec=0; self.insrc=0; self.ref=None; self.buf=[]; self.rows=[]
    def handle_starttag(self,tag,attrs):
        a=dict(attrs)
        if a.get('id')==self.sheet: self.insec=1
        elif self.insec and tag=='section' and a.get('id')"'!=self.sheet: self.insec+=1
        if self.insec and '"'src-cell' in a.get('class','').split(): self.insrc=1; self.ref=a.get('data-excel-ref'); self.buf=[]
    def handle_endtag(self,tag):
        if self.insrc and tag=='span':
            t=' '.join(''.join(self.buf).split())
            if t:self.rows.append((self.ref,t))
            self.insrc=0
        if self.insec and tag=='section':
            self.insec-=1
    def handle_data(self,d):
        if self.insrc:self.buf.append(d)
for fn,sid in [
