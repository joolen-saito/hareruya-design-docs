   440	        //       スマレジ受注が別テーブル管理の場合は UNION 等で本クエリを拡張すること。
   441	        $query = <<<SQL
   442	            SELECT
   443	                oi.product_class_id,
   444	                s.base_info_id,
   445	                SUM(CASE WHEN o.order_date::date = (:order_date_ts::timestamptz)::date - 1 THEN oi.quantity::int ELSE 0 END) AS sales_yesterday,
   446	                SUM(CASE WHEN o.order_date >= :order_date_ts::timestamptz - INTERVAL '3 days' THEN oi.quantity::int ELSE 0 END) AS sales_3day,
   447	                SUM(CASE WHEN o.order_date >= :order_date_ts::timestamptz - INTERVAL '7 days' THEN oi.quantity::int ELSE 0 END) AS sales_weekly,
   448	                SUM(CASE WHEN o.order_date >= :order_date_ts::timestamptz - INTERVAL '28 days' THEN oi.quantity::int ELSE 0 END) AS sales_month,
   449	                SUM(CASE WHEN o.order_date >= :order_date_ts::timestamptz - INTERVAL '90 days' THEN oi.quantity::int ELSE 0 END) AS sales_90day,
   450	                SUM(CASE WHEN o.order_date >= :order_date_ts::timestamptz - INTERVAL '180 days' THEN oi.quantity::int ELSE 0 END) AS sales_180day,
   451	                SUM(CASE WHEN o.order_date >= :order_date_ts::timestamptz - INTERVAL '365 days' THEN oi.quantity::int ELSE 0 END) AS sales_365day
   452	            FROM dtb_order_item oi
   453	            JOIN dtb_order o ON oi.order_id = o.id
   454	            JOIN dtb_shipping s ON oi.shipping_id = s.id
   455	            JOIN dtb_base_info bi ON s.base_info_id = bi.id
   456	            WHERE o.order_date >= :order_date_ts::timestamptz - INTERVAL '366 days'
   457	              AND o.order_status_id != :cancel_status
   458	              AND bi.is_open_shop = true
   459	              AND oi.order_item_type_id = :product_item_type
   460	              AND oi.product_class_id IS NOT NULL
   461	            GROUP BY oi.product_class_id, s.base_info_id
   462	            SQL;
   463	
   464	        return $this->getEntityManager()
   465	            ->createNativeQuery($query, $rsm)
   466	            ->setParameter('cancel_status', $cancelStatus)
   467	            ->setParameter('product_item_type', $productItemType)
   468	            ->setParameter('order_date_ts', $orderDateUtc->format('Y-m-d H:i:sP'))
   469	            ->getResult();
   470	    }
