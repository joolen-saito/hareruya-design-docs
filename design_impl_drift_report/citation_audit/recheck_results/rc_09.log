   308	     * For update sales summary (OrderQuantity01 ～ OrderQuantity08 in product_sub_class)
   309	     * @param Application $app
   310	     * @return array
   311	     */
   312	    public function getSaleForUpdateSummary(Application $app)
   313	    {
   314	        $date = new \DateTime();
   315	        $dateStr = $date->format('Y-m-d');
   316	        $excludeStatuses = [
   317	            OrderStatus::ORDER_CANCEL,
   318	            OrderStatus::ORDER_PROCESSING,
   319	        ];
   320	        $excludeStatusesStr = implode(',', $excludeStatuses);
   321	        $rsm = new ResultSetMapping();
   322	        $rsm
   323	            ->addScalarResult('product_class_id', 'product_class_id')
   324	            ->addScalarResult('sales_yesterday', 'sales_yesterday')
   325	            ->addScalarResult('sales_3day', 'sales_3day')
   326	            ->addScalarResult('sales_weekly', 'sales_weekly')
   327	            ->addScalarResult('sales_month', 'sales_month')
   328	            ->addScalarResult('sales_90day', 'sales_90day')
   329	            ->addScalarResult('sales_180day', 'sales_180day')
   330	            ->addScalarResult('sales_365day', 'sales_365day');
   331	
   332	        $query = "
   333	            select od.product_class_id,
   334	                sum(case when date_format(o.order_date,'%Y%m%d') = date_format(date_sub('{$dateStr}', interval 1 day),'%Y%m%d') and o.status NOT IN ({$excludeStatusesStr}) then od.quantity else 0 end) as sales_yesterday,
   335	                sum(case when date_format(o.order_date,'%Y%m%d') >= date_format(date_sub('{$dateStr}', interval 3 day),'%Y%m%d') and o.status NOT IN ({$excludeStatusesStr}) then od.quantity else 0 end) as sales_3day,
   336	                sum(case when date_format(o.order_date,'%Y%m%d') >= date_format(date_sub('{$dateStr}', interval 7 day),'%Y%m%d') and o.status NOT IN ({$excludeStatusesStr}) then od.quantity else 0 end) as sales_weekly,
   337	                sum(case when date_format(o.order_date,'%Y%m%d') >= date_format(date_sub('{$dateStr}', interval 28 day),'%Y%m%d') and o.status NOT IN ({$excludeStatusesStr}) then od.quantity else 0 end) as sales_month,
   338	                sum(case when date_format(o.order_date,'%Y%m%d') >= date_format(date_sub('{$dateStr}', interval 90 day),'%Y%m%d') and o.status NOT IN ({$excludeStatusesStr}) then od.quantity else 0 end) as sales_90day,
   339	                sum(case when date_format(o.order_date,'%Y%m%d') >= date_format(date_sub('{$dateStr}', interval 180 day),'%Y%m%d') and o.status NOT IN ({$excludeStatusesStr}) then od.quantity else 0 end) as sales_180day,
   340	                sum(case when date_format(o.order_date,'%Y%m%d') >= date_format(date_sub('{$dateStr}', interval 365 day),'%Y%m%d') and o.status NOT IN ({$excludeStatusesStr}) then od.quantity else 0 end) as sales_365day
   341	            from dtb_order_detail od
   342	                 join dtb_order o on od.order_id = o.order_id
   343	                 join
   344	                 (
   345	                     select order_detail_id
   346	                     from dtb_order_detail iod
   347	                          join dtb_order io on io.order_id = iod.order_id
   348	                     where io.order_date >= DATE_SUB('{$dateStr}', interval 366 day)
   349	                 ) as target on od.order_detail_id = target.order_detail_id
   350	            group by od.product_class_id";
