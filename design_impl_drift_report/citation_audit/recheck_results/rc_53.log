from html.parser import HTMLParser
from pathlib import Path
terms=['/format/','formatId','admin_format_delete','"'^[1-9'"','DELETE','admin.format.error.delete.event','Referer','dtb_card_format','javascript','DeleteModal','モーダル','ID昇順','admin.register.complete','admin.delete.complete','admin.register.failed','page_no','/deck/search/','admin_deck_search','m15-01_admin']
class P(HTMLParser):
 def __init__(self,path): super().__init__(); self.path=path; self.ref=None; self.buf=[]
 def handle_starttag(self,tag,attrs):
  d=dict(attrs)
  if tag=='span' and 'src-cell' in d.get('class','').split():self.ref=d.get('data-excel-ref');self.buf=[]
 def handle_endtag(self,tag):
  if tag=='span' and self.ref is not None:
   txt=' '.join(''.join(self.buf).split())
   for term in terms:
    if term.casefold() in txt.casefold(): hits[term].append((self.path,self.ref,txt))
   self.ref=None;self.buf=[]
 def handle_data(self,data):
  if self.ref is not None:self.buf.append(data)
hits={t:[] for t in terms}
for f in Path('/home/y-saito/Developments/hareruya-design-docs/excel_to_html/output').glob('*.html'):
 p=P(f.name); p.feed(f.read_text(errors='replace'))
for term in terms:
 print('\\nTERM',repr(term),'HITS',len(hits[term]))
 for row in hits[term][:80]:print(' | '.join(row))
