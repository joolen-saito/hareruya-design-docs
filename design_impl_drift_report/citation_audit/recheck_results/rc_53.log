  1274	                  <tr data-connector-state="soft" data-excel-ref="0212:デッキ一覧(検索入力)!P24"><td>8</td><td>0212:デッキ一覧(検索入力)!P24</td><td>no_connection</td><td>soft</td></tr>
  1275	                </tbody>
