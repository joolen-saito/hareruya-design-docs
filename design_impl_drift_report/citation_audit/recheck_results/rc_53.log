   161	        if (!$format->getEvents()->isEmpty() || !$format->getDecks()->isEmpty() || !$format->getArchetypes()->isEmpty()) {
   162	            $app->addError('admin.format.error.delete.event', 'admin');
   163	
   164	            return $app->redirect($request->headers->get('referer'));
   165	        }
   166	
   167	        // 禁止・制限情報の削除
