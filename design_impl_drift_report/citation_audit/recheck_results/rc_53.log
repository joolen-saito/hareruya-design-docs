    62	        $form = $app['form.factory']->createBuilder('hareruyaec_format', $format)->getForm();
    63	        // 関連テーブル項目に初期値を設定する
    64	        $form['bannedCards']->setData($bannedCards);
    65	        $form['restrictedCards']->setData($restrictedCards);
    66	        $form['commanderInMain']->setData($format->isCommanderInMain());
    67	
    68	        // 統率ボード上下限
    69	        if ($commanderFormatBoard = $format->getBoardByBoardId(MtbBoard::BOARD_ID_COMMAND)) {
    70	            $form['commandMaxCardCount']->setData($commanderFormatBoard->getMaxCardCount());
    71	            $form['commandMinCardCount']->setData($commanderFormatBoard->getMinCardCount());
    72	        }
    73	
    74	        return $app->render('HareruyaEc/Resource/template/admin/Format/formatedit.twig', [
