from html.parser import HTMLParser
from pathlib import Path
class P(HTMLParser):
 def __init__(self,target): super().__init__(); self.target=target; self.depth=0; self.ins=False; self.span=None; self.buf=[]
 def handle_starttag(self,tag,attrs):
  d=dict(attrs)
  if tag=='section' and d.get('id')==self.target: self.depth=1; self.ins=True
  elif self.ins and tag=='section': self.depth+=1
  if self.ins and tag=='span' and 'src-cell' in d.get('class','').split(): self.span=d.get('data-excel-ref'); self.buf=[]
