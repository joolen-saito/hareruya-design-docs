    43	    public function edit(Application $app, Request $request, $formatId = null)
    44	    {
    45	        if (is_null($format = $formatId ? $app['hareruya_ec.repository.format']->find($formatId) : new MtbFormat())) {
    46	            // DBに見つからない場合はエラーとする
    47	            return $app->abort(404);
    48	        }
    49	
    50	        ini_set("memory_limit", "500M");
    51	
    52	        /**
    53	         * カード&フォーマット関連
    54	         */
    55	        $cardFormatArr = $app['hareruya_ec.repository.card_format']->findByFormatId($formatId);
    56	        $bannedCards = [];
    57	        $restrictedCards = [];
    58	        // 禁止カードと制限カードを抽出する
    59	        $this->extractBannedOrRestrictedCards($cardFormatArr, $bannedCards, $restrictedCards);
    60	
