<?php
namespace Plugin\HareruyaEc\Form\Type\Admin\Entry;

use Symfony\Component\Validator\ConstraintValidator;
use Symfony\Component\Validator\Constraint;
use Plugin\HareruyaEc\Entity\DtbEventEntry;

class EntryDuplicateValidator extends ConstraintValidator
{
    /**
     * validate
     * @param $value entryPlayer
     * @param $constraint Constraint
     */
    public function validate($value, Constraint $constraint)
    {
        $form = $this->context->getRoot();
        $eventEntryId = $form['eventEntryId']->getData();
        if ($eventEntryId) {
            $eventEntry = $constraint->app['orm.em']->getRepository('Plugin\HareruyaEc\Entity\DtbEventEntry')->find($eventEntryId);
        } else {
            $eventEntry = new DtbEventEntry();
            $eventEntry->setEventDetail(
                $constraint->app['orm.em']->getRepository('Plugin\HareruyaEc\Entity\DtbEventDetail')->find($form['eventDetailId']->getData())
            );
        }
        if (!$eventEntry) {
            $constraint->app->abort(404);
        }
        // 登録不能なプレイヤーが居るか確認
        $playersList = json_decode($value, true);
        foreach (array_column($playersList, 'id') as $playerId) {
            if ($playerId && (
                !$constraint->app['hareruya_ec.repository.player']->find($playerId)
                || (
                    $eventEntry->getEventDetail()->isEntriedByPlayerId((int)$playerId)
                    && !$eventEntry->isEntriedByPlayerId((int)$playerId)
                )
            )) {
                $this->context
                ->buildViolation($constraint->app->trans('form.entry.duplicate'))
                ->addViolation();
            }
        }
    }
}
