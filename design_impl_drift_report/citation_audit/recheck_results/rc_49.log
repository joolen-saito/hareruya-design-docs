    /** @var list<int> */
    protected const ADMIN_CSV_IMPORT_HISTORY_PAGE_COUNT_OPTIONS = [10, 50, 100, 300, 500, 1000, 2000, 10000, 12000];

    /** @var int */
    protected const ADMIN_CSV_IMPORT_MAX_ROWS = 5010;

    /**
     * CSVの行数を概算する（ダブルクォート内の改行は除いてカウント）。
     */
    protected function countCsvRows(?UploadedFile $file): int
    {
        if ($file === null) {
            return 0;
        }
        $path = $file->getRealPath();
        if ($path === false || $path === '') {
            return 0;
        }
        $contents = @file_get_contents($path);
        if ($contents === false) {
            return 0;
        }
        $replaced = preg_replace('/\"(.|\n|\r\n|\r)+?\"/', '', $contents);

        return substr_count($replaced, "\n");
    }

