     * skipped.
     */
    #[\ReturnTypeWillChange]
    #[\Override]
    public function rewind(): void
    {
        $this->file->rewind();
        if (null !== $this->headerRowNumber) {
            $this->file->seek($this->headerRowNumber + 1);
        }
