    /**
     * 申込登録　検索
     * オンライン受付ありの日程を持つイベントを検索
     *
     * @param array<string, mixed> $searchData
     */
    public function getQueryBuilderByEntryRegistrationSearchData(array $searchData): QueryBuilder
    {
        $qb = $this->createQueryBuilder('e')
            ->distinct()
            ->join('e.Details', 'ed', 'WITH', 'ed.entryFlg = true');

        $multi = $searchData['multi'] ?? null;
        if (StringUtil::isNotBlank($multi)) {
            $multi = trim(mb_convert_kana($multi, 's', 'UTF-8'));
            $texts = preg_split('/[\s,　]+/u', $multi);
            $queries = [];
            $searchColumns = ['nameJp', 'nameEn'];
            foreach ($texts as $num => $text) {
                if (empty($text)) {
                    continue;
                }
                $cond = "%{$text}%";
                foreach ($searchColumns as $column) {
                    $queries[] = "e.{$column} LIKE :{$column}{$num}";
                    $qb->setParameter("{$column}{$num}", $cond);
                }
            }
            if (!empty($queries)) {
                $qb->andWhere('('.implode(' OR ', $queries).')');
            }
        }

        $dateFrom = $searchData['start_date_from'] ?? null;
        $dateTo = $searchData['start_date_to'] ?? null;
        if (!empty($dateFrom)) {
            $qb->andWhere('ed.startDate >= :reg_entry_start_from')
                ->setParameter('reg_entry_start_from', $dateFrom);
        }
        if (!empty($dateTo)) {
            $qb->andWhere('ed.startDate < :reg_entry_start_to')
                ->setParameter('reg_entry_start_to', (clone $dateTo)->modify('+1 days'));
        }

        $baseInfos = $searchData['base_info'] ?? [];
        if ($baseInfos !== []) {
            $baseInfoIds = array_map(fn (BaseInfo $baseInfo) => $baseInfo->getId(), $baseInfos);
            $baseInfoIds = array_unique($baseInfoIds);
            if ($baseInfoIds !== []) {
                $qb->andWhere('IDENTITY(e.BaseInfo) IN (:baseInfoIds)')
                    ->setParameter('baseInfoIds', array_values($baseInfoIds));
            }
        }

        $qb->addOrderBy('e.id', 'DESC');

        return $qb;
    }

    /**
     * イベント管理　イベント一覧の件数を返す
     *
     * TODO: getQueryBuilderBySearchDataのコメントアウトを外すタイミングでここのコメントアウトも外す
     *
     * @param array<string, mixed> $searchData
     */
    public function getCountBySearchData(array $searchData): int
    {
        $qb = $this->getQueryBuilderBySearchData($searchData);

        return $qb->select($qb->expr()->count('e'))

class EventEntryDetailType extends AbstractType
{
    public function __construct(
        private readonly MtbEntryStatusRepository $entryStatusRepository,
        private readonly PaymentRepository $paymentRepository,
    ) {
    }

    #[\Override]
    public function buildForm(FormBuilderInterface $builder, array $options): void
    {
        $registrationMode = (bool) ($options['registration_mode'] ?? true);
        $requireEntryPlayer = (bool) ($options['require_entry_player'] ?? true);
        $entryStatusEditable = (bool) ($options['entry_status_editable'] ?? false);

        $builder
            ->add('eventDetailId', HiddenType::class, [
                'mapped' => false,
                'required' => false,
            ])
            ->add('eventEntryId', HiddenType::class, [
                'mapped' => false,
                'required' => false,
            ])
            ->add('entryPlayer', HiddenType::class, [
                'mapped' => false,
                'required' => false,
                'constraints' => $requireEntryPlayer ? [
                    new NotBlank([
                        'message' => 'admin.event.entry.player_required',
                    ]),
                    new Regex([
                        'pattern' => '/^[1-9]\d*$/',
                        'message' => 'admin.event.entry.player_id_invalid',
                    ]),
                ] : [],
            ])
            ->add('EntryStatus', EntityType::class, [
                'class' => MtbEntryStatus::class,
                'label' => 'admin.event.entry.entry_status',
                'required' => true,
                'placeholder' => false,
                'choice_label' => 'name',
                'choice_translation_domain' => false,
                'query_builder' => function (EntityRepository $er) use ($registrationMode) {
                    $qb = $er->createQueryBuilder('es')->orderBy('es.id', 'ASC');
                    if ($registrationMode) {
                        $qb->andWhere('es.id = :id')->setParameter('id', MtbEntryStatus::ENTERED);
                    }

                    return $qb;
                },
                'disabled' => !$entryStatusEditable,
                'attr' => [
                    'class' => 'form-select',
                ],
            ])
            ->add('Payment', EntityType::class, [
                'class' => Payment::class,
                'label' => 'admin.event.entry.payment',
                'required' => true,
                'choice_label' => fn (Payment $Payment) => $Payment->isVisible()
                    ? $Payment->getMethod()
                    : $Payment->getMethod().trans('admin.common.hidden_label'),
                'placeholder' => false,
                'query_builder' => fn (EntityRepository $er) => $er->createQueryBuilder('p')
                    ->where('p.id = :id')
                    ->setParameter('id', Payment::EC_ADMIN),
                'disabled' => true,
                'attr' => [
                    'class' => 'form-select',
                ],
            ])
            ->add('price', IntegerType::class, [
                'label' => 'admin.event.entry.price',
                'required' => false,
                'disabled' => true,
                'attr' => [
                    'class' => 'form-control payment',
                ],
            ])
            ->add('search', TextType::class, [
                'mapped' => false,
                'label' => false,
                'required' => false,
                'attr' => [
                    'class' => 'form-control',
                ],
            ])
        ;

        $builder->addEventListener(FormEvents::PRE_SET_DATA, function (FormEvent $event): void {
            $data = $event->getData();
            if (!$data instanceof DtbEventEntry) {
                return;
            }
            if ($data->getId() !== 0) {
                return;
            }
            $entered = $this->entryStatusRepository->find(MtbEntryStatus::ENTERED);
            if ($entered instanceof MtbEntryStatus) {
                $data->setEntryStatus($entered);
            }
            $payment = $this->paymentRepository->find(Payment::EC_ADMIN);
            if ($payment instanceof Payment) {
                $data->setPayment($payment);
            }
            $eventDetail = $data->getEventDetail();
            $data->setPrice($eventDetail->getEntryFee());
        });
    }

    #[\Override]
    public function configureOptions(OptionsResolver $resolver): void
    {
        $resolver->setDefaults([
            'data_class' => DtbEventEntry::class,
            'registration_mode' => true,
            'require_entry_player' => true,
            'entry_status_editable' => false,
        ]);
        $resolver->setAllowedTypes('registration_mode', 'bool');
        $resolver->setAllowedTypes('require_entry_player', 'bool');
        $resolver->setAllowedTypes('entry_status_editable', 'bool');
    }

    #[\Override]
    public function getBlockPrefix(): string
    {
        return 'admin_event_entry_detail';
    }
