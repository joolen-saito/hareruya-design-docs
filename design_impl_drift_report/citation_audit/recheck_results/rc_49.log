        if (!$form->isSubmitted()) {
            $app->addError('admin.register.failed', 'admin');

            return $app->redirect($app->url('admin_entry_new', [
                'eventDetailId' => $form['eventDetailId']->getData()
            ]));
        }

        if (!$this->isFormValid($app, $form)) {
            if (!$form['price']->isValid()) {
                $app->addError('form.price.message', 'admin');
            } else {
                $app->addError('form.entry.duplicate', 'admin');
            }

            return $app->redirect($app->url('admin_entry_new', ['eventDetailId' => $form['eventDetailId']->getData()]));
        }
        // 新規イベント申込情報の作成
        $eventEntry = new DtbEventEntry();
        $playersList = json_decode($form['entryPlayerList']->getData(), true);
        // フォームからデータ設定
        $this->setValues($eventEntry, $form, [
            'eventDetailId',
            'eventEntryId',
            'entryStatusId',
            'entryStatus',
            'paymentId',
            'payment',
            'entryPlayers',
            'entryHistories',
            'payingCustomerId',
            'payingCustomer',
        ]);
        $eventEntry->setEventDetail(
            $app['orm.em']->getRepository('Plugin\HareruyaEc\Entity\DtbEventDetail')->find($eventDetailId)
        );
        $eventEntry->setPayingCustomer($app['hareruya_ec.repository.player']->find($playersList[0]['id'])->getCustomer());
        // entryStatus及びpaymentは、入力不能につき固定の値を入れる
        $eventEntry->setEntryStatus($app['hareruya_ec.repository.entry_status']->find(MtbEntryStatus::ENTERED));
        $eventEntry->setPayment($app['eccube.repository.payment']->find(Payment::EC_ADMIN));
        // EventEntryのIDを得る為、プレイヤーより先にDB登録を済ませる
        $app['orm.em']->persist($eventEntry);
        $app['orm.em']->flush();
        // 申込履歴
        $app['hareruya_ec.repository.entry_history']->createEntryHistory($app, $eventEntry, true);
        // プレイヤー情報登録
        $eventEntryId = $eventEntry->getEventEntryId();
        foreach ($playersList as $listItem) {
            $entryPlayer = new DtbEntryPlayer();
            $entryPlayer
                ->setEventEntryId($eventEntryId)
                ->setPlayerId($listItem['id'])
                ->setConfirmFlg($listItem['confirm'])
                ->setSeatOrder($listItem['seat'])
                ->setEventEntry($eventEntry)
                ->setPlayer($app['hareruya_ec.repository.player']->find($listItem['id']));
            $app['orm.em']->persist($entryPlayer);
        }
        $app['orm.em']->flush();
        $app->addSuccess('admin.register.complete', 'admin');

        return $app->redirect($app->url('admin_entry_edit', ['eventEntryId' => $eventEntryId]));
    }

    /**
     * イベント申込更新
     * @param Application $app
     * @param Request $request
     * @param integer $eventEntryId イベント申込ID
     * @return \Symfony\Component\HttpFoundation\Response
     */
        set_time_limit(0);

        $headers = self::CSV_HEADER;

        /** @var FormInterface $form */
        $form = $app['form.factory']->createBuilder('admin_csv_import')->getForm();
        $form->handleRequest($request);

        if (!$this->isFormValid($app, $form)) {
            foreach ($form->getErrors(true) as $error) {
                $app->addError($error->getMessage(), 'admin');
            }

            return $this->render($app, $form, $headers, $this->importTwig);
        }

        /** @var UploadedFile $file */
        $file = $form['import_file']->getData();

        // レコード数上限チェック
        if ((int)exec('wc -l '.$file) >= self::CSV_IMPORT_MAX) {
            $app->addError(sprintf($app->trans('admin.csv.error.upload.maxrecord'), self::CSV_IMPORT_MAX), 'admin');

            return $this->render($app, $form, $headers, $this->importTwig);
        }

        log_info('イベント一括登録CSV登録開始');

        $importer = new CsvImporter($app, new BulkEntryImportHandler($app));
        $result = $importer->import($file);

        if ($result->hasError()) {
            log_info('イベント一括登録 異常終了');

            return $this->render($app, $form, $headers, $this->importTwig, $result->getErrors());
        }

        $app->addSuccess('admin.event.save.complete', 'admin');
        log_info('イベント一括登録', ['count' => $result->getCount()]);

        return $app->redirect($app->path('admin_entry_bulk_csv'));
    }

    /**
     * アップロード用CSV雛形ファイルダウンロード
     *
     * @param Application $app
     * @param Request $request
     * @param string $type
     *
     * @return \Symfony\Component\HttpFoundation\Response
        ))
        // 支払金額
        ->add('price', 'money', array(
            'label' => $this->app['translator']->trans('form.price.label'),
            'required' => true,
            'currency' => 'JPY',
            'scale' => 0,
            'constraints' => array(
                // 金額（数字）のみ
                new Assert\Regex(array(
                    'pattern' => '/^[0-9]+$/',
                )),
            ),
        ))
        // イベント詳細ID
        ->add('eventDetailId', 'hidden')
        // イベント申込ID
        ->add('eventEntryId', 'hidden')
        // プレイヤー情報リスト(JSON形式、{id : ??, confirm : ??, seat : ??})
        ->add('entryPlayerList', 'hidden', array(
            'required' => true,
            'constraints' => array(
                new EntryDuplicate($this->app),
            ),
        ))
        // プレイヤー検索
        ->add('search', 'text', array(
            'required' => false,
        ))
        ;
    }

