    /**
     * @return RedirectResponse|array<string, mixed>
     */
    #[Route(
        path: '/%eccube_admin_route%/event/entry/bulk_csv_import',
        name: 'admin_event_entry_bulk_csv_import',
        methods: ['GET', 'POST'],
        priority: 10,
    )]
    #[Template(template: '@admin/Event/Entry/event_bulk_csv_import.twig')]
    public function index(Request $request): RedirectResponse|array
    {
        $form = $this->createForm(CsvImportType::class);

        $event = new EventArgs(
            [
                'form' => $form,
            ],
            $request
        );
        $this->eventDispatcher->dispatch($event, EccubeEvents::ADMIN_EVENT_ENTRY_BULK_CSV_INDEX_INITIALIZE);

        $headers = [];
        foreach (EventBulkCsvImportHandler::ORDERED_HEADERS as $i => $name) {
            $headers[] = [
                'name' => $name,
                'description' => EventBulkCsvImportHandler::FORMAT_TABLE_DESCRIPTIONS[$name] ?? '',
                'required' => EventBulkCsvImportHandler::REQUIRED_ON_CELL[$i],
            ];
        }
        $errors = [];

        if ($request->getMethod() === 'POST') {
            $form->handleRequest($request);
            if ($form->isSubmitted() && $form->isValid()) {
                /** @var UploadedFile $formFile */
                $formFile = $form->get('import_file')->getData();
                if ($this->countCsvRows($formFile) > static::ADMIN_CSV_IMPORT_MAX_ROWS) {
                    return [
                        'form' => $form->createView(),
                        'headers' => $headers,
                        'errors' => [
                            $this->translator->trans('admin.csv.error.upload.maxrecord', [
                                '%maxRecord%' => static::ADMIN_CSV_IMPORT_MAX_ROWS,
                            ]),
                        ],
                    ];
                }
                $user = $this->getUser();
                if (!$user instanceof Member) {
                    return [
                        'form' => $form->createView(),
                        'headers' => $headers,
                        'errors' => [$this->translator->trans('admin.common.system_error')],
                    ];
                }
                log_info('イベント一括登録CSV登録開始');
                $handler = new EventBulkCsvImportHandler(
                    $this->eventEntityManager,
                    $this->eventDetailEntityManager,
                    $this->paymentRepository,
                    $this->baseInfoRepository,
                    $this->mtbFormatRepository,
                    $this->mtbRelRepository,
                    $this->mtbDispRepository,
                    $this->mtbHolidayRepository,
                    $this->eccubeConfig,
                    $this->translator,
                    $user,
                );
                $importer = new CsvImporter(
                    $this->entityManager,
                    $this->translator,
                    $this->eccubeConfig,
                    $handler,
                    $user,
                );
                $result = null;
                try {
                    $result = $importer->import($formFile);
                } catch (\Exception $e) {
                    $errors[] = $e->getMessage();
                }
                if ($errors === [] && $result->hasError()) {
                    $errors = array_map(
                        static fn (array $error): string => $error['message'],
                        $result->getErrors()
                    );
                }
                if ($errors === []) {
                    log_info('イベント一括登録CSV登録完了');

                    $event = new EventArgs(
                        [
                            'form' => $form,
                        ],
                        $request
                    );
                    $this->eventDispatcher->dispatch($event, EccubeEvents::ADMIN_EVENT_ENTRY_BULK_CSV_INDEX_COMPLETE);

                    $this->addSuccess('admin.common.csv_upload_complete', 'admin');

                    return $this->redirectToRoute('admin_event_entry_bulk_csv_import');
                }
            } else {
                foreach ($form->getErrors(true) as $error) {
                    $errors[] = $error->getMessage();
                }
            }
        }

        return [
            'form' => $form->createView(),
            'headers' => $headers,
            'errors' => $errors,
        ];
    }

        }

