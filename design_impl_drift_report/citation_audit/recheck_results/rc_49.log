    public function handle(EntryRegistrationStoreInput $input): DtbEventEntry
    {
        return $this->entityManager->wrapInTransaction(function () use ($input): DtbEventEntry {
            $FormEventEntry = $input->EventEntry;
            $player = $this->playerRepository->find($input->playerId);
            if ($player === null) {
                throw new \InvalidArgumentException($this->translator->trans('admin.event.entry.registration_player_not_found', ['%player_id%' => (string) $input->playerId]));
            }
            $PayingCustomer = $player->getCustomer();
            if ($PayingCustomer === null) {
                throw new \InvalidArgumentException($this->translator->trans('admin.event.entry.paying_member_customer_not_registered'));
            }

            $EventEntry = $this->eventEntryEntityManager->save(
                Entry: null,
                EventDetail: $input->EventDetail,
                EntryStatus: $FormEventEntry->getEntryStatus(),
                Payment: $FormEventEntry->getPayment(),
                price: $FormEventEntry->getPrice(),
                paymentNo: $FormEventEntry->getPaymentNo(),
                paymentLimit: $FormEventEntry->getPaymentLimit(),
                PayingCustomer: $PayingCustomer,
                deletedAt: null,
            );
            $this->entryPlayerEntityManager->save(
                EntryPlayer: null,
                EventEntry: $EventEntry,
                Player: $player,
                confirmFlg: false,
                seatOrder: 1,
            );

            $this->entityManager->flush();
            $this->entryHistoryRepository->createEntryHistory($EventEntry, $input->Member->getId());

            return $EventEntry;
        });
    }
