    /**
     * @param string|int $index 列の名前 or 列番号
     *
     * @return bool 列が存在する場合 true
     */
    public function exists(string|int $index): bool
    {
        if (is_int($index)) {
            return isset($this->values[$index]);
        }
        if (is_null($this->headers)) {
            throw new \LogicException('ヘッダ情報が未設定です。 setHeaders() でヘッダ名を設定してください。');
        }
        $indexByHeader = $this->headers[$index] ?? -1;

        return ($indexByHeader >= 0) && (isset($this->values[$indexByHeader]));
    }

    /**
     * @param string|int $index 列の名前 or 列番号
     *
     * @return string 列の値
     */
    public function getValue(string|int $index): string
    {
        return (string) $this->getColumnValue($index);
    }

    /**
     * @param string|int $index 列の名前 or 列番号
     *
     * @return string 列の値
     */
    private function getColumnValue(string|int $index): string
    {
        if (is_int($index)) {
            if (isset($this->values[$index])) {
                return $this->values[$index];
            }

            throw new \InvalidArgumentException(sprintf('%d 行目には %d 列目のデータが存在しません。（最大 %d 列）', $this->getRowNumber(), $index, $this->count()));
        }

        if (is_null($this->headers)) {
            throw new \LogicException('ヘッダ情報が未設定です。 setHeaders() でヘッダ名を設定してください。');
        }

        if (!isset($this->headers[$index])) {
            throw new \InvalidArgumentException(sprintf('ヘッダに指定されたキー %s が存在しません', $index));
        }

        $indexByHeader = $this->headers[$index];

        if (isset($this->values[$indexByHeader])) {
            return $this->values[$indexByHeader];
        }

        throw new \InvalidArgumentException(sprintf('%d 行目には %d 列目（%s）のデータが存在しません。（最大 %d 列）', $this->getRowNumber(), $indexByHeader, $index, $this->count()));
    }
