    /**
     * @return array<string, mixed>
     */
    #[Route(path: '/%eccube_admin_route%/entry_registration', name: 'admin_entry_registration', methods: ['GET', 'POST'])]
    #[Route(path: '/%eccube_admin_route%/entry_registration/page/{page_no}', name: 'admin_entry_registration_page', requirements: ['page_no' => '\d+'], methods: ['GET', 'POST'])]
    #[Template(template: '@admin/Event/EntryRegistration/index.twig')]
    public function index(Request $request, PaginatorInterface $paginator, ?int $page_no = null): array
    {
        $hasExplicitPageParam = $page_no !== null;
        $pageNo = $page_no ?? 1;
        $member = $this->getMember();
        $defaultBaseInfo = $member->getDefaultSearchBaseInfo();
        $builder = $this->formFactory
            ->createBuilder(EntryRegisterSearchType::class, null, [
                'base_info_default' => $defaultBaseInfo ? [$defaultBaseInfo] : [],
            ]);

        $event = new EventArgs(
            [
                'builder' => $builder,
            ],
            $request
        );
        $this->eventDispatcher->dispatch($event, EccubeEvents::ADMIN_EVENT_ENTRY_REGISTRATION_INDEX_INITIALIZE);

        $searchForm = $builder->getForm();
        $pagination = null;
        $datas = [];
        $shouldSearch = false;
        $searchData = [];

        if ('POST' === $request->getMethod()) {
            $searchForm->handleRequest($request);
            if ($searchForm->isValid()) {
                $pageNo = 1;
                $searchData = $searchForm->getData();
                $this->session->set(self::SESSION_KEY, FormUtil::getViewData($searchForm));
                $this->session->set(self::SESSION_KEY.'.page_no', $pageNo);
                $shouldSearch = true;
            } else {
                return [
                    'searchForm' => $searchForm->createView(),
                    'pagination' => [],
                    'datas' => [],
                    'has_errors' => true,
                ];
            }
        } else {
            if ($hasExplicitPageParam || $request->get('resume') !== null) {
                if ($hasExplicitPageParam) {
                    $this->session->set(self::SESSION_KEY.'.page_no', $pageNo);
                } else {
                    $pageNo = (int) $this->session->get(self::SESSION_KEY.'.page_no', 1);
                }
                $viewData = $this->session->get(self::SESSION_KEY, []);
                $searchData = FormUtil::submitAndGetData($searchForm, $viewData);
                $shouldSearch = true;
            } else {
                $pageNo = 1;
                $viewData = FormUtil::getViewData($searchForm);
                $this->session->set(self::SESSION_KEY, $viewData);
                $this->session->set(self::SESSION_KEY.'.page_no', $pageNo);
            }
        }

        if ($shouldSearch) {
            $eventsQueryBuilder = $this->eventRepository->getQueryBuilderByEntryRegistrationSearchData(
                $searchData
            );
            $events = $eventsQueryBuilder->getQuery()->getResult();

            $allDatas = $this->entryRegistrationScheduleRowBuilder->expandScheduleRows(
                $events,
                !empty($searchData['start_date_from']) ? $searchData['start_date_from'] : null,
                !empty($searchData['start_date_to']) ? $searchData['start_date_to'] : null,
            );
            [$pagination, $datas] = $this->entryRegistrationScheduleRowBuilder->paginateWithRowSpanByEvent(
                $paginator,
                $allDatas,
                $pageNo,
                self::SCHEDULES_PER_PAGE
            );
        }

        return [
            'searchForm' => $searchForm->createView(),
            'pagination' => $pagination,
            'datas' => $datas,
        ];
    }

    /**
     * イベント申込新規（GET: フォーム表示、POST: 登録処理）
     *
     * @return RedirectResponse|array<string, mixed>
     */
    #[Route(path: '/%eccube_admin_route%/entry_registration/new/{eventDetailId}', name: 'admin_entry_new', requirements: ['eventDetailId' => '\d+'], methods: ['GET', 'POST'])]
    #[Template(template: '@admin/Event/EntryRegistration/edit.twig')]
    public function create(Request $request, #[MapEntity(id: 'eventDetailId')] DtbEventDetail $eventDetail): RedirectResponse|array
    {
        $baseInfo = $eventDetail->getEvent()->getBaseInfo();
        if ($baseInfo === null || !$this->getMember()->isEditableShop($baseInfo)) {
            throw $this->createNotFoundException();
        }

        $eventEntry = new DtbEventEntry();
        $eventEntry->setId(0);
        $eventEntry->setEventDetail($eventDetail);

        $form = $this->formFactory->create(EventEntryDetailType::class, $eventEntry, ['registration_mode' => true]);
        $form->get('eventDetailId')->setData((string) $eventDetail->getId());

        $event = new EventArgs(
            [
                'form' => $form,
            ],
            $request
        );
        $this->eventDispatcher->dispatch($event, EccubeEvents::ADMIN_EVENT_ENTRY_REGISTRATION_CREATE_INITIALIZE);

        $form->handleRequest($request);

        $entryPlayer = $form->get('entryPlayer')->getData();
        $submittedPlayerId = is_string($entryPlayer) && $entryPlayer !== '' ? (int) $entryPlayer : 0;

        if ($form->isSubmitted() && $form->isValid()) {
            /** @var DtbEventEntry $FormEventEntry */
            $FormEventEntry = $form->getData();
            $input = new EntryRegistrationStoreInput($FormEventEntry, $eventDetail, $this->getMember(), $submittedPlayerId);
            try {
                $this->entryRegistrationStoreAction->handle($input);

                $event = new EventArgs(
                    [
                        'form' => $form,
                    ],
                    $request
                );
