     *                        (dup => [value1, value2, value3])
     */
    public function setHeaderRowNumber(int $rowNumber, ?int $duplicates = null): bool
    {
        $this->duplicateHeadersFlag = $duplicates ?? 0;
        $this->headerRowNumber = $rowNumber;
        $headers = $this->readHeaderRow($rowNumber);

        if ($headers === false) {
            return false;
        }
        $this->setColumnHeaders($headers);

        return true;
    }

    /**
