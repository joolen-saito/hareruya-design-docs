   590	    public function bulkUpdate(Application $app, Request $request)
   591	    {
   592	        $builder = $app['form.factory']->createBuilder('admin_entry_bulk_update');
   593	        $form = $builder->getForm();
   594	        $form->handleRequest($request);
   595	        if (!$request->isXmlHttpRequest()) {
   596	            return $app->json(['message'=> $app->trans('admin.register.failed')]);
   597	        }
   598	        if (!$this->isFormValid($app, $form)) {
   599	            $errors = [];
   600	            foreach ($form->getErrors(true) as $error) {
   601	                $errors[] = $error->getMessage();
   602	            }
   603	
   604	            return $app->json(['message'=> $errors]);
   605	        }
   606	        // エントリーID毎処理
   607	        $entries = $app['hareruya_ec.repository.event_entry']->findBy(['eventEntryId' => $request->get('entries')]);
   608	        foreach ($entries as $eventEntry) {
   609	            $eventEntry->setEntryStatus($form['entryStatus']->getData());
   610	            $app['orm.em']->persist($eventEntry);
   611	            // 申込履歴
   612	            $app['hareruya_ec.repository.entry_history']->createEntryHistory($app, $eventEntry, true);
   613	        }
   614	        $app['orm.em']->flush();
   615	
   616	        return $app->json(['message'=> [$app->trans('admin.register.complete')]]);
   617	    }
