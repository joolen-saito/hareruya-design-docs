   104	            'data_class' => TaxRule::class,
   105	        ]);
   106	    }
   107	
   108	    /**
   109	     * {@inheritdoc}
   110	     */
   111	    #[\Override]
   112	    public function getBlockPrefix(): string
   113	    {
   114	        return 'tax_rule';
   115	    }
   116	}
