            <table class="item-table">
              <thead>
                <tr><th><span class="src-cell" data-excel-book="0505" data-excel-sheet="注文印刷_印刷情報をプリンタへ送信" data-excel-ref="0505:注文印刷_印刷情報をプリンタへ送信!E22">現状</span></th><th><span class="src-cell" data-excel-book="0505" data-excel-sheet="注文印刷_印刷情報をプリンタへ送信" data-excel-ref="0505:注文印刷_印刷情報をプリンタへ送信!G22">/order/print/direct?ConnectionType=GetRequest</span></th><th><span class="src-cell" data-excel-book="0505" data-excel-sheet="注文印刷_印刷情報をプリンタへ送信" data-excel-ref="0505:注文印刷_印刷情報をプリンタへ送信!U22">GETで受信</span></th><th></th></tr>
              </thead>
