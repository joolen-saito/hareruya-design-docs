    /**
     * getUpdatedProductClasses - 正常系
     * 更新日時が期間内の商品規格が存在する場合、count と result を含む JSON が返ること
     *
     * @group HARERUYA
     */
    public function testGetUpdatedProductClasses(): void
    {
        $this->generator->createFullProduct('test_updated_product', 1);
        $today = (new \DateTime())->format('Y-m-d');

        $this->client->request(Request::METHOD_GET, "/updateProducts/{$today}/{$today}");

        $this->assertSame(Response::HTTP_OK, $this->client->getResponse()->getStatusCode());

        $responseData = json_decode($this->client->getResponse()->getContent(), true);
        $this->assertIsArray($responseData);
        $this->assertArrayHasKey('count', $responseData);
        $this->assertArrayHasKey('result', $responseData);
        $this->assertGreaterThan(0, $responseData['count']);
        $this->assertCount($responseData['count'], $responseData['result']);

        $item = $responseData['result'][0];
        $this->assertArrayHasKey('productId', $item);
        $this->assertArrayHasKey('name', $item);
        $this->assertArrayHasKey('stock', $item);
        $this->assertArrayHasKey('price02', $item);
        $this->assertArrayHasKey('statusId', $item);
        $this->assertArrayHasKey('productClassUpdateDate', $item);
        $this->assertArrayHasKey('productUpdateDate', $item);
    }

    /**
     * getUpdatedProductClasses - 正常系（.json サフィックス）
     * .json サフィックスでリクエストした場合も 200 OK が返ること
     *
     * @group HARERUYA
     */
    public function testGetUpdatedProductClassesWithJsonSuffix(): void
    {
        $this->generator->createFullProduct('test_updated_product_json', 1);
        $today = (new \DateTime())->format('Y-m-d');

        $this->client->request(Request::METHOD_GET, "/updateProducts/{$today}/{$today}.json");

        $this->assertSame(Response::HTTP_OK, $this->client->getResponse()->getStatusCode());

        $responseData = json_decode($this->client->getResponse()->getContent(), true);
        $this->assertIsArray($responseData);
        $this->assertArrayHasKey('count', $responseData);
        $this->assertArrayHasKey('result', $responseData);
    }

    /**
     * getUpdatedProductClasses - 正常系（該当商品規格なし）
     * 期間内に更新された商品規格がない場合、count=0・result=[] が返ること
     *
     * @group HARERUYA
     */
    public function testGetUpdatedProductClassesEmptyResult(): void
