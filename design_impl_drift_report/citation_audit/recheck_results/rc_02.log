  1609	    {
  1610	        $qb = $this->createQueryBuilder('o');
  1611	        $qb->select([
  1612	            'o.id AS order_id',
  1613	            'o.order_date AS order_date',
  1614	            'o.order_number AS order_number',
  1615	            "CONCAT(o.kana01, ' ', o.kana02) AS name_kana",
  1616	            "CONCAT(o.name01, ' ', o.name02) AS name",
  1617	            'o.payment_total AS payment_total',
  1618	            'IDENTITY(o.OrderStatus) AS status',
  1619	            "'□' AS expensive",
  1620	            'o.smaregi_code AS smaregi_code',
  1621	            'CASE WHEN o.message IS NOT NULL THEN true ELSE false END AS hasMessage',
  1622	        ])
  1623	            ->join('\Eccube\Entity\Shipping', 's', 'WITH', 's.Order = o')
  1624	            ->where('IDENTITY(o.baseInfo) = :baseInfoId')
  1625	            ->andWhere('o.order_number IS NOT NULL')
  1626	            ->andWhere($qb->expr()->orX(
  1627	                $qb->expr()->andX(
  1628	                    's.Delivery = :otc',
  1629	                    'o.OrderStatus = :orderNew'
