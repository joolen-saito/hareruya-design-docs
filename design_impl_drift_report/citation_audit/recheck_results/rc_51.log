    #[Route('/%eccube_admin_route%/card/{id}/delete', name: 'admin_card_delete', requirements: ['id' => '\d+'], methods: ['DELETE'])]
    public function delete(Request $request, MtbCard $card): RedirectResponse
    {
        $this->isTokenValid();

        $pageNo = $this->session->get($this->sessionKey.'.page_no', 1);
        $referer = $request->headers->get('referer');

        $indexUrl = $this->generateUrl('admin_card_search', ['page_no' => $pageNo]).'?resume='.Constant::ENABLED;
        $editUrl = $this->generateUrl('admin_card_edit', ['id' => $card->getId()]);

        // 失敗時の戻り先
        $isEditPage = $referer && str_contains($referer, '/edit');
        $errorRedirectUrl = $isEditPage ? $editUrl : $indexUrl;

        if (!$this->cardRepository->isDeletable($card)) {
            $this->addError(trans('admin.card.delete.error_foreign_key', ['%card_name%' => $card->getNameJpWithEn()]), 'admin');

            return $this->redirect($errorRedirectUrl);
        }

        try {
            $this->entityManager->remove($card);
            $this->entityManager->flush();
        } catch (\Exception $e) {
            log_error('カード削除エラー', ['id' => $card->getId(), 'message' => $e->getMessage()]);
            $this->addError('admin.common.delete_error', 'admin');

            return $this->redirect($errorRedirectUrl);
        }

        $event = new EventArgs(
            [
                'Card' => $card,
            ],
            $request
        );
        $this->eventDispatcher->dispatch($event, EccubeEvents::ADMIN_CARD_DELETE_COMPLETE);

        $this->addSuccess('admin.common.delete_complete', 'admin');

        return $this->redirect($indexUrl);
    }

