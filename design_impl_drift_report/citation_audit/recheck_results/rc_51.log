    public static function multiTextQuery($qb, $params, $searchedColumns)
    {
        foreach ($params as $num => $param) {
            if (empty($param)) {
                continue;
            }
            $likeArr = array();
            foreach ($searchedColumns as $tableName => $table) {
                foreach ($table as $columnName) {
                    $likeArr[] = $qb->expr()->like(
                        $tableName . '.' . $columnName,
                        ':' . $columnName . $num
                    );
                    $qb->setParameter("{$columnName}{$num}", '%' . addcslashes($param, '%_') . '%');
                }
            }
            $qb->andWhere(new Orx($likeArr));
        }
    }

