    /**
     * CSVImportService を生成する。
     *
     * @param UploadedFile $file インポートするファイル
     * @param string $tempFileName 一時ファイルの名前
     *
     * @return CsvImportService
     */
    protected function createCsvImportService(UploadedFile $file, string $tempFileName): CsvImportService
    {
        // アップロードされたCSVファイルを一時ディレクトリに保存
        $file->move($this->eccubeConfig['eccube_csv_temp_realdir'], $tempFileName);

        $filePath = $this->eccubeConfig['eccube_csv_temp_realdir'].'/'.$tempFileName;
        $splFile = new \SplFileObject($filePath);

        $fileExtension = $file->getClientOriginalExtension();
        $delimiter = ($fileExtension === 'tsv') ? "\t" : $this->eccubeConfig['eccube_csv_import_delimiter'];

        return new CsvImportService($splFile, $delimiter, $this->eccubeConfig['eccube_csv_import_enclosure']);
    }

