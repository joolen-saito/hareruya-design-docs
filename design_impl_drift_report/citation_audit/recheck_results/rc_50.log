use Silex\Application as BaseApplication;
use Silex\ServiceProviderInterface;

class BannerServiceProvider implements ServiceProviderInterface
{

    public function register(BaseApplication $app)
    {
        // イベントバナー管理
        $app->get('/'.$app['config']['admin_route'].'/banner/event', 'Plugin\HareruyaEc\Controller\Admin\BannerController::eventIndex')
            ->bind('admin_banner');
        $app->get('/'.$app['config']['admin_route'].'/banner/event/{html_class}', 'Plugin\HareruyaEc\Controller\Admin\BannerController::eventIndex')
            ->bind('admin_banner_narrow');
        $app->post('/'.$app['config']['admin_route'].'/banner/event', 'Plugin\HareruyaEc\Controller\Admin\BannerController::eventBannerSet')
            ->bind('admin_banner_update');
        $app->post('/'.$app['config']['admin_route'].'/banner/event/{html_class}', 'Plugin\HareruyaEc\Controller\Admin\BannerController::eventBannerSet')
            ->bind('admin_banner_update_narrow');
        $app->delete('/'.$app['config']['admin_route'].'/banner/event/delete', 'Plugin\HareruyaEc\Controller\Admin\BannerController::delete')
