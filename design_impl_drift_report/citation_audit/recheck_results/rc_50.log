from html.parser import HTMLParser
from pathlib import Path

class SrcParser(HTMLParser):
    def __init__(self): super().__init__(); self.stack=[]; self.items=[]
    def handle_starttag(self, tag, attrs):
        attrs=dict(attrs)
        is_src=tag=='span' and 'src-cell' in attrs.get('class','').split()
        if is_src: self.stack.append({'ref':attrs.get('data-excel-ref'),'text':[],'depth':1})
        elif self.stack: self.stack[-1]['depth']+=1
    def handle_startendtag(self,tag,attrs): pass
    def handle_data(self,data):
        if self.stack: self.stack[-1]['text'].append(data)
    def handle_endtag(self,tag):
        if self.stack:
            self.stack[-1]['depth']-=1
            if self.stack[-1]['depth']==0:
                x=self.stack.pop(); x['text']=' '.join(''.join(x['text']).split()); self.items.append(x)

def load(fp):
 p=SrcParser(); p.feed(Path(fp).read_text()); return p.items
