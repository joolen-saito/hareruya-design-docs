   205	    /**
   206	     * 受注売上分析の集計を行う。
   207	     *
   208	     * @param array<string, mixed> $searchData
   209	     *
   210	     * @return array{result: array<int, array<string, mixed>>, total: array{sales: int, total: int, order_count: int}}
   211	     */
   212	    public function getAnalysisSummary(array $searchData): array
   213	    {
   214	        $summaryType = ($searchData['summary_type'] ?? null) === 'class_category_name' ? 'class_category_name' : 'product_id';
   215	        $dateType = in_array($searchData['date_type'] ?? null, self::ANALYSIS_DATE_COLUMNS, true)
   216	            ? (string) $searchData['date_type']
   217	            : 'order_date';
   218	
   219	        $avgPriceExpr = 'SUM(oi.price * oi.quantity) / NULLIF(SUM(oi.quantity), 0)';
   220	
   221	        $qb = $this->getEntityManager()->getConnection()->createQueryBuilder()
   222	            ->from('dtb_order_item', 'oi')
   223	            ->innerJoin('oi', 'dtb_order', 'o', 'oi.order_id = o.id')
   224	            ->innerJoin('oi', 'dtb_product', 'p', 'oi.product_id = p.id')
   225	            ->addSelect('SUM(oi.price * oi.quantity) AS total')
   226	            ->addSelect('SUM(oi.quantity) AS sales')
   227	            ->addSelect($avgPriceExpr.' AS price')
   228	            ->addSelect('COUNT(DISTINCT o.id) AS order_count');
   229	
   230	        if ($summaryType === 'class_category_name') {
   231	            $qb->addSelect("'' AS code")
   232	                ->addSelect('cat.category_name AS name')
   233	                ->innerJoin('oi', 'dtb_product_category', 'pcat', 'pcat.product_id = oi.product_id')
   234	                ->innerJoin('pcat', 'dtb_category', 'cat', 'cat.id = pcat.category_id')
   235	                ->groupBy('cat.category_name');
   236	        } else {
   237	            $qb->addSelect('oi.product_code AS code')
   238	                ->addSelect('MAX(oi.product_name) AS name')
   239	                ->groupBy('oi.product_code');
   240	        }
   241	
   242	        $baseInfoIds = array_values(array_filter(array_map('intval', (array) ($searchData['base_info_ids'] ?? []))));
   243	        if ($baseInfoIds === []) {
   244	            return ['result' => [], 'total' => ['sales' => 0, 'total' => 0, 'order_count' => 0]];
   245	        }
   246	        $qb->andWhere('o.base_info_id IN (:baseInfoIds)')
   247	            ->setParameter('baseInfoIds', $baseInfoIds, ArrayParameterType::INTEGER);
   248	
   249	        $qb->andWhere('o.order_date IS NOT NULL');
   250	
   251	        if ($dateType === 'cancel_date') {
   252	            $qb->andWhere('o.cancel_date IS NOT NULL')
   253	                ->andWhere('o.order_status_id = :cancelStatus')
   254	                ->setParameter('cancelStatus', OrderStatus::CANCEL);
   255	        } else {
   256	            $qb->andWhere('o.order_status_id != :cancelStatus')
   257	                ->setParameter('cancelStatus', OrderStatus::CANCEL);
   258	        }
   259	
   260	        if (!empty($searchData['summary_date_from'])) {
   261	            $qb->andWhere("o.{$dateType} >= :summaryDateFrom")
   262	                ->setParameter('summaryDateFrom', $searchData['summary_date_from']->format('Y-m-d H:i:s'));
   263	        }
   264	        if (!empty($searchData['summary_date_to'])) {
   265	            $qb->andWhere("o.{$dateType} <= :summaryDateTo")
   266	                ->setParameter('summaryDateTo', $searchData['summary_date_to']->format('Y-m-d H:i:s'));
   267	        }
   268	
   269	        $multi = isset($searchData['multi']) ? trim((string) $searchData['multi']) : '';
   270	        if ($multi !== '') {
   271	            $qb->leftJoin('p', 'mtb_card_detail', 'cd', 'p.card_detail_id = cd.id')
   272	                ->leftJoin('cd', 'mtb_card', 'c', 'cd.card_id = c.id');
   273	            $terms = preg_split('/[\s,\x{3000}]+/u', $multi, -1, PREG_SPLIT_NO_EMPTY) ?: [];
   274	            foreach ($terms as $index => $term) {
   275	                $param = 'multi'.$index;
   276	                $qb->andWhere("(oi.product_name LIKE :{$param} OR oi.product_code LIKE :{$param} OR p.name_en LIKE :{$param} OR c.name_jp LIKE :{$param} OR c.name_en LIKE :{$param} OR o.message LIKE :{$param} OR o.note LIKE :{$param})")
   277	                    ->setParameter($param, '%'.addcslashes($term, '%_\\').'%');
   278	            }
   279	        }
   280	
   281	        if (!empty($searchData['category_id'])) {
   282	            $categoryIds = array_map(static fn ($Category) => $Category->getId(), $searchData['category_id']->getSelfAndDescendants());
   283	            $qb->andWhere('EXISTS (SELECT 1 FROM dtb_product_category pcf WHERE pcf.product_id = oi.product_id AND pcf.category_id IN (:categoryIds))')
   284	                ->setParameter('categoryIds', $categoryIds, ArrayParameterType::INTEGER);
   285	        }
   286	
   287	        if (!empty($searchData['card_condition'])) {
   288	            $cardConditionIds = array_values(array_map('intval', (array) $searchData['card_condition']));
   289	            $qb->andWhere('EXISTS (SELECT 1 FROM dtb_product_class pcc WHERE pcc.id = oi.product_class_id AND pcc.card_condition_id IN (:cardConditionIds))')
   290	                ->setParameter('cardConditionIds', $cardConditionIds, ArrayParameterType::INTEGER);
   291	        }
   292	
   293	        if (!empty($searchData['tag_sales_analysis']) && count($searchData['tag_sales_analysis']) > 0) {
   294	            $tagIds = array_map(static fn ($Tag) => $Tag->getId(), $searchData['tag_sales_analysis']->toArray());
   295	            $qb->andWhere('EXISTS (SELECT 1 FROM dtb_order_item_tag_sales_analysis oita WHERE oita.order_item_id = oi.id AND oita.tag_sales_analysis_id IN (:tagIds))')
   296	                ->setParameter('tagIds', $tagIds, ArrayParameterType::INTEGER);
   297	        }
   298	
   299	        if (!empty($searchData['cardset']) && count($searchData['cardset']) > 0) {
   300	            $cardsetIds = array_map(static fn ($Cardset) => $Cardset->getId(), $searchData['cardset']->toArray());
   301	            $qb->andWhere('EXISTS (SELECT 1 FROM mtb_card_detail cdf WHERE cdf.id = p.card_detail_id AND cdf.cardset_id IN (:cardsetIds))')
   302	                ->setParameter('cardsetIds', $cardsetIds, ArrayParameterType::INTEGER);
