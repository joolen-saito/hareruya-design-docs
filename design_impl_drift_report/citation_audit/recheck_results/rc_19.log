    /**
     * 商品規格IDごとの期間別販売数を取得する.
     *
     * @param array<int> $productClassIds
     * @param bool $isMainBase true の場合は通販+TC東京（base_info_id = TC_TOKYO_ID）、false の場合は支店（dtb_base_info.is_main_shop = false）を集計する
     *
     * @return array<int, array{orderQuantity01:int,orderQuantity02:int,orderQuantity03:int,orderQuantity04:int,orderQuantity05:int,orderQuantity06:int}>
     */
    private function getSalesQuantitiesByProductClassIds(array $productClassIds, bool $isMainBase): array
    {
        if ($productClassIds === []) {
            return [];
        }

        $params = ['ids' => $productClassIds];
        $types = ['ids' => \Doctrine\DBAL\ArrayParameterType::INTEGER];

        if ($isMainBase) {
            $baseInfoCondition = 'bi.id = :mallBaseInfoId';
            $params['mallBaseInfoId'] = BaseInfo::TC_TOKYO_ID;
            $types['mallBaseInfoId'] = \PDO::PARAM_INT;
        } else {
            $baseInfoCondition = 'bi.is_main_shop = false';
        }

        $rows = $this->getEntityManager()->getConnection()->fetchAllAssociative(
            'SELECT
                sq.product_class_id,
                COALESCE(SUM(sq.sales_quantity_01), 0) AS order_quantity_01,
                COALESCE(SUM(sq.sales_quantity_02), 0) AS order_quantity_02,
                COALESCE(SUM(sq.sales_quantity_03), 0) AS order_quantity_03,
                COALESCE(SUM(sq.sales_quantity_04), 0) AS order_quantity_04,
                COALESCE(SUM(sq.sales_quantity_05), 0) AS order_quantity_05,
                COALESCE(SUM(sq.sales_quantity_06), 0) AS order_quantity_06
            FROM dtb_sales_quantity sq
            JOIN dtb_base_info bi ON sq.base_info_id = bi.id
            WHERE sq.product_class_id IN (:ids)
              AND '.$baseInfoCondition.'
            GROUP BY sq.product_class_id',
            $params,
            $types
        );

        $result = [];
        foreach ($rows as $row) {
            $id = (int) $row['product_class_id'];
            $result[$id] = [
                'orderQuantity01' => (int) ($row['order_quantity_01'] ?? 0),
                'orderQuantity02' => (int) ($row['order_quantity_02'] ?? 0),
                'orderQuantity03' => (int) ($row['order_quantity_03'] ?? 0),
                'orderQuantity04' => (int) ($row['order_quantity_04'] ?? 0),
                'orderQuantity05' => (int) ($row['order_quantity_05'] ?? 0),
                'orderQuantity06' => (int) ($row['order_quantity_06'] ?? 0),
            ];
        }

        return $result;
    }

    /**
     * 本店（通販+TC東京, base_info_id = TC_TOKYO_ID）のEC（sales_location = ECCUBE）販売数を商品規格IDごとに取得する.
     * 本店（通販+TC東京, base_info_id = TC_TOKYO_ID）のEC（sales_location = ECCUBE）販売数を商品規格IDごとに取得する.
     *
     * 集計バッチが更新する dtb_sales_quantity を正本とし、旧 dtb_product_class.order_quantity 参照を置き換える用途.
     *
     * @param array<int> $productClassIds
     *
     * @return array<int, array{orderQuantity01:int,orderQuantity02:int,orderQuantity03:int,orderQuantity04:int,orderQuantity05:int,orderQuantity06:int,orderQuantity07:int,orderQuantity08:int}>
     */
    public function getMainEcSalesQuantitiesByProductClassIds(array $productClassIds): array
    {
        if ($productClassIds === []) {
            return [];
        }

        $rows = $this->getEntityManager()->getConnection()->fetchAllAssociative(
            'SELECT
                sq.product_class_id,
                COALESCE(SUM(sq.sales_quantity_01), 0) AS order_quantity_01,
                COALESCE(SUM(sq.sales_quantity_02), 0) AS order_quantity_02,
                COALESCE(SUM(sq.sales_quantity_03), 0) AS order_quantity_03,
                COALESCE(SUM(sq.sales_quantity_04), 0) AS order_quantity_04,
                COALESCE(SUM(sq.sales_quantity_05), 0) AS order_quantity_05,
                COALESCE(SUM(sq.sales_quantity_06), 0) AS order_quantity_06,
                COALESCE(SUM(sq.sales_quantity_07), 0) AS order_quantity_07,
                COALESCE(SUM(sq.sales_quantity_08), 0) AS order_quantity_08
            FROM dtb_sales_quantity sq
            WHERE sq.product_class_id IN (:ids)
              AND sq.base_info_id = :mainBaseInfoId
              AND sq.sales_location = :ecLocation
            GROUP BY sq.product_class_id',
            [
                'ids' => $productClassIds,
                'mainBaseInfoId' => BaseInfo::TC_TOKYO_ID,
                'ecLocation' => DtbSalesQuantity::SALES_LOCATION_ECCUBE,
            ],
            [
                'ids' => \Doctrine\DBAL\ArrayParameterType::INTEGER,
                'mainBaseInfoId' => \PDO::PARAM_INT,
                'ecLocation' => \PDO::PARAM_INT,
            ]
        );

        $result = [];
        foreach ($rows as $row) {
            $id = (int) $row['product_class_id'];
            $result[$id] = [
                'orderQuantity01' => (int) ($row['order_quantity_01'] ?? 0),
                'orderQuantity02' => (int) ($row['order_quantity_02'] ?? 0),
                'orderQuantity03' => (int) ($row['order_quantity_03'] ?? 0),
                'orderQuantity04' => (int) ($row['order_quantity_04'] ?? 0),
                'orderQuantity05' => (int) ($row['order_quantity_05'] ?? 0),
