    /**
     * @return array<string, array{label: string, labelEn: string, column: string, exclude_from_default?: bool}>
     */
    public static function getAvailableColumns(): array
    {
        return self::AVAILABLE_COLUMNS;
    }

    /**
     * `key:label` 形式の指定から列キーを取り出し、日本語ヘッダ名を返す。
     */
    public static function getLabelNameJp(string $column): string
    {
        $key = explode(':', $column, 2)[0];
        $def = self::getAvailableColumns()[$key] ?? null;

        return $def === null ? '' : $def['label'];
    }

    /**
     * リクエストクエリからCSV出力条件を読み取り、内部状態を初期化する。
     *
     * @param array<string, mixed> $query Request
     */
    public function initByQuery(array $query): self
    {
        $this->initColumnsByQuery($query);
        $this->initHeaderLanguageByQuery($query);
        $this->initTargetByQuery($query);
        $this->initConditionByQuery($query);
        $this->initProductIdRangeByQuery($query);
        $this->initOffsetByQuery($query);
        $this->initLimitByQuery($query);

        return $this;
    }

    /**
     * 商品一覧の検索条件（SearchProductType の正規化済み配列）を付与する。
     *
     * @param array<string, mixed>|null $searchData
     */
    public function setAdminSearchData(?array $searchData): self
    {
        $this->adminSearchData = $searchData;
     * クエリ文字列の columns 指定を解析し、有効な列だけを選択状態にする。
     *
     * @param array<string, mixed> $query
     */
    private function initColumnsByQuery(array $query): void
    {
        $rawColumns = explode(',', (string) ($query['columns'] ?? ''), 100);
        $columns = [];
        foreach ($rawColumns as $rawColumn) {
            $parts = explode(':', $rawColumn, 2);
            $column = ['key' => $parts[0]];
            if (count($parts) > 1) {
                $column['label'] = $parts[1];
            }
            $columns[] = $column;
        }
        $validColumns = array_values(array_filter(
            $columns,
            fn ($column) => isset(self::getAvailableColumns()[$column['key']]),
        ));
        $this->columns = $validColumns === [] ? $this->getDefaultColumns() : $validColumns;
    }

    /**
     * ヘッダ言語指定（jp/en）を読み取り、内部フラグに変換する。
     *
     * @param array<string, mixed> $query
     */
    private function initHeaderLanguageByQuery(array $query): void
    {
        $headerLanguage = mb_strtolower((string) ($query['header'] ?? 'jp'));
        $isEnglish = in_array($headerLanguage, ['en', 'english'], true);
        $this->headerLanguage = $isEnglish ? self::HEADER_ENGLISH : self::HEADER_JAPANESE;
    }

    /**
     * 出力対象指定（all/card/non_card）を内部定数へ変換する。
     *
     * @param array<string, mixed> $query
     */
    private function initTargetByQuery(array $query): void
    {
        $target = (string) ($query['target'] ?? '');
        if ($target === 'card') {
            $this->target = self::TARGET_CARD;
        } elseif ($target === 'non_card') {
            $this->target = self::TARGET_NON_CARD;
        } else {
            $this->target = self::TARGET_ALL;
        }
    }

