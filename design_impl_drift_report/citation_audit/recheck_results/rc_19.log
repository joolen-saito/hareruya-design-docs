            predecessor_order_sales AS (
                SELECT
                    predecessor.next_order_id AS order_id,
                    oi.product_class_id,
                    SUM(oi.quantity::int) AS quantity
                FROM dtb_order_item oi
                JOIN dtb_order predecessor ON oi.order_id = predecessor.id
                WHERE predecessor.next_order_id IS NOT NULL
                  AND oi.order_item_type_id = :product_item_type
                  AND oi.product_class_id IS NOT NULL
                GROUP BY predecessor.next_order_id, oi.product_class_id
            ),
            -- 統合受注を複製分（ECCUBE）とついで買い分（スマレジ）に分解する。
            -- 双方とも統合受注の店舗・受注日で計上するため、合計は必ず統合受注の数量に一致する。
            -- 複製分は、引き渡し後に元注文の数量が増やされた場合に実際の引き渡し数を超えないよう
            -- 統合受注の数量で上限を切る。
            merged_split AS (
