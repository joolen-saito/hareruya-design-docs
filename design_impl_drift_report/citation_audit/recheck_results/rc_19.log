    /**
     * 選択列とヘッダ言語設定に基づいてCSVヘッダ行を生成する。
     *
     * @return list<string>
     */
    private function getCsvHeaders(): array
    {
        $labelKey = $this->headerLanguage === self::HEADER_ENGLISH ? 'labelEn' : 'label';
        $headers = [];
        foreach ($this->getSelectedColumns() as $column) {
            if (isset($column['label']) && $column['label'] !== '') {
                $headers[] = $column['label'];
            } else {
                $columnKey = $column['key'];
                $headers[] = self::getAvailableColumns()[$columnKey][$labelKey];
            }
        }

        return $headers;
    }

