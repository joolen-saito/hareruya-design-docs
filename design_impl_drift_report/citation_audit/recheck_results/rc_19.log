    /**
     * {@inheritdoc}
     *
     * @param array<string, mixed> $options
     */
    #[\Override]
    public function buildForm(FormBuilderInterface $builder, array $options): void
    {
        $builder
            // 基本情報
            ->add('name', TextType::class, [
                'constraints' => [
                    new NotBlank(),
                    new Length(['max' => $this->eccubeConfig['eccube_stext_len']]),
                ],
            ])
            ->add('name_en', TextType::class, [
                'constraints' => [
                    new Length(['max' => $this->eccubeConfig['eccube_stext_len']]),
                ],
            ])
            ->add('CardDetail', HiddenType::class, [
                'mapped' => false,
            ])
            ->add('product_image', FileType::class, [
                'multiple' => true,
                'required' => false,
                'mapped' => false,
            ])
            ->add('description_detail', TextareaType::class, [
                'purify_html' => true,
                'constraints' => [
                    new Length(['max' => $this->eccubeConfig['eccube_ltext_len']]),
                ],
            ])
            ->add('description_detail_en', TextareaType::class, [
                'purify_html' => true,
                'constraints' => [
                    new Length(['max' => $this->eccubeConfig['eccube_ltext_len']]),
                ],
            ])
            ->add('buy_description_detail', TextareaType::class, [
                'purify_html' => true,
                'constraints' => [
                    new Length(['max' => $this->eccubeConfig['eccube_ltext_len']]),
                ],
            ])
            ->add('buy_description_detail_en', TextareaType::class, [
                'purify_html' => true,
                'constraints' => [
                    new Length(['max' => $this->eccubeConfig['eccube_ltext_len']]),
                ],
            ])
            ->add('Cardset', EntityType::class, [
                'class' => MtbCardset::class,
                'label' => 'admin.product.cardset',
                'required' => false,
                'multiple' => false,
                'expanded' => false,
                'mapped' => false,
                'query_builder' => function (EntityRepository $er): QueryBuilder {
                    return $er->createQueryBuilder('cs')
                        ->orderBy('cs.release_date', 'DESC')
                        ->addOrderBy('cs.id', 'DESC');
                },
            ])
            ->add('StorageCode', EntityType::class, [
                'class' => MtbStorageCode::class,
                'label' => 'admin.product.storage_code',
                'choice_label' => 'name',
                'required' => false,
                'multiple' => false,
                'expanded' => false,
                'query_builder' => function (EntityRepository $er): QueryBuilder {
                    return $er->createQueryBuilder('sc')
                    ->orderBy('sc.id', 'ASC');
                },
            ])
            ->add('TagSalesAnalysis', EntityType::class, [
                'class' => MtbTagSalesAnalysis::class,
                'label' => 'admin.product.tag_sales_analysis',
                'required' => false,
                'choice_label' => 'name',
                'multiple' => true,
                'expanded' => false,
                'query_builder' => function (EntityRepository $er): QueryBuilder {
                    return $er->createQueryBuilder('t')
                    ->orderBy('t.id', 'ASC');
                },
            ])
            ->add('SellGroup', EntityType::class, [
                'class' => MtbSellGroup::class,
                'label' => 'admin.product.sell_group',
                'required' => false,
                'choice_label' => 'name',
                'multiple' => false,
                'expanded' => false,
                'query_builder' => function (EntityRepository $er): QueryBuilder {
                    return $er->createQueryBuilder('g')
                    ->orderBy('g.id', 'ASC');
                },
            ])
            ->add('size', IntegerType::class, [
                'label' => 'admin.product.size',
                'required' => false,
                'empty_data' => 0,
                'attr' => [
                    'min' => 0,
                    'maxlength' => $this->eccubeConfig['eccube_int_len'],
                ],
            ])
            ->add('weight', IntegerType::class, [
                'label' => 'admin.product.weight',
                'required' => false,
                'empty_data' => 0,
                'attr' => [
                    'min' => 0,
                    'maxlength' => $this->eccubeConfig['eccube_int_len'],
                ],
            ])
            ->add('Discount', EntityType::class, [
                'class' => MtbDiscount::class,
                'label' => 'admin.product.discount',
                'required' => false,
                'choice_label' => function (MtbDiscount $discount): string {
                    return $discount->getName().' '.$discount->getConditionRateLabels();
                },
                'multiple' => false,
                'expanded' => false,
                'query_builder' => function (EntityRepository $er): QueryBuilder {
                    return $er->createQueryBuilder('d')
                    ->orderBy('d.id', 'ASC');
                },
            ])
            ->add('BuyDiscount', EntityType::class, [
                'class' => MtbBuyDiscount::class,
                'label' => 'admin.product.buy_discount',
                'required' => false,
                'choice_label' => function (MtbBuyDiscount $buyDiscount) {
                    return $buyDiscount->getName().' '.$buyDiscount->getConditionRateLabels();
                },
                'multiple' => false,
                'expanded' => false,
                'query_builder' => function (EntityRepository $er): QueryBuilder {
                    return $er->createQueryBuilder('d')
                    ->orderBy('d.id', 'ASC');
                },
            ])
            ->add('RegionRestriction', EntityType::class, [
                'class' => MtbRegionRestriction::class,
                'label' => 'admin.product.region_restriction',
                'placeholder' => null,
                'required' => false,
                'choice_label' => 'name_jp',
                'multiple' => false,
                'expanded' => true,
                'query_builder' => function (EntityRepository $er) {
                    return $er->createQueryBuilder('r')
                    ->orderBy('r.id', 'ASC');
                },
            ])
            ->add('isBranchPublished', ChoiceType::class, [
                'label' => 'admin.product.is_branch_published',
                'placeholder' => null,
                'multiple' => false,
                'expanded' => true,
                'required' => false,
                'mapped' => false,
                'choices' => [
                    'admin.product.display_status__show' => Constant::ENABLED,
                    'admin.product.display_status__hide' => Constant::DISABLED,
                ],
            ])
            ->add('Category', ChoiceType::class, [
                'choice_label' => 'Name',
                'multiple' => true,
                'mapped' => false,
                'expanded' => true,
                'choices' => $this->categoryRepository->getList(null, true),
                'choice_value' => fn (?Category $Category = null) => $Category ? $Category->getId() : null,
            ])

            // 詳細な説明
            ->add('Tag', EntityType::class, [
                'class' => Tag::class,
                'query_builder' => fn ($er) => $er->createQueryBuilder('t')
                ->orderBy('t.sort_no', 'DESC'),
                'required' => false,
                'multiple' => true,
                'expanded' => true,
                'mapped' => false,
            ])
            ->add('search_word', TextareaType::class, [
                'required' => false,
                'constraints' => [
                    new Length(['max' => $this->eccubeConfig['eccube_ltext_len']]),
                ],
            ])
            // サブ情報
            ->add('free_area', TextareaType::class, [
                'purify_html' => true,
                'required' => false,
                'constraints' => [
                    new TwigLint(),
                    new Length(['max' => $this->eccubeConfig['eccube_lltext_len']]),
                ],
            ])

            // 右ブロック
            ->add('Status', ProductStatusType::class, [
                'constraints' => [
                    new NotBlank(),
                ],
            ])
            ->add('note', TextareaType::class, [
                'required' => false,
                'constraints' => [
                    new Length(['max' => $this->eccubeConfig['eccube_ltext_len']]),
                ],
            ])

            // タグ
            ->add('tags', CollectionType::class, [
                'entry_type' => HiddenType::class,
                'prototype' => true,
                'mapped' => false,
                'allow_add' => true,
                'allow_delete' => true,
            ])
            // 画像
            ->add('images', CollectionType::class, [
                'entry_type' => HiddenType::class,
                'prototype' => true,
                'mapped' => false,
                'allow_add' => true,
                'allow_delete' => true,
            ])
            ->add('add_images', CollectionType::class, [
                'entry_type' => HiddenType::class,
                'prototype' => true,
                'mapped' => false,
                'allow_add' => true,
                'allow_delete' => true,
            ])
            ->add('delete_images', CollectionType::class, [
                'entry_type' => HiddenType::class,
                'prototype' => true,
                'mapped' => false,
                'allow_add' => true,
                'allow_delete' => true,
            ])
            ->add('copy_images', CollectionType::class, [
                'entry_type' => HiddenType::class,
                'prototype' => true,
                'mapped' => false,
                'allow_add' => true,
                'allow_delete' => true,
            ])
            ->add('return_link', HiddenType::class, [
                'mapped' => false,
            ])
        ;

        $builder->addEventListener(FormEvents::POST_SUBMIT, function (FormEvent $event): void {
            /** @var FormInterface $form */
            $form = $event->getForm();
    private function validateFilePath(FormInterface $form): void
    {
        foreach ($form->getData() as $fileName) {
            // 既にデータベースに登録されている画像の場合、ファイルが存在するか確認
            /* @var ProductImage $Image */
            $Image = $this->productImageRepository->findOneBy(['objectKey' => $fileName]);
            if (
                (
                    $Image !== null
                    && $this->fileAdapter->exists($Image->getFileKey(), $Image->getAdapterInformation()) === false
                )
                || $this->fileAdapter->exists($this->eccubeConfig->get('preferred_temp_product_image_path').$fileName, []) === false
            ) {
                $form->getRoot()['product_image']->addError(new FormError(trans('admin.product.image__invalid_path')));
            }
        }
    }

    /**
     * {@inheritdoc}
     */
    #[\Override]
    public function configureOptions(OptionsResolver $resolver): void
    {
    }

    /**
     * {@inheritdoc}
     */
    #[\Override]
    public function getBlockPrefix(): string
    {
        return 'admin_product';
    }
}
