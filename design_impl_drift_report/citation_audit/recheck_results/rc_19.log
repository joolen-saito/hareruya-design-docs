    /**
     * 画像をS3にアップロード
     *
     * @param Application $app
     * @param $form
     *
     * @return array
     */
    private function uploadProductImageToS3(Application $app, $form)
    {
        $addImages = $form['product']['add_images']->getData();
        $s3 = new S3AccessService($app);
        $s3->setS3Directory(self::S3_DIRCTORY);
        $uploadDir = $app['config']['image_temp_realdir'];

        $fileNameMap = [];
        foreach ($addImages as $addImage) {
            // S3へ移動
            $uploadPath = $uploadDir . '/' . $addImage;
            $file = new File($uploadPath);
            $s3FilePath = $s3->putFile([
                'extension' => $file->guessExtension(),
                'file' => $uploadPath
            ]);

            $fileNameMap[$addImage] = $s3FilePath;
        }

        return $fileNameMap;
    }

    /**
     * 画像のコピー(card/ → product/)
     *
     * @param Application $app
     * @param $form
     * @param $fileNameMap
     * @param $product
     *
     * @return array
     */
    private function copyProductImage(Application $app, $form, $fileNameMap, $product)
    {
        $copyImages = $form['product']['copy_images']->getData();
        $s3 = new S3AccessService($app);
        $s3->setS3Directory(self::S3_DIRCTORY);

        foreach ($copyImages as $copyImage) {
            // S3へ移動
            $s3FilePath = $s3->copyFile([
                'extension' => pathinfo($copyImage)['extension'],
                'file' => $copyImage
            ]);

            $fileNameMap[$copyImage] = $s3FilePath;

            // 画像を登録
            $productImage = new \Eccube\Entity\ProductImage();
            $productImage
                ->setFileName($s3FilePath)
                ->setProduct($product)
                ->setRank(1);
            $product->addProductImage($productImage);
            $app['orm.em']->persist($productImage);
        }

        return $fileNameMap;
    }

    /**
     * 画像の登録
     *
     * @param Application $app
     * @param $form
     * @param $fileNameMap
     * @param $product
     */
    private function registerProductImage(Application $app, $form, $fileNameMap, $product)
    {
        $addImages = $form['product']['add_images']->getData();
        $s3 = new S3AccessService($app);
        $s3->setS3Directory(self::S3_DIRCTORY);
        $uploadDir = $app['config']['image_temp_realdir'];

        foreach ($addImages as $addImage) {
            if (!isset($fileNameMap[$addImage])) {
                continue;
            }
            $fileName = $fileNameMap[$addImage];

            $productImage = new \Eccube\Entity\ProductImage();
            $productImage
                ->setFileName($fileName)
                ->setProduct($product)
                ->setRank(1);
            $product->addProductImage($productImage);
            $app['orm.em']->persist($productImage);
        }
    }

    /**
     * 画像の削除
     *
     * @param Application $app
     * @param $form
     * @param $product
     */
    private function deleteProductImage(Application $app, $form, $product)
    {
        $deleteImages = $form['product']['delete_images']->getData();
        foreach ($deleteImages as $deleteImage) {
            $productImage = $app['eccube.repository.product_image']
                ->findOneBy(['file_name' => $deleteImage]);

            if (!$productImage instanceof \Eccube\Entity\ProductImage) {
                // 追加してすぐに削除した画像は、Entityに追加されない
                continue;
            }

            $product->removeProductImage($productImage);
            $app['orm.em']->remove($productImage);

            $productSubClassImages = $app['hareruya_ec.repository.product_sub_class_image']
                ->findBy(['productImageId' => $productImage->getId()]);
            foreach ($productSubClassImages as $productSubClassImage) {
                $app['orm.em']->remove($productSubClassImage);
            }
        }
    }

    /**
     * 画像順序の登録
     *
     * @param Application $app
     * @param $request
     * @param $fileNameMap
     * @param $product
     */
    private function registerProductImageRank(Application $app, $request, $fileNameMap, $product)
    {
        if (!$ranks = $request->get('rank_images')) {
            return;
        }

        foreach ($ranks as $rank) {
            list($fileName, $rankVal) = explode('//', $rank);
            $fileName = htmlspecialchars_decode($fileName, ENT_QUOTES);
            if (isset($fileNameMap[$fileName])) {
                $fileName = $fileNameMap[$fileName];
            }

            $productImage = $app['eccube.repository.product_image']
                ->findOneBy([
                    'file_name' => $fileName,
                    'Product' => $product,
                ]);
            $productImage->setRank($rankVal);
        }
    }

