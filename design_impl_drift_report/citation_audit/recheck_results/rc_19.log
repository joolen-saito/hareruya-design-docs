                    merged_sales.quantity - COALESCE(predecessor.quantity, 0) AS smaregi_quantity
                FROM merged_order_sales merged_sales
                LEFT JOIN predecessor_order_sales predecessor
                    ON predecessor.order_id = merged_sales.order_id
