    /**
     * 商品規格IDごとに、本店（base_info_id = TC_TOKYO_ID）在庫と支店（dtb_base_info.is_main_shop = false）合計在庫を取得する。
     *
     * @param array<int> $productClassIds
     *
     * @return array<int, array{mainStoreStock:int,branchTotalStock:int}>
     */
    public function getStockSummaryByProductClassIds(array $productClassIds): array
    {
        if ($productClassIds === []) {
            return [];
        }

        $rows = $this->getEntityManager()->getConnection()->fetchAllAssociative(
            'SELECT
                ps.product_class_id,
                COALESCE(SUM(CASE WHEN ps.base_info_id = :mallBaseInfoId THEN ps.stock ELSE 0 END), 0) AS main_store_stock,
                COALESCE(SUM(CASE WHEN bi.is_main_shop = false THEN ps.stock ELSE 0 END), 0) AS branch_total_stock
            FROM dtb_product_stock ps
            JOIN dtb_base_info bi ON ps.base_info_id = bi.id
            WHERE ps.product_class_id IN (:ids)
            GROUP BY ps.product_class_id',
            [
                'ids' => $productClassIds,
                'mallBaseInfoId' => BaseInfo::TC_TOKYO_ID,
            ],
            [
                'ids' => \Doctrine\DBAL\ArrayParameterType::INTEGER,
                'mallBaseInfoId' => \PDO::PARAM_INT,
            ]
        );

        $result = [];
        foreach ($rows as $row) {
            $id = (int) $row['product_class_id'];
            $result[$id] = [
                'mainStoreStock' => (int) $row['main_store_stock'],
                'branchTotalStock' => (int) $row['branch_total_stock'],
            ];
        }

        return $result;
    }

    /**
     * ProductStock ID で更新ロックをかける。
     *
     * @return array<string, int|string>|null ロックが成功したら在庫情報、失敗したら null
     */
    public function tryLockAndGetById(int $productStockId): ?array
    {
        $em = $this->getEntityManager();

        $sql = <<<EOT
SELECT
    ps.id,
    ps.product_class_id,
    ps.stock,
    ps.total_cost
FROM
    dtb_product_stock ps
WHERE
    ps.id = ?
FOR UPDATE
EOT;

        try {
            $result = $em->getConnection()->fetchAssociative(
                $sql,
                [$productStockId]
            );
        } catch (\Exception $e) {
            if (SqlUtil::isTimeoutException($e)) {
                // ロック失敗
                return null;
            }

            // ロック失敗以外の予期しないエラー
            throw $e;
        }

        if ($result === false) {
            return null;
        }

        // ロック成功
        return [
            'id' => (int) $result['id'],
            'productClassId' => (int) $result['product_class_id'],
            'stock' => $result['stock'],
            'totalCost' => (string) $result['total_cost'],
        ];
    }

