                WHERE smaregi_quantity > 0
            )
            SELECT
                product_class_id,
                base_info_id,
                sales_location,
                SUM(CASE WHEN order_date::date = (:order_date_ts::timestamptz)::date - 1 THEN quantity ELSE 0 END) AS sales_yesterday,
                SUM(CASE WHEN order_date >= :order_date_ts::timestamptz - INTERVAL '3 days' THEN quantity ELSE 0 END) AS sales_3day,
                SUM(CASE WHEN order_date >= :order_date_ts::timestamptz - INTERVAL '7 days' THEN quantity ELSE 0 END) AS sales_weekly,
                SUM(CASE WHEN order_date >= :order_date_ts::timestamptz - INTERVAL '28 days' THEN quantity ELSE 0 END) AS sales_month,
                SUM(CASE WHEN order_date >= :order_date_ts::timestamptz - INTERVAL '90 days' THEN quantity ELSE 0 END) AS sales_90day,
                SUM(CASE WHEN order_date >= :order_date_ts::timestamptz - INTERVAL '180 days' THEN quantity ELSE 0 END) AS sales_180day,
                SUM(CASE WHEN order_date >= :order_date_ts::timestamptz - INTERVAL '365 days' THEN quantity ELSE 0 END) AS sales_365day
            FROM sales
            GROUP BY product_class_id, base_info_id, sales_location
            SQL;
    }

