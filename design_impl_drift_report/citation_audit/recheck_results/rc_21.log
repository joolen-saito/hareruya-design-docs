   651	    private function persistProductClass(ReadCsvRowEvent $event, int $productId): void
   652	    {
   653	        $row = $event->getRow();
   654	
   655	        $languageId = $this->languageIdColumn->getValue($row);
   656	        $baseSellPrice = (int) bcfloor((string) $this->sellPriceColumn->getValue($row));
   657	        $baseBuyPrice = (int) bcfloor((string) $this->buyPriceColumn->getValue($row));
   658	        $standardPrice = (int) bcfloor((string) $this->standardPriceColumn->getValue($row));
   659	        $saleLimit = $this->saleLimitColumn->getValue($row);
   660	        $memberId = $event->getUpdateUser()->getId();
   661	
   662	        $productCardConditions = $this->findProductCardConditionsWithProductClass($productId, $languageId);
   663	
   664	        /** @var ProductClassRepository $productClassRepository */
   665	        $productClassRepository = $this->productClassRepository;
   666	
   667	        $statusId = $this->statusIdColumn->getValue($row);
   668	
   669	        foreach ($productCardConditions as $productCardCondition) {
   670	            $sellPrice = PriceUtil::discount($baseSellPrice, $productCardCondition['discountRate']);
   671	            $productClassId = $productCardCondition['productClassId'] ?? null;
   672	            $cardConditionId = $productCardCondition['cardConditionId'];
   673	
   674	            $buyPrice = $this->productClassRepository->getBuyPriceByConditions($baseBuyPrice, $cardConditionId, $productCardCondition['specialFlg'], $productCardCondition['buyDiscountRate'] ?? null);
   675	            $discountId = isset($productCardCondition['discountId']) ? (int) $productCardCondition['discountId'] : null;
   676	            $newStandardPrice = $this->standardPriceCalculator->calculate(
   677	                $discountId,
   678	                $cardConditionId,
   679	                $standardPrice,
   680	            );
   681	
   682	            $smaregiAlignmentFlg = $this->determineSmaregiAlignmentFlg($sellPrice, $cardConditionId, $statusId);
   683	            $sectionId = $this->determineSectionId($smaregiAlignmentFlg, $cardConditionId);
   684	            $smaregiProductCode = $this->determineSmaregiProductCode($smaregiAlignmentFlg, $productCardCondition['smaregiProductCode'] ?? null);
   685	
   686	            if ($productClassId !== null) {
   687	                // 商品規格が登録済み。 update する
   688	
   689	                $currentSaleFlg = (bool) ($productCardCondition['saleFlg'] ?? false);
   690	                // セールフラグが無効な場合は販売価格を基準価格で上書き
   691	                if (!$currentSaleFlg) {
   692	                    $sellPrice = $newStandardPrice;
   693	                } else {
   694	                    // セールフラグが有効な場合、販売価格(price02)は既存値を維持する
   695	                    // （CSVの基準価格は standard_price のみ反映）
   696	                    $sellPrice = (int) ($productCardCondition['price02'] ?? $sellPrice);
   697	                }
   698	
   699	                try {
   700	                    $productClassRepository->updateProductClass([
   701	                        'id' => $productClassId,
   702	                        'saleLimit' => $saleLimit,
   703	                        'price02' => $sellPrice,
   704	                        'buyPrice' => $buyPrice,
   705	                        'standardPrice' => $newStandardPrice,
   706	                        'saleFlg' => $currentSaleFlg,
   707	                        'cardConditionId' => $cardConditionId,
   708	                        'languageId' => $languageId,
   709	                        'smaregiAlignmentFlg' => $smaregiAlignmentFlg,
   710	                        'smaregiProductCode' => $smaregiProductCode,
   711	                        'sectionId' => $sectionId,
   712	                    ]);
   713	                } catch (UniqueConstraintViolationException $e) {
   714	                    $event->getMessageStore()
   715	                        ->addNewProductSmaregiProductCodeDuplicateError(
