   724	
   725	                // update の場合、販売/買取/基準価格のいずれかが変更された場合のみ履歴を登録する
   726	                $oldSellPrice = (int) ($productCardCondition['price02'] ?? 0);
   727	                $oldBuyPrice = (int) ($productCardCondition['buyPrice'] ?? 0);
   728	                $oldStandardPrice = (int) ($productCardCondition['standardPrice'] ?? 0);
   729	                if ($sellPrice !== $oldSellPrice || $buyPrice !== $oldBuyPrice || $newStandardPrice !== $oldStandardPrice) {
   730	                    /** @var ProductClass $ProductClass */
