     7	use Firebase\JWT\SignatureInvalidException;
     8	use Symfony\Component\HttpFoundation\Response;
     9	use Symfony\Component\HttpFoundation\Request;
    10	use Symfony\Component\HttpKernel\Exception\UnauthorizedHttpException;
    11	use App\Entity\DtbMember;
    12	
    13	class BaseController extends FOSRestController
    14	{
    15	    protected $memberId;
    16	    protected $member;
    17	
    18	    /**
    19	     * Auth by JWT token
    20	     * @param Request $request
    21	     * @throws UnauthorizedHttpException
    22	     */
    23	    public function authAdminToken(Request $request) : void
    24	    {
    25	        $headers = $request->headers->all();
    26	        if (empty($headers['jwt-token'])) {
    27	            throw new UnauthorizedHttpException('');
    28	        }
    29	        $token = $headers['jwt-token'][0];
    30	        try {
    31	            $userInfo = JWT::decode($token, $this->container->getParameter('auth_magic'), ["HS256"]);
    32	        } catch (SignatureInvalidException $e) {
    33	            throw new UnauthorizedHttpException('');
    34	        }
    35	
    36	        $this->member = $this->getDoctrine()
    37	            ->getRepository(DtbMember::class)
    38	            ->findOneBy(['memberId' => $userInfo->aud]);
    39	
    40	        if (empty($this->member)) {
    41	            throw new UnauthorizedHttpException('');
    42	        }
    43	
    44	        $this->memberId = $this->member->getMemberId();
    45	    }
    46	}
