    41	    #[\Override]
    42	    public function getUserBadgeFrom(string $accessToken): UserBadge
    43	    {
    44	        try {
    45	            $memberId = $this->jwtTokenService->verifyAndGetMemberId($accessToken);
    46	        } catch (InvalidTokenException $e) {
    47	            $this->logger->warning('JWT authentication failed: {message}', [
    48	                'message' => $e->getMessage(),
    49	                'exception' => $e,
    50	            ]);
    51	            throw new BadCredentialsException('Invalid token', 0, $e);
    52	        }
    53	
    54	        return new UserBadge(
