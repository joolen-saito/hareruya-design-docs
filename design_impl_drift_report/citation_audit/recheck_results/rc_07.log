    15	     * @param array $hierarchy 階層構造定義 ['fieldName' OR 'fieldName:childKey' => childHierarchy, ...]
    16	     * @param array $data 非階層化データの配列 [['fieldName' => value, ... ], ...]
    17	     * @return array 階層化済みデータ ['fieldName' => value OR [childKey => childNode], ...]
    18	     */
    19	    public function makeHierarchy(array $hierarchy, array $data)
    20	    {
    21	        $tree = [];
    22	        foreach ($data as $record) {
    23	            [$childName, $childKey] = explode(':', key($hierarchy));
    24	            $this->recursiveLoad($tree[$childName], $childKey, reset($hierarchy), $record);
    25	        }
    26	
    27	        return $tree;
