    29	
    30	    /**
    31	     * 再帰的に階層化
    32	     *
    33	     * @param array $parent 親ノード
    34	     * @param string $keyName キー名
    35	     * @param array $hierarchy 子ノードの階層構造定義
    36	     * @param array $record 非階層化データ
    37	     */
    38	    private function recursiveLoad(&$parent, $keyName, $hierarchy, $record)
    39	    {
    40	        foreach ($hierarchy as $key => $field) {
    41	            if (gettype($field) === 'array') {
    42	                // 階層を持つ子のキーは''
    43	                [$childName, $childKey] = explode(':', $key);
    44	                $this->recursiveLoad($parent[$record[$keyName]][$childName], $childKey, $field, $record);
    45	                continue;
    46	            }
    47	            $parent[$record[$keyName]][$field] = $record[$field];
    48	        }
    49	    }
    50	
    51	    /**
    52	     * List形式を含むデータの階層化
    53	     *
    54	     * @param array $hierarchy 階層構造定義 ['fieldName' OR 'fieldName:' => childHierarchy, ...]
