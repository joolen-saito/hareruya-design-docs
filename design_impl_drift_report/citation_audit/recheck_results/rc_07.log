+<?php
+
+declare(strict_types=1);
+
+use Symfony\Bundle\FrameworkBundle\Test\WebTestCase;
+
+final class Rc07AuthProbeTest extends WebTestCase
+{
+    public function testMissingAndInvalidTokenBodies(): void
+    {
+        $client = static::createClient();
+
+        $client->request('GET', '/api/v1/admin/buyOrders.json');
+        fwrite(STDERR, 'missing_status='.$client->getResponse()->getStatusCode()."\n");
+        fwrite(STDERR, 'missing_body='.json_encode($client->getResponse()->getContent(), JSON_UNESCAPED_UNICODE)."\n");
+
+        $client->request('GET', '/api/v1/admin/buyOrders.json', [], [], ['HTTP_JWT_TOKEN' => 'invalid-token']);
+        fwrite(STDERR, 'invalid_status='.$client->getResponse()->getStatusCode()."\n");
+        fwrite(STDERR, 'invalid_body='.json_encode($client->getResponse()->getContent(), JSON_UNESCAPED_UNICODE)."\n");
+
+        self::assertTrue(true);
+    }
+}

