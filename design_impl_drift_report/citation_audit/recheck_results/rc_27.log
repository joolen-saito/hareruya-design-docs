   307	        // update_notification_target_members 最終更新者
   308	        if (isset($searchData['update_notification_target_members']) && StringUtil::isNotBlank($searchData['update_notification_target_members'])) {
   309	            $qb
   310	                ->andWhere($qb->expr()->in('sh.UpdateMember', ':update_notification_target_members'))
   311	                ->setParameter('update_notification_target_members', $searchData['update_notification_target_members']);
   312	        }
   313	
   314	        // update_date_to 最終更新日
   315	        if (isset($searchData['update_date_to']) && StringUtil::isNotBlank($searchData['update_date_to'])) {
   316	            $date = $searchData['update_date_to']->format('Y-m-d 23:59:59');
   317	            $qb
   318	                ->andWhere('sh.updateDate < :update_date_to')
   319	                ->setParameter('update_date_to', $date);
   320	        }
   321	
   322	        // stock_change_reason 在庫変動理由・欠品理由
   323	        if (isset($searchData['stock_change_reason']) && StringUtil::isNotBlank($searchData['stock_change_reason'])) {
   324	            $qb
   325	                ->andWhere('sh.stockChangeReason LIKE :likeStockChangeReason')
   326	                ->setParameter('likeStockChangeReason', '%'.str_replace(['%', '_'], ['\\%', '\\_'], $searchData['stock_change_reason']).'%');
   327	        }
   328	
   329	        // Order By
   330	        $qb->addSelect('COALESCE(sh.approvalAt, sh.registeredAt, sh.createDate) AS HIDDEN sortDate');
   331	        $qb->addOrderBy('pc.code', 'DESC');
   332	        $qb->addOrderBy('ps.baseInfo', 'DESC');
   333	        $qb->addOrderBy('sortDate', 'DESC');
   334	
   335	        return $qb;
   336	    }
