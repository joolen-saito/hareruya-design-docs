    33	    /**
    34	     * コンストラクタ
    35	     */
    36	    public function __construct(Application $app)
    37	    {
    38	        $this->app = $app;
    39	    }
    40	    /**
    41	     * CSVを出力する
    42	     *
    43	     * @param QueryBuilder $qb
    44	     * @param String $type
    45	     * @return StreamedResponse
    46	     */
    47	    public function exportCsv(QueryBuilder $qb, $type)
    48	    {
    49	        $app = $this->app;
    50	        $response = new StreamedResponse();
    51	        $response->setCallback(function () use ($app, $type, $qb) {
    52	            $csvService = $app['eccube.service.csv.export'];
    53	            $csvService->fopen();
    54	            $csvService->putBOM();
    55	            $csvService->fputcsv(self::EXPORT_INFO[$type]['headers']);
    56	            $method = self::EXPORT_INFO[$type]['method'];
    57	
    58	            $i = 0;
    59	            foreach ($qb->getQuery()->iterate() as $csvRow) {
    60	                $csvService->fputcsv($this->$method($csvRow[$i]));
    61	                $i++;
    62	            }
    63	
    64	            $csvService->fclose();
    65	        });
    66	
    67	        $now = new \DateTime();
    68	        $filename = "product_{$type}_history_" . $now->format('YmdHis') . '.csv';
    69	        $response->headers->set('Content-Type', 'application/octet-stream');
    70	        $response->headers->set('Content-Disposition', 'attachment; filename=' . $filename);
    71	        $response->send();
    72	
    73	        return $response;
    74	    }
