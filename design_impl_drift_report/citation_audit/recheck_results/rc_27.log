    /**
     * CSVを出力する
     *
     * @param array<int, mixed> $stockHistoryIds
     *
     * @return StreamedResponse
     */
    public function exportCsv(array $stockHistoryIds): StreamedResponse
    {
        if (empty($stockHistoryIds) || !$StockHistories = $this->stockHistoryRepository->getStockHistories($stockHistoryIds)) {
            throw new \RuntimeException($this->translator->trans('admin.csv.error.export.not_registered_stock_history_id'));
        }

        $csvRows = $this->convertExportCsvRows($StockHistories);
        if ($csvRows === []) {
            throw new \RuntimeException($this->translator->trans('admin.csv.error.export.no_stock_history_data'));
        }
        $response = new StreamedResponse();

        $headerKeys = array_keys($this->csvHeader);
        $response->setCallback(function () use ($csvRows, $headerKeys): void {
            $this->csvExportService->fopen();
            $this->csvExportService->fputcsv($headerKeys);
            foreach ($csvRows as $row) {
                $this->csvExportService->fputcsv(array_map(fn (string $key) => $row[$key] ?? '', $headerKeys));
            }
            $this->csvExportService->fclose();
        });

        $filename = $this->createFileName('stock_history_');
        $this->setCsvResponseHeader($response, $filename);

        log_info('在庫履歴CSV出力ファイル名', [$filename]);

        return $response;
    }

    /**
     * DtbStockHistoryをCSV出力できる形にコンバート
     *
     * @param array<int, DtbStockHistory> $StockHistories StockHistoryの配列
     *
     * @return array<int, array<string, mixed>>
     */
    public function convertExportCsvRows(array $StockHistories): array
    {
        $csvRows = [];

        foreach ($StockHistories as $StockHistory) {
            $ProductStock = $this->productStockRepository->findOneBy(['id' => $StockHistory->getProductStock()]);
            $ProductClass = $this->productClassRepository->findOneBy(['id' => $ProductStock->getProductClass()]);
            $Product = $this->productRepository->findOneBy(['id' => $ProductClass->getProduct()]);

            $rowBase = [
                '商品コード' => $ProductClass->getCode(),
                '商品名' => $Product->getName(),
                '言語' => $ProductClass->getLanguageNameJp(),
                '状態' => $ProductClass->getCardCondition()->getCode(),
                'Foil' => '',   // TODO - From Foil Master Table
                '店舗' => $ProductStock->getBaseInfo(),
                '在庫場所' => $ProductStock->getLocationName(),
                '登録元' => $StockHistory->getHistorySourceType(),
                '登録元ID' => $StockHistory->getHistorySourceId(),
                '変更前在庫' => $StockHistory->getOldStock(),
                '変更後在庫' => $StockHistory->getStock(),
                '在庫増減数' => $StockHistory->getStockChangeQuantity(),
                '在庫変動理由区分' => $StockHistory->getStockChangeTypeDetail()->getStockChangeType()->getName(),
                '在庫変動理由' => $StockHistory->getStockChangeReason(),
                '変更時販売価格' => $StockHistory->getSellPrice(),
                '仕入単価' => $ProductClass->getBuyPrice(),
                '変更前原価単価' => $StockHistory->getUnitCostPriceBefore(),
                '変更後原価単価' => $StockHistory->getUnitCostPriceAfter(),
                '総原価増減数' => ($StockHistory->getTotalCostPriceAfter() - $StockHistory->getTotalCostPriceBefore()),
                '変更前総原価' => $StockHistory->getTotalCostPriceBefore(),
                '変更後総原価' => $StockHistory->getTotalCostPriceAfter(),
                '登録日' => !empty($StockHistory->getRegisteredAt()) ? $StockHistory->getRegisteredAt()->format('Y-m-d H:i') : '',
                '登録者' => $StockHistory->getRegisteredMember(),
                '承認日' => !empty($StockHistory->getApprovalAt()) ? $StockHistory->getApprovalAt()->format('Y-m-d H:i') : '',
                '承認者' => $StockHistory->getApprovalMember(),
                '最終更新日' => !empty($StockHistory->getUpdateDate()) ? $StockHistory->getUpdateDate()->format('Y-m-d H:i') : '',
                '最終更新者' => $StockHistory->getUpdateMember(),
            ];
            $csvRows[] = $rowBase;
        }

        return $csvRows;
    }
}

    /**
     * CSVを出力する
     *
     * @param array<int, mixed> $stockHistoryIds
     *
     * @return StreamedResponse
     */
    public function exportCsv(array $stockHistoryIds): StreamedResponse
    {
        if (empty($stockHistoryIds) || !$StockHistories = $this->stockHistoryRepository->getStockHistories($stockHistoryIds)) {
            throw new \RuntimeException($this->translator->trans('admin.csv.error.export.not_registered_stock_history_id'));
        }

        $csvRows = $this->convertExportCsvRows($StockHistories);
        if ($csvRows === []) {
            throw new \RuntimeException($this->translator->trans('admin.csv.error.export.no_stock_history_data'));
        }
        $response = new StreamedResponse();

        $headerKeys = array_keys($this->csvHeader);
        $response->setCallback(function () use ($csvRows, $headerKeys): void {
            $this->csvExportService->fopen();
            $this->csvExportService->fputcsv($headerKeys);
            foreach ($csvRows as $row) {
                $this->csvExportService->fputcsv(array_map(fn (string $key) => $row[$key] ?? '', $headerKeys));
            }
            $this->csvExportService->fclose();
        });

        $filename = $this->createFileName('stock_history_disposal_');
        $this->setCsvResponseHeader($response, $filename);

        log_info('欠品履歴CSV出力ファイル名', [$filename]);

        return $response;
    }

    /**
     * DtbStockHistoryをCSV出力できる形にコンバート
     *
     * @param array<int, DtbStockHistory> $StockHistories StockHistoryの配列
     *
     * @return array<int, array<string, mixed>>
     */
    public function convertExportCsvRows(array $StockHistories): array
    {
        $csvRows = [];

        foreach ($StockHistories as $StockHistory) {
            $ProductStock = $this->productStockRepository->findOneBy(['id' => $StockHistory->getProductStock()]);
            $ProductClass = $this->productClassRepository->findOneBy(['id' => $ProductStock->getProductClass()]);
            $Product = $this->productRepository->findOneBy(['id' => $ProductClass->getProduct()]);

            $rowBase = [
                '商品コード' => $ProductClass->getCode(),
                '商品名' => $Product->getName(),
                '言語' => $ProductClass->getLanguageNameJp(),
                '状態' => $ProductClass->getCardCondition()->getCode(),
                'Foil' => '',   // TODO - From Foil Master Table
                '店舗' => $ProductStock->getBaseInfo(),
                '在庫場所' => $ProductStock->getLocationName(),
                '登録元' => $StockHistory->getHistorySourceType(),
                '登録元ID' => $StockHistory->getHistorySourceId(),
                '欠品点数' => $StockHistory->getStock(),
                '欠品時販売価格' => $StockHistory->getSellPrice(),
                '欠品理由' => $StockHistory->getStockChangeReason(),
                '登録日' => !empty($StockHistory->getRegisteredAt()) ? $StockHistory->getRegisteredAt()->format('Y-m-d H:i') : '',
                '登録者' => $StockHistory->getRegisteredMember(),
                '最終更新日' => !empty($StockHistory->getUpdateDate()) ? $StockHistory->getUpdateDate()->format('Y-m-d H:i') : '',
                '最終更新者' => $StockHistory->getUpdateMember(),
            ];
            $csvRows[] = $rowBase;
        }

        return $csvRows;
    }
}
            $qb
                ->andWhere('sh.createDate >= :create_date_from')
                ->setParameter('create_date_from', $date);
        }

        // create_date_to 登録日
        if (isset($searchData['create_date_to']) && StringUtil::isNotBlank($searchData['create_date_to'])) {
            $date = $searchData['create_date_to']->format('Y-m-d 23:59:59');
            $qb
                ->andWhere('sh.createDate <= :create_date_to')
                ->setParameter('create_date_to', $date);
        }

        // 在庫変動区分（子区分）で絞り込み
        $stockChangeTypeDetailIds = [];
        if (isset($searchData['stock_change_type_detail']) && StringUtil::isNotBlank($searchData['stock_change_type_detail'])) {
            // stock_change_type_detail 在庫変動区分（子区分）で絞り込み
            foreach ((array) $searchData['stock_change_type_detail'] as $StockChangeTypeDetail) {
                $stockChangeTypeDetailIds[] = $StockChangeTypeDetail->getId();
            }
        } elseif (isset($searchData['disposal_search']) && StringUtil::isNotBlank($searchData['disposal_search'])) {
            // 欠品検索 ON: 欠品減算(受注)・欠品減算(移動) に限定
            $stockChangeTypeDetailIds = [
                MtbStockChangeTypeDetail::ORDER_STOCKOUT_DECREASE,
                MtbStockChangeTypeDetail::MOVE_SHORTAGE_SUBTRACT,
            ];
        }

        if ($stockChangeTypeDetailIds !== []) {
            $qb
                ->andWhere($qb->expr()->in('IDENTITY(sh.StockChangeTypeDetail)', ':stock_change_type_detail_ids'))
                ->setParameter('stock_change_type_detail_ids', $stockChangeTypeDetailIds);
        }

        // category_id カテゴリ
        if (isset($searchData['category_id']) && StringUtil::isNotBlank($searchData['category_id'])) {
            $qb
                ->leftJoin('p.ProductCategories', 'pca')
                ->andWhere($qb->expr()->in('pca.Category', ':category_id'))
                ->setParameter('category_id', $searchData['category_id']);
        }

        // status 公開種別
        if (isset($searchData['status']) && StringUtil::isNotBlank($searchData['status'])) {
            $qb
                ->andWhere($qb->expr()->in('p.Status', ':Status'))
        }

        // update_notification_target_members 最終更新者
        if (isset($searchData['update_notification_target_members']) && StringUtil::isNotBlank($searchData['update_notification_target_members'])) {
            $qb
                ->andWhere($qb->expr()->in('sh.UpdateMember', ':update_notification_target_members'))
                ->setParameter('update_notification_target_members', $searchData['update_notification_target_members']);
        }

        // update_date_to 最終更新日
        if (isset($searchData['update_date_to']) && StringUtil::isNotBlank($searchData['update_date_to'])) {
            $date = $searchData['update_date_to']->format('Y-m-d 23:59:59');
            $qb
                ->andWhere('sh.updateDate < :update_date_to')
                ->setParameter('update_date_to', $date);
        }

        // stock_change_reason 在庫変動理由・欠品理由
        if (isset($searchData['stock_change_reason']) && StringUtil::isNotBlank($searchData['stock_change_reason'])) {
            $qb
                ->andWhere('sh.stockChangeReason LIKE :likeStockChangeReason')
                ->setParameter('likeStockChangeReason', '%'.str_replace(['%', '_'], ['\\%', '\\_'], $searchData['stock_change_reason']).'%');
        }

        // Order By
        $qb->addSelect('COALESCE(sh.approvalAt, sh.registeredAt, sh.createDate) AS HIDDEN sortDate');
        $qb->addOrderBy('pc.code', 'DESC');
        $qb->addOrderBy('ps.baseInfo', 'DESC');
        $qb->addOrderBy('sortDate', 'DESC');

        return $qb;
    }

    /**
     * 指定した在庫の最新履歴を取得する.
     *
     * 承認日時があるものは承認日時、ないものは登録日時を基準に降順で最大 $limit 件.
     *
     * @return list<DtbStockHistory>
     */
    public function findLatestByProductStockId(int $productStockId, int $limit = 30): array
    {
        $qb = $this->createQueryBuilder('sh')
            ->addSelect('sctd', 'sct', 'hst', 'rm', 'am')
            ->innerJoin('sh.StockChangeTypeDetail', 'sctd')
            ->innerJoin('sctd.StockChangeType', 'sct')
            ->leftJoin('sh.HistorySourceType', 'hst')
            ->leftJoin('sh.RegisteredMember', 'rm')
            ->leftJoin('sh.ApprovalMember', 'am')
            ->andWhere('sh.ProductStock = :productStockId')
            ->setParameter('productStockId', $productStockId)
            ->addSelect('COALESCE(sh.approvalAt, sh.registeredAt, sh.createDate) AS HIDDEN sortDate')
            ->orderBy('sortDate', 'DESC')
            ->addOrderBy('sh.registeredAt', 'DESC')
            ->setMaxResults($limit);

        return $qb->getQuery()->getResult();
    }

