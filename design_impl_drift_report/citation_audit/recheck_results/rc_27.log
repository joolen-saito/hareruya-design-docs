for sid in ('sheet-24','sheet-25','sheet-26'):
    sec=s.find(id=sid)
    print(sid, sec.name if sec else None)
    if not sec: continue
    imgs=sec.select('img.image-layer-img')
    print('images',len(imgs),[(im.get('data-excel-ref'),len(im.get('src','')),im.get('alt')) for im in imgs])
