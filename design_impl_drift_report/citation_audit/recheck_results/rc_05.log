from pathlib import Path
import base64,re
p=Path('/home/y-saito/Developments/hareruya-design-docs/excel_to_html/output/0506_基本設計仕様書(API_店頭買取管理).html')
t=p.read_text()
out=Path('/tmp/rc05_design_images'); out.mkdir(exist_ok=True)
for n in range(4,9):
    start=t.index(f'<section class=\"sheet-panel\" id=\"sheet-{n}\">')
    end=t.index('<section class=\"sheet-panel\" id=\"sheet-', start+1) if n<8 else t.index('<section class=\"sheet-panel\" id=\"sheet-9\">', start+1)
    frag=t[start:end]
    title=re.search(r'<h2>(.*?)</h2>',frag,re.S).group(1)
    srcs=re.findall(r'<figure class=\"sheet-image\".*?<img src=\"data:image/png;base64,([A-Za-z0-9+/=]+)\"',frag,re.S)
    print(f'sheet-{n}',title,'images=',len(srcs))
    for i,src in enumerate(srcs,1):
        dest=out/f'sheet-{n}-{i}.png'
        dest.write_bytes(base64.b64decode(src))
        print(dest, dest.stat().st_size)
