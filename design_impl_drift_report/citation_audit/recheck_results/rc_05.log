    24	
    25	        $otcBuyOrder = $this->getDoctrine()
    26	            ->getRepository(DtbOtcBuyOrder::class)
    27	            ->findOneBy(['otcBuyOrderId' => $id]);
    28	
    29	        if (empty($otcBuyOrder)) {
    30	            throw new NotFoundHttpException();
    31	        }
    32	
    33	        $oldStatus = $otcBuyOrder->getOtcBuyOrderStatus();
    34	
    35	        $putStatus = $this->getDoctrine()
    36	              ->getRepository(MtbOtcBuyOrderStatus::class)
    37	              ->findOneBy(['id' => $request->get('status')]);
    38	
    39	        if (empty($putStatus)) {
    40	            $view = View::create([
    41	                'code' => Response::HTTP_BAD_REQUEST,
    42	                'errors' => ['正しい店頭買取ステータスIDを入力してください'],
    43	            ], Response::HTTP_BAD_REQUEST);
    44	
    45	            return $this->get('fos_rest.view_handler')->handle($view);
    46	        }
    47	
    48	        // 査定終了後のステータスは変更不可。
    49	        if (in_array($oldStatus->getId(), MtbOtcBuyOrderStatus::ASSESSMENT_COMPLETED_STATUS, true)) {
    50	            $message = in_array($putStatus->getId(), MtbOtcBuyOrderStatus::ASSESSMENT_ACTIVE_STATUS, true)
    51	                ? 'この査定はすでに終了しているため開くことができません。'
    52	                : 'この査定はすでに終了しているためステータスの更新に失敗しました。';
    53	            $view = View::create([
    54	                'code' => Response::HTTP_BAD_REQUEST,
    55	                'errors' => [$message],
    56	            ], Response::HTTP_BAD_REQUEST);
    57	
    58	            return $this->get('fos_rest.view_handler')->handle($view);
    59	        }
    60	
    61	        // 査定者本人を除き、査定中または査定再開のものは査定開始できない。
    62	        if (in_array($oldStatus->getId(), MtbOtcBuyOrderStatus::ASSESSMENT_ACTIVE_STATUS, true)
    63	            && in_array($putStatus->getId(), MtbOtcBuyOrderStatus::ASSESSMENT_ACTIVE_STATUS, true)
    64	            && (!is_null($otcBuyOrder->getMember()) && $otcBuyOrder->getMember()->getMemberId() !== $this->member->getMemberId()))
    65	        {
    66	            $view = View::create([
    67	                'code' => Response::HTTP_BAD_REQUEST,
    68	                'errors' => ["この受注は「{$otcBuyOrder->getMember()->getName()}」が査定中です。"],
    69	            ], Response::HTTP_BAD_REQUEST);
    70	
    71	            return $this->get('fos_rest.view_handler')->handle($view);
    72	        }
    73	
    74	        if ($oldStatus !== $putStatus) {
    75	            $em = $this->getDoctrine()->getManager();
    76	            $otcBuyOrder
    77	                ->setOtcBuyOrderStatus($putStatus)
    78	                ->setMember($this->member)
    79	                ->setUpdateDate(new \DateTime());
    80	            $em->persist($otcBuyOrder);
    81	
    82	            $otcBuyOrderStatusHistory = new DtbOtcBuyOrderStatusHistory();
    83	            $otcBuyOrderStatusHistory
    84	                ->setOtcBuyOrderId($id)
    85	                ->setOtcBuyOrderStatusId($putStatus->getId())
    86	                ->setMemberId($this->memberId)
    87	                ->setCreateDate(new \DateTime());
    88	            $em->persist($otcBuyOrderStatusHistory);
    89	            $em->flush();
    90	        }
    91	
    92	        $view = View::create([
    93	            "code" => Response::HTTP_OK,
    94	        ], Response::HTTP_OK);
    95	
    96	        return $this->get('fos_rest.view_handler')->handle($view);
    97	    }
