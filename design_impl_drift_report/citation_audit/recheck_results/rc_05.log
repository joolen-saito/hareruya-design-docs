codex
対象は同一 Excel ブックの API 5シートです。正本テキストだけでなく、各シートの埋め込みレイアウト画像（店頭買取情報取得・更新・コメント更新・ステータス更新・商品情報取得）も抽出して目視します。これは、文言やレスポンス例が画像側にだけ残っている可能性を排除するためです。
exec
/bin/bash -lc "python3 - <<'PY'
from pathlib import Path
from bs4 import BeautifulSoup
import base64
p=Path('/home/y-saito/Developments/hareruya-design-docs/excel_to_html/output/0506_基本設計仕様書(API_店頭買取管理).html')
s=BeautifulSoup(p.read_text(), 'html.parser')
out=Path('/tmp/rc05_design_images'); out.mkdir(exist_ok=True)
for sec_id in ['sheet-4','sheet-5','sheet-6','sheet-7','sheet-8']:
    sec=s.find('section', id=sec_id)
    title=sec.find('h2').get_text(strip=True)
    figs=sec.select('figure.sheet-image')
    print(sec_id, title, 'images=', len(figs))
    for i,fig in enumerate(figs,1):
        img=fig.find('img')
        src=img.get('src','')
        data=base64.b64decode(src.split(',',1)[1])
        dest=out/f'{sec_id}-{i}.png'
        dest.write_bytes(data)
        print(dest, len(data))
