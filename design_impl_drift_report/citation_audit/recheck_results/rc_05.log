  1636	                  <tr data-shape-index="1" data-shape-ref="B97" data-excel-book="0506" data-excel-sheet="店頭買取情報更新" data-excel-ref="0506:店頭買取情報更新!B97"><td class="shape-ref">B97</td><td>{<br>  "order_status": 1 ,<br>  "qualified_invoice_issuer_confirmation_flg": true,<br>  "order_details": [<br>    {<br>      "product_class_id": 565771,<br>      "name": "【EN】セラの天使",<br>      "quantity": 1,<br>      "price": 100,<br>      "sell_price": 200,<br>      "section_id": 1<br>    },<br>    {<br>      "product_class_id": null,<br>      "name": "商品名テスト",<br>      "quantity": null,<br>      "price": null,<br>      "sell_price": null,<br>      "section_id": null<br>    }<br>  ]<br>}</td></tr>
