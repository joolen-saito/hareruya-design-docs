        public function getFoilText(): ?string
        {
            $cardDetail = $this->getCardDetail();
            if (!$cardDetail) {
                return '-';
            }

            return match ($cardDetail->getFoilFlg()) {
                MtbCardDetail::NON_FOIL => '-',
                MtbCardDetail::FOIL => '通常',
                MtbCardDetail::FOIL_SPECIAL => '特殊',
                default => '-',
            };
        }

