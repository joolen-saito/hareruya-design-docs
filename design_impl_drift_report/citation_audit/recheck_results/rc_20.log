namespace Eccube\Repository;

use Doctrine\ORM\Query\Expr\Join;
use Doctrine\Persistence\ManagerRegistry;
use Eccube\Entity\DtbCsvCsvExtension;

/**
 * @extends AbstractRepository<DtbCsvCsvExtension>
 */
class DtbCsvCsvExtensionRepository extends AbstractRepository
{
    public function __construct(ManagerRegistry $registry)
    {
        parent::__construct($registry, DtbCsvCsvExtension::class);
    }

    /**
     * CSV拡張の登録済情報を削除
     */
    public function deleteByCsvExtensionId(int $csvExtensionId): void
    {
        $this->getEntityManager()
            ->getConnection()
            ->executeUpdate('DELETE FROM dtb_csv_csv_extension WHERE csv_extension_id = ?', [$csvExtensionId]);
    }

    /**
     * rankでソートしたCSV情報の取得(CSVダウンロード用)
     *
     * @param int $csvExtensionId
     *
     * @return \Eccube\Entity\Csv[]
     */
    public function findCsvOrderbyRank(int $csvExtensionId): array
    {
        $qb = $this->createQueryBuilder('cce')
            ->select('c')
            ->innerJoin('Eccube\Entity\Csv', 'c', Join::WITH, 'cce.Csv = c.id')
            ->where('cce.CsvExtension = :csvExtensionId')
            ->setParameter('csvExtensionId', $csvExtensionId)
            ->orderBy('cce.rank', 'ASC')
            ->addOrderBy('c.sort_no', 'ASC');

        return $qb->getQuery()->getResult();
    }
}
