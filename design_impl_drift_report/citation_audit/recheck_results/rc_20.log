   145	    #[Route(path: '/products/search/tag/{tagId}', name: 'product_list_tag', requirements: ['tagId' => '\d+(?:-\d+)*'], methods: ['GET'])]
   146	    #[Template(template: 'Product/list.twig')]
   147	    public function index(Request $request, PaginatorInterface $paginator, ?int $categoryId = null, ?string $tagId = null): array
   148	    {
   149	        if ($categoryId !== null) {
   150	            $request->query->set('category', (string) $categoryId);
   151	        }
   152	
   153	        if ($tagId !== null) {
   154	            // 単一ID(例: 1)/複数ID(例: 1-2-3)に関わらず、パスの {tagId} を tags[] 配列へ正規化する。
   155	            // ここで用意したタグ配列がユニサーチパラメータの fq.tag に implode されて送信される。
   156	            $request->query->set('tags', array_values(array_filter(explode('-', $tagId), static fn (string $v): bool => $v !== '')));
   157	        }
   158	
   159	        $this->frontProductSearchRequestQueryNormalizer->normalize($request);
   160	
   161	        // Doctrine SQLFilter
   162	        if ($this->BaseInfo->isOptionNostockHidden()) {
   163	            $this->entityManager->getFilters()->enable('option_nostock_hidden');
   164	        }
