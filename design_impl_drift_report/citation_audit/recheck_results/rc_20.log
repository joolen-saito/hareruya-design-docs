   360	
   361	        $seqFullName = (string) $seqFullName;
   362	        $parts = explode('.', $seqFullName, 2);
   363	        if (count($parts) === 2) {
   364	            [$schema, $sequencename] = $parts;
   365	        } else {
   366	            $schema = 'public';
