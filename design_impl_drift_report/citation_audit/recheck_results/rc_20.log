   140	     * @return array<string, mixed> product_list_page_products: 当ページの Product 配列（list.twig は pagination オブジェクトを使わない）.
   141	     */
   142	    #[Route(path: '/products/search', name: 'product_list', methods: ['GET'])]
   143	    #[Route(path: '/products/search/cate/{categoryId}/tag/{tagId}', name: 'product_list_category_tag', requirements: ['categoryId' => '\d+', 'tagId' => '\d+(?:-\d+)*'], methods: ['GET'])]
