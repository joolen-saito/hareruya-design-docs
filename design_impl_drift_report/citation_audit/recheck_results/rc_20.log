namespace Eccube\Service\EntityManager;

use Doctrine\ORM\EntityManagerInterface;
use Eccube\Entity\Csv;
use Eccube\Entity\DtbCsvCsvExtension;
use Eccube\Entity\DtbCsvExtension;

class CsvCsvExtensionEntityManager
{
    private EntityManagerInterface $entityManager;

    public function __construct(EntityManagerInterface $entityManager)
    {
        $this->entityManager = $entityManager;
    }

    /**
     * @param DtbCsvCsvExtension $CsvCsvExtension
     * @param DtbCsvExtension $CsvExtension
     * @param Csv $Csv
     * @param int $rank
     */
    public function save(DtbCsvCsvExtension $CsvCsvExtension, DtbCsvExtension $CsvExtension, Csv $Csv, int $rank): void
    {
        $CsvCsvExtension
            ->setCsvExtension($CsvExtension)
            ->setCsv($Csv)
            ->setRank($rank);
        $this->entityManager->persist($CsvCsvExtension);
    }
}

