namespace Eccube\Entity;

use Doctrine\Common\Collections\ArrayCollection;
use Doctrine\Common\Collections\Collection;
use Doctrine\DBAL\Types\Types;
use Doctrine\ORM\Mapping as ORM;
use Eccube\Entity\Master\CsvType;
use Eccube\Repository\DtbCsvExtensionRepository;

/**
 * DtbCsvExtension
 */
#[ORM\Table(name: 'dtb_csv_extension')]
#[ORM\Entity(repositoryClass: DtbCsvExtensionRepository::class)]
class DtbCsvExtension extends AbstractEntity implements \Stringable
{
    #[ORM\Column(name: 'id', type: Types::INTEGER, options: ['unsigned' => true, 'comment' => 'CSV拡張ID'])]
    #[ORM\Id]
    #[ORM\GeneratedValue(strategy: 'IDENTITY')]
    private ?int $id = null;

    public function getId(): ?int
    {
        return $this->id ?? null;
    }

    #[ORM\Column(name: 'name', type: Types::STRING, length: 255, nullable: true, options: ['comment' => '名称'])]
    private ?string $name = null;

    public function getName(): ?string
    {
        return $this->name ?? null;
    }

    public function setName(?string $name): DtbCsvExtension
    {
        $this->name = $name;

        return $this;
    }

    #[ORM\Column(name: 'create_date', type: Types::DATETIMETZ_MUTABLE, options: ['comment' => '作成日時'])]
    private \DateTime $create_date;

    public function getCreateDate(): \DateTime
    {
        return $this->create_date;
    }

    public function setCreateDate(\DateTime $create_date): DtbCsvExtension
    {
        $this->create_date = $create_date;

        return $this;
    }

    #[ORM\Column(name: 'update_date', type: Types::DATETIMETZ_MUTABLE, options: ['comment' => '更新日時'])]
    private \DateTime $update_date;

    public function getUpdateDate(): \DateTime
    {
        return $this->update_date;
    }

    public function setUpdateDate(\DateTime $update_date): DtbCsvExtension
    {
        $this->update_date = $update_date;

        return $this;
    }

    #[ORM\Column(name: 'deleted_at', type: Types::DATETIMETZ_MUTABLE, nullable: true, options: ['comment' => '削除日時'])]
    private ?\DateTime $deleted_at = null;

    public function getDeletedAt(): ?\DateTime
    {
        return $this->deleted_at;
    }

    public function setDeletedAt(?\DateTime $deleted_at): DtbCsvExtension
    {
        $this->deleted_at = $deleted_at;

        return $this;
    }

    #[ORM\JoinColumn(name: 'csv_type_id', referencedColumnName: 'id')]
    #[ORM\ManyToOne(targetEntity: CsvType::class)]
    private ?CsvType $CsvType = null;

    public function getCsvType(): ?CsvType
    {
        return $this->CsvType;
    }

    public function setCsvType(?CsvType $csvType): DtbCsvExtension
    {
        $this->CsvType = $csvType;

        return $this;
    }

    #[ORM\JoinColumn(name: 'member_id', referencedColumnName: 'id')]
    #[ORM\ManyToOne(targetEntity: Member::class)]
    private ?Member $Member = null;

    public function getMember(): ?Member
    {
        return $this->Member;
    }

    public function setMember(?Member $member): DtbCsvExtension
    {
        $this->Member = $member;

        return $this;
    }

    /**
     * @var Collection<int, DtbCsvCsvExtension>
     */
    #[ORM\OneToMany(targetEntity: DtbCsvCsvExtension::class, mappedBy: 'CsvExtension')]
    private Collection $CsvCsvExtensions;

    public function addCsvCsvExtension(DtbCsvCsvExtension $csvCsvExtension): DtbCsvExtension
    {
        $this->CsvCsvExtensions[] = $csvCsvExtension;

        return $this;
    }

    public function removeCsvCsvExtension(DtbCsvCsvExtension $csvCsvExtension): bool
    {
        return $this->CsvCsvExtensions->removeElement($csvCsvExtension);
    }

    /**
     * @return Collection<int, DtbCsvCsvExtension>
     */
    public function getCsvCsvExtensions(): Collection
    {
        return $this->CsvCsvExtensions;
    }

    /**
     * @var Csv[]
     */
    private array $csvs = [];

    /**
     * Add csvs
     *
     * @param Csv $csv
     *
     * @return DtbCsvExtension
        $CsvExtension = $CsvExtension ?? new DtbCsvExtension();
        $form = $this->formFactory
            ->createBuilder(CustomCsvType::class, null, ['csvType' => $CsvType, 'csvExtension' => $CsvExtension])
            ->getForm();

        try {
            $updateAction->handle(
                $CsvExtension,
                $CsvType,
                $request->get('admin_custom_csv'),
                $this->getMember()
            );

            $event = new EventArgs(
                [
                    'form' => $form,
                    'CsvType' => $CsvType,
                    'CsvExtension' => $CsvExtension,
                ],
                $request
            );
            $this->eventDispatcher->dispatch($event, EccubeEvents::ADMIN_SETTING_SHOP_CUSTOMER_CSV_UPDATE_COMPLETE);

            $this->addSuccess('admin.setting.shop.csv.save.complete', 'admin');
        } catch (\Exception $e) {
            $this->addError($e->getMessage(), 'admin');
        }

        return $this->redirectToRoute('admin_setting_shop_csv_custom', ['csvTypeId' => $CsvType->getId(), 'csvExtensionId' => $CsvExtension->getId()]);
    }

    /**
     * カスタムCSV出力設定削除
     */
    #[Route(path: '/%eccube_admin_route%/setting/shop/custom_csv/delete/{csvExtensionId}', name: 'admin_setting_shop_csv_custom_delete', requirements: ['csvExtensionId' => '\d+'], methods: ['DELETE'])]
    public function delete(Request $request, #[MapEntity(id: 'csvExtensionId')] DtbCsvExtension $CsvExtension): RedirectResponse
    {
        $csvTypeId = $CsvExtension->getCsvType()->getId();
        try {
            $this->csvCsvExtensionRepository->deleteByCsvExtensionId($CsvExtension->getId());
            $this->entityManager->remove($CsvExtension);
            $this->entityManager->flush();

            $event = new EventArgs(
                [
                    'CsvExtension' => $CsvExtension,
                ],
                $request
            );
            $this->eventDispatcher->dispatch($event, EccubeEvents::ADMIN_SETTING_SHOP_CUSTOMER_CSV_DELETE_COMPLETE);

            $this->addSuccess('admin.common.delete_complete', 'admin');
        } catch (ForeignKeyConstraintViolationException $e) {
            $this->addError(trans('admin.common.delete_error_foreign_key', ['%name%' => $CsvExtension->getName()]), 'admin');

            return $this->redirectToRoute('admin_setting_shop_csv_custom', ['csvTypeId' => $csvTypeId, 'csvExtensionId' => $CsvExtension->getId()]);
        }

        return $this->redirectToRoute('admin_setting_shop_csv_custom', ['csvTypeId' => $csvTypeId]);
    }
}
     */
    public function handle(
        DtbCsvExtension $CsvExtension,
        CsvType $CsvType,
        array $requestData,
        Member $member,
    ): void {
        $this->entityManager->beginTransaction();

        try {
            $this->csvExtensionEntityManager->save(
                $CsvExtension,
                $CsvType,
                $requestData['name'],
                $member
            );
            $this->entityManager->flush();

            if ($CsvExtension->getCsvCsvExtensions()->count() > 0) {
                $this->csvCsvExtensionRepository->deleteByCsvExtensionId($CsvExtension->getId());
            }

            $csvIds = isset($requestData['csv_output']) ? $requestData['csv_output'] : [];
            $Csvs = $this->csvRepository->findBy(['id' => $csvIds]);

            foreach ($Csvs as $key => $Csv) {
                $CsvCsvExtension = new DtbCsvCsvExtension();
                $this->csvCsvExtensionEntityManager->save($CsvCsvExtension, $CsvExtension, $Csv, $key);
            }
            $this->entityManager->flush();
            $this->entityManager->commit();
        } catch (\Exception $e) {
            $this->entityManager->rollback();

            throw $e;
        }
    }
}

