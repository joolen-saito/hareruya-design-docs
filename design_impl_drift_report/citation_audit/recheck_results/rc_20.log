        /**
         * 言語コードをキーとした規格(ProductClass)と裏面の配列を返す（3系の $products と同じ構造）
         * 戻り値: [ 言語コード => [ 商品規格ID => ProductClass, ..., 'back' => MtbCardDetail|null ], ... ]
         *
         * @return array<string, array<int|string, mixed>>
         */
        public function getProductsByLanguage(): array
        {
            $products = [];
            $backDetail = $this->getResolvedBackCardDetail();
            $backImageByLanguageCode = [];
            if ($backDetail !== null) {
                foreach ($backDetail->getCardImages() as $cardImage) {
                    $language = $cardImage->getLanguage();
                    if ($language === null) {
                        continue;
                    }
                    $languageCode = $language->getCode();
                    if ($languageCode === '') {
                        continue;
                    }
                    $backImageByLanguageCode[$languageCode] = $cardImage;
                }
            }

            foreach ($this->getProductClasses() as $ProductClass) {
                if (!$ProductClass->isVisible()) {
                    continue;
                }

                $lang = $ProductClass->getLanguage();
                if (!$lang) {
                    continue;
                }

                $code = $lang->getCode();
                if ($code === '') {
                    continue;
                }
                $products[$code][$ProductClass->getId()] = $ProductClass;
            ->leftJoin('p.ProductImage', 'pi')
            ->leftJoin('p.ProductTag', 'pt')
            ->leftJoin('p.CardDetail', 'cd')
            ->leftJoin('cd.Card', 'c')
            ->where('p.id = :id')
            ->andWhere('pc.visible = :visible')
            ->setParameter('id', $productId)
            ->setParameter('visible', true)
            ->orderBy('cc1.sort_no', 'DESC')
            ->addOrderBy('cc2.sort_no', 'DESC');

        return $qb
            ->getQuery()
            ->getOneOrNullResult();
    }

    /**
     * フロント商品詳細向けの商品を取得する.
     *
     * 移植元 getProductWithSubData()
     */
    public function findForFrontDetail(int $productId): ?Product
    {
        $qb = $this->createQueryBuilder('p');
        $qb->addSelect(['pc', 'lang', 'cardCondition', 'pi', 'pt', 'cd', 'c', 'ps'])
            ->innerJoin('p.ProductClasses', 'pc')
            ->innerJoin('pc.ProductStock', 'ps')
            ->leftJoin('pc.Language', 'lang')
            ->leftJoin('pc.CardCondition', 'cardCondition')
            ->leftJoin('p.ProductImage', 'pi')
            ->leftJoin('p.ProductTag', 'pt')
            ->leftJoin('p.CardDetail', 'cd')
            ->leftJoin('cd.Card', 'c')
            ->where('p.id = :id')
            ->andWhere('p.Status = :status')
            ->andWhere('pc.visible = :visible')
            ->andWhere('pc.price02 > :minPrice')
            ->setParameter('id', $productId)
            ->setParameter('status', ProductStatus::DISPLAY_SHOW)
            ->setParameter('visible', true)
            ->setParameter('minPrice', 0)
            ->orderBy('lang.id', 'ASC')
            ->addOrderBy('pc.price02', 'DESC')
            ->addOrderBy('pc.id', 'ASC');

        return $qb
            ->getQuery()
            ->getOneOrNullResult();
    }

