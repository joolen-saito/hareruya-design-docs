  1348	    protected function getPageTitle(?array $searchData): string
  1349	    {
  1350	        if (!empty($searchData['product'])) {
  1351	            return trans('front.product.search_result');
  1352	        } elseif (isset($searchData['category']) && $searchData['category']) {
  1353	            $names = array_map(
  1354	                fn ($Category) => $Category->getName(),
  1355	                $searchData['category']->getPath()
  1356	            );
  1357	            if (count($names) >= 3 && str_contains($names[2], $names[1])) {
  1358	                array_splice($names, 1, 1);
  1359	            }
  1360	
  1361	            return implode(' / ', $names);
  1362	        } else {
  1363	            return trans('front.product.all_products');
  1364	        }
  1365	    }

