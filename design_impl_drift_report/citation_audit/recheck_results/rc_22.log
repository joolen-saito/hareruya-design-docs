    20	
    21	/**
    22	 * 数値項目に対し、文字の長さを検証する ValidatorInterface 実装。
    23	 */
    24	class NumericMaxLengthValidator implements ValidatorInterface
    25	{
    26	    use ValidatorTrait;
    27	
    28	    /** @var int 最大の長さ */
    29	    private int $maxLength;
    30	
    31	    /**
    32	     * @param int $maxLength 最大の長さ
    33	     */
    34	    public function __construct(int $maxLength)
    35	    {
    36	        $this->maxLength = $maxLength;
    37	    }
    38	
    39	    /**
    40	     * @param MessageStore $errors エラーメッセージの格納先
    41	     * @param CsvValueInterface $value 検証する値
    42	     *
    43	     * @return bool $value が空ではない場合 true
    44	     */
    45	    public function validate(MessageStore $errors, CsvValueInterface $value): bool
    46	    {
    47	        if (!$value->hasValue()) {
    48	            // 未入力の場合はチェックしない
    49	            return true;
    50	        }
    51	
    52	        $validator = function ($value) {
    53	            return strlen($value) <= $this->maxLength;
    54	        };
    55	
    56	        if (!$value->validate($validator)) {
    57	            // message.yml に数値向けのメッセージしかないので、本クラスも数値専用になっている。
    58	            $errors->addNumericMaxLengthError(
    59	                $value->getRowNumber(),
    60	                $value->getLabel(),
    61	                $this->maxLength
    62	            );
    63	
    64	            return false;
    65	        }
    66	
    67	        return true;
    68	    }
    69	}

