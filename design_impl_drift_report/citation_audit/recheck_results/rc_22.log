   740	        $column = new BaseCsvColumn($name, $label);
   741	        $column->setConverter(new IntArrayConverter())
   742	            ->setMultiple(true)
   743	            ->addValidator(new NumericValidator());
   744	
   745	        if (is_int($maxLength)) {
   746	            $column->addValidator(new NumericMaxLengthValidator($maxLength));
   747	        }
   748	
   749	        return $column;
   750	    }
