from html.parser import HTMLParser
from pathlib import Path
terms=['商品公開ステータス','公開ステータス','公開状態','表示状態','product_status_id','ProductStatus','pc.visible','del_flg','csv_invalid_no_data','CSVデータが存在しません','getErrors(true)','フォーム検証エラー']
root=Path('/home/y-saito/Developments/hareruya-design-docs/excel_to_html/output')
class P(HTMLParser):
 def __init__(self):super().__init__();self.cap=None;self.depth=0;self.rows=[]
 def handle_starttag(self,t,a):
  a=dict(a)
  if t=='span' and 'src-cell' in a.get('class','').split():self.cap=[a.get('data-excel-ref'),[]];self.depth=1
  elif self.cap:self.depth+=1
 def handle_endtag(self,t):
  if self.cap:
   self.depth-=1
   if not self.depth:self.rows.append((self.cap[0],' '.join(''.join(self.cap[1]).split())));self.cap=None
 def handle_data(self,d):
  if self.cap:self.cap[1].append(d)
counts={t:[] for t in terms}
for f in root.glob('*.html'):
 p=P()
 try:p.feed(f.read_text(encoding='utf-8'))
 except Exception as e:continue
 for ref,text in p.rows:
  for t in terms:
   if t in text: counts[t].append((f.name,ref,text))
for t in terms:
 print('\\nTERM',t,'COUNT',len(counts[t]))
 for row in counts[t][:20]: print(row)
