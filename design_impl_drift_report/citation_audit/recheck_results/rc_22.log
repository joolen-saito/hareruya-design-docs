    27	final class SmaregiProductClassCsvImportUpsertCoordinator
    28	{
    29	    /** @var array<int, true> */
    30	    private array $deferredProductClassIds = [];
    31	
    32	    public function __construct(
    33	        private readonly SmaregiProductClassEventService $smaregiProductClassEventService,
    34	        private readonly ProductClassRepository $productClassRepository,
    35	        private readonly string $logContextLabel,
