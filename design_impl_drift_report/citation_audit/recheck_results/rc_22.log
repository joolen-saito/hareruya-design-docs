   113	    /**
   114	     * セール用高額商品価格変更CSV取込
   115	     */
   116	    #[Route(path: '/%eccube_admin_route%/product/sale_high_price/import', name: 'admin_product_sale_high_price_import', methods: ['POST'])]
   117	    public function import(Request $request): RedirectResponse
   118	    {
   119	        /** @var Member $Member */
   120	        $Member = $this->getUser();
   121	
   122	        $form = $this->formFactory->createBuilder(CsvImportType::class)->getForm();
   123	        $form->handleRequest($request);
   124	
   125	        if (!$form->isValid()) {
   126	            foreach ($form->getErrors() as $error) {
   127	                $this->addError($error->getMessage(), 'admin');
   128	            }
   129	
   130	            return $this->redirectToRoute('admin_product_sale_high_price_csv_upload');
   131	        }
   132	        /** @var UploadedFile|null $formFile */
   133	        $formFile = $form['import_file']->getData();
   134	
   135	        if ($formFile === null) {
   136	            $this->addError('admin.common.csv_invalid_format', 'admin');
   137	
   138	            return $this->redirectToRoute('admin_product_sale_high_price_csv_upload');
   139	        }
   140	
   141	        if ($this->countCsvRows($formFile) >= static::ADMIN_CSV_IMPORT_MAX_ROWS) {
   142	            $this->addError($this->getCsvImportMaxRowsExceededMessage(), 'admin');
   143	
   144	            return $this->redirectToRoute('admin_product_sale_high_price_csv_upload');
   145	        }
   146	
   147	        log_info('セール用高額商品価格変更CSV登録開始');
   148	
   149	        $handler = new SaleHighPriceImportHandler(
   150	            $this->entityManager,
   151	            $this->productRepository,
   152	            $this->productClassRepository,
   153	            $this->priceHistoryRepository,
   154	        );
   155	        $importer = new CsvImporter(
   156	            $this->entityManager,
   157	            $this->translator,
   158	            $this->eccubeConfig,
   159	            $handler,
   160	            $Member
   161	        );
   162	        $result = $importer->import($formFile);
   163	        if ($result->hasInfos()) {
   164	            foreach ($result->getInfos() as $info) {
   165	                $this->addWarning($info['message'], 'admin');
   166	            }
   167	        }
   168	
   169	        if ($result->hasError()) {
   170	            log_info('セール用高額商品価格変更CSV登録 異常終了');
   171	            foreach ($result->getErrors() as $error) {
   172	                $this->addError($error['message'], 'admin');
   173	            }
   174	        } else {
   175	            $this->addSuccess('admin.register.complete', 'admin');
   176	            log_info('セール用高額商品価格変更CSV登録完了', ['count' => $result->getCount()]);
   177	            $this->csvImportHistoryRepository->insertCsvImportHistory(
   178	                MtbCsvImportType::HIGH_PRICE_IMPORT_CSV_ID,
   179	                $formFile->getClientOriginalName(),
   180	                $Member->getId()
   181	            );
   182	
   183	            $event = new EventArgs(
   184	                [
   185	                    'form' => $form,
   186	                    'result' => $result,
   187	                ],
   188	                $request
   189	            );
   190	            $this->eventDispatcher->dispatch($event, EccubeEvents::ADMIN_PRODUCT_CSV_PRODUCT_SALE_HIGH_PRICE_CSV_IMPORT_COMPLETE);
   191	        }
   192	
   193	        return $this->redirectToRoute('admin_product_sale_high_price_csv_upload');
   194	    }
