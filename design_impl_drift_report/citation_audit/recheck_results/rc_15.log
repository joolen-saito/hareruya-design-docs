     */
    #[Route(path: '/products/remove_favorite/{id}/{language_code}', name: 'product_remove_favorite', requirements: ['id' => '\d+'], methods: ['DELETE'])]
    public function removeFavorite(
        Product $Product,
        #[MapEntity(mapping: ['language_code' => 'code'])] MtbLanguage $Language,
    ): JsonResponse {
        if (!$this->isTokenValid()) {
            throw new BadRequestHttpException();
        }

        if (!$this->checkVisibility($Product)) {
            throw new NotFoundHttpException();
        }

        if (!$this->getShop()->isMainShop()) {
            throw new NotFoundHttpException();
        }

        /** @var Customer $Customer */
        $Customer = $this->getUser();
        $Player = $this->dtbPlayerRepository->findOneBy(['Customer' => $Customer]);
        if (empty($Player)) {
            return $this->json(['status' => 'nologin', 'message' => trans('front.product.favorite_product.favorite_notlogin.message')]);
        }

        $RegisteredFavoriteProducts = $this->dtbFavoriteProductRepository->findBy(['Product' => $Product, 'Player' => $Player, 'Language' => $Language]);
        if (!empty($RegisteredFavoriteProducts)) {
            try {
                foreach ($RegisteredFavoriteProducts as $RegisteredFavoriteProduct) {
                    $this->entityManager->remove($RegisteredFavoriteProduct);
                }
                $this->entityManager->flush();
            } catch (\Exception $e) {
                log_error($e->getMessage());

                return $this->json(['status' => 'fail', 'message' => trans('front.product.favorite_product.remove.fail')]);
            }

