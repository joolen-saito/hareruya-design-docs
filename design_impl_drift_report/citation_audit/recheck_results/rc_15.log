    private function entryActivate(Request $request, string $secret_key): int
    {
        log_info('本会員登録開始');

        $Customer = $this->registerCustomerViewRepository->getProvisionalCustomerBySecretKey($secret_key);
        if ($Customer === null) {
            if ($this->registerCustomerViewRepository->isAlreadyActivatedBySecretKey($secret_key)) {
                throw new EntryAlreadyActivatedException();
            }

            throw new EntryInvalidSecretKeyException();
        }

        // ビューでお客様のステータスを更新する。
        $this->entityManager->getConnection()->executeQuery(
            'UPDATE registration_view SET customer_status_id = :status_id WHERE secret_key = :secret_key',
            [
                'status_id' => CustomerStatus::REGULAR,
                'secret_key' => $Customer->getSecretKey(),
            ]
        );

        log_info('本会員登録完了');

        $event = new EventArgs(
            [
                'Customer' => $Customer,
            ],
            $request
        );
        $this->eventDispatcher->dispatch($event, EccubeEvents::FRONT_ENTRY_ACTIVATE_COMPLETE);

        // スマレジ会員を作成し、採番された会員IDをdtb_playerへ保存
        $ActivatedCustomer = $this->linkSmaregiCustomer($secret_key);

        // メール送信
        $this->mailService->sendCustomerCompleteMail($Customer);

        // Assign session carts into customer carts
        $Carts = $this->cartService->getCarts();
        $qtyInCart = 0;
        foreach ($Carts as $Cart) {
            $qtyInCart += $Cart->getTotalQuantity();
        }

        if ($ActivatedCustomer instanceof Customer) {
            $this->security->login($ActivatedCustomer, 'form_login', 'customer');
    private function linkSmaregiCustomer(string $secret_key): ?Customer
    {
        /** @var Customer|null $Customer */
        $Customer = $this->customerRepository->findOneBy(['secret_key' => $secret_key]);
        if ($Customer === null) {
            return null;
        }

        $Player = $Customer->getPlayer();
        if ($Player === null) {
            return $Customer;
        }

        // 既に連携済みなら何もしない (冪等).
        $smaregiId = $Player->getSmaregiId();
        if ($smaregiId !== null && $smaregiId !== '') {
            return $Customer;
        }

        // 同一会員のアクティベートが並行しても二重登録しないよう、Player 行を悲観ロックして直列化する。
        // ロック取得後に smaregi_id を再チェックし、先行リクエストが連携済みなら何もしない。
        $this->entityManager->beginTransaction();
        try {
            $this->entityManager->lock($Player, LockMode::PESSIMISTIC_WRITE);
            $this->entityManager->refresh($Player);

            $lockedSmaregiId = $Player->getSmaregiId();
            if ($lockedSmaregiId !== null && $lockedSmaregiId !== '') {
                // 先行リクエストが連携済みのため二重作成しない。
                $this->entityManager->commit();

                return $Customer;
            }

            $result = $this->smaregiCustomerService->createCustomer($Customer);

            if ($result['ok'] && !empty($result['smaregiId'])) {
                $Player->setSmaregiId($result['smaregiId']);
                $Player->setExistsSmaregiFlg(true);
                $this->entityManager->flush();
                $this->entityManager->commit();

                return $Customer;
            }

            // スマレジ API 失敗時はフラグ OFF のまま確定し、アクティベート失敗画面で終了する
            $this->markSmaregiLinkFailed($Player, $Customer->getId(), $result['error']);
            $this->entityManager->commit();

            throw new EntryActivateFailedException('スマレジ会員連携に失敗しました');
        } catch (EntryActivateFailedException $e) {
            throw $e;
        } catch (\Throwable $e) {
            if ($this->entityManager->getConnection()->isTransactionActive()) {
                $this->entityManager->rollback();
            }

            // 予期しない例外も連携失敗として扱い、アクティベート失敗画面へ遷移させる
            log_error('スマレジ会員連携処理で例外が発生しました(本会員化は完了済み)', [
                'customerId' => $Customer->getId(),
                'error' => $e->getMessage(),
            ]);

            throw new EntryActivateFailedException('スマレジ会員連携処理で例外が発生しました', 0, $e);
        }
    }

    /**
     * スマレジ連携失敗を記録する (exists_smaregi_flg を OFF のまま確定し、ログを残す)
     */
    private function markSmaregiLinkFailed(DtbPlayer $Player, ?int $customerId, ?string $error): void
    {
        $Player->setExistsSmaregiFlg(false);
        $this->entityManager->flush();

        log_error('スマレジ会員連携に失敗しました(本会員化は完了済み)', [
            'customerId' => $customerId,
            'error' => $error,
        ]);
    }


