    /**
     * お気に入り商品の削除
     * @param Application $app
     * @param Request $request
     * @return \Symfony\Component\HttpFoundation\JsonResponse
     */
    public function removeFavorite(Application $app, Request $request)
    {
        $id = $request->get('product_id');
        $lang = $request->get('language');
        $customer = $app->user();
        $player = $app['hareruya_ec.repository.player']->findOneByCustomer($customer);

        if (empty($player)) {
            return $app->abort(400);
        }

        $language = $app['hareruya_ec.repository.language']->findOneByCode($lang);

        $registeredFavoriteProduct = $app['hareruya_ec.repository.favorite_product']->findOneBy(['productId' => $id, 'player' => $player, 'language' => $language]);

        if (!empty($registeredFavoriteProduct)) {
            $app['orm.em']->remove($registeredFavoriteProduct);
            $app['orm.em']->flush();
        }

        return $this->responseJson($app, 'front.favorite_product.cancel', 'success');

