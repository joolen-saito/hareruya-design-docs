diff --git a//tmp/extract_rc15_images.py b//tmp/extract_rc15_images.py
new file mode 100644
index 0000000000000000000000000000000000000000..1c33aabc38c392ce3df1b74d28d02ab02cf5117c
--- /dev/null
+++ b//tmp/extract_rc15_images.py
@@ -0,0 +1,44 @@
+import base64
+import html
+import pathlib
+import re
+import sys
+
+source = pathlib.Path(sys.argv[1])
+sheet_id = sys.argv[2]
+target = pathlib.Path(sys.argv[3])
+target.mkdir(parents=True, exist_ok=True)
+
+text = source.read_text(encoding="utf-8")
+start_match = re.search(
+    rf'<section class="sheet-panel(?: is-active)?" id="{re.escape(sheet_id)}">',
+    text,
+)
+if not start_match:
+    raise SystemExit(f"sheet not found: {sheet_id}")
+next_match = re.search(
+    r'<section class="sheet-panel(?: is-active)?" id="sheet-\d+">',
+    text[start_match.end():],
+)
+end = start_match.end() + next_match.start() if next_match else len(text)
+section = text[start_match.start():end]
+
+tags = re.findall(r"<img[^>]+>", section)
+index = 0
+for tag in tags:
+    source_match = re.search(
+        r'src="data:image/(?P<kind>png|jpeg);base64,(?P<data>[^"]+)"',
+        tag,
+    )
+    if not source_match:
+        continue
+    index += 1
+    attrs = tag
+    alt_match = re.search(r'alt="([^"]*)"', attrs)
+    ref_match = re.search(r'data-excel-ref="([^"]*)"', attrs)
+    alt = html.unescape(alt_match.group(1)) if alt_match else ""
+    ref = html.unescape(ref_match.group(1)) if ref_match else ""
+    suffix = "jpg" if source_match.group("kind") == "jpeg" else "png"
+    path = target / f"{source.stem}_{sheet_id}_{index:02d}.{suffix}"
+    path.write_bytes(base64.b64decode(source_match.group("data")))
+    print(f"{path}\tref={ref}\talt={alt}")
diff --git a//tmp/search_excel_regions.py b//tmp/search_excel_regions.py
new file mode 100644
index 0000000000000000000000000000000000000000..3d3e4fffd8c5193ca0f6daa8bd7e88cb39dcb354
--- /dev/null
+++ b//tmp/search_excel_regions.py
@@ -0,0 +1,28 @@
+import pathlib
+import re
+import sys
+
+root = pathlib.Path(sys.argv[1])
+terms = sys.argv[2:]
+embed = re.compile(
+    r"<!-- function-design-embed:start.*?<!-- function-design-embed:end.*?-->",
+    re.DOTALL,
+)
+
+for term in terms:
+    print(f"TERM\t{term}")
+    count = 0
+    for path in sorted(root.glob("*.html")):
+        text = path.read_text(encoding="utf-8")
+        excel = embed.sub("", text)
+        for match in re.finditer(re.escape(term), excel, re.IGNORECASE):
+            count += 1
+            line = excel.count("\n", 0, match.start()) + 1
+            start = excel.rfind("\n", 0, match.start()) + 1
+            end = excel.find("\n", match.end())
+            if end < 0:
+                end = len(excel)
+            snippet = re.sub(r"<[^>]+>", " ", excel[start:end])
+            snippet = re.sub(r"\s+", " ", snippet).strip()
+            print(f"{path.name}:{line}\t{snippet[:300]}")
+    print(f"COUNT\t{count}")
