1626-      <section class="function-design-embed" id="function-design-m04-01-m04-01_admin_stock_stock_search_list" data-source="functions/ec-cube-enterprise/m04-01_admin_stock_stock_search_list.md">
1627-        <header class="function-design-header">
1628-          <p class="function-design-source">Source:<br>functions/ec-cube-enterprise/m04-01_admin_stock_stock_search_list.md</p>
