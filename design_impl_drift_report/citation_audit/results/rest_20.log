  2341	    private function saveUserMailHistory(Email $message, ?MailTemplate $mailTemplate = null, Customer|Order|DtbBuyOrder|null $info = null, ?Member $creator = null): void
  2342	    {
  2343	        $mailHistory = new MailHistory();
  2344	        $mailHistory
  2345	            ->setMailSubject($message->getSubject())
  2346	            ->setMailBody($message->getTextBody())
  2347	            ->setSendDate(new \DateTime())
  2348	            ->setCreator($creator);
  2349	
  2350	        if (!is_null($mailTemplate)) {
  2351	            $mailHistory->setMailTemplate($mailTemplate);
  2352	            $mailHistory->setBaseInfo($mailTemplate->getBaseInfo());
  2353	        }
  2354	
  2355	        if ($info instanceof Customer) {
  2356	            $mailHistory->setCustomer($info);
  2357	        } elseif ($info instanceof Order) {
  2358	            $mailHistory
  2359	                ->setOrder($info)
  2360	                ->setCustomer($info->getCustomer());
  2361	            // ゲストIDを設定
  2362	            $guestId = $info->getGuestId();
  2363	            if ($guestId !== null && $guestId !== '') {
  2364	                $mailHistory->setGuestId($guestId);
  2365	            }
  2366	        } elseif ($info instanceof DtbBuyOrder) {
  2367	            $mailHistory
  2368	                ->setBuyOrder($info)
  2369	                ->setCustomer($info->getCustomer());
  2370	        }
  2371	
  2372	        $this->entityManager->persist($mailHistory);
  2373	        $this->entityManager->flush();
  2374	    }
