    24	/**
    25	 * 履歴スナップショットから表示用（非永続）の Order グラフを復元する.
    26	 */
    27	class OrderHistorySnapshotHydrator
    28	{
    29	    public function __construct(
    30	        private readonly EntityManagerInterface $entityManager,
    31	    ) {
    32	    }
    33	
    34	    /**
    35	     * @param array<string, mixed> $snapshot
    36	     *
    37	     * @return array{
    38	     *     Order: Order,
    39	     *     waitingNumber: int|null,
    40	     *     linkedEcOrderNumbers: list<string>
    41	     * }
    42	     */
    43	    public function hydrate(array $snapshot): array
    44	    {
    45	        /** @var array<string, mixed> $orderData */
    46	        $orderData = $snapshot['order'] ?? [];
    47	        /** @var list<array<string, mixed>> $orderItemsData */
    48	        $orderItemsData = $snapshot['order_items'] ?? [];
    49	        /** @var list<array<string, mixed>> $shippingsData */
    50	        $shippingsData = $snapshot['shippings'] ?? [];
    51	        /** @var array{waiting_number?: int|null, linked_ec_order_numbers?: list<string>} $view */
    52	        $view = $snapshot['view'] ?? [];
    53	
    54	        $Order = new Order();
    55	        $this->applyNormalizedData($Order, $orderData);
    56	
    57	        $orderItemsById = [];
    58	        foreach ($orderItemsData as $itemData) {
    59	            $OrderItem = new OrderItem();
    60	            $this->applyNormalizedData($OrderItem, $itemData);
    61	            $OrderItem->setOrder($Order);
    62	            $Order->addOrderItem($OrderItem);
    63	            if (isset($itemData['id']) && is_numeric($itemData['id'])) {
    64	                $orderItemsById[(int) $itemData['id']] = $OrderItem;
    65	            }
    66	        }
    67	
    68	        foreach ($shippingsData as $shippingData) {
    69	            $Shipping = new Shipping();
    70	            $this->applyNormalizedData($Shipping, $shippingData);
    71	            $Shipping->setOrder($Order);
    72	            $Order->addShipping($Shipping);
    73	
    74	            $itemIds = $shippingData['order_item_ids'] ?? [];
    75	            if (\is_array($itemIds)) {
    76	                foreach ($itemIds as $itemId) {
    77	                    $oid = is_numeric($itemId) ? (int) $itemId : null;
    78	                    if ($oid !== null && isset($orderItemsById[$oid])) {
    79	                        $orderItemsById[$oid]->setShipping($Shipping);
    80	                        $Shipping->addOrderItem($orderItemsById[$oid]);
    81	                    }
    82	                }
    83	            }
    84	        }
    85	
    86	        return [
    87	            'Order' => $Order,
    88	            'waitingNumber' => $view['waiting_number'] ?? null,
    89	            'linkedEcOrderNumbers' => $view['linked_ec_order_numbers'] ?? [],
    90	        ];
    91	    }
    92	
    93	    /**
    94	     * @param array<string, mixed> $data
    95	     */
    96	    private function applyNormalizedData(AbstractEntity $Entity, array $data): void
    97	    {
    98	        $scalars = [];
    99	        foreach ($data as $key => $value) {
   100	            if ($key === 'order_item_ids') {
   101	                continue;
   102	            }
   103	            if (\is_array($value) && array_key_exists('id', $value)) {
   104	                $this->setAssociationById($Entity, $key, $value['id']);
   105	                continue;
   106	            }
   107	            if (\is_array($value)) {
   108	                // Collection 由来の ID 配列は復元対象外（別途組み立て）
   109	                continue;
   110	            }
   111	            if (\is_string($value) && preg_match('/^\d{4}-\d{2}-\d{2}T/', $value) === 1) {
   112	                try {
   113	                    $scalars[$key] = new \DateTime($value);
   114	                    continue;
   115	                } catch (\Exception) {
   116	                    // 通常文字列として扱う
   117	                }
   118	            }
   119	            $scalars[$key] = $value;
   120	        }
   121	
   122	        // 表示用キー用に id も Reflection でセット（非永続エンティティ）
   123	        if (isset($data['id']) && is_numeric($data['id']) && (new \ReflectionClass($Entity))->hasProperty('id')) {
   124	            $idProperty = (new \ReflectionClass($Entity))->getProperty('id');
   125	            $idProperty->setAccessible(true);
   126	            $idProperty->setValue($Entity, (int) $data['id']);
   127	        }
   128	
   129	        $Entity->setPropertiesFromArray($scalars, ['id']);
   130	    }
   131	
   132	    private function setAssociationById(AbstractEntity $Entity, string $propertyName, mixed $id): void
   133	    {
   134	        if ($id === null || $id === '') {
   135	            return;
   136	        }
   137	
   138	        $reflect = new \ReflectionClass($Entity);
   139	        if (!$reflect->hasProperty($propertyName)) {
   140	            return;
   141	        }
   142	        $property = $reflect->getProperty($propertyName);
   143	        $type = $property->getType();
   144	        if (!$type instanceof \ReflectionNamedType || $type->isBuiltin()) {
   145	            return;
   146	        }
   147	        $className = $type->getName();
   148	        if (!is_a($className, AbstractEntity::class, true)) {
   149	            return;
   150	        }
   151	
   152	        try {
   153	            /** @var class-string<AbstractEntity> $className */
   154	            $reference = $this->entityManager->getReference($className, $id);
   155	            $property->setAccessible(true);
   156	            $property->setValue($Entity, $reference);
   157	        } catch (\Exception) {
   158	            // 参照先が無い場合はスキップ（履歴表示を優先）
   159	        }
   160	    }
   161	}
