  2515	    INNER JOIN dtb_product_class pc ON p.id = pc.product_id AND pc.visible = true
  2516	    LEFT JOIN dtb_product_stock pstock ON pstock.product_class_id = pc.id
  2517	        AND pstock.base_info_id = :stockBaseInfoId
  2518	        AND pstock.stock_location_id = :eccubeStockLocationId
  2519	    LEFT JOIN mtb_language lang ON pc.language_id = lang.id
  2520	    LEFT JOIN mtb_card_condition cc ON pc.card_condition_id = cc.id
  2521	    LEFT JOIN dtb_product_class_image pci ON pci.product_class_id = pc.id
  2522	    LEFT JOIN dtb_product_image pimg ON pci.product_image_id = pimg.id
  2523	    INNER JOIN mtb_card_detail cd ON p.card_detail_id = cd.id
  2524	    INNER JOIN mtb_card c ON cd.card_id = c.id
  2525	    LEFT JOIN mtb_cardset cs ON cd.cardset_id = cs.id
  2526	WHERE (c.old_product_id = :oldProductId OR c.old_en_product_id = :oldProductId)
  2527	  AND p.product_status_id = :statusId
  2528	ORDER BY
  2529	    CASE WHEN cs.special_flg THEN 1 ELSE 2 END ASC,
  2530	    CASE WHEN cd.promotion_flg THEN 1 ELSE 2 END ASC,
  2531	    COALESCE(cs.release_date, '1900-01-01'::timestamptz) DESC,
  2532	    cd.foil_flg ASC,
  2533	    CASE WHEN lang.code = CASE WHEN c.old_product_id = :oldProductId THEN 'JP' ELSE 'EN' END THEN 1 ELSE 2 END ASC,
  2534	    CASE WHEN pci.rank = CASE WHEN c.old_product_id = :oldProductId THEN 2 ELSE 1 END THEN 1 ELSE 2 END ASC
  2535	LIMIT 1
