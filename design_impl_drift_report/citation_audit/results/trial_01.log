    50	        }
    51	
    52	        $action = $event->getAction();
    53	        if ($action !== self::ACTION_EDITED) {
    54	            $this->logger->warning('Smaregi stock action has no handler', [
    55	                'webhookEventId' => $event->getId(),
    56	                'action' => $action,
    57	                'knownActions' => [self::ACTION_EDITED],
