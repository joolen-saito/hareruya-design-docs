    16	namespace Eccube\Service\App\Popup;
    17	
    18	class PopupResponseBuilder
    19	{
    20	    /**
    21	     * ポップアップ用情報のレスポンスを構築する
    22	     *
    23	     * @param array<string, mixed> $result
    24	     *
    25	     * @return array<string, mixed>
    26	     */
    27	    public function build(array $result, string $productUrl, bool $includeBeltUrl = false): array
    28	    {
    29	        $response = [
    30	            'productId' => $result['productId'],
    31	            'name' => $result['productName'],
    32	            'productClassId' => $result['productClassId'],
    33	            'price01' => $result['price01'],
    34	            'price02' => $result['price02'],
    35	            'stock' => (int) ($result['stock'] ?? 0),
    36	            'nameEn' => $result['nameEn'],
    37	            'subFileName' => $result['imageFileName'],
    38	            'fileName' => $result['imageFileName'],
    39	            'code' => $result['languageCode'],
    40	            'conditionCode' => $result['conditionCode'],
    41	            'weeklySold' => (int) ($result['weeklySold'] ?? 0),
    42	            'productUrl' => $productUrl,
    43	        ];
    44	
    45	        if ($includeBeltUrl) {
    46	            $response['beltUrl'] = $result['beltUrl'] ?? null;
    47	        } else {
    48	            $response['foilFlg'] = $result['foilFlg'];
    49	        }
    50	
    51	        return $response;
    52	    }
    53	}

