from html.parser import HTMLParser
from pathlib import Path
class P(HTMLParser):
 def __init__(self, wanted):
  super().__init__(); self.wanted=set(wanted); self.section=None; self.in_src=0; self.ref=''; self.buf=[]; self.rows={n:[] for n in wanted}
 def handle_starttag(self, tag, attrs):
  a=dict(attrs)
  if tag=='section' and a.get('id','').startswith('sheet-'):
   try: self.section=int(a['id'].split('-')[1])
   except: self.section=None
  if self.section in self.wanted and 'src-cell' in a.get('class','').split():
   self.in_src=1; self.ref=a.get('data-excel-ref',''); self.buf=[]
  elif self.in_src: self.in_src += 1
 def handle_endtag(self, tag):
  if self.in_src:
   self.in_src -= 1
   if self.in_src==0:
    txt=' '.join(''.join(self.buf).split())
    if txt: self.rows[self.section].append((self.ref,txt))
  if tag=='section' and not self.in_src: self.section=None
 def handle_data(self,data):
  if self.in_src: self.buf.append(data)
