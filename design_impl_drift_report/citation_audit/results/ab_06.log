     9	use FOS\RestBundle\View\View;
    10	use Symfony\Component\HttpFoundation\Request;
    11	
    12	class BannerController extends FOSRestController
    13	{
    14	    /**
    15	     * トップバナー情報取得
    16	     *
    17	     * @param integer $id
    18	     * @return array
    19	     */
    20	    public function getTopBannerAction($id)
    21	    {
    22	        $topBanner = $this->getDoctrine()
    23	            ->getRepository(MtbTopBanner::class)
    24	            ->find($id);
    25	
    26	        if (empty($topBanner)) {
    27	            $view = View::create([
    28	                "code" => 404,
    29	                "message" => 'Not Found'
    30	            ], 404);
    31	
    32	            return $this->get('fos_rest.view_handler')->handle($view);
    33	        }
    34	
    35	        return $topBanner;
    36	    }
    37	
    38	    /**
    39	     * 設定済みトップバナー一覧取得
    40	     *
    41	     * @param string $languageCode
    42	     * @return array
    43	     */
    44	    public function getTopBannersAction($languageCode)
    45	    {
    46	        $topBanners = $this->getDoctrine()
    47	            ->getRepository(MtbTopBanner::class)
    48	            ->findAllWhereUrlIsNotEmpty($languageCode);
    49	
    50	        if (empty($topBanners) &&
    51	            empty($this->getDoctrine()->getRepository(MtbLanguage::class)->findByCode($languageCode))) {
    52	
    53	            $view = View::create([
    54	                "code" => 404,
    55	                "message" => 'Language code is not found'
    56	            ], 404);
    57	
    58	            return $this->get('fos_rest.view_handler')->handle($view);
    59	        }
    60	
    61	        return $topBanners;
    62	    }
    63	}
