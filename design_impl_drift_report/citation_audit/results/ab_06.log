     4	use Doctrine\ORM\EntityRepository;
     5	
     6	/**
     7	 * MtbTopBannerRepository
     8	 */
     9	class MtbTopBannerRepository extends EntityRepository
    10	{
    11	    /**
    12	     * 画像URLが空文字でないレコードをすべて返す
    13	     *
    14	     * @param string $languageCode
    15	     * @return array
    16	     */
    17	    public function findAllWhereUrlIsNotEmpty($languageCode = null)
    18	    {
    19	        $qb = $this->createQueryBuilder('tb')
    20	            ->where("tb.imageUrl <> ''")
    21	            ->andWhere("tb.imageUrl <> ''")
    22	            ->andWhere("tb.dispType <> 0");
    23	        if ($languageCode) {
    24	            $qb->join('tb.languages', 'l')
    25	            ->andWhere("l.code = :languageCode")
    26	            ->setParameter('languageCode', $languageCode);
    27	        }
    28	        $qb->orderBy('tb.id', 'ASC');
    29	
    30	        return $qb->getQuery()->execute();
    31	    }
    32	}
