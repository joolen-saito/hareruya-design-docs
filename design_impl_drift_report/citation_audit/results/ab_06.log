     3	namespace App\Controller;
     4	
     5	use App\Entity\DtbArticle;
     6	use App\Entity\DtbDeck;
     7	use FOS\RestBundle\Controller\FOSRestController;
     8	use FOS\RestBundle\View\View;
     9	use Symfony\Component\HttpFoundation\Request;
    10	use App\Form\DtbArticleType;
    11	use FOS\RestBundle\Request\ParamFetcher;
    12	use FOS\RestBundle\Controller\Annotations\QueryParam;
    13	
    14	class ArticleController extends FOSRestController
    15	{
    16	    /**
    17	     * 記事情報登録
    18	     * 
    19	     * @param Request $request
    20	     * @return integer
    21	     */
    22	    public function postArticleAction(Request $request)
    23	    {
    24	        /* 
    25	         * Symfony4.4へアップデートの影響?で、メモリーオーバーとなるwpPostIdとならないIDが存在
    26	         * 原因は不明かつ実害が少なそうなので、一時的に記事登録機能を停止
    27	         */
    28	        return 1;
    29	
    30	        $em = $this->getDoctrine()->getManager();
    31	        $data = json_decode($request->getContent(), true);
    32	
    33	        $decks = $em->getRepository(DtbDeck::class)->findByDeckId($data['decks']);
    34	        unset($data['decks']);
    35	    
    36	        // すでにwpPostIdが存在すれば上書き、そうでなければ新規作成
    37	        $article = $em->getRepository(DtbArticle::class)->findOneByWpPostId($data['wpPostId']);
    38	        if (empty($article)) {
    39	            $article = new DtbArticle;
    40	        }
    41	
    42	        $form = $this->createForm(DtbArticleType::class, $article, [
    43	            'csrf_protection' => false,
    44	        ]);
    45	
    46	        $form->submit($data);
    47	        $article->setDecks($decks);
    48	
    49	        if (!$form->isValid()) {
    50	            $view = View::create($form, 400);
    51	
    52	            return $this->get('fos_rest.view_handler')->handle($view);
    53	        }
    54	
    55	        $em->persist($article);
    56	        $em->flush();
    57	
    58	        return $article->getArticleId();
    59	    }
    60	
    61	    /**
    62	     * 記事情報取得
    63	     * 
    64	     * @param integer $id
    65	     * @return array
    66	     */
    67	    public function getArticleAction($id)
    68	    {
    69	        $article = $this->getDoctrine()
    70	            ->getRepository(DtbArticle::class)
    71	            ->find($id);
    72	
    73	        if (empty($article)) {
    74	            $view = View::create([
    75	                "code" => 404,
    76	                "message" => 'Not Found'
    77	            ], 404);
    78	
    79	            return $this->get('fos_rest.view_handler')->handle($view);
    80	        }
    81	
    82	        return $article;
    83	    }
    84	
    85	    /**
    86	     * 検索クエリに一致する記事を一件取得
    87	     * 
    88	     * @QueryParam(name="wpPostId", description="article")
    89	     * @param ParamFetcher $paramFetcher
    90	     * @return array
    91	     */
    92	    public function getSingleArticleByParamsAction(ParamFetcher $paramFetcher)
    93	    {
    94	        $article = $this->getDoctrine()
    95	            ->getRepository(DtbArticle::class)
    96	            ->findOneByParams($paramFetcher->all());
    97	
    98	        if (empty($article)) {
    99	            $view = View::create([
   100	                "code" => 404,
   101	                "message" => 'Not Found'
   102	            ], 404);
   103	
   104	            return $this->get('fos_rest.view_handler')->handle($view);
   105	        }
   106	
   107	        return $article;
   108	    }
   109	
   110	    /**
   111	     * 関連記事を取得
   112	     * 
   113	     * @param integer $id
   114	     * @return array
   115	     */
   116	    public function getRelatedArticlesAction($id, Request $request)
   117	    {
   118	        $em = $this->getDoctrine()->getManager();
   119	        $articles = $em->getRepository(DtbArticle::class)->getRelatedArticles($id, $request->get('limit'));
   120	
   121	        if (empty($articles)) {
   122	            $view = View::create([
   123	                "code" => 404,
   124	                "message" => 'Not Found'
   125	            ], 404);
   126	
   127	            return $this->get('fos_rest.view_handler')->handle($view);
   128	        }
   129	
   130	        return $articles;
   131	    }
   132	
   133	    /**
   134	     * 記事情報削除
   135	     * 
   136	     * @param integer $id
   137	     * @return integer
   138	     */
   139	    public function deleteArticleAction($id)
   140	    {
   141	        $em = $this->getDoctrine()->getManager();
   142	        $article = $this->getDoctrine()
   143	            ->getRepository(DtbArticle::class)
   144	            ->find($id);
   145	
   146	        if (empty($article)) {
   147	            $view = View::create([
   148	                "code" => 404,
   149	                "message" => 'Not Found'
   150	            ], 404);
   151	
   152	            return $this->get('fos_rest.view_handler')->handle($view);
   153	        }
   154	
   155	        $em->remove($article);
   156	        $em->flush();
   157	
   158	        return $article->getArticleId();
   159	    }
   160	}

