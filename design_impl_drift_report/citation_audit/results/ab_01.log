    16	    /**
    17	     * スタック用紙の印字情報取得
    18	     *
    19	     * @return array
    20	     */
    21	    public function getPrintOrderList()
    22	    {
    23	        $qb = $this->createQueryBuilder('o')
    24	            ->select([
    25	                'o.orderId AS order_id',
    26	                'o.orderDate AS order_date',
    27	                'os.orderNumber AS order_number',
    28	                "CONCAT(o.orderKana01, ' ', o.orderKana02) AS name_kana",
    29	                "CONCAT(o.orderName01, ' ', o.orderName02) AS name",
    30	                'o.paymentTotal AS payment_total',
    31	                'o.status',
    32	                "'□' AS expensive",
    33	                'os.smaregiCode AS smaregi_code',
    34	                'CASE WHEN o.message IS NOT NULL THEN true ELSE false END AS hasMessage',
    35	            ])
    36	            ->join('o.orderSub', 'os')
    37	            ->join('\App\Entity\DtbShipping', 's', 'WITH', 's.order = o')
    38	            ->where('os.orderNumber IS NOT NULL')
    39	            ->andWhere('s.delivery = :otc AND o.status = :orderNew')
    40	            ->orWhere('s.delivery = :smoothOtc
    41	                AND o.status <> :processing
    42	                AND o.payment IN (:payments)
    43	                AND os.confirmDate IS NULL
    44	                AND o.commitDate IS NULL
    45	                AND os.shippingDate IS NULL
    46	                AND os.cancelDate IS NULL
    47	                AND os.receiptDate IS NULL
    48	                AND os.otcRsvDate IS NULL
    49	                AND os.smaregiCode IS NOT NULL'
    50	            )
    51	            ->orWhere('os.browserPrintFlg = 1')
    52	            ->setParameters([
    53	                'otc' => DtbDelivery::OTC,
    54	                'orderNew' => MtbOrderStatus::ORDER_NEW,
    55	                'smoothOtc' => DtbDelivery::SMOOTH_OTC,
    56	                'processing' => MtbOrderStatus::ORDER_PROCESSING,
    57	                'payments' => [DtbPayment::EC_CREDIT, DtbPayment::EC_SPLINKS_CREDIT, DtbPayment::EC_PAYMENT_NONE],
    58	            ])
    59	            ->groupBy('o.orderId')
    60	            ->setMaxResults(10)
    61	        ;
    62	
    63	        return $qb->getQuery()->getResult();
    64	    }
    65	}
