    88	    /**
    89	     * 印刷が完了した受注のステータスを更新する
    90	     */
    91	    private function updatePrintedOrderStatus()
    92	    {
    93	        try {
    94	            $xml = simplexml_load_string($_POST['ResponseFile']);
    95	        } catch (\Exception $e) {
    96	            $this->logger->error($_POST['ResponseFile']);
    97	            $this->logger->error($e->getMessage()); 
    98	
    99	            return;
   100	        }
   101	        if ($xml->ServerDirectPrint === 'false' || count($xml->ePOSPrint) < 1) {
   102	            $this->logger->error($_POST['ResponseFile']);
   103	
   104	            return;
   105	        }
   106	
   107	        $em = $this->getDoctrine()->getManager();
   108	        foreach ($xml->ePOSPrint as $print) {
   109	            $orderId = explode('_', $print->Parameter->printjobid)[0];
   110	            $order = $this->getDoctrine()->getRepository(DtbOrder::class)->findOneByOrderId($orderId);
   111	            if (!$order) {
   112	                $this->logger->error("ステータス更新エラー：受注ID{$orderId}が存在しません。");
   113	
   114	                continue;
   115	            }
   116	            $orderSub = $order->getOrderSub();
   117	            if ($orderSub->getBrowserPrintFlg()) {
   118	                $orderSub->setBrowserPrintFlg(false);
   119	            } else {
   120	                $order->setStatus(MtbOrderStatus::ORDER_PICKING);
   121	                $orderSub->setConfirmDate(new \DateTime());
   122	            }
   123	            $em->flush();
   124	        }
   125	    }
