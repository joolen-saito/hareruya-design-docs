    31	    public function postPrintDirectAction(Request $request)
    32	    {
    33	        $connectionType = $request->get('ConnectionType');
    34	        if ($connectionType === 'GetRequest') {
    35	            // 印刷データ送信処理
    36	            $uri = $request->getUriForPath('/');
    37	            $xmlData = $this->sendXmlData($uri);
    38	
    39	            // 印刷不具合検証のためXMLデータをファイル出力する
    40	            if (!empty($xmlData)) {
    41	                $dir = '/var/www/html/api/var/log/print_logs/';
    42	                if (!is_dir($dir)) {
    43	                    mkdir($dir, 0777, true);
    44	                }
    45	                $filename = $dir . 'print_' . date('Ymd_His') . '_' . uniqid() . '.xml';;
    46	                // ステータスがピック中だが未印刷という不具合再現待ちで停止
    47	                file_put_contents($filename, $xmlData);
    48	            }
    49	
    50	            $response = new StreamedResponse();
    51	            $response->setCallback(function() use ($xmlData) {
    52	                echo $xmlData;
    53	            });
    54	            $response->headers->set('Content-Type', 'application/octet-stream');
    55	            $response->send();
    56	        } elseif ($connectionType === 'SetResponse') {
    57	            // 印刷が完了した受注のステータスを更新
    58	            $this->updatePrintedOrderStatus();
    59	
    60	            return View::create([], Response::HTTP_OK, [
    61	                'Content-Type' => 'text/xml; charset=utf-8',
    62	                'Content-Length' => 0
    63	            ]);
    64	        }
    65	    }
