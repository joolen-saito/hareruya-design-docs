     6	        width: 2,
     7	        radius: 12,
     8	        corners: 1,
     9	        rotate: 0,
    10	        direction: 1,
    11	        color: '#BBB',
    12	        speed: 1,
    13	        trail: 67,
    14	        shadow: true,
    15	        hwaccel: false,
    16	        className: 'spinner',
    17	        zIndex: 2e9,
    18	        top: top
    19	    };
    20	
    21	    ImageSpinner = new Spinner(opts).spin(document.getElementById('spinner'));
    22	    ImageSpinner.stop();
    23	
    24	    $('#upload-form').submit(function() {
    25	        $('#upload-button').attr('disabled', 'disabled');
    26	        $('#download-button').attr('disabled', 'disabled');
    27	        ImageSpinner.spin(document.getElementById('spinner'));
    28	    });
