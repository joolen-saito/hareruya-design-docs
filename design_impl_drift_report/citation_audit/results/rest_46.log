   296	    #[Route('/%eccube_admin_route%/archetype/search_card_image', name: 'admin_archetype_search_card_image', methods: ['POST'])]
   297	    public function searchCardImage(Request $request): JsonResponse
   298	    {
   299	        $searchWord = $request->request->getString('search_word');
   300	        $exactMatch = $request->request->getString('exact_match') === '1';
   301	        $cardText = $request->request->getString('card_text');
   302	        $page = max(1, $request->request->getInt('page', 1));
   303	        $limit = 10;
   304	
   305	        $qb = $this->archetypeEntityManager->createQueryBuilder()
   306	            ->select('ci.id', 'ci.url', 'c.name_jp', 'c.name_en')
   307	            ->from(\Eccube\Entity\Master\MtbCardImage::class, 'ci')
   308	            ->join('ci.CardDetail', 'cd')
   309	            ->join('cd.Card', 'c')
   310	            ->andWhere('ci.back_flg = false');
   311	
   312	        if (!empty($searchWord)) {
   313	            if ($exactMatch) {
   314	                $qb->andWhere($qb->expr()->orX(
   315	                    $qb->expr()->eq('c.name_jp', ':word'),
   316	                    $qb->expr()->eq('c.name_en', ':word'),
   317	                ))
   318	                    ->setParameter('word', $searchWord);
   319	            } else {
   320	                $qb->andWhere($qb->expr()->orX(
   321	                    $qb->expr()->like('c.name_jp', ':word'),
   322	                    $qb->expr()->like('c.name_en', ':word'),
   323	                ))
   324	                    ->setParameter('word', '%'.$searchWord.'%');
   325	            }
   326	        }
   327	
   328	        if (!empty($cardText)) {
   329	            $qb->andWhere($qb->expr()->orX(
   330	                $qb->expr()->like('c.text_jp', ':cardText'),
   331	                $qb->expr()->like('c.text_en', ':cardText'),
   332	            ))
   333	                ->setParameter('cardText', '%'.$cardText.'%');
   334	        }
   335	
   336	        $event = new EventArgs(
   337	            [
   338	                'qb' => $qb,
   339	            ],
   340	            $request
   341	        );
   342	        $this->eventDispatcher->dispatch($event, EccubeEvents::ADMIN_ARCHETYPE_CARD_IMAGE_SEARCH);
   343	
   344	        $countQb = clone $qb;
   345	        $countQb->select('COUNT(ci.id)');
   346	        $totalCount = (int) $countQb->getQuery()->getSingleScalarResult();
   347	        $totalPages = (int) ceil($totalCount / $limit);
   348	        if ($totalPages > 0 && $page > $totalPages) {
   349	            $page = $totalPages;
   350	        }
   351	
   352	        $qb->orderBy('ci.id', 'ASC')
   353	            ->setFirstResult(($page - 1) * $limit)
   354	            ->setMaxResults($limit);
   355	
   356	        $results = $qb->getQuery()->getResult();
   357	        $data = [];
   358	        foreach ($results as $row) {
   359	            $data[] = [
   360	                'id' => $row['id'],
   361	                'url' => $row['url'],
   362	                'nameJp' => $row['name_jp'] ?? '',
   363	                'nameEn' => $row['name_en'] ?? '',
   364	            ];
   365	        }
   366	
   367	        return new JsonResponse([
   368	            'items' => $data,
   369	            'totalCount' => $totalCount,
   370	            'page' => $page,
   371	            'totalPages' => $totalPages,
   372	        ]);
   373	    }
   374	}
