    51	
    52	        log_info('アーキタイプCSV登録開始');
    53	        $data = $archetypeCsv->getImportData($formFile);
    54	        if ($data === false) {
    55	            return $archetypeCsv->render();
    56	        }
    57	
    58	        try {
    59	            // ヘッダーの値が一致するかチェック
    60	            $headers = $this->getCsvHeader();
    61	            $columnHeaders = $data->getColumnHeaders();
    62	            $archetypeCsv->checkHeaderValues(array_keys($headers), $columnHeaders, $this->getNotRequiredCsvHeader());
    63	            $headerSize = count($columnHeaders);
    64	
    65	            // CSVデータが空でないかチェック
    66	            $archetypeCsv->checkDataSize($data);
    67	
    68	            $app['orm.em']->getConfiguration()->setSQLLogger(null);
    69	            $app['orm.em']->beginTransaction();
    70	
    71	            // CSVファイルの登録処理
    72	            $archetypeCsv->register($headers, $headerSize, $data);
    73	        } catch (\LogicException | \RuntimeException $e) {
    74	            // 登録失敗時の処理
    75	            $app['orm.em']->rollback();
    76	            log_info('エラーが発生しました', [$e->getMessage()]);
    77	            $app->addError($e->getMessage(), 'admin');
    78	
    79	            return $archetypeCsv->render();
    80	        }
    81	
    82	        log_info('アーキタイプCSV登録完了');
    83	        $app->addSuccess('admin.register.complete', 'admin');
    84	
    85	        return $archetypeCsv->render();
    86	    }
