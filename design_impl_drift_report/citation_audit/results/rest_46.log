     1	{% extends 'default_frame.twig' %}
     2	
     3	{% set menus = ['deck_menu', 'archetype_list'] %}
     4	
     5	{% block title %}アーキタイプ管理{% endblock %}
     6	{% block sub_title %}アーキタイプ登録CSV, TSVアップロード{% endblock %}
     7	
     8	{% form_theme form 'Form/bootstrap_3_horizontal_layout.html.twig' %}
     9	
    10	{% block javascript %}
    11	<script src="{{ app.config.admin_urlpath }}/assets/js/vendor/spin.min.js"></script>
    12	<script src="{{ path('admin_assets', {'path': 'js/card-csvimport.js'}) }}"></script>
    13	{% endblock javascript %}
    14	
    15	{% block main %}
    16	<div id="upload_wrap" class="row">
    17	    <div id="upload_file_box" class="col-md-12">
    18	        <form id="upload-form" class="form-inline" method="post" action="{{ url('admin_archetype_csv_import') }}" {{ form_enctype(form) }}>
    19	            {{ form_widget(form._token) }}
    20	            <div id="upload_file_box__body" class="box">
    21	                <div id="upload_file_box__header" class="box-header">
    22	                    <h3 class="box-title">アーキタイプ登録CSV, TSV</h3>
    23	                </div><!-- /.box-header -->
    24	                <div id="upload_file_box__body_inner" class="box-body">
    25	                    <div id="upload_file_box__upload_box" class="form-group">
    26	                        <label class="col-sm-5 control-label">CSV, TSVファイル選択</label>
    27	                        <div id="upload_file_box__import_file" class="col-sm-7">
    28	                            {{ form_widget(form.import_file, {'attr': {'accept': '.csv, text/csv, .tsv, text/tsv'}}) }}
    29	                            {{ form_errors(form.import_file) }}
    30	                        </div>
    31	                    </div>
    32	                    <div id="spinner"></div>
    33	                </div><!-- /.box-body -->
    34	                <div id="button_box__upload_button" class="box-footer text-center">
    35	                    <button id="upload-button" type="submit" class="btn btn-primary btn-sm">CSV, TSVファイルのアップロード</button>
    36	                </div><!-- /.box-footer -->
    37	            </div><!-- /.box -->
    38	        </form>
    39	    </div><!-- /.col -->
    40	</div>
    41	
    42	<div id="file_format" class="row">
    43	    <div id="file_format_box" class="col-md-12">
    44	        <div id="file_format_box__body" class="box">
    45	            <div id="file_format_box__head" class="box-header">
    46	                <h3 class="box-title">アーキタイプ登録CSV, TSVファイルフォーマット</h3>
    47	            </div><!-- /.box-header -->
    48	            <div id="file_format_box__body_inner" class="box-body no-padding">
    49	                <div id="file_format_box__list_box" class="table_list">
    50	                    <div id="file_format_box__list_box_body" class="table-responsive no-border table-menu table-responsive-overflow">
    51	                        <table class="table table-striped">
    52	                            <thead>
    53	                                <tr id="file_format_box__header" class="text-nowrap">
    54	                                    {% for header in headers|keys %}
    55	                                        <th id="file_format_box__header--{{ loop.index }}">{{ header }}</th>
    56	                                    {% endfor %}
    57	                                </tr>
    58	                            </thead>
    59	                            <tbody>
    60	                                <tr id="file_format_box__list" class="text-nowrap">
    61	                                    {% for key, value in headers %}
    62	                                        <th id="file_format_box__{{ key }}">{{ value|nl2br }}</th>
    63	                                    {% endfor %}
    64	                                </tr>
    65	                            </tbody>
    66	                        </table>
    67	                    </div>
    68	                </div>
    69	            </div><!-- /.box-body -->
    70	        </div><!-- /.box -->
    71	    </div><!-- /.col -->
    72	</div>
    73	
    74	{% endblock %}
     1	$(function() {
     2	
