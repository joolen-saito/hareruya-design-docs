import json,re
p='hareruya-design-docs/design_impl_drift_report/citation_audit/results/rest_46.json'
packet='hareruya-design-docs/design_impl_drift_report/citation_audit/packets/rest_46.json'
d=json.load(open(p)); src=json.load(open(packet))
required={'rowId','verdict','specEvidence','legacyEvidence','currentImpl','note'}
valid={'SPEC_BACKED','LEGACY_BACKED','UNSUPPORTED','ALREADY_MET','UNCERTAIN'}
assert d['packetId']=='rest_46'
assert len(d['results'])==src['count']==20
assert [x['rowId'] for x in d['results']]==[x['rowId'] for x in src['findings']]
for x in d['results']:
 assert set(x)==required,(x['rowId'],set(x))
 assert x['verdict'] in valid
 for k in ('specEvidence','legacyEvidence','currentImpl'):
  assert x[k].strip(),(x['rowId'],k)
  assert re.search(r':\\d',x[k]),(x['rowId'],k,'no line marker')
from collections import Counter
print('count',len(d['results']))
print('rows',','.join(map(str,[x['rowId'] for x in d['results']])))
print('verdicts',dict(Counter(x['verdict'] for x in d['results'])))
