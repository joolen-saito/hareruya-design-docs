    75	            function buildCardImageRow(c) {
    76	                const $tr = $('<tr>');
    77	                $('<td>').text(c.id).appendTo($tr);
    78	                const displayName = c.nameJp ? c.nameJp + ' / ' + c.nameEn : c.nameEn;
    79	                $('<td>').text(displayName).appendTo($tr);
    80	                const $imgTd = $('<td>');
    81	                $('<img>').attr('src', buildImagePath(c.url)).css('max-height', '100px').appendTo($imgTd);
    82	                $imgTd.appendTo($tr);
    83	                const $btnTd = $('<td>');
    84	                $('<button>')
    85	                    .attr('type', 'button')
    86	                    .addClass('btn btn-sm btn-ec-regular select-card-image')
    87	                    .attr('data-id', c.id)
    88	                    .attr('data-name', displayName)
    89	                    .attr('data-url', c.url)
    90	                    .text('{{ "admin.deck.select"|trans|e('js') }}')
    91	                    .appendTo($btnTd);
    92	                $btnTd.appendTo($tr);
    93	                return $tr;
    94	            }
