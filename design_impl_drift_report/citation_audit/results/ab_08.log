     5	use Symfony\Component\Console\Input\InputArgument;
     6	use Symfony\Component\Console\Input\InputInterface;
     7	use Symfony\Component\Console\Output\OutputInterface;
     8	use Knp\Command\Command;
     9	
    10	class ProductBatch extends Command
    11	{
    12	    const BATCH_NAMES = [
    13	        'displayReleasedProduct' => 'Plugin\HareruyaEc\Service\Product\DisplayReleasedProduct',
    14	        'updateProductSummary' => 'Plugin\HareruyaEc\Service\Product\UpdateProductSummary',
    15	        'attachCategory' => 'Plugin\HareruyaEc\Service\Product\AttachCategory',
    16	        'deleteProductRequest' => 'Plugin\HareruyaEc\Service\Product\DeleteProductRequest',
    17	        'exportWeeklyStockHistoryCsv' => 'Plugin\HareruyaEc\Service\Product\ExportWeeklyStockHistoryCsv',
    18	        'ExportPopularProductRecommendCsv' => 'Plugin\HareruyaEc\Service\Product\ExportPopularProductRecommendCsv',
    19	        'insertStockHistory' => 'Plugin\HareruyaEc\Service\Product\InsertStockHistory',
    20	        'updateProductSummaryForStockUp' => 'Plugin\HareruyaEc\Service\Product\UpdateProductSummaryForStockUp',
    21	        'checkNoSectionProduct' => 'Plugin\HareruyaEc\Service\Product\CheckNoSectionProduct',
    22	        'saleNotification' => 'Plugin\HareruyaEc\Service\Product\SaleNotificationService',
    23	        'inventoryReflection' => 'Plugin\HareruyaEc\Service\Product\InventoryReflectService',
    24	    ];
    25	
    26	    const LAST_ARG = 10;
    27	
    28	    protected function configure()
    29	    {
    30	        $this->setName('product:batch')
    31	            ->setDescription('product batchs')
    32	            ->addArgument('batch_name', InputArgument::OPTIONAL);
    33	
    34	        foreach (range(1, self::LAST_ARG) as $num) {
    35	            $this->addArgument("arg-{$num}", InputArgument::OPTIONAL);
    36	        }
    37	    }
    38	
    39	    protected function execute(InputInterface $input, OutputInterface $output)
    40	    {
    41	        $app = $this->getSilexApplication();
    42	
    43	        $name = $input->getArgument('batch_name');
    44	        $batchNames = self::BATCH_NAMES;
    45	        $resultMessage = '[' . date('Y/m/d H:i') . '] ';
    46	
    47	        if (!isset($batchNames[$name])) {
    48	            echo $resultMessage . " Nothing args or command.\n";
    49	
    50	            return 1;
    51	        }
    52	
    53	        $product = new $batchNames[$name]($app, $this->createOptions($input));
    54	        echo $resultMessage . "{$name}: Command start.\n";
    55	        $product->execute();
    56	        echo $product->getErrorMassage() ?? $resultMessage . "{$name}: Command complete.\n";
    57	
    58	        return 0;
    59	    }
    60	
    61	    /**
    62	     * 引数がある場合はoptionsに詰め込む
    63	     * @param InputInterface $input
    64	     * @return array $options
    65	     */
    66	    private function createOptions(InputInterface $input)
    67	    {
    68	        $num = 1;
    69	        $options = [];
    70	        while (!empty($input->getArgument("arg-{$num}"))) {
    71	            $options[] = $input->getArgument("arg-{$num}");
    72	            $num++;
    73	        }
    74	
    75	        return $options;
    76	    }
    77	}
