    26	/**
    27	 * 在庫初期化バッチ（B02-06）
    28	 *
    29	 * 店舗登録時、基準店舗の商品規格在庫データを新店舗用に複製する（在庫数0で初期化）。
    30	 *
    31	 * 【使い方】
    32	 *
    33	 *   bin/console eccube:initial-stock-registration {新店舗のbase_info_id}
    34	 */
    35	#[AsCommand(name: 'eccube:initial-stock-registration', description: '在庫初期化バッチ')]
    36	class InitialStockRegistrationCommand extends Command
    37	{
    38	    public function __construct(private readonly BatchInitialStockRegistrationAction $batchInitialStockRegistrationAction)
    39	    {
    40	        parent::__construct();
    41	    }
    42	
    43	    #[\Override]
    44	    protected function configure(): void
    45	    {
    46	        $this->addArgument('target_base_info_id', InputArgument::REQUIRED, '新店舗の base_info_id');
    47	    }
    48	
    49	    #[\Override]
    50	    protected function execute(InputInterface $input, OutputInterface $output): int
    51	    {
    52	        $io = new SymfonyStyle($input, $output);
    53	
    54	        $targetBaseInfoIdRaw = $input->getArgument('target_base_info_id');
    55	        if (!is_string($targetBaseInfoIdRaw) || !ctype_digit($targetBaseInfoIdRaw) || (int) $targetBaseInfoIdRaw <= 0) {
    56	            $io->error('target_base_info_id には 1 以上の整数を指定してください。');
    57	
    58	            return Command::FAILURE;
    59	        }
    60	
    61	        $targetBaseInfoId = (int) $targetBaseInfoIdRaw;
    62	
    63	        try {
    64	            $count = $this->batchInitialStockRegistrationAction->handle($targetBaseInfoId);
    65	        } catch (\Exception $e) {
    66	            $io->error('在庫初期化でエラーが発生しました: '.$e->getMessage());
    67	
    68	            return Command::FAILURE;
    69	        }
    70	
    71	        $io->success(sprintf('在庫初期化が完了しました。（%d件作成、新店舗ID=%d）', $count, $targetBaseInfoId));
    72	
    73	        return Command::SUCCESS;
    74	    }
    75	}
