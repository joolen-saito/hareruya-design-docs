     3	namespace Plugin\HareruyaEc\Service\Product;
     4	
     5	use Eccube\Application;
     6	
     7	class SaleNotificationService extends ProductBatchService
     8	{
     9	    protected $commandName = 'saleNotification';
    10	    protected $app;
    11	    protected $options = [];
    12	
    13	    /**
    14	     * Constructor
    15	     * @param Eccube\Application $app
    16	     * @param array $options
    17	     */
    18	    function __construct(Application $app, $options = [])
    19	    {
    20	        $this->app = $app;
    21	        $this->options = $options;
    22	    }
    23	
    24	    /**
    25	     * notification sale favorite product
    26	     */
    27	    public function execute()
    28	    {
    29	        // セール状態のお気に入り商品情報を取得
    30	        $saleFavoriteProducts = $this->app['hareruya_ec.repository.favorite_product']->findSaleFavoriteProducts();
    31	        $customerDataList = [];
    32	        // 各顧客ごとに送り先・セール商品をまとめる
    33	        $i = 0;
    34	        foreach($saleFavoriteProducts as $saleFavoriteProduct) {
    35	            $playerId = $saleFavoriteProduct[$i]['playerId'];
    36	            if (!array_key_exists($playerId, $customerDataList)) {
    37	                $customerDataList[$playerId] = [];
    38	                $customerDataList[$playerId]['name01'] = $saleFavoriteProduct[$i]['name01'];
    39	                $customerDataList[$playerId]['name02'] = $saleFavoriteProduct[$i]['name02'];
    40	                $customerDataList[$playerId]['email'] = $saleFavoriteProduct[$i]['email'];
    41	                $customerDataList[$playerId]['prefId'] = $saleFavoriteProduct[$i]['prefId'];
    42	                $customerDataList[$playerId]['products'] = [];
    43	            }
    44	
    45	            $productData = [
    46	                'productId' => $saleFavoriteProduct[$i]['productId'],
    47	                'langCode' => $saleFavoriteProduct[$i]['langCode'],
    48	                'name' => $saleFavoriteProduct[$i]['productName'],
    49	                'nameEn' => $saleFavoriteProduct[$i]['productNameEn']
    50	            ];
    51	            $customerDataList[$playerId]['products'][] = $productData;
    52	            $i++;
    53	
    54	            if ($i % 1000 === 0) {
    55	                $this->app['orm.em']->clear();
    56	            }
    57	        }
    58	
    59	        $transport = new \Swift_SmtpTransport('localhost', 25);
    60	        $transport->setUsername($this->app['config']['HareruyaEc']['const']['swiftmailer_user']);
    61	        $transport->setPassword('');
    62	        $this->app['mailer'] = new \Swift_Mailer($transport);
    63	
    64	        // 各顧客情報ごとに通知メール送信処理
    65	        foreach($customerDataList as $customerData) {
    66	            $this->app['hareruya_ec.service.mail']->sendSaleProductNotification($customerData);
    67	        }
    68	    }
    69	}
