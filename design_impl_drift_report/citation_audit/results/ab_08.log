   311	                SUM(CASE WHEN date_format(sh.create_date,'%Y%m%d') >= date_format(date_sub('{$dateStr}', INTERVAL 3 DAY),'%Y%m%d') THEN (CASE WHEN (sh.stock > sh.old_stock) THEN (sh.stock - sh.old_stock) ELSE 0 END) ELSE 0 END) AS stock_up_3day,
   312	                SUM(CASE WHEN date_format(sh.create_date,'%Y%m%d') >= date_format(date_sub('{$dateStr}', INTERVAL 7 DAY),'%Y%m%d') THEN (CASE WHEN (sh.stock > sh.old_stock) THEN (sh.stock - sh.old_stock) ELSE 0 END) ELSE 0 END) AS stock_up_weekly,
   313	                SUM(CASE WHEN date_format(sh.create_date,'%Y%m%d') >= date_format(date_sub('{$dateStr}', INTERVAL 14 DAY),'%Y%m%d') THEN (CASE WHEN (sh.stock > sh.old_stock) THEN (sh.stock - sh.old_stock) ELSE 0 END) ELSE 0 END) AS stock_up_2week,
   314	                SUM(CASE WHEN date_format(sh.create_date,'%Y%m%d') >= date_format(date_sub('{$dateStr}', INTERVAL 21 DAY),'%Y%m%d') THEN (CASE WHEN (sh.stock > sh.old_stock) THEN (sh.stock - sh.old_stock) ELSE 0 END) ELSE 0 END) AS stock_up_3week,
   315	                SUM(CASE WHEN date_format(sh.create_date,'%Y%m%d') >= date_format(date_sub('{$dateStr}', INTERVAL 28 DAY),'%Y%m%d') THEN (CASE WHEN (sh.stock > sh.old_stock) THEN (sh.stock - sh.old_stock) ELSE 0 END) ELSE 0 END) AS stock_up_month,
   316	                SUM(CASE WHEN date_format(sh.create_date,'%Y%m%d') >= date_format(date_sub('{$dateStr}', INTERVAL 90 DAY),'%Y%m%d') THEN (CASE WHEN (sh.stock > sh.old_stock) THEN (sh.stock - sh.old_stock) ELSE 0 END) ELSE 0 END) AS stock_up_90day,
   317	                SUM(CASE WHEN date_format(sh.create_date,'%Y%m%d') >= date_format(date_sub('{$dateStr}', INTERVAL 180 DAY),'%Y%m%d') THEN (CASE WHEN (sh.stock > sh.old_stock) THEN (sh.stock - sh.old_stock) ELSE 0 END) ELSE 0 END) AS stock_up_180day,
   318	                SUM(CASE WHEN date_format(sh.create_date,'%Y%m%d') >= date_format(date_sub('{$dateStr}', INTERVAL 365 DAY),'%Y%m%d') THEN (CASE WHEN (sh.stock > sh.old_stock) THEN (sh.stock - sh.old_stock) ELSE 0 END) ELSE 0 END) AS stock_up_365day
