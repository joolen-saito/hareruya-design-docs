     1	<?php
     2	
     3	namespace Plugin\HareruyaEc\Service\Product;
     4	
     5	use Eccube\Application;
     6	use Plugin\HareruyaEc\Entity\DtbStockHistory;
     7	use Plugin\HareruyaEc\Entity\MtbStockChangeType;
     8	use Plugin\HareruyaEc\Util\EntityManagerUtil;
     9	
    10	class InsertStockHistory extends ProductBatchService
    11	{
    12	    protected $commandName = 'insertStockHistory';
    13	    protected $app;
    14	    protected $options = [];
    15	
    16	    /**
    17	     * Constructor
    18	     * @param Eccube\Application $app
    19	     * @param array $options
    20	     */
    21	    function __construct(Application $app, $options = [])
    22	    {
    23	        $this->app = $app;
    24	        $this->options = $options;
    25	    }
    26	
    27	    /**
    28	     * Update display status
    29	     *
    30	     * @param array $option
    31	     */
    32	    public function execute()
    33	    {
    34	        if (count($this->options) < 2) {
    35	            echo "開始と終了の日付を指定してください。\n";
    36	
    37	            return;
    38	        }
    39	        $startDate = new \DateTime($this->options[0]);
    40	        $endDate = new \DateTime($this->options[1]);
    41	        $orders = $this->app['hareruya_ec.repository.order']->getQueryBuilderByOrderDate($startDate, $endDate);
    42	        foreach ($orders as $order) {
    43	            $orderId = $order->getId();
    44	            $orderDate = $order->getOrderDate();
    45	            $orderSub = $this->app['hareruya_ec.repository.order_sub']->find($orderId);
    46	            foreach($order->getOrderDetails() as $detail) {
    47	                $productClassId = $detail->getProductClass()->getId();
    48	                $latestStockHistory = $this->app['hareruya_ec.repository.stock_history']->getLatestStockHistoryByCreateDate($productClassId, $orderDate);
    49	                if (!empty($latestStockHistory)) {
    50	                    $detailId = $detail->getId();
    51	                    $name = $detail->getProductName();
    52	                    $memo = sprintf($this->app->trans('stock_change.order_minus'), $orderSub->getOrderNumber(), $detail->getPrice());
    53	
    54	                    // memoと商品規格IDから履歴に登録されているか確認、登録済みの場合は次の商品規格へ
    55	                    $isRegisterd = $this->app['hareruya_ec.repository.stock_history']->isRegisteredStockHistory($productClassId, $memo);
    56	                    if ($isRegisterd) {
    57	                        echo "受注ID:{$orderId} 受注詳細ID:{$detailId} 商品名:{$name}の在庫履歴はすでに登録されています。\n";
    58	                        continue;
    59	                    }
    60	
    61	                    // 在庫履歴を追加する
    62	                    $history = new DtbStockHistory();
    63	                    $history->setStockChangeTypeId(MtbStockChangeType::ORDER)
    64	                        ->setProductClassId($productClassId)
    65	                        ->setStock($latestStockHistory->getStock() - $detail->getQuantity())
    66	                        ->setOldStock($latestStockHistory->getStock())
    67	                        ->setSellPrice($detail->getPrice())
    68	                        ->setMemo($memo);
    69	                    $this->app['hareruya_ec.repository.stock_history']->createStockHistoryNative($this->app, $history, $orderDate);
    70	                    echo "在庫履歴登録 受注ID:{$orderId} 受注詳細ID:{$detailId} 商品名:{$name} \n";
    71	                    $this->app['orm.em']->flush();
    72	                }
    73	            }
    74	        }
    75	    }
    76	}
