    16	namespace Eccube\Repository;
    17	
    18	use Doctrine\ORM\QueryBuilder;
    19	use Doctrine\Persistence\ManagerRegistry as RegistryInterface;
    20	use Eccube\Common\Constant;
    21	use Eccube\Common\EccubeConfig;
    22	use Eccube\Entity\Customer;
    23	use Eccube\Entity\CustomerFavoriteProduct;
    24	use Eccube\Entity\Master\ProductListOrderBy;
    25	use Eccube\Entity\Master\ProductStatus;
    26	use Eccube\Entity\Product;
    27	use Eccube\Entity\ProductClass;
    28	use Eccube\Entity\ProductStock;
