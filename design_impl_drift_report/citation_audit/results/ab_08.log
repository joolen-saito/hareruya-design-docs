    18	use Eccube\Service\Product\BatchFavoriteSaleNotificationAction;
    19	use Symfony\Component\Console\Attribute\AsCommand;
    20	use Symfony\Component\Console\Command\Command;
    21	use Symfony\Component\Console\Input\InputInterface;
    22	use Symfony\Component\Console\Output\OutputInterface;
    23	use Symfony\Component\Console\Style\SymfonyStyle;
    24	
    25	/**
    26	 * お気に入り商品セール通知バッチ（B02-05）
    27	 *
    28	 * お気に入り登録商品がセール中の会員にメール通知する。
    29	 *
    30	 * 【使い方】
    31	 *
    32	 *   bin/console eccube:favorite-sale-notification
    33	 */
    34	#[AsCommand(name: 'eccube:favorite-sale-notification', description: 'お気に入り商品セール通知バッチ')]
    35	class FavoriteSaleNotificationCommand extends Command
    36	{
    37	    public function __construct(private readonly BatchFavoriteSaleNotificationAction $batchFavoriteSaleNotificationAction)
    38	    {
    39	        parent::__construct();
    40	    }
    41	
    42	    #[\Override]
    43	    protected function execute(InputInterface $input, OutputInterface $output): int
    44	    {
    45	        $io = new SymfonyStyle($input, $output);
    46	
    47	        try {
    48	            $count = $this->batchFavoriteSaleNotificationAction->handle();
    49	        } catch (\Exception $e) {
    50	            $io->error('お気に入り商品セール通知でエラーが発生しました: '.$e->getMessage());
    51	
    52	            return Command::FAILURE;
    53	        }
    54	
    55	        if ($count === 0) {
    56	            $io->success('セール中のお気に入り商品はありませんでした。');
    57	        } else {
    58	            $io->success(sprintf('お気に入り商品セール通知を%d名に送信しました。', $count));
    59	        }
    60	
    61	        return Command::SUCCESS;
    62	    }
    63	}
