    30	/**
    31	 * CustomerFavoriteProductRepository
    32	 *
    33	 * This class was generated by the Doctrine ORM. Add your own custom
    34	 * repository methods below.
    35	 *
    36	 * @extends AbstractRepository<CustomerFavoriteProduct>
    37	 */
    38	class CustomerFavoriteProductRepository extends AbstractRepository
    39	{
    40	    public function __construct(
    41	        RegistryInterface $registry,
    42	        EccubeConfig $eccubeConfig,
    43	    ) {
    44	        parent::__construct($registry, CustomerFavoriteProduct::class);
    45	        $this->eccubeConfig = $eccubeConfig;
    46	    }
    47	
    48	    public function addFavorite(Customer $Customer, Product $Product): void
    49	    {
    50	        if ($this->isFavorite($Customer, $Product)) {
    51	            return;
    52	        } else {
    53	            $CustomerFavoriteProduct = new CustomerFavoriteProduct();
    54	            $CustomerFavoriteProduct->setCustomer($Customer);
    55	            $CustomerFavoriteProduct->setProduct($Product);
    56	
    57	            $em = $this->getEntityManager();
    58	            $em->persist($CustomerFavoriteProduct);
    59	            $em->flush();
    60	        }
    61	    }
    62	
    63	    public function isFavorite(Customer $Customer, Product $Product): bool
    64	    {
    65	        $qb = $this->createQueryBuilder('cf')
    66	            ->select('COUNT(cf.Product)')
    67	            ->andWhere('cf.Customer = :Customer AND cf.Product = :Product')
    68	            ->setParameter('Customer', $Customer)
    69	            ->setParameter('Product', $Product)
    70	        ;
    71	        $count = $qb
    72	            ->getQuery()
    73	            ->getSingleScalarResult();
    74	
    75	        return $count > 0;
    76	    }
    77	
    78	    public function getQueryBuilderByCustomer(Customer $Customer): QueryBuilder
    79	    {
    80	        $qb = $this->createQueryBuilder('cfp')
    81	            ->select('cfp, p')
    82	            ->innerJoin('cfp.Product', 'p')
    83	            ->where('cfp.Customer = :Customer AND p.Status = 1')
    84	            ->setParameter('Customer', $Customer);
    85	
    86	        // Order By
    87	        $qb->addOrderBy('cfp.create_date', 'DESC');
    88	
    89	        return $qb;
    90	    }
    91	
    92	    /**
    93	     * フロントお気に入りブロック用: お気に入り登録商品のうち公開中・在庫あり・locale 一致の ProductClass を返す。
    94	     *
    95	     * pf-eccube3 の ProductFinder の locale (display_locale_list) / stock 条件を踏襲し、
    96	     * Product ごとに 1 ProductClass (pc.id 昇順で deterministic) を cfp.create_date 降順で返す。
    97	     *
    98	     * @return ProductClass[]
    99	     */
   100	    public function findTopFavoriteProductClassesByCustomer(
   101	        Customer $Customer,
   102	        string $locale,
   103	        int $limit,
   104	        ?int $stockBaseInfoId = null,
   105	    ): array {
   106	        $baseInfoId = $stockBaseInfoId ?? (int) $this->eccubeConfig->get('eccube_root_base_info_id');
   107	
   108	        /** @var ProductClass[] $candidates */
   109	        $candidates = $this->getEntityManager()->createQueryBuilder()
   110	            ->select('pc', 'p')
   111	            ->addSelect('cfp.create_date AS HIDDEN favoritedAt')
   112	            ->addSelect('cfp.id AS HIDDEN favoriteId')
   113	            ->from(ProductClass::class, 'pc')
   114	            ->innerJoin('pc.Product', 'p')
   115	            ->innerJoin(CustomerFavoriteProduct::class, 'cfp', 'WITH', 'cfp.Product = p')
   116	            ->leftJoin('p.RegionRestriction', 'rr')
   117	            ->where('cfp.Customer = :Customer')
   118	            ->andWhere('p.Status = 1')
   119	            ->andWhere('pc.visible = true')
   120	            ->andWhere('EXISTS (
   121	                SELECT 1 FROM \Eccube\Entity\ProductStock ps
   122	                WHERE ps.ProductClass = pc
   123	                  AND ps.stock > 0
   124	                  AND IDENTITY(ps.baseInfo) = :baseInfoId
   125	                  AND ps.stockLocationId = :eccubeStockLocationId
   126	            )')
   127	            ->andWhere('(rr.display_locale_list IS NULL OR rr.display_locale_list LIKE :locale)')
   128	            ->setParameter('Customer', $Customer)
   129	            ->setParameter('baseInfoId', $baseInfoId)
   130	            ->setParameter('eccubeStockLocationId', ProductStock::STOCK_LOCATION_ECCUBE)
   131	            ->setParameter('locale', '%'.$locale.'%')
   132	            ->orderBy('favoritedAt', 'DESC')
   133	            ->addOrderBy('favoriteId', 'DESC')
   134	            ->addOrderBy('pc.id', 'ASC')
   135	            ->getQuery()
   136	            ->getResult();
   137	
   138	        $selectedByProductId = [];
   139	        foreach ($candidates as $ProductClass) {
   140	            $productId = $ProductClass->getProduct()->getId();
   141	            if (isset($selectedByProductId[$productId])) {
   142	                continue;
   143	            }
   144	            $selectedByProductId[$productId] = $ProductClass;
   145	        }
   146	
   147	        return array_slice(array_values($selectedByProductId), 0, $limit);
   148	    }
   149	
   150	    /**
   151	     * お気に入りを削除します.
   152	     *
   153	     * @param CustomerFavoriteProduct $CustomerFavoriteProduct
   154	     */
   155	    #[\Override]
   156	    public function delete($CustomerFavoriteProduct): void
   157	    {
   158	        $em = $this->getEntityManager();
   159	        $em->remove($CustomerFavoriteProduct);
   160	        $em->flush();
   161	    }
   162	
   163	    /**
   164	     * @param array<string, mixed>|null $searchData
   165	     *
   166	     * @return CustomerFavoriteProduct[]
   167	     */
   168	    public function getQueryBuilderBySearchFavorite(Customer $Customer, ?array $searchData): array
   169	    {
   170	        $qb = $this->createQueryBuilder('fp')
   171	            ->addSelect(['p', 'cd', 'pc'])
   172	            ->innerJoin('fp.Product', 'p')
   173	            ->innerJoin('p.ProductClasses', 'pc')
   174	            ->leftJoin('p.CardDetail', 'cd')
   175	            ->leftJoin('cd.Card', 'c')
   176	            ->where('fp.Customer = :Customer')
   177	            ->andWhere('p.Status = :status')
   178	            ->setParameter('Customer', $Customer)
   179	            ->setParameter('status', ProductStatus::DISPLAY_SHOW);
   180	
   181	        if (isset($searchData['sale_flg']) && $searchData['sale_flg']) {
   182	            $qb
   183	                ->andWhere('pc.sale_flg = :sale_flg')
   184	                ->setParameter('sale_flg', Constant::ENABLED);
   185	        }
   186	
   187	        $orderId = !empty($searchData['orderby']) ? $searchData['orderby']->getId() : null;
   188	
   189	        if ($orderId === ProductListOrderBy::PRICE_ROW) {
   190	            // 価格低い順
   191	            $qb
   192	                ->andWhere('pc.visible = true')
   193	                ->addSelect('MIN(pc.price02) as HIDDEN price02_min')
   194	                ->groupBy('fp.id, p.id, cd.id, c.id')
   195	                ->orderBy('price02_min', 'ASC');
   196	        } elseif ($orderId === ProductListOrderBy::PRICE_HIGHER) {
   197	            // 価格高い順
   198	            $qb
   199	                ->andWhere('pc.visible = true')
   200	                ->addSelect('MAX(pc.price02) as HIDDEN price02_max')
   201	                ->groupBy('fp.id, p.id, cd.id, c.id')
   202	                ->orderBy('price02_max', 'DESC');
   203	        } else {
   204	            // 色順
   205	            $qb->orderBy('c.ColorSequence', 'ASC');
   206	        }
   207	
   208	        $qb->addOrderBy('fp.id', 'DESC');
   209	
   210	        return $qb->getQuery()->getResult();
   211	    }
   212	
   213	    /**
   214	     * セール中のお気に入り商品を会員別に取得する。
   215	     *
   216	     * 本会員のみ対象（仮会員・退会済み会員は除外）。
   217	     * 会員ごとに商品名・言語コードをまとめた配列を返す。
   218	     *
   219	     * @return array<int, array{
   220	     *     customer_id: int,
   221	     *     name01: string,
   222	     *     name02: string,
   223	     *     email: string,
   224	     *     pref_id: int|null,
   225	     *     product_name: string,
   226	     *     product_name_en: string|null,
   227	     *     lang_code: string|null,
   228	     * }>
   229	     */
   230	    public function findSaleFavoriteProducts(): array
   231	    {
   232	        return $this->createQueryBuilder('cfp')
   233	            ->select(
   234	                'c.id AS customer_id',
   235	                'c.name01',
   236	                'c.name02',
   237	                'c.email',
   238	                'pref.id AS pref_id',
   239	                'p.name AS product_name',
   240	                'p.name_en AS product_name_en',
   241	                'l.code AS lang_code',
   242	            )
   243	            ->join('cfp.Customer', 'c')
   244	            ->join('cfp.Product', 'p')
   245	            ->join('p.ProductClasses', 'pc')
   246	            ->join('c.Pref', 'pref')
   247	            ->leftJoin('pc.Language', 'l')
   248	            ->where('pc.sale_flg = true')
   249	            ->andWhere('c.Status = :regularStatus')
   250	            ->setParameter('regularStatus', \Eccube\Entity\Master\CustomerStatus::REGULAR)
   251	            ->groupBy('c.id, p.id, l.id, pref.id')
   252	            ->orderBy('c.id', 'ASC')
   253	            ->getQuery()
   254	            ->getResult();
   255	    }
   256	}
