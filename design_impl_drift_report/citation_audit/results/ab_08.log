   347	     *
   348	     * @return int 商品在庫ID
   349	     */
   350	    public function insertProductStock(
   351	        int $productClassId,
   352	        int $stock,
   353	        int $creatorId,
   354	        int $baseInfoId,
   355	        int $stockLocationId,
   356	        string $totalCost,
   357	        bool $pickUpFlg,
   358	    ): int {
   359	        $sql = <<<EOT
   360	INSERT INTO
   361	    dtb_product_stock
   362	(
   363	    product_class_id,
   364	    base_info_id,
   365	    creator_id,
   366	    stock,
   367	    stock_location_id,
   368	    total_cost,
   369	    pick_up_flg,
   370	    create_date,
   371	    update_date
   372	)
   373	VALUES
   374	(
   375	    ?,
   376	    ?,
   377	    ?,
   378	    ?,
   379	    ?,
   380	    ?,
   381	    ?,
   382	    ?,
   383	    ?
   384	)
   385	EOT;
   386	
   387	        $now = new \DateTime();
   388	
   389	        $connection = $this->getEntityManager()->getConnection();
   390	        $connection->executeStatement(
   391	            $sql,
   392	            [
   393	                $productClassId,
   394	                $baseInfoId,
   395	                $creatorId,
   396	                $stock,
   397	                $stockLocationId,
   398	                $totalCost,
   399	                $pickUpFlg ? 1 : 0,
   400	                $now,
   401	                $now,
   402	            ],
   403	            [
   404	                ParameterType::INTEGER,
   405	                ParameterType::INTEGER,
   406	                ParameterType::INTEGER,
   407	                ParameterType::INTEGER,
   408	                ParameterType::INTEGER,
   409	                ParameterType::STRING,
   410	                ParameterType::INTEGER,
   411	                Types::DATETIMETZ_MUTABLE,
   412	                Types::DATETIMETZ_MUTABLE,
   413	            ],
   414	        );
   415	
   416	        return (int) $connection->lastInsertId();
   417	    }
