from html.parser import HTMLParser
from pathlib import Path
VOID={'img','br','meta','link','input','hr','source','area','base','col','embed','param','track','wbr'}
keys=['M13-15','画像設定','アップロード先','バナー','店舗','ファイル','GIF','JPG','PNG','削除','URL','GET','POST','DELETE',
'カード一覧','検索','CSRF','セッション','カード名','リロード','CSV','500','マナ','リーガリティ','カラー','色','新規','編集','ルート','半角','全角','カンマ','最大','文字']
class P(HTMLParser):
 def __init__(self,wanted): super().__init__(convert_charrefs=True); self.wanted=set(wanted); self.stack=[]; self.cap=[]; self.out=[]
 def handle_starttag(self,tag,attrs):
  a=dict(attrs); active=(self.stack[-1][2] if self.stack else None)
  if tag=='section' and a.get('id') in self.wanted: active=a['id']
  embed=(self.stack[-1][3] if self.stack else False) or ('function-design-embed' in a.get('class','').split())
  self.stack.append((tag,a,active,embed))
  if active and not embed and 'src-cell' in a.get('class','').split(): self.cap.append([len(self.stack),self.getpos()[0],a.get('data-excel-ref'),[]])
  if tag in VOID: self.close(tag)
 def handle_startendtag(self,tag,attrs): self.handle_starttag(tag,attrs)
 def close(self,tag):
  ix=next((i for i in range(len(self.stack)-1,-1,-1) if self.stack[i][0]==tag),None)
  if ix is None:return
  while len(self.stack)>ix:
   if self.cap and self.cap[-1][0]==len(self.stack):
    dep,line,ref,parts=self.cap.pop(); txt=' '.join(''.join(parts).split())
    if txt:self.out.append((self.stack[-1][2],line,ref,txt))
   self.stack.pop()
 def handle_endtag(self,tag): self.close(tag)
 def handle_data(self,d):
  if self.cap:self.cap[-1][3].append(d)
for fn,ids in [('hareruya-design-docs/excel_to_html/output/0214_基本設計仕様書(イベント管理).html',['sheet-22']),('hareruya-design-docs/excel_to_html/output/0208_基本設計仕様書(カード管理).html',['sheet-3','sheet-4','sheet-6'])]:
 p=P(ids);p.feed(Path(fn).read_text()); print('\\nFILE',fn)
 for sid,line,ref,txt in p.out:
  if any(k in txt for k in keys): print(f'{sid} {line}: {ref}: {txt}')
