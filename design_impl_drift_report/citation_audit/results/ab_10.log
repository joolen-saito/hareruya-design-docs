    55	        } catch (\Throwable $e) {
    56	            try {
    57	                $order->setPointErrorMessage(json_encode(['message' => $e->getMessage()], JSON_UNESCAPED_UNICODE))
    58	                    ->setSmaregiErrorFlg(true);
    59	                $this->entityManager->persist($order);
    60	                $this->entityManager->flush();
