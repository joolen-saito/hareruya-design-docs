    39	            if (!$orderSub->getSmaregiStockFlg()) {
    40	                $processes[] = 'stock';
    41	            }
    42	            $this->app['hareruya_ec.service.smaregi']->postSmaregiProcess($orderSub, $processes);
    43	        }
    44	    }
    45	}
