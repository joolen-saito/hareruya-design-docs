   245	                    return $er->createQueryBuilder('m')
   246	                        ->orderBy('m.rank', 'ASC');
   247	                },
   248	                'multiple' => false,
   249	                'class' => 'Eccube\Entity\Member',
   250	            ])
   251	        ;
   252	    }
