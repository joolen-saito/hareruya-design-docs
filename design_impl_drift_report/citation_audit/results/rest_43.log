    78	    #[Template('@admin/Deck/index.twig')]
    79	    public function index(Request $request, PaginatorInterface $paginator, int $page_no = 1): array
    80	    {
    81	        $searchForm = $this->getForm();
    82	        $bulkUpdateForm = $this->createForm(DeckBulkUpdateType::class);
    83	
    84	        $event = new EventArgs(
    85	            [
    86	                'form' => $searchForm,
    87	            ],
    88	            $request
    89	        );
    90	        $this->eventDispatcher->dispatch($event, EccubeEvents::ADMIN_DECK_INDEX_INITIALIZE);
    91	
    92	        if ($request->isMethod('POST')) {
    93	            $searchForm->handleRequest($request);
    94	
    95	            if (!$searchForm->isValid()) {
    96	                return [
    97	                    'searchForm' => $searchForm->createView(),
    98	                    'bulkUpdateForm' => $bulkUpdateForm->createView(),
    99	                    'pagination' => null,
   100	                    'is_search_filter_active' => true,
   101	                ];
   102	            }
   103	
   104	            $page_no = 1;
   105	            $viewData = FormUtil::getViewData($searchForm);
   106	
   107	            $this->session->set($this->sessionKey, $viewData);
   108	            $this->session->set($this->sessionKey.'.page_no', $page_no);
   109	        } else {
   110	            $pageNoAttr = $request->attributes->get('page_no');
   111	            if ($request->query->getInt('resume') === Constant::ENABLED || $pageNoAttr !== null) {
   112	                if ($pageNoAttr !== null) {
   113	                    $page_no = (int) $pageNoAttr;
   114	                    $this->session->set($this->sessionKey.'.page_no', $page_no);
   115	                } else {
   116	                    $page_no = $this->session->get($this->sessionKey.'.page_no', 1);
   117	                }
   118	                $viewData = $this->session->get($this->sessionKey, []);
   119	                FormUtil::submitAndGetData($searchForm, $viewData);
   120	            } else {
   121	                $viewData = FormUtil::getViewData($searchForm);
   122	                $this->session->set($this->sessionKey, $viewData);
   123	                $this->session->set($this->sessionKey.'.page_no', 1);
   124	                $this->session->set('eccube.admin.'.$this->sessionKey.'.search.page_count', 100);
   125	
   126	                return [
   127	                    'searchForm' => $searchForm->createView(),
   128	                    'bulkUpdateForm' => $bulkUpdateForm->createView(),
   129	                    'pagination' => null,
   130	                    'is_search_filter_active' => false,
   131	                ];
   132	            }
   133	        }
   134	
   135	        $responseData = $this->search($request, null, $page_no);
   136	
   137	        $searchData = $searchForm->getData();
   138	        $responseData['sortKeys'] = $this->deckRepository->getSortKeys();
   139	        $responseData['sortKey'] = $searchData['sortKey'] ?? $this->deckRepository::DEFAULT_SORT_KEY;
   140	        $responseData['sortOrder'] = $searchData['sortOrder'] ?? $this->deckRepository::DEFAULT_SORT_ORDER;
   141	        $responseData['bulkUpdateForm'] = $bulkUpdateForm->createView();
   142	
   143	        return $responseData;
   144	    }
