   109	    /**
   110	     * 一時ファイルを削除する。
   111	     *
   112	     * @param string $tempFileName ファイル名
   113	     */
   114	    protected function deleteTempFile(string $tempFileName)
   115	    {
   116	        try {
   117	            $fs = new Filesystem();
   118	            $fs->remove($this->app['config']['csv_temp_realdir'] . '/' . $tempFileName);
   119	        } catch (\Exception $e) {
   120	            // エラーが発生しても無視する
   121	        }
   122	    }
   123	
   124	    /**
   125	     * CSVImportService を生成する。
   126	     *
   127	     * @param UploadedFile $file インポートするファイル
   128	     * @param string $tempFileName 一時ファイルの名前
   129	     * @return CsvImportService
   130	     */
   131	    protected function createCsvImportService(UploadedFile $file, string $tempFileName)
   132	    {
   133	        // アップロードされたCSVファイルを一時ディレクトリに保存
   134	        $file->move($this->app['config']['csv_temp_realdir'], $tempFileName);
   135	
   136	        $content = file_get_contents($this->app['config']['csv_temp_realdir'] . '/' . $tempFileName);
   137	
   138	        if ('\\' === DIRECTORY_SEPARATOR && PHP_VERSION_ID >= 70000) {
   139	            // Windows 環境の PHP7 の場合はファイルエンコーディングを CP932 に合わせる
   140	            // see https://github.com/EC-CUBE/ec-cube/issues/1780
   141	            setlocale(LC_ALL, ''); // 既定のロケールに設定
   142	            if (mb_detect_encoding($content) === 'UTF-8') { // UTF-8 を検出したら SJIS-win に変換
   143	                $content = mb_convert_encoding($content, 'SJIS-win', 'UTF-8');
   144	            }
   145	        } else {
   146	            // アップロードされたファイルがUTF-8以外は文字コード変換を行う
   147	            $encode = Str::characterEncoding($content);
   148	            if ($encode !== 'UTF-8') {
   149	                $content = mb_convert_encoding($content, 'UTF-8', $encode);
   150	            }
   151	        }
   152	        $content = Str::convertLineFeed($content);
   153	        $content = $this->removeZeroWidthSpaces($content);
   154	
   155	        $tmp = tmpfile();
   156	        fwrite($tmp, $content);
   157	        rewind($tmp);
   158	        $meta = stream_get_meta_data($tmp);
   159	        $splFile = new \SplFileObject($meta['uri']);
   160	
   161	        $fileExtension = $file->getClientOriginalExtension();
   162	        $delimiter = ($fileExtension === 'tsv') ? "\t" : $this->app['config']['csv_import_delimiter'];
   163	
   164	        return new CsvImportService($splFile, $delimiter, $this->app['config']['csv_import_enclosure']);
   165	    }
   166	
   167	    /**
   168	     * ゼロ幅スペース、ゼロ幅ノーブレークスペースを除外する
   169	     *
   170	     * @param string $str 処理する文字列
   171	     * @return string ゼロ幅スペース等を除去した文字列
   172	     */
   173	    protected function removeZeroWidthSpaces($str)
   174	    {
   175	        return preg_replace(
   176	            '/(?:'
   177	            .'|(?:\xe2\x80\x8b)'
   178	            .'|(?:\xef\xbb\xbf)'
   179	            .')+/',
   180	            '',
   181	            $str
   182	        );
   183	    }
   184	
   185	    /**
   186	     * 基本的なエラーをチェックする。
   187	     * @param CsvImportService $importService CSVファイル
   188	     * @return array エラーメッセージ。エラーがない場合は空。
   189	     */
   190	    protected function validateBeforeImport(CsvImportService $importService): array
   191	    {
   192	        $messageStore = new MessageStore($this->app);
   193	
   194	        // 1行目にヘッダ行がなければエラー
   195	        if (!$importService->setHeaderRowNumber(0)) {
   196	            $messageStore->addHeaderFormatError();
   197	
   198	            return $messageStore->getMessages();
   199	        }
   200	
   201	        // 2行目にデータが存在しない場合はエラー
   202	        $importService->next();
   203	        $hasData = $importService->valid();
   204	        $importService->seek(0);
   205	        if (!$hasData) {
   206	            $messageStore->addNoDataError();
   207	
   208	            return $messageStore->getMessages();
   209	        }
   210	
   211	        // エラーなし
   212	        return [];
   213	    }
   214	
   215	    /**
   216	     * 各行のデータをインポートする。
   217	     *
   218	     * @param CsvImportService $importService
   219	     * @return CsvImportResultInterface
   220	     * @throws \Exception
   221	     */
   222	    protected function importRows(CsvImportService $importService)
   223	    {
   224	        $headers = $importService->getColumnHeaders();
   225	        $this->em->getConnection()->beginTransaction();
   226	
   227	        try {
   228	            $defaultLockTimeout = SqlUtil::getLockTimeout($this->em);
   229	            SqlUtil::setLockTimeout($this->em, $this->getLockTimeout());
   230	
   231	            $messageStore = new MessageStore($this->app);
   232	            $loginUser = $this->getLoginUser();
   233	            $this->handler->onBeforeImport();
   234	
   235	            $hasBreak = false;
   236	            $importCount = 0;
   237	            foreach ($importService as $index => $row) {
   238	                $rowNumber = $index + 1;
   239	                $csvRow = new CsvRow($rowNumber, $row);
   240	                $csvRow->setHeaders($headers);
   241	                $event = new ReadCsvRowEvent($csvRow, $messageStore, $loginUser);
   242	
   243	                $this->handler->onValidateRow($event);
   244	                if ($event->isBreakAll()) {
   245	                    $hasBreak = true;
   246	                    break;
   247	                }
   248	                if ($event->isSkipRow()) {
   249	                    continue;
   250	                }
   251	
   252	                $event->clearNextAction();
   253	                $isOk = $this->handler->onReadRow($event);
   254	                if ($isOk) {
   255	                    $importCount++;
   256	                }
   257	
   258	                if ($index % $this->flushPerLines === 0) {
   259	                    $this->em->flush();
   260	                    EntityManagerUtil::clearCache($this->em);
   261	                }
   262	
   263	                if ($event->isBreakAll()) {
   264	                    $hasBreak = true;
   265	                    break;
   266	                }
   267	            }
   268	
   269	            $this->em->flush();
   270	            EntityManagerUtil::clearCache($this->em);
   271	
   272	            $isSuccessful = $messageStore->count() === 0 || !$hasBreak;
   273	            if ($isSuccessful) {
   274	                $this->em->getConnection()->commit();
   275	            } else {
   276	                $this->em->getConnection()->rollback();
   277	            }
   278	
   279	            $this->handler->onAfterImport(new AfterReadEvent($isSuccessful, $importCount));
   280	
   281	            SqlUtil::setLockTimeout($this->em, $defaultLockTimeout);
   282	
   283	            $importResult = new CsvImportResult();
   284	            $importResult->setCount($importCount)
   285	                ->setErrors($messageStore->getMessages());
   286	
   287	            return $importResult;
   288	
   289	        } catch (\Exception $e) {
   290	            try {
   291	                $this->em->getConnection()->rollback();
   292	            } catch (ConnectionException $ce) {
   293	                // 元のエラーを throws するため、ロールバック時のエラーは無視する
   294	            }
   295	
   296	            throw $e;
   297	        }
   298	    }
   299	
   300	    /**
   301	     * @return Member ログインユーザー
   302	     */
   303	    protected function getLoginUser()
   304	    {
   305	        return $this->app['security']->getToken()->getUser();
   306	    }
   307	
   308	    /**
   309	     * @return int 行ロックのタイムアウト（秒）
   310	     * @throws \LogicException タイムアウトの値が不正な場合
   311	     */
   312	    protected function getLockTimeout()
   313	    {
   314	        $lockTimeout = $this->handler->getLockTimeout();
   315	        if ($lockTimeout < self::MIN_LOCK_TIMEOUT || $lockTimeout > self::MAX_LOCK_TIMEOUT) {
   316	            throw new \LogicException(
   317	                sprintf(
   318	                    '%s の getLockTimeout() は %d 以上 %d 以下を返してください: %d',
   319	                    get_class($this->handler),
   320	                    self::MIN_LOCK_TIMEOUT,
   321	                    self::MAX_LOCK_TIMEOUT,
   322	                    $lockTimeout
   323	                )
   324	            );
   325	        }
   326	
   327	        return $lockTimeout;
   328	    }
   329	}

