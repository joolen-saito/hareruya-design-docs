    28	    /** @var int 行ロックタイムアウト（秒）の最小値 */
    29	    const MIN_LOCK_TIMEOUT = 1;
    30	
    31	    /** @var int 行ロックタイムアウト（秒）の最大値 */
    32	    const MAX_LOCK_TIMEOUT = 30;
    33	
    34	    /** @var Application $app */
