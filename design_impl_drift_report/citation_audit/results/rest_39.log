   646	     */
   647	    public function bulkEntryUpload(Application $app, Request $request)
   648	    {
   649	        // タイムアウトを無効にする
   650	        set_time_limit(0);
   651	
   652	        $headers = self::CSV_HEADER;
   653	
   654	        /** @var FormInterface $form */
   655	        $form = $app['form.factory']->createBuilder('admin_csv_import')->getForm();
   656	        $form->handleRequest($request);
   657	
   658	        if (!$this->isFormValid($app, $form)) {
   659	            foreach ($form->getErrors(true) as $error) {
   660	                $app->addError($error->getMessage(), 'admin');
   661	            }
   662	
   663	            return $this->render($app, $form, $headers, $this->importTwig);
   664	        }
   665	
   666	        /** @var UploadedFile $file */
   667	        $file = $form['import_file']->getData();
   668	
   669	        // レコード数上限チェック
   670	        if ((int)exec('wc -l '.$file) >= self::CSV_IMPORT_MAX) {
   671	            $app->addError(sprintf($app->trans('admin.csv.error.upload.maxrecord'), self::CSV_IMPORT_MAX), 'admin');
   672	
   673	            return $this->render($app, $form, $headers, $this->importTwig);
   674	        }
   675	
   676	        log_info('イベント一括登録CSV登録開始');
   677	
   678	        $importer = new CsvImporter($app, new BulkEntryImportHandler($app));
   679	        $result = $importer->import($file);
   680	
   681	        if ($result->hasError()) {
