   316	    /**
   317	     * イベントを登録する。
   318	     *
   319	     * @param ReadCsvRowEvent $event イベント
   320	     * @return int イベントID
   321	     */
   322	    private function persistEvent(ReadCsvRowEvent $readEvent)
   323	    {
   324	        /** @var DtbEventRepository $repository */
   325	        $repository = $this->app['hareruya_ec.repository.event'];
   326	
   327	        $row = $readEvent->getRow();
   328	        $event = new DtbEvent();
   329	        $eventDetail = null;
   330	
   331	        $shopRepository = $this->app['hareruya_ec.repository.shop'];
   332	        $venueRepository = $this->app['hareruya_ec.repository.venue'];
   333	        $formatRepository = $this->app['hareruya_ec.repository.format'];
   334	        $relRepository = $this->app['hareruya_ec.repository.rel'];
   335	        $dispRepository = $this->app['eccube.repository.master.disp'];
   336	        $paymentRepository = $this->em->getRepository('Eccube\Entity\Payment');
   337	
   338	        $event->setNameJp($this->nameJpColumn->getValue($row));
   339	        $event->setNameEn($this->nameEnColumn->getValue($row));
   340	        $event->setShop($shopRepository->findOneByNameJp($this->shopColumn->getValue($row)));
   341	        $event->setVenue($venueRepository->findOneByNameJp($this->venueColumn->getValue($row)));
   342	        $event->setFormats($formatRepository->findByNameJp($this->formatColumn->getValue($row)));
   343	        $event->setRel($relRepository->findOneByNameJp($this->relColumn->getValue($row)));
   344	        $event->setDisp($dispRepository->findOneByName($this->dispColumn->getValue($row)));
   345	        $event->setBannerUrl($this->bannerUrlJpColumn->getValue($row));
   346	        $event->setBannerEnUrl($this->bannerEnUrlColumn->getValue($row));
   347	        $event->setCapacity($this->capacityColumn->getValue($row));
   348	        $event->setTeamMemberCount($this->teamMemberCountColumn->getValue($row));
   349	        if ($this->paymentColumn->getValue($row) === "あり") {
   350	            $event->setPayments($paymentRepository->findById(Payment::EC_CREDIT));
   351	        }
   352	        $event->setEntryFee($this->feeColumn->getValue($row));
   353	        $event->setPrizeJp($this->prizeJpColumn->getValue($row));
   354	        $event->setPrizeEn($this->prizeEnColumn->getValue($row));
   355	        $event->setDetailJp($this->detailJpColumn->getValue($row));
   356	        $event->setDetailEn($this->detailEnColumn->getValue($row));
   357	
   358	        // 開始時間がある場合、イベント詳細も登録
   359	        if ($startDate = $this->startDateColumn->getValue($row)) {
   360	            $eventDetail = new DtbEventDetail();
   361	            $eventDetail->setStartDate(new \DateTime($startDate));
   362	            $eventDetail->setEntryFlg($this->entryFlgColumn->getValue($row) === "あり");
   363	            if ($entryStartTime = $this->entryStartTimeColumn->getValue($row)) {
   364	                $eventDetail->setEntryStartDate((new \DateTime($startDate))->modify($entryStartTime));
   365	            }
   366	            if ($entryEndTime = $this->entryEndTimeColumn->getValue($row)) {
   367	                $eventDetail->setEntryEndDate((new \DateTime($startDate))->modify($entryEndTime));
   368	            }
   369	            $eventDetail->setDeckRegistFlg($this->deckRegistFlgColumn->getValue($row) === "あり");
   370	            if ($deckRegistDeadline = $this->deckRegistDeadlineColumn->getValue($row)) {
   371	                $eventDetail->setDeckRegistDeadline(new \DateTime($deckRegistDeadline));
   372	            }
   373	            // $eventDetail->setShopId($this->onlineEntryFlgColumn->getValue($row));
   374	            if ($onlineEntryStartDate = $this->onlineEntryStartDateColumn->getValue($row)) {
   375	                $eventDetail->setOnlineEntryStartDate(new \DateTime($onlineEntryStartDate));
   376	            }
   377	            if ($onlineEntryEndDate = $this->onlineEntryEndDateColumn->getValue($row)) {
   378	                $eventDetail->setOnlineEntryEndDate(new \DateTime($onlineEntryEndDate));
   379	            }
   380	            $eventDetail->setCapacity($this->scheduleCapacityColumn->getValue($row));
   381	            $eventDetail->setEntryFee($this->scheduleEntryFeeColumn->getValue($row));
   382	            $eventDetail->setDisp($dispRepository->findOneByName($this->scheduleDispColumn->getValue($row)));
   383	            $eventDetail->setPrizeJp($this->schedulePrizeJpColumn->getValue($row));
   384	            $eventDetail->setPrizeEn($this->schedulePrizeEnColumn->getValue($row));
   385	            $eventDetail->setEvent($event);
   386	        }
   387	
   388	        $this->em->persist($event);
   389	        
   390	        if ($eventDetail) {
   391	            $this->em->persist($eventDetail);
   392	        }
   393	
   394	        return $event->getEventId();
   395	    }
   396	}

