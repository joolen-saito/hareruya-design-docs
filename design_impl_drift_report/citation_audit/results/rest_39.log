   683	
   684	            return $this->render($app, $form, $headers, $this->importTwig, $result->getErrors());
   685	        }
   686	
   687	        $app->addSuccess('admin.event.save.complete', 'admin');
   688	        log_info('イベント一括登録', ['count' => $result->getCount()]);
