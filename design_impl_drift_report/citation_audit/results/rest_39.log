    46	    /**
    47	     * @param Application $app
    48	     * @param CsvImportHandlerInterface $handler 読み込んだファイルを処理するもの
    49	     */
    50	    public function __construct($app, CsvImportHandlerInterface $handler)
    51	    {
    52	        $this->app = $app;
    53	        $this->em = $app['orm.em'];
