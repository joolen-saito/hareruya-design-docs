    24	{% extends 'default_frame.twig' %}
    25	
    26	{% set menus = ['content', 'page'] %}
    27	
    28	{% block title %}コンテンツ管理{% endblock %}
    29	{% block sub_title %}ページ管理{% endblock %}
    30	
    31	{% form_theme form 'Form/bootstrap_3_horizontal_layout.html.twig' %}
    32	
    33	{% block main %}
    34	<div class="row" id="aside_wrap">
    35	    <form role="form" name="content_page_form" id="content_page_form" method="post"
    36	          action="{%- if page_id is not null %}{{ url('admin_content_page_edit', {id: page_id}) }}{% else %}{{ url('admin_content_page_new') }}{% endif -%}">
    37	        {{ form_widget(form._token) }}
    38	        {{ form_widget(form.id) }}
    39	        {{ form_widget(form.DeviceType, { attr : { style : 'display: none;' } } ) }}
    40	            <div id="detail" class="col-md-9">
    41	                <div id="detail_box" class="box form-horizontal">
    42	                    <div id="detail_box__header" class="box-header">
    43	                        <h3 class="box-title">ページ詳細編集</h3>
    44	                    </div>
    45	                    <!-- /.box-header -->
    46	                    <div id="detail_box__body" class="box-body">
    47	
    48	                        <div id="detail_box__name" class="form-group">
    49	                            {{ form_label(form.name) }}
    50	                            <div class="col-sm-9 col-lg-10">
    51	                                {{ form_widget(form.name) }}
    52	                                {{ form_errors(form.name) }}
    53	                            </div>
    54	                        </div>
    55	                        <div id="detail_box__url" class="form-group word-break">
    56	                            {{ form_label(form.url) }}
    57	                            <div class="col-sm-9 col-lg-10 form-inline">
    58	                                {% if editable %}
    59	                                    {{ url('top') }}{{ app.config.user_data_route }}/{{ form_widget(form.url) }}
    60	                                {% else %}
    61	                                    {{ app.request.schemeAndHttpHost }}{{ app.request.basePath }}{{ app.routes.get(form.url.vars.value).path }}
    62	                                    {{ form_widget(form.url, { type : 'hidden' } ) }}
    63	                                {% endif %}
    64	                                {{ form_errors(form.url) }}
    65	                            </div>
    66	                        </div>
    67	                        <div id="detail_box__file_name" class="form-group word-break">
    68	                            {{ form_label(form.file_name) }}
    69	                            <div class="col-sm-9 col-lg-10 form-inline">
    70	                                {% if editable %}
    71	                                    {{ template_path }}/{{ form_widget(form.file_name) }}.twig
    72	                                {% else %}
    73	                                    {{ template_path }}/{{ form.file_name.vars.value }}.twig
    74	                                    {{ form_widget(form.file_name, { type : 'hidden' } ) }}
    75	                                {% endif %}
    76	                                {{ form_errors(form.file_name) }}
    77	                            </div>
    78	                        </div>
    79	
    80	                        <div id="detail_box__tpl_data" class="form-group">
    81	                            {{ form_label(form.tpl_data) }}
    82	                            <div class="col-sm-9 col-lg-10">
    83	                                {{ form_widget(form.tpl_data, { attr : { 'rows' : 15, style : 'font-size:12px' } }) }}
    84	                                {{ form_errors(form.tpl_data) }}
    85	                            </div>
    86	                        </div>
    87	
    88	                        <div class="extra-form">
    89	                            {% for f in form.getIterator %}
    90	                                {% if f.vars.name matches '[^plg*]' %}
    91	                                    {{ form_row(f) }}
    92	                                {% endif %}
    93	                            {% endfor %}
    94	                        </div>
    95	                    </div>
    96	                </div>
    97	                <div id="detail_meta_box" class="box form-horizontal">
    98	                    <div id="detail_meta_box__header" class="box-header">
    99	                        <h3 class="box-title">
   100	                            meta設定
   101	                        </h3>
   102	                    </div>
   103	                    <!-- /.box-header -->
   104	
   105	                    <div id="detail_meta_box__body" class="box-body">
   106	                        {{ form_row(form.author) }}
   107	                        {{ form_row(form.description) }}
   108	                        {{ form_row(form.keyword) }}
   109	                        {{ form_row(form.meta_robots) }}
   110	                        {{ form_row(form.meta_tags, { attr : { placeholder : '複数のmetaタグを入力可能'}}) }}
   111	                    </div>
   112	                </div>
   113	
   114	                <div id="detail_box__footer" class="row hidden-xs hidden-sm">
   115	                    <div id="detail_box__back_button" class="col-xs-10 col-xs-offset-1 col-sm-6 col-sm-offset-3 text-center btn_area">
   116	                        <p><a href="{{ url('admin_content_page') }}">戻る</a></p>
   117	                    </div>
   118	                </div>
   119	            </div>
   120	            <!-- /.col -->
   121	            <div class="col-md-3" id="aside_column">
   122	                <div id="common_box" class="col_inner">
   123	                    <div id="common_button_box" class="box no-header">
   124	                        <div id="common_button_box__body" class="box-body">
   125	                            <div id="common_button_box__insert_button" class="row text-center">
   126	                                <div class="col-sm-6 col-sm-offset-3 col-md-12 col-md-offset-0">
   127	                                    <button class="btn btn-primary btn-block btn-lg" type="submit">登録</button>
   128	                                </div>
   129	                            </div>
   130	                        </div>
   131	                        <!-- /.box-body -->
   132	                    </div>
   133	                    <!-- /.box -->
   134	                </div>
   135	            </div>
   136	            <!-- /.col -->
   137	    </form>
   138	</div>
   139	{% endblock %}
