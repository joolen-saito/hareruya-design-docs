    25	namespace Eccube\Form\Type\Admin;
    26	
    27	use Symfony\Component\Form\AbstractType;
    28	use Symfony\Component\Form\FormBuilderInterface;
    29	use Symfony\Component\Form\FormError;
    30	use Symfony\Component\Form\FormEvents;
    31	use Symfony\Component\OptionsResolver\OptionsResolverInterface;
    32	use Symfony\Component\Validator\Constraints as Assert;
    33	
    34	class MainEditType extends AbstractType
    35	{
    36	    public $app;
    37	
    38	    public function __construct(\Silex\Application $app)
    39	    {
    40	        $this->app = $app;
    41	    }
    42	
    43	    /**
    44	     * {@inheritdoc}
    45	     */
    46	    public function buildForm(FormBuilderInterface $builder, array $options)
    47	    {
    48	        $app = $this->app;
    49	
    50	        $builder
    51	            ->add('name', 'text', array(
    52	                'label' => '名称',
    53	                'required' => true,
    54	                'constraints' => array(
    55	                    new Assert\NotBlank(),
    56	                    new Assert\Length(array(
    57	                        'max' => $app['config']['stext_len'],
    58	                    ))
    59	                )
    60	            ))
    61	            ->add('url', 'text', array(
    62	                'label' => 'URL',
    63	                'required' => true,
    64	                'constraints' => array(
    65	                    new Assert\NotBlank(),
    66	                    new Assert\Length(array(
    67	                        'max' => $app['config']['stext_len'],
    68	                    )),
    69	                    new Assert\Regex(array(
    70	                        'pattern' => '/^([0-9a-zA-Z_\-]+\/?)+(?<!\/)$/',
    71	                    )),
    72	                )
    73	            ))
    74	            ->add('file_name', 'text', array(
