    24	{% extends 'default_frame.twig' %}
    25	
    26	{% set menus = ['content', 'page'] %}
    27	
    28	{% block title %}コンテンツ管理{% endblock %}
    29	{% block sub_title %}ページ管理{% endblock %}
    30	
    31	{% block main %}
    32	<div id="page_wrap" class="container-fluid">
    33	    <div id="page_list" class="row">
    34	        <div id="page_list_box" class="col-md-12">
    35	            <div id="page_list__body" class="box">
    36	                <div id="page_list_box__header" class="box-header">
    37	                    <div class="box-title">
    38	                        ページ一覧
    39	                    </div>
    40	                </div>
    41	                <div id="sortable_list_box" class="box-body no-padding no-border">
    42	                    <div id="sortable_list_box__list" class="sortable_list">
    43	                        <div class="tableish">
    44	                            <div class="item_box tr" style="background-color: #F9F9F9;">
    45	                                <div class="item_pattern td"><strong>ページ名</strong></div>
    46	                                <div class="item_pattern td"><strong>ルーティング名</strong></div>
    47	                                <div class="item_pattern td"><strong>ファイル名</strong></div>
    48	                                <div class="item_pattern td"></div>
    49	                            </div>
    50	                            {% for PageLayout in PageLayouts %}
    51	                                <div id="sortable_list_box__item--{{ PageLayout.id }}" class="item_box tr">
    52	                                    <div id="sortable_list_box__name--{{ PageLayout.id }}" class="item_pattern td">
    53	                                        {{ PageLayout.name }}
    54	                                    </div>
    55	                                    <div id="sortable_list_box__url--{{ PageLayout.id }}" class="td">
    56	                                        {{ PageLayout.url }}
    57	                                    </div>
    58	                                    <div id="sortable_list_box__file_name--{{ PageLayout.id }}" class="td">
    59	                                        {% if PageLayout.file_name %}{{ PageLayout.file_name }}.twig{% endif %}
    60	                                    </div>
    61	                                    <div id="sortable_list_box__menu_box--{{ PageLayout.id }}" class="icon_edit td">
    62	                                        <div id="sortable_list_box__menu_box_toggle--{{ PageLayout.id }}" class="dropdown">
    63	                                            <a class="dropdown-toggle" data-toggle="dropdown"><svg class="cb cb-ellipsis-h"> <use xlink:href="#cb-ellipsis-h" /></svg></a>
    64	                                            <ul id="sortable_list_box__menu--{{ PageLayout.id }}" class="dropdown-menu dropdown-menu-right">
    65	                                                <li>
    66	                                                    <a href="{{ url('admin_content_layout_edit', { id : PageLayout.id } ) }}" >レイアウト編集</a>
    67	                                                </li>
    68	                                                <li>
    69	                                                    {% if PageLayout.filename|length >= 1 %}
    70	                                                        <a href="{{ url('admin_content_page_edit', {id : PageLayout.id } ) }}">ページ編集</a>
    71	                                                    {% else %}
    72	                                                        <a>ページ編集</a>
    73	                                                    {% endif %}
    74	                                                </li>
    75	                                                <li>
    76	                                                    {% if PageLayout.edit_flg == constant('Eccube\\Entity\\PageLayout::EDIT_FLG_USER') %}
    77	                                                        <a href="{{ url('admin_content_page_delete', { 'id': PageLayout.id}) }}" {{ csrf_token_for_anchor() }} data-method="delete" data-message="このページを削除してもよろしいですか？">削除</a>
    78	                                                    {% else %}
    79	                                                        <a>削除</a>
    80	                                                    {% endif %}
    81	                                                </li>
    82	                                            </ul>
    83	                                        </div>
    84	                                    </div>
    85	                                </div><!-- /.item_box -->
    86	                            {% endfor %}
    87	
    88	                        </div>
    89	                    </div>
    90	                </div><!-- /.box-body -->
    91	            </div><!-- /.box -->
    92	            <!-- ▲ データがある時 ▲ -->
    93	        </div><!-- /.col -->
    94	
    95	        <div id="page_list__footer" class="row btn_area2">
    96	            <div id="page_list__insert_button" class="col-xs-10 col-xs-offset-1 col-sm-6 col-sm-offset-3 text-center">
    97	                <a class="btn btn-primary btn-block btn-lg" href="{{ url('admin_content_page_new')}}">新規入力</a>
    98	            </div>
    99	        </div>
   100	
   101	    </div>
   102	</div>
   103	{% endblock %}
