   280	
   281	            $adapter = $this->fileManager->getAdapter();
   282	            $contentBucketOptions = $this->fileManager->getContentBucketOptions();
   283	            foreach ($filesToDelete as $twigFile) {
   284	                if ($adapter->exists($this::BLOCK_PATH.$twigFile, $contentBucketOptions)) {
   285	                    $adapter->delete($this::BLOCK_PATH.$twigFile, $contentBucketOptions);
   286	                } else {
