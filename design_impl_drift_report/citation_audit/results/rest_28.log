    54	
    55	    /**
    56	     * src/Eccube/Resource/template/default
    57	     *
    58	     * @return string
    59	     */
    60	    private function srcTemplateDir()
    61	    {
    62	        return $this->app['config']['template_default_realdir'];
    63	    }
    64	
    65	    /**
    66	     * app/Plugin/HareruyaEc/Resource/template/default
    67	     *
    68	     * @return string
    69	     */
    70	    private function pluginTemplateDir()
    71	    {
    72	        return $this->app['config']['plugin_realdir'].'/HareruyaEc/Resource/template/default';
    73	    }
    74	
    75	    /**
    76	     * データが初期投入されたものか
    77	     *
    78	     * @return boolean
    79	     */
    80	    private function resourceIsDefaultData()
    81	    {
    82	        return $this->resource->getEditFlg() === PageLayout::EDIT_FLG_DEFAULT;
    83	    }
    84	
    85	    /**
    86	     * 書き込み先パスを返す
    87	     *
    88	     * @return string
    89	     */
    90	    private function writePath()
    91	    {
    92	        return $this->resourceIsDefaultData() ? $this->appTemplateDir() : $this->userDataDir();
    93	    }
    94	
    95	    /**
    96	     * 初期化完了イベントを発行する
    97	     *
    98	     * @param Eccube\Event\EventArgs $args
    99	     */
   100	    private function dispatchInitializedEvent(EventArgs $args)
   101	    {
   102	        $this->dispatchEvent(
   103	            EccubeEvents::ADMIN_CONTENT_PAGE_EDIT_INITIALIZE,
   104	            $args
   105	        );
   106	    }
   107	
   108	    /**
   109	     * 編集完了イベントに受け渡す値を作成して返す
   110	     *
   111	     * @override from ContentController
   112	     * @return Eccube\Event\EventArgs
   113	     */
   114	    protected function createEditCompleteEventArgs(array $args = [])
   115	    {
   116	        return parent::createEditCompleteEventArgs([
   117	            'templatePath' => $this->writePath(),
   118	            'filePath' => $this->writePath(). '/' .$this->resource->getFileName().'.twig',
   119	        ]);
   120	    }
   121	
   122	    /**
   123	     * 編集完了イベントを発行する
   124	     *
   125	     * @param Eccube\Event\EventArgs $args
   126	     */
   127	    private function dispatchEditCompleteEvent(EventArgs $args)
   128	    {
   129	        $this->dispatchEvent(
   130	            EccubeEvents::ADMIN_CONTENT_PAGE_EDIT_COMPLETE,
   131	            $args
   132	        );
   133	    }
   134	
   135	    /**
   136	     * ファイルを読み込んでその内容を返す
   137	     *
   138	     * @override from ContentController
   139	     * @param array $paths
   140	     * @return string
   141	     */
   142	    protected function getFileContent(array $paths = [])
   143	    {
   144	        $paths = $this->resourceIsDefaultData() ?
   145	            [
   146	                $this->appTemplateDir(),
   147	                $this->pluginTemplateDir(),
   148	                $this->srcTemplateDir()
   149	            ] :
   150	            [
   151	                $this->userDataDir()
   152	            ];
   153	
   154	        return parent::getFileContent($paths);
   155	    }
   156	
   157	    /**
   158	     * フォームの内容に基づいてレコード情報を更新する
   159	     *
   160	     * @override from ContentController
   161	     */
   162	    protected function updateResourceFromFormContent()
   163	    {
   164	        parent::updateResourceFromFormContent();
   165	
   166	        if (!$this->resource->getEditFlg()) {
   167	            $this->resource
   168	                ->setUrl($this->cachedResource->getUrl())
   169	                ->setFileName($this->cachedResource->getFileName());
   170	        }
   171	    }
   172	
   173	    /**
   174	     * ファイルを保存する
   175	     * リネームされた場合は元のファイルを削除する
   176	     *
   177	     * @override from ContentController
   178	     * @param string $templateDir
   179	     */
   180	    protected function saveFile($templateDir = '')
   181	    {
   182	        parent::saveFile($this->writePath());
   183	    }
   184	
   185	    /**
   186	     * フォーム(新規作成 or 編集)画面をレンダリングする
   187	     *
   188	     * @override from ContentController
   189	     * @param array $args
   190	     * @return Symfony\Component\HttpFoundation\Response
   191	     */
   192	    protected function renderForm(array $args = [])
   193	    {
   194	        return parent::renderForm([
   195	            'editable' => !$this->resourceIsDefaultData(),
   196	            'template_path' => $this->writePath(),
   197	        ]);
   198	    }
   199	
   200	    /**
   201	     * 新規作成画面を表示する
   202	     *
   203	     * @override from ContentController
   204	     * @param Eccube\Application $app
   205	     * @param Symfony\Component\HttpFoundation\Request $request
   206	     * @return Symfony\Component\HttpFoundation\Response
   207	     */
   208	    public function new_(Application $app, Request $request)
   209	    {
   210	        $this->initialize($app, $request);
   211	        $this->setContentToForm();
   212	
   213	        $initEventArgs = $this->createInitializedEventArgs();
   214	        $this->dispatchInitializedEvent($initEventArgs);
   215	
   216	        return $this->renderForm();
   217	    }
   218	
   219	    /**
   220	     * 該当IDレコードの編集画面を表示する
   221	     *
   222	     * @override from ContentController
   223	     * @param Eccube\Application $app
   224	     * @param Symfony\Component\HttpFoundation\Request $request
   225	     * @param string $id
   226	     * @return Symfony\Component\HttpFoundation\Response
   227	     */
   228	    public function edit(Application $app, Request $request, $id)
   229	    {
   230	        $this->initialize($app, $request, $id);
   231	
   232	        $this->setContentToForm();
   233	
   234	        $initEventArgs = $this->createInitializedEventArgs();
   235	        $this->dispatchInitializedEvent($initEventArgs);
   236	
   237	        return $this->renderForm();
   238	    }
   239	
   240	    /**
   241	     * 新規レコードを作成する
   242	     *
   243	     * @override from ContentController
   244	     * @param Eccube\Application $app
   245	     * @param Symfony\Component\HttpFoundation\Request $request
   246	     * @return Symfony\Component\HttpFoundation\Response
   247	     */
   248	    public function create(Application $app, Request $request)
   249	    {
   250	        $this->initialize($app, $request);
   251	        $this->setContentToForm();
   252	
   253	        $initEventArgs = $this->createInitializedEventArgs();
   254	        $this->dispatchInitializedEvent($initEventArgs);
   255	
   256	        $this->setRequestParamertersToForm();
   257	
   258	        if (!$this->formContentIsValid()) {
   259	            return $this->renderForm();
   260	        }
   261	
   262	        $this->updateResourceFromFormContent();
   263	        $this->saveResourse();
   264	
   265	        $this->saveFile();
   266	        $this->clearCache();
   267	
   268	        $completeEventArgs = $this->createEditCompleteEventArgs();
   269	        $this->dispatchEditCompleteEvent($completeEventArgs);
   270	
   271	        $this->addSuccessMessage();
   272	
   273	        return $this->redirectToEditForm();
   274	    }
   275	
   276	    /**
   277	     * 該当IDのレコードを更新する
   278	     *
   279	     * @override from ContentController
   280	     * @param Eccube\Application $app
   281	     * @param Symfony\Component\HttpFoundation\Request $request
   282	     * @param string $id
   283	     * @return Symfony\Component\HttpFoundation\Response
   284	     */
   285	    public function update(Application $app, Request $request, $id)
   286	    {
   287	        $this->initialize($app, $request, $id);
   288	
   289	        $this->setContentToForm();
   290	
   291	        $initEventArgs = $this->createInitializedEventArgs();
   292	        $this->dispatchInitializedEvent($initEventArgs);
   293	
   294	        $this->setRequestParamertersToForm();
   295	
   296	        if (!$this->formContentIsValid()) {
   297	            return $this->renderForm();
   298	        }
   299	
   300	        $this->updateResourceFromFormContent();
   301	        $this->saveResourse();
   302	
   303	        if (!$this->resourceIsDefaultData()) {
   304	            $this->saveFile();
   305	        }
   306	
   307	        $this->clearCache();
   308	
   309	        $completeEventArgs = $this->createEditCompleteEventArgs();
   310	        $this->dispatchEditCompleteEvent($completeEventArgs);
   311	
   312	        $this->addSuccessMessage();
   313	
   314	        return $this->redirectToEditForm();
   315	    }
   316	}
