     3	namespace Plugin\HareruyaEc\Controller\Admin;
     4	
     5	use Eccube\Application;
     6	use Symfony\Component\HttpFoundation\Request;
     7	
     8	class DiscountController
     9	{
    10	    /**
    11	     * 割引率一覧
    12	     * @param Application $app
    13	     * @param Request $request
    14	     * @return \Symfony\Component\HttpFoundation\Response
    15	     */
    16	    public function index(Application $app, Request $request)
    17	    {
    18	        $cardConditions = $app['hareruya_ec.repository.card_condition']->findAll();
    19	        $discounts = $app['hareruya_ec.repository.discount']->findAll();
    20	        $discountCardConditions = $app['hareruya_ec.repository.discount_card_condition']->findAll();
    21	
    22	        $discountMap = [];
    23	        foreach ($discountCardConditions as $dcc) {
    24	            $discountMap[$dcc->getCardConditionId()][$dcc->getDiscountId()] = $dcc->getRate();
    25	        }
    26	
    27	        return $app->render('HareruyaEc/Resource/template/admin/Discount/discount.twig', [
    28	            'cardConditions' => $cardConditions,
    29	            'discounts' => $discounts,
    30	            'discountMap' => $discountMap,
    31	        ]);
    32	    }
    33	}
