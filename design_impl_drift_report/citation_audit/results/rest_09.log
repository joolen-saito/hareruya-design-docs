   103	    public function onValidateRow(ReadCsvRowEvent $event): void
   104	    {
   105	        parent::onValidateRow($event);
   106	        if ($event->isBreakAll() || $event->isSkipRow()) {
   107	            return;
   108	        }
   109	
   110	        $row = $event->getRow();
   111	        $idRaw = trim((string) $row->getValue('ID'));
   112	        if ($idRaw === '') {
   113	            return;
   114	        }
   115	
   116	        $messageStore = $event->getMessageStore();
   117	        $rowNumber = $row->getRowNumber();
   118	        $idLabel = $this->idColumn->getLabel();
   119	
   120	        if (!SqlUtil::isNumericParam($idRaw)) {
   121	            $messageStore->addNumericError($rowNumber, $idLabel);
   122	            $event->breakAll();
   123	
   124	            return;
   125	        }
   126	
   127	        $id = (int) $idRaw;
   128	        if ($this->sectionRepository->find($id) === null) {
   129	            $messageStore->addMasterNotExistsError($rowNumber, $idLabel, $idRaw);
   130	            $event->breakAll();
   131	        }
   132	    }
