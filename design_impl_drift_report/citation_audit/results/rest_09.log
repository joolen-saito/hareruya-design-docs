    22	use Eccube\Message\SmaregiSectionUpsertMessage;
    23	use Psr\Log\LoggerInterface;
    24	use Symfony\Component\Messenger\MessageBusInterface;
    25	
    26	class SmaregiSectionEventService
    27	{
    28	    public function __construct(
    29	        private readonly MessageBusInterface $messageBus,
    30	        private readonly EntityManagerInterface $entityManager,
    31	        private readonly LoggerInterface $logger,
    32	    ) {
    33	    }
    34	
    35	    public function dispatchUpsert(MtbSection $section): void
    36	    {
    37	        $job = new MessengerJob();
    38	        $job->setMessageClass(SmaregiSectionUpsertMessage::class);
    39	        $job->setStatus(MessengerJob::STATUS_PENDING);
    40	        $job->setPayloadSummary(sprintf(
    41	            'sectionId=%d name=%s code=%s',
    42	            $section->getId(),
    43	            $section->getName(),
    44	            $section->getCode(),
    45	        ));
    46	        $this->entityManager->persist($job);
    47	        $this->entityManager->flush();
    48	
    49	        try {
    50	            $this->messageBus->dispatch(new SmaregiSectionUpsertMessage(
    51	                $section->getId(),
    52	                $section->getName(),
    53	                $section->getCode(),
    54	                (int) $job->getId(),
    55	            ));
    56	        } catch (\Throwable $e) {
    57	            try {
    58	                $job->setStatus(MessengerJob::STATUS_FAILED);
    59	                $job->setCompletedAt(new \DateTime());
    60	                $job->setErrorMessage('メッセージバスへの投入に失敗しました: '.$e->getMessage());
    61	                $this->entityManager->flush();
    62	            } catch (\Throwable $persistError) {
    63	                $this->logger->error('Failed to persist Smaregi section upsert job failure state', [
    64	                    'jobId' => $job->getId(),
    65	                    'sectionId' => $section->getId(),
    66	                    'error' => $persistError->getMessage(),
    67	                ]);
    68	            }
    69	            $this->logger->error('Smaregi section upsert message dispatch failed', [
    70	                'exception' => $e,
    71	                'jobId' => $job->getId(),
    72	                'sectionId' => $section->getId(),
    73	            ]);
    74	
    75	            throw $e;
    76	        }
    77	    }
    78	
    79	    /**
    80	     * 部門削除と同一DBトランザクションで、スマレジ部門削除の連携ジョブを登録（flush は呼び出し側）
    81	     *
    82	     * 削除後はMtbSectionが存在しないため、スマレジ部門ID(categoryId)を保持して削除する。
    83	     * smaregi_category_idが無い（未連携）場合は呼び出し側で本メソッドを呼ばない想定。
    84	     */
    85	    public function registerDeleteJob(string $smaregiCategoryId): MessengerJob
    86	    {
    87	        $job = new MessengerJob();
    88	        $job->setMessageClass(SmaregiSectionDeleteMessage::class);
    89	        $job->setStatus(MessengerJob::STATUS_PENDING);
    90	        $job->setPayloadSummary(sprintf('smaregiCategoryId=%s', $smaregiCategoryId));
    91	        $this->entityManager->persist($job);
    92	
    93	        return $job;
    94	    }
    95	
    96	    /**
    97	     * registerDeleteJob の flush / commit 成功後にのみ呼ぶ。
    98	     * メッセージバス投入に失敗しても例外は投げず、ジョブを FAILED にしてログする（EC 側処理は既に確定している想定）。
    99	     */
   100	    public function dispatchDeleteMessage(MessengerJob $job, string $smaregiCategoryId): void
   101	    {
   102	        $jobId = (int) $job->getId();
   103	        if ($jobId < 1) {
   104	            $this->logger->error('Smaregi section delete job has no id; cannot dispatch message bus.', [
   105	                'smaregiCategoryId' => $smaregiCategoryId,
   106	            ]);
   107	
   108	            return;
   109	        }
   110	
   111	        try {
   112	            $this->messageBus->dispatch(new SmaregiSectionDeleteMessage($smaregiCategoryId, $jobId));
   113	        } catch (\Throwable $e) {
   114	            try {
   115	                $managed = $this->entityManager->find(MessengerJob::class, $jobId);
   116	                if ($managed instanceof MessengerJob) {
   117	                    $managed->setStatus(MessengerJob::STATUS_FAILED);
   118	                    $managed->setCompletedAt(new \DateTime());
   119	                    $managed->setErrorMessage('メッセージバスへの投入に失敗しました: '.$e->getMessage());
   120	                    $this->entityManager->flush();
   121	                }
   122	            } catch (\Throwable $persistError) {
   123	                $this->logger->error('Failed to persist Smaregi section delete job failure state', [
   124	                    'jobId' => $jobId,
   125	                    'smaregiCategoryId' => $smaregiCategoryId,
   126	                    'error' => $persistError->getMessage(),
   127	                ]);
   128	            }
   129	            $this->logger->error('Smaregi section delete message dispatch failed', [
   130	                'exception' => $e,
   131	                'jobId' => $jobId,
   132	                'smaregiCategoryId' => $smaregiCategoryId,
   133	            ]);
   134	        }
   135	    }
   136	}
