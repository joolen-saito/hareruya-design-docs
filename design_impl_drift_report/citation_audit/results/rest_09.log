   142	        $visible = $visibleRaw === '1';
   143	
   144	        $em = $this->sectionRepository->getEntityManager();
   145	
   146	        if ($idRaw === '') {
   147	            $Section = new MtbSection();
   148	            $Section->setName($name);
   149	            $Section->setCode($code);
   150	            $Section->setTaxFreeDivision($taxFree);
   151	            $Section->setVisible($visible);
   152	            $em->persist($Section);
   153	        } else {
   154	            $Section = $this->sectionRepository->find((int) $idRaw);
   155	            \assert($Section instanceof MtbSection);
   156	            $Section->setName($name);
   157	            $Section->setCode($code);
   158	            $Section->setTaxFreeDivision($taxFree);
   159	            $Section->setVisible($visible);
   160	        }
   161	
   162	        $this->sectionsForSmaregi[] = $Section;
