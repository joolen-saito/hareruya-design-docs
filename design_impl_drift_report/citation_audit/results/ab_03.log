    64	                $app, $transactionHead['customerId'], $transactionHead['newPoint'], $transactionHead['spendPoint'], $transactionHead['transactionHeadId']
    65	            );
    66	            foreach ($transactionDetail['rows'] as $rows) {
    67	                if (substr($rows['productCode'], 3, 3) === $smaregiStoreId) {
    68	                    $updateCount += $this->updateSmaregiStatusToDeliv($app, $rows['productCode']);
    69	                } else {
    70	                    // スマレジコードが支店のものの場合は記録し、まとめて転送する
    71	                    $branchTransactionRows[] = $rows;
    72	                }
    73	            }
    74	        }
    75	
