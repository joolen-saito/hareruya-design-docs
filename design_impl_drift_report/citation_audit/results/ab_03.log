     9	use Symfony\Component\HttpFoundation\Request;
    10	use Symfony\Component\HttpFoundation\Response;
    11	use App\Entity\DtbOtcBuyOrder;
    12	use App\Controller\BaseController;
    13	
    14	class OtcBuyOrderFreeCommentController extends BaseController
    15	{
    16	    /**
    17	     * Update free comment
    18	     */
    19	    public function putAction(Request $request, int $id) : Response
    20	    {
    21	        $this->authAdminToken($request);
    22	
    23	        $otcBuyOrder = $this->getDoctrine()
    24	            ->getRepository(DtbOtcBuyOrder::class)
    25	            ->findOneBy(['otcBuyOrderId' => $id]);
    26	
    27	        if (empty($otcBuyOrder)) {
    28	            throw new NotFoundHttpException();
    29	        }
    30	
    31	        if (is_null($request->get('free_comment'))) {
    32	            $view = View::create([
    33	                'code' => Response::HTTP_BAD_REQUEST,
    34	                'errors' => ['コメントを入力してください'],
    35	            ], Response::HTTP_BAD_REQUEST);
    36	
    37	            return $this->get('fos_rest.view_handler')->handle($view);
    38	        }
    39	
    40	        $em = $this->getDoctrine()->getManager();
    41	        $otcBuyOrder
    42	            ->setFreeComment($request->get('free_comment'))
    43	            ->setMember($this->member);
    44	        $em->flush();
    45	        $em->persist($otcBuyOrder);
    46	
    47	        $view = View::create([
    48	            "code" => Response::HTTP_OK,
    49	        ], Response::HTTP_OK);
    50	
    51	        return $this->get('fos_rest.view_handler')->handle($view);
    52	    }
    53	}

