   111	        return $app->json($response, 200, [
   112	            'Content-Type' => 'application/json;charset=UTF-8',
   113	            'Cache-Control' => 'no-store',
   114	            'Pragma' => 'no-cache',
   115	            'Access-Control-Allow-Origin' => '*',
   116	        ]);
   117	    }
