    57	        } elseif ((int)$transactionHead['disposeDivision'] === self::IS_DISPOSE) {
    58	            // 打消レコードの場合はnewPoint,spendPointともに負の値を持つので正負を反転させる
    59	            $updateCount += $this->cancelCustomerPoint(
