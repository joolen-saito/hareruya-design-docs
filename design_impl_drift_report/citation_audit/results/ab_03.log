    80	            $header = [
    81	                "X_contract_id: {$rqHeaders['X_contract_id']}",
    82	                "X_access_token: {$rqHeaders['X_access_token']}",
    83	                'Content-Type: application/x-www-form-urlencoded;charset=UTF-8',
    84	            ];
    85	
    86	            $transactionDetail['rows'] = $branchTransactionRows;
    87	            $branchTransactionParams = [
    88	                    'data' => [
    89	                        $transactionDetail
    90	                    ]
    91	            ];
    92	
    93	            $result = $this->cURLForwardBranchSmaregi($app, $header, $rqPost['proc_name'], json_encode($branchTransactionParams));
    94	
    95	            if (isset($result['result'])) {
    96	                $updateCount += $result['result']['TransactionHead'];
    97	            } else {
    98	                log_info('スマレジ通知支店転送エラー：');
    99	                log_info($result);
   100	            }
   101	        }
   102	
   103	        $response = [
   104	            'result' => [
   105	                [
   106	                    'TransactionHead' => $updateCount
   107	                ]
   108	            ]
   109	        ];
