    15	     *
    16	     * @param Application $app
    17	     * @param Request $request
    18	     * @return \Symfony\Component\HttpFoundation\Response
    19	     */
    20	    public function index(Application $app, Request $request)
    21	    {
    22	        $options = $app['hareruya_ec.repository.option']->findAll();
    23	        $settings = array_reduce($options, function ($carray, $option) {
    24	            $carray[$option->getOptionKey()] = $option->getOptionValue();
    25	
    26	            return $carray;
    27	        }, []);
    28	
    29	        $form = $app['form.factory']->createBuilder('hareruyaec_config', null, ['settings' => $settings])->getForm();
    30	
    31	        return $app->render('HareruyaEc/Resource/template/admin/config.twig', [
    32	            'forms' => $form->createView(),
    33	        ]);
    34	    }
    35	
    36	    /**
    37	     * 設定更新
    38	     *
    39	     * @param Application $app
    40	     * @param Request $request
    41	     * @return \Symfony\Component\HttpFoundation\Response
    42	     */
    43	    public function update(Application $app, Request $request)
    44	    {
    45	        $options = $app['hareruya_ec.repository.option']->findAll();
    46	        $form = $app['form.factory']->createBuilder('hareruyaec_config')->getForm()->handleRequest($request);
    47	
    48	        if (!$this->isFormValid($app, $form)) {
    49	            return $app->render('HareruyaEc/Resource/template/admin/config.twig', [
    50	                'forms' => $form->createView(),
    51	            ]);
    52	        }
    53	
    54	        foreach ($options as $option) {
    55	            $keyName = $option->getOptionKey();
    56	            if (array_key_exists($keyName, $form->getData()) && (string)$form->getData()[$keyName] !== (string)$option->getOptionValue()) {
    57	                $option->setOptionValue($form->getData()[$keyName])
    58	                    ->setMemberId($app['security']->getToken()->getUser()->getId());
    59	                $app['orm.em']->persist($option);
    60	            }
    61	        }
    62	
    63	        $app['orm.em']->flush();
    64	        $app->addSuccess('admin.register.complete', 'admin');
    65	
    66	        return $app->redirect($app->url('plugin_HareruyaEc_config'));
    67	    }
