    49	        if ('POST' === $request->getMethod()) {
    50	            if ($form->isValid()) {
    51	                if (!is_null($previous_password) && $Member->getPassword() === $app['config']['default_password']) {
    52	                    // 編集時にパスワードを変更していなければ変更前のパスワード(暗号化済み)をセット
    53	                    $Member->setPassword($previous_password);
    54	                } else {
    55	                    $salt = $Member->getSalt();
    56	                    if (!isset($salt)) {
    57	                        $salt = $app['eccube.repository.member']->createSalt(5);
    58	                        $Member->setSalt($salt);
    59	                    }
    60	
    61	                    // 入力されたパスワードを暗号化してセット
    62	                    $password = $app['eccube.repository.member']->encryptPassword($Member);
    63	                    $Member->setPassword($password);
    64	                }
    65	
    66	                $status = $app['eccube.repository.member']->save($Member);
    67	
    68	                if ($status) {
    69	                    if (!is_null($form['Shop']->getData())) {
    70	                        $dtbMemberSub->setShopId($form['Shop']->getData()->getId());
    71	                    } else {
    72	                        $dtbMemberSub->setShopId(null);
    73	                    }
    74	                    if ($form['smaregiMemberFlg']->getData() && $this->isExistSmaregiMember($app, $Member->getId())) {
    75	                        $app->addError('admin.member.save.exist_smaregi_member_error', 'admin');
    76	
    77	                        return $app->redirect($app->url('admin_setting_system_member_edit', ['id' => $Member->getId()]));
    78	                    }
    79	                    
    80	                    $dtbMemberSub->setMember($Member)
    81	                        ->setSmaregiMemberFlg($form['smaregiMemberFlg']->getData());
    82	                    $app['orm.em']->persist($dtbMemberSub);
    83	                    $app['orm.em']->flush();
    84	
    85	                    $event = new EventArgs([
    86	                        'form' => $form,
    87	                        'Member' => $Member,
    88	                    ], $request);
    89	                    $app['eccube.event.dispatcher']->dispatch(EccubeEvents::ADMIN_SETTING_SYSTEM_MEMBER_EDIT_COMPLETE, $event);
    90	                    $app->addSuccess('admin.member.save.complete', 'admin');
    91	
    92	                    return $app->redirect($app->url('admin_setting_system_member_edit', ['id' => $Member->getId()]));
    93	
    94	                } else {
    95	                    $app->addError('admin.member.save.error', 'admin');
    96	                }
    97	            }
    98	        }
    99	
   100	        $app['security']->getToken()->setUser($LoginMember);
   101	
   102	        return $app->render('Member/member_edit.twig', [
