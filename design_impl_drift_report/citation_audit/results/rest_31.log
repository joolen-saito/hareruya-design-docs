    16	class CsvController extends \Eccube\Controller\Admin\Setting\Shop\CsvController
    17	{
    18	    use FormValidHelper;
    19	
    20	    private $csvExtension;
    21	    private $csvType;
    22	
    23	    /**
    24	     * csvExtensionの新規作成・更新
    25	     * @param Application $app
    26	     * @param Request $request
    27	     * @param int $id
    28	     * @param int $extensionId
    29	     * @return \Symfony\Component\HttpFoundation\Response
    30	     */
    31	    public function custom(Application $app, Request $request, $id = CsvType::CSV_TYPE_PRODUCT, $extensionId = null)
    32	    {
    33	        // とりあえず、idは1固定(商品CSVのみ)
    34	        // $id = CsvType::CSV_TYPE_PRODUCT;
    35	        $form = $this->getForm($app, $request, $id, $extensionId);
    36	
    37	        return $app->render('HareruyaEc/Resource/template/admin/Setting/Shop/custom_csv.twig', [
    38	            'form' => $form->createView(),
    39	            'id' => $id,
    40	            'extensionId' => $this->csvExtension->getCsvExtensionId(),
    41	        ]);
    42	    }
    43	
    44	    /**
    45	     * csvExtensionの新規作成・更新　実行
    46	     * @param Application $app
    47	     * @param Request $request
    48	     * @param int $id
    49	     * @param int $extensionId
    50	     * @return \Symfony\Component\HttpFoundation\Response
    51	     */
    52	    public function customUpdate(Application $app, Request $request, $id = CsvType::CSV_TYPE_PRODUCT, $extensionId = null)
    53	    {
    54	        $form = $this->getForm($app, $request, $id, $extensionId);
    55	        $data = $request->get('admin_custom_csv');
    56	        $name = $data['name'];
    57	        $this->csvExtension->setCsvType($this->csvType)
    58	            ->setName($name)
    59	            ->setMemberId($app['security']->getToken()->getUser()->getId());
    60	        $app['orm.em']->persist($this->csvExtension);
    61	        $app['orm.em']->flush();
    62	
    63	        // 設定済の「CSV出力する項目」を削除
    64	        if ($extensionId) {
    65	            $csvCsvExtension = $app['hareruya_ec.repository.csv_csv_extension']->findByCsvExtensionId($extensionId);
    66	            if ($csvCsvExtension) {
    67	                $app['hareruya_ec.repository.csv_csv_extension']->deleteByCsvExtensionId($extensionId);
    68	            }
    69	        } else {
    70	            $extensionId = $this->csvExtension->getCsvExtensionId();
    71	        }
    72	
    73	        // 設定された順番通りにDtbCsvCsvExtensionへ登録
    74	        $csvIds = isset($data['csv_output']) ? $data['csv_output'] : [];
    75	        $csvs = [];
    76	        foreach ($app['eccube.repository.csv']->findById($csvIds) as $csv) {
    77	            $csvs[$csv->getId()] = $csv;
    78	        }
    79	        foreach ($csvIds as $key => $value) {
    80	            $csvCsvExtension = new DtbCsvCsvExtension();
    81	            $csvCsvExtension
    82	                ->setCsvExtensionId($extensionId)
    83	                ->setCsvExtension($this->csvExtension)
    84	                ->setCsvId($value)
    85	                ->setCsv($csvs[$value])
    86	                ->setRank($key);
    87	            $app['orm.em']->persist($csvCsvExtension);
    88	        }
    89	
    90	        $app['orm.em']->flush();
    91	        $app->addSuccess('admin.shop.csv.save.complete', 'admin');
    92	
    93	        return $app->redirect($app->url('admin_setting_shop_csv_custom', ['id' => $id, 'extensionId' => $extensionId]));
    94	    }
    95	
    96	    /**
    97	     * csvExtensionの削除
    98	     * @param Application $app
    99	     * @param Request $request
   100	     * @param int $extensionId
   101	     * @return \Symfony\Component\HttpFoundation\Response
   102	     */
   103	    public function customDelete(Application $app, Request $request, $extensionId = null)
   104	    {
   105	        $this->checkCsrfValid($app);
   106	
   107	        if (is_null($extensionId) || !$csvExtension = $app['hareruya_ec.repository.csv_extension']->find($extensionId)) {
   108	            return $app->abort(404);
   109	        }
   110	
   111	        $csvExtension->setCsvs(null);
   112	        $app['orm.em']->persist($csvExtension);
   113	        $app['orm.em']->flush();
   114	        $app['orm.em']->remove($csvExtension);
   115	        $app['orm.em']->flush();
   116	
   117	        return $app->redirect($app->url('admin_setting_shop_csv_custom'));
   118	    }
   119	
   120	    /**
   121	     * フォームの取得&パラメータチェック
   122	     * @param Application $app
   123	     * @param Request $request
   124	     * @param int $id
   125	     * @param int $extensionId
   126	     * @return \Symfony\Component\HttpFoundation\Response
   127	     */
   128	    private function getForm(Application $app, Request $request, $id, $extensionId)
   129	    {
   130	        $this->csvType = $app['eccube.repository.master.csv_type']->find($id);
   131	        if (is_null($this->csvType)) {
   132	            throw new NotFoundHttpException();
   133	        }
   134	
   135	        $this->csvExtension = !is_null($extensionId) ? $app['hareruya_ec.repository.csv_extension']->find($extensionId) : new DtbCsvExtension();
   136	        if (is_null($this->csvExtension)) {
   137	            throw new NotFoundHttpException();
   138	        }
   139	
   140	        $form = $app['form.factory']
   141	            ->createBuilder('admin_custom_csv', null, [
   142	                'csvType' => $this->csvType,
   143	                'csvExtension' => $this->csvExtension
   144	            ])
   145	            ->getForm();
   146	
   147	        return $form;
   148	    }
   149	}
