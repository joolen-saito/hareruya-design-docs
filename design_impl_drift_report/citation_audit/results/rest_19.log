   285	            $key = array_search($order->getId(), $ids, true);
   286	            if($key === false) {
   287	                continue;
   288	            }
   289	            unset($invalidIds[$key]);
   290	        }
   291	        foreach ($invalidIds as $invalidId) {
   292	            $app->addError(sprintf($app->trans('admin.order.mail_all.error.missing'), $invalidId), 'admin');
