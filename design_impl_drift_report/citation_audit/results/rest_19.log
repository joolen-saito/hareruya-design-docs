   146	     * @param MailTemplate $template
   147	     * @param String $body
   148	     * @param array $content
   149	     */
   150	    public function sendManualMailForBulk($data, $template, $body, $content)
   151	    {
   152	        $message = \Swift_Message::newInstance()
   153	            ->setSubject($content['mail']['subject'])
   154	            ->setFrom([$this->baseInfo->getEmail01() => $this->baseInfo->getShopName()])
   155	            ->setTo([$data->getEmail()])
   156	            ->setBcc($this->baseInfo->getEmail01())
   157	            ->setReplyTo($this->baseInfo->getEmail03())
   158	            ->setReturnPath($this->baseInfo->getEmail04())
   159	            ->setBody($body);
   160	
   161	        MailUtil::convertMessage($this->app, $message);
   162	        MailUtil::setParameterForCharset($this->app, $message);
   163	
   164	        $this->app->mail($message);
   165	        $this->saveUserMailHistory($message, $template, $data);
   166	
   167	        return;
   168	    }
