   296	        if ($templateId) {
   297	            $mail = $this->getManualMailTemplate($app, $templateId);
   298	
   299	            $app['twig.loader']->addLoader(new \Twig_Loader_Filesystem([__DIR__.'/../../../Resource/template/default']));
   300	            $templateBody = $app['twig']->getLoader()->getSourceContext($mail->getFileName())->getCode();
   301	            $templateBody = $app['hareruya_ec.service.mail']->replaceBody($templateBody, $mail);
   302	        }
   303	
   304	        $form = $app['form.factory']
   305	            ->createBuilder('mail', $mail, ['autoMail' => false, 'baseFiles' => [MailTemplate::BASE_SELL_ORDER, MailTemplate::BASE_SELL_ORDER_EN]])
   306	            ->getForm();
   307	        $form['template']->setData($mail);
   308	
   309	        if ('POST' === $request->getMethod()) {
