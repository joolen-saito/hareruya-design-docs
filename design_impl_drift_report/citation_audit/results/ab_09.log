    52	                if ($orderSub->getSpendedPoints()) {
    53	                    // ポイント履歴を確認して履歴がない場合はポイント処理を行う
    54	                    if (empty($this->app['hareruya_ec.repository.point_history']->findByOrder($order))) {
    55	                        $this->app['hareruya_ec.service.point']->spendPoints($order);
    56	                    }
    57	                    // スマレジポイント連携を別プロセスで実行
    58	                    $process = new Process("nohup php {$this->app['config']['root_dir']}/app/console smaregi:batch updatePoint {$order->getId()} &");
    59	                    $process->run();
    60	                }
    61	                $orderNumberEntity = $this->app['hareruya_ec.repository.order_number']->findOneByOrderId($order->getId());
    62	                $orderNumber = $orderNumberEntity ? sprintf('%08d', $orderNumberEntity->getOrderNumber()) : '';
    63	                // 在庫履歴と販売数を更新
    64	                $this->app['eccube.service.shopping']->updateStock($orderSub, $orderNumber);
    65	                $this->app['orm.em']->commit();
    66	                // メールの再送信
    67	                $this->app['hareruya_ec.service.mail']->resendOrderMail($order, $orderNumber, $this->getLang($order->getCustomer()));
    68	            } catch (\Exception $e) {
    69	                echo $e->getMessage() . "\n" ;
    70	                $this->app['orm.em']->rollback();
    71	            }
    72	        }
    73	    }
