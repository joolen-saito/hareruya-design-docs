    48	    public function upload(string $localPath): bool
    49	    {
    50	        if (!file_exists($localPath)) {
    51	            log_error('SFTPアップロード失敗: ローカルファイルが見つかりません。', ['path' => $localPath]);
    52	
    53	            return false;
    54	        }
    55	
    56	        $remoteFileName = basename($localPath);
    57	        $remotePath = $this->remoteDir.'/'.$remoteFileName;
    58	
    59	        $sftp = $this->createSftp();
    60	        if ($sftp === null) {
    61	            return false;
    62	        }
    63	
    64	        log_info('SFTPアップロード開始', ['local' => $localPath, 'remote' => $remotePath]);
    65	
    66	        if (!$sftp->put($remotePath, $localPath, SFTP::SOURCE_LOCAL_FILE)) {
    67	            log_error('SFTPアップロードに失敗しました。', ['path' => $remotePath, 'errors' => $sftp->getErrors()]);
    68	
    69	            return false;
    70	        }
    71	
    72	        log_info('SFTPアップロード成功', ['path' => $remotePath]);
    73	
    74	        return true;
    75	    }
