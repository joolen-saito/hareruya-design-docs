  1915	            ->setParameter('delivery', [Delivery::OTC, Delivery::SMOOTH_OTC])
  1916	            ->andWhere('o.smaregi_product_flg = false')
  1917	            ->andWhere('o.smaregi_stock_flg = false')
  1918	            ->andWhere('o.order_number IS NOT NULL')
  1919	            ->andWhere('o.OrderStatus IN (:orderStatus)')
  1920	            ->setParameter('targetDateTime', $targetDateTime)
  1921	            ->setParameter('orderStatus', [OrderStatus::NEW, OrderStatus::PAY_WAIT, OrderStatus::PAID, OrderStatus::PICKED, OrderStatus::PICKING]);
  1922	
  1923	        return $qb->getQuery()->getResult();
