    34	    }
    35	
    36	    /**
    37	     * 新規登録 (POST /pos/products) 用のボディ。
    38	     *
    39	     * @return array<string,string>
    40	     */
    41	    public function buildForCreate(Order $Order, string $productCode, string $categoryId): array
    42	    {
    43	        return [
    44	            'productName' => $this->buildProductName($Order),
    45	            'price' => $this->resolvePrice($Order),
    46	            'taxDivision' => '0',
    47	            'productPriceDivision' => '1',
    48	            'division' => '0',
    49	            'productCode' => $productCode,
    50	            'description' => '',
    51	            'supplierProductNo' => $productCode,
    52	            'categoryId' => $categoryId,
    53	        ];
    54	    }
    55	
    56	    /**
    57	     * 更新 (PATCH /pos/products/{productId}) 用のボディ。
    58	     *
    59	     * 受注編集で変わり得る商品名・価格のみを送る。productCode / categoryId は
    60	     * 登録時に確定した値を書き換えないため含めない。
    61	     *
    62	     * @return array<string,string>
    63	     */
    64	    public function buildForUpdate(Order $Order): array
    65	    {
    66	        return [
    67	            'productName' => $this->buildProductName($Order),
    68	            'price' => $this->resolvePrice($Order),
    69	        ];
    70	    }
    71	
    72	    private function buildProductName(Order $Order): string
    73	    {
    74	        $name = (string) $Order->getOrderNumber();
    75	
    76	        if ($this->isShopFrontOrder($Order)) {
    77	            $waitingNumber = '';
    78	            $orderId = $Order->getId();
    79	            if ($orderId !== null) {
    80	                $waitingNumberEntity = $this->waitingNumberRepository->findOneByOrderId($orderId);
    81	                $waitingNumber = $waitingNumberEntity !== null ? (string) $waitingNumberEntity->getWaitingNumber() : '';
    82	            }
    83	            $name .= "/店頭注文: {$waitingNumber} のご注文";
    84	        } else {
    85	            $name .= "/ {$Order->getKana01()} {$Order->getKana02()} 様のご注文";
    86	        }
    87	
    88	        return SmaregiFieldFormatter::truncateProductName($name);
    89	    }
    90	
    91	    /**
    92	     * 仕様書より抜粋: スムーズ店頭受取は 0 円固定 / 店頭受取は注文合計 (payment_total)。
    93	     */
    94	    private function resolvePrice(Order $Order): string
    95	    {
    96	        foreach ($Order->getShippings() as $Shipping) {
    97	            $delivery = $Shipping->getDelivery();
    98	            if ($delivery instanceof Delivery && $delivery->getId() === Delivery::SMOOTH_OTC) {
    99	                return '0';
   100	            }
   101	        }
   102	
   103	        return (string) max(0, (int) $Order->getPaymentTotal());
   104	    }
   105	
   106	    private function isShopFrontOrder(Order $Order): bool
   107	    {
   108	        $Customer = $Order->getCustomer();
   109	        if ($Customer === null) {
   110	            return false;
   111	        }
   112	
   113	        $Player = $Customer->getPlayer();
   114	        if ($Player === null) {
   115	            return false;
   116	        }
   117	
   118	        return $Player->getCustomerGroup()->getShopFrontFlg();
   119	    }
   120	}
    25	 *
    26	 * 採番衝突 (同一コードが ECCUBE 内に既存) の検出は本サービスのスコープ外で、
    27	 * 利用側 (同期サービス) で既存検索した上でエラー処理する想定。
    28	 */
    29	final readonly class SmaregiOtcProductCodeGenerator
    30	{
    31	    private const FIXED_PREFIX = '201';
    32	    private const STORE_ID_LENGTH = 3;
    33	    private const ORDER_NUMBER_PAD_LENGTH = 8;
    34	    private const ORDER_NUMBER_TAIL_LENGTH = 6;
    35	    private const TOTAL_LENGTH = 13;
    36	
    37	    /**
    38	     * 店舗 ID と注文番号から 13 桁の商品コードを生成する。
    39	     *
    40	     * @throws \InvalidArgumentException 入力が要件を満たさない場合 (数値以外、桁数超過)
    41	     */
    42	    public function generate(string $storeId, string $orderNumber): string
    43	    {
    44	        $storeIdPart = $this->normalizeStoreId($storeId);
    45	        $orderNumberPart = $this->normalizeOrderNumber($orderNumber);
    46	
    47	        $base = self::FIXED_PREFIX.$storeIdPart.$orderNumberPart;
    48	        $checkDigit = $this->calculateCheckDigit($base);
    49	
    50	        $code = $base.$checkDigit;
    51	        if (strlen($code) !== self::TOTAL_LENGTH) {
    52	            throw new \LogicException(sprintf('Generated Smaregi OTC code length is invalid: %s', $code));
    53	        }
    54	
    55	        return $code;
    56	    }
    57	
    58	    private function normalizeStoreId(string $storeId): string
    59	    {
    60	        if ($storeId === '' || !ctype_digit($storeId)) {
    61	            throw new \InvalidArgumentException(sprintf('Store ID must be a non-empty numeric string. given=%s', $storeId));
    62	        }
    63	        if (strlen($storeId) > self::STORE_ID_LENGTH) {
    64	            throw new \InvalidArgumentException(sprintf('Store ID exceeds %d digits. given=%s', self::STORE_ID_LENGTH, $storeId));
    65	        }
    66	
    67	        return str_pad($storeId, self::STORE_ID_LENGTH, '0', STR_PAD_LEFT);
    68	    }
    69	
    70	    private function normalizeOrderNumber(string $orderNumber): string
    71	    {
    72	        if ($orderNumber === '' || !ctype_digit($orderNumber)) {
    73	            throw new \InvalidArgumentException(sprintf('Order number must be a non-empty numeric string. given=%s', $orderNumber));
    74	        }
    75	
    76	        $padded = str_pad($orderNumber, self::ORDER_NUMBER_PAD_LENGTH, '0', STR_PAD_LEFT);
    77	
    78	        return substr($padded, -self::ORDER_NUMBER_TAIL_LENGTH);
    79	    }
    80	
    81	    private function calculateCheckDigit(string $base12): string
    82	    {
    83	        $sum = 0;
    84	        for ($i = 0; $i < 12; $i++) {
    85	            $d = (int) $base12[$i];
    86	            $sum += ($i % 2 === 0) ? $d : ($d * 3);
    87	        }
    88	
    89	        return (string) ((10 - ($sum % 10)) % 10);
    90	    }

