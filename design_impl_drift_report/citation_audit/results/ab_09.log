  1928	     *
  1929	     * @return array<array{order_id: int}>
  1930	     */
  1931	    public function getNotReflectedPointsUsage(): array
  1932	    {
  1933	        $sql = <<<EOT
  1934	            SELECT o.id AS order_id
  1935	            FROM dtb_order o
  1936	            JOIN plg_sln_order_payment_status sln ON sln.order_id = o.id
  1937	            LEFT JOIN dtb_stockout_history soh ON soh.order_id = o.id
  1938	            WHERE o.total != o.payment_total
  1939	            AND o.order_number IS NOT NULL
  1940	            AND o.note IS NULL
  1941	            AND o.discount > 0
  1942	            AND soh.order_id IS NULL
  1943	            AND GREATEST(o.total, o.payment_total) != (o.discount + LEAST(o.total, o.payment_total))
  1944	            AND sln.amount::numeric = GREATEST(o.total, o.payment_total)
  1945	            AND o.payment_date BETWEEN NOW() - INTERVAL '1 hour' AND NOW()
  1946	            AND o.deleted_at IS NULL
  1947	            ORDER BY o.id DESC
  1948	            EOT;
  1949	
  1950	        $rsm = new ResultSetMapping();
  1951	        $rsm->addScalarResult('order_id', 'order_id', Types::INTEGER);
  1952	
  1953	        return $this->getEntityManager()->createNativeQuery($sql, $rsm)->getResult();
  1954	    }
