  1961	    public function getNotSendMailOrders(): array
  1962	    {
  1963	        $toDate = new \DateTime('now', new \DateTimeZone('UTC'));
  1964	        $toDate->modify('-60 second');
  1965	        $fromDate = clone $toDate;
  1966	        $fromDate->modify('-5 minute');
  1967	
  1968	        $result = $this->createQueryBuilder('o')
  1969	            ->select('o')
  1970	            ->join('o.OrderStatus', 'os', 'WITH', 'os.id IN (:statusList)')
  1971	            ->leftJoin('Eccube\Entity\MailHistory', 'mh', 'WITH', 'o = mh.Order')
  1972	            ->where('mh.id IS NULL')
  1973	            ->andWhere('o.order_date > :fromDate AND o.order_date < :toDate')
  1974	            ->setParameter('toDate', $toDate)
  1975	            ->setParameter('fromDate', $fromDate)
  1976	            ->setParameter('statusList', [
  1977	                OrderStatus::NEW,
  1978	                OrderStatus::PAY_WAIT,
  1979	                OrderStatus::PICKING,
  1980	            ])
  1981	            ->getQuery()
  1982	            ->getResult();
  1983	
  1984	        return $result;
  1985	    }
