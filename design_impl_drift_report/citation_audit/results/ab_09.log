  1683	    public function getFormatNoTagSalesSummary($app, $inputDate, $not)
  1684	    {
  1685	        $fromDate = clone $inputDate;
  1686	        $toDate = clone $inputDate;
  1687	        $toDate->modify('+1 months');
  1688	
  1689	        $query = "
  1690	            SELECT
  1691	                DATE_FORMAT(o.order_date, '%e') as day,
  1692	                SUM(od.price * od.quantity) as price
  1693	            FROM
  1694	                dtb_order as o
  1695	                inner join dtb_order_detail as od
  1696	                on o.order_id = od.order_id
  1697	                inner join dtb_product as p
  1698	                on od.product_id = p.product_id
  1699	                inner join dtb_product_sub as ps
  1700	                on p.product_id = ps.product_id
  1701	                left join dtb_order_detail_sub_tag_sales_analysis as ot
  1702	                on od.order_detail_id = ot.order_detail_id
  1703	            WHERE
  1704	                o.status != :status
  1705	            and ot.order_detail_id is null
  1706	            and o.order_date >= :fromDate
  1707	            and o.order_date <  :toDate
  1708	            and ps.card_detail_id is {$not} null
  1709	            GROUP BY
  1710	                DATE_FORMAT(o.order_date, '%Y%m%d')";
  1711	
  1712	        $rsm = new ResultSetMapping();
  1713	        $rsm->addScalarResult('day', 'day')
  1714	            ->addScalarResult('price', 'price', Type::INTEGER);
  1715	
  1716	        $result = $app['orm.em']
  1717	            ->createNativeQuery($query, $rsm)
  1718	            ->setParameters([
