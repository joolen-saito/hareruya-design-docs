    47	                dtb_weekly_stock_history (
    48	                    {$insertQuery}
    49	                )
    50	            SELECT
    51	                {$selectQuery}
    52	            FROM
    53	                dtb_weekly_stock_history_temp wsht
    54	            EOT;
