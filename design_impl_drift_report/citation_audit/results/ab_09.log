   198	    /**
   199	     * Get weekly stock history
   200	     *
   201	     * @return array
   202	     */
   203	    public function getWeeklyStockHistory()
   204	    {
   205	        ini_set('memory_limit', '-1');
   206	        set_time_limit(0);
   207	
   208	        $entityManager = $this->getEntityManager();
   209	        $entityManager->getConnection()->getConfiguration()->setSQLLogger(null);
   210	
   211	        $date = new \DateTime();
   212	        $dateStr = $date->format('Y-m-d');
   213	        $productClassIds = $entityManager->getRepository(ProductStock::class)->getAllProductClassId();
   214	
   215	        $weeklyStockHistories = [];
   216	        foreach ($productClassIds as $productClassId) {
   217	            $weeklyStockHistory = [];
   218	            $weeklyStockHistory['product_class_id'] = $productClassId;
   219	            for ($i = 1; $i <= self::WEEKLY_STOCK_HISTORY_COUNT; $i++) {
   220	                $sql = <<<EOT
   221	                    SELECT
   222	                        sh.stock
   223	                    FROM
   224	                        dtb_stock_history sh
   225	                    WHERE
   226	                        sh.product_class_id = :productClassId
   227	                        AND DATE_FORMAT(sh.create_date, '%Y%m%d') <= DATE_FORMAT(DATE_SUB('{$dateStr}', INTERVAL {$i} WEEK), '%Y%m%d')
   228	                    ORDER BY
   229	                        sh.create_date DESC
   230	                    LIMIT 1
   231	                EOT;
   232	                $rsm = new ResultSetMapping();
   233	                $rsm->addScalarResult('stock', 'stock');
   234	                $result = $entityManager->createNativeQuery($sql, $rsm)
   235	                    ->setParameter('productClassId', $productClassId)
   236	                    ->getOneOrNullResult();
   237	                $weeklyStockHistory[sprintf('stock_%02d', $i)] = $result['stock'] ?? 0;
   238	            }
   239	            $weeklyStockHistories[] = $weeklyStockHistory;
   240	            $entityManager->clear();
   241	        }
   242	
   243	        return $weeklyStockHistories;
   244	    }
