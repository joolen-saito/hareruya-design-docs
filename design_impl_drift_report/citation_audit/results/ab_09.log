  2011	    const sheetLinks = document.querySelectorAll(".artifact-map a[data-sheet]");
  2012	    sheetLinks.forEach((link) => {
  2013	      link.addEventListener("click", (event) => {
  2014	        event.preventDefault();
  2015	        const target = link.dataset.sheet;
  2016	        sheetLinks.forEach((item) => {
  2017	          if (item === link) {
  2018	            item.setAttribute("aria-current", "page");
  2019	          } else {
  2020	            item.removeAttribute("aria-current");
  2021	          }
  2022	        });
  2023	        document.querySelectorAll(".sheet-panel").forEach((panel) => {
  2024	          panel.classList.toggle("is-active", panel.id === target);
  2025	        });
  2026	      });
  2027	    });
  2028	
  2029	    const refToggle = document.getElementById("ref-toggle");
  2030	    if (refToggle) {
  2031	      refToggle.addEventListener("click", () => {
  2032	        const on = document.body.classList.toggle("show-refs");
  2033	        refToggle.setAttribute("aria-pressed", on ? "true" : "false");
  2034	      });
  2035	    }
