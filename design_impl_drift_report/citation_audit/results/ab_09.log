    45	            throw new \RuntimeException('resendMail get lock failed.');
    46	        }
    47	        $orders = $this->app['hareruya_ec.repository.order']->getNotSendMailOrders();
    48	        foreach ($orders as $order) {
    49	            try {
    50	                $this->app['orm.em']->beginTransaction();
