    61	    /**
    62	     * 本テーブルを TRUNCATE し、一時テーブルからデータをコピーする。
    63	     *
    64	     * TRUNCATE 後に COPY が失敗するとデータが空になるため、トランザクションでラップする。
    65	     * PostgreSQL では TRUNCATE がトランザクション内でロールバック可能。
    66	     */
    67	    public function replaceFromTemp(): void
    68	    {
    69	        $em = $this->getEntityManager();
    70	        $connection = $em->getConnection();
    71	        $connection->beginTransaction();
    72	        try {
    73	            $connection->executeStatement('TRUNCATE TABLE dtb_weekly_stock_history');
    74	            $this->copyDataFromTemp();
    75	            $connection->commit();
    76	        } catch (\Throwable $e) {
    77	            $connection->rollBack();
    78	            throw $e;
    79	        }
    80	        $em->clear();

