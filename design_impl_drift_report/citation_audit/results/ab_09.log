    34	 */
    35	#[AsCommand(name: 'eccube:update-weekly-stock-history', description: '週間在庫履歴更新バッチ')]
    36	class UpdateWeeklyStockHistoryCommand extends Command
    37	{
    38	    public function __construct(private readonly BatchUpdateWeeklyStockHistoryAction $batchUpdateWeeklyStockHistoryAction)
    39	    {
    40	        parent::__construct();
    41	    }
    42	
    43	    #[\Override]
    44	    protected function execute(InputInterface $input, OutputInterface $output): int
    45	    {
    46	        $io = new SymfonyStyle($input, $output);
    47	
