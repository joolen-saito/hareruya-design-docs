    88	            }
    89	
    90	            $gzipPath = $this->compressFile($tsvPath, self::COMPRESS_GZIP);
    91	
    92	            $md5 = md5_file($gzipPath);
    93	            $this->filesystem->dumpFile($donePath, $md5);
    94	            log_info('.doneファイルを生成しました。', ['path' => $donePath, 'md5' => $md5]);
    95	
    96	            log_info('バックアップファイルを作成しました。', ['path' => $gzipPath]);
    97	            $this->applyPermissions([$tsvPath, $gzipPath, $donePath]);
    98	
    99	            if (!$isManualExecution) {
   100	                if (!$this->sftpService->deleteRemoteByPrefixes(['feed_hareruyamtg_', 'done_hareruyamtg_'])) {
   101	                    throw new \RuntimeException('SFTP既存ファイルの削除に失敗しました。');
   102	                }
   103	                if (!$this->sftpService->upload($gzipPath)) {
   104	                    throw new \RuntimeException('SFTPアップロードに失敗しました。');
   105	                }
   106	                if (!$this->sftpService->upload($donePath)) {
   107	                    throw new \RuntimeException('SFTPアップロードに失敗しました。');
   108	                }
   109	                log_info('生成したファイルをSFTPにアップロードしました。');
   110	            } else {
   111	                log_info('手動実行モードのため、SFTPアップロードをスキップしました。');
   112	            }
   113	        } catch (\Throwable $e) {
   114	            log_error('ユニサーチ商品フィード連携処理でエラーが発生しました。', [
