   135	    public function getEventBanners($shopId, $locale, $limit)
   136	    {
   137	        $qb = $this->createQueryBuilder('e');
   138	        $from = (new \DateTime())->setTime(0, 0, 0);
   139	        $qb->join('e.details', 'ed')
   140	            ->where($qb->expr()->eq('e.shopId', ':shopId'))
   141	            ->andWhere($qb->expr()->eq('e.dispId', Disp::DISPLAY_SHOW))
   142	            ->andWhere($qb->expr()->eq('ed.dispId', Disp::DISPLAY_SHOW))
   143	            ->andWhere($qb->expr()->gte('ed.startDate', ':from'));
   144	        $locale === 'ja' ? $qb->andWhere("e.bannerUrl != ''") : $qb->andWhere("e.bannerEnUrl != ''");
   145	
   146	        $qb->setParameters([
   147	                'from' => $from,
   148	                'shopId' => $shopId
   149	            ])
   150	            ->orderBy('ed.startDate', 'ASC')
   151	            ->setMaxResults($limit);
   152	
   153	        return $qb->getQuery()->execute();
