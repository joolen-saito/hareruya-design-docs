    16	namespace Eccube\Service\Front\Event;
    17	
    18	use Eccube\Entity\DtbEventDetail;
    19	
    20	final readonly class EventDetailButtonStateResolver
    21	{
    22	    public function resolve(
    23	        DtbEventDetail $Detail,
    24	        int $activeEntryCount,
    25	        bool $hasMyActiveEntry,
    26	        \DateTimeImmutable $now,
    27	    ): EventDetailButtonState {
    28	        $event = $Detail->getEvent();
    29	
    30	        $canApply = !$hasMyActiveEntry
    31	            && $Detail->getEntryFlg()
    32	            && $activeEntryCount < $event->getCapacity()
    33	            && $this->isWithinEntryWindow($Detail, $now);
    34	
    35	        return new EventDetailButtonState(
    36	            canApply: $canApply,
    37	            canCancel: $hasMyActiveEntry,
    38	            canDeckRegist: $Detail->canBeRegisteredDeck(),
    39	        );
    40	    }
    41	
    42	    private function isWithinEntryWindow(DtbEventDetail $Detail, \DateTimeImmutable $now): bool
    43	    {
    44	        $start = $Detail->getOnlineEntryStartDate();
    45	        $end = $Detail->getOnlineEntryEndDate();
    46	        if ($start === null || $end === null) {
    47	            return false;
    48	        }
    49	
    50	        $startImmutable = \DateTimeImmutable::createFromInterface($start);
    51	        $endImmutable = \DateTimeImmutable::createFromInterface($end);
    52	
    53	        return $now >= $startImmutable && $now <= $endImmutable;
    54	    }
    55	}

