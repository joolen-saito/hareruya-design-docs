4400-                <tr id="item-sheet-11-4-2"><td><a class="item-no" href="#pin-sheet-11-4-2"><span class="src-cell" data-excel-book="0306" data-excel-sheet="オンライン本人確認" data-excel-ref="0306:オンライン本人確認!B245">4-2</span></a></td><td><span class="src-cell" data-excel-book="0306" data-excel-sheet="オンライン本人確認" data-excel-ref="0306:オンライン本人確認!E245">本人確認状況</span></td><td><span class="src-cell" data-excel-book="0306" data-excel-sheet="オンライン本人確認" data-excel-ref="0306:オンライン本人確認!M245">-</span></td><td><span class="src-cell" data-excel-book="0306" data-excel-sheet="オンライン本人確認" data-excel-ref="0306:オンライン本人確認!T245">-</span></td><td><span class="src-cell" data-excel-book="0306" data-excel-sheet="オンライン本人確認" data-excel-ref="0306:オンライン本人確認!V245">-</span></td><td><span class="src-cell" data-excel-book="0306" data-excel-sheet="オンライン本人確認" data-excel-ref="0306:オンライン本人確認!Z245">-</span></td><td><span class="src-cell" data-excel-book="0306" data-excel-sheet="オンライン本人確認" data-excel-ref="0306:オンライン本人確認!AG245">・身分証明書の進行ステータスを表示</span></td></tr>
4401:                <tr id="item-sheet-11-4-3"><td><a class="item-no" href="#pin-sheet-11-4-3"><span class="src-cell" data-excel-book="0306" data-excel-sheet="オンライン本人確認" data-excel-ref="0306:オンライン本人確認!B246">4-3</span></a></td><td><span class="src-cell" data-excel-book="0306" data-excel-sheet="オンライン本人確認" data-excel-ref="0306:オンライン本人確認!E246">マイページ</span></td><td><span class="src-cell" data-excel-book="0306" data-excel-sheet="オンライン本人確認" data-excel-ref="0306:オンライン本人確認!M246">ボタン</span></td><td><span class="src-cell" data-excel-book="0306" data-excel-sheet="オンライン本人確認" data-excel-ref="0306:オンライン本人確認!T246">-</span></td><td><span class="src-cell" data-excel-book="0306" data-excel-sheet="オンライン本人確認" data-excel-ref="0306:オンライン本人確認!V246">-</span></td><td><span class="src-cell" data-excel-book="0306" data-excel-sheet="オンライン本人確認" data-excel-ref="0306:オンライン本人確認!Z246">-</span></td><td><span class="src-cell" data-excel-book="0306" data-excel-sheet="オンライン本人確認" data-excel-ref="0306:オンライン本人確認!AG246">・押下すると、マイページへ遷移する</span></td></tr>
