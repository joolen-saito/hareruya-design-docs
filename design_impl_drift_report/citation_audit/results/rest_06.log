    16	namespace Eccube\Controller\Front\Mypage;
    17	
    18	use Eccube\Controller\AbstractController;
    19	use Eccube\Entity\Customer;
    20	use Eccube\EventListener\PasswordPolicyListener;
    21	use Eccube\Form\Type\Front\PasswordChangeType;
    22	use Symfony\Bridge\Twig\Attribute\Template;
    23	use Symfony\Component\HttpFoundation\RedirectResponse;
    24	use Symfony\Component\HttpFoundation\Request;
    25	use Symfony\Component\PasswordHasher\Hasher\UserPasswordHasherInterface;
    26	use Symfony\Component\Routing\Attribute\Route;
    27	use Symfony\Component\Security\Http\Attribute\IsGranted;
    28	
    29	/**
    30	 * パスワード変更専用画面コントローラー.
    31	 *
    32	 * パスワードポリシー未準拠の会員がログイン後に遷移する専用画面。
    33	 * パスワード変更が完了するとポリシー未準拠フラグを解除する。
    34	 */
    35	class PasswordChangeController extends AbstractController
    36	{
    37	    /**
    38	     * @param UserPasswordHasherInterface $passwordHasher
    39	     */
    40	    public function __construct(
    41	        private readonly UserPasswordHasherInterface $passwordHasher,
    42	    ) {
    43	    }
    44	
    45	    /**
    46	     * パスワード変更画面
    47	     *
    48	     * @return array<string, mixed>|RedirectResponse
    49	     */
    50	    #[IsGranted('ROLE_USER')]
    51	    #[Route(path: '/mypage/password_change', name: 'mypage_password_change', methods: ['GET', 'POST'])]
    52	    #[Template(template: 'Mypage/password_change.twig')]
    53	    public function index(Request $request): array|RedirectResponse
    54	    {
    55	        if (!$request->getSession()->get(PasswordPolicyListener::SESSION_KEY)) {
    56	            return $this->redirectToRoute('mypage');
    57	        }
    58	
    59	        /** @var Customer $Customer */
    60	        $Customer = $this->getUser();
    61	        $Customer->setPlainPassword('');
    62	
    63	        $form = $this->formFactory->createBuilder(PasswordChangeType::class, $Customer)->getForm();
    64	        $form->handleRequest($request);
    65	
    66	        if ($form->isSubmitted() && $form->isValid()) {
    67	            $password = $this->passwordHasher->hashPassword($Customer, (string) $Customer->getPlainPassword());
    68	            $Customer->setPassword($password);
    69	            $this->entityManager->flush();
    70	
    71	            $request->getSession()->remove(PasswordPolicyListener::SESSION_KEY);
    72	
    73	            return $this->redirectToRoute('mypage_password_change_complete');
    74	        }
    75	
    76	        return ['form' => $form->createView()];
    77	    }
    78	
    79	    /**
    80	     * パスワード変更完了画面
    81	     *
    82	     * @return array<string, mixed>
    83	     */
    84	    #[IsGranted('ROLE_USER')]
    85	    #[Route(path: '/mypage/password_change_complete', name: 'mypage_password_change_complete', methods: ['GET'])]
    86	    #[Template(template: 'Mypage/password_change_complete.twig')]
    87	    public function complete(): array
    88	    {
    89	        return [];
    90	    }
    91	}
