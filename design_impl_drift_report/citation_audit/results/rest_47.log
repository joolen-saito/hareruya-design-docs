    14	namespace Eccube\Form\Type\Admin;
    15	
    16	use Doctrine\ORM\EntityManagerInterface;
    17	use Doctrine\ORM\Mapping\Driver\AttributeDriver;
    18	use Eccube\Entity\Master\Country;
    19	use Eccube\Entity\Master\CustomerOrderStatus;
    20	use Eccube\Entity\Master\MtbColorSequence;
    21	use Eccube\Entity\Master\OrderStatus;
    22	use Eccube\Entity\Master\OrderStatusColor;
    23	use Symfony\Component\Form\AbstractType;
    24	use Symfony\Component\Form\Extension\Core\Type\ChoiceType;
    25	use Symfony\Component\Form\FormBuilderInterface;
    26	use Symfony\Component\Validator\Constraints as Assert;
    27	
    28	/**
    29	 * Class MasterdataType
    30	 */
    31	class MasterdataType extends AbstractType
    32	{
    33	    /**
    34	     * MasterdataType constructor.
    35	     */
    36	    public function __construct(protected EntityManagerInterface $entityManager)
    37	    {
    38	    }
    39	
    40	    /**
    41	     * {@inheritdoc}
    42	     *
    43	     * @param array<string, mixed> $options
    44	     */
    45	    #[\Override]
    46	    public function buildForm(FormBuilderInterface $builder, array $options): void
    47	    {
    48	        $masterdata = [];
    49	
    50	        // AttributeDriver でも有効なメタデータ一括取得に変更
    51	        foreach ($this->entityManager->getMetadataFactory()->getAllMetadata() as $meta) {
    52	            // 抽象クラスは除外
    53	            $rc = $meta->getReflectionClass();
    54	            if ($rc->isAbstract()) {
    55	                continue;
    56	            }
    57	
    58	            // OrderStatus/OrderStatusColor/CustomerOrderStatus/MtbColorSequence/Contry は対象外
    59	            if (in_array($meta->getName(), [OrderStatus::class, OrderStatusColor::class, CustomerOrderStatus::class, MtbColorSequence::class, Country::class], true)) {
    60	                continue;
    61	            }
    62	
    63	            if (str_contains($meta->rootEntityName, 'Master')
    64	                && $meta->hasField('id')
    65	                && $meta->hasField('name')
    66	                && $meta->hasField('sort_no')
    67	            ) {
    68	                $metadataName = str_replace('\\', '-', $meta->getName());
    69	                $masterdata[$metadataName] = $meta->getTableName();
    70	            }
    71	        }
    72	
    73	        $builder
    74	            ->add('masterdata', ChoiceType::class, [
    75	                'choices' => array_flip($masterdata),
    76	                'expanded' => false,
    77	                'multiple' => false,
    78	                'constraints' => [
    79	                    new Assert\NotBlank(),
    80	                ],
    81	            ])
    82	        ;
    83	    }
    84	
    85	    /**
    86	     * {@inheritdoc}
    87	     */
    88	    #[\Override]
    89	    public function getBlockPrefix(): string
    90	    {
    91	        return 'admin_system_masterdata';
    92	    }
    93	}
