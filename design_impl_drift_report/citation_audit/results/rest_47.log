    11	{% extends '@admin/default_frame.twig' %}
    12	
    13	{% set menus = ['data_management', 'mtg_master_data'] %}
    14	
    15	{% block title %}{{ 'admin.data.mtg_master_data_management'|trans }}{% endblock %}
    16	{% block sub_title %}{{ 'admin.data.data_management'|trans }}{% endblock %}
    17	
    18	{% block stylesheet %}
    19	<style>
    20	    .mtg-master-table {
    21	        --bs-table-border-color: var(--bs-border-color);
    22	        border-top: 1px solid var(--bs-border-color);
    23	    }
    24	    .mtg-master-table th,
    25	    .mtg-master-table td {
    26	        border-color: var(--bs-border-color);
    27	    }
    28	    .mtg-master-table > thead > tr > * {
    29	        --bs-table-bg-type: #ffffff;
    30	        background-color: #ffffff;
    31	    }
    32	    .mtg-master-table.table-striped > tbody > tr:nth-of-type(odd) > * {
    33	        --bs-table-bg-type: #f7f7f7;
    34	        background-color: #f7f7f7;
    35	    }
    36	    .mtg-master-table.table-striped > tbody > tr:nth-of-type(even) > * {
    37	        --bs-table-bg-type: #ffffff;
    38	        background-color: #ffffff;
    39	    }
    40	</style>
    41	{% endblock stylesheet %}
    42	
    43	{% block main %}
    44	    <div class="c-contentsArea__cols">
    45	        <div class="c-contentsArea__primaryCol">
    46	            <div class="c-primaryCol">
    47	
    48	                <form method="get" action="{{ url('admin_data_mtg_master_data') }}">
    49	                    <div class="card rounded border-0 mb-4">
    50	                        <div class="card-header">
    51	                            <span>{{ 'admin.data.mtg_master_data_management'|trans }}</span>
    52	                        </div>
    53	                        <div class="card-body">
    54	                            <div class="d-flex gap-2 align-items-center">
    55	                                <select name="entity" class="form-select w-auto">
    56	                                    {% for key, label in entityChoices %}
    57	                                        <option value="{{ key }}" {% if key == entityKey %}selected{% endif %}>{{ label }}</option>
    58	                                    {% endfor %}
    59	                                </select>
    60	                                <button class="btn btn-ec-conversion" type="submit">{{ 'admin.data.mtg_master_data.select'|trans }}</button>
    61	                            </div>
    62	                        </div>
    63	                    </div>
    64	                </form>
    65	
    66	                <form id="edit_form" method="post" action="{{ url('admin_data_mtg_master_data') }}">
    67	                    {{ form_widget(editForm._token) }}
    68	                    {{ form_widget(editForm.entity_key) }}
    69	
    70	                    <div class="card rounded border-0 mb-4">
    71	                        <div class="card-body p-0">
    72	                            <p class="mb-2 text-muted small px-3 pt-3">
    73	                                マスターデータの値を設定できます。<br>
    74	                                行の値をすべて消すことで、値は削除されます。<br>
    75	                                設定値によってはサイトが機能しなくなる場合もありますので、十分ご注意ください。<br>
    76	                                「特殊サジェスト」を設定する際は、設定後に<a href="{{ url('admin_card_list') }}">カード一覧の「カード名リスト作成」</a>を実行してください。
    77	                            </p>
    78	
    79	                            <div class="table-responsive mb-0">
    80	                                <table class="table table-bordered table-striped mtg-master-table">
    81	                                    <thead>
    82	                                        <tr>
    83	                                            {% for column in columns %}
    84	                                                <th class="text-center" {% if column.field == 'sort_no' or column.field == 'sortNo' %}style="width: 80px"{% endif %}>{{ column.label }}</th>
    85	                                            {% endfor %}
    86	                                        </tr>
    87	                                    </thead>
    88	                                    <tbody>
    89	                                        {% for rowIndex, row in entityRows %}
    90	                                            <tr>
    91	                                                {% for column in columns %}
    92	                                                    {% set isFixed = fixedFormNum >= 0 and (rowIndex + 1) <= fixedFormNum and column.label != 'sort_no' %}
    93	                                                    <td class="align-middle">
    94	                                                        {% if column.set_type == 'bool' %}
    95	                                                            <select name="rows[{{ row.id }}][{{ column.field }}]" class="form-select form-select-sm">
    96	                                                                <option value="0" {% if row.values[column.field]|default('0') != '1' %}selected{% endif %}>0</option>
    97	                                                                <option value="1" {% if row.values[column.field]|default('0') == '1' %}selected{% endif %}>1</option>
    98	                                                            </select>
    99	                                                        {% else %}
   100	                                                            <input
   101	                                                                type="{{ column.set_type in ['int', 'nullable_int'] ? 'number' : (column.type == 'datetime' ? 'datetime-local' : 'text') }}"
   102	                                                                name="rows[{{ row.id }}][{{ column.field }}]"
   103	                                                                value="{{ column.type == 'datetime' ? row.values[column.field]|default('')|replace({' ': 'T'}) : row.values[column.field]|default('') }}"
   104	                                                                class="form-control form-control-sm"
   105	                                                                {% if isFixed %}readonly="readonly"{% endif %}
   106	                                                            >
   107	                                                        {% endif %}
   108	                                                    </td>
   109	                                                {% endfor %}
   110	                                            </tr>
   111	                                        {% endfor %}
   112	                                        <tr>
   113	                                            {% for column in columns %}
   114	                                                <td class="align-middle">
   115	                                                    {% if column.set_type == 'bool' %}
   116	                                                        <select name="rows[new][{{ column.field }}]" class="form-select form-select-sm">
   117	                                                            <option value="0" selected>0</option>
   118	                                                            <option value="1">1</option>
   119	                                                        </select>
   120	                                                    {% else %}
   121	                                                        <input
   122	                                                            type="{{ column.set_type in ['int', 'nullable_int'] ? 'number' : (column.type == 'datetime' ? 'datetime-local' : 'text') }}"
   123	                                                            name="rows[new][{{ column.field }}]"
   124	                                                            value=""
   125	                                                            class="form-control form-control-sm"
   126	                                                        >
   127	                                                    {% endif %}
   128	                                                </td>
   129	                                            {% endfor %}
   130	                                        </tr>
   131	                                    </tbody>
   132	                                </table>
   133	                            </div>
   134	                        </div>
   135	                    </div>
   136	                </form>
   137	
   138	            </div>
   139	        </div>
   140	
   141	        <div class="c-conversionArea">
   142	            <div class="c-conversionArea__container">
   143	                <div class="c-conversionArea__leftBlock">
   144	                    <div class="c-conversionArea__leftBlockItem"></div>
   145	                </div>
   146	                <div id="ex-conversion-action" class="c-conversionArea__rightBlock">
   147	                    <div class="c-conversionArea__rightBlockItem">
   148	                        <button class="btn btn-ec-conversion px-5" type="submit" form="edit_form">{{ 'admin.common.registration'|trans }}</button>
   149	                    </div>
   150	                </div>
   151	            </div>
   152	        </div>
   153	
   154	    </div>
   155	{% endblock %}
