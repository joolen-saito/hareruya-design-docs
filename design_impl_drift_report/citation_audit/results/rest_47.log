   329	                                                    <img src="{{ publicUrl }}" class="img-fluid w-100" style="max-width: 90%;">
   330	                                                </a>
   331	                                            </div>
   332	                                            <div class="text-break small mt-2 ps-0 ms-0">{{ publicUrl }}</div>
   333	                                        </td>
   334	                                        <td class="text-center">
   335	                                            {% if file.lastModified is not null %}
   336	                                                {{ file.lastModified|date('Y/m/d H:i:s') }}
   337	                                            {% endif %}
   338	                                        </td>
   339	                                        <td class="text-center">
   340	                                            <button type="button" class="btn btn-link p-0 js-copy-url" data-url="{{ publicUrl|e('html_attr') }}">
   341	                                                {{ 'admin.data.top_banner.upload_copy_url'|trans }}
   342	                                            </button>
   343	                                        </td>
   344	                                        <td class="text-center">
   345	                                            {% if filterBaseInfoDigit is not empty %}
   346	                                                {% set deleteUrl = path('admin_data_top_banner_delete_filter', { select_file: file.key, base_info_digit: filterBaseInfoDigit }) %}
   347	                                            {% else %}
   348	                                                {% set deleteUrl = path('admin_data_top_banner_delete', { select_file: file.key }) %}
   349	                                            {% endif %}
   350	                                            <a href="{{ deleteUrl }}"
   351	                                               {{ csrf_token_for_anchor() }}
   352	                                               data-method="delete"
   353	                                               data-message="{{ 'admin.data.top_banner.delete_confirm'|trans }}">
   354	                                                {{ 'admin.common.delete'|trans }}
   355	                                            </a>
   356	                                        </td>
   357	                                    </tr>
   358	                                {% else %}
   359	                                    <tr>
   360	                                        <td colspan="4" class="text-center">{{ 'admin.data.top_banner.upload_empty'|trans }}</td>
   361	                                    </tr>
   362	                                {% endfor %}
   363	                                </tbody>
   364	                            </table>
   365	                        </div>
   366	                    </div>
   367	                </div>
   368	            </div>
   369	        </div>
   370	    </div>
   371	{% endblock %}
