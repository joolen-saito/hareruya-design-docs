   141	
   142	        return $this;
   143	    }
   144	
   145	    #[ORM\Column(name: 'attached_info_name_en', type: Types::STRING, length: 255, nullable: true, options: ['comment' => '付加情報名(英)'])]
   146	    private ?string $attached_info_name_en = null;
   147	
   148	    public function getAttachedInfoNameEn(): ?string
   149	    {
   150	        return $this->attached_info_name_en;
   151	    }
   152	
   153	    public function setAttachedInfoNameEn(?string $attached_info_name_en): MtbContactSubject
   154	    {
   155	        $this->attached_info_name_en = $attached_info_name_en;
   156	
   157	        return $this;
   158	    }
   159	
   160	    /**
   161	     * @var Collection<int, DtbContact>
   162	     */
   163	    #[ORM\OneToMany(targetEntity: DtbContact::class, mappedBy: 'ContactSubject')]
   164	    private Collection $Contacts;
   165	
   166	    public function addContact(DtbContact $Contact): MtbContactSubject
   167	    {
   168	        $this->Contacts[] = $Contact;
   169	
   170	        return $this;
   171	    }
   172	
   173	    public function removeContact(DtbContact $Contact): bool
   174	    {
   175	        return $this->Contacts->removeElement($Contact);
   176	    }
   177	
   178	    /**
   179	     * @return Collection<int, DtbContact>
   180	     */
   181	    public function getContacts(): Collection
   182	    {
   183	        return $this->Contacts;
   184	    }
   185	
   186	    public function __construct()
   187	    {
   188	        $this->Contacts = new ArrayCollection();
   189	    }
   190	}
