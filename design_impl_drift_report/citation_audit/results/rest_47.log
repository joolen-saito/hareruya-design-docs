   365	    private function convertStrFromServer($target)
   366	    {
   367	        if ($this->encode == self::SJIS) {
   368	            return mb_convert_encoding($target, self::UTF, self::SJIS);
   369	        }
   370	
   371	        return $target;
   372	    }
   373	
   374	    private function convertStrToServer($target)
   375	    {
   376	        if ($this->encode == self::SJIS) {
   377	            return mb_convert_encoding($target, self::SJIS, self::UTF);
   378	        }
   379	
   380	        return $target;
   381	    }
