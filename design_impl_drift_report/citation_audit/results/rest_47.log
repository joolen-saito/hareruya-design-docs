   149	    /**
   150	     * トップバナー管理削除
   151	     * @param Application $app
   152	     * @param Request $request
   153	     * @param string|null $html_class
   154	     * @return \Symfony\Component\HttpFoundation\Response
   155	     */
   156	    public function topDelete(Application $app, Request $request, ?string $html_class)
   157	    {
   158	        return $this->delete($app, $request, false, $html_class);
