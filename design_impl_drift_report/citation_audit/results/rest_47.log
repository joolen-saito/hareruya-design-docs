    11	
    12	namespace Plugin\HareruyaEc\Controller\Admin;
    13	
    14	use Eccube\Application;
    15	use Symfony\Component\HttpFoundation\Request;
    16	use Plugin\HareruyaEc\Entity\MtbHoliday;
    17	use Japanese\Holiday\Repository as HolidayRepository;
    18	use Plugin\HareruyaEc\Controller\FormValidHelper;
    19	
    20	class HolidayController
    21	{
    22	    use FormValidHelper;
    23	
    24	    /**
    25	     * 祝日一覧
    26	     * @param Application $app
    27	     * @param Request $request
    28	     * @return \Symfony\Component\HttpFoundation\Response
    29	     */
    30	    public function index(Application $app, Request $request)
    31	    {
    32	        $addForm  = $app['form.factory']->createBuilder('hareruyaec_holiday_add')->getForm();
    33	        $loadForm = $app['form.factory']->createBuilder('hareruyaec_holiday_load')->getForm();
    34	
    35	        $HolidayList = $app['hareruya_ec.repository.holiday']->findBy(array(),array('date' => 'ASC'));
    36	
    37	        return $app->render('HareruyaEc/Resource/template/admin/Holiday/holiday.twig',
    38	            array(
    39	            'addForm'  => $addForm->createView(),
    40	            'loadForm' => $loadForm->createView(),
    41	            'holidayList' => $HolidayList,
    42	        ));
    43	    }
    44	
    45	    /**
    46	     * 指定した祝日情報を削除する。
    47	     *
    48	     * @param Application $app
    49	     * @param Request $request
    50	     * @param integer $id
    51	     * @throws NotFoundHttpException
    52	     * @return \Symfony\Component\HttpFoundation\RedirectResponse
    53	     */
    54	    public function delete(Application $app, Request $request, $id)
    55	    {
    56	        $this->checkCsrfValid($app);
    57	
    58	        $targetHoliday = $app['hareruya_ec.repository.holiday']->find($id);
    59	        if (!$targetHoliday) {
    60	            throw new NotFoundHttpException();
    61	        }
    62	
    63	        $app['orm.em']->remove($targetHoliday);
    64	        $app['orm.em']->flush($targetHoliday);
    65	
    66	        $app->addSuccess('admin.delete.complete', 'admin');
    67	
    68	        // 削除した祝日のイベントの、休日フラグを全てオフに
    69	        $this->setHolidayFlgs($app, $targetHoliday->getDate(), false);
    70	
    71	        return $app->redirect($app->url('admin_holiday_list'));
    72	    }
    73	
    74	    /**
    75	     * 指定した祝日情報を追加する。
    76	     *
    77	     * @param Application $app
    78	     * @param Request $request
    79	     * @throws NotFoundHttpException
    80	     * @return \Symfony\Component\HttpFoundation\RedirectResponse
    81	     */
    82	    public function add(Application $app, Request $request)
    83	    {
    84	        $addForm = $app['form.factory']->createBuilder('hareruyaec_holiday_add')->getForm();
    85	        $addForm->handleRequest($request);
    86	
    87	        if (!$this->isFormValid($app, $addForm)) {
    88	            $app->addError('admin.register.failed', 'admin');
    89	
    90	            return $app->redirect($app->url('admin_holiday_list'));
    91	        }
    92	
    93	        $overlap = $app['orm.em']->getRepository('Plugin\HareruyaEc\Entity\MtbHoliday')->findBy(
    94	            array(
    95	                'date' => $addForm['date']->getData(),
    96	            )
    97	        );
    98	        if ($overlap) {
    99	            $app->addError('hareruyaec.holiday.overlap', 'admin');
   100	            return $app->redirect($app->url('admin_holiday_list'));
   101	        }
   102	
   103	        $registHoliday = new MtbHoliday();
   104	        $registHoliday->setDate($addForm['date']->getData());
   105	        $registHoliday->setName($addForm['name']->getData());
   106	        $app['orm.em']->persist($registHoliday);
   107	        $app['orm.em']->flush($registHoliday);
   108	
   109	        $app->addSuccess('admin.register.complete', 'admin');
   110	
   111	        // 追加した祝日のイベントの、休日フラグを全てオンに
   112	        $this->setHolidayFlgs($app, $registHoliday->getDate(), true);
   113	
   114	        return $app->redirect($app->url('admin_holiday_list'));
   115	    }
   116	
   117	    /**
   118	     * 指定した期間に含まれる祝日情報を読み込み一括追加する。
   119	     *
   120	     * @param Application $app
   121	     * @param Request $request
   122	     * @throws NotFoundHttpException
   123	     * @return \Symfony\Component\HttpFoundation\RedirectResponse
   124	     */
   125	    public function load(Application $app, Request $request)
   126	    {
   127	        $loadForm = $app['form.factory']->createBuilder('hareruyaec_holiday_load')->getForm();
   128	        $loadForm->handleRequest($request);
   129	
   130	        if (!$this->isFormValid($app, $loadForm)) {
   131	            $app->addError('admin.register.failed', 'admin');
   132	
   133	            return $app->redirect($app->url('admin_holiday_list'));
   134	        }
   135	        $dateCrs = $loadForm['startDate']->getData();
   136	        $dateEnd = $loadForm['endDate']->getData();
   137	
   138	        // 入力した開始・終了日の前後関係が反対の場合、エラーを出す
   139	        if ($dateCrs > $dateEnd) {
   140	            $app->addError('hareruyaec.holiday.wrong_range', 'admin');
   141	            return $app->redirect($app->url('admin_holiday_list'));
   142	        }
   143	
   144	        $holidayRepository = new HolidayRepository();
   145	        $holidayCount = 0;
   146	        while ($dateCrs <= $dateEnd) {
   147	            if ($holidayRepository->isHoliday($dateCrs->format('Y-m-d'))) {
   148	                $overlap = $app['orm.em']->getRepository('Plugin\HareruyaEc\Entity\MtbHoliday')->findBy(
   149	                    array(
   150	                        'date' => $dateCrs,
   151	                    )
   152	                );
   153	                if ($overlap) {
   154	                    $app->addWarning(
   155	                        sprintf(
   156	                            $app->trans('hareruyaec.holiday.skip_holiday'),
   157	                            $dateCrs->format('Y/m/d')
   158	                        ),
   159	                        'admin'
   160	                    );
   161	                } else {
   162	                    $registHoliday = new MtbHoliday();
   163	                    $registHoliday->setDate(clone $dateCrs);
   164	                    $holidays = $holidayRepository->getHolidaysForYear(intval($dateCrs->format('Y')));
   165	                    $registHoliday->setName($holidays[$dateCrs->format('Y-m-d')]->getName());
   166	
   167	                    $app['orm.em']->persist($registHoliday);
   168	                    $holidayCount ++;
   169	
   170	                    // 追加した祝日のイベントの、休日フラグを全てオンに
   171	                    $this->setHolidayFlgs($app, $registHoliday->getDate(), true);
   172	                }
   173	            }
   174	            $dateCrs = $dateCrs->modify('+1 days');
   175	        }
   176	        if (0 < $holidayCount) {
   177	            $app->addSuccess(
   178	                sprintf(
   179	                    $app->trans('hareruyaec.holiday.load_complete'),
   180	                    $holidayCount
   181	                ),
   182	                'admin'
   183	            );
   184	            $app['orm.em']->flush();
   185	        } else {
   186	            $app->addError('hareruyaec.holiday.no_holidays', 'admin');
   187	        }
   188	
   189	        return $app->redirect($app->url('admin_holiday_list'));
   190	    }
   191	
   192	    /**
   193	     * 祝日フラグ設定
   194	     *
   195	     * 祝日の追加/削除に合わせ、eventDetailの祝日フラグを設定する
   196	     *
   197	     * @param Application $app
   198	     * @param DateTime $day
   199	     * @param boolean $flg
   200	     */
   201	    private function setHolidayFlgs(Application $app, $day, $flg)
   202	    {
   203	        $changedEventDetails = $app['hareruya_ec.repository.event_detail']->getDetailsOfADay($day);
   204	        foreach ($changedEventDetails as $eventDetail) {
   205	            $eventDetail->setHolidayFlg($flg);
   206	            $app['orm.em']->persist($eventDetail);
   207	            $app['orm.em']->flush($eventDetail);
   208	        }
   209	    }
   210	}
