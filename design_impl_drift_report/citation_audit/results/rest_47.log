    16	namespace Eccube\Controller\Admin\Data;
    17	
    18	use Eccube\Controller\AbstractController;
    19	use Eccube\Entity\Master\MtbBuyPriceList;
    20	use Eccube\Entity\Master\MtbCardCondition;
    21	use Eccube\Event\EccubeEvents;
    22	use Eccube\Event\EventArgs;
    23	use Eccube\Form\Type\Admin\BuyPriceListEditType;
    24	use Eccube\Repository\Master\MtbBuyPriceListRepository;
    25	use Eccube\Repository\Master\MtbCardConditionRepository;
    26	use Eccube\Service\Admin\Data\ActionInput\BuyPriceListUpdateInput;
    27	use Eccube\Service\Admin\Data\BuyPriceListUpdateAction;
    28	use Symfony\Bridge\Twig\Attribute\Template;
    29	use Symfony\Component\HttpFoundation\RedirectResponse;
    30	use Symfony\Component\HttpFoundation\Request;
    31	use Symfony\Component\Routing\Attribute\Route;
    32	
    33	class BuyPriceListController extends AbstractController
    34	{
    35	    public function __construct(
    36	        private readonly MtbBuyPriceListRepository $buyPriceListRepository,
    37	        private readonly MtbCardConditionRepository $cardConditionRepository,
    38	        private readonly BuyPriceListUpdateAction $buyPriceListUpdateAction,
    39	    ) {
    40	    }
    41	
    42	    /**
    43	     * 買取価格対応表一覧
    44	     *
    45	     * @return array<string, mixed>
    46	     */
    47	    #[Route(path: '/%eccube_admin_route%/data/buy_price_list', name: 'admin_data_buy_price_list', methods: ['GET'])]
    48	    #[Template(template: '@admin/Data/buy_price_list.twig')]
    49	    public function index(Request $request): array
    50	    {
    51	        $event = new EventArgs([], $request);
    52	        $this->eventDispatcher->dispatch($event, EccubeEvents::ADMIN_DATA_BUY_PRICE_LIST_INDEX_INITIALIZE);
    53	
    54	        $CardConditions = $this->cardConditionRepository->findBy([
    55	            'id' => [
    56	                MtbCardCondition::SP,
    57	                MtbCardCondition::MP,
    58	                MtbCardCondition::HP,
    59	            ],
    60	        ]);
    61	
    62	        $BuyPriceListItems = $this->buyPriceListRepository->findBy([], ['nmPrice' => 'ASC', 'specialFlg' => 'ASC']);
    63	
    64	        $buyPriceMap = [];
    65	        foreach ($BuyPriceListItems as $BuyPrice) {
    66	            $specialFlgKey = $BuyPrice->getSpecialFlg() ? 1 : 0;
    67	            $buyPriceMap[$BuyPrice->getNmPrice()][$specialFlgKey][$BuyPrice->getCardCondition()->getId()] = [
    68	                'price' => $BuyPrice->getPrice(),
    69	                'id' => $BuyPrice->getId(),
    70	            ];
    71	        }
    72	        ksort($buyPriceMap, SORT_NUMERIC);
    73	
    74	        return [
    75	            'CardConditions' => $CardConditions,
    76	            'buyPriceMap' => $buyPriceMap,
    77	        ];
    78	    }
    79	
    80	    /**
    81	     * 買取価格編集
    82	     *
    83	     * @return array<string, mixed>
    84	     */
    85	    #[Route(path: '/%eccube_admin_route%/data/buy_price_list/{id}/edit', name: 'admin_data_buy_price_list_edit', requirements: ['id' => '\\d+'], methods: ['GET'])]
    86	    #[Template(template: '@admin/Data/buy_price_list_edit.twig')]
    87	    public function edit(Request $request, MtbBuyPriceList $BuyPriceList): array
    88	    {
    89	        $builder = $this->formFactory->createBuilder(BuyPriceListEditType::class, $BuyPriceList);
    90	
    91	        $event = new EventArgs(
    92	            [
    93	                'builder' => $builder,
    94	            ],
    95	            $request
    96	        );
    97	        $this->eventDispatcher->dispatch($event, EccubeEvents::ADMIN_DATA_BUY_PRICE_LIST_EDIT_INITIALIZE);
    98	
    99	        $form = $builder->getForm();
   100	
   101	        return [
   102	            'form' => $form->createView(),
   103	            'BuyPriceList' => $BuyPriceList,
   104	        ];
   105	    }
   106	
   107	    /**
   108	     * 買取価格更新
   109	     *
   110	     * @return array<string, mixed>|RedirectResponse
   111	     */
   112	    #[Route(path: '/%eccube_admin_route%/data/buy_price_list/{id}/update', name: 'admin_data_buy_price_list_update', requirements: ['id' => '\\d+'], methods: ['POST'])]
   113	    #[Template(template: '@admin/Data/buy_price_list_edit.twig')]
   114	    public function update(Request $request, MtbBuyPriceList $BuyPriceList): array|RedirectResponse
   115	    {
   116	        $form = $this->formFactory->createBuilder(BuyPriceListEditType::class, $BuyPriceList)->getForm();
   117	        $form->handleRequest($request);
   118	
   119	        if ($form->isSubmitted() && $form->isValid()) {
   120	            $price = (int) $form->get('price')->getData();
   121	            $this->buyPriceListUpdateAction->handle(new BuyPriceListUpdateInput(
   122	                $BuyPriceList,
   123	                $price,
   124	                $BuyPriceList->getNmPrice(),
   125	                $BuyPriceList->getSpecialFlg(),
   126	                $BuyPriceList->getCardCondition(),
   127	            ));
   128	
   129	            $event = new EventArgs(
   130	                [
   131	                    'form' => $form,
   132	                ],
   133	                $request
   134	            );
   135	            $this->eventDispatcher->dispatch($event, EccubeEvents::ADMIN_DATA_BUY_PRICE_LIST_UPDATE_COMPLETE);
   136	
   137	            $this->addSuccess('admin.register.complete', 'admin');
   138	
   139	            return $this->redirectToRoute('admin_data_buy_price_list');
   140	        }
   141	
   142	        return [
   143	            'form' => $form->createView(),
   144	            'BuyPriceList' => $BuyPriceList,
   145	        ];
   146	    }
   147	}
