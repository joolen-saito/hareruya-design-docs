    23	use Eccube\Repository\Master\MtbCardConditionRepository;
    24	use Symfony\Bridge\Twig\Attribute\Template;
    25	use Symfony\Component\HttpFoundation\Request;
    26	use Symfony\Component\Routing\Attribute\Route;
    27	
    28	class BuyDiscountController extends AbstractController
    29	{
    30	    public function __construct(
    31	        private readonly MtbCardConditionRepository $cardConditionRepository,
    32	        private readonly MtbBuyDiscountRepository $buyDiscountRepository,
    33	        private readonly DtbBuyDiscountCardConditionRepository $buyDiscountCardConditionRepository,
    34	    ) {
    35	    }
    36	
    37	    /**
    38	     * @return array<string, mixed>
    39	     */
    40	    #[Route(path: '/%eccube_admin_route%/data/buy_discount', name: 'admin_data_buy_discount', methods: ['GET'])]
    41	    #[Template(template: '@admin/Data/buy_discount.twig')]
    42	    public function index(Request $request): array
    43	    {
    44	        $event = new EventArgs([], $request);
    45	        $this->eventDispatcher->dispatch($event, EccubeEvents::ADMIN_DATA_BUY_DISCOUNT_INDEX_INITIALIZE);
    46	
    47	        $CardConditions = $this->cardConditionRepository->findAll();
    48	        $BuyDiscounts = $this->buyDiscountRepository->findAll();
    49	        $DtbBuyDiscountCardConditions = $this->buyDiscountCardConditionRepository->findAll();
    50	
    51	        $buyDiscountMap = [];
    52	        foreach ($DtbBuyDiscountCardConditions as $DtbBuyDiscountCardCondition) {
    53	            $buyDiscountMap[$DtbBuyDiscountCardCondition->getCardCondition()->getId()][$DtbBuyDiscountCardCondition->getBuyDiscount()->getId()] = $DtbBuyDiscountCardCondition->getRate();
    54	        }
    55	
    56	        return [
    57	            'CardConditions' => $CardConditions,
    58	            'BuyDiscounts' => $BuyDiscounts,
    59	            'buyDiscountMap' => $buyDiscountMap,
    60	        ];
    61	    }
    62	}
