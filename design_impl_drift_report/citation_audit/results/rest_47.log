    20	    $(function() {
    21	        eccube.setModeAndSubmitBanner = function(mode, keyname, keyid) {
    22	            document.hareruyaec_banner.mode.value = mode;
    23	            if (keyname !== undefined && keyname !== "" && keyid !== undefined && keyid !== "") {
    24	                document.hareruyaec_banner[keyname].value = keyid;
    25	            }
    26	
    27	            // 並び順が被りなく設定されているかの判定。
    28	            var sortNoValues = [];
    29	            var isEmpty = false;
    30	
    31	            $('[id^="hareruyaec_banner_sort_no_"]').each(function(index) {
    32	                if ($.trim($(this).val()).length === 0) {
    33	                    alert('並び順が空フォームがあります。');
    34	                    isEmpty = true;
    35	                    return false;
    36	                }
    37	                sortNoValues.push(parseInt($(this).val()));
    38	            });
    39	
    40	            if (isEmpty) {
    41	                return;
    42	            }
    43	
    44	            var duplications = sortNoValues.filter(function (x, i, self) {
    45	                return self.indexOf(x) === i && i !== self.lastIndexOf(x);
    46	            });
    47	
    48	            if (duplications.length > 0) {
    49	                alert('同じ並び順があります(' + duplications.join(',') + ')');
    50	                return
    51	            }
    52	
    53	            document.hareruyaec_banner.submit();
    54	        };
    55	
    56	    });
    57	</script>
