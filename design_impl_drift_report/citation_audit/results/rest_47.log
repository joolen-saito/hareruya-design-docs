   161	    /**
   162	     * バナー新規アップロード
   163	     * アップロード処理のみでDBに登録しない
   164	     * @param Application $app
   165	     * @param Request $request
   166	     * @return boolean
   167	     */
   168	    public function upload(Application $app, Request $request)
   169	    {
   170	        $form = $app['form.factory']
   171	            ->createBuilder('form')
   172	            ->add('file', 'file')
   173	            ->add('create_file', 'text')
   174	            ->add('shops', 'entity', [
   175	                'required' => false,
   176	                'expanded' => false,
   177	                'multiple' => false,
   178	                'class' => 'Plugin\HareruyaEc\Entity\MtbShop',
   179	                'empty_value' => '未選択',
   180	            ])
   181	            ->getForm()
   182	            ->handleRequest($request);
   183	
   184	        if (!$this->isFormValid($app, $form)) {
   185	            return [false, null];
   186	        }
   187	
   188	        $data = $form->getData();
   189	
   190	        if (empty($data['file'])) {
   191	            $this->error = ['message' => $app->trans('admin.error.select_no_file')];
   192	
   193	            return [false, null];
   194	        }
   195	        if (filesize($data['file']) > self::MAX_FILE_SIZE) {
   196	            $this->error = ['message' => sprintf($app->trans('admin.error.size_over'), self::MAX_FILE_SIZE)];
   197	
   198	            return [false, null];
   199	        }
   200	        if (exif_imagetype($data['file']) > 0 && exif_imagetype($data['file']) <= 3) {
   201	            $fileName = $this->convertStrToServer($data['file']->getClientOriginalName());
   202	            if (is_null($data['shops'])) {
   203	                $uploadDirectory = self::S3_DIRCTORY;
   204	            } else {
   205	                $uploadDirectory = self::S3_DIRCTORY . $data['shops']->getHtmlClassName() . '/';
   206	            }
   207	            $s3 = new S3AccessService($app);
   208	            $s3->setS3Directory($uploadDirectory);
   209	            $s3FilePath = $s3->putFile(['extension' => $data['file']->guessExtension(), 'file' => $data['file']]);
   210	
   211	            return [true, is_null($data['shops']) ? null : $data['shops']->getHtmlClassName()];
   212	        }
   213	        $this->error = ['message' => $app->trans('admin.error.not_image')];
   214	
   215	        return [false, null];
   216	    }
   217	
   218	    /**
   219	     * リンク登録
   220	     * 更新、削除についてもここの上書きで行われる
   221	     * @param Application $app
   222	     * @param Request $request
   223	     * @param boolean $isEventBanner true時イベントバナー、false時トップバナーを取扱う
   224	     * @param ArrayCollection $bannerList MtbBannerあるいはMtbTopBanner
   225	     * @param string|null $urlHtmlClass
   226	     * @return \Symfony\Component\HttpFoundation\Response
   227	     */
   228	    public function bannerSet(Application $app, Request $request, $isEventBanner = true, $bannerList, ?string $urlHtmlClass)
   229	    {
   230	        //バナー設定用フォーム
   231	        $bannerSetForm = $app['form.factory']
   232	            ->createBuilder('hareruyaec_banner', $bannerList)
   233	            ->getForm()
   234	            ->handleRequest($request);
   235	
   236	        // 画像アップロード側のsubmitであれば、そちらに遷移
   237	        if ($isUpload = $request->files->has('form')) {
   238	            list($result, $urlHtmlClass) = $this->upload($app, $request);
   239	        } else {
   240	            $result = $this->isFormValid($app, $bannerSetForm);
   241	        }
   242	
   243	        if (!$result) {
   244	            if (!$isUpload) {
   245	                $this->bannerError = [
   246	                    'message' => sprintf($app->trans('admin.error.text_over'), $app['config']['HareruyaEc']['const']['banner']['length']),
   247	                ];
   248	            }
   249	            if (!is_null($urlHtmlClass)) {
   250	                $selectedShop = $app['hareruya_ec.repository.shop']->findOneByHtmlClassName($urlHtmlClass);
   251	            }
   252	            //画像用フォーム
   253	            $form = $app['form.factory']->createBuilder('form')
   254	                ->add('file', 'file')
   255	                ->add('create_file', 'text')
   256	                ->add('shops', 'entity', [
   257	                    'required' => false,
   258	                    'expanded' => false,
   259	                    'multiple' => false,
   260	                    'class' => 'Plugin\HareruyaEc\Entity\MtbShop',
   261	                    'data' => $selectedShop ?? null,
   262	                    'required' => true,
   263	                ])
   264	                ->getForm();
   265	            //DB情報取得
   266	            $s3 = new S3AccessService($app);
   267	            $arrFileList = $s3->getFiles(self::S3_DIRCTORY);
   268	            $shops = $app['hareruya_ec.repository.shop']->findAll([], ['id' => 'ASC']);
   269	
   270	            return $app->render('HareruyaEc/Resource/template/admin/Banner/banner.twig', [
   271	                'form' => $form->createView(),
   272	                'bannerSetForm' => $bannerSetForm->createView(),
   273	                'bannerList' => $bannerList,
   274	                'arrFileList' => $arrFileList,
   275	                'error' => $this->error,
   276	                'bannerError' => $this->bannerError,
   277	                'isEventBanner' => $isEventBanner,
   278	                'shops' => $shops,
   279	                'htmlClass' => $urlHtmlClass,
   280	            ]);
   281	        }
   282	
   283	        if ($isUpload) {
   284	            if (is_null($urlHtmlClass)) {
   285	                return $app->redirect($app->url($isEventBanner ? 'admin_banner' : 'admin_top_banner') . '#upload_wrap');
   286	            } else {
   287	                return $app->redirect($app->url($isEventBanner ? 'admin_banner_narrow' : 'admin_top_banner_narrow', ['html_class' => $urlHtmlClass]) . '#upload_wrap');
   288	            }
   289	        }
   290	
   291	        $sortedBannerList = [];
   292	        // 並び順をkeyに配列の生成
   293	        foreach ($bannerList as $banner) {
   294	            $sortNo = 'sort_no_' . $banner->getId();
   295	            $sortNoValue = $bannerSetForm[$sortNo]->getData();
   296	
   297	            $sortedBannerList[$sortNoValue] = [
   298	                    'image' => 'image_url_' . $banner->getId(),
   299	                    'link' => 'link_' . $banner->getId(),
   300	                    'dispType' => 'dispType_' . $banner->getId(),
   301	                    'shops' => 'shop_' . $banner->getId(),
   302	                    'languages' => 'language_' . $banner->getId(),
   303	                    'imageAlt' => 'image_alt_' . $banner->getId(),
   304	                ];
   305	        }
   306	        // keyでソート
   307	        ksort($sortedBannerList);
   308	
   309	        // 配列のkeyを1からの順番に変換
   310	        $sortedBannerList = array_combine(range(1, count($sortedBannerList)), $sortedBannerList);
   311	
   312	        foreach ($bannerList as $banner) {
   313	            $banner->setImageUrl($bannerSetForm[$sortedBannerList[$banner->getId()]['image']]->getData());
   314	            $banner->setLink($bannerSetForm[$sortedBannerList[$banner->getId()]['link']]->getData() ?? '');
   315	            $banner->setDispType($bannerSetForm[$sortedBannerList[$banner->getId()]['dispType']]->getData());
   316	            if ($isEventBanner) {
   317	                $shopEntities = $app['hareruya_ec.repository.shop']->findById($bannerSetForm[$sortedBannerList[$banner->getId()]['shops']]->getData());
   318	                $banner->setShops($shopEntities);
   319	            }
   320	            $languageEntities = $app['hareruya_ec.repository.language']->findById($bannerSetForm[$sortedBannerList[$banner->getId()]['languages']]->getData());
   321	            $banner->setLanguages($languageEntities);
   322	            $banner->setImageAlt($bannerSetForm[$sortedBannerList[$banner->getId()]['imageAlt']]->getData());
   323	
   324	            /* 登録 */
   325	            $app['orm.em']->persist($banner);
   326	        }
   327	        $app['orm.em']->flush();
   328	
   329	        if (is_null($urlHtmlClass)) {
   330	            return $app->redirect($app->url($isEventBanner ? 'admin_banner' : 'admin_top_banner'));
   331	        } else {
   332	            return $app->redirect($app->url($isEventBanner ? 'admin_banner_narrow' : 'admin_top_banner_narrow', ['html_class' => $urlHtmlClass]));
   333	        }
   334	    }
