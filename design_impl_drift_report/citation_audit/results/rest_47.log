    18	use Aws\S3\Exception\S3Exception;
    19	use Eccube\Service\S3AccessService;
    20	
    21	class TopBannerDeleteAction
    22	{
    23	    private const TOP_BANNER_S3_PREFIX = 'banner/top/';
    24	
    25	    public function __construct(
    26	        private readonly S3AccessService $s3AccessService,
    27	    ) {
    28	    }
    29	
    30	    public function handle(string $objectKey): void
    31	    {
    32	        if (!str_starts_with($objectKey, self::TOP_BANNER_S3_PREFIX)) {
    33	            throw new \RuntimeException('admin.common.error_invalid_request');
    34	        }
    35	
    36	        try {
    37	            $this->s3AccessService->deleteFile($objectKey);
    38	        } catch (S3Exception $e) {
    39	            throw new \RuntimeException('admin.common.delete_error', 0, $e);
    40	        }
    41	    }
    42	}
