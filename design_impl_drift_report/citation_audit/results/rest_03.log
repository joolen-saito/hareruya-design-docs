    84	    #[Route(path: '/mypage/login', name: 'mypage_login', methods: ['GET', 'POST'])]
    85	    #[Template(template: 'Mypage/login.twig')]
    86	    public function login(Request $request, AuthenticationUtils $utils): RedirectResponse|array
    87	    {
    88	        if ($this->isGranted('IS_AUTHENTICATED_FULLY')) {
    89	            log_info('認証済のためログイン処理をスキップ');
    90	
    91	            return $this->redirectToRoute('mypage');
    92	        }
    93	
    94	        $builder = $this->formFactory
    95	            ->createNamedBuilder('', CustomerLoginType::class);
    96	
    97	        if ($this->isGranted('IS_AUTHENTICATED_REMEMBERED')) {
    98	            $Customer = $this->getUser();
    99	            if ($Customer instanceof Customer) {
   100	                $builder->get('login_email')
   101	                    ->setData($Customer->getEmail());
   102	            }
   103	        }
   104	
   105	        $event = new EventArgs(
   106	            [
   107	                'builder' => $builder,
   108	            ],
   109	            $request
   110	        );
   111	        $this->eventDispatcher->dispatch($event, EccubeEvents::FRONT_MYPAGE_MYPAGE_LOGIN_INITIALIZE);
   112	
   113	        $form = $builder->getForm();
   114	
   115	        return [
   116	            'error' => $utils->getLastAuthenticationError(),
   117	            'form' => $form->createView(),
   118	        ];
   119	    }
