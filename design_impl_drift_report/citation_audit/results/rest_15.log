   266	    public function update(Request $request): RedirectResponse|array
   267	    {
   268	        // タイムアウトを無効にする
   269	        set_time_limit(0);
   270	
   271	        $builder = $this->formFactory->createBuilder(StockHistoryDisposalType::class, null, []);
   272	        $form = $builder->getForm();
   273	        $form->handleRequest($request);
   274	        $formData = $form->getData();
   275	        $Member = $this->getMember();
   276	
   277	        log_info('欠品理由の編集');
   278	
   279	        try {
   280	            $inputs = [
   281	                'stockHistoryId' => (int) $formData['stock_history_id'],
   282	                'disposalReason' => (string) $formData['disposal_reason'],
   283	                'memberId' => (int) $Member->getId(),
   284	            ];
   285	            $this->stockHistoryRepository->updateDisposalReason($inputs);
   286	        } catch (\Exception $e) {
   287	            $this->addError('admin.common.save_error', 'admin');
   288	
   289	            return $this->redirectToRoute('admin_stock_history');
   290	        }
   291	
   292	        $event = new EventArgs(
   293	            [
   294	                'form' => $form,
   295	                'formData' => $formData,
   296	                'Member' => $Member,
   297	            ],
   298	            $request
   299	        );
   300	        $this->eventDispatcher->dispatch($event, EccubeEvents::ADMIN_STOCK_HISTORY_UPDATE_COMPLETE);
   301	
   302	        $this->addSuccess('admin.common.save_complete', 'admin');
   303	
   304	        return $this->redirectToRoute('admin_stock_history');
   305	    }
