   135	
   136	        $otcBuyOrders = $this->app['hareruya_ec.repository.otc_buy_order']->findBy(['otcBuyOrderId' => $ids]);
   137	        $this->app['hareruya_ec.repository.otc_buy_order']->updateOtcBuyOrderStatusInExport($this->app, $ids);
