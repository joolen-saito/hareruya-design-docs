    45	    public function __construct(
    46	        protected CsvExportService $csvExportService,
    47	        protected DtbDeckRepository $deckRepository,
    48	    ) {
    49	    }
    50	
    51	    /**
    52	     * 検索条件に合致するカード採用データを CSV でストリーミング出力する。
    53	     * ファイル名は `used_card_product_YmdHis.csv` 形式。
    54	     *
    55	     * @param array<string, mixed> $searchData
    56	     */
    57	    public function exportBySearchData(array $searchData): StreamedResponse
    58	    {
    59	        $response = new StreamedResponse();
    60	        $response->setCallback(function () use ($searchData): void {
    61	            $rows = $this->deckRepository->getUsedCardsCsvExportData($searchData);
    62	            $this->csvExportService->fopen();
    63	            $this->csvExportService->fputcsv(array_values(self::CSV_HEADER));
    64	
    65	            foreach ($rows as $row) {
    66	                $orderedRow = array_map(
    67	                    fn (string $key): string => (string) ($row[$key] ?? ''),
    68	                    array_keys(self::CSV_HEADER),
    69	                );
    70	                $this->csvExportService->fputcsv($orderedRow);
    71	            }
    72	
    73	            $this->csvExportService->fclose();
    74	        });
    75	
    76	        $now = new \DateTime();
    77	        $filename = 'used_card_product_'.$now->format('YmdHis').'.csv';
    78	        $response->headers->set('Content-Type', 'application/octet-stream');
    79	        $response->headers->set('Content-Disposition', 'attachment; filename='.$filename);
    80	
    81	        return $response;
    82	    }
    83	}
