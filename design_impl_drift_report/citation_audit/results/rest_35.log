    38	<div class="c-outsideBlock search-box-inner">
    39	    <form id='search_form' method="post" action="{{ url('admin_event_index') }}">
    40	        {{ form_widget(searchForm._token) }}
    41	        {{ form_widget(searchForm.sortkey) }}
    42	        {{ form_widget(searchForm.sorttype) }}
    43	        <div class="c-outsideBlock__contents">
    44	            <div class="row justify-content-between align-items-start">
    45	                <div class="col-6">
    46	                    <div class="mb-2">
    47	                        {{ form_widget(searchForm.multi, {'attr': {'placeholder': 'admin.event.multi_search_placeholder'|trans}}) }}
    48	                        {{ form_errors(searchForm.multi) }}
    49	                    </div>
    50	                    <div class="d-inline-block mb-3" data-bs-toggle="collapse" href="#searchDetail"
    51	                         aria-expanded="true" aria-controls="searchDetail">
    52	                        <a><i class="fa fa-minus-square-o fw-bold me-1"></i><span class="fw-bold">{{ 'admin.common.search_detail'|trans }}</span></a>
    53	                    </div>
    54	                </div>
    55	                <div class="col-auto">
    56	                    <a class="btn btn-ec-conversion" href="{{ url('admin_event_create') }}">{{ 'admin.common.create__new'|trans }}</a>
    57	                </div>
    58	            </div>
    59	        </div>
    60	        <div class="c-subContents collapse ec-collapse show" id="searchDetail">
    61	            <div class="row mb-2">
    62	                <div class="col-6">
    63	                    <label class="col-form-label">{{ 'admin.event.search.start_date'|trans }}</label>
    64	                    <div class="row align-items-center">
    65	                        <div class="col">
   125	                                <label for="sort_by_pulldown" class="col-form-label mb-0 small text-muted">{{ 'admin.common.sort'|trans }}</label>
   126	                                <select id="sort_by_pulldown" class="form-select form-select-sm" style="width: auto;">
   127	                                    <option value="default" {% if (searchForm.sortkey.vars.value|default('default')) == 'default' %}selected{% endif %}>{{ 'admin.event.list.id'|trans }}</option>
   128	                                    <option value="eventName" {% if (searchForm.sortkey.vars.value|default('')) == 'eventName' %}selected{% endif %}>{{ 'admin.event.name'|trans }}</option>
   129	                                </select>
   130	                                <select id="sort_order_pulldown" class="form-select form-select-sm" style="width: auto;">
   131	                                    {% set currentSortType = searchForm.sorttype.vars.value|default('d') %}
   132	                                    <option value="a" {% if currentSortType == 'a' %}selected{% endif %}>{{ 'admin.common.sort_asc'|trans }}</option>
   133	                                    <option value="d" {% if currentSortType != 'a' %}selected{% endif %}>{{ 'admin.common.sort_desc'|trans }}</option>
   134	                                </select>
   135	                            </div>
   136	                        </div>
   137	                    </div>
