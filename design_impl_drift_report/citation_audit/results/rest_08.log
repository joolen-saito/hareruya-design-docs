    86	                $sideMenuChildCategories = $form['sideMenuChildCategory']->getData();
    87	                $sideMenuChildCategoryList = $app['hareruya_ec.repository.category_sub']->getSideMenuChildCategory($id);
    88	                foreach ($sideMenuChildCategoryList as $sideMenuChildCategory) {
    89	                    $sideMenuChildCategory->setSideMenuParentCategoryId(null);
    90	                    $app['orm.em']->persist($sideMenuChildCategory);
    91	                }
    92	                $app['orm.em']->flush();
    93	
    94	                if (!empty($sideMenuChildCategories)) {
    95	                    foreach ($sideMenuChildCategories as $childCategory) {
    96	                        if (isset($childCategory['categorySub'])) {
    97	                            $id ? $childCategory->getCategorySub()->setSideMenuParentCategoryId($id) : $childCategory->getCategorySub()->setSideMenuParentCategoryId($categorySub->getCategoryId());
    98	                            $app['orm.em']->persist($childCategory);
    99	                        } else {
   100	                            $categorySubEntity = $app['hareruya_ec.repository.category_sub']->findOneByCategoryId($childCategory->getId());
   101	                            $id ? $categorySubEntity->setSideMenuParentCategoryId($id) : $categorySubEntity->setSideMenuParentCategoryId($categorySub->getCategoryId());
   102	                            $app['orm.em']->persist($categorySubEntity);
   103	                        }
   104	                    }
   105	                    $app['orm.em']->flush();
   106	                }
   107	
   108	                $app['hareruya_ec.repository.category_sort']->deleteByTagId($categorySub->getCategoryId());
   109	                $priorityCodes = explode("\r\n", $categorySub->getPriorityProducts());
   110	                $priorityCodes = array_filter($priorityCodes);
   111	                $priorityCodes = array_unique($priorityCodes);
   112	                $subClassEntities = $app['hareruya_ec.repository.product_sub_class']->getSubClassByCodeAndCategory($priorityCodes, $categorySub->getCategoryId());
   113	                $codesCount = count($priorityCodes);
   114	
   115	                foreach ($priorityCodes as $index => $code) {
   116	                    if (!isset($subClassEntities[$code])) {
   117	                        $app->addError(sprintf($app->trans('admin.error.not_exist_code'), $code, $categorySub->getName()), 'admin');
   118	
   119	                        if ($id) {
   120	                            return $app->redirect($app->url('admin_product_category_edit', ['id' => $id]));
   121	                        } else {
   122	                            return $app->redirect($app->url('admin_product_category_show', ['parent_id' => $Parent->getId()]));
   123	                        }
   124	                    }
   125	                    $categorySort = new DtbCategorySort();
   126	                    $categorySort->setProductSubClass($subClassEntities[$code])
   127	                        ->setCategoryId($categorySub->getCategoryId())
   128	                        ->setRank($codesCount - $index);
   129	                    $app['orm.em']->persist($categorySort);
   130	                }
   131	
   132	                $app['orm.em']->flush();
   133	
   134	                if ($status) {
   135	                    log_info('カテゴリ登録完了', array($id));
   136	
   137	                    $event = new EventArgs(
   138	                        [
   139	                            'form' => $form,
   140	                            'Parent' => $Parent,
   141	                            'TargetCategory' => $TargetCategory,
   142	                        ],
   143	                        $request
   144	                    );
   145	                    $app['eccube.event.dispatcher']->dispatch(EccubeEvents::ADMIN_PRODUCT_CATEGORY_INDEX_COMPLETE, $event);
   146	                    $app->addSuccess('admin.category.save.complete', 'admin');
   147	
   148	                    return $app->redirect($app->url('admin_product_category_edit', ['id' => $categorySub->getCategoryId()]));
   149	                } else {
   150	                    log_info('カテゴリ登録エラー', array($id));
   151	                    $app->addError('admin.category.save.error', 'admin');
   152	                }
   153	            }
   154	        }
   155	
   156	        $Categories = $app['hareruya_ec.repository.category']->getList($Parent);
   157	
   158	        // ツリー表示のため、ルートからのカテゴリを取得
   159	        $TopCategories = $app['hareruya_ec.repository.category']->getList(null);
   160	
   161	        return $app->render('Product/category.twig', [
   162	            'form' => $form->createView(),
   163	            'Parent' => $Parent,
   164	            'Categories' => $Categories,
   165	            'TopCategories' => $TopCategories,
   166	            'TargetCategory' => $TargetCategory,
   167	            'CategoryNameEnList' => $app['hareruya_ec.repository.category_sub']->getNameEnList(),
   168	        ]);
   169	    }
   170	}
