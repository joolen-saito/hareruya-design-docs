   102	                        '_token' : this.dataset.csrf,
   103	                        'batch' : this.dataset.batch
   104	                    },
   105	                    url: this.dataset.url,
   106	
   107	                })
   108	                .done(function (data, status, jqXHR) {
   109	                    alert(data.message);
   110	                    location.reload(true);
   111	                })
   112	                .fail(function (jqXHR, status, error) {
   113	                    document.body.innerHTML = jqXHR.responseText;
   114	                });
   115	            });
   116	
   117	            var select2Selector = $("#admin_category_sideMenuChildCategory");
   118	            select2Selector.select2({width:"150%"});
   119	        });
   120	    </script>
