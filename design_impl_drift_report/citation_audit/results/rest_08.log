    85	                    .css("display", "");
    86	
    87	            // クリックでひらく
    88	            $("#category_tree li svg").on("click", function(){
    89	                $(this).parent().find("ul").slideToggle(100);
    90	            });
    91	
    92	            //バッチ実行ボタン
    93	            $("#batch-1").on('click', function(){
    94	                if ($(this).prop('disabled') || !confirm(this.dataset.message)) {
    95	                    return;
    96	                }
    97	                $(this).prop('disabled',true);
    98	                $.ajax({
    99	                    type: 'POST',
   100	                    dataType: 'JSON',
