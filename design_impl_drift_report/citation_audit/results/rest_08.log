    /**
     * 商品の販売地域制限を取得
     *
     * @param array<int, mixed> $productClassIdList
     *
     * @return array<int, mixed>
     */
    public function getRegionRestrictionIdlist(array $productClassIdList): array
    {
        $qb = $this->createQueryBuilder('pc');
        $result = $qb->select('rr.id')
            ->join('pc.Product', 'p')
            ->join('p.RegionRestriction', 'rr')
            ->where($qb->expr()->in('pc.id', $productClassIdList))
            ->getQuery()
            ->getResult();

        return array_column($result, 'id');
    }

