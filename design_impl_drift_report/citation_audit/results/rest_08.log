    /**
    * DtbProductSubをCSV出力できる形にコンバート
    *
    * @param Array $productSubs
    * @return Array
    */
    public function convertExportCsvRows($productSubs)
    {
     * CSVを出力する
     *
     * @param array<int, mixed> $productIds
     *
     * @return StreamedResponse
     */
    public function exportCsv(array $productIds): StreamedResponse
    {
        if (empty($productIds) || !$Products = $this->productRepository->findBy(['id' => $productIds])) {
            throw new \RuntimeException($this->translator->trans('admin.csv.error.export.not_registered'));
        }
        $csvRows = $this->convertExportCsvRows($Products, $this->baseInfoRepository->getMallBaseInfo());
        if ($csvRows === []) {
            throw new \RuntimeException($this->translator->trans('admin.csv.error.export.no_goods_data'));
        }
        $response = new StreamedResponse();

        $headerKeys = array_keys($this->csvHeader);
        $response->setCallback(function () use ($csvRows, $headerKeys): void {
            $this->csvExportService->fopen();
            $this->csvExportService->fputcsv($headerKeys);
            foreach ($csvRows as $row) {
                $this->csvExportService->fputcsv(array_map(fn (string $key) => $row[$key] ?? '', $headerKeys));
            }

