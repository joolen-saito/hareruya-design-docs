    38	    <script>
    39	        $(function() {
    40	            var oldRanks = [];
    41	            // 画面の中のrank一覧を保持
    42	            $("div.tableish > .item_box").each(function() {
    43	                oldRanks.push(this.dataset.rank);
    44	            });
    45	            // rsort
    46	            oldRanks.sort(function(a,b){return a - b;}).reverse();
    47	
    48	            $("div.tableish").sortable({
    49	                items: '> .item_box',
    50	                cursor: 'move',
    51	                update: function(e, ui) {
    52	                    $("body").append($('<div class="modal-backdrop in"></div>'));
    53	                    updateRank();
    54	                }
    55	            });
    56	
    57	            var updateRank = function() {
    58	                // 並び替え後にrankを更新
    59	                var newRanks = {};
    60	                var i = 0;
    61	                $("div.tableish > .item_box").each(function() {
    62	                    newRanks[this.dataset.categoryId] = oldRanks[i];
    63	                    i++;
    64	                });
    65	
    66	                $.ajax({
    67	                    url: '{{ url('admin_product_category_rank_move') }}',
    68	                    type: 'POST',
    69	                    data: newRanks,
    70	                }).done(function(data) {
    71	                    console.log(data);
    72	                    $(".modal-backdrop").remove();
    73	                }).fail(function() {
    74	                    console.log('fail');
    75	                    $(".modal-backdrop").remove();
    76	                });
    77	            };
    78	
    79	            // カテゴリツリー開閉
