   119	    public function findForFrontDetail(int $productId): ?Product
   120	    {
   121	        $qb = $this->createQueryBuilder('p');
   122	        $qb->addSelect(['pc', 'lang', 'cardCondition', 'pi', 'pt', 'cd', 'c', 'ps'])
   123	            ->innerJoin('p.ProductClasses', 'pc')
   124	            ->innerJoin('pc.ProductStock', 'ps')
   125	            ->leftJoin('pc.Language', 'lang')
   126	            ->leftJoin('pc.CardCondition', 'cardCondition')
   127	            ->leftJoin('p.ProductImage', 'pi')
   128	            ->leftJoin('p.ProductTag', 'pt')
   129	            ->leftJoin('p.CardDetail', 'cd')
   130	            ->leftJoin('cd.Card', 'c')
   131	            ->where('p.id = :id')
   132	            ->andWhere('p.Status = :status')
   133	            ->andWhere('pc.visible = :visible')
   134	            ->andWhere('pc.price02 > :minPrice')
   135	            ->setParameter('id', $productId)
   136	            ->setParameter('status', ProductStatus::DISPLAY_SHOW)
   137	            ->setParameter('visible', true)
   138	            ->setParameter('minPrice', 0)
   139	            ->orderBy('lang.id', 'ASC')
   140	            ->addOrderBy('pc.price02', 'DESC')
   141	            ->addOrderBy('pc.id', 'ASC');
