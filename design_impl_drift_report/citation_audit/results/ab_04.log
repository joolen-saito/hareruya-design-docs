   301	    /**
   302	     * requestの商品名から商品の一覧を取得
   303	     * @param Request $request
   304	     * @return JsonResponse
   305	     */
   306	    public function getProductListByNameAction(Request $request): JsonResponse
   307	    {
   308	        set_time_limit(120);
   309	        $productName = $request->get('product');
   310	        if (empty($productName)) {
   311	            return $this->json([
   312	                'code' => Response::HTTP_NOT_FOUND,
   313	                'message' => 'Not Found'
   314	            ], Response::HTTP_NOT_FOUND);
   315	        }
   316	
   317	        $keySets = $this->getDoctrine()
   318	            ->getManager()
   319	            ->getRepository(DtbProductSubClass::class)
   320	            ->getProductIdsByProductName($productName);
   321	
   322	        if (empty($keySets)) {
   323	            return $this->json([
   324	                'code' => Response::HTTP_NOT_FOUND,
   325	                'message' => 'Not Found'
   326	            ], Response::HTTP_NOT_FOUND);
   327	        }
   328	
   329	        $productSubClasses = $this->getDoctrine()
   330	            ->getManager()
   331	            ->getRepository(DtbProductSubClass::class)
   332	            ->getProductsDataById($keySets);
   333	
   334	        if (empty($productSubClasses)) {
   335	            return $this->json([
   336	                'code' => Response::HTTP_NOT_FOUND,
   337	                'message' => 'Not Found'
   338	            ], Response::HTTP_NOT_FOUND);
   339	        }
   340	
   341	        $results = [];
   342	        foreach ($productSubClasses as $productSubClass) {
   343	            // 商品ID+言語+高額商品コードでkeyとし、配列を作成
   344	            $productKey = $productSubClass['productId'] . '_' . $productSubClass['languageCode'] . '_' . $productSubClass['highPriceCode'];
   345	            if (!array_key_exists($productKey, $results)) {
   346	                // 商品名
   347	                $resultProductName = !empty($productSubClass['cardDetailId']) ? '【' . $productSubClass['languageCode'] . '】' . $productSubClass['productName'] : $productSubClass['productName'];
   348	                $results[$productKey] = [
   349	                    'product_id' => $productSubClass['productId'],
   350	                    'product_name' => $resultProductName,
   351	                    'language_code' => $productSubClass['languageCode'],
   352	                    'high_price_code' => $productSubClass['highPriceCode'],
   353	                    'categories' => explode('|', $productSubClass['categoryNames']),
   354	                    'region_restriction' => $productSubClass['regionRestrictionName'],
   355	                    'product_classes' => [],
   356	                ];
   357	            }
   358	            if ($productSubClass['cardConditionId'] === MtbCardCondition::NM_ID || $productSubClass['price'] >= (int)$this->container->getParameter('condition_display_min_price')) {
   359	                $productClass = [
   360	                    'product_class_id' => $productSubClass['productClassId'],
   361	                    'product_code' => $productSubClass['productCode'],
   362	                    'card_condition_code' => $productSubClass['conditionCode'],
   363	                    'price' => (int)$productSubClass['price'],
   364	                    'stock' => (int)$productSubClass['stock'],
   365	                    'product_class_images' => [],
   366	                ];
   367	                foreach (explode(',', $productSubClass['imageFileName']) as $imageFile) {
   368	                    $productClass['product_class_images'][] = S3PathUtil::getS3Url($this->container, $imageFile);
   369	                }
   370	
   371	                $results[$productKey]['product_classes'][] = $productClass;
   372	            }
   373	            if (count($results) >= 100) {
   374	                break;
   375	            }
   376	        }
   377	
   378	        // その他商品の表示チェック
   379	        foreach ($results as $key => $product) {
   380	            if (!$this->isDisplayOtherConditions($product['product_classes'])) {
   381	                $results[$key]['product_classes'] = $this->getProductClassesNmOnly($product);
   382	            }
   383	        }
   384	        $response = $this->json([
   385	            'code' => Response::HTTP_OK,
   386	            'products' => array_values($results)
   387	        ], Response::HTTP_OK);
   388	
   389	        return $response;
   390	    }
