   405	        $productDetails = $this->getDoctrine()
   406	            ->getManager()
   407	            ->getRepository(DtbProduct::class)
   408	            ->getProductDetailById($productId, $languageCode);
   409	
   410	        if (empty($productDetails)) {
   411	            return $this->json([
   412	                'code' => Response::HTTP_NOT_FOUND,
   413	                'message' => 'Not Found'
   414	            ], Response::HTTP_NOT_FOUND);
   415	        }
   416	
   417	        $response = [
   418	            'code' => Response::HTTP_OK,
   419	            'weekly_sold' => 0
   420	        ];
   421	        foreach ($productDetails as $index => $productDetail) {
   422	            if ($index === array_key_first($productDetails)) {
   423	                // 商品情報
   424	                $response['product_id'] = $productDetail['productId'];
   425	                $productName = !empty($productDetail['cardName']) ? '【' . $productDetail['languageCode'] . '】' . $productDetail['productName'] : $productDetail['productName'];
   426	                $response['product_name'] = $productName;
   427	                $response['language_code'] = $productDetail['languageCode'];
   428	                $response['description_detail'] = $productDetail['descriptionDetail'];
   429	                $response['categories'] = explode('|', $productDetail['categoryNames']);
   430	                $response['region_restriction'] = $productDetail['regionRestrictionName'];
   431	                $response['product_classes'] = [];
   432	                // カード情報
   433	                $response['card_detail'] = null;
   434	                if (!empty($productDetail['cardName'])) {
   435	                    $response['card_detail'] = [
   436	                        'card_name' => $productDetail['cardName'],
   437	                        'colors' => $productDetail['colors'],
   438	                        'mana_cost' => $productDetail['manaCost'],
   439	                        'rarity' => $productDetail['rarityName'],
   440	                        'card_type' => $productDetail['cardtypes'],
   441	                        'card_text' => $productDetail['textJp'],
   442	                        'flavor' => $productDetail['flavorJp'],
   443	                        'power_toughness' => (is_null($productDetail['power']) || $productDetail['power'] === '') ? null : $productDetail['power'] . '/' . $productDetail['toughness'],
   444	                        'loyalty' => (is_null($productDetail['loyalty']) || $productDetail['loyalty'] === '') ? null : $productDetail['loyalty'],
   445	                        'cardset' => $productDetail['cardsetName'],
   446	                        'cardsetblock' => $productDetail['cardsetblockName'],
   447	                        'illustrator' => $productDetail['illustratorName'],
   448	                        'formats' => $productDetail['formats'],
   449	                    ];
   450	                }
   451	            }
   452	            // 週間販売数
   453	            $response['weekly_sold'] += $productDetail['orderQuantity04'];
   454	            if ($productDetail['cardConditionId'] === MtbCardCondition::NM_ID || $productDetail['price'] >= (int)$this->container->getParameter('condition_display_min_price')) {
   455	                // 商品規格
   456	                $productClass = [
   457	                    'product_class_id' => $productDetail['productClassId'],
   458	                    'product_code' => $productDetail['productCode'],
   459	                    'high_price_code' => $productDetail['highPriceCode'],
   460	                    'card_condition_code' => $productDetail['conditionCode'],
   461	                    'price' => (int)$productDetail['price'],
   462	                    'sale_limit' => !empty($productDetail['saleLimit']) ? (int)$productDetail['saleLimit'] : null,
   463	                    'stock' => (int)$productDetail['stock'],
   464	                ];
   465	                $productClass['product_class_images'] = [];
   466	                // 商品画像追加
   467	                foreach (explode(',', $productDetail['imageFileNames']) as $imageFile) {
   468	                    $productClass['product_class_images'][] = S3PathUtil::getS3Url($this->container, $imageFile);
   469	                }
   470	
   471	                $response['product_classes'][] = $productClass;
   472	            }
   473	        }
   474	
   475	        return $this->json($response, Response::HTTP_OK);
   476	    }
