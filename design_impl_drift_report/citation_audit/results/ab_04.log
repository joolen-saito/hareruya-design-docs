   284	    public function getProductClassByUpdateDate($strFromDate, $strToDate)
   285	    {
   286	        ini_set('memory_limit', '1024M');
   287	        $fromDate = (new \DateTime($strFromDate))->modify('00:00:00');
   288	        $toDate = (new \DateTime($strToDate))->modify('23:59:59');
   289	        $result = $this->getDoctrine()
   290	            ->getManager()
   291	            ->getRepository(DtbProductClass::class)
   292	            ->getProductClassesByUpdateDate($fromDate, $toDate);
   293	
   294	        $response = [];
   295	        $response['count'] = count($result);
   296	        $response['result'] = $result;
   297	
   298	        return $response;
   299	    }
