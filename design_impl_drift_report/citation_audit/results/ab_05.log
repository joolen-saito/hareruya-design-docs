   140	        $BuyOrderStatus = $this->buyOrderStatusRepository->find((int) $statusId);
   141	        if (!$BuyOrderStatus instanceof MtbBuyOrderStatus) {
   142	            // 旧システム互換性目的：「店頭」ではないが、「店頭買取」という表現を使っている
   143	            throw new InvalidParameterException('正しい店頭買取ステータスIDを入力してください');
   144	        }
