   205	
   206	                    foreach ($oldApplicationPrices as $oldApplicationPrice) {
   207	                        $applicationPrice = new DtbApplicationPrice();
   208	                        $applicationPrice
   209	                            ->setBuyMainCard($buyMainCard)
   210	                            ->setApplicationPrice($oldApplicationPrice->getApplicationPrice())
   211	                            ->setCardCondition($oldApplicationPrice->getCardCondition());
   212	
   213	                        $em->persist($applicationPrice);
   214	                        $newApplicationPrices[] = $applicationPrice;
   215	                    }
   216	
   217	                    $buyMainCard
   218	                        ->setApplicationPrices($newApplicationPrices);
   219	                }
   220	
   221	                $buyMainCard
   222	                    ->setBuyOrderId($buyOrder->getBuyOrderId())
   223	                    ->setProduct($productClass->getProduct())
   224	                    ->setCount($orderDetail['quantity'])
   225	                    ->setPrice($orderDetail['price'])
   226	                    ->setLanguage($this->getDoctrine()->getRepository(MtbLanguage::class)->find($orderDetail['language_id']))
   227	                    ->setCardConditionId($orderDetail['condition_id'])
   228	                    ->setFoilFlg($orderDetail['foil_flg'])
   229	                    ->setPurchaseCategory($orderDetail['purchase_category'])
   230	                    ->setBuyOrder($buyOrder);
   231	
   232	                $buyOrderMainCards[] = $buyMainCard;
   233	            }
   234	
   235	            // まとめて買取(商品)のID。買取カテゴリまとめて買取の商品ではないので注意
   236	            $bulkPurchaseId = (int)($this->getDoctrine()
   237	                ->getRepository(MtbOption::class)
   238	                ->findOneBy(['optionKey' => MtbOption::BULK_PURCHASE_ID_KEY])
   239	                ->getOptionValue());
   240	
   241	            // サプライやパックの情報はアプリから送られてこないため、合計額算出と削除防止措置のみ行う
   242	            foreach ($buyMainCards as $supplyBuyMainCard) {
   243	                // まとめて買取(商品)は削除するため申込時買取価格の削除のみ行う
   244	                if ($supplyBuyMainCard->getProductId() === $bulkPurchaseId) {
   245	                    $bulkPurchaseApplicationPrices = $this->getDoctrine()
   246	                        ->getRepository(DtbApplicationPrice::class)
   247	                        ->findByBuyMainCard($supplyBuyMainCard);
   248	                    foreach ($bulkPurchaseApplicationPrices as $bulkPurchaseApplicationPrice) {
   249	                        $em->remove($bulkPurchaseApplicationPrice);
   250	                    }
   251	
   252	                    continue;
   253	                }
   254	
   255	                $productSub = $supplyBuyMainCard->getProduct()
   256	                    ->getProductSub();
   257	
   258	                // カード詳細IDが未設定の場合、サプライやパックとなる
   259	                if (empty($productSub->getCardDetailId())) {
   260	                    $price = $supplyBuyMainCard->getPrice();
   261	                    if (!empty($price)) {
   262	                        $total += $price * $supplyBuyMainCard->getCount();
   263	                    }
   264	
   265	                    // 削除対象から外す
   266	                    $savingBuyMainCardIds[] = $supplyBuyMainCard->getBuyMainCardId();
   267	                }
   268	            }
   269	
   270	            $nowDate = new \DateTime();
   271	            $total = ceil($total / 10) * 10;
   272	            $buyOrder
   273	                ->setBuyOrderStatusId($buyOrderStatus->getId())
   274	                ->setTotalPrice($total)
   275	                ->setBuyMainCards($buyOrderMainCards)
   276	                ->setBuyOrderIndivisualInputProducts($buyOrderIndivisualInputProducts)
   277	                ->setMember($this->member)
   278	                ->setUpdateDate($nowDate);
   279	
   280	            // 更新を行なったエンティティで無い場合削除する
   281	            foreach ($buyMainCards as $removeCard) {
   282	                if (!is_null($removeCard) && !in_array($removeCard->getBuyMainCardId(), $savingBuyMainCardIds, true)) {
   283	                    // 買取代表カードに紐づく古い申込時買取価格を削除する
   284	                    $removeApplicationPrices = $removeCard->getApplicationPrices();
   285	                    foreach ($removeApplicationPrices as $removeApplicationPrice) {
   286	                        $em->remove($removeApplicationPrice);
   287	                    }
   288	                    $em->remove($removeCard);
   289	                }
   290	            }
   291	            foreach ($indivisualInputProducts as $removeProduct) {
   292	                if (!is_null($removeProduct) && !in_array($removeProduct->getBuyOrderIndivisualInputProductId(), $savingBuyOrderIndivisualInputProductIds, true)) {
   293	                    $em->remove($removeProduct);
   294	                }
   295	            }
   296	
   297	            $em->persist($buyOrder);
   298	
   299	            if ($oldStatus !== $buyOrderStatus->getId()) {
   300	                $buyOrder
   301	                    ->setBuyOrderStatusId($buyOrderStatus->getId())
   302	                    ->setUpdateDate($nowDate);
   303	                $em->persist($buyOrder);
   304	
   305	                $buyOrderStatusHistory = new DtbBuyOrderStatusHistory();
   306	                $buyOrderStatusHistory
   307	                    ->setBuyOrderId($buyOrder->getBuyOrderId())
   308	                    ->setBuyOrderStatusId($buyOrderStatus->getId())
   309	                    ->setMemberId($this->memberId)
   310	                    ->setCreateDate($nowDate);
   311	                $em->persist($buyOrderStatusHistory);
   312	            }
   313	
   314	            $em->flush();
   315	            $em->commit();
   316	        } catch (\Exception $e) {
   317	            $this->logger->error($e->getMessage());
   318	            $em->rollback();
   319	
   320	            throw $e;
   321	        }
   322	    }
   323	}
