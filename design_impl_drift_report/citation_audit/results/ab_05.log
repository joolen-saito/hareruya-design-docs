     2	
     3	namespace App\Controller\Admin;
     4	
     5	use FOS\RestBundle\Controller\FOSRestController;
     6	use FOS\RestBundle\Controller\Annotations as Rest;
     7	use FOS\RestBundle\View\View;
     8	use Symfony\Component\HttpKernel\Exception\NotFoundHttpException;
     9	use Symfony\Component\HttpFoundation\Request;
    10	use Symfony\Component\HttpFoundation\Response;
    11	use App\Entity\DtbBuyOrder;
    12	use App\Entity\MtbBuyOrderStatus;
    13	use App\Entity\DtbBuyOrderStatusHistory;
    14	use App\Controller\BaseController;
    15	
    16	class BuyOrderStatusController extends BaseController
    17	{
    18	    /**
    19	     * Update order status
    20	     */
    21	    public function putAction(Request $request, int $id) : Response
    22	    {
    23	        $this->authAdminToken($request);
    24	
    25	        $buyOrder = $this->getDoctrine()
    26	            ->getRepository(DtbBuyOrder::class)
    27	            ->find($id);
    28	
    29	        if (empty($buyOrder)) {
    30	            throw new NotFoundHttpException();
    31	        }
    32	
    33	        $oldStatusId = $buyOrder->getBuyOrderStatusId();
    34	
    35	        $putStatus = $this->getDoctrine()
    36	              ->getRepository(MtbBuyOrderStatus::class)
    37	              ->find($request->get('status'));
    38	
    39	        if (empty($putStatus)) {
    40	            $view = View::create([
    41	                'code' => Response::HTTP_BAD_REQUEST,
    42	                'errors' => ['正しい店頭買取ステータスIDを入力してください'],
    43	            ], Response::HTTP_BAD_REQUEST);
    44	
    45	            return $this->get('fos_rest.view_handler')->handle($view);
    46	        }
    47	
    48	        // 査定終了後のステータスは変更不可。
    49	        if (in_array($oldStatusId, MtbBuyOrderStatus::ASSESSMENT_COMPLETED_STATUS, true)) {
    50	            $message = in_array($putStatus->getId(), MtbBuyOrderStatus::ASSESSMENT_ACTIVE_STATUS, true)
    51	                ? 'この査定はすでに終了しているため開くことができません。'
    52	                : 'この査定はすでに終了しているためステータスの更新に失敗しました。';
    53	            $view = View::create([
    54	                'code' => Response::HTTP_BAD_REQUEST,
    55	                'errors' => [$message],
    56	            ], Response::HTTP_BAD_REQUEST);
    57	
    58	            return $this->get('fos_rest.view_handler')->handle($view);
    59	        }
    60	
    61	        // 査定者本人を除き、査定中または査定再開のものは査定開始できない。
    62	        if (in_array($oldStatusId, MtbBuyOrderStatus::ASSESSMENT_ACTIVE_STATUS, true)
    63	            && in_array($putStatus->getId(), MtbBuyOrderStatus::ASSESSMENT_ACTIVE_STATUS, true)
    64	            && $buyOrder->getMember()->getMemberId() !== $this->member->getMemberId())
    65	        {
    66	            $view = View::create([
    67	                'code' => Response::HTTP_BAD_REQUEST,
    68	                'errors' => ["この受注は「{$buyOrder->getMember()->getName()}」が査定中です。"],
    69	            ], Response::HTTP_BAD_REQUEST);
    70	
    71	            return $this->get('fos_rest.view_handler')->handle($view);
    72	        }
    73	
    74	        if ($oldStatusId !== $putStatus->getId()) {
    75	            $em = $this->getDoctrine()->getManager();
    76	            try {
    77	                $em->beginTransaction();
    78	                $buyOrder
    79	                    ->setBuyOrderStatusId($putStatus->getId())
    80	                    ->setMember($this->member)
    81	                    ->setUpdateDate(new \DateTime());
    82	                $em->persist($buyOrder);
    83	
    84	                $buyOrderStatusHistory = new DtbBuyOrderStatusHistory();
    85	                $buyOrderStatusHistory
    86	                    ->setBuyOrderId($id)
    87	                    ->setBuyOrderStatusId($putStatus->getId())
    88	                    ->setMemberId($this->memberId)
    89	                    ->setCreateDate(new \DateTime());
    90	                $em->persist($buyOrderStatusHistory);
    91	                $em->flush();
    92	                $em->commit();
    93	            } catch (\Exception $e) {
    94	                $em->rollback();
    95	
    96	                $view = View::create([
    97	                    'code' => Response::HTTP_INTERNAL_SERVER_ERROR,
    98	                    'errors' => [$e->getMessage()],
    99	                ], Response::HTTP_INTERNAL_SERVER_ERROR);
   100	
   101	                return $this->get('fos_rest.view_handler')->handle($view);
   102	            }
   103	        }
   104	
   105	        $view = View::create([
   106	            'code' => Response::HTTP_OK,
   107	        ], Response::HTTP_OK);
   108	
   109	        return $this->get('fos_rest.view_handler')->handle($view);
   110	    }
   111	}
