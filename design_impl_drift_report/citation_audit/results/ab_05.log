    80	                    'telNo' => $buyOrder['telNo'] ?? '',
    81	                    'zipcode' => $buyOrder['zipcode'],
    82	                    'address' => $address,
    83	                ],
    84	            ];
    85	        }, $buyOrders);
    86	
    87	        return new JsonResponse($response);
