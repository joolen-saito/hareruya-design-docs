     1	<?php
     2	namespace App\Repository;
     3	
     4	use Doctrine\ORM\EntityRepository;
     5	use Doctrine\ORM\Query\Expr;
     6	use App\Entity\MtbBuyOrderStatus;
     7	
     8	/**
     9	 * DtbBuyOrderRepository
    10	 */
    11	class DtbBuyOrderRepository extends EntityRepository
    12	{
    13	    use HierarchicalDataTrait;
    14	
    15	    const NET_ORDERS_HIERALCHY = [
    16	            'netBuyOrderId',
    17	            'applyDate',
    18	            'freeComment',
    19	            'memberName',
    20	            'netOrderStatusId',
    21	            'customerInfo:list:' => [
    22	                'firstName',
    23	                'lastName',
    24	                'telNo',
    25	                'zipcode',
    26	                'address',
    27	            ],
    28	        ];
    29	
    30	    /**
    31	     * 成立前ネット買取情報取得(商品到着～査定未完了のもの)
    32	     */
    33	    public function findProductArrivalBuyOrder() : array
    34	    {
    35	        $statusIds = [
    36	            MtbBuyOrderStatus::STATUS_PRODUCT_ARRIVAL,
    37	            MtbBuyOrderStatus::STATUS_ASSESSING,
    38	            MtbBuyOrderStatus::STATUS_PENDING,
    39	            MtbBuyOrderStatus::STATUS_RESUMPTION,
    40	        ];
    41	
    42	        $qb = $this->createQueryBuilder('buyOrder')
    43	            ->leftJoin('buyOrder.member', 'memberMain')
    44	            ->leftJoin('buyOrder.pref', 'pref')
    45	            ->select(
    46	                'buyOrder.buyOrderId AS netBuyOrderId',
    47	                'buyOrder.orderDate AS applyDate',
    48	                'buyOrder.firstName',
    49	                'buyOrder.lastName',
    50	                'buyOrder.telNo',
    51	                'buyOrder.zipcode',
    52	                'buyOrder.memo AS freeComment',
    53	                'memberMain.name AS memberName',
    54	                'buyOrder.buyOrderStatusId AS netOrderStatusId',
    55	                "CONCAT(pref.name, ' ', buyOrder.addr01, ' ', buyOrder.addr02) AS address",
    56	            )
    57	            ->orderBy('buyOrder.buyOrderId', 'ASC');
    58	
    59	        $qb
    60	            ->andWhere($qb->expr()->in('buyOrder.buyOrderStatusId', ':statusIds'))
    61	            ->setParameter('statusIds', $statusIds);
    62	
    63	        $result = $qb->getQuery()->getResult();
    64	
    65	        return $this->makeListHierarchy(self::NET_ORDERS_HIERALCHY, $result);
    66	    }
    67	}
