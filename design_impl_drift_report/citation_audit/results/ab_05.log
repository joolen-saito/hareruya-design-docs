    14	namespace Eccube\EventListener;
    15	
    16	use Eccube\Common\EccubeConfig;
    17	use Eccube\Request\Context;
    18	use Symfony\Component\EventDispatcher\EventSubscriberInterface;
    19	use Symfony\Component\HttpFoundation\IpUtils;
    20	use Symfony\Component\HttpKernel\Event\RequestEvent;
    21	use Symfony\Component\HttpKernel\Exception\AccessDeniedHttpException;
    22	
    23	class IpAddrListener implements EventSubscriberInterface
    24	{
    25	    public function __construct(protected EccubeConfig $eccubeConfig, protected Context $requestContext)
    26	    {
    27	    }
    28	
    29	    /**
    30	     * @throws AccessDeniedHttpException|\Exception
    31	     */
    32	    public function onKernelRequest(RequestEvent $event): void
    33	    {
    34	        if (!$event->isMainRequest()) {
    35	            return;
    36	        }
    37	
    38	        $clientIp = $event->getRequest()->getClientIp();
    39	        log_debug('Client IP: '.$clientIp);
    40	
    41	        if (!$this->requestContext->isAdmin()) {
    42	            // IPアドレス許可リスト範囲になければ拒否
    43	            $allowFrontHosts = $this->eccubeConfig['eccube_front_allow_hosts'];
    44	            if (!empty($allowFrontHosts) && !$this->isClientIpInList($allowFrontHosts, $clientIp)) {
    45	                throw new AccessDeniedHttpException();
    46	            }
    47	
    48	            // IPアドレス拒否リスト範囲にあれば拒否
    49	            $denyFrontHosts = $this->eccubeConfig['eccube_front_deny_hosts'];
    50	            if (!empty($denyFrontHosts) && $this->isClientIpInList($denyFrontHosts, $clientIp)) {
    51	                throw new AccessDeniedHttpException();
    52	            }
    53	
    54	            return;
    55	        }
    56	
    57	        // IPアドレス許可リスト範囲になければ拒否
    58	        $allowAdminHosts = $this->eccubeConfig['eccube_admin_allow_hosts'];
    59	        if (!empty($allowAdminHosts) && !$this->isClientIpInList($allowAdminHosts, $clientIp)) {
    60	            throw new AccessDeniedHttpException();
    61	        }
    62	
    63	        // IPアドレス拒否リストを確認
    64	        $denyAdminHosts = $this->eccubeConfig['eccube_admin_deny_hosts'];
    65	        if (!empty($denyAdminHosts) && $this->isClientIpInList($denyAdminHosts, $clientIp)) {
    66	            throw new AccessDeniedHttpException();
    67	        }
    68	    }
    69	
    70	    /**
    71	     * @param array<int, string> $hostList
    72	     */
    73	    private function isClientIpInList(array $hostList, ?string $clientIp): bool
    74	    {
    75	        log_debug('Host List: '.implode(',', $hostList));
    76	        if ($hostList) {
    77	            $isInList = array_filter($hostList, fn ($host) => IpUtils::checkIp($clientIp, $host));
    78	
    79	            return count($isInList) > 0;
    80	        }
    81	
    82	        return true;
    83	    }
    84	
    85	    /**
    86	     * @return array<string, array<int, string|int>>
    87	     */
    88	    #[\Override]
    89	    public static function getSubscribedEvents(): array
    90	    {
    91	        return [
    92	            'kernel.request' => ['onKernelRequest', 512],
    93	        ];
    94	    }
    95	}
