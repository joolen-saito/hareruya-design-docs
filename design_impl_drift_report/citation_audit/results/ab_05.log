    37	    #[Route(path: '/%eccube_api_v1_route%/admin/buyOrderIndivisualInputProduct.json', name: 'api_admin_buy_order_indivisual_input_product', methods: ['POST'])]
    38	    public function getByBuyOrderIds(Request $request): JsonResponse
    39	    {
    40	        $ids = $request->request->get('ids');
    41	
    42	        // 旧システム互換目的：クライアントAppが空のリクエストを送信する可能性があり、400エラーで返すとハンドリングできないため空配列を返す
    43	        if ($ids === null || $ids === '') {
    44	            return new JsonResponse([]);
    45	        }
    46	
    47	        // カンマ区切りを配列に変換し、数字のみをフィルタリング
    48	        $buyOrderIds = array_filter(
    49	            explode(',', $ids),
    50	            static fn (string $id) => preg_match('/^\d+$/', trim($id)) === 1
    51	        );
    52	        $buyOrderIds = array_map('intval', $buyOrderIds);
    53	
    54	        // 有効なIDがない場合は空配列を返す
    55	        if (empty($buyOrderIds)) {
    56	            return new JsonResponse([]);
    57	        }
    58	
    59	        $BuyOrderIndivisualInputProducts = $this->repository->findBy(['BuyOrder' => $buyOrderIds]);
    60	
    61	        $response = array_map(
    62	            static fn (DtbBuyOrderIndivisualInputProduct $Product) => [
    63	                'buyOrderIndivisualInputProductId' => $Product->getId(),
    64	                'buyOrderId' => $Product->getBuyOrder()->getId(),
    65	                'name' => $Product->getName(),
    66	                'price' => $Product->getPrice(),
    67	                'count' => $Product->getQuantity(),
    68	                'saleFlg' => $Product->isSaleFlg(),
    69	            ],
    70	            $BuyOrderIndivisualInputProducts
    71	        );
    72	
    73	        return new JsonResponse($response);
    74	    }
    75	}
