    47	                AND bmc.languageId = :languageId
    48	                AND bmc.foilFlg = :foilFlg
    49	                AND bmc.purchaseCategory = :selectType'
    50	            )
    51	            ->setParameters([
    52	                'buyOrderId' => $buyOrderId,
    53	                'productId' => $productId,
    54	                'languageId' => $languageId,
    55	                'foilFlg' => $foilFlg,
    56	                'selectType' => DtbBuyMainCard::SELECT_TYPE,
    57	            ])
    58	            ->getQuery()
    59	            ->getResult();
    60	
    61	        return !empty($results) ? $results[0]['buyMainCardId'] : null;
    62	    }
    63	
    64	}
