    71	    /**
    72	    * カードレイアウト毎に点数で見たマナコスト(CMC)を取得
    73	    *
    74	    * @param Integer $row
    75	    * @return Integer
    76	    */
    77	    public function getCmc($row)
    78	    {
    79	        switch ($row['layout']) {
    80	            case 'Split':
    81	                $cmc = array_sum(explode('/', $row['cmc']));
    82	                 break;
    83	            case 'Flip':
    84	                // FlipのCMCは 3/3 のような形で値が来るので先頭のものを採用
    85	                $cmc = explode('/', $row['cmc'])[0];
    86	                break;
    87	            case 'Normal':
    88	            case 'Double Faced':
    89	            case 'Meld':
    90	            case 'Double Faced,Meld':
    91	            default:
    92	                $cmc = $row['cmc'];
    93	                break;
    94	        }
    95	
    96	        return $cmc;
    97	    }
