   114	
   115	    /**
   116	     * アップロードされたCSVファイルの行ごとの処理
   117	     *
   118	     * @param $formFile
   119	     * @return CsvImportService
   120	     */
   121	    public function getImportData($formFile)
   122	    {
   123	        // アップロードされたCSVファイルを一時ディレクトリに保存
   124	        $this->fileName = 'upload_' . Str::random() . '.' . $formFile->getClientOriginalExtension();
   125	        $formFile->move($this->app['config']['csv_temp_realdir'], $this->fileName);
   126	
   127	        $file = file_get_contents($this->app['config']['csv_temp_realdir'] . '/' . $this->fileName);
   128	
   129	        if ('\\' === DIRECTORY_SEPARATOR && PHP_VERSION_ID >= 70000) {
   130	            // Windows 環境の PHP7 の場合はファイルエンコーディングを CP932 に合わせる
   131	            // see https://github.com/EC-CUBE/ec-cube/issues/1780
   132	            setlocale(LC_ALL, ''); // 既定のロケールに設定
   133	            if (mb_detect_encoding($file) === 'UTF-8') { // UTF-8 を検出したら SJIS-win に変換
   134	                $file = mb_convert_encoding($file, 'SJIS-win', 'UTF-8');
   135	            }
   136	        } else {
   137	            // アップロードされたファイルがUTF-8以外は文字コード変換を行う
   138	            $encode = Str::characterEncoding($file);
   139	            if ($encode !== 'UTF-8') {
   140	                $file = mb_convert_encoding($file, 'UTF-8', $encode);
   141	            }
   142	        }
   143	        $file = Str::convertLineFeed($file);
   144	
   145	        // ゼロ幅スペースの消去
   146	        $file = $this->removeWhite($file);
   147	
   148	        $tmp = tmpfile();
   149	        fwrite($tmp, $file);
