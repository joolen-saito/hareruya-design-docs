   383	    public function checkRequiredHeaders($requiredHeaders, $row, $rowIndex)
   384	    {
   385	        foreach ($requiredHeaders as $key => $requiredHeader) {
   386	            if ($key !== 'main_list' && $row[$key] === '') {
   387	                throw new \RuntimeException(sprintf($this->app->trans('admin.csv.error.data.require'), $requiredHeader, $rowIndex));
   388	            }
   389	            // デッキリストが非公開である場合はメインリストが空欄でもエラーにしない
   390	            // デッキリスト非公開フラグのチェックをしていないので危険性があります
   391	            if ($key === 'main_list' && $row['private_flg'] === strval(DtbDeck::PRIVATE_SHOW) && $row[$key] === '') {
   392	                throw new \RuntimeException(sprintf($this->app->trans('admin.csv.error.data.require'), $requiredHeader, $rowIndex));
   393	            }
   394	        }
   395	    }
