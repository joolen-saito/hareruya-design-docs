from html.parser import HTMLParser
p='/home/y-saito/Developments/hareruya-design-docs/excel_to_html/output/0212_基本設計仕様書(デッキ管理).html'
class P(HTMLParser):
 def __init__(self): super().__init__(); self.cur=None; self.ref=None; self.buf=[]
 def handle_starttag(self,tag,attrs):
  a=dict(attrs)
  if tag=='span' and 'src-cell' in a.get('class','').split() and a.get('data-excel-ref'):
   ref=a['data-excel-ref']
   if any(x in ref for x in ['デッキ登録CSVアップロード"'!'"','デッキ登録CSV"'!'"','デッキタグ一覧"'!'"','アーキタイプ管理(検索入力)"'!'"','アーキタイプ管理(検索結果)"'!'"']): self.ref=ref; self.buf=[]
 def handle_data(self,d):
  if self.ref: self.buf.append(d)
 def handle_endtag(self,tag):
  if tag=='span' and self.ref:
   t=' '.join(''.join(self.buf).split())
   if t and t not in ['-','—']: print(f'{self.ref}\\t{t}')
   self.ref=None; self.buf=[]
P().feed(open(p,encoding='utf-8').read())
