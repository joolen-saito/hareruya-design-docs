    68	                $main = $this->checkListForm($mtbFormat, $headers['main_list'], MtbBoard::BOARD_ID_MAIN, $row['main_list'], $rowIndex);
    69	                // メインリストに含まれている統率者を除外し、メインリストのテキストを再生成する
    70	                if (!empty($commander)) {
    71	                    $main = $this->removeCommander($commander[0]['cardId'], $main);
    72	                    $row['main_list'] = $this->convertArrayToDeckList($main);
    73	                }
    74	                // メインのデータ詳細チェック
    75	                $mainList = $this->checkListData($mtbFormat, null, $headers['main_list'], $row['main_list'], $row['format'], $rowIndex);
    76	
    77	                /** サイドリストチェック */
    78	                // 分割カードの文字列置換
    79	                $row['side_list'] = str_replace(' // ', '/', $row['side_list']);
    80	                // サイドのデータ形式チェック
    81	                $side = $this->checkListForm($mtbFormat, $headers['side_list'], MtbBoard::BOARD_ID_SIDE, $row['side_list'], $rowIndex);
    82	                // サイドのデータ詳細チェック
    83	                $sideList = $this->checkListData($mtbFormat, $mainList, $headers['side_list'], $row['side_list'], $row['format'], $rowIndex);
    84	
    85	
    86	                // 枚数チェック
    87	                $mainCardCount = array_sum(array_column($mainList, 'count'));
    88	                $mainMaxCardCount = $mtbFormat->getMainMaxCardCount();
    89	                if ($this->isStrict && $mainMaxCardCount < $mainCardCount) {
    90	                    throw new \RuntimeException(sprintf($this->app->trans('admin.csv.error.format.too_many'), $rowIndex, $headers['main_list'], $mainMaxCardCount));
    91	                }
    92	                $mainMinCardCount = $mtbFormat->getMainMinCardCount();
    93	                if ($this->isStrict && $mainMinCardCount > $mainCardCount) {
    94	                    throw new \RuntimeException(sprintf($this->app->trans('admin.csv.error.format.too_few'), $rowIndex, $headers['main_list'], $mainMinCardCount));
    95	                }
    96	
    97	                $sideCardCount = array_sum(array_column($sideList, 'count'));
    98	                $sideMaxCardCount = $mtbFormat->getSideMaxCardCount();
    99	                if ($this->isStrict && $sideMaxCardCount < $sideCardCount) {
   100	                    throw new \RuntimeException(sprintf($this->app->trans('admin.csv.error.format.too_many'), $rowIndex, $headers['side_list'], $sideMaxCardCount));
   101	                }
   102	                $sideMinCardCount = $mtbFormat->getSideMinCardCount();
   103	                if ($this->isStrict && $sideMinCardCount > $sideCardCount) {
   104	                    throw new \RuntimeException(sprintf($this->app->trans('admin.csv.error.format.too_few'), $rowIndex, $headers['side_list'], $sideMinCardCount));
   105	                }
   106	            }
   107	
   108	            // 既存データ検索
   109	            $dtbDeck = $this->app['hareruya_ec.repository.deck']->findOneByDeckId($row['deck_id']);
   110	            $insertFlg = !$dtbDeck;
   111	            if ($insertFlg) {
   112	                $dtbDeck = new DtbDeck();
   113	                $this->em->persist($dtbDeck);
   114	            }
   115	
   116	            /** CSVデータ登録 */
   117	            $dtbDeck->setPlayerName($row['player_name'])
   118	                ->setFormat($mtbFormat)
   119	                ->setArchetype($dtbArchetype)
   120	                ->setEventDetail($dtbEventDetail)
   121	                ->setDeckName($row['deck_name'])
   122	                ->setWinCount($row['win_count'] === '' ? null : $row['win_count'])
   123	                ->setLossCount($row['loss_count'] === '' ? null : $row['loss_count'])
   124	                ->setDrawCount($row['draw_count'] === '' ? null : $row['draw_count'])
   125	                ->setRanking($row['ranking'] === '' ? null : $row['ranking'])
   126	                ->setResult($row['result'])
   127	                ->setDciNo($row['dci_no'] === '' ? null : $row['dci_no'])
   128	                ->setEventNameEn($row['event_name_en'])
   129	                ->setEventNameJp($row['event_name_jp'])
   130	                ->setEventDate($eventDate)
   131	                ->setSourceUrl($row['source_url'])
   132	                ->setParticipants($row['participants'] === '' ? null : $row['participants'])
   133	                ->setDisp($this->app['eccube.repository.master.disp']->findOneById(Disp::CSV_TO_DISPID[$dispFlg]))
   134	                ->setPrivateFlg($privateFlg)
   135	                ->setTextMain($row['main_list'])
   136	                ->setTextSide($row['side_list'])
   137	                ->setTextCommand(!empty($commander) ? '1 ' . $row['commander'] : null)
   138	                ->setOldDeckId($oldDeckId)
   139	            ;
   140	
   141	            if (!empty($row['image_card_name'])) {
   142	                $dtbDeck->setCardImage($this->app['hareruya_ec.repository.card_image']->getOptimalCardImageByCardNameEn($row['image_card_name']));
   143	            }
   144	            // アーキタイプから代表カードを取得
   145	            else {
   146	                $dtbDeck->setCardImage($dtbArchetype->getCardImage());
   147	            }
   148	
   149	            $dtbDeck->setMemberId($this->app['security']->getToken()->getUser()->getId());
   150	            if (is_null($dtbDeck->getDeckType())) {
   151	                $dtbDeck->setDeckType($this->app['hareruya_ec.repository.deck_type']->find(MtbDeckType::EVENT_ID));
   152	            }
   153	            $this->em->persist($dtbDeck);
   154	
   155	            // デッキリスト公開の場合はデッキリストをDtbDeckCardに登録する
   156	            if ($isDisplayAndNotPrivate) {
   157	                CardUtil::setDeckCards($this->app, $main, $dtbDeck, MtbBoard::BOARD_ID_MAIN);
   158	                CardUtil::setDeckCards($this->app, $side, $dtbDeck, MtbBoard::BOARD_ID_SIDE);
   159	            }
   160	            if (!empty($commander)) {
   161	                CardUtil::setDeckCards($this->app, $commander, $dtbDeck, MtbBoard::BOARD_ID_COMMAND);
   162	            }
   163	
   164	            if ($rowIndex % 100 === 0 || $insertFlg) {
   165	                $this->em->flush();
   166	                $this->clearCache();
   167	            }
   168	        }
   169	
   170	        $this->em->flush();
   171	        $this->em->commit();
   172	        $this->clearCache();
   173	    }
