   663	    private function uploadProductImageToS3(Application $app, $form)
   664	    {
   665	        $addImages = $form['product']['add_images']->getData();
   666	        $s3 = new S3AccessService($app);
   667	        $s3->setS3Directory(self::S3_DIRCTORY);
   668	        $uploadDir = $app['config']['image_temp_realdir'];
   669	
   670	        $fileNameMap = [];
   671	        foreach ($addImages as $addImage) {
   672	            // S3へ移動
   673	            $uploadPath = $uploadDir . '/' . $addImage;
   674	            $file = new File($uploadPath);
   675	            $s3FilePath = $s3->putFile([
   676	                'extension' => $file->guessExtension(),
   677	                'file' => $uploadPath
   678	            ]);
   679	
   680	            $fileNameMap[$addImage] = $s3FilePath;
   681	        }
   682	
   683	        return $fileNameMap;
   684	    }
