   776	
   777	            $productSubClassImages = $app['hareruya_ec.repository.product_sub_class_image']
   778	                ->findBy(['productImageId' => $productImage->getId()]);
   779	            foreach ($productSubClassImages as $productSubClassImage) {
   780	                $app['orm.em']->remove($productSubClassImage);
   781	            }
   782	        }
   783	    }
