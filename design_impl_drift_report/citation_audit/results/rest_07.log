   630	    private function registerProductCategory(Application $app, $form, $product)
   631	    {
   632	        $count = 1;
   633	        $categories = $form['product']['Category']->getData();
   634	        $categoriesIdList = [];
   635	        foreach ($categories as $category) {
   636	            foreach ($category->getPath() as $parentCategory) {
   637	                if (!isset($categoriesIdList[$parentCategory->getId()])) {
   638	                    $productCategory = $this->createProductCategory($product, $parentCategory, $count);
   639	                    $app['orm.em']->persist($productCategory);
   640	                    $count++;
   641	                    $product->addProductCategory($productCategory);
   642	                    $categoriesIdList[$parentCategory->getId()] = true;
   643	                }
   644	            }
   645	            if (!isset($categoriesIdList[$category->getId()])) {
   646	                $productCategory = $this->createProductCategory($product, $category, $count);
   647	                $app['orm.em']->persist($productCategory);
   648	                $count++;
   649	                $product->addProductCategory($productCategory);
   650	                $categoriesIdList[$category->getId()] = true;
   651	            }
   652	        }
   653	    }
