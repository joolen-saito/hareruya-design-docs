    37	            </p>
    38	        </div>
    39	        {% endif %}
    40	        {% if withEntry is not null and withEntry == constant('Eccube\\Controller\\Front\\Purchase\\OtcBuyController::ENTRY_SUCCESS') %}
    41	        <div class="p-hareruya-satei-complete__register">
    42	            <h2 class="c-hareruya-heading--lev2">Pre-registration is complete.</h2>
    43	            <div class="u-hareruya-mt15">
    44	                <p class="c-hareruya-text--error">You are currently in a Pre-registration status.</p>
    45	                <p class="c-hareruya-text">We have sent an email to your registered address.</p>
    46	                <p class="c-hareruya-text">Please click and access the URL listed in the mail to complete your account registration.</p>
    47	                <p class="c-hareruya-text--sm u-hareruya-mt15">If you are using a cell phone email address, it may be blocked by the filtering function of your email.</p>
    48	                <p class="c-hareruya-text--sm">In case you do not receive the email, please review your spam or filter settings and contact us to let us know that you did not receive the email.</p>
    49	            </div>
    50	        </div>
    51	        {% endif %}
    52	        <div class="p-hareruya-satei-complete__actions">
