   266	    /**
   267	     * 商品画像 登録
   268	     * @param Application $app
   269	     * @param Request $request
   270	     *
   271	     * @return \Symfony\Component\HttpFoundation\Response
   272	     */
   273	    public function addImage(Application $app, Request $request)
   274	    {
   275	        if (!$request->isXmlHttpRequest()) {
   276	            throw new BadRequestHttpException('リクエストが不正です');
   277	        }
   278	
   279	        $images = $request->files->get('admin_product_edit')['product'];
   280	        $uploadDir = $app['config']['image_temp_realdir'];
   281	
   282	        if (!is_array($images) || count($images) === 0) {
   283	            throw new BadRequestHttpException('ファイルが存在しません');
   284	        }
   285	
   286	        $files = [];
   287	        foreach ($images as $img) {
   288	            foreach ($img as $image) {
   289	                //ファイルフォーマット検証
   290	                $mimeType = $image->getMimeType();
   291	                if (0 !== strpos($mimeType, 'image')) {
   292	                    throw new UnsupportedMediaTypeHttpException('ファイル形式が不正です');
   293	                }
   294	
   295	                $extension = $image->getClientOriginalExtension();
   296	                $filename = date('mdHis') . uniqid('_') . '.' . $extension;
   297	                $image->move($uploadDir, $filename);
   298	                $files[] = $filename;
   299	            }
   300	        }
   301	
   302	        return $app->json(['files' => $files], 200);
   303	    }
