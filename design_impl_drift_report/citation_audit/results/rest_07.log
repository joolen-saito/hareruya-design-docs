   243	        );
   244	        $app['eccube.event.dispatcher']->dispatch(EccubeEvents::ADMIN_PRODUCT_ADD_IMAGE_COMPLETE, $event);
   245	        $files = $event->getArgument('files');
   246	
   247	        return $app->json(array('files' => $files), 200);
   248	    }
