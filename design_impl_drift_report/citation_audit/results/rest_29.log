    68	    public function index()
    69	    {
    70	        $Shop = $this->twig->getGlobals()['BaseInfo'];
    71	        if ($Shop->getCommonSettingFlg()) {
    72	            $Shop = $this->baseInfoRepository->get(BaseInfoTrait::$TC_TOKYO_ID);
    73	        }
    74	
    75	        $results = [
    76	            DtbTile::UPPER_LEFT => [],
    77	            DtbTile::UPPER_CENTER => [],
    78	            DtbTile::LOWER_LEFT => [],
    79	            DtbTile::LOWER_CENTER => [],
    80	            DtbTile::LOWER_RIGHT => [],
    81	        ];
    82	        foreach ($Shop->getTiles() as $i => $Tile) {
    83	            switch ($Tile->getTileType()->getId()) {
    84	                case MtbTileType::PICKUP_PRODUCT:
    85	                    $productClasses = $this->getPickupProductClasses();
    86	                    break;
    87	                default:
    88	                    $productClasses = is_null($Tile->getTag()) ? [] :$this->getProductClassesFromTag($Tile->getTag()->getId());
    89	            }
    90	            $results[$Tile->getSection()] = [
    91	                'productClasses' => $productClasses,
    92	                'TileType' => $Tile->getTileType(),
    93	                'Tag' => $Tile->getTag(),
    94	            ];
    95	        }
    96	
    97	        // 中身が空のタイルはスタン・レガシー・統率者タイルからランダムに1つを表示
    98	        // TODO: 上記候補に新弾とセールを追加する
    99	        foreach ($results as $key => $result) {
   100	            if (!empty($result)) {
   101	                continue;
   102	            }
   103	            $tagId = array_rand($this->getFormatTags());
   104	            $productClasses = $this->getProductClassesFromTag($tagId);
   105	            $results[$key] = [
   106	                'productClasses' => $productClasses,
   107	                'TileType' => $this->tileTypeRepository->find(MtbTileType::FORMAT_RANKING),
   108	                'Tag' => $this->tagRepository->find($tagId),
   109	            ];
   110	        }
   111	
   112	        // タイル配置ランダムフラグによるシャッフル
   113	        if ($Shop->getRandomTileFlg()) {
   114	            shuffle($results);                // 添え字はタイルのセクションを使用する。(1～5)
   115	            array_unshift($results, 'dummy'); // 添え字がリセットされているので先頭にダミーを追加してインデックスをずらす
   116	            unset($results[0]);               // 添え字の再配置を回避するためにunsetで先頭の要素を削除
   117	        }
   118	
   119	        return [
   120	            'Shop' => $Shop,
   121	            'results' => $results,
   122	        ];
   123	    }
