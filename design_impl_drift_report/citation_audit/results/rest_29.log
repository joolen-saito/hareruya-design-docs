    46	    /**
    47	     * 税率設定の初期表示・登録
    48	     *
    49	     * @return RedirectResponse|array<string, mixed>
    50	     */
    51	    #[Route(path: '/%eccube_admin_route%/setting/shop/tax', name: 'admin_setting_shop_tax', methods: ['GET', 'POST'])]
    52	    #[Route(path: '/%eccube_admin_route%/setting/shop/tax/new', name: 'admin_setting_shop_tax_new', methods: ['GET', 'POST'])]
    53	    #[Template(template: '@admin/Setting/Shop/tax_rule.twig')]
    54	    public function index(Request $request): RedirectResponse|array
    55	    {
    56	        $TargetTaxRule = $this->taxRuleRepository->newTaxRule($this->getMember()->getBaseInfo());
    57	        $builder = $this->formFactory
    58	            ->createBuilder(TaxRuleType::class, $TargetTaxRule);
    59	
    60	        $event = new EventArgs(
    61	            [
    62	                'builder' => $builder,
    63	                'BaseInfo' => $this->BaseInfo,
    64	                'TargetTaxRule' => $TargetTaxRule,
    65	            ],
    66	            $request
    67	        );
    68	        $this->eventDispatcher->dispatch($event, EccubeEvents::ADMIN_SETTING_SHOP_TAX_RULE_INDEX_INITIALIZE);
    69	
    70	        $form = $builder->getForm();
    71	
    72	        $mode = $request->get('mode');
    73	        if ($mode != 'edit_inline') {
    74	            $form->handleRequest($request);
    75	            if ($form->isSubmitted() && $form->isValid()) {
    76	                $this->entityManager->persist($TargetTaxRule);
    77	                $this->entityManager->flush();
    78	
    79	                $event = new EventArgs(
    80	                    [
    81	                        'form' => $form,
    82	                        'BaseInfo' => $this->BaseInfo,
    83	                        'TargetTaxRule' => $TargetTaxRule,
    84	                    ],
    85	                    $request
    86	                );
    87	                $this->eventDispatcher->dispatch($event, EccubeEvents::ADMIN_SETTING_SHOP_TAX_RULE_INDEX_COMPLETE);
    88	
    89	                $this->addSuccess('admin.common.save_complete', 'admin');
    90	
    91	                return $this->redirectToRoute('admin_setting_shop_tax');
    92	            }
    93	        }
    94	
    95	        // 共通税率一覧
    96	        $TaxRules = $this->taxRuleRepository->getList();
    97	
    98	        // edit tax rule form
    99	        $forms = [];
   100	        $errors = [];
   101	        /** @var TaxRule $TaxRule */
   102	        foreach ($TaxRules as $TaxRule) {
   103	            /** @var FormBuilderInterface $builder */
   104	            $builder = $this->formFactory->createBuilder(TaxRuleType::class, $TaxRule);
   105	            if ($TaxRule->isDefaultTaxRule()) {
   106	                $builder->remove('apply_date');
   107	            }
   108	            $editTaxRuleForm = $builder->getForm();
   109	            // error number
   110	            $error = 0;
   111	            if ($mode == 'edit_inline'
   112	                && $request->getMethod() === 'POST'
   113	                && (string) $TaxRule->getId() === $request->get('tax_rule_id')
   114	            ) {
   115	                $editTaxRuleForm->handleRequest($request);
   116	                if ($editTaxRuleForm->isValid()) {
   117	                    $taxRuleData = $editTaxRuleForm->getData();
   118	
   119	                    $this->entityManager->persist($taxRuleData);
   120	                    $this->entityManager->flush();
   121	
   122	                    $this->addSuccess('admin.common.save_complete', 'admin');
   123	
   124	                    return $this->redirectToRoute('admin_setting_shop_tax');
   125	                }
   126	                $error = count($editTaxRuleForm->getErrors(true));
   127	            }
   128	
   129	            $forms[$TaxRule->getId()] = $editTaxRuleForm->createView();
   130	            $errors[$TaxRule->getId()] = $error;
   131	        }
   132	
   133	        return [
   134	            'TargetTaxRule' => $TargetTaxRule,
   135	            'TaxRules' => $TaxRules,
   136	            'form' => $form->createView(),
   137	            'forms' => $forms,
   138	            'errors' => $errors,
   139	        ];
   140	    }
