    35	
    36	    /**
    37	     * 日次集計向けに、受注金額・原価・販売数量・販売件数を店舗(base_info)ごとに集計する。
    38	     * 総売上(order_amount_order)は値引き前金額（ポイント・クーポン値引きは考慮しない）に送料・手数料を含めた額。
    39	     *
    40	     * @return array<int, array<string, mixed>>
    41	     */
    42	    public function aggregateOrderSummaryByBaseInfo(\DateTimeInterface $from, \DateTimeInterface $to): array
    43	    {
    44	        return $this->getEntityManager()->getConnection()->fetchAllAssociative(
    45	            <<<'SQL'
    46	SELECT
    47	    o.base_info_id,
    48	    COALESCE(SUM(o.subtotal + o.delivery_fee_total + o.charge), 0) AS order_amount_order,
    49	    COALESCE(SUM(order_cost.total_cost), 0) AS cost,
    50	    COALESCE(SUM(order_cost.sale_quantity), 0) AS sale_quantity,
    51	    COUNT(o.id) AS buyer_count
    52	FROM dtb_order o
    53	LEFT JOIN (
    54	    SELECT
    55	        oi.order_id,
    56	        COALESCE(SUM(oi.total_cost), 0) AS total_cost,
    57	        -- 販売数量は商品明細の数量のみを合算する（送料・手数料・値引き・ポイント明細の数量は含めない）
    58	        COALESCE(SUM(CASE WHEN oi.order_item_type_id = :productItemTypeId THEN oi.quantity ELSE 0 END), 0) AS sale_quantity
    59	    FROM dtb_order_item oi
    60	    GROUP BY oi.order_id
    61	) order_cost ON order_cost.order_id = o.id
    62	WHERE
    63	    o.base_info_id IS NOT NULL
    64	    AND o.order_date >= :summaryDateFrom
    65	    AND o.order_date <= :summaryDateTo
    66	GROUP BY o.base_info_id
    67	SQL,
    68	            [
    69	                'summaryDateFrom' => $from->format('Y-m-d H:i:s'),
    70	                'summaryDateTo' => $to->format('Y-m-d H:i:s'),
    71	                'productItemTypeId' => OrderItemType::PRODUCT,
    72	            ]
    73	        );
    74	    }
    75	
    76	    /**
    77	     * 日次集計向けに、買取件数・買取金額を集計する。
    78	     * ネット買取(dtb_buy_order)は本店(root)に集約し、店頭買取(dtb_otc_buy_order)は店舗ごとに集計する。
    79	     * 集計日(申込日)はネット買取が order_date、店頭買取が apply_date で絞り込む。
    80	     *
    81	     * @return array<int, array<string, mixed>>
    82	     */
    83	    public function aggregatePurchaseSummaryByBaseInfo(int $rootBaseInfoId, \DateTimeInterface $from, \DateTimeInterface $to): array
    84	    {
    85	        return $this->getEntityManager()->getConnection()->fetchAllAssociative(
    86	            <<<'SQL'
    87	SELECT
    88	    purchase_base.base_info_id,
    89	    SUM(purchase_base.purchase_count) AS purchase_count,
    90	    SUM(purchase_base.purchase_amount) AS purchase_amount
    91	FROM (
    92	    SELECT
    93	        CAST(:rootBaseInfoId AS INTEGER) AS base_info_id,
    94	        COUNT(bo.id) AS purchase_count,
    95	        COALESCE(
    96	            SUM(
    97	                CEIL(
    98	                    (
    99	                        COALESCE(main_card_sum.main_total, 0)
   100	                        + COALESCE(indiv_sum.indiv_total, 0)
   101	                    ) / 10.0
   102	                ) * 10
   103	            ),
   104	            0
   105	        ) AS purchase_amount
   106	    FROM dtb_buy_order bo
   107	    LEFT JOIN (
   108	        SELECT
   109	            bmc.buy_order_id,
   110	            SUM(
   111	                CASE
   112	                    WHEN bmc.sale_flg THEN COALESCE(bmc.price, 0) * COALESCE(bmc."count", 0)
   113	                    ELSE 0
   114	                END
   115	            ) AS main_total
   116	        FROM dtb_buy_main_card bmc
   117	        GROUP BY bmc.buy_order_id
   118	    ) main_card_sum ON main_card_sum.buy_order_id = bo.id
   119	    LEFT JOIN (
   120	        SELECT
   121	            biip.buy_order_id,
   122	            SUM(
   123	                CASE
   124	                    WHEN biip.sale_flg THEN COALESCE(biip.price, 0) * COALESCE(biip.quantity, 0)
   125	                    ELSE 0
   126	                END
   127	            ) AS indiv_total
   128	        FROM dtb_buy_order_indivisual_input_product biip
   129	        GROUP BY biip.buy_order_id
   130	    ) indiv_sum ON indiv_sum.buy_order_id = bo.id
   131	    WHERE
   132	        bo.auto_approval_flg = TRUE
   133	        AND bo.order_date >= :summaryDateFrom
   134	        AND bo.order_date <= :summaryDateTo
   135	    GROUP BY base_info_id
   136	
   137	    UNION ALL
   138	
   139	    SELECT
   140	        obo.base_info_id,
   141	        COUNT(obo.id) AS purchase_count,
   142	        COALESCE(SUM(obo.total_price), 0) AS purchase_amount
   143	    FROM dtb_otc_buy_order obo
   144	    WHERE
   145	        obo.base_info_id IS NOT NULL
   146	        AND obo.cancel_date IS NULL
   147	        AND obo.apply_date >= :summaryDateFrom
   148	        AND obo.apply_date <= :summaryDateTo
   149	    GROUP BY obo.base_info_id
   150	) purchase_base
   151	GROUP BY purchase_base.base_info_id
   152	SQL,
   153	            [
   154	                'summaryDateFrom' => $from->format('Y-m-d H:i:s'),
   155	                'summaryDateTo' => $to->format('Y-m-d H:i:s'),
   156	                'rootBaseInfoId' => $rootBaseInfoId,
   157	            ]
   158	        );
   159	    }
   160	
   161	    /**
   162	     * 日次集計向けに、廃棄数量を店舗(base_info)ごとに集計する。
   163	     * - 在庫変動区分が廃棄(MtbStockChangeType::DISPOSAL)の在庫履歴が対象
   164	     * - 詳細区分のうち「廃棄(他事業移動)」「廃棄(イベント商品)」は対象外
   165	     * - 集計日は在庫変動履歴の登録日(registered_at)
   166	     * - 在庫変動履歴は減算分がマイナスで入るため、合計を符号反転してプラスにする
   167	     *   （廃棄(却下)による戻しは正の値で入り、ここで差し引かれる）
   168	     *
   169	     * @return array<int, array<string, mixed>>
   170	     */
   171	    public function aggregateDisposalQuantityByBaseInfo(\DateTimeInterface $from, \DateTimeInterface $to): array
   172	    {
   173	        $qb = $this->getEntityManager()->createQueryBuilder();
   174	
   175	        return $qb
   176	            ->select('IDENTITY(sh.baseInfo) AS base_info_id')
   177	            ->addSelect('(0 - COALESCE(SUM(sh.stockChangeQuantity), 0)) AS waste_quantity')
   178	            ->from(DtbStockHistory::class, 'sh')
   179	            ->innerJoin('sh.StockChangeTypeDetail', 'sctd')
   180	            ->where('IDENTITY(sctd.StockChangeType) = :disposalTypeId')
   181	            ->andWhere($qb->expr()->notIn('sctd.id', ':excludedDisposalDetailIds'))
   182	            ->andWhere('sh.registeredAt >= :summaryDateFrom')
   183	            ->andWhere('sh.registeredAt <= :summaryDateTo')
   184	            ->groupBy('sh.baseInfo')
   185	            ->setParameter('disposalTypeId', MtbStockChangeType::DISPOSAL)
   186	            ->setParameter('excludedDisposalDetailIds', [
   187	                MtbStockChangeTypeDetail::DISPOSAL_OTHER_BUSINESS_TRANSFER,
   188	                MtbStockChangeTypeDetail::DISPOSAL_EVENT_PRODUCT,
   189	            ])
   190	            ->setParameter('summaryDateFrom', $from)
   191	            ->setParameter('summaryDateTo', $to)
   192	            ->getQuery()
   193	            ->getResult();
   194	    }
   195	
   196	    /**
   197	     * 日次集計向けに、欠品数量を店舗(base_info)ごとに集計する。
   198	     * - 詳細区分が「欠品減算(受注)」「欠品加算(移動)」の在庫履歴が対象
   199	     * - 集計日は在庫変動履歴の登録日(registered_at)
   200	     * - 在庫変動履歴は減算分がマイナスで入るため、合計を符号反転してプラスにする
   201	     *
   202	     * @return array<int, array<string, mixed>>
   203	     */
   204	    public function aggregateShortageQuantityByBaseInfo(\DateTimeInterface $from, \DateTimeInterface $to): array
   205	    {
   206	        $qb = $this->getEntityManager()->createQueryBuilder();
   207	
   208	        return $qb
   209	            ->select('IDENTITY(sh.baseInfo) AS base_info_id')
   210	            ->addSelect('(0 - COALESCE(SUM(sh.stockChangeQuantity), 0)) AS shortage_quantity')
   211	            ->from(DtbStockHistory::class, 'sh')
   212	            ->where($qb->expr()->in('IDENTITY(sh.StockChangeTypeDetail)', ':shortageDetailIds'))
   213	            ->andWhere('sh.registeredAt >= :summaryDateFrom')
   214	            ->andWhere('sh.registeredAt <= :summaryDateTo')
   215	            ->groupBy('sh.baseInfo')
   216	            ->setParameter('shortageDetailIds', [
   217	                MtbStockChangeTypeDetail::ORDER_STOCKOUT_DECREASE,
   218	                MtbStockChangeTypeDetail::MOVE_SHORTAGE_ADD,
   219	            ])
   220	            ->setParameter('summaryDateFrom', $from)
   221	            ->setParameter('summaryDateTo', $to)
   222	            ->getQuery()
   223	            ->getResult();
   224	    }
   225	
   226	    /**
   227	     * 月次集計向けに、期間内の日次集計を店舗(base_info)ごとに合算する。
   228	     * sale_average は合算値ではないため呼び出し側で算出する。
   229	     *
   230	     * @return array<int, array<string, mixed>>
   231	     */
   232	    public function aggregateMonthlyTotalsByBaseInfo(\DateTimeInterface $from, \DateTimeInterface $to): array
   233	    {
   234	        return $this->createQueryBuilder('d')
   235	            ->select('IDENTITY(d.BaseInfo) AS base_info_id')
   236	            ->addSelect('COALESCE(SUM(d.grossSales), 0) AS gross_sales')
   237	            ->addSelect('COALESCE(SUM(d.totalCost), 0) AS total_cost')
   238	            ->addSelect('COALESCE(SUM(d.grossProfit), 0) AS gross_profit')
   239	            ->addSelect('COALESCE(SUM(d.saleQuantity), 0) AS sale_quantity')
   240	            ->addSelect('COALESCE(SUM(d.saleCount), 0) AS sale_count')
   241	            ->addSelect('COALESCE(SUM(d.purchaseCount), 0) AS purchase_count')
   242	            ->addSelect('COALESCE(SUM(d.purchaseAmount), 0) AS purchase_amount')
   243	            ->addSelect('COALESCE(SUM(d.wasteCount), 0) AS waste_count')
   244	            ->addSelect('COALESCE(SUM(d.shortageCount), 0) AS shortage_count')
   245	            ->where('d.summaryDate >= :from')
   246	            ->andWhere('d.summaryDate <= :to')
   247	            ->groupBy('d.BaseInfo')
   248	            ->setParameter('from', $from->format('Y-m-d'))
   249	            ->setParameter('to', $to->format('Y-m-d'))
   250	            ->getQuery()
   251	            ->getResult();
   252	    }
   253	
   254	    /**
   255	     * 指定した集計日の日次集計を全店舗分削除する。
   256	     * 再集計時は本メソッドで削除してから insertDailySummary で登録し直す。
   257	     */
   258	    public function deleteBySummaryDate(\DateTimeInterface $summaryDate): void
   259	    {
   260	        $this->getEntityManager()->createQueryBuilder()
   261	            ->delete(DtbDailySummary::class, 's')
   262	            ->where('s.summaryDate = :summaryDate')
   263	            ->setParameter('summaryDate', $summaryDate->format('Y-m-d'))
   264	            ->getQuery()
   265	            ->execute();
   266	    }
   267	
   268	    /**
   269	     * 日次集計結果を1店舗分 INSERT する。
   270	     * 同一 (summary_date, base_info_id) は事前に deleteBySummaryDate で削除しておくこと。
   271	     *
   272	     * @param array<string, int> $summaryValues gross_sales/total_cost/gross_profit/sale_quantity/sale_count/sale_average/purchase_count/purchase_amount/waste_count/shortage_count
   273	     */
   274	    public function insertDailySummary(\DateTimeInterface $summaryDate, int $baseInfoId, array $summaryValues): void
   275	    {
   276	        $em = $this->getEntityManager();
   277	        $now = new \DateTime();
   278	
   279	        $summary = (new DtbDailySummary())
   280	            ->setSummaryDate(\DateTime::createFromInterface($summaryDate))
   281	            ->setBaseInfo($em->getReference(BaseInfo::class, $baseInfoId))
   282	            ->setGrossSales((string) ($summaryValues['gross_sales'] ?? 0))
   283	            ->setTotalCost((string) ($summaryValues['total_cost'] ?? 0))
   284	            ->setGrossProfit((string) ($summaryValues['gross_profit'] ?? 0))
   285	            ->setSaleQuantity((int) ($summaryValues['sale_quantity'] ?? 0))
   286	            ->setSaleCount((int) ($summaryValues['sale_count'] ?? 0))
   287	            ->setSaleAverage((string) ($summaryValues['sale_average'] ?? 0))
   288	            ->setPurchaseCount((int) ($summaryValues['purchase_count'] ?? 0))
   289	            ->setPurchaseAmount((string) ($summaryValues['purchase_amount'] ?? 0))
   290	            ->setWasteCount((int) ($summaryValues['waste_count'] ?? 0))
   291	            ->setShortageCount((int) ($summaryValues['shortage_count'] ?? 0))
   292	            ->setCreateDate($now)
   293	            ->setUpdateDate($now);
   294	
   295	        $em->persist($summary);
   296	        $em->flush();
   297	    }
   298	
   299	    /**
   300	     * @param list<int> $targetBaseInfoIds 空配列の場合は店舗絞り込みなし（全店舗）
   301	     *
   302	     * @return array<int, array<string, mixed>>
   303	     */
   304	    public function fetchSummaryRowsByDateRangeAndTargets(
   305	        \DateTimeInterface $from,
   306	        \DateTimeInterface $to,
   307	        array $targetBaseInfoIds,
   308	    ): array {
   309	        $qb = $this->createQueryBuilder('s');
   310	
   311	        $qb
   312	            ->select(
   313	                's.summaryDate AS summary_date',
   314	                'b.id AS base_info_id',
   315	                'b.short_name_jp AS short_name_jp',
   316	                'b.shop_name AS shop_name',
   317	                's.grossSales AS gross_sales',
   318	                's.totalCost AS total_cost',
   319	                's.grossProfit AS gross_profit',
   320	                's.saleQuantity AS sale_quantity',
   321	                's.saleCount AS sale_count',
   322	                's.saleAverage AS sale_average',
   323	                's.purchaseCount AS purchase_count',
   324	                's.purchaseAmount AS purchase_amount',
   325	                's.wasteCount AS waste_count',
   326	                's.shortageCount AS shortage_count',
   327	            )
   328	            ->innerJoin('s.BaseInfo', 'b')
   329	            ->where('s.summaryDate >= :from')
   330	            ->andWhere('s.summaryDate <= :to')
   331	            ->orderBy('s.summaryDate', 'ASC')
   332	            ->addOrderBy('b.id', 'ASC')
   333	            ->setParameter('from', $from->format('Y-m-d'))
   334	            ->setParameter('to', $to->format('Y-m-d'));
   335	
   336	        if ($targetBaseInfoIds !== []) {
   337	            $qb
   338	                ->andWhere($qb->expr()->in('b.id', ':targetIds'))
   339	                ->setParameter('targetIds', $targetBaseInfoIds);
   340	        }
   341	
   342	        return $qb->getQuery()->getResult();
   343	    }
   344	}
