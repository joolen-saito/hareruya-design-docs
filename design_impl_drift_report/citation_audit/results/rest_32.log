    59	            ];
    60	
    61	        $builder
    62	            ->add('summary_type', ChoiceType::class, [
    63	                'required' => true,
    64	                'expanded' => true,
    65	                'multiple' => false,
    66	                'choices' => [
    67	                    '日次' => 'daily',
    68	                    '月次' => 'monthly',
    69	                ],
    70	            ])
    71	            ->add('summary_date_from', DateType::class, $dateFieldOptions)
    72	            ->add('summary_date_to', DateType::class, $dateFieldOptions)
    73	            ->add('mail_order_enabled', CheckboxType::class, [
    74	                'required' => false,
