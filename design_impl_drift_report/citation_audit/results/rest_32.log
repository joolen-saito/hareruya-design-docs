    77	
    78	    /**
    79	     * @param list<int> $targetBaseInfoIds 空配列の場合は店舗絞り込みなし（全店舗）
    80	     *
    81	     * @return array<int, array<string, mixed>>
    82	     */
    83	    public function fetchSummaryRowsByMonthRangeAndTargets(
    84	        \DateTimeInterface $from,
    85	        \DateTimeInterface $to,
    86	        array $targetBaseInfoIds,
    87	    ): array {
    88	        $sql = <<<'SQL'
    89	SELECT
    90	    s.summary_month,
    91	    s.base_info_id,
    92	    b.short_name_jp,
    93	    b.shop_name,
    94	    s.gross_sales,
    95	    s.total_cost,
    96	    s.gross_profit,
    97	    s.sale_quantity,
    98	    s.sale_count,
    99	    s.sale_average,
   100	    s.purchase_count,
   101	    s.purchase_amount,
   102	    s.waste_count,
   103	    s.shortage_count
   104	FROM dtb_monthly_summary s
   105	INNER JOIN dtb_base_info b ON b.id = s.base_info_id
   106	WHERE s.summary_month >= :from
   107	  AND s.summary_month <= :to
   108	SQL;
   109	        $params = [
   110	            'from' => $from->format('Y-m-d'),
   111	            'to' => $to->format('Y-m-d'),
   112	        ];
   113	        $types = [];
   114	
   115	        if ($targetBaseInfoIds !== []) {
   116	            $sql .= ' AND s.base_info_id IN (:targetIds)';
   117	            $params['targetIds'] = $targetBaseInfoIds;
   118	            $types['targetIds'] = ArrayParameterType::INTEGER;
   119	        }
   120	
   121	        $sql .= ' ORDER BY s.summary_month ASC, s.base_info_id ASC';
   122	
   123	        return $this->getEntityManager()->getConnection()->executeQuery($sql, $params, $types)->fetchAllAssociative();
   124	    }
   125	}
