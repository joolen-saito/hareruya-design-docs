   239	                    $denyUrl = str_replace('/', '\/', $baseUrl.$AuthorityRole->getDenyUrl());
   240	                    if (preg_match("/^({$denyUrl})/i", $url)) {
   241	                        // 権限がないURLの場合は配列から削除
   242	                        unset($parentNav[$key]);
