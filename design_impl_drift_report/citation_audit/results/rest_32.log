    23	/**
    24	 * @extends AbstractRepository<DtbMonthlySummary>
    25	 */
    26	class DtbMonthlySummaryRepository extends AbstractRepository
    27	{
    28	    public function __construct(ManagerRegistry $registry)
    29	    {
    30	        parent::__construct($registry, DtbMonthlySummary::class);
    31	    }
    32	
    33	    /**
    34	     * 指定した集計月の月次集計を全店舗分削除する。
    35	     * 再集計時は本メソッドで削除してから insertMonthlySummary で登録し直す。
    36	     */
    37	    public function deleteBySummaryMonth(\DateTimeInterface $summaryMonth): void
    38	    {
    39	        $this->getEntityManager()->createQueryBuilder()
    40	            ->delete(DtbMonthlySummary::class, 's')
    41	            ->where('s.summaryMonth = :summaryMonth')
    42	            ->setParameter('summaryMonth', $summaryMonth->format('Y-m-d'))
    43	            ->getQuery()
    44	            ->execute();
    45	    }
    46	
    47	    /**
    48	     * 月次集計結果を1店舗分 INSERT する。
    49	     * 同一 (summary_month, base_info_id) は事前に deleteBySummaryMonth で削除しておくこと。
    50	     *
    51	     * @param array<string, int> $summaryValues gross_sales/total_cost/gross_profit/sale_quantity/sale_count/sale_average/purchase_count/purchase_amount/waste_count/shortage_count
    52	     */
    53	    public function insertMonthlySummary(\DateTimeInterface $summaryMonth, int $baseInfoId, array $summaryValues): void
    54	    {
    55	        $em = $this->getEntityManager();
    56	        $now = new \DateTime();
    57	
    58	        $summary = (new DtbMonthlySummary())
    59	            ->setSummaryMonth(\DateTime::createFromInterface($summaryMonth))
    60	            ->setBaseInfo($em->getReference(BaseInfo::class, $baseInfoId))
    61	            ->setGrossSales((string) ($summaryValues['gross_sales'] ?? 0))
    62	            ->setTotalCost((string) ($summaryValues['total_cost'] ?? 0))
    63	            ->setGrossProfit((string) ($summaryValues['gross_profit'] ?? 0))
    64	            ->setSaleQuantity((int) ($summaryValues['sale_quantity'] ?? 0))
    65	            ->setSaleCount((int) ($summaryValues['sale_count'] ?? 0))
    66	            ->setSaleAverage((string) ($summaryValues['sale_average'] ?? 0))
    67	            ->setPurchaseCount((int) ($summaryValues['purchase_count'] ?? 0))
    68	            ->setPurchaseAmount((string) ($summaryValues['purchase_amount'] ?? 0))
    69	            ->setWasteCount((int) ($summaryValues['waste_count'] ?? 0))
    70	            ->setShortageCount((int) ($summaryValues['shortage_count'] ?? 0))
    71	            ->setCreateDate($now)
    72	            ->setUpdateDate($now);
    73	
    74	        $em->persist($summary);
    75	        $em->flush();
