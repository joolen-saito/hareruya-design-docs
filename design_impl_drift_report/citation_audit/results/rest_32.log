    44	    public function buildForm(FormBuilderInterface $builder, array $options): void
    45	    {
    46	        $dateFieldOptions = $options['monthly_date_inputs']
    47	            ? [
    48	                'required' => true,
    49	                'input' => 'datetime',
    50	                'widget' => 'single_text',
    51	                'html5' => false,
    52	                'format' => 'yyyy-MM',
