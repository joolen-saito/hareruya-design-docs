    88	        // 月次は yyyy-MM 形式で送られた場合に DateType 用へ月初日へ正規化する
    89	        $builder->addEventListener(FormEvents::PRE_SUBMIT, function (FormEvent $event): void {
    90	            $data = $event->getData();
    91	            if (!is_array($data) || ($data['summary_type'] ?? '') !== 'monthly') {
    92	                return;
    93	            }
    94	
    95	            foreach (['summary_date_from', 'summary_date_to'] as $field) {
    96	                $value = $data[$field] ?? '';
    97	                if (is_string($value) && preg_match('/^\d{4}-\d{2}$/', $value) === 1) {
    98	                    $data[$field] = $value.'-01';
    99	                }
   100	            }
   101	
   102	            $event->setData($data);
   103	        });
   104	    }
