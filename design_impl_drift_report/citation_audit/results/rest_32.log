    76	            ])
    77	            ->add('store_sales_all', CheckboxType::class, [
    78	                'required' => false,
    79	                'label' => '全店舗チェック',
    80	            ])
    81	            ->add('store_sales_targets', ChoiceType::class, [
    82	                'required' => false,
    83	                'expanded' => true,
    84	                'multiple' => true,
    85	                'choices' => $this->getPublishedStoreChoices(),
    86	            ]);
