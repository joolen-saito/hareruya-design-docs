    16	namespace Eccube\Service\Admin\Analysis;
    17	
    18	use Eccube\Common\EccubeConfig;
    19	use Eccube\Repository\DtbDailySummaryRepository;
    20	use Eccube\Repository\DtbMonthlySummaryRepository;
    21	
    22	class AnalysisSummaryBuilder
    23	{
    24	    public function __construct(
    25	        private readonly DtbDailySummaryRepository $dtbDailySummaryRepository,
    26	        private readonly DtbMonthlySummaryRepository $dtbMonthlySummaryRepository,
    27	        private readonly EccubeConfig $eccubeConfig,
    28	    ) {
    29	    }
    30	
    31	    /**
    32	     * @param list<int> $targetBaseInfoIds
    33	     * @param array<string, string> $resultColumns
    34	     *
    35	     * @return array{
    36	     *   summary: array<int, array<string, int|float|string>>,
    37	     *   total: array<string, int|float|string>
    38	     * }
    39	     */
    40	    public function build(
    41	        string $summaryType,
    42	        \DateTimeInterface $dateFrom,
    43	        \DateTimeInterface $dateTo,
    44	        array $targetBaseInfoIds,
    45	        bool $mailOrderEnabled,
    46	        array $resultColumns,
    47	    ): array {
    48	        $summary = $summaryType === 'monthly'
    49	            ? $this->fetchMonthlySummary($dateFrom, $dateTo, $targetBaseInfoIds, $mailOrderEnabled)
    50	            : $this->fetchDailySummary($dateFrom, $dateTo, $targetBaseInfoIds, $mailOrderEnabled);
    51	
    52	        return [
    53	            'summary' => $summary,
    54	            'total' => $this->buildTotal($summary, $resultColumns),
    55	        ];
    56	    }
    57	
    58	    /**
    59	     * @param list<int> $targetBaseInfoIds
    60	     *
    61	     * @return array<int, array<string, int|float|string>>
    62	     */
    63	    private function fetchDailySummary(
    64	        \DateTimeInterface $dateFrom,
    65	        \DateTimeInterface $dateTo,
    66	        array $targetBaseInfoIds,
    67	        bool $mailOrderEnabled,
    68	    ): array {
    69	        $from = \DateTimeImmutable::createFromInterface($dateFrom)->setTime(0, 0, 0);
    70	        $to = \DateTimeImmutable::createFromInterface($dateTo)->setTime(23, 59, 59);
    71	        if ($from > $to) {
    72	            [$from, $to] = [$to, $from];
    73	        }
    74	
    75	        $rowsRaw = $this->dtbDailySummaryRepository->fetchSummaryRowsByDateRangeAndTargets($from, $to, $targetBaseInfoIds);
    76	        $rows = [];
    77	        foreach ($rowsRaw as $raw) {
    78	            $storeName = $this->resolveStoreName(
    79	                (int) ($raw['base_info_id'] ?? 0),
    80	                (string) ($raw['short_name_jp'] ?? ''),
    81	                (string) ($raw['shop_name'] ?? ''),
    82	                $mailOrderEnabled
    83	            );
    84	            $summaryDate = $raw['summary_date'];
    85	            $rows[] = [
    86	                'order_date' => $summaryDate instanceof \DateTimeInterface
    87	                    ? $summaryDate->format('Y/m/d')
    88	                    : (new \DateTime($summaryDate !== null ? (string) $summaryDate : 'now'))->format('Y/m/d'),
    89	                'store_name' => $storeName,
    90	                'order_amount_order' => (int) ($raw['gross_sales'] ?? 0),
    91	                'cost' => (int) ($raw['total_cost'] ?? 0),
    92	                'gross_profit' => (int) ($raw['gross_profit'] ?? 0),
    93	                'order_count_order' => (int) ($raw['sale_quantity'] ?? 0),
    94	                'buyer_count' => (int) ($raw['sale_count'] ?? 0),
    95	                'order_average_order' => self::calcOrderAverage(
    96	                    (int) ($raw['gross_sales'] ?? 0),
    97	                    (int) ($raw['sale_count'] ?? 0),
    98	                ),
    99	                'purchase_count' => (int) ($raw['purchase_count'] ?? 0),
   100	                'purchase_amount' => (int) ($raw['purchase_amount'] ?? 0),
   101	                'discard_count' => (int) ($raw['waste_count'] ?? 0),
   102	                'out_of_stock_count' => (int) ($raw['shortage_count'] ?? 0),
   103	            ];
   104	        }
   105	
   106	        return $rows;
   107	    }
   108	
   109	    /**
   110	     * @param list<int> $targetBaseInfoIds
   111	     *
   112	     * @return array<int, array<string, int|float|string>>
   113	     */
   114	    private function fetchMonthlySummary(
   115	        \DateTimeInterface $dateFrom,
   116	        \DateTimeInterface $dateTo,
   117	        array $targetBaseInfoIds,
   118	        bool $mailOrderEnabled,
   119	    ): array {
   120	        $from = \DateTimeImmutable::createFromInterface($dateFrom)->modify('first day of this month')->setTime(0, 0, 0);
   121	        $to = \DateTimeImmutable::createFromInterface($dateTo)->modify('first day of this month')->setTime(0, 0, 0);
   122	        if ($from > $to) {
   123	            [$from, $to] = [$to, $from];
   124	        }
   125	
   126	        $rowsRaw = $this->dtbMonthlySummaryRepository->fetchSummaryRowsByMonthRangeAndTargets($from, $to, $targetBaseInfoIds);
   127	
   128	        $rows = [];
   129	        foreach ($rowsRaw as $raw) {
   130	            $storeName = $this->resolveStoreName(
   131	                (int) ($raw['base_info_id'] ?? 0),
   132	                (string) ($raw['short_name_jp'] ?? ''),
   133	                (string) ($raw['shop_name'] ?? ''),
   134	                $mailOrderEnabled
   135	            );
   136	            $rows[] = [
   137	                'order_date' => (new \DateTime((string) $raw['summary_month']))->format('Y/n'),
   138	                'store_name' => $storeName,
   139	                'order_amount_order' => (int) ($raw['gross_sales'] ?? 0),
   140	                'cost' => (int) ($raw['total_cost'] ?? 0),
   141	                'gross_profit' => (int) ($raw['gross_profit'] ?? 0),
   142	                'order_count_order' => (int) ($raw['sale_quantity'] ?? 0),
   143	                'buyer_count' => (int) ($raw['sale_count'] ?? 0),
   144	                'order_average_order' => self::calcOrderAverage(
   145	                    (int) ($raw['gross_sales'] ?? 0),
   146	                    (int) ($raw['sale_count'] ?? 0),
   147	                ),
   148	                'purchase_count' => (int) ($raw['purchase_count'] ?? 0),
   149	                'purchase_amount' => (int) ($raw['purchase_amount'] ?? 0),
   150	                'discard_count' => (int) ($raw['waste_count'] ?? 0),
   151	                'out_of_stock_count' => (int) ($raw['shortage_count'] ?? 0),
   152	            ];
   153	        }
   154	
   155	        return $rows;
   156	    }
