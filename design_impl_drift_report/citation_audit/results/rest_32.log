   106	    /**
   107	     * @return array<string, int>
   108	     */
   109	    private function getPublishedStoreChoices(): array
   110	    {
   111	        $BaseInfos = $this->baseInfoRepository->getPublicTenantShopsForSummary();
   112	        $choices = [];
   113	
   114	        foreach ($BaseInfos as $BaseInfo) {
   115	            $label = trim($BaseInfo->getShortNameJp());
   116	            if ($label === '') {
   117	                $label = (string) ($BaseInfo->getShopName() ?? '');
   118	            }
   119	            if ($label === '') {
   120	                continue;
   121	            }
   122	            $id = $BaseInfo->getId();
   123	            if ($id === null) {
   124	                continue;
   125	            }
   126	            $uniqueLabel = $label;
   127	            if (isset($choices[$uniqueLabel])) {
   128	                $uniqueLabel = sprintf('%s (ID:%d)', $label, $id);
   129	            }
   130	            $choices[$uniqueLabel] = $id;
   131	        }
   132	
   133	        return $choices;
   134	    }
