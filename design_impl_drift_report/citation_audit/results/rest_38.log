   484	    /**
   485	     * イベント申込更新
   486	     * @param Application $app
   487	     * @param Request $request
   488	     * @param integer $eventEntryId イベント申込ID
   489	     * @return \Symfony\Component\HttpFoundation\Response
   490	     */
   491	    public function update(Application $app, Request $request, $eventEntryId)
   492	    {
   493	        $this->app = $app;
   494	        // フォーム入力値
   495	        $form = $app['form.factory']->createBuilder('admin_entry_detail')->getForm();
   496	        $form->handleRequest($request);
   497	
   498	        if (!$eventEntry = $app['hareruya_ec.repository.event_entry']->find($eventEntryId)) {
   499	            return $app->abort(404);
   500	        }
   501	        if (!$form->isSubmitted()) {
   502	            $app->addError('admin.register.failed', 'admin');
   503	
   504	            return $app->redirect($app->url('admin_entry_edit', ['eventEntryId' => $eventEntryId]));
   505	        }
   506	
   507	        if (!$this->isFormValid($app, $form)) {
   508	            if (!$form['price']->isValid()) {
   509	                $app->addError('form.price.message', 'admin');
   510	            } elseif (!$form['entryPlayerList']->isValid()) {
   511	                $app->addError('form.entry.duplicate', 'admin');
   512	            } else {
   513	                $app->addError('admin.register.failed', 'admin');
   514	            }
   515	
   516	            // 詳細画面表示
   517	            return $app->render('HareruyaEc/Resource/template/admin/Entry/entrydetail.twig', [
   518	                'form' => $form->createView(),
   519	                'eventEntry' => $eventEntry,
   520	                'entryPlayers' => $eventEntry->getEntryPlayers(),
   521	                'teamMemberCount' => $eventEntry->getEventDetail()->getEvent()->getTeamMemberCount(),
   522	                'page_count' => $app['config']['default_page_count'],
   523	            ]);
   524	        }
   525	        // フォームからデータ設定
   526	        $this->setValues($eventEntry, $form, [
   527	                'eventDetailId',
   528	                'eventEntryId',
   529	                'entryStatusId',
   530	                'paymentId',
   531	                'payment',
   532	                'entryPlayers',
   533	                'entryHistories',
   534	                'payment',
   535	                'payingCustomerId',
   536	                'payingCustomer',
   537	        ]);
   538	        // 申込履歴
   539	        $app['hareruya_ec.repository.entry_history']->createEntryHistory($app, $eventEntry, true);
   540	        // 更新
   541	        $app['orm.em']->persist($eventEntry);
   542	        $app['orm.em']->flush();
   543	
   544	        // プレイヤー情報
   545	        $entryPlayers = $eventEntry->getEntryPlayers();
   546	        $playersList = json_decode($form['entryPlayerList']->getData(), true);
   547	        foreach ($entryPlayers as $entryPlayer) {
   548	            if (in_array($entryPlayer->getPlayerId(), array_column($playersList, 'id'))) {
   549	                // 参加継続プレイヤー（確認フラグ他の変更がある場合、新しい情報に更新）
   550	                $key = array_search($entryPlayer->getPlayerId(), array_column($playersList, 'id'));
   551	                if ($playersList[$key]['confirm']   != $entryPlayer->getConfirmFlg()
   552	                 || $playersList[$key]['seat']      != $entryPlayer->getSeatOrder()) {
   553	                    $entryPlayer->setConfirmFlg($playersList[$key]['confirm']);
   554	                    $entryPlayer->setSeatOrder($playersList[$key]['seat']);
   555	                    $app['orm.em']->persist($entryPlayer);
   556	                }
   557	            } else {
   558	                // 外れたプレイヤー
   559	                $app['orm.em']->remove($entryPlayer);
   560	            }
   561	        }
   562	        foreach ($playersList as $listItem) {
   563	            if (!$eventEntry->isEntriedByPlayerIdAll($listItem['id'])) {
   564	                // 新規プレイヤー
   565	                $newEntryPlayer = new DtbEntryPlayer();
   566	                $newEntryPlayer
   567	                    ->setEventEntryId($eventEntry->getEventEntryId())
   568	                    ->setPlayerId($listItem['id'])
   569	                    ->setConfirmFlg($listItem['confirm'])
   570	                    ->setSeatOrder($listItem['seat'])
   571	                    ->setEventEntry($eventEntry)
   572	                    ->setPlayer($app['hareruya_ec.repository.player']->find($listItem['id']));
   573	                $app['orm.em']->persist($newEntryPlayer);
   574	            }
   575	        }
   576	
   577	        $app['orm.em']->flush();
   578	
   579	        $app->addSuccess('admin.register.complete', 'admin');
   580	
   581	        return $app->redirect($app->url('admin_entry_edit', ['eventEntryId' => $eventEntryId]));
   582	    }
