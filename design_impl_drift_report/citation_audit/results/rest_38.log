   776	                'main' => CardUtil::decodeCardlist($app, $deck->getTextMain()),
   777	                'side' => CardUtil::decodeCardlist($app, $deck->getTextSide()),
   778	            ];
   779	
   780	            $mainCount = array_sum(array_column($deckText['main'], 'count'));
   781	            $sideCount = array_sum(array_column($deckText['side'], 'count'));
   782	
