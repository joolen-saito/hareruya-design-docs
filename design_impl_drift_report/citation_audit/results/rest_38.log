   176	    public function searchEventHtml(Application $app, Request $request, $page_no = null)
   177	    {
   178	        $pageNo = $page_no;
   179	        $session = $request->getSession();
   180	        $data = [];
   181	        $pagination = [];
   182	        if (!$request->isXmlHttpRequest()) {
   183	            return $app->render('HareruyaEc/Resource/template/admin/Entry/search_event.twig', [
   184	                'datas' => $datas,
   185	                'pagination' => $pagination,
   186	                'modal' => ($request->get('modal') === 'true'),
   187	            ]);
   188	        }
   189	
   190	        $pageCount = $app['config']['default_page_count'];
   191	        // フォーム取得
   192	        $builder = $app['form.factory']->createBuilder($this->formName);
   193	        // 検索ボタンから遷移
   194	        if ('POST' === $request->getMethod()) {
   195	            $pageNo = 1;
   196	            $searchData = [
   197	                'multi' => $request->get('search_word'),
   198	                'start_date_from' => \DateTime::createFromFormat('Y-m-d', $request->get('from')),
   199	                'start_date_to' => \DateTime::createFromFormat('Y-m-d', $request->get('to')),
   200	                'formats' => null,
   201	                'shop' => $request->get('search_shop'),
   202	                'rel' => null,
   203	                'sort' => 'eventIdAndEventDetailId',
   204	                'order' => 'DESC',
   205	                'entry' => ($request->get('entry') === 'true'),
   206	            ];
   207	            // Sessionに追加
   208	            $session->set('admin.entry.event.search', $searchData);
   209	            $session->set('admin.entry.event.search.page_no', $pageNo);
   210	        // ページ番号からの遷移
   211	        } else {
   212	            $searchData = (array)$session->get('admin.entry.event.search');
   213	            // ページ番号が取得できない場合Sessionから取得
   214	            if (is_null($pageNo)) {
   215	                $pageNo = intval($session->get('admin.entry.event.search.page_no'));
   216	            } else {
   217	                $session->set('admin.entry.event.search.page_no', $pageNo);
   218	            }
   219	        }
   220	
   221	        // イベント情報検索
   222	        $qb = $app['hareruya_ec.repository.event_detail']->getQueryBuilderBySearchData($searchData);
   223	        $pagination = $app['paginator']()->paginate(
   224	            $qb,
   225	            $pageNo,
   226	            $pageCount,
   227	            ['wrap-queries' => true]
   228	        );
   229	
   230	        $detailArr = $pagination->getItems();
   231	        $datas = [];
   232	        $before = -1;
   233	        $continuation = 1;
   234	        foreach ($detailArr as $detail) {
   235	            $event = $detail->getEvent();
   236	            $formatNames = [];
   237	            foreach ($event->getFormats() as $format) {
   238	                $formatNames[] = $format->getNameJp();
   239	            }
   240	            $datas[] = [
   241	                'eventId' => $event->getEventId(),
   242	                'name' => sprintf('%s %s', $event->getNameJp(), $event->getNameEn()),
   243	                'shop' => $event->getShop()->getNameJp(),
   244	                'formatNames' => $formatNames,
   245	                'startDate' => $detail->getStartDate(),
   246	                'rowSpan' => 0,
   247	                'eventDetailId' => $detail->getEventDetailId(),
   248	            ];
   249	            // 同EventId連続数カウント(表中の同じイベントの名前は、rowspanで繋げて表示する)
   250	            if ($event->getEventId() == $before) {
   251	                $continuation ++;
   252	            } else {
   253	                $continuation = 1;
   254	            }
   255	            $datas[count($datas) - $continuation]['rowSpan'] = $continuation;
   256	            $before = $event->getEventId();
   257	        }
   258	
   259	        return $app->render('HareruyaEc/Resource/template/admin/Entry/search_event.twig', [
   260	            'datas' => $datas,
   261	            'pagination' => $pagination,
   262	            'modal' => ($request->get('modal') === 'true'),
   263	        ]);
   264	    }
