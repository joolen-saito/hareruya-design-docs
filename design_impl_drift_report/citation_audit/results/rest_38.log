     3	namespace Plugin\HareruyaEc\Form\Type\Admin\Entry;
     4	
     5	use Symfony\Component\Form\AbstractType;
     6	use Symfony\Component\Form\Extension\Core\Type;
     7	use Symfony\Component\Form\FormBuilderInterface;
     8	use Symfony\Component\Validator\Constraints as Assert;
     9	use Plugin\HareruyaEc\Form\Type\Admin\Entry\EntryDuplicate;
    10	use Plugin\HareruyaEc\Form\Type\Admin\Entry\PaymentDiff;
    11	use Doctrine\ORM\EntityRepository;
    12	use Plugin\HareruyaEc\Entity\Payment;
    13	
    14	class EntryDetailType extends AbstractType
    15	{
    16	    public function __construct($app)
    17	    {
    18	        $this->app = $app;
    19	    }
    20	
    21	    /**
    22	     * イベント詳細画面の入力フォーム生成
    23	     *
    24	     * @param FormBuilderInterface $builder
    25	     * @param array $options
    26	     */
    27	    public function buildForm(FormBuilderInterface $builder, array $options)
    28	    {
    29	        $app = $this->app;
    30	        $length = $app['config']['HareruyaEc']['const']['event']['length'];
    31	
    32	        $builder
    33	        // 申込状況
    34	        ->add('entryStatus', 'entity', array(
    35	            'label' => $this->app['translator']->trans('form.entry_status.label'),
    36	            'required' => true,
    37	            'class' => 'Plugin\HareruyaEc\Entity\MtbEntryStatus',
    38	        ))
    39	        // 支払方法
    40	        ->add('payment', 'entity', array(
    41	            'label' => $this->app['translator']->trans('form.payment.label'),
    42	            'required' => true,
    43	            'class' => 'Eccube\Entity\Payment',
    44	            'constraints' => array(
    45	                new PaymentDiff($this->app),
    46	            ),
    47	            'query_builder' => function (EntityRepository $er) {
    48	                $qb = $er->createQueryBuilder('p');
    49	
    50	                return $qb
    51	                    ->where($qb->expr()->in('p.id', [Payment::EC_CREDIT, Payment::EC_CVS, Payment::EC_ADMIN]))
    52	                    ->orderBy('p.rank', 'ASC');
    53	            },
    54	            'disabled' => true,
    55	        ))
    56	        // 支払金額
    57	        ->add('price', 'money', array(
    58	            'label' => $this->app['translator']->trans('form.price.label'),
    59	            'required' => true,
    60	            'currency' => 'JPY',
    61	            'scale' => 0,
    62	            'constraints' => array(
    63	                // 金額（数字）のみ
    64	                new Assert\Regex(array(
    65	                    'pattern' => '/^[0-9]+$/',
    66	                )),
    67	            ),
    68	        ))
    69	        // イベント詳細ID
    70	        ->add('eventDetailId', 'hidden')
    71	        // イベント申込ID
    72	        ->add('eventEntryId', 'hidden')
    73	        // プレイヤー情報リスト(JSON形式、{id : ??, confirm : ??, seat : ??})
    74	        ->add('entryPlayerList', 'hidden', array(
    75	            'required' => true,
    76	            'constraints' => array(
    77	                new EntryDuplicate($this->app),
    78	            ),
    79	        ))
    80	        // プレイヤー検索
    81	        ->add('search', 'text', array(
    82	            'required' => false,
    83	        ))
    84	        ;
    85	    }
    86	
