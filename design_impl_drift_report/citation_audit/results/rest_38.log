   762	        $searchData = FormUtil::submitAndGetData($searchForm, $viewData);
   763	        $sort = $request->get('sort');
   764	        $order = $request->get('order');
   765	        $searchData['sort'] = isset($sort) ? $sort : $this->defaultSort;
   766	        $searchData['order'] = isset($order) ? $order : $this->defaultOrder;
   767	        $eventDecks = $app['hareruya_ec.repository.deck']->getEntryDeckData($searchData);
   768	        $dispDecks = [];
   769	        $i = 0;
   770	
   771	        // ページ分割
   772	        foreach ($eventDecks as $deck) {
   773	            $dispDecks[$i] = [];
   774	
   775	            $deckText = [
   776	                'main' => CardUtil::decodeCardlist($app, $deck->getTextMain()),
   777	                'side' => CardUtil::decodeCardlist($app, $deck->getTextSide()),
   778	            ];
   779	
   780	            $mainCount = array_sum(array_column($deckText['main'], 'count'));
   781	            $sideCount = array_sum(array_column($deckText['side'], 'count'));
   782	
   783	            // １ページ分で分割
   784	            $chunks = array_chunk($deckText['main'], 40);
   785	            $j = 0;
   786	            foreach ($chunks as $chunk) {
   787	                // サイドボードを1ページ目にあれば設定
