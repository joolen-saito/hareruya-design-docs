     2	namespace Plugin\HareruyaEc\Form\Type\Admin\Entry;
     3	
     4	use Symfony\Component\Validator\ConstraintValidator;
     5	use Symfony\Component\Validator\Constraint;
     6	use Plugin\HareruyaEc\Entity\DtbEventEntry;
     7	
     8	class EntryDuplicateValidator extends ConstraintValidator
     9	{
    10	    /**
    11	     * validate
    12	     * @param $value entryPlayer
    13	     * @param $constraint Constraint
    14	     */
    15	    public function validate($value, Constraint $constraint)
    16	    {
    17	        $form = $this->context->getRoot();
    18	        $eventEntryId = $form['eventEntryId']->getData();
    19	        if ($eventEntryId) {
    20	            $eventEntry = $constraint->app['orm.em']->getRepository('Plugin\HareruyaEc\Entity\DtbEventEntry')->find($eventEntryId);
    21	        } else {
    22	            $eventEntry = new DtbEventEntry();
    23	            $eventEntry->setEventDetail(
    24	                $constraint->app['orm.em']->getRepository('Plugin\HareruyaEc\Entity\DtbEventDetail')->find($form['eventDetailId']->getData())
    25	            );
    26	        }
    27	        if (!$eventEntry) {
    28	            $constraint->app->abort(404);
    29	        }
    30	        // 登録不能なプレイヤーが居るか確認
    31	        $playersList = json_decode($value, true);
    32	        foreach (array_column($playersList, 'id') as $playerId) {
    33	            if ($playerId && (
    34	                !$constraint->app['hareruya_ec.repository.player']->find($playerId)
    35	                || (
    36	                    $eventEntry->getEventDetail()->isEntriedByPlayerId((int)$playerId)
    37	                    && !$eventEntry->isEntriedByPlayerId((int)$playerId)
    38	                )
    39	            )) {
    40	                $this->context
    41	                ->buildViolation($constraint->app->trans('form.entry.duplicate'))
    42	                ->addViolation();
    43	            }
    44	        }
    45	    }
    46	}
