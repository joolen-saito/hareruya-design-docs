    22	
    23	class EntryPlayerEntityManager
    24	{
    25	    public function __construct(
    26	        private EntityManagerInterface $entityManager,
    27	    ) {
    28	    }
    29	
    30	    public function save(
    31	        ?DtbEntryPlayer $EntryPlayer,
    32	        DtbEventEntry $EventEntry,
    33	        DtbPlayer $Player,
    34	        bool $confirmFlg,
    35	        int $seatOrder,
    36	    ): DtbEntryPlayer {
    37	        $EntryPlayer = $EntryPlayer ?? new DtbEntryPlayer();
    38	
    39	        $EntryPlayer->setEventEntry($EventEntry);
    40	        $EntryPlayer->setPlayer($Player);
    41	        $EntryPlayer->setConfirmFlg($confirmFlg);
    42	        $EntryPlayer->setSeatOrder($seatOrder);
    43	
    44	        $this->entityManager->persist($EntryPlayer);
    45	
    46	        return $EntryPlayer;
    47	    }
    48	}

