   407	    /**
   408	     * イベント申込新規登録
   409	     * @param Application $app
   410	     * @param Request $request
   411	     * @param integer $eventDetailId イベント詳細ID
   412	     * @return \Symfony\Component\HttpFoundation\Response
   413	     */
   414	    public function create(Application $app, Request $request, $eventDetailId)
   415	    {
   416	        $this->app = $app;
   417	        // フォーム入力値
   418	        $form = $app['form.factory']->createBuilder('admin_entry_detail')->getForm();
   419	        $form->handleRequest($request);
   420	        if (!$form->isSubmitted()) {
   421	            $app->addError('admin.register.failed', 'admin');
   422	
   423	            return $app->redirect($app->url('admin_entry_new', [
   424	                'eventDetailId' => $form['eventDetailId']->getData()
   425	            ]));
   426	        }
   427	
   428	        if (!$this->isFormValid($app, $form)) {
   429	            if (!$form['price']->isValid()) {
   430	                $app->addError('form.price.message', 'admin');
   431	            } else {
   432	                $app->addError('form.entry.duplicate', 'admin');
   433	            }
   434	
   435	            return $app->redirect($app->url('admin_entry_new', ['eventDetailId' => $form['eventDetailId']->getData()]));
   436	        }
   437	        // 新規イベント申込情報の作成
   438	        $eventEntry = new DtbEventEntry();
   439	        $playersList = json_decode($form['entryPlayerList']->getData(), true);
   440	        // フォームからデータ設定
   441	        $this->setValues($eventEntry, $form, [
   442	            'eventDetailId',
   443	            'eventEntryId',
   444	            'entryStatusId',
   445	            'entryStatus',
   446	            'paymentId',
   447	            'payment',
   448	            'entryPlayers',
   449	            'entryHistories',
   450	            'payingCustomerId',
   451	            'payingCustomer',
   452	        ]);
   453	        $eventEntry->setEventDetail(
   454	            $app['orm.em']->getRepository('Plugin\HareruyaEc\Entity\DtbEventDetail')->find($eventDetailId)
   455	        );
   456	        $eventEntry->setPayingCustomer($app['hareruya_ec.repository.player']->find($playersList[0]['id'])->getCustomer());
   457	        // entryStatus及びpaymentは、入力不能につき固定の値を入れる
   458	        $eventEntry->setEntryStatus($app['hareruya_ec.repository.entry_status']->find(MtbEntryStatus::ENTERED));
   459	        $eventEntry->setPayment($app['eccube.repository.payment']->find(Payment::EC_ADMIN));
   460	        // EventEntryのIDを得る為、プレイヤーより先にDB登録を済ませる
   461	        $app['orm.em']->persist($eventEntry);
   462	        $app['orm.em']->flush();
   463	        // 申込履歴
   464	        $app['hareruya_ec.repository.entry_history']->createEntryHistory($app, $eventEntry, true);
   465	        // プレイヤー情報登録
   466	        $eventEntryId = $eventEntry->getEventEntryId();
   467	        foreach ($playersList as $listItem) {
   468	            $entryPlayer = new DtbEntryPlayer();
   469	            $entryPlayer
   470	                ->setEventEntryId($eventEntryId)
   471	                ->setPlayerId($listItem['id'])
   472	                ->setConfirmFlg($listItem['confirm'])
   473	                ->setSeatOrder($listItem['seat'])
   474	                ->setEventEntry($eventEntry)
   475	                ->setPlayer($app['hareruya_ec.repository.player']->find($listItem['id']));
   476	            $app['orm.em']->persist($entryPlayer);
   477	        }
   478	        $app['orm.em']->flush();
   479	        $app->addSuccess('admin.register.complete', 'admin');
   480	
   481	        return $app->redirect($app->url('admin_entry_edit', ['eventEntryId' => $eventEntryId]));
   482	    }
