     8	use Plugin\HareruyaEc\Entity\MtbPointType;
     9	
    10	class CheckSmaregiTransaction
    11	{
    12	    const IS_CANCEL = 1; // 取消区分：取消
    13	    const IS_DISPOSE = 2; // 打消区分：打消レコード
    14	
    15	    protected $app;
    16	    protected $options = [];
    17	
    18	    /**
    19	     * Constructor
    20	     * @param Eccube\Application $app
    21	     * @param array $options
    22	     */
    23	    public function __construct(Application $app, $options = [])
    24	    {
    25	        $this->app = $app;
    26	        $this->options = $options;
    27	    }
    28	
    29	    /**
    30	     * スマレジAPIから取引情報を確認し、連携エラーしたものに対してポイントを再連携
    31	     */
    32	    public function execute()
    33	    {
    34	        $app = $this->app;
    35	        $optionValues = $this->getOptionValues($app);
    36	
    37	        $now = new \DateTime();
    38	
    39	        $result = $this->cURLSmaregi(
    40	            $optionValues[MtbOption::SMAREGI_REQUEST_URL],
    41	            $this->getHeader($optionValues),
    42	            'transaction_ref',
    43	            json_encode($this->getTransactionParams($app, $now))
    44	        );
    45	
    46	        if (isset($result['error'])) {
    47	            log_info("取引情報取得失敗：{$result['error']}：詳細：{$result['error_description']}");
    48	            echo "取引情報取得失敗：{$result['error']}：{$result['error_description']}";
    49	
    50	            return 1;
    51	        }
    52	
    53	        if (empty($result['result'])) {
    54	            return 0;
    55	        }
    56	
    57	        $this->updateSmaregiTransaction($app, $result['result']);
    58	
    59	        return 0;
    60	    }
    61	
    62	    /**
    63	     * オプションkey-value配列取得
    64	     *
    65	     * @param Applicattion $app
    66	     * @return array
    67	     */
    68	    private function getOptionValues($app)
    69	    {
    70	        $options = $app['hareruya_ec.repository.option']->findListArray([
    71	            MtbOption::SMAREGI_CONTRACT_ID,
    72	            MtbOption::SMAREGI_ACCESS_TOKEN,
    73	            MtbOption::SMAREGI_REQUEST_URL,
    74	            MtbOption::SMAREGI_STORE_ID,
    75	            MtbOption::SMAREGI_CATEGORY_ID]
    76	        );
    77	
    78	        return array_column($options, 'optionValue', 'optionKey');
    79	    }
    80	
    81	    /**
    82	     * スマレジAPIヘッダ取得
    83	     *
    84	     * @param array $optionValues
    85	     * @return array
    86	     */
    87	    private function getHeader($optionValues)
    88	    {
    89	        $header = [
    90	            "X_contract_id: {$optionValues[MtbOption::SMAREGI_CONTRACT_ID]}",
    91	            "X_access_token: {$optionValues[MtbOption::SMAREGI_ACCESS_TOKEN]}",
    92	            'Content-Type: application/x-www-form-urlencoded;charset=UTF-8',
    93	        ];
    94	
    95	        return $header;
    96	    }
    97	
    98	    /**
    99	     * スマレジへのデータ送信処理
   100	     *
   101	     * @param  string $url
   102	     * @param  string $header
   103	     * @param  string $process
   104	     * @param  string $param
   105	     * @return array
   106	     */
   107	    private function cURLSmaregi($url, $header, $process, $param)
   108	    {
   109	        $curl = curl_init();
   110	        curl_setopt($curl, CURLOPT_URL, $url);
   111	        curl_setopt($curl, CURLOPT_CUSTOMREQUEST, 'POST');
   112	        curl_setopt($curl, CURLOPT_HTTPHEADER, $header);
   113	        curl_setopt($curl, CURLOPT_POSTFIELDS, "proc_name={$process}&params=" . $param);
   114	        curl_setopt($curl, CURLOPT_SSL_VERIFYPEER, false);
   115	        curl_setopt($curl, CURLOPT_RETURNTRANSFER, true);
   116	        curl_setopt($curl, CURLOPT_HEADER, true);
   117	
   118	        $response = curl_exec($curl);
   119	
   120	        $headerSize = curl_getinfo($curl, CURLINFO_HEADER_SIZE);
   121	        $body = substr($response, $headerSize);
   122	        $result = json_decode($body, true);
   123	
   124	        curl_close($curl);
   125	
   126	        return $result;
   127	    }
   128	
   129	    /**
   130	     * 取引情報照会パラメータ
   131	     *
   132	     * @param Applicattion $app
   133	     * @param  Datetime $now
   134	     * @return array
   135	     */
   136	    private function getTransactionParams(Application $app, $now)
   137	    {
   138	        $nowStr = $now->format('Y-m-d H:i:s');
   139	        $startDatetime = $now->modify("-{$app['config']['HareruyaEc']['const']['smaregi']['transaction_period_hours']} hours");
   140	
   141	        return [
   142	            'conditions' => [
   143	                [
   144	                    'transactionHeadDivision' => '1',
   145	                    'updDateTime >=' => $startDatetime->format('Y-m-d H:i:s'), // 取引日時の検索開始日時
   146	                    'updDateTime <' => $nowStr,
   147	                ],
   148	            ],
   149	            'order' => [
   150	                'transactionHeadId'
   151	            ],
   152	            'table_name' => 'TransactionHead' ,
   153	        ];
   154	    }
   155	
   156	    /**
   157	     * 取引情報リストからポイント履歴に登録されていない取引を反映
   158	     */
   159	    private function updateSmaregiTransaction(Application $app, $transactions)
   160	    {
   161	        $updateCount = 0;
   162	        foreach ($transactions as $transaction) {
   163	            $transactionId = $transaction['transactionHeadId'];
   164	            $pointHistories = $app['hareruya_ec.repository.point_history']->findByTransactionId($transactionId);
   165	
   166	            if (((int)$transaction['cancelDivision'] === self::IS_CANCEL) && !empty($pointHistories)) {
   167	                log_info("未削除のキャンセルスマレジ取引ID：{$transactionId}");
   168	
   169	                $updateCount += $this->cancelCustomerPoint(
   170	                    $app, $transaction['customerId'], $transaction['newPoint'], $transaction['spendPoint'], $transactionId
   171	                );
   172	            } elseif ((int)$transaction['disposeDivision'] === self::IS_DISPOSE) {
   173	                // 打消レコードの場合はnewPoint,spendPointともに負の値を持つので正負を反転させる
   174	                $updateCount += $this->cancelCustomerPoint(
   175	                    $app, $transaction['customerId'], -$transaction['newPoint'], -$transaction['spendPoint'], $transaction['disposeServerTransactionHeadId']
   176	                );
   177	            } elseif (((int)$transaction['cancelDivision'] !== self::IS_CANCEL) && ((int)$transaction['disposeDivision'] !== self::IS_DISPOSE) && empty($pointHistories)) {
   178	                log_info("未登録のスマレジ取引ID：{$transactionId}");
   179	
   180	                $updateCount += $this->updateCustomerPoint(
   181	                    $app, $transaction['customerId'], $transaction['newPoint'], $transaction['spendPoint'], $transactionId
   182	                );
   183	            }
   184	        }
   185	
   186	        if ($updateCount > 0) {
   187	            log_info("スマレジ取引処理件数:{$updateCount}");
   188	        }
   189	    }
   190	
   191	    /**
   192	     * 会員の購入通知ポイント情報関連を更新する
   193	     *
   194	     * @param Application $app
   195	     * @param string $smaregiId
   196	     * @param integer $gainPoint
   197	     * @param integer $spendPoint
   198	     * @param integer $transactionHeadId
   199	     * @return integer
   200	     */
   201	    private function updateCustomerPoint(Application $app, $smaregiId, $gainPoint, $spendPoint, $transactionHeadId)
   202	    {
   203	        $player = $app['hareruya_ec.repository.player']->findOneBySmaregiId($smaregiId);
   204	        if (is_null($player)) {
   205	            return 0;
   206	        }
   207	
   208	        $newPoint = $player->getPoint() + $gainPoint - $spendPoint;
   209	        $player->setPoint($newPoint);
   210	        $app['orm.em']->persist($player);
   211	
   212	        $purchaseType = $app['hareruya_ec.repository.point_type']->find(MtbPointType::PURCHASE_TYPE);
   213	        if ($gainPoint > 0) {
   214	            $gainPointHistory = new DtbPointHistory();
   215	            $gainPointHistory
   216	                ->setCustomer($player->getCustomer())
   217	                ->setPointChange($gainPoint)
   218	                ->setNote($app->trans('front.smaregi.shop.gain'))
   219	                ->setIssueDate(new \DateTime())
   220	                ->setCreateDate(new \DateTime())
   221	                ->setPointType($purchaseType)
   222	                ->setTransactionId($transactionHeadId);
   223	            $app['orm.em']->persist($gainPointHistory);
   224	        }
   225	        if ($spendPoint > 0) {
   226	            $spendPointHistory = new DtbPointHistory();
   227	            $spendPointHistory
   228	                ->setCustomer($player->getCustomer())
   229	                ->setPointChange(-$spendPoint)
   230	                ->setNote($app->trans('front.smaregi.shop.spend'))
   231	                ->setIssueDate(new \DateTime())
   232	                ->setCreateDate(new \DateTime())
   233	                ->setPointType($purchaseType)
   234	                ->setTransactionId($transactionHeadId);
   235	            $app['orm.em']->persist($spendPointHistory);
   236	        }
   237	
   238	        $app['orm.em']->flush();
   239	
   240	        return 1;
   241	    }
