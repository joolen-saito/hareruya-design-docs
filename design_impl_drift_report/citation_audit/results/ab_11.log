    41	    public function __construct(
    42	        private readonly ClientInterface $httpClient,
    43	        private readonly LoggerInterface $logger,
    44	        private readonly SmaregiPlatformApiCallRecorder $platformApiCallRecorder,
    45	        private readonly TransactionResponseParser $responseParser,
    46	    ) {
    47	    }
    48	
    49	    /**
    50	     * @return array{statusCode:int,headers:array<string,array<string>>,body:string,json:array<string,mixed>|null,dto:TransactionDto|null}
    51	     */
    52	    public function getTransaction(
    53	        string $apiUrl,
    54	        string $contractId,
    55	        string $accessToken,
    56	        string $transactionHeadId,
    57	    ): array {
    58	        $url = sprintf(
    59	            '%s/%s/pos/transactions/%s',
    60	            rtrim($apiUrl, '/'),
    61	            $contractId,
    62	            rawurlencode($transactionHeadId),
    63	        );
    64	
    65	        $response = $this->requestGet(
    66	            SmaregiPlatformApiCallLog::OPERATION_TRANSACTION_GET,
    67	            $url,
    68	            $accessToken,
    69	            self::TRANSACTION_GET_FIXED_QUERY,
    70	            [
    71	                'transactionHeadId' => $transactionHeadId,
    72	            ],
    73	        );
    74	
    75	        $dto = null;
    76	        if (is_array($response['json'])) {
    77	            try {
    78	                $dto = $this->responseParser->parse($response['json']);
    79	            } catch (\Throwable $e) {
    80	                $this->logger->error('Smaregi transaction response parse failed', [
    81	                    'transactionHeadId' => $transactionHeadId,
    82	                    'error' => $e->getMessage(),
    83	                ]);
    84	            }
    85	        }
    86	
    87	        return $response + ['dto' => $dto];
    88	    }
    89	
    90	    /**
    91	     * 取引一覧を取得する（Webhook 未達期間の受信漏れを補完する再連携バッチ等で使用する）.
    92	     *
    93	     * ページング（page / limit）と期間指定は公式 API のクエリキーに準拠して呼び出し側が $query に指定し、
    94	     * ページ送りのループも呼び出し側で制御する（在庫の {@see SmaregiStockApiClient::listStocks} と同方針）。
    95	     * 参考: https://developers.smaregi.dev/platform-api-reference/apis/pos/operations/gettransactions/
    96	     *
    97	     * @param array<string,string> $query page / limit / 期間指定 等の公式クエリキー
    98	     *
    99	     * @return array{statusCode:int,headers:array<string,array<string>>,body:string,json:array<int,array<string,mixed>>|null}
   100	     */
   101	    public function listTransactions(
   102	        string $apiUrl,
   103	        string $contractId,
   104	        string $accessToken,
   105	        array $query = [],
   106	    ): array {
   107	        $url = sprintf('%s/%s/pos/transactions', rtrim($apiUrl, '/'), $contractId);
   108	
   109	        return $this->requestGet(
   110	            SmaregiPlatformApiCallLog::OPERATION_TRANSACTION_LIST,
   111	            $url,
   112	            $accessToken,
   113	            $query,
   114	            [
   115	                'queryKeys' => array_keys($query),
   116	            ],
   117	        );
   118	    }
   119	
   120	    /**
   121	     * @param array<string,string> $query
   122	     * @param array<string,mixed>  $logContext
   123	     *
   124	     * @return array{statusCode:int,headers:array<string,array<string>>,body:string,json:array<string,mixed>|array<int,array<string,mixed>>|null}
   125	     */
   126	    private function requestGet(
   127	        string $operation,
   128	        string $url,
   129	        string $accessToken,
   130	        array $query,
   131	        array $logContext,
   132	    ): array {
   133	        $headers = [
   134	            'Authorization' => 'Bearer '.$accessToken,
   135	            'Accept' => 'application/json',
   136	        ];
   137	        $queryString = http_build_query($query);
   138	        $requestUrl = $queryString === ''
   139	            ? $url
   140	            : $url.(str_contains($url, '?') ? '&' : '?').$queryString;
   141	        $started = hrtime(true);
   142	
   143	        try {
   144	            $response = $this->httpClient->request('GET', $url, [
   145	                'headers' => $headers,
   146	                'query' => $query,
   147	                'http_errors' => false,
   148	            ]);
   149	        } catch (\Throwable $e) {
   150	            $this->recordFailure($operation, 'GET', $requestUrl, $headers, null, $started, $e, $logContext);
   151	
   152	            return [
   153	                'statusCode' => 0,
   154	                'headers' => [],
   155	                'body' => '',
   156	                'json' => null,
   157	            ];
   158	        }
   159	
   160	        $statusCode = $response->getStatusCode();
   161	        $body = (string) $response->getBody();
   162	        /** @var array<string|int,array<string>> $responseHeaders */
   163	        $responseHeaders = $response->getHeaders();
   164	        $durationMs = (int) ((hrtime(true) - $started) / 1_000_000);
   165	
   166	        $decoded = $this->decodeJson($body);
   167	
   168	        try {
   169	            $this->platformApiCallRecorder->record(
   170	                $operation,
   171	                'GET',
   172	                $requestUrl,
   173	                $headers,
   174	                '',
   175	                $statusCode,
   176	                $responseHeaders,
   177	                $body,
   178	                $durationMs,
   179	                null,
   180	            );
    45	use Eccube\Service\Smaregi\Webhook\Transaction\PurchasePatternContextBuilder;
    46	use Eccube\Service\Smaregi\Webhook\Transaction\PurchasePatternResolver;
    47	use Eccube\Service\Smaregi\Webhook\Transaction\SmaregiOrderPointApplier;
    48	use Eccube\Service\Smaregi\Webhook\Transaction\SmaregiPointAdjustmentApplier;
    49	use Eccube\Service\Smaregi\Webhook\Transaction\SmaregiPointAdjustmentReverter;
    50	use Psr\Log\LoggerInterface;
    51	use Symfony\Component\Messenger\Attribute\AsMessageHandler;
    52	
    53	/**
    54	 * スマレジ取引取得 + action 別処理を 1 子ジョブとして消化する MessageHandler。
    55	 *
    56	 * 親ジョブ ({@see SmaregiWebhookEventMessageHandler}) は SmaregiWebhookEvent 単位での
    57	 * 受信状態を管理し、本ハンドラは transactionHeadId 単位の処理状態を MessengerJob として管理する。
    58	 *
    59	 * 主な責務:
    60	 *  1. 子 MessengerJob を {@see SmaregiMessengerJobProcessingLock} で悲観ロック + 状態遷移
    61	 *     (PENDING/FAILED → PROCESSING、COMPLETED は skip)
    62	 *  2. スマレジ取引取得 API 呼出
    63	 *  3. updateDateTime ベースの dedup ({@see SmaregiTransactionJobRepository::findLatestCompletedByTransaction()})
    64	 *     により、同一 (transactionHeadId, action) で過去に完了した updateDateTime 以下のリクエストを skip
    65	 *  4. action ('created' / 'edited' / 'canceled' / 'disposed') 別に Pattern Handler / Processor を実行
    66	 *  5. 処理結果を {@see SmaregiTransactionJob} に保存 (updateDateTime と共に)
    67	 *
    68	 * TODO: bulk-* も同パターンで子ジョブ化する
    69	 * TODO: webhook 到着順序が逆転して対応 Order が無い canceled/disposed の救済
    70	 */
    71	#[AsMessageHandler]
    72	final readonly class SmaregiTransactionProcessMessageHandler
    73	{
    74	    public function __construct(
    75	        private LoggerInterface $logger,
    76	        private EntityManagerInterface $entityManager,
    77	        private SmaregiMessengerJobProcessingLock $smaregiMessengerJobProcessingLock,
    78	        private MessengerJobRepository $messengerJobRepository,
    79	        private SmaregiWebhookEventRepository $smaregiWebhookEventRepository,
    80	        private SmaregiTransactionJobRepository $smaregiTransactionJobRepository,
    81	        private SmaregiMessengerJobContext $smaregiMessengerJobContext,
    82	        private SmaregiAccessTokenService $accessTokenService,
    83	        private SmaregiTransactionApiClient $transactionApiClient,
    84	        private PurchasePatternContextBuilder $contextBuilder,
    85	        private PurchasePatternResolver $patternResolver,
    86	        private OtcGuestPatternHandler $otcGuestPatternHandler,
    87	        private OtcMemberPatternHandler $otcMemberPatternHandler,
    88	        private EccubeSmoothOtcPatternHandler $eccubeSmoothOtcPatternHandler,
    89	        private EccubeOtcPatternHandler $eccubeOtcPatternHandler,
    90	        private SmaregiOrderPointApplier $pointApplier,
    91	        private SmaregiPointAdjustmentApplier $pointAdjustmentApplier,
    92	        private SmaregiPointAdjustmentReverter $pointAdjustmentReverter,
    93	        private SmaregiTransactionCanceledProcessor $canceledProcessor,
    94	        private SmaregiTransactionDisposedProcessor $disposedProcessor,
    95	        private SmaregiTransactionEditedProcessor $editedProcessor,
    96	        private string $smaregiApiIdUrl,
    97	        private string $smaregiApiUrl,
    98	        private string $smaregiApiClientId,
    99	        private string $smaregiApiClientSecret,
   100	        private string $smaregiApiContractId,
   101	    ) {
   102	    }
   103	
   104	    public function __invoke(SmaregiTransactionProcessMessage $message): void
   105	    {
   106	        $Job = $this->messengerJobRepository->find($message->getJobId());
   107	        if (!$Job instanceof MessengerJob) {
   108	            $this->logger->error('Smaregi transaction process job not found', [
   109	                'jobId' => $message->getJobId(),
   110	            ]);
   111	
   112	            return;
   113	        }
   114	
   115	        // スマレジ API 呼び出しログを当該子ジョブに紐付けるため、コンテキストへ jobId を設定する。
   116	        // ({@see \Eccube\Service\Smaregi\Api\SmaregiPlatformApiCallRecorder} は本 ID を見て記録の可否を判断する)
   117	        $this->smaregiMessengerJobContext->setJobId((int) $Job->getId());
   118	
   119	        try {
   120	            // 悲観ロック + PENDING/FAILED のときのみ PROCESSING へ遷移し、重複実行を抑止する。
   121	            if (!$this->smaregiMessengerJobProcessingLock->tryBeginProcessingJob($Job)) {
   122	                return;
   123	            }
   124	
   125	            $Event = $this->smaregiWebhookEventRepository->find($message->getSmaregiWebhookEventId());
   126	            if (!$Event instanceof SmaregiWebhookEvent) {
   127	                throw new \RuntimeException(sprintf('Smaregi webhook event not found (webhookEventId=%d)', $message->getSmaregiWebhookEventId()));
   128	            }
   129	
   130	            $this->processTransaction($Job, $Event, $message->getAction(), $message->getTransactionHeadId());
   131	
   132	            $Job->setStatus(MessengerJob::STATUS_COMPLETED);
   133	            $Job->setCompletedAt(new \DateTime());
   134	            $Job->setErrorMessage(null);
   135	            $this->entityManager->flush();
   136	        } catch (\Throwable $e) {
   137	            $this->logger->warning('Smaregi transaction process job failed', [
   138	                'jobId' => $Job->getId(),
   139	                'webhookEventId' => $message->getSmaregiWebhookEventId(),
   140	                'action' => $message->getAction(),
   141	                'transactionHeadId' => $message->getTransactionHeadId(),
   142	                'error' => $e->getMessage(),
   143	            ]);
   144	            $this->failJob($Job, $e);
