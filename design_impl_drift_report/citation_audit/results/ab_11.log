    27	class SmaregiTransactionApiClient
    28	{
    29	    /**
    30	     * @var array<string,string>
    31	     */
    32	    private const TRANSACTION_GET_FIXED_QUERY = [
    33	        'with_details' => 'all',
    34	        'with_payments' => 'none',
    35	        'with_discounts' => 'all',
    36	        'with_store' => 'all',
    37	        'with_customer' => 'all',
    38	        'with_staff' => 'all',
    39	    ];
