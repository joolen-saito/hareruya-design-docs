  1284	        event.preventDefault();
  1285	        const target = link.dataset.sheet;
  1286	        sheetLinks.forEach((item) => {
  1287	          if (item === link) {
  1288	            item.setAttribute("aria-current", "page");
  1289	          } else {
  1290	            item.removeAttribute("aria-current");
  1291	          }
  1292	        });
  1293	        document.querySelectorAll(".sheet-panel").forEach((panel) => {
  1294	          panel.classList.toggle("is-active", panel.id === target);
  1295	        });
  1296	      });
  1297	    });
