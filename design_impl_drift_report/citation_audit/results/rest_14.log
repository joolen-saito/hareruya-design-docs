    18	
    19	            $('.js-disposal-reason-form .edit-icon').click(function() {
    20	                const $container = $(this).closest('.editable-container');
    21	                const $display = $container.find('.text-display');
    22	                const $icon = $container.find('.icon-display');
    23	                const $iconSubmit = $container.find('.icon-submit');
    24	                const $textarea = $container.find('.edit-area');
    25	
    26	                // テキストエリアに表示内容を入れ、表示を切り替え
    27	                $textarea.val($display.html().replace(/<br\s*\/?>/gi, '\n')).show();
    28	                $display.hide();
    29	                $icon.hide();
    30	                $iconSubmit.show().prop('disabled', false);
    31	                $textarea.focus();
    32	            });
    33	
    34	            $('.js-disposal-reason-form .edit-area').blur(function() {
    35	                const $textarea = $(this);
    36	                const $container = $textarea.closest('.editable-container');
    37	                const $display = $container.find('.text-display');
    38	                const $icon = $container.find('.icon-display');
    39	                const $iconSubmit = $container.find('.icon-submit');
    40	            });
    41	
    42	            function renderReasonTextAsHtml(text) {
    43	                return $('<div>').text(text).html().replace(/\n/g, '<br>');
    44	            }
    45	
    46	            function showStockHistoryReasonAlert(message, isError) {
    47	                const alertClass = isError ? 'alert-danger' : 'alert-success';
    48	                const $target = $('#stockHistoryList .card-body');
    49	                $target.find('.js-stock-change-history-alert').remove();
    50	                const $alert = $('<div class="alert ' + alertClass + ' alert-dismissible fade show js-stock-change-history-alert mb-0" role="alert">')
    51	                    .append($('<span>').text(message))
    52	                    .append('<button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>');
    53	                $target.prepend($alert);
    54	            }
    55	
    56	            function setReasonEditToggleLoading($toggle, isLoading) {
    57	                const $pen = $toggle.find('.js-reason-edit-icon');
    58	                const $spinner = $toggle.find('.js-reason-loading-icon');
    59	                if (isLoading) {
    60	                    $toggle.addClass('is-saving');
    61	                    $pen.hide();
    62	                    $spinner.show();
    63	                } else {
    64	                    $toggle.removeClass('is-saving');
    65	                    $pen.show();
    66	                    $spinner.hide();
    67	                }
    68	            }
    69	
    70	            function exitReasonEditMode($reasonEditContainer, $reasonDisplay, $reasonTextarea) {
    71	                $reasonEditContainer.removeClass('is-editing');
    72	                $reasonTextarea.hide();
    73	                $reasonDisplay.show();
    74	            }
    75	
    76	            function restoreReasonEditSnapshot($reasonEditContainer, $reasonDisplay, $reasonTextarea) {
    77	                const originalDisplayHtml = $reasonEditContainer.data('original-display-html');
    78	                const originalTextareaVal = $reasonEditContainer.data('original-textarea-val');
    79	                if (typeof originalDisplayHtml === 'string') {
    80	                    $reasonDisplay.html(originalDisplayHtml);
    81	                }
    82	                if (typeof originalTextareaVal === 'string') {
    83	                    $reasonTextarea.val(originalTextareaVal);
    84	                }
    85	                exitReasonEditMode($reasonEditContainer, $reasonDisplay, $reasonTextarea);
    86	            }
    87	
    88	            const saveErrorMsg = {{ 'admin.common.save_error'|trans|json_encode|raw }};
    89	            $(document).on('click', '.stock-change-history-reason-form .js-reason-edit-toggle, .stock-change-history-reason-form .js-reason-edit-toggle *', function(e) {
    90	                e.preventDefault();
    91	                e.stopPropagation();
    92	
    93	                const $toggle = $(this).closest('.js-reason-edit-toggle');
    94	                if ($toggle.length === 0) {
    95	                    return;
    96	                }
    97	
    98	                const $reasonEditContainer = $toggle.closest('.editable-container');
    99	                const $reasonForm = $toggle.closest('form');
   100	                if ($reasonForm.length === 0 || $reasonForm.closest('.stock-change-history-reason-form').length === 0) {
   101	                    return;
   102	                }
   103	                if ($reasonEditContainer.hasClass('is-saving')) {
   104	                    return;
   105	                }
   106	
   107	                const $reasonDisplay = $reasonEditContainer.find('.text-display');
   108	                const $reasonTextarea = $reasonEditContainer.find('.edit-area');
   109	                const isReasonEditMode = $reasonEditContainer.hasClass('is-editing');
   110	
   111	                if (!isReasonEditMode) {
   112	                    $reasonEditContainer.data('original-display-html', $reasonDisplay.html());
   113	                    $reasonEditContainer.data('original-textarea-val', $reasonTextarea.val());
   114	                    $reasonEditContainer.addClass('is-editing');
   115	                    $reasonDisplay.hide();
   116	                    $reasonTextarea.show().focus();
   117	                    return;
   118	                }
   119	
   120	                const pendingReason = $reasonTextarea.val();
   121	                $reasonDisplay.html(renderReasonTextAsHtml(pendingReason));
   122	                exitReasonEditMode($reasonEditContainer, $reasonDisplay, $reasonTextarea);
   123	                $reasonEditContainer.addClass('is-saving');
   124	                setReasonEditToggleLoading($toggle, true);
   125	
   126	                $.ajax({
   127	                    url: $reasonForm.attr('action'),
   128	                    type: 'POST',
   129	                    data: $reasonForm.serialize(),
   130	                    dataType: 'json',
   131	                    headers: {
   132	                        'X-Requested-With': 'XMLHttpRequest',
   133	                    },
   134	                }).done(function(response) {
   135	                    if (response.success) {
   136	                        const displayText = response.stock_change_reason_display || pendingReason;
   137	                        const savedReason = response.stock_change_reason || pendingReason;
   138	                        $reasonDisplay.html(renderReasonTextAsHtml(displayText));
   139	                        $reasonTextarea.val(savedReason);
   140	                        $reasonEditContainer.data('original-display-html', $reasonDisplay.html());
   141	                        $reasonEditContainer.data('original-textarea-val', savedReason);
   142	                        $('#stockHistoryList .card-body').find('.js-stock-change-history-alert').remove();
   143	                    } else {
   144	                        restoreReasonEditSnapshot($reasonEditContainer, $reasonDisplay, $reasonTextarea);
   145	                        showStockHistoryReasonAlert(response.message || saveErrorMsg, true);
   146	                    }
   147	                }).fail(function(xhr) {
   148	                    restoreReasonEditSnapshot($reasonEditContainer, $reasonDisplay, $reasonTextarea);
   149	                    let message = saveErrorMsg;
   150	                    if (xhr.responseJSON && xhr.responseJSON.message) {
   151	                        message = xhr.responseJSON.message;
   152	                    }
   153	                    showStockHistoryReasonAlert(message, true);
   154	                }).always(function() {
   155	                    $reasonEditContainer.removeClass('is-saving');
   156	                    setReasonEditToggleLoading($toggle, false);
   157	                });
   158	            });
   159	        });
   160	        const select2Ids = [
