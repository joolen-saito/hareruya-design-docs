     2	# 移植元: 旧バッチサーバー inventory_tc.sh / inventory_branch.sh (本店/支店, MySQL) を新システム(PostgreSQL・全店舗統一)向けに移植
     3	# 月次商品情報スナップショット (ECCUBE_HARERUYA-781)
     4	# 処理: 本番Auroraの最新スナップショットを一時クラスタに復元し、公開・営業中店舗の全店舗在庫を抽出して
     5	#       TSV(zip)を s3://<bucket>/ にアップロードし、一時クラスタを削除する。
     6	# 使い方:
     7	#   PROD_CLUSTER_ID=... DB_SUBNET_GROUP=... VPC_SECURITY_GROUP_IDS=... DB_CLUSTER_PARAMETER_GROUP=... \
     8	#   DB_ENGINE=aurora-postgresql DB_INSTANCE_CLASS=... S3_BUCKET=inventorycheck \
     9	#   PGUSER=... PGDATABASE=... PGPASSWORD=... bash script/ops/monthly-inventory-snapshot/inventory.sh
    10	# ※ 接続情報・AWS識別子は config.sh / 環境変数で注入(リポジトリに含めない)。AWS認証はIAMロール。
    11	
    12	set -euo pipefail
    13	SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
    14	# shellcheck source=config.sh
    15	source "${SCRIPT_DIR}/config.sh"
    16	
    17	: "${PROD_CLUSTER_ID:?PROD_CLUSTER_ID is required}"
    18	: "${DB_SUBNET_GROUP:?DB_SUBNET_GROUP is required}"
    19	: "${VPC_SECURITY_GROUP_IDS:?VPC_SECURITY_GROUP_IDS is required}"
    20	: "${DB_CLUSTER_PARAMETER_GROUP:?DB_CLUSTER_PARAMETER_GROUP is required}"
    21	: "${DB_ENGINE:?DB_ENGINE is required}"
    22	: "${DB_INSTANCE_CLASS:?DB_INSTANCE_CLASS is required}"
    23	: "${S3_BUCKET:?S3_BUCKET is required}"
    24	: "${PGUSER:?PGUSER is required}"
    25	: "${PGDATABASE:?PGDATABASE is required}"
    26	
    27	# 複数SGを空白区切りで渡せるよう配列化(単一SGでも可)
    28	read -ra VPC_SG_ARR <<< "${VPC_SECURITY_GROUP_IDS}"
    29	
    30	# 再実行・並列実行で他実行の一時DBを誤削除しないよう実行毎に一意な識別子にする
    31	# 複数ホスト同時実行でも衝突しないよう乱数由来のIDを使う(uuidgen が無い環境ではPIDで代替)
    32	RUN_ID="$(uuidgen 2>/dev/null | tr 'A-Z' 'a-z' | tr -cd 'a-z0-9' | cut -c1-8)"
    33	[ -n "${RUN_ID}" ] || RUN_ID="$$"
    34	RUN_SUFFIX="$(date +%Y%m%d%H%M%S)-${RUN_ID}"
    35	TMP_CLUSTER_ID="${TMP_CLUSTER_ID}-${RUN_SUFFIX}"
    36	TMP_INSTANCE_ID="${TMP_INSTANCE_ID}-${RUN_SUFFIX}"
    37	CREATED_CLUSTER=0
    38	CREATED_INSTANCE=0
    39	
    40	log() { echo "$(date '+%Y-%m-%d %H:%M:%S') $*"; }
    41	
    42	# 失敗時も含め、この実行で作成した一時クラスタ/インスタンスのみ削除する
    43	# インスタンス削除完了を待ってからクラスタを削除する(残インスタンスがあるとクラスタ削除不可のため)
    44	cleanup() {
    45	  log "cleanup: 一時インスタンス/クラスタを削除"
    46	  if [ "${CREATED_INSTANCE}" -eq 1 ]; then
    47	    aws rds delete-db-instance --db-instance-identifier "${TMP_INSTANCE_ID}" --skip-final-snapshot >/dev/null 2>&1 || true
    48	    aws rds wait db-instance-deleted --db-instance-identifier "${TMP_INSTANCE_ID}" >/dev/null 2>&1 || true
    49	  fi
    50	  if [ "${CREATED_CLUSTER}" -eq 1 ]; then
    51	    aws rds delete-db-cluster --db-cluster-identifier "${TMP_CLUSTER_ID}" --skip-final-snapshot >/dev/null 2>&1 || true
    52	  fi
    53	}
    54	trap cleanup EXIT
    55	
    56	log "script start"
    57	
    58	# 1. 本番の最新スナップショット識別子を取得
    59	SNAPSHOT_ID=$(aws rds describe-db-cluster-snapshots \
    60	  --db-cluster-identifier "${PROD_CLUSTER_ID}" \
    61	  --query "reverse(sort_by(DBClusterSnapshots[?DBClusterIdentifier=='${PROD_CLUSTER_ID}' && Status=='available'],&SnapshotCreateTime))[0].DBClusterSnapshotIdentifier" \
    62	  --output text)
    63	if [ -z "${SNAPSHOT_ID}" ] || [ "${SNAPSHOT_ID}" = "None" ]; then
    64	  log "ERROR: ${PROD_CLUSTER_ID} のスナップショットが見つかりません"
    65	  exit 1
    66	fi
    67	log "snapshot: ${SNAPSHOT_ID}"
    68	
    69	# 2. スナップショットから一時クラスタを復元
    70	aws rds restore-db-cluster-from-snapshot \
    71	  --snapshot-identifier "${SNAPSHOT_ID}" \
    72	  --db-cluster-identifier "${TMP_CLUSTER_ID}" \
    73	  --engine "${DB_ENGINE}" \
    74	  ${DB_ENGINE_VERSION:+--engine-version "${DB_ENGINE_VERSION}"} \
    75	  --db-subnet-group-name "${DB_SUBNET_GROUP}" \
    76	  --vpc-security-group-ids "${VPC_SG_ARR[@]}" \
    77	  --db-cluster-parameter-group-name "${DB_CLUSTER_PARAMETER_GROUP}" \
    78	  --no-publicly-accessible >/dev/null
    79	CREATED_CLUSTER=1
    80	log "cluster restoring: ${TMP_CLUSTER_ID}"
    81	
    82	# 3. 一時インスタンスを作成
    83	aws rds create-db-instance \
    84	  --db-cluster-identifier "${TMP_CLUSTER_ID}" \
    85	  --db-instance-identifier "${TMP_INSTANCE_ID}" \
    86	  --engine "${DB_ENGINE}" \
    87	  --db-instance-class "${DB_INSTANCE_CLASS}" \
    88	  --no-publicly-accessible >/dev/null
    89	CREATED_INSTANCE=1
    90	log "instance creating: ${TMP_INSTANCE_ID}"
    91	
    92	# 4. インスタンスが利用可能になるまで待機(最大60分・30秒間隔)
    93	status="creating"
    94	for _ in $(seq 1 120); do
    95	  status=$(aws rds describe-db-instances --db-instance-identifier "${TMP_INSTANCE_ID}" \
    96	    --query 'DBInstances[0].DBInstanceStatus' --output text 2>/dev/null || echo "creating")
    97	  [ "${status}" = "available" ] && break
    98	  sleep 30
    99	done
   100	if [ "${status}" != "available" ]; then
   101	  log "ERROR: インスタンスが利用可能になりません (status=${status})"
   102	  exit 1
   103	fi
   104	
   105	# 5. 復元クラスタのエンドポイントを取得
   106	PGHOST=$(aws rds describe-db-clusters --db-cluster-identifier "${TMP_CLUSTER_ID}" \
   107	  --query 'DBClusters[0].Endpoint' --output text)
   108	if [ -z "${PGHOST}" ] || [ "${PGHOST}" = "None" ]; then
   109	  log "ERROR: ${TMP_CLUSTER_ID} のエンドポイントが取得できません"
   110	  exit 1
   111	fi
   112	export PGHOST
   113	log "endpoint: ${PGHOST}"
   114	
   115	# 6. 抽出クエリを実行して TSV を出力
   116	OUT="stock_$(date +%Y%m%d).txt"
   117	PGCLIENTENCODING=UTF8 psql -v ON_ERROR_STOP=1 --no-psqlrc -f "${SCRIPT_DIR}/query.sql" > "${OUT}"
   118	log "extracted: ${OUT} ($(wc -l < "${OUT}") lines)"
   119	
   120	# 7. ZIP 圧縮
   121	ZIP="${OUT}.zip"
   122	zip -j -q "${ZIP}" "${OUT}"
   123	
   124	# 8. S3 へアップロード
   125	aws s3 cp "${ZIP}" "s3://${S3_BUCKET}/"
   126	log "uploaded: s3://${S3_BUCKET}/${ZIP}"
   127	
   128	# 9. ローカル一時ファイルを削除
   129	rm -f "${OUT}" "${ZIP}"
   130	
   131	log "script finish"
