    10	class SmaregiBatch extends Command
    11	{
    12	    const BATCH_NAMES = [
    13	        'createCustomer' => 'Plugin\HareruyaEc\Service\Smaregi\CreateCustomer',
    14	        'checkCustomer' => 'Plugin\HareruyaEc\Service\Smaregi\CheckCustomer',
    15	        'updatePoint' => 'Plugin\HareruyaEc\Service\Smaregi\UpdatePoint',
    16	        'checkSmaregiErrorOrder' => 'Plugin\HareruyaEc\Service\Smaregi\CheckSmaregiErrorOrder',
    17	        'checkSmaregiTransaction' => 'Plugin\HareruyaEc\Service\Smaregi\CheckSmaregiTransaction',
    18	    ];
    19	
    20	    const LAST_ARG = 10;
    21	
    22	    protected function configure()
    23	    {
    24	        $this->setName('smaregi:batch')
    25	            ->setDescription('smaregi batchs')
    26	            ->addArgument('batch_name', InputArgument::OPTIONAL);
    27	
    28	        foreach (range(1, self::LAST_ARG) as $num) {
    29	            $this->addArgument("arg-{$num}", InputArgument::OPTIONAL);
    30	        }
    31	    }
    32	
    33	    protected function execute(InputInterface $input, OutputInterface $output)
    34	    {
    35	        $app = $this->getSilexApplication();
    36	
    37	        $name = $input->getArgument('batch_name');
    38	        $batchNames = self::BATCH_NAMES;
    39	        $resultMessage = '[' . date('Y/m/d H:i') . '] ';
    40	
    41	        if (!isset($batchNames[$name])) {
    42	            echo $resultMessage . " Nothing args or command.\n";
    43	
    44	            return 1;
    45	        }
    46	
    47	        $accountList = new $batchNames[$name]($app, $this->createOptions($input));
    48	        echo sprintf("Command start:%s \n", date('Y/m/d H:i:s'));
    49	        $accountList->execute();
    50	        echo sprintf("Command complete:%s \n", date('Y/m/d H:i:s'));
    51	
    52	        return 0;
    53	    }
    54	
    55	    /**
    56	     * 引数がある場合はoptionsに詰め込む
    57	     * @param InputInterface $inpu
    58	     * @return array $options
    59	     */
    60	    private function createOptions(InputInterface $input)
    61	    {
    62	        $num = 1;
    63	        $options = [];
    64	        while (!empty($input->getArgument("arg-{$num}"))) {
    65	            $options[] = $input->getArgument("arg-{$num}");
    66	            $num++;
    67	        }
    68	
    69	        return $options;
    70	    }
    71	}
