     2	
     3	namespace Plugin\HareruyaEc\Service\Payment;
     4	
     5	use Plugin\HareruyaEc\Entity\MtbEntryStatus as ES;
     6	use Plugin\HareruyaEc\Entity\Payment;
     7	use Plugin\HareruyaEc\Service\Payment\SlnSearchHelper as SearchHelper;
     8	
     9	class AbstractCheckPaymentEntry extends AbstractPaymentService
    10	{
    11	    use SearchHelper;
    12	
    13	    protected $commandName = '';
    14	
    15	    /**
    16	     * @param array $entries
    17	     * @return array
    18	     */
    19	    protected function check($entries = [])
    20	    {
    21	        $this->initSearchHelper();
    22	
    23	        $message = '';
    24	        $messages = [];
    25	        $errorMessages = [];
    26	        $prePaymentNo = '';
    27	        foreach ($entries as $entry) {
    28	            // 1つ前のpaymentNoと同じ時に、前回の結果($message)から判断して同様の処理を行う
    29	            if ($prePaymentNo === $entry->getPaymentNo()) {
    30	                switch ($message) {
    31	                    case '':
    32	                        $this->execRecordOperation($entry, $newStatus);
    33	                        break;
    34	                    case $this->notExistingTransuctionMessage:
    35	                        $this->removeRecord($entry);
    36	                        break;
    37	                }
    38	                continue;
    39	            }
    40	            $result = $this->execSearch($entry, true);
    41	            $message = $result[0];
    42	            $newStatus = $result[1];
    43	            $prePaymentNo = $entry->getPaymentNo();
    44	
    45	            if ($message !== '') {
    46	                if (
    47	                    $message === $this->notExistingTransuctionMessage ||
    48	                    $message === $this->transactionIncompleteMessage ||
    49	                    $message === $this->transactionErrorMessage
    50	                ) {
    51	                    $messages[] = "OrderId<{$prePaymentNo}>{$message}";
    52	                    continue;
    53	                } elseif (!in_array($message, $errorMessages)) {
    54	                    // SPLINKS取引不在/未完了 以外のエラーを1つにまとめてメールで通知する
    55	                    $errorMessages[] = $message;
    56	                }
    57	            }
    58	
    59	            $this->execRecordOperation($entry, $newStatus);
    60	        }
    61	
    62	        if (!empty($errorMessages)) {
    63	            $transport = new \Swift_SmtpTransport('localhost', 25);
    64	            $transport->setUsername($this->app['config']['HareruyaEc']['const']['swiftmailer_user']);
    65	            $transport->setPassword('');
    66	            $this->app['mailer'] = new \Swift_Mailer($transport);
    67	
    68	            $this->app['hareruya_ec.service.mail']->sendCheckPaymentErrorMail($errorMessages);
    69	        }
    70	
    71	        $this->app['hareruya_ec.repository.entry_history']->createEntryHistory($this->app, $entries);
    72	        $this->app['orm.em']->flush();
    73	
    74	        return $this->createResult($messages);
    75	    }
    76	
    77	    /**
    78	     * 削除するか更新するかもしくはそのままかの処理
    79	     *
    80	     * @param DtbEventEntry $entry
    81	     * @param integer $paymentStatus
    82	     */
    83	    private function execRecordOperation($entry, $entryStatusId)
    84	    {
    85	
    86	        switch ($entryStatusId) {
    87	            case Payment::REMOVE:
    88	                $this->removeRecord($entry);
    89	                return;
    90	            case Payment::ON_HOLD:
    91	                return;
    92	        }
    93	
    94	        $entry->setEntryStatus($this->app['hareruya_ec.repository.entry_status']->find($entryStatusId));
    95	        $this->app['orm.em']->persist($entry);
    96	
    97	        // クレジットカード決済完了メール送信
    98	        if ($entryStatusId === ES::ENTERED) {
    99	            try {
   100	                $this->app['hareruya_ec.service.mail']->sendCreditCardPaymentCompleteMail($entry->getEventEntryId());
   101	            } catch(\Exception $e) {
   102	                log_error($e->getMessage());
   103	            }
   104	        }
   105	    }
   106	}
