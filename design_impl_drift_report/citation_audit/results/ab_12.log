     1	#!/bin/bash
     2	# 月次商品情報スナップショット 設定。
     3	# 誤実行防止のため接続先・AWS識別子の既定値は設定しない。実行前に環境変数で必ず指定すること。
     4	# ※ 接続情報・認証情報はリポジトリに含めない（環境変数/Secrets Manager/SSM で注入）。
     5	# ※ AWS 認証はバッチEC2/Fargate の IAM ロールを使用（アクセスキー不要）。
     6	#
     7	# 設定例（コメントを外して環境に合わせて設定）:
     8	#   export PROD_CLUSTER_ID="<本番Auroraクラスタ識別子>"        # スナップショット検索対象
     9	#   export DB_ENGINE="aurora-postgresql"
    10	#   export DB_ENGINE_VERSION="<例: 16.4>"
    11	#   export DB_INSTANCE_CLASS="<例: db.t3.medium>"
    12	#   export DB_SUBNET_GROUP="<サブネットグループ名>"
    13	#   export VPC_SECURITY_GROUP_IDS="<sg-xxxx>"
    14	#   export DB_CLUSTER_PARAMETER_GROUP="<クラスタパラメータグループ名>"
    15	#   export S3_BUCKET="inventorycheck"
    16	#   export PGUSER="<スナップショットのマスターユーザー>"
    17	#   export PGDATABASE="<DB名>"
    18	#   export PGPASSWORD="<パスワード>"   # ~/.pgpass / Secrets Manager でも可
    19	
    20	# 一時クラスタ/インスタンス名（固定）
    21	export TMP_CLUSTER_ID="${TMP_CLUSTER_ID:-monthly-inventory-check}"
    22	export TMP_INSTANCE_ID="${TMP_INSTANCE_ID:-restore-for-inventory}"
    23	export PGPORT="${PGPORT:-5432}"
     1	-- 月次商品情報スナップショット 抽出クエリ (ECCUBE_HARERUYA-781)
     2	-- 公開(product_status_id=DISPLAY_SHOW=1)かつ営業中店舗(is_open_shop=true)の全店舗在庫を、
     3	-- 店舗ID昇順・在庫区分(EC-CUBE→スマレジ)順で出力する。TSV(タブ区切り・UTF-8)+ヘッダー。
     4	COPY (
     5	    SELECT
     6	        pc.product_code AS "商品コード",
     7	        pc.price02      AS "販売価格",
     8	        pc.buy_price    AS "買取価格",
     9	        bi.shop_name    AS "店舗名",
    10	        CASE ps.stock_location_id WHEN 1 THEN 'EC-CUBE' WHEN 2 THEN 'スマレジ' ELSE '' END AS "在庫区分名",
    11	        ps.stock        AS "在庫数"
    12	    FROM dtb_product_stock ps
    13	    INNER JOIN dtb_product_class pc ON pc.id = ps.product_class_id
    14	    LEFT JOIN dtb_base_info bi      ON bi.id = ps.base_info_id
    15	    WHERE bi.is_open_shop = true
    16	      AND pc.product_status_id = 1
    17	    ORDER BY ps.base_info_id ASC, ps.stock_location_id ASC
    18	) TO STDOUT WITH (FORMAT csv, DELIMITER E'\t', HEADER true);
