     1	#!/bin/bash
     2	# 開発環境用デフォルト設定（localstack）。
     3	# 本番運用時は実行前に環境変数で上書きすること。
     4	#
     5	# 本番設定例（コメントを外せば動く）:
     6	#   export S3_BUCKET="filepool-resized"
     7	#   export S3_ENDPOINT=""
     8	#   export S3_PUBLIC_URL="https://files.hareruyamtg.com/"
     9	#   export MAIL_ENABLED="true"
    10	# ※ 本番EC2はIAMロールで認証するため AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY の設定は不要
    11	
    12	# S3設定
    13	export S3_BUCKET="${S3_BUCKET:-filepool-resized}"
    14	# LocalStackエンドポイント。本番AWSを使う場合は空文字: S3_ENDPOINT=""
    15	# AWS CLI v2 は AWS_ENDPOINT_URL を参照するため、S3_ENDPOINT から自動設定する
    16	export S3_ENDPOINT="${S3_ENDPOINT-http://localhost:4566}"
    17	export AWS_ENDPOINT_URL="${S3_ENDPOINT}"
    18	
    19	# AWSクレデンシャル
    20	export AWS_ACCESS_KEY_ID="${AWS_ACCESS_KEY_ID:-eccube_enterprise}"
    21	export AWS_SECRET_ACCESS_KEY="${AWS_SECRET_ACCESS_KEY:-secret_aws_key}"
    22	export AWS_DEFAULT_REGION="${AWS_DEFAULT_REGION:-ap-northeast-1}"
    23	
    24	# 結果表示用の公開URLプレフィックス (s3://<バケット名>/ の置換先、末尾スラッシュ必須)
    25	# 本番例: https://files.hareruyamtg.com/
    26	export S3_PUBLIC_URL="${S3_PUBLIC_URL:-http://localhost:4566/${S3_BUCKET}/}"
    27	
    28	# 一時ファイルの保存先
    29	export WORK_DIR="${WORK_DIR:-$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/tmp}"
    30	
    31	# メール送信設定 (開発環境ではfalseにして送信をスキップ)
    32	export MAIL_ENABLED="${MAIL_ENABLED:-false}"
    33	export MAIL_FROM="${MAIL_FROM:-info@hareruyamtg.com}"
    34	export MAIL_TO="${MAIL_TO:-hareruya_filesize_alert@hareruyamtg.com}"
    35	export MAIL_CC="${MAIL_CC:-it_common@hareruyamtg.com}"
    36	export MAIL_BCC="${MAIL_BCC:-ex-hareruya-eccube-al-aaaat4a5x3pzbmyj2q2bc6gd5u@wakuwaku-impact.slack.com}"

