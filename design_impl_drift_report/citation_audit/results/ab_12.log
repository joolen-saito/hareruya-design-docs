    16	namespace Eccube\Service\Smaregi;
    17	
    18	use Doctrine\ORM\EntityManagerInterface;
    19	use Eccube\Repository\DtbPlayerRepository;
    20	use Eccube\Repository\OrderRepository;
    21	
    22	class SmaregiUpdatePointAction
    23	{
    24	    public function __construct(
    25	        private readonly OrderRepository $orderRepository,
    26	        private readonly DtbPlayerRepository $playerRepository,
    27	        private readonly SmaregiCustomerService $smaregiCustomerService,
    28	        private readonly EntityManagerInterface $entityManager,
    29	    ) {
    30	    }
    31	
    32	    public function handle(int $orderId): void
    33	    {
    34	        $order = $this->orderRepository->find($orderId);
    35	        if ($order === null) {
    36	            return;
    37	        }
    38	
    39	        $suspendPoint = $order->getSpendedPoints();
    40	        if ($suspendPoint === null || $suspendPoint === 0) {
    41	            return;
    42	        }
    43	
    44	        $customer = $order->getCustomer();
    45	        if ($customer === null) {
    46	            return;
    47	        }
    48	        $player = $this->playerRepository->findOneByCustomer($customer);
    49	        if ($player === null) {
    50	            return;
    51	        }
    52	
    53	        try {
    54	            $response = $this->smaregiCustomerService->postSmaregiPoint($player->getSmaregiId(), -$suspendPoint, false);
    55	        } catch (\Throwable $e) {
    56	            try {
    57	                $order->setPointErrorMessage(json_encode(['message' => $e->getMessage()], JSON_UNESCAPED_UNICODE))
    58	                    ->setSmaregiErrorFlg(true);
    59	                $this->entityManager->persist($order);
    60	                $this->entityManager->flush();
    61	            } catch (\Throwable $persistError) {
    62	                log_error('スマレジポイント連携失敗後の注文更新に失敗しました', [
    63	                    'orderId' => $orderId,
    64	                    'error' => $persistError->getMessage(),
    65	                ]);
    66	            }
    67	
    68	            throw $e;
    69	        }
    70	
    71	        if (array_key_exists('result', $response)) {
    72	            return;
    73	        }
    74	
    75	        $order->setPointErrorMessage(json_encode($response, JSON_UNESCAPED_UNICODE))
    76	            ->setSmaregiErrorFlg(true);
    77	        $this->entityManager->persist($order);
    78	        $this->entityManager->flush();
    79	    }
    80	}
   860	
   861	    /**
   862	     * 店頭受取注文 (Delivery::OTC_GROUP) のうち、スマレジ商品/在庫の連携が未完了な受注を返す。
   863	     *
   864	     * 取得条件:
   865	     * - Shipping.Delivery が OTC または SMOOTH_OTC
   866	     * - OrderStatus = NEW (受取前)
   867	     * - smaregi_del_flg = false (削除対象でない)
   868	     * - smaregi_error_flg = false (エラー受注は本バッチでは扱わない)
   869	     * - smaregi_product_flg = false または smaregi_stock_flg = false (いずれかが未連携)
   870	     *
   871	     * 1 受注 = 1 スマレジ商品の前提で、productCode は注文番号+店舗IDから決定論的に採番する。
   872	     *
   873	     * @return list<Order>
   874	     */
   875	    public function findOtcOrdersAwaitingSmaregiSync(int $limit = 100): array
   876	    {
   877	        $qb = $this->createQueryBuilder('o');
   878	        $qb
   879	            ->distinct()
   880	            ->innerJoin(\Eccube\Entity\Shipping::class, 's', 'WITH', 's.Order = o')
   881	            ->where('s.Delivery IN (:deliveryIds)')
   882	            ->andWhere('o.OrderStatus = :orderNew')
   883	            ->andWhere('o.smaregi_del_flg = :flgFalse')
   884	            ->andWhere('o.smaregi_error_flg = :flgFalse')
   885	            ->andWhere($qb->expr()->orX(
   886	                'o.smaregi_product_flg = :flgFalse',
   887	                'o.smaregi_stock_flg = :flgFalse',
   888	            ))
   889	            ->setParameter('deliveryIds', Delivery::OTC_GROUP)
   890	            ->setParameter('orderNew', OrderStatus::NEW)
   891	            ->setParameter('flgFalse', Constant::DISABLED)
   892	            ->orderBy('o.id', 'ASC')
   893	            ->setMaxResults($limit);
   894	
   895	        /** @var list<Order> $result */
   896	        $result = $qb->getQuery()->getResult();
   897	
   898	        return $result;
   899	    }
