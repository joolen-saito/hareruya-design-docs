    12	 */
    13	class DtbEventEntryRepository extends \Doctrine\ORM\EntityRepository
    14	{
    15	    /**
    16	     * イベント申込管理　イベント申込一覧
    17	     * 検索条件に該当するデータを取得
    18	     *
    19	     * @param integer $id
    20	     * @return array
    21	     */
    22	    public function getEntryCount($id)
    23	    {
    24	        // dtb_event_entry
    25	        $qb = $this->createQueryBuilder('ee')
    26	            ->select('count(ee.eventEntryId) as entry', 'ee.eventDetailId as event_detail_id')
    27	            ->join('Plugin\HareruyaEc\Entity\DtbEventDetail', 'ed', Join::WITH, 'ee.eventDetailId = ed.eventDetailId')
    28	            ->andWhere('ee.entryStatusId = :entryStatusId')
    29	            ->andWhere('ed.eventId = :eventId')
    30	            ->setParameter('eventId', $id)
    31	            ->setParameter('entryStatusId', ES::ENTERED)
    32	            ->groupBy('ee.eventDetailId');
    33	
    34	        return $qb->getQuery()->getResult();
    35	    }
    36	
    37	    /**
    38	     * イベント申込管理　イベント申込詳細
    39	     * 詳細に該当するデータを取得
    40	     *
    41	     * @param integer $id
    42	     * @return array
    43	     */
    44	    public function getResultByEntryDetail($id)
    45	    {
    46	        // dtb_event_entry
    47	        $qb = $this->createQueryBuilder('ee')
    48	            ->select('ee.eventEntryId', 'ee.paymentId', 'ee.entryStatusId', 'ed.startDate', 'ed.event.shop.nameJp')
    49	            ->join('Plugin\HareruyaEc\Entity\DtbEventDetail', 'ed', Join::WITH, 'a.eventDetailId = ed.eventDetailId')
    50	            ->andWhere('ee.eventEntryId = :eventEntryId')
    51	            ->setParameter('eventEntryId', $id);
    52	
    53	        return $qb->getQuery()->getResult();
    54	    }
    55	
    56	    /**
    57	     * 特定のステータスの限界時間を超えた申込を取得
    58	     *
    59	     * @param integer $limitMinute
    60	     * @param array $payments
    61	     * @param integer $entryStatusId
    62	     * @return array
    63	     */
    64	    public function getPassedLimitEntry($limitMinute, Array $payments = [], $entryStatusId = ES::PROCESSING_PAYMENT)
    65	    {
    66	        $time = new \DateTime();
    67	        // dtb_event_entry
    68	        $qb = $this->createQueryBuilder('ee');
    69	        $qb->where($qb->expr()->eq('ee.entryStatusId', ':entryStatusId'))
    70	            ->andWhere($qb->expr()->lte('ee.updateDate', ':limitTime'))
    71	            ->andWhere('ee.paymentNo IS NOT NULL')
    72	            ->orderBy('ee.paymentNo');
    73	
    74	        $paramters = [
    75	            'entryStatusId' => $entryStatusId,
    76	            'limitTime' => $time->modify("-{$limitMinute} minute")
    77	        ];
    78	
    79	        if (count($payments) > 0) {
    80	            $qb->andWhere($qb->expr()->in('ee.paymentId', ':payments'));
    81	            $paramters['payments'] = $payments;
    82	        }
    83	        $query = $qb
    84	            ->setParameters($paramters)
    85	            ->getQuery();
    86	
    87	        return $query->execute();
    88	    }
    89	    /**
    90	     * 該当プレイヤーが申込済みの申込を取得
    91	     *
    92	     * @param integer $playerId
    93	     * @return array
    94	     */
    95	    public function getEntriesByPlayerId($playerId) {
    96	        $qb = $this->createQueryBuilder('e');
    97	        $query = $qb->join('e.entryPlayers', 'p')
    98	            ->join('e.eventDetail', 'ed')
    99	            ->where('p.playerId = :playerId')
   100	            ->andWhere($qb->expr()->notIn('e.entryStatusId', [ES::CANCELED]))
   101	            ->setParameter('playerId', $playerId)
   102	            ->orderBy('ed.startDate', 'DESC')
   103	            ->getQuery();
   104	
   105	        return $query->execute();
   106	    }
   107	
   108	    /**
   109	     * 該当プレイヤーが参加予定のチーム申込を取得
   110	     *
   111	     * @param integer $playerId
   112	     * @return array
   113	     */
   114	    public function getTeamEntriesByPlayerId($playerId) {
   115	        $qb = $this->createQueryBuilder('ee');
   116	        $query = $qb->join('ee.entryPlayers', 'p')
   117	            ->join('ee.eventDetail', 'ed')
   118	            ->join('ed.event', 'e')
   119	            ->where('p.playerId = :playerId')
   120	            ->andWhere('e.teamMemberCount > 1')
   121	            ->andWhere('ed.onlineEntryEndDate >= :nowDate')
   122	            ->andWhere($qb->expr()->notIn('ee.entryStatusId', [ES::PROCESSING_PAYMENT, ES::CANCELED]))
   123	            ->setParameter('playerId', $playerId)
   124	            ->setParameter('nowDate', new \DateTime())
   125	            ->getQuery();
   126	
   127	        return $query->execute();
   128	    }
   129	}

