    37	    {
    38	        $this->addArgument('orderId', InputArgument::OPTIONAL, '対象受注ID', '');
    39	    }
    40	
    41	    #[\Override]
    42	    protected function execute(InputInterface $input, OutputInterface $output): int
    43	    {
    44	        $io = new SymfonyStyle($input, $output);
    45	
    46	        $orderId = $input->getArgument('orderId');
    47	        if ($orderId === '') {
    48	            $io->success('orderId が未入力のため、処理をスキップして正常終了しました');
    49	
    50	            return Command::SUCCESS;
    51	        }
