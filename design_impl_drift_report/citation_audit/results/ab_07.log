   257	    /**
   258	     * カードIDからポップアップ用の商品情報を1件取得する
   259	     *
   260	     * @param string $lang
   261	     * @param string $cardId
   262	     *
   263	     * @return JsonResponse
   264	     */
   265	    #[Route(path: '/api/popup/card/{lang}/{cardId}', name: 'popup_product_by_card_id', methods: ['GET'])]
   266	    public function getPopupProductByCardId(string $lang, string $cardId): JsonResponse
   267	    {
   268	        try {
   269	            if (!preg_match('/^\\d+$/', $cardId) || (int) $cardId < 1) {
   270	                throw new NotFoundException('Not Found');
   271	            }
   272	
   273	            $languageCode = match (strtolower($lang)) {
   274	                'ja' => 'JP',
   275	                default => 'EN',
   276	            };
   277	
   278	            $result = $this->productRepository->findPopupProductByCardId((int) $cardId, $languageCode, $this->getShop()->getId());
   279	            if ($result === null) {
   280	                throw new NotFoundException('Not Found');
   281	            }
   282	
   283	            $locale = $result['languageCode'] === 'EN' ? 'en' : 'ja';
   284	            $productUrl = $this->generateUrl(
   285	                'product_detail',
   286	                ['id' => (int) $result['productId'], '_locale' => $locale],
   287	                UrlGeneratorInterface::ABSOLUTE_URL
   288	            );
   289	
   290	            return $this->json($this->popupResponseBuilder->build($result, $productUrl, true), Response::HTTP_OK);
   291	        } catch (BaseApiException $e) {
   292	            return $this->json([
   293	                'code' => $e->getStatusCode(),
   294	                'errors' => $e->getErrors(),
   295	            ], $e->getStatusCode());
   296	        } catch (\Throwable $e) {
   297	            log_error('ポップアップカード取得処理中にエラーが発生しました', [
   298	                'lang' => $lang,
   299	                'card_id' => $cardId,
   300	                'error' => $e->getMessage(),
   301	            ]);
   302	
   303	            return $this->json([
   304	                'code' => Response::HTTP_INTERNAL_SERVER_ERROR,
   305	                'errors' => ['Internal Server Error'],
   306	            ], Response::HTTP_INTERNAL_SERVER_ERROR);
   307	        }
   308	    }
