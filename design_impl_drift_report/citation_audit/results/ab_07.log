    24	
    25	/**
    26	 * 期間別販売数集計バッチ（B02-01）
    27	 *
    28	 * 商品規格・店舗ごとに期間別の販売数を集計し、dtb_sales_quantity を更新する。
    29	 * 現在は EC 受注のみ対象。スマレジ実店舗販売は未実装のため除外される。
    30	 *
    31	 * 【使い方】
    32	 *
    33	 *   bin/console eccube:aggregate-sales
    34	 */
    35	#[AsCommand(name: 'eccube:aggregate-sales', description: '期間別販売数集計バッチ')]
    36	class AggregateSalesCommand extends Command
    37	{
    38	    public function __construct(private readonly BatchAggregateSalesAction $batchAggregateSalesAction)
    39	    {
    40	        parent::__construct();
    41	    }
    42	
    43	    #[\Override]
    44	    protected function execute(InputInterface $input, OutputInterface $output): int
    45	    {
