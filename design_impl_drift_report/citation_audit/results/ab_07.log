   248	    /**
   249	     * 商品IDから商品詳細情報を取得
   250	     *
   251	     * pf-apiではGROUP_CONCATを使用しているためネイティブSQLで実装
   252	     * PostgreSQLに対応するためGROUP_CONCATはSTRING_AGGに置換
   253	     *
   254	     * @param int $productId
   255	     * @param string $languageCode
   256	     *
   257	     * @return array<int, array<string, mixed>>
   258	     */
   259	    public function findProductById(int $productId, string $languageCode = 'JP', ?int $stockBaseInfoId = null): array
   260	    {
   261	        $stockBaseInfoId ??= (int) $this->eccubeConfig->get('eccube_root_base_info_id');
   262	
   263	        $sql = <<<SQL
   264	SELECT
   265	    p.id AS productId,
   266	    p.name AS productName,
   267	    COALESCE(lang.code, :languageCode) AS languageCode,
   268	    pc.high_price_code AS highPriceCode,
   269	    p.description_detail AS descriptionDetail,
   270	    STRING_AGG(DISTINCT pimg.file_name, ',') AS imageFileNames,
   271	    pc.order_quantity_04 AS orderQuantity04,
   272	    pc.id AS productClassId,
   273	    pc.product_code AS productCode,
   274	    cc.id AS cardConditionId,
   275	    CASE WHEN pc.memo IS NOT NULL AND pc.memo != '' THEN pc.memo ELSE cc.code END AS conditionCode,
   276	    pc.price02 AS price,
   277	    pc.sale_limit AS saleLimit,
   278	    pstock.stock AS stock,
   279	    c.name_jp AS cardName,
   280	    STRING_AGG(DISTINCT colors.name_jp, ',') AS colors,
   281	    c.mana_cost AS manaCost,
   282	    rarity.name_jp AS rarityName,
   283	    STRING_AGG(DISTINCT types.name_jp, ',') AS cardtypes,
   284	    cd.text_jp AS textJp,
   285	    cd.flavor_jp AS flavorJp,
   115	     *
