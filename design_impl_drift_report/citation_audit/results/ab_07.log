   565	    /**
   566	     * lacaleと商品規格Idから状態・言語付きの商品名を取得
   567	     * @param Application $app
   568	     * @param int $productClassId
   569	     * @return string
   570	     */
   571	    public function getNameByClass($app, int $productClassId, $locale = null)
   572	    {
   573	        $result = $this->createQueryBuilder('psc')
   574	            ->addSelect([
   575	                'cc.code AS condtion',
   576	                'l.code AS language',
   577	                "CASE WHEN 'ja' = :locale THEN p.name ELSE ps.nameEn END AS name",
   578	                'CASE WHEN ps.cardDetail IS NULL THEN 0 ELSE 1 END isExistDetail',
   579	                'psc.highPriceCode',
   580	                'psc.memo',
   581	            ])
   582	            ->join('psc.cardCondition', 'cc')
   583	            ->join('psc.language', 'l')
   584	            ->join('psc.productSub', 'ps')
   585	            ->join('ps.product', 'p')
   586	            ->where('psc.productClassId = :productClassId')
   587	            ->setParameters([
   588	                'productClassId' => $productClassId,
   589	                'locale' => $locale ?? $app['locale'],
   590	            ])
   591	            ->getQuery()
   592	            ->useQueryCache(true)
   593	            ->useResultCache(true, self::NAME_CACHING_TIME, 'className:' . $productClassId . ($locale ?? $app['locale']))
   594	            ->getOneOrNullResult();
   595	
   596	        $condition = '';
   597	        if ($result['isExistDetail']) {
   598	            $condition .= $result['memo'] ? "【{$result['language']}/{$result['memo']}】" : "【{$result['language']}/{$result['condtion']}】";
   599	        }
   600	
   601	        return $condition . $result['name'] . ($result['highPriceCode'] ? '#' . $result['highPriceCode'] : '');
   602	    }
