   213	    /**
   214	     * Find the Products with sorted ClassCategories.
   215	     *
   216	     * @param array<int, int|string> $ids Product in ids
   217	     * @param string $indexBy The index for the from.
   218	     *
   219	     * @return ArrayCollection<int, mixed>|array<int, mixed>|null
   220	     */
   221	    public function findProductsWithSortedClassCategories(array $ids, ?string $indexBy = null): ArrayCollection|array|null
   222	    {
   223	        if (count($ids) < 1) {
   224	            return [];
   225	        }
   226	        $qb = $this->createQueryBuilder('p', $indexBy);
   227	        $qb->addSelect(['pc', 'cc1', 'cc2', 'pi', 'pt', 'tr', 'ps'])
   228	            ->innerJoin('p.ProductClasses', 'pc')
   229	            // XXX Joined 'TaxRule' and 'ProductStock' to prevent lazy loading
   230	            ->leftJoin('pc.TaxRule', 'tr')
   231	            ->innerJoin('pc.ProductStock', 'ps')
   232	            ->leftJoin('pc.ClassCategory1', 'cc1')
   233	            ->leftJoin('pc.ClassCategory2', 'cc2')
   234	            ->leftJoin('p.ProductImage', 'pi')
   235	            ->leftJoin('p.ProductTag', 'pt')
   236	            ->where($qb->expr()->in('p.id', $ids))
   237	            ->andWhere('pc.visible = :visible')
   238	            ->setParameter('visible', true)
   239	            ->orderBy('cc1.sort_no', 'DESC')
   240	            ->addOrderBy('cc2.sort_no', 'DESC');
   241	
   242	        return $qb
   243	            ->getQuery()
   244	            ->setResultCacheLifetime($this->eccubeConfig['eccube_result_cache_lifetime_short'])
   245	            ->getResult();
   246	    }
