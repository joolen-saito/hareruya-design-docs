   160	    /**
   161	     * 人気商品リコメンド取得
   162	     */
   163	    public function getPopularProductRecommend(int $currentBaseInfoId, string $locale, int $limit = 30): mixed
   164	    {
   165	        // サブクエリ セール帯・通常版・日本語・非FOILを各キーとして優先表示
   166	        $sqlPriority = <<<SQL
   167	        CONCAT(
   168	            CASE WHEN pc.sale_flg = :isSale THEN '1' ELSE '0' END,
   169	            CASE WHEN pr.id = :nonPromotion THEN '1' ELSE '0' END,
   170	            CASE WHEN l.id = :japanese THEN '1' ELSE '0' END,
   171	            CASE WHEN cd.foil_flg = :nonFoil THEN '1' ELSE '0' END
   172	        ) AS priority
   173	        SQL;
   174	        $priorities = $this->createQueryBuilder('sq')
   175	            ->select(['pc.id AS productClassId', 'p.id AS productId', 'l.id AS languageId', $sqlPriority])
   176	            ->innerJoin('sq.BaseInfo', 'bi')
   177	            ->innerJoin('sq.ProductClass', 'pc')
   178	            ->innerJoin('pc.Product', 'p')
   179	            ->innerJoin('pc.Language', 'l')
   180	            ->innerJoin('pc.ProductStock', 'ps')
   181	            ->innerJoin('ps.baseInfo', 'psbi')
   182	            ->innerJoin('p.CardDetail', 'cd')
   183	            ->innerJoin('cd.Card', 'c')
   184	            ->innerJoin('cd.Promotion', 'pr')
   185	            ->where('bi.id = :baseInfoId')
   186	            ->andWhere('psbi.id = :currentBaseInfoId')
   187	            ->andWhere('ps.stock > 0')
   188	            ->setParameter('baseInfoId', self::POPULAR_PRODUCT_RECOMMEND_SHOP_ID)
   189	            ->setParameter('currentBaseInfoId', $currentBaseInfoId)
   190	            ->setParameter('isSale', ProductClass::SALE)
   191	            ->setParameter('japanese', MtbLanguage::JP_ID)
   192	            ->setParameter('nonPromotion', MtbPromotion::NON_PROMOTION_ID)
   193	            ->setParameter('nonFoil', MtbCardDetail::NON_FOIL)
   194	            ->orderBy('priority', 'ASC')
   195	            ->getQuery()
   196	            ->getResult();
   197	
   198	        $targetProductId = [];
   199	        foreach ($priorities as $priority) {
   200	            // priorityの昇順で並んだものを上書きするので、最終的に最もpriority高いものが残る
   201	            $targetProductId[$priority['productId'].'/'.$priority['languageId']] = $priority['productClassId'];
   202	        }
   203	
   204	        // 在庫があるもののうち、上位30件を表示
   205	        return $this->createQueryBuilder('sq')
   206	            ->select([
   207	                'p.id AS productId',
   208	                "CASE WHEN 'ja' = :locale THEN p.name ELSE COALESCE(NULLIF(p.name_en, ''), p.name) END AS productName",
   209	                'pc.sale_flg AS saleFlg',
   210	                'pc.price02 AS price',
   211	                'pi.file_name AS fileName',
   212	                'l.code AS languageCode',
   213	                'cd.foil_flg AS foilFlg',
   214	                'SUM(sqs.sales_quantity_04) AS sum',
   215	            ])
   216	            ->groupBy('p.id', 'p.name', 'p.name_en', 'pc.sale_flg', 'pc.price02', 'pi.file_name', 'pc.Language', 'l.code', 'cd.foil_flg')
   217	            ->innerJoin('sq.ProductClass', 'pc')
   218	            ->innerJoin('pc.Product', 'p')
   219	            ->innerJoin('pc.Language', 'l')
   220	            ->innerJoin('p.ProductClasses', 'pcs', Join::WITH, 'pc.Language = pcs.Language')
