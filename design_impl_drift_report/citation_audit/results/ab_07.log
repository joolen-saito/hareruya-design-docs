    16	namespace Eccube\Service\Product;
    17	
    18	use Doctrine\ORM\EntityManagerInterface;
    19	use Eccube\Repository\DtbSalesQuantityRepository;
    20	
    21	class BatchAggregateSalesAction
    22	{
    23	    public function __construct(
    24	        private readonly DtbSalesQuantityRepository $salesQuantityRepository,
    25	        private readonly EntityManagerInterface $entityManager,
    26	    ) {
    27	    }
    28	
    29	    /**
    30	     * 期間別販売数を集計し dtb_sales_quantity を更新する。
    31	     *
    32	     * 現在は EC 受注のみ集計対象。スマレジ実店舗販売の dtb_order 取り込みが
    33	     * 実装された際は getSalesForAggregate() の SQL を拡張すること。
    34	     *
    35	     * @throws \Exception 集計処理で例外が発生した場合
    36	     */
    37	    public function handle(): void
    38	    {
    39	        // TODO: スマレジ実店舗販売を dtb_order に取り込む処理が実装されたら、
    40	        //       getSalesForAggregate() がスマレジ受注も自動的に含むか確認する。
    41	        //       スマレジ受注が別テーブルで管理される場合は別途集計処理を追加する。
    42	        $connection = $this->entityManager->getConnection();
    43	        $connection->beginTransaction();
    44	        try {
    45	            // 集計前に既存の集計行を削除し、古い販売数が残らないようにする
    46	            $this->salesQuantityRepository->clearSalesQuantityForAggregate();
    47	            $salesData = $this->salesQuantityRepository->getSalesForAggregate();
    48	            foreach ($salesData as $data) {
    49	                $this->salesQuantityRepository->updateSalesQuantityColumns($data);
    50	            }
    51	            $connection->commit();
    52	        } catch (\Throwable $e) {
    53	            $connection->rollBack();
    54	            throw $e;
    55	        }
    56	    }
    57	}
