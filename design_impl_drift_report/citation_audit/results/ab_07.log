   334	                'illustrator.nameEn AS illustratorName',
   335	                'GROUP_CONCAT(DISTINCT format.nameEn) AS formats',
   336	                'regionRestriction.nameJp AS regionRestrictionName',
   337	                "GROUP_CONCAT(DISTINCT category.categoryName SEPARATOR '|') AS categoryNames",
   338	                ])
   339	            ->join('product.productSub', 'productSub')
   340	            ->leftJoin('product.categories', 'category')
   341	            ->join('productSub.regionRestriction', 'regionRestriction')
   342	            ->join('productSub.productSubClasses', 'productSubClass')
   343	            ->join('productSubClass.productClass', 'productClass', 'with', 'productClass.price02 > 0')
   344	            ->join('productSubClass.cardCondition', 'cardCondition')
