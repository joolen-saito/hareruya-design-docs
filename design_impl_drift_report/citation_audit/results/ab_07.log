   346	            ->leftJoin('productSubClass.productSubClassImages', 'productSubClassImage')
   347	            ->leftJoin('productSubClassImage.productImage', 'productSubImage')
   348	            ->leftJoin('productSub.cardDetail', 'cardDetail')
   349	            ->leftJoin('cardDetail.card', 'card')
   350	            ->leftJoin('card.colors', 'cardColor')
   351	            ->leftJoin('card.cardtypes', 'cardtype')
   352	            ->leftJoin('card.cardFormats', 'cardFormat')
   353	            ->leftJoin('cardFormat.format', 'format')
   354	            ->leftJoin('cardDetail.rarity', 'rarity')
   355	            ->leftJoin('cardDetail.cardset', 'cardset')
   356	            ->leftJoin('cardset.cardsetblock', 'cardsetblock')
   357	            ->leftJoin('cardDetail.illustrator', 'illustrator')
   358	            ->where('product.productId = :productId')
   359	            ->andWhere('language.code = :languageCode')
   360	            ->andWhere('product.status = 1')
