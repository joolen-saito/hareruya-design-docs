   324	                'card.manaCost',
   325	                'rarity.nameJp AS rarityName',
   326	                'GROUP_CONCAT(DISTINCT cardtype.nameJp) AS cardtypes',
   327	                'cardDetail.textJp',
   328	                'cardDetail.flavorJp',
   329	                'card.power',
   330	                'card.toughness',
   331	                'card.loyalty',
   332	                'cardset.nameJp AS cardsetName',
