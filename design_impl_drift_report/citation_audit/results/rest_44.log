1171-                <tr id="item-sheet-3-27"><td><a class="item-no" href="#pin-sheet-3-27"><span class="src-cell" data-excel-book="0212" data-excel-sheet="デッキ一覧(検索入力)" data-excel-ref="0212:デッキ一覧(検索入力)!B102" data-excel-formula="=B101+1">27</span></a></td><td><span class="src-cell" data-excel-book="0212" data-excel-sheet="デッキ一覧(検索入力)" data-excel-ref="0212:デッキ一覧(検索入力)!E102">カード名</span></td><td><span class="src-cell" data-excel-book="0212" data-excel-sheet="デッキ一覧(検索入力)" data-excel-ref="0212:デッキ一覧(検索入力)!M102">文字列</span></td><td><span class="src-cell" data-excel-book="0212" data-excel-sheet="デッキ一覧(検索入力)" data-excel-ref="0212:デッキ一覧(検索入力)!T102">-</span></td><td><span class="src-cell" data-excel-book="0212" data-excel-sheet="デッキ一覧(検索入力)" data-excel-ref="0212:デッキ一覧(検索入力)!V102">100文字</span></td><td></td><td></td></tr>
