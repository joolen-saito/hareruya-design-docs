    42	    /**
    43	     * デッキ登録CSVアップロード
    44	     *
    45	     * @param Application $app
    46	     * @param Request $request
    47	     * @return \Symfony\Component\HttpFoundation\Response
    48	     */
    49	    public function import(Application $app, Request $request)
    50	    {
    51	        $deckCsv = new DeckCsv($app, $this->importTwig, $this->sessionKey, $this->getCsvHeader(), $this->getRequiredCsvHeader());
    52	
    53	        $form = $app['form.factory']
    54	            ->createBuilder('admin_csv_import')
    55	            ->add('strict', 'checkbox', [
    56	                'required' => false,
    57	                'label' => 'form.deck.strict',
    58	            ])
    59	            ->getForm()
    60	            ->handleRequest($request);
    61	
    62	        $deckCsv->setIsStrict($form['strict']->getData())
    63	            ->checkFormValid($form);
    64	        try {
    65	            $formFile = $deckCsv->getFormFile($form);
    66	        } catch (\LogicException $e) {
    67	            log_info('エラーが発生しました', [$e->getMessage()]);
    68	            $app->addError($e->getMessage(), 'admin');
    69	
    70	            return $deckCsv->render();
    71	        }
    72	
    73	        log_info('デッキCSV登録開始');
    74	        $data = $deckCsv->getImportData($formFile);
    75	        if ($data === false) {
    76	            return $deckCsv->render();
    77	        }
    78	
    79	        try {
    80	            // ヘッダーの値が一致するかチェック
    81	            $headers = $this->getCsvHeader();
    82	            $columnHeaders = $data->getColumnHeaders();
    83	            $deckCsv->checkHeaderValues(array_keys($headers), $columnHeaders, $this->getNotRequiredCsvHeader());
    84	            $headerSize = count($columnHeaders);
    85	
    86	            // CSVデータが空でないかチェック
    87	            $deckCsv->checkDataSize($data);
    88	
    89	            $app['orm.em']->getConfiguration()->setSQLLogger(null);
    90	            $app['orm.em']->beginTransaction();
    91	
    92	            // CSVファイルの登録処理
    93	            $deckCsv->register($headers, $headerSize, $data);
    94	        } catch (\LogicException | \RuntimeException $e) {
    95	            // 登録失敗時の処理
    96	            $app['orm.em']->rollback();
    97	            log_info('エラーが発生しました', [$e->getMessage()]);
    98	            $app->addError($e->getMessage(), 'admin');
    99	
   100	            return $deckCsv->render();
   101	        }
   102	
   103	        log_info('デッキCSV登録完了');
   104	        $app->addSuccess('admin.register.complete', 'admin');
   105	
   106	        return $deckCsv->render();
   107	    }
