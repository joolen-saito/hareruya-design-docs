   244	        }
   245	
   246	        // 順位（From/To）
   247	        if (!empty($searchData['ranking_from'])) {
   248	            $qb->andWhere('d.ranking >= :rankingFrom')
   249	                ->setParameter('rankingFrom', $searchData['ranking_from']);
   250	        }
   251	        if (!empty($searchData['ranking_to'])) {
   252	            $qb->andWhere('d.ranking <= :rankingTo')
   253	                ->setParameter('rankingTo', $searchData['ranking_to']);
   254	        }
   255	
   256	        // 成績（部分一致）
