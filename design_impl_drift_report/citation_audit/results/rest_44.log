   177	    public function getQueryBuilderBySearchData(array $searchData): QueryBuilder
   178	    {
   179	        $qb = $this->createQueryBuilder('d');
   180	
   181	        // 大会開始時刻前のデッキは検索結果に表示しない
   182	        $qb->leftJoin('d.EventDetail', 'ed', Join::WITH, 'ed.startDate < :time OR IDENTITY(d.EventDetail) IS NULL')
   183	            ->andWhere('ed.startDate < :time OR IDENTITY(d.EventDetail) IS NULL')
   184	            ->setParameter('time', new \DateTime());
   185	
   186	        // ユーザ作成のデッキは検索結果に表示しない
   187	        $qb->andWhere('IDENTITY(d.DeckType) = :deckType')
   188	            ->setParameter('deckType', MtbDeckType::EVENT_ID);
   189	
   190	        // デッキID
   191	        if (!empty($searchData['deck_id'])) {
   192	            SqlUtil::searchByIds($qb, $searchData['deck_id'], 'd', 'id');
   193	        }
   194	
   195	        // デッキ名（部分一致、スペース/カンマ区切りで複数検索）
   196	        if (!empty($searchData['deck_name'])) {
   197	            $texts = preg_split('/[\s,　]+/u', $searchData['deck_name']);
   198	            SqlUtil::multiTextQuery($qb, $texts, ['d' => ['deckName']]);
   199	        }
   200	
   201	        // フォーマット
   202	        if (!empty($searchData['formats']) && count($searchData['formats']) > 0) {
   203	            $qb->andWhere($qb->expr()->in('d.Format', ':formats'))
   204	                ->setParameter('formats', $searchData['formats']);
   205	        }
   206	
   207	        // アーキタイプ
   208	        if (!empty($searchData['archetypes']) && count($searchData['archetypes']) > 0) {
   209	            $qb->andWhere($qb->expr()->in('d.Archetype', ':archetypes'))
   210	                ->setParameter('archetypes', $searchData['archetypes']);
   211	        }
   212	
   213	        // カラー（アーキタイプ経由）
   214	        if (!empty($searchData['color']) && count($searchData['color']) > 0) {
   215	            $qb->join('d.Archetype', 'da')
   216	                ->join('da.Colors', 'co', Join::WITH, $qb->expr()->in('co.id', ':colors'))
   217	                ->setParameter('colors', $searchData['color']);
   218	        }
   219	
   220	        // 公開状態
   221	        if (!empty($searchData['disp']) && count($searchData['disp']) > 0) {
   222	            $qb->andWhere($qb->expr()->in('d.Disp', ':disp'))
   223	                ->setParameter('disp', $searchData['disp']);
   224	        }
   225	
   226	        // デッキリスト公開状態
   227	        if (!empty($searchData['private_flg']) && count($searchData['private_flg']) === 1) {
   228	            $qb->andWhere('d.privateFlg = :privateFlg')
   229	                ->setParameter('privateFlg', $searchData['private_flg'][0]);
   230	        }
   231	
   232	        // イベント開催日（From）
   233	        if (!empty($searchData['event_date_from'])) {
   234	            $from = (clone $searchData['event_date_from'])->setTime(0, 0, 0);
   235	            $qb->andWhere('d.eventDate >= :eventDateFrom')
   236	                ->setParameter('eventDateFrom', $from);
   237	        }
   238	
   239	        // イベント開催日（To）
   240	        if (!empty($searchData['event_date_to'])) {
   241	            $to = (clone $searchData['event_date_to'])->setTime(23, 59, 59);
   242	            $qb->andWhere('d.eventDate <= :eventDateTo')
