   595	    private function saveDeckCards(array $cards, DtbDeck $Deck, int $boardId): void
   596	    {
   597	        $Board = $this->em->getReference(MtbBoard::class, $boardId);
   598	
   599	        foreach ($cards as $cardData) {
   600	            $Card = $cardData['Card'] ?? null;
   601	            if ($Card === null) {
   602	                continue;
   603	            }
   604	
   605	            $DeckCard = new DtbDeckCard();
   606	            $DeckCard->setDeck($Deck)
   607	                ->setCard($Card)
   608	                ->setBoard($Board)
   609	                ->setCount($cardData['count']);
   610	            $this->em->persist($DeckCard);
   611	        }
   612	    }
