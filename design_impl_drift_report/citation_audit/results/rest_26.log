from html.parser import HTMLParser
from html import unescape
import re
p='hareruya-design-docs/excel_to_html/output/0207_基本設計仕様書(会員管理機能).html'
class P(HTMLParser):
 def __init__(self): super().__init__(); self.sheet=None; self.embed=0; self.cap=None; self.rows=[]
 def handle_comment(self,d):
  if 'function-design-embed:start' in d: self.embed+=1
  elif 'function-design-embed:end' in d: self.embed=max(0,self.embed-1)
 def handle_starttag(self,t,a):
  a=dict(a)
  if t=='section' and a.get('id','').startswith('sheet-'): self.sheet=a['id']
  if self.sheet in {f'sheet-{i}' for i in range(13,17)} and not self.embed and t=='span' and 'src-cell' in a.get('class','').split():
   self.cap=[self.getpos()[0],a.get('data-excel-ref',''),'']
 def handle_data(self,d):
  if self.cap is not None:self.cap[2]+=d
 def handle_endtag(self,t):
  if t=='span' and self.cap is not None:
   s=' '.join(unescape(self.cap[2]).split())
   if s and s not in {'-','・'}: self.rows.append((self.sheet,*self.cap[:2],s))
   self.cap=None
x=P(); x.feed(open(p).read())
for row in x.rows: print('\\t'.join(map(str,row)))
