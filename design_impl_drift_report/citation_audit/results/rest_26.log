   280	        $player = $app['hareruya_ec.repository.player']->findOneByCustomer($customer);
   281	
   282	        return $app->render('HareruyaEc/Resource/template/admin/Customer/point_type_select.twig', [
   283	            'form' => $form->createView(),
   284	            'player' => $player,
   285	        ]);
