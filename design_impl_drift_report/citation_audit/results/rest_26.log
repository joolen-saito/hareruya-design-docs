   158	    /**
   159	      * mail send page
   160	      * @param Application $app
   161	      * @param Request $request
   162	      * @return \Symfony\Component\HttpFoundation\Response
   163	      */
   164	    public function postMailComplete(Application $app, Request $request)
   165	    {
   166	
   167	        $builder = $app['form.factory']->createBuilder('customer_mail_all');
   168	        $form = $builder->getForm()->handleRequest($request);
   169	
   170	        $data = $form->getData();
   171	
   172	        $ids = explode(',', $request->get('ids'));
   173	
   174	        foreach ($ids as $id) {
   175	            $customer = $app['eccube.repository.customer']->find($id);
   176	            $message = $app['hareruya_ec.service.mail']->sendCustomerWithoutTemplate($customer, $data);
   177	        }
   178	
   179	        return $app->redirect($app->url('admin_customer_mail_all_complete'));
   180	    }
   181	
   182	    /**
   183	      * complete page
   184	      * @param Application $app
   185	      * @param Request $request
   186	      * @return \Symfony\Component\HttpFoundation\Response
   187	      */
   188	    public function getMailComplete(Application $app, Request $request)
   189	    {
   190	        return $app->render('HareruyaEc/Resource/template/admin/Customer/mail_complete.twig');
   191	    }
   192	
   193	    /**
   194	     * post manual mail page
   195	     * @param Application $app
   196	     * @param Request $request
   197	     * @param integer $customerId
   198	     * @param integer $templateId
   199	     * @return \Symfony\Component\HttpFoundation\Response
   200	     */
   201	    public function manualMail(Application $app, Request $request, $customerId = null, $templateId = null)
   202	    {
   203	        $customerId = $request->get('customerId');
   204	        if (is_null($customerId)) {
   205	            return $app->abort(404);
   206	        }
   207	
   208	        $customer = $app['orm.em']->getRepository('Eccube\Entity\Customer')->find($customerId);
   209	        if (empty($customer)) {
   210	            return $app->abort(404);
   211	        }
   212	
   213	        $mail = null;
   214	        if ($templateId) {
   215	            $criteria = new Criteria();
   216	            $criteria->andWhere($criteria->expr()->eq('id', $templateId))
   217	                ->andWhere($criteria->expr()->in('file_name', [
   218	                    MailTemplate::BASE_FILES[MailTemplate::BASE_CUSTOMER],
   219	                    MailTemplate::BASE_FILES[MailTemplate::BASE_CUSTOMER_EN],
   220	                    MailTemplate::BASE_FILES[MailTemplate::BASE_NO_BASE]
   221	                ]));
   222	
   223	            $mail = $app['eccube.repository.mail_template']->matching($criteria)->first();
   224	            if (!($mail)) {
   225	                throw new NotFoundHttpException();
   226	            }
   227	
   228	            $baseInfo = $app['eccube.repository.base_info']->get();
   229	
   230	            $body = $app['hareruya_ec.service.mail']->getBody($mail->getFileName(), [
   231	                'header' => $mail->getHeader(),
   232	                'footer' => $mail->getFooter(),
   233	                'Customer' => $customer,
   234	                'BaseInfo' => $baseInfo,
   235	            ]);
   236	        }
   237	
   238	        $form = $app['form.factory']
   239	            ->createBuilder('mail', $mail, ['autoMail' => false, 'baseFiles' => [MailTemplate::BASE_CUSTOMER, MailTemplate::BASE_CUSTOMER_EN]])
   240	            ->getForm();
   241	
   242	        $form['template']->setData($mail);
   243	
   244	        if ('POST' === $request->getMethod()) {
   245	            $form->handleRequest($request);
   246	
   247	            if ($this->isFormValid($app, $form)) {
   248	                $app['hareruya_ec.service.mail']->sendManualMail($customer, $mail, $request->request->all());
   249	
   250	                $app->addSuccess('admin.mail.send_success', 'admin');
   251	            }
   252	
   253	            return $app->redirect($app->path('admin_customer_manual_mail_edit', ['customerId' => $customerId, 'templateId' => $templateId]));
   254	        }
   255	
   256	        return $app->render('HareruyaEc/Resource/template/admin/Customer/manual_mail.twig', [
   257	            'form' => $form->createView(),
   258	            'id' => $templateId,
   259	            'customer' => $customer,
   260	            'body' => $body ?? '',
   261	            'mail' => $mail,
   262	        ]);
   263	    }
