   135	    public function mailConfirm(Application $app, Request $request)
   136	    {
   137	
   138	        $builder = $app['form.factory']->createBuilder('customer_mail_all');
   139	        $form = $builder->getForm()->handleRequest($request);
   140	
   141	        $builder->setAttribute('freeze', true);
   142	        $builder->setAttribute('freeze_display_text', true);
   143	
   144	        $data = $form->getData();
   145	
   146	        $form = $builder->getForm()->setData($data);
   147	
   148	        $ids = explode(',', $request->get('ids'));
   149	        $targetCustomers = $app['eccube.repository.customer']->findById($ids);
   150	
   151	        return $app->render('HareruyaEc/Resource/template/admin/Customer/mail_confirm.twig', [
   152	            'form' => $form->createView(),
   153	            'ids' => $request->get('ids'),
   154	            'customers' => $targetCustomers
   155	        ]);
   156	    }
