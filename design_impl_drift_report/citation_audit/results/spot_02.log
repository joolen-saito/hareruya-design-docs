    (3583, 'REVERSE', '', '<div class="table-wrap"><table><thead><tr><th>項目名</th><th>必須／任意</th><th>最大長</th><th>初期値</th><th>保存先・扱い</th></tr></thead><tbody><tr><td>イベント名</td><td>任意</td><td>一行テキスト（フォーム上の<code>Length</code>なし）</td><td>空</td><td>検索条件キー<code>multi</code>。永続化しない。イベント名等への絞り込み。</td></tr><tr><td>申込状況</td><td>任意</td><td>セレクト（複数）</td><td>未選択</td><td>検索条件キー<code>entry_status</code>。申込状況マスタ（<code>MtbEntryStatus</code>）。</td></tr><tr><td>支払方法</td><td>任意</td><td>セレクト（複数）<')
    (3605, 'REVERSE', '', '<div class="table-wrap"><table><thead><tr><th>項目</th><th>内容</th></tr></thead><tbody><tr><td>支払番号</td><td><code>maxlength</code>属性による入力長制限（64文字）。</td></tr><tr><td>プレイヤー名</td><td><code>maxlength</code>属性による入力長制限（255文字）。</td></tr><tr><td>イベント詳細ID</td><td>10桁以内の数字（<code>Regex</code>）。</td></tr><tr><td>検索モード</td><td><code>entriedEvent</code>／<code>registedDeck</code>の選択肢に限る。必須。</td></tr><tr><td>並び順</td><td><code>ASC</code>／<code>DESC</code>（大文字小文字可）以外')
