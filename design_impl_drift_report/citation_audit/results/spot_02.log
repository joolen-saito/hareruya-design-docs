    (2270, 'SPEC', '', '<div class="doc-bullet" style="--lv:1"><span class="doc-marker"><span class="src-cell" data-excel-book="0211" data-excel-sheet="受注売上分析 集計一覧(検索項目)" data-excel-ref="0211:受注売上分析 集計一覧(検索項目)!C63">・</span></span><span><span class="src-cell" data-excel-book="0211" data-excel-sheet="受注売上分析 集計一覧(検索項目)" data-excel-ref="0211:受注売上分析 集計一覧(検索項目)!D63">集計単位の選択肢を商品・カテゴリのみとし、支払方法、購入グループ、都道府県、性別、利用端末、年代(会員)は削除する</span></span></div>')
