   277	
   278	                            {# (4-1) 検索ボタン #}
   279	                            <div class="mt-3 d-flex align-items-center gap-3">
   280	                                <button type="submit" class="btn btn-ec-conversion">{{ 'admin.common.search'|trans }}</button>
   281	                            </div>
   282	                        </div>
   283	                    </form>
   284	                </div>
   285	
   286	                {# (4-2) 検索結果件数 + CSV出力 + 一覧テーブル #}
   287	                <div class="card rounded border-0 mb-4">
   288	                    <div class="card-body border-bottom">
   289	                        <div class="d-flex justify-content-between align-items-center">
   290	                            <div>
   291	                                {% if stockSplitJoinSearchPerformed %}
   292	                                    <a href="{{ url('admin_stock_split_join_csv_export') }}" class="btn btn-ec-conversion">{{ 'admin.stock.split_join.csv_export'|trans }}</a>
   293	                                {% endif %}
   294	                            </div>
   295	                            <div>
   296	                                {% if StockSplitJoins is defined and StockSplitJoins is not empty %}
   297	                                    <p class="mb-0">{{ 'admin.common.search_result'|trans({'%count%': StockSplitJoins|length}) }}</p>
   298	                                {% elseif stockSplitJoinSearchPerformed %}
   299	                                    <p class="mb-0 text-muted">{{ 'admin.common.search_no_result'|trans }}</p>
   300	                                {% endif %}
   301	                            </div>
   302	                        </div>
   303	                    </div>
   304	                    <div class="card-body p-0">
   305	                        <table class="table table-sm table-striped">
   306	                            <thead>
   307	                                <tr class="table-secondary">
   308	                                    <th class="pt-2 pb-2 ps-3">{{ 'admin.stock.split_join.id'|trans }}</th>
   309	                                    <th class="pt-2 pb-2">{{ 'admin.stock.split_join.type'|trans }}</th>
   310	                                    <th class="pt-2 pb-2">{{ 'admin.stock.split_join.store'|trans }}</th>
   311	                                    <th class="pt-2 pb-2">{{ 'admin.stock.split_join.inventory_category'|trans }}</th>
   312	                                    <th class="pt-2 pb-2">{{ 'admin.stock.split_join.list.source_destination_product'|trans }}</th>
   313	                                    <th class="pt-2 pb-2">
   314	                                        <div>{{ 'admin.stock.split_join.list.source_destination_points'|trans }}</div>
   315	                                        <div>{{ 'admin.stock.list.base_price'|trans }}</div>
   316	                                    </th>
   317	                                    <th class="pt-2 pb-2 text-center" aria-label="{{ 'admin.stock.split_join.type'|trans }}">—</th>
   318	                                    <th class="pt-2 pb-2">
   319	                                        <div>{{ 'admin.stock.split_join.list.destination_source_points'|trans }}</div>
   320	                                        <div>{{ 'admin.stock.list.base_price'|trans }}</div>
   321	                                    </th>
   322	                                    <th class="pt-2 pb-2">{{ 'admin.stock.split_join.status'|trans }}</th>
   323	                                    <th class="pt-2 pb-2">{{ 'admin.stock.split_join.registrant'|trans }}</th>
   324	                                    <th class="pt-2 pb-2 pe-3">{{ 'admin.stock.split_join.registration_date'|trans }}</th>
   325	                                </tr>
   325	                                </tr>
   326	                            </thead>
   327	                            <tbody>
   328	                                {% if StockSplitJoins is defined and StockSplitJoins is not empty %}
   329	                                    {% for StockSplitJoin in StockSplitJoins %}
   330	                                        {% set productName = StockSplitJoin.productStock.productClass.product.name|default('') %}
   331	                                        {% if StockSplitJoin.productStock.productClass.classCategory1 %}
   332	                                            {% set productName = productName ~ ' - ' ~ StockSplitJoin.productStock.productClass.classCategory1.name %}
   333	                                        {% endif %}
   334	                                        {% if StockSplitJoin.productStock.productClass.classCategory2 %}
   335	                                            {% set productName = productName ~ ' - ' ~ StockSplitJoin.productStock.productClass.classCategory2.name %}
   336	                                        {% endif %}
   337	                                        {% set _cond = StockSplitJoin.productStock.productClass.cardConditionNameJp %}
   338	                                        {% if _cond %}{% set productName = productName ~ ' [' ~ _cond ~ ']' %}{% endif %}
   339	                                        {# 分割時: 分割元における分割数 / 結合時: 結合先における結合数 #}
   340	                                        {% set sourceDestPoints = StockSplitJoin.splitJoinQuantity %}
   341	                                        {% set sourceDestStandardTotal = StockSplitJoin.standardPrice * StockSplitJoin.splitJoinQuantity %}
   342	                                        {# 分割時: 分割先在庫数の総和（例: 1点と12点→13点） / 結合時: 結合元在庫数の総和 #}
   343	                                        {% set destSourcePoints = StockSplitJoin.details|reduce((sum, d) => sum + d.splitJoinQuantity, 0) %}
   344	                                        {# 基準価格合計 = 各Detail の規格 standard_price × 点数（destinationStock）の合計 #}
   345	                                        {% set destSourceStandardTotal = StockSplitJoin.details|reduce((sum, d) => sum + ((d.productClass.standardPrice|default(0)) * d.splitJoinQuantity), 0) %}
   346	                                        <tr>
   347	                                            <td class="align-middle ps-3">
   348	                                                {# 承認画面リンクは MtbStockSplitJoinStatus と StockSplitApplyApprovalAction / StockJoinApplyApprovalAction に合わせる。
   349	                                                   - 分割 + id 3 = SPLIT_APPROVAL_WAITING（分割承認待ち）→ 分割承認。
   350	                                                   - 結合 + id 4 = JOIN_APPROVAL_WAITING（結合承認待ち）→ 結合承認。
   351	                                                   - 結合 + id 2 = JOIN_SOURCE_REGISTERED（結合元登録済み）→ 欠品入力（次工程）。 #}
   352	                                                {% set _sjStatus = StockSplitJoin.stockSplitJoinStatus.id|default(0) %}
   353	                                                {% if StockSplitJoin.isSplit and _sjStatus == 3 %}
   354	                                                    <a href="{{ url('admin_stock_split_approval', { id: StockSplitJoin.id }) }}">{{ StockSplitJoin.id }}</a>
   355	                                                {% elseif not StockSplitJoin.isSplit and _sjStatus == 4 %}
   356	                                                    <a href="{{ url('admin_stock_join_approval', { id: StockSplitJoin.id }) }}">{{ StockSplitJoin.id }}</a>
   357	                                                {% elseif StockSplitJoin.isSplit %}
   358	                                                    <a href="{{ url('admin_stock_split_edit', { id: StockSplitJoin.id }) }}">{{ StockSplitJoin.id }}</a>
   359	                                                {% elseif not StockSplitJoin.isSplit and _sjStatus == 2 %}
   360	                                                    <a href="{{ url('admin_stock_join_shortage_entry', { id: StockSplitJoin.id }) }}">{{ StockSplitJoin.id }}</a>
   361	                                                {% else %}
   362	                                                    <a href="{{ url('admin_stock_join_edit', { id: StockSplitJoin.id }) }}">{{ StockSplitJoin.id }}</a>
   363	                                                {% endif %}
   364	                                            </td>
   365	                                            <td class="align-middle">
   366	                                                {% if StockSplitJoin.isSplit %}
   367	                                                    {{ 'admin.stock.split_join.type_split'|trans }}
   368	                                                {% else %}
   369	                                                    {{ 'admin.stock.split_join.type_join'|trans }}
   370	                                                {% endif %}
   371	                                            </td>
   372	                                            <td class="align-middle">{{ StockSplitJoin.productStock.baseInfo.shopName|default('—') }}</td>
   373	                                            <td class="align-middle">{{ StockSplitJoin.productStock.locationName|default('—') }}</td>
   374	                                            <td class="align-middle">{{ productName|default('—') }}</td>
   375	                                            <td class="align-middle">
   376	                                                <div>{{ sourceDestPoints|number_format }}点</div>
   377	                                                <div>¥{{ sourceDestStandardTotal|number_format(0, '.', ',') }}</div>
   378	                                            </td>
   379	                                            <td class="align-middle text-center">
   380	                                                {% if StockSplitJoin.isSplit %}
   381	                                                    <span aria-hidden="true">→</span>
   382	                                                {% else %}
   383	                                                    <span aria-hidden="true">←</span>
   384	                                                {% endif %}
   385	                                            </td>
   386	                                            <td class="align-middle">
   387	                                                <div>{{ destSourcePoints|number_format }}点</div>
   388	                                                <div>¥{{ destSourceStandardTotal|number_format(0, '.', ',') }}</div>
   389	                                            </td>
   390	                                            <td class="align-middle">{{ StockSplitJoin.stockSplitJoinStatus ? StockSplitJoin.stockSplitJoinStatus.name : '—' }}</td>
   391	                                            <td class="align-middle">{{ StockSplitJoin.registeredMember.name|default('—') }}</td>
   392	                                            <td class="align-middle pe-3">{{ StockSplitJoin.createDate|date('Y/m/d H:i') }}</td>
   393	                                        </tr>
   394	                                    {% endfor %}
   395	                                {% else %}
   396	                                    <tr>
   397	                                        <td colspan="11" class="align-middle text-center py-4">
   398	                                            {% if not stockSplitJoinSearchPerformed %}
   399	                                                {{ 'admin.stock.split_join.search_first'|trans }}
   400	                                            {% else %}
   401	                                                {{ 'admin.common.search_no_result'|trans }}
   402	                                            {% endif %}
   403	                                        </td>
   404	                                    </tr>
   405	                                {% endif %}
   406	                            </tbody>
   407	                        </table>
   408	                    </div>
