   101	    #[Route(path: '/%eccube_admin_route%/product/stock/split-join', name: 'admin_stock_split_join_list', methods: ['GET', 'POST'])]
   102	    #[Template(template: '@admin/Stock/stock_split_join_index.twig')]
   103	    public function index(Request $request): array|RedirectResponse
   104	    {
   105	        $session = $request->getSession();
   106	
   107	        if ($request->query->getBoolean('clear')) {
   108	            $session->remove(StockSplitJoinIndexAction::SESSION_KEY_SEARCH);
   109	
   110	            return $this->redirectToRoute('admin_stock_split_join_list');
   111	        }
   112	
   113	        $builder = $this->formFactory->createBuilder(SearchStockSplitJoinType::class);
   114	
   115	        $event = new EventArgs(
   116	            [
   117	                'builder' => $builder,
   118	            ],
   119	            $request
   120	        );
   121	        $this->eventDispatcher->dispatch($event, EccubeEvents::ADMIN_STOCK_SPLIT_JOIN_INDEX_INITIALIZE);
   122	
   123	        $searchForm = $builder->getForm();
   124	        $rawFormPayload = [];
   125	
   126	        if ($request->isMethod('POST')) {
   127	            $searchForm->handleRequest($request);
   128	            if ($searchForm->isSubmitted() && $searchForm->isValid()) {
   129	                $session->set(StockSplitJoinIndexAction::SESSION_KEY_SEARCH, FormUtil::getViewData($searchForm));
   130	            }
   131	            $rawFormPayload = $request->request->all('admin_search_stock_split_join');
   132	        } elseif ($request->query->getBoolean('resume')) {
   133	            $viewData = $session->get(StockSplitJoinIndexAction::SESSION_KEY_SEARCH, []);
   134	            FormUtil::submitAndGetData($searchForm, $viewData);
   135	        } else {
   136	            $editableBaseInfos = $this->getEditableBaseInfos();
   137	            $BaseInfo = $editableBaseInfos[0] ?? $this->baseInfoRepository->get();
   138	            $splitCsvForm = $this->formFactory->createBuilder(StockSplitCsvUploadType::class, null, [
   139	                'BaseInfo' => $BaseInfo,
   140	                'editableBaseInfos' => $editableBaseInfos,
   141	                'approval_notification_required' => true,
   142	            ])->getForm();
   143	            $joinCsvForm = $this->formFactory->createBuilder(StockJoinCsvUploadType::class, null, [
   144	                'BaseInfo' => $BaseInfo,
   145	                'editableBaseInfos' => $editableBaseInfos,
   146	            ])->getForm();
   147	
   148	            return [
   149	                'searchForm' => $searchForm->createView(),
   150	                'StockSplitJoins' => [],
   151	                'stockSplitJoinSearchPerformed' => false,
   152	                'pager' => null,
   153	                'membersByShopJson' => $this->searchStockSplitJoinType->buildMembersByShopJson(),
   154	                'splitCsvModal' => [
   155	                    'form' => $splitCsvForm->createView(),
   156	                ],
   157	                'joinCsvModal' => [
   158	                    'form' => $joinCsvForm->createView(),
   159	                ],
   160	            ];
   161	        }
   162	
   163	        $raw = $searchForm->getData();
   164	        $searchData = \is_array($raw) ? $raw : [];
   165	        $StockSplitJoins = $this->indexAction->handle(new StockSplitJoinIndexInput($searchData, $rawFormPayload));
   166	
   167	        $editableBaseInfos = $this->getEditableBaseInfos();
   168	        $BaseInfo = $editableBaseInfos[0] ?? $this->baseInfoRepository->get();
   169	        $splitCsvForm = $this->formFactory->createBuilder(StockSplitCsvUploadType::class, null, [
   170	            'BaseInfo' => $BaseInfo,
   171	            'editableBaseInfos' => $editableBaseInfos,
   172	        ])->getForm();
   173	        $joinCsvForm = $this->formFactory->createBuilder(StockJoinCsvUploadType::class, null, [
   174	            'BaseInfo' => $BaseInfo,
   175	            'editableBaseInfos' => $editableBaseInfos,
   176	        ])->getForm();
   177	
   178	        return [
   179	            'searchForm' => $searchForm->createView(),
   180	            'StockSplitJoins' => $StockSplitJoins,
   181	            'stockSplitJoinSearchPerformed' => true,
   182	            'pager' => null,
   183	            'membersByShopJson' => $this->searchStockSplitJoinType->buildMembersByShopJson(),
   184	            'splitCsvModal' => [
   185	                'form' => $splitCsvForm->createView(),
   186	            ],
   187	            'joinCsvModal' => [
   188	                'form' => $joinCsvForm->createView(),
   189	            ],
   190	        ];
   245	        $response->headers->set('Content-Type', 'application/octet-stream');
   246	        $response->headers->set('Content-Disposition', 'attachment; filename="'.$filename.'"');
   247	
   248	        return $response;
   249	    }
