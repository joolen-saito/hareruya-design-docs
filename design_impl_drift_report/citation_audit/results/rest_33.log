    31	
    32	    /**
    33	     * @param array<string, mixed> $searchData
    34	     */
    35	    public function exportBySearchData(array $searchData): StreamedResponse
    36	    {
    37	        $isProduct = ($searchData['summary_type'] ?? null) !== 'class_category_name';
    38	        $rows = $this->orderItemRepository->getAnalysisSummary($searchData)['result'];
    39	        $header = $isProduct ? $this->buildProductHeader() : $this->buildCategoryHeader();
    40	
    41	        $response = new StreamedResponse(function () use ($rows, $isProduct, $header): void {
    42	            $this->csvExportService->fopen();
    43	            $this->csvExportService->fputcsv($header);
    44	
    45	            foreach ($rows as $row) {
    46	                $line = $isProduct ? [(string) ($row['code'] ?? '')] : [];
    47	                $line[] = (string) ($row['name'] ?? '');
    48	                $line[] = (string) ((int) ($row['price'] ?? 0));
    49	                $line[] = (string) ((int) ($row['sales'] ?? 0));
    50	                $line[] = (string) ((int) ($row['total'] ?? 0));
    51	                $line[] = (string) ((int) ($row['order_count'] ?? 0));
    52	                $this->csvExportService->fputcsv($line);
    53	            }
    54	
    55	            $this->csvExportService->fclose();
    56	        });
    57	
    58	        $filename = 'sales_report_'.(new \DateTime())->format('YmdHis').'.csv';
    59	        $response->headers->set('Content-Type', 'application/octet-stream');
    60	        $response->headers->set('Content-Disposition', 'attachment; filename='.$filename);
    61	
    62	        return $response;
    63	    }
