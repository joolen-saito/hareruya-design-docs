   221	    /**
   222	     * @return array<string, int>
   223	     */
   224	    private function getPublishedStoreChoices(): array
   225	    {
   226	        $BaseInfos = $this->baseInfoRepository->getPublicTenantShopsForSummary();
   227	        $choices = [];
   228	
   229	        foreach ($BaseInfos as $BaseInfo) {
   230	            $label = trim($BaseInfo->getShortNameJp());
   231	            if ($label === '') {
   232	                $label = (string) ($BaseInfo->getShopName() ?? '');
   233	            }
   234	            if ($label === '') {
   235	                continue;
   236	            }
   237	            $id = $BaseInfo->getId();
   238	            if ($id === null) {
   239	                continue;
   240	            }
   241	            $uniqueLabel = $label;
   242	            if (isset($choices[$uniqueLabel])) {
   243	                $uniqueLabel = sprintf('%s (ID:%d)', $label, $id);
   244	            }
   245	            $choices[$uniqueLabel] = $id;
   246	        }
   247	
   248	        return $choices;
   249	    }
