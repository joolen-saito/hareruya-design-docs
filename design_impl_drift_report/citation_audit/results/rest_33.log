   203	                ->setParameter('device_types', $deviceTypeIds);
   204	        }
   205	
   206	        // tagSalesAnalyses
   207	        if (!empty($searchData['tagSalesAnalyses']) && count($searchData['tagSalesAnalyses']) > 0) {
   208	            $qb->join('Plugin\HareruyaEc\Entity\DtbOrderDetailSub', 'ods', 'WITH', 'od.id = ods.orderDetailId')
   209	                ->join('ods.tagSalesAnalyses', 'tsa', 'with', $qb->expr()->in('tsa.id', ':tagSalesAnalyses'))
   210	                ->setParameter('tagSalesAnalyses', $searchData['tagSalesAnalyses']->toArray());
   211	        }
   212	
   213	        // カードセット
