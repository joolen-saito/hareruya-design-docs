   189	    /**
   190	     * 受注明細に紐づく売上分析タグ関連を削除する.
   191	     *
   192	     * ManyToMany の所有側が MtbTagSalesAnalysis のため、OrderItem の remove だけでは
   193	     * dtb_order_item_tag_sales_analysis が残り FK 違反になる。
   194	     */
   195	    public function deleteTagSalesAnalyses(int $orderItemId): void
   196	    {
   197	        $this->getEntityManager()
   198	            ->getConnection()
   199	            ->executeStatement(
   200	                'DELETE FROM dtb_order_item_tag_sales_analysis WHERE order_item_id = :orderItemId',
   201	                ['orderItemId' => $orderItemId],
   202	            );
   203	    }
