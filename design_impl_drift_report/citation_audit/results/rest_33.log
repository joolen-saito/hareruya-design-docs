    98	    public function export(Application $app, Request $request)
    99	    {
   100	        $response = new StreamedResponse();
   101	        $response->setCallback(function () use ($app, $request) {
   102	
   103	            $session = $request->getSession();
   104	            $viewData = $session->get(self::VIEW_KEY, []);
   105	            $searchForm = $app['form.factory']->create('admin_summary', null, ['csrf_protection' => true]);
   106	            $searchData = FormUtil::submitAndGetData($searchForm, $viewData);
   107	            $headers = $this->getDispColumns($searchData);
   108	
   109	            // 集計
   110	            $result = $app['hareruya_ec.repository.order']->getOrderSummary($app, $searchData, $headers);
   111	
   112	            $csvService = $app['eccube.service.csv.export'];
   113	            $csvService->fopen();
   114	            $csvService->putBOM();
   115	
   116	            $csvService->fputcsv(array_merge(['日付'], $headers));
   117	
   118	            // データ出力
   119	            foreach ($result['result'] as $data) {
   120	                $row = [$data['order_date']];
   121	                foreach ($headers as $key => $column) {
   122	                    if ($key === 'buyer_rate') {
   123	                        $row[] = $data[$key] . '%';
   124	                    } else {
   125	                        $row[] = $data[$key];
   126	                    }
   127	                }
   128	                $csvService->fputcsv($row);
   129	            }
   130	            $csvService->fclose();
   131	        });
   132	
   133	        $now = new \DateTime();
   134	        $filename = 'report_summary_' . $now->format('YmdHis') . '.csv';
   135	        $response->headers->set('Content-Type', 'application/octet-stream');
   136	        $response->headers->set('Content-Disposition', 'attachment; filename=' . $filename);
   137	        $response->send();
   138	
   139	        return $response;
   140	    }
   141	
   142	    /**
   143	     * 表示項目取得
   144	     * @param array $form
   145	     * @return array
   146	     */
   147	    private function getDispColumns($form)
   148	    {
   149	        $dispColumns = [];
   150	        foreach (['order', 'product'] as $columnType) {
   151	            $sub = $columnType === 'product' ? '商品別' : '';
   152	            $columns = $form["columns_{$columnType}"];
   153	            foreach ($columns as $column) {
   154	                $columnNames = self::COLUMN_NAMES[$column];
   155	                if (is_array($columnNames) && isset($columnNames['detail'])) {
   156	                    foreach ($columnNames['detail'] as $detailKey => $detailValue) {
   157	                        $dispColumns["{$columnType}_{$detailKey}_{$column}"] = $sub . $columnNames['name'] . $detailValue;
   158	                    }
   159	                } elseif (is_array($columnNames)) {
   160	                    foreach ($columnNames['name'] as $key => $name) {
   161	                        $dispColumns[$key] = $name;
   162	                    }
   163	                } else {
   164	                    $dispColumns[$column] = $columnNames;
   165	                }
   166	            }
   167	        }
   168	
   169	        return $dispColumns;
   170	    }
   171	}
