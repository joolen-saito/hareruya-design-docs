   103	                ->leftJoin('Plugin\HareruyaEc\Entity\DtbCustomerGroup', 'cg', 'WITH', 'pl.customerGroupId = cg.id');
   104	        } elseif ($summaryType === 'class_category_name') {
   105	            $qb->join('Eccube\Entity\ProductCategory', 'pcate', 'WITH', 'p.id = pcate.product_id')
   106	                ->join('pcate.Category', 'cate');
   107	        }
   108	
   109	        $searchDate = $dateType;
   110	        if ($dateType !== 'cancel_date') {
   111	            $qb->join('o.OrderStatus', 'os', 'WITH', 'os.id != ' . OrderStatus::ORDER_CANCEL);
   112	        }
   113	        if ($dateType !== 'order_date' && $dateType !== 'payment_date') {
   114	            $searchDate = 'osb.' . lcfirst(strtr(ucwords(strtr($dateType, ["_" => " "])), [" " => ""]));
   115	            $qb->join('Plugin\HareruyaEc\Entity\DtbOrderSub', 'osb', 'WITH', 'o.id = osb.orderId');
   116	        } else {
   117	            $searchDate = "o.{$dateType}";
   118	        }
   119	
   120	        $qb->andWhere("o.order_date is not null");
