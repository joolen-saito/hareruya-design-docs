    23	class SalesAnalysisCsvExporterService
    24	{
    25	    public function __construct(
    26	        protected CsvExportService $csvExportService,
    27	        protected OrderItemRepository $orderItemRepository,
    28	        protected TranslatorInterface $translator,
    29	    ) {
