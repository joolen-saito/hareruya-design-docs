   222	                ->setParameter('cardsets', $searchData['cardsets']->toArray());
   223	        }
   224	
   225	        // 状態
   226	        $cardCondition = $searchData['card_condition'];
   227	        if (!empty($cardCondition) && count($cardCondition) > 0) {
   228	            $conditions = [];
   229	            foreach ($cardCondition as $type) {
   230	                $conditions[] = $type->getId();
   231	            }
   232	            $qb->join('od.ProductClass', 'pc')
   233	                ->join('Plugin\HareruyaEc\Entity\DtbProductSubClass', 'psc', 'with', 'pc.id = psc.productClassId')
   234	                ->andWhere('psc.cardConditionId in (:card_condition)')
   235	                ->setParameter('card_condition', $conditions);
   236	        }
   237	
   238	        // 平均単価
   239	        $priceFrom = $searchData['price_from'];
   240	        $priceTo = $searchData['price_to'];
   241	        if (isset($priceFrom) && Str::isNotBlank($priceFrom) && is_numeric($priceFrom)) {
   242	            $qb->andHaving('price >= :price_from')
   243	                ->setParameter('price_from', $priceFrom);
   244	        }
   245	        if (isset($priceTo) && Str::isNotBlank($priceTo) && is_numeric($priceTo)) {
   246	            $qb->andHaving('price <= :price_to')
   247	                ->setParameter('price_to', $priceTo);
   248	        }
   249	
   250	        // 数量
   251	        $salesFrom = $searchData['sales_from'];
