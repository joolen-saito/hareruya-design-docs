   126	    public function edit(Application $app, Request $request, $id = null)
   127	    {
   128	        if (is_null($id)) {
   129	            $form = $app['form.factory']->createBuilder('card_set')->getForm();
   130	            $cardlist = null;
   131	        } else {
   132	            $softDeleteFilter = $app['orm.em']->getFilters()->getFilter('soft_delete');
   133	            $softDeleteFilter->setExcludes([
   134	                'Eccube\Entity\Category',
   135	            ]);
   136	
   137	            // カードセット1件取得
   138	            $cardset = $app['hareruya_ec.repository.cardset']->findOneById($id);
   139	
   140	            if (!$cardset) {
   141	                return $app->abort(404);
   142	            }
   143	
   144	            $form = $app['form.factory']->createBuilder('card_set', $cardset)->getForm();
   145	
   146	            // 収録カードリスト
   147	            // カード詳細取得
   148	            $cardlist = $app['hareruya_ec.repository.card']->selectCardsetId($id);
   149	        }
   150	
   151	        return $app->render('HareruyaEc/Resource/template/admin/Cardset/card_set_detail.twig', array(
   152	            'form' => $form->createView(),
   153	            'cardlists' => $cardlist,
   154	            'id' => $id,
   155	        ));
   156	    }
   157	
   158	    /**
   159	     * カードセット登録 「登録」
   160	     * カードセット詳細 「更新」
   161	     * @param Application $app
   162	     * @param Request $request
   163	     * @return \Symfony\Component\HttpFoundation\Response
   164	     */
   165	    public function update(Application $app, Request $request)
   166	    {
   167	        $this->app = $app;
   168	        $form = $app['form.factory']->createBuilder('card_set')->getForm()->handleRequest($request);
   169	
   170	        $s3 = new S3AccessService($app);
   171	        $s3->setS3Directory(self::S3_DIRCTORY);
   172	
   173	        if (!$this->isFormValid($app, $form)) {
   174	            $app->addError('admin.register.failed', 'admin');
   175	            $id = $form->getData() ? $form->getData()['id'] : null;
   176	            $cardlist = !is_null($id) ? $app['hareruya_ec.repository.card']->selectCardsetId($id) : [];
   177	
   178	            return $app->render('HareruyaEc/Resource/template/admin/Cardset/card_set_detail.twig', [
   179	                'form' => $form->createView(),
   180	                'cardlists' => $cardlist,
   181	                'id' => $id,
   182	            ]);
   183	        }
   184	
   185	        $data = $form->getData();
   186	        // シンボル画像前処理
   187	        $symbolImage = null;
   188	
   189	        if (!empty($data['upload_url'])) {
   190	            $uploadDir = $app['config']['user_data_realdir'];
   191	            $symbolImage = $this->convertStrToServer($data['upload_url']->getClientOriginalName());
   192	            $uploadPath = $uploadDir . '/' . $symbolImage;
   193	        // アップロードしない場合、元の画像を引き継ぐ
   194	        } elseif (!empty($data['symbol_image'])) {
   195	            $symbolImage = $data['symbol_image'];
   196	        }
   197	        // 登録/更新判定
   198	        $isRegister = is_null($data['id']);
   199	
   200	        if ($isRegister) {
   201	            $mtbCardset = new \Plugin\HareruyaEc\Entity\MtbCardset();
   202	        } else {
   203	            $mtbCardset = $app['hareruya_ec.repository.cardset']->findOneById($data['id']);
   204	        }
   205	
   206	        $mtbCardset->setNameJp($data['nameJp'])
   207	            ->setNameEn($data['nameEn'])
   208	            ->setCode($data['code'])
   209	            ->setCardsetblockId($data['cardsetblockId'])
   210	            ->setReleaseDate(new \DateTime($data['releaseDate']->format('Y-m-d')))
   211	            ->setRank(intval($data['rank']))
   212	            ->setSpecialFlg($data['specialFlg'])
   213	            ->setDisplaySideMenuFlg($data['displaySideMenuFlg'])
   214	            ->setBranchDisplayFlg($data['branchDisplayFlg'])
   215	            ->setArenaLegalFlg($data['arenaLegalFlg'])
   216	            ->setRarityDisplayFlg($data['rarityDisplayFlg'])
   217	            ->setSingleAndPackBoxDisplayFlg($data['singleAndPackBoxDisplayFlg'])
   218	            ->setCategory($data['category'])
   219	            ->setFreeAreaJp($data['freeAreaJp'])
   220	            ->setFreeAreaEn($data['freeAreaEn'])
   221	        ;
   222	
   223	        // シンボル画像後処理
   224	        if (!empty($data['upload_url'])) {
   225	            // 画像名が同じ場合、古い画像を削除 不要かも
   226	            $fs = new Filesystem();
   227	            if ($fs->exists($uploadPath)) {
   228	                $fs->remove($uploadPath);
   229	            }
   230	            $moveFile = $data['upload_url']->move($uploadDir, $symbolImage);
   231	            $s3FilePath = $s3->putFile(['extension' => $moveFile->guessExtension(), 'file' => $uploadPath]);
   232	            $mtbCardset->setSymbolImage($s3FilePath);               // シンボル画像
   233	        }
   234	
   235	        $app['orm.em']->persist($mtbCardset);
   236	        $app['orm.em']->flush();
   237	        $app->addSuccess('admin.register.complete', 'admin');
   238	
   239	        // カードセット詳細画面に遷移
   240	        return $app->redirect($app->url('admin_cardset_edit', array('id' => $mtbCardset->getId())));
   241	    }
