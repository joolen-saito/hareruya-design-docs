   150	                'label' => 'シンボル画像',
   151	                'required' => false,
   152	            ])
   153	            ->add('upload_url', 'file', [
   154	                'label' => false,
   155	                'required' => false,
   156	            ])
   157	            ->add('category', 'entity', [
   158	                'label' => 'カテゴリ',
   159	                'required' => false,
   160	                'class' => 'Eccube\Entity\Category',
   161	                'expanded' => false,
   162	                'multiple' => false,
   163	                'empty_value' => '未指定',
   164	            ])
   165	            ->add('freeAreaJp', 'textarea', [
   166	                'label' => 'フリーエリア(日)',
   167	                'required' => false,
   168	                'attr' => [
