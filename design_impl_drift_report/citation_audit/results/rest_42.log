   125	                'required' => false,
   126	            ])
   127	            // ARENA導入フラグ
   128	            ->add('arenaLegalFlg', 'checkbox', [
   129	                'label' => 'form.format.arena_legal_flg.label',
   130	                'value' => 'false',
   131	                'required' => false,
   132	            ])
   133	            // レアリティ別表示フラグ
   134	            ->add('rarityDisplayFlg', 'checkbox', [
   135	                'label' => 'レアリティ別に表示させない',
   136	                'required' => false,
   137	            ])
   138	            // レアリティ別表示(【未開封品】パック・ボックスは表示する)フラグ
   139	            ->add('singleAndPackBoxDisplayFlg', 'checkbox', [
   140	                'label' => 'レアリティ別に表示させない(【未開封品】パック・ボックスは表示する)',
   141	                'required' => false,
   142	            ])
   143	            // 支店表示フラグ
   144	            ->add('branchDisplayFlg', 'checkbox', [
