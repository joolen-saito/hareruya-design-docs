   171	            ])
   172	            ->add('freeAreaEn', 'textarea', [
   173	                'label' => 'フリーエリア(英)',
   174	                'required' => false,
   175	                'attr' => [
   176	                    'placeholder'   => 'フリーエリア(英)',
   177	                ]
   178	            ])
   179	        ;
   180	    }
