    78	    }
    79	
    80	    /**
    81	     * 登録/更新
    82	     * @param Application $app
    83	     * @param Request $request
    84	     * @param string $formatId
    85	     * @return \Symfony\Component\HttpFoundation\Response
    86	     */
    87	    public function update(Application $app, Request $request, $formatId = null)
    88	    {
    89	        if (is_null($format = $formatId ? $app['hareruya_ec.repository.format']->find($formatId) : new MtbFormat())) {
    90	            // DBに見つからない場合はエラーとする
    91	            return $app->abort(404);
    92	        }
    93	
    94	        $form = $app['form.factory']->createBuilder('hareruyaec_format', $format)->getForm()->handleRequest($request);
    95	
    96	        if (!$this->isFormValid($app, $form)) {
    97	            $app->addError('admin.register.failed', 'admin');
    98	
    99	            return $app->render('HareruyaEc/Resource/template/admin/Format/formatedit.twig', [
   100	                'form' => $form->createView(),
   101	                'format' => $format,
   102	            ]);
   103	        }
   104	
   105	        $app['orm.em']->persist($format);
   106	        $app['orm.em']->flush();
   107	
   108	        $banIds = array_reduce($form['bannedCards']->getData()->getValues(), function ($carray, $format) {
   109	            $carray[] = $format->getId();
   110	            return $carray;
   111	        }, []);
   112	
   113	        $restrictionIds = array_reduce($form['restrictedCards']->getData()->getValues(), function ($carray, $format) {
   114	            $carray[] = $format->getId();
   115	            return $carray;
   116	        }, []);
   117	
   118	        $newIds = array_merge($banIds, $restrictionIds);
   119	
   120	        // 直前の禁止・制限情報を削除
   121	        foreach($format->getCardFormats() as $cardFormat) {
   122	            if (
   123	                $cardFormat->getRestriction()->getId() !== MtbRestriction::LEGAL_ID ||
   124	                in_array($cardFormat->getCardId(), $newIds, true)
   125	            ) {
   126	                $app['orm.em']->remove($cardFormat);
   127	            }
   128	        }
   129	
   130	        // 禁止・制限カード登録
   131	        $this->persistCardFormats($app, $format,
   132	            $form['bannedCards']->getData(),
   133	            $form['restrictedCards']->getData()
   134	        );
   135	
   136	        // 各ボード情報persist
   137	        $this->persistEachBoards($app, $format, $form);
   138	
   139	        $app['orm.em']->flush();
   140	        $app->addSuccess('admin.register.complete', 'admin');
   141	
   142	        return $app->redirect($app->url('admin_format_edit', ['formatId' => $format->getId()]));
   143	    }
   144	
   145	    /**
   146	     * 削除
   147	     * @param Application $app
   148	     * @param Request $request
   149	     * @param string $formatId
   150	     * @return \Symfony\Component\HttpFoundation\Response
   151	     */
   152	    public function delete(Application $app, Request $request, $formatId)
   153	    {
   154	        $this->checkCsrfValid($app);
   155	
   156	        if (is_null($format = $app['hareruya_ec.repository.format']->find($formatId))) {
   157	            // DBに見つからない場合はエラーとする
   158	            return $app->abort(404);
   159	        }
   160	        // 大会・デッキ・アーキタイプで使用されているなら削除不可とする
   161	        if (!$format->getEvents()->isEmpty() || !$format->getDecks()->isEmpty() || !$format->getArchetypes()->isEmpty()) {
   162	            $app->addError('admin.format.error.delete.event', 'admin');
   163	
   164	            return $app->redirect($request->headers->get('referer'));
   165	        }
   166	
   167	        // 禁止・制限情報の削除
   168	        foreach($format->getCardFormats() as $cardFormat) {
   169	            $app['orm.em']->remove($cardFormat);
   170	        }
   171	
   172	        // フォーマットの削除
   173	        $app['orm.em']->remove($format);
   174	        $app['orm.em']->flush();
   175	        $app->addSuccess('admin.delete.complete', 'admin');
   176	
   177	        return $app->redirect($app->url('admin_format_list'));
   178	    }
   179	
   180	    /**
   181	     * 指定されたフォーマットと制限を持つDtbCardFormatをカード分生成する
   182	     * @param MtbFormat $format
   183	     * @param MtbRestriction $restriction
   184	     * @param array $cards
   185	     * @return array
   186	     */
   187	    private function createCardFormatArr($format, $restriction, $cards)
   188	    {
   189	        $newCardFormatArr = [];
   190	        foreach ($cards as $card) {
   191	            $cardFormat = new DtbCardFormat();
   192	            $cardFormat->setCard($card)
   193	                ->setFormat($format)
   194	                ->setRestriction($restriction);
   195	            $newCardFormatArr[] = $cardFormat;
   196	        }
   197	
   198	        return $newCardFormatArr;
   199	    }
   200	
   201	    /**
   202	     * DtbCardFormatから禁止カードエンティティと制限カードエンティティを抽出する
   203	     * @param array $cardFormatArr
   204	     * @param array $restrictedCards
   205	     * @param array $bannedCards
   206	     */
   207	    private function extractBannedOrRestrictedCards($cardFormatArr, &$bannedCards, &$restrictedCards)
   208	    {
   209	        foreach ($cardFormatArr as $cardFormat) {
   210	            if ($cardFormat->getRestrictionId() === MtbRestriction::BAN_ID) {
   211	                $bannedCards[] = $cardFormat->getCard();
   212	            } elseif ($cardFormat->getRestrictionId() === MtbRestriction::RESTRICTION_ID) {
   213	                $restrictedCards[] = $cardFormat->getCard();
   214	            }
   215	        }
   216	    }
   217	
   218	    /**
   219	     * 禁止・制限カード情報をpersistする
   220	     * @param Application $app
   221	     * @param MtbFormat $format
   222	     * @param array $bannedCards
   223	     * @param array $restrictedCards
   224	     */
   225	    private function persistCardFormats(Application $app, $format, $bannedCards, $restrictedCards)
   226	    {
   227	        $bannedRestriction = $app['orm.em']->getRepository('Plugin\HareruyaEc\Entity\MtbRestriction')->find(
   228	            MtbRestriction::BAN_ID
   229	        );
   230	        $restrictedRestriction = $app['orm.em']->getRepository('Plugin\HareruyaEc\Entity\MtbRestriction')->find(
   231	            MtbRestriction::RESTRICTION_ID
   232	        );
   233	        // 追加するレコードを作成
   234	        $newBannedCardFormatArr = $this->createCardFormatArr($format, $bannedRestriction, $bannedCards);
   235	        $newRestrictedCardFormatArr = $this->createCardFormatArr($format, $restrictedRestriction, $restrictedCards);
   236	
   237	        $newBannedOrRestrictedCardFormat = array_merge($newBannedCardFormatArr, $newRestrictedCardFormatArr);
   238	        foreach ($newBannedOrRestrictedCardFormat as $cardFormat) {
   239	            // 選択された禁止カードまたは制限カードを持つレコードを登録
   240	            $app['orm.em']->persist($cardFormat);
   241	        }
   242	    }
   243	
   244	    /**
   245	     * 各ボード情報をpersistする
   246	     * @param Application $app
   247	     * @param MtbFormat $format
   248	     * @param Form $form
   249	     */
   250	    private function persistEachBoards(Application $app, $format, $form)
   251	    {
   252	        // メイン
   253	        $mainFormatBoard = $this->getPersistedFormatBoard(
   254	            $app, MtbBoard::BOARD_ID_MAIN,
   255	            $form['mainMaxCardCount']->getData(), $form['mainMinCardCount']->getData(), $format
   256	        );
   257	        $mainFormatBoard->setCountBoardId(null);
   258	        $app['orm.em']->persist($mainFormatBoard);
   259	
   260	        // サイド
   261	        $sideFormatBoard = $this->getPersistedFormatBoard(
   262	            $app, MtbBoard::BOARD_ID_SIDE,
   263	            $form['sideMaxCardCount']->getData(), $form['sideMinCardCount']->getData(), $format
   264	        );
   265	        $sideFormatBoard->setCountBoardId(null);
   266	        $app['orm.em']->persist($sideFormatBoard);
   267	
   268	        // 統率
   269	        if ($form['useCommandFlg']->getData()) {
   270	            $commandFormatBoard = $this->getPersistedFormatBoard(
   271	                $app, MtbBoard::BOARD_ID_COMMAND,
   272	                $form['commandMaxCardCount']->getData(), $form['commandMinCardCount']->getData(), $format
   273	            );
   274	
   275	            $commandFormatBoard->setCountBoard(
   276	                $form['commanderInMain']->getData() ?
   277	                $mainFormatBoard : null
   278	            );
   279	
   280	            $app['orm.em']->persist($commandFormatBoard);
   281	        } else if ($commandFormatBoard = $format->getBoardByBoardId(MtbBoard::BOARD_ID_COMMAND)) {
   282	            $app['orm.em']->remove($commandFormatBoard);
   283	        }
   284	    }
   285	
   286	    /**
   287	     * persistしたいボード情報を得る
   288	     * @param Application $app
   289	     * @param integer $maxCardCount
   290	     * @param integer $minCardCount
   291	     * @param MtbFormat $format
   292	     * @return DtbFormatBoard
   293	     */
   294	    private function getPersistedFormatBoard(Application $app, $baordId, $maxCardCount, $minCardCount, $format)
   295	    {
   296	        if (!$formatBoard = $format->getBoardByBoardId($baordId)) {
   297	            $formatBoard = new DtbFormatBoard();
   298	            $formatBoard->setFormat($format);
   299	            $formatBoard->setBoard($app['hareruya_ec.repository.board']->find($baordId));
   300	        }
