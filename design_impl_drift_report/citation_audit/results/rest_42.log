   490	    public static function removeAllDirContents($dirPath)
   491	    {
   492	        $files = new \RecursiveIteratorIterator(
   493	            new \RecursiveDirectoryIterator($dirPath, \FilesystemIterator::SKIP_DOTS),
   494	            \RecursiveIteratorIterator::CHILD_FIRST
   495	        );
   496	
   497	        foreach ($files as $file) {
   498	            $file->isDir() ? rmdir($file->getPathname()) : unlink($file->getPathname());
   499	        }
   500	    }
   501	
   502	    private function convertStrToServer($target)
   503	    {
   504	        if ($this->encode === self::SJIS) {
   505	            return mb_convert_encoding($target, self::SJIS, self::UTF);
   506	        }
   507	
   508	        return $target;
   509	    }
