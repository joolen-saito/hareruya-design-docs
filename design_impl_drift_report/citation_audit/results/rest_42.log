    94	
    95	        $pagination = $app['paginator']()->paginate(
    96	            $cardsets,
    97	            $page_no,
    98	            $pageCount,
    99	            array('wrap-queries' => true)
   100	        );
   101	
   102	        // sessionに保持
   103	        $session->set('eccube.admin.cardset.page_no', $page_no);
   104	        $session->set('eccube.admin.cardset.pageCount', $pageCount);
   105	        $session->set('eccube.admin.cardset.sortSelect', $sortSelect);
   106	
   107	        return $app->render('HareruyaEc/Resource/template/admin/Cardset/card_set.twig', array(
   108	            'form' => $form->createView(),
