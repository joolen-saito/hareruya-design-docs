    48	            $session->remove('eccube.admin.cardset.page_no');
    49	            $session->remove('eccube.admin.cardset.pageCount');
    50	            $session->remove('eccube.admin.cardset.sortSelect');
    51	        }
    52	
    53	        // ページ関連
    54	        $pagination = array();
    55	        $pageMaxis = $app['eccube.repository.master.page_max']->findAll(); // 表示件数dropdown
    56	        $pageCount = $session->get('eccube.admin.cardset.pageCount', $app['config']['default_page_count']);
    57	        $pageCountParam = $request->get('pageCount');
    58	
    59	        // URLパラメーターを確認
    60	        if ($pageCountParam && is_numeric($pageCountParam)) {
    61	            foreach ($pageMaxis as $pageMax) {
    62	                if ($pageCountParam === $pageMax->getName()) {
    63	                    $pageCount = $pageMax->getName();
    64	                    $session->set('eccube.admin.cardset.pageCount', $pageCount); // SESSIONに保存
    65	
    66	                    break;
    67	                }
    68	            }
    69	        }
    70	
    71	        // 並び順関連
    72	        // 暫定？
    73	        $sortOrders = array('リリース日（昇順）', 'リリース日（降順）', 'セット英名（昇順）', 'セット英名（降順）');
    74	        // sessionに無い場合は「リリース日（降順）」
    75	        $sortSelect = $session->get('eccube.admin.cardset.sortSelect', $sortOrders[1]);
    76	        $sortSelectParam = $request->get('sortSelect');
    77	
    78	        // URLパラメーターを確認
    79	        if ($sortSelectParam) {
    80	            foreach ($sortOrders as $sortOrder) {
    81	                if ($sortSelectParam === $sortOrder) {
    82	                    $sortSelect = $sortOrder;
    83	                    $session->set('eccube.admin.cardset.sortSelect', $sortSelect); // SESSIONに保存
