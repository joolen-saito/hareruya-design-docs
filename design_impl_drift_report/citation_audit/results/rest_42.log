    78	                        'message' => '半角文字のみ使用可能です。',
    79	                    ]),
    80	                ]
    81	            ])
    82	            // ブロック選択
    83	            ->add('cardsetblockId', 'choice', [
    84	                'label' => 'ブロック選択',
    85	                'choices' => $masterdata,
    86	                'empty_value' => '未指定',
    87	                'expanded' => false,
    88	                'multiple' => false,
    89	                'required' => false,
    90	            ])
    91	            // リリース日
    92	            ->add('releaseDate', 'date', [
    93	                'label' => 'リリース日',
    94	                'required' => true,
    95	                'input' => 'datetime',
    96	                'widget' => 'single_text',
    97	                'format' => 'yyyy-MM-dd', //  HH:mm
    98	                'years' => range(date('Y'), date('Y') + 2),
    99	                'empty_value' => [
   100	                    'year' => '----',
   101	                    'month' => '--',
   102	                    'day' => '--',
   103	                ],
   104	            ])
   105	            // 並び順
   106	            ->add('rank', 'text', [
   107	                'label' => '並び順',
   108	                'required' => true,
   109	                'constraints' => [
   110	                    new Assert\NotBlank(),
   111	                    new Assert\Regex([
   112	                        'pattern' => '/^[0-9]\d*$/',
   113	                    ]),
   114	                    new Assert\Length(['max' => 8])
   115	                ]
   116	            ])
   117	            // 特殊セットフラグ
   118	            ->add('specialFlg', 'checkbox', [
   119	                'label' => '特殊セットフラグ',
   120	                'required' => false,
   121	            ])
   122	            // サイドメニュー表示フラグ
   123	            ->add('displaySideMenuFlg', 'checkbox', [
