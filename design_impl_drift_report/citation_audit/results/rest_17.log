   402	    public function csvTemplateDownload(Request $request): StreamedResponse
   403	    {
   404	        set_time_limit(0);
   405	
   406	        $columns = ['移動指示ID', '出庫元店舗(名称)', '入庫先店舗(名称)', '送り状No.'];
   407	        $filename = 'stock_move_instruction_record_template_'.(new \DateTime())->format('YmdHis').'.csv';
   408	
   409	        $encoding = $this->eccubeConfig['eccube_csv_export_encoding'] ?? 'SJIS-win';
   410	        $response = new StreamedResponse();
   411	        $response->setCallback(function () use ($columns, $encoding): void {
   412	            $fp = fopen('php://output', 'w');
   413	            // ExcelでUTF-8を正しく認識させるためBOMを出力
   414	            if (strtoupper((string) $encoding) === 'UTF-8') {
   415	                fwrite($fp, "\xEF\xBB\xBF");
   416	            }
   417	            $row = [];
   418	            foreach ($columns as $column) {
   419	                $row[] = mb_convert_encoding($column, $encoding, 'UTF-8');
   420	            }
   421	            fputcsv($fp, $row, $this->eccubeConfig['eccube_csv_export_separator'] ?? ',', '"', '\\');
   422	            fclose($fp);
   423	        });
   424	
   425	        $contentType = strcasecmp($encoding, 'SJIS-win') === 0 ? 'windows-31j' : $encoding;
   426	        $response->headers->set('Content-Type', 'text/csv; charset='.$contentType);
   427	        $response->headers->set('Content-Disposition', 'attachment; filename='.$filename);
   428	
   429	        $event = new EventArgs(
   430	            [
   431	                'response' => $response,
   432	            ],
   433	            $request
   434	        );
   435	        $this->eventDispatcher->dispatch($event, EccubeEvents::ADMIN_STOCK_MOVE_INSTRUCTION_TEMPLATE_DOWNLOAD_CSV_EXPORT);
   436	
   437	        return $response;
   438	    }
