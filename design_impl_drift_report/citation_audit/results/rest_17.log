   234	            foreach ($groups as $groupRows) {
   235	                $result = $this->processGroup($groupRows, $member, $baseInfo);
   236	                if ($result['ok']) {
   237	                    ++$successCount;
   238	                } else {
   239	                    $businessHasError = true;
   240	                    $this->flashErrors = array_merge($this->flashErrors, $result['errors']);
   241	                }
   242	            }
   243	
   244	            if ($businessHasError) {
   245	                $this->entityManager->rollback();
   246	
   247	                return;
   248	            }
   249	
   250	            if ($successCount > 0) {
   251	                $this->flashSuccesses[] = trans('admin.stock.split_join.list_csv_split_import_done', ['%count%' => (string) $successCount]);
   252	            }
