   202	                return;
   203	            }
   204	
   205	            // em->clear() 後、$this->member は UnitOfWork から完全に除外されて detach 状態になる。
   206	            // SaveEventSubscriber が prePersist/preUpdate で getCurrentUser()（= $this->member と
   207	            // 同一オブジェクト）を setCreator() に渡すため、flush() 時に
   208	            // getEntityIdentifier($this->member) が EntityNotFoundException を投げる。
   209	            // 対策: ① registerManaged で identity map へ再登録（originalEntityData は空で初期化）
   210	            //       ② refresh で DB 値を同期し originalEntityData を正しく設定（不要な UPDATE を防ぐ）
   211	            // em->find() を先に呼ぶと別オブジェクトが identity map に入り EntityIdentityCollisionException
   212	            // になるため、registerManaged → refresh の順序を厳守する。
   213	            $uow = $this->entityManager->getUnitOfWork();
   214	            $uow->registerManaged(
   215	                $this->member,
   216	                $this->entityManager->getClassMetadata(Member::class)->getIdentifierValues($this->member),
   217	                [],
   218	            );
   219	            $this->entityManager->refresh($this->member);
   220	            $member = $this->member;
   221	
   222	            // em->clear() により baseInfo が detach されているため再取得する（在庫区分はプルダウン店舗を維持）
   223	            $baseInfo = $this->entityManager->find(BaseInfo::class, $this->baseInfo->getId());
   224	            if ($baseInfo === null) {
   225	                $this->entityManager->rollback();
   226	
   227	                return;
   228	            }
   229	
   230	            $groups = $this->buildGroups();
   231	            $successCount = 0;
   232	            $businessHasError = false;
