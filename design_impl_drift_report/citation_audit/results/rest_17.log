   237	        $MovingStatus = $this->entityManager->find(
   238	            MtbStockMoveTransferStatus::class,
   239	            MtbStockMoveTransferStatus::STATUS_MOVING
   240	        );
   241	        foreach ($Transfers as $Transfer) {
