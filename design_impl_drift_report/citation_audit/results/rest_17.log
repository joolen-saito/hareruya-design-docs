   198	            ],
   199	            $request
   200	        );
   201	        $this->eventDispatcher->dispatch($event, EccubeEvents::ADMIN_STOCK_MOVE_INSTRUCTION_DETAIL_INITIALIZE);
   202	
   203	        $form = $builder->getForm();
   204	        $form->handleRequest($request);
   205	
   206	        if ($form->isSubmitted() && $form->isValid()) {
   207	            $newTrackingNo = trim($Instruction->getTrackingNo() ?? '');
   208	            if ($originalTrackingNo !== null && $originalTrackingNo !== '' && $newTrackingNo === '') {
   209	                $form->get('trackingNo')->addError(
   210	                    new FormError(
   211	                        $this->translator->trans('admin.stock.move_instruction.detail_tracking_no_cannot_be_cleared', [], 'messages')
   212	                    )
   213	                );
   214	            } else {
   215	                $input = new StockMoveInstructionDetailUpdateInput(
   216	                    $Instruction,
   217	                    $this->getMember(),
   218	                );
   219	                $this->detailUpdateAction->handle($input);
   220	
   221	                $event = new EventArgs(
   222	                    [
   223	                        'Instruction' => $Instruction,
   224	                    ],
   225	                    $request
   226	                );
   227	                $this->eventDispatcher->dispatch($event, EccubeEvents::ADMIN_STOCK_MOVE_INSTRUCTION_DETAIL_COMPLETE);
   228	
   229	                $this->addSuccess('admin.common.save_complete', 'admin');
   230	
   231	                return $this->redirectToRoute('admin_stock_move_instruction_detail', ['id' => $id]);
   232	            }
   233	        }
   234	
   235	        $Moves = $this->stockMoveTransferRepository->findBy(
   236	            ['moveInstructionId' => $Instruction->getId()],
   237	            ['id' => 'ASC']
   238	        );
   239	
   240	        $moveIds = array_map(static fn ($m) => $m->getId(), $Moves);
   241	        $moveAggregates = $this->stockMoveInstructionRepository->getTransferAggregatesByTransferIds(
   242	            $moveIds,
   243	            $Instruction->getMoveFromPriceThreshold()
   244	        );
   245	
   246	        $outboundTotalCost = '0';
   247	        $highTotalPrice = '0';
   248	        $regularTotalPrice = '0';
   249	        foreach ($moveAggregates as $agg) {
   250	            $outboundTotalCost = bcadd($outboundTotalCost, $agg['outbound_total_cost'], 2);
   251	            $highTotalPrice = bcadd($highTotalPrice, $agg['high_total'], 2);
   252	            $regularTotalPrice = bcadd($regularTotalPrice, $agg['regular_total'], 2);
   253	        }
   254	
   255	        return [
   256	            'instruction' => $Instruction,
   257	            'form' => $form->createView(),
   258	            'Moves' => $Moves,
   259	            'moveAggregates' => $moveAggregates,
   260	            'outboundTotalCost' => $outboundTotalCost,
   261	            'highTotalPrice' => $highTotalPrice,
   262	            'regularTotalPrice' => $regularTotalPrice,
   263	        ];
   264	    }
