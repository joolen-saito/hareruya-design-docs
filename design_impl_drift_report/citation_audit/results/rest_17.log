   351	    private function deleteInstruction(DtbStockMoveInstruction $Instruction): void
   352	    {
   353	        $trackingNo = $Instruction->getTrackingNo();
   354	        if ($trackingNo !== null && $trackingNo !== '') {
   355	            throw new StockMoveInstructionDeleteException();
   356	        }
   357	
   358	        $Moves = $this->stockMoveTransferRepository->findBy(
   359	            ['moveInstructionId' => $Instruction->getId()],
   360	            ['id' => 'ASC']
   361	        );
   362	        foreach ($Moves as $Move) {
   363	            $Move->setTrackingNo(null);
   364	            $Move->setMoveInstructionId(null);
   365	        }
   366	
   367	        $this->entityManager->remove($Instruction);
   368	        $this->entityManager->flush();
   369	    }
