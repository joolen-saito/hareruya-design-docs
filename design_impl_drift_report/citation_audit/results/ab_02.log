    26	        // ピック完了済みの注文番号札（数字）の取得
    27	        $waitingNumberList = $app['hareruya_ec.repository.waiting_number']->getWaitingNumberByStatus(OrderStatus::ORDER_PICKED);
    28	
    29	        // 注文番号札(アルファベット)の取得
