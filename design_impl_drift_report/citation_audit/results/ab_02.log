    94	            throw new \RuntimeException('OrderStatus CANCEL is not found.');
    95	        }
    96	
    97	        $this->stockReduceProcessor->rollback($Order, new PurchaseContext());
    98	        $Order->setOrderStatus($CancelStatus);
    99	        $this->entityManager->flush();
   100	
   101	        // CANCEL への遷移を反映して会員のスマレジ累計を洗い替える (取消分は集計対象から外れる)。
