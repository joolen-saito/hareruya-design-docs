    74	            $this->logger->warning('No matching ECCUBE order for canceled Smaregi transaction', [
    75	                'webhookEventId' => $event->getId(),
    76	                'transactionHeadId' => $transactionHeadId,
    77	            ]);
    78	
    79	            return;
    80	        }
    81	
    82	        if ($Order->getOrderStatus()?->getId() === OrderStatus::CANCEL) {
    83	            $this->logger->info('Order is already canceled, skipping', [
    84	                'webhookEventId' => $event->getId(),
    85	                'transactionHeadId' => $transactionHeadId,
    86	                'orderId' => $Order->getId(),
    87	            ]);
    88	
    89	            return;
    90	        }
    91	
    92	        $CancelStatus = $this->orderStatusRepository->find(OrderStatus::CANCEL);
