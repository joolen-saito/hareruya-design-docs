   184	        $orderSub = $app['hareruya_ec.repository.order_sub']->findOneBy(['smaregiCode' => $smaregiCode], ['orderId' => 'DESC']);
   185	
   186	        if (!$orderSub) {
   187	            return 0;
   188	        }
   189	
   190	        $now = new \DateTime();
   191	
   192	        $order = $orderSub->getOrder();
   193	        foreach ($order->getShippings() as $shipping) {
   194	            $shipping->setShippingCommitDate($now);
   195	        }
   196	
   197	        $order
   198	            ->setCommitDate($now)
   199	            ->setOrderStatus($app['eccube.repository.order_status']->find(OrderStatus::ORDER_DELIV));
   200	        $orderSub->setShippingDate($now);
   201	
   202	        $memberSub = $app['hareruya_ec.repository.member_sub']->findOneBySmaregiMemberFlg(1);
   203	        if (!empty($memberSub)) {
   204	            $orderSub->setOperator($memberSub->getMember());
   205	        }
   206	        $app['hareruya_ec.service.point']->gainPoints($order);
   207	        $app['orm.em']->persist($orderSub);
   208	
   209	        // スマレジ側で決済やポイントの付与が行われている場合は以降の処理不要
   210	        if ($orderSub->getGainedPoints() === 0) {
   211	            $app['orm.em']->flush();
   212	
   213	            return 1;
   214	        }
   215	
   216	        $player = $app['hareruya_ec.repository.player']->findOneByCustomer($order->getCustomer());
   217	
   218	        // 付与ポイントのスマレジ連携。使用ポイントはECからの注文時に連携済み
   219	        $response = $app['hareruya_ec.service.smaregi_customer']->postSmaregiPoint($player->getSmaregiId(), $orderSub->getGainedPoints(), false);
   220	        if (!array_key_exists('result', $response)) {
   221	            $orderSub
   222	                ->setPointErrorMessage(json_encode($response, JSON_UNESCAPED_UNICODE))
   223	                ->setSmaregiErrorFlg(true);
   224	        }
   225	
   226	        $app['orm.em']->flush();
   227	
   228	        return 1;
   229	    }
   230	
   231	    /**
   232	     * 会員の取消通知ポイント情報関連を更新する
   233	     *
   234	     * @param Application $app
   235	     * @param string $smaregiId
   236	     * @param integer $gainPoint
   237	     * @param integer $spendPoint
   238	     * @param integer $transactionId
   239	     * @return integer
   240	     */
   241	    private function cancelCustomerPoint(Application $app, $smaregiId, $gainPoint, $spendPoint, $transactionId)
   242	    {
   243	        $player = $app['hareruya_ec.repository.player']->findOneBySmaregiId($smaregiId);
   244	        $pointHistories = $app['hareruya_ec.repository.point_history']->findByTransactionId($transactionId);
   245	        if (is_null($player) || empty($pointHistories)) {
   246	            return 0;
   247	        }
   248	
   249	        $newPoint = $player->getPoint() - $gainPoint + $spendPoint;
   250	        $player->setPoint($newPoint);
   251	        $app['orm.em']->persist($player);
   252	
   253	        foreach ($pointHistories as $pointHistory) {
   254	            $app['orm.em']->remove($pointHistory);
   255	        }
   256	
   257	        $app['orm.em']->flush();
   258	
   259	        return 1;
   260	    }
   261	
   262	    /**
   263	     * 支店システム側のスマレジ通知APIへ連携
   264	     *
   265	     * @param  Application $app
   266	     * @param  string $header
   267	     * @param  string $process
   268	     * @param  string $param
   269	     */
   270	    private function cURLForwardBranchSmaregi(Application $app, $header, $process, $param)
   271	    {
   272	        $param = urlencode($param);
   273	        $url = $app['hareruya_ec.config.api']['branch_api_url'] . $app['hareruya_ec.config.api']['endpoint_smaregi_transaction'];
   274	        $curl = curl_init();
   275	        curl_setopt($curl, CURLOPT_URL, $url);
   276	        curl_setopt($curl, CURLOPT_CUSTOMREQUEST, 'POST');
   277	        curl_setopt($curl, CURLOPT_HTTPHEADER, $header);
   278	        curl_setopt($curl, CURLOPT_POSTFIELDS, "proc_name={$process}&params=" . $param);
   279	        curl_setopt($curl, CURLOPT_RETURNTRANSFER, true);
   280	        curl_setopt($curl, CURLOPT_HEADER, true);
   281	
   282	        $response = curl_exec($curl);
   283	        $header_size = curl_getinfo($curl, CURLINFO_HEADER_SIZE);
   284	        $body = substr($response, $header_size);
   285	        $result = json_decode($body, true);
   286	
   287	        curl_close($curl);
   288	
   289	        return $result;
   290	    }
   291	}
