    39	
    40	            foreach ($waitingNumberList as $waitingNumber) {
    41	                $targetNumber = $waitingNumber->getWaitingNumber();
    42	
    43	                // responseが空でなく、最後尾の次の番号がtargetNumberと一致しない場合
    44	                // 間の番号がすべて出荷済みか確認し、出荷済みならリストに追加する
    45	                if ((count($response) !== 0) && ((end($response) + 1) !==  $targetNumber)) {
    46	                    $betweenNumbers = range(end($response) + 1, $targetNumber - 1);
    47	                    if ($this->isBetweenAllOrderDeliv($delivNumbers, $betweenNumbers)) {
    48	                        $response = array_merge($response, $betweenNumbers);
    49	                    }
    50	                }
    51	                $response[] = $targetNumber;
    52	            }
    53	        } else {
    54	            // ピック完了済みの注文番号札（数字）を1つずつresponseに追加
    55	            foreach ($waitingNumberList as $waitingNumber) {
    56	                $response[] = $waitingNumber->getWaitingNumber();
    57	            }
    58	        }
    59	
    60	        // 注文番号札(アルファベット)を1つずつresponseに追加
