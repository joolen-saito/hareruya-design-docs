    31	
    32	        // 画面表示最大件数を超える場合は間の出荷完了の注文番号も含める
    33	        if (count($waitingNumberList) + count($waitingTagList) > $app['config']['HareruyaEc']['const']['waiting_monitor_max_size']) {
    34	            $delivNumbers = [];
    35	            $delivWaitingList = $app['hareruya_ec.repository.waiting_number']->getWaitingNumberByStatus(OrderStatus::ORDER_DELIV);
    36	            foreach ($delivWaitingList as $delivWaiting) {
