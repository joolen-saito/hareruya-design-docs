                <tr><td><span class="src-cell" data-excel-book="0203" data-excel-sheet="出荷実績登録CSVフォーマット" data-excel-ref="0203:出荷実績登録CSVフォーマット!B66" data-excel-formula="=ROW() - ROW(B$8) + 1">59</span></td><td><span class="src-cell" data-excel-book="0203" data-excel-sheet="出荷実績登録CSVフォーマット" data-excel-ref="0203:出荷実績登録CSVフォーマット!E66">配送先_FAX3</span></td><td></td><td><span class="src-cell" data-excel-book="0203" data-excel-sheet="出荷実績登録CSVフォーマット" data-excel-ref="0203:出荷実績登録CSVフォーマット!P66">数値(整数)</span></td><td></td><td></td><td><span class="src-cell" data-excel-book="0203" data-excel-sheet="出荷実績登録CSVフォーマット" data-excel-ref="0203:出荷実績登録CSVフォーマット!Z66">7545</span></td><td></td></tr>
                <tr><td><span class="src-cell" data-excel-book="0203" data-excel-sheet="出荷実績登録CSVフォーマット" data-excel-ref="0203:出荷実績登録CSVフォーマット!B67" data-excel-formula="=ROW() - ROW(B$8) + 1">60</span></td><td><span class="src-cell" data-excel-book="0203" data-excel-sheet="出荷実績登録CSVフォーマット" data-excel-ref="0203:出荷実績登録CSVフォーマット!E67">配送方法(ID)</span></td><td></td><td><span class="src-cell" data-excel-book="0203" data-excel-sheet="出荷実績登録CSVフォーマット" data-excel-ref="0203:出荷実績登録CSVフォーマット!P67">数値(整数)</span></td><td></td><td></td><td><span class="src-cell" data-excel-book="0203" data-excel-sheet="出荷実績登録CSVフォーマット" data-excel-ref="0203:出荷実績登録CSVフォーマット!Z67">3</span></td><td></td></tr>
                <tr><td><span class="src-cell" data-excel-book="0203" data-excel-sheet="出荷実績登録CSVフォーマット" data-excel-ref="0203:出荷実績登録CSVフォーマット!B68" data-excel-formula="=ROW() - ROW(B$8) + 1">61</span></td><td><span class="src-cell" data-excel-book="0203" data-excel-sheet="出荷実績登録CSVフォーマット" data-excel-ref="0203:出荷実績登録CSVフォーマット!E68">配送方法(名称)</span></td><td></td><td><span class="src-cell" data-excel-book="0203" data-excel-sheet="出荷実績登録CSVフォーマット" data-excel-ref="0203:出荷実績登録CSVフォーマット!P68">文字型</span></td><td></td><td></td><td><span class="src-cell" data-excel-book="0203" data-excel-sheet="出荷実績登録CSVフォーマット" data-excel-ref="0203:出荷実績登録CSVフォーマット!Z68">ゆうパック</span></td><td></td></tr>
