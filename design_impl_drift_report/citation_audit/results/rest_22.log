   166	    public function export(Application $app, Request $request)
   167	    {
   168	        $exportType = $request->get('export_type');
   169	        $otcBuyOrderIds = $request->request->get('otcBuyOrderIds');
   170	        if (empty($otcBuyOrderIds) || [] === $otcBuyOrderIds) {
   171	            $app->addError('admin.csv.error.export.product', 'admin');
   172	
   173	            return $app->redirect($request->headers->get('referer'));
   174	        }
   175	
   176	        $otcBuyOrderCsv = new OtcBuyOrderCsv($app, null, $this->sessionKey, self::CSV_HEADER[$exportType], null, $exportType);
   177	        set_time_limit(0);
   178	        $em = $app['orm.em'];
   179	        $em->getConfiguration()->setSQLLogger(null);
   180	
   181	        try {
   182	            $response = $otcBuyOrderCsv->exportCsv($otcBuyOrderIds);
   183	        } catch (\Exception $e) {
   184	            $app->addError($e->getMessage(), 'admin');
   185	
   186	            return $app->redirect($request->headers->get('referer'));
   187	        }
   188	
   189	        return $response;
   190	    }

