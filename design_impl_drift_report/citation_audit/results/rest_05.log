   501	    /**
   502	     * デッキ登録が可能か
   503	     *
   504	     * 以下のすべての条件を満たしていればtrueを返す
   505	     * - deckRegistFlgがtrueであること
   506	     * - deadlineFlgがfalseであること
   507	     */
   508	    public function canBeRegisteredDeck(): bool
   509	    {
   510	        return $this->getDeckRegistFlg() && !$this->getDeadlineFlg() && $this->deckRegistDeadline >= new \DateTime();
   511	    }
