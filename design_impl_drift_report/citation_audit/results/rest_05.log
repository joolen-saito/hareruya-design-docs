   513	    /**
   514	     * 該当IDのプレイヤーの申し込み情報を返す
   515	     */
   516	    public function getEventEntryAppliedByPlayerId(int $playerId): ?DtbEventEntry
   517	    {
   518	        $DtbEventEntry = $this->getEventEntries()
   519	            ->filter(fn (DtbEventEntry $e) => $e->isEntriedByPlayerId($playerId))
   520	            ->first();
   521	
   522	        if (!$DtbEventEntry) {
   523	            return null;
   524	        }
   525	
   526	        return $DtbEventEntry;
   527	    }
   528	
   529	    /**
   530	     * 該当IDのプレイヤーによって申し込まれたか
   531	     */
   532	    public function isEntriedByPlayerId(int $playerId): bool
   533	    {
   534	        return $this->getEventEntries()->exists(fn (int $i, DtbEventEntry $entry) => $entry->isEntriedByPlayerId($playerId));
   535	    }
   536	
   537	    /**
   538	     * 該当IDのプレイヤーが、指定した申込を除く同一日程の他申込に含まれているか（編集時に自申込を除外するため）
   539	     */
   540	    public function isEntriedByPlayerIdExceptEntry(int $playerId, ?int $excludeEventEntryId = null): bool
   541	    {
   542	        return $this->getEventEntries()->exists(function (int $i, DtbEventEntry $entry) use ($playerId, $excludeEventEntryId): bool {
   543	            if ($excludeEventEntryId !== null && $entry->getId() === $excludeEventEntryId) {
   544	                return false;
   545	            }
   546	
   547	            return $entry->isEntriedByPlayerId($playerId);
   548	        });
   549	    }
