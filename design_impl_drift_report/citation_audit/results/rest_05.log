    35	     * デッキ登録可能なイベントを全て表示する
    36	     * @params Application $app
    37	     * @param Request $request
    38	     * @return \Symfony\Component\HttpFoundation\Response
    39	     *
    40	     */
    41	    public function deckentryList(Application $app, Request $request)
    42	    {
    43	        $shopId = CookieUtil::getTopShopId(filter_input(INPUT_GET, 'shop'), $request);
    44	        $event = $request->get('event');
    45	        $player = $app['hareruya_ec.repository.player']->findOneByCustomerId($app->user()['id']);
    46	        //デッキ登録可能なイベント詳細を取得
    47	        $eventDetails = $app['hareruya_ec.repository.event_detail']->getDetailsThatCanBeRegisteredDeckentry($shopId, $event);
    48	
    49	        //ユーザーのイベント申込みリスト取得
    50	        $enteredEventDetails = $app['hareruya_ec.repository.event_detail']->getEntryEvents($player['playerid']);
    51	
    52	        //登録済みのデッキとイベント詳細の組を取得
    53	        $decks = $app['hareruya_ec.repository.deck']->getDetailsAndDecksByPlayerId($player['playerid']);
    54	        $deckEventDetailIds = array_column($decks, 'deckId', 'eventDetailId');
    55	        // イベント絞り込みフォームを取得
    56	        $form = $app['form.factory']->createBuilder('mypage_deckentry_search')->getForm()->handleRequest($request);
    57	
    58	        // マイデッキ情報の取得
    59	        $myDeckId = $request->get('deckId');
    60	        $myDeck = $app['hareruya_ec.repository.deck']->findOneBy(['deckId' => $myDeckId, 'player' => $player]);
    61	
    62	        return $app->render('Mypage/deckentry_list.twig', [
    63	            'eventDetails' => $eventDetails,
    64	            'enteredEventDetails' => $enteredEventDetails,
    65	            'deckEventDetailIds' => $deckEventDetailIds,
    66	            'form' => $form->createView(),
    67	            'currentShopId' => $shopId,
    68	            'myDeckName' => $myDeck ? $myDeck->getDeckName() : '',
    69	        ]);
    70	    }
