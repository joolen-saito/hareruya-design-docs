   159	        if (!$player) {
   160	            return $app->abort(Response::HTTP_NOT_FOUND);
   161	        }
   162	        $format = $this->getSelectedFormat($eventDetail->getEvent()->getFormats(), $request->get('format'));
   163	        if (!$format) {
   164	            return $app->abort(Response::HTTP_NOT_FOUND);
   165	        }
   166	        if ($this->deckEntryProblems($eventDetail) != $this::NO_PROBLEMS) {
   167	            return $app->abort(Response::HTTP_NOT_FOUND);
   168	        }
   169	
   170	        // アリーナカード名を実カード名に変換したカードリスト文字列を取得
   171	        $deckMainText = CardUtil::convertCardNamesFromArenaFormat($app, $request->get('deckMain'));
   172	        $deckSideText = CardUtil::convertCardNamesFromArenaFormat($app, $request->get('deckSide'));
   173	        $errorMain = null;
   174	        $errorSide = null;
   175	
   176	        // メイン/サイドボード入力内容確認
   177	        $main = CardUtil::decodeCardlist($app, $deckMainText);
   178	        if (gettype($main) === 'integer') {
   179	            $errorMain = $main;
   180	        }
   181	        $side = CardUtil::decodeCardlist($app, $deckSideText);
   182	        if (gettype($side) === 'integer') {
   183	            $errorSide = $side;
   184	        }
   185	
   186	        // 書式エラー時セッションに入力を保持してリダイレクト
   187	        if ($errorMain || $errorSide) {
   188	            $app['session']->set('hareruyaec.evententry.main_text', $deckMainText);
   189	            $app['session']->set('hareruyaec.evententry.side_text', $deckSideText);
   190	            $app['session']->set('hareruyaec.evententry.error_main', $errorMain);
   191	            $app['session']->set('hareruyaec.evententry.error_side', $errorSide);
   192	
   193	            return $app->redirect($app->path('deckentry_edit', [
   194	                'eventDetailId' => $eventDetailId,
   195	                'format' => $format,
   196	            ]));
   197	        }
   198	
   199	        // デッキ登録済みなら更新・異なるならば新規作成
   200	        $deck = $this->app['hareruya_ec.repository.deck']->findOneBy([
   201	            'eventDetailId' => $eventDetailId,
   202	            'player' => $player,
   203	            'format' => $format,
   204	        ]);
   205	
   206	        if ($deck) {
   207	            // 登録済みのデッキを上書き
   208	            $deck->setTextMain($deckMainText)
   209	                ->setTextSide($deckSideText)
   210	                ->setUpdateDate(date('Y/m/d H:i:s'))

