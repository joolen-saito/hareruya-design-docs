   137	    private function validateProductExists(ReadCsvRowEvent $event)
   138	    {
   139	        $row = $event->getRow();
   140	
   141	        // 商品がなければエラー
   142	        $productId = $this->productIdColumn->getValue($row);
   143	        $storageCode = $this->storageCodeColumn->getValue($row);
   144	        if (!$this->isProductExists($productId)) {
   145	            $event->getMessageStore()
   146	                ->addProductNotExistsError(
   147	                    $row->getRowNumber(),
   148	                    $this->productIdColumn->getLabel()
   149	                );
   150	            $event->breakAll();
   151	
   152	            return false;
   153	        }
   154	        // 略称コードを記録、なければエラー
   155	        if (!$this->setStorageCodeId($storageCode)) {
   156	            $event->getMessageStore()
   157	                ->addStorageCodeNotExistsError(
   158	                    $row->getRowNumber(),
   159	                    $this->storageCodeColumn->getLabel()
   160	                );
   161	            $event->breakAll();
   162	
   163	            return false;
   164	        }
   165	
   166	        return true;
   167	    }
