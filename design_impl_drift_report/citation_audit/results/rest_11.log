   172	     */
   173	    private function isProductExists(int $productId)
   174	    {
   175	        $sql = <<<EOT
   176	            SELECT
   177	                p.product_id
   178	            FROM
   179	                dtb_product p
   180	            WHERE
   181	                p.product_id = :productId
   182	                AND p.del_flg = :delFlg
   183	        EOT;
   184	
   185	        $rsm = new ResultSetMapping();
   186	        $rsm->addScalarResult('product_id', 'productId', Type::INTEGER);
   187	
   188	        $query = $this->em->createNativeQuery($sql, $rsm)
   189	            ->setParameter('productId', $productId)
   190	            ->setParameter('delFlg', Constant::DISABLED);
   191	        $result = $query->getOneOrNullResult();
   192	
   193	        return !empty($result);
   194	    }
   195	
   196	    /**
   197	     * @param string $storageCode 略称タグ文字列
   198	     * @return bool 略称タグが存在する場合 true
   199	     */
   200	    private function setStorageCodeId(string $storageCode)
   201	    {
   202	        if ($this->storageCodeIds[$storageCode]) {
   203	            return true;
   204	        }
   205	
   206	        $sql = <<<EOT
   207	            SELECT
   208	                sc.id
   209	            FROM
   210	                mtb_storage_code sc
   211	            WHERE
   212	                sc.name = :storageCode
   213	        EOT;
   214	
   215	        $rsm = new ResultSetMapping();
   216	        $rsm->addScalarResult('id', 'storageCodeId', Type::INTEGER);
   217	
   218	        $query = $this->em->createNativeQuery($sql, $rsm)
   219	            ->setParameter('storageCode', $storageCode)
   220	        ;
   221	        $result = $query->getOneOrNullResult();
   222	
   223	        if (!empty($result)) {
   224	            $this->storageCodeIds[$storageCode] = $result['storageCodeId'];
   225	
   226	            return true;
   227	        }
   228	
   229	        return false;
   230	    }
   231	
