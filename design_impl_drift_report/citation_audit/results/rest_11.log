   163	     * 略称タグCSV入力
   164	     * @param Application $app
   165	     * @param Request $request
   166	     * @return \Symfony\Component\HttpFoundation\Response
   167	     */
   168	    public function import(Application $app, Request $request)
   169	    {
   170	        $storageCodeCsv = new StorageCodeCsv($app, $this->importTwig, $this->sessionKey, $this->getCsvHeader(), $this->getRequiredCsvHeader());
   171	
   172	        $form = $app['form.factory']->createBuilder('admin_csv_import')->getForm()->handleRequest($request);
   173	
   174	        $storageCodeCsv->checkFormValid($form);
   175	        $formFile = $storageCodeCsv->getFormFile($form);
   176	
   177	        log_info('略称タグCSV登録開始');
   178	        $data = $storageCodeCsv->getImportData($formFile);
   179	        if ($data === false) {
   180	            return $storageCodeCsv->render();
   181	        }
   182	
   183	        try {
   184	            $headers = $this->getCsvHeader();
   185	            $columnHeaders = array_filter($data->getColumnHeaders());
   186	            $storageCodeCsv->checkHeaderValues(array_keys($headers), $columnHeaders, $this->getNotRequiredCsvHeader());
   187	            $headerSize = count($columnHeaders);
   188	            $storageCodeCsv->checkDataSize($data);
   189	            $app['orm.em']->getConfiguration()->setSQLLogger(null);
   190	            $app['orm.em']->beginTransaction();
   191	
   192	            $storageCodeCsv->register($headers, $headerSize, $data);
   193	        } catch (\LogicException | \RuntimeException $e) {
   194	            $app['orm.em']->rollback();
   195	            log_info('エラーが発生しました', [$e->getMessage()]);
   196	            $app->addError($e->getMessage(), 'admin');
   197	
   198	            return $storageCodeCsv->render();
   199	        }
   200	
   201	        log_info('略称タグCSV登録完了');
   202	        $app->addSuccess('admin.register.complete', 'admin');
   203	
   204	        return $storageCodeCsv->render();
   205	    }
