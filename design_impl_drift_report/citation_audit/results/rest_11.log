   162	    /**
   163	     * @return array<CsvColumnInterface>
   164	     */
   165	    protected function getColumns(): array
   166	    {
   167	        return [
   168	            $this->productCodeColumn,
   169	            $this->sellPriceColumn,
   170	            $this->saleFlgColumn,
   171	            $this->beltUrlColumn,
   172	            $this->productTagListColumn,
   173	        ];
   174	    }
   175	
   176	    /**
   177	     * @return array<RowValidatorInterface>
   178	     */
   179	    protected function getRowValidators(): array
   180	    {
   181	        return [];
   182	    }
   183	
   184	    private function validateRowTarget(ReadCsvRowEvent $event): bool
   185	    {
   186	        $row = $event->getRow();
   187	        $productCode = (string) $this->productCodeColumn->getValue($row);
   188	        $rowNumber = $row->getRowNumber();
   189	
   190	        if (!$this->productClassRepository->isProductCodeUnique($productCode)) {
   191	            $event->getMessageStore()->addProductCodeDuplicatedError($rowNumber, $productCode);
   192	
   193	            return false;
   194	        }
   195	
   196	        if ($this->productClassRepository->findHighPriceProductClassForSaleCsv($productCode) === null) {
   197	            $event->getMessageStore()->addProductNotExistsError(
   198	                $rowNumber,
   199	                $this->productCodeColumn->getLabel()
   200	            );
   201	
   202	            return false;
   203	        }
   204	
   205	        return true;
   206	    }
   207	}
  2200	    /**
  2201	     * 商品コードに該当し、sale_flg が指定値かつ  high_price_code が非空（NULL・空文字は除外）の行が存在するか。
  2202	     *
  2203	     * @param string $productCode 商品コード
  2204	     * @param bool $saleFlg true のとき sale_flg IS TRUE、false のとき sale_flg IS NOT TRUE OR sale_flg IS NULL で判定
  2205	     *
  2206	     * @return bool 存在する場合 true
  2207	     */
  2208	    public function existsProductClassByProductCodeAndSaleFlg(string $productCode, bool $saleFlg): bool
  2209	    {
  2210	        $saleFlgCondition = $saleFlg
  2211	            ? 'AND pc.sale_flg IS TRUE'
  2212	            : 'AND (pc.sale_flg IS NOT TRUE OR pc.sale_flg IS NULL)';
  2213	
  2214	        $sql = <<<EOT
  2215	            SELECT EXISTS (
  2216	                SELECT 1 FROM dtb_product_class pc
  2217	                INNER JOIN dtb_product p ON p.id = pc.product_id
  2218	                WHERE pc.product_code = ?
  2219	                {$saleFlgCondition}
  2220	                AND pc.high_price_code IS NOT NULL
  2221	                AND pc.high_price_code <> ''
  2222	            )
  2223	            EOT;
  2224	
  2225	        return (bool) $this->getEntityManager()->getConnection()->fetchOne($sql, [$productCode]);
  2226	    }
  2227	
  2228	    /**
  2229	     * セール用高額商品価格変更CSV用。
  2230	     * 商品コードに一致し、高額商品コードが非空で設定された商品規格を1件取得する
  2231	     * NULL・空文字は他機能と同様に「高額商品ではない」とみなす。
  2232	     */
  2233	    public function findHighPriceProductClassForSaleCsv(string $productCode): ?ProductClass
  2234	    {
  2235	        // NOTE:
  2236	        // - v3では DtbProductSubClass (psc) を起点に ProductClass (pc) と結合していたが、
  2237	        //   v4では ProductSubClass 相当のカラムが ProductClass に統合されている前提のため、
  2238	        //   ProductClass を起点に同等条件で検索する。
  2239	        $em = $this->getEntityManager();
  2240	        $qb = $this->createQueryBuilder('pc');
  2241	        $qb->innerJoin('pc.Product', 'p')
  2242	            ->where('pc.code = :productCode')
  2243	            ->andWhere('pc.high_price_code IS NOT NULL')
  2244	            ->andWhere('pc.high_price_code <> :emptyHighPriceCode')
  2245	            ->setParameter('productCode', $productCode)
  2246	            ->setParameter('emptyHighPriceCode', '')
  2247	            ->setMaxResults(1);
  2248	
  2249	        return $qb->getQuery()->getOneOrNullResult();
  2250	    }
  2570	     * @param string $code 商品コード
  2571	     *
  2572	     * @return bool 商品コードが存在する場合 true
  2573	     */
  2574	    public function isExistedCode(string $code): bool
  2575	    {
  2576	        $qb = $this->createQueryBuilder('pc');
  2577	        $result = $qb->join('pc.Product', 'p')
  2578	            ->select('pc.id')
  2579	            ->where($qb->expr()->eq('pc.code', ':code'))
  2580	            ->setParameter('code', $code)
  2581	            ->getQuery()
  2582	            ->getResult();
  2583	
  2584	        return (bool) count($result);
  2585	    }
