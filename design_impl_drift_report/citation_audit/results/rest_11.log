 13809	                  <tr data-excel-ref="0204:棚番号更新CSV登録!AX13" data-pin-no="4" data-pin-status="matched" data-item-candidates="1" data-pin-duplicates="1"><td>(4)</td><td>0204:棚番号更新CSV登録!AX13</td><td>image 2（枠外クランプ）</td><td>matched</td><td>0204:棚番号更新CSV登録!B46</td><td></td></tr>
 13810	                  <tr data-excel-ref="0204:棚番号更新CSV登録!D20" data-pin-no="6" data-pin-status="matched" data-item-candidates="1" data-pin-duplicates="1"><td>(6)</td><td>0204:棚番号更新CSV登録!D20</td><td>image 2</td><td>matched</td><td>0204:棚番号更新CSV登録!B48</td><td></td></tr>
