   453	    private function insertPriceHistory(array $productClass, ReadCsvRowEvent $event, int $newSellPrice, int $newBuyPrice)
   454	    {
   455	        $row = $event->getRow();
   456	        $history = new DtbPriceHistory();
   457	        $oldSellPrice = $productClass['sellPrice'];
   458	        $oldBuyPrice = $productClass['buyPrice'];
   459	
   460	        if ($oldSellPrice === $newSellPrice && $oldBuyPrice === $newBuyPrice) {
   461	            // 価格に変更なし。履歴は不要
   462	            return;
   463	        }
   464	
   465	        $history->setProductClassId($productClass['productClassId'])
   466	            ->setMemberId($event->getUpdateUser()->getId());
   467	
   468	        if ($oldSellPrice !== $newSellPrice) {
   469	            $history
   470	                ->setSellPrice($newSellPrice)
   471	                ->setOldSellPrice($oldSellPrice);
   472	        }
   473	
   474	        if ($oldBuyPrice !== $newBuyPrice) {
   475	            $history
   476	                ->setBuyPrice($newBuyPrice)
   477	                ->setOldBuyPrice($oldBuyPrice);
   478	        }
   479	
   480	        /** @var DtbPriceHistoryRepository $repository */
   481	        $repository = $this->app['hareruya_ec.repository.price_history'];
   482	        $repository->addHistoryNative($history);
   483	    }
   484	}

