  1356	                    return ceil(($nmPrice * MtbBuyPriceList::ORVER_PRICE_NOMAL_MP_RATE) / 100) * 100;
  1357	                case MtbCardCondition::HP:
  1358	                    return ceil(($nmPrice * MtbBuyPriceList::ORVER_PRICE_NOMAL_HP_RATE) / 100) * 100;
  1359	            }
  1360	        }
  1361	
  1362	        $sql = <<<EOT
  1363	SELECT
  1364	    bpl.price
  1365	FROM
  1366	    mtb_buy_price_list bpl
  1367	WHERE
  1368	    bpl.nm_price = :nmPrice
  1369	    AND bpl.card_condition_id = :cardConditionId
  1370	    AND bpl.special_flg = :specialFlg
  1371	EOT;
  1372	
  1373	        $rsm = new ResultSetMapping();
  1374	        $rsm->addScalarResult('price', 'price', Type::INTEGER);
  1375	
  1376	        $query = $this->getEntityManager()->createNativeQuery($sql, $rsm)
