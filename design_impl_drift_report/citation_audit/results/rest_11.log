   210	            ->setParameter('productCode', $productCode)
   211	            ->setParameter('delFlg', Constant::DISABLED);
   212	        $result = $query->getOneOrNullResult();
   213	
   214	        // 更新対象のproductIdを記録(重複を避ける)
   215	        if (!empty($result)) {
   216	            $this->importedIds[] = $result['productId'];
