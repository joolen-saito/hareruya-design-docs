  1341	                        return $nmPrice;
  1342	                    case MtbCardCondition::SP:
  1343	                        return ceil(($nmPrice * MtbBuyPriceList::ORVER_PRICE_SPECIAL_SP_RATE) / 100) * 100;
  1344	                    case MtbCardCondition::MP:
  1345	                        return ceil(($nmPrice * MtbBuyPriceList::ORVER_PRICE_SPECIAL_MP_RATE) / 100) * 100;
