  2588	     * セール用高額商品価格変更CSV向け。CSVで上書きする列のみ更新する。
  2589	     */
  2590	    public function updateProductClassForHighPriceSaleCsv(
  2591	        int $productClassId,
  2592	        int $price02,
  2593	        ?string $beltUrl,
  2594	        bool $saleFlg,
  2595	    ): void {
  2596	        $sql = <<<'EOT'
  2597	UPDATE dtb_product_class
  2598	SET
  2599	    price02 = ?,
  2600	    belt_url = ?,
  2601	    sale_flg = ?,
  2602	    update_date = ?
  2603	WHERE id = ?
  2604	EOT;
  2605	
  2606	        $this->getEntityManager()->getConnection()->executeStatement(
  2607	            $sql,
  2608	            [
  2609	                $price02,
  2610	                $beltUrl,
  2611	                $saleFlg,
  2612	                new \DateTime(),
  2613	                $productClassId,
  2614	            ],
  2615	            [
  2616	                ParameterType::INTEGER,
  2617	                ParameterType::STRING,
  2618	                ParameterType::BOOLEAN,
  2619	                Types::DATETIMETZ_MUTABLE,
  2620	                ParameterType::INTEGER,
  2621	            ],
  2622	        );
  2623	    }
