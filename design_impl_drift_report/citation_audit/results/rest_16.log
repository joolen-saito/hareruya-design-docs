    protected function validateBeforeImport(CsvImportService $importService): array
    {
        $messageStore = new MessageStore($this->app);

        // 1行目にヘッダ行がなければエラー
        if (!$importService->setHeaderRowNumber(0)) {
            $messageStore->addHeaderFormatError();

            return $messageStore->getMessages();
        }

        // 2行目にデータが存在しない場合はエラー
        $importService->next();
        $hasData = $importService->valid();
        $importService->seek(0);
        if (!$hasData) {
            $messageStore->addNoDataError();

            return $messageStore->getMessages();
