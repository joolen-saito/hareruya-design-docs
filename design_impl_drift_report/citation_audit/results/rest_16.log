namespace Plugin\HareruyaEc\Repository;

use Doctrine\ORM\EntityRepository;
use Plugin\HareruyaEc\Entity\DtbCsvImportHistory;

/**
 * DtbCsvImportHistoryRepository
 *
 * This class was generated by the Doctrine ORM. Add your own custom
 * repository methods below.
 */
class DtbCsvImportHistoryRepository extends EntityRepository
{
    const HISTORY_PERIOD = '-1 month';

    /**
     * insert csvImportHistory
     *
     * @param Application $app
     * @param integer $csvImportType
     * @param string $fileName
     */
    public function insertCsvImportHistory($app, $csvImportType, $fileName)
    {
        $dtbCsvImportHistory = new DtbCsvImportHistory();
        $dtbCsvImportHistory
            ->setFileName($fileName)
            ->setCreateDate(new \DateTime())
            ->setMember($app->user())
            ->setCsvImportType($csvImportType)
            ;

        $app['orm.em']->persist($dtbCsvImportHistory);
        $app['orm.em']->flush();
    }

    /**
     * 直近インポートされた履歴を取得
     *
     * @param integer $csvImportType
     * @param string $fileName
     * @return array
     */
    public function getRecentCsvImportHistory($csvImportType, $fileName)
    {
        $createDate = (new \DateTime())->modify(self::HISTORY_PERIOD)->format('Y-m-d H:i:s');

        return $this->createQueryBuilder('cih')
            ->where('cih.csvImportType = :csvImportType')
            ->andWhere('cih.fileName = :fileName')
            ->andWhere('cih.createDate >= :createDate')
            ->setParameters([
                'csvImportType' => $csvImportType,
                'fileName' => $fileName,
                'createDate' => $createDate,
            ])
            ->getQuery()
            ->getResult();
    }
}
