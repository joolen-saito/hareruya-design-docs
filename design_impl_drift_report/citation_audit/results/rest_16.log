     * @return array|null 商品規格の情報。 エラーがあった場合は null
     */
    private function tryLockFindProductClass(ReadCsvRowEvent $event)
    {
        $row = $event->getRow();
        $productCode = $this->productCodeColumn->getValue($row);
        $productClass = null;
        try {
            $productClassId = $this->findProductClassIdByProductCode($productCode);

        } catch (NonUniqueResultException $e) {
            $event->getMessageStore()
                ->addProductCodeDuplicatedError($row->getRowNumber(), $productCode);

            return null;
        }

        if (empty($productClassId)) {
            // 商品が見つからなかった。
            $event->getMessageStore()
                ->addMasterNotExistsError(
                    $row->getRowNumber(),
                    sprintf(
                        '%s(%s)',
                        $this->productCodeColumn->getLabel(),
                        $this->productCodeColumn->getName()
                    ),
                    $productCode
                );

            return null;
        }

        $lockedProductStock = $this->getProductStockRepository()->tryLockAndGetByProductClassId([$productClassId]);
        if (is_null($lockedProductStock)) {
            // 更新ロックをかけるのに失敗。
            $event->getMessageStore()
                ->addProductUpdateLockTimeoutError($row->getRowNumber());

            return null;
        }

        $productClass = $this->findProductClassById($productClassId);
        if (empty($productClass)) {
            // ロックをかけた後に再検索したら、商品が見つからなかった。
            $event->getMessageStore()
                ->addMasterNotExistsError(
                    $row->getRowNumber(),
                    sprintf(
                        '%s(%s)',
                        $this->productCodeColumn->getLabel(),
                        $this->productCodeColumn->getName()
                    ),
                    $productCode
                );

            return null;

        }

        return [
                'productClass' => $productClass,
                'productStock' => $lockedProductStock,
            ];
    }

    /**
     * 商品コードから商品規格IDを取得する。
     *
     * @param string $productCode 商品コード
     * @return int|null 商品規格ID。見つからなかった場合は null
     * @throws NonUniqueResultException 2件以上のデータが見つかった場合
     */
    private function findProductClassIdByProductCode(string $productCode)
    {
        // メモリリークを防ぐため、ネイティブクエリを使用する。
        // 通常のクエリでは EntityManager に値がキャッシュされていき、メモリリークが発生する。

        $sql = <<<EOT
SELECT
    pc.product_class_id
FROM
    dtb_product_class pc
    INNER JOIN dtb_product p
        ON pc.product_id = p.product_id
    INNER JOIN dtb_product_sub ps
        ON ps.product_id = p.product_id
WHERE
    p.del_flg = :delFlg
    AND pc.del_flg = :delFlg
    AND pc.product_code = :productCode
LIMIT 2
EOT;

        $rsm = new ResultSetMapping();
        $rsm->addScalarResult('product_class_id', 'productClassId', Type::INTEGER);

        $query = $this->em->createNativeQuery($sql, $rsm)
            ->setParameter('delFlg', Constant::DISABLED)
            ->setParameter('productCode', $productCode)
            ->setHydrationMode(AbstractQuery::HYDRATE_SCALAR);

        $found = $query->getOneOrNullResult();

        return empty($found) ? null : $found['productClassId'];
    }

    /**
     * 商品規格IDから商品規格情報を取得する。
     *
     * @param int $productClassId 商品規格ID
