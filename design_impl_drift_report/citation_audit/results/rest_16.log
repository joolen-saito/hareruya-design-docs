   107	     * @param AfterReadEvent $event
   108	     */
   109	    public function onAfterImport(AfterReadEvent $event)
   110	    {
   111	        parent::onAfterImport($event);
   112	
   113	        if ($this->arrivalNotificationEnabled
   114	                && $event->isSuccessful()
   115	                && !empty($this->arrivalProductClasses)) {
   116	
   117	            // 入荷通知メールを送る
   118	            $mail = new MailService($this->app);
   119	            $mail->sendNotificationOfArrivalMail($this->arrivalProductClasses);
   120	        }
   121	
   122	        $this->arrivalProductClasses = [];
   123	
   124	        // 更新した商品在庫を支店に連携する
