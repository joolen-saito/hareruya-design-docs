    protected function createCsvImportService(UploadedFile $file, string $tempFileName)
    {
        // アップロードされたCSVファイルを一時ディレクトリに保存
        $file->move($this->app['config']['csv_temp_realdir'], $tempFileName);

        $content = file_get_contents($this->app['config']['csv_temp_realdir'] . '/' . $tempFileName);

        if ('\\' === DIRECTORY_SEPARATOR && PHP_VERSION_ID >= 70000) {
            // Windows 環境の PHP7 の場合はファイルエンコーディングを CP932 に合わせる
            // see https://github.com/EC-CUBE/ec-cube/issues/1780
            setlocale(LC_ALL, ''); // 既定のロケールに設定
            if (mb_detect_encoding($content) === 'UTF-8') { // UTF-8 を検出したら SJIS-win に変換
                $content = mb_convert_encoding($content, 'SJIS-win', 'UTF-8');
            }
        } else {
            // アップロードされたファイルがUTF-8以外は文字コード変換を行う
            $encode = Str::characterEncoding($content);
            if ($encode !== 'UTF-8') {
                $content = mb_convert_encoding($content, 'UTF-8', $encode);
            }
        }
        $content = Str::convertLineFeed($content);
        $content = $this->removeZeroWidthSpaces($content);

        $tmp = tmpfile();
        fwrite($tmp, $content);
        rewind($tmp);
        $meta = stream_get_meta_data($tmp);
        $splFile = new \SplFileObject($meta['uri']);

        $fileExtension = $file->getClientOriginalExtension();
        $delimiter = ($fileExtension === 'tsv') ? "\t" : $this->app['config']['csv_import_delimiter'];

        return new CsvImportService($splFile, $delimiter, $this->app['config']['csv_import_enclosure']);
    }

    /**
     * ゼロ幅スペース、ゼロ幅ノーブレークスペースを除外する
     *
     * @param string $str 処理する文字列
     * @return string ゼロ幅スペース等を除去した文字列
     */
    protected function removeZeroWidthSpaces($str)
    {
        return preg_replace(
            '/(?:'
            .'|(?:\xe2\x80\x8b)'
            .'|(?:\xef\xbb\xbf)'
            .')+/',
            '',
            $str
        );
    }

