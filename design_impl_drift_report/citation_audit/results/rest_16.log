    47	    /**
    48	     * CSVデータ1行の形式をチェックする。
    49	     *
    50	     * @param ReadCsvRowEvent $event イベント
    51	     */
    52	    public function onValidateRow(ReadCsvRowEvent $event) {
    53	        /** @var array $columns */
    54	        $columns = $this->columnsCache->get();
    55	        $row = $event->getRow();
    56	
    57	        // 列数が一致しない場合、エラー
    58	        if (count($row) !== count($columns)) {
    59	            $event->getMessageStore()
    60	                ->addInvalidColumnCountError($row->getRowNumber());
    61	            $event->breakAll();
    62	
    63	            return;
    64	        }
    65	
    66	        // 行内の各データが正しくない場合、エラー
    67	        $messageStore = $event->getMessageStore();
    68	
    69	        /** @var CsvColumnInterface $column */
    70	        foreach ($columns as $column) {
    71	            $name = $column->getName();
    72	            if (!$row->exists($name)) {
    73	                $messageStore->addColumnNotExistsError($row->getRowNumber(), $name);
    74	                $event->breakAll();
    75	
    76	                return;
    77	            }
    78	
    79	            if (!$column->validate($messageStore, $row)) {
    80	                $event->breakAll();
    81	
    82	                return;
    83	            }
    84	        }
    85	
    86	        // 行全体を検証する
    87	        /** @var array $rowValidators */
    88	        $rowValidators = $this->rowValidatorsCache->get();
    89	        if (!empty($rowValidators)) {
    90	            /** @var RowValidatorInterface $rowValidator */
    91	            foreach ($rowValidators as $rowValidator) {
    92	                if (!$rowValidator->validate($messageStore, $row)) {
    93	                    $event->breakAll();
    94	
    95	                    return;
    96	                }
    97	            }
    98	        }
    99	    }
