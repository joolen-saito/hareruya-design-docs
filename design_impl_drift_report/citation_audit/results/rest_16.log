   182	                    'memberId' => (int) $this->Member->getId(),
   183	                    'stockEditApprovalId' => $this->requireStockEditApprovalId(),
   184	                ]);
   185	            } catch (\Throwable $e) {
   186	                if ($s3ObjectKey !== null && str_starts_with($s3ObjectKey, self::S3_PREFIX)) {
   187	                    $fileAdapter = $this->fileManager->getAdapter();
   188	                    $contentBucketOptions = $this->fileManager->getContentBucketOptions();
   189	
   190	                    if ($fileAdapter->exists($s3ObjectKey, $contentBucketOptions)) {
   191	                        $fileAdapter->delete($s3ObjectKey, $contentBucketOptions);
   192	                    }
   193	                }
   194	
   195	                throw $e;
   196	            }
   197	        }
