     */
    private function findProductClassById(int $productClassId)
    {
        // メモリリークを防ぐため、ネイティブクエリを使用する。
        // 通常のクエリでは EntityManager に値がキャッシュされていき、メモリリークが発生する。

        $sql = <<<EOT
SELECT
    pc.product_class_id,
    pc.product_code,
    pc.stock,
    pc.price02
FROM
    dtb_product_class pc
    INNER JOIN dtb_product p
        ON pc.product_id = p.product_id
WHERE
    p.del_flg = :delFlg
    AND pc.del_flg = :delFlg
    AND pc.product_class_id = :productClassId
LIMIT 2
EOT;

        $rsm = new ResultSetMapping();
        $rsm->addScalarResult('product_class_id', 'productClassId', Type::INTEGER)
            ->addScalarResult('product_code', 'productCode')
            ->addScalarResult('stock', 'stock', Type::INTEGER)
            ->addScalarResult('price02', 'price02', Type::INTEGER);

        $query = $this->em->createNativeQuery($sql, $rsm)
            ->setParameter('delFlg', Constant::DISABLED)
            ->setParameter('productClassId', $productClassId)
            ->setHydrationMode(AbstractQuery::HYDRATE_SCALAR);

        return $query->getOneOrNullResult();
    }

