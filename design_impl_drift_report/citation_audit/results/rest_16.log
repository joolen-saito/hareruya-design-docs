   342	    /**
   343	     * 商品コードから商品規格IDを取得する。
   344	     *
   345	     * @param string $productCode 商品コード
   346	     * @return int|null 商品規格ID。見つからなかった場合は null
   347	     * @throws NonUniqueResultException 2件以上のデータが見つかった場合
   348	     */
   349	    private function findProductClassIdByProductCode(string $productCode)
   350	    {
   351	        // メモリリークを防ぐため、ネイティブクエリを使用する。
   352	        // 通常のクエリでは EntityManager に値がキャッシュされていき、メモリリークが発生する。
   353	
   354	        $sql = <<<EOT
   355	SELECT
   356	    pc.product_class_id
   357	FROM
   358	    dtb_product_class pc
   359	    INNER JOIN dtb_product p
   360	        ON pc.product_id = p.product_id
   361	    INNER JOIN dtb_product_sub ps
   362	        ON ps.product_id = p.product_id
   363	WHERE
   364	    p.del_flg = :delFlg
   365	    AND pc.del_flg = :delFlg
   366	    AND pc.product_code = :productCode
   367	LIMIT 2
   368	EOT;
   369	
   370	        $rsm = new ResultSetMapping();
   371	        $rsm->addScalarResult('product_class_id', 'productClassId', Type::INTEGER);
   372	
   373	        $query = $this->em->createNativeQuery($sql, $rsm)
   374	            ->setParameter('delFlg', Constant::DISABLED)
   375	            ->setParameter('productCode', $productCode)
   376	            ->setHydrationMode(AbstractQuery::HYDRATE_SCALAR);
   377	
   378	        $found = $query->getOneOrNullResult();
   379	
   380	        return empty($found) ? null : $found['productClassId'];
   381	    }
   382	
