    /**
     * 在庫変更CSVアップロード 画面表示
     *
     * @param Application $app
     * @param Request $request
     *
     * @return \Symfony\Component\HttpFoundation\Response
     */
    public function csvProductStock(Application $app, Request $request)
    {
        $form = $app['form.factory']->createBuilder('stock_csv_import')->getForm();

        $headers = $this->getProductStockCsvHeader();

        return $this->render($app, $form, $headers, $this->productStockTwig, [], MtbCsvImportType::PRODUCT_STOCK_IMPORT_CSV_ID);
    }

    /**
     * 在庫変更CSVアップロード
     *
     * @param Application $app
     * @param Request $request
     *
     * @return \Symfony\Component\HttpFoundation\Response
     */
    public function csvProductStockUpload(Application $app, Request $request)
    {
        // タイムアウトを無効にする
        set_time_limit(0);

        $headers = $this->getProductStockCsvHeader();

        /** @var FormInterface $form */
        $form = $app['form.factory']->createBuilder('stock_csv_import')->getForm();
        $form->handleRequest($request);

        if (!$this->isFormValid($app, $form)) {
            foreach ($form->getErrors(true) as $error) {
                $app->addError($error->getMessage(), 'admin');
            }

            return $this->render($app, $form, $headers, $this->productStockTwig, [], MtbCsvImportType::PRODUCT_STOCK_IMPORT_CSV_ID);
        }

        /** @var UploadedFile $file */
        $file = $form['import_file']->getData();

        // 直近アップロードされたファイル名と同じ場合はキャンセル
        if ($app['hareruya_ec.repository.csv_import_history']->getRecentCsvImportHistory(MtbCsvImportType::PRODUCT_STOCK_IMPORT_CSV_ID, $file->getClientOriginalName())) {
            $app->addError(sprintf($app->trans('admin.csv.error.upload.duplicate')), 'admin');

            return $this->render($app, $form, $headers, $this->productStockTwig, [], MtbCsvImportType::PRODUCT_STOCK_IMPORT_CSV_ID);
        }

        // レコード数上限チェック
        if ($this->countCsvRows($file) >= self::CSV_IMPORT_MAX) {
            $app->addError(sprintf($app->trans('admin.csv.error.upload.maxrecord'), self::CSV_IMPORT_MAX), 'admin');

            return $this->render($app, $form, $headers, $this->productStockTwig, [], MtbCsvImportType::PRODUCT_STOCK_IMPORT_CSV_ID);
        }

        log_info('在庫変更CSV登録開始');

        $formData = $form->getData();
        $importer = new CsvImporter($app, new ProductStockImportHandler($app, $formData['memo']));
        $result = $importer->import($file);

        if ($result->hasError()) {
            log_info('在庫変更CSV登録 異常終了');
        } else {
            $app->addSuccess('admin.product.csv_import.save.complete', 'admin');
            log_info('在庫変更CSV登録完了', ['count' => $result->getCount()]);
            $csvImportType = $app['hareruya_ec.repository.csv_import_type']->findOneById(MtbCsvImportType::PRODUCT_STOCK_IMPORT_CSV_ID);
            $app['hareruya_ec.repository.csv_import_history']->insertCsvImportHistory($app, $csvImportType, $file->getClientOriginalName());
        }

        return $this->render($app, $form, $headers, $this->productStockTwig, $result->getErrors(), MtbCsvImportType::PRODUCT_STOCK_IMPORT_CSV_ID);
    }

