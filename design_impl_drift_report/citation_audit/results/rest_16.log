   154	            }
   155	
   156	            $s3ObjectKey = null;
   157	
   158	            try {
   159	                $s3Path = sprintf(
   160	                    '%s%s/%s/%d',
   161	                    self::S3_PREFIX,
   162	                    $now->format('Y'),
   163	                    $now->format('m'),
   164	                    $this->requireStockEditApprovalId(),
   165	                );
   166	                $s3Filename = 'upload_'.StringUtil::random().'.csv';
   167	
   168	                $fileAdapter = $this->fileManager->getAdapter();
   169	                $contentBucketOptions = $this->fileManager->getContentBucketOptions();
   170	                $fileAdapter->upload($importFilePath, $s3Path, $s3Filename, $contentBucketOptions);
   171	
   172	                $entitySaveData = $fileAdapter->toEntitySaveData();
   173	                $s3ObjectKey = (string) ($entitySaveData['s3_object_key'] ?? '');
   174	                if ($s3ObjectKey === '') {
