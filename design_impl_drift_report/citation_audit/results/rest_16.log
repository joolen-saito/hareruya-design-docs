    39	    /**
    40	     * 在庫変更情報詳細を登録する。
    41	     * EntityManager にキャッシュされないため、バッチ処理などに適する。
    42	     *
    43	     * @param array{
    44	     *     productStockId: int,
    45	     *     editQuantity: int,
    46	     *     purchaseUnitPrice: int,
    47	     *     changeBaseInfoId: int,
    48	     *     changeStockLocationId: int,
    49	     *     stockChangeTypeDetailId: int,
    50	     *     stockChangeReason: string,
    51	     *     approvalDepartment: int,
    52	     *     approvalNotificationTargetMembers: int,
    53	     *     stockEditApprovalId: int,
    54	     *     memberId: int,
    55	     *     beforeEditQuantity?: int|null,
    56	     *     beforePurchaseUnitPrice?: string|null,
    57	     * } $stockChange 登録する情報
    58	     *
    59	     * @return ?int 在庫編集ID
    60	     */
    61	    public function insertStockChangeDetail(array $stockChange): ?int
    62	    {
    63	        $sql = <<<EOT
    64	INSERT INTO
    65	    dtb_stock_edit_approval_detail
    66	(
    67	    product_stock_id,
    68	    stock_edit_approval_id,
    69	    edit_quantity,
    70	    stock_change_reason,
    71	    purchase_unit_price,
    72	    before_edit_quantity,
    73	    before_purchase_unit_price,
    74	    outbound_total_cost,
    75	    create_date,
    76	    update_date,
    77	    member_id
    78	)
    79	VALUES
    80	(
    81	    ?,
    82	    ?,
    83	    ?,
    84	    ?,
    85	    ?,
    86	    ?,
    87	    ?,
    88	    ?,
    89	    ?,
    90	    ?,
    91	    ?
    92	)
    93	EOT;
    94	
    95	        $outboundTotalCost = $stockChange['purchaseUnitPrice'] * $stockChange['editQuantity'];
    96	        $now = new \DateTime('now', new \DateTimeZone('UTC'));
    97	
    98	        $connection = $this->getEntityManager()->getConnection();
    99	        $connection->executeStatement(
   100	            $sql,
   101	            [
   102	                $stockChange['productStockId'],
   103	                $stockChange['stockEditApprovalId'],
   104	                $stockChange['editQuantity'],
   105	                $stockChange['stockChangeReason'],
   106	                $stockChange['purchaseUnitPrice'],
   107	                $stockChange['beforeEditQuantity'] ?? null,
   108	                $stockChange['beforePurchaseUnitPrice'] ?? null,
   109	                $outboundTotalCost,
   110	                SqlUtil::timestamp($now),
   111	                SqlUtil::timestamp($now),
   112	                $stockChange['memberId'],
   113	            ]
   114	        );
   115	
   116	        return (int) $connection->lastInsertId() ?: null;
   117	    }
