    }
}
<?php

namespace Plugin\HareruyaEc\Service\Csv\Importer\Event;

use Doctrine\DBAL\Types\Type;
use Doctrine\ORM\AbstractQuery;
use Doctrine\ORM\EntityManager;
use Doctrine\ORM\NonUniqueResultException;
use Doctrine\ORM\Query\ResultSetMapping;
use Eccube\Application;
use Eccube\Common\Constant;
use Plugin\HareruyaEc\Entity\DtbStockHistory;
use Plugin\HareruyaEc\Entity\MtbStockChangeType;
use Plugin\HareruyaEc\Repository\DtbStockHistoryRepository;
use Plugin\HareruyaEc\Repository\ProductClassRepository;
use Plugin\HareruyaEc\Repository\ProductStockRepository;
use Plugin\HareruyaEc\Service\BranchUpdateService;
use Plugin\HareruyaEc\Service\Csv\Importer\Model\ColumnDefinitions;
use Plugin\HareruyaEc\Service\Csv\Importer\Model\CsvColumnInterface;
use Plugin\HareruyaEc\Service\Csv\Importer\Model\CsvRow;
use Plugin\HareruyaEc\Service\MailService;

/**
 * 在庫変更CSVをインポートするもの。
 */
class ProductStockImportHandler extends BaseCsvImportHandler
{
    /** @var Application $app */
    private $app;

    /** @var EntityManager $em */
    private $em;

    /** @var CsvColumnInterface $productCodeColumn 列： 商品コード */
    private $productCodeColumn;

    /** @var CsvColumnInterface $diffStockColumn 列： 在庫増減数 */
    private $diffStockColumn;

    /** @var CsvColumnInterface $hiddenStockAfterColumn 更新後の在庫数（CSVには含まれない） */
    private $hiddenStockAfterColumn;

    /** @var bool $arrivalNotificationEnabled 入荷通知を行う場合 true */
    private $arrivalNotificationEnabled;

    /** @var array $arrivalProductClasses 入荷があった商品の productClassId */
    private $arrivalProductClasses;

    /** @var array $productStocks 更新した商品のproductClassIdとstock */
    private $productStocks;

    /** @var BranchUpdateService 支店更新サービス：本店在庫更新通知用 */
    private $branchUpdateService;

    /** @var memo 変更理由 */
    private $memo;

    /**
     * @param Application $app
     * @param string $memo
     */
    public function __construct(Application $app, $memo)
    {
        $this->memo = $memo;
        $this->app = $app;
        $this->em = $app['orm.em'];
        $this->arrivalProductClasses = [];
        $this->arrivalNotificationEnabled = true;
        $this->productStocks = [];

        $this->productCodeColumn = ColumnDefinitions::productCode()->setRequired(true);
        $this->diffStockColumn = ColumnDefinitions::diffStock()->setRequired(true);

        // 更新後の在庫数の値をチェックするもの
        $this->hiddenStockAfterColumn = ColumnDefinitions::stock()
            ->setName($this->diffStockColumn->getName())
            ->setLabel('更新後の在庫');

        $this->branchUpdateService = new BranchUpdateService($app);
    }

    /**
     * @param bool $arrivalNotificationEnabled 入荷通知を有効にする場合 true
     * @return self
     */
    public function setArrivalNotificationEnabled(bool $arrivalNotificationEnabled)
    {
        $this->arrivalNotificationEnabled = $arrivalNotificationEnabled;

        return $this;
    }

    /**
     * CSVの読み込み前に状態をリセットする。
     */
    public function onBeforeImport()
    {
        parent::onBeforeImport();

        $this->arrivalProductClasses = [];
        $this->productStocks = [];
    }

    /**
     * CSVデータの読み込み完了後に入荷通知を送る。
     *
     * @param AfterReadEvent $event
     */
    public function onAfterImport(AfterReadEvent $event)
    {
        parent::onAfterImport($event);

        if ($this->arrivalNotificationEnabled
                && $event->isSuccessful()
                && !empty($this->arrivalProductClasses)) {

            // 入荷通知メールを送る
            $mail = new MailService($this->app);
            $mail->sendNotificationOfArrivalMail($this->arrivalProductClasses);
        }

        $this->arrivalProductClasses = [];

        // 更新した商品在庫を支店に連携する
        $this->branchUpdateService->noticeStockUpdate($this->productStocks);

        $this->productStocks = [];
    }

    /**
     * @param ReadCsvRowEvent $event
     * @return bool 読み込みに成功した場合 true
     */
    public function onReadRow(ReadCsvRowEvent $event)
    {
        $row = $event->getRow();
        $diffStock = $this->diffStockColumn->getValue($row);

        // 在庫増減数が 0 の場合は更新不要。スキップする。
        if ($diffStock === 0) {
            return true;
        }

        // ProductStock に更新ロックをかけたうえで、商品規格情報を取得する。
        $productData = $this->tryLockFindProductClass($event);
        if (is_null($productData)) {
            $event->breakAll();

            return false;
        }

        $productClass = $productData['productClass'];
        // 商品コードが見つからない場合、エラー（admin.csv.error.product.not_exists）
        if (empty($productClass)) {
            $event->getMessageStore()
                ->addMasterNotExistsError(
                    $row->getRowNumber(),
                    $this->productCodeColumn->getLabel(),
                    $this->productCodeColumn->getValue($row)
                );
            $event->breakAll();

            return false;
        }

        $productStock = $productData['productStock'];
        if (is_null($productStock)) {
            $event->breakAll();

            return false;
        }

        $stockBefore = $productStock['stock'];

        // 更新後の在庫個数が0未満になる場合はエラーと扱う
        $stockAfter = $stockBefore + $diffStock;
        if ($stockAfter < 0) {
            $event->getMessageStore()
                ->addOutOfStockError(
                    $row->getRowNumber(),
                    $this->productCodeColumn->getLabel(),
                    $this->productCodeColumn->getValue($row)
                );
            $event->breakAll();

            return false;
        }

        // 更新後の在庫が上限を超える場合、エラーとなる
        if (!$this->validateStockAfter($event, $stockAfter)) {
            $event->breakAll();

            return false;
        }

        // 在庫数を更新する
        $productClassId = $productClass['productClassId'];
        $this->app['hareruya_ec.repository.product_sub_class']->stockUpProduct($productClassId, $diffStock);
        $this->updateProductStock($productClassId, $stockAfter);
        $this->updateProductClass($productClassId, $stockAfter);

        // 在庫履歴を追加する
        $history = new DtbStockHistory();
        $history->setStockChangeTypeId(MtbStockChangeType::MASTER_UPDATE);
        $history->setProductClassId($productClassId);
        $history->setStock($stockAfter);
        $history->setOldStock($stockBefore);
        $history->setSellPrice($productClass['price02']);
        $history->setMemo($this->memo);
        $history->setMemberId($event->getUpdateUser()->getId());
        $this->addStockHistory($history);

        if ($stockBefore === '0' && $stockAfter > 0) {
            // 「在庫なし」から「在庫あり」に変化したので入荷通知の対象にする
            $this->arrivalProductClasses[] = $productClassId;
        }

        // 支店に本店在庫の更新を通知
        $this->productStocks[$productClassId] = isset($this->productStocks[$productClassId])
