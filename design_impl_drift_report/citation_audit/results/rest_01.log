    16	namespace Eccube\Service;
    17	
    18	use Eccube\Entity\Customer;
    19	use Eccube\Entity\Master\MtbOption;
    20	use Eccube\Entity\ProductClass;
    21	use Eccube\Repository\Master\MtbOptionRepository;
    22	use Eccube\Repository\OrderItemRepository;
    23	use Eccube\Repository\ProductRepository;
    24	
    25	class RecommendService
    26	{
    27	    public function __construct(
    28	        private readonly OrderItemRepository $orderItemRepository,
    29	        private readonly ProductRepository $productRepository,
    30	        private readonly MtbOptionRepository $mtbOptionRepository,
    31	    ) {
    32	    }
    33	
    34	    /**
    35	     * 指定商品に基づくおすすめ商品の ProductClass 一覧を返す（最大10件）。
    36	     *
    37	     * @return list<ProductClass>
    38	     */
    39	    public function getRecommendProductClasses(
    40	        int $baseProductId,
    41	        string $locale,
    42	        int $shopId,
    43	        ?Customer $Customer = null,
    44	    ): array {
    45	        $Option = $this->mtbOptionRepository->findOneBy(['option_key' => MtbOption::RECOMMEND_SEARCH_DAYS]);
    46	        $searchDays = $Option !== null
    47	            ? (int) $Option->getOptionValue()
    48	            : MtbOption::RECOMMEND_SEARCH_DAYS_DEFAULT;
    49	
    50	        $customerId = $Customer !== null ? (int) $Customer->getId() : 0;
    51	
    52	        $productIds = $this->orderItemRepository->findRecommendProductIds($baseProductId, $searchDays, $customerId);
    53	
    54	        if ($productIds === []) {
    55	            return [];
    56	        }
    57	
    58	        return $this->productRepository->findPublicByIds($productIds, $locale, $shopId);
    59	    }
    60	}
