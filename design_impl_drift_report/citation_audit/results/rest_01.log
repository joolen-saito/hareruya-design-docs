from html.parser import HTMLParser
from pathlib import Path
import re
pat=re.compile(r'アイテムを探す|カテゴリ押下|カードセット|Trending Now|あなたのお気に入り|在庫が|カートに入れる|商品数|編集可能|設定しているURL|承っており|承ってい|日英切替|英語版サイトでは|日本語版サイトでは|デッキTOP|FAQ画面|選手一覧|short_name|短縮店舗名|右カラム|初心者講習会|閲覧店舗を選択|ご指定の条件に一致|該当なし|フォーマットの表示|短縮URL|front_search_hide_flg|非表示親|最新注文商品|最高額商品|種別.{0,10}mypage|おすすめブロック|商品リコメンド')
void={'area','base','br','col','embed','hr','img','input','link','meta','param','source','track','wbr'}
class P(HTMLParser):
 def __init__(self):
  super().__init__(convert_charrefs=True); self.stack=[]; self.sheet=None; self.caps=[]
 def handle_starttag(self,t,a):
  d=dict(a); pos=self.getpos()[0]
  if t=='section' and d.get('id','').startswith('sheet-') and not d.get('id','').endswith('-shapes'):
   self.sheet=d['id']
  if self.sheet and 'data-excel-ref' in d and t not in void:
   self.caps.append({'tag':t,'depth':len(self.stack),'line':pos,'ref':d['data-excel-ref'],'text':[],'sheet':self.sheet})
  if t not in void: self.stack.append(t)
 def handle_startendtag(self,t,a): pass
 def handle_data(self,data):
  for c in self.caps: c['text'].append(data)
 def handle_endtag(self,t):
  depth=len(self.stack)-1
  for c in list(self.caps):
   if c['tag']==t and c['depth']==depth:
    s=' '.join(''.join(c['text']).split())
    if len(s)<1500 and pat.search(s): print(f\"{c['sheet']}\\tL{c['line']}\\t{c['ref']}\\t{s}\")
    self.caps.remove(c)
  if self.stack:
   # recover malformed html by pop to tag
   if t in self.stack:
    while self.stack:
     x=self.stack.pop()
     if x==t: break
  if t=='section': self.sheet=None
files=['0301_基本設計仕様書(フロント_トップ).html','0302_基本設計仕様書(フロント_グローバルナビ).html','0303_基本設計仕様書(フロント_商品).html']
for f in files:
 print('FILE',f)
 p=P()
 with open('hareruya-design-docs/excel_to_html/output/'+f,errors='replace') as h:
  while c:=h.read(1024*1024): p.feed(c)
