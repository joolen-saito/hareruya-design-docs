    44	    public function index(Request $request): array|Response
    45	    {
    46	        if (!$this->blockTemplateExistCheckService->checkFileExist($request)) {
    47	            return $this->render('Block/null.twig');
    48	        }
    49	
    50	        $productId = $request->query->getInt('product_id', 0);
    51	
    52	        /** @var Customer|null $Customer */
    53	        $Customer = $this->getUser() instanceof Customer ? $this->getUser() : null;
    54	
    55	        if ($productId === 0 && $Customer !== null) {
    56	            $LatestItem = $this->orderItemRepository->findLatestExpensiveItem($Customer);
    57	            if ($LatestItem !== null && $LatestItem->getProduct() !== null) {
    58	                $productId = (int) $LatestItem->getProduct()->getId();
    59	            }
    60	        }
