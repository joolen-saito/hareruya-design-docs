from html.parser import HTMLParser
import re
f='hareruya-design-docs/excel_to_html/output/0301_基本設計仕様書(フロント_トップ).html'
pat=re.compile(r'以下1~6|会員のお気に入り|お気に入り登録|登録日時|登録日の降順|最大30件|1件もなければ')
class P(HTMLParser):
 def __init__(self): super().__init__(convert_charrefs=True); self.cap=None
 def handle_starttag(self,t,a):
  d=dict(a)
  if t=='span' and 'src-cell' in d.get('class','') and d.get('data-excel-sheet')=='ECTOP': self.cap=[self.getpos()[0],d.get('data-excel-ref'),[]]
 def handle_data(self,d):
  if self.cap:self.cap[2].append(d)
 def handle_endtag(self,t):
  if t=='span' and self.cap:
   s=' '.join(''.join(self.cap[2]).split())
   if pat.search(s):print(*self.cap[:2],s)
   self.cap=None
p=P()
with open(f,errors='replace') as h:
 while c:=h.read(1024*1024):p.feed(c)
PY
