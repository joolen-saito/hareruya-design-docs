from html.parser import HTMLParser
from pathlib import Path
files={
'0301_基本設計仕様書(フロント_トップ).html': {'sheet-3','sheet-4'},
'0302_基本設計仕様書(フロント_グローバルナビ).html': {'sheet-3','sheet-4','sheet-6'},
'0303_基本設計仕様書(フロント_商品).html': {'sheet-3','sheet-4','sheet-5','sheet-7'},
}
class P(HTMLParser):
 def __init__(self, targets):
  super().__init__(convert_charrefs=True); self.targets=targets; self.sheet=None; self.depth=0; self.caps=[]
 def handle_starttag(self,tag,attrs):
  d=dict(attrs)
  if tag=='section' and d.get('id') in self.targets:
   self.sheet=d['id']; self.depth=1
  elif self.sheet: self.depth+=1
  if self.sheet and 'data-excel-ref' in d:
   self.caps.append([tag,self.depth,self.getpos()[0],d['data-excel-ref'],[]])
 def handle_data(self,data):
  for c in self.caps: c[4].append(data)
 def handle_endtag(self,tag):
  if self.sheet:
   for c in list(self.caps):
    if c[0]==tag and c[1]==self.depth:
     t=' '.join(''.join(c[4]).split())
     if t: print(f'{self.sheet}\\tL{c[2]}\\t{c[3]}\\t{t}')
     self.caps.remove(c)
   self.depth-=1
   if self.depth==0: self.sheet=None
root=Path('hareruya-design-docs/excel_to_html/output')
for fn,targets in files.items():
 print('FILE',fn)
 p=P(targets)
 with (root/fn).open(errors='replace') as fh:
  while ch:=fh.read(1024*1024): p.feed(ch)
