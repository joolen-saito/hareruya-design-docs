    78	                        {{ form_errors(f) }}
    79	                        </div>
    80	                    {% endif %}
    81	                {% endfor %}
    82	            </div>
    83	            <div id="search_box_main__clear" class="col-xs-12 col-sm-12">
    84	              <p class="text-center"><a href="#" class="search-clear">検索条件をクリア</a></p>
    85	            </div>
    86	          </div>
    87	        </div>
    88	      </div>
    89	    </div>
    90	    <!-- /.col -->
    91	  </div>
    92	  <div id="search_box_footer" class="row btn_area">
