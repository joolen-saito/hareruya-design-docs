    49	        $multi = $searchData['multi'];
    50	        if (isset($multi) && Str::isNotBlank($multi)) {
    51	            //スペース除去
    52	            $multi = trim(mb_convert_kana($multi, "s", 'UTF-8'));
    53	            // 半角スペース、全角スペース、カンマで分割
    54	            $texts = mb_split('/[\s,　]+/', $multi);
    55	            $queries = [];
    56	            $searchColums = ['nameJp', 'nameEn', 'shortNameJp', 'shortNameEn'];
    57	
    58	            // 分割した文字列ごとに条件設定
    59	            foreach ($texts as $num => $text) {
    60	                if (empty($text)) {
    61	                    continue;
    62	                }
    63	                $cond = "%{$text}%";
    64	                // 名称、略称の英語、日本語
    65	                foreach ($searchColums as $column) {
    66	                    $queries[] = "e.{$column} like :{$column}{$num}";
    67	                    $qb->setParameter("{$column}{$num}", $cond);
    68	                }
    69	            }
    70	            $qb->andWhere("(". implode(" or ", $queries) . ")");
    71	        }
    72	        // 開催日From
    73	        $dateFrom = $searchData['start_date_from'];
    74	        if (!empty($dateFrom)) {
    75	            $dateFrom = $dateFrom->format('Y-m-d H:i:s');
    76	            $qb->andWhere('ed.startDate >= :start_date_from')
    77	                ->setParameter('start_date_from', $dateFrom);
    78	        }
    79	        // 開催日To
    80	        $dateTo = $searchData['start_date_to'];
    81	        if (!empty($dateTo)) {
    82	            $dateTo = $dateTo->modify('+1 days')->format('Y-m-d H:i:s');
    83	            $qb->andWhere('ed.startDate < :start_date_to')
    84	                ->setParameter('start_date_to', $dateTo);
    85	        }
    86	
    87	        // フォーマット
    88	        $format = $searchData['formats'];
    89	        if (!empty($format)) {
    90	            $qb->andWhere('ef.formatId = :format')
    91	                ->setParameter('format', $format);
    92	        }
    93	
    94	        // ルール適用度
