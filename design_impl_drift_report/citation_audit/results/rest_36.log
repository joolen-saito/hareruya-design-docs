   198	            return $app->abort(404);
   199	        }
   200	
   201	        // イベント詳細
   202	        $eventDetailIds = explode(',', $request->get('deleteDetailId'));
   203	        if (!$id || empty($eventDetails = $app['hareruya_ec.repository.event_detail']->findBy(['eventId' => $id, 'eventDetailId' => $eventDetailIds]))) {
   204	            return $app->abort(404);
