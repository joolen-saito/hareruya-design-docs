    99	  </div>
   100	</div>
   101	<!--検索条件設定テーブルここまで-->
   102	{% if pagination %}
   103	<div id="result_list" class="row">
   104	  <div class="col-md-12">
   105	    <div id="result_list_main" class="box">
   106	      {% if pagination and pagination.totalItemCount > 0 %}
   107	      <div id="result_list_main__header" class="box-header with-arrow">
   108	        <h3 class="box-title">検索結果 <span class="normal"><strong>{{ pagination.totalItemCount }} 件</strong> が該当しました</span></h3>
   109	      </div><!-- /.box-header -->
   110	      <div id="result_list_main__body" class="box-body">
   111	        <div id="result_list_main__menu" class="row">
   112	          <div class="col-md-12">
   113	            <ul class="sort-dd">
   114	              <li id="result_list_main__pagemax_menu" class="dropdown">
   115	                {% for pageMax in pageMaxis if pageMax.name == page_count %}
   116	                  <a class="dropdown-toggle" data-toggle="dropdown">{{ pageMax.name|e }}件<svg class="cb cb-angle-down icon_down"><use xlink:href="#cb-angle-down"></svg></a>
   117	                  <ul class="dropdown-menu">
   118	                {% endfor %}
   119	                  {% for pageMax in pageMaxis if pageMax.name != page_count %}
   120	                    <li><a href="{{ path('admin_event_page', {'page_no': 1, 'page_count': pageMax.name}) }}">{{ pageMax.name|e }}件</a></li>
   121	                  {% endfor %}
   122	                  </ul>
   123	              </li>
   124	              <li id="result_list_main__sort_menu" class="dropdown">
   125	                <a class="dropdown-toggle" data-toggle="dropdown">
   126	                  {{ trans('admin.btn.sort') }}：{{ trans('admin.btn.event.' ~ sort_key) }} | {{ trans('admin.btn.' ~ order_key) }}
   127	                  <svg class="cb cb-angle-down icon_down"><use xlink:href="#cb-angle-down"></svg>
   128	                </a>
   129	                <ul class="dropdown-menu">
   130	                {% for sortKey in sortKeys %}
   131	                  <li id="toggle-{{ sortKey }}" class="toggle-sort-key" data-name="{{ sortKey }}">
   132	                    <a data-toggle="dropdown">{{ trans('admin.btn.event.' ~ sortKey) }}</a>
   133	                  </li>
   134	                    <ul class="dropdown-menu dropdown-menu-sort sub" id="dropdown-menu-{{ sortKey }}">
   135	                      <li><a href="{{ url('admin_event_page', {'page_no': 1, 'sort': sortKey, 'order': 'ASC'}) }}">{{ trans('admin.btn.ASC') }}</a></li>
   136	                      <li><a href="{{ url('admin_event_page', {'page_no': 1, 'sort': sortKey, 'order': 'DESC'}) }}">{{ trans('admin.btn.DESC') }}</a></li>
   137	                    </ul>
   138	                {% endfor %}
   139	                </ul>
   140	              </li>
   141	            </ul>
   142	          </div>
   143	        </div>
   144	        {% for Event in pagination %}
   145	            <div id="result_list_main__list" class="table_list">
   146	                <div class="table-responsive with-border">
   147	                    <table class="table table-striped">
   148	                        <thead>
   149	                        <tr id="result_list_main__header">
   150	                            <th id="result_list_main__header_id">イベントID</th>
   151	                            <th id="result_list_main__header_name">イベント名</th>
   152	                            <th id="result_list_main__header_menu_box">&nbsp;</th>
   153	                        </tr>
   154	                        </thead>
   155	                        <tbody>
   156	                        {% for Event in pagination %}
   157	                        <tr id="result_list_main__item--{{ Event.event_id }}">
   158	                            <td id="result_list_main__id--{{ Event.event_id }}" class="member_id">{{ Event.event_id }}</td>
   159	                            <td id="result_list_main__name--{{ Event.event_id }}" class="member_name"><a href="{{ url('admin_event_edit', { 'id': Event.event_id}) }}">{{ Event.name_jp }}&nbsp;{{ Event.name_en }}</a></td>
   160	                            <td id="result_list_main__menu_box--{{ Event.event_id }}" class="icon_edit">
   161	                                <div id="result_list_main__menu_box_toggle--{{ Event.event_id }}" class="dropdown">
   162	                                    <a class="dropdown-toggle" data-toggle="dropdown"><svg class="cb cb-ellipsis-h"> <use xlink:href="#cb-ellipsis-h" /></svg></a>
   163	                                    <ul id="result_list_main__menu--{{ Event.event_id }}" class="dropdown-menu dropdown-menu-right">
   164	                                        <li><a href="{{ url('admin_event_edit', { 'id': Event.event_id}) }}">編集</a></li>
   165	                                        <li><a href="{{ url('admin_event_delete', { 'id': Event.event_id}) }}" {{ csrf_token_for_anchor() }} data-method="delete" data-message="このイベント情報を削除してもよろしいですか？">削除</a></li>
   166	                                    </ul>
   167	                                </div>
   168	                            </td>
   169	                        </tr>
   170	                        {% endfor %}
   171	                        </tbody>
   172	                    </table>
   173	                </div>
   174	            </div>
   175	        {% endfor %}
   176	      </div><!-- /.box-body -->
   177	      {% if pagination.totalItemCount > 0 %}
   178	      {% include "pager.twig" with { 'pages' : pagination.paginationData, 'routes' : 'admin_event_page' } %}
