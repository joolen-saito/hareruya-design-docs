   157	    public function delete(Application $app, Request $request, $id = null)
   158	    {
   159	        // イベント取得
   160	        $event = $app['hareruya_ec.repository.event']->find($id);
   161	        if (empty($event)) {
   162	            return $app->abort(403);
   163	        }
   164	
   165	        // csrfトークンチェック、存在チェック
   166	        $this->checkCsrfValid($app);
   167	
   168	        // 子の存在チェック、生きている場合は親を削除不可
   169	        if ($event->getDetails()->count() > 0) {
   170	            $app->addError('admin.event.delete.failed', 'admin');
   171	
   172	            return $app->redirect($request->headers->get('referer'));
   173	        }
   174	
   175	        // dtb_event削除
   176	        $app['orm.em']->remove($event);
   177	        $app['orm.em']->flush();
   178	        // 完了メッセージ表示
   179	        $app->addSuccess('admin.event.delete.complete', 'admin');
   180	
   181	        $pageNo = $request->getSession()->get("admin.{$this->sessionKey}.search.page_no");
   182	        return !empty($pageNo) ? $app->redirect($app->url('admin_event_search', ['page_no' => $pageNo ])) : $app->redirect($app->url('admin_event_search', ['page_no' => 1]));
   183	    }
