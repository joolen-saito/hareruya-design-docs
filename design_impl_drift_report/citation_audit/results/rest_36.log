   349	     * イベント削除（日程情報がある場合は削除不可）
   350	     */
   351	    #[Route(path: '/%eccube_admin_route%/event/{id}/delete', name: 'admin_event_delete', requirements: ['id' => '\d+'], methods: ['DELETE'])]
   352	    public function delete(Request $request, #[MapEntity(id: 'id')] DtbEvent $Event): RedirectResponse
   353	    {
   354	        $isEditableShop = $this->getMember()->isEditableShop($Event->getBaseInfo());
   355	        if (!$isEditableShop) {
   356	            $this->addError('admin.common.error_invalid_request', 'admin');
   357	
   358	            return $this->redirectToRoute('admin_event_edit', ['id' => $Event->getId()]);
   359	        }
   360	
   361	        if ($Event->getDetails()->count() > 0) {
   362	            $this->addError('admin.event.delete.schedule_exists', 'admin');
   363	
   364	            return $this->redirectToRoute('admin_event_edit', ['id' => $Event->getId()]);
   365	        }
   366	
   367	        $this->entityManager->remove($Event);
   368	        $this->entityManager->flush();
   369	
   370	        $event = new EventArgs(
   371	            [
   372	                'Event' => $Event,
   373	            ],
   374	            $request
   375	        );
   376	        $this->eventDispatcher->dispatch($event, EccubeEvents::ADMIN_EVENT_DELETE_COMPLETE);
   377	
   378	        $this->addSuccess('admin.common.delete_complete', 'admin');
   379	
   380	        $pageNo = (int) $this->session->get(self::SESSION_PAGE_NO_KEY, 1);
   381	
   382	        return $this->redirect(
   383	            $this->generateUrl('admin_event_index_page', ['page_no' => max(1, $pageNo)]).'?resume=1'
   384	        );
   385	    }
