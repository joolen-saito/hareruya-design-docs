    39	        <a id="search_box_main__toggle" href="#" class="toggle">
    40	          <svg class="cb cb-minus"> <use xlink:href="#cb-minus"/></svg>
    41	          <svg class="cb cb-minus"> <use xlink:href="#cb-minus"/></svg>
    42	        </a>
    43	        <div id="search_box_main__body" class="search-box-inner accpanel">
    44	          <div class="row">
    45	            <div id="search_box_main__body_inner" class="col-sm-12 col-lg-10 col-lg-offset-1 search">
    46	              <div class="col-xs-12 col-md-6">
