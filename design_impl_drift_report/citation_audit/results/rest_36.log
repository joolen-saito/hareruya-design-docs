    77	    /**
    78	     * データ検索メイン処理
    79	     *
    80	     * @param $app Application
    81	     * @param $request Request
    82	     * @param $page_no integer
    83	     * @return \Symfony\Component\HttpFoundation\Response
    84	     */
    85	    public function search(Application $app, Request $request, $page_no = 1)
    86	    {
    87	        // セッション取得
    88	        $session = $request->getSession();
    89	        $sessionkey = $this->sessionKey;
    90	        // セッションキー：ページ内表示件数
    91	        $pageCountKey = "admin.{$sessionkey}.search.page_count";
    92	        // セッションキー：ページ表示番号
    93	        $pageNoKey = "admin.{$sessionkey}.search.page_no";
    94	        // セッションキー：検索条件
    95	        $viewKey = "admin.{$sessionkey}.search";
    96	        // セッションキー：ソートカラム
    97	        $sortKey = "admin.{$sessionkey}.sort";
    98	        // セッションキー：降順/昇順
    99	        $orderKey = "admin.{$sessionkey}.order";
   100	
   101	        // ソート用のレポジトリをセット
   102	        $this->setRepository($app);
   103	
   104	        $pagination = [];
   105	        // フォーム取得
   106	        $builder = $app['form.factory']->createBuilder($this->formName, null, $this->formCreateOption);
   107	        $searchForm = $builder->getForm();
   108	        if ($searchForm->isValid()) {
   109	            return $app->render($this->twigName, [
   110	                'searchForm' => $searchForm->createView(),
   111	                'pagination' => [],
   112	                'pageMaxis' => [],
   113	                'page_no' => 1,
   114	                'page_count' => $app['config']['default_page_count'],
   115	            ]);
   116	        }
   117	
   118	        $searchForm->handleRequest($request);
   119	        // ソートキー、並び順
   120	        switch (true) {
   121	            case !empty($request->get('sort')):
   122	                $sort = $request->get('sort');
   123	                break;
   124	            case !is_null($session->get($sortKey)):
   125	                $sort = $session->get($sortKey);
   126	                break;
   127	            default:
   128	                $sort = $this->defaultSort;
   129	        }
   130	        switch (true) {
   131	            case !empty($request->get('order')):
   132	                $order = $request->get('order');
   133	                break;
   134	            case !is_null($session->get($orderKey)):
   135	                $order = $session->get($orderKey);
   136	                break;
   137	            default:
   138	                $order = $this->defaultOrder;
   139	        }
   140	        if (!preg_match('/^(ASC|DESC|asc|desc)$/', $order)) {
   141	            $app->addError('admin.error.sort', 'admin');
   142	            return $this->index($app, $request);
   143	        }
   144	
   145	        // ページマスター取得
   146	        $pageMaxis = $app['eccube.repository.master.page_max']->findAll();
   147	
   148	        $maxArr = [];
   149	        foreach ($pageMaxis as $pageMax) {
   150	            $maxArr[] = $pageMax->getName();
   151	        }
   152	        // 表示件数取得する、1.SESSION 2.設定ファイル
   153	        $pageCount = $session->get($pageCountKey, $app['config']['default_page_count']);
   154	        $pageCountParam = $request->get('page_count');
   155	        // 表示件数入力値がマスターに設定されている場合SESSIONに保存する
   156	        if ($pageCountParam && in_array($pageCountParam, $maxArr)) {
   157	            $pageCount = $pageCountParam;
   158	            $session->set($pageCountKey, $pageCount);
   159	        }
   160	
   161	        // 検索条件
   162	        $redirect = $request->get('redirect');
   163	        $searchData = $searchForm->getData();
   164	        $viewData = FormUtil::getViewData($searchForm);
   165	        if (is_null($searchData)) {
   166	            $viewData = $session->get($viewKey);
   167	            // sessionに保持されている検索条件を復元.
   168	            $searchData = FormUtil::submitAndGetData($searchForm, $viewData);
   169	            $this->setViewData($request, $viewData, $searchData);
   170	            if (is_null($viewData) && is_null($searchData)) {
   171	                return $this->index($app, $request);
   172	            }
   173	        }
   174	
   175	        $searchData['sort'] = $sort;
   176	        $searchData['order'] = $order;
   177	        $searchRequest = ['searchData' => $searchData];
   178	
   179	        $qb = $this->getQueryBuilder($app, $searchRequest);
   180	        if (!$qb instanceof QueryBuilder && !is_array($qb)) {
   181	            return $app->abort(404);
   182	        }
   183	
   184	        $resultCount = $this->getSearchCount($app, $searchRequest);
   185	
   186	        // 最終ページのデータ削除時に表示するデータがなくなった場合、１つ前のページを表示する
   187	        if ($page_no > 1 && $resultCount === (($page_no - 1) * $pageCount)) {
   188	            $page_no = $page_no - 1;
   189	        }
   190	
   191	        // Sessionに設定
   192	        $session->set($pageNoKey, $page_no);
   193	        $session->set($viewKey, $viewData);
   194	        $session->set($sortKey, $sort);
   195	        $session->set($orderKey, $order);
   196	        $session->set($pageCountKey, $pageCount);
   197	
   198	        // 検索結果
   199	        $pagination = $app['paginator']()->paginate($qb, $page_no, $pageCount, []);
   200	
   201	        // 検索結果表示
   202	        $renderArr = [
   203	            'searchForm' => $searchForm->createView(),
   204	            'pagination' => $pagination,
   205	            'pageMaxis' => $pageMaxis,
   206	            'page_no' => $page_no,
   207	            'page_count' => $pageCount,
   208	            'sort_key' => $sort,
   209	            'order_key' => $order,
   210	        ];
   211	        $this->addRenderItem($app, $request, $renderArr);
   212	
   213	        return $app->render($this->twigName, $renderArr);
   214	    }
