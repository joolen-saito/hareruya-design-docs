    32	     * コンストラクタ
    33	     */
    34	    public function __construct()
    35	    {
    36	        /** 追加検索欄初期表示 */
    37	        $this->active = false;
    38	        /** 検索一覧Twig */
    39	        $this->twigName = 'HareruyaEc/Resource/template/admin/Event/eventlist.twig';
    40	        /** セッションキー。表示件数、検索条件、ソート条件の保持に使用 */
    41	        $this->sessionKey = 'event';
    42	        /** フォーム名 */
    43	        $this->formName = 'admin_event_list';
    44	        /** ソート参照用レポジトリ */
    45	        $this->repository;
    46	    }
    47	
    48	    /**
    49	     * イベント詳細表示
    50	     * @param Application $app
    51	     * @param Request $request
    52	     * @param mixed $id integer or null
    53	     * @param integer or null $duplicateId
    54	     * @return \Symfony\Component\HttpFoundation\Response
    55	     *
    56	     */
    57	    public function edit(Application $app, Request $request, $id = null, $duplicateId = null)
    58	    {
    59	        $findEventId = $duplicateId ?? $id;
    60	        if (!$event = $findEventId ? $app['hareruya_ec.repository.event']->find($findEventId) : new DtbEvent()) {
    61	            return $app->abort(404);
    62	        }
    63	
    64	        $entryArr = [];
    65	        if ($id) {
    66	            $details = $app['hareruya_ec.repository.event_detail']->findBy(['eventId' => $id], ['startDate' => 'DESC']);
    67	            $event->setDetails($details);
    68	            // エントリー数
    69	            $entryArr = $this->getEntry($app, $event);
    70	        } elseif (is_null($findEventId)) {
    71	            // 支払方法初期設定
    72	            $payments = $app['eccube.repository.payment']->findBy(['id' => Payment::EC_CREDIT]);
    73	            $event->setPayments($payments);
    74	        }
    75	        // イベント登録フォーム
    76	        $form = $app['form.factory']->createBuilder('admin_event_detail', $event)->getForm();
    77	
    78	        // 詳細画面表示
    79	        return $app->render('HareruyaEc/Resource/template/admin/Event/eventdetail.twig', [
    80	            'form' => $form->createView(),
    81	            'event' => $event,
    82	            'entry' => $entryArr,
    83	            'id' => $id,
    84	        ]);
    85	    }
    86	
    87	    /**
    88	     * イベント登録、更新
    89	     * @param Application $app
    90	     * @param Request $request
    91	     * @param mixed $id integer or null
    92	     * @return \Symfony\Component\HttpFoundation\Response
    93	     */
    94	    public function create(Application $app, Request $request, $id = null)
    95	    {
    96	        $this->app = $app;
    97	        // IDあり：更新
    98	        if (!is_null($id)) {
    99	            // イベント取得
   100	            $event = $app['hareruya_ec.repository.event']->find($id);
   101	            // すでに削除されいる場合エラー
   102	            if (empty($event)) {
   103	                return $app->abort(403);
   104	            }
   105	            $entryArr = $this->getEntry($app, $event);
   106	        // IDなし：新規登録
   107	        } else {
   108	            // イベント取得
   109	            $event = new DtbEvent();
   110	            $entryArr = [];
   111	        }
   112	
   113	        $form = $app['form.factory']->createBuilder('admin_event_detail', $event)->getForm()->handleRequest($request);
   114	
   115	        // 申込有の場合支払いは変更不可
   116	        if (!is_null($id) && !empty(array_diff($form['payments']->getData()->toArray(), $event->getPayments()->toArray()))) {
   117	            foreach ($event->getDetails() as $detail) {
   118	                if ($detail->getEventEntries()->count() > 0) {
   119	                    $app->addError('admin.event.save.paymenterror', 'admin');
   120	
   121	                    return $app->redirect($request->headers->get('referer'));
   122	                }
   123	            }
   124	        }
   125	
   126	        // Validate
   127	        if (!$this->isFormValid($app, $form)) {
   128	            $app->addError('admin.event.save.failed', 'admin');
   129	            // 詳細画面表示
   130	            return $app->render('HareruyaEc/Resource/template/admin/Event/eventdetail.twig', [
   131	                'form' => $form->createView(),
   132	                'event' => $event,
   133	                'entry' => $entryArr
   134	            ]);
   135	        }
   136	
   137	        // 登録者(ログインユーザのID)
   138	        $event->setMemberId($app['security']->getToken()->getUser()->getId());
   139	
   140	        // dtb_event登録
   141	        $app['orm.em']->persist($event);
   142	        $app['orm.em']->flush();
   143	
   144	        // 完了メッセージ表示
   145	        $app->addSuccess('admin.event.save.complete', 'admin');
   146	
   147	        return $app->redirect($app->url('admin_event_edit', array('id'=> $event->getEventId())));
   148	    }
