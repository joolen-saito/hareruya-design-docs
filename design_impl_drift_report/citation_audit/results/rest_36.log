   182	        <h3 class="box-title">検索条件に該当するデータがありませんでした。</h3>
   183	      </div><!-- /.box-header -->
   184	      {% endif %}
   185	    </div><!-- /.box -->
   186	  </div><!-- /.col -->
   187	</div>
   188	{% endif %}
   189	</form>
