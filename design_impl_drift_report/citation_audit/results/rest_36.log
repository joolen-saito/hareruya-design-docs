   207	        $builder = $app['form.factory']->createBuilder('admin_event_detail', $eventDetails[0]->getEvent());
   208	        $form = $builder->getForm();
   209	        $this->checkCsrfValid($app, $form);
   210	
   211	        foreach ($eventDetails as $detail) {
   212	
   213	            // デッキ登録あり
   214	            if ($detail->getDecks()->count() > 0) {
   215	                $app->addError('admin.event.delete.deckerror', 'admin');
   216	
   217	                return $app->redirect($request->headers->get('referer'));
   218	            }
   219	            // 申込あり
   220	            if ($detail->getEventEntries()->count() > 0) {
   221	                $app->addError('admin.event.delete.entryerror', 'admin');
   222	
   223	                return $app->redirect($request->headers->get('referer'));
   224	            }
   225	
   226	            // dtb_event_detail更新
   227	            $app['orm.em']->remove($detail);
   228	        }
   229	        $app['orm.em']->flush();
   230	        $app->addSuccess('admin.schedule.delete.complete', 'admin');
   231	
   232	        // 詳細画面表示
   233	        return $app->redirect($app->url('admin_event_edit', ['id'=> $id]));
