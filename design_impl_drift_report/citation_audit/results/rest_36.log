    23	
    24	class ScheduleStoreAction
    25	{
    26	    public function __construct(
    27	        private readonly EntityManagerInterface $entityManager,
    28	        private readonly EventDetailEntityManager $eventDetailEntityManager,
    29	        private readonly MtbHolidayRepository $mtbHolidayRepository,
    30	    ) {
    31	    }
    32	
    33	    public function handle(ScheduleStoreInput $input): DtbEventDetail
    34	    {
    35	        $EventDetail = $input->EventDetail;
    36	
    37	        $EventDetail = $this->eventDetailEntityManager->save(
    38	            EventDetail: null,
    39	            Event: $input->Event,
    40	            startDate: $EventDetail->getStartDate(),
    41	            endDate: $EventDetail->getEndDate(),
    42	            Disp: $EventDetail->getDisp(),
    43	            Member: $input->Member,
    44	            deadlineFlg: $EventDetail->getDeadlineFlg(),
    45	            deckRegistFlg: $EventDetail->getDeckRegistFlg(),
    46	            entryFlg: $EventDetail->getEntryFlg(),
    47	            holidayFlg: $this->mtbHolidayRepository->isHoliday($EventDetail->getStartDate()),
    48	            entryStartDate: $EventDetail->getEntryStartDate(),
    49	            entryEndDate: $EventDetail->getEntryEndDate(),
    50	            onlineEntryStartDate: $EventDetail->getOnlineEntryStartDate(),
    51	            onlineEntryEndDate: $EventDetail->getOnlineEntryEndDate(),
    52	            deckRegistDeadline: $EventDetail->getDeckRegistDeadline(),
    53	            capacity: $EventDetail->getCapacity(),
    54	            entryFee: $EventDetail->getEntryFee(),
    55	            prizeJp: $EventDetail->getPrizeJp(),
    56	            prizeEn: $EventDetail->getPrizeEn(),
    57	            deletedAt: $EventDetail->getDeletedAt(),
    58	        );
    59	
    60	        $input->Event->getDetails()->add($EventDetail);
    61	
    62	        $this->entityManager->flush();
    63	
    64	        return $EventDetail;
    65	    }
    66	}

