    55	                  {{ form_widget(searchForm.formats) }}
    56	                </div>
    57	              </div>
    58	              <div class="col-xs-12 col-md-6">
    59	                <div id="search_box_main__venue" class="form-group">
    60	                  <label for="admin_event_list_venue">{{ trans('form.venue.label') }}</label>
    61	                  <div id="select2_venue">
    62	                  {{ form_widget(searchForm.venue) }}
    63	                  </div>
    64	                </div>
    65	              </div>
    66	              <div class="col-xs-12 col-md-6">
    67	                <div id="search_box_main__rel" class="form-group">
    68	                  <label for="admin_event_list_rel">{{ trans('form.rel.label') }}</label>
    69	                  {{ form_widget(searchForm.rel) }}
    70	                </div>
    71	              </div>
    72	            <div class="extra-form col-xs-12 col-sm-12">
