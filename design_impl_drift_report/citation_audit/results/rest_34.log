    76	        $searchForm = $this->createForm(SearchProductRequestType::class);
    77	        $searchForm->handleRequest($request);
    78	
    79	        if (!$searchForm->isSubmitted() || !$searchForm->isValid()) {
    80	            return [
    81	                'searchForm' => $searchForm->createView(),
    82	                'searched' => false,
    83	                'summary' => null,
    84	            ];
    85	        }
    86	
    87	        $searchData = $searchForm->getData();
    88	        $this->session->set(self::SESSION_KEY, FormUtil::getViewData($searchForm));
    89	
    90	        $summary = $this->productRequestRepository->getAnalysisSummary($searchData);
    91	
    92	        $event = new EventArgs(
    93	            [
    94	                'form' => $searchForm,
    95	                'searchData' => $searchData,
    96	            ],
    97	            $request
    98	        );
    99	        $this->eventDispatcher->dispatch($event, EccubeEvents::ADMIN_ANALYSIS_PRODUCT_REQUEST_SEARCH);
   100	
   101	        return [
   102	            'searchForm' => $searchForm->createView(),
   103	            'searched' => true,
   104	            'summary' => $summary ?: null,
   105	        ];
   106	    }
   107	
   108	    /**
   109	     * @return StreamedResponse|RedirectResponse
   110	     */
   111	    #[Route(path: '/%eccube_admin_route%/analysis/product-request/export', name: 'admin_analysis_product_request_export', methods: ['GET'])]
   112	    public function export(Request $request): StreamedResponse|RedirectResponse
   113	    {
   114	        $viewData = $this->session->get(self::SESSION_KEY);
   115	
   116	        if ($viewData === null) {
   117	            $this->addError('検索条件がありません。先に検索を実行してください。', 'admin');
   118	
   119	            return $this->redirectToRoute('admin_analysis_product_request');
   120	        }
   121	
   122	        $searchForm = $this->createForm(SearchProductRequestType::class);
   123	        $searchData = FormUtil::submitAndGetData($searchForm, $viewData);
   124	
   125	        $event = new EventArgs(
   126	            [
   127	                'form' => $searchForm,
   128	                'searchData' => $searchData,
   129	            ],
   130	            $request
   131	        );
   132	        $this->eventDispatcher->dispatch($event, EccubeEvents::ADMIN_ANALYSIS_PRODUCT_REQUEST_CSV_EXPORT);
   133	
   134	        return $this->productRequestCsvExportService->exportBySearchData($searchData);
   135	    }
   136	}
