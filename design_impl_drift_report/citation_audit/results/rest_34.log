    85	            );
    86	
    87	        if ($summaryType === 'product_id') {
    88	            $qb->addSelect('od.product_code as code');
    89	        }
    90	        if ($summaryType) {
    91	            $qb->groupBy(self::SUMMARY_GROUP_NAMES[$summaryType]['key']);
