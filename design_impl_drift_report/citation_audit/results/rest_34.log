   250	    public function deleteRequestByNonProduct()
   251	    {
   252	        $time = new \DateTime();
   253	        $sql = <<<EOT
   254	UPDATE
   255	    dtb_product_request pr
   256	JOIN dtb_product_class pc ON pr.product_class_id = pc.product_class_id
   257	LEFT OUTER JOIN dtb_product p ON pc.product_id = p.product_id
   258	SET
   259	    pr.deleted_at = ?
   260	WHERE
   261	    pr.deleted_at IS NULL
   262	AND (
   263	    pc.del_flg = 1
   264	OR
   265	    p.product_id IS NULL
   266	OR
   267	    p.del_flg = 1
   268	)
   269	EOT;
   270	
   271	        $connection = $this->getEntityManager()->getConnection();
   272	        $connection->executeUpdate(
   273	            $sql,
   274	            [
   275	                $time->format(self::MYSQL_DATE_FORMAT),
   276	            ]
   277	        );
   278	    }
   279	}
