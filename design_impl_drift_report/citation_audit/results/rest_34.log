   384	                'l.id AS language_id',
   385	                'l.code AS language_code',
   386	                'COUNT(DISTINCT CASE WHEN pr.deleted_at IS NULL THEN pr.player_id ELSE NULL END) AS pending_count',
   387	                '(COUNT(DISTINCT pr.player_id) - COUNT(DISTINCT CASE WHEN pr.deleted_at IS NULL THEN pr.player_id ELSE NULL END)) AS deleted_count',
   388	                'MIN((SELECT MIN(pc_min.price02) FROM dtb_product_class pc_min WHERE pc_min.product_id = p.id AND pc_min.language_id = l.id)) AS min_price',
   389	            )
   390	            ->from('dtb_product_request', 'pr')
   391	            ->leftJoin('pr', 'dtb_product_class', 'pc', 'pr.product_class_id = pc.id')
   392	            ->innerJoin('pr', 'dtb_product', 'p', 'p.id = COALESCE(pc.product_id, pr.product_id)')
   393	            ->leftJoin('pr', 'mtb_language', 'l', 'l.id = COALESCE(pc.language_id, pr.language_id)')
   394	            ->andWhere(
   395	                '(pr.product_class_id IS NOT NULL AND pc.id IS NOT NULL)'
   396	                .' OR (pr.product_class_id IS NULL AND pr.product_id IS NOT NULL AND pr.language_id IS NOT NULL)',
   397	            )
   398	            ->groupBy('p.id')
   399	            ->addGroupBy('p.name')
   400	            ->addGroupBy('l.id')
   401	            ->addGroupBy('l.code');
