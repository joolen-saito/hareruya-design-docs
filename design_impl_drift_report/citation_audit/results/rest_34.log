from html.parser import HTMLParser
from pathlib import Path
class P(HTMLParser):
 def __init__(self):
  super().__init__(); self.sheet=None; self.capture=None; self.out=[]; self.embed=False; self.stack=[]
 def handle_starttag(self,tag,attrs):
  a=dict(attrs)
  if tag=='section' and a.get('id','').startswith('sheet-'):
   try:self.sheet=int(a['id'].split('-')[1])
   except:pass
   self.embed=False
  if self.sheet in {9,11,12,13,14,15} and not self.embed and tag=='span' and 'src-cell' in a.get('class','').split():
   self.capture=[self.sheet,a.get('data-excel-ref',''),'']
  self.stack.append(tag)
 def handle_endtag(self,tag):
  if self.capture and tag=='span':
   self.out.append(tuple(self.capture)); self.capture=None
  if self.stack:self.stack.pop()
 def handle_data(self,data):
  if self.capture:self.capture[2]+=data
 def handle_comment(self,data):
  if 'function-design-embed:start' in data:self.embed=True
