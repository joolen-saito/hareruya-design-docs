    45	    /**
    46	    * 注文の合計サイズを取得
    47	    *
    48	    * @param \Eccube\Entity\Order $order
    49	    * @return integer
    50	    */
    51	    public function getTotalSize(\Eccube\Entity\Order $order)
    52	    {
    53	        $result = $this->createQueryBuilder('od')
    54	            ->join('od.Product', 'p')
    55	            ->join('Plugin\HareruyaEc\Entity\DtbProductSub', 'ps', 'WITH', 'p.id = ps.productId')
    56	            ->select('sum(ps.size*od.quantity)')
    57	            ->where('od.Order = :order')
    58	            ->setParameter('order', $order)
    59	            ->groupBy('od.Order')
    60	            ->getQuery()
    61	            ->getOneOrNullResult();
    62	
    63	        return $result[1] ?? 0;
    64	    }
