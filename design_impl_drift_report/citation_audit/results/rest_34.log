    22	class OrderDetailRepository extends \Eccube\Repository\OrderDetailRepository
    23	{
    24	    const RESULT_CACHING_TIME = 3600;
    25	    const SUMMARY_GROUP_NAMES = [
    26	        'product_id' => ['name' => 'od.product_name', 'key' => 'od.product_code'],
    27	        'class_category_name' => ['name' => 'cate.name', 'key' => 'cate.name'],
    28	        'payment_method' => ['name' => 'o.payment_method', 'key' => 'o.payment_method'],
    29	        'customer_group_id' => ['name' => 'cg.name', 'key' => 'pl.customerGroupId'],
    30	        'order_pref' => ['name' => 'pr.name', 'key' => 'o.Pref'],
