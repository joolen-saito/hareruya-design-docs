     5	use DateTime;
     6	use Eccube\Application;
     7	use Eccube\Controller\AbstractController;
     8	use Eccube\Util\FormUtil;
     9	use Symfony\Component\HttpFoundation\Request;
    10	use Symfony\Component\HttpFoundation\StreamedResponse;
    11	
    12	class RequestController extends AbstractController
    13	{
    14	    const VIEW_KEY = 'admin.request.search';
    15	    const EXPORT_HEADER = ['商品コード', '商品名', '言語', '状態', '販売金額', '在庫数', '会員名', '依頼日', '購入日', '通知日/通知設定削除日'];
    16	
    17	    /**
    18	     * 検索画面初期表示
    19	     *
    20	     * @param $app Application
    21	     * @param $request Request
    22	     * @return \Symfony\Component\HttpFoundation\Response
    23	     */
    24	    public function index(Application $app, Request $request)
    25	    {
    26	        $request->getSession()->remove(self::VIEW_KEY);
    27	        $builder = $app['form.factory']->createBuilder('admin_request');
    28	        $form = $builder->getForm();
    29	        $dateFrom = new Datetime('first day of this month');
    30	        $dateTo = new Datetime('last day of this month');
    31	        $form->get('create_date_from')->setData($dateFrom);
    32	        $form->get('create_date_to')->setData($dateTo);
    33	        $form->get('asc_desc')->setData('asc');
    34	
    35	        // 検索画面表示
    36	        $renderArr = [
    37	            'searchForm' => $form->createView(),
    38	            'summary' => null,
    39	        ];
    40	
    41	        return $app->render('Analysis/request.twig', $renderArr);
    42	    }
    43	
    44	    /**
    45	     * 検索
    46	     *
    47	     * @param Application $app
    48	     * @param Request $request
    49	     * @return \Symfony\Component\HttpFoundation\Response
    50	     */
    51	    public function search(Application $app, Request $request)
    52	    {
    53	        $builder = $app['form.factory']->createBuilder('admin_request');
    54	        $form = $builder->getForm();
    55	        $form->handleRequest($request);
    56	
    57	        $session = $request->getSession();
    58	        $viewData = FormUtil::getViewData($form);
    59	        $session->set(self::VIEW_KEY, $viewData);
    60	
    61	        // 集計
    62	        $app['orm.em']->getFilters()->disable('soft_deleteable');
    63	        $result = $app['hareruya_ec.repository.product_request']->getQueryBuilderBySearchData($form->getData());
    64	
    65	        // 検索画面表示
    66	        $renderArr = [
    67	            'searchForm' => $form->createView(),
    68	            'summary' => $result->getResult(),
    69	        ];
    70	
    71	        return $app->render('Analysis/request.twig', $renderArr);
    72	    }
    73	
    74	    /**
    75	     * Export
    76	     *
    77	     * @param Application $app
    78	     * @param Request $request
    79	     * @return \Symfony\Component\HttpFoundation\Response
    80	     */
    81	    public function export(Application $app, Request $request)
    82	    {
    83	        $response = new StreamedResponse();
    84	        $response->setCallback(function () use ($app, $request) {
    85	            $session = $request->getSession();
    86	            $viewData = $session->get(self::VIEW_KEY, []);
    87	            $searchForm = $app['form.factory']->create('admin_request', null, ['csrf_protection' => true]);
    88	            $searchData = FormUtil::submitAndGetData($searchForm, $viewData);
    89	
    90	            $app['orm.em']->getFilters()->disable('soft_deleteable');
    91	            $result = $app['hareruya_ec.repository.product_request']->getQueryBuilderBySearchData($searchData, true);
    92	
    93	            $csvService = $app['eccube.service.csv.export'];
    94	            $csvService->fopen();
    95	            $csvService->putBOM();
    96	
    97	            $csvService->fputcsv(self::EXPORT_HEADER);
    98	            $i = 0;
    99	            foreach ($result->iterate() as $line) {
   100	                $data = $line[$i];
   101	                $row = [];
   102	                $row[] = $data['code'];
   103	                $row[] = $data['name'];
   104	                $row[] = $data['language'];
   105	                $row[] = $data['condition'];
   106	                $row[] = $data['price02'];
   107	                $row[] = $data['stock'];
   108	                $row[] = $data['customerName'];
   109	                $row[] = $data['createDate']->format('Y/m/d H:i');
   110	                $row[] = $data['order_date'];
   111	                $deletedAt = $data['deletedAt'];
   112	                $row[] = !is_null($deletedAt) ? $deletedAt->format('Y/m/d H:i') : '';
   113	                $csvService->fputcsv($row);
   114	                $i++;
   115	            }
   116	            $csvService->fclose();
   117	        });
   118	
   119	        $now = new \DateTime();
   120	        $filename = 'request_report_' . $now->format('YmdHis') . '.csv';
   121	        $response->headers->set('Content-Type', 'application/octet-stream');
   122	        $response->headers->set('Content-Disposition', 'attachment; filename=' . $filename);
   123	        $response->send();
   124	
   125	        return $response;
   126	    }
   127	}
