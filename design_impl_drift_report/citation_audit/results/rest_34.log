   103	                ->leftJoin('Plugin\HareruyaEc\Entity\DtbCustomerGroup', 'cg', 'WITH', 'pl.customerGroupId = cg.id');
   104	        } elseif ($summaryType === 'class_category_name') {
   105	            $qb->join('Eccube\Entity\ProductCategory', 'pcate', 'WITH', 'p.id = pcate.product_id')
   106	                ->join('pcate.Category', 'cate');
   107	        }
   108	
   109	        $searchDate = $dateType;
   110	        if ($dateType !== 'cancel_date') {
   111	            $qb->join('o.OrderStatus', 'os', 'WITH', 'os.id != ' . OrderStatus::ORDER_CANCEL);
   112	        }
   113	        if ($dateType !== 'order_date' && $dateType !== 'payment_date') {
   114	            $searchDate = 'osb.' . lcfirst(strtr(ucwords(strtr($dateType, ["_" => " "])), [" " => ""]));
   115	            $qb->join('Plugin\HareruyaEc\Entity\DtbOrderSub', 'osb', 'WITH', 'o.id = osb.orderId');
   116	        } else {
   117	            $searchDate = "o.{$dateType}";
   118	        }
   119	
   120	        $qb->andWhere("o.order_date is not null");
   121	
   122	        $multi = $searchData['multi'];
   123	        if (isset($multi) && Str::isNotBlank($multi)) {
   124	            // 半角スペース、全角スペース、カンマで分割
   125	            $texts = preg_split('/[\s, ]+/u', $multi);
   126	            $searchColumns = [
   127	                'od' => ['product_name', 'product_code'],
   128	                'ps' => ['nameEn'],
   129	                'c' => ['nameJp', 'nameEn'],
   130	            ];
   131	            SqlUtil::multiTextQuery($qb, $texts, $searchColumns);
   132	            $qb->join('p.productSub', 'ps')
   133	                ->leftJoin('ps.cardDetail', 'cd')
   134	                ->leftJoin('cd.card', 'c');
   135	        }
   136	
   137	        // 集計日From
   138	        $dateFrom = $searchData['date_from'];
   139	        if (!empty($dateFrom)) {
   140	            $dateFrom = $dateFrom->format('Y-m-d H:i:s');
   141	            $qb->andWhere("{$searchDate} >= :{$dateType}_from")
   142	                ->setParameter("{$dateType}_from", $dateFrom);
   143	        }
   144	        // 集計日To
   145	        $dateTo = $searchData['date_to'];
   146	        if (!empty($dateTo)) {
   147	            $dateTo = $dateTo->format('Y-m-d H:i:s');
   148	            $qb->andWhere("{$searchDate} < :{$dateType}_to")
   149	                ->setParameter("{$dateType}_to", $dateTo);
   150	        }
   151	        // category
   152	        $category = $searchData['product']['category_id'];
   153	        if (!empty($category)) {
   154	            $categories = $category->getSelfAndDescendants();
   155	            $qb->join('p.ProductCategories', 'pct', Join::WITH, $qb->expr()->in('pct.Category', ':categories'))
   156	                ->setParameter('categories', $categories);
   157	        }
   158	
   159	        $pref = $searchData['customer']['pref'];
