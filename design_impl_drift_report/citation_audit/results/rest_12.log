   155	    private function isProductExists(string $productCode)
   156	    {
   157	        $sql = <<<EOT
   158	            SELECT
   159	                product_class_id
   160	            FROM
   161	                dtb_product_class pc
   162	            JOIN
   163	                dtb_product p ON p.product_id = pc.product_id AND p.del_flg = 0
   164	            JOIN
   165	                dtb_product_sub ps ON ps.product_id = p.product_id
   166	            WHERE
   167	                pc.product_code = :productCode
   168	                AND pc.del_flg = :delFlg
   169	        EOT;
   170	
   171	        $rsm = new ResultSetMapping();
   172	        $rsm->addScalarResult('product_class_id', 'productClassId', Type::INTEGER);
   173	
   174	        $query = $this->em->createNativeQuery($sql, $rsm)
   175	            ->setParameter('productCode', $productCode)
   176	            ->setParameter('delFlg', Constant::DISABLED);
   177	        $result = $query->getOneOrNullResult();
   178	
   179	        return !empty($result);
   180	    }

