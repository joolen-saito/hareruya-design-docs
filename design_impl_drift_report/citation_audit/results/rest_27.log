/bin/bash -lc "python3 - <<'PY'
from html.parser import HTMLParser
KEYS=['最大長','件名','配送先一覧','入力チェック','郵便番号','削除','確認済','本人確認','身分証','画像','閲覧','サムネイル','ログ','個人情報','顧客グループ','新規追加','編集','支払','ブラックリスト','登録エラー','登録完了','配送先情報登録CSV','スクロール','フォーマット','識別ID','主キー']
TARGET={f'sheet-{n}' for n in (16,17,18,20,21,25,26)}
class P(HTMLParser):
  def __init__(self): super().__init__(convert_charrefs=True); self.sheet=None; self.depth=0; self.cap=None
  def handle_starttag(self,tag,attrs):
    a=dict(attrs)
    if tag=='section' and a.get('id','').startswith('sheet-'): self.sheet=a['id']; self.depth=1
    elif self.sheet and tag=='section': self.depth+=1
    if self.sheet in TARGET and tag=='span' and 'src-cell' in a.get('class','').split(): self.cap=[self.getpos()[0],a.get('data-excel-ref'),[]]
    elif self.cap and tag=='br': self.cap[2].append(' ')
  def handle_data(self,d):
    if self.cap:self.cap[2].append(d)
  def handle_endtag(self,tag):
    if tag=='span' and self.cap:
      ln,ref,parts=self.cap; txt=' '.join(''.join(parts).split())
      if any(k in txt for k in KEYS): print(f'{self.sheet}\\t{ln}\\t{ref}\\t{txt}')
      self.cap=None
    if self.sheet and tag=='section':
      self.depth-=1
      if not self.depth:self.sheet=None
p=P();p.feed(open('hareruya-design-docs/excel_to_html/output/0207_基本設計仕様書(会員管理機能).html',encoding='utf-8').read())
