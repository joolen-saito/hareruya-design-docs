    62	    /**
    63	     * CSVアップロード画面
    64	     *
    65	     * @param Application $app
    66	     * @param Request $request
    67	     * @return \Symfony\Component\HttpFoundation\Response
    68	     */
    69	    public function csv(Application $app, Request $request)
    70	    {
    71	        $form = $app['form.factory']->createBuilder('admin_csv_import')->getForm()->handleRequest($request);
    72	
    73	        $headers = self::CSV_HEADER;
    74	
    75	        return $app->render($this->importTwig, [
    76	            'form' => $form->createView(),
    77	            'headers' => $headers
    78	        ]);
    79	    }
    80	
    81	    /**
    82	     * 配送先情報CSVアップロード
    83	     *
    84	     * @param Application $app
    85	     * @param Request $request
    86	     * @return \Symfony\Component\HttpFoundation\Response
    87	     */
    88	    public function import(Application $app, Request $request)
    89	    {
    90	        $customerAddressCsv = new CustomerAddressCsv($app, $this->importTwig, $this->sessionKey, self::CSV_HEADER, self::REQUIRED_CSV_HEADER);
    91	
    92	        $form = $app['form.factory']->createBuilder('admin_csv_import')->getForm()->handleRequest($request);
    93	
    94	        $customerAddressCsv->checkFormValid($form);
    95	        $formFile = $customerAddressCsv->getFormFile($form);
    96	
    97	        $data = $customerAddressCsv->getImportData($formFile);
    98	        if ($data === false) {
    99	            return $customerAddressCsv->render();
   100	        }
   101	
   102	        try {
   103	            // ヘッダーの値が一致するかチェック
   104	            $headers = self::CSV_HEADER;
   105	            $columnHeaders = $data->getColumnHeaders();
   106	            $customerAddressCsv->checkHeaderValues(array_keys($headers), $columnHeaders, self::NOT_REQUIRED_CSV_HEADER);
   107	            $headerSize = count($columnHeaders);
   108	
   109	            // CSVデータが空でないかチェック
   110	            $customerAddressCsv->checkDataSize($data);
   111	
   112	            $app['orm.em']->getConfiguration()->setSQLLogger(null);
   113	            $app['orm.em']->beginTransaction();
   114	
   115	            // CSVファイルの登録処理
   116	            $customerAddressCsv->register($headers, $headerSize, $data);
   117	        } catch (\LogicException | \RuntimeException $e) {
   118	            // 登録失敗時の処理
   119	            $app['orm.em']->rollback();
   120	            $app->addError($e->getMessage(), 'admin');
   121	
   122	            return $customerAddressCsv->render();
   123	        }
   124	
   125	        $app->addSuccess('admin.register.complete', 'admin');
   126	
   127	        return $customerAddressCsv->render();
   128	
   129	    }
   130	}
