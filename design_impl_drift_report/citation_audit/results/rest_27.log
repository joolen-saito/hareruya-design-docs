from html.parser import HTMLParser
TARGET={'sheet-20','sheet-21'}
class P(HTMLParser):
  def __init__(self): super().__init__(convert_charrefs=True); self.sheet=None; self.depth=0; self.cap=None
  def handle_starttag(self,tag,attrs):
    a=dict(attrs)
    if tag=='section' and a.get('id') in TARGET: self.sheet=a['id']; self.depth=1
    elif self.sheet and tag=='section':self.depth+=1
    if self.sheet and tag=='span' and 'src-cell' in a.get('class','').split():self.cap=[self.getpos()[0],a.get('data-excel-ref'),[]]
    elif self.cap and tag=='br':self.cap[2].append(' ')
  def handle_data(self,d):
    if self.cap:self.cap[2].append(d)
  def handle_endtag(self,tag):
    if tag=='span' and self.cap:
      l,r,p=self.cap;t=' '.join(''.join(p).split());
      if (self.sheet=='sheet-20' and 5195<=l<=5260) or (self.sheet=='sheet-21' and 5428<=l<=5466): print(f'{l}\\t{r}\\t{t}')
      self.cap=None
    if self.sheet and tag=='section':
      self.depth-=1
      if not self.depth:self.sheet=None
p=P();p.feed(open('hareruya-design-docs/excel_to_html/output/0207_基本設計仕様書(会員管理機能).html',encoding='utf-8').read())
