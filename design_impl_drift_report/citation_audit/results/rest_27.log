p='hareruya-design-docs/design_impl_drift_report/citation_audit/results/rest_27.json'
d=json.load(open(p))
required={'rowId','verdict','specEvidence','legacyEvidence','currentImpl','note'}
for r in d['results']:
    miss=required-r.keys()
    if miss: print('missing',r['rowId'],miss)
    for k in ('specEvidence','legacyEvidence','currentImpl'):
        if not re.search(r'["'^'"\\s:]+:\\d+',r[k]): print('no path:line',r['rowId'],k)
print('packet',d['packetId'],'count',len(d['results']),'unique',len({r['rowId'] for r in d['results']}))
PY" in /home/y-saito/Developments
