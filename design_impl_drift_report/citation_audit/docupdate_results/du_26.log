    clean=re.sub(r'<["'^>]+>'"',' ',clean)
    clean=html.unescape(clean)
    clean=' '.join(clean.split())[:500]
    hits.append((i,refs,clean))
  print('QUERY',q,'hits',len(hits))
  for x in hits[:5]: print(' ',x)
