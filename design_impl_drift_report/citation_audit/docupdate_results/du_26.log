  rel={x.attrib['Id']:norm('xl/workbook.xml',x.attrib['Target']) for x in wr}
  for s in wb.findall('m:sheets/m:sheet',NS):
   name=s.attrib['name']
   if name not in wanted: continue
   sp=rel[s.attrib['{'+NS['r']+'}id']]
   ws=ET.fromstring(z.read(sp))
   srp=str(PurePosixPath(sp).parent/'_rels'/(PurePosixPath(sp).name+'.rels'))
   sr={}
   if srp in z.namelist():
    sre=ET.fromstring(z.read(srp)); sr={x.attrib['Id']:norm(sp,x.attrib['Target']) for x in sre}
   d=ws.find('m:drawing',NS)
   print(' sheet',name,'worksheet',sp,'drawing',None if d is None else sr.get(d.attrib['{'+NS['r']+'}id']))
   if d is None: continue
   dp=sr[d.attrib['{'+NS['r']+'}id']]
   drp=str(PurePosixPath(dp).parent/'_rels'/(PurePosixPath(dp).name+'.rels'))
   dre=ET.fromstring(z.read(drp)); dr={x.attrib['Id']:norm(dp,x.attrib['Target']) for x in dre}
   root=ET.fromstring(z.read(dp))
