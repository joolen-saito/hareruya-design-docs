from zipfile import ZipFile
from xml.etree import ElementTree as ET
from pathlib import Path
NS='{http://schemas.openxmlformats.org/spreadsheetml/2006/main}'
p=Path('input/0211_基本設計仕様書(分析・集計管理機能)_詳細設計.xlsx')
with ZipFile(p) as z:
    ss=[]
    root=ET.fromstring(z.read('xl/sharedStrings.xml'))
    for si in root.findall(NS+'si'):
        ss.append(''.join(t.text or '' for t in si.iter(NS+'t')))
    for n in [4,5,7,8,9,10,19,20]:
        print(f'\\n=== sheet{n} ===')
        root=ET.fromstring(z.read(f'xl/worksheets/sheet{n}.xml'))
        for c in root.iter(NS+'c'):
            r=c.get('r'); typ=c.get('t'); v=c.find(NS+'v')
            if v is None: continue
            val=v.text or ''
            if typ=='s': val=ss[int(val)]
            elif typ=='inlineStr': val=''.join(t.text or '' for t in c.iter(NS+'t'))
            val=val.replace('\\n',' / ')
            if val.strip(): print(f'{r}\\t{val}')
