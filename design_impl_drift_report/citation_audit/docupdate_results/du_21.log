from zipfile import ZipFile
from xml.etree import ElementTree as ET
from pathlib import Path
NS={'xdr':'http://schemas.openxmlformats.org/drawingml/2006/spreadsheetDrawing','a':'http://schemas.openxmlformats.org/drawingml/2006/main','r':'http://schemas.openxmlformats.org/officeDocument/2006/relationships'}
p=Path('input/0211_基本設計仕様書(分析・集計管理機能)_詳細設計.xlsx')
mapd={4:2,5:3,7:5,8:None,9:6,10:7,19:13,20:14}
with ZipFile(p) as z:
  for sheet,draw in mapd.items():
    print(f'\\nSHEET {sheet} drawing={draw}')
    if draw is None: continue
    root=ET.fromstring(z.read(f'xl/drawings/drawing{draw}.xml'))
    for i,anchor in enumerate(list(root),1):
      fr=anchor.find('xdr:from',NS); to=anchor.find('xdr:to',NS)
      def pos(e):
        if e is None:return '?'
        return f\"r{int(e.find('xdr:row',NS).text)+1}c{int(e.find('xdr:col',NS).text)+1}\"
      pics=anchor.findall('xdr:pic',NS); shapes=anchor.findall('xdr:sp',NS)
      typ='pic' if pics else 'shape' if shapes else 'other'
      txt='|'.join((t.text or '') for t in anchor.findall('.//a:t',NS))
      print(i,typ,pos(fr),pos(to),txt[:160])
