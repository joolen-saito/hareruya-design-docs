/bin/bash -lc ".venv/bin/python -u - <<'PY'
from openpyxl import load_workbook
from pathlib import Path
books={
'0302':['F02-04','支店スマホ','店舗切替','閲覧店舗','右カラム'],
'0303':['F03-02','商品詳細','短縮URL','該当なし'],
'0306':['F06-22','F06-27','お問い合わせ','パスワード設定','当店へのご要望'],
'0307':['F07-03','大会詳細','参加費'],
'0601':['M06-01','MTGバイヤー','販売価格','印刷済み'],
}
for prefix,terms in books.items():
 p=next(Path('input').glob(prefix+'_*.xlsx'))
 print('\\nBOOK',p.name)
 wb=load_workbook(p, read_only=True, data_only=False)
 for ws in wb.worksheets:
  hits=[]
  for row in ws.iter_rows():
   for c in row:
    if c.value is not None:
     s=str(c.value)
     if any(t.lower() in s.lower() for t in terms): hits.append((c.coordinate,s.replace('\\n',' / ')[:500]))
  if hits:
   print('SHEET',ws.title)
   for x in hits[:120]: print(' ',*x)
