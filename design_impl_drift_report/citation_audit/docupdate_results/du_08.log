from openpyxl import load_workbook
from pathlib import Path
root=Path('input')
searches={
'0201':['M11-01','M11-02','M11-03','スマレジ用アカウント','権限設定'],
'0202':['M04-09','M04-12','在庫移動・振替登録','在庫分割結合'],
'0302':['F02-04','支店スマホ','店舗切替','閲覧店舗','右カラム'],
'0303':['F03-02','商品詳細'],
'0306':['F06-22','F06-27','お問い合わせ','パスワード設定'],
'0307':['F07-03','大会詳細','参加費'],
'0601':['M06-01','MTGバイヤー','販売価格','印刷済み'],
}
for prefix,terms in searches.items():
 p=next(root.glob(prefix+'_*.xlsx'))
 print('\\nBOOK',p.name,flush=True)
 wb=load_workbook(p, read_only=True, data_only=False)
 for ws in wb.worksheets:
  hits=[]
  for row in ws.iter_rows():
   for c in row:
    if c.value is not None:
     s=str(c.value)
     if any(t.lower() in s.lower() for t in terms):
      hits.append((c.coordinate,s.replace('\\n',' / ')[:400]))
  if hits:
   print('SHEET',ws.title)
   for x in hits[:100]: print(' ',x[0],x[1])
