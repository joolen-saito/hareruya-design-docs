from openpyxl import load_workbook
from pathlib import Path
cases={
'0505_基本設計仕様書(API_受注管理).xlsx':{
'スマレジ受信処理':['X_access_token','Cookie','ヘッダ','ログ','lock','ロック','排他','トランザクション','契約ID']},
'0203_基本設計仕様書(受注管理機能).xlsx':{
'出荷実績登録CSVフォーマット':['注文番号','01234567','キー項目','桁','サブ注文','sprintf']},
}
for book,queries in cases.items():
    wb=load_workbook(Path('hareruya-design-docs/excel_to_html/input')/book,read_only=True,data_only=False)
    print('\\nBOOK',book)
    for s,terms in queries.items():
        ws=wb[s]
        print('SHEET',s)
        for row in ws.iter_rows():
            hits=[]
            for c in row:
                v='' if c.value is None else str(c.value)
                for t in terms:
                    if t.lower() in v.lower(): hits.append((c.coordinate,t,v))
            if hits:
                vals=[f'{c.coordinate}={c.value"'!r}'"' for c in row if c.value not in (None,'')]
                print('HITS',hits)
                print('ROW',' | '.join(vals))
    wb.close()
