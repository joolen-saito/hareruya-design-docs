from pathlib import Path
p=Path('hareruya-design-docs/excel_to_html/input/0507_基本設計仕様書(API_ネット買取管理).xlsx')
wb=load_workbook(p, read_only=True, data_only=False)
queries={
'ネット買取注文の査定終了処理':['name','65535','400','500','order_status','ステータス以外','例外'],
'複数ネット買取IDからネット買取受注の商品一覧を取得':['foilFlg','ids','カンマ','必須','数値(整数)'],
'複数ネット買取IDから個別入力商品の一覧を取得':['buyOrderIndivisualInputProduct','IP制限','トークン','ids','カンマ','必須'],
}
for s,terms in queries.items():
    ws=wb[s]
    print('\\nSHEET',s)
    shown=set()
    for row in ws.iter_rows():
        hits=[]
        for c in row:
            v='' if c.value is None else str(c.value)
            for t in terms:
                if t.lower() in v.lower(): hits.append((c.coordinate,t,v))
        if hits:
            key=row[0].row
            if key in shown: continue
            shown.add(key)
            vals=[f'{c.coordinate}={c.value"'!r}'"' for c in row if c.value not in (None,'')]
            print('HITS',hits)
            print('ROW',' | '.join(vals))
wb.close()
