from openpyxl import load_workbook
from pathlib import Path
p=Path('hareruya-design-docs/excel_to_html/input/0516_基本設計仕様書(API_データ管理).xlsx')
wb=load_workbook(p, read_only=True, data_only=False)
queries={
'トップバナー情報取得':['200','404','該当データ','code','message','Not Found','レスポンス'],
'言語コードに紐づいたトップバナーの情報一覧を取得':['設定済み','表示','言語コード','200','404','該当データ','code','message','Not Found','sort'],
}
for s,terms in queries.items():
    ws=wb[s]
    print('\\nSHEET',s)
    for row in ws.iter_rows():
        hits=[]
        for c in row:
            v='' if c.value is None else str(c.value)
            for t in terms:
                if t.lower() in v.lower(): hits.append((c.coordinate,t,v))
        if hits:
            vals=[f'{c.coordinate}={c.value"'!r}'"' for c in row if c.value not in (None,'')]
            print('HITS',hits)
            print('ROW',' | '.join(vals))
wb.close()
