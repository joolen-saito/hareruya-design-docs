JSON は書き込み済みです。いま、28件の欠落・重複、`NONE=0人日`、許可された区分、`sharedWithRows` の参照整合、合計工数を機械的に検証しています。
exec
/bin/bash -lc "python3 - <<'PY'
import json
from pathlib import Path
base=Path('design_impl_drift_report/citation_audit')
p=json.loads((base/'docupdate_packets/du_17.json').read_text())
r=json.loads((base/'docupdate_results/du_17.json').read_text())
errors=[]
pids=[x['rowId'] for x in p['findings']]
rids=[x['rowId'] for x in r['results']]
if r.get('packetId') "'!= p.get('"'packetId'): errors.append('packetId mismatch')
if len(rids) "'!= len(set(rids)): errors.append('"'duplicate rowId')
if set(rids) "'!= set(pids): errors.append(f'"'coverage mismatch missing={set(pids)-set(rids)} extra={set(rids)-set(pids)}')
allowed={'NONE','ADD','FIX','IMAGE','RESOLVE','UNSURE'}
for x in r['results']:
    if x['docWork'] not in allowed: errors.append(f\"{x['rowId']} invalid docWork\")
    if (x['docWork']=='NONE') "'!= (x['"'docEffortDays']==0): errors.append(f\"{x['rowId']} effort/work mismatch\")
    if not set(x['sharedWithRows']) <= set(rids): errors.append(f\"{x['rowId']} invalid shared rows\")
    if x['rowId'] in x['sharedWithRows']: errors.append(f\"{x['rowId']} shares self\")
    if x['confidence'] not in {'high','medium','low'}: errors.append(f\"{x['rowId']} invalid confidence\")
from collections import Counter
counts=Counter(x['docWork'] for x in r['results'])
total=sum(x['docEffortDays'] for x in r['results'])
print('packet',r['packetId'])
print('rows',len(rids),'unique',len(set(rids)))
print('counts',dict(sorted(counts.items())))
print('total',round(total,10))
print('errors',errors)
