p='input/0208_基本設計仕様書(カード管理).xlsx'
wb=load_workbook(p, data_only=False, read_only=False)
targets=['カード一覧(検索入力)','カード一覧(検索結果)','カード詳細(登録・編集・削除)','画像ダウンロード(言語別)','カードセット詳細（登録・編集・削除)','フォーマット一覧']
