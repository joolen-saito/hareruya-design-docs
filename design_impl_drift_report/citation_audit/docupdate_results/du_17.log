[project]
name = "excel-to-html"
version = "0.1.0"
description = "Convert Excel workbooks to readable, self-contained tabbed HTML files."
requires-python = ">=3.10"
dependencies = [
    "openpyxl>=3.1.0",
    "Pillow>=10.0.0",
]

[tool.uv]
package = false

exec
/bin/bash -lc "uv run python - <<'PY'
from openpyxl import load_workbook
from openpyxl.utils import get_column_letter
p='input/0208_基本設計仕様書(カード管理).xlsx'
wb=load_workbook(p, data_only=False, read_only=False)
targets=['カード一覧(検索入力)','カード一覧(検索結果)','カード詳細(登録・編集・削除)','画像ダウンロード(言語別)','カードセット詳細（登録・編集・削除)','フォーマット一覧']
keywords=['処理概要','項目一覧','入力項目','表示項目','ボタン','検索','削除','ダウンロード','並び順','フォーマット','カード名','戻る','CSV','CSRF','セッション','javascript','現行踏襲','カスタマイズ要件']
for name in targets:
    ws=wb[name]
    print(f'## {name} dim={ws.max_row}x{ws.max_column} images={len(ws._images)} merged={len(ws.merged_cells.ranges)}')
    for im in ws._images:
        a=im.anchor
        if hasattr(a,'_from'):
            print('IMAGE', f'{get_column_letter(a._from.col+1)}{a._from.row+1}', getattr(im,'width',None), getattr(im,'height',None))
    for row in ws.iter_rows():
        hit=False
        for c in row:
            if c.value is not None and any(k in str(c.value) for k in keywords): hit=True
        if hit:
            vals=[]
            for c in row:
                if c.value not in (None,''):
                    s=str(c.value).replace('\\n',' / ')
                    if len(s)>320: s=s[:317]+'...'
                    vals.append(f'{c.coordinate}={s}')
            print(' | '.join(vals))
    print()
