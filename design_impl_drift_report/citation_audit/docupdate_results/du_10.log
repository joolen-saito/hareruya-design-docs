from zipfile import ZipFile
from xml.etree import ElementTree as ET
from io import BytesIO
from PIL import Image
from posixpath import normpath, dirname, join
p='input/0202_基本設計仕様書(在庫管理機能).xlsx'
NS={'m':'http://schemas.openxmlformats.org/spreadsheetml/2006/main','r':'http://schemas.openxmlformats.org/officeDocument/2006/relationships','xdr':'http://schemas.openxmlformats.org/drawingml/2006/spreadsheetDrawing','a':'http://schemas.openxmlformats.org/drawingml/2006/main'}
REL='{http://schemas.openxmlformats.org/package/2006/relationships}'
RID='{http://schemas.openxmlformats.org/officeDocument/2006/relationships}id'
EMB='{http://schemas.openxmlformats.org/officeDocument/2006/relationships}embed'
with ZipFile(p) as z:
  wb=ET.fromstring(z.read('xl/workbook.xml'))
  wr=ET.fromstring(z.read('xl/_rels/workbook.xml.rels'))
  rels={e.attrib['Id']:normpath(join('xl',e.attrib['Target'])) for e in wr}
  sheets={s.attrib['name']:rels[s.attrib[RID]] for s in wb.find('m:sheets',NS)}
  for name in ['在庫移動指示検索','棚卸計画一覧','在庫編集承認一覧(検索入力)','在庫一括編集']:
    sp=sheets[name]; srp=join(dirname(sp),'_rels',sp.split('/')[-1]+'.rels')
    print('\\nSHEET',name,sp)
    if srp not in z.namelist(): print('  no rels'); continue
    sr=ET.fromstring(z.read(srp)); srels={e.attrib['Id']:normpath(join(dirname(sp),e.attrib['Target'])) for e in sr}
    sx=ET.fromstring(z.read(sp))
    for d in sx.findall('m:drawing',NS):
      dp=srels[d.attrib[RID]]; print(' drawing',dp)
      dr=ET.fromstring(z.read(dp)); drp=join(dirname(dp),'_rels',dp.split('/')[-1]+'.rels')
      drel={e.attrib['Id']:normpath(join(dirname(dp),e.attrib['Target'])) for e in ET.fromstring(z.read(drp))}
      for a in list(dr):
        fr=a.find('xdr:from',NS)
        pos='?'
        if fr is not None: pos=f\"row{int(fr.find('xdr:row',NS).text)+1}/col{int(fr.find('xdr:col',NS).text)+1}\"
        blip=a.find('.//a:blip',NS)
        if blip is not None:
          mp=drel[blip.attrib[EMB]]; im=Image.open(BytesIO(z.read(mp)))
          print('  ',pos,mp,im.size,im.format)
