/bin/bash -lc "python3 - <<'PY'
import json, zipfile, xml.etree.ElementTree as ET, re
from difflib import SequenceMatcher
from pathlib import Path
pkt='/home/y-saito/Developments/hareruya-design-docs/design_impl_drift_report/citation_audit/docupdate_packets/du_02.json'
data=json.load(open(pkt))
M='http://schemas.openxmlformats.org/spreadsheetml/2006/main';R='http://schemas.openxmlformats.org/officeDocument/2006/relationships';P='http://schemas.openxmlformats.org/package/2006/relationships';NS={'m':M}
cache={}
def cells(book, html_idx):
 key=(book,html_idx)
 if key in cache:return cache[key]
 with zipfile.ZipFile(book) as z:
  wb=ET.fromstring(z.read('xl/workbook.xml')); rr=ET.fromstring(z.read('xl/_rels/workbook.xml.rels')); rel={e.attrib['Id']:e.attrib['Target'] for e in rr}
  ss=[]
  if 'xl/sharedStrings.xml' in z.namelist():
   sr=ET.fromstring(z.read('xl/sharedStrings.xml')); ss=[''.join(t.text or '' for t in si.findall('.//m:t',NS)) for si in sr.findall('m:si',NS)]
  s=wb.findall('m:sheets/m:sheet',NS)[html_idx]
  name=s.attrib['name']; t=rel[s.attrib['{'+R+'}id']];t=t if t.startswith('xl/') else 'xl/'+t
  root=ET.fromstring(z.read(t)); out=[]
  for c in root.findall('.//m:c',NS):
   typ=c.attrib.get('t');v=c.find('m:v',NS); val=''
   if typ=='s' and v is not None:val=ss[int(v.text)]
   elif typ=='inlineStr':val=''.join(x.text or '' for x in c.findall('.//m:t',NS))
   elif v is not None:val=v.text or ''
   if val.strip():out.append((c.attrib['r'],val))
  cache[key]=(name,out);return name,out
for f in data['findings']:
 if f['確定根拠区分']"'!='"'SPEC_BACKED':continue
 ref=f['設計書参照']; html=re.search(r'(.+\\.html)#sheet-(\\d+)',ref); hpath=html.group(1); idx=int(html.group(2)); book=hpath.replace('/output/','/input/').replace('.html','.xlsx')
 name, vals=cells(book,idx)
 exp=re.sub(r'\\s+','',f['設計期待値'])
 best=[]
 for cr,v in vals:
  vv=re.sub(r'\\s+','',v)
  m=SequenceMatcher(None,exp,vv).find_longest_match(0,len(exp),0,len(vv))
  best.append((m.size,cr,v,m.a,m.b))
 best.sort(reverse=True)
 size,cr,v,a,b=best[0]
 print(f[\"rowId\"],Path(book).name,'/',name,cr,'match',size,repr(exp[a:a+size]),'=>',repr(v[:180].replace('\\n',' / ')))
