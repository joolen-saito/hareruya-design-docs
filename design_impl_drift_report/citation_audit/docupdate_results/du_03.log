[project]
name = "excel-to-html"
version = "0.1.0"
description = "Convert Excel workbooks to readable, self-contained tabbed HTML files."
requires-python = ">=3.10"
dependencies = [
    "openpyxl>=3.1.0",
    "Pillow>=10.0.0",
]

[tool.uv]
package = false

exec
/bin/bash -lc "uv run python - <<'PY'
from pathlib import Path
from openpyxl import load_workbook
root=Path('input')
for name in ['0204_基本設計仕様書(商品管理).xlsx','0205_基本設計仕様書(店頭買取管理).xlsx']:
    p=root/name
    print(p.name)
    wb=load_workbook(p, read_only=False, data_only=False)
    for i, ws in enumerate(wb.worksheets,1):
        print(f'{i:02d}\\t{ws.title}\\t{ws.max_row}x{ws.max_column}\\timages={len(ws._images)}')
    wb.close()
