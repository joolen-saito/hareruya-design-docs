exec
/bin/bash -lc "uv run python -u - <<'PY'
from openpyxl import load_workbook
p='input/0204_基本設計仕様書(商品管理).xlsx'
wb=load_workbook(p, read_only=True, data_only=False)
checks={
'商品登録編集':['処理概要','画面項目','商品名(英)','商品名（英）','商品カテゴリ','購入グループ','サイズ','重量','割引率','販売制限','画像','スマレジ','商品公開ステータス'],
'商品タグ更新CSV登録':['処理概要','商品ID','タグ','CSV','データベース','テーブル'],
'高額商品価格変更CSVアップロード':['処理概要','画面部品','商品コード','セールフラグ','入力チェック','エラー','CSV'],
'カテゴリ一覧':['処理概要','表示制御','保存','ログ','並び順'],
}
for s,terms in checks.items():
    ws=wb[s]
    print('\\n###',s)
    for row in ws.iter_rows():
        hits=[]
        for c in row:
            if c.value is None: continue
            v=str(c.value).replace('\\n',' / ')
            if any(t in v for t in terms): hits.append(f'{c.coordinate}={v[:240]}')
        if hits: print(' | '.join(hits))
wb.close()
