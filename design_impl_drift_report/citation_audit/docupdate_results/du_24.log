from openpyxl import load_workbook
from pathlib import Path
p=Path('input/0214_基本設計仕様書(イベント管理).xlsx')
wb=load_workbook(p, read_only=True, data_only=False)
targets=['イベント申込一覧(検索結果) ','イベント申込一括編集','デッキ表示','イベント申込詳細・編集','イベント申込登録(検索入力) ','イベント申込登録(検索結果) ','イベント新規申込登録','イベント一括登録CSV']
for name in targets:
    ws=wb[name]
    print('\\n###',name,'max',ws.max_row,ws.max_column)
    for row in ws.iter_rows():
        vals=[]
        for c in row:
            if c.value is not None and str(c.value).strip()"'!='"'':
                s=str(c.value).replace('\\n','\\\\n')
                if len(s)>240:s=s[:237]+'...'
                vals.append(f'{c.coordinate}={s}')
        if vals:
            print(' | '.join(vals))
