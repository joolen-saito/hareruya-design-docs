画面文言系はテキスト表だけで済むか、Excel貼付画像の差し替えが必要かで工数が大きく変わるため、該当シートの埋め込み画像も確認しています。特に正本Excelで厳密文言が欠けている完了・エラー画面を重点確認します。
exec
/bin/bash -lc "uv run python - <<'PY'
from html.parser import HTMLParser
from pathlib import Path
import base64, re
html=Path('output/0306_基本設計仕様書(フロント_会員).html').read_text()
class P(HTMLParser):
    def __init__(self):
        super().__init__(); self.sheet=None; self.n={}
    def handle_starttag(self, tag, attrs):
        a=dict(attrs)
        if tag=='section' and a.get('id','').startswith('sheet-') and a['id'].count('-')==1:
            self.sheet=a['id']
        if tag=='img' and self.sheet in {'sheet-4','sheet-12','sheet-17','sheet-19','sheet-20'}:
            src=a.get('src','');
            if src.startswith('data:image/'):
                m=re.match(r'data:image/(["'^;]+);base64,(.*)'"',src,re.S)
                if m:
                    ext={'jpeg':'jpg','svg+xml':'svg'}.get(m.group(1),m.group(1))
                    i=self.n.get(self.sheet,0)+1; self.n[self.sheet]=i
                    p=Path('/tmp')/f'du28_{self.sheet}_{i}.{ext}'
                    p.write_bytes(base64.b64decode(m.group(2)))
                    print(p, a.get('alt',''))
p=P(); p.feed(html)
