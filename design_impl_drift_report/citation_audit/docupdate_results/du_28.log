[project]
name = "excel-to-html"
version = "0.1.0"
description = "Convert Excel workbooks to readable, self-contained tabbed HTML files."
requires-python = ">=3.10"
dependencies = [
    "openpyxl>=3.1.0",
    "Pillow>=10.0.0",
]

[tool.uv]
package = false

