for s in ['画像設定','祝日管理','販売割引率一覧','買取価格対応表(一覧)','買取価格対応表(編集)','買取減額率一覧']:
    ws=wb[s]
    print('\\n###',s)
    for row in ws.iter_rows():
        vals=[]
        for c in row:
            if c.value not in (None,''):
                v=str(c.value).replace('\\n',' / ')
                if len(v)>180:v=v[:177]+'...'
                vals.append(f'{c.coordinate}={v}')
        if vals: print(' | '.join(vals))
