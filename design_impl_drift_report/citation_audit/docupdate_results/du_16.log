import zipfile, xml.etree.ElementTree as ET, re
from pathlib import Path
NS={'m':'http://schemas.openxmlformats.org/spreadsheetml/2006/main','r':'http://schemas.openxmlformats.org/officeDocument/2006/relationships','pr':'http://schemas.openxmlformats.org/package/2006/relationships'}

def load_book(path):
  z=zipfile.ZipFile(path)
  root=ET.fromstring(z.read('xl/workbook.xml'))
  relroot=ET.fromstring(z.read('xl/_rels/workbook.xml.rels'))
  rels={e.attrib['Id']:e.attrib['Target'] for e in relroot}
  ss=[]
  if 'xl/sharedStrings.xml' in z.namelist():
    sr=ET.fromstring(z.read('xl/sharedStrings.xml'))
    for si in sr.findall('m:si',NS): ss.append(''.join(t.text or '' for t in si.iter('{%s}t'%NS['m'])))
  sheets=[]
  for i,s in enumerate(root.find('m:sheets',NS),0):
    target=rels[s.attrib['{%s}id'%NS['r']]]
    target='xl/'+target.lstrip('/') if not target.startswith('xl/') else target
    sheets.append((i,s.attrib['name'],target))
  return z,ss,sheets

def cells(z,ss,target):
  root=ET.fromstring(z.read(target)); out={}
  for c in root.findall('.//m:sheetData/m:row/m:c',NS):
    ref=c.attrib.get('r'); typ=c.attrib.get('t'); v=c.find('m:v',NS)
    if typ=='inlineStr':
      val=''.join(t.text or '' for t in c.findall('.//m:t',NS))
    elif v is None: val=''
    elif typ=='s': val=ss[int(v.text)]
    else: val=v.text or ''
    if val.strip(): out[ref]=val.replace('\\n',' / ')
  return out
books=[
('/home/y-saito/Developments/hareruya-design-docs/excel_to_html/input/0207_基本設計仕様書(会員管理機能).xlsx', {'メール一括送信','メール一括送信確認','メール一括送信完了','ポイント付与（余剰入金へのご返金、注文金額変更によるご返金','オンライン本人確認','顧客グループ管理','ブラックリスト管理','配送先情報CSV登録'}),
('/home/y-saito/Developments/hareruya-design-docs/excel_to_html/input/0208_基本設計仕様書(カード管理).xlsx', {'画像ダウンロード(セット別)','画像ダウンロード(言語別)'})]
for bp,targets in books:
  z,ss,sheets=load_book(bp)
  print('\\nBOOK',Path(bp).name)
  for idx,name,target in sheets:
    if name not in targets: continue
    cs=cells(z,ss,target)
    byrow={}
    for ref,val in cs.items(): byrow.setdefault(int(re.search(r'\\d+',ref).group()),[]).append((ref,val))
    print(f'\\nSHEET html#sheet-{idx} {name} {target} nonempty={len(cs)}')
    for row in sorted(byrow):
      txt=' | '.join(f'{ref}={val}' for ref,val in byrow[row])
      print(txt)
