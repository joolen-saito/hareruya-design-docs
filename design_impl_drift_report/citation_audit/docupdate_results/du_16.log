import zipfile, xml.etree.ElementTree as ET, posixpath
from pathlib import Path
R='http://schemas.openxmlformats.org/officeDocument/2006/relationships'
P='http://schemas.openxmlformats.org/package/2006/relationships'
S='http://schemas.openxmlformats.org/spreadsheetml/2006/main'
X='http://schemas.openxmlformats.org/drawingml/2006/spreadsheetDrawing'
A='http://schemas.openxmlformats.org/drawingml/2006/main'
for bp,sheetnums in [('/home/y-saito/Developments/hareruya-design-docs/excel_to_html/input/0207_基本設計仕様書(会員管理機能).xlsx',[6,7,8,13,19,21,22,26]),('/home/y-saito/Developments/hareruya-design-docs/excel_to_html/input/0208_基本設計仕様書(カード管理).xlsx',[11,12])]:
 z=zipfile.ZipFile(bp); print('\\n',Path(bp).name)
 for sn in sheetnums:
  sp=f'xl/worksheets/sheet{sn}.xml'; rp=f'xl/worksheets/_rels/sheet{sn}.xml.rels'
  root=ET.fromstring(z.read(sp)); dr=root.find('{%s}drawing'%S)
  if dr is None: print('sheet',sn,'no drawing'); continue
  rid=dr.attrib['{%s}id'%R]
  rr=ET.fromstring(z.read(rp)); target=next(e.attrib['Target'] for e in rr if e.attrib['Id']==rid)
  dp=posixpath.normpath(posixpath.join(posixpath.dirname(sp),target))
  drrp=posixpath.join(posixpath.dirname(dp),'_rels',posixpath.basename(dp)+'.rels')
  drels={e.attrib['Id']:e.attrib['Target'] for e in ET.fromstring(z.read(drrp))} if drrp in z.namelist() else {}
  droot=ET.fromstring(z.read(dp)); pics=[]; shapes=0
  for anc in list(droot):
   fr=anc.find('{%s}from'%X)
   anchor='?'
   if fr is not None:
    anchor=f\"r{int(fr.find('{%s}row'%X).text)+1}c{int(fr.find('{%s}col'%X).text)+1}\"
   pic=anc.find('{%s}pic'%X)
   if pic is not None:
    blip=pic.find('.//{%s}blip'%A); erid=blip.attrib.get('{%s}embed'%R) if blip is not None else None
    media=posixpath.normpath(posixpath.join(posixpath.dirname(dp),drels.get(erid,''))) if erid else '?'
    pics.append((anchor,media))
   if anc.find('{%s}sp'%X) is not None: shapes+=1
  print('sheet',sn,dp,'pics',pics,'shapes',shapes)
