/bin/bash -lc "python3 - <<'PY'
from zipfile import ZipFile
from xml.etree import ElementTree as ET
p='input/0202_基本設計仕様書(在庫管理機能).xlsx'
ns={'xdr':'http://schemas.openxmlformats.org/drawingml/2006/spreadsheetDrawing','a':'http://schemas.openxmlformats.org/drawingml/2006/main','r':'http://schemas.openxmlformats.org/officeDocument/2006/relationships'}
with ZipFile(p) as z:
    root=ET.fromstring(z.read('xl/drawings/drawing18.xml'))
    rel=ET.fromstring(z.read('xl/drawings/_rels/drawing18.xml.rels'))
    rm={e.attrib['Id']:e.attrib['Target'] for e in rel}
    for i,anchor in enumerate(list(root),1):
        f=anchor.find('xdr:from',ns); t=anchor.find('xdr:to',ns)
        def pos(x):
            if x is None:return '?'
            return f\"r{int(x.find('xdr:row',ns).text)+1}c{int(x.find('xdr:col',ns).text)+1}\"
        pic=anchor.find('xdr:pic',ns); sp=anchor.find('xdr:sp',ns)
        if pic is not None:
            name=pic.find('xdr:nvPicPr/xdr:cNvPr',ns).attrib.get('name')
            blip=pic.find('xdr:blipFill/a:blip',ns)
            rid=blip.attrib.get('{%s}embed'%ns['r']) if blip is not None else None
            print(i,'PIC',pos(f),pos(t),name,rid,rm.get(rid))
        elif sp is not None:
            name=sp.find('xdr:nvSpPr/xdr:cNvPr',ns).attrib.get('name')
            txt=' / '.join((e.text or '') for e in sp.findall('.//a:t',ns))
            print(i,'SHAPE',pos(f),pos(t),name,txt[:300])
        else:
            print(i,'OTHER',anchor.tag,pos(f),pos(t))
PY" in /home/y-saito/Developments/hareruya-design-docs/excel_to_html
