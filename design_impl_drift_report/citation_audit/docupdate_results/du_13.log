def dump(name,a,b):
 print('\\n###',name,a,b)
 ws=wb[name]
 for row in ws.iter_rows(min_row=a,max_row=b):
  vals=[]
  for c in row:
   if c.value not in (None,''):
    s=str(c.value).replace('\\n',' / ')
    if len(s)>240:s=s[:237]+'...'
    vals.append(f'{c.coordinate}={s}')
  if vals: print(' | '.join(vals))
