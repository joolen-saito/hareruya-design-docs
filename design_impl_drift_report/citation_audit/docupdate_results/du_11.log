  if 'xl/sharedStrings.xml' in z.namelist():
   root=ET.fromstring(z.read('xl/sharedStrings.xml'))
   ss=[''.join(t.text or '' for t in si.iter(f'{{{NSM}}}t')) for si in root.findall(f'{{{NSM}}}si')]
  wb=ET.fromstring(z.read('xl/workbook.xml')); rr=ET.fromstring(z.read('xl/_rels/workbook.xml.rels')); rel={x.attrib['Id']:x.attrib['Target'] for x in rr}
  sm={s.attrib['name']:normpath('xl/'+rel[s.attrib[f'{{{NSR}}}id']].lstrip('/')) for s in wb.find(f'{{{NSM}}}sheets')}
