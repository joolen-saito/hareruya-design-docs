   sr=ET.fromstring(z.read(sm[sn])); vals={}
   for c in sr.iter(f'{{{NSM}}}c'):
    typ=c.attrib.get('t'); v=c.find(f'{{{NSM}}}v'); val=''
    if typ=='s' and v is not None: val=ss[int(v.text)]
