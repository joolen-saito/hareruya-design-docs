with zipfile.ZipFile(p) as z:
 for n in [2,4,5,6,8]:
  root=ET.fromstring(z.read(f'xl/drawings/drawing{n}.xml'))
  print('\\nDRAWING',n)
  for anc in list(root):
   fr=anc.find('xdr:from',ns); to=anc.find('xdr:to',ns)
   def pos(e):
    if e is None:return None
    return (int(e.find('xdr:col',ns).text)+1,int(e.find('xdr:row',ns).text)+1)
   pic=anc.find('xdr:pic',ns); shape=anc.find('xdr:sp',ns)
   if pic is not None:
    name=pic.find('xdr:nvPicPr/xdr:cNvPr',ns).attrib.get('name')
    blip=pic.find('xdr:blipFill/a:blip',ns)
    rid=blip.attrib.get('{%s}embed'%ns['r']) if blip is not None else None
    print('PIC',name,rid,'from',pos(fr),'to',pos(to))
   elif shape is not None:
    name=shape.find('xdr:nvSpPr/xdr:cNvPr',ns).attrib.get('name')
    texts=[t.text for t in shape.findall('.//a:t',ns) if t.text]
    print('SHAPE',name,'from',pos(fr),'to',pos(to),'text',' / '.join(texts)[:100])
   else:
    print('OTHER',anc.tag,'from',pos(fr),'to',pos(to))
