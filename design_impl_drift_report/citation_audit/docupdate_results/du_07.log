from openpyxl import load_workbook
from pathlib import Path
cases=[
('0502','ポップアップ用商品情報取得（旧商品ID）',['404','productId','レスポンス','Not Found','cardId']),
('0505','注文印刷_印刷情報をプリンタへ送信',['ConnectionType','GetRequest','SetResponse','エンドポイント']),
('0506','本人確認更新',['identification','エンドポイント','URL']),
('0517','記事IDに関連する記事情報を取得',['wp_post_id','deleted_at','論理削除','関連記事']),
]
root=Path('input')
for prefix,sheet,terms in cases:
 p=next(root.glob(prefix+'*.xlsx'))
 wb=load_workbook(p, read_only=False, data_only=False)
 ws=wb[sheet]
 print('\\n###',p.name,'/',sheet)
 hits=[]
 for row in ws.iter_rows():
  for c in row:
   v=c.value
   if v is not None and any(t.lower() in str(v).lower() for t in terms):
    hits.append(c)
 print('hits',[(c.coordinate,str(c.value)[:120].replace('\\n',' / ')) for c in hits])
 rows=sorted(set(c.row for c in hits))
 for rn in rows:
  print('ROW',rn,[(c.coordinate,str(c.value).replace('\\n',' / ')[:250]) for c in ws[rn] if c.value is not None])
