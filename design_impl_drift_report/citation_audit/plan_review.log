03e\n\n                                                                                \u003c/div\u003e\n                    \u003c/div\u003e\n                \u003c/div\u003e\n            \u003c/div\u003e\n        \u003c/div\u003e\n        \u003cdiv class\u003d\"c-conversionArea\" id\u003d\"aside_column\"\u003e\n            \u003cdiv class\u003d\"c-conversionArea__container\"\u003e\n                \u003cdiv class\u003d\"row justify-content-between align-items-center\"\u003e\n                    \u003cdiv class\u003d\"col-6\"\u003e\n                        \u003cdiv class\u003d\"c-conversionArea__leftBlockItem\"\u003e\n                        \u003c/div\u003e\n                    \u003c/div\u003e\n                    \u003cdiv class\u003d\"col-6\"\u003e\n                        \u003cdiv id\u003d\"ex-conversion-action\" class\u003d\"row align-items-center justify-content-end\"\u003e\n                            \u003cdiv class\u003d\"col-auto\"\u003e\n                                \u003cbutton class\u003d\"btn btn-ec-conversion px-5\" type\u003d\"submit\"\u003e登録\u003c/button\u003e\n                            \u003c/div\u003e\n                        \u003c/div\u003e\n                    \u003c/div\u003e\n                \u003c/div\u003e\n            \u003c/div\u003e\n        \u003c/div\u003e\n    \u003c/form\u003e\n\n    \u003c!-- HTMLメールを確認するモーダル --\u003e\n    \u003cdiv class\u003d\"modal fade\" id\u003d\"htmlPreviewModal\" tabindex\u003d\"-1\" role\u003d\"dialog\" aria-labelledby\u003d\"htmlPreviewModal\" aria-hidden\u003d\"true\" data-bs-keyboard\u003d\"false\" data-bs-backdrop\u003d\"static\"\u003e\n        \u003cdiv class\u003d\"modal-dialog modal-lg\" role\u003d\"document\"\u003e\n            \u003cdiv class\u003d\"modal-content\"\u003e\n                \u003cdiv class\u003d\"modal-header\"\u003e\n                    \u003ch5 class\u003d\"modal-title fw-bold\"\u003eプレビュー\u003c/h5\u003e\n                    \u003cbutton class\u003d\"btn-close\" type\u003d\"button\" data-bs-dismiss\u003d\"modal\" aria-label\u003d\"Close\"\u003e\u003c/button\u003e\n                \u003c/div\u003e\n                \u003cdiv class\u003d\"modal-body\"\u003e\n                    \u003cdiv class\u003d\"bg-light p-4 bg-ec-formGray\" id\u003d\"viewEmail\" style\u003d\"word-wrap: break-word; word-break:break-all\"\u003e\n\n                    \u003c/div\u003e\n                \u003c/div\u003e\n                \u003cdiv class\u003d\"modal-footer\"\u003e\n                    \u003cbutton class\u003d\"btn btn-ec-sub\" type\u003d\"button\" data-bs-dismiss\u003d\"modal\"\u003e閉じる\u003c/button\u003e\n                \u003c/div\u003e\n            \u003c/div\u003e\n        \u003c/div\u003e\n    \u003c/div\u003e\n    \u003c!-- 削除モーダル --\u003e\n        \u003cdiv class\u003d\"modal fade\" id\u003d\"deleteModal\" tabindex\u003d\"-1\"\n         role\u003d\"dialog\"\n         aria-labelledby\u003d\"deleteModal\" aria-hidden\u003d\"true\"\u003e\n        \u003cdiv class\u003d\"modal-dialog\" role\u003d\"document\"\u003e\n            \u003cdiv class\u003d\"modal-content\"\u003e\n                \u003cdiv class\u003d\"modal-header\"\u003e\n                    \u003ch5 class\u003d\"modal-title fw-bold\"\u003e\n                        メールテンプレートを削除します。\u003c/h5\u003e\n                    \u003cbutton class\u003d\"btn-close\" type\u003d\"button\"\n                            data-bs-dismiss\u003d\"modal\"\n                            aria-label\u003d\"Close\"\u003e\n                    \u003c/button\u003e\n                \u003c/div\u003e\n                \u003cdiv class\u003d\"modal-body text-start\"\u003e\n                    \u003cp class\u003d\"text-start\"\u003e\n                        メールテンプレートを削除してよろしいですか？\u003c/p\u003e\n                \u003c/div\u003e\n                \u003cdiv class\u003d\"modal-footer\"\u003e\n                    \u003cbutton class\u003d\"btn btn-ec-sub\" type\u003d\"button\" data-bs-dismiss\u003d\"modal\"\u003eキャンセル\n                    \u003c/button\u003e\n                    \u003ca class\u003d\"btn btn-ec-delete\"\n                       href\u003d\"https://ec-cube/admin/setting/shop/mail/10/delete\"\n                        token-for-anchor\u003d\u002714ba4163f25758ef4dc0c482bc77.m6nkH1y1mFjLjRR_7-4vFTgFajGVZTxLM1BVCwnpziM.-eKQWQns8AH55kYen4oaRnxGCGXQVgQKUDczPz6bhGzeyrNnC-bsMrHscw\u0027\n                       data-method\u003d\"delete\" data-confirm\u003d\"false\"\u003e\n                        削除\n                    \u003c/a\u003e\n                \u003c/div\u003e\n            \u003c/div\u003e\n        \u003c/div\u003e\n    \u003c/div\u003e\n    \n    \u003c/div\u003e\n\u003c/div\u003e\n\u003cscript\u003e\nvar eccube_lang \u003d {\n    \u0027common.delete_confirm\u0027: \"削除してもよろしいですか?\",\n    \u0027front.product.out_of_stock\u0027: \"ただいま品切れ中です。\",\n};\n\u003c/script\u003e\n\u003cscript src\u003d\"/html/template/admin/assets/js/function.js\"\u003e\u003c/script\u003e\n    \u003cscript\u003e\n        $(function() {\n\n            $(window).on(\u0027pageshow\u0027, function() {\n                var tmp_select \u003d  $(\u0027#mail_template[name\u003d\"mail[template]\"] option[selected]\u0027).val();\n                $(\u0027#mail_template[name\u003d\"mail[template]\"]\u0027).val(tmp_select);\n            });\n\n            $(\u0027#mail_template\u0027).on(\u0027change\u0027, function() {\n                var id \u003d $(this).val()\n                if (id) {\n                    location.href \u003d \u0027https://ec-cube/admin/setting/shop/mail/\u0027 + id;\n                } else {\n                    location.href \u003d \u0027https://ec-cube/admin/setting/shop/mail\u0027;\n                }\n            });\n\n            ace.require(\u0027ace/ext/language_tools\u0027);\n            var editor \u003d ace.edit(\u0027editor\u0027);\n            editor.session.setMode(\u0027ace/mode/twig\u0027);\n            editor.setTheme(\u0027ace/theme/tomorrow\u0027);\n            editor.setValue(\"test\");\n            editor.setOptions({\n                enableBasicAutocompletion: true,\n                enableSnippets: true,\n                enableLiveAutocompletion: true,\n                showInvisibles: true\n            });\n\n            var html_editor \u003d ace.edit(\u0027html_editor\u0027);\n            html_editor.session.setMode(\u0027ace/mode/twig\u0027);\n            html_editor.setTheme(\u0027ace/theme/tomorrow\u0027);\n            html_editor.setValue(\"test\");\n            html_editor.setOptions({\n                enableBasicAutocompletion: true,\n                enableSnippets: true,\n                enableLiveAutocompletion: true,\n                showInvisibles: true\n            });\n\n            $(\"#editor\").resizable({\n                resize: function (event, ui) {\n                    editor.resize();\n                }\n            });\n\n            $(\"#html_editor\").resizable({\n                resize: function (event, ui) {\n                    editor.resize();\n                }\n            });\n\n            $(\u0027#form1\u0027).on(\u0027submit\u0027, function() {\n                $(\u0027#mail_tpl_data\u0027).val(editor.getValue());\n                $(\u0027#mail_html_tpl_data\u0027).val(html_editor.getValue());\n            });\n\n            // HTMLメールモーダル表示\n            $(\u0027#htmlPreviewModal\u0027).on(\u0027show.bs.modal\u0027, function (event) {\n                var html \u003d $(\u0027#viewEmail\u0027);\n                html.children().remove();\n\n                // HTMLを読み込んでモーダルに表示\n                $.ajax({\n                    type: \u0027POST\u0027,\n                    dataType: \u0027html\u0027,\n                    data: {\n                        \u0027html_body\u0027 : html_editor.getValue(),\n                    },\n                    url: \u0027https://ec-cube/admin/setting/shop/mail/preview\u0027,\n                    success: function(data) {\n                        // モーダルに結果を書き出し.\n                        $(\u0027#viewEmail\u0027).html(data);\n                    },\n                    error: function() {\n                        alert(\u0027preview html mail failed.\u0027);\n                    }\n                });\n            });\n\n            $(\u0027a[data-bs-toggle\u003d\"tab\"]\u0027).on(\u0027shown.bs.tab\u0027, function (e) {\n                var activated_tab \u003d e.target;\n                var id \u003d $(activated_tab).attr(\u0027id\u0027);\n                if (id \u003d\u003d \u0027menu__mail_html_tpl_data\u0027) {\n                    $(\u0027#preview_button\u0027).attr(\u0027style\u0027, \u0027display:blocked;\u0027);\n                } else {\n                    $(\u0027#preview_button\u0027).attr(\u0027style\u0027, \u0027display:none;\u0027);\n                }\n            });\n        });\n    \u003c/script\u003e\n\n\u003cdiv id\u003d\"sfwdt90d054\" class\u003d\"sf-toolbar sf-display-none\" role\u003d\"region\" aria-label\u003d\"Symfony Web Debug Toolbar\"\u003e    \u003c!-- START of Symfony Web Debug Toolbar --\u003e\u003cdiv id\u003d\"sfMiniToolbar-90d054\" class\u003d\"sf-minitoolbar\" data-no-turbolink data-turbo\u003d\"false\"\u003e    \u003cbutton type\u003d\"button\" title\u003d\"Show Symfony toolbar\" id\u003d\"sfToolbarMiniToggler-90d054\" accesskey\u003d\"D\" aria-expanded\u003d\"false\" aria-controls\u003d\"sfToolbarMainContent-90d054\"\u003e        \u003csvg xmlns\u003d\"http://www.w3.org/2000/svg\" width\u003d\"24\" height\u003d\"24\" viewBox\u003d\"0 0 24 24\"\u003e\u003cpath fill\u003d\"currentColor\" d\u003d\"M12 .9C5.8.9.9 5.8.9 12a11 11 0 1 0 22.2 0A11 11 0 0 0 12 .9zm6.5 6c-.6 0-.9-.3-.9-.8 0-.2 0-.4.2-.6l.2-.4c0-.3-.5-.4-.6-.4-1.8.1-2.3 2.5-2.7 4.4l-.2 1c1 .2 1.8 0 2.2-.3.6-.4-.2-.7-.1-1.2.1-.3.5-.5.7-.6.5 0 .7.5.7.9 0 .7-1 1.8-3 1.8l-.6-.1-.6 2.4c-.4 1.6-.8 3.8-2.4 5.7-1.4 1.7-2.9 1.9-3.5 1.9-1.2 0-1.9-.6-2-1.5 0-.8.7-1.3 1.2-1.3.6 0 1.1.5 1.1 1s-.2.6-.4.6c-.1.1-.3.2-.3.4 0 .1.1.3.4.3.5 0 .8-.3 1.1-.5 1.2-.9 1.