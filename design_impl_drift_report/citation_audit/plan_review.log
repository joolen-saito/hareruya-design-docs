/bin/bash -lc "awk -F '\\t' '
function add(k,v){c[k]++; s[k]+=v; if(v>m[k])m[k]=v}
NR>1 && "'$60!="NONE" && $60!="" && $60!="UNSURE" {
 bad=substr($13,1,60); add(bad,$61+0)
