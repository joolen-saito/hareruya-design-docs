namespace Eccube\Repository;

use Doctrine\Persistence\ManagerRegistry;
use Eccube\Entity\BaseInfo;
use Eccube\Entity\DtbDailySummary;
use Eccube\Entity\DtbStockHistory;
use Eccube\Entity\Master\MtbStockChangeType;
use Eccube\Entity\Master\MtbStockChangeTypeDetail;
use Eccube\Entity\Master\OrderItemType;

/**
 * @extends AbstractRepository<DtbDailySummary>
 */
class DtbDailySummaryRepository extends AbstractRepository
{
    public function __construct(ManagerRegistry $registry)
    {
        parent::__construct($registry, DtbDailySummary::class);
    }

    /**
     * 日次集計向けに、受注金額・原価・販売数量・販売件数を店舗(base_info)ごとに集計する。
     * 総売上(order_amount_order)は値引き前金額（ポイント・クーポン値引きは考慮しない）に送料・手数料を含めた額。
     *
     * @return array<int, array<string, mixed>>
     */
    public function aggregateOrderSummaryByBaseInfo(\DateTimeInterface $from, \DateTimeInterface $to): array
    {
        return $this->getEntityManager()->getConnection()->fetchAllAssociative(
            <<<'SQL'
SELECT
    o.base_info_id,
    COALESCE(SUM(o.subtotal + o.delivery_fee_total + o.charge), 0) AS order_amount_order,
    COALESCE(SUM(order_cost.total_cost), 0) AS cost,
    COALESCE(SUM(order_cost.sale_quantity), 0) AS sale_quantity,
    COUNT(o.id) AS buyer_count
FROM dtb_order o
LEFT JOIN (
    SELECT
        oi.order_id,
        COALESCE(SUM(oi.total_cost), 0) AS total_cost,
        -- 販売数量は商品明細の数量のみを合算する（送料・手数料・値引き・ポイント明細の数量は含めない）
        COALESCE(SUM(CASE WHEN oi.order_item_type_id = :productItemTypeId THEN oi.quantity ELSE 0 END), 0) AS sale_quantity
    FROM dtb_order_item oi
    GROUP BY oi.order_id
) order_cost ON order_cost.order_id = o.id
WHERE
    o.base_info_id IS NOT NULL
    AND o.order_date >= :summaryDateFrom
    AND o.order_date <= :summaryDateTo
GROUP BY o.base_info_id
SQL,
            [
                'summaryDateFrom' => $from->format('Y-m-d H:i:s'),
                'summaryDateTo' => $to->format('Y-m-d H:i:s'),
                'productItemTypeId' => OrderItemType::PRODUCT,
            ]
        );
    }

    /**
     * 日次集計向けに、買取件数・買取金額を集計する。
     * ネット買取(dtb_buy_order)は本店(root)に集約し、店頭買取(dtb_otc_buy_order)は店舗ごとに集計する。
     * 集計日(申込日)はネット買取が order_date、店頭買取が apply_date で絞り込む。
     *
     * @return array<int, array<string, mixed>>
     */
    public function aggregatePurchaseSummaryByBaseInfo(int $rootBaseInfoId, \DateTimeInterface $from, \DateTimeInterface $to): array
    {
        return $this->getEntityManager()->getConnection()->fetchAllAssociative(
            <<<'SQL'
SELECT
    purchase_base.base_info_id,
    SUM(purchase_base.purchase_count) AS purchase_count,
    SUM(purchase_base.purchase_amount) AS purchase_amount
FROM (
    SELECT
        CAST(:rootBaseInfoId AS INTEGER) AS base_info_id,
        COUNT(bo.id) AS purchase_count,
        COALESCE(
            SUM(
                CEIL(
                    (
                        COALESCE(main_card_sum.main_total, 0)
                        + COALESCE(indiv_sum.indiv_total, 0)
                    ) / 10.0
                ) * 10
            ),
            0
        ) AS purchase_amount
    FROM dtb_buy_order bo
    LEFT JOIN (
        SELECT
            bmc.buy_order_id,
            SUM(
                CASE
                    WHEN bmc.sale_flg THEN COALESCE(bmc.price, 0) * COALESCE(bmc."count", 0)
                    ELSE 0
                END
            ) AS main_total
        FROM dtb_buy_main_card bmc
        GROUP BY bmc.buy_order_id
    ) main_card_sum ON main_card_sum.buy_order_id = bo.id
    LEFT JOIN (
        SELECT
            biip.buy_order_id,
            SUM(
                CASE
                    WHEN biip.sale_flg THEN COALESCE(biip.price, 0) * COALESCE(biip.quantity, 0)
                    ELSE 0
                END
            ) AS indiv_total
        FROM dtb_buy_order_indivisual_input_product biip
        GROUP BY biip.buy_order_id
    ) indiv_sum ON indiv_sum.buy_order_id = bo.id
    WHERE
        bo.auto_approval_flg = TRUE
        AND bo.order_date >= :summaryDateFrom
        AND bo.order_date <= :summaryDateTo
    GROUP BY base_info_id

    UNION ALL

    SELECT
        obo.base_info_id,
        COUNT(obo.id) AS purchase_count,
        COALESCE(SUM(obo.total_price), 0) AS purchase_amount
    FROM dtb_otc_buy_order obo
    WHERE
        obo.base_info_id IS NOT NULL
        AND obo.cancel_date IS NULL
        AND obo.apply_date >= :summaryDateFrom
        AND obo.apply_date <= :summaryDateTo
    GROUP BY obo.base_info_id
) purchase_base
GROUP BY purchase_base.base_info_id
SQL,
            [
                'summaryDateFrom' => $from->format('Y-m-d H:i:s'),
                'summaryDateTo' => $to->format('Y-m-d H:i:s'),
                'rootBaseInfoId' => $rootBaseInfoId,
            ]
        );
    }

    /**
     * 日次集計向けに、廃棄数量を店舗(base_info)ごとに集計する。
     * - 在庫変動区分が廃棄(MtbStockChangeType::DISPOSAL)の在庫履歴が対象
     * - 詳細区分のうち「廃棄(他事業移動)」「廃棄(イベント商品)」は対象外
     * - 集計日は在庫変動履歴の登録日(registered_at)
     * - 在庫変動履歴は減算分がマイナスで入るため、合計を符号反転してプラスにする
     *   （廃棄(却下)による戻しは正の値で入り、ここで差し引かれる）
     *
     * @return array<int, array<string, mixed>>
     */
    public function aggregateDisposalQuantityByBaseInfo(\DateTimeInterface $from, \DateTimeInterface $to): array
    {
        $qb = $this->getEntityManager()->createQueryBuilder();

        return $qb
            ->select('IDENTITY(sh.baseInfo) AS base_info_id')
            ->addSelect('(0 - COALESCE(SUM(sh.stockChangeQuantity), 0)) AS waste_quantity')
            ->from(DtbStockHistory::class, 'sh')
            ->innerJoin('sh.StockChangeTypeDetail', 'sctd')
            ->where('IDENTITY(sctd.StockChangeType) = :disposalTypeId')
            ->andWhere($qb->expr()->notIn('sctd.id', ':excludedDisposalDetailIds'))
            ->andWhere('sh.registeredAt >= :summaryDateFrom')
            ->andWhere('sh.registeredAt <= :summaryDateTo')
            ->groupBy('sh.baseInfo')
            ->setParameter('disposalTypeId', MtbStockChangeType::DISPOSAL)
            ->setParameter('excludedDisposalDetailIds', [
                MtbStockChangeTypeDetail::DISPOSAL_OTHER_BUSINESS_TRANSFER,
                MtbStockChangeTypeDetail::DISPOSAL_EVENT_PRODUCT,
            ])
            ->setParameter('summaryDateFrom', $from)
            ->setParameter('summaryDateTo', $to)
            ->getQuery()
            ->getResult();
    }

    /**
     * 日次集計向けに、欠品数量を店舗(base_info)ごとに集計する。
     * - 詳細区分が「欠品減算(受注)」「欠品加算(移動)」の在庫履歴が対象
     * - 集計日は在庫変動履歴の登録日(registered_at)
     * - 在庫変動履歴は減算分がマイナスで入るため、合計を符号反転してプラスにする
     *
     * @return array<int, array<string, mixed>>
     */
    public function aggregateShortageQuantityByBaseInfo(\DateTimeInterface $from, \DateTimeInterface $to): array
    {
        $qb = $this->getEntityManager()->createQueryBuilder();

        return $qb
            ->select('IDENTITY(sh.baseInfo) AS base_info_id')
            ->addSelect('(0 - COALESCE(SUM(sh.stockChangeQuantity), 0)) AS shortage_quantity')
            ->from(DtbStockHistory::class, 'sh')
            ->where($qb->expr()->in('IDENTITY(sh.StockChangeTypeDetail)', ':shortageDetailIds'))
            ->andWhere('sh.registeredAt >= :summaryDateFrom')
            ->andWhere('sh.registeredAt <= :summaryDateTo')
            ->groupBy('sh.baseInfo')
            ->setParameter('shortageDetailIds', [
                MtbStockChangeTypeDetail::ORDER_STOCKOUT_DECREASE,
                MtbStockChangeTypeDetail::MOVE_SHORTAGE_ADD,
            ])
            ->setParameter('summaryDateFrom', $from)
            ->setParameter('summaryDateTo', $to)
            ->getQuery()
            ->getResult();
    }

    /**
     * 月次集計向けに、期間内の日次集計を店舗(base_info)ごとに合算する。
     * sale_average は合算値ではないため呼び出し側で算出する。
     *
     * @return array<int, array<string, mixed>>
     */
    public function aggregateMonthlyTotalsByBaseInfo(\DateTimeInterface $from, \DateTimeInterface $to): array
    {
        return $this->createQueryBuilder('d')
            ->select('IDENTITY(d.BaseInfo) AS base_info_id')
            ->addSelect('COALESCE(SUM(d.grossSales), 0) AS gross_sales')
            ->addSelect('COALESCE(SUM(d.totalCost), 0) AS total_cost')
            ->addSelect('COALESCE(SUM(d.grossProfit), 0) AS gross_profit')
            ->addSelect('COALESCE(SUM(d.saleQuantity), 0) AS sale_quantity')
            ->addSelect('COALESCE(SUM(d.saleCount), 0) AS sale_count')
     *
     * @return array<int, array<string, int|float|string>>
     */
    private function fetchDailySummary(
        \DateTimeInterface $dateFrom,
        \DateTimeInterface $dateTo,
        array $targetBaseInfoIds,
        bool $mailOrderEnabled,
    ): array {
        $from = \DateTimeImmutable::createFromInterface($dateFrom)->setTime(0, 0, 0);
        $to = \DateTimeImmutable::createFromInterface($dateTo)->setTime(23, 59, 59);
        if ($from > $to) {
            [$from, $to] = [$to, $from];
        }

        $rowsRaw = $this->dtbDailySummaryRepository->fetchSummaryRowsByDateRangeAndTargets($from, $to, $targetBaseInfoIds);
        $rows = [];
        foreach ($rowsRaw as $raw) {
            $storeName = $this->resolveStoreName(
                (int) ($raw['base_info_id'] ?? 0),
                (string) ($raw['short_name_jp'] ?? ''),
                (string) ($raw['shop_name'] ?? ''),
                $mailOrderEnabled
            );
            $summaryDate = $raw['summary_date'];
            $rows[] = [
                'order_date' => $summaryDate instanceof \DateTimeInterface
                    ? $summaryDate->format('Y/m/d')
                    : (new \DateTime($summaryDate !== null ? (string) $summaryDate : 'now'))->format('Y/m/d'),
                'store_name' => $storeName,
                'order_amount_order' => (int) ($raw['gross_sales'] ?? 0),
                'cost' => (int) ($raw['total_cost'] ?? 0),
                'gross_profit' => (int) ($raw['gross_profit'] ?? 0),
                'order_count_order' => (int) ($raw['sale_quantity'] ?? 0),
                'buyer_count' => (int) ($raw['sale_count'] ?? 0),
                'order_average_order' => self::calcOrderAverage(
                    (int) ($raw['gross_sales'] ?? 0),
                    (int) ($raw['sale_count'] ?? 0),
                ),
                'purchase_count' => (int) ($raw['purchase_count'] ?? 0),
                'purchase_amount' => (int) ($raw['purchase_amount'] ?? 0),
                'discard_count' => (int) ($raw['waste_count'] ?? 0),
                'out_of_stock_count' => (int) ($raw['shortage_count'] ?? 0),
            ];
        }

        return $rows;
    }

    /**
     * @param list<int> $targetBaseInfoIds
     *
     * @return array<int, array<string, int|float|string>>
     */
    private function fetchMonthlySummary(
        \DateTimeInterface $dateFrom,
        \DateTimeInterface $dateTo,
        array $targetBaseInfoIds,
        bool $mailOrderEnabled,
    ): array {
        $from = \DateTimeImmutable::createFromInterface($dateFrom)->modify('first day of this month')->setTime(0, 0, 0);
        $to = \DateTimeImmutable::createFromInterface($dateTo)->modify('first day of this month')->setTime(0, 0, 0);
        if ($from > $to) {
            [$from, $to] = [$to, $from];
        }

        $rowsRaw = $this->dtbMonthlySummaryRepository->fetchSummaryRowsByMonthRangeAndTargets($from, $to, $targetBaseInfoIds);

        $rows = [];
        foreach ($rowsRaw as $raw) {
            $storeName = $this->resolveStoreName(
                (int) ($raw['base_info_id'] ?? 0),
                (string) ($raw['short_name_jp'] ?? ''),
                (string) ($raw['shop_name'] ?? ''),
                $mailOrderEnabled
            );
            $rows[] = [
                'order_date' => (new \DateTime((string) $raw['summary_month']))->format('Y/n'),
                'store_name' => $storeName,
                'order_amount_order' => (int) ($raw['gross_sales'] ?? 0),
                'cost' => (int) ($raw['total_cost'] ?? 0),
                'gross_profit' => (int) ($raw['gross_profit'] ?? 0),
                'order_count_order' => (int) ($raw['sale_quantity'] ?? 0),
                'buyer_count' => (int) ($raw['sale_count'] ?? 0),
                'order_average_order' => self::calcOrderAverage(
                    (int) ($raw['gross_sales'] ?? 0),
                    (int) ($raw['sale_count'] ?? 0),
                ),
                'purchase_count' => (int) ($raw['purchase_count'] ?? 0),
                'purchase_amount' => (int) ($raw['purchase_amount'] ?? 0),
                'discard_count' => (int) ($raw['waste_count'] ?? 0),
                'out_of_stock_count' => (int) ($raw['shortage_count'] ?? 0),
            ];
        }

        return $rows;
    }

    /**
     * @param array<int, array<string, int|float|string>> $summary
     * @param array<string, string> $resultColumns
     *
     * @return array<string, int|float|string>
     */
    private function buildTotal(array $summary, array $resultColumns): array
    {
        $total = [];
        foreach (array_keys($resultColumns) as $key) {
            $total[$key] = match ($key) {
                'store_name' => '',
                'order_average_order' => 0.0,
            // 他画面（在庫一覧等）からのクエリパラメータをセッションにマージ
            if ($request->query->has('product_code') || $request->query->has('stock_location_id') || $request->query->has('base_info_id')) {
                $mergeData = $this->session->get($sessionKeySearch, []);
                if ($request->query->has('product_code')) {
                    $mergeData['product_name'] = $request->query->get('product_code');
                }
                if ($request->query->has('stock_location_id')) {
                    $mergeData['stock_location_id'] = [$request->query->get('stock_location_id')];
                }
                if ($request->query->has('base_info_id')) {
                    $mergeData['base_info'] = [$request->query->get('base_info_id')];
                }
                $this->session->set($sessionKeySearch, $mergeData);
                $this->session->set($sessionKeyPageNo, 1);
                $pageNo = 1;
            }

            if ($pageNo > 0 || $request->get('resume')) {
                /*
                 * ページ送りの場合または、他画面から戻ってきた場合は, セッションから検索条件を復旧する.
                 */
                if ($pageNo) {
                    // ページ送りで遷移した場合.
                    $this->session->set($sessionKeyPageNo, (int) $pageNo);
                } else {
                    // 他画面から遷移した場合.
                    $pageNo = $this->session->get($sessionKeyPageNo, 1);
                }
                $viewData = $this->session->get($sessionKeySearch, []);
                $searchData = FormUtil::submitAndGetData($searchForm, $viewData);
            } else {
                /**
                 * 初期表示の場合.
                 */
                $pageNo = 1;
                // submit default value
                $viewData = FormUtil::getViewData($searchForm);
                $searchData = FormUtil::submitAndGetData($searchForm, $viewData);

                // セッション中の検索条件, ページ番号を初期化.
                $this->session->set($sessionKeySearch, $viewData);
                $this->session->set($sessionKeyPageNo, $pageNo);

                return [
                    'form' => $searchForm->createView(),
                    'pagination' => [],
                    'pageMaxis' => $pageMaxis,
                    'pageNo' => $pageNo,
                    'page_count' => $pageCount,
                    'has_errors' => false,
                    'has_search_details' => true,
                    'has_search_disposal' => false,
                    'display_mode' => $displayMode,
                    'stockChangeReasonDisplayBuilder' => $this->stockChangeReasonDisplayBuilder,
                ];
            }
        }

        $qb = $this->stockHistoryRepository->getQueryBuilderBySearchDataForAdmin($searchData);

        $event = new EventArgs(
            [
                'qb' => $qb,
                'searchData' => $searchData,
            ],
            $request
        );
        $this->eventDispatcher->dispatch($event, EccubeEvents::ADMIN_STOCK_HISTORY_NEW_SEARCH);

        $pagination = $paginator->paginate(
            $qb,
                                            {% endfor %}
                                        </div>
                                    </form>
                                </div>
                            </div>
                        </div>
                        <div id="stockHistoryList" class="card rounded border-0 mb-4 d-block scroll-table">
                            <div class="card-body p-0">
                                <div class=" scroll-body">
                                    <table class="table table-sm">
                                        <thead>
