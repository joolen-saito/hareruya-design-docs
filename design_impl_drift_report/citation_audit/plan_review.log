}
END{
 for(k in c){bg++; if(c[k]>1){bmg++; bmr+=c[k]}; bsave+=0.5*(s[k]-m[k])}
 for(k in gc){gg++; if(gc[k]>1){gmg++; gmr+=gc[k]}; gsave+=0.5*(gs[k]-gm[k])}
 printf "prefix60 groups=%d multi_groups=%d multi_rows=%d B2_saving=%.3f'"\\n\",bg,bmg,bmr,bsave
 printf \"canonical groups=%d multi_groups=%d multi_rows=%d B2_saving=%.3f\\n\",gg,gmg,gmr,gsave
}' design_impl_drift_report/drift_findings_list_effort.tsv
