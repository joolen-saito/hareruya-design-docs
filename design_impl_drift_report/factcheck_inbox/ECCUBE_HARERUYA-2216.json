      "ok": true,
      "reason": "in_range",
      "excerpt": "        const setDeckRegisterLimit = () => {\n            if (!$(id.deckRegistFlg).prop('checked')) {\n                $(id.deckRegistDeadline).val('');\n                return;\n            }\n            const startDate = $(id.startDate).val();\n            if (!startDate) {\n                $(id.deckRegistDeadline).val('');\n                return;\n            }\n            const formattedDate = moment(startDate).hours(23).minutes(59).format('YYYY-MM-DD HH:mm');\n            $(id.deckRegistDeadline).val(formattedDate);\n        };"
