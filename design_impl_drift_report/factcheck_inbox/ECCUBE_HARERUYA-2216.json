      "excerpt": "        const changeRegist = () => {\n            const deckRegistFlg = $(id.deckRegistFlg).prop('checked');\n            $('.deckRegist').toggle(deckRegistFlg);\n            $(id.deckRegistDeadline).prop('disabled', !deckRegistFlg);\n        };"
    },
