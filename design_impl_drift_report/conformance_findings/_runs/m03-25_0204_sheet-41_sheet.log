    /**
     * 重複商品コード確認画面
     *
     * @return array{products: array<string, array<int, string>>}
     */
    #[Route(path: '/%eccube_admin_route%/product/doubling_check', name: 'admin_product_doubling_check', methods: ['GET'])]
    #[Template(template: '@admin/Product/doubling_check.twig')]
    public function doublingCheck(): array
    {
        return [
            'products' => $this->buildDoublingCodeEditUrls($this->productClassRepository->getDoublingCode()),
        ];
    }

    /**
     * @param array<int, array{code: string, product_id: string|int, product_class_id: string|int}> $rows
     *
     * @return array<string, array<int, string>>
     */
    private function buildDoublingCodeEditUrls(array $rows): array
    {
        $products = [];
        foreach ($rows as $row) {
            $products[$row['code']][] = $this->generateUrl('admin_product_product_class_edit', [
                'id' => (int) $row['product_id'],
                'productClassId' => (int) $row['product_class_id'],
            ]);
        }

        return $products;
    }

