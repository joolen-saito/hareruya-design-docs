 succeeded in 0ms:
     1	#!/bin/bash -l
     2	
     3	lockfile=/var/tmp/eccube-enterprise-sync-lock
     4	
     5	DATE=$(date "+%Y-%m-%d")
     6	# APP_ENV がdevの場合は、/etc/hostname からコンテナ ID を取得
     7	# ECS_CONTAINER_METADATA_URI が設定されている場合は、メタデータからコンテナ ID を取得
     8	# それ以外の場合は、unknown とする
     9	if [ "${APP_ENV}" = "dev" ]; then
    10	    CONTAINER_ID=$(cat /etc/hostname)
    11	elif [ -n "${ECS_CONTAINER_METADATA_URI}" ]; then
    12	    CONTAINER_ID=$(curl -s ${ECS_CONTAINER_METADATA_URI}/task | jq -r '.Containers[0].DockerId')
    13	else
    14	    CONTAINER_ID="unknown"
    15	fi
    16	
    17	# ログストリーム名とロググループ名を設定
    18	LOG_STREAM_NAME="/ecs/${AWS_CDK_PREFIX}-s3-sync-cron-logs-${DATE}-${CONTAINER_ID}"
    19	LOG_GROUP_NAME="/ecs/${AWS_CDK_PREFIX}-s3-sync-cron-logs-group"
    20	
    21	# ログストリームが存在しない場合は作成
    22	if ! /usr/local/bin/aws logs describe-log-streams --log-group-name "$LOG_GROUP_NAME" --log-stream-name-prefix "$LOG_STREAM_NAME" | grep -q "$LOG_STREAM_NAME"; then
    23	    /usr/local/bin/aws logs create-log-stream --log-group-name "$LOG_GROUP_NAME" --log-stream-name "$LOG_STREAM_NAME"
    24	fi
    25	
    26	function printAndSendToCloudWatch {
    27	    local message="$1"
    28	    timestamp=$(date +%s%3N)
    29	    # メッセージが空の場合は CloudWatch に送信しない
    30	    if [ -z "$message" ]; then
    31	        return
    32	    fi
    33	    # タイムスタンプとインスタンス ID をメッセージに追加
    34	    message="[$(date "+%Y-%m-%dT%H:%M:%S%:z")] [$CONTAINER_ID] $message"
    35	    # メッセージ内のダブルクォートをエンコードして、JSON パースの問題を回避
    36	    message=$(jq -Rn --arg str "$message" '$str | @json')
    37	    # ローカルログに出力
    38	    echo "$message"
    39	    # CloudWatch にログを送信
    40	    /usr/local/bin/aws logs put-log-events --log-group-name "$LOG_GROUP_NAME" --log-stream-name "$LOG_STREAM_NAME" --log-events "[{\"timestamp\": $timestamp, \"message\": $message}]" > /dev/null
    41	}
    42	
    43	printAndSendToCloudWatch "S3 Sync Started..."
