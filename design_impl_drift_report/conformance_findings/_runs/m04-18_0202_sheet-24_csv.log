 succeeded in 0ms:
     * CSV ファイル名を生成する
     *
     * @param string $prefix
     */
    protected function createFileName(string $prefix): string
    {
        return $prefix.(new \DateTime())->format('YmdHis').'.csv';
    }

    /**
     * レスポンスに CSV 用ヘッダーを設定する
     *
     * @param Response $response
     * @param string $fileName
     */
    protected function setCsvResponseHeader(Response $response, string $fileName): void
    {
        $innerEncoding = $this->eccubeConfig['eccube_csv_export_encoding'] ?? 'SJIS-win';
        $encoding = strcasecmp($innerEncoding, 'SJIS-win') === 0 ? 'windows-31j' : $innerEncoding;
        $response->headers->set('Content-Type', 'text/csv;charset='.$encoding);
        $response->headers->set('Content-Disposition', 'attachment; filename='.$fileName);
    }


