class StockHistoryController extends AbstractController
{
    /**
     * @var array<int, mixed>
     */
    private array $errors = [];

    public function __construct(
        protected ProductStockRepository $productStockRepository,
        protected DtbStockHistoryRepository $stockHistoryRepository,
        protected ProductClassRepository $productClassRepository,
        protected ProductRepository $productRepository,
        protected PageMaxRepository $pageMaxRepository,
        protected CsvExportService $csvExportService,
        protected StockChangeReasonDisplayBuilder $stockChangeReasonDisplayBuilder,
    ) {
    }

    /**
     * 在庫履歴検索/一覧 画面表示
     *
     * @param int|null $page_no
     * @param int|null $page_count
     *
     * @return array<string,mixed>
     */
    #[Route(path: '/%eccube_admin_route%/product/stock/history', name: 'admin_stock_history', methods: ['GET', 'POST'])]
    #[Route(path: '/%eccube_admin_route%/product/stock/history/page/{page_no}', name: 'admin_stock_history_page', requirements: ['page_no' => '\d+'], methods: ['POST', 'GET'])]
    #[Route(path: '/%eccube_admin_route%/product/stock/history/page/{page_no}/count/{page_count}', name: 'admin_stock_history_page_count', requirements: ['page_no' => '\d+'], methods: ['POST', 'GET'])]
    #[Template(template: '@admin/Stock/history.twig')]
    public function new(Request $request, PaginatorInterface $paginator, $page_no = null, $page_count = null): array
    {
        $session = $this->session;

        $builder = $this->formFactory->createBuilder(StockHistoryType::class, null, [
        ]);
        $searchForm = $builder->getForm();

        $Member = $this->getMember();

        /**
         * ページの表示件数は, 以下の順に優先される.
         * - リクエストパラメータ
         * - セッション
         * - デフォルト値
         * また, セッションに保存する際は mtb_page_maxと照合し, 一致した場合のみ保存する.
         **/
        $sessionKeyPageNo = 'eccube.admin.stock.stock_history.pageNo';
        $sessionKeyPageCount = 'eccube.admin.stock.stock_history.page_count';
        $sessionKeyDisplayMode = 'eccube.admin.stock.stock_history.display_mode';
        $sessionKeySearch = 'eccube.admin.stock.stock_history.search';

        $pageNo = (int) ($page_no ?? $session->get($sessionKeyPageNo, 1));
        $pageCount = (int) ($page_count ?? $session->get($sessionKeyPageCount, $this->eccubeConfig['eccube_default_page_count']));

        $pageCountParam = (int) $request->get('page_count');
        $pageMaxis = $this->pageMaxRepository->findAll();

        if ($pageCountParam) {
            foreach ($pageMaxis as $pageMax) {
                if ($pageCountParam == $pageMax->getName()) {
                    $pageCount = $pageMax->getName();
                    $this->session->set($sessionKeyPageCount, $pageCount);
                    break;
                }
            }
        }

        /**
         * 表示データ切り替えは, 以下の順に優先される.
         * - リクエストパラメータ
         * - セッション
         **/
        $displayMode = $this->session->get($sessionKeyDisplayMode);
        $displayModeParam = (int) $request->get('mode');
        if ($displayModeParam) {
            $displayMode = $displayModeParam;
            $this->session->set($sessionKeyDisplayMode, $displayMode);
        }

        if ($request->getMethod() === 'POST') {
            $searchForm->handleRequest($request);
            $hasSearchDisposal = !empty($searchForm['disposal_search']) ? true : false;

            if ($searchForm->isValid()) {
                /**
                 * 検索が実行された場合は, セッションに検索条件を保存する.
                 * ページ番号は最初のページ番号に初期化する.
                 */
                $pageNo = 1;
                $searchData = $searchForm->getData();

                // 検索条件, ページ番号をセッションに保持.
                $this->session->set($sessionKeySearch, FormUtil::getViewData($searchForm));
                $this->session->set($sessionKeyPageNo, $pageNo);
            } else {
                // 検索エラーの際は, 詳細検索枠を開いてエラー表示する.
                return [
                    'form' => $searchForm->createView(),
                    'pagination' => [],
                    'pageMaxis' => $pageMaxis,
                    'pageNo' => $pageNo,
                    'page_count' => $pageCount,
                    'has_errors' => true,
                    'has_search_details' => true,
                    'has_search_disposal' => $hasSearchDisposal,
                    'display_mode' => $displayMode,
                    'stockChangeReasonDisplayBuilder' => $this->stockChangeReasonDisplayBuilder,
                ];
            }
        } else {
            if ($pageNo > 0 || $request->get('resume')) {
                /*
                 * ページ送りの場合または、他画面から戻ってきた場合は, セッションから検索条件を復旧する.
                 */
                if ($pageNo) {
                    // ページ送りで遷移した場合.
                    $this->session->set($sessionKeyPageNo, (int) $pageNo);
                } else {
                    // 他画面から遷移した場合.
                    $pageNo = $this->session->get($sessionKeyPageNo, 1);
                }
                $viewData = $this->session->get($sessionKeySearch, []);
                $searchData = FormUtil::submitAndGetData($searchForm, $viewData);
            } else {
                /**
                 * 初期表示の場合.
                 */
                $pageNo = 1;
                // submit default value
                $viewData = FormUtil::getViewData($searchForm);
                $searchData = FormUtil::submitAndGetData($searchForm, $viewData);

                // セッション中の検索条件, ページ番号を初期化.
                $this->session->set($sessionKeySearch, $viewData);
                $this->session->set($sessionKeyPageNo, $pageNo);

                return [
                    'form' => $searchForm->createView(),
                    'pagination' => [],
                    'pageMaxis' => $pageMaxis,
                    'pageNo' => $pageNo,
                    'page_count' => $pageCount,
                    'has_errors' => false,
                    'has_search_details' => true,
                    'has_search_disposal' => false,
                    'display_mode' => $displayMode,
                    'stockChangeReasonDisplayBuilder' => $this->stockChangeReasonDisplayBuilder,
                ];
            }
        }

        $qb = $this->stockHistoryRepository->getQueryBuilderBySearchDataForAdmin($searchData);

        $pagination = $paginator->paginate(
            $qb,
            (int) $pageNo,
            (int) $pageCount
        );

        $hasSearchDisposal = !empty($searchData['disposal_search']) ? true : false;

        // 全件データ for CSV出力
        $PaginationAll = $qb->getQuery()->getResult();

        return [
            'form' => $searchForm->createView(),
            'pagination' => $pagination,
            'PaginationAll' => $PaginationAll,
            'pageMaxis' => $pageMaxis,
            'pageNo' => $pageNo,
            'page_count' => $pageCount,
            'has_errors' => true,
            'has_search_details' => true,
            'has_search_disposal' => $hasSearchDisposal,
            'display_mode' => $displayMode,
            'stockChangeReasonDisplayBuilder' => $this->stockChangeReasonDisplayBuilder,
        ];
    }

    /**
     * 欠品理由の編集
     *
     * @return RedirectResponse|array<mixed>
     */
    #[Route(
        path: '/%eccube_admin_route%/product/stock/history/updated',
        name: 'admin_stock_history_update',
        methods: ['POST']
    )
    ]
    public function update(Request $request): RedirectResponse|array
    {
        // タイムアウトを無効にする
        set_time_limit(0);

        $builder = $this->formFactory->createBuilder(StockHistoryDisposalType::class, null, []);
        $form = $builder->getForm();
        $form->handleRequest($request);
        $formData = $form->getData();
        $Member = $this->getMember();

        log_info('欠品理由の編集');

        try {
            $inputs = [
                'stockHistoryId' => (int) $formData['stock_history_id'],
                'disposalReason' => (string) $formData['disposal_reason'],
                'memberId' => (int) $Member->getId(),
            ];
            $this->stockHistoryRepository->updateDisposalReason($inputs);
        } catch (\Exception $e) {
            $this->addError('admin.common.save_error', 'admin');

            return $this->redirectToRoute('admin_stock_history');
        }

        $this->addSuccess('admin.common.save_complete', 'admin');

        return $this->redirectToRoute('admin_stock_history');
    }

    /**
     * 在庫履歴CSV出力
     *
     * @param Request $request
     *
     * @return StreamedResponse|RedirectResponse
     */
    #[Route(path: '/%eccube_admin_route%/product/stock/history/csv_export', name: 'admin_stock_history_csv_export', methods: ['POST'])]
    public function csvStockHistoryExport(Request $request): StreamedResponse|RedirectResponse
    {
        $params = $request->request->all();
        $ids = $params['ids'] ?? [];
        $stockHistoryIds = \is_array($ids)
            ? array_values(array_filter(array_map('intval', $ids), fn (int $id): bool => $id > 0))
            : [];

        if ($stockHistoryIds === []) {
            return $this->responseNoStockHistoryIdError($request);
        }

        set_time_limit(0);
        $this->entityManager->getConfiguration()->setSQLLogger(null);

        $stockHistoryCsv = new StockHistoryCsv(
            $this->entityManager,
            $this->translator,
            $this->eccubeConfig,
            $this->stockHistoryRepository,
            $this->csvExportService,
            $this->productRepository,
            $this->productClassRepository,
            $this->productStockRepository,
            $this->getStockHistoryCsvHeader(),
            $this->getRequiredStockHistoryCsvHeader()
        );

        try {
            return $stockHistoryCsv->exportCsv($stockHistoryIds);
        } catch (\RuntimeException $e) {
            $this->addError($e->getMessage(), 'admin');
            $referer = $request->headers->get('referer');
            if ($referer !== null && $referer !== '') {
                return $this->redirect($referer);
            }

            return $this->redirectToRoute('admin_stock_history');
        }
    }

    /**
     * 欠品履歴CSV出力
     *
     * @param Request $request
     *
     * @return StreamedResponse|RedirectResponse
     */
    #[Route(path: '/%eccube_admin_route%/product/stock/history/disposal/csv_export', name: 'admin_stock_history_disposal_csv_export', methods: ['POST'])]
