    private function responseNoStockHistoryIdError(Request $request): RedirectResponse
    {
        $this->addError('eccube.admin.error', $this->translator->trans('admin.stock_history.not_select'));
        $pageNo = $request->getSession()->get('eccube.admin.stock_history.search.page_no', 1);

        return $this->redirectToRoute('admin_stock_history_page', ['page_no' => $pageNo]);
    }

    /**
     * エラー画面表示
     */
    protected function addErrors(string $message): void
    {
        $this->errors[] = $message;
    }

    /**
     * @return string[]
     */
    protected function getErrors(): array
    {
        return $this->errors;
    }
}

