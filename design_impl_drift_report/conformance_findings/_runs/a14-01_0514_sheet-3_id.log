    31	#[MappedSuperclass]
    32	abstract class AbstractEntity implements \ArrayAccess
    33	{
    34	    #[\ReturnTypeWillChange]
    35	    #[\Override]
    36	    public function offsetExists($offset): bool
    37	    {
    38	        $inflector = new Inflector(new NoopWordInflector(), new NoopWordInflector());
    39	        $method = $inflector->classify($offset);
    40	
    41	        return method_exists($this, $method)
    42	            || method_exists($this, "get$method")
    43	            || method_exists($this, "is$method")
    44	            || method_exists($this, "has$method");
    45	    }
    46	
    47	    #[\ReturnTypeWillChange]
    48	    #[\Override]
    49	    public function offsetSet($offset, $value): void
    50	    {
    51	    }
    52	
    53	    #[\ReturnTypeWillChange]
    54	    #[\Override]
    55	    public function offsetGet($offset): mixed
    56	    {
    57	        $inflector = new Inflector(new NoopWordInflector(), new NoopWordInflector());
    58	        $method = $inflector->classify($offset);
    59	
    60	        if (method_exists($this, $method)) {
    61	            return $this->$method();
    62	        } elseif (method_exists($this, "get$method")) {
    63	            return $this->{"get$method"}();
    64	        } elseif (method_exists($this, "is$method")) {
    65	            return $this->{"is$method"}();
    66	        } elseif (method_exists($this, "has$method")) {
    67	            return $this->{"has$method"}();
    68	        }
    69	
    70	        return null;
    71	    }
    72	
    73	    #[\ReturnTypeWillChange]
    74	    #[\Override]
    75	    public function offsetUnset($offset): void
