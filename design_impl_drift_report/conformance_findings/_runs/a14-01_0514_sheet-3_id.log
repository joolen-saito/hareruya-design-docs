   129	     */
   130	    public function getBuyingCardsByCardName(
   131	        string $cardName,
   132	        int $storeId,
   133	        int $stockLocationId,
   134	    ): array {
   135	        $result = $this->buildBuyingCardsQuery($storeId, $stockLocationId)
   136	            ->andWhere('product.name LIKE :cardName')
   137	            ->setParameter('cardName', $cardName.'%')
   138	            ->getQuery()
   139	            ->getResult();
   140	
   141	        return GetBuyingCardsQueryResponseDto::fromDqlResult($result);
