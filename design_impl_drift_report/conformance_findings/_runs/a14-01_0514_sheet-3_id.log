   107	    public function getBuyingCardsByProductIds(
   108	        array $productIds,
   109	        int $storeId,
   110	        int $stockLocationId,
   111	    ): array {
   112	        $result = $this->buildBuyingCardsQuery($storeId, $stockLocationId)
   113	            ->andWhere('product.id IN (:productIds)')
   114	            ->setParameter('productIds', $productIds)
