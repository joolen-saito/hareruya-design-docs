   348	            ->join('o.OrderItems', 'oi')
   349	            ->select('ss', 'o', 'oi')
   350	            ->where('ss.id = :id')
   351	            ->setParameter('id', $id)
   352	            ->getQuery()
   353	            ->getOneOrNullResult();
   354	
   355	        if ($result === null) {
