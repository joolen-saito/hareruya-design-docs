    /**
     * 出荷指示リスト 納品書印刷
     *
     * @param Request $request
     * @param int $id
     * @param string $lang
     *
     * @return Response
     */
    #[Route(path: '/%eccube_admin_route%/standby/{id}/print/delivery/{lang}', name: 'admin_shipping_standby_print_delivery_slips', requirements: ['id' => '\d+', 'lang' => 'ja|en'], methods: ['GET', 'POST'])]
    public function printDeliverySlips(Request $request, int $id, string $lang): Response
    {
        $ShippingStandby = $this->shippingStandbyRepository->findOneById($id);
        if ($ShippingStandby === null) {
            throw $this->createNotFoundException();
        }

        $orderIdList = array_keys($request->get('order_ids', []));

        if ($orderIdList === []) {
            throw $this->createNotFoundException();
        }

        $shippingIdList = [];
        // 印刷対象を絞り込む
        foreach ($ShippingStandby->getOrders() as $Order) {
            $orderId = $Order->getId();
            // 注文IDが無効、または画面でチェックされたIDリストに含まれていない場合はスキップ
            if ($orderId === null || !in_array($orderId, $orderIdList, true)) {
                continue;
            }
            // 対象注文に紐づく配送情報を取得
            foreach ($Order->getShippings() as $Shipping) {
                $shippingId = $Shipping->getId();
                if ($shippingId !== null) {
                    // 配送IDをキーにしてリストに追加
                    $shippingIdList[$shippingId] = $shippingId;
                }
            }
        }

        if ($shippingIdList === []) {
            throw $this->createNotFoundException();
        }

        $DeliverySlips = $this->shippingStandbyRepository->generateDeliverySlips($lang !== 'ja', $shippingIdList);
        $BaseInfo = $this->baseInfoRepository->getMallBaseInfo();

        return $this->render("@admin/ShippingStandby/delivery_slips.{$lang}.twig", [
            'DeliverySlips' => $DeliverySlips,
            'BaseInfo' => $BaseInfo,
        ]);
    }
}

