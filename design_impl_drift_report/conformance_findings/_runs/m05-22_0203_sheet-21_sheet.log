{% block javascript %}
    <script nonce="{{ csp_nonce }}">
        $(function() {
            // ピッキングリスト印刷
            $('#printPickingList').on('click', function(event) {
                window.open('', 'newwin', 'toolbar=no, location=no, directories=no, status=no, menubar=no, scrollbars=yes, resizable=yes, width=700, height=700');
                $('#form_bulk').attr('action', "{{ url('admin_shipping_standby_print_picking_list', { 'id' : shippingStandby.id }) }}");
                $('#form_bulk').attr('target', 'newwin');
                $('#form_bulk').append($('<input>', { type: 'hidden', name: 'id', value: 'ja' }));
                $('#form_bulk').submit();
                return false;
            });
            // 納品書印刷(日本語)
            $('#printDeliverySlipsJp').on('click', function(event) {
                window.open('', 'newwin', 'toolbar=no, location=no, directories=no, status=no, menubar=no, scrollbars=yes, resizable=yes, width=700, height=700');
                $('#form_bulk').attr('action', "{{ url('admin_shipping_standby_print_delivery_slips' ,{'id' : shippingStandby.id, 'lang' : 'ja' }) }}");
                $('#form_bulk').attr('target', 'newwin');
                $('#form_bulk').submit();
                return false;
            });
            // 納品書印刷(英語)
            $('#printDeliverySlipsEn').on('click', function(event) {
                window.open('', 'newwin', 'toolbar=no, location=no, directories=no, status=no, menubar=no, scrollbars=yes, resizable=yes, width=700, height=700');
                $('#form_bulk').attr('action', "{{ url('admin_shipping_standby_print_delivery_slips' ,{'id' : shippingStandby.id, 'lang' : 'en' }) }}");
                $('#form_bulk').attr('target', 'newwin');
                $('#form_bulk').submit();
                return false;
            });
            // 出荷実績入力用CSV出力
            $('#orderExportForInput').on('click', function(event) {
                $('#form_bulk').removeAttr('target');
                $('#form_bulk').attr('action', "{{ url('admin_order_export_for_input') }}");
                $('#form_bulk').submit();
                return false;
            });
            // 送り状CSV出力
            $('#labelsExport').on('click', function(event) {
                $('#form_bulk').removeAttr('target');
                $('#form_bulk').attr('action', "{{ url('admin_labels_export') }}");
                $('#form_bulk input[name="ids[]"]').remove();
                $('#form_bulk input[type="checkbox"][name^="order_ids"]:checked').each(function() {
                    var shippingId = $(this).data('shipping-id');
                    if (shippingId) {
                        $('#form_bulk').append($('<input>', {
                            type: 'hidden',
                            name: 'ids[]',
                            value: shippingId
                        }));
                    }
                });
                $('#form_bulk').submit();
                return false;
            });
        });
    </script>
{% endblock javascript %}
