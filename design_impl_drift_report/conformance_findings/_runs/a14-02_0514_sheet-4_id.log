  1266	        <div class="sheet-doc">
  1267	          <dl class="doc-card">
  1268	            <div class="kv"><dt>ドキュメント名</dt><dd>カード管理API機能</dd></div>
  1269	            <div class="kv"><dt>セクション</dt><dd>—</dd></div>
  1270	            <div class="kv"><dt>プロジェクト名</dt><dd>サイトリニューアル</dd></div>
  1271	            <div class="kv"><dt>作成者</dt><dd>加島</dd></div>
  1272	            <div class="kv"><dt>作成日</dt><dd>2025-09-12</dd></div>
