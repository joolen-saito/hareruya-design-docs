   101	    /**
   102	     * カード詳細IDからカード詳細1件を検索する。
   103	     *
   104	     * エンティティではなく配列の形式で返すことで、メモリの消費を抑える。
   105	     * バッチ処理のときに使用するとよい。
   106	     *
   107	     * @param int $cardDetailId カード詳細ID
   108	     *
   109	     * @return array<string, mixed> カード詳細情報
   110	     *
   111	     * @throws EntityNotFoundException カード詳細情報が見つからなかった場合
   112	     */
   113	    public function findByIdNative(int $cardDetailId): array
   114	    {
   115	        $sql = <<<EOT
   116	            SELECT
   117	                cd.id as card_detail_id,
   118	                c.name_en,
   119	                cs.code as cardset_code,
   120	                cd.foil_flg,
   121	                cd.card_no,
   122	                pr.code AS promotion_code
   123	            FROM
   124	                mtb_card_detail cd
   125	                INNER JOIN mtb_card c
   126	                    ON cd.card_id = c.id
   127	                LEFT JOIN mtb_cardset cs
   128	                    ON cd.cardset_id = cs.id
   129	                LEFT JOIN mtb_promotion pr
   130	                    ON cd.promotion_id = pr.id
   131	            WHERE
   132	                cd.id = :cardDetailId
   133	        EOT;
   134	
   135	        $rsm = new ResultSetMapping();
   136	        $rsm->addScalarResult('card_detail_id', 'cardDetailId', Types::INTEGER)
   137	            ->addScalarResult('name_en', 'cardNameEn')
   138	            ->addScalarResult('cardset_code', 'cardsetCode')
   139	            ->addScalarResult('foil_flg', 'foilFlg', Types::INTEGER)
   140	            ->addScalarResult('card_no', 'cardNo')
   141	            ->addScalarResult('promotion_code', 'promotionCode');
   142	
   143	        $result = $this->getEntityManager()
   144	            ->createNativeQuery($sql, $rsm)
   145	            ->setParameter('cardDetailId', $cardDetailId)
   146	            ->getResult();
   147	
   148	        if (count($result) === 1) {
   149	            return current($result);
   150	        }
   151	
   152	        throw new EntityNotFoundException();
   153	    }
