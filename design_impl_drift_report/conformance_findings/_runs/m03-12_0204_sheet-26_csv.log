{% extends '@admin/default_frame.twig' %}

{% set menus = ['product', 'class_category'] %}

{% block title %}{{ 'admin.product.product_management'|trans }}{% endblock %}
{% block sub_title %}{{ 'admin.product.category_list'|trans }}{% endblock %}

{% if Parent is not null or isCategoryEdit|default(false) %}
    {% form_theme form '@admin/Form/bootstrap_4_horizontal_layout.html.twig' %}
{% endif %}

{% block javascript %}
<script nonce="{{ csp_nonce }}">
        $(function() {
            // 初期表示時のsort noを保持.
            var oldSortNos = [];
            $('.sortable-item').each(function() {
                oldSortNos.push(this.dataset.sortNo);
            });
            oldSortNos.sort(function(a, b) {
                return a - b;
            }).reverse();
            // 並び替え後にsort noを更新
            var updateSortNo = function() {
                var newSortNos = {};
                var i = 0;
                $('.sortable-item').each(function() {
                    newSortNos[this.dataset.id] = oldSortNos[i];
                    i++;
                });
                $.ajax({
                    url: '{{ url('admin_product_category_sort_no_move') }}',
                    type: 'POST',
                    data: newSortNos
                }).always(function() {
                    $(".modal-backdrop").remove();
                });
            };
            var redrawDisableAllows = function() {
                var items = $('.sortable-item');
                items.find('a.action-up').removeClass('disabled');
                items.find('a.action-down').removeClass('disabled');
                items.first().find('a.action-up').addClass('disabled');
                items.last().find('a.action-down').addClass('disabled');
            };
            // オーバレイ後, 表示順の更新を行う
            var moveSortNo = function() {
                $('body').append($('<div class="modal-backdrop show"></div>'));
                updateSortNo();
                redrawDisableAllows();
            };
            var categorySortDragConfirmMessage = {{ 'admin.product.category_sort_drag_confirm'|trans|json_encode|raw }};
            var previousSortableOrder = [];
            // Drag and Drop
            $('.sortable-container').sortable({
                items: '> .sortable-item',
                cursor: 'move',
                start: function() {
                    previousSortableOrder = [];
                    $(this).find('.sortable-item').each(function() {
                        previousSortableOrder.push(this.id);
                    });
                },
                update: function(e, ui) {
                    if (!window.confirm(categorySortDragConfirmMessage)) {
                        var container = this;
                        previousSortableOrder.forEach(function(elementId) {
                            var el = document.getElementById(elementId);
                            if (el) {
                                container.appendChild(el);
                            }
                        });
                        return;
                    }
                    moveSortNo();
                }
            });
            // Up
            $('.sortable-item').on('click', 'a.action-up', function(e) {
                e.preventDefault();
                var current = $(this).parents("li");
                if (!current.prev().hasClass('sortable-item')) {
                    return;
                }
                if (!window.confirm(categorySortDragConfirmMessage)) {
                    return;
                }
                current.prev().before(current);
                moveSortNo();
            });
            // Down
            $('.sortable-item').on('click', 'a.action-down', function(e) {
                e.preventDefault();
                var current = $(this).parents("li");
                if (!current.next().hasClass('sortable-item')) {
                    return;
                }
                if (!window.confirm(categorySortDragConfirmMessage)) {
                    return;
                }
                current.next().after(current);
                moveSortNo();
            });

            // 削除モーダルのhrefとmessageの変更
            $('#DeleteModal').on('shown.bs.modal', function(event) {
                var target = $(event.relatedTarget);
                // hrefの変更
                $(this).find('[data-method="delete"]').attr('href', target.data('url'));

                // messageの変更
                $(this).find('p.modal-message').text(target.data('message'));
            });

            {% if allowCategoryImageUpload|default(false) %}
            function categoryImageValidateFile(file) {
                if (!file || !file.type.match(/^image\//)) {
                    return false;
                }
                var ext = (file.name.split('.').pop() || '').toLowerCase();
                return ['gif', 'jpg', 'jpeg', 'png'].indexOf(ext) !== -1;
            }
            function categoryImageSetInputFile(input, file) {
                var dt = new DataTransfer();
                dt.items.add(file);
                input.files = dt.files;
                $(input).trigger('change');
            }
            function initCategoryImageDropzone(inputSelector, dropzoneSelector, listSelector, hintSelector) {
                var $input = $(inputSelector);
                var $dropzone = $(dropzoneSelector);
                var $list = $(listSelector);
                var $hint = $(hintSelector);
                function renderPreview(file) {
                    $list.empty();
                    if (!file || !categoryImageValidateFile(file)) {
                        $hint.show();
                        return;
                    }
                    $hint.hide();
                    var reader = new FileReader();
                    reader.onload = function(e) {
                        $list.append(
                            $('<li style="float: left; margin-right: 10px; margin-bottom: 10px;"></li>').append(
                                $('<img alt="">').attr('src', e.target.result).css({
                                    width: '120px',
                                    height: '160px',
                                    objectFit: 'contain',
                                    padding: '5px'
                                })
                            )
                        );
                    };
                    reader.readAsDataURL(file);
                }
                $input.on('change', function() {
                    var file = this.files && this.files[0];
                    if (file && !categoryImageValidateFile(file)) {
                        this.value = '';
                        renderPreview(null);
                        return;
                    }
                    renderPreview(file || null);
                });
                $dropzone.on('click', function() {
                    var el = $input[0];
                    if (el) {
                        el.click();
                    }
                });
                $dropzone.on('dragover', function(e) {
                    e.preventDefault();
                    e.stopPropagation();
                    $dropzone.addClass('border-primary');
                });
                $dropzone.on('drop', function(e) {
                    e.preventDefault();
                    e.stopPropagation();
                    $dropzone.removeClass('border-primary');
                    var file = e.originalEvent.dataTransfer && e.originalEvent.dataTransfer.files[0];
                    if (!file) {
                        return;
                    }
                    if (!categoryImageValidateFile(file)) {
                        return;
                    }
                    categoryImageSetInputFile($input[0], file);
                });
            }
            initCategoryImageDropzone(
                '#admin_category_banner_image_file',
                '#category-banner-drag-drop-area',
                '#category-banner-thumbnails',
                '#category-banner-dropzone-hint'
            );
            initCategoryImageDropzone(
                '#admin_category_icon_image_file',
                '#category-icon-drag-drop-area',
                '#category-icon-thumbnails',
                '#category-icon-dropzone-hint'
            );
            {% endif %}
        });
    </script>
