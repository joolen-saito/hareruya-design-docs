/**
 * CsvRepository
 *
 * This class was generated by the Doctrine ORM. Add your own custom
 * repository methods below.
 *
 * @extends AbstractRepository<Csv>
 */
class CsvRepository extends AbstractRepository
{
    public function __construct(RegistryInterface $registry)
    {
        parent::__construct($registry, Csv::class);
    }

    /**
     * CSV種別・有効フラグで dtb_csv を取得し、sort_no（表示順 rank）で並べ替える.
     *
     * @return Csv[]
     */
    public function findByCsvTypeIdAndEnabledOrderBySortNo(int $csvTypeId, bool $enabled, string $sort = 'DESC'): array
    {
        $CsvType = $this->getEntityManager()->getReference(CsvType::class, $csvTypeId);
        $direction = strtoupper($sort) === 'ASC' ? 'ASC' : 'DESC';

        return $this->createQueryBuilder('c')
            ->where('c.CsvType = :csvType')
            ->andWhere('c.enabled = :enabled')
            ->setParameter('csvType', $CsvType)
            ->setParameter('enabled', $enabled)
            ->orderBy('c.sort_no', $direction)
            ->getQuery()
            ->getResult();
    }

