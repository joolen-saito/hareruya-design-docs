   115	                'CsvType' => $CsvType,
   116	            ],
   117	            $request
   118	        );
   119	        $this->eventDispatcher->dispatch($event, EccubeEvents::ADMIN_SETTING_SHOP_CSV_INDEX_INITIALIZE);
   120	
   121	        $form = $builder->getForm();
   122	
   123	        // csv_output/csv_not_outputのチェックに引っかかるため, tokenチェックは個別に行う
   124	        if ('POST' === $request->getMethod() && $this->isTokenValid()) {
   125	            $data = $request->get('form');
   126	            if (isset($data['csv_not_output'])) {
   127	                $Csvs = $data['csv_not_output'];
   128	                $sortNo = 1;
   129	                foreach ($Csvs as $csv) {
   130	                    $c = $this->csvRepository->find($csv);
   131	                    $c->setSortNo($sortNo);
   132	                    $c->setEnabled(false);
   133	                    $sortNo++;
   134	                }
   135	            }
   136	
   137	            if (isset($data['csv_output'])) {
   138	                $Csvs = $data['csv_output'];
   139	                $sortNo = 1;
   140	                foreach ($Csvs as $csv) {
   141	                    $c = $this->csvRepository->find($csv);
   142	                    $c->setSortNo($sortNo);
   143	                    $c->setEnabled(true);
   144	                    $sortNo++;
   145	                }
   146	            }
   147	
   148	            $this->entityManager->flush();
   149	
   150	            $event = new EventArgs(
   151	                [
   152	                    'form' => $form,
   153	                    'CsvOutput' => $CsvOutput,
   154	                    'CsvType' => $CsvType,
   155	                ],
   156	                $request
   157	            );
   158	            $this->eventDispatcher->dispatch($event, EccubeEvents::ADMIN_SETTING_SHOP_CSV_INDEX_COMPLETE);
   159	
   160	            $this->addSuccess('admin.common.save_complete', 'admin');
   161	
   162	            return $this->redirectToRoute('admin_setting_shop_csv', ['id' => $CsvType->getId()]);
   163	        }
   164	
   165	        return [
   166	            'form' => $form->createView(),
   167	            'id' => $CsvType->getId(),
   168	        ];
   169	    }
   170	}

