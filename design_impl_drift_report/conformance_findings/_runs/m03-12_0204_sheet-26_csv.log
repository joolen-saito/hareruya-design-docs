    private function assertCategoryNestWithinLimit(Category $TargetCategory): void
    {
        if ($this->eccubeConfig['eccube_category_nest_level'] < $TargetCategory->getHierarchy()) {
            throw new BadRequestHttpException();
        }
    }

    /**
     * @param list<string> $absolutePaths save_image 配下へ移動済みの絶対パス（検証後にのみ削除）
     */
    private function unlinkCategoryImageFiles(array $absolutePaths): void
    {
        $rootReal = realpath(rtrim((string) $this->eccubeConfig['eccube_save_image_dir'], '/\\'));
        if ($rootReal === false) {
            return;
        }
        $rootNorm = str_replace('\\', '/', $rootReal);

        foreach ($absolutePaths as $path) {
            if ($path === '') {
                continue;
            }
            $fileReal = realpath($path);
            if ($fileReal === false || !is_file($fileReal)) {
                continue;
            }
            $fileNorm = str_replace('\\', '/', $fileReal);
            if (!str_starts_with($fileNorm, $rootNorm.'/')) {
                continue;
            }
            @unlink($fileReal);
        }
    }

    /**
     * @return array<string, mixed>
     */
    private function buildCategoryIndexViewData(
        Request $request,
        ?Category $Parent,
        Category $TargetCategory,
        FormInterface $form,
        bool $isCategoryEdit = false,
    ): array {
        $Categories = $this->categoryRepository->getList($Parent);
        $TopCategories = $this->categoryRepository->getList();

        return [
            'form' => $form->createView(),
            'Parent' => $Parent,
            'Ids' => $this->buildBreadcrumbIds($Parent),
            'Categories' => $Categories,
            'TopCategories' => $TopCategories,
            'TargetCategory' => $TargetCategory,
            'isCategoryEdit' => $isCategoryEdit,
            'allowCategoryImageUpload' => $Parent !== null && !$isCategoryEdit,
        ];
    }

    private function resolveCategoryFormActionForUpdate(Category $Category): string
    {
        return $this->generateUrl('admin_product_category_update', [
            'id' => $Category->getId(),
        ]);
    }

    private function resolveCategoryFormActionForCreate(Category $Parent): string
    {
        return $this->generateUrl('admin_product_category_create', [
            'parent_id' => $Parent->getId(),
        ]);
    }

    /**
     * @return int[]
     */
    private function buildBreadcrumbIds(?Category $Parent): array
    {
        $Ids = [];
        if ($Parent && $Parent->getParents()) {
            foreach ($Parent->getParents() as $item) {
                $Ids[] = $item['id'];
            }
        }
        if ($Parent !== null) {
            $Ids[] = (int) $Parent->getId();
        }

        return $Ids;
    }

    /**
     * @return array{0: Category|null, 1: Category}
     */
    private function resolveCategoryContext(?Category $Parent): array
    {
        $TargetCategory = new Category();
        $TargetCategory->setParent($Parent);
        if ($Parent) {
            $TargetCategory->setHierarchy($Parent->getHierarchy() + 1);
        } else {
            $TargetCategory->setHierarchy(1);
        }

        return [$Parent, $TargetCategory];
    }

    private function createCategoryForm(
        Category $TargetCategory,
        ?Category $Parent,
        Request $request,
        ?string $formAction = null,
        bool $allowImageUpload = false,
    ): FormInterface {
        $options = [
            'allow_image_upload' => $allowImageUpload,
        ];
        if ($formAction !== null) {
            $options['action'] = $formAction;
        }
        $builder = $this->formFactory->createBuilder(CategoryType::class, $TargetCategory, $options);
        $event = new EventArgs(
            [
                'builder' => $builder,
                'Parent' => $Parent,
                'TargetCategory' => $TargetCategory,
            ],
            $request
        );
        $this->eventDispatcher->dispatch($event, EccubeEvents::ADMIN_PRODUCT_CATEGORY_INDEX_INITIALIZE);

        return $builder->getForm();
    }

    private function redirectAfterCategorySave(?Category $Parent): RedirectResponse
    {
        if ($Parent) {
            return $this->redirectToRoute('admin_product_category_show', ['parent_id' => $Parent->getId()]);
        }

        return $this->redirectToRoute('admin_product_category');
    }

    /**
     * @param string $id
     *
     * @throws \Exception
     */
    #[Route(path: '/%eccube_admin_route%/product/category/{id}/delete', name: 'admin_product_category_delete', requirements: ['id' => '\d+'], methods: ['DELETE'])]
    public function delete(Request $request, $id, CacheUtil $cacheUtil): RedirectResponse
    {
        $this->isTokenValid();

        $TargetCategory = $this->categoryRepository->find($id);
        if (!$TargetCategory) {
            $this->deleteMessage();

            return $this->redirectToRoute('admin_product_category');
        }
        $Parent = $TargetCategory->getParent();

        log_info('カテゴリ削除開始', [$id]);

        try {
            $this->categoryRepository->delete($TargetCategory);

            $event = new EventArgs(
                [
                    'Parent' => $Parent,
                    'TargetCategory' => $TargetCategory,
                ], $request
            );
            $this->eventDispatcher->dispatch($event, EccubeEvents::ADMIN_PRODUCT_CATEGORY_DELETE_COMPLETE);

            $this->addSuccess('admin.common.delete_complete', 'admin');

            log_info('カテゴリ削除完了', [$id]);

            $cacheUtil->clearDoctrineCache();
        } catch (\Exception $e) {
            log_info('カテゴリ削除エラー', [$id, $e]);

            $message = trans('admin.common.delete_error_foreign_key', ['%name%' => $TargetCategory->getName()]);
            $this->addError($message, 'admin');
        }

        if ($Parent) {
            return $this->redirectToRoute('admin_product_category_show', ['parent_id' => $Parent->getId()]);
        } else {
            return $this->redirectToRoute('admin_product_category');
        }
    }

    /**
     * 一覧の並び順（sort_no）更新（Ajax POST）。カテゴリ新規登録は {@see create} のみ。
     *
     * @throws BadRequestHttpException|\Exception
     */
    #[Route(path: '/%eccube_admin_route%/product/category/sort_no/move', name: 'admin_product_category_sort_no_move', methods: ['POST'])]
    public function moveSortNo(Request $request, CacheUtil $cacheUtil): Response
    {
        if (!$request->isXmlHttpRequest()) {
            throw new BadRequestHttpException();
        }

        if ($this->isTokenValid()) {
            $sortNos = $request->request->all();
            unset($sortNos[Constant::TOKEN_NAME]);

            foreach ($sortNos as $categoryId => $sortNo) {
                /** @var Category $Category */
                $Category = $this->categoryRepository
                    ->find($categoryId);
                $Category->setSortNo((int) $sortNo);
                $this->entityManager->persist($Category);
            }
            $this->entityManager->flush();

            $cacheUtil->clearDoctrineCache();

            return new Response('Successful');
        }

        throw new BadRequestHttpException();
    }

    /**
     * カテゴリCSVの出力.
     */
    #[Route(path: '/%eccube_admin_route%/product/category/export', name: 'admin_product_category_export', methods: ['GET'])]
    public function export(): StreamedResponse
    {
        set_time_limit(0);

        $em = $this->entityManager;
        $em->getConfiguration()->setSQLLogger();

        $Csvs = $this->csvRepository->findByCsvTypeIdAndEnabledOrderBySortNo(
            CsvType::CSV_TYPE_CATEGORY,
            true,
            'ASC',
        );
        $response = new StreamedResponse();
        $response->setCallback(function () use ($Csvs): void {
            $this->csvExportService->fopen();

            $header = [];
            foreach ($Csvs as $Csv) {
                $header[] = $Csv->getDispName();
            }
            $this->csvExportService->fputcsv($header);

            $Categories = $this->categoryRepository->findBy([], ['sort_no' => 'DESC']);
            $categoryIds = array_values(array_filter(
                array_map(static fn (Category $c): ?int => $c->getId(), $Categories),
                static fn (?int $id): bool => $id !== null && $id > 0
            ));
            $productCountByCategoryId = $this->productCategoryRepository->getProductCountMapByCategoryIds($categoryIds);
            foreach ($Categories as $Category) {
                $row = [];
                foreach ($Csvs as $Csv) {
                    if ($Csv->getFieldName() === self::CATEGORY_CSV_FIELD_TARGET_PRODUCT_COUNT) {
                        $cid = $Category->getId();
                        $row[] = $cid !== null ? (string) ($productCountByCategoryId[$cid] ?? 0) : '0';

                        continue;
                    }
                    if ($Csv->getFieldName() === self::CATEGORY_CSV_FIELD_PARENT) {
                        $Parent = $Category->getParent();
                        $row[] = $Parent !== null ? (string) $Parent->getId() : '0';

                        continue;
                    }
                    $cell = $this->csvExportService->getData($Csv, $Category);
                    $row[] = $cell !== null && $cell !== '' ? $cell : '';
                }
                $this->csvExportService->fputcsv($row);
            }

            $this->csvExportService->fclose();
        });

        $now = new \DateTime();
        $filename = 'category_'.$now->format('YmdHis').'.csv';
        $response->headers->set('Content-Type', 'application/octet-stream');
        $response->headers->set('Content-Disposition', 'attachment; filename='.$filename);

        log_info('カテゴリCSV出力ファイル名', [$filename]);

        return $response;
    }
}

