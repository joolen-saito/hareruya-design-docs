namespace Eccube\Repository;

use Doctrine\DBAL\ParameterType;
use Doctrine\Persistence\ManagerRegistry as RegistryInterface;
use Eccube\Entity\ProductCategory;

/**
 * ProductCategoryRepository
 *
 * This class was generated by the Doctrine ORM. Add your own custom
 * repository methods below.
 *
 * @extends AbstractRepository<ProductCategory>
 */
class ProductCategoryRepository extends AbstractRepository
{
    public function __construct(RegistryInterface $registry)
    {
        parent::__construct($registry, ProductCategory::class);
    }

    /**
     * 管理画面 CSV 用。指定カテゴリ ID ごとに dtb_product_category 上の紐づき商品数（同一商品は 1）を数える.
     * base_info は会社情報のため admin 集計では条件に含めない.
     *
     * @param list<int> $categoryIds
     *
     * @return array<int, int> category_id => count
     */
    public function getProductCountMapByCategoryIds(array $categoryIds): array
    {
        $categoryIds = array_values(array_unique(array_values(array_filter(
            array_map(static fn (mixed $id): int => (int) $id, $categoryIds),
            static fn (int $id): bool => $id > 0
        ))));
        if ($categoryIds === []) {
            return [];
        }

        $placeholders = implode(',', array_fill(0, count($categoryIds), '?'));
        $sql = 'SELECT category_id, COUNT(DISTINCT product_id) FROM dtb_product_category '
            ."WHERE category_id IN ($placeholders) "
            .'GROUP BY category_id';

        $types = array_fill(0, count($categoryIds), ParameterType::INTEGER);

        $rows = $this->getEntityManager()->getConnection()->fetchAllKeyValue($sql, $categoryIds, $types);

        $map = [];
        foreach ($rows as $categoryId => $count) {
            $map[(int) $categoryId] = (int) $count;
        }

        return $map;
    }
}

