    45	        if ($customer === null) {
    46	            return;
    47	        }
    48	        $player = $this->playerRepository->findOneByCustomer($customer);
    49	        if ($player === null) {
    50	            return;
    51	        }
    52	
    53	        try {
    54	            $response = $this->smaregiCustomerService->postSmaregiPoint($player->getSmaregiId(), -$suspendPoint, false);
    55	        } catch (\Throwable $e) {
    56	            try {
    57	                $order->setPointErrorMessage(json_encode(['message' => $e->getMessage()], JSON_UNESCAPED_UNICODE))
    58	                    ->setSmaregiErrorFlg(true);
    59	                $this->entityManager->persist($order);
    60	                $this->entityManager->flush();
    61	            } catch (\Throwable $persistError) {
    62	                log_error('スマレジポイント連携失敗後の注文更新に失敗しました', [
