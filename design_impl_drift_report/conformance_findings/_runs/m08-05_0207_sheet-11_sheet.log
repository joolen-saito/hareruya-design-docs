namespace Eccube\Service\App\PointGranter;

use Doctrine\ORM\EntityManagerInterface;
use Eccube\Repository\DtbPlayerRepository;
use Eccube\Repository\Master\MtbPointTypeRepository;
use Eccube\Service\EntityManager\PointHistoryEntityManager;

class PointGranterAction
{
    public function __construct(
        private readonly DtbPlayerRepository $playerRepository,
        private readonly MtbPointTypeRepository $mtbPointTypeRepository,
        private readonly EntityManagerInterface $entityManager,
        private readonly PointHistoryEntityManager $pointHistoryEntityManager,
    ) {
    }

    /**
     * ポイント付与処理を実行する
     *
     * @param PointGranterInput $input
     *
     * @return void
     *
     * @throws \Exception DB操作時のエラー
     */
    public function handle(PointGranterInput $input): void
    {
        $row = $input->row;

        $customerId = $row['customerId'] ?? null;
        $newPoint = isset($row['newPoint']) ? (int) $row['newPoint'] : 0;
        $memo = $row['memo'] ?? null;
        $terminalTranDateTime = $row['terminalTranDateTime'] ?? null;
        $pointAttr = isset($row['pointAttr']) ? (int) $row['pointAttr'] : null;

        $Player = $this->playerRepository->findOneBy(['smaregiId' => (string) $customerId]);
        if ($Player === null) {
            return;
        }

        $this->entityManager->beginTransaction();

        try {
            $issueDate = $terminalTranDateTime ? new \DateTime($terminalTranDateTime) : new \DateTime();

            if ($pointAttr !== null) {
                $PointType = $this->mtbPointTypeRepository->find($pointAttr);
            }

            $Player->setPoint($Player->getPoint() + $newPoint);
            $this->entityManager->persist($Player);
            $this->pointHistoryEntityManager->save(
                PointHistory: null,
                Customer: $Player->getCustomer(),
                Order: null,
                PointType: $PointType ?? null,
                pointChange: $newPoint,
                note: $memo ?? '',
                issueDate: $issueDate,
                transactionId: null,
            );

            $this->entityManager->flush();
            $this->entityManager->commit();
        } catch (\Throwable $e) {
            $this->entityManager->rollback();
            throw $e;
        }
    }
}

