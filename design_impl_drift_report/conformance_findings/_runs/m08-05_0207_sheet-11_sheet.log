namespace Eccube\Controller\Admin\Customer;

use Eccube\Controller\AbstractController;
use Eccube\Entity\Customer;
use Eccube\Entity\DtbPointHistory;
use Eccube\Entity\Master\MtbPointType;
use Eccube\Form\Type\Admin\CustomerPointType;
use Eccube\Repository\Master\MtbPointTypeRepository;
use Symfony\Bridge\Twig\Attribute\Template;
use Symfony\Component\HttpFoundation\RedirectResponse;
use Symfony\Component\HttpFoundation\Request;
use Symfony\Component\Routing\Attribute\Route;

class CustomerPointController extends AbstractController
{
    public function __construct(private readonly MtbPointTypeRepository $pointTypeRepository)
    {
    }

    /**
     * @return array<string, mixed>
     */
    #[Route('/%eccube_admin_route%/customer/point/{id}/select', name: 'admin_customer_point_select', requirements: ['id' => '\d+'], methods: ['GET'])]
    #[Template('@admin/Customer/point_select.twig')]
    public function index(Customer $Customer): array
    {
        return [
            'Customer' => $Customer,
        ];
    }

    /**
     * @return array<string, mixed>|RedirectResponse
     */
    #[Route('/%eccube_admin_route%/customer/point/{id}/{type}', name: 'admin_customer_point_history', requirements: ['id' => '\d+', 'type' => 'history|granted|purchase'], methods: ['GET'])]
    #[Route('/%eccube_admin_route%/customer/point/{id}/{type}', name: 'admin_customer_point_update', requirements: ['id' => '\d+', 'type' => 'granted|purchase'], methods: ['POST'])]
    #[Template('@admin/Customer/point_update.twig')]
    public function pointHistory(Request $request, Customer $Customer, string $type): array|RedirectResponse
    {
        $PointHistory = new DtbPointHistory();
        $PointHistory->setCustomer($Customer);

        $builder = $this->formFactory
            ->createBuilder(CustomerPointType::class, $PointHistory, ['type' => $type]);

        $form = $builder->getForm();
        $form->handleRequest($request);

        if ($form->isSubmitted() && $form->isValid()) {
            $pointTypeId = $type == MtbPointType::GRANTED ? MtbPointType::GRANTED_TYPE : MtbPointType::PURCHASE_TYPE;
            $PointType = $this->pointTypeRepository->find($pointTypeId);

            if ($PointType === null) {
                $this->addError('admin.common.system_error', 'admin');

                return $this->redirectToRoute('admin_customer_point_history', [
                    'id' => $Customer->getId(),
                    'type' => $type,
                ]);
            }

            $orderNumber = $form->get('orderNumber')->getData();

            $PointHistory
                ->setOrder($Customer->getOrderByOrderNumber($orderNumber))
                ->setPointType($PointType)
            ;
            $this->entityManager->persist($PointHistory);

            $Customer->getPlayer()->addPoint($PointHistory->getPointChange());
            $this->entityManager->persist($Customer);

            $this->entityManager->flush();

            // TODO: ECCUBE_HARERUYA-112 ポイント付与 スマレジ連携の会員ポイント処理機能が作成されたら反映する

            $this->addSuccess('admin.common.save_complete', 'admin');

            return $this->redirectToRoute('admin_customer_point_history', [
                'id' => $Customer->getId(),
                'type' => $type,
            ]);
        }

        $pointTypeLabelKey = $type === MtbPointType::GRANTED
            ? 'admin.customer.point_update.granted'
            : 'admin.customer.point_update.purchase';

        return [
            'Customer' => $Customer,
            'form' => $form->createView(),
            'type' => $type,
            'pointTypeLabelKey' => $pointTypeLabelKey,
            'pointUpdateFlg' => $type !== MtbPointType::HISTORY,
        ];
    }
}

