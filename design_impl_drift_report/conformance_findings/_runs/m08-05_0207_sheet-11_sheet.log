{% extends '@admin/default_frame.twig' %}

{% set menus = ['customer', 'customer_edit'] %}

{% block title %}{{ 'admin.customer.point_update'|trans }}{% endblock %}
{% block sub_title %}{{ 'admin.customer.customer_management'|trans }}{% endblock %}

{% form_theme form '@admin/Form/bootstrap_4_horizontal_layout.html.twig' %}

{% block main %}
    <span class="p-country-name" style="display:none;">Japan</span>
    <div class="c-contentsArea__cols">
        <div class="c-contentsArea__primaryCol">
            <div class="c-primaryCol">
                {% if pointUpdateFlg %}
                    <div class="card rounded border-0 mb-4">
                        <form name="customer_point_form" role="form" id="customer_address_form" method="post"
                              action="{{ url('admin_customer_point_update', { id : Customer.id, type: type }) }}"
                              novalidate class="h-adr">
                            {{ form_widget(form._token) }}
                            <div class="card-header">
                                <div class="row">
                                    <div class="col-8">
                                        <span class="card-title">{{ pointTypeLabelKey|trans }}</span>
                                    </div>
                                    <div class="col-4 text-end">
                                        <a data-bs-toggle="collapse" href="#pointFormInfo" aria-expanded="false" aria-controls="pointFormInfo">
                                            <i class="fa fa-angle-up fa-lg"></i>
                                        </a>
                                    </div>
                                </div>
                            </div>
                            <div class="collapse show ec-cardCollapse" id="pointFormInfo">
                                <div class="card-body">
                                    <div class="row mb-2">
                                        <div class="col-3">
                                            <span>{{ 'admin.customer.point.order_id'|trans }}</span>
                                        </div>
                                        <div class="col mb-2">
                                            {{ form_widget(form.orderNumber) }}
                                            {{ form_errors(form.orderNumber) }}
                                        </div>
                                    </div>

                                    <div class="row mb-2">
                                        <div class="col-3 mb-2">
                                            <span>{{ 'admin.customer.point.point_change'|trans }}</span>
                                            <span class="badge bg-primary ms-1">{{ 'admin.common.required'|trans }}</span>
                                        </div>
                                        <div class="col mb-2">
                                            {{ form_widget(form.pointChange) }}
                                            {{ form_errors(form.pointChange) }}
                                        </div>
                                    </div>

                                    <div class="row mb-2">
                                        <div class="col-3">
                                            <span>{{ 'admin.customer.point.issue_date'|trans }}</span>
                                            <span class="badge bg-primary ms-1">{{ 'admin.common.required'|trans }}</span>
                                        </div>
                                        <div class="col mb-2">
                                            {{ form_widget(form.issueDate) }}
                                            {{ form_errors(form.issueDate) }}
                                        </div>
                                    </div>

                                    <div class="row mb-2">
                                        <div class="col-3 mb-2">
                                            <span>{{ 'admin.customer.point.note'|trans }}</span>
                                            <span class="badge bg-primary ms-1">{{ 'admin.common.required'|trans }}</span>
                                        </div>
                                        <div class="col mb-2">
                                            {{ form_widget(form.note) }}
                                            {{ form_errors(form.note) }}
                                        </div>
                                    </div>

                                    <div class="row mb-2">
                                        <div id="ex-conversion-action" class="col-6">
                                            <div class="row align-items-center justify-content-end">
                                                <div class="col-auto">
                                                    <button class="btn btn-ec-conversion px-5"
                                                            type="submit">{{ 'admin.common.registration'|trans }}</button>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </form>
                    </div>
                {% endif %}

                <div class="card rounded border-0 mb-4">
                    <div class="card-header">
                        <div class="row">
                            <div class="col-12">
                                <span class="card-title">
                                    {{ 'admin.customer.point_select'|trans }}
                                </span>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-12 text-end">
                                ポイント残高: {{ Customer.Player.point }}pt
                            </div>
                        </div>
                    </div>
                    <div class="collapse show ec-cardCollapse" id="pointHistory">
                        <div class="card-body">
                            <table class="table table-striped table-sm">
                                <thead class="table-active">
                                    <th class="align-middle pt-2 pb-2 ps-3">{{ 'admin.common.id'|trans }}</th>
                                    <th class="align-middle pt-2 pb-2">{{ 'admin.common.customer_name'|trans }}</th>
                                    <th class="align-middle pt-2 pb-2 pe-3">{{ 'admin.common.order_number'|trans }}</th>
                                    <th class="align-middle pt-2 pb-2 pe-3">{{ 'admin.common.point_charge'|trans }}</th>
                                    <th class="align-middle pt-2 pb-2 pe-3">{{ 'admin.common.note'|trans }}</th>
                                    <th class="align-middle pt-2 pb-2 pe-3">{{ 'admin.common.issue_date'|trans }}</th>
                                    <th class="align-middle pt-2 pb-2 pe-3">{{ 'admin.common.point_create_date'|trans }}</th>
                                    <th class="align-middle pt-2 pb-2 pe-3">{{ 'admin.common.expiry_date'|trans }}</th>
                                </thead>
                                <tbody>
                                {% for PointHistory in Customer.PointHistories %}
                                    <tr>
                                        <td class="align-middle ps-3">
                                            {{ PointHistory.id }}
                                        </td>
                                        <td class="align-middle">
                                            {{ PointHistory.Customer.name01 }} {{ PointHistory.Customer.name02 }}
                                        </td>
                                        <td class="align-middle">
                                             {% if PointHistory.Order %}{{ PointHistory.Order.order_number }}{%endif %}
                                        </td>
                                        <td class="align-middle">
                                            {{ PointHistory.point_change }}
                                        </td>
                                        <td class="align-middle">
                                            {{ PointHistory.note }}
                                        </td>
                                        <td class="align-middle">
                                            {{ PointHistory.issue_date|date('Y/m/d') }}
                                        </td>
                                        <td class="align-middle">
                                            {{ PointHistory.create_date|date('Y/m/d') }}
                                        </td>
                                        <td class="align-middle">
                                            {{ PointHistory.issue_date|date_modify("+" ~ eccube_config.eccube_customer_point_expire ~ " day")|date_format }}
                                        </td>
                                    </tr>
                                {% endfor %}
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="c-conversionArea">
        <div class="c-conversionArea__container">
            <div class="row justify-content-between align-items-center">
                <div class="col-6">
                    <div class="c-conversionArea__leftBlockItem">
                        <a class="c-baseLink" href="{{ url('admin_customer_edit', { id: Customer.id }) }}">
                            <i class="fa fa-backward" aria-hidden="true"></i>
                            <span>{{ 'admin.customer.back_to_customer_edit'|trans }}</span></a>
                    </div>
                </div>
            </div>
        </div>
    </div>

{% endblock %}

