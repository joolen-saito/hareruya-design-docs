    /**
     * 最もポイント有効期限切れに近く、未使用のポイント履歴を取得する
     * 有効期限が同日の履歴が複数ある場合は失効するポイントを合計する
     */
    public function getNextDeadlinePointHistory(DtbPlayer $player): ?DtbPointHistory
    {
        if ($player->getPoint() === 0) {
            return null;
        }

        $qb = $this->createQueryBuilder('ph')
            ->innerJoin('ph.Customer', 'c')
            ->where('c.id = :customerId')
            ->andWhere('ph.pointChange > 0')
            ->andWhere('ph.issueDate >= :expireIssueDate')
            ->setParameter('customerId', $player->getCustomer()->getId())
            ->setParameter('expireIssueDate', $this->getExpireDate())
            ->orderBy('ph.issueDate', 'DESC');
        $pointHistories = $qb->getQuery()->getResult();

        $deadlinePointHistory = null;
        $previousPointHistory = null;
        $totalSameDatePreviousPoint = 0;
        $currentPoint = $player->getPoint();
        foreach ($pointHistories as $pointHistory) {
            $totalSameDatePreviousPoint = $this->isSameDatePointHistory($pointHistory, $previousPointHistory) ? $totalSameDatePreviousPoint : 0;

            $currentPoint -= $pointHistory->getPointChange();
            if ($currentPoint <= 0) {
                $deadlinePointHistory = (clone $pointHistory)->setPointChange($currentPoint + $pointHistory->getPointChange() + $totalSameDatePreviousPoint);

                break;
            }

            $totalSameDatePreviousPoint = $this->isSameDatePointHistory($pointHistory, $previousPointHistory)
                ? $totalSameDatePreviousPoint + $pointHistory->getPointChange() : $pointHistory->getPointChange();

            $previousPointHistory = $pointHistory;
        }

        return $deadlinePointHistory;
    }

