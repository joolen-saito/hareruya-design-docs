    public function __construct(
        ManagerRegistry $registry,
        EccubeConfig $eccubeConfig,
    ) {
        $this->eccubeConfig = $eccubeConfig;
        parent::__construct($registry, DtbPointHistory::class);
    }

    /**
     * 指定したスマレジ取引IDのポイント履歴が既に存在するか判定する.
     *
     * スマレジ取引由来のポイント付与の冪等性担保 (Webhook 再送・補完取得バッチでの重複付与防止) に使う。
     */
    public function existsByTransactionId(int $transactionId): bool
    {
        $count = (int) $this->createQueryBuilder('ph')
            ->select('COUNT(ph.id)')
            ->where('ph.transactionId = :transactionId')
            ->setParameter('transactionId', $transactionId)
            ->getQuery()
            ->getSingleScalarResult();

        return $count > 0;
    }

    /**
     * 指定したスマレジ取引IDの「ポイント専用取引」(受注に紐付かない = order_id が NULL) のポイント履歴を取得する.
     *
     * 受注由来 (order_id 有り) のポイント履歴と区別し、ポイント専用取引 (取引区分6/7) の
     * 取消/打消による差し戻し対象のみを抽出するために使う。
     *
     * @return list<DtbPointHistory>
     */
    public function findPointOnlyByTransactionId(int $transactionId): array
    {
        /** @var list<DtbPointHistory> $result */
        $result = $this->createQueryBuilder('ph')
            ->where('ph.transactionId = :transactionId')
            ->andWhere('ph.Order IS NULL')
            ->setParameter('transactionId', $transactionId)
            ->orderBy('ph.id', 'ASC')
            ->getQuery()
            ->getResult();

        return $result;
    }

    /**
