namespace Eccube\Service\EntityManager;

use Doctrine\ORM\EntityManagerInterface;
use Eccube\Entity\Customer;
use Eccube\Entity\DtbPointHistory;
use Eccube\Entity\Master\MtbPointType;
use Eccube\Entity\Order;

class PointHistoryEntityManager
{
    public function __construct(private readonly EntityManagerInterface $entityManager)
    {
    }

    /**
     * ポイント履歴を保存する
     *
     * @param DtbPointHistory|null $PointHistory
     * @param Customer $Customer
     * @param Order|null $Order
     * @param MtbPointType|null $PointType
     * @param int|null $pointChange
     * @param string|null $note
     * @param \DateTime $issueDate
     * @param int|null $transactionId
     *
     * @return void
     */
    public function save(
        ?DtbPointHistory $PointHistory,
        Customer $Customer,
        ?Order $Order,
        ?MtbPointType $PointType,
        ?int $pointChange,
        ?string $note,
        \DateTime $issueDate,
        ?int $transactionId,
    ): void {
        if ($PointHistory === null) {
            $PointHistory = new DtbPointHistory();
        }

        $PointHistory->setCustomer($Customer)
            ->setIssueDate($issueDate);

        if ($Order !== null) {
            $PointHistory->setOrder($Order);
        }
        if ($PointType !== null) {
            $PointHistory->setPointType($PointType);
        }
        if ($pointChange !== null) {
            $PointHistory->setPointChange($pointChange);
        }
        if ($note !== null) {
            $PointHistory->setNote($note);
        }
        if ($transactionId !== null) {
            $PointHistory->setTransactionId($transactionId);
        }

        $this->entityManager->persist($PointHistory);
    }
}
