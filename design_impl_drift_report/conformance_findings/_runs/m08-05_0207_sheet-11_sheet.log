namespace Eccube\Form\Type\Admin;

use Eccube\Common\EccubeConfig;
use Eccube\Entity\DtbPointHistory;
use Symfony\Component\Form\AbstractType;
use Symfony\Component\Form\Extension\Core\Type\ChoiceType;
use Symfony\Component\Form\Extension\Core\Type\DateType;
use Symfony\Component\Form\Extension\Core\Type\IntegerType;
use Symfony\Component\Form\Extension\Core\Type\TextType;
use Symfony\Component\Form\FormBuilderInterface;
use Symfony\Component\Form\FormError;
use Symfony\Component\Form\FormEvent;
use Symfony\Component\Form\FormEvents;
use Symfony\Component\OptionsResolver\OptionsResolver;
use Symfony\Component\Validator\Constraints\Length;
use Symfony\Component\Validator\Constraints\NotBlank;
use Symfony\Component\Validator\Constraints\Range;
use Symfony\Component\Validator\Constraints\Regex;

class CustomerPointType extends AbstractType
{
    public const NOTE_CHOICES_GRANTED = [
        'キャンペーン' => 'キャンペーン',
        '特別対応' => '特別対応',
    ];

    public const NOTE_CHOICES_REFUND = [
        '余剰入金へのご返金' => '余剰入金へのご返金',
        '注文金額変更によるご返金' => '注文金額変更によるご返金',
    ];

    public function __construct(private EccubeConfig $eccubeConfig)
    {
    }

    /**
     * {@inheritdoc}
     *
     * @param array<string, mixed> $options
     */
    #[\Override]
    public function buildForm(FormBuilderInterface $builder, array $options): void
    {
        $noteChoices = $options['type'] === 'granted' ? self::NOTE_CHOICES_GRANTED : self::NOTE_CHOICES_REFUND;

        $builder
            ->add('orderNumber', TextType::class, [
                'label' => 'admin.customer.point.order_id',
                'required' => false,
                'mapped' => false,
                'attr' => [
                    'placeholder' => '例: 00001234',
                ],
                'constraints' => [
                    new Length(['max' => $this->eccubeConfig['eccube_order_id_len'], 'maxMessage' => 'form.order_id.max_length']),
                    new Regex(['pattern' => '/^\d{8}$/']),
                ],
            ])
            ->add('pointChange', IntegerType::class, [
                'label' => 'admin.customer.point.point_change',
                'required' => true,
                'attr' => [
                    'placeholder' => 'admin.customer.point.point_change_ex',
                ],
                'constraints' => [
                    new NotBlank(),
                    new Regex(['pattern' => '/^[-]?([1-9]\d*|0)$/']),
                ],
            ])
            ->add('note', ChoiceType::class, [
                'label' => 'admin.customer.point.note',
                'required' => true,
                'choices' => $noteChoices,
                'expanded' => false,
                'multiple' => false,
                'constraints' => [
                    new NotBlank(),
                ],
            ])
            ->add('issueDate', DateType::class, [
                'label' => 'admin.customer.point.issue_date',
                'required' => true,
                'input' => 'datetime',
                'widget' => 'single_text',
                'placeholder' => ['year' => '----', 'month' => '--', 'day' => '--'],
                'constraints' => [
                    new NotBlank(),
                    new Range([
                        'min' => '1900-01-01',
                        'minMessage' => 'form_error.out_of_range',
                    ]),
                ],
                'attr' => [
                    'class' => 'datetimepicker-input',
                    'data-target' => '#'.$this->getBlockPrefix().'_create_date_start',
                    'data-toggle' => 'datetimepicker',
                ],
            ]);

        $builder->addEventListener(FormEvents::POST_SUBMIT, function (FormEvent $event) {
            $form = $event->getForm();

            /** @var DtbPointHistory $PointHistory */
            $PointHistory = $event->getData();

            $Customer = $PointHistory->getCustomer();

            if ($form->get('orderNumber')->isValid()) {
                $orderNumber = $form->get('orderNumber')->getData();
                if ($orderNumber && !$Customer->hasOrderNumber($orderNumber)) {
                    $form['orderNumber']->addError(new FormError(trans('admin.customer.point.form.not_has.order_no')));
                }
            }

            $pointChange = $form->get('pointChange')->getData();
            if ($Customer->getPoint() + $pointChange < 0) {
                $form['pointChange']->addError(new FormError(trans('admin.customer.point.point_charge.point_minus')));
            }
        });
    }

    #[\Override]
    public function configureOptions(OptionsResolver $resolver): void
    {
        $resolver->setDefaults([
            'data_class' => DtbPointHistory::class,
            'type' => null,
        ]);
    }

    #[\Override]
    public function getBlockPrefix(): string
    {
        return 'admin_customer_point';
    }
}

