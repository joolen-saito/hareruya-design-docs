   103	        if (!\mb_check_encoding($file->current(), 'UTF-8')) {
   104	            // UTF-8 が検出できなかった場合は SJIS-win の stream filter を適用する
   105	            $filters[] = SjisToUtf8EncodingFilter::class;
   106	        }
   107	
   108	        $this->file = self::applyStreamFilter($file, ...$filters);
   109	        $this->file->setFlags(
   110	            \SplFileObject::READ_CSV |
   111	            \SplFileObject::SKIP_EMPTY |
   112	            \SplFileObject::READ_AHEAD
   113	        );
   114	        $this->file->setCsvControl(
   115	            $delimiter,
   116	            $enclosure,
   117	            $escape
   118	        );
   119	    }
