    43	/**
    44	 * CSV reader
    45	 *
    46	 * @implements \Iterator<int, array<int|string, string>>
    47	 * @implements \SeekableIterator<int, array<int|string, string>>
    48	 */
    49	class CsvImportService implements \Iterator, \SeekableIterator, \Countable
    50	{
    51	    public const DUPLICATE_HEADERS_INCREMENT = 1;
    52	    public const DUPLICATE_HEADERS_MERGE = 2;
    53	
    54	    /**
