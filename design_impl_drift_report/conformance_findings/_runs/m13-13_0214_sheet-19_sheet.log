    70	
    71	    /**
    72	     * Number of column headers, stored and re-used for performance
    73	     *
    74	     * In case of duplicate headers, this is always the number of unmerged headers.
    75	     */
    76	    protected int $headersCount = 0;
    77	
    78	    /**
    79	     * Total number of rows in the CSV file
    80	     */
    81	    protected ?int $count = null;
    82	
    83	    /**
