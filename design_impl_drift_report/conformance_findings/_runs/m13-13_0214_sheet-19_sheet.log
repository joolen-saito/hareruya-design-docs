    94	
    95	    public function __construct(\SplFileObject $file, string $delimiter = ',', string $enclosure = '"', string $escape = '\\')
    96	    {
    97	        // stream filter を適用して文字エンコーディングと改行コードの変換を行う
    98	        // see https://github.com/EC-CUBE/ec-cube/issues/5252
    99	        $filters = [
   100	            ConvertLineFeedFilter::class,
   101	        ];
