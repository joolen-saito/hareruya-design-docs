   143	     *
   144	     * @return array<int, mixed> ページ属性の配列
   145	     */
   146	    public function getPageList(?string $where = null, array $parameters = []): array
   147	    {
   148	        $qb = $this->createQueryBuilder('p')
   149	            ->andWhere('p.id <> 0')
   150	            ->andWhere('(p.MasterPage is null OR p.edit_type = :edit_type)')
   151	            ->orderBy('p.id', 'ASC')
   152	            ->setParameter('edit_type', Page::EDIT_TYPE_DEFAULT_CONFIRM);
   153	        if (!is_null($where)) {
   154	            $qb->andWhere($where);
   155	            foreach ($parameters as $key => $val) {
   156	                $qb->setParameter($key, $val);
   157	            }
   158	        }
   159	
   160	        return $qb
   161	            ->getQuery()
   162	            ->getResult();
   163	    }
