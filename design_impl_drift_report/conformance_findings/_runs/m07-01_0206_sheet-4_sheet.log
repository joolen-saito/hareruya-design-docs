    16	namespace Eccube\Service\Csv\Exporter;
    17	
    18	use Symfony\Contracts\Translation\TranslatorInterface;
    19	
    20	/**
    21	 * 棚戻しリスト PDF 用の区間（セクション）組み立て
    22	 *
    23	 * 入力は getBuyOrderRestockListCsvExportData / getOtcBuyOrderRestockListExportData が返す raw row
    24	 */
    25	final class RestockListPdfSectionBuilder
    26	{
    27	    /** 棚戻しリスト SQL の pickingTypeSort: サプライ品 */
    28	    public const PICKING_TYPE_SORT_SUPPLY = 99;
    29	
    30	    /** 棚戻しリスト SQL の pickingTypeSort: 基準価格 null */
    31	    public const PICKING_TYPE_SORT_NULL_STANDARD_PRICE = 50;
    32	
    33	    public function __construct(
    34	        private readonly RestockListCsvRowFormatter $restockListCsvRowFormatter,
    35	        private readonly TranslatorInterface $translator,
    36	    ) {
    37	    }
    38	
    39	    /**
    40	     * @param iterable<array<string, mixed>> $rawRows
    41	     *
    42	     * @return array{
    43	     *     sections: list<array{
    44	     *         titleBase: string,
    45	     *         isSupply: bool,
    46	     *         items: list<array<string, mixed>>,
    47	     *         total_quantity: int
    48	     *     }>
    49	     * }
    50	     */
    51	    public function buildSections(iterable $rawRows): array
    52	    {
    53	        $sortedThresholds = [];
    54	        $buckets = [];
    55	
    56	        foreach ($rawRows as $rawRow) {
    57	            // 閾値をソート
    58	            if ($sortedThresholds === []) {
    59	                $sortedThresholds = $this->restockListCsvRowFormatter->resolveSortedThresholds(
    60	                    $rawRow['threshold1'] !== null ? (int) $rawRow['threshold1'] : null,
    61	                    $rawRow['threshold2'] !== null ? (int) $rawRow['threshold2'] : null,
    62	                    $rawRow['threshold3'] !== null ? (int) $rawRow['threshold3'] : null,
    63	                );
    64	            }
    65	
    66	            // 区間分け
    67	            $formatted = $this->restockListCsvRowFormatter->formatRow($rawRow);
    68	            $pickingTypeSort = $this->resolvePickingTypeSort($rawRow);
    69	            $quantity = (int) $rawRow['quantity'];
    70	
    71	            if (!isset($buckets[$pickingTypeSort])) {
    72	                $buckets[$pickingTypeSort] = [
    73	                    'titleBase' => $this->buildSectionTitleBase(
    74	                        $pickingTypeSort,
    75	                        (bool) $rawRow['isSupply'],
    76	                        $sortedThresholds,
    77	                    ),
    78	                    'isSupply' => (bool) $rawRow['isSupply'],
    79	                    'items' => [],
    80	                    'total_quantity' => 0,
    81	                ];
    82	            }
    83	
    84	            $buckets[$pickingTypeSort]['items'][] = $this->toPickingItem($rawRow, $formatted);
    85	            $buckets[$pickingTypeSort]['total_quantity'] += $quantity;
    86	        }
    87	
    88	        $sections = [];
    89	
    90	        // getBuyOrderRestockListCsvExportData の ORDER BY pickingTypeSort と同じ挿入順
    91	        foreach (array_keys($buckets) as $sortKey) {
    92	            $section = $buckets[$sortKey];
    93	            $sections[] = [
    94	                'titleBase' => $section['titleBase'],
    95	                'isSupply' => $section['isSupply'],
    96	                'items' => $section['items'],
    97	                'total_quantity' => $section['total_quantity'],
    98	            ];
    99	        }
   100	
   101	        return [
   102	            'sections' => $sections,
   103	        ];
   104	    }
   105	
   106	    /**
   107	     * ピッキングリスト1行分のデータを組み立てる
   108	     * 言語・状態のみ twig で表示用の罫線を分けるロジックのためraw data を返す
   109	     *
   110	     * @param array<string, mixed> $rawRow
   111	     * @param array<string, string|int|null> $formatted
   112	     *
   113	     * @return array<string, mixed>
   114	     */
   115	    private function toPickingItem(array $rawRow, array $formatted): array
   116	    {
   117	        return [
   118	            'shelfNumberName' => $formatted['shelfNumber'],
   119	            'languageAndCondition' => $formatted['languageAndCondition'],
   120	            'languageCode' => (string) ($rawRow['languageCode'] ?? ''),
   121	            'conditionCode' => (string) ($rawRow['conditionCode'] ?? ''),
   122	            'cardsetName' => $formatted['storageCode'],
   123	            'abbreviationColorRarity' => $formatted['colorAndRarity'],
   124	            'quantitySubtotal' => (int) $formatted['quantity'],
   125	            'product_name' => $formatted['productName'],
   126	            'price' => $formatted['standardPrice'],
   127	        ];
   128	    }
   129	
   130	    /**
   131	     * @param array<string, mixed> $rawRow
   132	     */
   133	    private function resolvePickingTypeSort(array $rawRow): int
   134	    {
   135	        if ((bool) $rawRow['isSupply']) {
   136	            return self::PICKING_TYPE_SORT_SUPPLY;
   137	        }
   138	
   139	        return (int) $rawRow['pickingTypeSort'];
   140	    }
   141	
   142	    /**
   143	     * 区間ごとのタイトルを組み立てる
   144	     *
   145	     * @param list<int> $sortedThresholds
   146	     */
   147	    private function buildSectionTitleBase(int $pickingTypeSort, bool $isSupply, array $sortedThresholds): string
   148	    {
   149	        // サプライ
   150	        if ($isSupply) {
   151	            return $this->translator->trans('admin.picking_item_list.title_per_supply');
   152	        }
   153	
   154	        // 基準価格null
   155	        if ($pickingTypeSort === self::PICKING_TYPE_SORT_NULL_STANDARD_PRICE) {
   156	            return str_replace(
   157	                '_',
   158	                '）',
   159	                $this->translator->trans('admin.picking_item_list.title_per_item'),
   160	            );
   161	        }
   162	
   163	        $prefix = $this->translator->trans('admin.picking_item_list.title_per_item');
   164	        $thresholdCount = count($sortedThresholds);
   165	
   166	        if ($thresholdCount === 0) {
   167	            return str_replace('_', '）', $prefix);
   168	        }
   169	
   170	        // Repository の pickingTypeSort は「超えた閾値の数 + 1」。
   171	        // 閾値 [980, 4800] なら sort=1→最安帯, 2→中間帯, 3→最高帯
   172	        if ($pickingTypeSort === 1) {
   173	            // 最安帯
   174	            return $prefix.number_format($sortedThresholds[0]).$this->translator->trans('admin.picking_item_list.under');
   175	        }
   176	
   177	        if ($pickingTypeSort >= $thresholdCount + 1) {
   178	            // 最高帯
   179	            return $prefix.number_format($sortedThresholds[$thresholdCount - 1]).$this->translator->trans('admin.picking_item_list.over');
   180	        }
   181	
   182	        // 中間帯
   183	        $low = $sortedThresholds[$pickingTypeSort - 2];
   184	        $high = $sortedThresholds[$pickingTypeSort - 1];
   185	
   186	        return $prefix
   187	            .number_format($low)
   188	            .$this->translator->trans('admin.picking_item_list.andover')
   189	            .number_format($high)
   190	            .$this->translator->trans('admin.picking_item_list.under');
   191	    }
   192	}

