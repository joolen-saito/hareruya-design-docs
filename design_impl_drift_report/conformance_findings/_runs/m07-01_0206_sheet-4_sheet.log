   480	    /**
   481	     * 選んで買取サプライ品明細削除
   482	     */
   483	    #[Route(path: '/%eccube_admin_route%/purchase/detail/{id}/delete', name: 'admin_purchase_detail_delete', requirements: ['id' => '\d+'], methods: ['DELETE'])]
   484	    public function detailDelete(Request $request, int $id): RedirectResponse
   485	    {
   486	        $BuyMainCard = $this->buyMainCardRepository->find($id);
   487	        if ($BuyMainCard === null) {
   488	            throw new NotFoundHttpException();
   489	        }
   490	
   491	        $this->isTokenValid();
   492	
   493	        $BuyOrder = $BuyMainCard->getBuyOrder();
   494	
   495	        // サプライ品でない場合はエラー
   496	        if (!$BuyMainCard->isSupplyProduct()) {
   497	            $this->addError('サプライ品以外は削除できません', 'admin');
   498	
   499	            return $this->redirectToRoute('admin_purchase_edit', ['id' => $BuyOrder->getId()]);
   500	        }
   501	
   502	        $this->entityManager->wrapInTransaction(function () use ($BuyMainCard, $BuyOrder): void {
   503	            $this->entityManager->remove($BuyMainCard);
   504	            $this->entityManager->flush();
   505	
   506	            $this->entityManager->refresh($BuyOrder);
   507	            $BuyOrder->setTotalPrice($BuyOrder->getAcceptanceTotalPrice());
   508	            $this->entityManager->flush();
   509	        });
   510	
   511	        $this->addSuccess('admin.common.delete_complete', 'admin');
   512	
   513	        return $this->redirectToRoute('admin_purchase_edit', ['id' => $BuyOrder->getId()]);
   514	    }
