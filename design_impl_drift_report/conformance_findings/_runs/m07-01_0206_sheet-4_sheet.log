    27	     *
    28	     * @var array<string, string>
    29	     */
    30	    public const CSV_HEADER = [
    31	        'product_code' => '商品コード',
    32	        'product_count' => '在庫増減数',
    33	        'product_name' => '商品名',
    34	        'standard_price' => '基準価格',
    35	        'buy_price' => '買取価格',
    36	        'language_id' => '言語ID',
    37	        'storage_code' => '略称タグ',
    38	        'rarity_code' => 'レアリティ',
    39	        'condition_code' => '状態',
    40	    ];
    41	
    42	    public function __construct(
    43	        protected CsvExportService $csvExportService,
    44	        protected DtbBuyOrderRepository $buyOrderRepository,
    45	    ) {
    46	    }
    47	
    48	    /**
    49	     * 買取商品一覧CSVを出力する
    50	     * （通常は在庫増減数、キャンセル時はキャンセル数として同一サービスで出力）
    51	     *
    52	     * @param array<int, int> $buyOrderIds 買取注文IDの配列
    53	     * @param bool $isSale true のとき売却数、false のときキャンセル数
    54	     */
    55	    public function exportByIds(array $buyOrderIds, bool $isSale): StreamedResponse
    56	    {
    57	        $BuyOrders = $this->buyOrderRepository->findBy(
    58	            ['id' => $buyOrderIds],
    59	            ['id' => 'ASC'],
    60	        );
    61	
    62	        if ($BuyOrders === []) {
    63	            throw new \RuntimeException('admin.purchase.online.csv_export.not_registered_buy_order_id');
    64	        }
    65	
    66	        $saleFlg = $isSale ? DtbBuyMainCard::SALE : DtbBuyMainCard::NOT_SALE;
    67	        $rows = $this->buyOrderRepository->getProductListDataForExportCsv($buyOrderIds, $saleFlg);
    68	
    69	        $header = self::CSV_HEADER;
    70	        if (!$isSale) {
    71	            $header = array_merge($header, ['product_count' => 'キャンセル数']);
    72	        }
    73	        $headerKeys = array_keys($header);
    74	
    75	        $response = new StreamedResponse();
    76	        $response->setCallback(function () use ($header, $headerKeys, $rows): void {
    77	            $this->csvExportService->fopen();
    78	            $this->csvExportService->fputcsv(array_values($header));
    79	
    80	            foreach ($rows as $row) {
    81	                $orderedRow = array_map(
    82	                    fn ($key) => $row[$key] ?? '',
    83	                    $headerKeys,
    84	                );
    85	                $this->csvExportService->fputcsv($orderedRow);
    86	            }
    87	
    88	            $this->csvExportService->fclose();
    89	        });
