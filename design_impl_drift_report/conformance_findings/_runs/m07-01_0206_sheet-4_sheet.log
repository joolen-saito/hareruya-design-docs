   263	        $pageCount = 30;
   264	        $session = $this->session;
   265	
   266	        if ($request->getMethod() === 'POST') {
   267	            $page_no = 1;
   268	            $searchData = [
   269	                'id' => $request->get('id'),
   270	                'category_id' => $request->get('category_id'),
   271	            ];
   272	            $session->set('eccube.admin.purchase.product.search', $searchData);
   273	            $session->set('eccube.admin.purchase.product.search.page_no', $page_no);
   274	        } else {
   275	            $searchData = (array) $session->get('eccube.admin.purchase.product.search', []);
   276	            if ($page_no === null) {
   277	                $page_no = (int) $session->get('eccube.admin.purchase.product.search.page_no', 1);
   278	            } else {
   279	                $session->set('eccube.admin.purchase.product.search.page_no', $page_no);
   280	            }
   281	        }
   282	
   283	        $qb = $this->productRepository->getQueryBuilderBySearchDataForPurchase($searchData);
   284	
   285	        $pager = $this->paginator->paginate(
   286	            $qb,
   287	            $page_no,
   288	            $pageCount,
   289	            ['wrap-queries' => false]
   290	        );
   291	
   292	        /** @var \Eccube\Entity\Product[] $Products */
   293	        $Products = $pager->getItems();
   294	
   295	        $pagination = [];
   296	        foreach ($Products as $Product) {
   297	            foreach ($Product->getProductClasses() as $pc) {
   298	                if ($pc->getCardCondition() !== null && $pc->getCardCondition()->getId() === MtbCardCondition::NM) {
   299	                    $pagination[] = [
   300	                        'productClassId' => $pc->getId(),
   301	                        'id' => $Product->getId(),
   302	                        'code' => $pc->getCode() ?? '',
   303	                        'name' => $Product->getName(),
   304	                        'buyPrice' => $pc->getBuyPrice() ?? 0,
   305	                        'languageId' => $pc->getLanguage()?->getId(),
   306	                        'foilFlg' => $Product->getCardDetail()?->getFoilFlg(),
   307	                    ];
   308	                    break;
   309	                }
   310	            }
   311	        }
   312	
   313	        return [
   314	            'pagination' => $pagination,
   315	            'pager' => $pager,
   316	        ];
   317	    }
