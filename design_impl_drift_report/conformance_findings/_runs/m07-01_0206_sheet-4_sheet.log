   446	    /**
   447	     * 買取詳細画面の表示に必要なデータを取得する。
   448	     * edit と update（バリデーションエラー時）の両方で同じ表示にするために共通化している。
   449	     *
   450	     * @return array<string, mixed>
   451	     */
   452	    private function getDetailViewData(DtbBuyOrder $BuyOrder, int $id): array
   453	    {
   454	        // 初期表示時は選んで買取のみを表示する(キャンセル先頭でソートさせる)
   455	        $BuyOrder->setBuyMainCards(new ArrayCollection(
   456	            $this->buyMainCardRepository->getBuyMainCardsByPurchaseCategory($BuyOrder->getId(), DtbBuyMainCard::SELECT_TYPE)
   457	        ));
   458	        // 個別入力商品はキャンセルが先頭に来るようにソートさせる
   459	        $BuyOrder->setBuyOrderIndivisualInputProducts(new ArrayCollection(
   460	            $BuyOrder->getBuyOrderIndivisualInputProductsWithCancelSort()
   461	        ));
   462	        // 実在庫は状態、価格、商品コードでソートさせる
   463	        $BuyOrder->setBuyOrderStocks(new ArrayCollection(
   464	            $this->buyOrderStockRepository->selectForStockTable($BuyOrder)
   465	        ));
   466	
   467	        return [
   468	            'BuyOrder' => $BuyOrder,
   469	            'bulkTotalPrice' => $this->buyMainCardRepository->getBulkPurchaseTotalPrice($id),
   470	            'bulkAcceptanceTotalPrice' => $this->buyMainCardRepository->getBulkPurchaseAcceptanceTotalPrice($id),
   471	            'Player' => $this->playerRepository->findOneBy(['Customer' => $BuyOrder->getCustomer()]),
   472	            'StatusHistories' => $this->buyOrderStatusHistoryRepository->findBy(
   473	                ['BuyOrder' => $BuyOrder],
   474	                ['createDate' => 'DESC']
   475	            ),
   476	            'statusList' => $this->buyOrderStatusRepository->getAllStatusName(),
   477	        ];
   478	    }
