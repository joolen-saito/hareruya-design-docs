    94	        $response->headers->set('Content-Type', 'application/octet-stream');
    95	        $response->headers->set('Content-Disposition', 'attachment; filename='.$filename);
    96	
    97	        log_info('買取商品一覧CSV出力完了. ファイル名: '.$filename);
    98	
    99	        return $response;
