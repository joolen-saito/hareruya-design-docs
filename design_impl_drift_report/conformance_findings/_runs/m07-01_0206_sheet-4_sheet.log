   285	                                                                    <li><a href="{{ url('admin_purchase_manual_mail', {'buyOrderId': Purchase.id}) }}">メール通知</a></li>
   286	                                                                </ul>
   287	                                                            </div>
   288	                                                        </td>
   289	                                                    </tr>
   290	                                                {% endfor %}
   291	                                            </tbody>
   292	                                        </table>
   293	                                    </div>
   294	                                </div>
