   703	    /**
   704	     * 個別入力商品の実在庫登録
   705	     *
   706	     * モーダルで選択した商品規格(ProductClass)を個別入力商品に紐付け、
   707	     * 実在庫(DtbBuyOrderStock)を新規作成する。
   708	     * 全個別入力商品が登録済みになった場合、ステータスを「入庫待ち」に遷移させる。
   709	     */
   710	    #[Route(
   711	        path: '/%eccube_admin_route%/purchase/{buyOrderId}/register-individual-stock/{individualProductId}',
   712	        name: 'admin_purchase_register_individual_stock',
   713	        requirements: ['buyOrderId' => '\d+', 'individualProductId' => '\d+'],
   714	        methods: ['POST'],
   715	    )]
   716	    public function registerIndividualStock(
   717	        Request $request,
   718	        int $buyOrderId,
   719	        int $individualProductId,
   720	    ): Response {
   721	        if (!$this->isCsrfTokenValid('purchase_register_individual_stock', $request->request->get('_token'))) {
   722	            $this->addError('admin.common.csrf_token_error', 'admin');
   723	
   724	            return $this->redirectToRoute('admin_purchase_edit', ['id' => $buyOrderId]);
   725	        }
   726	
   727	        $BuyOrder = $this->buyOrderRepository->find($buyOrderId);
   728	        if ($BuyOrder === null) {
   729	            throw new NotFoundHttpException();
   730	        }
   731	
   732	        $IndividualProduct = $this->entityManager->find(
   733	            DtbBuyOrderIndivisualInputProduct::class,
   734	            $individualProductId,
   735	        );
   736	        if ($IndividualProduct === null || $IndividualProduct->getBuyOrder()->getId() !== $BuyOrder->getId()) {
   737	            throw new NotFoundHttpException();
   738	        }
   739	
   740	        $productClassId = $request->request->getInt('product_class_id');
   741	        $ProductClass = $this->entityManager->find(ProductClass::class, $productClassId);
   742	        if ($ProductClass === null) {
   743	            $this->addError('商品規格が見つかりません。', 'admin');
   744	
   745	            return $this->redirectToRoute('admin_purchase_edit', ['id' => $buyOrderId]);
   746	        }
   747	
   748	        $Member = $this->getUser();
   749	        if (!$Member instanceof Member) {
   750	            throw new AuthenticationException();
   751	        }
