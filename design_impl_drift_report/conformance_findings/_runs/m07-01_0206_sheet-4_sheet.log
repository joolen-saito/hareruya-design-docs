   349	    /**
   350	     * 買取詳細編集
   351	     */
   352	    #[Route(path: '/%eccube_admin_route%/purchase/{id}/update', name: 'admin_purchase_update', requirements: ['id' => '\d+'], methods: ['POST'])]
   353	    public function update(Request $request, int $id, PurchaseDetailUpdateAction $purchaseDetailUpdateAction): RedirectResponse|Response
   354	    {
   355	        // タイムアウトを無効にする
   356	        // Note: 移植元と同様に設定しておく
   357	        set_time_limit(0);
   358	
   359	        $BuyOrder = $this->buyOrderRepository->find($id);
   360	        if ($BuyOrder === null) {
   361	            throw new NotFoundHttpException();
   362	        }
   363	
   364	        // ここでsetするBuyMainCardsの並びはネット買取詳細の商品の並びと同じにする必要がある
   365	        $BuyMainCards = $this->buyMainCardRepository->getBuyMainCardsByPurchaseCategory($BuyOrder->getId(), DtbBuyMainCard::SELECT_TYPE);
   366	        $BuyOrder->setBuyMainCards(new ArrayCollection($BuyMainCards));
   367	        $BuyMainBulkCards = $this->buyMainCardRepository->getBuyMainCardsByPurchaseCategory($BuyOrder->getId(), DtbBuyMainCard::BULK_TYPE);
   368	        $BuyOrder->setBuyMainBulkCards(new ArrayCollection($BuyMainBulkCards));
   369	
   370	        $stockProductClasses = array_merge(
   371	            $this->productClassRepository->selectHighPriceProductClassByBuyOrder($BuyOrder),
   372	            $this->productClassRepository->selectAllProductClassByBuyOrder($BuyOrder)
   373	        );
   374	
   375	        $treatNullAsUnconfirmed = $BuyOrder->getQualifiedInvoiceIssuerConfirmationFlg() === null;
   376	        $originalBuyOrderStatusId = $BuyOrder->getBuyOrderStatus()->getId();
   377	        $buyOrderStockForm = $this->formFactory->createBuilder(BuyOrderStockType::class, ['stockProductClasses' => $stockProductClasses])->getForm();
   378	        $form = $this->formFactory->createBuilder(PurchaseDetailType::class, $BuyOrder, [
   379	            'treatNullAsUnconfirmed' => $treatNullAsUnconfirmed,
   380	            'original_buy_order_status_id' => $originalBuyOrderStatusId,
   381	            'buy_order_stock_form' => $buyOrderStockForm,
   382	        ])
   383	            ->getForm();
   384	
   385	        // 実在庫バリデーション（validateStockEditAllowed）が buyOrderStockForm->getData() を参照するため、
   386	        // 先に実在庫フォームをリクエストでバインドする
   387	        $buyOrderStockForm->handleRequest($request);
   388	        $form->handleRequest($request);
   389	
   390	        $searchProductModalForm = $this->formFactory->createBuilder(SearchProductType::class)->getForm();
   391	        $stockSearchProductModalForm = $this->formFactory->createBuilder(SearchProductType::class)->getForm();
   392	        $bankAccountForm = $this->formFactory->createBuilder(BankAccountType::class, $BuyOrder->getBankAccount())->getForm();
   393	        $bankAccountForm->handleRequest($request);
   394	        $qualifiedInvoiceIssuerForm = $this->formFactory->createBuilder(
   395	            QualifiedInvoiceIssuerAccountType::class,
   396	            $BuyOrder->getQualifiedInvoiceIssuerAccount(),
   397	            ['qualifiedInvoiceIssuerFlgForDisplay' => $BuyOrder->isQualifiedInvoiceIssuerFlg()]
   398	        )->getForm();
   399	        $qualifiedInvoiceIssuerForm->handleRequest($request);
   400	
   401	        $isInvalid = !$form->isValid() || !$buyOrderStockForm->isValid() || !$bankAccountForm->isValid() || !$qualifiedInvoiceIssuerForm->isValid();
   402	
   403	        if ($form->isSubmitted() && $isInvalid) {
   404	            foreach ($form->getErrors(true) as $error) {
   405	                $this->addError($error->getMessage(), 'admin');
   406	            }
   407	            $viewData = $this->getDetailViewData($BuyOrder, $id);
   408	
   409	            return $this->render('@admin/Purchase/detail.twig', array_merge($viewData, [
   410	                'form' => $form->createView(),
   411	                'buyOrderStockForm' => $buyOrderStockForm->createView(),
   412	                'searchProductModalForm' => $searchProductModalForm->createView(),
   413	                'stockSearchProductModalForm' => $stockSearchProductModalForm->createView(),
   414	                'bankAccountForm' => $bankAccountForm->createView(),
   415	                'qualifiedInvoiceIssuerForm' => $qualifiedInvoiceIssuerForm->createView(),
   416	            ]));
   417	        }
   418	
   419	        if (!$isInvalid) {
   420	            $qualifiedInvoiceIssuerFlg = (bool) $qualifiedInvoiceIssuerForm->get('qualifiedInvoiceIssuerFlg')->getData();
   421	            $stockData = $buyOrderStockForm->getData();
   422	            $stockProductClassRows = $stockData['stockProductClasses'] ?? new ArrayCollection();
   423	
   424	            $Member = $this->getUser();
   425	            if (!$Member instanceof Member) {
   426	                throw new AccessDeniedHttpException();
   427	            }
   428	
   429	            $input = new PurchaseDetailUpdateInput(
   430	                BuyOrder: $form->getData(),
   431	                qualifiedInvoiceIssuerFlg: $qualifiedInvoiceIssuerFlg,
   432	                originalBuyOrderStatusId: $originalBuyOrderStatusId,
   433	                Member: $Member,
   434	                stockProductClassRows: $stockProductClassRows,
   435	            );
   436	
   437	            $purchaseDetailUpdateAction->handle($input);
   438	            $this->addSuccess('admin.register.complete', 'admin');
   439	
   440	            return $this->redirectToRoute('admin_purchase_edit', ['id' => $id]);
   441	        }
   442	
   443	        return $this->redirectToRoute('admin_purchase_edit', ['id' => $id]);
   444	    }
