   372	    /**
   373	     * 複数の買取注文に対してそれぞれの買取依頼商品数と前回依頼日を取得（買取情報CSV用）
   374	     *
   375	     * @param array<int, int> $buyOrderIds 買取注文IDの配列
   376	     *
   377	     * @return array<int, array{productCounts: int, previousOrderDate: string|null}> キーは買取注文ID。previousOrderDate は 'Y/m/d' または null
   378	     */
   379	    public function getBuyOrdersProductsCount(array $buyOrderIds): array
   380	    {
   381	        if ($buyOrderIds === []) {
   382	            return [];
   383	        }
   384	
   385	        // 返却配列の初期化（すべてのIDについてデフォルト値をセット）
   386	        $result = [];
   387	        foreach ($buyOrderIds as $id) {
   388	            $result[$id] = [
   389	                'productCounts' => 0,
   390	                'previousOrderDate' => null,
   391	            ];
   392	        }
   393	
   394	        // 前回利用日のみを取得するクエリ
   395	        $qbDate = $this->createQueryBuilder('b');
   396	        $qbDate->select('b.id AS buyOrderId')
   397	            ->addSelect('MAX(preBo.orderDate) AS previousOrderDate')
   398	            ->leftJoin(DtbBuyOrder::class, 'preBo', Join::WITH, 'IDENTITY(preBo.Customer) = IDENTITY(b.Customer) AND preBo.orderDate < b.orderDate')
   399	            ->where($qbDate->expr()->in('b.id', ':buyOrderIds'))
   400	            ->groupBy('b.id')
   401	            ->setParameter('buyOrderIds', $buyOrderIds);
   402	
   403	        foreach ($qbDate->getQuery()->getResult() as $row) {
   404	            $id = (int) $row['buyOrderId'];
   405	            $prevDateRaw = $row['previousOrderDate'];
   406	
   407	            if ($prevDateRaw !== null) {
   408	                $dt = $prevDateRaw instanceof \DateTimeInterface
   409	                    ? $prevDateRaw
   410	                    : new \DateTime($prevDateRaw);
   411	                $result[$id]['previousOrderDate'] = $dt->format('Y/m/d');
   412	            }
   413	        }
   414	
   415	        // BuyMainCards の商品点数を集計
   416	        $qbCards = $this->createQueryBuilder('b');
   417	        $qbCards->select('b.id AS buyOrderId')
   418	            ->addSelect('SUM(bmc.count) AS cardCount')
   419	            ->join('b.BuyMainCards', 'bmc')
   420	            ->where($qbCards->expr()->in('b.id', ':buyOrderIds'))
   421	            ->groupBy('b.id')
   422	            ->setParameter('buyOrderIds', $buyOrderIds);
   423	
   424	        foreach ($qbCards->getQuery()->getResult() as $row) {
   425	            $id = (int) $row['buyOrderId'];
   426	            $result[$id]['productCounts'] += (int) $row['cardCount'];
   427	        }
   428	
   429	        // BuyOrderIndivisualInputProducts の商品点数を集計
   430	        $qbIndiv = $this->createQueryBuilder('b');
   431	        $qbIndiv->select('b.id AS buyOrderId')
   432	            ->addSelect('SUM(boi.quantity) AS indivCount')
   433	            ->join('b.BuyOrderIndivisualInputProducts', 'boi')
   434	            ->where($qbIndiv->expr()->in('b.id', ':buyOrderIds'))
   435	            ->groupBy('b.id')
   436	            ->setParameter('buyOrderIds', $buyOrderIds);
   437	
   438	        foreach ($qbIndiv->getQuery()->getResult() as $row) {
   439	            $id = (int) $row['buyOrderId'];
   440	            $result[$id]['productCounts'] += (int) $row['indivCount'];
   441	        }
   442	
   443	        return $result;
   444	    }
