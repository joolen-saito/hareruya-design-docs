   102	    public function addPointDiscountItem(ItemHolderInterface $itemHolder, string $discount, string $processorName = PointProcessor::class): void
   103	    {
   104	        // 注文明細以外は処理しない.
   105	        if ($itemHolder instanceof Order === false) {
