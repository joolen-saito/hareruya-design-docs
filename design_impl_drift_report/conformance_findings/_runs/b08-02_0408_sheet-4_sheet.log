    73	     *
    74	     * @throws NoResultException
    75	     * @throws NonUniqueResultException
    76	     */
    77	    public function pointToDiscount(string $point): string
    78	    {
    79	        return bcmul($this->pointToPrice($point), '-1', 0);
    80	    }
    81	
    82	    /**
    83	     * 金額をポイントに変換する.
