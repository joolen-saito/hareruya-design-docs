   283	    private function isSameDatePointHistory(DtbPointHistory $pointHistory, ?DtbPointHistory $anotherPointHistory): bool
   284	    {
   285	        return !is_null($anotherPointHistory) && $pointHistory->getIssueDate()->format('Ymd') === $anotherPointHistory->getIssueDate()->format('Ymd');
