    59	     */
    60	    public function pointToPrice(string $point): string
    61	    {
    62	        $BaseInfo = $this->baseInfoRepository->get();
    63	
    64	        return bcmul($point, (string) $BaseInfo->getPointConversionRate(), 0);
    65	    }
    66	
    67	    /**
