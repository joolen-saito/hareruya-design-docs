   124	        $OrderItem->setProductName($DiscountType ? $DiscountType->getName() : '')
   125	            ->setPrice($discount)
   126	            ->setPointRate($pointRate)
   127	            ->setQuantity('1')
   128	            ->setTax('0')
   129	            ->setBaseInfo($itemHolder->getBaseInfo())
   130	            ->setTaxRate('0')->setRoundingType()
   131	            ->setOrderItemType($DiscountType)
   132	            ->setTaxDisplayType($TaxInclude)
   133	            ->setTaxType($Taxation)
   134	            ->setOrder($itemHolder)
   135	            ->setProcessorName($processorName);
   136	        $itemHolder->addItem($OrderItem);
   137	    }
   138	
   139	    /**
   140	     * 既存のポイント明細を削除する.
   141	     */
   142	    public function removePointDiscountItem(ItemHolderInterface $itemHolder, string $processorName = PointProcessor::class): void
   143	    {
   144	        if ($itemHolder instanceof Order) {
   145	            foreach ($itemHolder->getItems() as $item) {
   146	                if ($item instanceof OrderItem && $item->getProcessorName() == $processorName) {
   147	                    $itemHolder->removeOrderItem($item);
   148	                    $this->entityManager->remove($item);
   149	                }
   150	            }
   151	        }
   152	    }
