    16	namespace Eccube\Service\Admin\Customer;
    17	
    18	use Doctrine\ORM\EntityManagerInterface;
    19	use Eccube\Entity\Master\MtbPointType;
    20	use Eccube\Repository\DtbPointHistoryRepository;
    21	use Eccube\Repository\Master\MtbPointTypeRepository;
    22	use Eccube\Service\EntityManager\PointHistoryEntityManager;
    23	use Eccube\Service\Smaregi\SmaregiCustomerService;
    24	use Psr\Log\LoggerInterface;
    25	
    26	class LostPointsAction
    27	{
    28	    private const NOTE = '有効期限切れによる失効';
    29	
    30	    public function __construct(
    31	        private readonly DtbPointHistoryRepository $pointHistoryRepository,
    32	        private readonly MtbPointTypeRepository $pointTypeRepository,
    33	        private readonly SmaregiCustomerService $smaregiCustomerService,
    34	        private readonly EntityManagerInterface $entityManager,
    35	        private readonly PointHistoryEntityManager $pointHistoryEntityManager,
    36	        private readonly LoggerInterface $logger,
    37	    ) {
    38	    }
    39	
    40	    public function handle(): void
    41	    {
    42	        $lostPointPlayers = $this->pointHistoryRepository->getPlayersForLostPoint();
    43	        $PointType = $this->pointTypeRepository->find(MtbPointType::GRANTED_TYPE);
    44	
    45	        if (empty($lostPointPlayers)) {
    46	            $this->logger->info('ポイント失効処理対象なし');
    47	
    48	            return;
    49	        }
    50	
    51	        try {
    52	            $this->entityManager->beginTransaction();
    53	
    54	            foreach ($lostPointPlayers as $lostPointPlayer) {
    55	                $Player = $lostPointPlayer['player'];
    56	                $remainingPoint = (int) $lostPointPlayer['remainingPoint'];
    57	                $losePoint = $remainingPoint - $Player->getPoint();
    58	
    59	                $response = $this->smaregiCustomerService->postSmaregiPoint();
    60	
    61	                if (!array_key_exists('result', $response)) {
    62	                    $this->logger->warning('スマレジAPI連携失敗', [
    63	                        'player_id' => $Player->getId(),
    64	                        'smaregi_id' => $Player->getSmaregiId(),
    65	                    ]);
    66	                    continue;
    67	                }
    68	
    69	                $Player->setPoint($remainingPoint);
    70	                $this->entityManager->persist($Player);
    71	
    72	                $this->pointHistoryEntityManager->save(
    73	                    PointHistory: null,
    74	                    Customer: $Player->getCustomer(),
    75	                    Order: null,
    76	                    PointType: $PointType,
    77	                    pointChange: $losePoint,
    78	                    note: self::NOTE,
    79	                    issueDate: (new \DateTime())->modify('+183 days'),
    80	                    transactionId: null,
    81	                );
    82	            }
    83	
    84	            $this->entityManager->flush();
    85	            $this->entityManager->commit();
    86	        } catch (\Throwable $e) {
    87	            $this->logger->error('ポイント失効処理に失敗しました', [
    88	                'message' => $e->getMessage(),
    89	            ]);
    90	            $this->entityManager->rollback();
    91	
    92	            throw $e;
    93	        }
    94	    }
