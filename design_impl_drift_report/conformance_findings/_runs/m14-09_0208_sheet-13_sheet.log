    26	class MtbFormatRepository extends AbstractRepository
    27	{
    28	    public function __construct(ManagerRegistry $registry)
    29	    {
    30	        parent::__construct($registry, MtbFormat::class);
    31	    }
    32	
    33	    public function get(int $id = 1): ?MtbFormat
    34	    {
    35	        return $this->find($id);
    36	    }
    37	
    38	    public function findOneByNameEn(string $nameEn): ?MtbFormat
    39	    {
    40	        return $this->findOneBy(['name_en' => $nameEn], ['id' => 'ASC']);
    41	    }
    42	
    43	    /**
    44	     * ランキング表示フラグが立っているフォーマットを rank 順で取得
    45	     *
    46	     * @return MtbFormat[]
    47	     */
    48	    public function findRankingDisplayFormats(): array
    49	    {
    50	        return $this->findBy(['ranking_flg' => true], ['rank' => 'ASC']);
    51	    }
    52	
    53	    /**
    54	     * ランキング表示フラグまたは他メタゲームフラグが立っているフォーマットを rank 順で取得
    55	     *
    56	     * @return MtbFormat[]
    57	     */
    58	    public function findDeckSitemapFormats(): array
    59	    {
    60	        return $this->createQueryBuilder('f')
    61	            ->where('f.ranking_flg = true OR f.other_meta_flg = true')
    62	            ->orderBy('f.rank', 'ASC')
    63	            ->getQuery()
    64	            ->getResult();
    65	    }
    66	
    67	    /**
    68	     * デッキ検索の検索条件を取得
    69	     *
    70	     * @return array<int, MtbFormat>
    71	     */
    72	    public function getSearchFormats(): array
    73	    {
    74	        $searchFormats = [];
    75	        foreach ($this->findBy(['search_flg' => true], ['rank' => 'ASC']) as $format) {
    76	            $searchFormats[$format->getId()] = $format;
    77	        }
    78	
    79	        return $searchFormats;
    80	    }
    81	
    82	    /**
    83	     * 指定フォーマットに含まれるカード名(日/英)の一覧を取得
    84	     *
    85	     * @return iterable<array{name_jp: string|null, name_en: string|null}>
    86	     */
    87	    public function getFormatCardListNativeQuery(int $formatId): iterable
    88	    {
    89	        $sql = <<<EOT
    90	            SELECT
    91	                c.name_jp,
    92	                c.name_en
    93	            FROM
    94	                mtb_format f
    95	            INNER JOIN
    96	                dtb_card_format cf ON cf.format_id = f.id
    97	            INNER JOIN
    98	                mtb_card c ON c.id = cf.card_id
    99	            WHERE
   100	                f.id = :formatId
   101	EOT;
   102	
   103	        $rsm = new ResultSetMapping();
   104	        $rsm->addScalarResult('name_jp', 'name_jp');
   105	        $rsm->addScalarResult('name_en', 'name_en');
   106	
   107	        $query = $this->getEntityManager()
   108	            ->createNativeQuery($sql, $rsm)
   109	            ->setParameter('formatId', $formatId);
   110	
   111	        return $query->toIterable();
   112	    }
   113	
   114	    /**
   115	     * 実 DtbEvent に 1 件以上 設定 されている format のみ id ASC で 取得する。
   116	     *
   117	     * @return list<MtbFormat>
   118	     */
   119	    public function getFormatsAssignedToEvents(): array
   120	    {
   121	        /** @var list<MtbFormat> $formats */
   122	        $formats = $this->createQueryBuilder('f')
   123	            ->innerJoin('f.Events', 'e')
   124	            ->andWhere('e.deletedAt IS NULL')
   125	            ->groupBy('f.id')
   126	            ->orderBy('f.id', 'ASC')
   127	            ->getQuery()
   128	            ->getResult();
   129	
   130	        return $formats;
   131	    }
   132	}

