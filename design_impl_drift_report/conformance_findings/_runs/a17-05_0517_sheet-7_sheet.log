    19	use Symfony\Component\DependencyInjection\ParameterBag\ParameterBagInterface;
    20	use Symfony\Component\HttpFoundation\Response;
    21	
    22	class ProductSearchResponseBuilder
    23	{
    24	    private int $conditionDisplayMinPrice;
    25	    private ?string $cdnBaseUrl;
    26	    private string $s3Endpoint;
    27	    private string $awsS3Bucket;
    28	
    29	    public function __construct(ParameterBagInterface $params)
    30	    {
    31	        $this->conditionDisplayMinPrice = (int) $params->get('condition_display_min_price');
    32	        $this->cdnBaseUrl = $params->get('cdn_base_url');
    33	        $this->s3Endpoint = $params->get('s3_endpoint');
    34	        $this->awsS3Bucket = $params->get('aws_s3_bucket');
    35	    }
    36	
    37	    /**
    38	     * 複数商品の検索結果をレスポンス形式で構築する
    39	     * pf-apiにあわせて、最大件数を100件にして返却
    40	     *
    41	     * @param array<int, array<string, mixed>> $products
    42	     * @param int $maxCount
    43	     *
    44	     * @return array<string, mixed>
    45	     */
    46	    public function build(array $products, int $maxCount = 100): array
    47	    {
    48	        $response = [
    49	            'code' => Response::HTTP_OK,
    50	            'count' => 0,
    51	            'products' => [],
    52	        ];
    53	
    54	        $groupedProducts = $this->groupProducts($products);
    55	
    56	        $count = 0;
    57	        foreach ($groupedProducts as $product) {
    58	            if ($count >= $maxCount) {
    59	                break;
    60	            }
    61	
    62	            $productData = $this->buildProduct($product);
    63	            if ($productData !== null) {
    64	                $response['products'][] = $productData;
    65	                $count++;
    66	            }
    67	        }
    68	
    69	        $response['count'] = $count;
    70	
    71	        return $response;
    72	    }
    73	
    74	    /**
    75	     * 商品をグループ化する
    76	     *
    77	     * @param array<int, array<string, mixed>> $products
    78	     *
    79	     * @return array<string, array<string, mixed>>
    80	     */
    81	    private function groupProducts(array $products): array
    82	    {
    83	        $grouped = [];
    84	
    85	        foreach ($products as $product) {
    86	            $productId = $product['productId'];
    87	            $languageCode = $product['languageCode'] ?? 'JP';
    88	            $highPriceCode = $product['highPriceCode'] ?? null;
    89	            $key = "{$productId}_{$languageCode}_{$highPriceCode}";
    90	
    91	            if (!isset($grouped[$key])) {
    92	                $grouped[$key] = [
    93	                    'productId' => $productId,
    94	                    'productName' => $product['productName'],
    95	                    'languageCode' => $languageCode,
    96	                    'highPriceCode' => $highPriceCode,
    97	                    'categories' => $this->splitString($product['categoryNames'] ?? '', '|'),
    98	                    'regionRestriction' => $product['regionRestrictionName'] ?? null,
    99	                    'cardName' => $product['cardName'] ?? null,
   100	                    'productClasses' => [],
   101	                ];
   102	            }
   103	
   104	            if ($product['productClassId'] !== null) {
   105	                $productClass = $this->buildProductClass($product);
   106	                if ($productClass !== null) {
   107	                    $grouped[$key]['productClasses'][] = $productClass;
   108	                }
   109	            }
   110	        }
   111	
   112	        return $grouped;
   113	    }
   114	
   115	    /**
   116	     * 商品情報を構築
   117	     * その他状態が表示不可の場合、NM状態または高額商品コードが設定されている商品クラスのみを残す
   118	     *
   119	     * @param array<string, mixed> $productGroup
   120	     *
   121	     * @return array<string, mixed>|null
   122	     */
   123	    private function buildProduct(array $productGroup): ?array
   124	    {
   125	        if (empty($productGroup['productClasses'])) {
   126	            return null;
   127	        }
   128	
   129	        $productName = $productGroup['productName'];
   130	        if ($productGroup['cardName'] !== null) {
   131	            $productName = '【'.$productGroup['languageCode'].'】'.$productName;
   132	        }
   133	
   134	        $displayOtherConditions = $this->isDisplayOtherConditions($productGroup['productClasses']);
   135	        $hasHighPriceCode = $productGroup['highPriceCode'] !== '';
   136	
   137	        $filteredClasses = $displayOtherConditions
   138	            ? $productGroup['productClasses']
   139	            : array_filter($productGroup['productClasses'], function ($pc) use ($hasHighPriceCode) {
   140	                return $pc['card_condition_code'] === MtbCardCondition::CODE_NEAR_MINT || $hasHighPriceCode;
   141	            });
   142	
   143	        if (empty($filteredClasses)) {
   144	            return null;
   145	        }
   146	
   147	        return [
   148	            'product_id' => $productGroup['productId'],
   149	            'product_name' => $productName,
   150	            'language_code' => $productGroup['languageCode'],
   151	            'high_price_code' => $productGroup['highPriceCode'] ?: null,
   152	            'categories' => $productGroup['categories'],
   153	            'region_restriction' => $productGroup['regionRestriction'],
   154	            'product_classes' => array_values($filteredClasses),
   155	        ];
   156	    }
   157	
   158	    /**
   159	     * 商品クラス情報を構築
   160	     *
   161	     * @param array<string, mixed> $detail
   162	     *
   163	     * @return array<string, mixed>|null
   164	     */
   165	    private function buildProductClass(array $detail): ?array
   166	    {
   167	        $conditionCode = $detail['conditionCode'] ?? null;
   168	        $price = (int) $detail['price'];
   169	
   170	        if ($conditionCode !== MtbCardCondition::CODE_NEAR_MINT && $price < $this->conditionDisplayMinPrice) {
   171	            return null;
   172	        }
   173	
   174	        $imageFileNames = $this->splitString($detail['imageFileNames'] ?? '');
   175	        $productClassImages = [];
   176	        foreach ($imageFileNames as $imageFile) {
   177	            $productClassImages[] = $this->getS3Url($imageFile);
   178	        }
   179	
   180	        return [
   181	            'product_class_id' => $detail['productClassId'],
   182	            'product_code' => $detail['productCode'],
   183	            'card_condition_code' => $conditionCode,
   184	            'price' => $price,
   185	            'stock' => (int) ($detail['stock'] ?? 0),
   186	            'product_class_images' => $productClassImages,
   187	        ];
   188	    }
   189	
   190	    /**
   191	     * その他状態の表示可否を判定
   192	     *
   193	     * @param array<int, array<string, mixed>> $productClasses
   194	     *
   195	     * @return bool
   196	     */
   197	    private function isDisplayOtherConditions(array $productClasses): bool
   198	    {
   199	        $firstNonNmCondition = null;
   200	        $hasValidNonNmWithStock = false;
   201	
   202	        foreach ($productClasses as $productClass) {
   203	            if ($productClass['card_condition_code'] !== MtbCardCondition::CODE_NEAR_MINT) {
   204	                if ($firstNonNmCondition === null) {
   205	                    $firstNonNmCondition = $productClass;
   206	                }
   207	
   208	                if ((int) ($productClass['stock'] ?? 0) > 0 && (int) $productClass['price'] >= $this->conditionDisplayMinPrice) {
   209	                    $hasValidNonNmWithStock = true;
   210	                }
   211	            }
   212	        }
   213	
   214	        if ($firstNonNmCondition === null) {
   215	            return true;
   216	        }
   217	
   218	        if ((int) $firstNonNmCondition['price'] >= $this->conditionDisplayMinPrice || $hasValidNonNmWithStock) {
   219	            return true;
   220	        }
   221	
   222	        return false;
   223	    }
   224	
   225	    /**
   226	     * 区切り文字列を配列に変換
   227	     *
   228	     * @param string|null $value
   229	     * @param string $separator
   230	     *
   231	     * @return array<int, string>
   232	     */
   233	    private function splitString(?string $value, string $separator = ','): array
   234	    {
   235	        if (empty($value)) {
   236	            return [];
   237	        }
   238	
   239	        $items = explode($separator, $value);
   240	
   241	        return array_values(array_unique(array_filter(array_map('trim', $items))));
   242	    }
   243	
   244	    /**
   245	     * ファイルパスをS3のURLに変換
   246	     *
   247	     * @param string $path
   248	     *
   249	     * @return string
   250	     */
   251	    private function getS3Url(string $path): string
   252	    {
   253	        if (!empty($this->cdnBaseUrl)) {
   254	            return $this->cdnBaseUrl.$path;
   255	        }
   256	
   257	        return $this->s3Endpoint.$this->awsS3Bucket.'/'.$path;
   258	    }
   259	}

