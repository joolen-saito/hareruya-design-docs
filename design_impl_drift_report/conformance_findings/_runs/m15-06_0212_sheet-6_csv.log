   451	    /**
   452	     * @return list<array{count: int, Card: MtbCard|null, name: string}>
   453	     */
   454	    private function decodeCardList(string $text, ReadCsvRowEvent $event, string $listLabel): array
   455	    {
   456	        $result = [];
   457	        if ($text === '') {
   458	            return $result;
   459	        }
   460	
   461	        $lines = preg_split('/[\r\n]+/u', $text);
   462	        if ($lines === false) {
   463	            return $result;
   464	        }
   465	
   466	        $row = $event->getRow();
   467	        $rowNumber = $row->getRowNumber();
   468	        $messageStore = $event->getMessageStore();
   469	
   470	        $parsed = [];
   471	        $names = [];
   472	        foreach ($lines as $line) {
   473	            $line = trim($line);
   474	            if ($line === '') {
   475	                continue;
   476	            }
   477	
   478	            if (preg_match('/^(\d+)\s+(\S.*)/', $line, $match) === 0) {
   479	                $messageStore->addRawMessage(sprintf(
   480	                    $this->translator->trans('admin.deck.csv.error.format_invalid'),
   481	                    $listLabel,
   482	                    $rowNumber,
   483	                ));
   484	                $event->breakAll();
   485	
   486	                return [];
   487	            }
   488	
   489	            $name = $this->getSimpleCardName(trim($match[2]));
   490	            $parsed[] = ['count' => (int) $match[1], 'name' => $name];
   491	            $names[$name] = true;
   492	        }
   493	
   494	        $cardByName = $this->lookupCardsByNames(array_keys($names));
   495	
   496	        foreach ($parsed as $entry) {
   497	            $Card = $cardByName[$entry['name']] ?? null;
   498	            if ($Card === null) {
   499	                $messageStore->addMasterNotExistsError($rowNumber, $listLabel, $entry['name']);
   500	                $event->breakAll();
   501	
   502	                return [];
   503	            }
   504	            $result[] = [
   505	                'count' => $entry['count'],
   506	                'Card' => $Card,
   507	                'name' => $entry['name'],
   508	            ];
   509	        }
   510	
   511	        return $result;
   512	    }
