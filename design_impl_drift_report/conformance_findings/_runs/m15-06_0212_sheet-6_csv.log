   549	    private function parseEventDate(string $value): ?\DateTime
   550	    {
   551	        foreach (['Y-m-d H:i:s', 'Y-m-d'] as $format) {
   552	            $dt = \DateTime::createFromFormat($format, $value);
   553	            $errors = \DateTime::getLastErrors();
   554	            $hasError = is_array($errors) && ($errors['warning_count'] > 0 || $errors['error_count'] > 0);
   555	            if ($dt instanceof \DateTime && !$hasError) {
   556	                return $dt;
   557	            }
   558	        }
   559	
   560	        return null;
   561	    }
