                <tr><td>14</td><td>イベント開催日</td><td></td><td>日付</td><td>〇</td><td></td><td>2020-07-11 13:00:00</td><td>イベント開催日</td></tr>
                <tr><td>15</td><td>参照元</td><td></td><td></td><td></td><td></td><td>http://example.com/</td><td>参照元</td></tr>
                <tr><td>16</td><td>イベント参加人数</td><td></td><td></td><td></td><td></td><td>10</td><td>イベント参加人数</td></tr>
                <tr><td>17</td><td>表示フラグ</td><td></td><td>0(非表示) または 1(表示)</td><td>〇</td><td></td><td>1</td><td>表示フラグ</td></tr>
                <tr><td>18</td><td>デッキリスト非公開フラグ</td><td></td><td>0(公開) または 1(非公開)</td><td>〇</td><td></td><td>0</td><td>デッキリスト非公開フラグ</td></tr>
                <tr><td>19</td><td>メインリスト</td><td></td><td>デッキリスト形式</td><td>△</td><td></td><td>2 Castle Ardenvale<br>（略）</td><td>メインリスト</td></tr>
                <tr><td>20</td><td>サイドリスト</td><td></td><td>デッキリスト形式</td><td></td><td></td><td>同上</td><td>サイドリスト</td></tr>
                <tr><td>21</td><td>統率者</td><td></td><td>デッキリスト形式</td><td>△</td><td></td><td>同上</td><td>統率者</td></tr>
                <tr><td>22</td><td>デッキID</td><td>〇</td><td></td><td></td><td></td><td>290036</td><td>デッキID</td></tr>
                <tr><td>23</td><td>代表カード名</td><td></td><td></td><td></td><td></td><td>Hallowed Fountain</td><td>代表カード名</td></tr>
                <tr><td>24</td><td>旧デッキID</td><td></td><td></td><td></td><td></td><td></td><td>旧デッキID　※カスタマイズ対応、項目除去する</td></tr>
