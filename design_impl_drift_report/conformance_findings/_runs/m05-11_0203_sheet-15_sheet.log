   680	                    const quantity = parseInt(elem.value, 10) || 0;
   681	                    const productClassId = $('input[name="' + orderItemFieldName(elem.name, '[ProductClass]') + '"]').val();
   682	                    if (!productClassId || !Object.prototype.hasOwnProperty.call(arrQuantity, productClassId)) {
   683	                        return;
   684	                    }
   685	                    // 明細削除以外の一部キャンセル時処理
   686	                    if (!exitQuantity) {
