   689	                        if (beforeQuantity > quantity) {
   690	                            if (!confirm("一部キャンセル時、在庫数等は以下のように変動します。\nキャンセルしてもよろしいですか？\n在庫数：キャンセル分増加\n使用ポイント：変動なし\n付与予定ポイント：再計算\n付与済みポイント：変動なし")) {
