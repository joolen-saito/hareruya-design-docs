   668	                let exitQuantity = false;
   669	                let returnQuantity = false;
   670	                let exitStockout = false;
   671	                let tQuantity = 0;
   672	                // 明細削除時処理
   673	                if ($('input[name$="[quantity]"]').length < Object.keys(arrQuantity).length) {
   674	                    if (!confirm("一部キャンセル時、在庫数等は以下のように変動します。\nキャンセルしてもよろしいですか？\n在庫数：キャンセル分増加\n使用ポイント：変動なし\n付与予定ポイント：再計算\n付与済みポイント：変動なし")) {
