   919	    /**
   920	     * 受注フォームのポイント関連入力と担当者を受注に反映する.
   921	     *
   922	     * 受注明細・配送・金額が確定した後（PurchaseFlow commit 後）に実行し、
   923	     * 小計や還元率が変わった場合のみ発生ポイントを再計算する。
   924	     */
   925	    private function applyOrderPointAndOperatorFromForm(Order $TargetOrder, Order $OriginOrder, FormInterface $form): void
   926	    {
   927	        $targetSubTotal = (int) $TargetOrder->getSubtotal();
   928	        $pointPercentage = $form->has('pointPercentage')
   929	            ? (int) ($form->get('pointPercentage')->getData() ?? 0)
   930	            : (int) ($TargetOrder->getPointPercentage() ?? 0);
   931	        $spendedPoints = $form->has('spendedPoints')
   932	            ? (int) ($form->get('spendedPoints')->getData() ?? 0)
   933	            : (int) ($TargetOrder->getSpendedPoints() ?? 0);
   934	        $gainedPoints = $form->has('gainedPoints')
   935	            ? (int) ($form->get('gainedPoints')->getData() ?? 0)
   936	            : (int) ($TargetOrder->getGainedPoints() ?? 0);
   937	
   938	        $paymentMethod = $TargetOrder->getPaymentMethod() ?? '';
   939	        if ($TargetOrder->getOrderStatus()?->getId() === OrderStatus::CANCEL) {
   940	            $gainedPoints = 0;
   941	        } elseif (strpos($paymentMethod, Payment::EC_CASH_AND_CARRY_METHOD) === false
   942	            && ($targetSubTotal !== (int) $OriginOrder->getSubtotal()
   943	                || (int) ($OriginOrder->getPointPercentage() ?? 0) !== $pointPercentage)) {
   944	            $taxedBase = $targetSubTotal - $spendedPoints;
   945	            $gainedPoints = $taxedBase > 0 ? (int) floor($taxedBase * $pointPercentage / 100) : 0;
   946	        }
   947	
   948	        $TargetOrder
   949	            ->setMember($this->getMember())
   950	            ->setGainedPoints($gainedPoints)
   951	            ->setSpendedPoints($spendedPoints)
   952	            ->setPointPercentage($pointPercentage);
   953	    }
