   823	    /**
   824	     * 商品規格ごとの数量差分から一部キャンセルかどうかを判定する.
   825	     */
   826	    private function isPartCancel(Order $TargetOrder, Order $OriginOrder): bool
   827	    {
   828	        $fromQuantities = $this->getProductQuantitiesByProductClass($OriginOrder);
   829	        $toQuantities = $this->getProductQuantitiesByProductClass($TargetOrder);
   830	
   831	        foreach (array_unique(array_merge(array_keys($fromQuantities), array_keys($toQuantities))) as $classId) {
   832	            $diff = bcsub($toQuantities[$classId] ?? '0', $fromQuantities[$classId] ?? '0', 0);
   833	            if (bccomp($diff, '0', 0) === 0) {
   834	                continue;
   835	            }
   836	            if (bccomp($diff, '0', 0) < 0 && isset($fromQuantities[$classId])) {
   837	                return true;
   838	            }
   839	        }
   840	
   841	        return false;
   842	    }
   843	
   844	    /**
   845	     * @return array<int, string> 商品規格IDをキーとした商品明細数量の合計
   846	     */
   847	    private function getProductQuantitiesByProductClass(Order $Order): array
   848	    {
   849	        $quantities = [];
   850	        foreach ($Order->getOrderItems() as $OrderItem) {
   851	            if (!$OrderItem->isProduct()) {
   852	                continue;
   853	            }
   854	            $classId = $OrderItem->getProductClass()?->getId();
   855	            if ($classId === null) {
   856	                continue;
   857	            }
   858	            $quantities[$classId] = isset($quantities[$classId])
   859	                ? bcadd($quantities[$classId], $OrderItem->getQuantity(), 0)
   860	                : $OrderItem->getQuantity();
   861	        }
   862	
   863	        return $quantities;
   864	    }
