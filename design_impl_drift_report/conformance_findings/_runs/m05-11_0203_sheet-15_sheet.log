   955	    /**
   956	     * 受注編集画面モーダル用の会員検索・商品検索フォームを生成し、それぞれ初期化イベントを送出する.
   957	     *
   958	     * @param Request $request     リクエスト
   959	     * @param Order   $OriginOrder 編集前スナップショット
   960	     * @param Order   $TargetOrder 編集対象の受注
   961	     *
   962	     * @return array{0: FormInterface, 1: FormInterface} [会員検索フォーム, 商品検索フォーム]
   963	     */
   964	    private function createSearchModalForms(Request $request, Order $OriginOrder, Order $TargetOrder): array
   965	    {
   966	        $builder = $this->formFactory->createBuilder(SearchCustomerType::class);
   967	
   968	        $event = new EventArgs(
   969	            [
   970	                'builder' => $builder,
   971	                'OriginOrder' => $OriginOrder,
   972	                'TargetOrder' => $TargetOrder,
   973	            ],
   974	            $request
   975	        );
   976	        $this->eventDispatcher->dispatch($event, EccubeEvents::ADMIN_ORDER_EDIT_SEARCH_CUSTOMER_INITIALIZE);
   977	
   978	        $searchCustomerModalForm = $builder->getForm();
   979	
   980	        $builder = $this->formFactory->createBuilder(SearchProductType::class);
   981	
   982	        $event = new EventArgs(
   983	            [
   984	                'builder' => $builder,
   985	                'OriginOrder' => $OriginOrder,
   986	                'TargetOrder' => $TargetOrder,
   987	            ],
   988	            $request
   989	        );
   990	        $this->eventDispatcher->dispatch($event, EccubeEvents::ADMIN_ORDER_EDIT_SEARCH_PRODUCT_INITIALIZE);
   991	
   992	        $searchProductModalForm = $builder->getForm();
   993	
   994	        return [$searchCustomerModalForm, $searchProductModalForm];
   995	    }
