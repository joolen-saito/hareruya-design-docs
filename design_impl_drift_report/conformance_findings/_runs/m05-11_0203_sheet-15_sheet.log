   746	    /**
   747	     * 「ステータス更新」押下時の確定処理。ステータス遷移と日付更新のみを行う.
   748	     */
   749	    private function tryCommitOrderStatusChange(Order $TargetOrder, Order $OriginOrder, FormInterface $form): RedirectResponse
   750	    {
   751	        $prevStatusId = $OriginOrder->getOrderStatus()?->getId();
   752	        $newStatusId = $TargetOrder->getOrderStatus()?->getId();
   753	
   754	        if ($prevStatusId === null || $newStatusId === null || $prevStatusId === $newStatusId) {
   755	            return $this->redirectToRoute('admin_order_edit', ['id' => $TargetOrder->getId()]);
   756	        }
   757	
   758	        if (!$form->isValid()) {
   759	            return $this->redirectToRoute('admin_order_edit', ['id' => $TargetOrder->getId()]);
   760	        }
   761	
   762	        $now = new \DateTime();
   763	        $statusChangedToDelivered = $newStatusId === OrderStatus::DELIVERED && $prevStatusId !== OrderStatus::DELIVERED;
   764	
   765	        if ($statusChangedToDelivered) {
   766	            $TargetOrder->setShippingDate($now);
   767	            foreach ($TargetOrder->getShippings() as $Shipping) {
   768	                $Shipping->setShippingDate($now);
   769	            }
   770	        }
   771	        $isFirstCancellation = $newStatusId === OrderStatus::CANCEL && $prevStatusId !== OrderStatus::CANCEL && $TargetOrder->getCancelDate() === null;
   772	        if ($isFirstCancellation) {
   773	            $TargetOrder->setCancelDate($now);
   774	        }
   775	        if ($newStatusId === OrderStatus::PAID && $prevStatusId !== OrderStatus::PAID && $TargetOrder->getPaymentDate() === null) {
   776	            $TargetOrder->setPaymentDate($now);
   777	        }
   778	        if ($newStatusId === OrderStatus::PICKING && $prevStatusId !== OrderStatus::PICKING && $TargetOrder->getConfirmDate() === null) {
   779	            $TargetOrder->setConfirmDate($now);
   780	        }
   781	
   782	        $OldOrderStatus = $OriginOrder->getOrderStatus();
   783	        $NewOrderStatus = $TargetOrder->getOrderStatus();
   784	        if ($OldOrderStatus !== null && $NewOrderStatus !== null) {
   785	            $TargetOrder->setOrderStatus($OldOrderStatus);
   786	        }
   787	
   788	        $this->entityManager->wrapInTransaction(function () use ($TargetOrder, $statusChangedToDelivered, $isFirstCancellation, $OldOrderStatus, $NewOrderStatus): void {
   789	            if ($OldOrderStatus !== null && $NewOrderStatus !== null) {
   790	                $this->orderStateMachine->apply($TargetOrder, $NewOrderStatus);
   791	            }
   792	
   793	            $TargetOrder
   794	                ->setMember($this->getMember())
   795	                ->setUpdateDate(new \DateTime());
   796	            $this->entityManager->persist($TargetOrder);
   797	
   798	            // 新たに出荷完了になった場合、ポイントを付加
   799	            if ($statusChangedToDelivered) {
   800	                $this->pointService->gainPoints($TargetOrder);
   801	                $this->smaregiCustomerService->gainPoints($TargetOrder);
   802	            }
   803	            if ($isFirstCancellation) {
   804	                $this->pointService->cancelOrderPoints($TargetOrder);
   805	            }
   806	
   807	            if ($TargetOrder->getSmaregiCode()
   808	                && $TargetOrder->getOrderStatus() !== null
   809	                && $TargetOrder->getOrderStatus()->getId() !== OrderStatus::CANCEL) {
   810	                $this->smaregiApiService->postSmaregiProcess($TargetOrder, ['product']);
   811	            }
   812	        });
   813	
   814	        if ($newStatusId === OrderStatus::CANCEL) {
   815	            $this->addSuccess('admin.order.cancel.complete', 'admin');
   816	        } else {
   817	            $this->addSuccess('admin.order.save.complete', 'admin');
   818	        }
   819	
   820	        return $this->redirectToRoute('admin_order_edit', ['id' => $TargetOrder->getId()]);
   821	    }
