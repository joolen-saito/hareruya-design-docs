   866	    /**
   867	     * 指定された日付項目をクリアする.
   868	     */
   869	    private function tryClearOrderDate(Request $request, Order $TargetOrder): RedirectResponse
   870	    {
   871	        $target = (string) $request->query->get('target', '');
   872	        switch ($target) {
   873	            case 'picking_date':
   874	                // ピック中
   875	                $TargetOrder->setPickingDate(null);
   876	                break;
   877	            case 'payment_date':
   878	                // 入金日
   879	                $TargetOrder->setPaymentDate(null);
   880	                break;
   881	            case 'confirm_date':
   882	                // ピック中
   883	                $TargetOrder->setConfirmDate(null);
   884	                break;
   885	            case 'commit_date':
   886	                // 出荷指示日
   887	                $TargetOrder->setCommitDate(null);
   888	                break;
   889	            case 'shipping_date':
   890	                // 出荷日
   891	                $TargetOrder->setShippingDate(null);
   892	                foreach ($TargetOrder->getShippings() as $Shipping) {
   893	                    $Shipping->setShippingDate(null);
   894	                }
   895	                break;
   896	            case 'cancel_date':
   897	                // キャンセル日
   898	                $TargetOrder->setCancelDate(null);
   899	                break;
   900	            case 'otc_rsv_date':
   901	                // 店頭予約
   902	                $TargetOrder->setOtcRsvDate(null);
   903	                break;
   904	            default:
   905	                return $this->redirectToRoute('admin_order_edit', ['id' => $TargetOrder->getId()]);
   906	        }
   907	
   908	        $TargetOrder
   909	            ->setMember($this->getMember())
   910	            ->setUpdateDate(new \DateTime());
   911	        $this->entityManager->persist($TargetOrder);
   912	        $this->entityManager->flush();
   913	
   914	        $this->addSuccess('admin.order.save.complete', 'admin');
   915	
   916	        return $this->redirectToRoute('admin_order_edit', ['id' => $TargetOrder->getId()]);
   917	    }
