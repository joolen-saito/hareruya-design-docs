  1004	     *     ThresholdPrices: list<MtbOption>,
  1005	     *     waitingNumber: int|null,
  1006	     *     productNameAndSubInfos: array<int, array<string, string|array<string, string>>>
  1007	     * }
  1008	     */
  1009	    private function buildAdminOrderEditViewContext(Order $TargetOrder): array
  1010	    {
  1011	        $times = [];
  1012	        foreach ($this->deliveryRepository->findAll() as $Delivery) {
  1013	            $deliveryTimes = $Delivery->getDeliveryTimes();
  1014	            foreach ($deliveryTimes as $DeliveryTime) {
  1015	                $times[$Delivery->getId()][$DeliveryTime->getId()] = $DeliveryTime->getDeliveryTime();
  1016	            }
  1017	        }
  1018	
  1019	        $WaitingNumber = $TargetOrder->getId() === null
  1020	            ? null
  1021	            : $this->waitingNumberRepository->findOneBy(['orderId' => $TargetOrder->getId()]);
  1022	
  1023	        return [
  1024	            'shippingDeliveryTimes' => $this->serializer->serialize($times, 'json'),
  1025	            'ThresholdPrices' => $this->optionRepository->findBy(['option_key' => [MtbOption::ORDER_LIST_THRESHOLD_PRICE_1, MtbOption::ORDER_LIST_THRESHOLD_PRICE_2]]),
  1026	            'waitingNumber' => $WaitingNumber?->getWaitingNumber() ?? null,
  1027	            'productNameAndSubInfos' => $this->getProductNameAndSubInfosForEditView($TargetOrder),
  1028	        ];
  1029	    }
