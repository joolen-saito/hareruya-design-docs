                <tr><td><a class="item-no" href="#pin-sheet-4-9">9</a></td><td>成績</td><td>文字列</td><td>チェックを入れた場合のみ必須、32文字まで</td><td></td></tr>
                <tr><td><a class="item-no" href="#pin-sheet-4-10">10</a></td><td>勝利数</td><td>数値</td><td>チェックを入れた場合のみ必須、数値チェック</td><td>※カスタマイズ対応、項目を除去する</td></tr>
                <tr><td><a class="item-no" href="#pin-sheet-4-11">11</a></td><td>敗北数</td><td>数値</td><td>チェックを入れた場合のみ必須、数値チェック</td><td>※カスタマイズ対応、項目を除去する</td></tr>
                <tr><td><a class="item-no" href="#pin-sheet-4-12">12</a></td><td>引き分け数</td><td>数値</td><td>チェックを入れた場合のみ必須、数値チェック</td><td>※カスタマイズ対応、項目を除去する</td></tr>
                <tr id="item-sheet-4-13"><td><a class="item-no" href="#pin-sheet-4-13">13</a></td><td>DCIナンバー</td><td>文字列</td><td>チェックを入れた場合のみ必須</td><td>※カスタマイズ対応、項目を除去する</td></tr>
                <tr id="item-sheet-4-14"><td><a class="item-no" href="#pin-sheet-4-14">14</a></td><td>プレイヤー名</td><td>文字列</td><td>チェックを入れた場合のみ必須、64文字まで</td><td></td></tr>
                <tr id="item-sheet-4-15"><td><a class="item-no" href="#pin-sheet-4-15">15</a></td><td>タグ</td><td>複数選択</td><td>チェックを入れた場合のみ必須</td><td>サジェスト機能</td></tr>
                <tr id="item-sheet-4-16"><td><a class="item-no" href="#pin-sheet-4-16">16</a></td><td>引用元URL</td><td>文字列</td><td>チェックを入れた場合のみ必須、255文字まで</td><td></td></tr>
                <tr id="item-sheet-4-17"><td><a class="item-no" href="#pin-sheet-4-17">17</a></td><td>一括編集実行</td><td>ボタン</td><td>-</td><td>入力された項目に該当するデータを更新する</td></tr>
              </tbody>
            </table>
          </div>
