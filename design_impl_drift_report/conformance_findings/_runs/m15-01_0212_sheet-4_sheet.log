    76	    #[Template('@admin/Deck/index.twig')]
    77	    public function index(Request $request, PaginatorInterface $paginator, int $page_no = 1): array
    78	    {
    79	        $searchForm = $this->getForm();
    80	        $bulkUpdateForm = $this->createForm(DeckBulkUpdateType::class);
    81	
    82	        if ($request->isMethod('POST')) {
    83	            $searchForm->handleRequest($request);
    84	
    85	            if (!$searchForm->isValid()) {
    86	                return [
    87	                    'searchForm' => $searchForm->createView(),
    88	                    'bulkUpdateForm' => $bulkUpdateForm->createView(),
    89	                    'pagination' => null,
    90	                    'is_search_filter_active' => true,
    91	                ];
    92	            }
    93	
    94	            $page_no = 1;
    95	            $viewData = FormUtil::getViewData($searchForm);
    96	
    97	            $this->session->set($this->sessionKey, $viewData);
    98	            $this->session->set($this->sessionKey.'.page_no', $page_no);
    99	        } else {
   100	            $pageNoAttr = $request->attributes->get('page_no');
   101	            if ($request->query->getInt('resume') === Constant::ENABLED || $pageNoAttr !== null) {
   102	                if ($pageNoAttr !== null) {
   103	                    $page_no = (int) $pageNoAttr;
   104	                    $this->session->set($this->sessionKey.'.page_no', $page_no);
   105	                } else {
   106	                    $page_no = $this->session->get($this->sessionKey.'.page_no', 1);
   107	                }
   108	                $viewData = $this->session->get($this->sessionKey, []);
   109	                FormUtil::submitAndGetData($searchForm, $viewData);
   110	            } else {
   111	                $viewData = FormUtil::getViewData($searchForm);
   112	                $this->session->set($this->sessionKey, $viewData);
   113	                $this->session->set($this->sessionKey.'.page_no', 1);
   114	                $this->session->set('eccube.admin.'.$this->sessionKey.'.search.page_count', 100);
   115	
   116	                return [
   117	                    'searchForm' => $searchForm->createView(),
   118	                    'bulkUpdateForm' => $bulkUpdateForm->createView(),
   119	                    'pagination' => null,
   120	                    'is_search_filter_active' => false,
   121	                ];
   122	            }
   123	        }
   124	
   125	        $responseData = $this->search($request, null, $page_no);
   126	
   127	        $searchData = $searchForm->getData();
   128	        $responseData['sortKeys'] = $this->deckRepository->getSortKeys();
   129	        $responseData['sortKey'] = $searchData['sortKey'] ?? $this->deckRepository::DEFAULT_SORT_KEY;
   130	        $responseData['sortOrder'] = $searchData['sortOrder'] ?? $this->deckRepository::DEFAULT_SORT_ORDER;
   131	        $responseData['bulkUpdateForm'] = $bulkUpdateForm->createView();
   132	
   133	        return $responseData;
   134	    }
