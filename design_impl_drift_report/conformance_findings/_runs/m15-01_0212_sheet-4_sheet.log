    75	        $response = new StreamedResponse();
    76	        $response->setCallback(function () use ($header, $Decks): void {
    77	            $this->csvExportService->fopen();
    78	            $this->csvExportService->fputcsv($header);
    79	            foreach ($Decks as $Deck) {
    80	                $this->csvExportService->fputcsv($this->buildCsvRow($Deck));
    81	            }
    82	            $this->csvExportService->fclose();
    83	        });
    84	
    85	        $filename = $exportType.'_'.(new \DateTime())->format('YmdHis').'.csv';
    86	        $response->headers->set('Content-Type', 'application/octet-stream');
    87	        $response->headers->set('Content-Disposition', 'attachment; filename='.$filename);
    88	
    89	        log_info('デッキCSV出力完了. ファイル名: '.$filename);
    90	
    91	        return $response;
    92	    }
    93	
    94	    /**
    95	     * @param array<int, int> $ids
    96	     *
    97	     * @return list<DtbDeck>
    98	     */
    99	    private function getDecksByExportType(string $exportType, array $ids): array
   100	    {
   101	        return match ($exportType) {
   102	            'deck' => $this->deckRepository->findByDeckIds($ids),
   103	            default => throw new \InvalidArgumentException('Invalid export type: '.$exportType),
   104	        };
   105	    }
   106	
   107	    /**
   108	     * @return array<int, string|int>
   109	     */
   110	    private function buildCsvRow(DtbDeck $Deck): array
   111	    {
   112	        $Format = $Deck->getFormat();
   113	        $Archetype = $Deck->getArchetype();
   114	        $EventDetail = $Deck->getEventDetail();
   115	        $CardImage = $Deck->getCardImage();
   116	
   117	        $commanderCardName = '';
   118	        foreach ($Deck->getDeckCards() as $DeckCard) {
   119	            if ($DeckCard->getBoard()->getId() === MtbBoard::BOARD_ID_COMMAND) {
   120	                $commanderCardName = (string) $DeckCard->getCard()->getNameEn();
   121	                break;
   122	            }
   123	        }
   124	
   125	        $representativeCardName = '';
   126	        if ($CardImage !== null) {
   127	            $CardDetail = $CardImage->getCardDetail();
   128	            $Card = $CardDetail?->getCard();
   129	            if ($Card !== null) {
   130	                $representativeCardName = (string) $Card->getNameEn();
   131	            }
   132	        }
   133	
   134	        $dispFlg = $Deck->getDisp()->getId() === MtbDisp::DISPLAY_SHOW ? 1 : 0;
   135	
   136	        $tagNames = [];
   137	        foreach ($Deck->getDeckTags() as $DeckTag) {
   138	            $tagNames[] = $DeckTag->getNameJp();
   139	        }
   140	        $tags = implode(',', $tagNames);
   141	
   142	        $eventDate = $Deck->getEventDate();
   143	
   144	        return [
   145	            (string) $Deck->getPlayerName(),
   146	            $Format !== null ? (string) $Format->getNameEn() : '',
   147	            $Archetype !== null ? (string) $Archetype->getNameJp() : '',
   148	            $EventDetail !== null ? (string) $EventDetail->getId() : '',
   149	            (string) $Deck->getDeckName(),
   150	            $Deck->getRanking() !== null ? (int) $Deck->getRanking() : '',
   151	            (string) $Deck->getResult(),
   152	            $tags,
   153	            (string) $Deck->getEventNameEn(),
   154	            (string) $Deck->getEventNameJp(),
   155	            $eventDate !== null ? $eventDate->format('Y-m-d H:i:s') : '',
   156	            (string) $Deck->getSourceUrl(),
   157	            $Deck->getParticipants() !== null ? (int) $Deck->getParticipants() : '',
   158	            $dispFlg,
   159	            $Deck->getPrivateFlg() ? 1 : 0,
   160	            (string) $Deck->getTextMain(),
   161	            (string) $Deck->getTextSide(),
   162	            $commanderCardName,
   163	            (int) $Deck->getId(),
   164	            $representativeCardName,
   165	        ];
   166	    }
   167	}

