   442	    #[Route('/%eccube_admin_route%/deck/search_player', name: 'admin_deck_search_player', methods: ['POST'])]
   443	    public function searchPlayer(Request $request): JsonResponse
   444	    {
   445	        $searchWord = $request->request->getString('search_word');
   446	        $page = $request->request->getInt('page', 1);
   447	        $limit = 10;
   448	
   449	        $qb = $this->entityManager->createQueryBuilder()
   450	            ->select('p.id', 'p.firstNameJp', 'p.lastNameJp', 'p.firstNameEn', 'p.lastNameEn', 'p.nickname')
   451	            ->from(\Eccube\Entity\DtbPlayer::class, 'p');
   452	
   453	        if (!empty($searchWord)) {
   454	            $qb->where('p.firstNameJp LIKE :word OR p.lastNameJp LIKE :word OR p.firstNameEn LIKE :word OR p.lastNameEn LIKE :word OR p.nickname LIKE :word')
   455	                ->setParameter('word', '%'.$searchWord.'%');
   456	        }
   457	
   458	        $countQb = clone $qb;
   459	        $countQb->select('COUNT(p.id)');
   460	        $totalCount = (int) $countQb->getQuery()->getSingleScalarResult();
   461	        $totalPages = (int) ceil($totalCount / $limit);
   462	
   463	        $qb->setFirstResult(($page - 1) * $limit)
   464	            ->setMaxResults($limit);
   465	
   466	        $results = $qb->getQuery()->getResult();
   467	        $data = [];
   468	        foreach ($results as $row) {
   469	            $data[] = [
   470	                'id' => $row['id'],
   471	                'name' => trim(($row['lastNameJp'] ?? '').' '.($row['firstNameJp'] ?? '')),
   472	                'nameEn' => trim(($row['firstNameEn'] ?? '').' '.($row['lastNameEn'] ?? '')),
   473	                'nickname' => $row['nickname'] ?? '',
   474	            ];
   475	        }
   476	
   477	        return new JsonResponse([
   478	            'items' => $data,
   479	            'totalCount' => $totalCount,
   480	            'page' => $page,
   481	            'totalPages' => $totalPages,
   482	        ]);
   483	    }
