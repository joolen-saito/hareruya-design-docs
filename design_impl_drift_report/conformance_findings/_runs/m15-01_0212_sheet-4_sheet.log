   268	    /**
   269	     * 保存処理（新規/編集共通）.
   270	     *
   271	     * @return array<string, mixed>|RedirectResponse
   272	     */
   273	    private function save(Request $request, DtbDeck $Deck, bool $isNew = false): array|RedirectResponse
   274	    {
   275	        $form = $this->createForm(DeckType::class, $Deck);
   276	        $copyForm = $isNew ? null : $this->createForm(DeckCopyType::class);
   277	        $shops = $this->entityManager->getRepository(\Eccube\Entity\BaseInfo::class)->findAll();
   278	
   279	        if (!$isNew && !$request->isMethod('POST')) {
   280	            if ($Deck->getPlayer() !== null) {
   281	                $form->get('playerId')->setData((string) $Deck->getPlayer()->getId());
   282	            }
   283	            if ($Deck->getCardImage() !== null) {
   284	                $form->get('cardImageId')->setData((string) $Deck->getCardImage()->getId());
   285	            }
   286	            if ($Deck->getEventDetail() !== null) {
   287	                $form->get('eventDetailId')->setData((string) $Deck->getEventDetail()->getId());
   288	            }
   289	        }
   290	
   291	        $form->handleRequest($request);
   292	
   293	        if ($form->isSubmitted() && $form->isValid()) {
   294	            $User = $this->getUser();
   295	            $Member = $User instanceof \Eccube\Entity\Member ? $User : null;
   296	            $cardImageId = $form->get('cardImageId')->getData() ? (int) $form->get('cardImageId')->getData() : null;
   297	            $playerId = $form->get('playerId')->getData() ? (int) $form->get('playerId')->getData() : null;
   298	            $eventDetailId = $form->get('eventDetailId')->getData() ? (int) $form->get('eventDetailId')->getData() : null;
   299	
   300	            $input = new DeckStoreInput($Deck, $Member, $cardImageId, $playerId, $eventDetailId);
   301	
   302	            try {
   303	                $result = $this->storeAction->handle($input);
   304	
   305	                if (!empty($result['errors'])) {
   306	                    foreach ($result['errors'] as $error) {
   307	                        $this->addError($error, 'admin');
   308	                    }
   309	
   310	                    return [
   311	                        'form' => $form->createView(),
   312	                        'copyForm' => $copyForm !== null ? $copyForm->createView() : null,
   313	                        'Deck' => $Deck,
   314	                        'isNew' => $isNew,
   315	                        'shops' => $shops,
   316	                    ];
   317	                }
   318	
   319	                foreach ($result['warnings'] as $warning) {
   320	                    $this->addWarning($warning, 'admin');
   321	                }
   322	
   323	                $this->addSuccess('admin.common.save_complete', 'admin');
   324	
   325	                return $this->redirectToRoute('admin_deck_edit', ['id' => $Deck->getId()]);
   326	            } catch (\Exception $e) {
   327	                log_error('デッキ保存エラー', ['message' => $e->getMessage()]);
   328	                $this->addError('admin.common.save_error', 'admin');
   329	            }
   330	        }
   331	
   332	        return [
   333	            'form' => $form->createView(),
   334	            'copyForm' => $copyForm !== null ? $copyForm->createView() : null,
   335	            'Deck' => $Deck,
   336	            'isNew' => $isNew,
   337	            'shops' => $shops,
   338	        ];
   339	    }
