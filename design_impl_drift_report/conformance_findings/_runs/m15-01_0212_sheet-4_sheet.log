   488	    #[Route('/%eccube_admin_route%/deck/search_event', name: 'admin_deck_search_event', methods: ['POST'])]
   489	    public function searchEvent(Request $request): JsonResponse
   490	    {
   491	        $searchWord = $request->request->getString('search_word');
   492	        $shopId = $request->request->getString('shop_id');
   493	        $page = $request->request->getInt('page', 1);
   494	        $limit = 10;
   495	
   496	        $qb = $this->entityManager->createQueryBuilder()
   497	            ->select('ed.id AS eventDetailId', 'e.id AS eventId', 'e.nameJp', 'e.nameEn', 'ed.startDate')
   498	            ->from(\Eccube\Entity\DtbEventDetail::class, 'ed')
   499	            ->join('ed.Event', 'e')
   500	            ->orderBy('e.id', 'DESC')
   501	            ->addOrderBy('ed.startDate', 'DESC');
   502	
   503	        if (!empty($searchWord)) {
   504	            $qb->andWhere('e.nameJp LIKE :word OR e.nameEn LIKE :word')
   505	                ->setParameter('word', '%'.$searchWord.'%');
   506	        }
   507	
