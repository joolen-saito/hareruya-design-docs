    18	use Doctrine\ORM\EntityManagerInterface;
    19	use Eccube\Entity\MessengerJob;
    20	use Eccube\Entity\Order;
    21	use Eccube\Message\SmaregiOtcSyncMessage;
    22	use Psr\Log\LoggerInterface;
    23	use Symfony\Component\Messenger\MessageBusInterface;
    24	
    25	/**
    26	 * 店頭受取注文 (OTC) スマレジ連携を MessengerJob として enqueue するディスパッチャ。
    27	 *
    28	 * 同一 DB トランザクション内で MessengerJob を pending で永続化 → commit 成功後に
    29	 * MessageBus へ dispatch する (アウトボックス順序)。
    30	 * dispatch 失敗時は MessengerJob を FAILED に遷移させ例外を再 throw する
    31	 * (既存 SmaregiProductClassEventService::dispatchUpsert と同方針)。
    32	 */
    33	final readonly class SmaregiOtcSyncDispatcher
    34	{
    35	    public function __construct(
    36	        private MessageBusInterface $messageBus,
    37	        private EntityManagerInterface $entityManager,
    38	        private LoggerInterface $logger,
    39	    ) {
    40	    }
    41	
    42	    public function dispatch(Order $Order): MessengerJob
    43	    {
    44	        $orderId = $Order->getId();
    45	        if ($orderId === null) {
    46	            throw new \InvalidArgumentException('Order id is null; cannot enqueue Smaregi OTC sync job.');
    47	        }
    48	
    49	        $Job = new MessengerJob();
    50	        $Job->setMessageClass(SmaregiOtcSyncMessage::class);
    51	        $Job->setStatus(MessengerJob::STATUS_PENDING);
    52	        $Job->setPayloadSummary(sprintf(
    53	            'orderId=%d orderNo=%s',
    54	            $orderId,
    55	            (string) ($Order->getOrderNo() ?? ''),
    56	        ));
    57	        $this->entityManager->persist($Job);
    58	        $this->entityManager->flush();
    59	
    60	        try {
    61	            $this->messageBus->dispatch(new SmaregiOtcSyncMessage(
    62	                $orderId,
    63	                (int) $Job->getId(),
    64	            ));
    65	        } catch (\Throwable $e) {
    66	            try {
    67	                $Job->setStatus(MessengerJob::STATUS_FAILED);
    68	                $Job->setCompletedAt(new \DateTime());
    69	                $Job->setErrorMessage('メッセージバスへの投入に失敗しました: '.$e->getMessage());
    70	                $this->entityManager->flush();
    71	            } catch (\Throwable $persistError) {
    72	                $this->logger->error('Failed to persist Smaregi OTC sync job failure state', [
    73	                    'jobId' => $Job->getId(),
    74	                    'orderId' => $orderId,
    75	                    'error' => $persistError->getMessage(),
    76	                ]);
    77	            }
    78	            $this->logger->error('Smaregi OTC sync message dispatch failed', [
    79	                'exception' => $e,
    80	                'jobId' => $Job->getId(),
    81	                'orderId' => $orderId,
    82	            ]);
    83	
    84	            throw $e;
    85	        }
    86	
    87	        return $Job;
    88	    }
    89	}

