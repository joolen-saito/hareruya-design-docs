    70	                'orderId' => $Order->getId(),
    71	            ]);
    72	
    73	            return SmaregiOtcSyncResult::SKIPPED;
    74	        }
    75	
    76	        try {
    77	            $productCode = $Order->getSmaregiCode();
    78	            if ($productCode === null || $productCode === '') {
