   209	        if (!$this->isHttpSuccess($result['statusCode'])) {
   210	            return null;
   211	        }
   212	
   213	        $json = $result['json'];
   214	        if (!is_array($json)) {
   215	            return null;
   216	        }
   217	
   218	        foreach ($json as $row) {
   219	            if (($row['productCode'] ?? null) !== $productCode) {
   220	                continue;
