   191	
   192	            return SmaregiOtcSyncResult::PRODUCT_FAILED;
   193	        }
   194	
   195	        $Order->setSmaregiCode($productCode);
   196	        $Order->setSmaregiProductFlg(true);
   197	        $this->entityManager->flush();
