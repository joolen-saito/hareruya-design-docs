    77	     * @return DtbCsvImportHistory[]
    78	     */
    79	    public function getRecentCsvImportHistory(int $csvImportType, string $fileName): array
    80	    {
    81	        $createDate = (new \DateTime())->modify(self::HISTORY_PERIOD)->format('Y-m-d H:i:s');
    82	
    83	        return $this->createQueryBuilder('cih')
    84	            ->where('cih.CsvImportType = :csvImportType')
    85	            ->andWhere('cih.fileName = :fileName')
    86	            ->andWhere('cih.createDate >= :createDate')
    87	            ->setParameters(new ArrayCollection([
    88	                'csvImportType' => $csvImportType,
    89	                'fileName' => $fileName,
    90	                'createDate' => $createDate,
    91	            ]))
    92	            ->getQuery()
    93	            ->getResult();
    94	    }
    95	}

