    96	        $StockEditApproval = $Detail->getStockEditApproval();
    97	        $StockChangeTypeDetail = $StockEditApproval->getStockChangeTypeDetail();
    98	
    99	        $beforeEditQuantity = (string) ($Detail->getBeforeEditQuantity() ?? 0);
   100	        $editQuantity = (string) $Detail->getEditQuantity();
   101	        $purchaseUnitPrice = $Detail->getPurchaseUnitPrice();
   102	
   103	        // 登録時点の在庫 + 在庫増減数
   104	        $stockAfter = bcadd($beforeEditQuantity, $editQuantity, 0);
