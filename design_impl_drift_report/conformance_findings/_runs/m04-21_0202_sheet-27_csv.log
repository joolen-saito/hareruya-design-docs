    83	    public function index(Request $request, PaginatorInterface $paginator, ?int $page_no = null, ?int $page_count = null): array
    84	    {
    85	        $session = $this->session;
    86	
    87	        $BaseInfos = $this->baseInfoRepository->findAll();
    88	
    89	        $builder = $this->formFactory->createBuilder(SearchStockApprovalListType::class, null, [
    90	            'base_info' => $BaseInfos,
    91	        ]);
    92	        $searchForm = $builder->getForm();
    93	
    94	        /**
    95	         * ページの表示件数は, 以下の順に優先される.
    96	         * - リクエストパラメータ
    97	         * - セッション
    98	         * - デフォルト値
    99	         * また, セッションに保存する際は mtb_page_maxと照合し, 一致した場合のみ保存する.
   100	         **/
   101	        $sessionKeyPageNo = 'eccube.admin.stock.approval_list.search.pageNo';
   102	        $sessionKeyPageCount = 'eccube.admin.stock.approval_list.search.page_count';
   103	        $sessionKeySearch = self::SESSION_KEY_SEARCH;
   104	
   105	        $pageNo = (int) ($page_no ?? $session->get($sessionKeyPageNo, 1));
   106	        $pageCount = (int) ($page_count ?? $session->get($sessionKeyPageCount, $this->eccubeConfig['eccube_default_page_count']));
   107	        $pageCountParam = (int) $pageCount;
   108	        $PageMaxis = $this->pageMaxRepository->findAll();
   109	        if ($pageCountParam > 0) {
   110	            foreach ($PageMaxis as $PageMax) {
   111	                if ($pageCountParam === (int) $PageMax->getName()) {
   112	                    $pageCount = (int) $PageMax->getName();
   113	                    $this->session->set($sessionKeyPageCount, $pageCount);
   114	                    break;
   115	                }
   116	            }
   117	        }
   118	
   119	        $idFromQuery = $request->query->get('id', '');
   120	
   121	        if ($request->isMethod('POST')) {
   122	            $searchForm->handleRequest($request);
   123	
   124	            if ($searchForm->isValid()) {
   125	                $pageNo = 1;
   126	                $searchData = $searchForm->getData();
   127	                $this->session->set($sessionKeySearch, $this->getViewDataFromFormForSession($searchForm));
   128	                $this->session->set($sessionKeyPageNo, $pageNo);
   129	            } else {
   130	                return [
   131	                    'searchForm' => $searchForm->createView(),
   132	                    'pagination' => [],
   133	                    'listRows' => [],
   134	                    'PageMaxis' => $PageMaxis,
   135	                    'page_no' => $pageNo,
   136	                    'page_count' => $pageCount,
   137	                    'totalCount' => 0,
   138	                    'has_errors' => true,
   139	                ];
   140	            }
   141	        } elseif (ctype_digit((string) $idFromQuery)) {
   142	            // id クエリパラメータ（在庫編集承認ID）で history_source_id のみ絞り込み
   143	            $pageNo = 1;
   144	            $viewData = [
   145	                'id' => (int) $idFromQuery,
   146	                '_token' => $this->csrfTokenManager->getToken($searchForm->getConfig()->getAttribute('csrf_token_id'))->getValue(),
   147	            ];
   148	            $searchForm->submit($viewData);
   149	            $this->session->set($sessionKeySearch, $this->getViewDataFromFormForSession($searchForm));
   150	            $this->session->set($sessionKeyPageNo, $pageNo);
   151	        } else {
   152	            if ($pageNo > 0) {
   153	                $this->session->set($sessionKeyPageNo, $pageNo);
   154	            } else {
   155	                $pageNo = (int) $this->session->get($sessionKeyPageNo, 1);
   156	            }
   157	            $viewData = $this->session->get($sessionKeySearch, []);
   158	            if ($viewData === []) {
   159	                $viewData = $this->getDefaultSearchViewData($this->getMember());
   160	            }
   161	            if (empty($viewData['_token'])) {
   162	                $viewData['_token'] = $this->csrfTokenManager->getToken($searchForm->getConfig()->getAttribute('csrf_token_id'))->getValue();
   163	            }
   164	            $searchForm->submit($viewData);
   165	            $this->session->set($sessionKeySearch, $this->getViewDataFromFormForSession($searchForm));
   166	        }
   167	
   168	        $searchData = $searchForm->getData();
   169	
   170	        $qb = $this->dtbStockApprovalListRepository->getQueryBuilderBySearchDataForAdmin($searchData);
   171	        $pagination = $paginator->paginate($qb, $pageNo, $pageCount);
   172	        $totalCount = $pagination->getTotalItemCount();
   173	        $listRows = $this->approvalListRowBuilder->build($pagination->getItems());
   174	
   175	        return [
   176	            'searchForm' => $searchForm->createView(),
   177	            'pagination' => $pagination,
   178	            'listRows' => $listRows,
   179	            'PageMaxis' => $PageMaxis,
   180	            'page_no' => $pageNo,
   181	            'page_count' => $pageCount,
   182	            'totalCount' => $totalCount,
   183	            'has_errors' => false,
   184	        ];
   185	    }
