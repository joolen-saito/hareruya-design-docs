    88	     */
    89	    private function approveBeStocked(
    90	        DtbStockEditApprovalDetail $Detail,
    91	        DtbStockApprovalList $StockApprovalList,
    92	        Member $ApprovalMember,
    93	        \DateTime $approvedDate,
    94	    ): void {
