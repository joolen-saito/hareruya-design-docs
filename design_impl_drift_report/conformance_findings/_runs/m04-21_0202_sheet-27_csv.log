    62	        // 日時でソート
    63	        usort($rows, static function (StockChangeHistoryDisplayRow $a, StockChangeHistoryDisplayRow $b): int {
    64	            return $b->sortDate <=> $a->sortDate;
    65	        });
    66	
    67	        // リミットを超えた場合は切り捨てて返す
    68	        return array_slice($rows, 0, self::DISPLAY_LIMIT);
    69	    }
