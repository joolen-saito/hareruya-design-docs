    65	    <script nonce="{{ csp_nonce }}">
    66	    (function() {
    67	        'use strict';
    68	
    69	        const PRE_VALIDATE_URL = '{{ url('admin_stock_change_csv_pre_validate') }}';
    70	        const MAX_ROWS = 10000;
    71	        const MAX_ABS_QUANTITY = 99999999;
    72	        const MAX_PRICE = 999999999;
    73	        const LARGE_CHANGE_THRESHOLD = 100;
    74	
    75	        /** エラーリストを画面上に表示する */
    76	        function showErrors(errors) {
    77	            const container = document.getElementById('csv-validate-errors');
    78	            const list = document.getElementById('csv-validate-error-list');
    79	            list.innerHTML = '';
    80	            errors.forEach(function(err) {
    81	                const li = document.createElement('li');
    82	                li.textContent = err.row > 0 ? ('行 ' + err.row + ': ' + err.message) : err.message;
    83	                list.appendChild(li);
    84	            });
    85	            container.classList.remove('d-none');
    86	            container.scrollIntoView({ behavior: 'smooth', block: 'start' });
    87	        }
    88	
    89	        function hideErrors() {
    90	            document.getElementById('csv-validate-errors').classList.add('d-none');
    91	        }
    92	
    93	        /** UTF-8/BOM 対応のシンプルなCSV行パーサー */
    94	        function parseCSV(text) {
    95	            text = text.replace(/^﻿/, '');
    96	            const lines = text.split(/\r\n|\r|\n/);
    97	            return lines
    98	                .filter(function(line) { return line.trim() !== ''; })
    99	                .map(function(line) {
   100	                    const fields = [];
   101	                    let field = '';
   102	                    let inQ = false;
   103	                    for (let i = 0; i < line.length; i++) {
   104	                        const c = line[i];
   105	                        if (c === '"') {
   106	                            if (inQ && line[i + 1] === '"') { field += '"'; i++; }
   107	                            else { inQ = !inQ; }
   108	                        } else if (c === ',' && !inQ) {
   109	                            fields.push(field);
   110	                            field = '';
   111	                        } else {
   112	                            field += c;
   113	                        }
   114	                    }
   115	                    fields.push(field);
   116	                    return fields;
   117	                });
   118	        }
   119	
   120	        /** ボタンを読み込み中状態にする */
   121	        function setButtonLoading(btn, loading) {
   122	            btn.disabled = loading;
   123	            btn.textContent = loading ? '検証中...' : '{{ 'admin.common.bulk_registration'|trans|e('js') }}';
   124	        }
   125	
   126	        document.getElementById('upload-form').addEventListener('submit', function(e) {
   127	            e.preventDefault();
   128	            hideErrors();
   129	
   130	            const form = e.target;
   131	            const btn = document.getElementById('upload-button');
   132	            const fileInput = document.getElementById('admin_stock_change_csv_list_import_file');
   133	
   134	            if (!fileInput || !fileInput.files || fileInput.files.length === 0) {
   135	                showErrors([{ row: 0, message: 'CSVファイルを選択してください' }]);
   136	                return;
   137	            }
   138	
   139	            setButtonLoading(btn, true);
   140	
   141	            const reader = new FileReader();
   142	            reader.onload = function(ev) {
   143	                const text = ev.target.result;
   144	                const allRows = parseCSV(text);
   145	
   146	                // ヘッダー行を除いたデータ行
   147	                const dataRows = allRows.slice(1).filter(function(r) {
   148	                    return r.some(function(f) { return f.trim() !== ''; });
   149	                });
   150	
   151	                const errors = [];
   152	
   153	                // 2-4-1: 件数上限
   154	                if (dataRows.length === 0) {
   155	                    errors.push({ row: 0, message: 'CSVにデータがありません' });
   156	                } else if (dataRows.length > MAX_ROWS) {
   157	                    errors.push({ row: 0, message: MAX_ROWS.toLocaleString() + '件を超えています（' + dataRows.length.toLocaleString() + '件）' });
   158	                }
   159	
   160	                if (errors.length > 0) {
   161	                    setButtonLoading(btn, false);
   162	                    showErrors(errors);
   163	                    return;
   164	                }
   165	
   166	                let hasLargeChange = false;
   167	                const rowsForAjax = [];
   168	
   169	                // 2-4: フォーマット・範囲チェック（全行）
   170	                dataRows.forEach(function(fields, idx) {
   171	                    const rowNum = idx + 2;
   172	                    const productCode = (fields[0] || '').trim();
   173	                    const editQuantityStr = (fields[1] || '').trim();
   174	                    const purchasePriceStr = (fields[2] || '').trim();
   175	
   176	                    if (!productCode) {
   177	                        errors.push({ row: rowNum, message: '商品コードは必須です' });
   178	                    }
   179	
   180	                    let validQty = null;
   181	                    if (!editQuantityStr) {
   182	                        errors.push({ row: rowNum, message: '在庫増減数は必須です' });
   183	                    } else if (!/^-?\d+$/.test(editQuantityStr)) {
   184	                        errors.push({ row: rowNum, message: '在庫増減数は整数で入力してください' });
   185	                    } else {
   186	                        const qty = parseInt(editQuantityStr, 10);
   187	                        if (qty === 0) {
   188	                            // 0は未入力扱い
   189	                        } else if (qty < -MAX_ABS_QUANTITY || qty > MAX_ABS_QUANTITY) {
   190	                            errors.push({ row: rowNum, message: '在庫増減数は ' + (-MAX_ABS_QUANTITY).toLocaleString() + '〜' + MAX_ABS_QUANTITY.toLocaleString() + ' の範囲で入力してください' });
   191	                        } else {
   192	                            validQty = qty;
   193	                            if (Math.abs(qty) >= LARGE_CHANGE_THRESHOLD) { hasLargeChange = true; }
   194	                            if (productCode) {
   195	                                rowsForAjax.push({ row: rowNum, product_code: productCode, edit_quantity: qty });
   196	                            }
   197	                        }
   198	                    }
   199	
   200	                    if (purchasePriceStr !== '') {
   201	                        if (!/^\d+$/.test(purchasePriceStr)) {
   202	                            errors.push({ row: rowNum, message: '仕入単価は0以上の整数で入力してください' });
   203	                        } else {
   204	                            const price = parseInt(purchasePriceStr, 10);
   205	                            if (price === 0) {
   206	                                // 0は未入力扱い
   207	                            } else if (price >= MAX_PRICE) {
   208	                                errors.push({ row: rowNum, message: '仕入単価は ' + (MAX_PRICE - 1).toLocaleString() + ' 以下で入力してください' });
   209	                            } else if (validQty !== null) {
   210	                                // 仕入単価 × 増減数の絶対値 = 行の合計総単価チェック
   211	                                const rowTotalCost = price * Math.abs(validQty);
   212	                                if (rowTotalCost > MAX_PRICE) {
   213	                                    errors.push({ row: rowNum, message: '合計総単価が上限（' + MAX_PRICE.toLocaleString() + ' 円）を超えています（仕入単価 ' + price.toLocaleString() + ' × 数量 ' + Math.abs(validQty).toLocaleString() + ' = ' + rowTotalCost.toLocaleString() + ' 円）' });
   214	                                }
   215	                            }
   216	                        }
   217	                    }
   218	                });
   219	
   220	                // 2-5-1: フォーマットエラーがあれば全て表示して停止
   221	                if (errors.length > 0) {
   222	                    setButtonLoading(btn, false);
   223	                    showErrors(errors);
   224	                    return;
   225	                }
   226	
   227	                // Phase 2: AJAX在庫チェック（在庫上限・ゼロ以下）
   228	                const baseInfoEl = document.getElementById('admin_stock_change_csv_list_change_base_info');
   229	                const baseInfoId = baseInfoEl ? parseInt(baseInfoEl.value, 10) || 0 : 0;
   230	                const stockLocationEl = document.querySelector('input[name="admin_stock_change_csv_list[change_stock_location_id]"]:checked');
   231	                const stockLocationId = stockLocationEl ? parseInt(stockLocationEl.value, 10) || 0 : 0;
   232	
   233	                fetch(PRE_VALIDATE_URL, {
   234	                    method: 'POST',
   235	                    headers: {
   236	                        'Content-Type': 'application/json',
   237	                        'X-Requested-With': 'XMLHttpRequest',
   238	                    },
   239	                    body: JSON.stringify({
   240	                        base_info_id: baseInfoId,
   241	                        stock_location_id: stockLocationId,
   242	                        rows: rowsForAjax,
   243	                    }),
   244	                })
   245	                    .then(function(r) { return r.ok ? r.json() : Promise.reject(r.status); })
   246	                    .then(function(data) {
   247	                        setButtonLoading(btn, false);
   248	                        const ajaxErrors = data.errors || [];
   249	                        if (ajaxErrors.length > 0) {
   250	                            showErrors(ajaxErrors);
   251	                            return;
   252	                        }
   253	
   254	                        // Phase 3: 1件でも±100点以上の在庫変動がある場合の確認モーダル
   255	                        if (hasLargeChange) {
   256	                            const modalEl = document.getElementById('largeChangeConfirmModal');
   257	                            const modal = new bootstrap.Modal(modalEl);
   258	                            const okBtn = document.getElementById('large-change-confirm-ok');
   259	                            const okHandler = function() {
   260	                                modal.hide();
   261	                                form.submit();
   262	                            };
   263	                            okBtn.addEventListener('click', okHandler, { once: true });
   264	                            modalEl.addEventListener('hidden.bs.modal', function() {
   265	                                okBtn.removeEventListener('click', okHandler);
   266	                            }, { once: true });
   267	                            modal.show();
   268	                        } else {
   269	                            form.submit();
   270	                        }
   271	                    })
   272	                    .catch(function() {
   273	                        setButtonLoading(btn, false);
   274	                        showErrors([{ row: 0, message: '在庫検証中にエラーが発生しました。店舗・在庫区分を選択してから再度お試しください' }]);
   275	                    });
   276	            };
   277	
   278	            reader.onerror = function() {
   279	                setButtonLoading(btn, false);
   280	                showErrors([{ row: 0, message: 'CSVファイルの読み込みに失敗しました' }]);
   281	            };
   282	
   283	            reader.readAsText(fileInput.files[0], 'UTF-8');
   284	        });
   285	    })();
   286	    </script>
