    59	     */
    60	    private function approveDisposal(
    61	        DtbStockEditApprovalDetail $Detail,
    62	        DtbStockEditApproval $StockEditApproval,
    63	        DtbStockApprovalList $StockApprovalList,
    64	        Member $ApprovalMember,
    65	        \DateTime $approvedDate,
    66	    ): void {
    67	        $ProductStock = $Detail->getProductStock();
    68	
    69	        $StockHistory = $this->dtbStockHistoryRepository->findOneBy([
    70	            'historySourceId' => $StockEditApproval->getId(),
    71	            'HistorySourceType' => $StockApprovalList->getHistorySourceType(),
    72	            'ProductStock' => $ProductStock,
    73	        ]);
    74	        if ($StockHistory === null) {
    75	            return;
    76	        }
    77	
    78	        $StockHistory->setApprovalMember($ApprovalMember);
    79	        $StockHistory->setApprovalAt($approvedDate);
    80	        $StockHistory->setUpdateMember($ApprovalMember);
    81	    }
