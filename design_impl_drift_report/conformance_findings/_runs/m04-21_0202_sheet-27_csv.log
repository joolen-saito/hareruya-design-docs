   327	                'm_appr.name AS approver_name',
   328	                'sal.id AS sort_sal_id',
   329	                'sad.id AS sort_sad_id'
   330	            )
   331	            ->from('dtb_stock_approval_list', 'sal')
   332	            ->innerJoin('sal', 'dtb_stock_edit_approval_detail', 'sad', 'sal.history_source_id = sad.stock_edit_approval_id')
   333	            ->innerJoin('sad', 'dtb_stock_edit_approval', 'sa', 'sad.stock_edit_approval_id = sa.id')
   334	            ->innerJoin('sad', 'dtb_product_stock', 'ps', 'sad.product_stock_id = ps.id')
   335	            ->innerJoin('ps', 'dtb_product_class', 'pc', 'ps.product_class_id = pc.id')
   336	            ->innerJoin('pc', 'dtb_product', 'p', 'pc.product_id = p.id')
   337	            ->innerJoin('ps', 'dtb_base_info', 'bi', 'ps.base_info_id = bi.id')
   338	            ->innerJoin('sa', 'dtb_member', 'm_reg', 'sa.registered_member_id = m_reg.id')
   339	            ->leftJoin('sa', 'dtb_member', 'm_appr', 'sa.approval_member_id = m_appr.id')
   340	            ->leftJoin('pc', 'mtb_language', 'lang', 'pc.language_id = lang.id')
   341	            ->leftJoin('pc', 'mtb_card_condition', 'cc', 'pc.card_condition_id = cc.id')
   342	            ->leftJoin('p', 'mtb_card_detail', 'cd', 'p.card_detail_id = cd.id')
   343	            ->leftJoin('sa', 'mtb_stock_change_type_detail', 'sctd', 'sa.stock_change_type_detail_id = sctd.id')
   344	            ->leftJoin('sctd', 'mtb_stock_change_type', 'sct', 'sctd.stock_change_type_id = sct.id')
   345	            ->where('sal.history_source_type_id IN (:stockEditTypes)')
   346	            ->andWhere('sal.id IN (:ids)')
   347	            ->setParameter('stockEditTypes', [
   348	                MtbStockHistorySourceType::STOCK_EDIT,
   349	                MtbStockHistorySourceType::STOCK_BULK_EDIT,
   350	                MtbStockHistorySourceType::STOCK_CHANGE_CSV_IMPORT,
   351	            ], ArrayParameterType::INTEGER)
   352	            ->setParameter('ids', $approvalListIds, ArrayParameterType::INTEGER)
   353	            ->orderBy('sal.id', 'ASC')
   354	            ->addOrderBy('sad.id', 'ASC');
   355	
   356	        return $qb;
   357	    }
   358	}

