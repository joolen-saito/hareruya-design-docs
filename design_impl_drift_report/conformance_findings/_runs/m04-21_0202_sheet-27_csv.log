   195	    private function getDepartmentChoices(): array
   196	    {
   197	        $Members = $this->memberRepository->findAll();
   198	
   199	        $choices = [];
   200	        foreach ($Members as $Member) {
   201	            $Department = $Member->getDepartment();
   202	            if ($Department !== null) {
   203	                $departmentName = $Department->getName();
   204	                $choices[$departmentName] = $departmentName;
   205	            }
   206	        }
   207	
   208	        return $choices;
   209	    }
   210	
   211	    /**
   212	     * @return array<string, string>
   213	     */
   214	    private function getMemberChoices(?BaseInfo $BaseInfo = null): array
   215	    {
   216	        $BaseInfo ??= $this->entityManager->getRepository(BaseInfo::class)->get();
   217	        $Members = $this->memberRepository->getApprovalAuthorityMembers($BaseInfo);
   218	
   219	        // 同姓同名の場合はvalueの上書きを防ぐ為、keyを"Name(ID:xxx)"の形式としている
   220	        $nameCounts = [];
   221	        foreach ($Members as $Member) {
   222	            $name = $Member->getName();
   223	            $nameCounts[$name] = ($nameCounts[$name] ?? 0) + 1;
   224	        }
   225	
   226	        $choices = [];
   227	        foreach ($Members as $Member) {
   228	            $name = $Member->getName();
   229	            $id = (string) $Member->getId();
   230	            $key = $nameCounts[$name] > 1 ? $name.'(ID:'.$id.')' : $name;
   231	            $choices[$key] = $id;
   232	        }
   233	
   234	        return $choices;
   235	    }
