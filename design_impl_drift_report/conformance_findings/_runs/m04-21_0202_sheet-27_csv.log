   396	    #[Route(path: '/%eccube_admin_route%/product/stock/change/members', name: 'admin_stock_change_csv_members', methods: ['GET'])]
   397	    public function members(Request $request): JsonResponse
   398	    {
   399	        $baseInfoId = (int) $request->query->get('base_info_id', 0);
   400	        $BaseInfo = $this->baseInfoRepository->find($baseInfoId);
   401	
   402	        if ($BaseInfo === null) {
   403	            return new JsonResponse([]);
   404	        }
   405	
   406	        $Members = $this->memberRepository->getApprovalAuthorityMembers($BaseInfo);
   407	
   408	        $result = [];
   409	        $seen = [];
   410	        foreach ($Members as $Member) {
   411	            $name = $Member->getName();
   412	            $id = (string) $Member->getId();
   413	
   414	            if (isset($seen[$name])) {
   415	                $name = $name.'(ID:'.$id.')';
   416	            }
   417	            $seen[$Member->getName()] = true;
   418	
   419	            $result[] = [
   420	                'id' => $id,
   421	                'name' => $name,
   422	            ];
   423	        }
   424	
   425	        return new JsonResponse($result);
   426	    }
