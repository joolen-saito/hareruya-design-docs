   322	    /**
   323	     * CSVの事前検証（在庫上限・減算ゼロ以下チェック）をAJAXで行う。
   324	     * クライアントサイドのフォーマットチェック通過後に呼び出される。
   325	     */
   326	    #[Route(path: '/%eccube_admin_route%/product/stock/change/pre-validate', name: 'admin_stock_change_csv_pre_validate', methods: ['POST'])]
   327	    public function preValidate(Request $request): JsonResponse
   328	    {
   329	        try {
   330	            $body = json_decode($request->getContent(), true, 512, JSON_THROW_ON_ERROR);
   331	        } catch (\JsonException) {
   332	            return $this->json(['errors' => []]);
   333	        }
   334	
   335	        $baseInfoId = (int) ($body['base_info_id'] ?? 0);
   336	        $stockLocationId = (int) ($body['stock_location_id'] ?? 0);
   337	        $rows = \is_array($body['rows'] ?? null) ? $body['rows'] : [];
   338	
   339	        if ($baseInfoId === 0 || $stockLocationId === 0 || $rows === []) {
   340	            return $this->json(['errors' => []]);
   341	        }
   342	
   343	        $BaseInfo = $this->baseInfoRepository->find($baseInfoId);
   344	        if ($BaseInfo === null) {
   345	            return $this->json(['errors' => []]);
   346	        }
   347	
   348	        $errors = [];
   349	
   350	        foreach ($rows as $rowData) {
   351	            $rowNum = (int) ($rowData['row'] ?? 0);
   352	            $productCode = (string) ($rowData['product_code'] ?? '');
   353	            $editQuantity = (int) ($rowData['edit_quantity'] ?? 0);
   354	
   355	            $productStockId = $this->productStockRepository->getProductStockIdByProductCode(
   356	                $productCode, $BaseInfo, $stockLocationId
   357	            );
   358	
   359	            if ($productStockId === null) {
   360	                $errors[] = ['row' => $rowNum, 'message' => sprintf('商品コード「%s」が見つかりません', $productCode)];
   361	                continue;
   362	            }
   363	
   364	            $ProductStock = $this->productStockRepository->find($productStockId);
   365	            if ($ProductStock === null) {
   366	                continue;
   367	            }
   368	
   369	            $currentStock = (int) $ProductStock->getStock();
   370	            $afterStock = $currentStock + $editQuantity;
   371	
   372	            if ($editQuantity < 0 && $afterStock < 0) {
   373	                $errors[] = ['row' => $rowNum, 'message' => sprintf(
   374	                    '在庫数を超える減算です（現在庫: %s、変動後: %s）',
   375	                    number_format($currentStock), number_format($afterStock)
   376	                )];
   377	            } elseif ($afterStock > 99_999_999) {
   378	                $errors[] = ['row' => $rowNum, 'message' => sprintf(
   379	                    '在庫上限（99,999,999）を超えます（変動後: %s）',
   380	                    number_format($afterStock)
   381	                )];
   382	            } elseif ($afterStock < -99_999_999) {
   383	                $errors[] = ['row' => $rowNum, 'message' => sprintf(
   384	                    '在庫下限（-99,999,999）を下回ります（変動後: %s）',
   385	                    number_format($afterStock)
   386	                )];
   387	            }
   388	        }
   389	
   390	        return $this->json(['errors' => $errors]);
   391	    }
