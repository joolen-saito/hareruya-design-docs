    45	        $StockChangeTypeDetail = $StockEditApproval->getStockChangeTypeDetail();
    46	
    47	        if ($StockChangeTypeDetail->isTypeDisposal()) {
    48	            $this->approveDisposal($Detail, $StockEditApproval, $StockApprovalList, $ApprovalMember, $approvedDate);
