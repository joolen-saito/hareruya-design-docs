   177	    /**
   178	     * 在庫変動履歴から登録者列に表示する名前を取得
   179	     *
   180	     * operator_member_name が設定されていればそれを返す。
   181	     * 未設定の場合は RegisteredMember の名前を返す。
   182	     * どちらも空の場合は「システム」と表示する。
   183	     */
   184	    private function resolveRegisteredMemberName(DtbStockHistory $StockHistory): string
   185	    {
   186	        $operatorName = $StockHistory->getOperatorMemberName();
   187	        if ($operatorName !== null && $operatorName !== '') {
   188	            return $operatorName;
   189	        }
   190	
   191	        $RegisteredMember = $StockHistory->getRegisteredMember();
   192	        if ($RegisteredMember !== null && $RegisteredMember->getName() !== '') {
   193	            return $RegisteredMember->getName();
   194	        }
   195	
   196	        return $this->translator->trans('admin.stock.edit.history.system');
   197	    }
   198	
   199	    /**
   200	     * 承認日時を表示用文字列に変換する.
   201	     */
   202	    private function formatApprovalDate(?\DateTimeInterface $approvalAt): string
   203	    {
   204	        if ($approvalAt === null) {
   205	            return '-';
   206	        }
   207	
   208	        return $approvalAt->format('Y/m/d H:i');
   209	    }
   210	
   211	    /**
   212	     * 承認者名を表示用文字列に変換する.
   213	     */
   214	    private function resolveApprovalMemberDisplay(DtbStockHistory $StockHistory, bool $hasApprovalFlow): string
   215	    {
   216	        $ApprovalMember = $StockHistory->getApprovalMember();
   217	        if ($ApprovalMember !== null && $ApprovalMember->getName() !== '') {
   218	            return $ApprovalMember->getName();
   219	        }
   220	
   221	        if ($hasApprovalFlow && $StockHistory->getHistorySourceId() !== null) {
   222	            return $this->translator->trans('admin.stock.approval_list.approval_waiting');
   223	        }
   224	
   225	        return '-';
   226	    }
   227	
   228	    /**
   229	     * 一覧の並び順に使う日時を、承認日時 → 登録日時 → 作成日時 の優先順で取得する.
   230	     */
   231	    private function resolveSortDate(DtbStockHistory $StockHistory): \DateTimeInterface
   232	    {
   233	        return $StockHistory->getApprovalAt()
   234	            ?? $StockHistory->getRegisteredAt()
   235	            ?? $StockHistory->getCreateDate()
   236	            ?? new \DateTime();
   237	    }
