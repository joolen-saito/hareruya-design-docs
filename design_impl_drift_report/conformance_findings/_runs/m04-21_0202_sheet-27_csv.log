   234	    public function update(Request $request): RedirectResponse|array
   235	    {
   236	        // タイムアウトを無効にする
   237	        set_time_limit(0);
   238	
   239	        $approvalListIds = $request->get('approval_list_ids');
   240	        $approvalListStatus = $request->get('approval_list_status'); // 承認ステータス（承認: 2, 却下: 3）
   241	        $Member = $this->getMember();
   242	        // $rejectionReason = $request->get('rejection_reason'); // TODO 却下理由の保存は後続の実装で
   243	
   244	        $stockApprovalListIds = array_values(array_filter(
   245	            array_map('intval', (array) $approvalListIds),
   246	            fn (int $id) => $id > 0,
   247	        ));
   248	
   249	        $StockApprovalLists = $this->dtbStockApprovalListRepository->findBy(['id' => $stockApprovalListIds]);
   250	        foreach ($StockApprovalLists as $StockApprovalList) {
   251	            if (!$this->memberRepository->canApprove($Member, $StockApprovalList->getBaseInfo(), $StockApprovalList->getRegisteredMember())) {
   252	                $this->addError('admin.stock.approval_list.not_granted', 'admin');
   253	
   254	                return $this->redirectToRoute('admin_stock_approval_list');
   255	            }
   256	        }
   257	
   258	        $input = new StockApprovalListUpdateInput(
   259	            Member: $Member,
   260	            stockApprovalListIds: $stockApprovalListIds,
   261	            approvalStatus: (int) $approvalListStatus,
   262	        );
   263	
   264	        try {
   265	            $result = $this->stockApprovalListUpdateAction->handle($input);
   266	
   267	            if (isset($result['errorMessage'])) {
   268	                $this->addError($result['errorMessage'], 'admin');
   269	
   270	                return $this->redirectToRoute('admin_stock_approval_list');
   271	            }
   272	        } catch (\Exception $e) {
   273	            $this->restockNotificationProductClassIdsBuffer->clear();
   274	
   275	            $this->addError('admin.common.save_error', 'admin');
   276	
   277	            return $this->redirectToRoute('admin_stock_approval_list');
   278	        }
   279	
   280	        $event = new EventArgs([], $request);
   281	        $this->eventDispatcher->dispatch($event, EccubeEvents::ADMIN_STOCK_APPROVAL_LIST_UPDATE_COMPLETE);
   282	
   283	        $this->addSuccess('admin.common.save_complete', 'admin');
   284	
   285	        return $this->redirectToRoute('admin_stock_approval_list');
   286	    }
