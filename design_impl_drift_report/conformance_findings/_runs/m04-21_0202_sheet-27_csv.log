   428	    /**
   429	     * 在庫変更CSV雛形ダウンロード
   430	     */
   431	    #[Route(path: '/%eccube_admin_route%/product/stock/change/csv-template', name: 'admin_stock_change_csv_template', methods: ['GET'])]
   432	    public function csvTemplate(): StreamedResponse
   433	    {
   434	        set_time_limit(0);
   435	
   436	        $columns = array_keys($this->getStockChangeCsvHeader());
   437	        $encoding = $this->eccubeConfig['eccube_csv_export_encoding'];
   438	
   439	        $response = new StreamedResponse();
   440	        $response->setCallback(function () use ($columns, $encoding): void {
   441	            $row = [];
   442	            foreach ($columns as $column) {
   443	                $row[] = mb_convert_encoding($column, $encoding, 'UTF-8');
   444	            }
   445	
   446	            $fp = fopen('php://output', 'w');
   447	            if (strtoupper((string) $encoding) === 'UTF-8') {
   448	                fwrite($fp, "\xEF\xBB\xBF");
   449	            }
   450	            fputcsv($fp, $row, $this->eccubeConfig['eccube_csv_export_separator'], '"', '\\');
   451	            fclose($fp);
   452	        });
   453	
   454	        $response->headers->set('Content-Type', 'application/octet-stream');
   455	        $response->headers->set('Content-Disposition', 'attachment; filename=stock_change.csv');
   456	
   457	        return $response;
   458	    }
