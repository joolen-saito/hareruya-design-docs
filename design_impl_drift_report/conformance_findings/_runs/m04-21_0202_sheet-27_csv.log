    25	/**
    26	 * @extends AbstractRepository<DtbStockEditCsv>
    27	 */
    28	class DtbStockEditCsvRepository extends AbstractRepository
    29	{
    30	    public function __construct(
    31	        ManagerRegistry $registry,
    32	        protected BaseInfoRepository $baseInfoRepository,
    33	        protected MemberRepository $memberRepository,
    34	        protected MtbStockChangeTypeRepository $stockChangeTypeRepository,
    35	        protected MtbStockChangeTypeDetailRepository $stockChangeTypeDetailRepository,
    36	    ) {
    37	        parent::__construct($registry, DtbStockEditCsv::class);
    38	    }
    39	
    40	    /**
    41	     * CSVファイル名を登録する。
    42	     *
    43	     * @param array{
    44	     *     fileName: string,
    45	     *     memberId: int,
    46	     *     stockEditApprovalId: int,
    47	     * } $inputs 登録する情報
    48	     *
    49	     * @return ?int 在庫編集情報CSVファイルID
    50	     */
    51	    public function insertCsvFilename(array $inputs): ?int
    52	    {
    53	        $sql = <<<EOT
    54	INSERT INTO
    55	    dtb_stock_edit_csv
    56	(
    57	    file_name,
    58	    create_date,
    59	    member_id,
    60	    stock_edit_id
    61	)
    62	VALUES
    63	(
    64	    ?,
    65	    ?,
    66	    ?,
    67	    ?
    68	)
    69	EOT;
    70	
    71	        $connection = $this->getEntityManager()->getConnection();
    72	        $connection->executeStatement(
    73	            $sql,
    74	            [
    75	                $inputs['fileName'],
    76	                SqlUtil::timestamp(new \DateTime('now', new \DateTimeZone('UTC'))),
    77	                $inputs['memberId'],
    78	                $inputs['stockEditApprovalId'],
    79	            ]
    80	        );
    81	        $stockEditCsvId = (int) $connection->lastInsertId() ?: null;
    82	
    83	        return $stockEditCsvId;
    84	    }
    85	
    86	    /**
    87	     * 在庫変更CSV登録履歴を取得する.
    88	     *
    89	     * @return list<array<string, mixed>>
    90	     */
    91	    public function getStockChangeHistory(): array
    92	    {
    93	        $conn = $this->getEntityManager()->getConnection();
    94	
    95	        $sql = '
    96	            SELECT
    97	                sc.file_name,
    98	                sc.create_date,
    99	                sc.member_id,
   100	                sa.*,
   101	                (
   102	                    SELECT
   103	                        count(*)
   104	                    FROM
   105	                        dtb_stock_edit_approval_detail sd
   106	                    WHERE
   107	                        sd.stock_edit_approval_id = sc.stock_edit_id
   108	                ) as stock_change_count,
   109	                (
   110	                    SELECT
   111	                        sum(edit_quantity)
   112	                    FROM
   113	                        dtb_stock_edit_approval_detail sd
   114	                    WHERE
   115	                        sd.stock_edit_approval_id = sc.stock_edit_id
   116	                ) as stock_change_qty,
   117	                (
   118	                    SELECT
   119	                        sum(edit_quantity * purchase_unit_price)
   120	                    FROM
   121	                        dtb_stock_edit_approval_detail sd
   122	                    WHERE
   123	                        sd.stock_edit_approval_id = sc.stock_edit_id
   124	                ) as stock_change_total_price,
   125	                msd.stock_change_type_id
   126	            FROM 
   127	                dtb_stock_edit_csv sc
   128	            INNER JOIN 
   129	                dtb_stock_edit_approval sa ON sc.stock_edit_id = sa.id
   130	            INNER JOIN 
   131	                mtb_stock_change_type_detail msd ON sa.stock_change_type_detail_id = msd.id
   132	            ORDER BY
   133	                sa.id DESC
   134	        ';
   135	
   136	        $stmt = $conn->prepare($sql);
   137	        $result = $stmt->executeQuery();
   138	
   139	        $rows = [];
   140	        while ($row = $result->fetchAssociative()) {
   141	            $rows[] = [
   142	                'id' => (int) $row['id'],
   143	                'approval_status' => (int) $row['approval_status'],
   144	                'file_name' => $row['file_name'],
   145	                'stock_change_count' => $row['stock_change_count'],
   146	                'stock_change_qty' => $row['stock_change_qty'],
   147	                'stock_change_total_price' => $row['stock_change_total_price'],
   148	                'base_info' => $this->baseInfoRepository->get($row['base_info_id']),
   149	                'change_stock_location' => ProductStock::STOCK_LOCATION_ID_TO_NAME[1],
   150	                'stock_change_type_detail' => $this->stockChangeTypeRepository->get($row['stock_change_type_id']).'/'.$this->stockChangeTypeDetailRepository->get($row['stock_change_type_detail_id']),
   151	                'create_date' => $row['create_date'],
   152	                'registered_member' => $this->memberRepository->find($row['member_id']),
   153	                'approved_at' => $row['approved_at'],
   154	                'approval_member' => $this->memberRepository->find($row['approval_member_id']),
   155	            ];
   156	        }
   157	
   158	        return $rows;
   159	    }
   160	}

