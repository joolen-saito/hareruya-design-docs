    34	
    35	/**
    36	 * 在庫変更CSVをインポートするもの。
    37	 */
    38	class StockChangeCsvImportHandler extends BaseCsvImportHandler
    39	{
    40	    /** @var CsvColumnInterface 列: 商品コード */
    41	    private ?CsvColumnInterface $productCodeColumn = null;
    42	
    43	    /** @var CsvColumnInterface 列: 在庫増減数 */
    44	    private ?CsvColumnInterface $editQuantityColumn = null;
    45	
    46	    /** @var CsvColumnInterface 列: 仕入単価 */
    47	    private ?CsvColumnInterface $purchaseUnitPriceColumn = null;
    48	
    49	    private int $totalInventoryChange = 0;
    50	    private int $totalCostPriceBefore = 0;
    51	    private int $rowCount = 0;
    52	
    53	    /**
    54	     * @param StockChangeCsvImportInput $input
    55	     */
    56	    public function __construct(
    57	        private readonly DtbStockEditApprovalDetailRepository $stockEditApprovalDetailRepository,
    58	        private readonly BaseInfoRepository $baseInfoRepository,
    59	        private readonly ProductStockRepository $productStockRepository,
    60	        private readonly MtbStockHistorySourceTypeRepository $stockHistorySourceTypeRepository,
    61	        private readonly EntityManagerInterface $entityManager,
    62	        private readonly StockApprovalListEntityManager $stockApprovalListEntityManager,
    63	        private readonly Member $Member,
    64	        private StockChangeCsvImportInput $input,
    65	    ) {
    66	        $this->input = $input;
    67	    }
    68	
    69	    public function onBeforeImport(): void
    70	    {
    71	        parent::onBeforeImport();
    72	
    73	        $this->initializeColumnDefinitions();
    74	        $this->totalInventoryChange = 0;
    75	        $this->totalCostPriceBefore = 0;
    76	        $this->rowCount = 0;
    77	    }
    78	
    79	    public function onAfterImport(AfterReadEvent $event): void
    80	    {
    81	        parent::onAfterImport($event);
    82	
    83	        if ($this->rowCount > 0 && $event->isSuccessful()) {
    84	            $now = new \DateTime('now', new \DateTimeZone('UTC'));
    85	            $HistorySourceType = $this->stockHistorySourceTypeRepository->find(MtbStockHistorySourceType::STOCK_CHANGE_CSV_IMPORT);
    86	            $BaseInfo = $this->entityManager->getReference(BaseInfo::class, $this->input->changeBaseInfoId);
    87	
    88	            $this->stockApprovalListEntityManager->save(
    89	                StockApprovalList: null,
    90	                BaseInfo: $BaseInfo,
    91	                StockLocationId: $this->input->changeStockLocationId,
    92	                HistorySourceType: $HistorySourceType,
    93	                historySourceId: $this->input->stockEditApprovalId,
    94	                StockTransferTypeDetail: $this->entityManager->getReference(MtbStockChangeTypeDetail::class, $this->input->stockChangeTypeDetailId),
    95	                approvalStatus: DtbStockApprovalList::APPROVAL_STATUS_UNAPPROVED,
    96	                registeredDate: $now,
    97	                RegisteredMember: $this->entityManager->getReference(Member::class, $this->Member->getId()),
    98	                approvedDate: null,
    99	                ApprovalMember: null,
   100	                ProductStockTotalCount: $this->rowCount,
   101	                InventoryChangeTotalCount: $this->totalInventoryChange,
   102	                TotalCostPriceBefore: $this->totalCostPriceBefore,
   103	            );
   104	
   105	            $this->entityManager->flush();
   106	        }
   107	
   108	        $this->clearColumnDefinitions();
   109	    }
   110	
   111	    /**
   112	     * CSVデータ1行を取り込む。
   113	     *
   114	     * @param ReadCsvRowEvent $event イベント
   115	     *
   116	     * @return bool 読み込みに成功した場合 true
   117	     */
   118	    public function onReadRow(ReadCsvRowEvent $event): bool
   119	    {
   120	        $this->persistStockChange($event);
   121	
   122	        if ($event->isBreakAll()) {
   123	            return false;
   124	        }
   125	
   126	        return true;
   127	    }
   128	
   129	    /**
   130	     * 列の定義を取得する。
   131	     *
   132	     * @return array<CsvColumnInterface> 列の定義を CsvColumnInterface で返す。
   133	     */
   134	    protected function getColumns(): array
   135	    {
   136	        return [
   137	            $this->productCodeColumn,
   138	            $this->editQuantityColumn,
   139	            $this->purchaseUnitPriceColumn,
   140	        ];
   141	    }
   142	
   143	    /**
   144	     * 列を検証するロジックを取得する。
   145	     *
   146	     * @return array<RowValidatorInterface> 列全体を検証する定義を RowValidatorInterface で返す。
   147	     */
   148	    protected function getRowValidators(): array
   149	    {
   150	        return [
   151	            new PriceConsistencyRowValidator(1, 1),
   152	        ];
   153	    }
   154	
   155	    /**
   156	     * 列の定義を初期化する。
   157	     */
   158	    private function initializeColumnDefinitions(): void
   159	    {
   160	        $this->productCodeColumn = ColumnDefinitions::productCode()->setRequired(true);
   161	        $this->editQuantityColumn = ColumnDefinitions::editQuantity()->setRequired(true);
   162	        $this->purchaseUnitPriceColumn = ColumnDefinitions::purchaseUnitPrice()->setRequired(true);
   163	    }
   164	
   165	    /**
   166	     * 列の定義を削除し、メモリを開放する。
   167	     */
   168	    private function clearColumnDefinitions(): void
   169	    {
   170	        $this->productCodeColumn = null;
   171	        $this->editQuantityColumn = null;
   172	        $this->purchaseUnitPriceColumn = null;
   173	    }
   174	
   175	    /**
   176	     * 在庫変更情報を更新または登録する。
   177	     *
   178	     * @param ReadCsvRowEvent $event イベント
   179	     *
   180	     * @return int 在庫変更ID
   181	     */
   182	    private function persistStockChange(ReadCsvRowEvent $event): int
   183	    {
   184	        /** @var DtbStockEditApprovalDetailRepository $repository */
   185	        $repository = $this->stockEditApprovalDetailRepository;
   186	
   187	        $row = $event->getRow();
   188	        $productCode = $this->productCodeColumn->getValue($row);
   189	
   190	        // productCodeからproductStockIdを取得
   191	        $BaseInfo = $this->baseInfoRepository->find($this->input->changeBaseInfoId);
   192	        if ($BaseInfo === null) {
   193	            $event->getMessageStore()->addRawMessage(
   194	                sprintf('%d行目: 変更元拠点（ID: %d）が見つかりません', $row->getRowNumber(), $this->input->changeBaseInfoId)
   195	            );
   196	            $event->breakAll();
   197	
   198	            return 0;
   199	        }
   200	        $productStockId = $this->productStockRepository->getProductStockIdByProductCode($productCode, $BaseInfo, $this->input->changeStockLocationId);
   201	        if ($productStockId === null || $productStockId === 0) {
   202	            $event->getMessageStore()->addRawMessage(
   203	                sprintf('%d行目: 商品コード「%s」が見つかりません', $row->getRowNumber(), $productCode)
   204	            );
   205	            $event->breakAll();
   206	
   207	            return 0;
   208	        }
   209	
   210	        $ProductStock = $this->productStockRepository->find($productStockId);
   211	
   212	        $stock = [
   213	            'productStockId' => $productStockId,
   214	            'editQuantity' => $this->editQuantityColumn->getValue($row),
   215	            'purchaseUnitPrice' => $this->purchaseUnitPriceColumn->getValue($row),
   216	            'beforeEditQuantity' => $ProductStock !== null ? (int) $ProductStock->getStock() : null,
   217	            'beforePurchaseUnitPrice' => $ProductStock !== null ? $ProductStock->getUnitCost() : null,
   218	            'changeBaseInfoId' => $this->input->changeBaseInfoId,
   219	            'changeStockLocationId' => $this->input->changeStockLocationId,
   220	            'stockChangeTypeDetailId' => $this->input->stockChangeTypeDetailId,
   221	            'stockChangeReason' => $this->input->stockChangeReason,
   222	            'approvalDepartment' => $this->input->approvalDepartment,
   223	            'approvalNotificationTargetMembers' => $this->input->approvalNotificationTargetMembers,
   224	            'stockEditApprovalId' => $this->input->stockEditApprovalId,
   225	            'memberId' => $this->Member->getId(),
   226	        ];
   227	
   228	        $stockChangeId = $repository->insertStockChangeDetail($stock);
   229	
   230	        $this->totalInventoryChange += (int) $this->editQuantityColumn->getValue($row);
   231	        $this->totalCostPriceBefore += $ProductStock !== null ? (int) $ProductStock->getTotalCost() : 0;
   232	        ++$this->rowCount;
   233	
   234	        $this->entityManager->flush();
   235	
   236	        return $stockChangeId;
   237	    }
   238	}

