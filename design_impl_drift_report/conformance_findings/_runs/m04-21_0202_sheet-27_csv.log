   162	        $builder->addEventListener(FormEvents::PRE_SUBMIT, function (FormEvent $event): void {
   163	            $data = $event->getData();
   164	            $form = $event->getForm();
   165	
   166	            $baseInfoId = $data['change_base_info'] ?? null;
   167	            $BaseInfo = $baseInfoId !== null
   168	                ? $this->entityManager->getRepository(BaseInfo::class)->find((int) $baseInfoId)
   169	                : null;
