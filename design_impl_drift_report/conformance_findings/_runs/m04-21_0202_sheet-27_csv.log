   161	    /**
   162	     * 在庫変動区分を表示用文字列に変換する.
   163	     */
   164	    private function formatChangeTypeDetailLabel(?MtbStockChangeTypeDetail $StockChangeTypeDetail): string
   165	    {
   166	        if ($StockChangeTypeDetail === null) {
   167	            return '-';
   168	        }
   169	
   170	        return sprintf(
