    27	
    28	/**
    29	 * 在庫編集承認一覧の一括承認・一括却下処理。
    30	 */
    31	class StockApprovalListUpdateAction
    32	{
    33	    public function __construct(
    34	        private readonly EntityManagerInterface $entityManager,
    35	        private readonly DtbStockApprovalListRepository $dtbStockApprovalListRepository,
    36	        private readonly DtbStockEditApprovalRepository $stockEditApprovalRepository,
    37	        private readonly DtbStockEditApprovalDetailRepository $stockEditApprovalDetailRepository,
    38	        private readonly StockEditApprovalLineItemApprover $stockEditApprovalLineItemApprover,
    39	        private readonly StockEditApprovalLineItemRejecter $stockEditApprovalLineItemRejecter,
    40	    ) {
    41	    }
    42	
    43	    /**
    44	     * 在庫編集承認一覧の一括承認・一括却下処理。
    45	     *
    46	     * @return array{errorMessage?: string}
    47	     */
    48	    public function handle(StockApprovalListUpdateInput $input): array
    49	    {
    50	        $memberId = (int) $input->Member->getId();
    51	        $stockApprovalListIds = array_values(array_filter(
    52	            array_map('intval', $input->stockApprovalListIds),
    53	            fn (int $id) => $id > 0,
    54	        ));
    55	
    56	        if ($stockApprovalListIds === []) {
    57	            return ['errorMessage' => 'admin.stock.approval_list.no_approval_list_ids'];
    58	        }
    59	
    60	        if (!$this->isGrantedForStockApprovalList($stockApprovalListIds, $memberId)) {
    61	            return ['errorMessage' => 'admin.stock.approval_list.not_granted'];
    62	        }
    63	
    64	        $this->entityManager->beginTransaction();
    65	
    66	        try {
    67	            $approvedDate = new \DateTime();
    68	            $ApprovalMember = $input->Member;
    69	            $approvalStatus = $input->approvalStatus;
    70	
    71	            foreach ($stockApprovalListIds as $stockApprovalListId) {
    72	                $StockApprovalList = $this->dtbStockApprovalListRepository->find($stockApprovalListId);
    73	                if ($StockApprovalList === null) {
    74	                    continue;
    75	                }
    76	
    77	                if (!in_array($StockApprovalList->getHistorySourceTypeId(), [
    78	                    MtbStockHistorySourceType::STOCK_EDIT,
    79	                    MtbStockHistorySourceType::STOCK_BULK_EDIT,
    80	                    MtbStockHistorySourceType::STOCK_CHANGE_CSV_IMPORT,
    81	                ], true)) {
    82	                    continue;
    83	                }
    84	
    85	                $StockEditApproval = $this->stockEditApprovalRepository->find($StockApprovalList->getHistorySourceId());
    86	                if ($StockEditApproval === null) {
    87	                    continue;
    88	                }
    89	
    90	                $StockEditApprovalDetails = $this->stockEditApprovalDetailRepository->findByStockEditApprovalId(
    91	                    $StockEditApproval->getId(),
    92	                );
    93	                if ($StockEditApprovalDetails === []) {
    94	                    continue;
    95	                }
    96	
    97	                $StockApprovalList->setApprovalStatus($approvalStatus);
    98	                $StockApprovalList->setApprovedDate($approvedDate);
    99	                $StockApprovalList->setApprovalMember($ApprovalMember);
   100	
   101	                $StockEditApproval->setApprovalStatus($approvalStatus);
   102	                $StockEditApproval->setApprovalMember($ApprovalMember);
   103	                $StockEditApproval->setApprovedAt($approvedDate);
   104	
   105	                if ($approvalStatus === DtbStockApprovalList::APPROVAL_STATUS_APPROVED) {
   106	                    foreach ($StockEditApprovalDetails as $Detail) {
   107	                        $this->stockEditApprovalLineItemApprover->approve(
   108	                            $Detail,
   109	                            $StockEditApproval,
   110	                            $StockApprovalList,
   111	                            $ApprovalMember,
   112	                            $approvedDate,
   113	                        );
   114	                    }
   115	                } else {
   116	                    foreach ($StockEditApprovalDetails as $Detail) {
   117	                        $this->stockEditApprovalLineItemRejecter->reject(
   118	                            $Detail,
   119	                            $StockEditApproval,
   120	                            $StockApprovalList,
   121	                            $ApprovalMember,
   122	                            $approvedDate,
   123	                        );
   124	                    }
   125	                }
   126	            }
   127	
   128	            $this->entityManager->flush();
   129	            $this->entityManager->commit();
   130	        } catch (\Throwable $e) {
   131	            $this->entityManager->rollback();
   132	
   133	            throw $e;
   134	        }
   135	
   136	        return [];
   137	    }
   138	
   139	    /**
   140	     * 承認一覧の承認権限を確認する。
   141	     *
   142	     * @param list<int> $stockApprovalListIds
   143	     */
   144	    private function isGrantedForStockApprovalList(array $stockApprovalListIds, int $memberId): bool
   145	    {
   146	        if ($this->dtbStockApprovalListRepository->countByRegisteredMemberId($stockApprovalListIds, $memberId) > 0) {
   147	            return false;
   148	        }
   149	
   150	        $approvableApprovalListCount = $this->dtbStockApprovalListRepository->countApprovableByMemberId(
   151	            $stockApprovalListIds,
   152	            $memberId,
   153	        );
   154	
   155	        return $approvableApprovalListCount === count($stockApprovalListIds);
   156	    }
   157	}

