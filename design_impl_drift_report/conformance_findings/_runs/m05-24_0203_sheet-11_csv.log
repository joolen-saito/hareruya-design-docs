namespace Eccube\Service\Csv\Exporter;

use Eccube\Repository\OrderRepository;
use Eccube\Service\CsvExportService;
use Symfony\Component\HttpFoundation\StreamedResponse;

class ShippingStandbyCsvExporterService
{
    public function __construct(
        protected CsvExportService $csvExportService,
        protected OrderRepository $orderRepository,
    ) {
    }

    /**
     * CSVヘッダー定義 - 送り状CSV向け
     *
     * @var array{labels: array{header: array<int, string>}}
     */
    private const CSV_TYPES = [
        'labels' => [
            'header' => [
                '注文番号',
                '注文金額合計',
                '注文者氏名',
                '注文者カナ',
                '注文者郵便番号',
                '注文者都道府県',
                '注文者住所',
                '注文者住所2',
                '注文者住所3',
                '注文者会社',
                '注文者部署',
                '注文者電話番号',
                '贈り主氏名',
                '贈り主カナ',
                '贈り主郵便番号',
                '贈り主都道府県',
                '贈り主住所',
                '贈り主住所2',
                '贈り主住所3',
                '贈り主会社',
                '贈り主部署',
                '贈り主電話番号',
                '注文コメント',
                '注文備考(社内用)',
                '備考(内部用)',
                '注文確定日',
                '出荷指示日',
                '出荷日',
                '配送希望日',
                '配送希望時間帯',
                '商品金額合計',
                '送料',
                '送料(税抜)',
                '手数料',
                '手数料(税抜)',
                'のし・ラッピング手数料',
                'のし・ラッピング手数料(税抜)',
                '送料・手数料税率',
                '配送先番号',
                '荷物問い合わせURL',
                '送り状No.',
                '配送先氏名',
                '配送先カナ',
                '配送先郵便番号',
                '配送先都道府県',
                '配送先住所',
                '配送先住所2',
                '配送先住所3',
                '配送先会社名',
                '配送先部署名',
                '配送先電話番号',
                '郵便種別',
                '発送方法',
                '発送先国コード',
                '商品総重量',
                '発送方法コード',
            ],
        ],
    ];

    /**
     * @param array<int, int> $ids
     */
    public function exportByIds(
        string $exportType,
        array $ids,
    ): StreamedResponse {
        if (!isset(self::CSV_TYPES[$exportType])) {
            throw new \InvalidArgumentException('Invalid export type: '.$exportType);
        }

        $header = self::CSV_TYPES[$exportType]['header'];

        $response = new StreamedResponse();
        $response->setCallback(function () use (
            $header,
            $exportType,
            $ids,
        ): void {
            $this->csvExportService->fopen();

            // ヘッダー出力
            $this->csvExportService->fputcsv($header);

            // データ取得（選択されたIDでフィルタリング）
            $datas = $this->getDataByExportType($exportType, $ids);

            foreach ($datas as $row) {
                // データ出力
                $this->csvExportService->fputcsv($row);
            }

            $this->csvExportService->fclose();
        });
        $now = new \DateTime();
        $filename = $exportType.'_'.$now->format('YmdHis').'.csv';
        $response->headers->set('Content-Type', 'application/octet-stream');
        $response->headers->set(
            'Content-Disposition',
            'attachment; filename='.$filename,
        );

        log_info('送り状CSV出力完了. ファイル名: '.$filename);

        return $response;
    }

    /**
     * @param array<int, int> $ids
     *
     * @return iterable<array<int, int|string>>
