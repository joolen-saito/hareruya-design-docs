    90	     */
    91	    public function findWithSortedClassCategories(int $productId): ?Product
    92	    {
    93	        $qb = $this->createQueryBuilder('p');
    94	        $qb->addSelect(['pc', 'cc1', 'cc2', 'pi', 'pt', 'cd', 'c'])
    95	            ->innerJoin('p.ProductClasses', 'pc')
    96	            ->leftJoin('pc.ClassCategory1', 'cc1')
    97	            ->leftJoin('pc.ClassCategory2', 'cc2')
    98	            ->leftJoin('p.ProductImage', 'pi')
    99	            ->leftJoin('p.ProductTag', 'pt')
   100	            ->leftJoin('p.CardDetail', 'cd')
   101	            ->leftJoin('cd.Card', 'c')
   102	            ->where('p.id = :id')
   103	            ->andWhere('pc.visible = :visible')
   104	            ->setParameter('id', $productId)
   105	            ->setParameter('visible', true)
   106	            ->orderBy('cc1.sort_no', 'DESC')
   107	            ->addOrderBy('cc2.sort_no', 'DESC');
   108	
   109	        return $qb
   110	            ->getQuery()
   111	            ->getOneOrNullResult();
   112	    }

