   472	    /**
   473	     * 商品規格を登録, 更新する.
   474	     *
   475	     * @param array|ProductClass[] $ProductClasses
   476	     *
   477	     * @throws NoResultException
   478	     */
   479	    protected function saveProductClasses(Product $Product, array $ProductClasses = []): void
   480	    {
   481	        foreach ($ProductClasses as $pc) {
   482	            // 新規登録時、チェックを入れていなければ更新しない
   483	            if (!$pc->getId() && !$pc->isVisible()) {
   484	                continue;
   485	            }
   486	            $pc->setBaseInfo($Product->getBaseInfo());
