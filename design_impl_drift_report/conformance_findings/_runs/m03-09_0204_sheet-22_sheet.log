   437	    /**
   438	     * 商品規格の配列をマージする.
   439	     *
   440	     * @param array<int, ProductClass> $ProductClassesForMatrix
   441	     * @param ArrayCollection<int, ProductClass> $ProductClasses
   442	     *
   443	     * @return array|ProductClass[]
   444	     */
   445	    protected function mergeProductClasses(array $ProductClassesForMatrix, ArrayCollection $ProductClasses): array
   446	    {
   447	        $mergedProductClasses = [];
   448	        foreach ($ProductClassesForMatrix as $pcfm) {
   449	            foreach ($ProductClasses as $pc) {
   450	                if ($pcfm->getClassCategory1()->getId() === $pc->getClassCategory1()->getId()) {
   451	                    $cc2fm = $pcfm->getClassCategory2();
   452	                    $cc2 = $pc->getClassCategory2();
   453	
   454	                    if (null === $cc2fm && null === $cc2) {
   455	                        $mergedProductClasses[] = $pc;
   456	                        continue 2;
   457	                    }
   458	
   459	                    if ($cc2fm && $cc2 && $cc2fm->getId() === $cc2->getId()) {
   460	                        $mergedProductClasses[] = $pc;
   461	                        continue 2;
   462	                    }
   463	                }
   464	            }
   465	
   466	            $mergedProductClasses[] = $pcfm;
   467	        }
   468	
   469	        return $mergedProductClasses;
   470	    }
