   344	     * 2) システム廃止していない (Status=DISPLAY_SHOW で兼ねる)
   345	     * 3) 表示店舗 (base_info_id) の在庫1以上
   346	     * 4) セールタグ (Tag::SALE_ID)
   347	     * 5) セールフラグ (sale_flg = true)
   348	     * 6) 販売価格 1円以上 (price02 >= 1)
   349	     * 7) 状態最良の選出はテンプレート側 (ProductClasses sort by CardCondition.id ASC)
   350	     * 8) 並び順ランダム
   351	     *
   352	     * @return ProductClass[]
   353	     */
   354	    public function findTopSaleProductsByBaseInfo(int $baseInfoId, string $locale, int $limit): array
   355	    {
   356	        $sql = <<<'SQL'
   357	            SELECT p.id
   358	            FROM dtb_product p
   359	            LEFT JOIN mtb_region_restriction rr ON rr.id = p.region_restriction_id
   360	            WHERE p.product_status_id = :statusShow
   361	              AND (rr.display_locale_list IS NULL OR rr.display_locale_list LIKE :locale)
   362	              AND EXISTS (
   363	                  SELECT 1
   364	                  FROM dtb_product_class pc
   365	                  INNER JOIN dtb_product_stock ps ON ps.product_class_id = pc.id
   366	                  INNER JOIN dtb_product_tag pt ON pt.product_id = pc.product_id AND pt.tag_id = :saleTagId
   367	                  WHERE pc.product_id = p.id
   368	                    AND pc.visible = true
   369	                    AND pc.sale_flg = true
   370	                    AND pc.price02 >= 1
   371	                    AND ps.stock > 0
   372	                    AND ps.base_info_id = :baseInfoId
   373	              )
   374	            ORDER BY RANDOM()
   375	            LIMIT :limit
   376	            SQL;
   377	
   378	        $rows = $this->getEntityManager()->getConnection()->executeQuery($sql, [
   379	            'statusShow' => ProductStatus::DISPLAY_SHOW,
   380	            'locale' => '%'.$locale.'%',
   381	            'saleTagId' => Tag::SALE_ID,
   382	            'baseInfoId' => $baseInfoId,
   383	            'limit' => $limit,
   384	        ])->fetchAllAssociative();
   385	
   386	        $productIds = array_map(static fn (array $row): int => (int) $row['id'], $rows);
   387	        if ($productIds === []) {
   388	            return [];
   389	        }
