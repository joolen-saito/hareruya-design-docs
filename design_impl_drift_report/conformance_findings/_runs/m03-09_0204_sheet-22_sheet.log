   589	    /**
   590	     * 商品を取得する.
   591	     * 商品規格はvisible=trueのものだけを取得し, 規格分類はsort_no=DESCでソートされている.
   592	     *
   593	     * @throws NonUniqueResultException
   594	     */
   595	    protected function findProduct(string|int $id): ?Product
   596	    {
   597	        $qb = $this->productRepository->createQueryBuilder('p')
   598	            ->addSelect(['pc', 'cc1', 'cc2', 'bi'])
   599	            ->leftJoin('p.baseInfo', 'bi')
   600	            ->leftJoin('p.ProductClasses', 'pc')
   601	            ->leftJoin('pc.ClassCategory1', 'cc1')
   602	            ->leftJoin('pc.ClassCategory2', 'cc2')
   603	            ->where('p.id = :id')
   604	            ->andWhere('pc.visible = :pc_visible')
   605	            ->setParameter('id', $id)
   606	            ->setParameter('pc_visible', true)
   607	            ->orderBy('cc1.sort_no', 'DESC')
   608	            ->addOrderBy('cc2.sort_no', 'DESC');
   609	
   610	        try {
   611	            return $qb->getQuery()->getSingleResult();
   612	        } catch (NoResultException) {
   613	            return null;
   614	        }
   615	    }
