    19	    <link rel="stylesheet" href="https://use.fontawesome.com/releases/v6.5.2/css/all.css" integrity="sha384-PPIZEGYM1v8zp5Py7UjFb79S58UeqCL9pYVnVPURKEqvioPROaVAJKKLzvH2rDnI" crossorigin="anonymous">
    20	    <link rel="stylesheet" href="https://use.fontawesome.com/releases/v6.5.2/css/v4-shims.css" integrity="sha384-XyvK/kKwgVW+fuRkusfLgfhAMuaxLPSOY8W7wj8tUkf0Nr2WGHniPmpdu+cmPS5n" crossorigin="anonymous">
    21	    <link rel="stylesheet" href="{{ asset('assets/css/bootstrap.css', 'admin') }}">
