    24	            <span class="{{ form.vars.id }}-off text-dark {{ form.vars.data ? 'd-none' : '' }}">{{ form.vars.label_off|trans }}</span>
    25	        </div>
    26	        <script nonce="{{ csp_nonce }}">
    27	            $('#{{ form.vars.id }}').on('change', function (e) {
    28	                if ($(this).prop('checked')) {
    29	                    $('.{{ form.vars.id }}-on').removeClass('d-none');
    30	                    $('.{{ form.vars.id }}-off').addClass('d-none');
    31	                } else {
