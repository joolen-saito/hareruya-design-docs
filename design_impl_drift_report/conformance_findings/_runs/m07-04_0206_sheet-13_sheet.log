    68	                            $body = $this->createBody($BuyOrder, $MailTemplate);
    69	                            $form = $builder->getForm();
    70	                            $form->get('template')->setData($MailTemplate);
    71	                            $form->get('subject')->setData($MailTemplate->getMailSubject());
    72	                            $form->get('body')->setData($body);
    73	                        }
    74	                    }
