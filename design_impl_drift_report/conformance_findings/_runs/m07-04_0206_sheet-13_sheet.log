    26	    {% block stylesheet %}
    27	        <style>
    28	            {# メール履歴のアイコンCSS #}
    29	            #svgicon {
    30	                display: block;
    31	                width: 0; height: 0; overflow: hidden;
    32	            }
    33	            .cb {
    34	                display: inline-block;
    35	                width: 1em;
    36	                height: 1em;
    37	                vertical-align: middle;
    38	                fill: currentColor;
    39	            }
    40	        </style>
    41	        <style>
    42	            /* dropdownCSS */
    43	            .dropdown {
    44	                position: relative;
    45	                display: inline-block;
    46	            }
    47	
    48	            .dropdown button {
    49	                cursor: pointer;
    50	            }
    51	
    52	            .dropdown ul {
    53	                display: none;
    54	                position: absolute;
    55	                top: 100%;
    56	                left: 0;
    57	                margin: 0;
    58	                padding: 0;
    59	                list-style: none;
    60	                border: 1px solid #ccc;
    61	                background: #fff;
    62	                min-width: 120px;
    63	                z-index: 1000;
    64	            }
    65	
    66	            .dropdown ul li {
    67	                padding: 8px 12px;
    68	            }
    69	
    70	            .dropdown ul li:hover {
    71	                background: #eee;
    72	            }
    73	            .dropdown ul li a {
    74	                color: #0a0a0a;
    75	                display: block;
    76	                width: 100%;
    77	                height: 100%;
    78	            }
    79	        </style>
    80	    {% endblock %}
    81	    <script nonce="{{ csp_nonce }}">
    82	        $(function() {
    83	            $.ajaxSetup({
    84	                'headers': {
    85	                    'ECCUBE-CSRF-TOKEN': $('meta[name="eccube-csrf-token"]').attr('content')
    86	                }
    87	            });
    88	        });
    89	        document.addEventListener('DOMContentLoaded', function() {
    90	
    91	            document.querySelectorAll('.dropdown-menu-toggle').forEach(function(toggle) {
    92	                toggle.addEventListener('click', function(e) {
    93	                    e.stopPropagation();
    94	
    95	                    const menu = this.nextElementSibling;
    96	                    if (!menu) {
    97	                        return;
    98	                    }
    99	
   100	                    document.querySelectorAll('.dropdown-menu').forEach(m => {
   101	                        if (m !== menu) {
   102	                            m.style.display = 'none';
   103	                        }
   104	                    });
   105	
   106	                    if (menu.style.display === 'block') {
   107	                        menu.style.display = 'none';
   108	                        return;
   109	                    }
   110	
   111	                    menu.style.left = '';
   112	                    menu.style.right = '';
   113	
   114	                    menu.style.display = 'block';
   115	
   116	                    const menuRect = menu.getBoundingClientRect();
   117	                    const screenWidth = window.innerWidth;
   118	
   119	                    if (menuRect.right > screenWidth - 10) {
   120	                        menu.style.right = '0px';
   121	                        menu.style.left = 'auto';
   122	                    } else {
   123	                        menu.style.left = '0px';
   124	                        menu.style.right = 'auto';
   125	                    }
   126	
   127	                    const leftOffset = menu.getBoundingClientRect().left;
   128	                    if (leftOffset < 10) {
   129	                        menu.style.left = '10px';
   130	                        menu.style.right = 'auto';
   131	                    }
   132	                });
   133	            });
   134	
   135	            document.querySelectorAll('.dropdown-menu').forEach(function(menu) {
   136	                menu.addEventListener('click', function(e) {
   137	                    e.stopPropagation();
   138	                });
   139	            });
   140	
   141	            document.addEventListener('click', function() {
   142	                document.querySelectorAll('.dropdown-menu').forEach(menu => {
   143	                    menu.style.display = 'none';
   144	                });
   145	            });
   146	
   147	            document.querySelectorAll('form').forEach(function(form) {
   148	                form.addEventListener('submit', function(e) {
   149	                    const btns = form.querySelectorAll('[type="submit"]');
   150	                    btns.forEach(function(btn) { btn.disabled = true; });
   151	                    setTimeout(function() {
   152	                        if (e.defaultPrevented) {
   153	                            btns.forEach(function(btn) { btn.disabled = false; });
   154	                        }
   155	                    }, 0);
   156	                });
   157	            });
   158	
   159	            window.addEventListener('pageshow', function(e) {
   160	                if (e.persisted) {
   161	                    document.querySelectorAll('[type="submit"]').forEach(function(btn) {
   162	                        btn.disabled = false;
   163	                    });
   164	                }
   165	            });
   166	        });
   167	    </script>
