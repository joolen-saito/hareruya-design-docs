    57	        $form = $builder->getForm();
    58	
    59	        if ($request->isMethod('POST')) {
    60	            $form->handleRequest($request);
    61	            $mode = $request->get('mode');
    62	
    63	            switch ($mode) {
    64	                case 'change':
    65	                    if ($form->get('template')->isValid()) {
    66	                        $MailTemplate = $form->get('template')->getData();
