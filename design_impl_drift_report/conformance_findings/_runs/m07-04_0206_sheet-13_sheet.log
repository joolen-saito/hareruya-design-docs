    49	    public function manualMail(Request $request, int $buyOrderId): Response|RedirectResponse
    50	    {
    51	        $BuyOrder = $this->buyOrderRepository->find($buyOrderId);
    52	        if (!$BuyOrder instanceof DtbBuyOrder) {
