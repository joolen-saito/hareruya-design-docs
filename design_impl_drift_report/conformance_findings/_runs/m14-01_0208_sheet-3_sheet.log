   232	            }
   233	
   234	            if (array_diff($noDeletableCardDetailIds, $submittedCardDetailIds) !== []) {
   235	                $this->addError('admin.common.delete_error', 'admin');
   236	
   237	                return [
   238	                    'form' => $form->createView(),
   239	                    'card' => $card,
   240	                    'noDeletableCardDetailIds' => $noDeletableCardDetailIds,
   241	                ];
   242	            }
   243	
   244	            $this->entityManager->beginTransaction();
   245	            try {
   246	                $this->entityManager->persist($card);
   247	                $this->entityManager->flush();
   248	                $this->entityManager->commit();
   249	
   250	                $this->addSuccess('admin.common.save_complete', 'admin');
   251	
   252	                return $this->redirectToRoute('admin_card_edit', ['id' => $card->getId()]);
   253	            } catch (\Exception $e) {
   254	                $this->entityManager->rollback();
   255	                $this->addError('admin.common.save_error', 'admin');
   256	            }
   257	        }
   258	
   259	        return [
   260	            'form' => $form->createView(),
   261	            'card' => $card,
   262	            'noDeletableCardDetailIds' => $noDeletableCardDetailIds,
   263	        ];
   264	    }
