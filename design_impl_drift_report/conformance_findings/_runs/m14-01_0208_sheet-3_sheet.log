    61	
    62	                // 2. 実行確認（data-confirm 属性がある場合のみ表示）
    63	                const confirmMessage = $this.data('confirm');
    64	                if (confirmMessage && !confirm(confirmMessage)) {
    65	                    return false;
    66	                }
    67	
    68	                // 3. 既存の動的フィールドをクリア（二重付与防止）
    69	                $form.find('input[name="_method"], input[name="{{ constant('Eccube\\Common\\Constant::TOKEN_NAME') }}"]').remove();
    70	
    71	                // 4. HTTPメソッドの設定（data-method 属性、デフォルトは POST）
    72	                const method = $this.data('method') || 'POST';
    73	                if (method.toUpperCase() !== 'POST' && method.toUpperCase() !== 'GET') {
    74	                    $('<input />').attr({
    75	                        type: 'hidden',
    76	                        name: '_method',
    77	                        value: method.toUpperCase()
    78	                    }).appendTo($form);
    79	                }
    80	
    81	                // 5. CSRFトークンの注入（token-for-anchor 属性がある場合のみ）
