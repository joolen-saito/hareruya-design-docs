   746	    /**
   747	     * 指定された card_id 配列に対して、card / 言語ごとの最新カード画像 URL を一括取得する。
   748	     * `findBySearchParams` 内で N+1 クエリを避けるためにネイティブ SQL の DISTINCT ON でまとめて引く。
   749	     *
   750	     * @param array<int> $cardIds
   751	     *
   752	     * @return array<int, array<int, string>>
   753	     */
   754	    private function getLatestCardImagesByCardIdsNative(\Doctrine\DBAL\Connection $conn, array $cardIds): array
   755	    {
   756	        $placeholders = implode(',', array_map(fn (int $id) => $id, $cardIds));
   757	        $sql = "
   758	            SELECT DISTINCT ON (cd.card_id, ci.language_id)
   759	                cd.card_id,
   760	                ci.language_id,
   761	                ci.url
   762	            FROM mtb_card_image ci
   763	            JOIN mtb_card_detail cd ON cd.id = ci.card_detail_id
   764	            JOIN mtb_cardset cs ON cs.id = cd.cardset_id
   765	            WHERE cd.card_id IN ({$placeholders})
   766	              AND ci.back_flg = false
   767	            ORDER BY cd.card_id, ci.language_id,
   768	                     cs.special_flg ASC,
   769	                     cd.promotion_flg ASC,
   770	                     cs.release_date DESC,
   771	                     cd.foil_flg ASC
   772	        ";
   773	
   774	        $rows = $conn->executeQuery($sql)->fetchAllAssociative();
   775	        $result = [];
   776	        foreach ($rows as $row) {
   777	            $cardId = (int) $row['card_id'];
   778	            $langId = (int) $row['language_id'];
   779	            if (!isset($result[$cardId][$langId])) {
   780	                $result[$cardId][$langId] = $row['url'];
   781	            }
   782	        }
   783	
   784	        return $result;
   785	    }
