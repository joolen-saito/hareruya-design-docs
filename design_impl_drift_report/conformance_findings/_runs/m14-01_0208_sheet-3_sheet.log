   655	    /**
   656	     * cardtype / subtype / rarity 等のリレーションテーブルに対する検索条件 (AND / OR / NOT) を組み立てる。
   657	     * AND は値ごとに別エイリアスの LEFT JOIN + COUNT で全件マッチを要求し、OR / NOT は親エンティティ単位の
   658	     * EXISTS / NOT EXISTS サブクエリで判定する。$joins / $sqlParams / $joinIndex は呼び出し元で蓄積される
   659	     * JOIN 句リスト・バインド値・JOIN エイリアス連番として参照渡しで更新する。
   660	     *
   661	     * @param array<string|int> $values
   662	     * @param array<string, mixed> $sqlParams
   663	     * @param array<string> $joins
   664	     */
   665	    private function buildRelationCondition(string $table, string $column, array $values, string $condition, array &$sqlParams, int &$joinIndex, array &$joins): string
   666	    {
   667	        $values = array_unique($values);
   668	        if ($condition === 'AND') {
   669	            $clauses = [];
   670	            foreach ($values as $i => $v) {
   671	                $alias = "rel_{$joinIndex}";
   672	                $paramKey = "rel_{$joinIndex}_v";
   673	                $joins[] = "JOIN {$table} {$alias} ON {$alias}.card_id = c.id AND {$alias}.{$column} = :{$paramKey}";
   674	                $sqlParams[$paramKey] = $v;
   675	                $joinIndex++;
   676	            }
   677	
   678	            return '1=1';
   679	        }
   680	
   681	        $placeholders = [];
   682	        foreach ($values as $i => $v) {
   683	            $key = "rel_{$joinIndex}_{$i}";
   684	            $sqlParams[$key] = $v;
   685	            $placeholders[] = ":{$key}";
   686	        }
   687	        $inClause = implode(',', $placeholders);
   688	
   689	        if ($condition === 'NOT') {
   690	            $joinIndex++;
   691	
   692	            return "c.id NOT IN (SELECT card_id FROM {$table} WHERE {$column} IN ({$inClause}))";
   693	        }
   694	
   695	        $alias = "rel_{$joinIndex}";
   696	        $joins[] = "JOIN {$table} {$alias} ON {$alias}.card_id = c.id";
   697	        $joinIndex++;
   698	
   699	        return "{$alias}.{$column} IN ({$inClause})";
   700	    }
