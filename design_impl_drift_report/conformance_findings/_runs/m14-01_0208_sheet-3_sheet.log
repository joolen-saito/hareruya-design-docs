   363	        }
   364	        $sortColumn = $this->sortKeys[$sortKey] ?? $this->sortKeys[self::DEFAULT_SORT_KEY];
   365	        $qb->orderBy($sortColumn, $order);
   366	
   367	        return $qb;
   368	    }
   369	
   370	    /**
   371	     * 検索値が空でないか判定する
   372	     *
   373	     * @param mixed $value
   374	     *
   375	     * @return bool
   376	     */
   377	    private function isNotEmpty(mixed $value): bool
   378	    {
   379	        if ($value instanceof \Doctrine\Common\Collections\Collection) {
   380	            return !$value->isEmpty();
   381	        }
   382	
   383	        return !empty($value);
   384	    }
   385	
   386	    /**
   387	     * カードが削除可能かどうかを判定する.
   388	     * 商品(Product)またはデッキ(DeckCard)に紐付いている場合は削除不可とする.
   389	     */
   390	    public function isDeletable(MtbCard $card): bool
   391	    {
   392	        if (!$card->getId()) {
   393	            return true;
   394	        }
   395	
   396	        $entityManager = $this->getEntityManager();
   397	
   398	        // 1. 商品(Product)との紐付けチェック
   399	        // Product -> CardDetail -> Card の経路で確認
   400	        $productCount = (int) $entityManager->createQueryBuilder()
   401	            ->select('COUNT(Product.id)')
   402	            ->from(Product::class, 'Product')
   403	            ->innerJoin('Product.CardDetail', 'CardDetail')
   404	            ->where('CardDetail.Card = :card')
   405	            ->setParameter('card', $card)
   406	            ->getQuery()
   407	            ->getSingleScalarResult();
   408	
   409	        if ($productCount > 0) {
   410	            return false;
   411	        }
   412	
   413	        // 2. デッキ(DeckCard)との紐付けチェック
   414	        // DeckCard -> Card の直接のリレーションを確認
   415	        $deckCount = (int) $entityManager->createQueryBuilder()
   416	            ->select('COUNT(DeckCard.id)')
   417	            ->from(\Eccube\Entity\DtbDeckCard::class, 'DeckCard')
   418	            ->where('DeckCard.Card = :card')
   419	            ->setParameter('card', $card)
   420	            ->getQuery()

