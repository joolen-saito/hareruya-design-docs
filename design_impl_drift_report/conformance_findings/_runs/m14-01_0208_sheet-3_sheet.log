   707	     * @param array<string> $where
   708	     * @param array<string, mixed> $sqlParams
   709	     * @param array<string, mixed> $params
   710	     */
   711	    private function addNumericRangeCondition(array &$where, array &$sqlParams, array $params, string $name, string $dbColumn, ?string $numericGuard = null): void
   712	    {
   713	        $guardClause = $numericGuard !== null ? " AND {$numericGuard}" : '';
   714	        if (StringUtil::isNotBlank($params["{$name}_from"] ?? null)) {
   715	            $fromVal = is_array($params["{$name}_from"]) ? $params["{$name}_from"][0] : $params["{$name}_from"];
   716	            $where[] = "{$dbColumn} IS NOT NULL AND {$dbColumn} != ''{$guardClause} AND CAST({$dbColumn} AS FLOAT) >= :{$name}_from";
   717	            $sqlParams["{$name}_from"] = (float) $fromVal;
   718	        }
   719	        if (StringUtil::isNotBlank($params["{$name}_to"] ?? null)) {
   720	            $toVal = is_array($params["{$name}_to"]) ? $params["{$name}_to"][0] : $params["{$name}_to"];
   721	            $where[] = "{$dbColumn} IS NOT NULL AND {$dbColumn} != ''{$guardClause} AND CAST({$dbColumn} AS FLOAT) <= :{$name}_to";
   722	            $sqlParams["{$name}_to"] = (float) $toVal;
