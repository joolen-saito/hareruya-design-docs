    49	
    50	            // 一括操作ボタンの制御
    51	            $('#form_bulk').find('.action-submit').on('click', function(event) {
    52	                event.preventDefault();
    53	                const $this = $(this);
    54	                const $form = $('#form_bulk');
    55	
    56	                // 1. チェックボックスの選択確認
    57	                if (!$form.find('input:checkbox[name^="cardIds"]:checked').length) {
    58	                    alert(' 1つ以上のカードを選択してください。');
    59	                    return false;
