    16	namespace Eccube\Service\ListText;
    17	
    18	use Eccube\Common\EccubeConfig;
    19	use Eccube\Repository\Master\MtbCardRepository;
    20	use Eccube\Repository\Master\MtbFormatRepository;
    21	use Eccube\Repository\Master\MtbSpecialSuggestRepository;
    22	use Eccube\Service\Upload\FileManager;
    23	
    24	class CardNameListService
    25	{
    26	    public const LIST_DIRECTORY = 'list';
    27	
    28	    public function __construct(
    29	        private readonly MtbCardRepository $cardRepository,
    30	        private readonly MtbSpecialSuggestRepository $specialSuggestRepository,
    31	        private readonly MtbFormatRepository $formatRepository,
    32	        private readonly EccubeConfig $eccubeConfig,
    33	        private readonly FileManager $fileManager,
    34	    ) {
    35	    }
    36	
    37	    /**
    38	     * @param array<mixed> $option
    39	     *
    40	     * @return array{0: int, 1: string}
    41	     */
    42	    public function create(array $option = []): array
    43	    {
    44	        $cardlist = [];
    45	
    46	        // MtbCardの取得
    47	        foreach ($this->cardRepository->findAll() as $Card) {
    48	            if ($Card->getNameEn()) {
    49	                $cardlist[] = str_replace('/', '+', $Card->getNameEn());
    50	            }
    51	            if ($Card->getNameJp() && $Card->getNameEn() !== $Card->getNameJp()) {
    52	                $cardlist[] = str_replace('/', '+', $Card->getNameJp());
    53	            }
    54	        }
    55	
    56	        // SpecialSuggestの取得
    57	        foreach ($this->specialSuggestRepository->findAll() as $SpecialSuggest) {
    58	            if ($SpecialSuggest->getNameEn()) {
    59	                $cardlist[] = str_replace('/', '+', $SpecialSuggest->getNameEn());
    60	            }
    61	            if ($SpecialSuggest->getNameJp() && $SpecialSuggest->getNameEn() !== $SpecialSuggest->getNameJp()) {
    62	                $cardlist[] = str_replace('/', '+', $SpecialSuggest->getNameJp());
    63	            }
    64	        }
    65	
    66	        // 全体リストの保存
    67	        $this->saveJsonFile('cardNameList.json', $cardlist);
    68	
    69	        // フォーマット別リストの生成
    70	        $Formats = $this->formatRepository->createQueryBuilder('f')
    71	            ->where('f.code IS NOT NULL')
    72	            ->getQuery()
    73	            ->getResult();
    74	        foreach ($Formats as $Format) {
    75	            $cardlist = [];
    76	            $results = $this->formatRepository->getFormatCardListNativeQuery($Format->getId());
    77	
    78	            foreach ($results as $data) {
    79	                if ($cardNameEn = $data['name_en']) {
    80	                    $cardlist[] = $cardNameEn;
    81	                }
    82	                if ($data['name_jp'] !== $cardNameEn) {
    83	                    $cardlist[] = $data['name_jp'];
    84	                }
    85	            }
    86	
    87	            $this->saveJsonFile("cardNameList_{$Format->getCode()}.json", $cardlist);
    88	        }
    89	
    90	        return [0, 'success']; // [結果コード, メッセージ]
    91	    }
    92	
    93	    /**
    94	     * JSONファイルを保存する
    95	     *
    96	     * @param string $fileName
    97	     * @param array<mixed> $data
    98	     *
    99	     * @return void
   100	     */
   101	    private function saveJsonFile(string $fileName, array $data): void
   102	    {
   103	        // 1. JSONデータを一時的な文字列として生成
   104	        $jsonText = (string) json_encode($data, JSON_UNESCAPED_UNICODE);
   105	
   106	        // 2. 一時ファイルを作成
   107	        $tmpFile = (string) tempnam(sys_get_temp_dir(), 'cardlist');
   108	        file_put_contents($tmpFile, $jsonText);
   109	
   110	        try {
   111	            // 3. FileManagerのアダプターを取得
   112	            $fileAdapter = $this->fileManager->getAdapter();
   113	            $contentBucketOptions = $this->fileManager->getContentBucketOptions();
   114	
   115	            // 4. 保存先ディレクトリの組み立て
   116	            $savePath = $this->eccubeConfig['eccube_html_user_data_dir'].self::LIST_DIRECTORY;
   117	
   118	            // 5. アップロード実行
   119	            $fileAdapter->upload(
   120	                $tmpFile,
   121	                $savePath,
   122	                $fileName,
   123	                $contentBucketOptions
   124	            );
   125	        } finally {
   126	            // 一時ファイルの削除
   127	            if (file_exists($tmpFile)) {
   128	                unlink($tmpFile);
   129	            }
   130	        }
   131	    }
   132	}

