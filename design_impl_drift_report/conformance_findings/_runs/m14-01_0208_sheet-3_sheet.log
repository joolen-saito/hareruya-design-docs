   270	    public function delete(Request $request, MtbCard $card): RedirectResponse
   271	    {
   272	        $this->isTokenValid();
   273	
   274	        $pageNo = $this->session->get($this->sessionKey.'.page_no', 1);
   275	        $referer = $request->headers->get('referer');
   276	
   277	        $indexUrl = $this->generateUrl('admin_card_search', ['page_no' => $pageNo]).'?resume='.Constant::ENABLED;
   278	        $editUrl = $this->generateUrl('admin_card_edit', ['id' => $card->getId()]);
   279	
   280	        // 失敗時の戻り先
   281	        $isEditPage = $referer && str_contains($referer, '/edit');
   282	        $errorRedirectUrl = $isEditPage ? $editUrl : $indexUrl;
   283	
   284	        if (!$this->cardRepository->isDeletable($card)) {
   285	            $this->addError(trans('admin.card.delete.error_foreign_key', ['%card_name%' => $card->getNameJpWithEn()]), 'admin');
   286	
   287	            return $this->redirect($errorRedirectUrl);
   288	        }
   289	
   290	        try {
   291	            $this->entityManager->remove($card);
   292	            $this->entityManager->flush();
   293	        } catch (\Exception $e) {
   294	            log_error('カード削除エラー', ['id' => $card->getId(), 'message' => $e->getMessage()]);
   295	            $this->addError('admin.common.delete_error', 'admin');
   296	
   297	            return $this->redirect($errorRedirectUrl);
   298	        }
   299	
   300	        $this->addSuccess('admin.common.delete_complete', 'admin');
   301	
   302	        return $this->redirect($indexUrl);
