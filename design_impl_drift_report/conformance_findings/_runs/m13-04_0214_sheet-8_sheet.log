    39	    #[Route(path: '/%eccube_admin_route%/event/{eventId}/repeatSchedule/create', name: 'admin_repeat_schedule_create', requirements: ['eventId' => '\d+'], methods: ['GET', 'POST'])]
    40	    #[Template(template: '@admin/Event/RepeatSchedule/create.twig')]
    41	    public function create(Request $request, #[MapEntity(id: 'eventId')] DtbEvent $Event): RedirectResponse|array
