   196	                    $fieldVal = $values[$field] ?? null;
   197	                    $targetVal = $values[$target] ?? null;
   198	                    if ($fieldVal === null || $targetVal === null) {
   199	                        continue;
   200	                    }
   201	
   202	                    $timeOnlyFields = [...self::TIME_ONLY_FIELDS, ...self::TIME_ONLY_FOR_COMPARISON];
   203	                    $fieldTimeOnly = in_array($field, $timeOnlyFields, true);
   204	                    $targetTimeOnly = in_array($target, $timeOnlyFields, true);
   205	                    $after = $toComparable($fieldVal, $fieldTimeOnly);
   206	                    $before = $toComparable($targetVal, $targetTimeOnly);
   207	                    if ($after === null || $before === null) {
   208	                        continue;
   209	                    }
   210	
   211	                    $valid = match ($op) {
   212	                        '<' => $after < $before,
   213	                        '<=' => $after <= $before,
   214	                    };
   215	                    if (!$valid) {
   216	                        $form->get($field)->addError(new FormError(trans($msgKey, ['%field1%' => $label($field), '%field2%' => $label($target)], 'validators')));
   217	                    }
   218	                }
