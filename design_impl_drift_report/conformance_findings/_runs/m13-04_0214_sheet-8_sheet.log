    33	    public function handle(RepeatScheduleStoreInput $input): void
    34	    {
    35	        $Event = $input->Event;
    36	        $Member = $input->Member;
    37	        $formData = $input->formData;
    38	
    39	        $weekArr = $formData['week'];
    40	        $repeatStartDate = Carbon::parse($formData['repeatStartDate']);
    41	        $repeatEndDate = Carbon::parse($formData['repeatEndDate']);
    42	        $startTime = Carbon::parse($formData['startTime']);
    43	        $offlineEntryFlg = $formData['offlineEntryFlg'];
    44	        $entryStartTime = $formData['entryStartTime'] ?? null;
    45	        $entryEndTime = $formData['entryEndTime'] ?? null;
    46	        $deckRegistFlg = $formData['deckRegistFlg'];
    47	        $deckRegistDeadlineDays = $formData['deckRegistDeadlineDays'] ?? 0;
    48	        $deckRegistDeadlineTime = $formData['deckRegistDeadlineTime'] ?? null;
    49	        $entryFlg = $formData['entryFlg'];
    50	        $onlineEntryStartDays = $formData['onlineEntryStartDays'] ?? 0;
    51	        $onlineEntryStartTime = $formData['onlineEntryStartTime'] ?? null;
    52	        $onlineEntryEndDateDays = $formData['onlineEntryEndDateDays'] ?? 0;
    53	        $onlineEntryEndTime = $formData['onlineEntryEndTime'] ?? null;
    54	
    55	        $currentDate = $repeatStartDate->copy();
    56	
    57	        while ($currentDate <= $repeatEndDate) {
    58	            if (!in_array($currentDate->dayOfWeek, $weekArr, true)) {
    59	                $currentDate->modify('+1 day');
    60	                continue;
    61	            }
    62	
    63	            // 開始日時を取得
    64	            $startDate = Carbon::parse($currentDate->format('Y-m-d').' '.$startTime->format('H:i:s'));
    65	            $endDate = Carbon::parse($currentDate->format('Y-m-d').' '.$startTime->format('H:i:s'));
    66	
    67	            // 受付あり
    68	            $entryStartDate = null;
    69	            $entryEndDate = null;
    70	            if ($offlineEntryFlg && $entryStartTime !== null && $entryEndTime !== null) {
    71	                $entryStartDate = Carbon::parse($currentDate->format('Y-m-d').' '.$entryStartTime->format('H:i:s'));
    72	                $entryEndDate = Carbon::parse($currentDate->format('Y-m-d').' '.$entryEndTime->format('H:i:s'));
    73	            }
    74	
    75	            // デッキ登録期限
    76	            $deckRegistDeadline = null;
    77	            if ($deckRegistFlg && $deckRegistDeadlineTime !== null) {
    78	                $deckRegistDeadline = Carbon::parse($currentDate->copy()->subDays($deckRegistDeadlineDays)->format('Y-m-d').' '.$deckRegistDeadlineTime->format('H:i:s'));
    79	            }
    80	
    81	            // オンライン受付を取得
    82	            $onlineEntryStartDate = null;
    83	            $onlineEntryEndDate = null;
    84	            if ($entryFlg && $onlineEntryStartTime !== null && $onlineEntryEndTime !== null) {
    85	                $onlineEntryStartDate = Carbon::parse($currentDate->copy()->subDays($onlineEntryStartDays)->format('Y-m-d').' '.$onlineEntryStartTime->format('H:i:s'));
    86	                $onlineEntryEndDate = Carbon::parse($currentDate->copy()->subDays($onlineEntryEndDateDays)->format('Y-m-d').' '.$onlineEntryEndTime->format('H:i:s'));
    87	            }
    88	
    89	            $this->eventDetailEntityManager->save(
    90	                EventDetail: null,
    91	                Event: $Event,
    92	                startDate: $startDate,
    93	                endDate: $endDate,
    94	                Disp: $Event->getDisp(),
    95	                Member: $Member,
    96	                deadlineFlg: false,
    97	                deckRegistFlg: $deckRegistFlg,
    98	                entryFlg: $entryFlg,
    99	                holidayFlg: $this->mtbHolidayRepository->isHoliday($startDate),
   100	                entryStartDate: $entryStartDate,
   101	                entryEndDate: $entryEndDate,
   102	                onlineEntryStartDate: $onlineEntryStartDate,
   103	                onlineEntryEndDate: $onlineEntryEndDate,
   104	                deckRegistDeadline: $deckRegistDeadline,
   105	                capacity: $Event->getCapacity(),
   106	                entryFee: $Event->getEntryFee(),
   107	                prizeJp: $Event->getPrizeJp(),
   108	                prizeEn: $Event->getPrizeEn(),
   109	            );
   110	
   111	            $currentDate->modify('+1 day');
   112	        }
   113	
   114	        $this->entityManager->flush();
   115	    }
   116	}

