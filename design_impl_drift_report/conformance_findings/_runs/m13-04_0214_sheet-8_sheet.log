   180	                }
   181	
   182	                $toComparable = function (?\DateTimeInterface $dt, bool $isTimeOnly) use ($values): ?\DateTimeInterface {
   183	                    if ($dt === null) {
   184	                        return null;
   185	                    }
   186	                    if ($isTimeOnly) {
   187	                        return Carbon::parse($values['repeatStartDate'])->setTimeFromTimeString($dt->format('H:i'));
