   514	    /**
   515	     * @param list<string> $names
   516	     *
   517	     * @return array<string, MtbCard>
   518	     */
   519	    private function lookupCardsByNames(array $names): array
   520	    {
   521	        $map = [];
   522	        if ($names === []) {
   523	            return $map;
   524	        }
   525	
   526	        foreach ($this->cardRepository->findBy(['name_en' => $names]) as $Card) {
   527	            $map[$Card->getNameEn()] = $Card;
   528	        }
   529	
   530	        $remaining = array_values(array_diff($names, array_keys($map)));
   531	        if ($remaining !== []) {
   532	            foreach ($this->cardRepository->findBy(['name_jp' => $remaining]) as $Card) {
   533	                $map[$Card->getNameJp()] = $Card;
   534	            }
   535	        }
   536	
   537	        return $map;
   538	    }
   539	
   540	    private function getSimpleCardName(string $name): string
   541	    {
   542	        if (preg_match('/^(\S.*?)\s+\(\S.*\)\s+\d+/', $name, $match) === 1) {
   543	            return $match[1];
   544	        }
   545	
   546	        return $name;
   547	    }
