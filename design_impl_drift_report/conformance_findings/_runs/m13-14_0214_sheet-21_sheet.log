    45	    {
    46	        $Banners = array_values($this->bannerRepository->findBy([], ['id' => 'ASC']));
    47	        $slotCount = count($Banners);
    48	
    49	        $sortedBannerList = $this->buildSortedBannerList($form, $slotCount);
    50	        if ($sortedBannerList === []) {
    51	            return;
    52	        }
    53	
    54	        $this->entityManager->beginTransaction();
    55	        try {
    56	            $position = 1;
    57	            foreach ($Banners as $Banner) {
    58	                $sorted = $sortedBannerList[$position++];
    59	                $imageUrl = trim((string) ($form->get($sorted['image'])->getData() ?? ''));
    60	                $link = trim((string) ($form->get($sorted['link'])->getData() ?? ''));
    61	                $dispType = (int) ($form->get($sorted['dispType'])->getData() ?? MtbBanner::HIDE_BOTH);
    62	                if ($imageUrl === '') {
    63	                    $dispType = MtbBanner::HIDE_BOTH;
    64	                }
    65	                $imageAlt = trim((string) ($form->get($sorted['imageAlt'])->getData() ?? ''));
    66	                $languageIds = $form->get($sorted['languages'])->getData() ?? [];
    67	                if (!is_array($languageIds)) {
    68	                    $languageIds = [];
    69	                }
    70	                $baseInfoSelection = $form->get($sorted['baseInfos'])->getData() ?? [];
    71	                if (!is_array($baseInfoSelection)) {
    72	                    $baseInfoSelection = [];
    73	                }
    74	
    75	                $Languages = $languageIds === []
    76	                    ? []
    77	                    : $this->languageRepository->findBy(['id' => $languageIds], ['id' => 'ASC']);
    78	                $BaseInfos = [];
    79	                foreach ($baseInfoSelection as $item) {
    80	                    if ($item instanceof BaseInfo) {
    81	                        $BaseInfos[] = $item;
    82	                    }
    83	                }
    84	
    85	                $Banner
    86	                    ->setImageUrl($imageUrl)
    87	                    ->setLink($link)
    88	                    ->setDispType($dispType)
    89	                    ->setLanguages(new ArrayCollection($Languages))
    90	                    ->setBaseInfos(new ArrayCollection($BaseInfos))
    91	                    ->setImageAlt($imageAlt === '' ? null : $imageAlt);
    92	
    93	                $this->entityManager->persist($Banner);
    94	            }
    95	
    96	            $this->entityManager->flush();
    97	            $this->entityManager->commit();
    98	        } catch (\Throwable $e) {
    99	            $this->entityManager->rollback();
   100	            throw $e;
   101	        }
   102	    }
   103	
   104	    /**
   105	     * フォームの各スロットについて、`sort_no_*` の値を表示順として解釈し、昇順に並べたうえでキーを 1 からの連番に振り直す。
   106	     * 返却配列の各要素は、その順位に対応するスロットのフィールド名（`image_url_N` 等）への参照であり、
   107	     * {@see handle()} 内の保存対象バナーと位置 1..N で対応させるために使う。
   108	     *
   109	     * @return array<int, array{image: string, link: string, dispType: string, baseInfos: string, languages: string, imageAlt: string}>
   110	     */
   111	    private function buildSortedBannerList(FormInterface $form, int $slotCount): array
   112	    {
   113	        $sortedBannerList = [];
   114	        for ($slot = 1; $slot <= $slotCount; ++$slot) {
   115	            $sortNo = (int) $form->get('sort_no_'.$slot)->getData();
   116	            if ($sortNo < 1 || $sortNo > $slotCount || isset($sortedBannerList[$sortNo])) {
   117	                throw new \LogicException('sort_no_* に重複または範囲外の値が含まれています。');
   118	            }
   119	            $sortedBannerList[$sortNo] = [
   120	                'image' => 'image_url_'.$slot,
   121	                'link' => 'link_'.$slot,
   122	                'dispType' => 'disp_type_'.$slot,
   123	                'baseInfos' => 'base_info_'.$slot,
   124	                'languages' => 'language_'.$slot,
   125	                'imageAlt' => 'image_alt_'.$slot,
   126	            ];
   127	        }
   128	
   129	        ksort($sortedBannerList);
   130	
   131	        return $sortedBannerList;
   132	    }
   133	}

