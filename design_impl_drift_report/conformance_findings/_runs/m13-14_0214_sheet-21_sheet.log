    50	<script src="{{ asset('assets/js/select2.min.js', 'admin') }}" nonce="{{ csp_nonce }}"></script>
    51	<script nonce="{{ csp_nonce }}">
    52	    function copyEventBannerUrl(text) {
    53	        if (!text) {
    54	            return;
    55	        }
    56	        if (navigator.clipboard && window.isSecureContext) {
    57	            navigator.clipboard.writeText(text).catch(function () { window.prompt('URL', text); });
    58	        } else {
    59	            window.prompt('URL', text);
    60	        }
    61	    }
    62	
    63	    const eventBannerSettingAlerts = {
    64	        sortEmpty: {{ 'admin.event.banner.alert_sort_no_empty'|trans|json_encode(constant('JSON_UNESCAPED_UNICODE'))|raw }},
    65	        sortDuplicate: {{ 'admin.event.banner.alert_sort_no_duplicate'|trans|json_encode(constant('JSON_UNESCAPED_UNICODE'))|raw }}
    66	    };
    67	
    68	    $(function () {
    69	        $('.js-event-banner-setting-shops').select2({ width: '100%', closeOnSelect: true });
    70	        const eventBannerSlotCount = {{ bannerSettingSlots|length }};
    71	
    72	        /**
    73	         * @param {JQuery} $form
    74	         * @returns {boolean}
    75	         */
    76	        function validateEventBannerSortOrder($form) {
    77	            for (let slot = 1; slot <= eventBannerSlotCount; slot++) {
    78	                const $input = $form.find('[name="event_banner[sort_no_' + slot + ']"]');
    79	                if ($input.length === 0) {
    80	                    continue;
    81	                }
    82	                const raw = ($input.val() || '').toString().trim();
    83	                if (raw === '') {
    84	                    alert(eventBannerSettingAlerts.sortEmpty);
    85	                    return false;
    86	                }
    87	            }
    88	            const counts = {};
    89	            {
    90	                for (let slot = 1; slot <= eventBannerSlotCount; slot++) {
    91	                    const $sortInput = $form.find('[name="event_banner[sort_no_' + slot + ']"]');
    92	                    if ($sortInput.length === 0) {
    93	                        continue;
    94	                    }
    95	                    const trimmed = ($sortInput.val() || '').toString().trim();
    96	                    const parsed = parseInt(trimmed, 10);
    97	                    const key = (trimmed !== '' && !Number.isNaN(parsed)) ? String(parsed) : trimmed;
    98	                    counts[key] = (counts[key] || 0) + 1;
    99	                }
   100	            }
   101	            for (const k in counts) {
   102	                if (Object.prototype.hasOwnProperty.call(counts, k) && counts[k] > 1) {
   103	                    alert(eventBannerSettingAlerts.sortDuplicate.replace('__V__', k));
   104	                    return false;
   105	                }
   106	            }
   107	
   108	            return true;
   109	        }
   110	
   111	        /**
   112	         * @param {HTMLFormElement} formElement
   113	         */
   114	        function submitEventBannerSettingsForm(formElement) {
   115	            const $form = $(formElement);
   116	            if (!validateEventBannerSortOrder($form)) {
   117	                return;
   118	            }
   119	            $form.find('.js-event-banner-setting-shops').each(function () {
