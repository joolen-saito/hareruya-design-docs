namespace Eccube\Form\Type\Admin\Analysis;

use Eccube\Repository\BaseInfoRepository;
use Symfony\Component\Form\AbstractType;
use Symfony\Component\Form\Extension\Core\Type\CheckboxType;
use Symfony\Component\Form\Extension\Core\Type\ChoiceType;
use Symfony\Component\Form\Extension\Core\Type\DateType;
use Symfony\Component\Form\FormBuilderInterface;
use Symfony\Component\Form\FormEvent;
use Symfony\Component\Form\FormEvents;
use Symfony\Component\OptionsResolver\OptionsResolver;

class SummaryType extends AbstractType
{
    public function __construct(
        private readonly BaseInfoRepository $baseInfoRepository,
    ) {
    }

    public function configureOptions(OptionsResolver $resolver): void
    {
        $resolver->setDefaults([
            'csrf_protection' => false,
            'monthly_date_inputs' => false,
        ]);
        $resolver->setAllowedTypes('monthly_date_inputs', 'bool');
    }

    public function buildForm(FormBuilderInterface $builder, array $options): void
    {
        $dateFieldOptions = $options['monthly_date_inputs']
            ? [
                'required' => true,
                'input' => 'datetime',
                'widget' => 'single_text',
                'html5' => false,
                'format' => 'yyyy-MM',
            ]
            : [
                'required' => true,
                'input' => 'datetime',
                'widget' => 'single_text',
                'html5' => true,
            ];

        $builder
            ->add('summary_type', ChoiceType::class, [
                'required' => true,
                'expanded' => true,
                'multiple' => false,
                'choices' => [
                    '日次' => 'daily',
                    '月次' => 'monthly',
                ],
            ])
            ->add('summary_date_from', DateType::class, $dateFieldOptions)
            ->add('summary_date_to', DateType::class, $dateFieldOptions)
            ->add('mail_order_enabled', CheckboxType::class, [
                'required' => false,
                'label' => '通販',
            ])
            ->add('store_sales_all', CheckboxType::class, [
                'required' => false,
                'label' => '全店舗チェック',
            ])
            ->add('store_sales_targets', ChoiceType::class, [
                'required' => false,
                'expanded' => true,
                'multiple' => true,
                'choices' => $this->getPublishedStoreChoices(),
            ]);

        // 月次は yyyy-MM 形式で送られた場合に DateType 用へ月初日へ正規化する
        $builder->addEventListener(FormEvents::PRE_SUBMIT, function (FormEvent $event): void {
            $data = $event->getData();
            if (!is_array($data) || ($data['summary_type'] ?? '') !== 'monthly') {
                return;
            }

            foreach (['summary_date_from', 'summary_date_to'] as $field) {
                $value = $data[$field] ?? '';
                if (is_string($value) && preg_match('/^\d{4}-\d{2}$/', $value) === 1) {
                    $data[$field] = $value.'-01';
                }
            }

            $event->setData($data);
        });
    }

    /**
     * @return array<string, int>
     */
    private function getPublishedStoreChoices(): array
    {
        $BaseInfos = $this->baseInfoRepository->getPublicTenantShopsForSummary();
        $choices = [];

        foreach ($BaseInfos as $BaseInfo) {
            $label = trim($BaseInfo->getShortNameJp());
            if ($label === '') {
                $label = (string) ($BaseInfo->getShopName() ?? '');
            }
            if ($label === '') {
                continue;
            }
            $id = $BaseInfo->getId();
            if ($id === null) {
                continue;
            }
            $uniqueLabel = $label;
            if (isset($choices[$uniqueLabel])) {
                $uniqueLabel = sprintf('%s (ID:%d)', $label, $id);
            }
            $choices[$uniqueLabel] = $id;
        }

        return $choices;
    }

    #[\Override]
    public function getBlockPrefix(): string
    {
        return 'admin_summary';
    }
}

