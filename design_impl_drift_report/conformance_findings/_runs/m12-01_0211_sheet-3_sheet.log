        $(function () {
            $('#admin_summary_store_sales_all').on('change', function () {
                const checked = $(this).prop('checked');
                $('input[id^="admin_summary_store_sales_targets_"]').prop('checked', checked);
            });

            document.querySelectorAll('input[name="admin_summary[summary_type]"]').forEach((input) => {
