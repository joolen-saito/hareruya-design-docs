            'dateInputType' => $isMonthly ? 'month' : 'date',
            'isMonthlySummary' => $isMonthly,
        ];
    }

    /**
     * 集計期間の初期値を返す。
     * 月次: 2ヶ月前 ～ 当月、日次: 当月1日 ～ 当月末日。
     *
     * @return array{0: \DateTime, 1: \DateTime}
     */
    private function resolveInitialSummaryDateRange(string $summaryType): array
    {
        if ($summaryType === 'monthly') {
            $currentMonth = new \DateTime('first day of this month');
            $twoMonthsAgo = (clone $currentMonth)->modify('-2 months');

            return [$twoMonthsAgo, $currentMonth];
        }

        return [
            new \DateTime('first day of this month'),
            new \DateTime('last day of this month'),
        ];
    }

    /**
     * 集計対象の店舗IDを取得する。
     *
     * @param iterable<mixed> $storeSalesTargets
     *
     * @return list<int>
     */
    private function resolveTargetBaseInfoIds(
        bool $mailOrderEnabled,
        iterable $storeSalesTargets,
    ): array {
        $ids = [];
        $rootBaseInfoId = (int) $this->eccubeConfig->get('eccube_root_base_info_id');

        if ($mailOrderEnabled) {
            $ids[$rootBaseInfoId] = $rootBaseInfoId;
        }

        foreach ($storeSalesTargets as $storeId) {
            $id = (int) $storeId;
            if ($id > 0) {
                $ids[$id] = $id;
            }
        }

        return array_values($ids);
    }

    /**
     * 集計対象フォームの初期値を返す。
     * dtb_member.base_info_id が TC東京（通販）の場合は通販チェック、それ以外は所属店舗のみチェックする。
     *
     * @return array{mail_order_enabled: bool, store_sales_targets: list<int>}
     */
    private function resolveInitialSummaryTargets(): array
    {
        $Member = $this->getUser();
        if (!$Member instanceof Member) {
            return [
                'mail_order_enabled' => false,
                'store_sales_targets' => [],
            ];
        }

        $memberBaseInfoId = $Member->getBaseInfo()->getId();
        if ($memberBaseInfoId === BaseInfo::TC_TOKYO_ID) {
            return [
                'mail_order_enabled' => true,
                'store_sales_targets' => [],
            ];
        }

        return [
            'mail_order_enabled' => false,
            'store_sales_targets' => [$memberBaseInfoId],
        ];
    }
}

