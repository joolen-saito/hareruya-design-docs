    private function buildSummaryResponse(
        string $summaryType,
        FormInterface $form,
        array $summary = [],
        array $total = [],
        array $columns = [],
    ): array {
        $isMonthly = $summaryType === 'monthly';

        return [
            'searchForm' => $form->createView(),
            'summary' => $summary,
            'total' => $total,
            'columns' => $columns,
            'summaryType' => $summaryType,
