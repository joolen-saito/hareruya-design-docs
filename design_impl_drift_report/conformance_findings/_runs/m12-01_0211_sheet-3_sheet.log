    35	#[AsCommand(name: 'eccube:analysis:aggregate-daily-summary', description: '日次集計テーブル更新バッチ')]
    36	class DailySummaryAggregateCommand extends Command
    37	{
    38	    public function __construct(
    39	        private readonly BatchAggregateDailySummaryAction $batchAggregateDailySummaryAction,
    40	    ) {
    41	        parent::__construct();
    42	    }
    43	
    44	    #[\Override]
    45	    protected function configure(): void
    46	    {
    47	        $this->addArgument('date', InputArgument::OPTIONAL, '集計対象日 (Y-m-d)。省略時は前日');
    48	    }
    49	
    50	    #[\Override]
    51	    protected function execute(InputInterface $input, OutputInterface $output): int
    52	    {
    53	        $io = new SymfonyStyle($input, $output);
    54	        $dateArg = $input->getArgument('date');
    55	
    56	        if ($dateArg !== null) {
    57	            $dateArg = (string) $dateArg;
    58	            $summaryDate = \DateTime::createFromFormat('Y-m-d', $dateArg);
    59	            $errors = \DateTime::getLastErrors();
    60	            if ($summaryDate === false
    61	                || ($errors !== false && ($errors['warning_count'] > 0 || $errors['error_count'] > 0))
    62	                || $summaryDate->format('Y-m-d') !== $dateArg
    63	            ) {
    64	                $io->error('日付の形式が正しくありません。Y-m-d形式で実在する日付を指定してください。');
    65	
    66	                return Command::FAILURE;
    67	            }
    68	        } else {
    69	            $summaryDate = new \DateTime('yesterday');
    70	        }
    71	        $summaryDate->setTime(0, 0, 0);
    72	
    73	        try {
    74	            $affected = $this->batchAggregateDailySummaryAction->handle($summaryDate);
    75	        } catch (\Throwable $e) {
