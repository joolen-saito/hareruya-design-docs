    79	        }
    80	
    81	        $io->success(sprintf('日次集計テーブル更新が完了しました。対象日: %s / 更新件数: %d', $summaryDate->format('Y-m-d'), $affected));
    82	
    83	        return Command::SUCCESS;
    84	    }
    85	}
