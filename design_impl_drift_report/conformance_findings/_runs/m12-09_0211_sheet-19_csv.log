   203	     */
   204	    public function findTopAdoptedCards(int $formatId, int $baseInfoId, int $limit = 30): array
   205	    {
   206	        $redisKey = sprintf('deck_adoption_ranking:%d:%d:%d', $formatId, $baseInfoId, $limit);
   207	        try {
   208	            $cached = $this->redisService->get($redisKey);
   209	            if (is_string($cached)) {
   210	                $decoded = json_decode($cached, true);
   211	                if (is_array($decoded)) {
   212	                    return $decoded;
   213	                }
   214	            }
   215	        } catch (\Throwable $e) {
   216	            // Redis 障害時は DB フォールバック
   217	        }
   218	
   219	        $sql = <<<'SQL'
   220	            WITH top_cards AS (
   221	                SELECT c.id AS card_id,
   222	                       c.name_jp,
   223	                       c.name_en,
   224	                       c.color_sequence_id,
   225	                       SUM(dc.count)::int AS total_count
   226	                FROM dtb_deck_card dc
   227	                JOIN dtb_deck d ON dc.deck_id = d.id
   228	                JOIN mtb_card c ON dc.card_id = c.id
   229	                JOIN mtb_format f ON d.format_id = f.id
   230	                JOIN dtb_event_detail ed ON d.event_detail_id = ed.id
   231	                WHERE d.format_id = :formatId
   232	                  AND d.disp_id = :dispShow
   233	                  AND (d.private_flg = false OR d.private_flg IS NULL)
   234	                  AND d.deck_type_id = :eventDeckType
   235	                  AND ed.start_date >= NOW() - make_interval(days => f.meta_range)
   236	                  AND ed.start_date <= NOW()
   237	                  AND NOT EXISTS (
   238	                      SELECT 1 FROM dtb_card_cardtype cct
   239	                      WHERE cct.card_id = c.id AND cct.cardtype_id = :landTypeId
   240	                  )
   241	                  AND EXISTS (
   242	                      SELECT 1 FROM mtb_card_detail cd
   243	                      JOIN dtb_product p ON p.card_detail_id = cd.id
   244	                      JOIN dtb_product_class pc ON pc.product_id = p.id
   245	                      WHERE cd.card_id = c.id
   246	                        AND p.product_status_id = :publicStatusId
   247	                        AND pc.visible = true
   248	                        AND pc.price02 >= 1
   249	                  )
   250	                GROUP BY c.id, c.name_jp, c.name_en, c.color_sequence_id
   251	                ORDER BY total_count DESC, c.color_sequence_id ASC, c.name_en ASC
   252	                LIMIT :resultLimit
   253	            ),
   254	            best_product AS (
   255	                SELECT DISTINCT ON (cd.card_id)
   256	                       cd.card_id,
   257	                       p.id AS product_id,
   258	                       p.name AS product_name,
   259	                       pc.id AS product_class_id,
   260	                       pc.price02 AS price,
   261	                       pc.sale_flg,
   262	                       pc.language_id,
   263	                       cd.foil_flg
   264	                FROM mtb_card_detail cd
   265	                JOIN dtb_product p ON p.card_detail_id = cd.id
   266	                JOIN dtb_product_class pc ON pc.product_id = p.id
   267	                WHERE cd.card_id IN (SELECT card_id FROM top_cards)
   268	                  AND p.product_status_id = :publicStatusId
   269	                  AND pc.visible = true
   270	                  AND pc.price02 >= 1
   271	                ORDER BY cd.card_id,
   272	                    (CASE WHEN pc.sale_flg THEN 1 ELSE 0 END) DESC,
   273	                    (CASE WHEN cd.promotion_id = :nonPromoId THEN 1 ELSE 0 END) DESC,
   274	                    (CASE WHEN pc.language_id = :jpLangId THEN 1 ELSE 0 END) DESC,
   275	                    (CASE WHEN cd.foil_flg = :nonFoil THEN 1 ELSE 0 END) DESC
   276	            )
   277	            SELECT tc.card_id,
   278	                   tc.name_jp,
   279	                   tc.name_en,
   280	                   tc.total_count,
   281	                   bp.product_id,
   282	                   bp.product_name,
   283	                   bp.product_class_id,
   284	                   bp.price,
   285	                   bp.sale_flg,
   286	                   bp.language_id,
   287	                   l.code AS language_code,
   288	                   bp.foil_flg,
   289	                   (SELECT pi.file_name FROM dtb_product_image pi
   290	                    WHERE pi.product_id = bp.product_id
   291	                    ORDER BY pi.sort_no ASC LIMIT 1) AS image_url,
   292	                   (SELECT COALESCE(SUM(sq.sales_quantity_04), 0)::int
   293	                    FROM dtb_sales_quantity sq
   294	                    WHERE sq.product_class_id = bp.product_class_id
   295	                      AND sq.base_info_id = :baseInfoId) AS weekly_sales
   296	            FROM top_cards tc
   297	            LEFT JOIN best_product bp ON bp.card_id = tc.card_id
   298	            LEFT JOIN mtb_language l ON bp.language_id = l.id
   299	            ORDER BY tc.total_count DESC, tc.color_sequence_id ASC, tc.name_en ASC
   300	            SQL;
   301	
   302	        $rsm = new ResultSetMapping();
   303	        $rsm->addScalarResult('card_id', 'cardId', 'integer')
   304	            ->addScalarResult('name_jp', 'nameJp')
   305	            ->addScalarResult('name_en', 'nameEn')
   306	            ->addScalarResult('total_count', 'totalCount', 'integer')
   307	            ->addScalarResult('product_id', 'productId', 'integer')
   308	            ->addScalarResult('product_name', 'productName')
   309	            ->addScalarResult('product_class_id', 'productClassId', 'integer')
   310	            ->addScalarResult('price', 'price', 'integer')
   311	            ->addScalarResult('sale_flg', 'saleFlg', 'boolean')
   312	            ->addScalarResult('language_id', 'languageId', 'integer')
   313	            ->addScalarResult('language_code', 'languageCode')
   314	            ->addScalarResult('foil_flg', 'foilFlg', 'integer')
   315	            ->addScalarResult('image_url', 'imageUrl')
   316	            ->addScalarResult('weekly_sales', 'weeklySales', 'integer');
   317	
   318	        $results = $this->getEntityManager()->createNativeQuery($sql, $rsm)
   319	            ->setParameter('formatId', $formatId)
   320	            ->setParameter('baseInfoId', $baseInfoId)
   321	            ->setParameter('dispShow', MtbDisp::DISPLAY_SHOW)
   322	            ->setParameter('eventDeckType', MtbDeckType::EVENT_ID)
   323	            ->setParameter('landTypeId', MtbCardtype::LAND_ID)
   324	            ->setParameter('nonPromoId', MtbPromotion::NON_PROMOTION_ID)
   325	            ->setParameter('jpLangId', MtbLanguage::JP_ID)
   326	            ->setParameter('nonFoil', MtbCardDetail::NON_FOIL)
   327	            ->setParameter('publicStatusId', ProductStatus::DISPLAY_SHOW)
   328	            ->setParameter('resultLimit', $limit)
   329	            ->getResult();
   330	
   331	        $encoded = json_encode($results);
   332	        if ($encoded !== false && $results !== []) {
