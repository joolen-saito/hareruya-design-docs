  1216	     *
  1217	     * @param array{start_date: \DateTime, end_date: ?\DateTime, formats: iterable<MtbFormat>, include_basic: bool} $searchData
  1218	     *
  1219	     * @return iterable<int, array<string, mixed>>
  1220	     */
  1221	    public function getUsedCardsCsvExportData(array $searchData): iterable
  1222	    {
  1223	        $from = (clone $searchData['start_date'])->setTime(0, 0, 0);
  1224	        $to = $searchData['end_date'] !== null
  1225	            ? (clone $searchData['end_date'])->setTime(23, 59, 59)
