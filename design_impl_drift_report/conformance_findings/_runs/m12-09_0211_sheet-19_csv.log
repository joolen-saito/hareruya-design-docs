  1232	
  1233	        if ($formatIds === []) {
  1234	            return [];
  1235	        }
  1236	
  1237	        // 動的に IN 句のプレースホルダーを生成
  1238	        $formatParamKeys = [];
  1239	        $formatParams = [];
  1240	        foreach ($formatIds as $i => $id) {
  1241	            $key = 'fmtId'.$i;
  1242	            $formatParamKeys[] = ':'.$key;
  1243	            $formatParams[$key] = $id;
  1244	        }
  1245	        $fmtInSql = implode(',', $formatParamKeys);
  1246	
  1247	        $whereCondition = '';
  1248	        if (!$searchData['include_basic']) {
  1249	            $whereCondition = 'WHERE NOT EXISTS (
  1250	                SELECT 1 FROM dtb_card_specialtype cs_basic
  1251	                WHERE cs_basic.card_id = c.id AND cs_basic.specialtype_id = :basicId
  1252	            )';
  1253	            $formatParams['basicId'] = MtbSpecialtype::BASIC_ID;
  1254	        }
  1255	
  1256	        $params = array_merge($formatParams, [
  1257	            'dispId' => MtbDisp::DISPLAY_SHOW,
  1258	            'from' => $from->format('Y-m-d H:i:s'),
  1259	            'to' => $to->format('Y-m-d H:i:s'),
  1260	            'deckTypeId' => MtbDeckType::EVENT_ID,
  1261	            'abolishedStatusId' => ProductStatus::DISPLAY_ABOLISHED,
  1262	            'nmConditionId' => MtbCardCondition::NM,
  1263	        ]);
  1264	
  1265	        $sql = "
  1266	            SELECT
  1267	                countView.*,
  1268	                p2.id AS product_id,
  1269	                pc2.product_code,
  1270	                p2.name AS product_name,
  1271	                pc2.stock,
  1272	                pc2.price02::integer AS price,
  1273	                pc2.buy_price,
  1274	                pc2.language_id,
  1275	                cs2.code AS cardset_code,
  1276	                r.code AS rarity_code,
  1277	                cd2.foil_flg,
  1278	                cc.code AS card_condition_code,
  1279	                pc2.order_quantity_01 AS order_quantity_today,
  1280	                pc2.order_quantity_04 AS order_quantity_1week,
  1281	                pc2.order_quantity_05 AS order_quantity_1month,
  1282	                STRING_AGG(DISTINCT pt.tag_id::text, ',') AS tags
  1283	            FROM (
  1284	                SELECT
  1285	                    c.id AS card_id,
  1286	                    c.name_en AS card_name_en,
  1287	                    c.color_sequence_id,
  1288	                    SUM(dc.count)/(
  1289	                        COUNT(DISTINCT cct.cardtype_id) *
  1290	                        CASE WHEN COUNT(DISTINCT cs.specialtype_id) = 0 THEN 1 ELSE COUNT(DISTINCT cs.specialtype_id) END
  1291	                    ) AS totalCount,
  1292	                    (
  1293	                        SELECT pc.id
  1294	                        FROM mtb_card_detail cd
  1295	                        JOIN mtb_cardset cset ON cset.id = cd.cardset_id
  1296	                        JOIN dtb_product p ON p.card_detail_id = cd.id
  1297	                        JOIN dtb_product_class pc ON pc.product_id = p.id AND pc.card_condition_id = :nmConditionId
  1298	                        WHERE c.id = cd.card_id
