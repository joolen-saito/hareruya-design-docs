  1313	                LEFT JOIN dtb_card_specialtype cs ON cs.card_id = c.id
  1314	                $whereCondition
  1315	                GROUP BY c.id, c.name_en, c.color_sequence_id
  1316	            ) countView
  1317	            JOIN dtb_product_class pc2 ON countView.product_class_id = pc2.id
  1318	            JOIN mtb_card_condition cc ON cc.id = pc2.card_condition_id
  1319	            JOIN dtb_product p2 ON p2.id = pc2.product_id
  1320	            LEFT JOIN dtb_product_tag pt ON pt.product_id = p2.id
  1321	            LEFT JOIN mtb_card_detail cd2 ON cd2.id = p2.card_detail_id
  1322	            LEFT JOIN mtb_cardset cs2 ON cs2.id = cd2.cardset_id
  1323	            LEFT JOIN mtb_rarity r ON r.id = cd2.rarity_id
  1324	            GROUP BY p2.id, pc2.id, countView.card_id, countView.product_class_id, countView.totalCount, countView.color_sequence_id, countView.card_name_en, cd2.foil_flg, cs2.code, r.code, cc.code
  1325	            ORDER BY countView.totalCount DESC, countView.color_sequence_id ASC, countView.card_name_en ASC
  1326	        ";
