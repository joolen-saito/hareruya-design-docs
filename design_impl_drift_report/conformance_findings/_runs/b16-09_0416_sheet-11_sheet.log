   171	            // 管理画面から作成されたページは除外
   172	            if ($Page->getEditType() === Page::EDIT_TYPE_USER) {
   173	                return false;
   174	            }
   175	
   176	            $route = $this->router->getRouteCollection()->get($Page->getUrl());
   177	            if (is_null($route)) {
   178	                return false;
   179	            }
   180	
   181	            return count($route->compile()->getPathVariables()) < 1;
   182	        });
   183	
