    90	/**
    91	 * Class MasterdataDataType
    92	 */
    93	class MasterdataDataType extends AbstractType
    94	{
    95	    /**
    96	     * MasterdataDataType constructor.
    97	     */
    98	    public function __construct(protected EccubeConfig $eccubeConfig)
    99	    {
   100	    }
   101	
   102	    /**
   103	     * {@inheritdoc}
   104	     *
   105	     * @param array<string, mixed> $options
   106	     */
   107	    #[\Override]
   108	    public function buildForm(FormBuilderInterface $builder, array $options): void
   109	    {
   110	        $builder
   111	            ->add('id', TextType::class, [
   112	                'required' => false,
   113	                'constraints' => [
   114	                    new Assert\Length([
   115	                        'max' => $this->eccubeConfig['eccube_int_len'],
   116	                    ]),
   117	                    new Assert\Regex([
   118	                        'pattern' => '/^\d+$/u',
   119	                        'message' => 'form_error.numeric_only',
   120	                    ]),
   121	                ],
   122	            ])
   123	            ->add('name', TextType::class, [
   124	                'required' => false,
   125	            ])
   126	        ->addEventListener(FormEvents::POST_SUBMIT, function (FormEvent $event): void {
   127	            $form = $event->getForm();
   128	            $data = $form->getData();
   129	            if (isset($data['id']) && strlen($data['name'] ?? '') == 0) {
   130	                $form['name']->addError(new FormError(trans('This value should not be blank.', [], 'validators')));
