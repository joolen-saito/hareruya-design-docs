   416	    /**
   417	     * @param array<int, object> $Entities
   418	     * @param list<array{field: string, label: string, type: string, set_type: string}> $columns
   419	     *
   420	     * @return array<int, array{id: int, values: array<string, string>}>
   421	     */
   422	    private function buildEntityRows(array $Entities, array $columns): array
   423	    {
   424	        $rows = [];
   425	        foreach ($Entities as $Entity) {
   426	            /** @var int $id */
   427	            $id = $Entity->getId();
   428	            $values = [];
   429	            foreach ($columns as $column) {
   430	                $getter = 'get'.$this->toAccessorName($column['field']);
   431	                $value = $Entity->$getter();
   432	                if ($value instanceof \DateTimeInterface) {
   433	                    $values[$column['field']] = $value->format('Y-m-d H:i:s');
   434	                } elseif (is_bool($value)) {
   435	                    $values[$column['field']] = $value ? '1' : '0';
   436	                } elseif ($value === null) {
   437	                    $values[$column['field']] = '';
   438	                } else {
   439	                    $values[$column['field']] = (string) $value;
   440	                }
   441	            }
   442	            $rows[] = ['id' => $id, 'values' => $values];
   443	        }
   444	
   445	        return $rows;
   446	    }
   447	
   448	    private function toAccessorName(string $fieldName): string
   449	    {
   450	        return str_replace('_', '', ucwords($fieldName, '_'));
   451	    }
