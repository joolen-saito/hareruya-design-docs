   236	namespace Eccube\Form\Type\Admin;
   237	
   238	use Doctrine\ORM\EntityManagerInterface;
   239	use Doctrine\ORM\Mapping\Driver\AttributeDriver;
   240	use Eccube\Entity\Master\Country;
   241	use Eccube\Entity\Master\CustomerOrderStatus;
   242	use Eccube\Entity\Master\MtbColorSequence;
   243	use Eccube\Entity\Master\OrderStatus;
   244	use Eccube\Entity\Master\OrderStatusColor;
   245	use Symfony\Component\Form\AbstractType;
   246	use Symfony\Component\Form\Extension\Core\Type\ChoiceType;
   247	use Symfony\Component\Form\FormBuilderInterface;
   248	use Symfony\Component\Validator\Constraints as Assert;
   249	
   250	/**
   251	 * Class MasterdataType
   252	 */
   253	class MasterdataType extends AbstractType
   254	{
   255	    /**
   256	     * MasterdataType constructor.
   257	     */
   258	    public function __construct(protected EntityManagerInterface $entityManager)
   259	    {
   260	    }
   261	
   262	    /**
   263	     * {@inheritdoc}
   264	     *
   265	     * @param array<string, mixed> $options
   266	     */
   267	    #[\Override]
   268	    public function buildForm(FormBuilderInterface $builder, array $options): void
   269	    {
   270	        $masterdata = [];
   271	
   272	        // AttributeDriver でも有効なメタデータ一括取得に変更
   273	        foreach ($this->entityManager->getMetadataFactory()->getAllMetadata() as $meta) {
   274	            // 抽象クラスは除外
   275	            $rc = $meta->getReflectionClass();
   276	            if ($rc->isAbstract()) {
   277	                continue;
   278	            }
   279	
   280	            // OrderStatus/OrderStatusColor/CustomerOrderStatus/MtbColorSequence/Contry は対象外
   281	            if (in_array($meta->getName(), [OrderStatus::class, OrderStatusColor::class, CustomerOrderStatus::class, MtbColorSequence::class, Country::class], true)) {
   282	                continue;
   283	            }
   284	
   285	            if (str_contains($meta->rootEntityName, 'Master')
   286	                && $meta->hasField('id')
   287	                && $meta->hasField('name')
   288	                && $meta->hasField('sort_no')
   289	            ) {
   290	                $metadataName = str_replace('\\', '-', $meta->getName());
   291	                $masterdata[$metadataName] = $meta->getTableName();
   292	            }
   293	        }
   294	
   295	        $builder
   296	            ->add('masterdata', ChoiceType::class, [
   297	                'choices' => array_flip($masterdata),
   298	                'expanded' => false,
   299	                'multiple' => false,
   300	                'constraints' => [
   301	                    new Assert\NotBlank(),
   302	                ],
   303	            ])
   304	        ;
   305	    }
   306	
   307	    /**
   308	     * {@inheritdoc}
   309	     */
   310	    #[\Override]
   311	    public function getBlockPrefix(): string
   312	    {
   313	        return 'admin_system_masterdata';
   314	    }
   315	}

