  1554	                  <tr data-shape-index="1" data-shape-ref="AP7"><td class="shape-ref">AP7</td><td><a class="item-no" href="#item-sheet-6-6">(6)</a></td></tr>
  1555	                  <tr data-shape-index="2" data-shape-ref="C9"><td class="shape-ref">C9</td><td><a class="item-no" href="#item-sheet-6-1">(1)</a></td></tr>
  1556	                  <tr data-shape-index="3" data-shape-ref="L9"><td class="shape-ref">L9</td><td><a class="item-no" href="#item-sheet-6-2">(2)</a></td></tr>
  1557	                  <tr data-shape-index="4" data-shape-ref="S10"><td class="shape-ref">S10</td><td>押下すると赤枠内を表示</td></tr>
  1558	                  <tr data-shape-index="5" data-shape-ref="AF15"><td class="shape-ref">AF15</td><td><a class="item-no" href="#item-sheet-6-3">(3)</a></td></tr>
  1559	                  <tr data-shape-index="6" data-shape-ref="C17"><td class="shape-ref">C17</td><td><a class="item-no" href="#item-sheet-6-4">(4)</a></td></tr>
