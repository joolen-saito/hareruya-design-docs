    99	                $(this).find('p.modal-message').text(target.data('message'));
   100	            });
   101	        });
   102	    </script>
   103	{% endblock javascript %}
   104	
   105	{% block main %}
   106	    {% include "@admin/Card/delete_modal.twig" ignore missing %}
   107	
   108	    <form name="form1" id="form1" method="post" enctype="multipart/form-data"
   109	          action="{{ (card.id is null) ? url('admin_card_new') : url('admin_card_edit', { id: card.id }) }}">
   110	        {{ form_widget(form._token) }}
   111	
   112	        <div class="c-contentsArea__cols">
   113	            <div class="c-contentsArea__primaryCol">
   114	                <div class="c-primaryCol">
   115	                    {# 基本情報 #}
   116	                    <div class="card rounded border-0 shadow-sm mb-4">
   117	                        <div class="card-header">
   118	                            <h3 class="card-title">{{ ((card.id is null) ? 'admin.product.card_new' : 'admin.product.card_edit')|trans }}:基本情報</h3>
   119	                        </div>
   120	                        <div class="card-body">
   121	                            {{ form_row(form.nameJp) }}
   122	                            {{ form_row(form.nameEn) }}
   123	                            {{ form_row(form.arenaFormatNameJp) }}
   124	                            {{ form_row(form.arenaFormatNameEn) }}
   125	                            {{ form_row(form.textJp) }}
   126	                            {{ form_row(form.textEn) }}
   127	                            <div class="row">
   128	                                <div class="col-6">{{ form_row(form.manaCost) }}</div>
   129	                                <div class="col-6">{{ form_row(form.cmc) }}</div>
   130	                            </div>
   131	                            <div class="row">
   132	                                <div class="col-4">{{ form_row(form.power) }}</div>
   133	                                <div class="col-4">{{ form_row(form.toughness) }}</div>
   134	                                <div class="col-4">{{ form_row(form.loyalty) }}</div>
   135	                            </div>
   136	                            <div class="row">
   137	                                <div class="col-6">{{ form_row(form.cardtypes) }}</div>
   138	                            </div>
   139	                            <div class="row">
   140	                                <div class="col-6">{{ form_row(form.colors) }}</div>
   141	                                <div class="col-6">{{ form_row(form.colorIdentities) }}</div>
   142	                            </div>
   143	                            <div class="row">
   144	                                <div class="col-6">{{ form_row(form.subtypes) }}</div>
   145	                                <div class="col-6">{{ form_row(form.specialtypes) }}</div>
   146	                            </div>
   147	                            <div class="row">
   148	                                <div class="col-6">{{ form_row(form.colorSequence) }}</div>
   149	                                <div class="col-6">{{ form_row(form.isSticker) }}</div>
   150	                            </div>
   151	
   152	                            {# リーガリティ情報 #}
   153	                            <div class="row">
   154	                                <div class="col">{{ 'admin.card.restriction'|trans }}</div>
   155	                            </div>
   156	                            <div class="card-body" id="card-formats-container"
   157	                                 data-prototype='<div class="row mb-2 removable-item align-items-center border-bottom pb-2">
   158	                                <div class="col-5">{{ form_widget(form.cardFormats.vars.prototype.format)|e("html_attr") }}</div>
   159	                                <div class="col-5">{{ form_widget(form.cardFormats.vars.prototype.restriction)|e("html_attr") }}</div>
   160	                                <div class="col-2"><button type="button" class="btn btn-ec-delete delete-item">×</button></div>
   161	                             </div>'>
   162	                                {% for cardFormat in form.cardFormats %}
   163	                                    <div class="row mb-2 removable-item align-items-center border-bottom pb-2">
   164	                                        <div class="col-5">{{ form_widget(cardFormat.format) }}</div>
   165	                                        <div class="col-5">{{ form_widget(cardFormat.restriction) }}</div>
   166	                                        <div class="col-2"><button type="button" class="btn btn-ec-delete delete-item">×</button></div>
   167	                                    </div>
   168	                                {% endfor %}
   169	                            </div>
   170	                            <div class="card-body">
   171	                                <button type="button" id="add-format" class="btn btn-ec-regular">リーガリティ追加</button>
   172	                            </div>
   173	                        </div>
   174	                    </div>
   175	
   176	                    {# 詳細情報 #}
   177	                    <div class="card rounded border-0 shadow-sm mb-4">
   178	                        <div class="card-header d-flex justify-content-between align-items-center">
   179	                            <h3 class="card-title">詳細情報</h3>
   180	                        </div>
   181	                        <div class="card-body" id="card-details-container"
   182	                             data-prototype="{{ include('@admin/Card/detail_row.twig', {
   183	                                 'detailForm': form.cardDetails.vars.prototype,
   184	                                 'header_label': '新規詳細',
   185	                                 'is_deletable': true,
   186	                                 'show_images': false
   187	                             })|e('html_attr') }}">
   188	
   189	                            {% for detailForm in form.cardDetails %}
   190	                                {{ include('@admin/Card/detail_row.twig', {
   191	                                    'detailForm': detailForm,
   192	                                    'id': 'cardDetails_' ~ loop.index0,
   193	                                    'header_label': 'カード詳細ID: ' ~ (detailForm.vars.value.id|default('新規')),
   194	                                    'is_deletable': (detailForm.vars.value.id not in noDeletableCardDetailIds),
   195	                                    'show_images': true
   196	                                }) }}
   197	                            {% endfor %}
   198	                        </div>
   199	                        <div class="card-body">
   200	                            <button type="button" id="add-detail" class="btn btn-ec-regular">詳細情報を追加</button>
   201	                        </div>
   202	                    </div>
   203	                </div>
   204	            </div>
   205	        </div>
   206	
   207	        <div class="c-conversionArea">
   208	            <div class="c-conversionArea__container">
   209	                <div class="row align-items-center">
   210	                    <div class="col-6">
   211	                        <div class="c-conversionArea__leftBlockItem">
   212	                            <a class="c-baseLink" href="{{ url('admin_card_list', { 'resume': 1 }) }}">
   213	                                <i class="fa fa-backward" aria-hidden="true"></i>
   214	                                <span>{{ 'admin.product.card_list'|trans }}</span>
   215	                            </a>
   216	                            {% if card.getId() is not null %}
   217	                                <a class="ms-5 btn btn-ec-delete px-5" data-bs-toggle="modal" data-bs-target="#DeleteModal"
   218	                                   data-url="{{ url('admin_card_delete', {id: card.getId()}) }}"
   219	                                   data-message="{{ 'admin.common.delete_modal__message'|trans({ "%name%" : card.getNameJpWithEn }) }}">
   220	                                    {{ 'admin.common.delete' | trans }}
   221	                                </a>
   222	                            {% endif %}
   223	                        </div>
   224	                    </div>
   225	                    <div class="col-6 text-end">
   226	                        <button class="btn btn-ec-conversion px-5" type="submit">
   227	                            {{ 'admin.common.registration'|trans }}
   228	                        </button>
   229	                    </div>
   230	                </div>
   231	            </div>
   232	        </div>
   233	    </form>
   234	{% endblock main %}

