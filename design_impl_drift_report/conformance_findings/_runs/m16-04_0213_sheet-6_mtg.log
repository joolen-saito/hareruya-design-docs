   158	
   159	use Symfony\Component\Form\AbstractType;
   160	use Symfony\Component\Form\Extension\Core\Type\CollectionType;
   161	use Symfony\Component\Form\Extension\Core\Type\HiddenType;
   162	use Symfony\Component\Form\FormBuilderInterface;
   163	use Symfony\Component\Form\FormError;
   164	use Symfony\Component\Form\FormEvent;
   165	use Symfony\Component\Form\FormEvents;
   166	
   167	class MasterdataEditType extends AbstractType
   168	{
   169	    /**
   170	     * {@inheritdoc}
   171	     *
   172	     * @param array<string, mixed> $options
   173	     */
   174	    #[\Override]
   175	    public function buildForm(FormBuilderInterface $builder, array $options): void
   176	    {
   177	        $builder
   178	            ->add('data', CollectionType::class, [
   179	                'entry_type' => MasterdataDataType::class,
   180	                'allow_add' => true,
   181	                'allow_delete' => true,
   182	                'prototype' => true,
   183	            ])
   184	            ->add('masterdata_name', HiddenType::class)
   185	            ->addEventListener(FormEvents::POST_SUBMIT, function (FormEvent $event): void {
   186	                $form = $event->getForm();
   187	                $data = $event->getData();
   188	
   189	                // IDのみを配列化
   190	                $ids = [];
   191	                foreach ($data['data'] as $key => $value) {
   192	                    if (isset($value['id'])) {
   193	                        $ids[$key] = $value['id'];
   194	                    }
   195	                }
   196	
   197	                if (count($ids) > 0) {
   198	                    // 重複IDチェック
   199	                    $idCount = array_count_values($ids);
   200	                    foreach ($idCount as $id => $count) {
   201	                        // 同じIDの数が2つ以上の場合は重複
   202	                        if ($count >= 2) {
   203	                            $keys = array_keys($ids, $id);
   204	                            // 重複した全ての入力項目にエラーを出力
   205	                            foreach ($keys as $key) {
   206	                                $form['data'][$key]['id']->addError(new FormError(trans('admin.setting.system.master_data.duplicate_id')));
   207	                            }
   208	                        }
   209	                    }
   210	                }
   211	            });
   212	    }
   213	
   214	    /**
   215	     * {@inheritdoc}
   216	     */
   217	    #[\Override]
   218	    public function getBlockPrefix(): string
   219	    {
   220	        return 'admin_system_masterdata_edit';
   221	    }
   222	}
