          </nav>
          <div class="doc-flow">
            <h3 class="doc-h doc-h-section" style="--lv:0">レイアウト図</h3>
          </div>
          <div class="image-block">
            <figure class="sheet-image wf-frame">
              <div class="wf-stage">
                <img src="[DATA]" alt="画像設定 / J7 / image 1" width="592">
                <a class="wf-pin" id="pin-sheet-4-1" href="#item-sheet-4-1" style="left:47.03%;top:10.82%" title="No.1 店舗" aria-label="No.1 店舗">1</a>
                <a class="wf-pin" id="pin-sheet-4-2" href="#item-sheet-4-2" style="left:47.06%;top:15.31%" title="No.2 画像のアップロード" aria-label="No.2 画像のアップロード">2</a>
                <a class="wf-pin" id="pin-sheet-4-6" href="#item-sheet-4-6" style="left:48.33%;top:34.15%" title="No.6 更新日時" aria-label="No.6 更新日時">6</a>
                <a class="wf-pin" id="pin-sheet-4-3" href="#item-sheet-4-3" style="left:46.91%;top:19.77%" title="No.3 アップロード" aria-label="No.3 アップロード">3</a>
                <a class="wf-pin" id="pin-sheet-4-4" href="#item-sheet-4-4" style="left:100.00%;top:26.21%" title="No.4 アップロードした店舗" aria-label="No.4 アップロードした店舗">4</a>
                <a class="wf-pin" id="pin-sheet-4-7" href="#item-sheet-4-7" style="left:74.87%;top:33.82%" title="No.7 画像URLコピー" aria-label="No.7 画像URLコピー">7</a>
                <a class="wf-pin" id="pin-sheet-4-8" href="#item-sheet-4-8" style="left:92.80%;top:33.84%" title="No.8 削除" aria-label="No.8 削除">8</a>
                <a class="wf-pin" id="pin-sheet-4-5" href="#item-sheet-4-5" style="left:5.57%;top:34.62%" title="No.5 画像" aria-label="No.5 画像">5</a>
              </div>
              <figcaption>画像設定 / J7 / image 1</figcaption>
            </figure>
          </div>
          <div class="doc-flow">
            <h3 class="doc-h doc-h-section" style="--lv:0">カスタマイズ説明</h3>
