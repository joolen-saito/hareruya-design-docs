    31	    public function handle(\DateTimeInterface $summaryDate): int
    32	    {
    33	        $summaryDateFrom = \DateTime::createFromInterface($summaryDate)->setTime(0, 0, 0);
    34	        $summaryDateTo = \DateTime::createFromInterface($summaryDate)->setTime(23, 59, 59);
    35	        $rootBaseInfoId = (int) $this->eccubeConfig->get('eccube_root_base_info_id');
    36	
    37	        $orderRows = $this->dailySummaryRepository->aggregateOrderSummaryByBaseInfo($summaryDateFrom, $summaryDateTo);
    38	        $purchaseRows = $this->dailySummaryRepository->aggregatePurchaseSummaryByBaseInfo($rootBaseInfoId, $summaryDateFrom, $summaryDateTo);
    39	        $wasteRows = $this->dailySummaryRepository->aggregateDisposalQuantityByBaseInfo($summaryDateFrom, $summaryDateTo);
    40	        $shortageRows = $this->dailySummaryRepository->aggregateShortageQuantityByBaseInfo($summaryDateFrom, $summaryDateTo);
    41	
    42	        /** @var array<int, array<string, int>> $summaries */
    43	        $summaries = [];
    44	        foreach ($orderRows as $row) {
    45	            $baseInfoId = (int) ($row['base_info_id'] ?? 0);
    46	            if ($baseInfoId < 1) {
    47	                continue;
    48	            }
    49	
    50	            $summaries[$baseInfoId] = array_merge(
    51	                $this->createEmptySummary($baseInfoId),
    52	                [
    53	                    'order_amount_order' => (int) ($row['order_amount_order'] ?? 0),
    54	                    'cost' => (int) ($row['cost'] ?? 0),
    55	                    'sale_quantity' => (int) ($row['sale_quantity'] ?? 0),
    56	                    'buyer_count' => (int) ($row['buyer_count'] ?? 0),
    57	                ]
    58	            );
    59	        }
    60	
    61	        foreach ($purchaseRows as $row) {
    62	            $baseInfoId = (int) ($row['base_info_id'] ?? 0);
    63	            if ($baseInfoId < 1) {
    64	                continue;
    65	            }
    66	
    67	            if (!isset($summaries[$baseInfoId])) {
    68	                $summaries[$baseInfoId] = $this->createEmptySummary($baseInfoId);
    69	            }
    70	
    71	            $summaries[$baseInfoId]['purchase_count'] += (int) ($row['purchase_count'] ?? 0);
    72	            $summaries[$baseInfoId]['purchase_amount'] += (int) ($row['purchase_amount'] ?? 0);
    73	        }
    74	
    75	        foreach ($wasteRows as $row) {
    76	            $baseInfoId = (int) ($row['base_info_id'] ?? 0);
    77	            if ($baseInfoId < 1) {
    78	                continue;
    79	            }
    80	
    81	            if (!isset($summaries[$baseInfoId])) {
    82	                $summaries[$baseInfoId] = $this->createEmptySummary($baseInfoId);
    83	            }
    84	
    85	            $summaries[$baseInfoId]['waste_count'] += (int) ($row['waste_quantity'] ?? 0);
    86	        }
    87	
    88	        foreach ($shortageRows as $row) {
    89	            $baseInfoId = (int) ($row['base_info_id'] ?? 0);
    90	            if ($baseInfoId < 1) {
    91	                continue;
    92	            }
    93	
    94	            if (!isset($summaries[$baseInfoId])) {
    95	                $summaries[$baseInfoId] = $this->createEmptySummary($baseInfoId);
    96	            }
    97	
    98	            $summaries[$baseInfoId]['shortage_count'] += (int) ($row['shortage_quantity'] ?? 0);
    99	        }
   100	
   101	        $rows = array_values($summaries);
   102	
   103	        $connection = $this->entityManager->getConnection();
   104	        $connection->beginTransaction();
   105	        try {
   106	            // 再集計に備え、対象日の既存集計を一旦すべて削除してから登録し直す。
   107	            // 失敗時はトランザクションごとロールバックされ、削除前の状態に戻る。
   108	            $this->dailySummaryRepository->deleteBySummaryDate($summaryDateFrom);
   109	
   110	            $affected = 0;
   111	            foreach ($rows as $row) {
   112	                $baseInfoId = (int) ($row['base_info_id'] ?? 0);
   113	                $grossSales = (int) ($row['order_amount_order'] ?? 0);
   114	                $totalCost = (int) ($row['cost'] ?? 0);
   115	                $saleCount = (int) ($row['buyer_count'] ?? 0);
   116	                $saleAverage = $saleCount > 0
   117	                    ? (int) ceil($grossSales / $saleCount)
   118	                    : 0;
   119	
   120	                $this->dailySummaryRepository->insertDailySummary(
   121	                    $summaryDateFrom,
   122	                    $baseInfoId,
   123	                    [
   124	                        'gross_sales' => $grossSales,
   125	                        'total_cost' => $totalCost,
   126	                        'gross_profit' => $grossSales - $totalCost,
   127	                        'sale_quantity' => (int) ($row['sale_quantity'] ?? 0),
   128	                        'sale_count' => $saleCount,
   129	                        'sale_average' => $saleAverage,
   130	                        'purchase_count' => (int) ($row['purchase_count'] ?? 0),
   131	                        'purchase_amount' => (int) ($row['purchase_amount'] ?? 0),
   132	                        'waste_count' => (int) ($row['waste_count'] ?? 0),
   133	                        'shortage_count' => (int) ($row['shortage_count'] ?? 0),
   134	                    ]
   135	                );
   136	                ++$affected;
   137	            }
   138	
   139	            $connection->commit();
   140	
   141	            return $affected;
   142	        } catch (\Throwable $e) {
