    27	
    28	class SummaryType extends AbstractType
    29	{
    30	    public function __construct(
    31	        private readonly BaseInfoRepository $baseInfoRepository,
    32	    ) {
    33	    }
    34	
    35	    public function configureOptions(OptionsResolver $resolver): void
    36	    {
    37	        $resolver->setDefaults([
    38	            'csrf_protection' => false,
    39	            'monthly_date_inputs' => false,
    40	        ]);
    41	        $resolver->setAllowedTypes('monthly_date_inputs', 'bool');
    42	    }
    43	
    44	    public function buildForm(FormBuilderInterface $builder, array $options): void
    45	    {
    46	        $dateFieldOptions = $options['monthly_date_inputs']
    47	            ? [
    48	                'required' => true,
    49	                'input' => 'datetime',
    50	                'widget' => 'single_text',
    51	                'html5' => false,
    52	                'format' => 'yyyy-MM',
    53	            ]
    54	            : [
    55	                'required' => true,
    56	                'input' => 'datetime',
    57	                'widget' => 'single_text',
    58	                'html5' => true,
    59	            ];
    60	
    61	        $builder
    62	            ->add('summary_type', ChoiceType::class, [
    63	                'required' => true,
    64	                'expanded' => true,
    65	                'multiple' => false,
    66	                'choices' => [
    67	                    '日次' => 'daily',
    68	                    '月次' => 'monthly',
    69	                ],
    70	            ])
    71	            ->add('summary_date_from', DateType::class, $dateFieldOptions)
    72	            ->add('summary_date_to', DateType::class, $dateFieldOptions)
    73	            ->add('mail_order_enabled', CheckboxType::class, [
    74	                'required' => false,
    75	                'label' => '通販',
    76	            ])
    77	            ->add('store_sales_all', CheckboxType::class, [
    78	                'required' => false,
    79	                'label' => '全店舗チェック',
    80	            ])
    81	            ->add('store_sales_targets', ChoiceType::class, [
    82	                'required' => false,
    83	                'expanded' => true,
    84	                'multiple' => true,
    85	                'choices' => $this->getPublishedStoreChoices(),
    86	            ]);
    87	
    88	        // 月次は yyyy-MM 形式で送られた場合に DateType 用へ月初日へ正規化する
    89	        $builder->addEventListener(FormEvents::PRE_SUBMIT, function (FormEvent $event): void {
    90	            $data = $event->getData();
    91	            if (!is_array($data) || ($data['summary_type'] ?? '') !== 'monthly') {
    92	                return;
    93	            }
    94	
    95	            foreach (['summary_date_from', 'summary_date_to'] as $field) {
    96	                $value = $data[$field] ?? '';
    97	                if (is_string($value) && preg_match('/^\d{4}-\d{2}$/', $value) === 1) {
    98	                    $data[$field] = $value.'-01';
    99	                }
   100	            }
   101	
   102	            $event->setData($data);
   103	        });
   104	    }
   105	
   106	    /**
   107	     * @return array<string, int>
   108	     */
   109	    private function getPublishedStoreChoices(): array
   110	    {
   111	        $BaseInfos = $this->baseInfoRepository->getPublicTenantShopsForSummary();
   112	        $choices = [];
   113	
   114	        foreach ($BaseInfos as $BaseInfo) {
   115	            $label = trim($BaseInfo->getShortNameJp());
   116	            if ($label === '') {
   117	                $label = (string) ($BaseInfo->getShopName() ?? '');
   118	            }
   119	            if ($label === '') {
   120	                continue;
   121	            }
   122	            $id = $BaseInfo->getId();
   123	            if ($id === null) {
   124	                continue;
   125	            }
   126	            $uniqueLabel = $label;
   127	            if (isset($choices[$uniqueLabel])) {
   128	                $uniqueLabel = sprintf('%s (ID:%d)', $label, $id);
   129	            }
   130	            $choices[$uniqueLabel] = $id;
   131	        }
   132	
   133	        return $choices;
   134	    }
   135	
