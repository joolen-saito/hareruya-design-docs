    26	/**
    27	 * Pattern 8 (店頭購入(会員)) のハンドラ。
    28	 *
    29	 * スマレジ取引に対応する EC-CUBE 受注を新規作成し、Player/Customer を紐付けて保存する。
    30	 * EC-CUBE 上に該当する既存受注は存在しない前提のため、移行先ID 登録などは行わない。
    31	 */
    32	final readonly class OtcMemberPatternHandler
    33	{
    34	    public function __construct(
    35	        private LoggerInterface $logger,
    36	        private EntityManagerInterface $entityManager,
    37	        private OrderRepository $orderRepository,
    38	        private SmaregiOrderFactory $orderFactory,
    39	    ) {
    40	    }
    41	
    42	    public function handle(TransactionDto $transaction, DtbPlayer $member): Order
    43	    {
    44	        $transactionHeadId = $transaction->transactionHeadId;
    45	        if ($transactionHeadId === null || $transactionHeadId === '') {
    46	            throw new \RuntimeException('Smaregi OTC member order creation requires a non-empty transactionHeadId.');
    47	        }
    48	
    49	        // 同一 transactionHeadId の Webhook が並列処理されても受注を重複作成しないよう、
    50	        // 取引IDをキーにアドバイザリロックで find-or-create を直列化する
    51	        // (findOneBy 単独では check と insert の間に別プロセスが割り込み得るため)。
    52	        $lockName = SmaregiOtcOrderLock::PREFIX.$transactionHeadId;
    53	        if (!$this->orderRepository->getLock($lockName, SmaregiOtcOrderLock::TIMEOUT_SECONDS)) {
    54	            throw new \RuntimeException(sprintf('Failed to acquire Smaregi OTC order creation lock (transactionHeadId=%s)', $transactionHeadId));
    55	        }
    56	
    57	        try {
    58	            // 冪等性: 既に作成済みなら再作成せず再利用する (ロック確立後に再確認)。
    59	            $existing = $this->orderRepository->findOneBy(['smaregiTransactionId' => $transactionHeadId]);
    60	            if ($existing instanceof Order) {
    61	                $this->logger->info('Smaregi OTC member order already exists for transaction, reusing', [
    62	                    'orderId' => $existing->getId(),
    63	                    'transactionHeadId' => $transaction->transactionHeadId,
    64	                ]);
    65	
    66	                return $existing;
    67	            }
    68	
    69	            $order = $this->orderFactory->createForMember($transaction, $member);
    70	
    71	            $this->entityManager->persist($order);
    72	            foreach ($order->getOrderItems() as $item) {
    73	                $this->entityManager->persist($item);
    74	            }
    75	            // 待機側がロック解放後の findOneBy で確実に検出できるよう、解放前に flush で確定させる。
    76	            $this->entityManager->flush();
    77	
    78	            $this->logger->info('Smaregi OTC member order created', [
    79	                'orderId' => $order->getId(),
    80	                'transactionHeadId' => $transaction->transactionHeadId,
    81	                'playerId' => $member->getId(),
    82	            ]);
    83	
    84	            return $order;
    85	        } finally {
    86	            $this->orderRepository->releaseLock($lockName);
    87	        }
    88	    }
    89	}

