   248	     * 開催日時昇順 → イベント ID 昇順で取得する。Detail / Formats / EventScale / Rel は eager join。
   249	     * イベント大会TOP (F07-01) の月単位 JSON 取得で利用する。
   250	     *
   251	     * @return DtbEvent[]
   252	     */
   253	    public function getEventsByShopAndMonth(int $baseInfoId, \DateTimeImmutable $monthStart): array
   254	    {
   255	        $monthEnd = $monthStart->modify('+1 month');
   256	
   257	        $qb = $this->createQueryBuilder('e');
   258	
   259	        return $qb
   260	            ->select('e', 'ed', 'es', 'rel', 'f')
   261	            ->leftJoin('e.Details', 'ed')
   262	            ->leftJoin('e.EventScale', 'es')
   263	            ->leftJoin('e.Rel', 'rel')
   264	            ->leftJoin('e.Formats', 'f')
   265	            ->where($qb->expr()->eq('IDENTITY(e.BaseInfo)', ':baseInfoId'))
   266	            ->andWhere($qb->expr()->eq('IDENTITY(e.Disp)', ':dispShow'))
   267	            ->andWhere($qb->expr()->isNull('e.deletedAt'))
   268	            ->andWhere($qb->expr()->eq('IDENTITY(ed.Disp)', ':dispShow'))
   269	            ->andWhere($qb->expr()->gte('ed.startDate', ':monthStart'))
   270	            ->andWhere($qb->expr()->lt('ed.startDate', ':monthEnd'))
   271	            ->setParameter('baseInfoId', $baseInfoId)
   272	            ->setParameter('dispShow', MtbDisp::DISPLAY_SHOW)
   273	            ->setParameter('monthStart', $monthStart)
   274	            ->setParameter('monthEnd', $monthEnd)
   275	            ->orderBy('ed.startDate', 'ASC')
   276	            ->addOrderBy('e.id', 'ASC')
   277	            ->getQuery()
   278	            ->getResult();
   279	    }
