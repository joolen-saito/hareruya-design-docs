    82	     * @param string $languageCode
    83	     *
    84	     * @return JsonResponse
    85	     */
    86	    #[Route(path: '/topBanners/{languageCode}.json', name: 'top_banners_by_language_code_json', methods: ['GET'])]
    87	    #[Route(path: '/topBanners/{languageCode}', name: 'top_banners_by_language_code', methods: ['GET'])]
    88	    public function getTopBannersByLanguageCode(Request $request, string $languageCode): JsonResponse
    89	    {
    90	        try {
    91	            $Language = $this->languageRepository->findOneBy([
    92	                'code' => $languageCode,
    93	            ]);
    94	
    95	            if (empty($Language)) {
    96	                log_warning('言語情報が見つかりません', [
    97	                    'request_url' => $request->getUri(),
    98	                ]);
    99	                throw new NotFoundException('Not Found');
   100	            }
   101	
   102	            $TopBanners = $Language->getTopBanners();
   103	            if ($TopBanners->isEmpty()) {
   104	                log_warning('指定した言語のトップバナーが見つかりません', [
   105	                    'request_url' => $request->getUri(),
   106	                ]);
   107	                throw new NotFoundException('Not Found');
   108	            }
   109	
   110	            $response = $this->topBannersResponseBuilder->build($TopBanners);
   111	
   112	            return $this->json($response, Response::HTTP_OK);
   113	        } catch (BaseApiException $e) {
