    16	namespace Eccube\Doctrine\EventSubscriber;
    17	
    18	use Doctrine\Bundle\DoctrineBundle\Attribute\AsDoctrineListener;
    19	use Doctrine\ORM\EntityManagerInterface;
    20	use Doctrine\ORM\Events;
    21	use Doctrine\Persistence\Event\LifecycleEventArgs;
    22	use Eccube\Common\EccubeConfig;
    23	use Eccube\Entity\Member;
    24	use Eccube\Request\Context;
    25	
    26	#[AsDoctrineListener(event: Events::prePersist)]
    27	#[AsDoctrineListener(event: Events::preUpdate)]
    28	class SaveEventSubscriber
    29	{
    30	    public function __construct(protected Context $requestContext, protected EccubeConfig $eccubeConfig)
    31	    {
    32	    }
    33	
    34	    /**
    35	     * @param LifecycleEventArgs<EntityManagerInterface> $args
    36	     */
    37	    public function prePersist(LifecycleEventArgs $args): void
    38	    {
    39	        $entity = $args->getObject();
    40	
    41	        if (method_exists($entity, 'setCreateDate')) {
    42	            $entity->setCreateDate(new \DateTime());
    43	        }
    44	        if (method_exists($entity, 'setUpdateDate')) {
    45	            $entity->setUpdateDate(new \DateTime());
    46	        }
    47	        if (method_exists($entity, 'setCurrencyCode')) {
    48	            $currency = $this->eccubeConfig->get('currency');
    49	            $entity->setCurrencyCode($currency);
    50	        }
    51	        if (method_exists($entity, 'setCreator')) {
    52	            $creator = $this->resolveManagedCreator($args);
    53	            if ($creator !== null) {
    54	                $entity->setCreator($creator);
    55	            }
    56	        }
    57	    }
    58	
    59	    /**
    60	     * @param LifecycleEventArgs<EntityManagerInterface> $args
    61	     */
    62	    public function preUpdate(LifecycleEventArgs $args): void
    63	    {
    64	        $entity = $args->getObject();
    65	
    66	        if (method_exists($entity, 'setUpdateDate')) {
    67	            $entity->setUpdateDate(new \DateTime());
    68	        }
    69	
    70	        if (method_exists($entity, 'setCreator')) {
    71	            $creator = $this->resolveManagedCreator($args);
    72	            if ($creator !== null) {
    73	                $entity->setCreator($creator);
    74	            }
    75	        }
    76	    }
    77	
    78	    /**
    79	     * 現在のログイン Member を「flush 中の EM の管理下にある参照」として解決する。
    80	     *
    81	     * Context::getCurrentUser() は Security トークンが保持する Member インスタンスを返すため、
    82	     * CSV バッチ取込等で EM::clear() が走ると detach 状態になる。それをそのまま setCreator()
    83	     * に渡すと flush 時に identifier を引けず EntityNotFoundException / ORMInvalidArgumentException
    84	     * を引き起こす。getReference() は現 EM に紐付いたプロキシ（または identity map にいる実体）を
    85	     * 返すため、FK を埋めるだけのこの用途では追加クエリも発生しない。
    86	     *
    87	     * @param LifecycleEventArgs<EntityManagerInterface> $args
    88	     */
    89	    private function resolveManagedCreator(LifecycleEventArgs $args): ?Member
    90	    {
    91	        $user = $this->requestContext->getCurrentUser();
    92	        if (!$user instanceof Member) {
    93	            return null;
    94	        }
    95	        $id = $user->getId();
    96	        if ($id === null) {
    97	            return null;
    98	        }
    99	
   100	        /** @var Member */
   101	        return $args->getObjectManager()->getReference(Member::class, $id);
   102	    }
   103	}

