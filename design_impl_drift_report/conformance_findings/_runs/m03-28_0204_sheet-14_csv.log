    82	namespace Eccube\Service\Csv\Importer\Converter;
    83	
    84	use Eccube\Util\StringUtil;
    85	
    86	/**
    87	 * int の配列に変換する Converter 実装。
    88	 */
    89	class IntArrayConverter implements ConverterInterface
    90	{
    91	    /** @var string 区切り文字 */
    92	    private string $separator;
    93	
    94	    /**
    95	     * @param string $separator 区切り文字
    96	     */
    97	    public function __construct(string $separator = ',')
    98	    {
    99	        $this->separator = $separator;
   100	    }
   101	
   102	    /**
   103	     * @param string $value 変換する値
   104	     *
   105	     * @return array<int> 変換後の値
   106	     */
   107	    public function convert(string $value): array
   108	    {
   109	        if (StringUtil::isBlank($value)) {
   110	            return [];
   111	        }
   112	
   113	        return array_map(
   114	            function ($value) {
   115	                return (int) $value;
   116	            },
   117	            explode($this->separator, $value)
