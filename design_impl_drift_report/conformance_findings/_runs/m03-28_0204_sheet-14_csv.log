   142	 */
   143	class StringArrayConverter implements ConverterInterface
   144	{
   145	    /** @var string 区切り文字 */
   146	    private string $separator;
   147	
   148	    /**
   149	     * @param string $separator 区切り文字
   150	     */
   151	    public function __construct(string $separator = ',')
   152	    {
   153	        $this->separator = $separator;
   154	    }
   155	
   156	    /**
   157	     * @param string $value 変換する値
   158	     *
   159	     * @return array<string> 変換後の値
   160	     */
   161	    public function convert(string $value): array
   162	    {
   163	        return array_filter(
   164	            explode($this->separator, $value),
   165	            function ($v) {
   166	                return StringUtil::isNotBlank($v);
   167	            }
   168	        );
   169	    }
   170	}

