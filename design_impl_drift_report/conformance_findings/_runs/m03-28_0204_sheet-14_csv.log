   159	     *
   160	     * @return self
   161	     */
   162	    public function addValidator(mixed $validator): self
   163	    {
   164	        $validators = is_array($validator) ? $validator : func_get_args();
   165	        $this->validator = $this->validator->thenValidate($validators);
   166	
   167	        return $this;
   168	    }
