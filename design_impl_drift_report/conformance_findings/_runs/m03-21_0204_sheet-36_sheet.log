   239	            $this->getShelfNumberUpdateCsvHeader(),
   240	            'shelf_number_template.csv'
   241	        );
   242	    }
   243	
   244	    /**
   245	     * 棚番号更新CSVアップロード画面（部門マスタと同様に master_csv_upload を正とする。/csv は互換用）
   246	     */
   247	    #[Route(path: '/%eccube_admin_route%/product/shelf_number/master_csv_upload', name: 'admin_product_shelf_number_master_csv_upload', methods: ['GET'], priority: 10)]
   248	    #[Route(path: '/%eccube_admin_route%/product/shelf_number/csv', name: 'admin_product_shelf_number_csv', methods: ['GET'], priority: 10)]
   249	    public function csv(Request $request): Response
   250	    {
   251	        $form = $this->createForm(CsvImportType::class);
   252	        $form->handleRequest($request);
   253	
   254	        return $this->render('@admin/Product/csv_product_shelf_number.twig', [
   255	            'form' => $form->createView(),
   256	            'headers' => $this->getShelfNumberUpdateCsvHeader(),
   257	            'csv_required_header_keys' => array_keys($this->getShelfNumberUpdateCsvRequiredHeader()),
   258	            'csv_box_title' => 'admin.product.product_shelf_number_csv_upload_title',
   259	            'csv_format_title' => 'admin.product.product_shelf_number_csv_format_title',
   260	            'form_action_route' => 'admin_product_shelf_number_master_import',
   261	            'template_download_route' => 'admin_product_shelf_number_master_csv_template',
   262	            'menus' => ['product', 'product_csv_management', 'shelf_number_csv_import'],
   263	        ]);
   264	    }
   265	
   266	    /**
   267	     * 棚番号更新CSV取込
   268	     */
   269	    #[Route(path: '/%eccube_admin_route%/product/shelf_number/master_import', name: 'admin_product_shelf_number_master_import', methods: ['POST'], priority: 10)]
   270	    #[Route(path: '/%eccube_admin_route%/product/shelf_number/import', name: 'admin_product_shelf_number_import', methods: ['POST'], priority: 10)]
   271	    public function import(Request $request): RedirectResponse
   272	    {
   273	        /** @var Member $Member */
   274	        $Member = $this->getUser();
   275	
   276	        $form = $this->formFactory->createBuilder(CsvImportType::class)->getForm();
   277	        $form->handleRequest($request);
   278	
   279	        if (!$form->isValid()) {
   280	            foreach ($form->getErrors(true) as $error) {
   281	                $this->addError($error->getMessage(), 'admin');
   282	            }
   283	
   284	            return $this->redirectToRoute('admin_product_shelf_number_master_csv_upload');
   285	        }
   286	        /** @var UploadedFile|null $formFile */
   287	        $formFile = $form['import_file']->getData();
   288	
   289	        if ($formFile === null) {
   290	            $this->addError('admin.common.csv_invalid_format', 'admin');
   291	
   292	            return $this->redirectToRoute('admin_product_shelf_number_master_csv_upload');
   293	        }
   294	
   295	        if ($this->countCsvRows($formFile) >= static::ADMIN_CSV_IMPORT_MAX_ROWS) {
   296	            $this->addError(
   297	                $this->translator->trans('admin.csv.error.upload.maxrecord', ['%maxRecord%' => static::ADMIN_CSV_IMPORT_MAX_ROWS]),
   298	                'admin'
   299	            );
   300	
   301	            return $this->redirectToRoute('admin_product_shelf_number_master_csv_upload');
   302	        }
   303	
   304	        log_info('棚番号マスタCSV登録開始');
   305	
   306	        $handler = new ShelfNumberMasterImportHandler($this->shelfNumberRepository);
   307	        $importer = new CsvImporter(
   308	            $this->entityManager,
   309	            $this->translator,
   310	            $this->eccubeConfig,
   311	            $handler,
   312	            $Member
   313	        );
   314	        $result = $importer->import($formFile);
   315	
   316	        if ($result->hasError()) {
