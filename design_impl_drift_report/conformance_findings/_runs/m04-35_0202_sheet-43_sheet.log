    }

    /**
     * 在庫反映済みの棚卸詳細があるかどうかを調べる.
     */
    public function hasReflectedDetail(): bool
    {
        $criteria = Criteria::create()
            ->where(Criteria::expr()->neq('stockReflectionedDate', null))
            ->orderBy(['id' => Criteria::ASC])
            ->setFirstResult(0)
            ->setMaxResults(1);

        return $this->InventoryPlanDetails->matching($criteria)->count() === 1;
    }
}
