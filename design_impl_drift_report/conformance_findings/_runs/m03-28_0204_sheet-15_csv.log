   110	    #[Route(path: '/%eccube_admin_route%/product/product_tag/import', name: 'admin_product_product_tag_import', methods: ['POST'])]
   111	    public function import(Request $request): RedirectResponse
   112	    {
   113	        /** @var Member $Member */
   114	        $Member = $this->getUser();
   115	
   116	        $form = $this->formFactory->createBuilder(CsvImportType::class)->getForm();
   117	        $form->handleRequest($request);
   118	
   119	        if (!$form->isValid()) {
   120	            foreach ($form->getErrors() as $error) {
   121	                $this->addError($error->getMessage(), 'admin');
   122	            }
   123	
   124	            return $this->redirectToRoute('admin_product_product_tag_csv_upload');
   125	        }
   126	        /** @var UploadedFile|null $formFile */
   127	        $formFile = $form['import_file']->getData();
   128	
   129	        if ($formFile === null) {
   130	            $this->addError('admin.common.csv_invalid_format', 'admin');
   131	
   132	            return $this->redirectToRoute('admin_product_product_tag_csv_upload');
   133	        }
   134	
   135	        if ($this->countCsvRows($formFile) >= static::ADMIN_CSV_IMPORT_MAX_ROWS) {
   136	            $this->addError($this->getCsvImportMaxRowsExceededMessage(), 'admin');
   137	
   138	            return $this->redirectToRoute('admin_product_product_tag_csv_upload');
   139	        }
   140	
   141	        log_info('商品タグ更新CSV登録開始');
   142	
   143	        $handler = new ProductTagUpdateImportHandler($this->entityManager, $this->productRepository);
   144	        $importer = new CsvImporter(
   145	            $this->entityManager,
   146	            $this->translator,
   147	            $this->eccubeConfig,
   148	            $handler,
   149	            $Member
   150	        );
   151	        $result = $importer->import($formFile);
   152	
   153	        if ($result->hasError()) {
   154	            log_info('商品タグ更新CSV登録 異常終了');
   155	            foreach ($result->getErrors() as $error) {
   156	                $this->addError($error['message'], 'admin');
   157	            }
   158	        } else {
   159	            $this->addSuccess('admin.register.complete', 'admin');
   160	            log_info('商品タグ更新CSV登録完了', ['count' => $result->getCount()]);
   161	            $this->csvImportHistoryRepository->insertCsvImportHistory(
   162	                MtbCsvImportType::PRODUCT_TAG_IMPORT_CSV_ID,
   163	                $formFile->getClientOriginalName(),
   164	                $Member->getId()
   165	            );
