   608	                ) THEN 1 ELSE 0 END AS "isSupply",
   609	                -- ピッキング区分ソート: 円未満(1) → 円以上~円未満(2) → 円以上(3) → サプライ(99)
   610	                CASE
   611	                    WHEN EXISTS (
