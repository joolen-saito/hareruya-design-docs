    28	class OtcBuyOrderRestockListService
    29	{
    30	    public function __construct(
    31	        private readonly DtbOtcBuyOrderRepository $otcBuyOrderRepository,
    32	        private readonly EntityManagerInterface $entityManager,
    33	        private readonly RestockListPdfSectionBuilder $restockListPdfSectionBuilder,
    34	    ) {
    35	    }
    36	
    37	    /**
    38	     * 戻しリストPDF用のTwig変数を組み立て、対象買取を棚戻し済みに更新する
    39	     *
    40	     * @param list<int> $otcBuyOrderIds
    41	     *
    42	     * @return array{restockListSections: list<array{
    43	     *     titleBase: string,
    44	     *     isSupply: bool,
    45	     *     items: list<array<string, mixed>>,
    46	     *     total_quantity: int
    47	     * }>}
    48	     */
    49	    public function buildPdfViewData(array $otcBuyOrderIds): array
    50	    {
    51	        $rawRows = $this->otcBuyOrderRepository->getOtcBuyOrderRestockListExportData($otcBuyOrderIds);
    52	        $built = $this->restockListPdfSectionBuilder->buildSections($rawRows);
    53	        $this->markOtcBuyOrdersAsRestocked($otcBuyOrderIds);
    54	
    55	        return [
    56	            'restockListSections' => $built['sections'],
    57	        ];
    58	    }
    59	
    60	    /**
    61	     * @param array<int, int> $otcBuyOrderIds
    62	     */
    63	    public function markOtcBuyOrdersAsRestocked(array $otcBuyOrderIds): void
    64	    {
    65	        $this->entityManager->beginTransaction();
    66	        try {
    67	            foreach ($otcBuyOrderIds as $id) {
    68	                $OtcBuyOrder = $this->entityManager->find(DtbOtcBuyOrder::class, $id);
    69	                if ($OtcBuyOrder === null) {
    70	                    continue;
    71	                }
    72	                $OtcBuyOrder->setRestockedFlg(true);
    73	                $this->entityManager->persist($OtcBuyOrder);
    74	            }
    75	            $this->entityManager->flush();
    76	            $this->entityManager->commit();
    77	        } catch (\Exception $e) {
    78	            $this->entityManager->rollback();
    79	            throw $e;
    80	        }
    81	    }
    82	
    83	    /**
    84	     * 棚戻しリスト出力用バリデーション
    85	     *
    86	     * @param array<int, int> $otcBuyOrderIds
    87	     *
    88	     * @return list<string>
    89	     */
    90	    public function validateRestockListRequest(array $otcBuyOrderIds, Member $Member): array
    91	    {
    92	        $orderData = $this->otcBuyOrderRepository->getStatusAndShopByIds(
    93	            $otcBuyOrderIds,
    94	        );
    95	
    96	        if ($orderData === []) {
    97	            return ['対象のデータが見つかりません。'];
    98	        }
    99	
   100	        $errs = [];
   101	        $editableShopIds = $Member
   102	            ->getMemberBaseInfos()
   103	            ->map(fn ($memberBaseInfo) => $memberBaseInfo->getBaseInfo()->getId())
   104	            ->toArray();
   105	
   106	        $shopIds = [];
   107	        foreach ($orderData as $data) {
   108	            $shopIds[] = $data['shopId'];
   109	
   110	            // 店舗編集権限チェック
   111	            if (!in_array($data['shopId'], $editableShopIds, true)) {
   112	                $errs[] = sprintf(
   113	                    'ID: %d は権限のない店舗のデータです。',
   114	                    $data['orderId'],
   115	                );
   116	            }
   117	
   118	            // ステータスチェック
   119	            if (
   120	                $data['statusId'] !== MtbOtcBuyOrderStatus::STATUS_STOCKING_PENDING
   121	                && $data['statusId'] !== MtbOtcBuyOrderStatus::STATUS_STOCKING_COMPLETE
   122	            ) {
   123	                $errs[] = sprintf(
   124	                    'ID: %d は対象外のステータスです。',
   125	                    $data['orderId'],
   126	                );
   127	            }
   128	        }
   129	
   130	        // 複数店舗チェック
   131	        if (count(array_unique($shopIds)) > 1) {
   132	            $errs[] = '複数店舗の買取情報を同時に処理することはできません。';
   133	        }
   134	
   135	        return $errs;
   136	    }
   137	}

