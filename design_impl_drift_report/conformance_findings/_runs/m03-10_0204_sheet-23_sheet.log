    88	
    89	                const rate = parseFloat($rate.val());
    90	
    91	                if (isNaN(rate) || rate === 0) {
    92	                    return;
    93	                }
    94	
    95	                $target.val(Math.round((nmVal * rate) / 10) * 10);
    96	            });
    97	        }
    98	
    99	        $(document).on('input change', '.js-base-price-nm', function() {
