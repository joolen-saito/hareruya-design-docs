    11	<script nonce="{{ csp_nonce }}">
    12	    $(function() {
    13	        function updateRatio($targetInput) {
    14	            const $currentRow = $targetInput.closest('tr');
    15	
    16	            let $row1, $row2;
    17	
    18	            if ($targetInput.hasClass('js-buy-price')) {
    19	                $row1 = $currentRow;
    20	                $row2 = $currentRow.next('tr');
    21	            }
    22	            else if ($targetInput.hasClass('js-base-price')) {
    23	                $row2 = $currentRow;
    24	                $row1 = $currentRow.prev('tr');
    25	            } else {
    26	                return; // 関係ないinput
    27	            }
    28	
    29	            const $buyInput = $row1.find('.js-buy-price');
    30	            const $output = $row1.find('.js-ratio-output');
    31	
    32	            const $baseInput = $row2.find('.js-base-price');
    33	
    34	            if ($buyInput.length === 0 || $baseInput.length === 0) return;
    35	
    36	            const buyVal = $buyInput.val();
    37	            const baseVal = $baseInput.val();
    38	
    39	            if (buyVal === '' || baseVal === '') {
    40	                $output.val('');
    41	                return;
    42	            }
    43	
    44	            const buyPrice = parseFloat(buyVal);
    45	            const basePrice = parseFloat(baseVal);
    46	
    47	            if (basePrice === 0 || buyPrice === 0) {
    48	                $output.val('-');
    49	                return;
    50	            }
    51	
    52	            const ratio = buyPrice / basePrice;
    53	            const result = Math.round(ratio * 100) / 100;
    54	
    55	            if (isNaN(result)) {
    56	                $output.val('-');
    57	                return;
    58	            }
    59	
    60	            $output.val(result);
    61	        }
    62	
    63	        $(document).on('input', '.js-buy-price, .js-base-price', function() {
    64	            updateRatio($(this));
    65	        });
    66	
    67	        $('.js-buy-price').each(function() {
    68	            updateRatio($(this));
    69	        });
    70	
    71	        // 基準価格(NM) 変更時に SP/MP/HP を NM × 割引率 で再計算（10円単位四捨五入）
    72	        // 割引率が 0 または対象セルが非表示の規格はスキップ
    73	        function calcConditionStandardPrices($nmInput) {
    74	            const $row = $nmInput.closest('tr');
