   147	        /**
   148	         * 課税対象の明細を返す.
   149	         *
   150	         * @return OrderItem[]
   151	         */
   152	        public function getTaxableItems(): array
   153	        {
   154	            $Items = [];
   155	
   156	            foreach ($this->OrderItems as $Item) {
   157	                if (null === $Item->getTaxType()) {
   158	                    continue;
   159	                }
   160	
   161	                if ($Item->getTaxType()->getId() == TaxType::TAXATION) {
   162	                    $Items[] = $Item;
   163	                }
   164	            }
   165	
   166	            return $Items;
   167	        }
   168	
   169	        /**
   170	         * 課税対象の明細の合計金額を返す.
   171	         * 商品合計 + 送料 + 手数料 + 値引き(課税).
   172	         */
   173	        public function getTaxableTotal(): string
   174	        {
   175	            $total = '0';
   176	
   177	            foreach ($this->getTaxableItems() as $Item) {
   178	                $total = bcadd($total, $Item->getTotalPrice(), 2);
   179	            }
   180	
   181	            return $total;
   182	        }
   183	
   184	        /**
   185	         * 課税対象の明細の合計金額を、税率ごとに集計する.
   186	         *
   187	         * @return array<string, string>  [税率 => 合計金額]
   188	         */
   189	        public function getTaxableTotalByTaxRate(): array
   190	        {
   191	            $total = [];
   192	
   193	            foreach ($this->getTaxableItems() as $Item) {
   194	                $totalPrice = $Item->getTotalPrice();
   195	                $taxRate = $Item->getTaxRate();
   196	                $total[$taxRate] = isset($total[$taxRate])
   197	                    ? bcadd($total[$taxRate], $totalPrice, 2)
   198	                    : $totalPrice;
   199	            }
   200	
   201	            krsort($total, SORT_NUMERIC);
   202	
   203	            return $total;
   204	        }
   205	
   206	        /**
   207	         * 明細の合計額を税率ごとに集計する.
   208	         *
   209	         * 不課税, 非課税の値引明細は税率ごとに按分する.
   210	         *
   211	         * @return array<string, string>
   212	         */
   213	        public function getTotalByTaxRate(): array
   214	        {
   215	            $roundingTypes = $this->getRoundingTypeByTaxRate();
   216	            $total = [];
   217	            $taxableTotal = $this->getTaxableTotal();
   218	            $taxFreeDiscount = $this->getTaxFreeDiscount();
   219	
   220	            foreach ($this->getTaxableTotalByTaxRate() as $rate => $totalPrice) {
   221	                if (bccomp($taxableTotal, '0', 2) !== 0) {
   222	                    // 按分計算: totalPrice - (abs(taxFreeDiscount) * totalPrice / taxableTotal)
   223	                    $absDiscount = ltrim($taxFreeDiscount, '-');
   224	                    $discountPortion = bcdiv(bcmul($absDiscount, $totalPrice, 6), $taxableTotal, 6);
   225	                    $value = bcsub($totalPrice, $discountPortion, 6);
   226	                } else {
   227	                    $value = '0';
   228	                }
   229	
   230	                $total[$rate] = TaxRuleService::roundByRoundingType(
   231	                    $value,
   232	                    $roundingTypes[$rate]->getId()
   233	                );
   234	            }
   235	
   236	            ksort($total);
   237	
   238	            return $total;
   239	        }
