    49	            'fileName' => 'stock_',
    50	        ],
    51	    ];
    52	
    53	    /**
    54	     * OrderController constructor.
    55	     *
    56	     * @param CsvExportService $csvExportService
    57	     * @param DtbCsvExtensionRepository $dtbCsvExtensionRepository
    58	     * @param DtbCsvCsvExtensionRepository $dtbCsvCsvExtensionRepository
    59	     */
    60	    public function __construct(protected CsvExportService $csvExportService, protected DtbCsvExtensionRepository $dtbCsvExtensionRepository, protected DtbCsvCsvExtensionRepository $dtbCsvCsvExtensionRepository)
    61	    {
    62	    }
    63	
    64	    /**
    65	     * カスタムCSV出力
    66	     * 商品・受注・配送・在庫共通のCSV出力を行う。
    67	     *
    68	     * @param int $csvExtensionId
    69	     *
    70	     * @return StreamedResponse
    71	     */
    72	    #[Route(path: '/%eccube_admin_route%/custom_csv/export/{csvExtensionId}', name: 'admin_custom_export', methods: ['GET', 'POST'])]
    73	    public function index(Request $request, int $csvExtensionId): StreamedResponse
    74	    {
    75	        if (!$CsvExtension = $this->dtbCsvExtensionRepository->find($csvExtensionId)) {
    76	            throw $this->createNotFoundException();
    77	        }
    78	        $CsvExtension->setCsvs($this->dtbCsvCsvExtensionRepository->findCsvOrderbyRank($csvExtensionId));
    79	        set_time_limit(0);
    80	        // sql loggerを無効にする.
    81	        $em = $this->entityManager;
    82	        $em->getConfiguration()->setSQLLogger(null);
    83	
    84	        $CsvType = $CsvExtension->getCsvType();
    85	
    86	        $response = new StreamedResponse();
    87	        $response->setCallback(function () use ($request, $CsvExtension, $CsvType) {
    88	            // CSV拡張情報を元に初期化.
    89	            $this->csvExportService->setCsvsAndCsvType($CsvExtension);
    90	            // ヘッダ行の出力.
    91	            $this->csvExportService->exportHeader();
    92	            // クエリビルダを取得.
    93	            $qb = $this->csvExportService->{self::FUNCTIONS[$CsvType->getId()]['queryBuilder']}($request);
    94	            // データ行の出力.
    95	            $this->csvExportService->setExportQueryBuilder($qb);
    96	            $this->csvExportService->exportData(function ($entity, CsvExportService $csvService) use ($request, $CsvExtension) {
    97	                $this->csvExportService->{self::FUNCTIONS[$CsvExtension->getCsvType()->getId()]['exporter']}($entity, $csvService, $request);
    98	            });
    99	        });
   100	
   101	        $now = new \DateTime();
   102	        $filename = self::FUNCTIONS[$CsvType->getId()]['fileName'].$now->format('YmdHis').'.csv';
   103	        $response->headers->set('Content-Type', 'application/octet-stream');
   104	        $response->headers->set('Content-Disposition', 'attachment; filename='.$filename);
   105	
   106	        log_info('カスタムCSV出力ファイル名', [$filename]);
   107	
   108	        return $response;
   109	    }
   110	}

