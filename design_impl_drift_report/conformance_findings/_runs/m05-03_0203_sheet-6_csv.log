    68	            $csvService = $this->csvExportService;
    69	            $csvService->fopen();
    70	
    71	            // ヘッダ行出力
    72	            $csvService->fputcsv(array_keys($this->csvHeader));
    73	
    74	            // データ出力
    75	            foreach ($csvRows as $csvRow) {
    76	                $csvService->fputcsv($csvRow);
    77	            }
    78	
    79	            $csvService->fclose();
    80	        });
    81	
    82	        $filename = $this->createFileName('order_');
