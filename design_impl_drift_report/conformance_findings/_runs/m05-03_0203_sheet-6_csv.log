    16	namespace Eccube\Repository;
    17	
    18	use Doctrine\ORM\Query\Expr\Join;
    19	use Doctrine\Persistence\ManagerRegistry;
    20	use Eccube\Entity\DtbCsvCsvExtension;
    21	
    22	/**
    23	 * @extends AbstractRepository<DtbCsvCsvExtension>
    24	 */
    25	class DtbCsvCsvExtensionRepository extends AbstractRepository
    26	{
    27	    public function __construct(ManagerRegistry $registry)
    28	    {
    29	        parent::__construct($registry, DtbCsvCsvExtension::class);
    30	    }
    31	
    32	    /**
    33	     * CSV拡張の登録済情報を削除
    34	     */
    35	    public function deleteByCsvExtensionId(int $csvExtensionId): void
    36	    {
    37	        $this->getEntityManager()
    38	            ->getConnection()
    39	            ->executeUpdate('DELETE FROM dtb_csv_csv_extension WHERE csv_extension_id = ?', [$csvExtensionId]);
    40	    }
    41	
    42	    /**
    43	     * rankでソートしたCSV情報の取得(CSVダウンロード用)
    44	     *
    45	     * @param int $csvExtensionId
    46	     *
    47	     * @return \Eccube\Entity\Csv[]
    48	     */
    49	    public function findCsvOrderbyRank(int $csvExtensionId): array
    50	    {
    51	        $qb = $this->createQueryBuilder('cce')
    52	            ->select('c')
    53	            ->innerJoin('Eccube\Entity\Csv', 'c', Join::WITH, 'cce.Csv = c.id')
    54	            ->where('cce.CsvExtension = :csvExtensionId')
    55	            ->setParameter('csvExtensionId', $csvExtensionId)
    56	            ->orderBy('cce.rank', 'ASC')
    57	            ->addOrderBy('c.sort_no', 'ASC');
    58	
    59	        return $qb->getQuery()->getResult();
    60	    }
    61	}

