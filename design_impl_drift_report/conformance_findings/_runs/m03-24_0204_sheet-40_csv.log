   381	    /**
   382	     * 検索条件で価格履歴のQueryBuilderを返す
   383	     *
   384	     * DtbProductSubClass 廃止・DtbProductClass への移行に合わせた実装。
   385	     * 共通処理は SqlUtil::setProductHistoryQuery() を使用。
   386	     * 価格履歴固有の条件（sell_price, buy_price等）はこのメソッドで追加。
   387	     *
   388	     * @param array<string, mixed> $searchData
   389	     */
   390	    public function getQueryBuilderBySearchData(array $searchData): QueryBuilder
   391	    {
   392	        $sortKeys = ['ph.createDate', 'ph.id'];
   393	
   394	        $qb = $this->createQueryBuilder('ph')
   395	            ->innerJoin('ph.ProductClass', 'pc')
   396	            ->innerJoin('pc.Product', 'p')
   397	            ->leftJoin('p.CardDetail', 'cd')
   398	            ->leftJoin('ph.Member', 'm');
   399	
   400	        // 共通検索処理（multi, category, status, cardset, rarity, language, card_condition, foil, promotion, date）
   401	        SqlUtil::setProductHistoryQuery($qb, $searchData, $sortKeys, 'ph');
   402	
   403	        // 価格履歴固有の条件
   404	        $product = $searchData['product'] ?? [];
   405	
   406	        // sell_price range
   407	        $sellPriceFrom = $product['sell_price_from'] ?? null;
   408	        if ($sellPriceFrom !== null && $sellPriceFrom !== '') {
   409	            $qb->andWhere('ph.sellPrice >= :sell_price_from')->setParameter('sell_price_from', (int) $sellPriceFrom);
   410	        }
   411	        $sellPriceTo = $product['sell_price_to'] ?? null;
   412	        if ($sellPriceTo !== null && $sellPriceTo !== '') {
   413	            $qb->andWhere('ph.sellPrice <= :sell_price_to')->setParameter('sell_price_to', (int) $sellPriceTo);
   414	        }
   415	
   416	        // buy_price range
   417	        $buyPriceFrom = $product['buy_price_from'] ?? null;
   418	        if ($buyPriceFrom !== null && $buyPriceFrom !== '') {
   419	            $qb->andWhere('ph.buyPrice >= :buy_price_from')->setParameter('buy_price_from', (int) $buyPriceFrom);
   420	        }
   421	        $buyPriceTo = $product['buy_price_to'] ?? null;
   422	        if ($buyPriceTo !== null && $buyPriceTo !== '') {
   423	            $qb->andWhere('ph.buyPrice <= :buy_price_to')->setParameter('buy_price_to', (int) $buyPriceTo);
   424	        }
   425	
   426	        // standard_price range
   427	        $standardPriceFrom = $product['standard_price_from'] ?? null;
   428	        if ($standardPriceFrom !== null && $standardPriceFrom !== '') {
   429	            $qb->andWhere('ph.standardPrice >= :standard_price_from')->setParameter('standard_price_from', (int) $standardPriceFrom);
   430	        }
   431	        $standardPriceTo = $product['standard_price_to'] ?? null;
   432	        if ($standardPriceTo !== null && $standardPriceTo !== '') {
   433	            $qb->andWhere('ph.standardPrice <= :standard_price_to')->setParameter('standard_price_to', (int) $standardPriceTo);
   434	        }
   435	
   436	        return $qb;
   437	    }
