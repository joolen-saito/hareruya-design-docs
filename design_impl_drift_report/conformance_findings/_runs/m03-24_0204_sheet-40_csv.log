    98	    public function addHistoryNative(DtbPriceHistory $PriceHistory): void
    99	    {
   100	        $sql = <<<EOT
   101	INSERT INTO dtb_price_history
   102	(
   103	    product_class_id,
   104	    sell_price,
   105	    old_sell_price,
   106	    buy_price,
   107	    old_buy_price,
   108	    standard_price,
   109	    old_standard_price,
   110	    member_id,
   111	    create_date
   112	)
   113	VALUES
   114	(
   115	    ?,
   116	    ?,
   117	    ?,
   118	    ?,
   119	    ?,
   120	    ?,
   121	    ?,
   122	    ?,
   123	    ?
   124	)
   125	EOT;
   126	
   127	        $this->getEntityManager()
   128	            ->getConnection()
   129	            ->executeStatement(
   130	                $sql,
   131	                [
   132	                    $PriceHistory->getProductClass()->getId(),
   133	                    $PriceHistory->getSellPrice(),
   134	                    $PriceHistory->getOldSellPrice(),
   135	                    $PriceHistory->getBuyPrice(),
   136	                    $PriceHistory->getOldBuyPrice(),
   137	                    $PriceHistory->getStandardPrice(),
   138	                    $PriceHistory->getOldStandardPrice(),
   139	                    $PriceHistory->getMemberId(),
   140	                    new \DateTime(),
   141	                ],
   142	                [
   143	                    ParameterType::INTEGER,
   144	                    ParameterType::INTEGER,
   145	                    ParameterType::INTEGER,
   146	                    ParameterType::INTEGER,
   147	                    ParameterType::INTEGER,
   148	                    ParameterType::INTEGER,
   149	                    ParameterType::INTEGER,
   150	                    ParameterType::INTEGER,
   151	                    Types::DATETIMETZ_MUTABLE,
   152	                ],
   153	            );
