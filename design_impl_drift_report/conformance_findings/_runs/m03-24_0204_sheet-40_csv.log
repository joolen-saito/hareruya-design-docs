   156	    /**
   157	     * 販売・買取のいずれかが変わっている場合のみ dtb_price_history に1行登録する。
   158	     * CSVインポート等で商品規格を更新した後に呼び出す。
   159	     */
   160	    public function addSellBuyPriceHistoryIfChanged(
   161	        ProductClass $ProductClass,
   162	        int $memberId,
   163	        int $oldSellPrice,
   164	        int $oldBuyPrice,
   165	        int $oldStandardPrice,
   166	        int $newSellPrice,
   167	        int $newBuyPrice,
   168	        int $newStandardPrice,
   169	    ): void {
   170	        if ($oldSellPrice === $newSellPrice && $oldBuyPrice === $newBuyPrice && $oldStandardPrice === $newStandardPrice) {
   171	            return;
   172	        }
   173	
   174	        $PriceHistory = new DtbPriceHistory();
   175	        $PriceHistory->setProductClass($ProductClass);
   176	        $PriceHistory->setMemberId($memberId);
   177	
   178	        if ($oldSellPrice !== $newSellPrice) {
   179	            $PriceHistory->setSellPrice($newSellPrice);
   180	            $PriceHistory->setOldSellPrice($oldSellPrice);
   181	        }
   182	
   183	        if ($oldBuyPrice !== $newBuyPrice) {
   184	            $PriceHistory->setBuyPrice($newBuyPrice);
   185	            $PriceHistory->setOldBuyPrice($oldBuyPrice);
   186	        }
   187	
   188	        if ($oldStandardPrice !== $newStandardPrice) {
   189	            $PriceHistory->setStandardPrice($newStandardPrice);
   190	            $PriceHistory->setOldStandardPrice($oldStandardPrice);
   191	        }
   192	
   193	        $this->addHistoryNative($PriceHistory);
   194	    }
