    16	namespace Eccube\Service\EntityManager;
    17	
    18	use Doctrine\ORM\EntityManagerInterface;
    19	use Eccube\Entity\Customer;
    20	use Eccube\Entity\DtbCustomerGroup;
    21	use Eccube\Entity\DtbPlayer;
    22	use Eccube\Entity\Master\MtbIdentification;
    23	use Eccube\Entity\Master\MtbIdentityConfirmStatus;
    24	
    25	class PlayerEntityManager
    26	{
    27	    public function __construct(private readonly EntityManagerInterface $entityManager)
    28	    {
    29	    }
    30	
    31	    public function save(
    32	        ?DtbPlayer $Player,
    33	        ?string $dciNo,
    34	        string $email,
    35	        ?string $firstNameJp,
    36	        ?string $firstNameEn,
    37	        ?string $lastNameJp,
    38	        ?string $lastNameEn,
    39	        ?Customer $Customer,
    40	        ?bool $identificationFlg,
    41	        DtbCustomerGroup $CustomerGroup,
    42	        bool $mailMagazineFlg,
    43	        int $point,
    44	        ?string $smaregiId,
    45	        ?string $pointContactNumber,
    46	        bool $pointTransferFlg,
    47	        int $pointLinkedFailureCount,
    48	        bool $existsSmaregiFlg,
    49	        MtbIdentityConfirmStatus $IdentityConfirmStatus,
    50	        ?string $nickname,
    51	        ?string $deckUserId,
    52	        ?string $profile,
    53	        ?\DateTime $idExpirationDate,
    54	        ?MtbIdentification $Identification,
    55	    ): DtbPlayer {
    56	        if ($Player === null) {
    57	            $Player = new DtbPlayer();
    58	        }
    59	
    60	        $Player->setDciNo($dciNo);
    61	        $Player->setEmail($email);
    62	        $Player->setFirstNameJp($firstNameJp);
    63	        $Player->setFirstNameEn($firstNameEn);
    64	        $Player->setLastNameJp($lastNameJp);
    65	        $Player->setLastNameEn($lastNameEn);
    66	        $Player->setCustomer($Customer);
    67	        $Player->setIdentificationFlg($identificationFlg);
    68	        $Player->setCustomerGroup($CustomerGroup);
    69	        $Player->setMailMagazineFlg($mailMagazineFlg);
    70	        $Player->setPoint($point);
    71	        $Player->setSmaregiId($smaregiId);
    72	        $Player->setPointContactNumber($pointContactNumber);
    73	        $Player->setPointTransferFlg($pointTransferFlg);
    74	        $Player->setPointLinkedFailureCount($pointLinkedFailureCount);
    75	        $Player->setExistsSmaregiFlg($existsSmaregiFlg);
    76	        $Player->setIdentityConfirmStatus($IdentityConfirmStatus);
    77	        $Player->setNickname($nickname);
    78	        $Player->setDeckUserId($deckUserId);
    79	        $Player->setProfile($profile);
    80	        $Player->setIdExpirationDate($idExpirationDate);
    81	        $Player->setIdentification($Identification);
    82	
    83	        $this->entityManager->persist($Player);
    84	
    85	        return $Player;
    86	    }
    87	}

