   318	            throw new AccessDeniedHttpException();
   319	        }
   320	
   321	        // DBに未登録のファイルの場合は404エラーを返し、S3からファイルを取得しない
   322	        if ($this->identificationImageRepository->findOneBy(['url' => $imageUrl]) === null) {
   323	            throw $this->createNotFoundException();
   324	        }
   325	
   326	        $file = $this->s3ServiceIdentification->getFile($imageUrl);
   327	
   328	        // 身分証画像が取得できなかった場合は404エラーを返し、画像表示を行わない
   329	        if ($file === '') {
   330	            throw $this->createNotFoundException();
   331	        }
   332	
   333	        // DBに保存されたS3オブジェクトキーからファイル拡張子を取得
   334	        $ext = pathinfo($imageUrl, PATHINFO_EXTENSION);
   335	
   336	        $response = new StreamedResponse(function () use ($file): void {
   337	            echo $file['Body']->getContents();
   338	        });
   339	        $response->headers->set('Content-Type', 'image/'.$ext);
   340	        $response->headers->set('Cache-Control', 'private, no-store');
   341	
   342	        return $response;
   343	    }
