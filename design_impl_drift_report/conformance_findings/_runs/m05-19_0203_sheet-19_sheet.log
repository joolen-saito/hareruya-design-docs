   118	            }
   119	            if ($ids !== []) {
   120	                $qb->andWhere($qb->expr()->in('IDENTITY(s.OrderType)', ':otIds'))
   121	                    ->setParameter('otIds', $ids);
   122	            }
   123	        }
   124	
   125	        return $qb;
   126	    }
