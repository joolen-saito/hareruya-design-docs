    97	        }
    98	
    99	        // 更新日From
   100	        if (!empty($searchData['update_date_from'])) {
   101	            $qb->andWhere('s.updateDate >= :udf')
   102	                ->setParameter('udf', $searchData['update_date_from']);
   103	        }
   104	
   105	        // 更新日To
   106	        if (!empty($searchData['update_date_to'])) {
   107	            $qb->andWhere('s.updateDate <= :udt')
   108	                ->setParameter('udt', $searchData['update_date_to']);
   109	        }
   110	
   111	        // 受注タイプ
   112	        if (!empty($searchData['order_type']) && is_array($searchData['order_type'])) {
   113	            $ids = [];
