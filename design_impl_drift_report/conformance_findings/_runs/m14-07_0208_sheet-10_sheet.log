namespace Eccube\Repository\Master;

use Doctrine\ORM\Query\ResultSetMapping;
use Doctrine\Persistence\ManagerRegistry;
use Eccube\Entity\Master\MtbCard;
use Eccube\Entity\Master\MtbCardDetail;
use Eccube\Entity\Master\MtbCardImage;
use Eccube\Entity\Master\MtbLanguage;
use Eccube\Repository\AbstractRepository;

/**
 * @extends AbstractRepository<MtbCardImage>
 */
class MtbCardImageRepository extends AbstractRepository
{
    public const RESULT_CACHING_TIME = 600;

    public function __construct(ManagerRegistry $registry)
    {
        parent::__construct($registry, MtbCardImage::class);
    }

    public function get(int $id = 1): ?MtbCardImage
    {
        return $this->find($id);
    }

    /**
     * 指定 Card に紐づく代表 CardImage を 1 件返す。MtbCardDetail を経由して取得する。
     */
    public function findOneByCardId(int $cardId): ?MtbCardImage
    {
        return $this->createQueryBuilder('ci')
            ->innerJoin('ci.CardDetail', 'cd')
            ->andWhere('IDENTITY(cd.Card) = :cardId')
            ->setParameter('cardId', $cardId)
            ->setMaxResults(1)
            ->getQuery()
            ->getOneOrNullResult();
    }

    public function findOneByCardDetail(MtbCardDetail $CardDetail): ?MtbCardImage
    {
        return $this->createQueryBuilder('ci')
            ->andWhere('ci.CardDetail = :CardDetail')
            ->setParameter('CardDetail', $CardDetail)
            ->setMaxResults(1)
            ->getQuery()
            ->getOneOrNullResult();
    }

    /**
     * カード（MtbCard）から最適な画像（日英優先・非プロモ・非Foil・表面）を1件取得する。
     */
    public function findOptimalByCard(MtbCard $Card): ?MtbCardImage
    {
        return $this->createQueryBuilder('ci')
            ->join('ci.CardDetail', 'cd')
            ->join('cd.Cardset', 'cs')
            ->where('cd.Card = :card')
            ->andWhere('ci.back_flg = :face')
            ->andWhere('ci.Language IN (:languageEn, :languageJp)')
            ->andWhere('cd.promotion_flg = :nonPromotion')
            ->andWhere('cd.foil_flg = :nonFoil')
            ->setParameter('card', $Card)
            ->setParameter('face', false)
            ->setParameter('languageEn', MtbLanguage::EN_ID)
            ->setParameter('languageJp', MtbLanguage::JP_ID)
            ->setParameter('nonPromotion', false)
            ->setParameter('nonFoil', 0)
            ->addOrderBy('cs.release_date', 'DESC')
            ->addOrderBy('ci.Language', 'DESC')
            ->setMaxResults(1)
            ->getQuery()
            ->getOneOrNullResult();
    }

    /**
     * 英語カード名から最適な画像（日英優先・非プロモ・非Foil・表面）を1件取得する。
     */
    public function findOptimalByCardNameEn(string $cardNameEn): ?MtbCardImage
    {
        $Results = $this->createQueryBuilder('ci')
            ->join('ci.CardDetail', 'cd')
            ->join('cd.Card', 'c')
            ->join('cd.Cardset', 'cs')
            ->where('c.name_en = :nameEn')
            ->andWhere('ci.back_flg = :face')
            ->andWhere('ci.Language IN (:languageEn, :languageJp)')
            ->andWhere('cd.promotion_flg = :nonPromotion')
            ->andWhere('cd.foil_flg = :nonFoil')
            ->setParameter('nameEn', $cardNameEn)
            ->setParameter('face', false)
            ->setParameter('languageEn', MtbLanguage::EN_ID)
            ->setParameter('languageJp', MtbLanguage::JP_ID)
            ->setParameter('nonPromotion', false)
            ->setParameter('nonFoil', 0)
            ->addOrderBy('cs.release_date', 'DESC')
            ->addOrderBy('ci.Language', 'DESC')
            ->setMaxResults(1)
            ->getQuery()
            ->getResult();

        return empty($Results) ? null : $Results[0];
    }

    /**
     * カードIdごとの最適な画像を取得し、['cardId' => 'imageUrl',・・・]の形で結果を返す
     *
     * @param array<int, mixed> $cardIds
     */
    public function getOptimalCardImages(array $cardIds, ?string $locale = 'ja'): mixed
    {
        $langId = $locale === 'ja' ? MtbLanguage::JP_ID : MtbLanguage::EN_ID;

        $cardIds = array_filter($cardIds, fn ($id) => is_int($id));

        if (empty($cardIds)) {
            return [null => null];
        }

        $query = 'SELECT c.id id, (
                    SELECT ci.url
                    FROM mtb_card_detail cd
                    JOIN mtb_card_image ci ON cd.id = ci.card_detail_id
                    JOIN mtb_cardset cs ON cd.cardset_id = cs.id
                    WHERE cd.card_id = c.id AND ci.back_flg = false
                    ORDER BY cs.special_flg ASC, cd.promotion_flg ASC, cs.release_date DESC, cd.foil_flg ASC, ci.language_id = :language_id DESC, cd.id DESC
                    limit 1
                ) url
                FROM mtb_card c
                WHERE c.id IN (:card_ids)';

        $rsm = new ResultSetMapping();
        $rsm->addScalarResult('id', 'id')
            ->addScalarResult('url', 'url');

        $result = $this->getEntityManager()
            ->createNativeQuery($query, $rsm)
            ->setParameters([
                ':card_ids' => $cardIds,
                ':language_id' => $langId,
            ])
            ->enableResultCache(self::RESULT_CACHING_TIME, 'cardImages-'.implode('_', $cardIds))
            ->getResult();

        $resultArray = array_column($result, 'url', 'id');
        $resultArray[null] = null;

        return $resultArray;
    }

    /**
     * カードIDリストに対して dead_link_flg=false の画像URLマップを返す。
     *
     * @param list<int>      $cardIds
     *
     * @return array<int, string>
     */
    public function findUrlMapByCardIds(array $cardIds): array
    {
        if ($cardIds === []) {
            return [];
        }

        /** @var list<array{cardId: int, url: string, id: int}> $rows */
        $rows = $this->createQueryBuilder('ci')
            ->select('IDENTITY(cd.Card) as cardId', 'ci.url', 'ci.id')
            ->join('ci.CardDetail', 'cd')
            ->where('IDENTITY(cd.Card) IN (:cardIds)')
            ->andWhere('ci.dead_link_flg = false')
            ->andWhere('ci.back_flg = false')
            ->orderBy('ci.id', 'ASC')
            ->setParameter('cardIds', $cardIds)
            ->getQuery()
            ->getArrayResult();

        $map = [];
        foreach ($rows as $row) {
            $cardId = (int) $row['cardId'];
            if (!isset($map[$cardId])) {
                $map[$cardId] = $row['url'];
            }
        }

        return $map;
    }

