namespace Eccube\Service;

use Aws\Result;
use Aws\S3\Exception\S3Exception;
use Aws\S3\S3Client;
use Eccube\Entity\Master\MtbCardImage;
use Symfony\Component\DependencyInjection\ParameterBag\ParameterBagInterface;

class S3AccessService
{
    private S3Client $client;
    private string $s3Directory = '';
    private string $bucket;
    private string $acl;

    /**
     * Application $app
     * boolean $isIdentification 身分証保管用バケットフラグ
     */
    public function __construct(
        private readonly ParameterBagInterface $parameterBag,
        bool $isIdentification = false,
    ) {
        $s3Config = $this->parameterBag->get('s3');

        $this->client = new S3Client([
            'region' => $s3Config['region'],
            'version' => $s3Config['version'],
            'credentials' => $s3Config['credentials'],
            'endpoint' => $s3Config['endpoint'] ?? null,
            'use_path_style_endpoint' => $s3Config['use_path_style_endpoint'] ?? false,
        ]);

        $this->bucket = $isIdentification ? $s3Config['identificationBucket'] : $s3Config['bucket'];
        $this->acl = $isIdentification ? $s3Config['identificationAcl'] : $s3Config['acl'];
    }

    /**
     * upload script
     *
     * @param array{extension: string, file: string|object} $fileInfo
     */
    public function putFile(array $fileInfo, string $suffix = ''): string
    {
        do {
            $fileName = $this->s3Directory.uniqid().rand(100, 999).$suffix.'.'.strtolower($fileInfo['extension']);
        } while ($this->client->doesObjectExist($this->bucket, $fileName));

        $this->client->putObject([
            'Bucket' => $this->bucket,
            'Key' => $fileName,
            'SourceFile' => $fileInfo['file'], // EntityBody::factoryの代わり
            'ContentType' => is_object($fileInfo['file']) && method_exists($fileInfo['file'], 'getMimeType')
                ? $fileInfo['file']->getMimeType()
                : null,
            'ACL' => $this->acl,
        ]);

        return $fileName;
    }

    /**
     * ファイルパスでなくファイルの中身を直接アップロードする
     *
     * @param array{extension: string, file: string|object} $fileInfo
     */
    public function putFileData(array $fileInfo, string $suffix = ''): string
    {
        do {
            $fileName = $this->s3Directory.uniqid().rand(100, 999).$suffix.'.'.strtolower((string) $fileInfo['extension']);
        } while ($this->client->doesObjectExist($this->bucket, $fileName));

        $this->client->putObject([
            'Bucket' => $this->bucket,
            'Key' => $fileName,
            'Body' => $fileInfo['file'],
            'ContentType' => is_object($fileInfo['file']) && method_exists($fileInfo['file'], 'getMimeType')
                ? $fileInfo['file']->getMimeType()
                : null,
            'ACL' => $this->acl,
        ]);

        return $fileName;
    }

    public function setS3Directory(string $dir): self
    {
        $this->s3Directory = $dir;

        return $this;
    }

    /**
     * @return array<string, mixed>
     */
    public function getFiles(string $dir, ?string $key = null): array
    {
        $objects = $this->client->listObjects([
            'Bucket' => $this->bucket,
            'Prefix' => $dir,
            'Marker' => $key,
        ]);

        $contents = [];
        if (isset($objects['Contents'])) {
            foreach ($objects['Contents'] as $object) {
                if (!str_ends_with($object['Key'], '/')) {
                    $contents[] = $object;
                }
            }
        }

        if ($objects['IsTruncated']) {
            $lastKey = end($contents)['Key'];
            $contents = array_merge($contents, $this->getFiles($dir, $lastKey));
        }

        return $contents;
    }

    public function isFileExist(string $fileName): bool
    {
        return $this->client->doesObjectExist($this->bucket, $fileName);
    }

    /**
     * カード画像をローカルディレクトリへ保存し、保存したファイル名を返す（旧 HareruyaEc S3AccessService::downloadFile 相当）.
     */
    public function downloadCardImageToDirectory(string $dirName, MtbCardImage $cardImage, int $foilFlg = 0): ?string
    {
        $ext = '.jpg';
        $s3Key = ltrim(trim((string) $cardImage->getUrl()), '/');
        $prefix = trim($this->s3Directory, '/');
        if ($prefix !== '' && !str_starts_with($s3Key, $prefix.'/')) {
            $s3Key = $prefix.'/'.$s3Key;
        }

        $cardDetail = $cardImage->getCardDetail();
        if ($cardDetail === null || $cardDetail->getId() === null) {
            return null;
        }

        $localFileName = $cardDetail->getId().$ext;
        if ($foilFlg !== 0) {
            $localFileName = 'F'.$localFileName;
        }

        try {
            $this->client->getObject([
                'Bucket' => $this->bucket,
                'Key' => $s3Key,
                '@http' => ['sink' => $dirName.'/'.$localFileName],
            ]);
        } catch (S3Exception $e) {
            log_info('カード画像S3取得エラー', [$e->getMessage()]);

            return null;
        }

        return $localFileName;
    }

    /**
     * @return Result<mixed>
     */

