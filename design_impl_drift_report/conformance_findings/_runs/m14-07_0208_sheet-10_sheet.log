   228	    /**
   229	     * カード画像 ZIP（セット別：カード詳細あたり language_id 昇順で最初の 1 枚）をダウンロードする。
   230	     *
   231	     * POST の cardsetIds が空のときはカードセット未設定（プロモ相当）のみを対象とする。
   232	     */
   233	    #[Route('/%eccube_admin_route%/cardset/download', name: 'admin_cardset_download', methods: ['POST'])]
   234	    public function download(Request $request, CardsetDownloadAction $downloadAction): Response
   235	    {
   236	        $ids = $this->getCardsetIdsFromRequest($request);
   237	
   238	        try {
   239	            $zipPath = $downloadAction->execute($ids, false);
   240	
   241	            return $this->createZipResponse($zipPath);
   242	        } catch (\Exception $e) {
   243	            $this->addError(trans($e->getMessage()), 'admin');
   244	
   245	            return $this->redirectToRoute('admin_cardset_list');
   246	        }
   247	    }
   248	
   249	    /**
   250	     * カード画像 ZIP（言語別フォルダに全言語分）をダウンロードする。
   251	     */
   252	    #[Route('/%eccube_admin_route%/cardset/download_each_lang', name: 'admin_cardset_download_each_lang', methods: ['POST'])]
   253	    public function downloadEachLang(Request $request, CardsetDownloadAction $downloadAction): Response
   254	    {
   255	        $ids = $this->getCardsetIdsFromRequest($request);
   256	
   257	        try {
   258	            $zipPath = $downloadAction->execute($ids, true);
   259	
   260	            return $this->createZipResponse($zipPath);
   261	        } catch (\Exception $e) {
   262	            $this->addError(trans($e->getMessage()), 'admin');
   263	
   264	            return $this->redirectToRoute('admin_cardset_list');
   265	        }
   266	    }
   267	
   268	    /**
   269	     * 一時 ZIP を添付したレスポンスを返す。送信完了後に ZIP ファイルのみ削除する（Symfony の deleteFileAfterSend）。
   270	     * 作業ディレクトリ内の展開画像などは、次回 CardsetDownloadAction::execute 開始時にまとめてクリアされる。
   271	     */
   272	    private function createZipResponse(string $filePath): BinaryFileResponse
   273	    {
   274	        $response = new BinaryFileResponse($filePath);
   275	        $response->setContentDisposition(
   276	            ResponseHeaderBag::DISPOSITION_ATTACHMENT,
   277	            'card_image.zip'
   278	        );
   279	        $response->deleteFileAfterSend(true);
   280	
   281	        return $response;
   282	    }
   283	
   284	    /**
   285	     * POST の cardsetIds を配列で返す。キーが無いときは空配列（execute 側でプロモ向けに解釈される）。
   286	     *
   287	     * @return list<int|string>
   288	     */
   289	    private function getCardsetIdsFromRequest(Request $request): array
   290	    {
   291	        $parameters = $request->request->all();
   292	        if (!\array_key_exists('cardsetIds', $parameters)) {
   293	            return [];
   294	        }
   295	
   296	        $ids = $parameters['cardsetIds'];
   297	        if ($ids === null || $ids === '') {
   298	            return [];
   299	        }
   300	
   301	        if (!\is_array($ids)) {
   302	            return [(string) $ids];
   303	        }
   304	
   305	        return $ids;
   306	    }
   307	}

