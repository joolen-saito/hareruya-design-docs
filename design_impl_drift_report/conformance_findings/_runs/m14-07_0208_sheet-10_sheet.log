namespace Eccube\Controller\Admin\Card;

use Eccube\Controller\AbstractController;
use Eccube\Entity\Master\MtbCardset;
use Eccube\Form\Type\Admin\CardsetType;
use Eccube\Repository\Master\MtbCardRepository;
use Eccube\Repository\Master\MtbCardsetRepository;
use Eccube\Repository\Master\PageMaxRepository;
use Eccube\Service\Admin\Cardset\CardsetDownloadAction;
use Eccube\Service\Admin\Cardset\CardsetSaveAction;
use Eccube\Service\Upload\FileManager;
use Symfony\Bridge\Twig\Attribute\Template;
use Symfony\Component\HttpFoundation\BinaryFileResponse;
use Symfony\Component\HttpFoundation\RedirectResponse;
use Symfony\Component\HttpFoundation\Request;
use Symfony\Component\HttpFoundation\Response;
use Symfony\Component\HttpFoundation\ResponseHeaderBag;
use Symfony\Component\HttpKernel\Exception\NotFoundHttpException;
use Symfony\Component\Routing\Attribute\Route;

class CardsetController extends AbstractController
{
    public function __construct(
        private readonly MtbCardsetRepository $cardsetRepository,
        private readonly MtbCardRepository $cardRepository,
        private readonly FileManager $fileManager,
        protected PageMaxRepository $pageMaxRepository,
    ) {
    }

    /**
     * @return array<string, mixed>
     */
    #[Route('/%eccube_admin_route%/cardset', name: 'admin_cardset_list')]
    #[Route('/%eccube_admin_route%/cardset/page/{page_no}', name: 'admin_cardset_list_paged', requirements: ['page_no' => '\d+'])]
    #[Template('@admin/Cardset/index.twig')]
    public function index(Request $request, \Knp\Component\Pager\PaginatorInterface $paginator, int $page_no = 1): array
    {
        // sort の処理
        $sortKeySessionKey = 'eccube.admin.cardset.sort';
        $sortKey = match (true) {
            !empty($request->query->getString('sort_key')) => $request->query->getString('sort_key'),
            ($this->session->get($sortKeySessionKey) !== null) => $this->session->get($sortKeySessionKey),
            default => MtbCardsetRepository::DEFAULT_SORT_KEY,
        };
        $this->session->set($sortKeySessionKey, $sortKey);

        // order の処理
        $sortOrderSessionKey = 'eccube.admin.cardset.order';
        $sortOrder = match (true) {
            !empty($request->query->getString('sort_order')) => $request->query->getString('sort_order'),
            ($this->session->get($sortOrderSessionKey) !== null) => $this->session->get($sortOrderSessionKey),
            default => MtbCardsetRepository::DEFAULT_SORT_ORDER,
        };
        $this->session->set($sortOrderSessionKey, $sortOrder);

        $qb = $this->cardsetRepository->getQueryBuilder([
            'sortKey' => $sortKey,
            'sortOrder' => $sortOrder,
        ]);

        $pageCountSessionKey = 'eccube.admin.cardset.search.page_count';
        $pageCount = $this->session->get($pageCountSessionKey,
            $this->eccubeConfig->get('eccube_default_page_count'));

        $pageCountParam = $request->query->getInt('page_count');
        $PageMaxis = $this->pageMaxRepository->findAll();
        if ($pageCountParam) {
            foreach ($PageMaxis as $PageMax) {
                $pageMaxNum = (int) $PageMax->getName();
                if ($pageCountParam === $pageMaxNum) {
                    $pageCount = $pageMaxNum;
                    $this->session->set($pageCountSessionKey, $pageCount);
                    break;
                }
            }
        }
        $pagination = $paginator->paginate(
            $qb,
            $page_no,
            $pageCount
        );

        $this->session->set('eccube.admin.cardset.page_no', $page_no);

        return [
            'pagination' => $pagination,
            'pageMaxis' => $PageMaxis,
            'pageCount' => $pageCount,
            'sortKeys' => $this->cardsetRepository->getSortKeys(),
            'sortKey' => $sortKey,
            'sortOrder' => $sortOrder,
        ];
    }

    /**
     * カードセット新規登録画面.
     *
     * @return RedirectResponse|array<string, mixed>
     */
    #[Route('/%eccube_admin_route%/cardset/new', name: 'admin_cardset_new', methods: ['GET', 'POST'])]
    #[Template('@admin/Cardset/edit.twig')]
    public function new(Request $request, CardsetSaveAction $saveAction): RedirectResponse|array
    {
        $Cardset = new MtbCardset();
        $builder = $this->formFactory->createBuilder(CardsetType::class, $Cardset, ['cardset_id' => null]);
        $form = $builder->getForm();
        $form->handleRequest($request);

        if ($form->isSubmitted() && $form->isValid()) {
            $Cardset = $form->getData();
            $saveAction->handle($Cardset);

            $this->addSuccess('admin.common.save_complete', 'admin');

            return $this->redirectToRoute('admin_cardset_edit', ['id' => $Cardset->getId()]);
        }

        $pageNo = $this->session->get('eccube.admin.cardset.page_no', 1);

        return [
            'form' => $form->createView(),
            'Cardset' => $Cardset,
            'pageNo' => $pageNo,
        ];
    }

    /**
     * カードセット編集画面.
     *
     * @return RedirectResponse|array<string, mixed>
     */
    #[Route('/%eccube_admin_route%/cardset/{id}/edit', name: 'admin_cardset_edit', methods: ['GET', 'POST'])]
    #[Template('@admin/Cardset/edit.twig')]
    public function edit(Request $request, int $id, CardsetSaveAction $saveAction): RedirectResponse|array
    {
        if (!$Cardset = $this->cardsetRepository->find($id)) {
            throw new NotFoundHttpException();
        }
        $builder = $this->formFactory->createBuilder(CardsetType::class, $Cardset, ['cardset_id' => $id]);
        $form = $builder->getForm();
        $form->handleRequest($request);

        if ($form->isSubmitted() && $form->isValid()) {
            $Cardset = $form->getData();
            $saveAction->handle($Cardset);

            $this->addSuccess('admin.common.save_complete', 'admin');

            return $this->redirectToRoute('admin_cardset_edit', ['id' => $Cardset->getId()]);
        }

        // 収録カードリスト
        $cardList = $this->cardRepository->getQueryBuilderByCardset($Cardset)
            ->getQuery()
            ->getResult();

        $pageNo = $this->session->get('eccube.admin.cardset.page_no', 1);

        return [
            'form' => $form->createView(),
            'Cardset' => $Cardset,
            'cardList' => $cardList,
            'pageNo' => $pageNo,
        ];
    }

    /**
     * @throws \Exception
     */
    #[Route(
        '/%eccube_admin_route%/product/cardset/{id}/delete',
        requirements: ['id' => '\d+'],
        name: 'admin_cardset_delete',
        methods: ['DELETE']
    )]
    public function delete(MtbCardset $Cardset): RedirectResponse
    {
        $this->isTokenValid();

        log_info('カードセット削除開始', [$Cardset->getId()]);

        if ($symbolImage = $Cardset->getSymbolImage()) {
            // シンボル画像ファイルを削除
            $fileAdapter = $this->fileManager->getAdapter();
            $filePath = $this->eccubeConfig['eccube_html_user_data_dir'].$symbolImage;

            if ($fileAdapter->exists($filePath, [])) {
                $fileAdapter->delete($filePath, []);
            }
        }

        try {
            $this->cardsetRepository->delete($Cardset);
            $this->entityManager->flush();

            $this->addSuccess('admin.common.delete_complete', 'admin');
            log_info('カードセット削除完了', [$Cardset->getId()]);
        } catch (\Doctrine\DBAL\Exception\ForeignKeyConstraintViolationException $e) {
            log_error('カードセット削除エラー（外部キー制約）', [$Cardset->getId(), $e]);

            $message = trans('admin.card.cardset.error.delete_has_cards', ['%name%' => $Cardset->getNameJp()]);
            $this->addError($message, 'admin');
        } catch (\Exception $e) {
            log_error('カードセット削除エラー', [$Cardset->getId(), $e]);

            $this->addError(trans('admin.common.delete_error'), 'admin');
        }

        return $this->redirectToRoute('admin_cardset_list');
    }

    /**
     * カード画像 ZIP（セット別：カード詳細あたり language_id 昇順で最初の 1 枚）をダウンロードする。
     *
     * POST の cardsetIds が空のときはカードセット未設定（プロモ相当）のみを対象とする。
     */
    #[Route('/%eccube_admin_route%/cardset/download', name: 'admin_cardset_download', methods: ['POST'])]
    public function download(Request $request, CardsetDownloadAction $downloadAction): Response
    {
        $ids = $this->getCardsetIdsFromRequest($request);

        try {
            $zipPath = $downloadAction->execute($ids, false);

            return $this->createZipResponse($zipPath);
        } catch (\Exception $e) {
            $this->addError(trans($e->getMessage()), 'admin');

            return $this->redirectToRoute('admin_cardset_list');
        }
    }

    /**
     * カード画像 ZIP（言語別フォルダに全言語分）をダウンロードする。
     */
    #[Route('/%eccube_admin_route%/cardset/download_each_lang', name: 'admin_cardset_download_each_lang', methods: ['POST'])]
    public function downloadEachLang(Request $request, CardsetDownloadAction $downloadAction): Response
    {
        $ids = $this->getCardsetIdsFromRequest($request);

        try {
            $zipPath = $downloadAction->execute($ids, true);

            return $this->createZipResponse($zipPath);
        } catch (\Exception $e) {
            $this->addError(trans($e->getMessage()), 'admin');

            return $this->redirectToRoute('admin_cardset_list');
        }
    }

    /**
     * 一時 ZIP を添付したレスポンスを返す。送信完了後に ZIP ファイルのみ削除する（Symfony の deleteFileAfterSend）。
     * 作業ディレクトリ内の展開画像などは、次回 CardsetDownloadAction::execute 開始時にまとめてクリアされる。
     */
    private function createZipResponse(string $filePath): BinaryFileResponse
    {
        $response = new BinaryFileResponse($filePath);
        $response->setContentDisposition(
            ResponseHeaderBag::DISPOSITION_ATTACHMENT,
            'card_image.zip'
        );
        $response->deleteFileAfterSend(true);

        return $response;
    }

    /**
     * POST の cardsetIds を配列で返す。キーが無いときは空配列（execute 側でプロモ向けに解釈される）。
     *
     * @return list<int|string>
     */
    private function getCardsetIdsFromRequest(Request $request): array
    {
        $parameters = $request->request->all();
        if (!\array_key_exists('cardsetIds', $parameters)) {
            return [];
        }

        $ids = $parameters['cardsetIds'];
        if ($ids === null || $ids === '') {
            return [];
        }

        if (!\is_array($ids)) {
            return [(string) $ids];
        }

        return $ids;
    }
}

