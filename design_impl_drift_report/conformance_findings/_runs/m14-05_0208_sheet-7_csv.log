   254	     * 一覧の一括 POST から数値のカード ID のみを重複除去して返す。
   255	     *
   256	     * @param Request $request エクスポート POST（cardIds 配列を含む）
   257	     *
   258	     * @return array<int, int> カード ID の昇順ではなく、リクエストで有効だった順を維持した配列
   259	     */
   260	    public function getIds(Request $request): array
   261	    {
   262	        try {
   263	            $raw = $request->request->all('cardIds');
   264	        } catch (BadRequestException) {
   265	            return [];
   266	        }
   267	
   268	        $ids = [];
   269	        foreach ($raw as $v) {
   270	            if ($v === null || $v === '') {
   271	                continue;
   272	            }
   273	            if (!is_scalar($v)) {
   274	                continue;
   275	            }
   276	            $value = (string) $v;
   277	            if (ctype_digit($value)) {
   278	                $ids[] = (int) $value;
   279	            }
   280	        }
   281	
   282	        return array_values(array_unique($ids, SORT_REGULAR));
   283	    }
