   343	    /**
   344	     * @return array<string, string>
   345	     */
   346	    private function buildExportRowDetailPart(MtbCard $Card, ?MtbCardDetail $Detail): array
   347	    {
   348	        if ($Detail === null) {
   349	            return [
   350	                'set' => '',
   351	                'rarity' => '',
   352	                'illustrator' => '',
   353	                'layout' => '',
   354	                'flavor_jp' => '',
   355	                'flavor_en' => '',
   356	                'card_no' => '',
   357	                'promotion_type' => '',
   358	                'foil' => '',
   359	                'frame' => '',
