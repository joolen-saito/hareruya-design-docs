   288	     * @param array<int, MtbCard> $Cards 出力対象カード
   289	     *
   290	     * @return array<int, array<string, string>> 列キー => セル文字列の行のリスト
   291	     */
   292	    public function convertExportCsvRows(array $Cards): array
   293	    {
   294	        $csvRows = [];
   295	
   296	        foreach ($Cards as $Card) {
   297	            $base = $this->buildExportRowBase($Card);
   298	            $details = $Card->getCardDetails();
   299	
   300	            if ($details->isEmpty()) {
   301	                $csvRows[] = array_merge($base, $this->buildExportRowDetailPart($Card, null));
   302	
   303	                continue;
   304	            }
   305	
   306	            foreach ($details as $Detail) {
   307	                $csvRows[] = array_merge($base, $this->buildExportRowDetailPart($Card, $Detail));
   308	            }
   309	        }
   310	
   311	        return $csvRows;
   312	    }
   313	
   314	    /**
   315	     * @return array<string, string>
   316	     */
   317	    private function buildExportRowBase(MtbCard $Card): array
   318	    {
   319	        return [
   320	            'name_jp' => (string) ($Card->getNameJp() ?? ''),
   321	            'name_en' => (string) ($Card->getNameEn() ?? ''),
   322	            'arena_format_name_jp' => (string) ($Card->getArenaFormatNameJp() ?? ''),
   323	            'arena_format_name_en' => (string) ($Card->getArenaFormatNameEn() ?? ''),
   324	            'text_jp' => (string) ($Card->getTextJp() ?? ''),
   325	            'text_en' => (string) ($Card->getTextEn() ?? ''),
   326	            'mana_cost' => $Card->getManaCost(),
   327	            'cmc' => $this->formatCmcForExport($Card->getCmc()),
   328	            'power' => (string) ($Card->getPower() ?? ''),
   329	            'toughness' => (string) ($Card->getToughness() ?? ''),
   330	            'loyalty' => (string) ($Card->getLoyalty() ?? ''),
   331	            'cardtype' => $this->joinEntityNamesEn($Card->getCardTypes()),
   332	            'color' => $this->joinEntityNamesEn($Card->getColors()),
   333	            'color_identity' => $this->joinEntityNamesEn($Card->getColorIdentities()),
   334	            'subtype' => $this->joinEntityNamesEn($Card->getSubtypes()),
   335	            'specialtype' => $this->joinEntityNamesEn($Card->getSpecialtypes()),
   336	            'keyword_ability' => '', // TODO:キーワード能力は未実装
   337	            'format' => $this->joinFormatNamesByRestriction($Card, MtbRestriction::LEGAL_ID),
   338	            'restriction_format' => $this->joinFormatNamesByRestriction($Card, MtbRestriction::RESTRICTION_ID),
   339	            'ban_format' => $this->joinFormatNamesByRestriction($Card, MtbRestriction::BAN_ID),
   340	        ];
   341	    }
