   387	    /**
   388	     * @param iterable<int, mixed> $collection
   389	     */
   390	    private function joinEntityNamesEn(iterable $collection): string
   391	    {
   392	        $names = [];
   393	        foreach ($collection as $entity) {
   394	            if (method_exists($entity, 'getNameEn')) {
   395	                $name = $entity->getNameEn();
   396	                if ($name !== null && $name !== '') {
   397	                    $names[] = (string) $name;
   398	                }
   399	            }
   400	        }
   401	
   402	        return implode(',', $names);
   403	    }
   404	
   405	    private function joinFormatNamesByRestriction(MtbCard $Card, int $restrictionId): string
   406	    {
   407	        $names = [];
   408	        foreach ($Card->getCardFormats() as $CardFormat) {
   409	            if ($CardFormat->getRestriction()?->getId() !== $restrictionId) {
   410	                continue;
   411	            }
   412	            $nameEn = $CardFormat->getFormat()?->getNameEn();
   413	            if ($nameEn !== null && $nameEn !== '') {
   414	                $names[] = $nameEn;
   415	            }
   416	        }
   417	
   418	        return implode(',', $names);
   419	    }
   420	
   421	    private function findCardImageUrl(MtbCardDetail $Detail, int $languageId): string
   422	    {
   423	        foreach ($Detail->getCardImages() as $CardImage) {
   424	            if ($CardImage->isBackFlg() === true) {
   425	                continue;
   426	            }
   427	            if ($CardImage->getLanguage()?->getId() === $languageId) {
   428	                return $CardImage->getUrl();
   429	            }
   430	        }
   431	
   432	        return '';
   433	    }
   434	
   435	    private function exportFrameLabel(int $frameFlg): string
   436	    {
   437	        return match ($frameFlg) {
   438	            MtbCardDetail::FRAME_SPECIAL => self::FRAME_SPECIAL,
   439	            default => self::FRAME_NORMAL,
   440	        };
   441	    }
   442	
   443	    private function formatCmcForExport(float $cmc): string
   444	    {
   445	        if ($cmc === floor($cmc)) {
   446	            return (string) (int) $cmc;
   447	        }
   448	
   449	        return rtrim(rtrim(sprintf('%.10F', $cmc), '0'), '.');
   450	    }
