   269	    #[Route('/%eccube_admin_route%/card/{id}/delete', name: 'admin_card_delete', requirements: ['id' => '\d+'], methods: ['DELETE'])]
   270	    public function delete(Request $request, MtbCard $card): RedirectResponse
   271	    {
   272	        $this->isTokenValid();
   273	
   274	        $pageNo = $this->session->get($this->sessionKey.'.page_no', 1);
   275	        $referer = $request->headers->get('referer');
   276	
   277	        $indexUrl = $this->generateUrl('admin_card_search', ['page_no' => $pageNo]).'?resume='.Constant::ENABLED;
   278	        $editUrl = $this->generateUrl('admin_card_edit', ['id' => $card->getId()]);
   279	
   280	        // 失敗時の戻り先
   281	        $isEditPage = $referer && str_contains($referer, '/edit');
   282	        $errorRedirectUrl = $isEditPage ? $editUrl : $indexUrl;
   283	
   284	        if (!$this->cardRepository->isDeletable($card)) {
   285	            $this->addError(trans('admin.card.delete.error_foreign_key', ['%card_name%' => $card->getNameJpWithEn()]), 'admin');
   286	
   287	            return $this->redirect($errorRedirectUrl);
   288	        }
   289	
   290	        try {
   291	            $this->entityManager->remove($card);
   292	            $this->entityManager->flush();
   293	        } catch (\Exception $e) {
   294	            log_error('カード削除エラー', ['id' => $card->getId(), 'message' => $e->getMessage()]);
   295	            $this->addError('admin.common.delete_error', 'admin');
   296	
   297	            return $this->redirect($errorRedirectUrl);
   298	        }
   299	
   300	        $this->addSuccess('admin.common.delete_complete', 'admin');
   301	
   302	        return $this->redirect($indexUrl);
   303	    }
   304	
   305	    /**
   306	     * カード一括削除.
   307	     */
   308	    #[Route('/%eccube_admin_route%/card/bulk_delete', name: 'admin_card_bulk_delete', methods: ['DELETE'])]
   309	    public function bulkDelete(Request $request): RedirectResponse
   310	    {
   311	        $this->isTokenValid();
   312	
   313	        $cardIds = $request->request->all('cardIds');
   314	
   315	        $pageNo = $this->session->get($this->sessionKey.'.page_no', 1);
   316	        $redirectUrl = $this->generateUrl('admin_card_search', ['page_no' => $pageNo]).'?resume='.Constant::ENABLED;
   317	
   318	        if (empty($cardIds)) {
   319	            $this->addError('admin.common.delete_error', 'admin');
   320	
   321	            return $this->redirect($redirectUrl);
   322	        }
   323	
   324	        $deleteCount = 0;
   325	        $skippedCardNames = [];
   326	
   327	        $cards = $this->cardRepository->findBy(['id' => $cardIds]);
   328	        foreach ($cards as $card) {
   329	            // 事前チェック：明らかに削除不可なものは即スキップ
   330	            if (!$this->cardRepository->isDeletable($card)) {
   331	                $skippedCardNames[] = $card->getNameJpWithEn();
   332	                continue;
   333	            }
   334	
   335	            // カード単位でトランザクションを切る
   336	            $this->entityManager->beginTransaction();
   337	            try {
   338	                $this->entityManager->remove($card);
   339	                $this->entityManager->flush();
   340	                $this->entityManager->commit();
   341	                $deleteCount++;
   342	            } catch (ForeignKeyConstraintViolationException $e) {
   343	                // isDeletable() 判定後の競合（他トランザクションによる参照追加）をスキップ扱いにする
   344	                $this->entityManager->rollback();
   345	                $skippedCardNames[] = $card->getNameJpWithEn();
   346	            } catch (\Exception $e) {
   347	                $this->entityManager->rollback();
   348	                log_error('カード一括削除エラー', ['id' => $card->getId(), 'message' => $e->getMessage()]);
   349	                $this->addError('admin.common.delete_error', 'admin');
   350	                break; // EntityManager が閉じる可能性があるため後続カードの処理を続けない
   351	            }
   352	        }
   353	
   354	        if ($deleteCount > 0) {
   355	            $this->addSuccess('admin.common.delete_complete', 'admin');
   356	        }
   357	
   358	        foreach ($skippedCardNames as $name) {
   359	            $this->addError(trans('admin.card.delete.error_foreign_key', ['%card_name%' => $name]), 'admin');
   360	        }
   361	
   362	        return $this->redirect($redirectUrl);
   363	    }
   364	}

