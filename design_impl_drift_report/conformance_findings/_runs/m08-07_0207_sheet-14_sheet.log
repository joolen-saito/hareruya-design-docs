  2111	    private function saveUserMailHistory(Email $message, ?MailTemplate $mailTemplate = null, Customer|Order|DtbBuyOrder|null $info = null, ?Member $creator = null): void
  2112	    {
  2113	        $mailHistory = new MailHistory();
  2114	        $mailHistory
  2115	            ->setMailSubject($message->getSubject())
  2116	            ->setMailBody($message->getTextBody())
  2117	            ->setSendDate(new \DateTime())
  2118	            ->setCreator($creator);
  2119	
  2120	        if (!is_null($mailTemplate)) {
  2121	            $mailHistory->setMailTemplate($mailTemplate);
  2122	            $mailHistory->setBaseInfo($mailTemplate->getBaseInfo());
  2123	        }
  2124	
  2125	        if ($info instanceof Customer) {
  2126	            $mailHistory->setCustomer($info);
  2127	        } elseif ($info instanceof Order) {
  2128	            $mailHistory
  2129	                ->setOrder($info)
  2130	                ->setCustomer($info->getCustomer());
  2131	            // ゲストIDを設定
  2132	            $guestId = $info->getGuestId();
  2133	            if ($guestId !== null && $guestId !== '') {
  2134	                $mailHistory->setGuestId($guestId);
  2135	            }
  2136	        } elseif ($info instanceof DtbBuyOrder) {
  2137	            $mailHistory
  2138	                ->setBuyOrder($info)
  2139	                ->setCustomer($info->getCustomer());
  2140	        }
  2141	
  2142	        $this->entityManager->persist($mailHistory);
  2143	        $this->entityManager->flush();
  2144	    }
