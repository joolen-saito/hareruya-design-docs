from pathlib import Path
from html.parser import HTMLParser
from html import unescape
text=Path('excel_to_html/output/0204_基本設計仕様書(商品管理).html').read_text(encoding='utf-8', errors='ignore')
start=text.index('<section class=\"sheet-panel\" id=\"sheet-57\"')
end=text.index('<section class=\"sheet-panel\" id=\"sheet-58\"', start)
s=text[start:end]
class P(HTMLParser):
    block={'h2','h3','h4','p','li','tr','dt','dd'}
    skip={'script','style','img','svg'}
    def __init__(self): super().__init__(); self.out=[]; self.cur=[]; self.stack=[]; self.skip_depth=0
    def handle_starttag(self,tag,attrs):
        if tag in self.skip: self.skip_depth+=1
        if tag in self.block: self.cur=[]; self.stack.append(tag)
        if tag=='br' and self.skip_depth==0: self.cur.append(' ')
    def handle_endtag(self,tag):
        if tag in self.skip and self.skip_depth: self.skip_depth-=1
        if tag in self.block and self.stack:
            t=' '.join(''.join(self.cur).split())
            if t: self.out.append(t)
            self.cur=[]
            self.stack.pop()
    def handle_data(self,data):
        if self.skip_depth==0 and self.stack: self.cur.append(unescape(data))
p=P(); p.feed(s)
for line in p.out:
    if not line.startswith('iVBOR') and len(line)<2000:
        print(line)
