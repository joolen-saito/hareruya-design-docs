    52	     * @return StreamedResponse
    53	     */
    54	    #[Route(path: '/%eccube_admin_route%/product/shelf_number/csv_template', name: 'admin_product_shelf_number_csv_template', methods: ['GET'])]
    55	    public function csvTemplate(): StreamedResponse
    56	    {
    57	        return $this->csvTemplateStreamedResponse(
