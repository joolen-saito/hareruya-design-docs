    71	    #[Route(path: '/%eccube_admin_route%/product/product_shelf_number_csv_import', name: 'admin_product_shelf_number_csv_import', methods: ['GET'])]
    72	    public function csv(Request $request): Response
    73	    {
    74	        $form = $this->createForm(CsvImportType::class);
    75	        $form->handleRequest($request);
    76	
    77	        $pagination = $this->getCsvImportHistoryPaginationParams(
