   114	    #[Route(path: '/%eccube_admin_route%/product/product_shelf_number_csv_upload', name: 'admin_product_shelf_number_csv_upload', methods: ['POST'])]
   115	    public function import(Request $request): RedirectResponse
   116	    {
   117	        /** @var Member $Member */
   118	        $Member = $this->getUser();
   119	
   120	        $form = $this->formFactory->createBuilder(CsvImportType::class)->getForm();
   121	        $form->handleRequest($request);
   122	
   123	        if (!$form->isValid()) {
   124	            foreach ($form->getErrors() as $error) {
   125	                $this->addError($error->getMessage(), 'admin');
   126	            }
   127	
   128	            return $this->redirectToRoute('admin_product_shelf_number_csv_import');
   129	        }
   130	        /** @var UploadedFile|null $formFile */
   131	        $formFile = $form['import_file']->getData();
   132	
   133	        if ($formFile === null) {
   134	            $this->addError('admin.common.csv_invalid_format', 'admin');
   135	
   136	            return $this->redirectToRoute('admin_product_shelf_number_csv_import');
   137	        }
   138	
   139	        if ($this->countCsvRows($formFile) >= static::ADMIN_CSV_IMPORT_MAX_ROWS) {
   140	            $this->addError($this->getCsvImportMaxRowsExceededMessage(), 'admin');
   141	
   142	            return $this->redirectToRoute('admin_product_shelf_number_csv_import');
   143	        }
   144	
   145	        log_info('棚番号更新CSV登録開始');
   146	
   147	        $handler = new ProductShelfNumberUpdateImportHandler(
   148	            $this->productClassRepository,
   149	            $this->shelfNumberRepository
   150	        );
   151	        $importer = new CsvImporter(
   152	            $this->entityManager,
   153	            $this->translator,
   154	            $this->eccubeConfig,
   155	            $handler,
   156	            $Member
   157	        );
   158	        $result = $importer->import($formFile);
   159	
   160	        if ($result->hasError()) {
   161	            log_info('棚番号更新CSV登録 異常終了');
   162	            foreach ($result->getErrors() as $error) {
   163	                $this->addError($error['message'], 'admin');
   164	            }
   165	        } else {
   166	            $this->addSuccess('admin.register.complete', 'admin');
   167	            log_info('棚番号更新CSV登録完了', ['count' => $result->getCount()]);
   168	            $this->csvImportHistoryRepository->insertCsvImportHistory(
   169	                MtbCsvImportType::PRODUCT_SHELF_NUMBER_IMPORT_CSV_ID,
   170	                $formFile->getClientOriginalName(),
   171	                $Member->getId()
   172	            );
   173	        }
   174	
   175	        return $this->redirectToRoute('admin_product_shelf_number_csv_import');
   176	    }
