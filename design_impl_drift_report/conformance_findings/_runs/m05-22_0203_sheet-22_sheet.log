   393	    #[Route(path: '/%eccube_admin_route%/standby/{id}/print/delivery/{lang}', name: 'admin_shipping_standby_print_delivery_slips', requirements: ['id' => '\d+', 'lang' => 'ja|en'], methods: ['GET', 'POST'])]
   394	    public function printDeliverySlips(Request $request, int $id, string $lang): Response
   395	    {
   396	        $ShippingStandby = $this->shippingStandbyRepository->findOneById($id);
   397	        if ($ShippingStandby === null) {
   398	            throw $this->createNotFoundException();
   399	        }
   400	
   401	        $orderIdList = array_keys($request->get('order_ids', []));
   402	
   403	        if ($orderIdList === []) {
   404	            throw $this->createNotFoundException();
   405	        }
   406	
   407	        $shippingIdList = [];
   408	        // 印刷対象を絞り込む
   409	        foreach ($ShippingStandby->getOrders() as $Order) {
   410	            $orderId = $Order->getId();
   411	            // 注文IDが無効、または画面でチェックされたIDリストに含まれていない場合はスキップ
   412	            if ($orderId === null || !in_array($orderId, $orderIdList, true)) {
   413	                continue;
   414	            }
   415	            // 対象注文に紐づく配送情報を取得
   416	            foreach ($Order->getShippings() as $Shipping) {
   417	                $shippingId = $Shipping->getId();
   418	                if ($shippingId !== null) {
   419	                    // 配送IDをキーにしてリストに追加
   420	                    $shippingIdList[$shippingId] = $shippingId;
   421	                }
   422	            }
   423	        }
   424	
   425	        if ($shippingIdList === []) {
   426	            throw $this->createNotFoundException();
   427	        }
   428	
   429	        $DeliverySlips = $this->shippingStandbyRepository->generateDeliverySlips($lang !== 'ja', $shippingIdList);
   430	        $BaseInfo = $this->baseInfoRepository->getMallBaseInfo();
   431	
   432	        return $this->render("@admin/ShippingStandby/delivery_slips.{$lang}.twig", [
   433	            'DeliverySlips' => $DeliverySlips,
   434	            'BaseInfo' => $BaseInfo,
   435	        ]);
   436	    }
   437	}

