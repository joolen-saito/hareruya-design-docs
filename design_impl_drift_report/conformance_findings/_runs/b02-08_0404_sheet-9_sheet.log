    47	
    48	    public function upload(string $localPath): bool
    49	    {
    50	        if (!file_exists($localPath)) {
    51	            log_error('SFTPアップロード失敗: ローカルファイルが見つかりません。', ['path' => $localPath]);
    52	
    53	            return false;
    54	        }
    55	
    56	        $remoteFileName = basename($localPath);
    57	        $remotePath = $this->remoteDir.'/'.$remoteFileName;
    58	
    59	        $sftp = $this->createSftp();
    60	        if ($sftp === null) {
    61	            return false;
    62	        }
    63	
    64	        log_info('SFTPアップロード開始', ['local' => $localPath, 'remote' => $remotePath]);
    65	
    66	        if (!$sftp->put($remotePath, $localPath, SFTP::SOURCE_LOCAL_FILE)) {
    67	            log_error('SFTPアップロードに失敗しました。', ['path' => $remotePath, 'errors' => $sftp->getErrors()]);
    68	
    69	            return false;
    70	        }
    71	
    72	        log_info('SFTPアップロード成功', ['path' => $remotePath]);
    73	
    74	        return true;
    75	    }
    76	
    77	    /**
    78	     * @param array<int, string> $prefixes
    79	     */
    80	    public function deleteRemoteByPrefixes(array $prefixes): bool
    81	    {
    82	        $sftp = $this->createSftp();
    83	        if ($sftp === null) {
    84	            return false;
    85	        }
    86	
    87	        $list = $sftp->nlist($this->remoteDir);
    88	        if (!is_array($list)) {
    89	            log_error('SFTPリスト取得に失敗しました。', ['dir' => $this->remoteDir]);
    90	
    91	            return false;
    92	        }
    93	
    94	        foreach ($list as $file) {
    95	            if (!is_string($file) || $file === '.' || $file === '..') {
    96	                continue;
    97	            }
    98	            foreach ($prefixes as $prefix) {
    99	                if (str_starts_with($file, $prefix)) {
   100	                    $path = $this->remoteDir.'/'.$file;
   101	                    if (!$sftp->delete($path)) {
   102	                        log_error('SFTP削除に失敗しました。', ['path' => $path, 'errors' => $sftp->getErrors()]);
   103	
   104	                        return false;
   105	                    } else {
   106	                        log_info('SFTP既存ファイルを削除しました。', ['path' => $path]);
   107	                    }
   108	                    break;
   109	                }
   110	            }
   111	        }
   112	
   113	        return true;
   114	    }
   115	
   116	    private function createSftp(): ?SFTP
   117	    {
   118	        $keyContents = file_get_contents($this->keyPath);
   119	        if ($keyContents === false) {
   120	            log_error('秘密鍵の読み込みに失敗しました。', ['key' => $this->keyPath]);
   121	
   122	            return null;
   123	        }
   124	
   125	        try {
   126	            $privateKey = PublicKeyLoader::load($keyContents);
   127	        } catch (\Throwable $e) {
   128	            log_error('秘密鍵の読み込みに失敗しました。', ['key' => $this->keyPath, 'ex' => $e->getMessage()]);
   129	
   130	            return null;
   131	        }
   132	
   133	        if (!($privateKey instanceof PrivateKey)) {
   134	            log_error('秘密鍵の形式が不正です。', ['key' => $this->keyPath]);
   135	
   136	            return null;
   137	        }
   138	
   139	        $sftp = new SFTP($this->host, $this->port);
   140	        if (!$sftp->login($this->user, $privateKey)) {
   141	            log_error('SFTPログインに失敗しました。', ['host' => $this->host, 'user' => $this->user]);
   142	
   143	            return null;
   144	        }
   145	
   146	        return $sftp;
   147	    }
