   479	    private function compressFile(string $sourcePath, string $compressionType): string
   480	    {
   481	        if ($compressionType !== self::COMPRESS_GZIP) {
   482	            return $sourcePath;
   483	        }
   484	
   485	        $destPath = $sourcePath.'.gz';
   486	        $fpOut = gzopen($destPath, 'wb9');
   487	        if ($fpOut === false) {
   488	            throw new \RuntimeException("GZIPファイルを開けません: {$destPath}");
   489	        }
   490	
   491	        $fpIn = fopen($sourcePath, 'rb');
   492	        if ($fpIn === false) {
   493	            throw new \RuntimeException("ソースファイルを開けません: {$sourcePath}");
   494	        }
   495	
   496	        while (!feof($fpIn)) {
   497	            gzwrite($fpOut, fread($fpIn, 8192));
   498	        }
   499	        fclose($fpIn);
   500	        gzclose($fpOut);
   501	
   502	        log_info('ファイルを圧縮しました。', ['source' => $sourcePath, 'destination' => $destPath]);
   503	
   504	        return $destPath;
   505	    }
