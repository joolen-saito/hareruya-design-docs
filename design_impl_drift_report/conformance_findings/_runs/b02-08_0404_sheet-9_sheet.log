    37	        private readonly EccubeConfig $eccubeConfig,
    38	        private readonly MtbOptionRepository $mtbOptionRepository,
    39	    ) {
    40	        $Option = $this->mtbOptionRepository->findOneBy(['option_key' => MtbOption::UNISEARCH_SFTP_HOST]);
    41	        $this->host = $Option->getOptionValue();
    42	        $this->port = $this->eccubeConfig['eccube_unisearch_sftp_port'];
    43	        $this->user = $this->eccubeConfig['eccube_unisearch_sftp_user'];
    44	        $this->remoteDir = $this->eccubeConfig['eccube_unisearch_sftp_upload_dir'];
