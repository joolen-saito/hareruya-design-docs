   172	    private function exportTsvBySql(string $tsvPath): int
   173	    {
   174	        if ($this->workerCount <= 1) {
   175	            return $this->exportTsvBySqlSequential($tsvPath);
   176	        }
   177	
   178	        return $this->exportTsvBySqlParallel($tsvPath);
   179	    }
   180	
   181	    private function exportTsvBySqlSequential(string $tsvPath): int
   182	    {
   183	        $file = new \SplFileObject($tsvPath, 'w');
   184	        $file->fwrite($this->buildTsvLine($this->normalizeRowToUtf8($this->getHeader())));
   185	
   186	        $count = 0;
   187	        foreach ($this->buildExportRanges() as $range) {
   188	            $count = $this->writeSqlRows(
   189	                $file,
   190	                $this->productClassRepository->iterateUniSearchFeedRows(
   191	                    $range['high_price_only'],
   192	                    $range['min_id'],
   193	                    $range['max_id']
   194	                ),
   195	                $count
   196	            );
   197	        }
   198	
   199	        if ($count === 0) {
   200	            $file->ftruncate(0);
   201	        }
   202	
   203	        return $count;
   204	    }
   205	
   206	    private function exportTsvBySqlParallel(string $tsvPath): int
   207	    {
   208	        $this->filesystem->dumpFile($tsvPath, $this->buildTsvLine($this->normalizeRowToUtf8($this->getHeader())));
   209	
   210	        $ranges = $this->buildExportRanges();
   211	        $partFiles = [];
   212	        $queue = new \SplQueue();
   213	        foreach ($ranges as $index => $range) {
   214	            $partPath = $this->workDir.'feed_part_'.$index.'.tsv';
   215	            $partFiles[$index] = $partPath;
   216	            $queue->enqueue([
   217	                'index' => $index,
   218	                'min_id' => $range['min_id'],
   219	                'max_id' => $range['max_id'],
   220	                'high_price_only' => $range['high_price_only'],
   221	                'part_path' => $partPath,
   222	            ]);
   223	        }
   224	
   225	        $running = [];
   226	        $counts = [];
   227	        try {
   228	            while (!$queue->isEmpty() || $running !== []) {
   229	                while (count($running) < $this->workerCount && !$queue->isEmpty()) {
   230	                    $task = $queue->dequeue();
   231	                    $process = $this->createExportChunkProcess($task);
   232	                    $process->start();
   233	                    $running[] = ['process' => $process, 'task' => $task];
   234	                }
   235	
   236	                foreach ($running as $key => $job) {
   237	                    /** @var Process $process */
   238	                    $process = $job['process'];
   239	                    if ($process->isRunning()) {
   240	                        continue;
   241	                    }
   242	
   243	                    $task = $job['task'];
   244	                    if (!$process->isSuccessful()) {
   245	                        throw new \RuntimeException(sprintf('Unisearch chunk export failed. index=%d error=%s', $task['index'], trim($process->getErrorOutput())));
   246	                    }
   247	
   248	                    $output = trim($process->getOutput());
   249	                    if ($output === '' || !is_numeric($output)) {
   250	                        throw new \RuntimeException(sprintf('Unisearch chunk export returned invalid count. index=%d output="%s"', $task['index'], $output));
   251	                    }
   252	
   253	                    $counts[$task['index']] = (int) $output;
   254	                    unset($running[$key]);
   255	                }
   256	
   257	                if ($running !== []) {
   258	                    usleep(100000);
   259	                }
   260	            }

