   509	     *
   510	     * @return array<int|string, mixed>
   511	     */
   512	    private function normalizeRowToUtf8(array $row): array
   513	    {
   514	        return array_map(static function ($v) {
   515	            if (is_string($v)) {
   516	                $enc = mb_detect_encoding(
   517	                    $v,
   518	                    ['UTF-8', 'SJIS-win', 'SJIS', 'EUC-JP', 'JIS', 'ISO-2022-JP', 'ASCII'],
   519	                    true
   520	                );
   521	                if ($enc && $enc !== 'UTF-8') {
   522	                    return mb_convert_encoding($v, 'UTF-8', $enc);
   523	                }
   524	            }
   525	
   526	            return $v;
   527	        }, $row);
   528	    }
