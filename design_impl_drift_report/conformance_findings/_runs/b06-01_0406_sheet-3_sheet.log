    36	#[AsCommand(name: 'eccube:buy-order:auto-stock', description: '買取自動入庫バッチ')]
    37	class BuyOrderAutoStockCommand extends Command
    38	{
    39	    public function __construct(
    40	        private readonly OtcBatchAutoStockAction $otcBatchAutoStockAction,
    41	        private readonly NetBatchAutoStockAction $netBatchAutoStockAction,
