    55	            $io->error('入庫処理でエラーが発生しました: '.$e->getMessage());
    56	
    57	            return Command::FAILURE;
    58	        }
    59	
    60	        $io->success('買取自動入庫が完了しました。');
    61	
    62	        return Command::SUCCESS;
    63	    }
    64	}

