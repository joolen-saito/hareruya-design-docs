    16	namespace Eccube\Service\Admin\Order;
    17	
    18	use Doctrine\ORM\EntityManagerInterface;
    19	use Eccube\Entity\DtbWaitingNumberCounter;
    20	use Eccube\Repository\BaseInfoRepository;
    21	use Eccube\Repository\DtbWaitingNumberCounterRepository;
    22	use Eccube\Repository\DtbWaitingNumberRepository;
    23	
    24	class TruncateWaitingNumberAction
    25	{
    26	    public function __construct(
    27	        private readonly DtbWaitingNumberRepository $waitingNumberRepository,
    28	        private readonly DtbWaitingNumberCounterRepository $waitingNumberCounterRepository,
    29	        private readonly BaseInfoRepository $baseInfoRepository,
    30	        private readonly EntityManagerInterface $entityManager,
    31	    ) {
    32	    }
    33	
    34	    public function handle(): void
    35	    {
    36	        $this->entityManager->beginTransaction();
    37	
    38	        try {
    39	            // 店舗販売用整理番号を物理削除
    40	            $this->waitingNumberRepository->truncateWaitingNumber();
    41	            $this->waitingNumberCounterRepository->truncateWaitingNumberCounter();
    42	
    43	            // 店舗販売用整理番号カウンタを初期化
    44	            $BaseInfos = $this->baseInfoRepository->findAll();
    45	            foreach ($BaseInfos as $BaseInfo) {
    46	                $WaitingNumberCounter = (new DtbWaitingNumberCounter())
    47	                    ->setBaseInfo($BaseInfo)
    48	                    ->setCurrentValue(0);
    49	                $this->entityManager->persist($WaitingNumberCounter);
    50	            }
    51	
    52	            $this->entityManager->flush();
    53	            $this->entityManager->commit();
    54	        } catch (\Throwable $e) {
    55	            $this->entityManager->rollback();
    56	
    57	            throw $e;
    58	        }
    59	    }
    60	}

