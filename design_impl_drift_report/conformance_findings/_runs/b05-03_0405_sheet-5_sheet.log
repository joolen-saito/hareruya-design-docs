    22	
    23	/**
    24	 * @extends AbstractRepository<DtbWaitingNumberCounter>
    25	 */
    26	class DtbWaitingNumberCounterRepository extends AbstractRepository
    27	{
    28	    public function __construct(ManagerRegistry $registry)
    29	    {
    30	        parent::__construct($registry, DtbWaitingNumberCounter::class);
    31	    }
    32	
    33	    /**
    34	     * 店別の店舗販売用整理番号番号を発番する
    35	     *
    36	     * 本メソッド内では追加のアプリケーション排他は行わない。
    37	     * （PostgreSQLのON CONFLICTによるアトミックな排他制御のみを利用）
    38	     *
    39	     * @param BaseInfo $BaseInfo
    40	     *
    41	     * @return int
    42	     */
    43	    public function nextValue(BaseInfo $BaseInfo): int
    44	    {
    45	        $connection = $this->getEntityManager()->getConnection();
    46	
    47	        $sql = <<<'SQL'
    48	INSERT INTO dtb_waiting_number_counter (base_info_id, current_value)
    49	VALUES (:base_info_id, 1)
    50	ON CONFLICT (base_info_id)
    51	DO UPDATE SET current_value = dtb_waiting_number_counter.current_value + 1
    52	RETURNING current_value
    53	SQL;
    54	
    55	        $nextValue = $connection->fetchOne(
    56	            $sql,
    57	            ['base_info_id' => $BaseInfo->getId()],
    58	            ['base_info_id' => ParameterType::INTEGER]
    59	        );
    60	
    61	        return (int) $nextValue;
    62	    }
    63	
    64	    /**
    65	     * 店舗販売用整理番号カウンタを初期化
    66	     *
    67	     * @return void
    68	     */
    69	    public function truncateWaitingNumberCounter(): void
    70	    {
    71	        $connection = $this->getEntityManager()->getConnection();
    72	        $connection->executeStatement('TRUNCATE TABLE dtb_waiting_number_counter');
    73	    }
    74	}

