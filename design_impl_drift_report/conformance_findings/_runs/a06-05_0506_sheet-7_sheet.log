    26	class UpdateStatusAction
    27	{
    28	    public function __construct(
    29	        private readonly EntityManagerInterface $entityManager,
    30	        private readonly LoggerInterface $logger,
    31	        private readonly OtcBuyOrderEntityManager $otcBuyOrderEntityManager,
    32	    ) {
    33	    }
    34	
    35	    private const FROM_STATUS_TO_ALLOWED_STATUSES = [
    36	        // 査定前 -> 査定中, 査定中断, 査定再開
    37	        MtbOtcBuyOrderStatus::STATUS_ASSESSMENT_PENDING => [
    38	            MtbOtcBuyOrderStatus::STATUS_ASSESSMENT_IN_PROGRESS,
    39	            MtbOtcBuyOrderStatus::STATUS_ASSESSMENT_PAUSED,
    40	            MtbOtcBuyOrderStatus::STATUS_ASSESSMENT_RESUMED,
    41	        ],
    42	        // 査定中 -> 査定中断, 査定再開
    43	        MtbOtcBuyOrderStatus::STATUS_ASSESSMENT_IN_PROGRESS => [
    44	            MtbOtcBuyOrderStatus::STATUS_ASSESSMENT_PAUSED,
    45	            MtbOtcBuyOrderStatus::STATUS_ASSESSMENT_RESUMED,
    46	        ],
    47	        // 査定中断 -> 査定中, 査定再開
    48	        MtbOtcBuyOrderStatus::STATUS_ASSESSMENT_PAUSED => [
    49	            MtbOtcBuyOrderStatus::STATUS_ASSESSMENT_IN_PROGRESS,
    50	            MtbOtcBuyOrderStatus::STATUS_ASSESSMENT_RESUMED,
    51	        ],
    52	        // 査定再開 -> 査定中, 査定中断
    53	        MtbOtcBuyOrderStatus::STATUS_ASSESSMENT_RESUMED => [
    54	            MtbOtcBuyOrderStatus::STATUS_ASSESSMENT_IN_PROGRESS,
    55	            MtbOtcBuyOrderStatus::STATUS_ASSESSMENT_PAUSED,
    56	        ],
    57	    ];
    58	
    59	    /**
    60	     * ステータスを更新する
    61	     * 更新前ステータス [5: 査定前, 6: 査定中, 8: 査定中断, 9: 査定再開]
    62	     * 更新後ステータス [6: 査定中, 8: 査定中断, 9: 査定再開]
    63	     * ただし、査定中 -> 査定再開のステータス更新ができるのは OtcBuyOrderの更新者(Member)のみ
    64	     */
    65	    public function handle(UpdateStatusInput $input): void
    66	    {
    67	        $CurrentStatus = $input->OtcBuyOrder->getOtcBuyOrderStatus();
    68	        if (!$CurrentStatus) {
    69	            throw new InvalidStatusTransitionException('不正なステータス遷移です');
    70	        }
    71	
    72	        $currentStatusId = $CurrentStatus->getId();
    73	        $nextStatusId = $input->NextStatus->getId();
    74	
    75	        if ($currentStatusId === $nextStatusId) {
    76	            return;
    77	        }
    78	
    79	        // 査定終了後のステータスは変更不可 (直後のロジックと重複しているが移行前のコードを踏襲)
    80	        if ($CurrentStatus->isAssessmentCompleted()) {
    81	            $message = $input->NextStatus->isAssessmentActive()
    82	                ? 'この査定はすでに終了しているため開くことができません。'
    83	                : 'この査定はすでに終了しているためステータスの更新に失敗しました。';
    84	
    85	            throw new InvalidStatusTransitionException($message);
    86	        }
    87	
    88	        if (
    89	            !isset(self::FROM_STATUS_TO_ALLOWED_STATUSES[$currentStatusId])
    90	            || !in_array($nextStatusId, self::FROM_STATUS_TO_ALLOWED_STATUSES[$currentStatusId], true)
    91	        ) {
    92	            throw new InvalidStatusTransitionException('不正なステータス遷移です');
    93	        }
    94	
    95	        // 査定中 -> 査定再開のステータス更新ができるのは 直近の更新者(Member)のみ (一部ロジックが重複しているが移行前のコードを踏襲)
    96	        if (
    97	            $CurrentStatus->isAssessmentActive()
    98	            && $input->NextStatus->isAssessmentActive()
    99	            && $input->Member !== $input->OtcBuyOrder->getMember()
   100	        ) {
   101	            throw new InvalidStatusTransitionException("この受注は{$input->OtcBuyOrder->getMember()->getName()}が査定中です");
   102	        }
   103	
   104	        $currentTime = new \DateTime();
   105	
   106	        $this->entityManager->beginTransaction();
   107	        try {
   108	            $input->OtcBuyOrder
   109	                ->setMember($input->Member)
   110	                ->setUpdateDate($currentTime);
   111	
   112	            $this->otcBuyOrderEntityManager->updateStatusWithHistory($input->OtcBuyOrder, $input->NextStatus, $input->Member, $currentTime);
   113	            $this->entityManager->flush();
   114	            $this->entityManager->commit();
   115	        } catch (\Throwable $e) {
   116	            $this->entityManager->rollback();
   117	            $this->logger->error('Failed to update status', ['exception' => $e, 'otcBuyOrderId' => $input->OtcBuyOrder->getId(), 'currentStatusId' => $currentStatusId, 'nextStatusId' => $nextStatusId, 'memberId' => $input->Member->getId()]);
   118	            throw new InternalException('システムエラーが発生しました', $e);
   119	        }
   120	    }
   121	}

