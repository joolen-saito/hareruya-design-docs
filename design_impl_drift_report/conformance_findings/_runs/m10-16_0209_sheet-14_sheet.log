    64	    #[Route('/%eccube_admin_route%/setting/shop/additional_system/update', name: 'admin_setting_shop_additional_system_update', methods: ['POST'])]
    65	    #[Template('@admin/Setting/Shop/additional_system.twig')]
    66	    public function update(Request $request): RedirectResponse|array
    67	    {
    68	        /** @var MtbOption[] $options */
    69	        $options = $this->optionRepository->findAll();
    70	        $settings = array_reduce($options, function (array $carray, MtbOption $Option): array {
