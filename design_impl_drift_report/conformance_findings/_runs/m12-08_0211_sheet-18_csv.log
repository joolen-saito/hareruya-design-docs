    27	
    28	class FormatSalesType extends AbstractType
    29	{
    30	    /**
    31	     * month（年月）・mail_order_enabled・store_enabled フィールドを追加し、
    32	     * 通販・店舗のいずれか1つ以上が必須となるバリデーションを設定する。
    33	     *
    34	     * @param FormBuilderInterface $builder
    35	     * @param array<string, mixed> $options
    36	     */
    37	    public function buildForm(FormBuilderInterface $builder, array $options): void
    38	    {
    39	        $builder
    40	            ->add('month', TextType::class, [
    41	                'required' => true,
    42	                'attr' => [],
    43	                'constraints' => [
    44	                    new Assert\NotBlank(),
    45	                    new Assert\Regex(['pattern' => '/^\d{4}-(0[1-9]|1[0-2])$/']),
    46	                ],
    47	            ])
    48	            ->add('mail_order_enabled', CheckboxType::class, [
    49	                'required' => false,
    50	                'label' => '通販',
    51	            ])
    52	            ->add('store_enabled', CheckboxType::class, [
    53	                'required' => false,
    54	                'label' => '全店舗',
    55	            ]);
    56	
    57	        // 通販・店舗のどちらか1つ以上必須
    58	        $builder->addEventListener(FormEvents::POST_SUBMIT, function (FormEvent $event): void {
    59	            $form = $event->getForm();
    60	            if (!$form->isValid()) {
    61	                return;
    62	            }
    63	            $mailOrder = (bool) $form->get('mail_order_enabled')->getData();
    64	            $store = (bool) $form->get('store_enabled')->getData();
    65	            if (!$mailOrder && !$store) {
    66	                $form->get('mail_order_enabled')->addError(
    67	                    new FormError('集計対象(通販)・集計対象(店舗)のいずれか1つ以上を選択してください')
    68	                );
    69	            }
    70	        });
    71	    }
    72	
    73	    /**
    74	     * @param OptionsResolver $resolver
    75	     */
    76	    public function configureOptions(OptionsResolver $resolver): void
    77	    {
