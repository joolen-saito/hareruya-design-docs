    50	    #[Route(path: '/api/product/detail/{productId}', name: 'product_detail_by_product_id', requirements: ['productId' => '\\d+'], methods: ['GET'])]
    51	    #[Route(path: '/api/product/detail/{productId}.json', name: 'product_detail_by_product_id_json', requirements: ['productId' => '\\d+'], methods: ['GET'])]
    52	    public function getProductDetailByProductId(Request $request, int $productId): JsonResponse
    53	    {
    54	        $languageCode = $request->query->get('lang', 'JP');
    55	        if (empty($languageCode)) {
    56	            $languageCode = 'JP';
    57	        }
    58	
    59	        $products = $this->productRepository->findProductById($productId, $languageCode);
    60	        if (empty($products)) {
    61	            log_warning('商品が見つかりません', [
    62	                'request_url' => $request->getUri(),
    63	            ]);
    64	            throw new NotFoundException('Not Found');
    65	        }
    66	
    67	        try {
    68	            $response = $this->productDetailResponseBuilder->build($products, $languageCode);
    69	
    70	            return $this->json($response, Response::HTTP_OK);
    71	        } catch (\Throwable $e) {
    72	            log_error('商品詳細取得処理中にエラーが発生しました', [
    73	                'error' => $e->getMessage(),
    74	                'request_url' => $request->getUri(),
    75	            ]);
    76	
    77	            throw new InternalException('商品詳細の取得に失敗しました', $e);
    78	        }
    79	    }
