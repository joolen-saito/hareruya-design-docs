  2033	    public function findPopupProductByProductId(int $productId, string $languageCode): ?array
  2034	    {
  2035	        // 現行 pf-api の LANG_RANK に合わせた画像ランク優先度（ja→2, en→1）
  2036	        $langRank = $languageCode === 'EN' ? 1 : 2;
