  2042	    p.name_en AS nameEn,
  2043	    pc.id AS productClassId,
  2044	    pc.price01 AS price01,
  2045	    pc.price02 AS price02,
  2046	    pc.stock AS stock,
  2047	    COALESCE(lang.code, :languageCode) AS languageCode,
  2048	    CASE WHEN pc.memo IS NOT NULL AND pc.memo != '' THEN pc.memo ELSE cc.code END AS conditionCode,
  2049	    cd.foil_flg AS foilFlg,
  2050	    pimg.file_name AS imageFileName,
  2051	    (SELECT COALESCE(SUM(pc2.order_quantity_04), 0)
  2052	     FROM dtb_product_class pc2
  2053	     LEFT JOIN mtb_language lang2 ON pc2.language_id = lang2.id
  2054	     WHERE pc2.product_id = p.id
  2055	       AND pc2.visible = true
  2056	       AND lang2.code = :languageCode) AS weeklySold
  2057	FROM dtb_product p
  2058	    INNER JOIN dtb_product_class pc ON p.id = pc.product_id AND pc.visible = true AND pc.price02 > 0
  2059	    LEFT JOIN mtb_language lang ON pc.language_id = lang.id
  2060	    LEFT JOIN mtb_card_condition cc ON pc.card_condition_id = cc.id
  2061	    LEFT JOIN dtb_product_class_image pci ON pci.product_class_id = pc.id
  2062	    LEFT JOIN dtb_product_image pimg ON pci.product_image_id = pimg.id
  2063	    INNER JOIN mtb_card_detail cd ON p.card_detail_id = cd.id
  2064	WHERE p.id = :productId
  2065	  AND p.product_status_id = :statusId
  2066	ORDER BY
  2067	    CASE WHEN pc.stock > 0 THEN 1 ELSE 2 END ASC,
  2068	    CASE WHEN lang.code = :languageCode THEN 1 ELSE 2 END ASC,
  2069	    pc.card_condition_id ASC NULLS LAST,
  2070	    CASE WHEN pci.rank = :langRank THEN 1 ELSE 2 END ASC,
  2071	    pci.rank ASC NULLS LAST,
  2072	    pc.id ASC
  2073	LIMIT 1
  2074	SQL;
