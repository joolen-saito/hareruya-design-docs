    53	    #[Route(path: '/events/{detailId}/entry', name: 'event_entry', requirements: ['detailId' => '\d+'], methods: ['GET'])]
    54	    public function entry(int $detailId): Response
    55	    {
    56	        $Customer = $this->getAuthenticatedCustomer();
    57	        if ($Customer === null) {
    58	            return $this->redirectToRoute('mypage_login');
    59	        }
    60	
    61	        $Detail = $this->eventDetailRepository->findForFront($detailId);
    62	        if ($Detail === null) {
    63	            throw new NotFoundHttpException();
    64	        }
    65	        $Player = $Customer->getPlayer();
    66	        if ($Player === null) {
    67	            return $this->redirectToRoute('event_detail', ['detailId' => $detailId]);
    68	        }
    69	
    70	        if (!$this->canEntry($Detail) || $this->eventEntryRepository->hasActiveEntryByCustomerAndDetail($Customer, $detailId)) {
    71	            return $this->redirectToRoute('event_detail', ['detailId' => $detailId]);
    72	        }
    73	
    74	        $Event = $Detail->getEvent();
    75	        $others = $this->eventDetailRepository->getOtherDetailsThatCanBeJoin($Event->getId(), $detailId, $Player->getId());
    76	        $otherIds = array_map(static fn (DtbEventDetail $Other): int => $Other->getId(), $others);
    77	        $otherActiveCounts = $this->eventEntryRepository->countActiveEntriesByDetailIds($otherIds);
    78	        $joinableOthers = array_values(array_filter(
    79	            $others,
    80	            fn (DtbEventDetail $Other): bool => $Other->canBeEntried($otherActiveCounts[$Other->getId()] ?? 0),
    81	        ));
    82	
    83	        $hasChargeableOption = ($Detail->getEntryFee() ?? 0) > 0;
    84	        foreach ($joinableOthers as $Other) {
    85	            if (($Other->getEntryFee() ?? 0) > 0) {
    86	                $hasChargeableOption = true;
    87	                break;
    88	            }
    89	        }
    90	
    91	        return $this->render('Event/entry.twig', [
    92	            'Event' => $Event,
    93	            'Detail' => $Detail,
    94	            'others' => $joinableOthers,
    95	            'payments' => $Event->getPayments()->getValues(),
    96	            'hasChargeableOption' => $hasChargeableOption,
    97	        ]);
    98	    }
