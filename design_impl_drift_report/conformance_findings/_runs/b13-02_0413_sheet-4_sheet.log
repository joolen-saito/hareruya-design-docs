    25	class DtbEntryHistoryRepository extends AbstractRepository
    26	{
    27	    public function __construct(ManagerRegistry $registry)
    28	    {
    29	        parent::__construct($registry, DtbEntryHistory::class);
    30	    }
    31	
    32	    /**
    33	     * 申込情報をもとに履歴登録（直近履歴と申込ステータスが同一ならスキップ）
    34	     *
    35	     * @param DtbEventEntry|list<DtbEventEntry> $eventEntries
    36	     */
    37	    public function createEntryHistory(DtbEventEntry|array $eventEntries, ?int $memberId = null): void
    38	    {
    39	        $entries = is_array($eventEntries) ? $eventEntries : [$eventEntries];
    40	        $entityManager = $this->getEntityManager();
    41	
    42	        foreach ($entries as $eventEntry) {
    43	            $history = $this->findOneBy(['EventEntry' => $eventEntry], ['id' => 'DESC']);
    44	            if ($history !== null && $history->getEntryStatus()->getId() === $eventEntry->getEntryStatus()->getId()) {
    45	                continue;
    46	            }
    47	
    48	            $entryHistory = new DtbEntryHistory($eventEntry);
    49	            $entryHistory->setMemberId($memberId);
    50	            $entryHistory->setCreateDate(new \DateTime());
    51	            $entityManager->persist($entryHistory);
    52	        }
    53	    }
    54	}

