   229	     */
   230	    public function getPassedLimitEntry(int $limitMinute, array $payments = [], int $entryStatusId = ES::PROCESSING_PAYMENT): mixed
   231	    {
   232	        $time = new \DateTime();
   233	        // dtb_event_entry
   234	        $qb = $this->createQueryBuilder('ee');
   235	        $qb->where($qb->expr()->eq('IDENTITY(ee.EntryStatus)', ':entryStatusId'))
   236	            ->andWhere($qb->expr()->lte('ee.updateDate', ':limitTime'))
   237	            ->andWhere('ee.paymentNo IS NOT NULL')
   238	            ->orderBy('ee.paymentNo');
   239	
   240	        $paramters = [
   241	            'entryStatusId' => $entryStatusId,
   242	            'limitTime' => $time->modify("-{$limitMinute} minute"),
   243	        ];
   244	
   245	        if (count($payments) > 0) {
   246	            $qb->andWhere($qb->expr()->in('IDENTITY(ee.Payment)', ':payments'));
   247	            $paramters['payments'] = $payments;
   248	        }
   249	        $query = $qb
   250	            ->setParameters(new ArrayCollection($paramters))
   251	            ->getQuery();
   252	
   253	        return $query->execute();
   254	    }
