   213	    public function getResultByEntryDetail(int $id): mixed
   214	    {
   215	        // dtb_event_entry
   216	        $qb = $this->createQueryBuilder('ee')
   217	            ->select('ee.id as eventEntryId', 'IDENTITY(ee.Payment)', 'IDENTITY(ee.EntryStatus)', 'ed.startDate')
   218	            ->join(DtbEventDetail::class, 'ed', Join::WITH, 'ee.EventDetail = ed')
   219	            ->andWhere('ee.id = :eventEntryId')
   220	            ->setParameter('eventEntryId', $id);
