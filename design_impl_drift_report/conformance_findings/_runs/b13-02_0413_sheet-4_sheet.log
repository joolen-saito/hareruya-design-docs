   267	            ->andWhere($qb->expr()->lte('ee.createDate', ':beforeTime'))
   268	            ->andWhere('ee.paymentNo IS NOT NULL')
   269	            ->andWhere('ee.deletedAt IS NULL')
   270	            ->setParameter('entryStatusId', $entryStatusId)
