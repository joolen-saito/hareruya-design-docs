   189	    /**
   190	     * イベント申込管理　イベント申込一覧
   191	     * 検索条件に該当するデータを取得
   192	     */
   193	    public function getEntryCount(int $id): mixed
   194	    {
   195	        // dtb_event_entry
   196	        $qb = $this->createQueryBuilder('ee')
   197	            ->select('count(ee.id) as entry', 'ed.id as event_detail_id')
   198	            ->join('ee.EventDetail', 'ed')
   199	            ->join('ed.Event', 'e')
   200	            ->andWhere('IDENTITY(ee.EntryStatus) = :entryStatusId')
   201	            ->andWhere('e.id = :eventId')
   202	            ->setParameter('eventId', $id)
   203	            ->setParameter('entryStatusId', ES::ENTERED)
   204	            ->groupBy('ed.id');
   205	
   206	        return $qb->getQuery()->getResult();
   207	    }
   208	
   209	    /**
