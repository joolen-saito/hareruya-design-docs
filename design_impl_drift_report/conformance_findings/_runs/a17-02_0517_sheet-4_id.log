    38	    /**
    39	     * WordPressの投稿IDを検索条件として、記事情報を1件取得して返却するAPIエンドポイント
    40	     *
    41	     * @param Request $request
    42	     *
    43	     * @return JsonResponse
    44	     */
    45	    #[Route('/article.json', name: 'article_by_params', methods: ['GET'])]
    46	    public function getSingleArticleByParamsAction(Request $request): JsonResponse
    47	    {
    48	        try {
    49	            $wpPostIdParam = $request->query->get('wpPostId');
    50	            if ($wpPostIdParam === null || $wpPostIdParam === '') {
    51	                throw new MissingRequiredParameterException('wpPostIdは必須です');
    52	            }
    53	
    54	            if (!is_numeric($wpPostIdParam) || (int) $wpPostIdParam != $wpPostIdParam || (int) $wpPostIdParam < 1) {
    55	                throw new InvalidParameterException('wpPostIdは正の整数である必要があります');
    56	            }
    57	
    58	            $Article = $this->dtbArticleRepository->findOneBy(['wpPostId' => (int) $wpPostIdParam]);
    59	            if ($Article === null) {
    60	                throw new NotFoundException('記事が見つかりません');
    61	            }
    62	
    63	            return $this->json($this->articleResponseBuilder->build($Article));
    64	        } catch (BaseApiException $e) {
    65	            // APIルートが/%eccube_api_v1_route%/ではなく、ExceptionListenerのエラーハンドリングが動作しないため、直接JSONを返す
    66	            return $this->json([
    67	                'code' => $e->getStatusCode(),
    68	                'errors' => $e->getErrors(),
    69	            ], $e->getStatusCode());
    70	        }
    71	    }
    72	
    73	    /**
    74	     * 指定された記事IDを基準として、関連する記事のリストを取得して返却するAPIエンドポイント
    75	     *
    76	     * @param string $id 基準記事のWordPress投稿ID
    77	     * @param Request $request
    78	     *
    79	     * @return JsonResponse
    80	     */
    81	    #[Route('/article/related/{id}', name: 'article_related', methods: ['GET'])]
    82	    public function getRelatedArticlesAction(string $id, Request $request): JsonResponse
    83	    {
    84	        try {
    85	            if (!preg_match('/^\d+$/', $id) || (int) $id < 1) {
    86	                throw new InvalidParameterException('idは正の整数である必要があります');
    87	            }
    88	
    89	            $limitParam = $request->query->get('limit', '');
    90	            $limit = $this->eccubeConfig->get('eccube_article_related_api_default_limit');
    91	            if ($limitParam !== '') {
    92	                if (!is_numeric($limitParam) || (int) $limitParam != $limitParam || (int) $limitParam < 1) {
    93	                    throw new InvalidParameterException('limitは正の整数である必要があります');
    94	                }
    95	                $limit = (int) $limitParam;
    96	            }
    97	
    98	            $relatedArticles = $this->dtbArticleRepository->getRelatedArticles((int) $id, $limit);
    99	
   100	            if (empty($relatedArticles)) {
   101	                throw new NotFoundException('関連記事が見つかりません');
   102	            }
   103	
   104	            return new JsonResponse($relatedArticles, 200);
   105	        } catch (BaseApiException $e) {
   106	            throw $e;
   107	        } catch (\Throwable $e) {
   108	            throw new InternalException('システムエラーが発生しました', $e);
   109	        }
   110	    }
   111	}

