    22	
    23	class SalesAnalysisCsvExporterService
    24	{
    25	    public function __construct(
    26	        protected CsvExportService $csvExportService,
    27	        protected OrderItemRepository $orderItemRepository,
    28	        protected TranslatorInterface $translator,
    29	    ) {
    30	    }
    31	
    32	    /**
    33	     * @param array<string, mixed> $searchData
    34	     */
    35	    public function exportBySearchData(array $searchData): StreamedResponse
    36	    {
    37	        $isProduct = ($searchData['summary_type'] ?? null) !== 'class_category_name';
    38	        $rows = $this->orderItemRepository->getAnalysisSummary($searchData)['result'];
    39	        $header = $isProduct ? $this->buildProductHeader() : $this->buildCategoryHeader();
    40	
    41	        $response = new StreamedResponse(function () use ($rows, $isProduct, $header): void {
    42	            $this->csvExportService->fopen();
    43	            $this->csvExportService->fputcsv($header);
    44	
    45	            foreach ($rows as $row) {
    46	                $line = $isProduct ? [(string) ($row['code'] ?? '')] : [];
    47	                $line[] = (string) ($row['name'] ?? '');
    48	                $line[] = (string) ((int) ($row['price'] ?? 0));
    49	                $line[] = (string) ((int) ($row['sales'] ?? 0));
    50	                $line[] = (string) ((int) ($row['total'] ?? 0));
    51	                $line[] = (string) ((int) ($row['order_count'] ?? 0));
    52	                $this->csvExportService->fputcsv($line);
    53	            }
    54	
    55	            $this->csvExportService->fclose();
    56	        });
    57	
    58	        $filename = 'sales_report_'.(new \DateTime())->format('YmdHis').'.csv';
    59	        $response->headers->set('Content-Type', 'application/octet-stream');
    60	        $response->headers->set('Content-Disposition', 'attachment; filename='.$filename);
    61	
    62	        return $response;
    63	    }
    64	
    65	    /**
    66	     * @return array<int, string>
    67	     */
    68	    private function buildProductHeader(): array
    69	    {
    70	        return [
    71	            $this->translator->trans('admin.analysis.sales.result.product_code'),
    72	            $this->translator->trans('admin.analysis.sales.result.product_name'),
    73	            $this->translator->trans('admin.analysis.sales.result.avg_price'),
    74	            $this->translator->trans('admin.analysis.sales.result.quantity'),
    75	            $this->translator->trans('admin.analysis.sales.result.total'),
    76	            $this->translator->trans('admin.analysis.sales.result.count'),
    77	        ];
    78	    }
    79	
    80	    /**
    81	     * @return array<int, string>
    82	     */
    83	    private function buildCategoryHeader(): array
    84	    {
    85	        return [
    86	            $this->translator->trans('admin.analysis.sales.result.category'),
    87	            $this->translator->trans('admin.analysis.sales.result.avg_price'),
    88	            $this->translator->trans('admin.analysis.sales.result.quantity'),
    89	            $this->translator->trans('admin.analysis.sales.result.total'),
    90	            $this->translator->trans('admin.analysis.sales.result.count'),
    91	        ];
    92	    }
    93	}

