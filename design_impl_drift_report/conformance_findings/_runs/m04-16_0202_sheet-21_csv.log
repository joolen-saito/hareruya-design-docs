from html.parser import HTMLParser
from pathlib import Path
class P(HTMLParser):
    def __init__(self):
        super().__init__(); self.in_target=False; self.current=None; self.rows=[]; self.text=[]; self.line=0
    def handle_starttag(self, tag, attrs):
        attrs=dict(attrs)
        if tag=='section' and attrs.get('id') in ('sheet-21','sheet-53'):
            self.in_target=True; self.current=attrs.get('id')
        elif tag=='section' and attrs.get('id','').startswith('sheet-') and self.in_target:
            self.in_target=False; self.current=None
    def handle_data(self, data):
        if self.in_target:
            s=' '.join(data.split())
            if s:
                self.text.append((self.getpos()[0], self.current, s))
html=Path('excel_to_html/output/0202_基本設計仕様書(在庫管理機能).html').read_text(errors='ignore')
p=P(); p.feed(html)
for ln, sheet, s in p.text:
