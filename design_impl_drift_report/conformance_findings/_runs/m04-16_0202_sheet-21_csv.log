   362	        if ($input->sellPriceFrom !== null) {
   363	            $conditions[] = 'pc.price02 >= :sellPriceFrom';
   364	            $params['sellPriceFrom'] = $input->sellPriceFrom;
   365	        }
   366	        if ($input->sellPriceTo !== null) {
   367	            $conditions[] = 'pc.price02 <= :sellPriceTo';
   368	            $params['sellPriceTo'] = $input->sellPriceTo;
   369	        }
   370	
   371	        if (
   372	            $input->orderDate !== null
   373	            && in_array((string) $input->orderDate, DtbStockUpQuantity::ORDER_QUANTITY_COLUMN_NUMBERS, true)
   374	        ) {
   375	            $col = sprintf('pc.order_quantity_%02d', $input->orderDate);
   376	            if ($input->orderQuantityFrom !== null) {
   377	                $conditions[] = $col.' >= :orderQuantityFrom';
   378	                $params['orderQuantityFrom'] = $input->orderQuantityFrom;
   379	            }
   380	            if ($input->orderQuantityTo !== null) {
   381	                $conditions[] = $col.' <= :orderQuantityTo';
   382	                $params['orderQuantityTo'] = $input->orderQuantityTo;
   383	            }
   384	        }
   385	
   386	        if ($input->stockFrom !== null) {
   387	            $conditions[] = 'ps.stock >= :stockFrom';
   388	            $params['stockFrom'] = $input->stockFrom;
   389	        }
   390	        if ($input->stockTo !== null) {
   391	            $conditions[] = 'ps.stock <= :stockTo';
   392	            $params['stockTo'] = $input->stockTo;
   393	        }
   394	
   395	        if ($input->languages !== []) {
   396	            $hasJp = in_array(MtbLanguage::JP_ID, $input->languages, true);
   397	            $hasEn = in_array(MtbLanguage::EN_ID, $input->languages, true);
   398	            $hasOther = in_array(MtbLanguage::NOT_JP_EN_LANG_ID, $input->languages, true);
   399	
   400	            $langConds = [];
   401	            if ($hasJp) {
   402	                $langConds[] = 'pc.language_id = '.MtbLanguage::JP_ID;
   403	            }
   404	            if ($hasEn) {
   405	                $langConds[] = 'pc.language_id = '.MtbLanguage::EN_ID;
   406	            }
   407	            if ($hasOther) {
   408	                $langConds[] = '(pc.language_id IS NOT NULL AND pc.language_id NOT IN (:constantLangIds))';
   409	                $params['constantLangIds'] = MtbLanguage::CONSTANT_LANG_IDS;
   410	                $paramTypes['constantLangIds'] = ArrayParameterType::INTEGER;
   411	            }
   412	            if ($langConds !== []) {
   413	                $conditions[] = '('.implode(' OR ', $langConds).')';
   414	            }
   415	        }
   416	
   417	        $whereSql = $conditions !== [] ? 'WHERE '.implode(' AND ', $conditions) : '';
   418	
   419	        return [$whereSql, $params, $paramTypes];
   420	    }
   421	
   422	    private function escapeLike(string $value): string
   423	    {
   424	        $e = self::ESCAPE_CHAR;
   425	        $escaped = str_replace($e, $e.$e, $value);
   426	        $escaped = str_replace('%', $e.'%', $escaped);
   427	        $escaped = str_replace('_', $e.'_', $escaped);
   428	
   429	        return '%'.$escaped.'%';
   430	    }

