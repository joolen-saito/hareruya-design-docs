   103	    /**
   104	     * @return \Traversable<int, array<string, mixed>>
   105	     */
   106	    private function fetchRows(StockListSearchInput $input): \Traversable
   107	    {
   108	        $isAllStore = $input->baseInfos === [];
   109	
   110	        [$whereSql, $params, $paramTypes] = $this->buildWhere($input);
   111	
   112	        $cardNameJoin = '';
   113	        if ($input->cardName !== null && trim($input->cardName) !== '') {
   114	            $cardNameJoin = '
   115	            LEFT JOIN mtb_card_detail cd ON p.card_detail_id = cd.id
   116	            LEFT JOIN mtb_card card ON cd.card_id = card.id';
   117	        }
   118	
   119	        $cardDetailMainJoin = '';
   120	        if (
   121	            $input->cardsets !== []
   122	            || $input->foilValues !== []
   123	            || $input->rarities !== []
   124	            || $input->frameValues !== []
   125	            || $input->promotions !== []
   126	        ) {
   127	            $cardDetailMainJoin = '
   128	            LEFT JOIN mtb_card_detail cd_main ON p.card_detail_id = cd_main.id';
   129	        }
   130	
   131	        $innerSql = "
   132	            SELECT
   133	                bi.id                                        AS bi_id,
   134	                bi.shop_name                                 AS store_name,
   135	                pc.id                                        AS pc_id,
   136	                pc.product_code                                      AS product_code,
   137	                p.name                                       AS product_name,
   138	                p.id                                         AS product_id,
   139	                pc.language_id                               AS language_id,
   140	                SUM(COALESCE(ps.stock, 0))                   AS current_stock,
   141	                SUM(COALESCE(wsh.stock_01, 0))               AS stock_1w_ago,
   142	                SUM(COALESCE(wsh.stock_02, 0))               AS stock_2w_ago,
   143	                SUM(COALESCE(wsh.stock_03, 0))               AS stock_3w_ago,
   144	                SUM(COALESCE(wsh.stock_04, 0))               AS stock_1m_ago,
   145	                COALESCE(MAX(dsq.sales_quantity_04), 0)      AS weekly_sales,
   146	                COALESCE(MAX(dsuq.stock_up_quantity_04), 0)  AS weekly_inbound,
   147	                COALESCE(MAX(dsq.sales_quantity_05), 0)      AS monthly_sales,
   148	                COALESCE(MAX(dsuq.stock_up_quantity_05), 0)  AS monthly_inbound
   149	            FROM dtb_product_stock ps
   150	            INNER JOIN dtb_product_class pc  ON ps.product_class_id = pc.id
   151	            INNER JOIN dtb_product p         ON pc.product_id = p.id
   152	            INNER JOIN dtb_base_info bi       ON ps.base_info_id = bi.id
   153	            LEFT JOIN dtb_weekly_stock_history wsh
   154	                ON wsh.product_stock_id = ps.id
   155	            LEFT JOIN dtb_sales_quantity dsq
   156	                ON dsq.product_class_id = pc.id AND dsq.base_info_id = bi.id
   157	            LEFT JOIN dtb_stock_up_quantity dsuq
   158	                ON dsuq.product_class_id = pc.id AND dsuq.base_info_id = bi.id
   159	            {$cardNameJoin}
   160	            {$cardDetailMainJoin}
   161	            {$whereSql}
   162	            GROUP BY bi.id, bi.shop_name, pc.id, pc.product_code, p.id, p.name, pc.language_id
   163	        ";
   164	
   165	        if ($isAllStore) {
   166	            $sql = "
   167	                SELECT
   168	                    '全店'                          AS store_name,
   169	                    inner_q.product_code,
   170	                    inner_q.product_name,
   171	                    inner_q.product_id,
   172	                    inner_q.language_id,
   173	                    SUM(inner_q.current_stock)      AS current_stock,
   174	                    SUM(inner_q.stock_1w_ago)       AS stock_1w_ago,
   175	                    SUM(inner_q.stock_2w_ago)       AS stock_2w_ago,
   176	                    SUM(inner_q.stock_3w_ago)       AS stock_3w_ago,
   177	                    SUM(inner_q.stock_1m_ago)       AS stock_1m_ago,
   178	                    SUM(inner_q.weekly_sales)       AS weekly_sales,
   179	                    SUM(inner_q.weekly_inbound)     AS weekly_inbound,
   180	                    SUM(inner_q.monthly_sales)      AS monthly_sales,
   181	                    SUM(inner_q.monthly_inbound)    AS monthly_inbound
   182	                FROM ({$innerSql}) inner_q
   183	                GROUP BY
   184	                    inner_q.pc_id,
   185	                    inner_q.product_code,
   186	                    inner_q.product_name,
   187	                    inner_q.product_id,
   188	                    inner_q.language_id
   189	                ORDER BY inner_q.product_code ASC
   190	            ";
   191	        } else {
   192	            $sql = $innerSql.' ORDER BY bi.shop_name ASC, pc.product_code ASC';
   193	        }
   194	
   195	        return $this->connection->executeQuery($sql, $params, $paramTypes)->iterateAssociative();
   196	    }
