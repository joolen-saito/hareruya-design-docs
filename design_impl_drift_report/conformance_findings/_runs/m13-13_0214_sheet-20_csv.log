   877	    private function resolveFormats(string $commaNames): bool
   878	    {
   879	        $parts = $this->formatNameParts($commaNames);
   880	        if ($parts === []) {
   881	            return false;
   882	        }
   883	        foreach ($parts as $part) {
   884	            if ($this->formatRepository->findOneBy(['name_jp' => $part]) === null) {
   885	                return false;
   886	            }
   887	        }
   888	
   889	        return true;
   890	    }
   891	
   892	    /**
   893	     * @return ArrayCollection<int, MtbFormat>
   894	     */
   895	    private function resolveFormatsCollection(string $commaNames): ArrayCollection
   896	    {
   897	        $c = new ArrayCollection();
   898	        foreach ($this->formatNameParts($commaNames) as $part) {
   899	            $f = $this->formatRepository->findOneBy(['name_jp' => $part]);
   900	            if ($f instanceof MtbFormat) {
   901	                $c->add($f);
   902	            }
   903	        }
   904	
   905	        return $c;
   906	    }
   907	
   908	    /**
   909	     * @return list<string>
   910	     */
   911	    private function formatNameParts(string $commaNames): array
   912	    {
   913	        $parts = [];
   914	        foreach (preg_split('/[,、]/u', $commaNames) ?: [] as $p) {
   915	            $t = trim((string) $p);
   916	            if ($t !== '') {
   917	                $parts[] = $t;
   918	            }
   919	        }
