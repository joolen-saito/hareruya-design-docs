    41	final class SjisToUtf8EncodingFilter extends \php_user_filter
    42	{
    43	    /**
    44	     * Buffer size limit (bytes)
    45	     */
    46	    private static int $bufferSizeLimit = 1024;
    47	
    48	    private string $buffer = '';
    49	
    50	    public static function setBufferSizeLimit(int $bufferSizeLimit): void
    51	    {
    52	        self::$bufferSizeLimit = $bufferSizeLimit;
    53	    }
    54	
    55	    /**
    56	     * @param resource $in
    57	     * @param resource $out
    58	     * @param float|int $consumed
    59	     * @param bool $closing
    60	     */
    61	    #[\Override]
    62	    public function filter($in, $out, &$consumed, $closing): int
    63	    {
    64	        $isBucketAppended = false;
    65	        $previousData = $this->buffer;
    66	        $deferredData = '';
    67	
    68	        while ($bucket = \stream_bucket_make_writeable($in)) {
    69	            $data = $previousData.$bucket->data;
    70	            $consumed += (int) $bucket->datalen;
    71	
    72	            while ($this->needsToNarrowEncodingDataScope($data)) {
    73	                $deferredData = \substr($data, -1).$deferredData;
    74	                $data = \substr($data, 0, -1);
    75	            }
    76	
    77	            if ($data) {
    78	                $bucket->data = $this->encode($data);
    79	                \stream_bucket_append($out, $bucket);
    80	                $isBucketAppended = true;
    81	            }
    82	        }
    83	
    84	        $this->buffer = $deferredData;
    85	        $this->assertBufferSizeIsSmallEnough();
    86	
    87	        return $isBucketAppended ? \PSFS_PASS_ON : \PSFS_FEED_ME;
    88	    }
    89	
    90	    private function needsToNarrowEncodingDataScope(string $string): bool
    91	    {
    92	        return !($string === '' || $this->isValidEncoding($string));
    93	    }
    94	
    95	    private function isValidEncoding(string $string): bool
    96	    {
    97	        return \mb_check_encoding($string, 'SJIS-win');
    98	    }
    99	
   100	    private function encode(string $string): string
   101	    {
   102	        return \mb_convert_encoding($string, 'UTF-8', 'SJIS-win');
   103	    }
   104	
   105	    private function assertBufferSizeIsSmallEnough(): void
   106	    {
   107	        \assert(
   108	            \strlen($this->buffer) <= self::$bufferSizeLimit,
