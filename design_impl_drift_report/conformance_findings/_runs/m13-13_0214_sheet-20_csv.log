   374	    /**
   375	     * Add an increment to duplicate headers
   376	     *
   377	     * So the following line:
   378	     * |duplicate|duplicate|duplicate|
   379	     * |first    |second   |third    |
   380	     *
   381	     * Yields value:
   382	     * $duplicate => 'first', $duplicate1 => 'second', $duplicate2 => 'third'
   383	     *
   384	     * @param array<int, string> $headers
   385	     *
   386	     * @return array<int, string>
   387	     */
   388	    protected function incrementHeaders(array $headers): array
   389	    {
   390	        $incrementedHeaders = [];
   391	        foreach (array_count_values($headers) as $header => $count) {
   392	            if ($count > 1) {
   393	                $incrementedHeaders[] = $header;
   394	                for ($i = 1; $i < $count; $i++) {
   395	                    $incrementedHeaders[] = $header.$i;
   396	                }
   397	            } else {
   398	                $incrementedHeaders[] = $header;
   399	            }
   400	        }
   401	
   402	        return $incrementedHeaders;
   403	    }
   404	
   405	    /**
   406	     * Merges values for duplicate headers into an array
   407	     *
   408	     * So the following line:
   409	     * |duplicate|duplicate|duplicate|
   410	     * |first    |second   |third    |
   411	     *
   412	     * Yields value:
   413	     * $duplicate => ['first', 'second', 'third']
   414	     *
   415	     * @param array<int, string> $line
   416	     *
   417	     * @return array<int, string>
   418	     */
   419	    protected function mergeDuplicates(array $line): array
   420	    {
   421	        $values = [];
   422	
   423	        $i = 0;
   424	        foreach ($this->columnHeaders as $count) {
   425	            if (1 === $count) {
   426	                $values[] = $line[$i];
   427	            } else {
   428	                $values[] = array_slice($line, $i, $count);
   429	            }
   430	
   431	            $i += $count;
   432	        }
   433	
   434	        return $values;
   435	    }
   436	}

