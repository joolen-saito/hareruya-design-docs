    82	            $page_no = 1;
    83	            $viewData = FormUtil::getViewData($searchForm);
    84	
    85	            $this->session->set($this->sessionKey, $viewData);
    86	            $this->session->set($this->sessionKey.'.page_no', $page_no);
    87	        } else {
    88	            $pageNoAttr = $request->attributes->get('page_no');
    89	            if ($request->query->getInt('resume') === Constant::ENABLED || $pageNoAttr !== null) {
    90	                if ($pageNoAttr !== null) {
    91	                    $page_no = (int) $pageNoAttr;
    92	                    $this->session->set($this->sessionKey.'.page_no', $page_no);
    93	                } else {
    94	                    $page_no = $this->session->get($this->sessionKey.'.page_no', 1);
    95	                }
    96	                $viewData = $this->session->get($this->sessionKey, []);
    97	                FormUtil::submitAndGetData($searchForm, $viewData);
    98	            } else {
    99	                $viewData = FormUtil::getViewData($searchForm);
   100	                $this->session->set($this->sessionKey, $viewData);
   101	                $this->session->set($this->sessionKey.'.page_no', 1);
   102	
   103	                return [
   104	                    'searchForm' => $searchForm->createView(),
   105	                    'pagination' => null,
   106	                    'is_search_filter_active' => false,
   107	                ];
