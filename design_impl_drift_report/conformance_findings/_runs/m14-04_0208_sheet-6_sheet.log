   174	
   175	            return new JsonResponse([
   176	                'result' => ($result[0] === 0) ? 'success' : 'failure',
   177	                'message' => ($result[0] === 0) ? trans('admin.common.save_complete') : $result[1],
   178	            ]);
   179	        } catch (\Exception $e) {
   180	            return new JsonResponse([
   181	                'result' => 'failure',
