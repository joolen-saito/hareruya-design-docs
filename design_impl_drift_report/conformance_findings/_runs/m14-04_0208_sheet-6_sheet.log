   439	    /**
   440	     * カード検索 API 用の一覧取得。クエリパラメータ ($params) を条件・並び順・ページネーションとして解釈し、
   441	     * 該当カードの正規化済み配列と総件数を返す。結果は Redis にキャッシュする。
   442	     *
   443	     * @param array<string, mixed> $params
   444	     *
   445	     * @return array{cards: array<int, array<string, mixed>>, total_count: int}
   446	     */
   447	    public function findBySearchParams(array $params): array
