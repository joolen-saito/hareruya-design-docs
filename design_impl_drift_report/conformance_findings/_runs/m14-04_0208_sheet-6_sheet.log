   129	     * @return bool 詳細検索項目に入力がある場合 true
   130	     */
   131	    private function checkSearchFilterActive(array $searchData): bool
   132	    {
   133	        // 判定から除外する項目（これらのみの場合は詳細検索を閉じさせる）
   134	        $excludeKeys = ['multi', 'sortKey', 'sortOrder'];
   135	
   136	        foreach ($searchData as $key => $value) {
   137	            if (in_array($key, $excludeKeys, true)) {
   138	                continue;
   139	            }
   140	
   141	            if ($value !== null && $value !== '') {
   142	                // 配列（EntityTypeの複数選択など）の場合は中身があるか確認
   143	                if (is_iterable($value)) {
   144	                    foreach ($value as $_) {
   145	                        return true;
   146	                    }
   147	                    continue;
   148	                }
   149	
   150	                return true;
   151	            }
   152	        }
   153	
   154	        return false;
   155	    }
