   160	    #[Route('/%eccube_admin_route%/card/generate_list', name: 'admin_card_generate_list', methods: ['POST'])]
   161	    public function generateList(Request $request): JsonResponse
   162	    {
   163	        $tokenValue = $request->request->get('_token');
   164	        $token = new CsrfToken('create_card_name_list', $tokenValue);
   165	        if (!$this->csrfTokenManager->isTokenValid($token)) {
