    66	    #[Template('@admin/Card/index.twig')]
    67	    public function index(Request $request, PaginatorInterface $paginator, int $page_no = 1): array
    68	    {
    69	        $searchForm = $this->getForm();
    70	
    71	        if ($request->isMethod('POST')) {
    72	            $searchForm->handleRequest($request);
    73	
    74	            if (!$searchForm->isValid()) {
    75	                return [
    76	                    'searchForm' => $searchForm->createView(),
