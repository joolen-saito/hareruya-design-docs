   163	     *     $cardInfo['foilFlg'] : foil フラグ（必須）
   164	     *     $cardInfo['promotionId'] : プロモーションID。省略時はノンプロモ。
   165	     *     $cardInfo['cardsetNameEn'] : カードセット名（英）。省略時は「カードセットなし」。
   166	     *
   167	     * @return array<string, mixed> カード詳細情報
   168	     *
   169	     * @throws EntityNotFoundException カード詳細情報が見つからなかった場合
   170	     * @throws NonUniqueResultException カード詳細情報が2件以上見つかった場合
   171	     */
   172	    public function findOneByNameNative(array $cardInfo): array
   173	    {
   174	        $baseSql = <<<EOT
   175	SELECT
   176	    cd.id as card_detail_id,
   177	    c.name_en,
   178	    cs.code as cardset_code,
   179	    cd.foil_flg,
   180	    cd.card_no,
   181	    pr.code AS promotion_code
   182	FROM
   183	    mtb_card_detail cd
   184	    INNER JOIN mtb_card c
   185	        ON cd.card_id = c.id
   186	    LEFT JOIN mtb_cardset cs
   187	        ON cd.cardset_id = cs.id
   188	    LEFT JOIN mtb_promotion pr
   189	        ON cd.promotion_id = pr.id
   190	EOT;
   191	
   192	        $where = [];
   193	        $params = [];
   194	
   195	        $where[] = 'c.name_en = :cardNameEn';
   196	        $params['cardNameEn'] = $cardInfo['cardNameEn'];
   197	
   198	        $where[] = 'cd.foil_flg = :foilFlg';
   199	        $params['foilFlg'] = $cardInfo['foilFlg'];
   200	
   201	        $where[] = 'pr.id = :promotionId';
   202	        $params['promotionId'] = $cardInfo['promotionId'] ?? MtbPromotion::NON_PROMOTION_ID;
   203	
   204	        if (isset($cardInfo['cardsetNameEn'])) {
   205	            $where[] = 'cs.name_en = :cardsetNameEn';
   206	            $params['cardsetNameEn'] = $cardInfo['cardsetNameEn'];
   207	        } else {
   208	            $where[] = 'cs.id IS NULL';
   209	        }
   210	
   211	        $sql = $baseSql.' WHERE '.implode(' AND ', $where);
   212	
   213	        $rsm = new ResultSetMapping();
   214	        $rsm->addScalarResult('card_detail_id', 'cardDetailId', Types::INTEGER)
   215	            ->addScalarResult('name_en', 'cardNameEn')
   216	            ->addScalarResult('cardset_code', 'cardsetCode')
   217	            ->addScalarResult('foil_flg', 'foilFlg', Types::INTEGER)
   218	            ->addScalarResult('card_no', 'cardNo')
   219	            ->addScalarResult('promotion_code', 'promotionCode');
   220	
   221	        $result = $this->getEntityManager()
   222	            ->createNativeQuery($sql, $rsm)
   223	            ->setParameters($params)
   224	            ->getResult();
   225	
   226	        if (count($result) === 1) {
   227	            return current($result);
   228	        }
   229	        if (count($result) === 0) {
   230	            throw new EntityNotFoundException();
   231	        }
   232	
   233	        throw new NonUniqueResultException(sprintf('カード詳細情報が複数見つかりました: cardName=%s', $cardInfo['cardNameEn']));
   234	    }
