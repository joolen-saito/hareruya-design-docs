    36	    /**
    37	     * カード詳細一覧
    38	     * 検索条件に該当するデータを取得
    39	     *
    40	     * @param array{
    41	     * card_name: string|null,
    42	     * cardset: int[]|null,
    43	     * sort: string,
    44	     * order: string
    45	     * } $searchData
    46	     *
    47	     * @return QueryBuilder
    48	     */
    49	    public function getQueryBuilderBySearchDataForAdmin(array $searchData): QueryBuilder
    50	    {
    51	        $sortKey = [
    52	            'cardDetailId' => 'cd.id',
    53	            'cardIdAndCardDetailId' => 'c.id,cd.id',
    54	        ];
    55	
    56	        $qb = $this->createQueryBuilder('cd')
    57	            ->select('c', 'cd', 'ci')
    58	            ->join('cd.Card', 'c')
    59	            ->leftJoin('cd.Cardset', 'cs')
    60	            ->leftJoin('cd.CardImages', 'ci');
    61	
    62	        // カード名
    63	        $cardName = $searchData['card_name'];
    64	        if (isset($cardName) && StringUtil::isNotBlank($cardName)) {
    65	            // スペース除去
    66	            $cardName = trim(mb_convert_kana($cardName, 's', 'UTF-8'));
    67	            // 半角スペース、全角スペース、カンマで分割
    68	            $texts = preg_split('/[\s,　]+/u', $cardName);
    69	            $searchColumns = [
    70	                'c' => ['name_jp', 'name_en'],
    71	            ];
    72	            SqlUtil::multiTextQuery($qb, $texts, $searchColumns);
    73	        }
    74	
    75	        // カードセット
    76	        $cardset = $searchData['cardset'];
    77	        if (!empty($cardset)) {
    78	            $qb->andWhere('cd.Cardset IN (:cardset)')
    79	                ->setParameter('cardset', $cardset);
    80	        }
    81	
    82	        // Order By
    83	        $sortkeys = explode(',', $sortKey[$searchData['sort']]);
    84	        foreach ($sortkeys as $sort) {
    85	            $qb->addOrderBy($sort, $searchData['order']);
    86	        }
    87	
    88	        return $qb;
    89	    }
