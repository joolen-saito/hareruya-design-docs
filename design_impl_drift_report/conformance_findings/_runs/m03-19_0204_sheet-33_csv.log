   302	        }
   303	        /** @var UploadedFile|null $formFile */
   304	        $formFile = $form['import_file']->getData();
   305	
   306	        if ($formFile === null) {
   307	            $this->addError('admin.common.csv_invalid_format', 'admin');
   308	
   309	            return $this->redirectToRoute('admin_product_section_master_csv_upload');
   310	        }
   311	
   312	        if ($this->countCsvRows($formFile) >= static::ADMIN_CSV_IMPORT_MAX_ROWS) {
   313	            $this->addError(
   314	                $this->translator->trans('admin.csv.error.upload.maxrecord', ['%maxRecord%' => static::ADMIN_CSV_IMPORT_MAX_ROWS]),
   315	                'admin'
   316	            );
   317	
   318	            return $this->redirectToRoute('admin_product_section_master_csv_upload');
   319	        }
   320	
   321	        log_info('部門マスタCSV登録開始');
   322	
   323	        $handler = new SectionMasterImportHandler($this->mtbSectionRepository, $this->smaregiSectionEventService);
   324	        $importer = new CsvImporter(
