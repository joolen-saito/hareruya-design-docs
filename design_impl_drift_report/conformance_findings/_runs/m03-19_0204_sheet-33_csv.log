   334	            log_info('部門マスタCSV登録 異常終了');
   335	            foreach ($result->getErrors() as $error) {
   336	                $this->addError($error['message'], 'admin');
   337	            }
   338	        } else {
   339	            $this->addSuccess('admin.register.complete', 'admin');
   340	            log_info('部門マスタCSV登録完了', ['count' => $result->getCount()]);
   341	        }
   342	
   343	        return $this->redirectToRoute('admin_product_section_master_csv_upload');
   344	    }
