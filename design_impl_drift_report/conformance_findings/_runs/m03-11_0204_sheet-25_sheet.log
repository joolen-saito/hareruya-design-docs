    80	    /**
    81	     * @return list<Category>
    82	     */
    83	    private function collectDescendantCategories(Category $root): array
    84	    {
    85	        $list = [];
    86	        $walk = static function (Category $node) use (&$walk, &$list): void {
    87	            $list[] = $node;
    88	            foreach ($node->getChildren() as $child) {
    89	                $walk($child);
    90	            }
    91	        };
    92	        $walk($root);
