    23	use Symfony\Component\Routing\Attribute\Route;
    24	
    25	class HeaderCategoriesController extends AbstractController
    26	{
    27	    public function __construct(
    28	        private readonly TopCategoryListBuilder $topCategoryListBuilder,
    29	        private readonly BaseInfoRepository $baseInfoRepository,
    30	    ) {
    31	    }
    32	
    33	    /**
    34	     * ヘッダー 4 段目のカテゴリバーが hover 展開時に取得する JSON エンドポイント。
    35	     * hareruya-top.js が `/assets/data/header-categories.json` を fetch するため、
    36	     * 物理ファイルの代わりに動的に同形式の JSON を返す。
    37	     */
    38	    #[Route(path: '/assets/data/header-categories.json', name: 'app_header_categories_json', methods: ['GET'])]
    39	    public function index(Request $request): JsonResponse
    40	    {
    41	        $shopSlug = $this->extractShopSlugFromReferer($request);
    42	        if ($shopSlug !== '') {
    43	            $request->attributes->set('_shop', $shopSlug);
    44	        }
    45	
    46	        return new JsonResponse(
    47	            $this->topCategoryListBuilder->buildHeaderCategoriesPayload($request->getLocale()),
    48	        );
    49	    }
    50	
    51	    /**
    52	     * bundle JS は `/assets/data/header-categories.json` を絶対パスで fetch するため Request 自身に `_shop` attribute が無く、
    53	     * Referer URL (現在 page の URL) から `/<locale>/<slug>/...` パターンを解析して shop slug を取得する。
    54	     * 取得した slug が dtb_base_info に存在する html_class_name と一致した場合のみ shop と判定する (本店の `/ja/contact` 等の単一セグメント page を shop と誤判定するのを防止)。
    55	     */
    56	    private function extractShopSlugFromReferer(Request $request): string
    57	    {
    58	        $referer = (string) $request->headers->get('referer', '');
    59	        if ($referer === '') {
    60	            return '';
    61	        }
    62	        $refererScheme = (string) (parse_url($referer, PHP_URL_SCHEME) ?? '');
    63	        $refererHost = (string) (parse_url($referer, PHP_URL_HOST) ?? '');
    64	        if ($refererScheme === '' || $refererHost === '') {
    65	            return '';
    66	        }
    67	        $refererPort = parse_url($referer, PHP_URL_PORT);
    68	        $refererOrigin = $refererScheme.'://'.$refererHost.($refererPort !== null ? ':'.$refererPort : '');
    69	        if ($refererOrigin !== $request->getSchemeAndHttpHost()) {
    70	            return '';
    71	        }
    72	        $path = (string) (parse_url($referer, PHP_URL_PATH) ?? '');
    73	        if (preg_match('#^/(?:ja|en)/([^/]+)(?:/|$)#', $path, $matches) !== 1) {
    74	            return '';
    75	        }
    76	
    77	        $candidate = $matches[1];
    78	        if ($this->baseInfoRepository->findByHtmlClassName($candidate) === null) {
    79	            return '';
    80	        }
    81	
    82	        return '/'.$candidate;
    83	    }
    84	}

