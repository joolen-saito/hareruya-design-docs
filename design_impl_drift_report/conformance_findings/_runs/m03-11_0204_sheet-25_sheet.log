    23	<script nonce="{{ csp_nonce }}">
    24	        $(document).on('drop dragover', function(e) {
    25	            e.preventDefault();
    26	        });
    27	
    28	        $(function() {
    29	            // 初期表示時のsort noを保持.
    30	            var oldSortNos = [];
    31	            $('.sortable-item').each(function() {
    32	                oldSortNos.push(this.dataset.sortNo);
    33	            });
    34	            oldSortNos.sort(function(a, b) {
    35	                return a - b;
    36	            }).reverse();
    37	            // 並び替え後にsort noを更新
    38	            var updateSortNo = function() {
    39	                var newSortNos = {};
    40	                var i = 0;
    41	                $('.sortable-item').each(function() {
    42	                    newSortNos[this.dataset.id] = oldSortNos[i];
    43	                    i++;
    44	                });
    45	                $.ajax({
    46	                    url: '{{ url('admin_product_category_sort_no_move') }}',
    47	                    type: 'POST',
    48	                    data: newSortNos
    49	                }).always(function() {
    50	                    $(".modal-backdrop").remove();
    51	                });
    52	            };
    53	            var redrawDisableAllows = function() {
    54	                var items = $('.sortable-item');
    55	                items.find('a.action-up').removeClass('disabled');
    56	                items.find('a.action-down').removeClass('disabled');
    57	                items.first().find('a.action-up').addClass('disabled');
    58	                items.last().find('a.action-down').addClass('disabled');
    59	            };
    60	            // オーバレイ後, 表示順の更新を行う
    61	            var moveSortNo = function() {
    62	                $('body').append($('<div class="modal-backdrop show"></div>'));
    63	                updateSortNo();
    64	                redrawDisableAllows();
    65	            };
    66	            var categorySortDragConfirmMessage = {{ 'admin.product.category_sort_drag_confirm'|trans|json_encode|raw }};
    67	            var previousSortableOrder = [];
    68	            // Drag and Drop
    69	            $('.sortable-container').sortable({
    70	                items: '> .sortable-item',
    71	                cursor: 'move',
    72	                start: function() {
    73	                    previousSortableOrder = [];
    74	                    $(this).find('.sortable-item').each(function() {
    75	                        previousSortableOrder.push(this.id);
    76	                    });
    77	                },
    78	                update: function(e, ui) {
    79	                    if (!window.confirm(categorySortDragConfirmMessage)) {
    80	                        var container = this;
    81	                        previousSortableOrder.forEach(function(elementId) {
    82	                            var el = document.getElementById(elementId);
    83	                            if (el) {
    84	                                container.appendChild(el);
    85	                            }
    86	                        });
    87	                        return;
    88	                    }
    89	                    moveSortNo();
    90	                }
    91	            });
    92	            // Up
    93	            $('.sortable-item').on('click', 'a.action-up', function(e) {
    94	                e.preventDefault();
    95	                var current = $(this).parents("li");
    96	                if (!current.prev().hasClass('sortable-item')) {
    97	                    return;
    98	                }
    99	                if (!window.confirm(categorySortDragConfirmMessage)) {
   100	                    return;
   101	                }
   102	                current.prev().before(current);
   103	                moveSortNo();
   104	            });
   105	            // Down
   106	            $('.sortable-item').on('click', 'a.action-down', function(e) {
   107	                e.preventDefault();
   108	                var current = $(this).parents("li");
   109	                if (!current.next().hasClass('sortable-item')) {
   110	                    return;
   111	                }
   112	                if (!window.confirm(categorySortDragConfirmMessage)) {
   113	                    return;
   114	                }
   115	                current.next().after(current);
   116	                moveSortNo();
   117	            });
