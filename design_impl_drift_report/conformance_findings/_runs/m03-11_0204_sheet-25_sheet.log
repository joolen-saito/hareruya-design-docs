   142	    /**
   143	     * @return array<string, mixed>
   144	     */
   145	    private function buildCategoryItem(Category $Category, string $locale, CategorySidebarLinkContext $linkContext): array
   146	    {
   147	        $params = ['category_id' => $Category->getId()];
   148	        $searchParameters = $Category->getSearchParameters();
   149	        if (!empty($searchParameters)) {
   150	            parse_str($searchParameters, $extraParams);
   151	            unset($extraParams['category_id']);
   152	            $params = array_merge($params, $extraParams);
   153	        }
   154	        // カテゴリリストからの導線は色順とする。ただし、管理画面のカテゴリ編集でクエリ文字列を登録できるため、念の為マスタ側の指定を優先とし上書きはしない。
   155	        if (!isset($params['orderby'])) {
   156	            $categoryListOrderById = $linkContext->getCategoryListOrderById();
   157	            if ($categoryListOrderById !== null) {
   158	                $params['orderby'] = $categoryListOrderById;
   159	            }
   160	        }
   161	        $request = $this->requestStack->getCurrentRequest();
   162	        if ($request !== null) {
   163	            $shop = (string) $request->attributes->get('_shop', '');
   164	            if ($shop !== '') {
   165	                $params['_shop'] = $shop;
   166	            }
   167	        }
   168	
   169	        $routeParams = array_merge($linkContext->getDefaultQueryParams(), $params);
   170	
   171	        $item = [
   172	            'id' => $Category->getId(),
   173	            'text' => $locale === 'en' && $Category->getCategoryNameEn()
   174	                ? $Category->getCategoryNameEn()
   175	                : $Category->getName(),
   176	            'href' => $this->urlGenerator->generate($linkContext->getListRouteName(), $routeParams),
   177	        ];
   178	
   179	        $item['image'] = $Category->getBannerImage();
   180	        $item['icon'] = $Category->getIconImage();
   181	
   182	        $item['children'] = [];
   183	        $isBranch = $this->isBranchShopContext();
   184	        foreach ($Category->getChildren() as $Child) {
   185	            if ($Child->getFrontSearchHideFlg()) {
   186	                continue;
   187	            }
   188	            if ($isBranch && $Child->getBranchHideFlg()) {
   189	                continue;
   190	            }
   191	            $item['children'][] = $this->buildCategoryItem($Child, $locale, $linkContext);
   192	        }
   193	
   194	        // mtb_cardset 紐づきのカードセット合成子要素を追加
   195	        foreach ($this->cardsetGenerator->generate($Category, $isBranch, $linkContext) as $cardsetNode) {
   196	            $item['children'][] = $this->convertCardsetNode($cardsetNode, $locale);
   197	        }
   198	
   199	        if (empty($item['children'])) {
   200	            unset($item['children']);
   201	        }
   202	
   203	        return $item;
   204	    }
