    26	
    27	/**
    28	 * category_list / category_nav_pc / category_modal ブロック用の Twig payload を構築する。
    29	 */
    30	class CategoryListBlockPayloadBuilder
    31	{
    32	    public function __construct(
    33	        private readonly RequestStack $requestStack,
    34	        private readonly TopCategoryListBuilder $topCategoryListBuilder,
    35	        private readonly MtbCardsetRepository $mtbCardsetRepository,
    36	        private readonly CacheInterface $categoryNavCache,
    37	        private readonly EccubeConfig $eccubeConfig,
    38	    ) {
    39	    }
    40	
    41	    /**
    42	     * @return array{
    43	     *     latestSetItems: list<array<string, mixed>>,
    44	     *     formatGroups: list<array{type: string, items: list<array<string, mixed>>}>,
    45	     *     othersItems: list<array<string, mixed>>,
    46	     *     RecentCardset: MtbCardset|null
    47	     * }
    48	     */
    49	    public function build(): array
    50	    {
    51	        $mainRequest = $this->requestStack->getMainRequest() ?? $this->requestStack->getCurrentRequest();
    52	        if ($mainRequest === null) {
    53	            throw new \RuntimeException('Request is not available.');
    54	        }
    55	
    56	        $locale = $mainRequest->getLocale();
    57	        $mainRoute = (string) $mainRequest->attributes->get('_route', '');
    58	        $isPurchase = str_starts_with($mainRoute, 'purchase_');
    59	        $linkContext = $isPurchase
    60	            ? CategorySidebarLinkContext::forPurchase()
    61	            : CategorySidebarLinkContext::forProduct();
    62	
    63	        // カテゴリツリーの構築 (5 階層 JOIN + 再帰 + カードセット合成) は重く、カテゴリ追加後は
    64	        // 単体クエリだけで約 10 秒かかる。全ページのヘッダーで毎リクエスト走るため共有キャッシュする。
    65	        // 生成結果は locale / 導線(販売・買取) / 店舗(_shop は href に埋まる) で変わるためキー要素に含める。
    66	        $shop = trim((string) $mainRequest->attributes->get('_shop', ''), '/');
    67	        $cacheKey = sprintf(
    68	            'category_nav.v1.%s.%s.%s',
    69	            $locale !== '' ? $locale : 'ja',
    70	            $isPurchase ? 'purchase' : 'product',
    71	            $shop !== '' ? $shop : 'main'
    72	        );
    73	
    74	        /** @var array<string, array{items: array<int, array<string, mixed>>}> $groups */
    75	        $groups = $this->categoryNavCache->get($cacheKey, function (ItemInterface $item) use ($locale, $linkContext) {
    76	            $item->expiresAfter((int) $this->eccubeConfig['eccube_result_cache_lifetime']);
    77	
    78	            return $this->topCategoryListBuilder->build($locale, $linkContext);
    79	        });
    80	
    81	        $formats = [
    82	            ['type' => TopCategoryListBuilder::GROUP_STANDARD, 'items' => $groups[TopCategoryListBuilder::GROUP_STANDARD]['items']],
    83	            ['type' => TopCategoryListBuilder::GROUP_PIONEER, 'items' => $groups[TopCategoryListBuilder::GROUP_PIONEER]['items']],
    84	            ['type' => TopCategoryListBuilder::GROUP_MODERN, 'items' => $groups[TopCategoryListBuilder::GROUP_MODERN]['items']],
    85	            ['type' => TopCategoryListBuilder::GROUP_LEGACY, 'items' => $groups[TopCategoryListBuilder::GROUP_LEGACY]['items']],
    86	            ['type' => TopCategoryListBuilder::GROUP_COMMANDER, 'items' => $groups[TopCategoryListBuilder::GROUP_COMMANDER]['items']],
    87	        ];
    88	
    89	        return [
    90	            'latestSetItems' => $groups[TopCategoryListBuilder::GROUP_LATEST_SET]['items'],
    91	            'formatGroups' => $formats,
    92	            'othersItems' => $groups[TopCategoryListBuilder::GROUP_OTHERS]['items'],
    93	            'RecentCardset' => $this->mtbCardsetRepository->getRecentCardset(),
    94	        ];
    95	    }
    96	}

