   121	                foreach ($this->cardsetGenerator->generate($Category, $isBranch, $linkContext) as $cardsetNode) {
   122	                    $item = $this->convertCardsetNode($cardsetNode, $locale);
   123	                    $result[self::GROUP_LATEST_SET]['items'][] = $item;
   124	                    $result['all']['items'][] = $item;
   125	                }
   126	            } elseif (isset(self::FORMAT_CATEGORY_NAMES[$name])) {
