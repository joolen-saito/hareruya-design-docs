    94	        return $list;
    95	    }
    96	
    97	    /**
    98	     * @return ?array<string, mixed>
    99	     */
   100	    private function buildNode(Category $category, bool $branchContext, ?Category $parentInTree): ?array
   101	    {
   102	        if ($category->getHierarchy() > self::MAX_HIERARCHY) {
   103	            return null;
   104	        }
   105	
   106	        if (!$this->isVisibleForApiTree($category, $parentInTree)) {
   107	            return null;
   108	        }
   109	
   110	        if ($branchContext && $category->getBranchHideFlg()) {
   111	            return null;
   112	        }
   113	
   114	        $builtChildren = [];
   115	        if ($category->getHierarchy() < self::MAX_HIERARCHY) {
   116	            foreach ($category->getChildren() as $child) {
   117	                if ($child->getHierarchy() > self::MAX_HIERARCHY) {
   118	                    continue;
   119	                }
   120	
   121	                $built = $this->buildNode($child, $branchContext, $category);
   122	                if ($built !== null) {
   123	                    $builtChildren[] = $built;
   124	                }
   125	            }
   126	        }
   127	
   128	        $parentId = $category->getId();
   129	        $prefetched = $this->prefetchedSyntheticChildrenByParentId;
   130	        if ($parentId !== null && $prefetched !== null) {
   131	            foreach ($prefetched[$parentId] ?? [] as $synthetic) {
   132	                $builtChildren[] = $synthetic;
   133	            }
   134	        } elseif ($prefetched === null) {
   135	            foreach ($this->cardsetSyntheticChildrenGenerator->generate($category, $branchContext) as $synthetic) {
   136	                $builtChildren[] = $synthetic;
   137	            }
   138	        }
   139	
   140	        $row = [
   141	            'id' => $category->getId(),
   142	            'parent_category_id' => $category->getParent()?->getId(),
   143	            'category_name' => $category->getName(),
   144	            'category_name_en' => $category->getCategoryNameEn(),
   145	            'hierarchy' => $category->getHierarchy(),
   146	            'sort_no' => $category->getSortNo(),
   147	            'banner_image' => $category->getBannerImage(),
   148	            'icon_image' => $category->getIconImage(),
   149	        ];
   150	
   151	        if ($builtChildren !== []) {
   152	            $row['children'] = $builtChildren;
   153	            $row['url'] = null;
   154	
   155	            return $row;
   156	        }
   157	
   158	        $searchParameters = $this->normalizeSearchParameters((string) ($category->getSearchParameters() ?? ''));
   159	        if ($searchParameters !== '') {
   160	            $row['is_search_parameter_category'] = true;
   161	            // 仕様: レアリティ等の子は「親カテゴリの一覧 URL + 検索パラメータ」
   162	            $listPath = $this->urlGenerator->generate('product_list');
   163	            $parent = $category->getParent();
   164	            if ($parent !== null && $parent->getId() !== null) {
   165	                $listPath = $this->urlGenerator->generate('product_list', [
   166	                    'category_id' => $parent->getId(),
   167	                ]);
   168	            }
   169	            $separator = str_contains($listPath, '?') ? '&' : '?';
   170	            $row['url'] = $listPath.$separator.$searchParameters;
   171	            $row['query'] = $searchParameters;
   172	        } else {
   173	            $categoryId = $category->getId();
   174	            $listPath = $categoryId !== null
   175	                ? $this->urlGenerator->generate('product_list', ['category_id' => $categoryId])
   176	                : $this->urlGenerator->generate('product_list');
   177	            $row['url'] = $listPath;
   178	            $row['query'] = $categoryId !== null ? 'category_id='.$categoryId : '';
   179	        }
   180	
   181	        return $row;
   182	    }
   183	
   184	    /**
   185	     * ルートは常にフロント表示必須。子は search_parameters があれば、親がフロント表示ならフロント非表示でもツリーに含める。
   186	     */
   187	    private function isVisibleForApiTree(Category $category, ?Category $parentInTree): bool
   188	    {
   189	        if (!$category->getFrontSearchHideFlg()) {
   190	            return true;
   191	        }
   192	
   193	        if ($parentInTree === null) {
   194	            return false;
   195	        }
   196	
   197	        if ($parentInTree->getFrontSearchHideFlg()) {
   198	            return false;
   199	        }
   200	
   201	        return $this->normalizeSearchParameters((string) ($category->getSearchParameters() ?? '')) !== '';
   202	    }
   203	
   204	    private function normalizeSearchParameters(string $raw): string
   205	    {
   206	        $searchParameters = trim($raw);
   207	        if ($searchParameters !== '' && str_starts_with($searchParameters, '?')) {
   208	            $searchParameters = substr($searchParameters, 1);
   209	        }
   210	
   211	        return trim($searchParameters);
   212	    }
   213	}

