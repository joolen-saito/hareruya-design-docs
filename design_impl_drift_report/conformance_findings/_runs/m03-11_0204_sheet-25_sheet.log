   185	        $clone = $CloneCategory ?? clone $TargetCategory;
   186	        $objectKeysToDelete = [];
   187	
   188	        log_info('カテゴリ登録開始');
   189	
   190	        $this->entityManager->wrapInTransaction(function () use ($form, $TargetCategory, $clone, &$objectKeysToDelete): void {
   191	            $fileAdapter = $this->fileManager->getAdapter();
   192	            $bannerTmpDir = rtrim((string) $this->eccubeConfig->get('preferred_temp_category_banner_image_path'), '/').'/';
   193	
   194	            // バナー画像の削除リクエストがあった場合
   195	            $deleteBanner = $form->get('delete_banner_image')->getData();
   196	            if (is_string($deleteBanner) && $deleteBanner !== '') {
   197	                $currentBanner = $clone->getBannerImage();
   198	                if (!is_string($currentBanner) || $currentBanner === '' || !hash_equals($currentBanner, $deleteBanner)) {
   199	                    throw new BadRequestHttpException();
   200	                }
   201	
   202	                $objectKeysToDelete[] = $currentBanner;
   203	                $TargetCategory->setBannerImage(null);
   204	            }
   205	
   206	            // バナー画像の追加リクエストがあった場合は一時ディレクトリから本ディレクトリにファイルを移動
   207	            $addBanner = $form->get('add_banner_image')->getData();
   208	            if (is_string($addBanner) && $addBanner !== '') {
   209	                $bannerTempFile = $bannerTmpDir.$addBanner;
   210	
   211	                if ($fileAdapter->exists($bannerTempFile, [])) {
   212	                    $bannerDir = rtrim((string) $this->eccubeConfig->get('preferred_category_banner_image_path'), '/').'/';
   213	
   214	                    $existingBanner = $clone->getBannerImage();
   215	                    if (is_string($existingBanner) && $existingBanner !== '') {
   216	                        $objectKeysToDelete[] = $existingBanner;
   217	                    }
   218	
   219	                    $fileAdapter->move($bannerTempFile, $bannerDir, $addBanner, []);
   220	
   221	                    $TargetCategory->setBannerImage($fileAdapter->toEntitySaveData()['s3_object_key']);
   222	                }
   223	            }
   224	
   225	            $iconTmpDir = rtrim((string) $this->eccubeConfig->get('preferred_temp_category_icon_image_path'), '/').'/';
   226	
   227	            // アイコン画像の削除リクエストがあった場合
   228	            $deleteIcon = $form->get('delete_icon_image')->getData();
   229	            if (is_string($deleteIcon) && $deleteIcon !== '') {
   230	                $currentIcon = $clone->getIconImage();
   231	                if (!is_string($currentIcon) || $currentIcon === '' || !hash_equals($currentIcon, $deleteIcon)) {
   232	                    throw new BadRequestHttpException();
   233	                }
   234	
   235	                $objectKeysToDelete[] = $currentIcon;
   236	                $TargetCategory->setIconImage(null);
   237	            }
   238	
