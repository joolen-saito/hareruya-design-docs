   771	                array_map(static fn (Category $c): ?int => $c->getId(), $Categories),
   772	                static fn (?int $id): bool => $id !== null && $id > 0
   773	            ));
   774	            $productCountByCategoryId = $this->productCategoryRepository->getProductCountMapByCategoryIds($categoryIds);
