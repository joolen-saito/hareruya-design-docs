   240	            $addIcon = $form->get('add_icon_image')->getData();
   241	            if (is_string($addIcon) && $addIcon !== '') {
   242	                $iconTempFile = $iconTmpDir.$addIcon;
   243	
   244	                if ($fileAdapter->exists($iconTempFile, [])) {
   245	                    $iconDir = rtrim((string) $this->eccubeConfig->get('preferred_category_icon_image_path'), '/').'/';
   246	
   247	                    $existingIcon = $clone->getIconImage();
   248	                    if (is_string($existingIcon) && $existingIcon !== '') {
   249	                        $objectKeysToDelete[] = $existingIcon;
   250	                    }
   251	
   252	                    $fileAdapter->move($iconTempFile, $iconDir, $addIcon, []);
   253	
   254	                    $TargetCategory->setIconImage($fileAdapter->toEntitySaveData()['s3_object_key']);
   255	                }
   256	            }
   257	
   258	            $this->categoryRepository->save($TargetCategory);
   259	        });
   260	
   261	        $fileAdapter = $this->fileManager->getAdapter();
   262	
   263	        foreach (array_unique($objectKeysToDelete) as $objectKey) {
   264	            if ($fileAdapter->exists($objectKey, [])) {
   265	                $fileAdapter->delete($objectKey, []);
   266	            }
   267	        }
   268	
   269	        log_info('カテゴリ登録完了', [$TargetCategory->getId()]);
   270	
   271	        $event = new EventArgs(
   272	            [
   273	                'form' => $form,
   274	                'Parent' => $Parent,
   275	                'TargetCategory' => $TargetCategory,
   276	            ],
   277	            $request
   278	        );
   279	        $this->eventDispatcher->dispatch($event, EccubeEvents::ADMIN_PRODUCT_CATEGORY_INDEX_COMPLETE);
