   213	    /**
   214	     * 指定 ID をルートとしたカテゴリツリー用に、子孫を結合取得する（最大4階層＝ルートから4段の JOIN）.
   215	     */
   216	    public function getTreeByRootId(int $id): ?Category
   217	    {
   218	        $qb = $this->createQueryBuilder('c1')
   219	            ->select('c1, c2, c3, c4')
   220	            ->leftJoin('c1.Children', 'c2')
   221	            ->leftJoin('c2.Children', 'c3')
   222	            ->leftJoin('c3.Children', 'c4')
   223	            ->where('c1.id = :id')
   224	            ->setParameter('id', $id)
   225	            ->orderBy('c1.sort_no', 'DESC')
   226	            ->addOrderBy('c2.sort_no', 'DESC')
   227	            ->addOrderBy('c3.sort_no', 'DESC')
   228	            ->addOrderBy('c4.sort_no', 'DESC');
   229	
   230	        /** @var Category|null $Category */
   231	        $Category = $qb->getQuery()
   232	            ->setResultCacheLifetime($this->getCacheLifetime())
   233	            ->getOneOrNullResult();
   234	
   235	        return $Category;
   236	    }
