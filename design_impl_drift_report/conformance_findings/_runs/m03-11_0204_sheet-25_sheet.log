    82	            self::GROUP_MODERN => ['items' => []],
    83	            self::GROUP_LEGACY => ['items' => []],
    84	            self::GROUP_COMMANDER => ['items' => []],
    85	            self::GROUP_OTHERS => ['items' => []],
