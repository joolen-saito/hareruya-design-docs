   128	                $result[self::FORMAT_CATEGORY_NAMES[$name]]['items'][] = $item;
   129	                $result['all']['items'][] = $item;
   130	            } else {
   131	                $item = $this->buildCategoryItem($Category, $locale, $linkContext);
   132	                $result[self::GROUP_OTHERS]['items'][] = $item;
   133	                $result['all']['items'][] = $item;
   134	            }
   135	        }
   136	
   137	        $this->cardsetGenerator->endPreload();
   138	
   139	        return $result;
   140	    }
