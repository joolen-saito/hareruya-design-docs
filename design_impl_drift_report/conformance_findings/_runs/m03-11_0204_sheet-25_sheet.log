   114	                        continue;
   115	                    }
   116	                    $item = $this->buildCategoryItem($Child, $locale, $linkContext);
   117	                    $result[self::GROUP_LATEST_SET]['items'][] = $item;
   118	                    $result['all']['items'][] = $item;
