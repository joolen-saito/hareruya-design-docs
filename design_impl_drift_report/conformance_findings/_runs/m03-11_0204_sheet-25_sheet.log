   165	    /**
   166	     * フラット取得した全カテゴリから親子関係を組み立て、各カテゴリの Children コレクションを
   167	     * 「初期化済み」状態で埋める。これにより後続の getChildren() 参照で遅延ロード(N+1)が発生しない。
   168	     *
   169	     * Children は inverse side (mappedBy: 'Parent') のため、ここでコレクションを差し替えても
   170	     * フラッシュ時に永続化へ影響しない（owning side は Parent）。takeSnapshot() で変更なし状態として記録する。
   171	     *
   172	     * @param Category[] $allCategories sort_no 降順で取得済みの全カテゴリ
   173	     *
   174	     * @return array{roots: Category[], childrenById: array<int, Category[]>}
   175	     */
   176	    private function buildCategoryTree(array $allCategories): array
   177	    {
   178	        $roots = [];
   179	        /** @var array<int, Category[]> $childrenById */
   180	        $childrenById = [];
   181	
   182	        // $allCategories は sort_no 降順のため、親ごとの子配列もその順序で構築される。
   183	        foreach ($allCategories as $Category) {
   184	            $ParentCategory = $Category->getParent();
   185	            if ($ParentCategory === null) {
   186	                $roots[] = $Category;
   187	                continue;
   188	            }
   189	            // 全カテゴリを取得済みのため getParent() は identity map 上の読み込み済みエンティティを返す（追加クエリなし）。
   190	            $childrenById[$ParentCategory->getId()][] = $Category;
   191	        }
   192	
   193	        $em = $this->getEntityManager();
   194	        $classMetadata = $em->getClassMetadata(Category::class);
   195	        $association = $classMetadata->getAssociationMapping('Children');
   196	        // Children は OneToMany (ToMany) のため必ず ToManyAssociationMapping。
   197	        // setOwner() の交差型 (AssociationMapping&ToManyAssociationMapping) を満たすための絞り込み。
   198	        assert($association instanceof ToManyAssociationMapping);
   199	        $reflChildren = $classMetadata->getReflectionProperty('Children');
   200	        assert($reflChildren !== null);
   201	
   202	        foreach ($allCategories as $Category) {
   203	            $children = $childrenById[$Category->getId()] ?? [];
   204	            $collection = new PersistentCollection($em, $classMetadata, new ArrayCollection($children));
   205	            $collection->setOwner($Category, $association);
   206	            $collection->takeSnapshot();
   207	            $reflChildren->setValue($Category, $collection);
   208	        }
   209	
   210	        return ['roots' => $roots, 'childrenById' => $childrenById];
   211	    }
