   175	    private function completeCategorySave(
   176	        FormInterface $form,
   177	        Category $TargetCategory,
   178	        ?Category $Parent,
   179	        Request $request,
   180	        CacheUtil $cacheUtil,
   181	        ?Category $CloneCategory = null,
   182	    ): RedirectResponse {
   183	        $this->assertCategoryNestWithinLimit($TargetCategory);
