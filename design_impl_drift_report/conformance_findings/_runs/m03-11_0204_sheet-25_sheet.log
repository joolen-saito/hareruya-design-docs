   794	            }
   795	
   796	            $this->csvExportService->fclose();
   797	        });
   798	
   799	        $now = new \DateTime();
   800	        $filename = 'category_'.$now->format('YmdHis').'.csv';
   801	        $response->headers->set('Content-Type', 'application/octet-stream');
