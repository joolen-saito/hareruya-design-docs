    20	class BuyingCardsFormatter
    21	{
    22	    /**
    23	     * フラットな配列を階層構造の連想配列に変換
    24	     *
    25	     * @param array<int, GetBuyingCardsQueryResponseDto> $dtoData
    26	     *
    27	     * @return array{cards: array<int, array{
    28	     *     cardNameJp: string,
    29	     *     cardNameEn: string|null,
    30	     *     imageFileName: string|null,
    31	     *     details: array<int, array{
    32	     *         cardsetCode: string|null,
    33	     *         cardsetName: string|null,
    34	     *         foilFlg: int,
    35	     *         cardNo: string|null,
    36	     *         promotionName: string|null,
    37	     *         productId: int,
    38	     *         productNameJp: string,
    39	     *         productNameEn: string|null,
    40	     *         rarityCode: string|null,
    41	     *         storageCodeName: string|null,
    42	     *         languageClasses: array<string, array{
