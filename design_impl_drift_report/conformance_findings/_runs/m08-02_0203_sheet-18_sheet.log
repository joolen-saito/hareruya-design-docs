    60	     */
    61	    public function getQueryBuilderBySearchData(array $searchData): QueryBuilder
    62	    {
    63	        $qb = $this->createQueryBuilder('s')
    64	            ->distinct()
    65	            ->leftJoin('s.OrderType', 'ot');
    66	
    67	        $sort = $searchData['sort'] ?? 'default';
    68	        $order = strtoupper((string) ($searchData['order'] ?? 'DESC'));
    69	        if (!isset($this->sortKeys[$sort])) {
    70	            $sort = 'default';
    71	        }
    72	        $qb->orderBy($this->sortKeys[$sort], $order === 'ASC' ? 'ASC' : 'DESC');
    73	
    74	        // 出荷指示番号
    75	        if (!empty($searchData['standby_id'])) {
    76	            $qb->andWhere('s.id = :standbyId')
    77	                ->setParameter('standbyId', $searchData['standby_id']);
    78	        }
    79	
    80	        // 注文番号
    81	        if (!empty($searchData['order_id'])) {
    82	            $qb->join('s.Orders', 'o_filter')
    83	                ->andWhere('o_filter.id = :orderId')
    84	                ->setParameter('orderId', $searchData['order_id']);
    85	        }
    86	
    87	        // 登録日From
    88	        if (!empty($searchData['create_date_from'])) {
    89	            $qb->andWhere('s.createDate >= :cdf')
    90	                ->setParameter('cdf', $searchData['create_date_from']);
    91	        }
    92	
    93	        // 登録日To
    94	        if (!empty($searchData['create_date_to'])) {
    95	            $qb->andWhere('s.createDate <= :cdt')
    96	                ->setParameter('cdt', $searchData['create_date_to']);
    97	        }
    98	
    99	        // 更新日From
   100	        if (!empty($searchData['update_date_from'])) {
   101	            $qb->andWhere('s.updateDate >= :udf')
   102	                ->setParameter('udf', $searchData['update_date_from']);
   103	        }
   104	
   105	        // 更新日To
   106	        if (!empty($searchData['update_date_to'])) {
   107	            $qb->andWhere('s.updateDate <= :udt')
   108	                ->setParameter('udt', $searchData['update_date_to']);
   109	        }
   110	
   111	        // 受注タイプ
   112	        if (!empty($searchData['order_type']) && is_array($searchData['order_type'])) {
   113	            $ids = [];
   114	            foreach ($searchData['order_type'] as $mt) {
   115	                if ($mt instanceof MtbOrderType) {
   116	                    $ids[] = $mt->getId();
   117	                }
   118	            }
   119	            if ($ids !== []) {
   120	                $qb->andWhere($qb->expr()->in('IDENTITY(s.OrderType)', ':otIds'))
   121	                    ->setParameter('otIds', $ids);
   122	            }
   123	        }
   124	
   125	        return $qb;
   126	    }
