{% extends '@admin/default_frame.twig' %}

{% set menus = ['data_management', 'holiday_management'] %}

{% block title %}{{ 'admin.data.holiday_management'|trans }}{% endblock %}
{% block sub_title %}{{ 'admin.data.data_management'|trans }}{% endblock %}

{% form_theme form '@admin/Form/bootstrap_4_horizontal_layout.html.twig' %}
{% form_theme loadForm '@admin/Form/bootstrap_4_horizontal_layout.html.twig' %}

{% block stylesheet %}
    <style>
        .c-contentsArea {
            position: relative;
        }
        .holiday-add-toggle {
            position: absolute;
            right: 1rem;
            top: 0.8rem;
            z-index: 2;
        }
        .holiday-add-toggle .btn {
            font-size: 0.9rem;
            padding: 0.4rem 0.8rem;
            min-width: 6.6rem;
            display: inline-flex;
            align-items: center;
            justify-content: center;
        }
        .holiday-card-header {
            border-bottom: 1px solid var(--bs-border-color);
        }
        .holiday-card-footer {
            background-color: #f5f5f5;
            text-align: center;
            border-top: 1px solid var(--bs-border-color);
            border-bottom: 1px solid var(--bs-border-color);
        }
        .holiday-table th,
        .holiday-table td {
            border-color: var(--bs-border-color);
        }
        .holiday-table {
            border-top: 1px solid var(--bs-border-color);
        }
        .holiday-table thead th + th,
        .holiday-table tbody td + td {
            border-left: 1px solid var(--bs-border-color);
        }
        .holiday-table.table-striped > tbody > tr:nth-of-type(odd) > * {
            --bs-table-bg-type: #ffffff;
            background-color: #ffffff;
        }
        .holiday-table.table-striped > tbody > tr:nth-of-type(even) > * {
            --bs-table-bg-type: #f7f7f7;
            background-color: #f7f7f7;
        }
    </style>
{% endblock %}

{% block javascript %}
    <script nonce="{{ csp_nonce }}">
        $(function () {
            const $toggleButton = $('#holidayAddToggle');
            const $addForm = $('#holidayAddForm');
            const $showLabel = $toggleButton.find('.toggle-label--expand');
            const $hideLabel = $toggleButton.find('.toggle-label--collapse');

            const syncLabel = (isOpen) => {
                $showLabel.toggleClass('d-none', isOpen);
                $hideLabel.toggleClass('d-none', !isOpen);
                $toggleButton.attr('aria-expanded', isOpen ? 'true' : 'false');
            };

            syncLabel($addForm.hasClass('show'));
            $addForm.on('shown.bs.collapse', () => syncLabel(true));
            $addForm.on('hidden.bs.collapse', () => syncLabel(false));
        });
    </script>
{% endblock %}

{% block main %}
    <div class="c-contentsArea__cols">
        <div class="c-contentsArea__primaryCol">
            <div class="c-primaryCol">
                {% set addFormExpanded = form.vars.submitted and not form.vars.valid %}
                <div id="holidayAddToggleWrapper" class="holiday-add-toggle">
                    <button class="btn btn-primary" type="button" id="holidayAddToggle"
                            data-bs-toggle="collapse"
                            data-bs-target="#holidayAddForm"
                            aria-expanded="{{ addFormExpanded ? 'true' : 'false' }}"
                            aria-controls="holidayAddForm">
                        <span class="toggle-label--expand">{{ 'admin.data.holiday.add_button'|trans }}</span>
                        <span class="toggle-label--collapse d-none">{{ 'admin.common.back'|trans }}</span>
                    </button>
                </div>

                <div class="collapse {{ addFormExpanded ? 'show' : '' }} mb-4" id="holidayAddForm">
                    {{ form_start(form) }}
                    <div class="row mb-2 align-items-stretch gx-2 holiday-add-form" id="aside_wrap">
                            <div class="col-md-9">
                                <div class="card border-0 h-100">
                        <div class="card-header holiday-card-header">
                            {{ 'admin.data.holiday.add_title'|trans }}
                        </div>
                                <div class="card-body">
                                        <div class="row g-3 align-items-center">
                                            <div class="col-4 px-2">
                                                {{ form_widget(form.name) }}
                                                {{ form_errors(form.name) }}
                                            </div>
                                            <div class="col-4 px-2">
                                                {{ form_widget(form.date) }}
                                                {{ form_errors(form.date) }}
                                            </div>
                                        </div>
                                </div>
                            </div>
                        </div>
                            <div class="col-md-3" id="aside_column">
                                <div class="card border-0 h-100">
                                    <div class="card-body d-flex align-items-center">
                                        <button class="btn btn-ec-conversion w-100 h-100" type="submit">
                                            {{ 'admin.data.holiday.add_submit'|trans }}
                                        </button>
                                    </div>
                            </div>
                        </div>
                    </div>
                    {{ form_end(form) }}
                </div>

                {{ form_start(loadForm) }}
                <div class="row mb-4 align-items-stretch gx-2" id="aside_wrap">
                    <div class="col-md-9">
                        <div class="card border-0 h-100">
                            <div class="card-body">
                                <div class="row g-3 align-items-center">
                                    <div class="col px-2">
                                        {{ form_widget(loadForm.start_date) }}
                                        {{ form_errors(loadForm.start_date) }}
                                    </div>
                                    <div class="col-auto text-center">～</div>
                                    <div class="col px-2">
                                        {{ form_widget(loadForm.end_date) }}
                                        {{ form_errors(loadForm.end_date) }}
                                    </div>
                                </div>
                            </div>
                            <div class="card-footer holiday-card-footer">
                                {{ 'admin.data.holiday.bulk_addition'|trans }}
                            </div>
                        </div>
                    </div>
                    <div class="col-md-3" id="aside_column">
                        <div class="card border-0 h-100">
                            <div class="card-body d-flex align-items-center">
                                <button class="btn btn-ec-conversion w-100 h-100" type="submit">
                                    {{ 'admin.data.holiday.load_submit'|trans }}
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
                {{ form_end(loadForm) }}

                <div class="card rounded border-0">
                    <div class="card-body">
                        <div class="table-responsive with-border">
                            <table class="table table-striped holiday-table">
                                <thead>
                                    <tr>
                                        <th>{{ 'admin.data.holiday.name'|trans }}</th>
                                        <th class="text-nowrap">{{ 'admin.data.holiday.date'|trans }}</th>
                                        <th class="text-nowrap">{{ 'admin.common.delete'|trans }}</th>
                                    </tr>
                                </thead>
                                <tbody>
                                {% for Holiday in HolidayList %}
                                    <tr>
                                        <td>{{ Holiday.name }}</td>
                                        <td>{{ Holiday.date|date('Y/m/d') }}</td>
                                        <td class="text-center align-middle">
                                            <a href="{{ path('admin_data_holiday_delete', { id: Holiday.id }) }}"
                                               {{ csrf_token_for_anchor() }}
                                               data-method="delete"
                                               data-message="{{ 'admin.data.holiday.delete_confirm'|trans }}">
                                                {{ 'admin.common.delete'|trans }}
                                            </a>
                                        </td>
                                    </tr>
                                {% endfor %}
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
{% endblock %}
