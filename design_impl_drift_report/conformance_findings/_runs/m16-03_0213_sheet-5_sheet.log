   138	use Eccube\Service\EntityManager\HolidayEntityManager;
   139	use Yasumi\Holiday;
   140	use Yasumi\ProviderInterface;
   141	use Yasumi\Yasumi;
   142	
   143	class HolidayLoadAction
   144	{
   145	    public function __construct(
   146	        private readonly EntityManagerInterface $entityManager,
   147	        private readonly HolidayEntityManager $holidayEntityManager,
   148	        private readonly HolidayDateNormalizer $holidayDateNormalizer,
   149	        private readonly MtbHolidayRepository $holidayRepository,
   150	        private readonly DtbEventDetailRepository $eventDetailRepository,
   151	    ) {
   152	    }
   153	
   154	    /**
   155	     * @return array{addedCount: int, skippedDates: string[]}
   156	     */
   157	    public function handle(HolidayLoadInput $input): array
   158	    {
   159	        $startDate = $this->holidayDateNormalizer->normalize($input->getStartDate());
   160	        $endDate = $this->holidayDateNormalizer->normalize($input->getEndDate());
   161	
   162	        $addedCount = 0;
   163	        $skippedDates = [];
   164	        $existingDateKeys = array_flip($this->holidayRepository->getDateKeysByRange($startDate, $endDate));
   165	
   166	        $this->entityManager->beginTransaction();
   167	
   168	        try {
   169	            $years = range((int) $startDate->format('Y'), (int) $endDate->format('Y'));
   170	            foreach ($years as $year) {
   171	                $provider = Yasumi::create('Japan', $year, 'ja_JP');
   172	                $periodStart = $year === (int) $startDate->format('Y')
   173	                    ? $startDate
   174	                    : new \DateTimeImmutable($year.'-01-01');
   175	                $periodEnd = $year === (int) $endDate->format('Y')
   176	                    ? $endDate
   177	                    : new \DateTimeImmutable($year.'-12-31');
   178	
   179	                foreach ($this->getHolidayIterator($provider) as $HolidayData) {
   180	                    $holidayDate = $this->holidayDateNormalizer->normalize(
   181	                        \DateTimeImmutable::createFromInterface($HolidayData)
   182	                    );
   183	                    if ($holidayDate < $periodStart || $holidayDate > $periodEnd) {
   184	                        continue;
   185	                    }
   186	
   187	                    $dateKey = $holidayDate->format('Y-m-d');
   188	                    if (isset($existingDateKeys[$dateKey])) {
   189	                        $skippedDates[] = (new \DateTimeImmutable($dateKey))->format('Y/m/d');
   190	                        continue;
   191	                    }
   192	
   193	                    $storeDate = new \DateTimeImmutable($dateKey);
   194	                    $Holiday = $this->holidayEntityManager->save(null, $storeDate, $HolidayData->getName());
   195	                    $this->setHolidayFlgs($Holiday->getDate(), true);
   196	                    $addedCount++;
   197	                    $existingDateKeys[$dateKey] = true;
   198	                }
   199	            }
   200	
   201	            $this->entityManager->flush();
   202	            $this->entityManager->commit();
   203	        } catch (\Exception $e) {
   204	            $this->entityManager->rollback();
   205	
   206	            throw $e;
   207	        }
   208	
   209	        return [
   210	            'addedCount' => $addedCount,
   211	            'skippedDates' => $skippedDates,
   212	        ];
   213	    }
   214	
   215	    /**
   216	     * @return \ArrayIterator<int|string, Holiday>
   217	     */
   218	    private function getHolidayIterator(ProviderInterface $provider): \ArrayIterator
   219	    {
   220	        /** @var \ArrayIterator<int|string, Holiday> $Iterator */
   221	        $Iterator = $provider->getIterator();
   222	
   223	        return $Iterator;
   224	    }
   225	
   226	    private function setHolidayFlgs(\DateTimeInterface $day, bool $flag): void
   227	    {
   228	        $targetDate = \DateTime::createFromInterface($day);
   229	        $EventDetails = $this->eventDetailRepository->getDetailsOfADay($targetDate);
   230	        foreach ($EventDetails as $EventDetail) {
   231	            $EventDetail->setHolidayFlg($flag);
   232	            $this->entityManager->persist($EventDetail);
   233	        }
   234	    }
   235	}
