namespace Eccube\Form\Type\Admin;

use Eccube\Repository\Master\MtbHolidayRepository;
use Symfony\Component\Form\AbstractType;
use Symfony\Component\Form\Extension\Core\Type\DateType;
use Symfony\Component\Form\Extension\Core\Type\TextType;
use Symfony\Component\Form\FormBuilderInterface;
use Symfony\Component\OptionsResolver\OptionsResolver;
use Symfony\Component\Validator\Constraints as Assert;
use Symfony\Component\Validator\Context\ExecutionContextInterface;

class HolidayAddType extends AbstractType
{
    public function __construct(
        private readonly MtbHolidayRepository $holidayRepository,
    ) {
    }

    /**
     * @param array<string, mixed> $options
     */
    #[\Override]
    public function buildForm(FormBuilderInterface $builder, array $options): void
    {
        $builder
            ->add('name', TextType::class, [
                'label' => 'admin.data.holiday.name',
                'required' => true,
                'attr' => [
                    'maxlength' => 64,
                    'placeholder' => 'admin.data.holiday.name_placeholder',
                ],
                'constraints' => [
                    new Assert\NotBlank([
                        'message' => 'admin.data.holiday.name_required',
                    ]),
                    new Assert\Length([
                        'max' => 64,
                        'maxMessage' => 'admin.data.holiday.name_max',
                    ]),
                ],
            ])
            ->add('date', DateType::class, [
                'label' => 'admin.data.holiday.date',
                'required' => true,
                'input' => 'datetime',
                'widget' => 'single_text',
                'placeholder' => ['year' => '----', 'month' => '--', 'day' => '--'],
                'constraints' => [
                    new Assert\NotBlank([
                        'message' => 'admin.data.holiday.date_required',
                    ]),
                    new Assert\Callback(function (mixed $value, ExecutionContextInterface $context): void {
                        if (!$value instanceof \DateTimeInterface) {
                            return;
                        }

                        if ($this->holidayRepository->existsByDate($value)) {
                            $context->buildViolation('admin.data.holiday.overlap')->addViolation();
                        }
                    }),
                ],
            ]);
    }

    #[\Override]
    public function configureOptions(OptionsResolver $resolver): void
    {
        $resolver->setDefaults([]);
    }
}
