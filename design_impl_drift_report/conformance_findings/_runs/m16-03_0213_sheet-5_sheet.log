namespace Eccube\Controller\Admin\Data;

use Eccube\Controller\AbstractController;
use Eccube\Entity\Master\MtbHoliday;
use Eccube\Form\Type\Admin\HolidayAddType;
use Eccube\Form\Type\Admin\HolidayLoadType;
use Eccube\Repository\Master\MtbHolidayRepository;
use Eccube\Service\Admin\Data\ActionInput\HolidayLoadInput;
use Eccube\Service\Admin\Data\HolidayAddAction;
use Eccube\Service\Admin\Data\HolidayDeleteAction;
use Eccube\Service\Admin\Data\HolidayLoadAction;
use Symfony\Bridge\Twig\Attribute\Template;
use Symfony\Component\HttpFoundation\RedirectResponse;
use Symfony\Component\HttpFoundation\Request;
use Symfony\Component\Routing\Attribute\Route;

class HolidayController extends AbstractController
{
    public function __construct(
        private readonly MtbHolidayRepository $holidayRepository,
        private readonly HolidayAddAction $holidayAddAction,
        private readonly HolidayDeleteAction $holidayDeleteAction,
        private readonly HolidayLoadAction $holidayLoadAction,
    ) {
    }

    /**
     * @return array<string, mixed>|RedirectResponse
     */
    #[Route(path: '/%eccube_admin_route%/data/holiday', name: 'admin_data_holiday', methods: ['GET', 'POST'])]
    #[Template(template: '@admin/Data/holiday.twig')]
    public function index(Request $request): array|RedirectResponse
    {
        $Holiday = new MtbHoliday();
        $form = $this->formFactory->createBuilder(HolidayAddType::class, $Holiday)->getForm();
        $loadForm = $this->formFactory->createBuilder(HolidayLoadType::class)->getForm();

        $form->handleRequest($request);
        $loadForm->handleRequest($request);

        if ($request->isMethod('POST') && $loadForm->isSubmitted()) {
            if (!$loadForm->isValid()) {
                foreach ($loadForm->getErrors(true) as $error) {
                    if ($error->getMessageTemplate() === 'admin.data.holiday.range_invalid') {
                        $this->addError('admin.data.holiday.range_invalid', 'admin');

                        return $this->redirectToRoute('admin_data_holiday');
                    }
                }

                $this->addError('admin.register.failed', 'admin');

                return $this->redirectToRoute('admin_data_holiday');
            }

            $startDate = $loadForm->get('start_date')->getData();
            $endDate = $loadForm->get('end_date')->getData();

            if (!$startDate instanceof \DateTimeInterface || !$endDate instanceof \DateTimeInterface) {
                return $this->redirectToRoute('admin_data_holiday');
            }

            $result = $this->holidayLoadAction->handle(new HolidayLoadInput($startDate, $endDate));

            foreach ($result['skippedDates'] as $skippedDate) {
                $this->addWarning(
                    str_replace('%date%', $skippedDate, trans('admin.data.holiday.skip_holiday')),
                    'admin'
                );
            }

            if ($result['addedCount'] > 0) {
                $this->addSuccess(
                    str_replace('%count%', (string) $result['addedCount'], trans('admin.data.holiday.load_complete')),
                    'admin'
                );
            } else {
                $this->addError('admin.data.holiday.no_holidays', 'admin');
            }

            return $this->redirectToRoute('admin_data_holiday');
        }

        if ($request->isMethod('POST') && $form->isSubmitted()) {
            if (!$form->isValid()) {
                foreach ($form->getErrors(true) as $error) {
                    if ($error->getMessageTemplate() === 'admin.data.holiday.overlap') {
                        $this->addError('admin.data.holiday.overlap', 'admin');

                        return $this->redirectToRoute('admin_data_holiday');
                    }
                }

                $this->addError('admin.register.failed', 'admin');

                return $this->redirectToRoute('admin_data_holiday');
            }

            $date = $form->get('date')->getData();
            $name = $form->get('name')->getData();

            if (!$date instanceof \DateTimeInterface) {
                return $this->redirectToRoute('admin_data_holiday');
            }

            $this->holidayAddAction->handle($date, is_string($name) ? $name : null);
            $this->addSuccess('admin.register.complete', 'admin');

            return $this->redirectToRoute('admin_data_holiday');
        }

        $HolidayList = $this->holidayRepository->findBy([], ['date' => 'ASC']);

        return [
            'form' => $form->createView(),
            'loadForm' => $loadForm->createView(),
            'HolidayList' => $HolidayList,
        ];
    }

    #[Route(path: '/%eccube_admin_route%/data/holiday/{id}/delete', name: 'admin_data_holiday_delete', requirements: ['id' => '\\d+'], methods: ['DELETE'])]
    public function delete(MtbHoliday $Holiday): RedirectResponse
    {
        $this->isTokenValid();

        try {
            $this->holidayDeleteAction->handle($Holiday);
            $this->addSuccess('admin.common.delete_complete', 'admin');
        } catch (\Exception) {
            $this->addError('admin.common.delete_error', 'admin');
        }

        return $this->redirectToRoute('admin_data_holiday');
    }
}
