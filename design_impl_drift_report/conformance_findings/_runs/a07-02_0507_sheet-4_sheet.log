   732	        );
   733	        $conn->executeStatement(
   734	            'UPDATE dtb_buy_order_indivisual_input_product SET sale_flg = TRUE WHERE buy_order_id = :id',
   735	            ['id' => $id]
   736	        );
   737	    }
