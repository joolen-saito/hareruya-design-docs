   726	    public function updateBulkSell(int $id): void
   727	    {
   728	        $conn = $this->getEntityManager()->getConnection();
   729	        $conn->executeStatement(
   730	            'UPDATE dtb_buy_main_card SET sale_flg = TRUE WHERE buy_order_id = :id',
