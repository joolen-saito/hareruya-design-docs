   153	/**
   154	 * JWTトークンの生成・検証を行うサービス
   155	 */
   156	class JwtTokenService
   157	{
   158	    private JWSSerializerManager $serializerManager;
   159	    private JWSBuilder $jwsBuilder;
   160	    private JWSVerifier $jwsVerifier;
   161	    private ?JWK $secretKey = null;
   162	
   163	    public function __construct(
   164	        private readonly string $jwtSecret,
   165	    ) {
   166	        $algorithmManager = new AlgorithmManager([new HS256()]);
   167	        $this->serializerManager = new JWSSerializerManager([new CompactSerializer()]);
   168	        $this->jwsBuilder = new JWSBuilder($algorithmManager);
   169	        $this->jwsVerifier = new JWSVerifier($algorithmManager);
   170	
   171	        $this->initializeKey();
   172	    }
   173	
   174	    /**
   175	     * シークレットキーを初期化する
   176	     */
   177	    private function initializeKey(): void
   178	    {
   179	        if ($this->jwtSecret === '') {
   180	            return;
   181	        }
   182	
   183	        $rawSecret = base64_decode($this->jwtSecret, true);
   184	        if ($rawSecret === false) {
   185	            throw new \RuntimeException('JWT_SECRET must be a valid base64 encoded string.');
   186	        }
   187	
   188	        $this->secretKey = JWKFactory::createFromSecret($rawSecret);
   189	    }
   190	
   191	    /**
   192	     * JWTトークンを生成する
   193	     *
   194	     * @param int $memberId Member ID
   195	     *
   196	     * @return string JWTトークン
   197	     */
   198	    public function createToken(int $memberId): string
   199	    {
   200	        if ($this->secretKey === null) {
   201	            throw new \RuntimeException('JWT secret is not configured. Please set JWT_SECRET.');
   202	        }
   203	
   204	        $payload = json_encode([
   205	            'sub' => (string) $memberId,
   206	        ], JSON_THROW_ON_ERROR);
   207	
   208	        $jws = $this->jwsBuilder
   209	            ->create()
   210	            ->withPayload($payload)
   211	            ->addSignature($this->secretKey, ['alg' => 'HS256'])
   212	            ->build();
   213	
   214	        return $this->serializerManager->serialize('jws_compact', $jws, 0);
   215	    }
