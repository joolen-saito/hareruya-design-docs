   125	
   126	    /**
   127	     * 承認フローがある履歴かどうかを判定する.
   128	     */
   129	    private function hasApprovalFlow(DtbStockHistory $StockHistory): bool
   130	    {
   131	        $sourceTypeId = $StockHistory->getHistorySourceType()?->getId();
