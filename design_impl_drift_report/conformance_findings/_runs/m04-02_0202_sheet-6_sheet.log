    27	class StockChangeHistoryListBuilder
    28	{
    29	    private const DISPLAY_LIMIT = 30;
    30	
    31	    private const APPROVAL_FLOW_SOURCE_TYPE_IDS = [
    32	        MtbStockHistorySourceType::STOCK_EDIT,
    33	        MtbStockHistorySourceType::STOCK_BULK_EDIT,
