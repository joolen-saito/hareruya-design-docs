   210	
   211	    /**
   212	     * 承認者名を表示用文字列に変換する.
   213	     */
   214	    private function resolveApprovalMemberDisplay(DtbStockHistory $StockHistory, bool $hasApprovalFlow): string
   215	    {
   216	        $ApprovalMember = $StockHistory->getApprovalMember();
   217	        if ($ApprovalMember !== null && $ApprovalMember->getName() !== '') {
   218	            return $ApprovalMember->getName();
   219	        }
   220	
   221	        if ($hasApprovalFlow && $StockHistory->getHistorySourceId() !== null) {
   222	            return $this->translator->trans('admin.stock.approval_list.approval_waiting');
   223	        }
   224	
   225	        return '-';
   226	    }
   227	
   228	    /**
   229	     * 一覧の並び順に使う日時を、承認日時 → 登録日時 → 作成日時 の優先順で取得する.
   230	     */
   231	    private function resolveSortDate(DtbStockHistory $StockHistory): \DateTimeInterface
   232	    {
   233	        return $StockHistory->getApprovalAt()
   234	            ?? $StockHistory->getRegisteredAt()
   235	            ?? $StockHistory->getCreateDate()
   236	            ?? new \DateTime();
   237	    }
   238	}

