    25	
    26	class StockApprovalHistoryReasonUpdateAction
    27	{
    28	    public function __construct(
    29	        private readonly DtbStockHistoryRepository $stockHistoryRepository,
    30	        private readonly DtbStockEditApprovalDetailRepository $stockEditApprovalDetailRepository,
    31	        private readonly EntityManagerInterface $entityManager,
    32	    ) {
    33	    }
    34	
    35	    /**
    36	     * 在庫変動履歴または承認待ち入庫詳細の在庫変動理由を更新する
    37	     */
    38	    public function handle(StockApprovalHistoryReasonUpdateInput $input): ?DtbStockHistory
    39	    {
    40	        // 在庫変動履歴の場合
    41	        if ($input->stockHistoryId !== null) {
    42	            return $this->updateStockHistoryReason($input);
    43	        }
    44	
    45	        // 承認待ち入庫詳細の場合
    46	        if ($input->stockEditApprovalDetailId !== null) {
    47	            $this->updatePendingInboundDetailReason($input);
    48	
    49	            // 在庫変動履歴がまだ存在しないため、null を返す
    50	            return null;
    51	        }
    52	
    53	        throw new \InvalidArgumentException('更新対象の在庫変動理由が指定されていません。');
    54	    }
    55	
    56	    private function updateStockHistoryReason(StockApprovalHistoryReasonUpdateInput $input): DtbStockHistory
    57	    {
    58	        $StockHistory = $this->stockHistoryRepository->find($input->stockHistoryId);
    59	        if ($StockHistory === null) {
    60	            throw new \InvalidArgumentException('在庫履歴が見つかりません。');
    61	        }
    62	
    63	        if ($StockHistory->getProductStock()->getId() !== $input->ProductStock->getId()) {
    64	            throw new \InvalidArgumentException('在庫履歴が別の在庫を参照しているため編集できません。');
    65	        }
    66	
    67	        if (!$StockHistory->isStockChangeReasonEditable()) {
    68	            throw new \InvalidArgumentException('在庫変動理由を編集できない在庫変動履歴です。');
    69	        }
    70	
    71	        $StockHistory->setStockChangeReason($input->stockChangeReason);
    72	        $StockHistory->setUpdateMember($input->Member);
    73	        $StockHistory->setUpdateDate(new \DateTime());
    74	        $this->entityManager->flush();
    75	
    76	        return $StockHistory;
    77	    }
    78	
    79	    private function updatePendingInboundDetailReason(StockApprovalHistoryReasonUpdateInput $input): void
    80	    {
    81	        $StockEditApprovalDetail = $this->stockEditApprovalDetailRepository->find($input->stockEditApprovalDetailId);
    82	        if ($StockEditApprovalDetail === null) {
    83	            throw new \InvalidArgumentException('在庫編集詳細が見つかりません。');
    84	        }
    85	
    86	        if ($StockEditApprovalDetail->getProductStock()->getId() !== $input->ProductStock->getId()) {
    87	            throw new \InvalidArgumentException('在庫編集詳細が別の在庫を参照しているため編集できません。');
    88	        }
    89	
    90	        if (!$this->isPendingInboundDetailReasonEditable($StockEditApprovalDetail)) {
    91	            throw new \InvalidArgumentException('在庫変動理由を編集できない在庫編集詳細です。');
    92	        }
    93	
    94	        $StockEditApprovalDetail->setStockChangeReason($input->stockChangeReason);
    95	        $StockEditApprovalDetail->setMember($input->Member);
    96	        $StockEditApprovalDetail->setUpdateDate(new \DateTime());
    97	        $this->entityManager->flush();
    98	    }
    99	
   100	    private function isPendingInboundDetailReasonEditable(DtbStockEditApprovalDetail $StockEditApprovalDetail): bool
   101	    {
   102	        $StockEditApproval = $StockEditApprovalDetail->getStockEditApproval();
   103	
   104	        if ($StockEditApproval->getApprovalStatus() !== DtbStockEditApproval::APPROVAL_STATUS_UNAPPROVED) {
   105	            return false;
   106	        }
   107	
   108	        if (!$StockEditApproval->getStockChangeTypeDetail()->isTypeBeStocked()) {
   109	            return false;
   110	        }
   111	
   112	        return true;
   113	    }
   114	}

