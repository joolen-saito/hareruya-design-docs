   102	    private function buildFromPendingApprovalDetail(DtbStockEditApprovalDetail $Detail): StockChangeHistoryDisplayRow
   103	    {
   104	        $StockEditApproval = $Detail->getStockEditApproval();
   105	        $StockChangeTypeDetail = $StockEditApproval->getStockChangeTypeDetail();
   106	        $baseReason = $Detail->getStockChangeReason() ?? '';
   107	
   108	        return new StockChangeHistoryDisplayRow(
   109	            stockHistoryId: null,
   110	            stockEditApprovalDetailId: $Detail->getId(),
   111	            oldStockDisplay: '-',
   112	            newStockDisplay: '-',
   113	            stockChangeQuantityDisplay: (string) $Detail->getEditQuantity(),
   114	            changeTypeDetailLabel: $this->formatChangeTypeDetailLabel($StockChangeTypeDetail),
   115	            stockChangeReasonDisplay: $this->stockChangeReasonDisplayBuilder->build($baseReason, null),
   116	            stockChangeReasonForEdit: $baseReason,
   117	            isReasonEditable: true,
   118	            registeredAt: $StockEditApproval->getRegisteredAt(),
   119	            registeredMemberName: $StockEditApproval->getRegisteredMember()->getName(),
   120	            approvalDateDisplay: '-',
   121	            approvalMemberDisplay: $this->translator->trans('admin.stock.approval_list.approval_waiting'),
   122	            sortDate: $StockEditApproval->getRegisteredAt(),
