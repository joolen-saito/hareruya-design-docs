   321	
   322	        // 在庫変動理由の編集モードを終了する前に、編集前の内容を復元する
   323	        function restoreReasonEditSnapshot($reasonEditContainer, $reasonDisplay, $reasonTextarea) {
   324	            const originalDisplayHtml = $reasonEditContainer.data('original-display-html');
   325	            const originalTextareaVal = $reasonEditContainer.data('original-textarea-val');
   326	            if (typeof originalDisplayHtml === 'string') {
   327	                $reasonDisplay.html(originalDisplayHtml);
   328	            }
   329	            if (typeof originalTextareaVal === 'string') {
   330	                $reasonTextarea.val(originalTextareaVal);
   331	            }
   332	            exitReasonEditMode($reasonEditContainer, $reasonDisplay, $reasonTextarea);
   333	        }
   334	
   335	        // 在庫変動理由の編集モード切り替えを行う
   336	        const saveErrorMsg = {{ 'admin.common.save_error'|trans|json_encode|raw }};
   337	        $(document).on('click', '.stock-change-history-reason-form .js-reason-edit-toggle, .stock-change-history-reason-form .js-reason-edit-toggle *', function(e) {
   338	            e.preventDefault();
   339	            e.stopPropagation();
   340	
   341	            // 編集モード切り替え対象のトグルボタンを取得
   342	            const $toggle = $(this).closest('.js-reason-edit-toggle');
   343	            if ($toggle.length === 0) {
   344	                return;
   345	            }
   346	
   347	            // 編集モード切り替え対象のコンテナを取得
   348	            const $reasonEditContainer = $toggle.closest('.editable-container');
   349	            const $reasonForm = $toggle.closest('form');
   350	            if ($reasonForm.length === 0 || $reasonForm.closest('.stock-change-history-reason-form').length === 0) {
   351	                return;
   352	            }
   353	            if ($reasonEditContainer.hasClass('is-saving')) {
   354	                return;
   355	            }
   356	
   357	            const $reasonDisplay = $reasonEditContainer.find('.text-display');
   358	            const $reasonTextarea = $reasonEditContainer.find('.edit-area');
   359	            const isReasonEditMode = $reasonEditContainer.hasClass('is-editing');
   360	
   361	            // 編集モード切り替え対象のコンテナが編集モードではない場合は編集モードに切り替える
   362	            if (!isReasonEditMode) {
   363	                $reasonEditContainer.data('original-display-html', $reasonDisplay.html());
   364	                $reasonEditContainer.data('original-textarea-val', $reasonTextarea.val());
   365	                $reasonEditContainer.addClass('is-editing');
   366	                $reasonTextarea.show().focus();
   367	                return;
   368	            }
   369	
   370	            // 編集モード切り替え対象のコンテナが編集モードである場合は編集モードを終了する
   371	            const pendingReason = $reasonTextarea.val();
   372	            $reasonDisplay.html(renderReasonTextAsHtml(pendingReason));
   373	            exitReasonEditMode($reasonEditContainer, $reasonDisplay, $reasonTextarea);
   374	            $reasonEditContainer.addClass('is-saving');
   375	            setReasonEditToggleLoading($toggle, true);
   376	
   377	            // 在庫変動理由の更新
   378	            $.ajax({
   379	                url: $reasonForm.attr('action'),
   380	                type: 'POST',
   381	                data: $reasonForm.serialize(),
   382	                dataType: 'json',
   383	                headers: {
   384	                    'X-Requested-With': 'XMLHttpRequest',
   385	                },
   386	            }).done(function(response) {
   387	                if (response.success) {
   388	                    const displayText = response.stock_change_reason_display || pendingReason;
   389	                    const savedReason = response.stock_change_reason || pendingReason;
   390	                    $reasonDisplay.html(renderReasonTextAsHtml(displayText));
   391	                    $reasonTextarea.val(savedReason);
   392	                    $reasonEditContainer.data('original-display-html', $reasonDisplay.html());
   393	                    $reasonEditContainer.data('original-textarea-val', savedReason);
   394	                    $('#stockChangeHistory .card-body').find('.js-stock-change-history-alert').remove();
   395	                } else {
   396	                    // 在庫変動理由の更新失敗時は編集モードを終了し、編集前の内容を復元する
   397	                    restoreReasonEditSnapshot($reasonEditContainer, $reasonDisplay, $reasonTextarea);
   398	                    showStockChangeHistoryAlert(response.message || saveErrorMsg, true);
   399	                }
   400	            }).fail(function(xhr) {
   401	                // 在庫変動理由の更新失敗時は編集モードを終了し、編集前の内容を復元する
   402	                restoreReasonEditSnapshot($reasonEditContainer, $reasonDisplay, $reasonTextarea);
   403	                let message = saveErrorMsg;
   404	                if (xhr.responseJSON && xhr.responseJSON.message) {
   405	                    message = xhr.responseJSON.message;
   406	                }
   407	                showStockChangeHistoryAlert(message, true);
   408	            }).always(function() {
   409	                // 在庫変動理由の更新完了時は編集モードを終了し、ローディングアイコンを非表示にする
   410	                $reasonEditContainer.removeClass('is-saving');
   411	                setReasonEditToggleLoading($toggle, false);
   412	            });
   413	        });
   414	    });
   415	    </script>
