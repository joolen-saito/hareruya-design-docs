   180	            ->innerJoin('sa.StockChangeTypeDetail', 'sctd')->addSelect('sctd')
   181	            ->innerJoin('sctd.StockChangeType', 'sct')->addSelect('sct')
   182	            ->innerJoin('sad.ProductStock', 'ps')->addSelect('ps')
   183	            ->innerJoin('ps.ProductClass', 'pc')->addSelect('pc')
   184	            ->andWhere('sa.id = :stockEditApprovalId')
   185	            ->setParameter('stockEditApprovalId', $stockEditApprovalId)
   186	            ->orderBy('sad.id', 'ASC')
   187	            ->getQuery()
   188	            ->getResult();
