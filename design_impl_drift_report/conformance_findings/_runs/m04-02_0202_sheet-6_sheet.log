   140	     */
   141	    private function resolveStockDisplay(
   142	        DtbStockHistory $StockHistory,
   143	        bool $hasApprovalFlow,
   144	        bool $isApproved,
   145	        int $stock,
   146	    ): string {
   147	        // 承認フローがないか、すでに承認されている場合は在庫数をそのまま表示
   148	        if (!$hasApprovalFlow || $isApproved) {
