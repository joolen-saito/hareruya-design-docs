    44	
    45	    /**
    46	     * @return list<StockChangeHistoryDisplayRow>
    47	     */
    48	    public function build(ProductStock $ProductStock): array
    49	    {
    50	        $rows = [];
    51	
    52	        // 在庫履歴を取得
    53	        foreach ($this->stockHistoryRepository->findLatestByProductStockId($ProductStock->getId(), self::DISPLAY_LIMIT) as $StockHistory) {
    54	            $rows[] = $this->buildFromStockHistory($StockHistory);
    55	        }
    56	
    57	        // 承認待ちの入庫詳細を取得
    58	        foreach ($this->stockEditApprovalDetailRepository->findPendingInboundByProductStockId($ProductStock->getId()) as $Detail) {
    59	            $rows[] = $this->buildFromPendingApprovalDetail($Detail);
    60	        }
    61	
    62	        // 日時でソート
    63	        usort($rows, static function (StockChangeHistoryDisplayRow $a, StockChangeHistoryDisplayRow $b): int {
    64	            return $b->sortDate <=> $a->sortDate;
    65	        });
    66	
    67	        // リミットを超えた場合は切り捨てて返す
    68	        return array_slice($rows, 0, self::DISPLAY_LIMIT);
    69	    }
