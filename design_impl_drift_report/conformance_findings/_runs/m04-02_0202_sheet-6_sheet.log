    71	    /**
    72	     * 在庫履歴を表示用データに変換する.
    73	     */
    74	    private function buildFromStockHistory(DtbStockHistory $StockHistory): StockChangeHistoryDisplayRow
    75	    {
    76	        $hasApprovalFlow = $this->hasApprovalFlow($StockHistory);
    77	        $isApproved = $StockHistory->getApprovalAt() !== null;
    78	        $baseReason = $StockHistory->getStockChangeReason() ?? '';
    79	        $isReasonEditable = $StockHistory->isStockChangeReasonEditable();
    80	
    81	        return new StockChangeHistoryDisplayRow(
    82	            stockHistoryId: $StockHistory->getId(),
    83	            stockEditApprovalDetailId: null,
    84	            oldStockDisplay: $this->resolveStockDisplay($StockHistory, $hasApprovalFlow, $isApproved, $StockHistory->getOldStock()),
    85	            newStockDisplay: $this->resolveStockDisplay($StockHistory, $hasApprovalFlow, $isApproved, $StockHistory->getStock()),
    86	            stockChangeQuantityDisplay: (string) ($StockHistory->getStockChangeQuantity() ?? '-'),
    87	            changeTypeDetailLabel: $this->formatChangeTypeDetailLabel($StockHistory->getStockChangeTypeDetail()),
    88	            stockChangeReasonDisplay: $this->stockChangeReasonDisplayBuilder->build($baseReason, $StockHistory->getShortageReason()),
    89	            stockChangeReasonForEdit: $isReasonEditable ? $baseReason : null,
    90	            isReasonEditable: $isReasonEditable,
    91	            registeredAt: $StockHistory->getRegisteredAt() ?? $StockHistory->getCreateDate(),
    92	            registeredMemberName: $this->resolveRegisteredMemberName($StockHistory),
    93	            approvalDateDisplay: $this->formatApprovalDate($StockHistory->getApprovalAt()),
    94	            approvalMemberDisplay: $this->resolveApprovalMemberDisplay($StockHistory, $hasApprovalFlow),
    95	            sortDate: $this->resolveSortDate($StockHistory),
    96	        );
    97	    }
