   131	            MtbStockHistorySourceType::STOCK_EDIT,
   132	            MtbStockHistorySourceType::STOCK_BULK_EDIT,
   133	        ];
   134	
   135	        /** @var list<DtbStockEditApprovalDetail> $result */
   136	        $result = $this->createQueryBuilder('sad')
   137	            ->innerJoin('sad.StockEditApproval', 'sa')->addSelect('sa')
   138	            ->innerJoin('sa.StockChangeTypeDetail', 'sctd')->addSelect('sctd')
   139	            ->innerJoin('sctd.StockChangeType', 'sct')->addSelect('sct')
   140	            ->innerJoin('sa.RegisteredMember', 'rm')->addSelect('rm')
   141	            ->innerJoin(
   142	                DtbStockApprovalList::class,
   143	                'sal',
   144	                Join::WITH,
   145	                'sal.historySourceId = sa.id
   146	                AND sal.approvalStatus = :approvalListUnapproved
   147	                AND IDENTITY(sal.HistorySourceType) IN (:stockEditSourceTypeIds)'
   148	            )
   149	            ->leftJoin(
   150	                DtbStockHistory::class,
   151	                'sh',
   152	                Join::WITH,
   153	                'sh.historySourceId = sa.id
   154	                AND sh.ProductStock = sad.ProductStock
   155	                AND IDENTITY(sh.HistorySourceType) IN (:stockEditSourceTypeIds)'
   156	            )
   157	            ->andWhere('sad.ProductStock = :productStockId')
   158	            ->andWhere('sct.id = :beStockedTypeId')
   159	            ->andWhere('sh.id IS NULL')
   160	            ->setParameter('productStockId', $productStockId)
   161	            ->setParameter('beStockedTypeId', MtbStockChangeType::BE_STOCKED)
   162	            ->setParameter('approvalListUnapproved', DtbStockApprovalList::APPROVAL_STATUS_UNAPPROVED)
   163	            ->setParameter('stockEditSourceTypeIds', $stockEditSourceTypeIds)
   164	            ->getQuery()
   165	            ->getResult();
   166	
   167	        return $result;
   168	    }
