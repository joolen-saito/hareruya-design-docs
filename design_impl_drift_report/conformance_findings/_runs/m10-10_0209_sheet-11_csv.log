    47	            $('.move').click(function() {
    48	                var $op = $('#csv-output option:selected');
    49	                var val = $(this).data('value');
    50	                if ($op.length) {
    51	                    val == 'up' ? $op.first().prev().before($op) : $op.last().next().after($op);
    52	                }
    53	            });
    54	
    55	            $('.move-most').click(function() {
