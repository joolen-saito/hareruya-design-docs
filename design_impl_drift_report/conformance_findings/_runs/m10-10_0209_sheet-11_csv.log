    30	                $('#' + event.data.from + ' option:selected')
    31	                    .appendTo($('#' + event.data.to))
    32	                    .prop('selected', false);
    33	            }
    34	
    35	            function addAll(event) {
    36	                $('#' + event.data.from + ' option').each(function() {
    37	                    $(this).appendTo($('#' + event.data.to));
    38	                    $(this).prop('selected', false);// 選択状態の解除
    39	                });
    40	            }
