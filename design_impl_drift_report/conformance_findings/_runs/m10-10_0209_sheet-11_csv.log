    35	    /**
    36	     * CSV種別・有効フラグで dtb_csv を取得し、sort_no（表示順 rank）で並べ替える.
    37	     *
    38	     * @return Csv[]
    39	     */
    40	    public function findByCsvTypeIdAndEnabledOrderBySortNo(int $csvTypeId, bool $enabled, string $sort = 'DESC'): array
    41	    {
    42	        $CsvType = $this->getEntityManager()->getReference(CsvType::class, $csvTypeId);
    43	        $direction = strtoupper($sort) === 'ASC' ? 'ASC' : 'DESC';
    44	
    45	        return $this->createQueryBuilder('c')
    46	            ->where('c.CsvType = :csvType')
    47	            ->andWhere('c.enabled = :enabled')
    48	            ->setParameter('csvType', $CsvType)
    49	            ->setParameter('enabled', $enabled)
    50	            ->orderBy('c.sort_no', $direction)
    51	            ->getQuery()
    52	            ->getResult();
    53	    }
