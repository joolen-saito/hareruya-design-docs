    30	class DtbPointHistoryRepository extends AbstractRepository
    31	{
    32	    public function __construct(
    33	        ManagerRegistry $registry,
    34	        EccubeConfig $eccubeConfig,
    35	    ) {
    36	        $this->eccubeConfig = $eccubeConfig;
    37	        parent::__construct($registry, DtbPointHistory::class);
