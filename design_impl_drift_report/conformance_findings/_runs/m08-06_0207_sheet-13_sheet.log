    39	
    40	    /**
    41	     * 指定したスマレジ取引IDのポイント履歴が既に存在するか判定する.
    42	     *
    43	     * スマレジ取引由来のポイント付与の冪等性担保 (Webhook 再送・補完取得バッチでの重複付与防止) に使う。
    44	     */
    45	    public function existsByTransactionId(int $transactionId): bool
    46	    {
    47	        $count = (int) $this->createQueryBuilder('ph')
    48	            ->select('COUNT(ph.id)')
    49	            ->where('ph.transactionId = :transactionId')
    50	            ->setParameter('transactionId', $transactionId)
    51	            ->getQuery()
    52	            ->getSingleScalarResult();
    53	
    54	        return $count > 0;
    55	    }
    56	
    57	    /**
    58	     * 指定したスマレジ取引IDの「ポイント専用取引」(受注に紐付かない = order_id が NULL) のポイント履歴を取得する.
    59	     *
    60	     * 受注由来 (order_id 有り) のポイント履歴と区別し、ポイント専用取引 (取引区分6/7) の
    61	     * 取消/打消による差し戻し対象のみを抽出するために使う。
    62	     *
    63	     * @return list<DtbPointHistory>
    64	     */
    65	    public function findPointOnlyByTransactionId(int $transactionId): array
