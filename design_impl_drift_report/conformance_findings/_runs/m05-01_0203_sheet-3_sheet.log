   132	    /**
   133	     * @param list<Order>  $matchedOrders
   134	     * @param list<string> $matchedSmaregiCodes
   135	     */
   136	    private function createNewOrder(
   137	        TransactionDto $transaction,
   138	        array $matchedOrders,
   139	        array $matchedSmaregiCodes,
   140	        ?DtbPlayer $member,
   141	    ): Order {
   142	        $newOrder = $this->createShellWithCustomer($transaction, $matchedOrders, $member);
   143	        $baseInfo = $newOrder->getBaseInfo();
   144	
   145	        // 注文日: 設計どおり「最古の店頭受取注文日」を適用
   146	        $oldestOrderDate = $this->findOldestOrderDate($matchedOrders);
   147	        if ($oldestOrderDate !== null) {
   148	            $newOrder->setOrderDate($oldestOrderDate);
   149	        }
   150	
   151	        // (1) 既存受注の商品明細を複製して新規受注へ (複数受注なら全件統合)。
   152	        // 送料/手数料/値引/税/ポイント等の非商品行は引き継がない (まとめ商品を「解いた」商品明細のみが対象)。
   153	        // 金額は取引から直接設定されるため、ここで複製するのは内訳としての商品行に限定する。
   154	        foreach ($matchedOrders as $existingOrder) {
   155	            foreach ($existingOrder->getOrderItems() as $existingItem) {
