   571	    public function getQueryBuilderByCustomer(Customer $Customer): QueryBuilder
   572	    {
   573	        $this->getEntityManager()->getFilters()->enable('incomplete_order_status_hidden');
   574	        $qb = $this->createQueryBuilder('o')
   575	            ->where('o.Customer = :Customer')
