    72	    /**
    73	     * @param list<Order>  $matchedOrders        productCode で既存 EC-CUBE OTC 受注に突合した受注
    74	     * @param list<string> $matchedSmaregiCodes  matchedOrders から抽出した smaregi_code (ついで買い判定用)
    75	     * @param ?DtbPlayer   $member               取引の customerId から解決した Player (非会員/未解決時は null)
    76	     *
    77	     * @return list<Order> 更新/作成された Order の一覧 (既存受注... + 新規受注 1件)
    78	     */
    79	    public function handle(
    80	        TransactionDto $transaction,
    81	        array $matchedOrders,
    82	        array $matchedSmaregiCodes,
    83	        ?DtbPlayer $member = null,
    84	    ): array {
    85	        $passed = $this->orderStatusRepository->find(OrderStatus::PASSED);
    86	        if (!$passed instanceof OrderStatus) {
    87	            throw new \RuntimeException('OrderStatus PASSED is not found.');
    88	        }
    89	
    90	        if ($matchedOrders === []) {
    91	            $this->logger->warning('Smaregi OTC pattern (店頭受取/店頭PC購入) has no matched ECCUBE order, skipping', [
    92	                'transactionHeadId' => $transaction->transactionHeadId,
    93	            ]);
    94	
    95	            return [];
    96	        }
    97	
    98	        $newOrder = $this->createNewOrder($transaction, $matchedOrders, $matchedSmaregiCodes, $member);
    99	
   100	        // 既存受注由来の複製明細数 (ついで買い分との内訳ログ用)。
   101	        // 永続化結果に依存しないためトランザクション外で算出する。
   102	        $clonedItemCount = array_sum(array_map(
   103	            static fn (Order $o): int => $o->getOrderItems()->count(),
   104	            $matchedOrders,
   105	        ));
   106	
   107	        $this->entityManager->wrapInTransaction(function () use ($newOrder, $matchedOrders, $passed): void {
   108	            $this->entityManager->persist($newOrder);
   109	            foreach ($newOrder->getOrderItems() as $item) {
   110	                $this->entityManager->persist($item);
   111	            }
   112	            // 既存受注の next_order_id に入れる前に flush して新規受注 ID を確定させる
   113	            $this->entityManager->flush();
   114	
   115	            foreach ($matchedOrders as $existingOrder) {
   116	                $existingOrder->setOrderStatus($passed);
   117	                $existingOrder->setNextOrderId($newOrder->getId());
   118	            }
   119	        });
   120	
   121	        $this->logger->info('Smaregi OTC pattern (店頭受取/店頭PC購入) processed', [
   122	            'transactionHeadId' => $transaction->transactionHeadId,
   123	            'existingOrderIds' => array_map(static fn (Order $o): ?int => $o->getId(), $matchedOrders),
   124	            'newOrderId' => $newOrder->getId(),
   125	            'clonedItemCount' => $clonedItemCount,
   126	            'addOnItemCount' => $newOrder->getOrderItems()->count() - $clonedItemCount,
   127	        ]);
   128	
   129	        return [...$matchedOrders, $newOrder];
   130	    }
