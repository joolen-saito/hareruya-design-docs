  1064	    <!--検索パターン-->
  1065	    {% if SearchPatterns is defined and SearchPatterns %}
  1066	        <div class="c-outsideBlock__contents">
  1067	            <div class="col-sm-2 mb-3">
  1068	                <button type="button" class="btn btn-inline btn-primary btn-sm" id="reload_all_pattern">
  1069	                    {{ 'admin.order.reload_all_pattern_label'|trans }}
  1070	                </button>
  1071	            </div>
  1072	            <div class="row mb-3">
  1073	                {% for SearchPattern in SearchPatterns %}
  1074	                <div class="col-3">
  1075	                    {% if pattern_id is defined and SearchPattern.id == pattern_id %}
  1076	                        {{ SearchPattern.name }}
  1077	                    {% else %}
  1078	                        <a href="{{ url('admin_order_search_pattern', { 'pattern_id': SearchPattern.id }) }}" id="search_pattern_{{ SearchPattern.id }}">{{ SearchPattern.name }}
  1079	                        (<span id="pattern_id_{{SearchPattern.id}}">*</span>)
  1080	                        </a>
  1081	                        <button type="button" class="get_count_pattern btn p-0 border-0 bg-transparent" id="get_count_pattern_{{ SearchPattern.id }}" data-pattern-id="{{ SearchPattern.id }}">
  1082	                            <i class="fa fa-refresh" aria-hidden="true"></i>
  1083	                        </button>
  1084	                    {% endif %}
  1085	                </div>
  1086	                {% endfor %}
  1087	            </div>
  1088	        </div>
  1089	    {% endif %}
  1090	
  1091	    <div class="c-contentsArea__cols">
  1092	        <div class="c-contentsArea__primaryCol">
  1093	            <div class="c-primaryCol">
