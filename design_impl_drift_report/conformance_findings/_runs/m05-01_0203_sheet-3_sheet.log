   136	    #[Route(path: '/%eccube_admin_route%/order', name: 'admin_order', methods: ['GET', 'POST'])]
   137	    #[Route(path: '/%eccube_admin_route%/order/page/{page_no}', name: 'admin_order_page', requirements: ['page_no' => '\d+'], methods: ['GET', 'POST'])]
   138	    #[Template(template: '@admin/Order/index.twig')]
   139	    public function index(Request $request, PaginatorInterface $paginator, ?int $page_no = null): array
   140	    {
   141	        $builder = $this->formFactory
   142	            ->createBuilder(SearchOrderType::class);
   143	
   144	        $event = new EventArgs(
   145	            [
   146	                'builder' => $builder,
   147	            ],
   148	            $request
   149	        );
   150	        $this->eventDispatcher->dispatch($event, EccubeEvents::ADMIN_ORDER_INDEX_INITIALIZE);
   151	
   152	        $searchForm = $builder->getForm();
   153	
   154	        /**
   155	         * ページの表示件数は, 以下の順に優先される.
   156	         * - リクエストパラメータ
   157	         * - セッション
   158	         * - デフォルト値
   159	         * また, セッションに保存する際は mtb_page_maxと照合し, 一致した場合のみ保存する.
   160	         **/
   161	        $page_count = (int) $this->session->get(
   162	            'eccube.admin.order.search.page_count',
   163	            (int) $this->eccubeConfig->get('eccube_default_page_count')
   164	        );
   165	
   166	        $page_count_param = (int) $request->get('page_count');
   167	        $pageMaxis = $this->pageMaxRepository->findAll();
   168	
   169	        if ($page_count_param) {
   170	            foreach ($pageMaxis as $pageMax) {
   171	                if ($page_count_param === (int) $pageMax->getName()) {
   172	                    $page_count = (int) $pageMax->getName();
   173	                    $this->session->set('eccube.admin.order.search.page_count', $page_count);
   174	                    break;
   175	                }
   176	            }
   177	        }
   178	
   179	        if ('POST' === $request->getMethod()) {
   180	            $searchForm->handleRequest($request);
   181	
   182	            if ($searchForm->isValid()) {
   183	                /**
   184	                 * 検索が実行された場合は, セッションに検索条件を保存する.
   185	                 * ページ番号は最初のページ番号に初期化する.
   186	                 */
   187	                $page_no = 1;
   188	                $searchData = $searchForm->getData();
   189	
   190	                // 検索条件, ページ番号をセッションに保持.
   191	                $this->session->set('eccube.admin.order.search', FormUtil::getViewData($searchForm));
   192	                $this->session->set('eccube.admin.order.search.page_no', $page_no);
   193	            } else {
   194	                // 検索エラーの際は, 詳細検索枠を開いてエラー表示する.
   195	                return [
   196	                    'searchForm' => $searchForm->createView(),
   197	                    'pagination' => [],
   198	                    'pageMaxis' => $pageMaxis,
   199	                    'page_no' => $page_no,
   200	                    'page_count' => $page_count,
   201	                    'has_errors' => true,
   202	                    'memberId' => $this->getMember()->getId(),
   203	                ];
   204	            }
   205	        } else {
   206	            if (null !== $page_no || $request->get('resume')) {
   207	                /*
   208	                 * ページ送りの場合または、他画面から戻ってきた場合は, セッションから検索条件を復旧する.
   209	                 */
   210	                if ($page_no) {
   211	                    // ページ送りで遷移した場合.
   212	                    $this->session->set('eccube.admin.order.search.page_no', (int) $page_no);
   213	                } else {
   214	                    // 他画面から遷移した場合.
   215	                    $page_no = $this->session->get('eccube.admin.order.search.page_no', 1);
   216	                }
   217	                $viewData = $this->session->get('eccube.admin.order.search', []);
   218	                $searchData = FormUtil::submitAndGetData($searchForm, $viewData);
   219	            } else {
   220	                /**
   221	                 * 初期表示の場合.
   222	                 */
   223	                $page_no = 1;
   224	                $viewData = [];
   225	
   226	                if ($statusId = (int) $request->get('order_status_id')) {
   227	                    $viewData = ['status' => [$statusId]];
   228	                }
   229	
   230	                $searchData = FormUtil::submitAndGetData($searchForm, $viewData);
   231	
   232	                // セッション中の検索条件, ページ番号を初期化.
   233	                $this->session->set('eccube.admin.order.search', $viewData);
   234	                $this->session->set('eccube.admin.order.search.page_no', $page_no);
   235	            }
   236	        }
   237	
   238	        $qb = $this->orderRepository->getQueryBuilderBySearchDataForAdmin($searchData);
   239	
   240	        $event = new EventArgs(
   241	            [
   242	                'qb' => $qb,
   243	                'searchData' => $searchData,
   244	                'memberId' => $this->getMember()->getId(),
   245	            ],
   246	            $request
   247	        );
   248	
   249	        $this->eventDispatcher->dispatch($event, EccubeEvents::ADMIN_ORDER_INDEX_SEARCH);
   250	        $sortKey = $searchData['sortkey'];
   251	
   252	        if (empty($this->orderRepository::COLUMNS[$sortKey]) || $sortKey == 'order_status') {
   253	            $pagination = $paginator->paginate(
   254	                $qb,
   255	                $page_no,
   256	                $page_count
   257	            );
   258	        } else {
   259	            $pagination = $paginator->paginate(
   260	                $qb,
   261	                $page_no,
   262	                $page_count,
   263	                ['wrap-queries' => true]
   264	            );
   265	        }
   266	
   267	        // 検索パターンを取得(TODO: 店舗条件の要否)
   268	        $SearchPatterns = $this->dtbSearchPatternRepository->findBy(['display_key' => 'order']);
   269	
   270	        return [
   271	            'searchForm' => $searchForm->createView(),
   272	            'pagination' => $pagination,
   273	            'pageMaxis' => $pageMaxis,
   274	            'page_no' => $page_no,
   275	            'page_count' => $page_count,
   276	            'has_errors' => false,
   277	            'OrderStatuses' => $this->orderStatusRepository->findBy([], ['sort_no' => 'ASC']),
   278	            'SearchPatterns' => $SearchPatterns,
   279	            'OrderCsvExtensions' => $this->dtbCsvExtensionRepository->findBy(['CsvType' => CsvType::CSV_TYPE_ORDER]),
   280	            'ShippingCsvExtensions' => $this->dtbCsvExtensionRepository->findBy(['CsvType' => CsvType::CSV_TYPE_SHIPPING]),
   281	            'memberId' => $this->getMember()->getId(),
   282	        ];
   283	    }
