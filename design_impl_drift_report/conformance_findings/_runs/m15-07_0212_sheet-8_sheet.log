    36	    public function getDeckTagsList(string $sortKey): mixed
    37	    {
    38	        $sortKeys = [
    39	            'nameJp' => 'dt.nameJp',
    40	            'nameEn' => 'dt.nameEn',
    41	            'sortNo' => 'dt.sortNo',
    42	            'default' => 'dt.sortNo',
    43	        ];
    44	
    45	        // mtb_deck_tag
    46	        $qb = $this->createQueryBuilder('dt')->select('dt');
    47	
    48	        // Order By
    49	        if ($sortKey && array_key_exists($sortKey, $sortKeys)) {
    50	            $qb->addOrderBy($sortKeys[$sortKey], 'ASC');
    51	        }
    52	
    53	        return $qb->getQuery()->getResult();
    54	    }
    55	
    56	    /**
    57	     * ランク値重複チェック
    58	     *
    59	     * @return bool 重複があればtrue
    60	     */
    61	    public function hasOverlapSortNo(int $id, int $sortNo): bool
    62	    {
    63	        // mtb_deck_tag
    64	        $qb = $this->createQueryBuilder('dt');
    65	
    66	        $qb->select('dt')
    67	            ->where($qb->expr()->neq('dt.id', ':id'))
    68	            ->andWhere($qb->expr()->eq('dt.sortNo', ':sortNo'))
    69	            ->setParameters(new ArrayCollection(['id' => $id, 'sortNo' => $sortNo]));
    70	
    71	        return !empty($qb->getQuery()->getResult());
    72	    }
