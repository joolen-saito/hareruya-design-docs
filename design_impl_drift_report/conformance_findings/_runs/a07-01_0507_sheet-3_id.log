    30	 */
    31	class JwtTokenService
    32	{
    33	    private JWSSerializerManager $serializerManager;
    34	    private JWSBuilder $jwsBuilder;
    35	    private JWSVerifier $jwsVerifier;
    36	    private ?JWK $secretKey = null;
    37	
    38	    public function __construct(
    39	        private readonly string $jwtSecret,
    40	    ) {
    41	        $algorithmManager = new AlgorithmManager([new HS256()]);
    42	        $this->serializerManager = new JWSSerializerManager([new CompactSerializer()]);
    43	        $this->jwsBuilder = new JWSBuilder($algorithmManager);
