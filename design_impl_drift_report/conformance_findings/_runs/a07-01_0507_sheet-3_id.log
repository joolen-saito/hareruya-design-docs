    23	use Symfony\Component\Security\Http\AccessToken\AccessTokenHandlerInterface;
    24	use Symfony\Component\Security\Http\Authenticator\Passport\Badge\UserBadge;
    25	
    26	/**
    27	 * JWTトークンを検証し、認証済みユーザーを返すハンドラー
    28	 *
    29	 * Why: クライアント側にリフレッシュトークンの仕組みがないことと
    30	 * トークンに有効期限を設けていないため、DBでMemberの存在を確認する
    31	 */
    32	class JwtTokenHandler implements AccessTokenHandlerInterface
    33	{
    34	    public function __construct(
    35	        private readonly JwtTokenService $jwtTokenService,
    36	        private readonly MemberRepository $memberRepository,
    37	        private readonly LoggerInterface $logger,
    38	    ) {
    39	    }
    40	
    41	    #[\Override]
    42	    public function getUserBadgeFrom(string $accessToken): UserBadge
    43	    {
    44	        try {
    45	            $memberId = $this->jwtTokenService->verifyAndGetMemberId($accessToken);
    46	        } catch (InvalidTokenException $e) {
    47	            $this->logger->warning('JWT authentication failed: {message}', [
    48	                'message' => $e->getMessage(),
    49	                'exception' => $e,
    50	            ]);
    51	            throw new BadCredentialsException('Invalid token', 0, $e);
    52	        }
    53	
    54	        return new UserBadge(
    55	            (string) $memberId,
    56	            fn (string $identifier): Member => $this->getMember((int) $identifier)
    57	        );
    58	    }
    59	
    60	    /**
    61	     * Member IDからMemberを取得する
    62	     *
    63	     * @param int $memberId Member ID
    64	     *
    65	     * @return Member
    66	     *
    67	     * @throws BadCredentialsException Memberが存在しない場合
    68	     */
    69	    private function getMember(int $memberId): Member
    70	    {
    71	        // Why: 旧システムと同じ仕様でworkチェックをしない
    72	        $Member = $this->memberRepository->find($memberId);
    73	
    74	        if ($Member === null) {
    75	            $this->logger->warning('JWT authentication failed: Member not found', [
    76	                'member_id' => $memberId,
    77	            ]);
    78	            throw new BadCredentialsException('Member not found');
    79	        }
    80	
    81	        return $Member;
    82	    }
    83	}

