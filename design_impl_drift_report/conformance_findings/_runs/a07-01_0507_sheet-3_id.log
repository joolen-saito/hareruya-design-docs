    20	use Eccube\Repository\Master\MtbOptionRepository;
    21	
    22	class BulkPurchaseIdService
    23	{
    24	    public function __construct(
    25	        private readonly MtbOptionRepository $optionRepository,
    26	    ) {
    27	    }
    28	
    29	    /**
    30	     * まとめて買取商品IDを取得
    31	     *
    32	     * @throws InternalException 設定が存在しない、または不正な値の場合
    33	     */
    34	    public function get(): int
    35	    {
    36	        $option = $this->optionRepository->findOneBy(['option_key' => MtbOption::BULK_PURCHASE_ID]);
    37	
    38	        if ($option === null) {
    39	            throw new InternalException('まとめて買取商品IDの設定がありません');
    40	        }
    41	
    42	        $value = $option->getOptionValue();
    43	        if ($value === '' || !ctype_digit((string) $value)) {
    44	            throw new InternalException('まとめて買取商品IDの設定値が不正です');
    45	        }
    46	
    47	        return (int) $value;
    48	    }
