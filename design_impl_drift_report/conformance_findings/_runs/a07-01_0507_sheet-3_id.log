    46	     * totally reloaded (e.g. from the database), or if the UserInterface
    47	     * object can just be merged into some internal array of users / identity
    48	     * map.
    49	     *
    50	     * @throws UnsupportedUserException if the user is not supported
    51	     */
    52	    #[\Override]
    53	    public function refreshUser(UserInterface $user): UserInterface
    54	    {
    55	        if (!$user instanceof Member) {
    56	            throw new UnsupportedUserException(sprintf('Instances of "%s" are not supported.', $user::class));
    57	        }
    58	
    59	        return $this->loadUserByIdentifier($user->getUsername());
    60	    }
    61	
    62	    /**
