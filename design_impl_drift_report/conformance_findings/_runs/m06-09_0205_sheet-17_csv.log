src/Eccube/Resource/locale/messages.ja.yaml:1239:front.shopping.payment_modal.credit.li1: ・Visa
src/Eccube/Resource/locale/messages.ja.yaml:1240:front.shopping.payment_modal.credit.li2: ・JCB
src/Eccube/Resource/locale/messages.ja.yaml:1241:front.shopping.payment_modal.credit.li3: ・Mastercard
