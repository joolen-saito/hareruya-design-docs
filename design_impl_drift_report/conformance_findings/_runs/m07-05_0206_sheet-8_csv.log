   550	    /**
   551	     * 買取商品一覧出力用データ取得
   552	     * 売却する用、キャンセル用のいずれからも利用する
   553	     * Note: 集計クエリでパフォーマンス考慮のため、DBAL + iterateAssociative を使用する
   554	     *
   555	     * @param array<int, int> $buyOrderIds
   556	     *
   557	     * @return \Traversable<int, array<string, mixed>>
   558	     */
   559	    public function getProductListDataForExportCsv(array $buyOrderIds, bool $saleFlg): iterable
   560	    {
   561	        if ($buyOrderIds === []) {
   562	            return new \ArrayIterator([]);
   563	        }
   564	
   565	        $sql = <<<SQL
   566	        (
   567	            -- 通常買取商品（状態あり）
   568	            SELECT
   569	                pc.product_code AS product_code,
   570	                SUM(bmc.count) AS product_count,
   571	                p.name AS product_name,
   572	                pc.standard_price AS standard_price,
   573	                bmc.price AS buy_price,
   574	                bmc.language_id AS language_id,
   575	                sc.name AS storage_code,
   576	                r.code AS rarity_code,
   577	                cc.code AS condition_code,
   578	                (CASE WHEN pc.product_code IS NULL THEN 1 ELSE 0 END) AS product_code_null_sort,
   579	                cc.id AS card_condition_id,
   580	                p.id AS product_id,
   581	                0 AS indivisual_input_product_sort
   582	            FROM
   583	                dtb_buy_order bo
   584	            JOIN
   585	                dtb_buy_main_card bmc ON bmc.buy_order_id = bo.id
   586	                AND bmc.sale_flg = :saleFlg
   587	            JOIN
   588	                dtb_product p ON p.id = bmc.product_id
   589	            JOIN
   590	                dtb_product_class pc ON pc.product_id = p.id
   591	                AND pc.product_status_id IN (:productStatusIds)
   592	                AND pc.language_id = bmc.language_id
   593	                AND pc.card_condition_id = bmc.card_condition_id
   594	                AND pc.high_price_code IS NULL
   595	            JOIN
   596	                mtb_card_condition cc ON cc.id = bmc.card_condition_id
   597	            LEFT JOIN
   598	                mtb_storage_code sc ON sc.id = p.storage_code_id
   599	            LEFT JOIN
   600	                mtb_card_detail cd ON cd.id = p.card_detail_id
   601	            LEFT JOIN
   602	                mtb_rarity r ON r.id = cd.rarity_id
   603	            WHERE
   604	                bo.id IN (:buyOrderIds)
   605	                AND (:saleFlg = true OR bo.buy_order_status_id != :cancelledStatusId) -- 売却しない抽出のときは、買取ステータス「キャンセル」を除外する
   606	            GROUP BY
   607	                pc.id, bmc.price, pc.product_code, p.name, pc.standard_price, bmc.language_id, sc.name, r.code, cc.code, cc.id, p.id
   608	        )
   609	        UNION ALL
   610	        (
   611	            -- 個別入力商品
   612	            SELECT
   613	                '' AS product_code,
   614	                iip.quantity AS product_count,
   615	                iip.name AS product_name,
   616	                NULL AS standard_price,
   617	                iip.price AS buy_price,
   618	                1 AS language_id,
   619	                '' AS storage_code,
   620	                '' AS rarity_code,
   621	                '' AS condition_code,
   622	                2 AS product_code_null_sort,
   623	                NULL AS card_condition_id,
   624	                NULL AS product_id,
   625	                1 AS indivisual_input_product_sort
   626	            FROM
   627	                dtb_buy_order_indivisual_input_product iip
   628	            JOIN
   629	                dtb_buy_order bo_iip ON bo_iip.id = iip.buy_order_id
   630	            WHERE
   631	                iip.buy_order_id IN (:buyOrderIds)
   632	                AND iip.sale_flg = :saleFlg
   633	                AND (:saleFlg = true OR bo_iip.buy_order_status_id != :cancelledStatusId) -- 売却しない抽出のときは、買取ステータス「キャンセル」を除外する
   634	        )
   635	        UNION ALL
   636	        (
   637	            -- 通常商品（状態なし）
   638	            SELECT
   639	                '' AS product_code,
   640	                SUM(bmc.count) AS product_count,
   641	                p.name AS product_name,
   642	                NULL AS standard_price,
   643	                bmc.price AS buy_price,
   644	                bmc.language_id AS language_id,
   645	                sc.name AS storage_code,
   646	                r.code AS rarity_code,
   647	                '' AS condition_code,
   648	                1 AS product_code_null_sort,
   649	                NULL AS card_condition_id,
   650	                p.id AS product_id,
   651	                0 AS indivisual_input_Product_sort
   652	            FROM
   653	                dtb_buy_order bo
   654	            JOIN
   655	                dtb_buy_main_card bmc ON bmc.buy_order_id = bo.id
   656	                AND bmc.sale_flg = :saleFlg
   657	            JOIN
   658	                dtb_product p ON p.id = bmc.product_id
   659	            LEFT JOIN
   660	                mtb_storage_code sc ON sc.id = p.storage_code_id
   661	            LEFT JOIN
   662	                mtb_card_detail cd ON cd.id = p.card_detail_id
   663	            LEFT JOIN
   664	                mtb_rarity r ON r.id = cd.rarity_id
   665	            WHERE
   666	                bo.id IN (:buyOrderIds)
   667	                AND bmc.card_condition_id IS NULL
   668	                AND (:saleFlg = true OR bo.buy_order_status_id != :cancelledStatusId) -- 売却しない抽出のときは、買取ステータス「キャンセル」を除外する
   669	            GROUP BY
   670	                bmc.product_id, p.name, bmc.price, bmc.language_id, sc.name, r.code, p.id
   671	        )
   672	        ORDER BY
   673	            indivisual_input_product_sort ASC, product_id ASC, product_code_null_sort ASC, card_condition_id ASC
   674	        SQL;
   675	
   676	        $conn = $this->getEntityManager()->getConnection();
   677	
   678	        return $conn->iterateAssociative(
   679	            $sql,
   680	            [
   681	                'buyOrderIds' => $buyOrderIds,
   682	                'saleFlg' => $saleFlg,
   683	                'productStatusIds' => [ProductStatus::DISPLAY_SHOW, ProductStatus::DISPLAY_HIDE], // 商品状態が公開または非公開の商品（論理削除に相当する「廃止」を除く）
   684	                'cancelledStatusId' => MtbBuyOrderStatus::CANCELED,
   685	            ],
   686	            [
   687	                'buyOrderIds' => \Doctrine\DBAL\Connection::PARAM_INT_ARRAY,
   688	                'saleFlg' => \PDO::PARAM_INT,
   689	                'productStatusIds' => \Doctrine\DBAL\Connection::PARAM_INT_ARRAY,
   690	                'cancelledStatusId' => \PDO::PARAM_INT,
   691	            ]
   692	        );

