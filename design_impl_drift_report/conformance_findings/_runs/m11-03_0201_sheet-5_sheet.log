   187	            if (permissionId) {
   188	                checkbox.name = 'authority[' + uniqueId + '][' + permissionId + ']';
   189	                checkbox.dataset.authorityId = uniqueId;
   190	                checkbox.checked = sourceCheckboxes[index]?.checked || false;
   191	            }
   192	        });
   193	        
   194	        const actionCell = newRow.querySelector('td:last-child');
   195	        const deleteButton = document.createElement('button');
   196	        deleteButton.type = 'button';
   197	        deleteButton.className = 'btn btn-ec-regular btn-delete';
   198	        deleteButton.textContent = '削除';
   199	        deleteButton.onclick = function(e) {
   200	            e.preventDefault();
   201	            e.stopPropagation();
   202	            e.currentTarget.closest('tr')?.remove();
   203	        };
   204	        if (actionCell) {
   205	            actionCell.innerHTML = '';
   206	            actionCell.appendChild(deleteButton);
   207	        }
   208	        tbody.appendChild(newRow);
   209	        return false;
   210	    }
   211	    
   212	    function init() {
   213	        const table = document.querySelector('#table-authority');
   214	        if (!table) {
   215	            return;
   216	        }
