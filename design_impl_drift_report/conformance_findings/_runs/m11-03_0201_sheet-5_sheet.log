   221	        });
   222	        
   223	        table.addEventListener('change', function(e) {
   224	            if (e.target?.classList.contains('permission-checkbox')) {
   225	                handlePermissionCheckboxChange(e);
   226	            }
   227	        });
   228	        
   229	        table.addEventListener('click', function(e) {
   230	            const checkbox = e.target;
   231	            if (checkbox?.classList.contains('permission-checkbox') && checkbox.classList.contains('locked')) {
   232	                e.preventDefault();
   233	                e.stopPropagation();
   234	                checkbox.checked = true;
   235	                return false;
   236	            }
   237	        }, true);
   238	
   239	        table.querySelectorAll('tbody tr').forEach(function(row) {
   240	            const groups = new Set();
   241	            row.querySelectorAll('.permission-checkbox').forEach(function(cb) {
   242	                if (cb.dataset.groupId) {
