    53	     */
    54	    public function handle(AuthorityIndexInput $input): void
    55	    {
    56	        $authorityRequestData = $input->authorityRequestData;
    57	
    58	        if (empty($authorityRequestData)) {
    59	            return;
    60	        }
    61	
    62	        $this->entityManager->beginTransaction();
    63	
    64	        try {
    65	            $PermissionAccessUrls = $this->permissionAccessUrlRepository->findAll();
    66	
    67	            $newAuthorityNames = $input->newAuthorityNames;
    68	            if (!empty($newAuthorityNames)) {
    69	                $nextId = $this->authorityRepository->getMaxId();
    70	                $nextSortNo = $this->authorityRepository->getMaxSortNo();
    71	                $seenNames = [];
    72	
    73	                foreach ($newAuthorityNames as $uniqueId => $newAuthorityName) {
    74	                    if (in_array($newAuthorityName, $seenNames, true) || $this->authorityRepository->findOneBy(['name' => $newAuthorityName])) {
    75	                        throw new \Exception($this->translator->trans('admin.setting.system.authority.exists_already_name'));
    76	                    }
