    22	use Symfony\Component\Security\Core\Authorization\Voter\VoterInterface;
    23	
    24	class AuthorityVoter implements VoterInterface
    25	{
    26	    public function __construct(protected AuthorityRoleRepository $authorityRoleRepository, protected RequestStack $requestStack, protected EccubeConfig $eccubeConfig)
    27	    {
    28	    }
    29	
    30	    /**
    31	     * @param array<mixed> $attributes
    32	     */
    33	    #[\Override]
    34	    public function vote(TokenInterface $token, mixed $subject, array $attributes, ?Vote $vote = null): int
    35	    {
    36	        $path = null;
    37	
    38	        try {
    39	            $request = $this->requestStack->getMainRequest();
    40	        } catch (\RuntimeException) {
    41	            // requestが取得できない場合、棄権する(テストプログラムで不要なため)
    42	            return VoterInterface::ACCESS_ABSTAIN;
    43	        }
    44	
    45	        if (is_object($request)) {
    46	            $path = rawurldecode($request->getPathInfo());
    47	        }
    48	
    49	        $Member = $token->getUser();
    50	        if ($Member instanceof Member) {
    51	            // 管理者のロールをチェック
    52	            $AuthorityRoles = $this->authorityRoleRepository->findBy(['Authority' => $Member->getAuthority()]);
    53	            $adminRoute = $this->eccubeConfig->get('eccube_admin_route');
    54	
    55	            foreach ($AuthorityRoles as $AuthorityRole) {
    56	                // 許可しないURLが含まれていればアクセス拒否
    57	                try {
    58	                    // 正規表現でURLチェック
    59	                    $denyUrl = str_replace('/', '\/', $AuthorityRole->getDenyUrl());
    60	                    if (preg_match("/^(\/{$adminRoute}{$denyUrl})/i", (string) $path)) {
    61	                        return VoterInterface::ACCESS_DENIED;
    62	                    }
    63	                } catch (\Exception) {
    64	                    // 拒否URLの指定に誤りがある場合、エスケープさせてチェック
    65	                    $denyUrl = preg_quote((string) $AuthorityRole->getDenyUrl(), '/');
    66	                    if (preg_match("/^(\/{$adminRoute}{$denyUrl})/i", (string) $path)) {
    67	                        return VoterInterface::ACCESS_DENIED;
    68	                    }
    69	                }
    70	            }
    71	        }
    72	
    73	        return VoterInterface::ACCESS_GRANTED;
    74	    }
    75	}

