   153	    /**
   154	     * 在庫編集の承認可能なメンバーを取得します.
   155	     *
   156	     * $BaseInfo を指定した場合は当該店舗に紐づく承認可能メンバーのみ、未指定の場合は承認可能な全メンバー.
   157	     *
   158	     * @param BaseInfo|null $BaseInfo
   159	     *
   160	     * @return array<Member> $Members - 在庫編集の承認可能なメンバーの配列
   161	     */
   162	    public function getApprovalAuthorityMembers(?BaseInfo $BaseInfo = null): array
   163	    {
   164	        $query = '
   165	            SELECT m.id, m.name, m.email, m.department_id
   166	            FROM dtb_member m';
   167	        $joins = '';
   168	        $conditions = ['
   169	            m.authority_id NOT IN (
   170	                SELECT authority_id
   171	                FROM dtb_authority_role
   172	                WHERE deny_url = :denyUrl
   173	            )',
   174	        ];
   175	        $params = [
   176	            'denyUrl' => '/approval_authority',
   177	        ];
   178	
   179	        // 店舗が指定されている場合は店舗に紐づくメンバーのみを取得
   180	        if ($BaseInfo !== null) {
   181	            $joins .= ' INNER JOIN dtb_member_base_info mbi ON m.id = mbi.member_id';
   182	            $conditions[] = 'mbi.base_info_id = :BaseInfoId';
   183	            $params['BaseInfoId'] = $BaseInfo->getId();
   184	        }
   185	
   186	        $query .= $joins;
   187	        $query .= ' WHERE '.implode(' AND ', $conditions);
   188	        $query .= ' ORDER BY m.name';
   189	
   190	        $rsm = new ResultSetMapping();
   191	        $rsm->addScalarResult('id', 'memberId')
   192	            ->addScalarResult('name', 'name')
   193	            ->addScalarResult('email', 'email')
   194	            ->addScalarResult('department_id', 'departmentId');
   195	
   196	        $rows = $this->getEntityManager()
   197	            ->createNativeQuery($query, $rsm)
   198	            ->setParameters($params)
   199	            ->getResult();
   200	
   201	        // Memberオブジェクトに変換する
   202	        $Members = [];
   203	        foreach ($rows as $row) {
   204	            $Member = new Member();
   205	            $Member->setId($row['memberId']);
   206	            $Member->setName($row['name']);
   207	            $Member->setEmail($row['email']);
   208	            $Member->setDepartment($this->getEntityManager()->getReference(Department::class, $row['departmentId']));
   209	
   210	            $Members[] = $Member;
   211	        }
   212	
   213	        return $Members;
   214	    }
   215	
   216	    /**
   217	     * 承認・却下の実行権限を一括判定する。
   218	     * ①編集可能店舗 + ③承認権限 を1クエリで確認し、②自分以外 はメモリ上で先に弾く。
   219	     */
   220	    public function canApprove(Member $approver, BaseInfo $baseInfo, ?Member $registeredBy): bool
   221	    {
   222	        if ($registeredBy !== null && $approver->getId() === $registeredBy->getId()) {
   223	            return false;
   224	        }
   225	
   226	        $rsm = new ResultSetMapping();
   227	        $rsm->addScalarResult('cnt', 'cnt');
   228	
   229	        $count = (int) $this->getEntityManager()
   230	            ->createNativeQuery(
   231	                'SELECT COUNT(*) AS cnt
   232	                 FROM dtb_member m
   233	                 INNER JOIN dtb_member_base_info mbi ON m.id = mbi.member_id AND mbi.base_info_id = :baseInfoId
   234	                 WHERE m.id = :memberId
   235	                 AND m.authority_id NOT IN (
   236	                     SELECT authority_id FROM dtb_authority_role WHERE deny_url = :denyUrl
   237	                 )',
   238	                $rsm
   239	            )
   240	            ->setParameter('memberId', $approver->getId())
   241	            ->setParameter('baseInfoId', $baseInfo->getId())
   242	            ->setParameter('denyUrl', '/approval_authority')
   243	            ->getSingleScalarResult();
   244	
   245	        return $count > 0;
   246	    }
   247	}

