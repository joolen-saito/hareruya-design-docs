   135	                    }
   136	                }
   137	            }
   138	
   139	            $this->entityManager->flush();
   140	            $this->entityManager->commit();
   141	        } catch (\Exception $e) {
   142	            $this->entityManager->rollback();
   143	
   144	            throw $e;
   145	        }
   146	    }
   147	}

