   114	{% block javascript %}
   115	<script nonce="{{ csp_nonce }}">
   116	(function() {
   117	    function updateGroupLocks(row, groupId) {
   118	        const checkboxes = Array.from(
   119	            row.querySelectorAll('.permission-checkbox[data-group-id="' + groupId + '"]')
   120	        );
   121	        const checkedPriorities = checkboxes
   122	            .filter(function(cb) { return cb.checked; })
   123	            .map(function(cb) { return parseInt(cb.dataset.priority, 10); })
   124	            .filter(function(p) { return !isNaN(p); });
   125	
   126	        if (checkedPriorities.length === 0) {
   127	            checkboxes.forEach(function(cb) {
   128	                cb.disabled = false;
   129	            });
   130	            return;
   131	        }
   132	
   133	        const minPriority = Math.min.apply(null, checkedPriorities);
   134	        checkboxes.forEach(function(cb) {
   135	            const cbPriority = parseInt(cb.dataset.priority, 10);
   136	            if (isNaN(cbPriority)) {
   137	                return;
   138	            }
   139	            if (cbPriority > minPriority) {
   140	                cb.checked = true;
   141	                cb.disabled = false;
   142	                cb.classList.add('locked');
   143	            } else {
   144	                cb.disabled = false;
   145	                cb.classList.remove('locked');
   146	            }
   147	        });
   148	    }
   149	
   150	    function handlePermissionCheckboxChange(e) {
   151	        const checkbox = e.target;
   152	        if (!checkbox?.classList.contains('permission-checkbox')) {
   153	            return;
   154	        }
   155	
   156	        const row = checkbox.closest('tr');
   157	        const groupId = checkbox.dataset.groupId;
   158	        if (!row || !groupId) {
   159	            return;
   160	        }
   161	
   162	        updateGroupLocks(row, groupId);
   163	    }
   164	    
   165	    function handleCopyClick(e) {
   166	        e.preventDefault();
   167	        e.stopPropagation();
   168	        
   169	        const sourceRow = e.target?.closest('tr');
   170	        const tbody = document.querySelector('#table-authority tbody');
   171	        if (!sourceRow || !tbody) {
   172	            return false;
   173	        }
   174	
   175	        const newRow = sourceRow.cloneNode(true);
   176	        const uniqueId = Date.now();
   177	        const sourceCheckboxes = sourceRow.querySelectorAll('.permission-checkbox');
   178	        const newCheckboxes = newRow.querySelectorAll('.permission-checkbox');
   179	
   180	        const nameCell = newRow.querySelector('th:first-child');
   181	        if (nameCell) {
