   129	
   130	        if ($pcIds === []) {
   131	            return [];
   132	        }
   133	
   134	        /** @var list<DtbSalesQuantity> $sqEntities */
   135	        $sqEntities = $this->entityManager->createQueryBuilder()
   136	            ->select('sq')
   137	            ->from(DtbSalesQuantity::class, 'sq')
   138	            ->where('sq.ProductClass IN (:pcIds)')
   139	            ->andWhere('sq.BaseInfo IS NOT NULL')
   140	            ->setParameter('pcIds', array_keys($pcIds))
   141	            ->getQuery()
   142	            ->getResult();
   143	
   144	        $map = [];
   145	        foreach ($sqEntities as $sq) {
   146	            $pcId = $sq->getProductClass()?->getId();
   147	            $biId = $sq->getBaseInfo()?->getId();
   148	            if ($pcId !== null && $biId !== null) {
   149	                $map[$pcId.'_'.$biId] = $sq;
   150	            }
   151	        }
   152	
   153	        return $map;
