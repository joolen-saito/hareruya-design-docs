   118	    public function onReadRow(ReadCsvRowEvent $event): bool
   119	    {
   120	        $row = $event->getRow();
   121	        $categoryId = $this->categoryIdColumn->getValue($row);
   122	        $isUpdate = $categoryId !== null && $categoryId > 0;
   123	
   124	        if ($isUpdate) {
   125	            $Category = $this->categoryRepository->find((int) $categoryId);
   126	            if (!$Category instanceof Category) {
   127	                return false;
   128	            }
   129	        } else {
   130	            $Category = new Category();
   131	        }
   132	
   133	        $nameJa = (string) $this->nameJaColumn->getValue($row);
   134	        $Category->setName(StringUtil::trimAll($nameJa));
   135	
   136	        $nameEn = $this->nameEnColumn->getValue($row);
   137	        $Category->setCategoryNameEn($nameEn !== null && StringUtil::isNotBlank((string) $nameEn) ? StringUtil::trimAll((string) $nameEn) : null);
   138	
   139	        $parentId = $this->parentCategoryIdColumn->getValue($row);
   140	        $Parent = null;
   141	        if ($parentId !== null && (int) $parentId > 0) {
   142	            $Parent = $this->categoryRepository->find((int) $parentId);
   143	        }
   144	        $Category->setParent($Parent);
   145	
   146	        $this->applyHierarchyFromParent($Category, $Parent);
   147	
   148	        $front = (int) $this->frontHideColumn->getValue($row);
   149	        $Category->setFrontSearchHideFlg($front === 1);
   150	
   151	        $branch = (int) $this->branchHideColumn->getValue($row);
   152	        $Category->setBranchHideFlg($branch === 1);
   153	
   154	        $search = $this->searchParametersColumn->getValue($row);
   155	        $Category->setSearchParameters($search !== null && StringUtil::isNotBlank((string) $search) ? StringUtil::trimAll((string) $search) : null);
   156	
   157	        $banner = $this->bannerPathColumn->getValue($row);
   158	        $Category->setBannerImage($banner !== null && StringUtil::isNotBlank((string) $banner) ? StringUtil::trimAll((string) $banner) : null);
   159	
   160	        $icon = $this->iconPathColumn->getValue($row);
   161	        $Category->setIconImage($icon !== null && StringUtil::isNotBlank((string) $icon) ? StringUtil::trimAll((string) $icon) : null);
   162	
   163	        if ($isUpdate) {
   164	            $sortNo = $this->sortNoColumn->getValue($row);
   165	            if ($sortNo !== null) {
   166	                $Category->setSortNo((int) $sortNo);
   167	            }
   168	            $Category->setUpdateDate(new \DateTime());
   169	        } else {
   170	            $now = new \DateTime();
   171	            $Category->setCreateDate($now);
   172	            $Category->setUpdateDate($now);
   173	            // 表示ランク: 全カテゴリ件数 + 1（CSV では新規時に表示ランク列は空のため補完）
   174	            $Category->setSortNo((int) $this->categoryRepository->getTotalCount() + 1);
   175	        }
   176	
   177	        if ($isUpdate) {
   178	            $this->categoryRepository->save($Category);
   179	        } else {
   180	            $this->categoryRepository->saveNewCategoryFromCsvImport($Category);
   181	        }
   182	
   183	        return true;
