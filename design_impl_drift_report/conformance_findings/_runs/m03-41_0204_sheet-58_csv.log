   172	     *
   173	     * リグレッション: SaveEventSubscriber が `Context::getCurrentUser()` から取得した
   174	     * Member 参照を setCreator() に渡す際、em->clear() でデタッチされたインスタンスを
   175	     * そのまま使うと flush 時に EntityNotFoundException が発生していた。
   176	     *
   177	     * @group HARERUYA
   178	     */
   179	    public function testImportSucceedsForRowsBeyondFlushPerLinesBoundary(): void
   180	    {
   181	        $rowCount = 101;
   182	        $uniqueSuffix = bin2hex(random_bytes(8));
   183	
   184	        $rows = [self::EXPECTED_TEMPLATE_HEADER_COLUMNS];
   185	        for ($i = 1; $i <= $rowCount; $i++) {
   186	            $rowByHeader = array_fill_keys(self::EXPECTED_TEMPLATE_HEADER_COLUMNS, '');
   187	            $rowByHeader['カテゴリ名(日)'] = sprintf('cat_test_%s_%03d', $uniqueSuffix, $i);
