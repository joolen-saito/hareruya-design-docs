    59	    /**
    60	     * テストクライアントの request 内で {@see StreamedResponse::sendContent()} が一度実行されるため
    61	     * {@see StreamedResponse::$streamed} が true のままとなり、続けての sendContent は無出力になる。
    62	     */
    63	    private function captureStreamedResponseBody(StreamedResponse $response): string
    64	    {
    65	        $streamed = new \ReflectionProperty(StreamedResponse::class, 'streamed');
    66	        $streamed->setAccessible(true);
    67	        $streamed->setValue($response, false);
    68	
    69	        ob_start();
    70	        try {
    71	            $response->sendContent();
    72	        } finally {
    73	            $body = (string) ob_get_clean();
    74	        }
    75	
    76	        return $body;
    77	    }
