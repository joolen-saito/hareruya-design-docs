   190	            $rowByHeader['フロント非表示フラグ'] = '0';
   191	            $rowByHeader['支店非表示フラグ'] = '0';
   192	            $rows[] = array_map(
   193	                static fn (string $header) => (string) $rowByHeader[$header],
   194	                self::EXPECTED_TEMPLATE_HEADER_COLUMNS
   195	            );
   196	        }
   197	
   198	        $tmpDir = sys_get_temp_dir().'/'.uniqid('category_csv_', true);
   199	        mkdir($tmpDir);
   200	        $uploadedFileName = 'category_bulk_'.$uniqueSuffix.'.csv';
   201	        $tmpFile = $tmpDir.'/'.$uploadedFileName;
   202	        $fp = fopen($tmpFile, 'w');
   203	        if ($fp === false) {
   204	            self::fail('Failed to open temp CSV file');
   205	        }
   206	        foreach ($rows as $row) {
   207	            fputcsv($fp, $row, ',', '"', '\\');
   208	        }
   209	        fclose($fp);
