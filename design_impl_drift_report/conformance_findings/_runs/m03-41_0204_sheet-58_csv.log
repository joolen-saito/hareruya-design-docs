    16	namespace Eccube\Service\Csv\Importer\Validator;
    17	
    18	use Eccube\Common\EccubeConfig;
    19	use Eccube\Repository\CategoryRepository;
    20	use Eccube\Service\Csv\Importer\MessageStore;
    21	use Eccube\Service\Csv\Importer\Model\CsvColumnInterface;
    22	use Eccube\Service\Csv\Importer\Model\CsvRowInterface;
    23	
    24	/**
    25	 * カテゴリ登録CSVの行単位検証（新規/更新の組み合わせ・階層など）。
    26	 */
    27	final class CategoryCsvRowValidator implements RowValidatorInterface
    28	{
    29	    public function __construct(
    30	        private readonly CategoryRepository $categoryRepository,
    31	        private readonly EccubeConfig $eccubeConfig,
    32	        private readonly CsvColumnInterface $categoryIdColumn,
    33	        private readonly CsvColumnInterface $sortNoColumn,
    34	        private readonly CsvColumnInterface $parentCategoryIdColumn,
    35	    ) {
    36	    }
    37	
    38	    #[\Override]
    39	    public function validate(MessageStore $errors, CsvRowInterface $row): bool
    40	    {
    41	        $categoryId = $this->categoryIdColumn->getValue($row);
    42	        $sortNo = $this->sortNoColumn->getValue($row);
    43	        $parentId = $this->parentCategoryIdColumn->getValue($row);
    44	
    45	        $isUpdate = $categoryId !== null && $categoryId > 0;
    46	
    47	        if ($isUpdate) {
    48	            if ($sortNo === null) {
    49	                $errors->addMessage('admin.csv.error.category.update_requires_sort', $row->getRowNumber());
    50	
    51	                return false;
    52	            }
    53	            $Category = $this->categoryRepository->find($categoryId);
    54	            if ($Category === null) {
    55	                $errors->addMessage('admin.csv.error.category.not_found', $row->getRowNumber());
    56	
    57	                return false;
    58	            }
    59	        } elseif ($sortNo !== null) {
    60	            $errors->addMessage('admin.csv.error.category.new_must_not_have_sort', $row->getRowNumber());
    61	
    62	            return false;
    63	        }
    64	
    65	        if ($categoryId !== null && $parentId !== null && (int) $categoryId === (int) $parentId && (int) $parentId > 0) {
    66	            $errors->addMessage('admin.csv.error.category.id_equals_parent', $row->getRowNumber());
    67	
    68	            return false;
    69	        }
    70	
    71	        $Parent = null;
    72	        if ($parentId !== null && $parentId > 0) {
    73	            $Parent = $this->categoryRepository->find($parentId);
    74	            if ($Parent === null) {
    75	                $errors->addMessage('admin.csv.error.category.parent_not_found', $row->getRowNumber());
    76	
    77	                return false;
    78	            }
    79	
    80	            if ($isUpdate) {
    81	                for ($cursor = $Parent; $cursor !== null; $cursor = $cursor->getParent()) {
    82	                    if ((int) $cursor->getId() === (int) $categoryId) {
    83	                        $errors->addMessage('admin.csv.error.category.parent_is_descendant', $row->getRowNumber());
    84	
    85	                        return false;
    86	                    }
    87	                }
    88	            }
    89	        }
    90	
    91	        $level = $Parent !== null ? (int) $Parent->getHierarchy() + 1 : 1;
    92	        $maxLevel = (int) $this->eccubeConfig['eccube_category_nest_level'];
    93	        if ($level > $maxLevel) {
    94	            $errors->addMessage('admin.csv.error.category.nest_level_exceeded', $row->getRowNumber(), $maxLevel);
    95	
    96	            return false;
    97	        }
    98	
    99	        return true;
   100	    }
   101	}

