   591	     */
   592	    private function resolveTagPriorityIndex(int $tagId): array
   593	    {
   594	        $Tag = $this->getEntityManager()->find(Tag::class, $tagId);
   595	        if ($Tag === null) {
   596	            return [];
   597	        }
   598	
   599	        $priorityProducts = $Tag->getPriorityProducts();
   600	        if (empty($priorityProducts)) {
   601	            return [];
   602	        }
   603	
   604	        $lines = preg_split('/\r\n|\n|\r/', (string) $priorityProducts);
   605	        $codes = array_values(array_filter(array_map('trim', $lines ?: []), static fn (string $v): bool => $v !== ''));
   606	
   607	        return array_flip($codes);
   608	    }
