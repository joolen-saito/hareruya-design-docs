   128	     * @param FormInterface|null $form
   129	     *
   130	     * @return array<string, mixed>
   131	     */
   132	    private function buildPage(BaseInfo $BaseInfo, ?FormInterface $form = null): array
   133	    {
   134	        if ($form === null) {
   135	            $form = $this->createForm(BranchTopPageManagementType::class, $BaseInfo, [
   136	                'selected_base_info_id' => $BaseInfo->getId(),
   137	            ]);
   138	            $form->get('branch_list')->setData($BaseInfo);
   139	        }
   140	
   141	        return [
   142	            'form' => $form->createView(),
   143	            'selected_branch_id' => $BaseInfo->getId(),
   144	            'common_branch_id' => $this->baseInfoRepository->getMallBaseInfo()->getId(),
   145	            'is_common_branch' => $this->isCommonBranch($BaseInfo),
   146	            'form_errors' => $this->collectFormErrors($form),
   147	        ];
   148	    }
   149	
   150	    /**
   151	     * 選択中の支店が支店共通かどうかを判定する
   152	     *
   153	     * @param BaseInfo $BaseInfo
   154	     *
   155	     * @return bool
   156	     */
   157	    private function isCommonBranch(BaseInfo $BaseInfo): bool
   158	    {
   159	        return $BaseInfo->getId() === $this->baseInfoRepository->getMallBaseInfo()->getId();
   160	    }
   161	
   162	    /**
   163	     * 支店トップページ管理の画面表示
   164	     *
   165	     * @param BaseInfo $BaseInfo
   166	     * @param FormInterface|null $form
   167	     *
   168	     * @return Response
   169	     */
   170	    private function renderPage(BaseInfo $BaseInfo, ?FormInterface $form = null): Response
   171	    {
   172	        return $this->render('@admin/Content/branch_toppage.twig', $this->buildPage($BaseInfo, $form));
   173	    }
   174	
   175	    /**
   176	     * フォームのエラーメッセージを画面上部表示用に収集する
   177	     *
   178	     * @param FormInterface $form
   179	     *
   180	     * @return array<int, string>
   181	     */
   182	    private function collectFormErrors(FormInterface $form): array
   183	    {
   184	        $messages = [];
   185	        foreach ($form->getErrors() as $error) {
   186	            $messages[] = $error->getMessage();
   187	        }
   188	
   189	        return $messages;
   190	    }
   191	
   192	    /**
   193	     * リクエストから BaseInfo を特定して返す
   194	     *
   195	     * @param Request $request
   196	     * @param bool $preferFormBranch
   197	     *
   198	     * @return BaseInfo
   199	     */
   200	    private function resolvePostedBaseInfo(Request $request, bool $preferFormBranch = false): BaseInfo
   201	    {
   202	        $id = $request->request->getInt('branch_id');
   203	        $formData = $request->request->all('branch_toppage_management');
   204	        $formBranchId = (int) ($formData['branch_list'] ?? 0);
   205	        if ($preferFormBranch && $formBranchId > 0) {
   206	            $id = $formBranchId;
   207	        } elseif ($id <= 0) {
   208	            $id = $formBranchId;
   209	        }
   210	        $BaseInfo = $this->baseInfoRepository->find($id);
   211	        if ($BaseInfo === null) {
   212	            throw $this->createNotFoundException();
   213	        }
   214	
   215	        return $BaseInfo;
   216	    }
   217	
   218	    /**
   219	     * 支店トップページ管理の入力内容を検証し、保存前に必要な値を BaseInfo へ反映する
   220	     *
   221	     * @param FormInterface $form
   222	     * @param BaseInfo $BaseInfo
   223	     * @param string $originalBannerImage
   224	     *
   225	     * @return bool
   226	     */
   227	    private function validateTopPageManagement(FormInterface $form, BaseInfo $BaseInfo, string $originalBannerImage): bool
   228	    {
   229	        /** @var UploadedFile|null $imageFile */
   230	        $imageFile = $form->get('image_file')->getData();
   231	        $postedBannerImage = (string) $BaseInfo->getBannerImage();
   232	
   233	        if (!empty($imageFile)) {
   234	            $bannerImage = $this->storeBannerImage($form, $BaseInfo, $originalBannerImage);
   235	            if ($bannerImage === null || $bannerImage === '') {
   236	                $this->addError('admin.content.branch_toppage.banner_image_required', 'admin');
   237	
   238	                return false;
   239	            }
   240	            $BaseInfo->setBannerImage($bannerImage);
   241	        } else {
   242	            if ($originalBannerImage === $postedBannerImage) {
   243	                if ($originalBannerImage === '') {
   244	                    $this->addError('admin.content.branch_toppage.banner_image_required', 'admin');
   245	
   246	                    return false;
   247	                }
   248	            } elseif ($postedBannerImage === '') {
   249	                $this->addError('admin.content.branch_toppage.banner_image_required', 'admin');
   250	
   251	                return false;
   252	            }
   253	        }
   254	
   255	        return $this->validateTiles($BaseInfo);
   256	    }
   257	
   258	    /**
   259	     * タイル位置の重複とタイルタグ未設定を検証する
   260	     *
   261	     * @param BaseInfo $BaseInfo
   262	     *
   263	     * @return bool
   264	     */
   265	    private function validateTiles(BaseInfo $BaseInfo): bool
   266	    {
   267	        $sections = [];
   268	        foreach ($BaseInfo->getTiles() as $Tile) {
   269	            if ($this->entityManager->getUnitOfWork()->getEntityState($Tile) === \Doctrine\ORM\UnitOfWork::STATE_NEW) {
   270	                $Tile->setBaseInfo($BaseInfo);
   271	            }
   272	
   273	            if (in_array($Tile->getSection(), $sections, true)) {
   274	                $this->addError('admin.content.branch_toppage.duplicate_section', 'admin');
   275	
   276	                return false;
   277	            }
   278	
   279	            if ($Tile->getTileType()->getId() !== MtbTileType::PICKUP_PRODUCT && $Tile->getTag() === null) {
   280	                $this->addError('admin.content.branch_toppage.tag_required', 'admin');
   281	
   282	                return false;
   283	            }
   284	
   285	            $sections[] = $Tile->getSection();
   286	        }
   287	
   288	        return true;
   289	    }
   290	
   291	    /**
   292	     * アップロードされたバナー画像を保存し、保存先の S3 キーを返す
   293	     *
   294	     * @param FormInterface $form
   295	     * @param BaseInfo $BaseInfo
   296	     * @param string $originalBannerImage
   297	     *
   298	     * @return string|null
   299	     */
   300	    private function storeBannerImage(FormInterface $form, BaseInfo $BaseInfo, string $originalBannerImage): ?string
   301	    {
   302	        /** @var UploadedFile|null $imageFile */
   303	        $imageFile = $form->get('image_file')->getData();
   304	        if (empty($imageFile)) {
   305	            return $BaseInfo->getBannerImage();
   306	        }
   307	
   308	        $adapter = $this->fileManager->getAdapter($this->eccubeConfig->get('default_file_adapter'));
   309	
   310	        $extension = strtolower((string) $imageFile->getClientOriginalExtension());
   311	        if ($extension === '') {
   312	            $extension = 'jpg';
   313	        }
   314	
   315	        $fileName = sprintf('%s%d.%s', uniqid(), random_int(100, 999), $extension);
   316	        $uploadDir = $this->eccubeConfig->get('branch_top_banner_directory').'/'.$BaseInfo->getHtmlClassName();
   317	
   318	        try {
   319	            $this->fileManager->uploadFile(
   320	                $imageFile->getPathname(),
   321	                $uploadDir,
   322	                $fileName,
   323	                $this->eccubeConfig->get('default_file_adapter'),
   324	            );
   325	
   326	            if ($originalBannerImage !== '' && $adapter->exists($originalBannerImage, [])) {
   327	                $adapter->delete($originalBannerImage, []);
   328	            }
   329	
   330	            return $uploadDir.'/'.$fileName;
   331	        } catch (\Throwable $e) {
   332	            log_error('バナー画像のアップロードに失敗しました', ['exception' => $e->getMessage()]);
   333	
   334	            return null;
   335	        }
   336	    }
   337	}

