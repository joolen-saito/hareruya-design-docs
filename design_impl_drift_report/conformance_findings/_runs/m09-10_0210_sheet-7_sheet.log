   380	    /**
   381	     * 支店ECTOP §2 SALE中の商品 仕様準拠で取得する。
   382	     *
   383	     * 設計書 0301 §2 SALE 中の商品の条件:
   384	     * 1) 商品公開ステータス「公開」
   385	     * 2) システム廃止していない (Status=DISPLAY_SHOW で兼ねる)
   386	     * 3) 表示店舗 (base_info_id) の在庫1以上
   387	     * 4) セールタグ (Tag::SALE_ID)
   388	     * 5) セールフラグ (sale_flg = true)
   389	     * 6) 販売価格 1円以上 (price02 >= 1)
   390	     * 7) 状態最良の選出はテンプレート側 (ProductClasses sort by CardCondition.id ASC)
   391	     * 8) 並び順ランダム
   392	     *
   393	     * @return ProductClass[]
   394	     */
   395	    public function findTopSaleProductsByBaseInfo(int $baseInfoId, string $locale, int $limit): array
   396	    {
   397	        $sql = <<<'SQL'
   398	            SELECT p.id
   399	            FROM dtb_product p
   400	            LEFT JOIN mtb_region_restriction rr ON rr.id = p.region_restriction_id
   401	            WHERE p.product_status_id = :statusShow
   402	              AND (rr.display_locale_list IS NULL OR rr.display_locale_list LIKE :locale)
   403	              AND EXISTS (
   404	                  SELECT 1
   405	                  FROM dtb_product_class pc
   406	                  INNER JOIN dtb_product_stock ps ON ps.product_class_id = pc.id
   407	                  INNER JOIN dtb_product_tag pt ON pt.product_id = pc.product_id AND pt.tag_id = :saleTagId
   408	                  WHERE pc.product_id = p.id
   409	                    AND pc.visible = true
   410	                    AND pc.sale_flg = true
   411	                    AND pc.price02 >= 1
   412	                    AND ps.stock > 0
   413	                    AND ps.base_info_id = :baseInfoId
   414	              )
   415	            ORDER BY RANDOM()
   416	            LIMIT :limit
   417	            SQL;
   418	
   419	        $rows = $this->getEntityManager()->getConnection()->executeQuery($sql, [
   420	            'statusShow' => ProductStatus::DISPLAY_SHOW,
   421	            'locale' => '%'.$locale.'%',
   422	            'saleTagId' => Tag::SALE_ID,
   423	            'baseInfoId' => $baseInfoId,
   424	            'limit' => $limit,
   425	        ])->fetchAllAssociative();
   426	
   427	        $productIds = array_map(static fn (array $row): int => (int) $row['id'], $rows);
   428	        if ($productIds === []) {
   429	            return [];
   430	        }
   431	
   432	        /** @var ProductClass[] $candidates */
   433	        $candidates = $this->getEntityManager()->createQueryBuilder()
   434	            ->select('pc', 'p')
   435	            ->from(ProductClass::class, 'pc')
   436	            ->innerJoin('pc.Product', 'p')
   437	            ->where('p.id IN (:productIds)')
   438	            ->andWhere('pc.visible = true')
   439	            ->andWhere('pc.sale_flg = true')
   440	            ->andWhere('pc.price02 >= 1')
   441	            ->andWhere('EXISTS (
   442	                SELECT 1 FROM \Eccube\Entity\ProductStock ps
   443	                WHERE ps.ProductClass = pc
   444	                  AND ps.stock > 0
   445	                  AND IDENTITY(ps.baseInfo) = :baseInfoId
   446	            )')
   447	            ->setParameter('productIds', $productIds)
   448	            ->setParameter('baseInfoId', $baseInfoId)
   449	            ->getQuery()
   450	            ->getResult();
   451	
   452	        $selectedByProductId = [];
   453	        foreach ($candidates as $ProductClass) {
   454	            $productId = $ProductClass->getProduct()->getId();
   455	            $current = $selectedByProductId[$productId] ?? null;
   456	            if ($current === null || $this->isBetterCardCondition($ProductClass, $current)) {
   457	                $selectedByProductId[$productId] = $ProductClass;
   458	            }
   459	        }
   460	
   461	        $ordered = [];
   462	        foreach ($productIds as $id) {
   463	            if (isset($selectedByProductId[$id])) {
   464	                $ordered[] = $selectedByProductId[$id];
   465	            }
   466	        }
   467	
   468	        return $ordered;
   469	    }
