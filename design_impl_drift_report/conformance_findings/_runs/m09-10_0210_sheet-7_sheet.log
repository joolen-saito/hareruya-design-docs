    69	
    70	    const fileElement = document.getElementById('{{ form.image_file.vars.id }}');
    71	    if (fileElement) {
    72	        fileElement.addEventListener('change', function() {
    73	            if (this.files.length === 0) {
    74	                return;
    75	            }
    76	            $('#{{ form.banner_image.vars.id }}').val('');
    77	            const src = URL.createObjectURL(this.files[0]);
    78	            showThumbnail(src);
