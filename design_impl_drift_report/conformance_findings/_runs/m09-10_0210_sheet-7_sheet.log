   137	        } else if (!$('#common-setting').prop('checked')) {
   138	            tagSelectForm.removeAttr('disabled');
   139	        }
   140	    }
   141	
   142	    $('#common-setting').on('change', function() {
   143	        switchFormAvailable();
   144	        $("[id^='branch_toppage_management_Tiles_'][id*='_tileType']").each(function() {
   145	            switchTagFormAvailable($(this));
   146	        });
   147	    });
   148	
   149	    $(document).on('change', "[id^='branch_toppage_management_Tiles_'][id*='_tileType']", function() {
   150	        switchTagFormAvailable($(this));
   151	    });
   152	
   153	    switchFormAvailable();
   154	    $("[id^='branch_toppage_management_Tiles_'][id*='_tileType']").each(function() {
   155	        switchTagFormAvailable($(this));
   156	    });
   157	});
   158	</script>
