   118	
   119	    function switchFormAvailable() {
   120	        if ($('#common-setting').prop('checked')) {
   121	            $('#branch_toppage_management_image_file').attr('disabled', 'disabled');
   122	            $('#branch_toppage_management_banner_image_tag').attr('disabled', 'disabled');
