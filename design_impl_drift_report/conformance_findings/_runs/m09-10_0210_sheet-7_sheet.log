    88	
    89	    const $collectionHolder = $('#tiles');
    90	    const sectionValues = Object.values({{ constant('\\Eccube\\Form\\Type\\Admin\\Content\\BranchTopPageTileType::SECTIONS')|json_encode|raw }});
    91	    let index = $collectionHolder.find('.tile-config').length;
    92	    const usedSections = new Set(
    93	        $collectionHolder.find("[id$='_section']").map((_, el) => Number($(el).val())).get()
    94	    );
    95	
    96	    sectionValues.forEach((sectionValue) => {
    97	        if (index >= sectionValues.length) {
    98	            return;
    99	        }
   100	
   101	        if (usedSections.has(sectionValue)) {
   102	            return;
   103	        }
   104	
   105	        const prototype = $collectionHolder.data('bs-prototype');
   106	        if (prototype !== undefined) {
   107	            const newForm = prototype.replace(/__name__/g, index);
   108	            const $lastRow = $('#tiles .tile-config:last');
