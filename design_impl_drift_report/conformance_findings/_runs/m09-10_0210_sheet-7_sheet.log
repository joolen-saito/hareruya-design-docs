    80	    }
    81	
    82	    $('#thumb').on('click', '.delete-image', function(e) {
    83	        e.preventDefault();
    84	        hideThumbnail();
    85	        $('#{{ form.image_file.vars.id }}').val('');
    86	        $('#{{ form.banner_image.vars.id }}').val('');
