   580	            ->andWhere('rr.display_locale_list IS NULL OR rr.display_locale_list LIKE :locale')
   581	            ->setParameter('statusShow', ProductStatus::DISPLAY_SHOW)
   582	            ->setParameter('tagId', $tagId)
