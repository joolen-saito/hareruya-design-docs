   524	    public function findTopPublicProductsByTag(int $tagId, string $locale, int $limit, ?int $baseInfoId = null): array
   525	    {
   526	        $priorityIndex = $this->resolveTagPriorityIndex($tagId);
   527	
   528	        /** @var ProductClass[] $candidates */
   529	        $candidates = $this->buildPublicProductClassesByTagQueryBuilder($tagId, $locale, $baseInfoId)
   530	            ->getQuery()
   531	            ->getResult();
   532	
   533	        $selectedByProductId = [];
   534	        foreach ($candidates as $ProductClass) {
   535	            $productId = $ProductClass->getProduct()->getId();
   536	            $current = $selectedByProductId[$productId] ?? null;
   537	            if ($current === null || $this->compareProductClassPreference($ProductClass, $current, $priorityIndex) < 0) {
   538	                $selectedByProductId[$productId] = $ProductClass;
   539	            }
   540	        }
   541	
   542	        $selected = array_values($selectedByProductId);
   543	        usort($selected, function (ProductClass $a, ProductClass $b) use ($priorityIndex): int {
   544	            $aPos = $this->priorityPositionOfProductClass($a, $priorityIndex);
   545	            $bPos = $this->priorityPositionOfProductClass($b, $priorityIndex);
   546	            if ($aPos !== $bPos) {
   547	                return $aPos <=> $bPos;
   548	            }
   549	
   550	            return $b->getProduct()->getId() <=> $a->getProduct()->getId();
   551	        });
   552	
   553	        return array_slice($selected, 0, $limit);
   554	    }
