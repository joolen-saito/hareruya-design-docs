   559	    private function buildPublicProductClassesByTagQueryBuilder(int $tagId, string $locale, ?int $baseInfoId = null): QueryBuilder
   560	    {
   561	        $effectiveBaseInfoId = $baseInfoId ?? (int) $this->eccubeConfig->get('eccube_root_base_info_id');
   562	
   563	        return $this->getEntityManager()->createQueryBuilder()
   564	            ->select('pc', 'p')
