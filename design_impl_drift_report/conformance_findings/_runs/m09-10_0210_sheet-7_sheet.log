   476	    public function findTopPickUpProductsByBaseInfo(int $baseInfoId, string $locale, int $limit): array
   477	    {
   478	        /** @var ProductClass[] $candidates */
   479	        $candidates = $this->getEntityManager()->createQueryBuilder()
   480	            ->select('pc', 'p')
   481	            ->from(ProductClass::class, 'pc')
   482	            ->innerJoin('pc.Product', 'p')
   483	            ->leftJoin('p.RegionRestriction', 'rr')
   484	            ->where('pc.visible = true')
   485	            ->andWhere('p.Status = :statusShow')
   486	            ->andWhere('EXISTS (
   487	                SELECT 1 FROM \Eccube\Entity\ProductStock ps
   488	                WHERE ps.ProductClass = pc
   489	                  AND ps.stock > 0
   490	                  AND ps.pick_up_flg = true
   491	                  AND IDENTITY(ps.baseInfo) = :baseInfoId
   492	            )')
   493	            ->andWhere('(rr.display_locale_list IS NULL OR rr.display_locale_list LIKE :locale)')
   494	            ->setParameter('statusShow', ProductStatus::DISPLAY_SHOW)
   495	            ->setParameter('baseInfoId', $baseInfoId)
   496	            ->setParameter('locale', '%'.$locale.'%')
   497	            ->getQuery()
   498	            ->getResult();
   499	
   500	        $selectedByProductId = [];
   501	        foreach ($candidates as $ProductClass) {
   502	            $productId = $ProductClass->getProduct()->getId();
   503	            $current = $selectedByProductId[$productId] ?? null;
   504	            if ($current === null || $this->isBetterCardCondition($ProductClass, $current)) {
   505	                $selectedByProductId[$productId] = $ProductClass;
   506	            }
   507	        }
   508	
   509	        $selected = array_values($selectedByProductId);
