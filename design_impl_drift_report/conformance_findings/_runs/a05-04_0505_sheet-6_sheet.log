namespace Eccube\Service\Smaregi\Webhook;

use Eccube\Entity\SmaregiWebhookEvent;
use Eccube\Repository\SmaregiWebhookEventRepository;
use Symfony\Component\HttpFoundation\Request;

class EventService
{
    public function __construct(
        private readonly SmaregiWebhookEventRepository $smaregiWebhookEventRepository,
    ) {
    }

    public function createEventFromRequest(Request $request): SmaregiWebhookEvent
    {
        $body = json_decode($request->getContent(), true);

        $smaregiEventId = $request->headers->get('smaregi-event-id');

        if ($smaregiEventId === null) {
            throw new \InvalidArgumentException('Smaregi-Event-Id header is required');
        }

        $Event = new SmaregiWebhookEvent();
        $Event->setContractId($body['contractId'] ?? '');
        $Event->setSmaregiEventId($smaregiEventId);
        $Event->setEvent($body['event'] ?? '');
        $Event->setAction($body['action'] ?? '');
        $Event->setRequestHeaders($request->headers->all());
        $Event->setRequestBody($body);
        $Event->setReceivedAt(new \DateTime());
        $Event->setStatus(SmaregiWebhookEvent::STATUS_PENDING);

        return $Event;
    }

    public function isDuplicate(string $smaregiEventId): bool
    {
        $Existing = $this->smaregiWebhookEventRepository->findBySmaregiEventId($smaregiEventId);

        return $Existing !== null;
    }
}

