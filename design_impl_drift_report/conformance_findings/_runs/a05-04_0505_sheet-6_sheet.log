namespace Eccube\Service\Smaregi\Webhook\Transaction\Handler\Pattern;

use Doctrine\ORM\EntityManagerInterface;
use Eccube\Dto\Smaregi\Api\Transaction\TransactionDto;
use Eccube\Entity\DtbPlayer;
use Eccube\Entity\Order;
use Eccube\Repository\OrderRepository;
use Eccube\Service\Smaregi\Webhook\Transaction\SmaregiOrderFactory;
use Psr\Log\LoggerInterface;

/**
 * Pattern 8 (店頭購入(会員)) のハンドラ。
 *
 * スマレジ取引に対応する EC-CUBE 受注を新規作成し、Player/Customer を紐付けて保存する。
 * EC-CUBE 上に該当する既存受注は存在しない前提のため、移行先ID 登録などは行わない。
 */
final readonly class OtcMemberPatternHandler
{
    public function __construct(
        private LoggerInterface $logger,
        private EntityManagerInterface $entityManager,
        private OrderRepository $orderRepository,
        private SmaregiOrderFactory $orderFactory,
    ) {
    }

    public function handle(TransactionDto $transaction, DtbPlayer $member): Order
    {
        $transactionHeadId = $transaction->transactionHeadId;
        if ($transactionHeadId === null || $transactionHeadId === '') {
            throw new \RuntimeException('Smaregi OTC member order creation requires a non-empty transactionHeadId.');
        }

        // 同一 transactionHeadId の Webhook が並列処理されても受注を重複作成しないよう、
        // 取引IDをキーにアドバイザリロックで find-or-create を直列化する
        // (findOneBy 単独では check と insert の間に別プロセスが割り込み得るため)。
        $lockName = SmaregiOtcOrderLock::PREFIX.$transactionHeadId;
        if (!$this->orderRepository->getLock($lockName, SmaregiOtcOrderLock::TIMEOUT_SECONDS)) {
            throw new \RuntimeException(sprintf('Failed to acquire Smaregi OTC order creation lock (transactionHeadId=%s)', $transactionHeadId));
        }

        try {
            // 冪等性: 既に作成済みなら再作成せず再利用する (ロック確立後に再確認)。
            $existing = $this->orderRepository->findOneBy(['smaregiTransactionId' => $transactionHeadId]);
            if ($existing instanceof Order) {
                $this->logger->info('Smaregi OTC member order already exists for transaction, reusing', [
                    'orderId' => $existing->getId(),
                    'transactionHeadId' => $transaction->transactionHeadId,
                ]);

                return $existing;
            }

            $order = $this->orderFactory->createForMember($transaction, $member);

            $this->entityManager->persist($order);
            foreach ($order->getOrderItems() as $item) {
                $this->entityManager->persist($item);
            }
            // 待機側がロック解放後の findOneBy で確実に検出できるよう、解放前に flush で確定させる。
            $this->entityManager->flush();

            $this->logger->info('Smaregi OTC member order created', [
                'orderId' => $order->getId(),
                'transactionHeadId' => $transaction->transactionHeadId,
                'playerId' => $member->getId(),
            ]);

            return $order;
        } finally {
            $this->orderRepository->releaseLock($lockName);
        }
    }
}

