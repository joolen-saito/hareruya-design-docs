/home/y-saito/Developments/ec-cube-enterprise/app/DoctrineMigrations/sql/mtb_card_detail_2.sql:45582:	 (64499,22637,1,4,183,30,2,NULL,'','The sound of every twisted secret tempts you to hear another.','飛行、トランプル
