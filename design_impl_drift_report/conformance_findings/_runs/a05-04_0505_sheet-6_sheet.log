        private EntityManagerInterface $entityManager,
        private OrderRepository $orderRepository,
        private OrderStatusRepository $orderStatusRepository,
        private StockReduceProcessor $stockReduceProcessor,
    ) {
    }

    public function process(SmaregiWebhookEvent $event, TransactionDto $transaction): void
    {
        $transactionHeadId = $transaction->transactionHeadId ?? '';
        if ($transactionHeadId === '') {
            $this->logger->warning('Smaregi canceled processor received a transaction with no transactionHeadId', [
                'webhookEventId' => $event->getId(),
            ]);

            return;
        }

        if (!$transaction->isCanceled()) {
            $this->logger->info('Smaregi canceled webhook received but cancelDivision is not 1, skipping', [
                'webhookEventId' => $event->getId(),
                'transactionHeadId' => $transactionHeadId,
                'cancelDivision' => $transaction->cancelDivision,
            ]);

            return;
        }

        $Order = $this->orderRepository->findOneBy(['smaregiTransactionId' => $transactionHeadId]);
        if (!$Order instanceof Order) {
            // TODO: webhook の到着順序が前後し、created がまだ届いていない場合のリカバリは別 PR (進捗管理 issue 候補参照)
            $this->logger->warning('No matching ECCUBE order for canceled Smaregi transaction', [
                'webhookEventId' => $event->getId(),
                'transactionHeadId' => $transactionHeadId,
            ]);

            return;
        }

        if ($Order->getOrderStatus()?->getId() === OrderStatus::CANCEL) {
            $this->logger->info('Order is already canceled, skipping', [
                'webhookEventId' => $event->getId(),
                'transactionHeadId' => $transactionHeadId,
                'orderId' => $Order->getId(),
            ]);

            return;
        }

        $CancelStatus = $this->orderStatusRepository->find(OrderStatus::CANCEL);
        if (!$CancelStatus instanceof OrderStatus) {
            throw new \RuntimeException('OrderStatus CANCEL is not found.');
        }

        $this->stockReduceProcessor->rollback($Order, new PurchaseContext());
        $Order->setOrderStatus($CancelStatus);
        $this->entityManager->flush();

        $this->logger->info('Smaregi canceled: order stock restored and status updated to CANCEL', [
            'webhookEventId' => $event->getId(),
            'transactionHeadId' => $transactionHeadId,
            'orderId' => $Order->getId(),
        ]);
    }
}

