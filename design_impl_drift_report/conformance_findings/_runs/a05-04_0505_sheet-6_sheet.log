/home/y-saito/Developments/ec-cube-enterprise/app/DoctrineMigrations/sql/mtb_card_detail_2.sql:9888:	 (48672,4499,1,2,141,33,1,NULL,'','Even after Anafenza was executed, many secretly maintained their beliefs in the old ways.','(２)(白)：鼓舞１を行う。（あなたがコントロールするクリーチャーの中で最も小さいタフネスを持つクリーチャーを１体選び、それの上に+1/+1カウンターを１個置く。）','{2}{White}: Bolster 1. (Choose a creature with the least toughness among creatures you control and put a +1/+1 counter on it.)','','','15',1,false,0,'2019-03-13 04:21:24+09','2025-07-31 20:50:33+09'),
/home/y-saito/Developments/ec-cube-enterprise/app/DoctrineMigrations/sql/mtb_card_detail_2.sql:10102:	 (48750,4574,1,3,141,32,1,NULL,'','"Silumgar''s mind is a dark labyrinth, full of grim secrets and subtle traps."
/home/y-saito/Developments/ec-cube-enterprise/app/DoctrineMigrations/sql/mtb_card_detail_2.sql:10920:	 (49060,5709,1,2,138,223,1,NULL,'','"There is no secret buried so deep that we will never find it."
/home/y-saito/Developments/ec-cube-enterprise/app/DoctrineMigrations/sql/mtb_card_detail_2.sql:10988:	 (49082,5731,1,2,138,532,1,NULL,'','"Their origins are shrouded in mystery. I believe they are the protectors of the lost secrets of our world."
