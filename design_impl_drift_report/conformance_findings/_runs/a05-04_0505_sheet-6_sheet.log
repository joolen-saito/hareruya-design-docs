namespace Eccube\Service\Smaregi\Webhook\Transaction\Handler\Pattern;

use Doctrine\ORM\EntityManagerInterface;
use Eccube\Dto\Smaregi\Api\Transaction\TransactionDto;
use Eccube\Entity\Master\OrderStatus;
use Eccube\Entity\Order;
use Eccube\Repository\Master\OrderStatusRepository;
use Psr\Log\LoggerInterface;

/**
 * Pattern 1 (ECCUBE購入・スムーズ店頭受取) のハンドラ。
 *
 * 既存 OTC 受注の特定は `Order.smaregi_code` (= スマレジ商品コード) と取引明細の `productCode`
 * の突合で行う ({@see PurchasePatternContextBuilder})。店頭受取注文スマレジ連携バッチが
 * 1 注文 = 1 スマレジ商品で採番するため、構造上は当該受注のみが対象となり別受注を巻き込まない。
 */
final readonly class EccubeSmoothOtcPatternHandler
{
    public function __construct(
        private LoggerInterface $logger,
        private EntityManagerInterface $entityManager,
        private OrderStatusRepository $orderStatusRepository,
    ) {
    }

    /**
     * @param list<Order> $matchedOrders productCode で既存 EC-CUBE OTC 受注に突合した受注
     *
     * @return list<Order>
     */
    public function handle(TransactionDto $transaction, array $matchedOrders): array
    {
        // スムーズ店頭受取 (Pattern 1) は仕様上「出荷完了 (DELIVERED)」へ更新する。
        $delivered = $this->orderStatusRepository->find(OrderStatus::DELIVERED);
        if (!$delivered instanceof OrderStatus) {
            throw new \RuntimeException('OrderStatus DELIVERED is not found.');
        }

        if ($matchedOrders === []) {
            $this->logger->warning('Smaregi smooth-otc transaction has no matched ECCUBE order', [
                'transactionHeadId' => $transaction->transactionHeadId,
            ]);

            return [];
        }

        foreach ($matchedOrders as $order) {
            $order->setOrderStatus($delivered);
            $order->setSmaregiTransactionId($transaction->transactionHeadId);
        }
        $this->entityManager->flush();

        $this->logger->info('Smaregi smooth-otc orders updated to delivered', [
            'transactionHeadId' => $transaction->transactionHeadId,
            'orderIds' => array_map(static fn (Order $order): ?int => $order->getId(), $matchedOrders),
        ]);

        return $matchedOrders;
    }
}

