namespace Eccube\Service\Smaregi\Webhook\Transaction;

use Eccube\Dto\Smaregi\Api\Transaction\TransactionDto;
use Eccube\Entity\Delivery;
use Eccube\Entity\DtbPlayer;
use Eccube\Entity\Order;
use Eccube\Repository\DtbPlayerRepository;
use Eccube\Repository\OrderRepository;

/**
 * 既存 EC-CUBE 受注との突合は `Order.smaregi_code` (= スマレジ商品コード) で行う。
 * スマレジ側 `productId` は EC-CUBE に保存していないため、両者で共有可能な共通キーとして
 * `productCode` を採用する。
 *
 * 店頭PC購入 (Pattern 4-7) も店頭受取 (Pattern 2/3) と同じく配送方法=店頭受取で登録されるため、
 * 突合自体は同一クエリで行える。両者の区別は突合した既存受注に紐づく顧客 (Customer) の
 * DtbPlayer の顧客グループが OTC / OTC_SHITEN (店頭販売グループ) か否かで判定する。
 */
final readonly class PurchasePatternContextBuilder
{
    public function __construct(
        private OrderRepository $orderRepository,
        private DtbPlayerRepository $playerRepository,
    ) {
    }

    public function build(TransactionDto $transaction): PurchasePatternContext
    {
        $transactionProductCodes = $this->extractDistinctProductCodes($transaction);
        $matchedOrders = $transactionProductCodes === []
            ? []
            : $this->orderRepository->findOtcOrdersBySmaregiCodes($transactionProductCodes);
        $matchedSmaregiCodes = $this->collectSmaregiCodes($matchedOrders);

        $hasEccubePurchase = $matchedOrders !== [];
        $isMember = $this->hasSmaregiCustomerId($transaction);
        // isMember はスマレジ側の会員判定 (customerId の有無) で決める。
        // EC-CUBE 側の Player 解決失敗は OTC_MEMBER ハンドラの fallback に委ね、
        // 「スマレジは会員と言っているが EC-CUBE 未連携」のケースを warning ログで可視化する。
        $member = $isMember ? $this->resolveMember($transaction) : null;

        return new PurchasePatternContext(
            hasEccubePurchase: $hasEccubePurchase,
            isOtcPcPurchase: $this->isOtcPcPurchase($matchedOrders),
            hasAddOnPurchase: $hasEccubePurchase && $this->hasAddOnPurchase($transactionProductCodes, $matchedSmaregiCodes),
            pickupMethod: $this->resolvePickupMethod($matchedOrders),
            isMember: $isMember,
            matchedOrders: $matchedOrders,
            matchedSmaregiCodes: $matchedSmaregiCodes,
            member: $member,
        );
    }

    private function hasSmaregiCustomerId(TransactionDto $transaction): bool
    {
        $smaregiCustomerId = $transaction->customerId;

        return $smaregiCustomerId !== null && $smaregiCustomerId !== '';
    }

    private function resolveMember(TransactionDto $transaction): ?DtbPlayer
    {
        return $this->playerRepository->findOneBy(['smaregiId' => $transaction->customerId]);
    }

    /**
     * 突合した既存受注のいずれかが店頭販売グループの顧客の注文であれば店頭PC購入と判定する。
     * 店頭PC購入注文も配送方法は店頭受取で登録されるため、店頭受取 (Pattern 2/3) との区別は
     * 受注に紐づく顧客 (Customer) の DtbPlayer の顧客グループで行う。
     *
     * @param list<Order> $matchedOrders
     */
    private function isOtcPcPurchase(array $matchedOrders): bool
    {
        foreach ($matchedOrders as $order) {
            if ($this->isOtcGroupCustomerOrder($order)) {
                return true;
            }
        }

        return false;
    }

    private function isOtcGroupCustomerOrder(Order $order): bool
    {
        $player = $order->getCustomer()?->getPlayer();

        return $player !== null && $player->isOtcGroupPlayer();
    }

    /**
     * @return list<string>
     */
    private function extractDistinctProductCodes(TransactionDto $transaction): array
    {
        $codes = [];
        foreach ($transaction->details as $detail) {
            $productCode = $detail->productCode;
            if ($productCode === null || $productCode === '') {
                continue;
            }
            $codes[$productCode] = true;
        }

        return array_keys($codes);
    }

    /**
     * @param list<Order> $matchedOrders
     *
     * @return list<string>
     */
    private function collectSmaregiCodes(array $matchedOrders): array
    {
        $codes = [];
        foreach ($matchedOrders as $order) {
            $code = $order->getSmaregiCode();
            if ($code === null || $code === '') {
                continue;
            }
            $codes[$code] = true;
        }

        return array_keys($codes);
    }

    /**
     * @param list<Order> $matchedOrders
     */
    private function resolvePickupMethod(array $matchedOrders): PickupMethod
    {
        foreach ($matchedOrders as $order) {
            foreach ($order->getShippings() as $shipping) {
                $delivery = $shipping->getDelivery();
                if ($delivery === null) {
                    continue;
                }

                $pickupMethod = match ($delivery->getId()) {
                    Delivery::SMOOTH_OTC => PickupMethod::SMOOTH_OTC,
                    Delivery::OTC => PickupMethod::OTC,
                    default => null,
                };
                if ($pickupMethod !== null) {
                    return $pickupMethod;
                }
            }
        }

        return PickupMethod::NONE;
    }

    /**
     * 取引明細の productCode のうち、matchedSmaregiCodes に含まれないものが 1 件でもあればついで買い有り。
     *
     * @param list<string> $transactionProductCodes
     * @param list<string> $matchedSmaregiCodes
     */
    private function hasAddOnPurchase(array $transactionProductCodes, array $matchedSmaregiCodes): bool
    {
        $matchedLookup = array_flip($matchedSmaregiCodes);
        foreach ($transactionProductCodes as $code) {
            if (!isset($matchedLookup[$code])) {
                return true;
            }
        }

        return false;
    }
}

