namespace Eccube\Service\Smaregi\Webhook\Transaction;

use Eccube\Dto\Smaregi\Api\Transaction\TransactionDetailDto;
use Eccube\Dto\Smaregi\Api\Transaction\TransactionDto;
use Eccube\Entity\BaseInfo;
use Eccube\Entity\DtbPlayer;
use Eccube\Entity\Master\OrderItemType;
use Eccube\Entity\Master\OrderStatus;
use Eccube\Entity\Order;
use Eccube\Entity\OrderItem;
use Eccube\Entity\ProductClass;
use Eccube\Repository\BaseInfoRepository;
use Eccube\Repository\Master\OrderItemTypeRepository;
use Eccube\Repository\Master\OrderStatusRepository;
use Eccube\Repository\ProductClassRepository;
use Psr\Log\LoggerInterface;

/**
 * 設計書: スマレジ取引の支払方法は「店頭支払」固定。原価は受信しても保存しない。
 *
 * TODO: 連携用アカウント (システム設定) を更新者にセットする
 * TODO: order_no の採番ルールを確定する
 * TODO: 商品未解決時の挙動 (現状: warningログ出して ProductClass 未リンクで継続) を
 *       設計書「商品未解決 → エラーキューへ退避」に合わせる
 * TODO: canceled/disposed 区分は当該 webhook 実装PRで Order にカラム追加してセットする
 */
final readonly class SmaregiOrderFactory
{
    private const SMAREGI_PAYMENT_METHOD = '店頭支払';
    private const GUEST_NAME01 = '非会員';
    private const GUEST_NAME02 = '';
    private const FALLBACK_BASE_INFO_ID = 1;

    public function __construct(
        private LoggerInterface $logger,
        private OrderStatusRepository $orderStatusRepository,
        private OrderItemTypeRepository $orderItemTypeRepository,
        private BaseInfoRepository $baseInfoRepository,
        private ProductClassRepository $productClassRepository,
    ) {
    }

    public function createForGuest(TransactionDto $transaction): Order
    {
        $baseInfo = $this->resolveBaseInfo($transaction->storeId);

        $order = $this->buildOrderShell($transaction, $baseInfo);
        $order->setName01(self::GUEST_NAME01);
        $order->setName02(self::GUEST_NAME02);

        foreach ($this->buildOrderItems($transaction, $baseInfo) as $item) {
            $item->setOrder($order);
            $order->addOrderItem($item);
        }

        return $order;
    }

    public function createForMember(TransactionDto $transaction, DtbPlayer $player): Order
    {
        $order = $this->createShellForMember($transaction, $player);
        $baseInfo = $order->getBaseInfo();

        foreach ($this->buildOrderItems($transaction, $baseInfo) as $item) {
            $item->setOrder($order);
            $order->addOrderItem($item);
        }

        return $order;
    }

    /**
     * 取引明細を OrderItem として展開せず、ヘッダ (Order shell) のみを作成する。
     *
     * Pattern 2/3 ({@see Handler\Pattern\EccubeOtcPatternHandler})
     * のように、新規受注の明細を「既存受注の OrderItem 複製 + 取引明細から作るついで買い分」で
     * 組み立てたい場合に使う。
     */
    public function createShellForMember(TransactionDto $transaction, DtbPlayer $player): Order
    {
        $baseInfo = $this->resolveBaseInfo($transaction->storeId);

        $order = $this->buildOrderShell($transaction, $baseInfo);
        $customer = $player->getCustomer();
        $order->setCustomer($customer);
        // 顧客情報が紐付かない (smaregi_id だけ振っていてカスタマー未連結) Player のときは
        // 表示が空にならないよう Player の氏名を fallback として使う。
        $order->setName01($customer?->getName01() ?? $player->getLastNameJp() ?? '');
        $order->setName02($customer?->getName02() ?? $player->getFirstNameJp() ?? '');

        return $order;
    }

    public function createShellForGuest(TransactionDto $transaction): Order
    {
        $baseInfo = $this->resolveBaseInfo($transaction->storeId);

        $order = $this->buildOrderShell($transaction, $baseInfo);
        $order->setName01(self::GUEST_NAME01);
        $order->setName02(self::GUEST_NAME02);

        return $order;
    }

    /**
     * 取引明細 1 件から OrderItem を組み立てる。Order への紐付けは呼び出し側で行う。
     */
    public function buildOrderItemFromDetail(TransactionDetailDto $detail, BaseInfo $baseInfo): OrderItem
    {
        $itemType = $this->orderItemTypeRepository->find(OrderItemType::PRODUCT);
        if (!$itemType instanceof OrderItemType) {
            throw new \RuntimeException('OrderItemType PRODUCT is not found.');
        }

        return $this->buildOrderItem($detail, $itemType, $baseInfo);
    }

    /**
     * 既存 OrderItem を新規受注用に複製する。Order への紐付けは呼び出し側で行う。
     *
     * Pattern 2/3 で「既存受注の明細を解いて新規受注へ繋ぐ」用途に使う。
     * Shipping は元受注のものに紐付くため意図的に複製しない。
     */
    public function cloneOrderItemForNewOrder(OrderItem $source, BaseInfo $baseInfo): OrderItem
    {
        $itemType = $source->getOrderItemType() ?? $this->orderItemTypeRepository->find(OrderItemType::PRODUCT);
        if (!$itemType instanceof OrderItemType) {
            throw new \RuntimeException('OrderItemType could not be resolved for clone source.');
        }

        $clone = new OrderItem();
        $clone->setBaseInfo($baseInfo);
        $clone->setOrderItemType($itemType);
        $clone->setProduct($source->getProduct());
        $clone->setProductClass($source->getProductClass());
        $clone->setProductName($source->getProductName());
        $clone->setProductCode($source->getProductCode());
        $clone->setClassName1($source->getClassName1());
        $clone->setClassName2($source->getClassName2());
        $clone->setClassCategoryName1($source->getClassCategoryName1());
        $clone->setClassCategoryName2($source->getClassCategoryName2());
        $clone->setPrice($source->getPrice() ?? '0');
        $clone->setQuantity($source->getQuantity());
        $clone->setTotalCost($source->getTotalCost());
        $clone->setTax($source->getTax());
        $clone->setTaxRate($source->getTaxRate());
        $clone->setTaxAdjust($source->getTaxAdjust());
        $clone->setTaxType($source->getTaxType());
        $clone->setTaxDisplayType($source->getTaxDisplayType());
        $clone->setRoundingType($source->getRoundingType());

        return $clone;
    }

    private function buildOrderShell(TransactionDto $transaction, BaseInfo $baseInfo): Order
    {
        $orderStatus = $this->orderStatusRepository->find(OrderStatus::PASSED);
        if (!$orderStatus instanceof OrderStatus) {
            throw new \RuntimeException('OrderStatus PASSED is not found.');
        }

        $order = new Order($orderStatus);
        $order->setBaseInfo($baseInfo);
        $order->setSmaregiTransactionId($transaction->transactionHeadId);
        $order->setSmaregiMemo($transaction->memo);
        $order->setOrderDate($this->parseDateTime($transaction->terminalTranDateTime) ?? new \DateTime());
        $order->setPaymentMethod(self::SMAREGI_PAYMENT_METHOD);
        $order->setSubtotal($transaction->subtotal ?? '0');
        $order->setTotal($transaction->total ?? '0');
        $order->setPaymentTotal($transaction->total ?? '0');
        // Order.tax は deprecated (Order.php の setTax docblock 参照)。
        // 税額は OrderItem 単位で taxIncludeProportional + taxExcludeProportional から算出する。
        $order->setCouponDiscount($transaction->couponDiscount === null ? null : (int) $transaction->couponDiscount);
        $order->setTaxFree($transaction->taxFreeTotal === null ? null : (int) $transaction->taxFreeTotal);
        $order->setSubtotalDiscountDivision(null);

        return $order;
    }

    /**
     * @return list<OrderItem>
     */
    private function buildOrderItems(TransactionDto $transaction, BaseInfo $baseInfo): array
    {
        $itemType = $this->orderItemTypeRepository->find(OrderItemType::PRODUCT);
        if (!$itemType instanceof OrderItemType) {
            throw new \RuntimeException('OrderItemType PRODUCT is not found.');
        }

        $items = [];
        foreach ($transaction->details as $detail) {
            $items[] = $this->buildOrderItem($detail, $itemType, $baseInfo);
        }

        return $items;
    }

    private function buildOrderItem(TransactionDetailDto $detail, OrderItemType $itemType, BaseInfo $baseInfo): OrderItem
    {
        $item = new OrderItem();
        $item->setBaseInfo($baseInfo);
        $item->setOrderItemType($itemType);
        $item->setProductName($detail->productName ?? '');
        $item->setProductCode($detail->productCode);
        $item->setPrice($detail->salesPrice ?? '0');
        $item->setQuantity((string) ($detail->quantity ?? 0));
        $item->setTax($this->calcDetailTax($detail));

        $productClass = $this->resolveProductClass($detail->productId);
        if ($productClass !== null) {
            $item->setProductClass($productClass);
            $item->setProduct($productClass->getProduct());
        }

        return $item;
    }

    /**
     * 明細の税額を Smaregi の按分済み内税/外税から算出する。
     *
     * Smaregi 用語:
     *  - `taxIncludeProportional` = 明細の内税 (税込価格に含まれる税) 按分額
     *  - `taxExcludeProportional` = 明細の外税 (税抜価格に上乗せされた税) 按分額
     * 両者の和がその明細の税額合計となる。
     *
     * いずれか/両方とも未設定 (Smaregi 仕様変更や旧データ) の場合は欠落側を 0 と扱う。
     */
    private function calcDetailTax(TransactionDetailDto $detail): string
    {
        $taxInclude = $detail->taxIncludeProportional !== null ? (int) $detail->taxIncludeProportional : 0;
        $taxExclude = $detail->taxExcludeProportional !== null ? (int) $detail->taxExcludeProportional : 0;
        $tax = $taxInclude + $taxExclude;
        if ($tax < 0) {
            return '0';
        }

        return (string) $tax;
    }

    private function resolveProductClass(?string $smaregiProductId): ?ProductClass
    {
        if ($smaregiProductId === null || $smaregiProductId === '') {
            return null;
        }

        $productClass = $this->productClassRepository->findOneBy(['smaregiProductId' => $smaregiProductId]);
        if ($productClass instanceof ProductClass) {
            return $productClass;
        }

        $this->logger->warning('Smaregi product not found in ECCUBE ProductClass', [
            'smaregiProductId' => $smaregiProductId,
        ]);

        return null;
    }

    private function resolveBaseInfo(?string $smaregiStoreId): BaseInfo
    {
        if ($smaregiStoreId !== null && $smaregiStoreId !== '' && ctype_digit($smaregiStoreId)) {
            $matched = $this->baseInfoRepository->findOneBy(['smaregi_shop_id' => (int) $smaregiStoreId]);
            if ($matched instanceof BaseInfo) {
                return $matched;
            }
        }

        $fallback = $this->baseInfoRepository->find(self::FALLBACK_BASE_INFO_ID);
        if (!$fallback instanceof BaseInfo) {
            throw new \RuntimeException('BaseInfo for Smaregi order could not be resolved.');
        }

        return $fallback;
    }

    private function parseDateTime(?string $value): ?\DateTime
    {
        if ($value === null || $value === '') {
            return null;
        }

        try {
            return new \DateTime($value);
        } catch (\Throwable) {
            return null;
        }
    }
}

