namespace Eccube\Service\Smaregi\Webhook\Transaction\Processor;

use Doctrine\ORM\EntityManagerInterface;
use Eccube\Dto\Smaregi\Api\Transaction\TransactionDto;
use Eccube\Entity\Master\OrderStatus;
use Eccube\Entity\Order;
use Eccube\Entity\SmaregiWebhookEvent;
use Eccube\Repository\Master\OrderStatusRepository;
use Eccube\Repository\OrderRepository;
use Eccube\Service\PurchaseFlow\Processor\StockReduceProcessor;
use Eccube\Service\PurchaseFlow\PurchaseContext;
use Psr\Log\LoggerInterface;

/**
 * disposed (廃棄返品) スマレジ取引に対する ECCUBE 受注側の取消反映を行う。
 *
 * 廃棄取引の transactionHeadId は廃棄取引自体の ID なので、
 * disposeServerTransactionHeadId を打消元 (元取引) のキーに使って Order を引き当てる。
 *
 * canceled と挙動は同一 (OrderItem 全件 rollback + status CANCEL)。
 * ついで買い分の在庫整合性はスマレジから別途送られる在庫変動 webhook で取られる前提。
 */
final readonly class SmaregiTransactionDisposedProcessor
{
    public function __construct(
        private LoggerInterface $logger,
        private EntityManagerInterface $entityManager,
        private OrderRepository $orderRepository,
        private OrderStatusRepository $orderStatusRepository,
        private StockReduceProcessor $stockReduceProcessor,
    ) {
    }

    public function process(SmaregiWebhookEvent $event, TransactionDto $transaction): void
    {
        $transactionHeadId = $transaction->transactionHeadId ?? '';
        if ($transactionHeadId === '') {
            $this->logger->warning('Smaregi disposed processor received a transaction with no transactionHeadId', [
                'webhookEventId' => $event->getId(),
            ]);

            return;
        }

        if (!$transaction->isDisposed()) {
            $this->logger->info('Smaregi disposed webhook received but disposeDivision is not 2, skipping', [
                'webhookEventId' => $event->getId(),
                'transactionHeadId' => $transactionHeadId,
                'disposeDivision' => $transaction->disposeDivision,
            ]);

            return;
        }

        $originTransactionHeadId = $transaction->disposeServerTransactionHeadId;
        if ($originTransactionHeadId === null || $originTransactionHeadId === '') {
            $this->logger->warning('Smaregi disposed transaction has no disposeServerTransactionHeadId', [
                'webhookEventId' => $event->getId(),
                'transactionHeadId' => $transactionHeadId,
            ]);

            return;
        }

        $Order = $this->orderRepository->findOneBy(['smaregiTransactionId' => $originTransactionHeadId]);
        if (!$Order instanceof Order) {
            // TODO: webhook の到着順序が前後し、created がまだ届いていない場合のリカバリは別 PR (進捗管理 issue 候補参照)
            $this->logger->warning('No matching ECCUBE order for disposed Smaregi transaction', [
                'webhookEventId' => $event->getId(),
                'transactionHeadId' => $transactionHeadId,
                'disposeServerTransactionHeadId' => $originTransactionHeadId,
            ]);

            return;
        }

        if ($Order->getOrderStatus()?->getId() === OrderStatus::CANCEL) {
            $this->logger->info('Order is already canceled, skipping', [
                'webhookEventId' => $event->getId(),
                'transactionHeadId' => $transactionHeadId,
                'disposeServerTransactionHeadId' => $originTransactionHeadId,
                'orderId' => $Order->getId(),
            ]);

            return;
        }

        $CancelStatus = $this->orderStatusRepository->find(OrderStatus::CANCEL);
        if (!$CancelStatus instanceof OrderStatus) {
            throw new \RuntimeException('OrderStatus CANCEL is not found.');
        }

        $this->stockReduceProcessor->rollback($Order, new PurchaseContext());
        $Order->setOrderStatus($CancelStatus);
        $this->entityManager->flush();

        $this->logger->info('Smaregi disposed: order stock restored and status updated to CANCEL', [
            'webhookEventId' => $event->getId(),
            'transactionHeadId' => $transactionHeadId,
            'disposeServerTransactionHeadId' => $originTransactionHeadId,
            'orderId' => $Order->getId(),
        ]);
    }
}

