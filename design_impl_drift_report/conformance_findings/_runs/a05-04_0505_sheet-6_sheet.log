namespace Eccube\MessageHandler;

use Doctrine\ORM\EntityManagerInterface;
use Eccube\Entity\MessengerJob;
use Eccube\Entity\SmaregiWebhookEvent;
use Eccube\Message\SmaregiWebhookEventMessage;
use Eccube\Repository\SmaregiWebhookEventRepository;
use Eccube\Service\Smaregi\Webhook\Stock\StockEventDispatcher;
use Eccube\Service\Smaregi\Webhook\Transaction\TransactionEventDispatcher;
use Psr\Log\LoggerInterface;
use Symfony\Component\Messenger\Attribute\AsMessageHandler;

/**
 * Webhook 全体の親 MessengerJob として動作する Handler。
 *
 * 本ジョブはWebhookイベントを受け取り、そのイベントとアクションに応じた子ジョブをディスパッチする。
 */
#[AsMessageHandler]
final readonly class SmaregiWebhookEventMessageHandler
{
    public function __construct(
        private LoggerInterface $logger,
        private EntityManagerInterface $entityManager,
        private SmaregiWebhookEventRepository $smaregiWebhookEventRepository,
        private TransactionEventDispatcher $transactionEventDispatcher,
        private StockEventDispatcher $stockEventDispatcher,
    ) {
    }

    public function __invoke(SmaregiWebhookEventMessage $message): void
    {
        $Event = $this->smaregiWebhookEventRepository->find($message->getSmaregiWebhookEventId());
        if ($Event === null) {
            $this->logger->error('Smaregi webhook event not found');

            return;
        }

        $Event->setStatus(SmaregiWebhookEvent::STATUS_PROCESSING);
        $Event->setStartedAt(new \DateTime());

        // Webhook イベント全体を可視化する親 MessengerJob を 1 件作成。
        // 配下の transactionHeadId ごとの子ジョブはここで発番した id を parent_job_id に持つ。
        $parentJob = (new MessengerJob())
            ->setMessageClass(SmaregiWebhookEventMessage::class)
            ->setStatus(MessengerJob::STATUS_PROCESSING)
            ->setStartedAt(new \DateTime())
            ->setPayloadSummary(sprintf(
                'webhookEventId=%d event=%s action=%s',
                (int) $Event->getId(),
                (string) $Event->getEvent(),
                (string) $Event->getAction(),
            ));
        // Event の PROCESSING 遷移・親ジョブ INSERT・親ジョブ ID 逆書きを同一トランザクションで確定し、
        // commit 成功後に子ジョブを dispatch する。途中で失敗した場合は rollback して PENDING のまま
        // retry させ、Event が PROCESSING のまま取り残されたり親ジョブが孤児化するのを防ぐ。
        $this->entityManager->beginTransaction();
        try {
            $this->entityManager->persist($parentJob);
            $this->entityManager->flush();

            // 管理画面 (Webhook 詳細 → ジョブ詳細) からの遷移用に Webhook 側へ親ジョブ ID を逆書き
            $Event->setMessengerJobId($parentJob->getId());
            $this->entityManager->flush();

            $this->entityManager->commit();
        } catch (\Throwable $e) {
            if ($this->entityManager->getConnection()->isTransactionActive()) {
                $this->entityManager->rollback();
            }
            $this->logger->error('Failed to begin Smaregi webhook parent job', [
                'eventId' => $Event->getId(),
                'error' => $e->getMessage(),
            ]);

            throw $e;
        }

        try {
            // 各ディスパッチャは自身が扱う event 種別以外を自己フィルタして return するため、
            // event の種別判定はここで分岐させず、関係する全ディスパッチャへ順に渡す。
            $this->transactionEventDispatcher->dispatch($Event, $parentJob->getId());
            $this->stockEventDispatcher->dispatch($Event, $parentJob->getId());

            $this->logger->info('Smaregi webhook event handled', [
                'eventId' => $Event->getId(),
                'parentJobId' => $parentJob->getId(),
            ]);
            $Event->setStatus(SmaregiWebhookEvent::STATUS_COMPLETED);
            $Event->setCompletedAt(new \DateTime());
            $parentJob->setStatus(MessengerJob::STATUS_COMPLETED);
            $parentJob->setCompletedAt(new \DateTime());
            $this->entityManager->flush();
        } catch (\Throwable $e) {
            $this->logger->warning('Smaregi webhook event failed', [
                'eventId' => $Event->getId(),
                'parentJobId' => $parentJob->getId(),
                'error' => $e->getMessage(),
                'trace' => $e->getTraceAsString(),
            ]);
            try {
                $Event->setStatus(SmaregiWebhookEvent::STATUS_FAILED);
                $Event->setCompletedAt(new \DateTime());
                $parentJob->setStatus(MessengerJob::STATUS_FAILED);
                $parentJob->setCompletedAt(new \DateTime());
                $parentJob->setErrorMessage($e->getMessage());
                $this->entityManager->flush();
            } catch (\Throwable $persistError) {
                $this->logger->error('Failed to persist Smaregi webhook event failure state', [
                    'eventId' => $Event->getId(),
                    'parentJobId' => $parentJob->getId(),
                    'error' => $persistError->getMessage(),
                ]);
            }

            throw $e;
        }
    }
}

