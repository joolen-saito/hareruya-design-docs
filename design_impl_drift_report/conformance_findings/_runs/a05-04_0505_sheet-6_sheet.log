namespace Eccube\Service\Smaregi\Webhook\Transaction;

final class PurchasePatternResolver
{
    public function resolve(PurchasePatternContext $context): PurchasePattern
    {
        // 既存受注が突合した場合は、その受注の顧客グループ (OTC / OTC_SHITEN か) で
        // 店頭受取 (Pattern 1-3) と店頭PC購入 (Pattern 4-7) を分岐する。
        // どちらも配送方法は店頭受取で登録されるため、突合できたか否かだけでは区別できない。
        if ($context->hasEccubePurchase) {
            return $context->isOtcPcPurchase
                ? $this->resolveOtcPcPurchase($context)
                : $this->resolveEccubePurchase($context);
        }

        // 既存受注が無いレジ単独購入は会員状態で Pattern 8/9 に分岐する。
        return $context->isMember
            ? PurchasePattern::OTC_MEMBER
            : PurchasePattern::OTC_GUEST;
    }

    private function resolveEccubePurchase(PurchasePatternContext $context): PurchasePattern
    {
        if ($context->pickupMethod === PickupMethod::SMOOTH_OTC) {
            return PurchasePattern::ECCUBE_SMOOTH_OTC;
        }

        return $context->hasAddOnPurchase
            ? PurchasePattern::ECCUBE_OTC_WITH_ADD_ON
            : PurchasePattern::ECCUBE_OTC;
    }

    private function resolveOtcPcPurchase(PurchasePatternContext $context): PurchasePattern
    {
        if ($context->isMember) {
            return $context->hasAddOnPurchase
                ? PurchasePattern::OTC_PC_MEMBER_WITH_ADD_ON
                : PurchasePattern::OTC_PC_MEMBER;
        }

        return $context->hasAddOnPurchase
            ? PurchasePattern::OTC_PC_GUEST_WITH_ADD_ON
            : PurchasePattern::OTC_PC_GUEST;
    }
}

