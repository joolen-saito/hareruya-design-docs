namespace Eccube\Service\Smaregi\Webhook\Transaction;

use Eccube\Entity\SmaregiWebhookEvent;
use Eccube\Service\Smaregi\Webhook\Transaction\Handler\TransactionActionHandlerInterface;
use Psr\Log\LoggerInterface;

final readonly class TransactionEventDispatcher
{
    public const EVENT_NAME = 'pos:transactions';

    /** @var array<string,TransactionActionHandlerInterface> */
    private array $handlerMap;

    /**
     * @param iterable<TransactionActionHandlerInterface> $handlers
     */
    public function __construct(
        iterable $handlers,
        private LoggerInterface $logger,
    ) {
        $map = [];
        foreach ($handlers as $handler) {
            $action = $handler->getAction();
            if (isset($map[$action])) {
                $this->logger->warning('Smaregi transaction action handler is duplicated', [
                    'action' => $action,
                    'duplicate' => $handler::class,
                    'kept' => $map[$action]::class,
                ]);

                continue;
            }
            $map[$action] = $handler;
        }
        $this->handlerMap = $map;
    }

    public function dispatch(SmaregiWebhookEvent $event, ?int $parentJobId = null): void
    {
        $eventName = $event->getEvent();
        if ($eventName !== self::EVENT_NAME) {
            // 当該イベントでなければ無視
            return;
        }

        $action = $event->getAction();
        $handler = $this->handlerMap[$action] ?? null;
        if ($handler === null) {
            // 未知actionは例外にせず後続バッチでの再連携余地を残すためログ警告のみで return する
            $this->logger->warning('Smaregi transaction action has no handler', [
                'webhookEventId' => $event->getId(),
                'action' => $action,
                'knownActions' => array_keys($this->handlerMap),
            ]);

            return;
        }

        $transactionHeadIds = $this->extractTransactionHeadIds($event);

        $this->logger->info('Smaregi transaction action dispatching', [
            'webhookEventId' => $event->getId(),
            'action' => $action,
            'transactionHeadIds' => $transactionHeadIds,
            'parentJobId' => $parentJobId,
        ]);

        $handler->handle($event, $transactionHeadIds, $parentJobId);
    }

    /**
     * @return list<string>
     */
    private function extractTransactionHeadIds(SmaregiWebhookEvent $event): array
    {
        $body = $event->getRequestBody();
        $raw = $body['transactionHeadIds'] ?? null;
        if (!is_array($raw)) {
            return [];
        }

        $result = [];
        foreach ($raw as $id) {
            if (is_string($id) && $id !== '') {
                $result[] = $id;

                continue;
            }
            if (is_int($id)) {
                $result[] = (string) $id;
            }
        }

        return $result;
    }
