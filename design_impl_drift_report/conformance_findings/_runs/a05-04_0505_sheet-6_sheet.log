namespace Eccube\Service\Smaregi\Webhook\Transaction\Handler\Pattern;

use Doctrine\ORM\EntityManagerInterface;
use Eccube\Dto\Smaregi\Api\Transaction\TransactionDetailDto;
use Eccube\Dto\Smaregi\Api\Transaction\TransactionDto;
use Eccube\Entity\DtbPlayer;
use Eccube\Entity\Master\OrderStatus;
use Eccube\Entity\Order;
use Eccube\Repository\Master\OrderStatusRepository;
use Eccube\Service\Smaregi\Webhook\Transaction\SmaregiOrderFactory;
use Psr\Log\LoggerInterface;

/**
 * Pattern 2 (ECCUBE購入・店頭受取・ついで買いなし) / Pattern 3 (同・ついで買いあり) と、
 * Pattern 4-7 (店頭PC購入: 会員/非会員 × ついで買い有無)、および
 * 複数の店頭受取受注を同時にレジへ持ち込む「複数受注購入パターン」のハンドラ。
 *
 * Pattern 2/3 と Pattern 4-7 は連携方法 (既存受注を引き渡し済みにし新規受注を作成) が同一のため共通化している。
 * 店頭PC購入注文も配送方法=店頭受取で登録されるため突合・複製ロジックは変わらず、
 * 会員(4/5)・非会員(6/7)の差は $member 引数 (非会員/未解決時は null → guest として作成) で吸収する。
 *
 * 設計:
 *  - 既存 ECCUBE 受注ステータスを「引き渡し済み」に更新（複数件の場合は全件）
 *  - スマレジ受注を新規 ECCUBE 受注として作成
 *  - 既存受注の `next_order_id` に新規受注の ID を登録（移行先 ID）
 *
 * 突合キー:
 *  - 既存受注の特定は `Order.smaregi_code` (= スマレジ商品コード) と
 *    取引明細の `productCode` を突き合わせて行う ({@see PurchasePatternContextBuilder})。
 *  - スマレジ側 `productId` は EC-CUBE 側で保存していないため使用しない。
 *
 * 新規受注の明細構成:
 *  - 既存受注の OrderItem をすべて複製して新規受注に紐付ける
 *    (スマレジ上は複数カードがまとめ商品 1 件として登録されているため、それを「解いた」状態が
 *     既存受注の OrderItem 群となる)
 *  - 複数受注の場合は全 matched Order の OrderItem を統合
 *  - スマレジ取引明細のうち、matchedSmaregiCodes に一致しないもの (= ついで買い分) を
 *    新規受注の OrderItem として追加
 *
 * 新規受注のメタ情報:
 *  - Customer/Player: 取引の `customerId` から解決した Player を使う (PurchasePatternContext.member)
 *    取引側で未解決の場合は 1 件目の matched Order の Customer に fallback、それも無ければ guest 扱い
 *  - order_date: 設計どおり「最古の店頭受取注文日」(matched Order の order_date の最小値)
 *
 * TODO: スマレジ用アカウントを更新者として設定する
 */
final readonly class EccubeOtcPatternHandler
{
    public function __construct(
        private LoggerInterface $logger,
        private EntityManagerInterface $entityManager,
        private OrderStatusRepository $orderStatusRepository,
        private SmaregiOrderFactory $orderFactory,
    ) {
    }

    /**
     * @param list<Order>  $matchedOrders        productCode で既存 EC-CUBE OTC 受注に突合した受注
     * @param list<string> $matchedSmaregiCodes  matchedOrders から抽出した smaregi_code (ついで買い判定用)
     * @param ?DtbPlayer   $member               取引の customerId から解決した Player (非会員/未解決時は null)
     *
     * @return list<Order> 更新/作成された Order の一覧 (既存受注... + 新規受注 1件)
     */
    public function handle(
        TransactionDto $transaction,
        array $matchedOrders,
        array $matchedSmaregiCodes,
        ?DtbPlayer $member = null,
    ): array {
        $passed = $this->orderStatusRepository->find(OrderStatus::PASSED);
        if (!$passed instanceof OrderStatus) {
            throw new \RuntimeException('OrderStatus PASSED is not found.');
        }

        if ($matchedOrders === []) {
            $this->logger->warning('Smaregi OTC pattern (店頭受取/店頭PC購入) has no matched ECCUBE order, skipping', [
                'transactionHeadId' => $transaction->transactionHeadId,
            ]);

            return [];
        }

        $newOrder = $this->createNewOrder($transaction, $matchedOrders, $matchedSmaregiCodes, $member);

        // 既存受注由来の複製明細数 (ついで買い分との内訳ログ用)。
        // 永続化結果に依存しないためトランザクション外で算出する。
        $clonedItemCount = array_sum(array_map(
            static fn (Order $o): int => $o->getOrderItems()->count(),
            $matchedOrders,
        ));

        $this->entityManager->wrapInTransaction(function () use ($newOrder, $matchedOrders, $passed): void {
            $this->entityManager->persist($newOrder);
            foreach ($newOrder->getOrderItems() as $item) {
                $this->entityManager->persist($item);
            }
            // 既存受注の next_order_id に入れる前に flush して新規受注 ID を確定させる
            $this->entityManager->flush();

            foreach ($matchedOrders as $existingOrder) {
                $existingOrder->setOrderStatus($passed);
                $existingOrder->setNextOrderId($newOrder->getId());
            }
        });

        $this->logger->info('Smaregi OTC pattern (店頭受取/店頭PC購入) processed', [
            'transactionHeadId' => $transaction->transactionHeadId,
            'existingOrderIds' => array_map(static fn (Order $o): ?int => $o->getId(), $matchedOrders),
            'newOrderId' => $newOrder->getId(),
            'clonedItemCount' => $clonedItemCount,
            'addOnItemCount' => $newOrder->getOrderItems()->count() - $clonedItemCount,
        ]);

        return [...$matchedOrders, $newOrder];
    }

    /**
     * @param list<Order>  $matchedOrders
     * @param list<string> $matchedSmaregiCodes
     */
    private function createNewOrder(
        TransactionDto $transaction,
        array $matchedOrders,
        array $matchedSmaregiCodes,
        ?DtbPlayer $member,
    ): Order {
        $newOrder = $this->createShellWithCustomer($transaction, $matchedOrders, $member);
        $baseInfo = $newOrder->getBaseInfo();

        // 注文日: 設計どおり「最古の店頭受取注文日」を適用
        $oldestOrderDate = $this->findOldestOrderDate($matchedOrders);
        if ($oldestOrderDate !== null) {
            $newOrder->setOrderDate($oldestOrderDate);
        }

        // (1) 既存受注の商品明細を複製して新規受注へ (複数受注なら全件統合)。
        // 送料/手数料/値引/税/ポイント等の非商品行は引き継がない (まとめ商品を「解いた」商品明細のみが対象)。
        // 金額は取引から直接設定されるため、ここで複製するのは内訳としての商品行に限定する。
        foreach ($matchedOrders as $existingOrder) {
            foreach ($existingOrder->getOrderItems() as $existingItem) {
                if (!$existingItem->isProduct()) {
                    continue;
                }
                $cloned = $this->orderFactory->cloneOrderItemForNewOrder($existingItem, $baseInfo);
                $cloned->setOrder($newOrder);
                $newOrder->addOrderItem($cloned);
            }
        }

        // (2) ついで買い分 = スマレジ取引明細のうち、matchedSmaregiCodes に一致しないもの
        $matchedCodeLookup = array_flip($matchedSmaregiCodes);
        foreach ($transaction->details as $detail) {
            if ($this->isAlreadyCoveredByExistingOrder($detail, $matchedCodeLookup)) {
                continue;
            }
            $addOnItem = $this->orderFactory->buildOrderItemFromDetail($detail, $baseInfo);
            $addOnItem->setOrder($newOrder);
            $newOrder->addOrderItem($addOnItem);
        }

        return $newOrder;
    }

    /**
     * @param list<Order> $matchedOrders
     */
    private function createShellWithCustomer(TransactionDto $transaction, array $matchedOrders, ?DtbPlayer $member): Order
    {
        // 第一優先: 取引の customerId から解決した Player を使う
        // 第二優先: 1 件目の matched Order の Customer に紐付く Player に fallback
        // どちらも無ければ guest として作成
        $player = $member ?? $matchedOrders[0]->getCustomer()?->getPlayer();
        if ($player !== null) {
            return $this->orderFactory->createShellForMember($transaction, $player);
        }

        $this->logger->warning('Smaregi OTC pattern: no member resolved for transaction, creating new order as guest', [
            'transactionHeadId' => $transaction->transactionHeadId,
            'existingOrderIds' => array_map(static fn (Order $o): ?int => $o->getId(), $matchedOrders),
        ]);

        return $this->orderFactory->createShellForGuest($transaction);
    }

    /**
     * @param list<Order> $matchedOrders
     */
    private function findOldestOrderDate(array $matchedOrders): ?\DateTime
    {
        $oldest = null;
        foreach ($matchedOrders as $order) {
            $orderDate = $order->getOrderDate();
            if ($orderDate === null) {
                continue;
            }
            if ($oldest === null || $orderDate < $oldest) {
                $oldest = $orderDate;
            }
        }

        return $oldest;
    }

    /**
     * @param array<string, int> $matchedCodeLookup
     */
    private function isAlreadyCoveredByExistingOrder(TransactionDetailDto $detail, array $matchedCodeLookup): bool
    {
        $productCode = $detail->productCode;
        if ($productCode === null || $productCode === '') {
            return false;
        }

        return isset($matchedCodeLookup[$productCode]);
    }
}

