    /**
     * Csv拡張から必要な情報をセット(initCsvTypeの代わり).
     *
     * @param DtbCsvExtension $CsvExtension
     */
    public function setCsvsAndCsvType(DtbCsvExtension $CsvExtension): void
    {
        $this->CsvType = $CsvExtension->getCsvType();
        $this->Csvs = $CsvExtension->getCsvs();
    }

    /**
     * @return Csv[]
     */
    public function getCsvs(): array
    {
        return $this->Csvs;
    }

    /**
     * ヘッダ行を出力する.
     * このメソッドを使う場合は, 事前にinitCsvType($CsvType)で初期化しておく必要がある.
     */
    public function exportHeader(): void
    {
        if (is_null($this->CsvType) || empty($this->Csvs)) {
            throw new \LogicException('init csv type incomplete.');
        }

        $row = [];
        foreach ($this->Csvs as $Csv) {
            $row[] = $Csv->getDispName();
        }

        $this->fopen();
        $this->fputcsv($row);
        $this->fclose();
    }

    /**
     * クエリビルダにもとづいてデータ行を出力する.
     * このメソッドを使う場合は, 事前にsetExportQueryBuilder($qb)で出力対象のクエリビルダをわたしておく必要がある.
     * 受注カスタムCSV用
     *
     * @param Order $Order
     * @param CsvExportService $csvExportService
     * @param Request $request
     */
    public function exportOrder(Order $Order, CsvExportService $csvExportService, Request $request): void
    {
        $OrderDetails = $Order->getOrderItems();
        $Shipping = $Order->getShippings()[0];

        foreach ($OrderDetails as $OrderDetail) {
            $ExportCsvRow = new \Eccube\Entity\ExportCsvRow();
            // CSV出力項目と合致するデータを取得.
            foreach ($csvExportService->getCsvs() as $Csv) {
                if (str_replace('\\\\', '\\', $Csv->getEntityName()) === 'Eccube\Entity\Shipping') {
                    $ExportCsvRow->setData($csvExportService->getData($Csv, $Shipping));
                } else {
                    $ExportCsvRow->setData($csvExportService->getData($Csv, $Order));
                    if ($ExportCsvRow->isDataNull()) {
                        $ExportCsvRow->setData($csvExportService->getData($Csv, $OrderDetail));
                    }
                }
                $ExportCsvRow->pushData();
            }
            $csvExportService->fputcsv($ExportCsvRow->getRow());
        }
    }

    /**
     * 在庫一覧カスタムCSV用のクエリビルダを返す.
     */
    public function getStockQueryBuilder(Request $request): QueryBuilder
    {
        if ($this->productStockRepository === null) {
            throw new \RuntimeException('productStockRepository is not set; cannot build stock query.');
        }
        $session = $request->getSession();
        $searchForm = $this->formFactory->createBuilder(SearchStockListType::class)->getForm();
        $viewData = $session->get('admin.stock.list.search', []);
        $input = StockListSearchInput::fromFormData(FormUtil::submitAndGetData($searchForm, $viewData));

        return $this->productStockRepository->getQueryBuilderForAdminStockList($input);
    }

    /**
     * 在庫一覧カスタムCSV用
     */
    public function exportStock(ProductStock $ProductStock, CsvExportService $csvExportService, Request $request): void
    {
        $ProductClass = $ProductStock->getProductClass();
        $Product = $ProductClass->getProduct();
        $cardDetail = $Product->getCardDetail();
        $card = $cardDetail?->getCard();

        $ExportCsvRow = new \Eccube\Entity\ExportCsvRow();
        foreach ($csvExportService->getCsvs() as $Csv) {
            $entityName = str_replace('\\\\', '\\', $Csv->getEntityName());
            switch ($entityName) {
                case 'Eccube\Entity\ProductStock':
                    $ExportCsvRow->setData($csvExportService->getData($Csv, $ProductStock));
                    break;
                case 'Eccube\Entity\ProductClass':
                    $ExportCsvRow->setData($csvExportService->getData($Csv, $ProductClass));
                    break;
                case 'Eccube\Entity\Product':
                    $ExportCsvRow->setData($csvExportService->getData($Csv, $Product));
                    break;
                case 'Eccube\Entity\Master\MtbCardDetail':
                    $ExportCsvRow->setData($cardDetail !== null ? $csvExportService->getData($Csv, $cardDetail) : null);
                    break;
                case 'Eccube\Entity\Master\MtbCard':
                    $ExportCsvRow->setData($card !== null ? $csvExportService->getData($Csv, $card) : null);
                    break;
                default:
                    $ExportCsvRow->setData(null);
                    break;
            }
            $ExportCsvRow->pushData();
        }
        $csvExportService->fputcsv($ExportCsvRow->getRow());
    }

    /**
     * 配送カスタムCSV用
     *
     * @param Order $Order
     * @param CsvExportService $csvExportService
     * @param Request $request
     */
    public function exportShipping(Order $Order, CsvExportService $csvExportService, Request $request): void
    {
        $Shippings = $Order->getShippings();

        foreach ($Shippings as $Shipping) {
            $ExportCsvRow = new \Eccube\Entity\ExportCsvRow();
            // CSV出力項目と合致するデータを取得.
            foreach ($csvExportService->getCsvs() as $Csv) {
                $ExportCsvRow->setData($csvExportService->getData($Csv, $Order));
                if ($ExportCsvRow->isDataNull()) {
                    $ExportCsvRow->setData($csvExportService->getData($Csv, $Shipping));
                }
                $ExportCsvRow->pushData();
            }
            $csvExportService->fputcsv($ExportCsvRow->getRow());
        }
    }
}

