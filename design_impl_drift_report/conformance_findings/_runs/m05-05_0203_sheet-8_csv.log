namespace Eccube\Entity;

use Doctrine\Common\Collections\ArrayCollection;
use Doctrine\Common\Collections\Collection;
use Doctrine\DBAL\Types\Types;
use Doctrine\ORM\Mapping as ORM;
use Eccube\Entity\Master\CsvType;
use Eccube\Repository\DtbCsvExtensionRepository;

/**
 * DtbCsvExtension
 */
#[ORM\Table(name: 'dtb_csv_extension')]
#[ORM\Entity(repositoryClass: DtbCsvExtensionRepository::class)]
class DtbCsvExtension extends AbstractEntity implements \Stringable
{
    #[ORM\Column(name: 'id', type: Types::INTEGER, options: ['unsigned' => true, 'comment' => 'CSV拡張ID'])]
    #[ORM\Id]
    #[ORM\GeneratedValue(strategy: 'IDENTITY')]
    private ?int $id = null;

    public function getId(): ?int
    {
        return $this->id ?? null;
    }

    #[ORM\Column(name: 'name', type: Types::STRING, length: 255, nullable: true, options: ['comment' => '名称'])]
    private ?string $name = null;

    public function getName(): ?string
    {
        return $this->name ?? null;
    }

    public function setName(?string $name): DtbCsvExtension
    {
        $this->name = $name;

