    /**
     * Csv種別からServiceの初期化を行う.
     */
    public function initCsvType(CsvType|int $CsvType): void
    {
        if ($CsvType instanceof CsvType) {
            $this->CsvType = $CsvType;
        } else {
            $this->CsvType = $this->csvTypeRepository->find($CsvType);
        }

        $criteria = [
            'CsvType' => $CsvType,
            'enabled' => true,
        ];
        $orderBy = [
            'sort_no' => 'ASC',
        ];
        $this->Csvs = $this->csvRepository->findBy($criteria, $orderBy);
    }

    /**
     * Csv拡張から必要な情報をセット(initCsvTypeの代わり).
     *
     * @param DtbCsvExtension $CsvExtension
     */
    public function setCsvsAndCsvType(DtbCsvExtension $CsvExtension): void
    {
        $this->CsvType = $CsvExtension->getCsvType();
        $this->Csvs = $CsvExtension->getCsvs();
    }

