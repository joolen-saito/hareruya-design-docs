   489	    /**
   490	     * @param int|string|null $id
   491	     *
   492	     * @return RedirectResponse|array<string, mixed>
   493	     *
   494	     * @throws NotFoundHttpException|\Exception
   495	     */
   496	    #[Route(path: '/%eccube_admin_route%/product/product/new', name: 'admin_product_product_new', methods: ['GET', 'POST'])]
   497	    #[Route(path: '/%eccube_admin_route%/product/product/{id}/edit', name: 'admin_product_product_edit', requirements: ['id' => '\d+'], methods: ['GET', 'POST'])]
   498	    #[Template(template: '@admin/Product/product.twig')]
   499	    public function edit(
   500	        Request $request,
   501	        RouterInterface $router,
   502	        CacheUtil $cacheUtil,
   503	        SmaregiProductClassEventService $smaregiProductClassEventService,
   504	        $id = null,
   505	    ): RedirectResponse|array {
   506	        $has_class = false;
   507	        $tmpDir = $this->eccubeConfig->get('preferred_temp_product_image_path');
   508	        $imgDir = $this->eccubeConfig->get('preferred_product_image_path');
   509	        if (is_null($id)) {
   510	            $Product = new Product();
   511	            $ProductClass = new ProductClass();
   512	            $ProductStatus = $this->productStatusRepository->find(ProductStatus::DISPLAY_HIDE);
   513	            $Product
   514	                ->addProductClass($ProductClass)
   515	                ->setBaseInfo($this->getMember()->getBaseInfo())
   516	                ->setStatus($ProductStatus);
   517	            $ProductClass
   518	                ->setVisible(true)
   519	                ->setStockUnlimited(true)
   520	                ->setBaseInfo($this->getMember()->getBaseInfo())
   521	                ->setProduct($Product);
   522	            $ProductStock = new ProductStock();
   523	            $ProductStock->setBaseInfo($this->getMember()->getBaseInfo());
   524	            $ProductClass->setProductStock($ProductStock);
   525	            $ProductStock->setProductClass($ProductClass);
   526	        } else {
   527	            $Product = $this->productRepository->findWithSortedClassCategories($id);
   528	            $ProductClass = null;
   529	            $ProductStock = null;
   530	            if (!$Product) {
   531	                throw new NotFoundHttpException();
   532	            }
   533	            // 規格無しの商品の場合は、デフォルト規格を表示用に取得する
   534	            $has_class = $Product->hasProductClass();
   535	            if (!$has_class) {
   536	                $ProductClasses = $Product->getProductClasses();
   537	                foreach ($ProductClasses as $pc) {
   538	                    if (!is_null($pc->getClassCategory1())) {
   539	                        continue;
   540	                    }
   541	                    if ($pc->isVisible()) {
   542	                        $ProductClass = $pc;
   543	                        break;
   544	                    }
   545	                }
   546	                if ($this->MallBaseInfo->isOptionProductTaxRule() && $ProductClass->getTaxRule()) {
   547	                    $ProductClass->setTaxRate($ProductClass->getTaxRule()->getTaxRate());
   548	                }
   549	                $ProductStock = $ProductClass->getProductStock();
   550	            }
   551	        }
   552	
   553	        $builder = $this->formFactory
   554	            ->createBuilder(ProductType::class, $Product);
   555	
   556	        $event = new EventArgs(
   557	            [
   558	                'builder' => $builder,
   559	                'Product' => $Product,
   560	            ],
   560	            ],
   561	            $request
   562	        );
   563	        $this->eventDispatcher->dispatch($event, EccubeEvents::ADMIN_PRODUCT_EDIT_INITIALIZE);
   564	
   565	        $form = $builder->getForm();
   566	
   567	        // ファイルの登録
   568	        $images = [];
   569	        $ProductImages = $Product->getProductImage();
   570	        foreach ($ProductImages as $ProductImage) {
   571	            $images[] = $ProductImage->getObjectKey();
   572	        }
   573	        $form['images']->setData($images);
   574	
   575	        $categories = [];
   576	        $ProductCategories = $Product->getProductCategories();
   577	        foreach ($ProductCategories as $ProductCategory) {
   578	            /** @var ProductCategory $ProductCategory */
   579	            $categories[] = $ProductCategory->getCategory();
   580	        }
   581	        $form['Category']->setData($categories);
   582	
   583	        $Tags = $Product->getTags();
   584	        $form['Tag']->setData($Tags);
   585	
   586	        $Cardset = $this->cardsetRepository->find($Product->getCardsetId());
   587	        $form['Cardset']->setData($Cardset);
   588	
   589	        $form['isBranchPublished']->setData((int) $Product->isBranchPublished());
   590	
   591	        if ('POST' === $request->getMethod()) {
   592	            // 画面からの商品新規登録は不可
   593	            if (!$Product->getId()) {
   594	                $this->addError('admin.common.save_error', 'admin');
   595	
   596	                return $this->redirectToRoute('admin_product_product_new');
   597	            }
   598	
   599	            $previousProductName = $Product->getName();
   600	            $form->handleRequest($request);
   601	            if ($form->isValid()) {
   602	                $fileAdapter = $this->fileManager->getAdapter();
   603	                log_info('商品登録開始', [$id]);
   604	                /** @var Product $Product */
   605	                $Product = $form->getData();
   606	
   607	                // カード詳細情報の登録
   608	                $cardDetailId = $form->get('CardDetail')->getData();
   609	                if (isset($cardDetailId)) {
   610	                    $CardDetail = $this->cardDetailRepository->find($cardDetailId);
   611	                    $Product->setCardDetail($CardDetail);
   612	                }
   613	
   614	                // カテゴリの登録
   615	                // 一度クリア
   616	                foreach ($Product->getProductCategories() as $ProductCategory) {
   617	                    $Product->removeProductCategory($ProductCategory);
   618	                    $this->entityManager->remove($ProductCategory);
   619	                }
   620	                $this->entityManager->persist($Product);
   621	                $this->entityManager->flush();
   622	
   623	                $count = 1;
   624	                $Categories = $form->get('Category')->getData();
   625	                $categoriesIdList = [];
   626	                foreach ($Categories as $Category) {
   627	                    foreach ($Category->getPath() as $ParentCategory) {
   628	                        if (!isset($categoriesIdList[$ParentCategory->getId()])) {
   629	                            $ProductCategory = $this->createProductCategory($Product, $ParentCategory);
   630	                            $this->entityManager->persist($ProductCategory);
   631	                            $count++;
   632	                            /** @var Product $Product */
   633	                            $Product->addProductCategory($ProductCategory);
   634	                            $categoriesIdList[$ParentCategory->getId()] = true;
   635	                        }
   636	                    }
   637	                    if (!isset($categoriesIdList[$Category->getId()])) {
   638	                        $ProductCategory = $this->createProductCategory($Product, $Category);
   639	                        $this->entityManager->persist($ProductCategory);
   640	                        $count++;
   641	                        /** @var Product $Product */
   642	                        $Product->addProductCategory($ProductCategory);
   643	                        $categoriesIdList[$Category->getId()] = true;
   644	                    }
   645	                }
   646	
   647	                // 画像の登録
   648	                $add_images = $form->get('add_images')->getData();
   649	                foreach ($add_images as $add_image) {
   650	                    // 移動
   651	                    $fileAdapter->move(
   652	                        $tmpDir.$add_image,
   653	                        FilesystemUtil::convertRawPathToDynamicPath(['id', 'name'], $Product, $imgDir),
   654	                        $add_image,
   655	                        []
   656	                    );
   657	                    $ProductImage = new ProductImage();
   658	                    $ProductImage
   659	                        ->saveFile($fileAdapter->toEntitySaveData())
   660	                        ->setProduct($Product)
   661	                        ->setSortNo(1);
   662	                    $Product->addProductImage($ProductImage);
   663	                    $this->entityManager->persist($ProductImage);
   664	                }
   665	
   666	                // カード詳細画像を商品画像としてコピー登録
   667	                // 旧システム参照: pf-eccube3/app/Plugin/HareruyaEc/Controller/Admin/Product/ProductController.php::copyProductImage()
   668	                $copy_images = $form->get('copy_images')->getData();
   669	                $existingFileNames = $Product->getProductImage()->map(
