   677	                        continue;
   678	                    }
   679	                    $filename = basename($copy_image);
   680	                    if (in_array($filename, $existingFileNames, true)) {
   681	                        continue;
   682	                    }
   683	                    $destPath = FilesystemUtil::convertRawPathToDynamicPath(['id', 'name'], $Product, $imgDir);
   684	                    try {
