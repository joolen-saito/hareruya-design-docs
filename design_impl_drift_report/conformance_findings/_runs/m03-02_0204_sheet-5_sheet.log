   857	                        $pattern = '/^'.preg_quote($request->getBasePath(), '/').'/';
   858	                        $returnLink = preg_replace($pattern, '', (string) $returnLink);
   859	                        $result = $router->match($returnLink);
   860	                        // パラメータのみ抽出
