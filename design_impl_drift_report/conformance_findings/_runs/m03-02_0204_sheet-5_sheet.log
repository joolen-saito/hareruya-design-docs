   930	    #[Route(path: '/%eccube_admin_route%/product/searchCardDetail', name: 'admin_product_card_detail_html', methods: ['GET', 'POST'])]
   931	    #[Template(template: '@admin/Product/search_carddetail.twig')]
   932	    public function searchCardDetailHtml(Request $request, PaginatorInterface $paginator): RedirectResponse|JsonResponse|array
   933	    {
   934	        $session = $request->getSession();
   935	
   936	        if (!$request->isXmlHttpRequest()) {
   937	            return [
   938	                'cardDetails' => [],
   939	                'pagination' => [],
   940	                'modal' => ($request->get('modal') === 'true'),
   941	            ];
   942	        }
   943	
   944	        $pageCount = $this->eccubeConfig->get('eccube_default_page_count');
   945	
   946	        if ($request->getMethod() === 'POST') {
   947	            $pageNo = 1;
   948	            $searchData = [
   949	                'card_name' => $request->get('search_card_name'),
   950	                'cardset' => $request->get('search_cardset'),
   951	                'product' => $request->get('product_flg'),
   952	                'sort' => 'cardIdAndCardDetailId',
   953	                'order' => 'DESC',
   954	            ];
   955	            $session->set('admin.card.carddetail.search', $searchData);
   956	        } else {
   957	            // ページ番号からの遷移
   958	            $pageNo = $request->get('page_no');
   959	            $searchData = (array) $session->get('admin.card.carddetail.search');
   960	        }
   961	
   962	        // カード詳細情報検索
   963	        $qb = $this->cardDetailRepository->getQueryBuilderBySearchDataForAdmin($searchData);
   964	
   965	        $pagination = $paginator->paginate(
   966	            $qb,
   967	            (int) $pageNo,
   968	            (int) $pageCount,
   969	            ['wrap-queries' => true]
   970	        );
   971	
   972	        return [
   973	            'cardDetails' => $pagination->getItems(),
   974	            'pagination' => $pagination,
   975	            'modal' => ($request->get('modal') === 'true'),
   976	        ];
   977	    }
