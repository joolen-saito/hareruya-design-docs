   979	    /**
   980	     * カード詳細IDをもとに結果表示に必要な情報を得る
   980	     * カード詳細IDをもとに結果表示に必要な情報を得る
   981	     *
   982	     * @return RedirectResponse|JsonResponse
   983	     *
   984	     * @throws \Exception
   985	     */
   986	    #[Route(path: '/%eccube_admin_route%/product/detail/search/id', name: 'admin_product_search_card_detail_by_id', methods: ['GET', 'POST'])]
   987	    public function searchCardDetailById(Request $request)
   988	    {
   989	        $data = [];
   990	        $cardDetailId = $request->get('id');
   991	
   992	        if (!$request->isXmlHttpRequest() || !isset($cardDetailId)) {
   993	            return $this->json($data);
   994	        }
   995	
   996	        $CardDetail = $this->cardDetailRepository->find($cardDetailId);
   997	        if ($CardDetail === null) {
   998	            return $this->json([], 404);
   999	        }
  1000	
  1001	        $Card = $CardDetail->getCard();
  1002	        if ($Card === null) {
  1003	            return $this->json([], 404);
  1004	        }
  1005	
  1006	        $CardColors = $Card->getColors();
  1007	        if ($CardColors->isEmpty()) {
  1008	            return $this->json([], 404);
  1009	        }
  1010	
  1011	        if ($CardDetail->getRarity() === null) {
  1012	            return $this->json([], 404);
  1013	        }
  1014	
  1015	        $CardImages = $CardDetail->getCardImages();
  1016	        if ($CardImages->isEmpty()) {
  1017	            return $this->json([], 404);
  1018	        }
  1019	
  1020	        $cardDetail = [
  1021	            'name' => $Card->getNameJp(),
  1022	            'nameEn' => $Card->getNameEn(),
  1023	            'productNameJp' => $CardDetail->buildProductNameJp(),
  1024	            'productNameEn' => $CardDetail->buildProductNameEn(),
  1025	            'cardLabelJp' => $CardDetail->buildCardLabelJp(),
  1026	            'detailId' => $cardDetailId,
  1027	            'images' => [],
  1028	        ];
  1029	
  1030	        foreach ($CardImages as $CardImage) {
  1031	            $cardDetail['images'][] = $CardImage->getUrl();
  1032	        }
  1033	
  1034	        return $this->json($cardDetail);
  1035	    }
