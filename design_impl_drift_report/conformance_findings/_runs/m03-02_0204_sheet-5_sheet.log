   359	                    && $this->fileAdapter->exists($Image->getFileKey(), $Image->getAdapterInformation()) === false
   360	                )
   361	                || $this->fileAdapter->exists($this->eccubeConfig->get('preferred_temp_product_image_path').$fileName, []) === false
   362	            ) {
   363	                $form->getRoot()['product_image']->addError(new FormError(trans('admin.product.image__invalid_path')));
