  1132	    /**
  1133	     * @param int|string|null $id
  1134	     *
  1135	     * @return RedirectResponse
  1136	     *
  1137	     * @throws \Exception
  1138	     */
  1139	    #[Route(path: '/%eccube_admin_route%/product/product/{id}/copy', name: 'admin_product_product_copy', requirements: ['id' => '\d+'], methods: ['POST'])]
  1140	    public function copy(Request $request, $id = null): RedirectResponse
  1141	    {
  1142	        // NOTE:
  1143	        // 商品複製機能は不要となったため、何も処理を行わず商品一覧へリダイレクトします。
  1144	        // ルーティング定義との互換性のために削除せずに維持しています。
  1145	        $this->isTokenValid();
  1146	
  1147	        if (!is_null($id)) {
  1148	            $Product = $this->productRepository->find($id);
  1149	            if ($Product instanceof Product) {
  1150	                $CopyProduct = new Product();
  1151	                $CopyProduct->copyProperties($Product, ['id']);
  1152	                $ProductStatus = $this->productStatusRepository->find(ProductStatus::DISPLAY_HIDE);
  1153	                $CopyProduct->setStatus($ProductStatus);
  1154	
  1155	                // 商品IDの確定
  1156	                $this->entityManager->persist($CopyProduct);
  1157	                $this->entityManager->flush();
  1158	
  1159	                // 商品関連のコピー
  1160	                $CopyProduct->copy($Product);
  1161	
  1162	                // 商品カテゴリの登録
  1163	                $CopyProductCategories = $CopyProduct->getProductCategories();
  1164	                foreach ($CopyProductCategories as $Category) {
  1165	                    $this->entityManager->persist($Category);
  1166	                }
  1167	
  1168	                // 規格あり商品の場合は, デフォルトの商品規格を取得し登録する.
  1169	                if ($CopyProduct->hasProductClass()) {
  1170	                    $dummyClass = $this->productClassRepository->findOneBy([
  1171	                        'visible' => false,
  1172	                        'ClassCategory1' => null,
  1173	                        'ClassCategory2' => null,
  1174	                        'Product' => $Product,
  1175	                    ]);
  1176	                    $dummyClass = clone $dummyClass;
  1177	                    $dummyClass->setProduct($CopyProduct);
  1178	                    $CopyProduct->addProductClass($dummyClass);
  1179	                }
  1180	
  1181	                $CopyProductClasses = $CopyProduct->getProductClasses();
  1182	                foreach ($CopyProductClasses as $Class) {
  1183	                    $Stock = $Class->getProductStock();
  1184	                    $CopyStock = clone $Stock;
  1185	                    $CopyStock->setProductClass($Class);
  1186	                    $this->entityManager->persist($CopyStock);
  1187	
  1188	                    $TaxRule = $Class->getTaxRule();
  1189	                    if ($TaxRule) {
  1190	                        $CopyTaxRule = clone $TaxRule;
  1191	                        $CopyTaxRule->setProductClass($Class);
  1192	                        $CopyTaxRule->setProduct($CopyProduct);
  1193	                        $this->entityManager->persist($CopyTaxRule);
  1194	                    }
