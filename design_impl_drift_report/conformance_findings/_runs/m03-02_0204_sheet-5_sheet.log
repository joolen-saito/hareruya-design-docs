   143	         * - セッション
   144	         * - デフォルト値
   145	         * また, セッションに保存する際は mtb_page_maxと照合し, 一致した場合のみ保存する.
   146	         **/
   147	        $page_count = $this->session->get(
   148	            'eccube.admin.product.search.page_count',
   149	            $this->eccubeConfig->get('eccube_default_page_count')
   150	        );
   151	
   152	        $page_count_param = (int) $request->get('page_count');
   153	        $pageMaxis = $this->pageMaxRepository->findAll();
   154	
   155	        if ($page_count_param) {
   156	            foreach ($pageMaxis as $pageMax) {
   157	                if ($page_count_param == $pageMax->getName()) {
   158	                    $page_count = $pageMax->getName();
   159	                    $this->session->set('eccube.admin.product.search.page_count', $page_count);
   160	                    break;
   161	                }
   162	            }
   163	        }
   164	
   165	        /**
   166	         * 表示データ切り替えは, 以下の順に優先される.
   167	         * - リクエストパラメータ
   168	         * - セッション
   169	         **/
   170	        $displayMode = $this->session->get('eccube.admin.product.search.display_mode', ProductListDisplayMode::SALES_MAIN->value);
   171	        $displayModeParam = (int) $request->get('mode');
   172	        if ($displayModeParam) {
   173	            $displayMode = $displayModeParam;
   174	            $this->session->set('eccube.admin.product.search.display_mode', $displayMode);
   175	        }
   176	
   177	        if ('POST' === $request->getMethod()) {
   178	            $searchForm->handleRequest($request);
   179	
   180	            if ($searchForm->isValid()) {
   181	                /**
   182	                 * 検索が実行された場合は, セッションに検索条件を保存する.
   183	                 * ページ番号は最初のページ番号に初期化する.
   184	                 */
   185	                $page_no = 1;
   186	                $searchData = $searchForm->getData();
   187	
   188	                // 検索条件, ページ番号をセッションに保持.
   189	                $this->session->set('eccube.admin.product.search', FormUtil::getViewData($searchForm));
   190	                $this->session->set('eccube.admin.product.search.page_no', $page_no);
   191	            } else {
   192	                // 検索エラーの際は, 詳細検索枠を開いてエラー表示する.
   193	                return [
   194	                    'searchForm' => $searchForm->createView(),
   195	                    'pagination' => [],
   196	                    'pageMaxis' => $pageMaxis,
   197	                    'page_no' => $page_no,
   198	                    'page_count' => $page_count,
   199	                    'has_errors' => true,
   200	                    'display_mode' => $displayMode,
   201	                    'stockSummaries' => [],
   202	                    'mainSalesQuantities' => [],
   203	                    'branchSalesQuantities' => [],
   204	                    'stockUpQuantities' => [],
   205	                    'ProductCsvExtensions' => $this->dtbCsvExtensionRepository->findActiveByCsvTypeId(CsvType::CSV_TYPE_PRODUCT),
   206	                ];
   207	            }
   208	        } else {
   209	            if (null !== $page_no || $request->get('resume')) {
   210	                /*
   211	                 * ページ送りの場合または、他画面から戻ってきた場合は, セッションから検索条件を復旧する.
   212	                 */
   213	                if ($page_no) {
   214	                    // ページ送りで遷移した場合.
   215	                    $this->session->set('eccube.admin.product.search.page_no', (int) $page_no);
   216	                } else {
   217	                    // 他画面から遷移した場合.
   218	                    $page_no = $this->session->get('eccube.admin.product.search.page_no', 1);
   219	                }
   220	                $viewData = $this->session->get('eccube.admin.product.search', []);
   221	                $searchData = FormUtil::submitAndGetData($searchForm, $viewData);
   222	            } else {
   223	                // 初期表示の場合は検索前のため商品一覧を表示しない.
   224	                $page_no = 1;
   225	                $viewData = FormUtil::getViewData($searchForm);
   226	                $this->session->set('eccube.admin.product.search', $viewData);
   227	                $this->session->set('eccube.admin.product.search.page_no', $page_no);
   228	
   229	                return [
   230	                    'searchForm' => $searchForm->createView(),
   231	                    'pagination' => null,
   232	                    'pageMaxis' => $pageMaxis,
   233	                    'page_no' => $page_no,
   234	                    'page_count' => $page_count,
   235	                    'has_errors' => false,
   236	                    'display_mode' => $displayMode,
   237	                    'stockSummaries' => [],
   238	                    'mainSalesQuantities' => [],
   239	                    'branchSalesQuantities' => [],
   240	                    'stockUpQuantities' => [],
   241	                    'ProductCsvExtensions' => $this->dtbCsvExtensionRepository->findActiveByCsvTypeId(CsvType::CSV_TYPE_PRODUCT),
   242	                ];
   243	            }
   244	        }
   245	
   246	        $qb = $this->productRepository->getQueryBuilderBySearchDataForAdmin($searchData);
   247	
   248	        $event = new EventArgs(
   249	            [
   250	                'qb' => $qb,
   251	                'searchData' => $searchData,
   252	            ],
   253	            $request
   254	        );
   255	
   256	        $this->eventDispatcher->dispatch($event, EccubeEvents::ADMIN_PRODUCT_INDEX_SEARCH);
   257	
   258	        // ProductClasses を fetch join し規格単位で ORDER BY するため output walker が必要
   259	        // @see https://github.com/EC-CUBE/ec-cube/issues/1618
   260	        $pagination = $paginator->paginate(
   260	        $pagination = $paginator->paginate(
   261	            $qb,
   262	            (int) $page_no,
   263	            (int) $page_count,
   264	            ['wrap-queries' => true]
   265	        );
   266	
   267	        // 各種集計
   268	        $productClassIds = $this->collectVisibleProductClassIds($pagination->getItems());
   269	        $stockSummaries = $this->productStockRepository->getStockSummaryByProductClassIds($productClassIds);
   270	
   271	        $mainSalesQuantities = [];
   272	        $branchSalesQuantities = [];
   273	        $stockUpQuantities = [];
   274	        switch (ProductListDisplayMode::tryFrom((int) $displayMode)) {
   275	            case ProductListDisplayMode::SALES_MAIN:
   276	                $mainSalesQuantities = $this->dtbSalesQuantityRepository->getMainSalesQuantitiesByProductClassIds($productClassIds);
   277	                break;
   278	            case ProductListDisplayMode::SALES_BRANCH:
   279	                $branchSalesQuantities = $this->dtbSalesQuantityRepository->getBranchSalesQuantitiesByProductClassIds($productClassIds);
   280	                break;
   281	            case ProductListDisplayMode::STOCK:
   282	                $stockUpQuantities = $this->dtbStockUpQuantityRepository->getStockUpQuantitiesByProductClassIds($productClassIds);
   283	                break;
   284	        }
   285	
   286	        return [
   287	            'searchForm' => $searchForm->createView(),
   288	            'pagination' => $pagination,
   289	            'pageMaxis' => $pageMaxis,
   290	            'page_no' => $page_no,
   291	            'page_count' => $page_count,
   292	            'has_errors' => false,
   293	            'display_mode' => $displayMode,
   294	            'stockSummaries' => $stockSummaries,
   295	            'mainSalesQuantities' => $mainSalesQuantities,
   296	            'branchSalesQuantities' => $branchSalesQuantities,
   297	            'stockUpQuantities' => $stockUpQuantities,
   298	            'ProductCsvExtensions' => $this->dtbCsvExtensionRepository->findActiveByCsvTypeId(CsvType::CSV_TYPE_PRODUCT),
   299	        ];
   300	    }
