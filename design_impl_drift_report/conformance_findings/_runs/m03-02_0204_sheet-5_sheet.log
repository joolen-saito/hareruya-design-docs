  1215	                }
  1216	
  1217	                $this->entityManager->persist($CopyProduct);
  1218	
  1219	                $this->entityManager->flush();
  1220	
  1221	                $event = new EventArgs(
  1222	                    [
  1223	                        'Product' => $Product,
  1224	                        'CopyProduct' => $CopyProduct,
  1225	                        'CopyProductCategories' => $CopyProductCategories,
  1226	                        'CopyProductClasses' => $CopyProductClasses,
  1227	                        'images' => $Images,
  1228	                        'Tags' => $Tags,
