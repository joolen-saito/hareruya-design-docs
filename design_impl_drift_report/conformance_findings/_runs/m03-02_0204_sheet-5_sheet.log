  1037	    /**
  1038	     * @param int|string|null $id
  1039	     *
  1040	     * @throws \Exception
  1041	     */
  1042	    #[Route(path: '/%eccube_admin_route%/product/product/{id}/delete', name: 'admin_product_product_delete', requirements: ['id' => '\d+'], methods: ['DELETE'])]
  1043	    public function delete(Request $request, CacheUtil $cacheUtil, $id = null): RedirectResponse|JsonResponse
  1044	    {
  1045	        $this->isTokenValid();
  1046	        $session = $request->getSession();
  1047	
  1048	        $page_no = intval($session->get('eccube.admin.product.search.page_no'));
  1049	        $page_no = $page_no ?: Constant::ENABLED;
  1050	        $success = false;
  1051	        $fileAdapter = $this->fileManager->getAdapter();
  1052	
  1053	        if (!is_null($id)) {
  1054	            /** @var Product|null $Product */
  1055	            $Product = $this->productRepository->find($id);
  1056	            if (!$Product) {
  1057	                if ($request->isXmlHttpRequest()) {
  1058	                    $message = trans('admin.common.delete_error_already_deleted');
  1059	
  1060	                    return $this->json(['success' => $success, 'message' => $message]);
  1061	                } else {
  1062	                    $this->deleteMessage();
  1063	                    $rUrl = $this->generateUrl('admin_product_page', ['page_no' => $page_no]).'?resume='.Constant::ENABLED;
  1064	
  1065	                    return $this->redirect($rUrl);
  1066	                }
  1067	            }
  1068	
  1069	            log_info('商品削除開始', [$id]);
  1070	
  1071	            $deleteImages = $Product->getProductImage();
  1072	            $ProductClasses = $Product->getProductClasses();
  1073	
  1074	            try {
  1075	                $this->productRepository->delete($Product);
  1076	                $this->entityManager->flush();
  1077	
  1078	                $event = new EventArgs(
  1079	                    [
  1080	                        'Product' => $Product,
  1081	                        'ProductClass' => $ProductClasses,
  1082	                        'deleteImages' => $deleteImages,
  1083	                    ],
  1084	                    $request
  1085	                );
  1086	                $this->eventDispatcher->dispatch($event, EccubeEvents::ADMIN_PRODUCT_DELETE_COMPLETE);
  1087	                $deleteImages = $event->getArgument('deleteImages');
  1088	
  1089	                // 画像ファイルの削除(commit後に削除させる)
  1090	                /** @var ProductImage $deleteImage */
  1091	                foreach ($deleteImages as $deleteImage) {
  1092	                    if ($this->productImageRepository->findOneBy(['file_name' => $deleteImage->getFileName()])) {
  1093	                        continue;
  1094	                    }
  1095	                    try {
  1096	                        $fileAdapter->delete($deleteImage->getFileKey(), $deleteImage->getAdapterInformation());
  1097	                    } catch (\Exception) {
  1098	                        // エラーが発生しても無視するlog_warning('画像の削除に失敗しました。', ['id' => $id, 'filename' => $deleteImage->getFileName()]);
  1099	                    }
  1100	                }
  1101	
  1102	                log_info('商品削除完了', [$id]);
  1103	
  1104	                $success = true;
  1105	                $message = trans('admin.common.delete_complete');
  1106	
  1107	                $cacheUtil->clearDoctrineCache();
  1108	            } catch (ForeignKeyConstraintViolationException) {
  1109	                log_info('商品削除エラー', [$id]);
  1110	                $message = trans('admin.common.delete_error_foreign_key', ['%name%' => $Product->getName()]);
  1111	            }
  1112	        } else {
  1113	            log_info('商品削除エラー', [$id]);
  1114	            $message = trans('admin.common.delete_error');
  1115	        }
  1116	
  1117	        if ($request->isXmlHttpRequest()) {
  1118	            return $this->json(['success' => $success, 'message' => $message]);
  1119	        } else {
  1120	            if ($success) {
  1121	                $this->addSuccess($message, 'admin');
  1122	            } else {
  1123	                $this->addError($message, 'admin');
  1124	            }
  1125	
  1126	            $rUrl = $this->generateUrl('admin_product_page', ['page_no' => $page_no]).'?resume='.Constant::ENABLED;
  1127	
  1128	            return $this->redirect($rUrl);
  1129	        }
  1130	    }
