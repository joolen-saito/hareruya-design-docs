   370	    #[Route(path: '/%eccube_admin_route%/product/product/image/process', name: 'admin_product_image_process', methods: ['POST'])]
   371	    public function imageProcess(Request $request): Response
   372	    {
   373	        if (!$request->isXmlHttpRequest() && $this->isTokenValid()) {
   374	            throw new BadRequestHttpException();
   375	        }
   376	
   377	        $images = $request->files->get('admin_product');
   378	        $allowExtensions = ['gif', 'jpg', 'jpeg', 'png'];
   379	        $files = [];
