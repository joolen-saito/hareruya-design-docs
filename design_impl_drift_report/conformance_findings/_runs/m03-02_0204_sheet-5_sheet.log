   302	    /**
   303	     * 一覧に表示対象となる商品規格IDを収集する.
   304	     *
   305	     * @param iterable<mixed> $products
   306	     *
   307	     * @return array<int>
   308	     */
   309	    private function collectVisibleProductClassIds(iterable $products): array
   310	    {
   311	        $productClassIds = [];
   312	        foreach ($products as $Product) {
   313	            if (!$Product instanceof Product) {
   314	                continue;
   315	            }
   316	            foreach ($Product->getProductClasses() as $ProductClass) {
   317	                if ($ProductClass->getLanguage() === null || $ProductClass->getCardCondition() === null) {
   318	                    continue;
   319	                }
   320	                $productClassId = $ProductClass->getId();
   321	                if ($productClassId !== null) {
   322	                    $productClassIds[] = (int) $productClassId;
   323	                }
   324	            }
   325	        }
   326	
   327	        return array_values(array_unique($productClassIds));
   328	    }
