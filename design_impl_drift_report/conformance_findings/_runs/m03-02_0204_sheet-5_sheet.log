   385	                    // ファイルフォーマット検証
   386	                    $mimeType = $image->getMimeType();
   387	                    if (!str_starts_with((string) $mimeType, 'image')) {
   388	                        throw new UnsupportedMediaTypeHttpException();
   389	                    }
   390	
   391	                    // 拡張子
   392	                    $extension = $image->getClientOriginalExtension();
   393	                    if (!in_array(strtolower((string) $extension), $allowExtensions)) {
   394	                        throw new UnsupportedMediaTypeHttpException();
   395	                    }
   396	
   397	                    $filename = date('mdHis').uniqid('_').'.'.$extension;
   398	                    $fileAdapter->upload($image->getRealPath(), $this->eccubeConfig->get('preferred_temp_product_image_path'), $filename);
   399	                    $files[] = $filename;
   400	                }
   401	            }
   402	        }
   403	
   404	        $event = new EventArgs(
   405	            [
   406	                'images' => $images,
   407	                'files' => $files,
   408	            ],
   409	            $request
   410	        );
   411	        $this->eventDispatcher->dispatch($event, EccubeEvents::ADMIN_PRODUCT_ADD_IMAGE_COMPLETE);
   412	        $files = $event->getArgument('files');
   413	
   414	        return new Response(array_shift($files));
   415	    }
