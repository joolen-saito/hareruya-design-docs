   363	    /**
   364	     * 画像アップロード時にリクエストされるメソッド.
   365	     *
   366	     * @see https://pqina.nl/filepond/docs/api/server/#process
   367	     *
   368	     * @throws BadRequestHttpException|UnsupportedMediaTypeHttpException
   369	     */
   370	    #[Route(path: '/%eccube_admin_route%/product/product/image/process', name: 'admin_product_image_process', methods: ['POST'])]
   371	    public function imageProcess(Request $request): Response
   372	    {
   373	        if (!$request->isXmlHttpRequest() && $this->isTokenValid()) {
   374	            throw new BadRequestHttpException();
   375	        }
   376	
   377	        $images = $request->files->get('admin_product');
   378	        $allowExtensions = ['gif', 'jpg', 'jpeg', 'png'];
   379	        $files = [];
   380	        $fileAdapter = $this->fileManager->getAdapter();
   381	        if (count($images) > 0) {
   382	            foreach ($images as $img) {
   383	                /** @var UploadedFile $image */
   384	                foreach ($img as $image) {
   385	                    // ファイルフォーマット検証
   386	                    $mimeType = $image->getMimeType();
   387	                    if (!str_starts_with((string) $mimeType, 'image')) {
   388	                        throw new UnsupportedMediaTypeHttpException();
   389	                    }
   390	
   391	                    // 拡張子
   392	                    $extension = $image->getClientOriginalExtension();
   393	                    if (!in_array(strtolower((string) $extension), $allowExtensions)) {
   394	                        throw new UnsupportedMediaTypeHttpException();
   395	                    }
   396	
   397	                    $filename = date('mdHis').uniqid('_').'.'.$extension;
   398	                    $fileAdapter->upload($image->getRealPath(), $this->eccubeConfig->get('preferred_temp_product_image_path'), $filename);
   399	                    $files[] = $filename;
   400	                }
   401	            }
   402	        }
   403	
   404	        $event = new EventArgs(
   405	            [
   406	                'images' => $images,
   407	                'files' => $files,
   408	            ],
   409	            $request
   410	        );
   411	        $this->eventDispatcher->dispatch($event, EccubeEvents::ADMIN_PRODUCT_ADD_IMAGE_COMPLETE);
   412	        $files = $event->getArgument('files');
   413	
   414	        return new Response(array_shift($files));
   415	    }
   416	
   417	    /**
   418	     * アップロード画像を取得する際にコールされるメソッド.
   419	     *
   420	     * @see https://pqina.nl/filepond/docs/api/server/#load
   421	     *
   422	     * @throws BadRequestHttpException|NotFoundHttpException
   423	     */
   424	    #[Route(path: '/%eccube_admin_route%/product/product/image/load', name: 'admin_product_image_load', methods: ['GET'])]
   425	    public function imageLoad(Request $request): Response
   426	    {
   427	        if (!$request->isXmlHttpRequest()) {
   428	            throw new BadRequestHttpException();
   429	        }
   430	
   431	        $source = (string) $request->get('source');
   432	        /** @var ProductImage|null $fileData */
   433	        $fileData = $this->productImageRepository->findOneBy(['objectKey' => $source]);
   434	        $fileAdapter = $this->fileManager->getAdapter();
   435	        if ($fileData === null) {
   436	            if ($fileAdapter->exists($this->eccubeConfig->get('preferred_temp_product_image_path').$source, []) === true) {
   437	                $file = $fileAdapter->get($this->eccubeConfig['preferred_temp_product_image_path'].$source, []);
   438	                $fileKey = $source;
   439	            } elseif (str_starts_with($source, 'img/goods/') && !str_contains($source, '..') && $fileAdapter->exists($source, []) === true) {
   440	                // カード詳細画像を FilePond プレビュー用に配信する。
   441	                // card_detail_image_set() で pond.addFile(url, { type: 'local' }) を呼ぶと
   442	                // FilePond がこのエンドポイントへ img/goods/... パスでリクエストを送る。
   443	                $file = $fileAdapter->get($source, []);
   444	                $fileKey = $source;
   445	            } else {
   446	                throw new NotFoundHttpException();
   447	            }
   448	        } else {
   449	            $file = $fileAdapter->get($fileData->getFileKey(), $fileData->getAdapterInformation());
   450	            $fileKey = $fileData->getFileKey();
   451	        }
   452	
   453	        return new Response(
   454	            $file,
   455	            Response::HTTP_OK,
   456	            [
   457	                'Access-Control-Expose-Headers: Content-Disposition, Content-Length, X-Content-Transfer-Id',
   458	                'Content-Type' => $fileAdapter->getAdditionalFileInformation()['ContentType'],
   459	                'Content-Disposition: inline; filename="'.$fileKey.'"',
   460	            ]
   461	        );
   462	    }
   463	
   464	    /**
   465	     * アップロード画像をすぐ削除する際にコールされるメソッド.
   466	     *
   467	     * @see https://pqina.nl/filepond/docs/api/server/#revert
   468	     *
   469	     * @throws BadRequestHttpException|NotFoundHttpException
   470	     */
   471	    #[Route(path: '/%eccube_admin_route%/product/product/image/revert', name: 'admin_product_image_revert', methods: ['DELETE'])]
   472	    public function imageRevert(Request $request): Response
   473	    {
   474	        if (!$request->isXmlHttpRequest() && $this->isTokenValid()) {
   475	            throw new BadRequestHttpException();
   476	        }
   477	
   478	        $tempFile = $this->eccubeConfig['preferred_temp_product_image_path'].$request->getContent();
   479	
   480	        $fileAdapter = $this->fileManager->getAdapter();
   481	        if ($this->fileManager->getAdapter()->exists($tempFile, [])) {
   482	            $fileAdapter->delete($tempFile, []);
   483	
   484	            return new Response(null, Response::HTTP_NO_CONTENT);
   485	        }
   486	        throw new NotFoundHttpException();
   487	    }
