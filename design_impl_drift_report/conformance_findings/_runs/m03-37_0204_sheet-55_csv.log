     *
     * @return int|string CMC
     */
    public function getCmc(array $row): int|string
    {
        $layout = $row['layout'] ?? 'Normal';
        $cmc = $row['cmc'] ?? 0;
        if ($cmc === '' || (\is_string($cmc) && trim($cmc) === '')) {
            $cmc = 0;
        }

        return match ($layout) {
            'Split' => array_sum(array_map('intval', explode('/', (string) $cmc))),
            'Flip' => (int) explode('/', (string) $cmc)[0],
            'Normal', 'Double Faced', 'Meld', 'Double Faced,Meld' => is_numeric($cmc) ? (int) $cmc : $cmc,
            default => is_numeric($cmc) ? (int) $cmc : $cmc,
        };
    }

