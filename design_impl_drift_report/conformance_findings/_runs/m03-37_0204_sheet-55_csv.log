namespace Eccube\Controller\Admin\Product;

use Eccube\Controller\AbstractController;
use Eccube\Entity\Master\MtbStorageCode;
use Eccube\Form\Type\Admin\CsvImportType;
use Eccube\Form\Type\Admin\StorageCodeType;
use Eccube\Repository\Master\MtbStorageCodeRepository;
use Eccube\Service\Csv\StorageCodeCsv;
use Eccube\Service\CsvExportService;
use Knp\Component\Pager\PaginatorInterface;
use Symfony\Component\HttpFoundation\RedirectResponse;
use Symfony\Component\HttpFoundation\Request;
use Symfony\Component\HttpFoundation\Response;
use Symfony\Component\HttpFoundation\StreamedResponse;
use Symfony\Component\Routing\Annotation\Route;

class StorageCodeController extends AbstractController
{
    /** @var MtbStorageCodeRepository */
    private MtbStorageCodeRepository $storageCodeRepository;

    /** @var CsvExportService */
    private CsvExportService $csvExportService;

    /**
     * @var PaginatorInterface
     */
    private PaginatorInterface $paginator;

    public const EXPORT_HEADER = ['ID', '名称', '並び順'];

    public function __construct(
        MtbStorageCodeRepository $storageCodeRepository,
        CsvExportService $csvExportService,
        PaginatorInterface $paginator,
    ) {
        $this->storageCodeRepository = $storageCodeRepository;
        $this->csvExportService = $csvExportService;
        $this->paginator = $paginator;
    }

    /**
     * 略称タグ一覧・編集・新規作成
     *
     * @param Request $request
     * @param MtbStorageCode|null $StorageCode
     * @param int|null $page_no
     *
     * @return Response
     */
    #[Route(path: '/%eccube_admin_route%/product/storage/{id}/page/{page_no}', name: 'admin_product_storage_code_edit_page', requirements: ['id' => '\d+', 'page_no' => '\d+'], methods: ['GET'])]
    #[Route(path: '/%eccube_admin_route%/product/storage/page/{page_no}', name: 'admin_product_storage_code_page', requirements: ['page_no' => '\d+'], defaults: ['id' => null], methods: ['GET'])]
    #[Route(path: '/%eccube_admin_route%/product/storage/{id}', name: 'admin_product_storage_code_edit', requirements: ['id' => '\d+'], methods: ['GET'])]
    #[Route(path: '/%eccube_admin_route%/product/storage', name: 'admin_product_storage_code', defaults: ['id' => null], methods: ['GET'])]
    public function index(Request $request, ?MtbStorageCode $StorageCode = null, ?int $page_no = null): Response
    {
        if ($StorageCode === null) {
            $StorageCode = new MtbStorageCode();
        }

        $builder = $this->formFactory->createBuilder(StorageCodeType::class, $StorageCode);
        $form = $builder->getForm();

        $session = $request->getSession();

        $sessionKeyPageNo = 'admin.product.storage.page_no';
        $pageNo = (int) ($page_no ?? $session->get($sessionKeyPageNo, 1));
        $session->set($sessionKeyPageNo, $pageNo);

        $sessionKeyCount = 'admin.product.storage.page_count';
        $pageCount = (int) ($request->get('page_count') ?: $session->get($sessionKeyCount, 10));
        $session->set($sessionKeyCount, $pageCount);

        $pagination = $this->createStorageCodesPagination($pageNo, $pageCount);

        return $this->render('@admin/Product/storage_code.twig', [
            'pagination' => $pagination,
            'page_no' => $pageNo,
            'page_count' => $pageCount,
            'form' => $form->createView(),
            'id' => $StorageCode->getId(),
        ]);
    }

    /**
     * 登録・更新処理
     *
     * @param Request $request
     * @param MtbStorageCode|null $StorageCode
     *
     * @return RedirectResponse
     */
    #[Route(path: '/%eccube_admin_route%/product/storage_code/store/{id}', name: 'admin_product_storage_code_store', requirements: ['id' => '\d+'], defaults: ['id' => null], methods: ['POST'])]
    public function store(Request $request, ?MtbStorageCode $StorageCode = null): RedirectResponse
    {
        $builder = $this->formFactory->createBuilder(StorageCodeType::class, $StorageCode);
        $form = $builder->getForm();
        $form->handleRequest($request);

        if (!$form->isSubmitted() || !$form->isValid()) {
            $this->addError('admin.register.failed', 'admin');

            return $this->redirectToRoute('admin_product_storage_code');
        }

        $StorageCode = $form->getData();
        $this->entityManager->persist($StorageCode);
        $this->entityManager->flush();

        $this->addSuccess('admin.register.complete', 'admin');

        return $this->redirectToRoute('admin_product_storage_code', ['id' => $StorageCode->getId()]);
    }

    /**
     * 略称タグ削除
     *
     * @param Request $request
     * @param MtbStorageCode $StorageCode
     *
     * @return RedirectResponse
     */
    #[Route(path: '/%eccube_admin_route%/product/storage_code/{id}/delete', name: 'admin_product_storage_code_delete', requirements: ['id' => '\d+'], methods: ['DELETE'])]
    public function delete(Request $request, MtbStorageCode $StorageCode): RedirectResponse
    {
        $this->isTokenValid();

        if (count($StorageCode->getProducts()) > 0) {
            $this->addError(
                $this->translator->trans('admin.storage.delete.failed', ['%name%' => $StorageCode->getName()]),
                'admin'
            );

            return $this->redirectToRoute('admin_product_storage_code');
        }

        $this->entityManager->remove($StorageCode);
        $this->entityManager->flush();
        $this->addSuccess('admin.common.delete_complete', 'admin');

        return $this->redirectToRoute('admin_product_storage_code');
    }

    /**
     * 略称タグCSV出力
     *
     * @param Request $request
     *
     * @return StreamedResponse
     */
    #[Route(path: '/%eccube_admin_route%/product/storage_code/export', name: 'admin_product_storage_code_export', methods: ['GET'])]
    public function export(Request $request): StreamedResponse
    {
        $response = new StreamedResponse();
        $response->setCallback(function () {
            $this->csvExportService->fopen();
            $this->csvExportService->fputcsv(self::EXPORT_HEADER);
            $results = $this->storageCodeRepository->findBy([], ['rank' => 'ASC']);

            foreach ($results as $result) {
                $row = [
                    $result->getId(),
                    $result->getName(),
                    $result->getRank(),
                ];
                $this->csvExportService->fputcsv($row);
            }

            $this->csvExportService->fclose();
        });

        $now = new \DateTime();
        $filename = 'storage_code_'.$now->format('YmdHis').'.csv';
        $response->headers->set('Content-Type', 'application/octet-stream');
        $response->headers->set('Content-Disposition', 'attachment; filename='.$filename);

        return $response;
    }

    /**
     * 略称タグCSV雛形ファイルダウンロード
     *
     * @return StreamedResponse
     */
    #[Route(path: '/%eccube_admin_route%/product/storage_code/csv_template', name: 'admin_product_storage_code_csv_template', methods: ['GET'])]
    public function csvTemplate(): StreamedResponse
    {
        $response = new StreamedResponse();
        $response->setCallback(function () {
            $this->csvExportService->fopen();
            $this->csvExportService->fputcsv(self::EXPORT_HEADER);
            $this->csvExportService->fclose();
        });

        $filename = 'storage_code_template.csv';
        $response->headers->set('Content-Type', 'application/octet-stream');
        $response->headers->set('Content-Disposition', 'attachment; filename='.$filename);

        return $response;
    }

    /**
     * 略称タグCSVアップロード画面
     *
     * @param Request $request
     *
     * @return Response
     */
    #[Route(path: '/%eccube_admin_route%/product/storage_code/csv', name: 'admin_product_storage_code_csv', methods: ['GET'])]
    public function csv(Request $request): Response
    {
        $form = $this->createForm(CsvImportType::class);
        $form->handleRequest($request);

        $headers = $this->getCsvHeader();

        return $this->render('@admin/Product/csv_product_storage_code.twig', [
            'form' => $form->createView(),
            'headers' => $headers,
        ]);
    }

    /**
     * 略称タグCSV入力
     *
     * @param Request $request
     *
     * @return RedirectResponse
     */
    #[Route(path: '/%eccube_admin_route%/product/storage_code/import', name: 'admin_product_storage_code_import', methods: ['POST'])]
    public function import(Request $request): RedirectResponse
    {
        $storageCodeCsv = new StorageCodeCsv(
            $this->entityManager,
            $this->translator,
            $this->eccubeConfig,
            $this->storageCodeRepository,
            $this->getCsvHeader(),
            $this->getRequiredCsvHeader()
        );

        $form = $this->formFactory->createBuilder(CsvImportType::class)->getForm();
        $form->handleRequest($request);

        if (!$storageCodeCsv->checkFormValid($form)) {
            foreach ($storageCodeCsv->getErrors() as $error) {
                $this->addError($error->getMessage(), 'admin');
            }
            $storageCodeCsv->deleteTempData();

            return $this->redirectToRoute('admin_product_storage_code_csv');
        }

        $formFile = $storageCodeCsv->getFormFile($form);
        if ($formFile === null) {
            $this->addError('admin.common.csv_invalid_format', 'admin');
            $storageCodeCsv->deleteTempData();

            return $this->redirectToRoute('admin_product_storage_code_csv');
        }

        log_info('略称タグCSV登録開始');
        $data = $storageCodeCsv->getImportData($formFile);

        if ($data === false) {
            $this->addError('admin.common.csv_invalid_format', 'admin');
            $storageCodeCsv->deleteTempData();
            log_info('略称タグCSVインポートでエラーが発生しました');

            return $this->redirectToRoute('admin_product_storage_code_csv');
        }

        try {
            $headers = $this->getCsvHeader();
            $columnHeaders = array_filter($data->getColumnHeaders());
            $storageCodeCsv->checkHeaderValues(array_keys($headers), $columnHeaders, $this->getNotRequiredCsvHeader());
            $headerSize = count($columnHeaders);
            $storageCodeCsv->checkDataSize($data);
            $this->entityManager->getConnection()->getConfiguration()->setSQLLogger(null);

            $storageCodeCsv->register(array_keys($headers), $headerSize, $data);
        } catch (\Throwable $e) {
            log_info('エラーが発生しました', [$e->getMessage()]);
            $this->addError($e->getMessage(), 'admin');
            $storageCodeCsv->deleteTempData();

            return $this->redirectToRoute('admin_product_storage_code_csv');
        }

        log_info('略称タグCSV登録完了');
        $this->addSuccess('admin.register.complete', 'admin');
        $storageCodeCsv->deleteTempData();

        return $this->redirectToRoute('admin_product_storage_code_csv');
    }

    /**
     * @param int $pageNo
     * @param int $pageCount
     *
     * @return \Knp\Component\Pager\Pagination\PaginationInterface<int, MtbStorageCode>
     */
    private function createStorageCodesPagination(int $pageNo, int $pageCount): \Knp\Component\Pager\Pagination\PaginationInterface
    {
        $qb = $this->storageCodeRepository->createQueryBuilder('s')->orderBy('s.rank', 'ASC');

        return $this->paginator->paginate($qb, $pageNo, $pageCount);
    }

    /**
     * 略称タグCSVヘッダー定義
     *
     * @return array<string, string>
     */
    private function getCsvHeader(): array
    {
        return [
            'ID' => 'ID',
            '名称' => '名称',
            '並び順' => '並び順',
        ];
    }

    /**
     * 略称タグCSV必須ヘッダー定義
     *
     * @return array<string, string>
     */
    private function getRequiredCsvHeader(): array
    {
        return [
            '名称' => '名称',
            '並び順' => '並び順',
        ];
    }

    /**
     * 略称タグCSV必須外ヘッダー（比較から除外）
     *
     * @return array<int, string>
     */
    private function getNotRequiredCsvHeader(): array
    {
        return ['ID'];
    }

