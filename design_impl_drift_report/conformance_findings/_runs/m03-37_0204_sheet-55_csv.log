                                    <div class="form-group">
                                        <div class="custom-file">
                                            {{ form_widget(form.import_file, {'attr': {'class': 'custom-file-input', 'accept': '.csv, text/csv, .tsv, text/tsv'}}) }}
                                        </div>
                                        {{ form_errors(form.import_file) }}
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="card-footer text-center">
                            <button id="upload-button" type="submit" class="btn btn-ec-conversion px-5">
                                {{ 'admin.common.csv_upload'|trans }}
                            </button>
                        </div>
                    </div>
                </form>

                <div class="card rounded border shadow-sm">
                    <div class="card-header d-flex align-items-center justify-content-between">
                        <h4 class="card-title mb-0">{{ 'admin.product.storage_code_csv_format_title'|trans }}</h4>
                        <a href="{{ url('admin_product_storage_code_csv_template') }}" class="btn btn-ec-conversion" id="download-template-button">{{ 'admin.common.csv_skeleton_download'|trans }}</a>
                    </div>
                    <div class="card-body p-0">
                        <div class="table-responsive">
                            <table class="table table-striped table-bordered mb-0 text-nowrap">
                                <thead class="thead-light">
                                <tr>
                                    {% for header in headers|keys %}
                                        <th>{{ header }}</th>
