     */
    public function getImportData(UploadedFile $formFile): CsvImportService|false
    {
        $tempDir = $this->eccubeConfig['eccube_csv_temp_realdir'] ?? null;
        if ($tempDir === null) {
            return false;
        }

        $this->fileName = 'upload_'.StringUtil::random().'.'.$formFile->getClientOriginalExtension();
        $formFile->move($tempDir, $this->fileName);

        $path = $tempDir.'/'.$this->fileName;
        $fileContent = file_get_contents($path);

        if ($fileContent === false) {
            return false;
        }

        if (str_starts_with($fileContent, "\xEF\xBB\xBF")) {
            $fileContent = substr($fileContent, 3);
        }

        $encode = StringUtil::characterEncoding($fileContent);
        // UTF-8以外（Shift-JISなど）なら、UTF-8に変換する
        if ($encode !== null && $encode !== 'UTF-8') {
            $fileContent = mb_convert_encoding($fileContent, 'UTF-8', $encode);
        }

        $fileContent = StringUtil::convertLineFeed($fileContent);
        $fileContent = $this->removeWhite($fileContent);

        $tmp = tmpfile();
        if ($tmp === false) {
            return false;
        }

        fwrite($tmp, $fileContent);
        rewind($tmp);

        $meta = stream_get_meta_data($tmp);
        $file = new \SplFileObject($meta['uri']);

        set_time_limit(0);

        $delimiter = $formFile->getClientOriginalExtension() === 'tsv'
            ? "\t"
            : ($this->eccubeConfig['eccube_csv_import_delimiter'] ?? ',');

        $enclosure = $this->eccubeConfig['eccube_csv_import_enclosure'] ?? '"';

        $data = new CsvImportService($file, $delimiter, $enclosure);

        return $data->setHeaderRowNumber(0) ? $data : false;
    }

