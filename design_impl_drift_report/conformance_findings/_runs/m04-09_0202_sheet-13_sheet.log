   255	                -- カードソート: alphabet_sort_flgがtrueの略称タグ→英語カード名昇順、falseならコレクター番号昇順
   256	                CASE WHEN sc.alphabet_sort_flg = true THEN c.name_en ELSE cd.card_no END AS "cardSort"
