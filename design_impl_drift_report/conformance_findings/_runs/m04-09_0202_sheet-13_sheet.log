   468	            'move_transfer_type' => \PDO::PARAM_INT,
   469	            'smaregi_stock_location_id' => \PDO::PARAM_INT,
   470	            'goods_category_id' => \PDO::PARAM_INT,
   471	            'reserved_goods_category_id' => \PDO::PARAM_INT,
   472	            'abolished_status_id' => \PDO::PARAM_INT,
   473	        ]);
   474	    }
