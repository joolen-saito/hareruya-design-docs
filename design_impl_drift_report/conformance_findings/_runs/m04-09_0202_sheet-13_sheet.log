   451	                $form.find('input[type="checkbox"]:checked').prop('checked', false);
   452	                $form.find('input').each(function () {
   453	                    const $i = $(this);
   454	                    const t = $i.attr('type');
   455	                    const name = $i.attr('name') || '';
   456	                    if (t === 'checkbox' || t === 'hidden' || t === 'submit' || name.indexOf('_token') !== -1) {
   457	                        return;
   458	                    }
   459	                    $i.val('');
   460	                });
   461	                $fromBase.val(null).trigger('change');
   462	                $toBase.val(null).trigger('change');
   463	                $registeredMembers.val(null).trigger('change');
   464	                $fromApprovalMembers.val(null).trigger('change');
   465	                $toApprovalMembers.val(null).trigger('change');
   466	                $form.find('select').each(function () {
   467	                    const $s = $(this);
   468	                    if ($s.is($fromBase) || $s.is($toBase) || $s.is($registeredMembers) || $s.is($fromApprovalMembers) || $s.is($toApprovalMembers)) {
   469	                        return;
   470	                    }
   471	                    $s.val($s.find('option:first').val()).trigger('change');
   472	                });
   473	                return false;
   474	            });
   475	        });
