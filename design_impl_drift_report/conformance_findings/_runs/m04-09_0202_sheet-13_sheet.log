    16	namespace Eccube\Repository;
    17	
    18	use Doctrine\Persistence\ManagerRegistry;
    19	use Eccube\Entity\DtbStockMoveTransferDetail;
    20	
    21	/**
    22	 * @extends AbstractRepository<DtbStockMoveTransferDetail>
    23	 */
    24	class DtbStockMoveTransferDetailRepository extends AbstractRepository
    25	{
    26	    public function __construct(ManagerRegistry $registry)
    27	    {
    28	        parent::__construct($registry, DtbStockMoveTransferDetail::class);
    29	    }
    30	
    31	    /**
    32	     * 在庫移動振替IDごとの移動点数・基準価格合計.
    33	     *
    34	     * @param list<int> $stockMoveTransferIds
    35	     *
    36	     * @return array<int, array{quantity: int, standard_total: string}>
    37	     */
    38	    public function getAggregatesByStockMoveTransferIds(array $stockMoveTransferIds): array
    39	    {
    40	        if ($stockMoveTransferIds === []) {
    41	            return [];
    42	        }
    43	
    44	        $rows = $this->createQueryBuilder('d')
    45	            ->select('smt.id AS stock_move_transfer_id')
    46	            ->addSelect('COALESCE(SUM(d.moveTransferQuantity), 0) AS move_transfer_quantity')
    47	            ->addSelect('COALESCE(SUM(d.standardTotalPrice), 0) AS standard_total_price')
    48	            ->innerJoin('d.StockMoveTransfer', 'smt')
    49	            ->where('smt.id IN (:ids)')
    50	            ->setParameter('ids', $stockMoveTransferIds)
    51	            ->groupBy('smt.id')
    52	            ->getQuery()
    53	            ->getArrayResult();
    54	
    55	        $aggregates = [];
    56	
    57	        foreach ($rows as $row) {
    58	            $stockMoveTransferId = (int) $row['stock_move_transfer_id'];
    59	
    60	            $aggregates[$stockMoveTransferId] = [
    61	                'quantity' => (int) $row['move_transfer_quantity'],
    62	                'standard_total' => (string) $row['standard_total_price'],
    63	            ];
    64	        }
    65	
    66	        return $aggregates;
    67	    }
    68	}

