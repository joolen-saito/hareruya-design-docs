   383	     * @param array<int, int> $stockMoveTransferIds
   384	     *
   385	     * @return iterable<int, array<string, mixed>>
   386	     */
   387	    public function iterateBarcodeCsvExportRowsByStockMoveTransferIds(array $stockMoveTransferIds): iterable
   388	    {
   389	        if ($stockMoveTransferIds === []) {
   390	            return new \ArrayIterator([]);
   391	        }
   392	
   393	        $connection = $this->getEntityManager()->getConnection();
   394	
   395	        $sql = <<<SQL
   396	            SELECT
   397	                barcode_rows."rawProductName",
   398	                barcode_rows."languageNameJp",
   399	                barcode_rows."conditionCode",
   400	                barcode_rows."standardPrice",
   401	                barcode_rows."smaregiProductId",
   402	                barcode_rows."smaregiProductCode",
   403	                barcode_rows."isSupply"
   404	            FROM (
   405	                SELECT DISTINCT ON (pc.id)
   406	                    pc.id AS product_class_id,
   407	                    p.name AS "rawProductName",
   408	                    lng.name_jp AS "languageNameJp",
   409	                    cond.code AS "conditionCode",
   410	                    pc.standard_price AS "standardPrice",
   411	                    pc.smaregi_product_id AS "smaregiProductId",
   412	                    pc.smaregi_product_code AS "smaregiProductCode",
   413	                    CASE WHEN EXISTS (
   414	                        SELECT 1 FROM dtb_product_category pcat
   415	                        WHERE pcat.product_id = p.id
   416	                          AND pcat.category_id IN (:goods_category_id, :reserved_goods_category_id)
   417	                    ) THEN 1 ELSE 0 END AS "isSupply",
   418	                    COALESCE(cs.sort_no, 99999) AS "colorSort",
   419	                    COALESCE(
   420	                        (
   421	                            SELECT MIN(ct.sort_no)
   422	                            FROM dtb_card_cardtype dcc
   423	                            INNER JOIN mtb_cardtype ct ON ct.id = dcc.cardtype_id
   424	                            WHERE dcc.card_id = c.id
   425	                        ),
   426	                        99999
   427	                    ) AS "cardTypeSort",
   428	                    COALESCE(c.cmc, 99999) AS "manaCostSort"
   429	                FROM dtb_stock_move_transfer smt
   430	                INNER JOIN dtb_stock_move_transfer_detail d ON d.stock_move_transfer_id = smt.id
   431	                INNER JOIN dtb_product_stock ps ON ps.id = d.move_to_product_stock_id
   432	                INNER JOIN dtb_product_class pc ON pc.id = ps.product_class_id
   433	                INNER JOIN dtb_product p ON p.id = pc.product_id
   434	                INNER JOIN mtb_product_status p_status ON p_status.id = p.product_status_id
   435	                INNER JOIN mtb_product_status pc_status ON pc_status.id = pc.product_status_id
   436	                LEFT JOIN mtb_language lng ON lng.id = pc.language_id
   437	                LEFT JOIN mtb_card_condition cond ON cond.id = pc.card_condition_id
   438	                LEFT JOIN mtb_card_detail cd ON cd.id = p.card_detail_id
   439	                LEFT JOIN mtb_card c ON c.id = cd.card_id
   440	                LEFT JOIN mtb_color_sequence cs ON cs.id = c.color_sequence_id
   441	                WHERE smt.id IN (:ids)
   442	                    AND smt.move_transfer_type = :move_transfer_type
   443	                    AND smt.move_to_stock_location_id = :smaregi_stock_location_id
   444	                    AND pc.smaregi_alignment_flg = TRUE
   445	                    AND pc.smaregi_product_id IS NOT NULL
   446	                    AND TRIM(pc.smaregi_product_id) <> ''
   447	                    AND p_status.id <> :abolished_status_id
   448	                    AND pc_status.id <> :abolished_status_id
   449	                ORDER BY pc.id ASC
   450	            ) AS barcode_rows
   451	            ORDER BY
   452	                barcode_rows."colorSort" ASC,
   453	                barcode_rows."cardTypeSort" ASC,
   454	                barcode_rows."manaCostSort" ASC,
   455	                barcode_rows."standardPrice" DESC NULLS LAST,
   456	                barcode_rows.product_class_id ASC
   457	        SQL;
   458	
   459	        return $connection->iterateAssociative($sql, [
   460	            'ids' => $stockMoveTransferIds,
   461	            'move_transfer_type' => DtbStockMoveTransfer::MOVE_TRANSFER_TYPE_MOVE,
   462	            'smaregi_stock_location_id' => ProductStock::STOCK_LOCATION_SMAREGI,
   463	            'goods_category_id' => Category::GOODS_ID,
   464	            'reserved_goods_category_id' => Category::RESERVED_GOODS_ID,
   465	            'abolished_status_id' => ProductStatus::DISPLAY_ABOLISHED,
