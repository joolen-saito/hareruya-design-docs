   162	     *
   163	     * @return list<MoveTransferListPrintPage>
   164	     */
   165	    private function buildPrintPagesForThresholdGroup(array $formattedRows): array
   166	    {
   167	        if ($formattedRows === []) {
   168	            return [];
   169	        }
   170	
   171	        $pageChunks = array_chunk($formattedRows, self::MAX_PAGE_ROWS);
   172	        $totalPages = count($pageChunks);
   173	        $pages = [];
   174	
   175	        foreach ($pageChunks as $pageIndex => $pageRows) {
   176	            $items = [];
   177	            $pageQuantitySubtotal = 0;
   178	
   179	            foreach ($pageRows as $rowIndex => $formattedRow) {
   180	                $items[] = [
   181	                    'rowNo' => $rowIndex + 1,
   182	                    'remarks' => '',
   183	                ] + array_diff_key($formattedRow, ['pickingType' => true]);
   184	
   185	                $pageQuantitySubtotal += (int) ($formattedRow['quantity'] ?? 0);
   186	            }
   187	
   188	            $pages[] = [
   189	                'currentPage' => $pageIndex + 1,
   190	                'totalPages' => $totalPages,
   191	                'items' => $items,
   192	                'pageQuantitySubtotal' => $pageQuantitySubtotal,
   193	            ];
   194	        }
   195	
   196	        return $pages;
   197	    }
   198	}

