   618	    public function createMoveInstruction(Request $request): RedirectResponse
   619	    {
   620	        $token = $request->request->get(Constant::TOKEN_NAME);
   621	        if (!$this->isCsrfTokenValid(Constant::TOKEN_NAME, $token)) {
   622	            $this->addError('admin.common.csrf_invalid', 'admin');
   623	
   624	            return $this->redirectToRoute('admin_stock_move_transfer', array_merge($request->query->all(), ['resume' => '1']));
   625	        }
   626	
   627	        $rawIds = $request->request->all('ids');
   628	        foreach ($rawIds as $rawId) {
   629	            if (!is_string($rawId) || !ctype_digit($rawId) || (int) $rawId <= 0) {
   630	                $this->addError('admin.stock.move_transfer.create_instruction.no_selection', 'admin');
