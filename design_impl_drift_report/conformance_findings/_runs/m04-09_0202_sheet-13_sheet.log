    26	class StockMoveInstructionCreateAction
    27	{
    28	    public function __construct(
    29	        private readonly EntityManagerInterface $entityManager,
    30	        private readonly DtbStockMoveInstructionRepository $stockMoveInstructionRepository,
    31	    ) {
    32	    }
    33	
    34	    /**
    35	     * 在庫移動指示を作成し、対象の移動に移動指示IDを紐づける
    36	     *
    37	     * @throws StockMoveInstructionCreateException バリデーションエラー時
    38	     */
    39	    public function handle(StockMoveInstructionCreateInput $input): DtbStockMoveInstruction
    40	    {
    41	        $StockMoveTransfers = $input->StockMoveTransfers;
    42	        $ids = array_map(fn (DtbStockMoveTransfer $t) => $t->getId(), $StockMoveTransfers);
    43	        $priceThreshold = $StockMoveTransfers[0]->getMoveFromBaseInfo()?->getExpensiveThreshold1() ?? 0;
    44	
    45	        $Instruction = new DtbStockMoveInstruction();
    46	        $Instruction->setMoveFromBaseInfo($StockMoveTransfers[0]->getMoveFromBaseInfo());
    47	        $Instruction->setMoveToBaseInfo($StockMoveTransfers[0]->getMoveToBaseInfo());
    48	        $Instruction->setMoveFromPriceThreshold($priceThreshold);
    49	        $Instruction->setSubjectOfMoves(count($StockMoveTransfers));
    50	        $Instruction->setQuantityOfMoves(0);
    51	        $Instruction->setStandardTotalPrice('0');
    52	        $Instruction->setOutboundTotalCost('0');
    53	        $Instruction->setHighTotalPrice('0');
    54	        $Instruction->setRegularTotalPrice('0');
    55	        $Instruction->setRegisteredMember($input->Member);
    56	        $Instruction->setCreateDate(new \DateTime());
    57	
    58	        $this->entityManager->beginTransaction();
    59	        try {
    60	            $this->validate($StockMoveTransfers);
    61	
    62	            $this->entityManager->persist($Instruction);
    63	            $this->entityManager->flush();
    64	
    65	            $affected = $this->entityManager->getConnection()->executeStatement(
    66	                'UPDATE dtb_stock_move_transfer SET move_instruction_id = :instructionId WHERE id IN (:ids) AND move_instruction_id IS NULL',
    67	                ['instructionId' => $Instruction->getId(), 'ids' => $ids],
    68	                ['ids' => ArrayParameterType::INTEGER]
    69	            );
    70	
    71	            if ($affected !== count($ids)) {
    72	                throw new StockMoveInstructionCreateException('admin.stock.move_transfer.create_instruction.already_assigned');
    73	            }
    74	
    75	            // Transfer 紐づけ完了後、閾値対応の集計値を算出して保存する
    76	            $aggregates = $this->stockMoveInstructionRepository->getTransferAggregatesByTransferIds($ids, $priceThreshold);
    77	            $totalQuantity = 0;
    78	            $totalStandardPrice = '0.00';
    79	            $totalOutboundCost = '0.00';
    80	            $totalHighPrice = '0.00';
    81	            $totalRegularPrice = '0.00';
    82	            foreach ($StockMoveTransfers as $transfer) {
    83	                $agg = $aggregates[$transfer->getId()] ?? [
    84	                    'quantity' => 0,
    85	                    'standard_total' => '0.00',
    86	                    'outbound_total_cost' => '0.00',
    87	                    'high_total' => '0.00',
    88	                    'regular_total' => '0.00',
    89	                ];
    90	                $totalQuantity += $agg['quantity'];
    91	                $totalStandardPrice = bcadd($totalStandardPrice, $agg['standard_total'], 2);
    92	                $totalOutboundCost = bcadd($totalOutboundCost, $agg['outbound_total_cost'], 2);
    93	                $totalHighPrice = bcadd($totalHighPrice, $agg['high_total'], 2);
    94	                $totalRegularPrice = bcadd($totalRegularPrice, $agg['regular_total'], 2);
    95	            }
    96	
    97	            $Instruction->setQuantityOfMoves($totalQuantity);
    98	            $Instruction->setStandardTotalPrice($totalStandardPrice);
    99	            $Instruction->setOutboundTotalCost($totalOutboundCost);
   100	            $Instruction->setHighTotalPrice($totalHighPrice);
   101	            $Instruction->setRegularTotalPrice($totalRegularPrice);
   102	            $this->entityManager->flush();
   103	
   104	            $this->entityManager->commit();
   105	        } catch (\Exception $e) {
   106	            $this->entityManager->rollback();
   107	            throw $e;
   108	        }
   109	
   110	        return $Instruction;
   111	    }
   112	
   113	    /**
   114	     * @param list<DtbStockMoveTransfer> $StockMoveTransfers
   115	     *
   116	     * @throws StockMoveInstructionCreateException
   117	     */
   118	    private function validate(array $StockMoveTransfers): void
   119	    {
   120	        foreach ($StockMoveTransfers as $transfer) {
   121	            // ①移動タイプが移動であること
   122	            if ($transfer->getMoveTransferType() !== DtbStockMoveTransfer::MOVE_TRANSFER_TYPE_MOVE) {
   123	                throw new StockMoveInstructionCreateException('admin.stock.move_transfer.create_instruction.not_move_type');
   124	            }
   125	
   126	            // ④ステータスが出庫承認済みであること
   127	            if ($transfer->getMoveTransferStatus()->getId() !== \Eccube\Entity\Master\MtbStockMoveTransferStatus::STATUS_OUTBOUND_APPROVED) {
   128	                throw new StockMoveInstructionCreateException('admin.stock.move_transfer.create_instruction.status_invalid');
   129	            }
   130	
   131	            // ⑤移動指示IDが未登録であること
   132	            if ($transfer->getMoveInstructionId() !== null) {
   133	                throw new StockMoveInstructionCreateException('admin.stock.move_transfer.create_instruction.already_assigned');
   134	            }
   135	        }
   136	
   137	        // ②選択された移動の出庫元店舗がすべて同一であること
   138	        $fromBaseInfoId = $StockMoveTransfers[0]->getMoveFromBaseInfo()?->getId();
   139	        foreach ($StockMoveTransfers as $transfer) {
   140	            if ($transfer->getMoveFromBaseInfo()?->getId() !== $fromBaseInfoId) {
   141	                throw new StockMoveInstructionCreateException('admin.stock.move_transfer.create_instruction.from_store_mismatch');
   142	            }
   143	        }
   144	
   145	        // ③選択された移動の入庫先店舗がすべて同一であること
   146	        $toBaseInfoId = $StockMoveTransfers[0]->getMoveToBaseInfo()?->getId();
   147	        foreach ($StockMoveTransfers as $transfer) {
   148	            if ($transfer->getMoveToBaseInfo()?->getId() !== $toBaseInfoId) {
   149	                throw new StockMoveInstructionCreateException('admin.stock.move_transfer.create_instruction.to_store_mismatch');
   150	            }
   151	        }
   152	    }
   153	}

