   210	                    WHERE dcc.card_id = c.id
   211	                ) AS "colorName",
   212	                r.code AS "rarityCode",
   213	                COALESCE(cd.foil_flg, 0) AS "foilFlg",
   214	                SUM({$quantityExpression}) AS "quantity",
   215	                pc.standard_price AS "standardPrice",
   216	                bi.expensive_threshold1 AS "threshold1",
   217	                bi.expensive_threshold2 AS "threshold2",
   218	                bi.expensive_threshold3 AS "threshold3",
   219	                -- カテゴリ判定を EXISTS に分離: 1:N JOIN による数量重複を防ぐ
   220	                CASE WHEN EXISTS (
   221	                    SELECT 1 FROM dtb_product_category pcat
   222	                    WHERE pcat.product_id = p.id
   223	                      AND pcat.category_id IN (:goods_category_id, :reserved_goods_category_id)
   224	                ) THEN 1 ELSE 0 END AS "isSupply",
   225	                -- ピッキング区分ソート: 円未満(1) → 円以上~円未満(2) → 円以上(3) → サプライ(99)
   226	                CASE
   227	                    WHEN EXISTS (
   228	                        SELECT 1 FROM dtb_product_category pcat
   229	                        WHERE pcat.product_id = p.id
   230	                          AND pcat.category_id IN (:goods_category_id, :reserved_goods_category_id)
   231	                    ) THEN 99
   232	                    ELSE
   233	                        (
   234	                            (CASE WHEN bi.expensive_threshold1 IS NOT NULL AND pc.standard_price >= bi.expensive_threshold1 THEN 1 ELSE 0 END)
   235	                            + (CASE WHEN bi.expensive_threshold2 IS NOT NULL AND pc.standard_price >= bi.expensive_threshold2 THEN 1 ELSE 0 END)
   236	                            + (CASE WHEN bi.expensive_threshold3 IS NOT NULL AND pc.standard_price >= bi.expensive_threshold3 THEN 1 ELSE 0 END)
   237	                        ) + 1
   238	                END AS "pickingTypeSort",
   239	                sn.name AS "shelfNumberName",
   240	                bi.id AS "baseInfoId",
