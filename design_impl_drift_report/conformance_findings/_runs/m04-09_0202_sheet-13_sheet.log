   249	                -- 略称タグソート: mtb_storage_code.rank 昇順
   250	                COALESCE(sc.rank, 99999) AS "storageCodeSort",
   251	                -- レアリティソート: mtb_rarity.sort_no 昇順（M→C はマスターの並び順に依存）
   252	                COALESCE(r.sort_no, 99999) AS "raritySort",
   253	                -- 色ソート: mtb_card.color_sequence_id → mtb_color_sequence.sort_no 昇順
