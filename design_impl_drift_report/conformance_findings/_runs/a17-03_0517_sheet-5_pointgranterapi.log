    21	use Eccube\Service\EntityManager\PointHistoryEntityManager;
    22	
    23	class PointGranterAction
    24	{
    25	    public function __construct(
    26	        private readonly DtbPlayerRepository $playerRepository,
    27	        private readonly MtbPointTypeRepository $mtbPointTypeRepository,
    28	        private readonly EntityManagerInterface $entityManager,
    29	        private readonly PointHistoryEntityManager $pointHistoryEntityManager,
    30	    ) {
    31	    }
    32	
    33	    /**
    34	     * ポイント付与処理を実行する
    35	     *
    36	     * @param PointGranterInput $input
    37	     *
    38	     * @return void
    39	     *
    40	     * @throws \Exception DB操作時のエラー
    41	     */
    42	    public function handle(PointGranterInput $input): void
    43	    {
    44	        $row = $input->row;
    45	
    46	        $customerId = $row['customerId'] ?? null;
    47	        $newPoint = isset($row['newPoint']) ? (int) $row['newPoint'] : 0;
    48	        $memo = $row['memo'] ?? null;
    49	        $terminalTranDateTime = $row['terminalTranDateTime'] ?? null;
    50	        $pointAttr = isset($row['pointAttr']) ? (int) $row['pointAttr'] : null;
    51	
    52	        $Player = $this->playerRepository->findOneBy(['smaregiId' => (string) $customerId]);
    53	        if ($Player === null) {
    54	            return;
    55	        }
    56	
    57	        $this->entityManager->beginTransaction();
    58	
    59	        try {
    60	            $issueDate = $terminalTranDateTime ? new \DateTime($terminalTranDateTime) : new \DateTime();
    61	
    62	            if ($pointAttr !== null) {
    63	                $PointType = $this->mtbPointTypeRepository->find($pointAttr);
    64	            }
    65	
    66	            $Player->setPoint($Player->getPoint() + $newPoint);
    67	            $this->entityManager->persist($Player);
    68	            $this->pointHistoryEntityManager->save(
    69	                PointHistory: null,
    70	                Customer: $Player->getCustomer(),
    71	                Order: null,
    72	                PointType: $PointType ?? null,
    73	                pointChange: $newPoint,
    74	                note: $memo ?? '',
    75	                issueDate: $issueDate,
    76	                transactionId: null,
    77	            );
    78	
    79	            $this->entityManager->flush();
    80	            $this->entityManager->commit();
    81	        } catch (\Throwable $e) {
    82	            $this->entityManager->rollback();
    83	            throw $e;
    84	        }
    85	    }
    86	}

