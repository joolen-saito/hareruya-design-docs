   178	            );
   179	        } catch (\Throwable $e) {
   180	            $this->logger->error('Smaregi transaction platform API call log (success) record failed', $logContext + [
   181	                'method' => 'GET',
   182	                'url' => $requestUrl,
   183	                'statusCode' => $statusCode,
   184	                'error' => $e->getMessage(),
   185	            ]);
   186	        }
   187	
