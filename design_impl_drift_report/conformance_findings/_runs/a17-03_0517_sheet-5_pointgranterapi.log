   130	    /**
   131	     * パラメータからrowデータを抽出する
   132	     *
   133	     * @param string $params
   134	     *
   135	     * @return array<string, mixed>|null
   136	     */
   137	    private function extractRow(string $params): ?array
   138	    {
   139	        $data = json_decode($params, true);
   140	        if (!is_array($data)) {
