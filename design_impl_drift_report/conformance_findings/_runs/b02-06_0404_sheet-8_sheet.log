     *         create_source?:MtbStockHistorySourceType[],
     *         create_source_id?:int|null,
     *         create_notification_target_members?:int|null,
     *         update_notification_target_members?:int|null,
     *         purchase_unit_price_from?:int|null,
     *         purchase_unit_price_to?:int|null,
     *         update_date_from?:\DateTime|null,
     *         update_date_to?:\DateTime|null,
     *         stock_change_reason?:string|null,
     *     } $searchData
     *
     * @return QueryBuilder
     */
    public function getQueryBuilderBySearchDataForAdmin(array $searchData): QueryBuilder
    {
        $qb = $this->createQueryBuilder('sh')
            ->addSelect('ps', 'm', 'pc', 'p', 'cd')
            ->leftJoin('sh.ProductStock', 'ps')
            ->leftJoin('sh.Member', 'm')
            ->leftJoin('ps.ProductClass', 'pc')
            ->leftJoin('pc.Product', 'p')
            ->leftJoin('pc.TaxRule', 'tr')
            ->leftJoin('p.CardDetail', 'cd');

        // id 商品名(日/英)・カード名(日/英)・商品ID・商品コード
        if (isset($searchData['product_name']) && StringUtil::isNotBlank($searchData['product_name'])) {
            $product_name = $searchData['product_name'];

            $qb
                ->leftJoin('cd.Card', 'ca')
                ->andWhere('p.name = :productName OR p.name LIKE :likeProductName OR p.name_en LIKE :likeProductName OR pc.code LIKE :likeProductName OR ca.name_jp LIKE :likeProductName OR ca.name_en LIKE :likeProductName')
                ->setParameter('productName', $product_name)
                ->setParameter('likeProductName', '%'.str_replace(['%', '_'], ['\\%', '\\_'], $product_name).'%');
        }

        // base_info 店舗
        if (isset($searchData['base_info']) && StringUtil::isNotBlank($searchData['base_info'])) {
            $qb
                ->andWhere($qb->expr()->in('ps.baseInfo', ':base_info'))
                ->setParameter('base_info', $searchData['base_info']);
        }

        // stock_location_id 在庫場所
        if (isset($searchData['stock_location_id']) && StringUtil::isNotBlank($searchData['stock_location_id'])) {
            $qb
                ->andWhere($qb->expr()->in('ps.stockLocationId', ':stock_location_id'))
                ->setParameter('stock_location_id', $searchData['stock_location_id']);
        }

        // create_date_from 登録日
        if (isset($searchData['create_date_from']) && StringUtil::isNotBlank($searchData['create_date_from'])) {
            $date = $searchData['create_date_from']->format('Y-m-d 00:00:00');
            $qb
                ->andWhere('sh.createDate >= :create_date_from')
                ->setParameter('create_date_from', $date);
        }

        // create_date_to 登録日
        if (isset($searchData['create_date_to']) && StringUtil::isNotBlank($searchData['create_date_to'])) {
            $date = $searchData['create_date_to']->format('Y-m-d 23:59:59');
            $qb
                ->andWhere('sh.createDate <= :create_date_to')
                ->setParameter('create_date_to', $date);
        }

        // stock_change_type_detail 在庫変動区分（子区分で絞り込み）
        if (isset($searchData['stock_change_type_detail']) && StringUtil::isNotBlank($searchData['stock_change_type_detail'])) {
            $qb
                ->andWhere($qb->expr()->in('sh.StockChangeTypeDetail', ':selected_change_type_detail'))
                ->setParameter('selected_change_type_detail', $searchData['stock_change_type_detail']);
        }

        // disposal_search 欠品検索
        if (isset($searchData['disposal_search']) && StringUtil::isNotBlank($searchData['disposal_search'])) {
            $StockChangeTypeIds = $this->stockChangeTypeDetailRepository->getQueryBuilderByStockChangeTypeIds(
                [MtbStockChangeType::DISPOSAL]
            )->getQuery()->getResult();
            $qb
                ->andWhere($qb->expr()->in('sh.StockChangeTypeDetail', ':stock_change_type_detail'))
                ->setParameter('stock_change_type_detail', $StockChangeTypeIds);
        } else {
            $StockChangeTypeIds = $this->stockChangeTypeDetailRepository->getQueryBuilderByStockChangeTypeIds(
                [MtbStockChangeType::BE_STOCKED]
            )->getQuery()->getResult();
            $qb
                ->andWhere($qb->expr()->in('sh.StockChangeTypeDetail', ':stock_change_type_detail'))
                ->setParameter('stock_change_type_detail', $StockChangeTypeIds);
        }

        // category_id カテゴリ
        if (isset($searchData['category_id']) && StringUtil::isNotBlank($searchData['category_id'])) {
            $qb
                ->leftJoin('p.ProductCategories', 'pca')
                ->andWhere($qb->expr()->in('pca.Category', ':category_id'))
                ->setParameter('category_id', $searchData['category_id']);
        }

        // status 公開種別
        if (isset($searchData['status']) && StringUtil::isNotBlank($searchData['status'])) {
            $qb
                ->andWhere($qb->expr()->in('p.Status', ':Status'))
                ->setParameter('Status', $searchData['status']);
        }

        // cardset エキスパンション
        if (isset($searchData['cardset']) && StringUtil::isNotBlank($searchData['cardset'])) {
            $qb
                ->andWhere($qb->expr()->in('cd.Cardset', ':cardset'))
                ->setParameter('cardset', $searchData['cardset']);
        }

        // rarity レアリティ
        if (isset($searchData['rarity']) && StringUtil::isNotBlank($searchData['rarity'])) {
            $qb
                ->andWhere($qb->expr()->in('cd.Rarity', ':rarity'))
                ->setParameter('rarity', $searchData['rarity']);
        }

        // language 言語（3=その他は Language >= 3 で一致させる）
        if (isset($searchData['language']) && StringUtil::isNotBlank($searchData['language'])) {
            $languages = array_map('intval', (array) $searchData['language']);
            $hasOthers = in_array(3, $languages, true);
            $exactLangs = array_values(array_filter($languages, fn (int $l): bool => $l !== 3));

            if ($hasOthers && $exactLangs !== []) {
                $qb->andWhere($qb->expr()->orX(
                    $qb->expr()->in('pc.Language', ':language'),
                    $qb->expr()->gte('pc.Language', ':others_threshold')
                ))
                    ->setParameter('language', $exactLangs)
                    ->setParameter('others_threshold', 3);
            } elseif ($hasOthers) {
                $qb->andWhere('pc.Language >= :others_threshold')
                    ->setParameter('others_threshold', 3);
            } else {
                $qb->andWhere($qb->expr()->in('pc.Language', ':language'))
                    ->setParameter('language', $exactLangs);
            }
        }

        // card_condition 状態
        if (isset($searchData['card_condition']) && StringUtil::isNotBlank($searchData['card_condition'])) {
            $qb
                ->andWhere($qb->expr()->in('pc.CardCondition', ':card_condition'))
                ->setParameter('card_condition', $searchData['card_condition']);
        }

        // foil
        // TODO:foilのマスタテーブルができた後で実装

        // promotion プロモ
        if (isset($searchData['promotion']) && StringUtil::isNotBlank($searchData['promotion'])) {
            $qb
                ->andWhere($qb->expr()->in('cd.Promotion', ':promotion'))
                ->setParameter('promotion', $searchData['promotion']);
        }

        // stock_from 在庫数
        if (isset($searchData['stock_from']) && StringUtil::isNotBlank($searchData['stock_from'])) {
            $qb
                ->andWhere('sh.stock >= :stock_from')
                ->setParameter('stock_from', $searchData['stock_from']);
        }

        // stock_to 在庫数
        if (isset($searchData['stock_to']) && StringUtil::isNotBlank($searchData['stock_to'])) {
            $qb
                ->andWhere('sh.stock <= :stock_to')
                ->setParameter('stock_to', $searchData['stock_to']);
        }

        // stock_change_from 在庫増減数
        if (isset($searchData['stock_change_from']) && StringUtil::isNotBlank($searchData['stock_change_from'])) {
            $qb
                ->andWhere('sh.stockChangeQuantity >= :stock_change_from')
                ->setParameter('stock_change_from', $searchData['stock_change_from']);
        }

        // stock_change_to 在庫増減数
        if (isset($searchData['stock_change_to']) && StringUtil::isNotBlank($searchData['stock_change_to'])) {
            $qb
                ->andWhere('sh.stockChangeQuantity <= :stock_change_to')
                ->setParameter('stock_change_to', $searchData['stock_change_to']);
        }

        // sell_price_from 変更時販売価格
        if (isset($searchData['sell_price_from']) && StringUtil::isNotBlank($searchData['sell_price_from'])) {
            $qb
                ->andWhere('sh.sell_price >= :sell_price_from')
                ->setParameter('sell_price_from', $searchData['sell_price_from']);

