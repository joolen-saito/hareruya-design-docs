   158	            $hasNormal = in_array(MtbPromotion::NON_PROMOTION_ID, $promotionIds, true);
   159	            $hasPromo = in_array(MtbPromotion::PROMOTION_ID, $promotionIds, true);
   160	            if (!($hasNormal && $hasPromo)) {
   161	                if ($hasNormal) {
   162	                    $qb->andWhere('sl_cd_main.Promotion IS NULL');
   163	                } else {
   164	                    $qb->andWhere('sl_cd_main.Promotion IS NOT NULL');
   165	                }
