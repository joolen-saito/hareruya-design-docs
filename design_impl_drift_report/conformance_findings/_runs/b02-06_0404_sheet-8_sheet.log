   232	        }
   233	
   234	        // 棚番号フィルター: pc.ShelfNumber
   235	        if ($input->shelfNumbers !== []) {
   236	            $qb->andWhere($qb->expr()->in('pc.ShelfNumber', ':stockListShelfNumbers'))
   237	                ->setParameter('stockListShelfNumbers', $input->shelfNumbers);
   238	        }
