namespace Eccube\Command;

use Eccube\Service\Product\BatchInitialStockRegistrationAction;
use Symfony\Component\Console\Attribute\AsCommand;
use Symfony\Component\Console\Command\Command;
use Symfony\Component\Console\Input\InputArgument;
use Symfony\Component\Console\Input\InputInterface;
use Symfony\Component\Console\Output\OutputInterface;
use Symfony\Component\Console\Style\SymfonyStyle;

/**
 * 在庫初期化バッチ（B02-06）
 *
 * 店舗登録時、基準店舗の商品規格在庫データを新店舗用に複製する（在庫数0で初期化）。
 *
 * 【使い方】
 *
 *   bin/console eccube:initial-stock-registration {新店舗のbase_info_id}
 */
#[AsCommand(name: 'eccube:initial-stock-registration', description: '在庫初期化バッチ')]
class InitialStockRegistrationCommand extends Command
{
    public function __construct(private readonly BatchInitialStockRegistrationAction $batchInitialStockRegistrationAction)
    {
        parent::__construct();
    }

    #[\Override]
    protected function configure(): void
    {
        $this->addArgument('target_base_info_id', InputArgument::REQUIRED, '新店舗の base_info_id');
    }

    #[\Override]
    protected function execute(InputInterface $input, OutputInterface $output): int
    {
        $io = new SymfonyStyle($input, $output);

        $targetBaseInfoIdRaw = $input->getArgument('target_base_info_id');
        if (!is_string($targetBaseInfoIdRaw) || !ctype_digit($targetBaseInfoIdRaw) || (int) $targetBaseInfoIdRaw <= 0) {
            $io->error('target_base_info_id には 1 以上の整数を指定してください。');

            return Command::FAILURE;
        }

        $targetBaseInfoId = (int) $targetBaseInfoIdRaw;

        try {
            $count = $this->batchInitialStockRegistrationAction->handle($targetBaseInfoId);
        } catch (\Exception $e) {
            $io->error('在庫初期化でエラーが発生しました: '.$e->getMessage());

            return Command::FAILURE;
        }

        $io->success(sprintf('在庫初期化が完了しました。（%d件作成、新店舗ID=%d）', $count, $targetBaseInfoId));

        return Command::SUCCESS;
    }
}

