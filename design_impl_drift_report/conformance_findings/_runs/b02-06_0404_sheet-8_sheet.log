namespace Eccube\Service\Product;

use Eccube\Repository\BaseInfoRepository;
use Eccube\Repository\ProductStockRepository;

class BatchInitialStockRegistrationAction
{
    public function __construct(
        private readonly ProductStockRepository $productStockRepository,
        private readonly BaseInfoRepository $baseInfoRepository,
    ) {
    }

    /**
     * 基準店舗の ProductStock を新店舗用に複製する（在庫数0で初期化）。
     *
     * @param int $targetBaseInfoId 新店舗のBaseInfo ID
     *
     * @return int 作成件数
     */
    public function handle(int $targetBaseInfoId): int
    {
        $TargetBaseInfo = $this->baseInfoRepository->find($targetBaseInfoId);
        if ($TargetBaseInfo === null) {
            throw new \RuntimeException(sprintf('新店舗（base_info_id=%d）が見つかりません。', $targetBaseInfoId));
        }

        $sourceBaseInfoId = \Eccube\Entity\BaseInfo::TC_TOKYO_ID;
        if ($targetBaseInfoId === $sourceBaseInfoId) {
            throw new \RuntimeException(sprintf('新店舗IDと基準店舗IDが同一です（base_info_id=%d）。', $targetBaseInfoId));
        }

        $SourceBaseInfo = $this->baseInfoRepository->find($sourceBaseInfoId);
        if ($SourceBaseInfo === null) {
            throw new \RuntimeException(sprintf('基準店舗（base_info_id=%d）が見つかりません。', $sourceBaseInfoId));
        }

        return $this->productStockRepository->copyStockForNewShop($sourceBaseInfoId, $targetBaseInfoId);
    }
}

