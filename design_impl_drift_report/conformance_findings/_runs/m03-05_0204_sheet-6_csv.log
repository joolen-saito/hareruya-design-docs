    /**
     * セール用価格変更CSVエクスポート
     *
     * @param Request $request
     *
     * @return StreamedResponse|RedirectResponse
     */
    #[Route(path: '/%eccube_admin_route%/product/product_price_csv_export', name: 'admin_product_price_csv_export', methods: ['POST'])]
    public function csvProductPriceExport(Request $request): StreamedResponse|RedirectResponse
    {
        $params = $request->request->all();
        $ids = $params['ids'] ?? [];
        $productIds = \is_array($ids)
            ? array_values(array_filter(array_map('intval', $ids), fn (int $id): bool => $id > 0))
            : [];

        if ($productIds === []) {
            return $this->responseNoProductIdError($request);
        }

        $productPriceCsv = new ProductPriceCsv(
            $this->entityManager,
            $this->translator,
            $this->eccubeConfig,
            $this->productRepository,
            $this->csvExportService,
            $this->baseInfoRepository,
            $this->getProductPriceCsvHeader(),
            $this->getRequiredProductPriceCsvHeader()
        );

        set_time_limit(0);
        $this->entityManager->getConfiguration()->setSQLLogger(null);

        try {
            return $productPriceCsv->exportCsv($productIds);
        } catch (\RuntimeException $e) {
            $this->addError($e->getMessage());
            $referer = $request->headers->get('referer');
            if ($referer !== null && $referer !== '') {
                return $this->redirect($referer);
            }

            return $this->redirectToRoute('admin_product_page');
        }
    }

    /**
     * カスタムCSVエクスポート
     *
     * @param Request $request
     *
     * @return StreamedResponse|RedirectResponse
     */
    #[Route(path: '/%eccube_admin_route%/product/product_all_csv_custom_export/{csvExtensionId}', name: 'admin_product_all_csv_custom_export', methods: ['GET', 'POST'])]
    public function csvCustomExport(Request $request, #[MapEntity(id: 'csvExtensionId')] DtbCsvExtension $CsvExtension): StreamedResponse|RedirectResponse
    {
        $activeCsvExtension = $this->dtbCsvExtensionRepository->findOneBy(['id' => $CsvExtension->getId(), 'deleted_at' => null]);
        if ($activeCsvExtension === null || $activeCsvExtension->getCsvType()?->getId() !== CsvType::CSV_TYPE_PRODUCT) {
            throw new NotFoundHttpException();
        }

        $Csvs = $this->dtbCsvCsvExtensionRepository->findCsvOrderbyRank($activeCsvExtension->getId());
        $columnNames = [];
        foreach ($Csvs as $Csv) {
            $columnName = trim((string) $Csv->getColumnName());
            if ($columnName !== '') {
                $columnNames[] = $columnName;
            }
        }
        if ($columnNames === []) {
            throw new NotFoundHttpException();
        }
        $columns = ['columns' => implode(',', $columnNames)];
        set_time_limit(0);
        $this->entityManager->getConfiguration()->setSQLLogger(null);

        $csvService = new ProductAllCsv($this->entityManager, $this->eccubeConfig);
        $csvService->initByQuery($columns);

        $csvService->setAdminSearchData($this->getAdminProductSearchDataForCsv($request));

        return $csvService->createStreamedResponse();
    }
     * セール用価格変更CSVヘッダー定義
     *
     * @return array<string, string>
     */
    private function getProductPriceCsvHeader(): array
    {
        return [
            '商品ID' => "商品ID\n必須",
            '言語(ID)' => "言語(ID)\n必須",
            '基準価格' => "基準価格\n必須",
            '販売価格' => "販売価格\n必須",
            '買取価格' => "買取価格\n必須",
            '原価単価' => "原価単価\n必須",
            'セールフラグ' => "セールフラグ\n0: セールではない\n1: セールである\n指定していない場合は0",
            '帯URL' => '帯URL',
            'タグ(ID)' => "タグ(ID)\nカンマ区切りで複数指定可能",
        ];
    }

    /**
     * セール用価格変更CSV必須ヘッダー定義
     *
     * @return array<string, string>
     */
    private function getRequiredProductPriceCsvHeader(): array
    {
        return [
            '商品ID' => "商品ID\n必須",
            '言語(ID)' => "言語(ID)\n必須",
            '販売価格' => "販売価格\n必須",
            '買取価格' => "買取価格\n必須",
        ];
    }
}

