namespace Eccube\Service\Csv;

use Doctrine\ORM\EntityManagerInterface;
use Eccube\Common\EccubeConfig;
use Eccube\Entity\BaseInfo;
use Eccube\Entity\Product;
use Eccube\Repository\BaseInfoRepository;
use Eccube\Repository\ProductRepository;
use Eccube\Service\CsvExportService;
use Symfony\Component\HttpFoundation\StreamedResponse;
use Symfony\Contracts\Translation\TranslatorInterface;

class ProductPriceCsv extends AbstractCsvService
{
    public function __construct(
        EntityManagerInterface $entityManager,
        TranslatorInterface $translator,
        EccubeConfig $eccubeConfig,
        private ProductRepository $productRepository,
        private CsvExportService $csvExportService,
        private BaseInfoRepository $baseInfoRepository,
        array $csvHeader = [],
        array $requiredCsvHeader = [],
    ) {
        parent::__construct($entityManager, $translator, $eccubeConfig, $csvHeader, $requiredCsvHeader);
    }

    /**
     * @param array<int, mixed> $productIds
     */
    public function exportCsv(array $productIds): StreamedResponse
    {
        if (empty($productIds) || !$Products = $this->productRepository->findBy(['id' => $productIds])) {
            throw new \RuntimeException($this->translator->trans('admin.csv.error.export.not_registered'));
        }
        $csvRows = $this->convertExportCsvRows($Products, $this->baseInfoRepository->getMallBaseInfo());

        $response = new StreamedResponse();

        $response->setCallback(function () use ($csvRows): void {
            $this->csvExportService->fopen();
            // ヘッダ行出力
            $this->csvExportService->fputcsv(array_keys($this->csvHeader));
            // データ出力
            foreach ($csvRows as $csvRow) {
                $this->csvExportService->fputcsv($csvRow);
            }
            $this->csvExportService->fclose();
        });

        $filename = $this->createFileName('product_price_');
        $this->setCsvResponseHeader($response, $filename);

        log_info('価格変更CSV出力ファイル名', [$filename]);

        return $response;
    }

    /**
     * DtbProductSubをCSV出力できる形にコンバート
     *
     * @param array<int, Product> $Products Productの配列
     * @param BaseInfo|null $mainBaseInfo 本店BaseInfo（原価単価は本店EC在庫の total_cost/stock を四捨五入）。null の場合は内部で解決する
     *
     * @return array<int, array<int, mixed>>
     */
    public function convertExportCsvRows(array $Products, ?BaseInfo $mainBaseInfo = null): array
    {
        $mainBaseInfo ??= $this->baseInfoRepository->getMallBaseInfo();
        $csvRows = [];

        foreach ($Products as $Product) {
            if (count($Product->getProductClasses()) === 0) {
                continue;
            }

            $tags = [];
            foreach ($Product->getProductTag() as $tag) {
                $tags[] = $tag->getTagId();
            }

            $ProductClasses = $Product->getProductClasses();

            foreach ($ProductClasses as $ProductClass) {
                $csvRows[] = [
                    $Product->getId(),
                    $ProductClass->getLanguage()?->getId() ?? '',
                    $ProductClass->getStandardPrice(),
                    $ProductClass->getPrice02(),
                    $ProductClass->getBuyPrice(),
                    $ProductClass->getMainEccubeUnitCost($mainBaseInfo),
                    !$ProductClass->isSaleFlg() ? '0' : $ProductClass->isSaleFlg(),
                    $ProductClass->getBeltUrl(),
                    implode(',', $tags),
                ];
            }
        }

        return $csvRows;
    }
}

