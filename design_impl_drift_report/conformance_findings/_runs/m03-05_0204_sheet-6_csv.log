{% extends '@admin/default_frame.twig' %}

{% set menus = ['product', 'product_master'] %}
{% set DISPLAY_MODE_SALES_MAIN = constant('Eccube\\Common\\ProductListDisplayMode::SALES_MAIN').value %}
{% set DISPLAY_MODE_SALES_BRANCH = constant('Eccube\\Common\\ProductListDisplayMode::SALES_BRANCH').value %}
{% set DISPLAY_MODE_STOCK = constant('Eccube\\Common\\ProductListDisplayMode::STOCK').value %}
{% set defaultStockSummary = {'mainStoreStock': 0, 'branchTotalStock': 0} %}
{% set defaultOrderQuantities = {
    'orderQuantity01': 0,
    'orderQuantity02': 0,
    'orderQuantity03': 0,
    'orderQuantity04': 0,
    'orderQuantity05': 0,
    'orderQuantity06': 0
} %}

{% block title %}{{ 'admin.product.product_list'|trans }}{% endblock %}
{% block sub_title %}{{ 'admin.product.product_management'|trans }}{% endblock %}

{% form_theme searchForm '@admin/Form/bootstrap_4_layout.html.twig' %}

{% block stylesheet %}
    <style>
        .admin-product-search-select2-multiple-col {
            position: relative;
            min-height: 38px;
        }
