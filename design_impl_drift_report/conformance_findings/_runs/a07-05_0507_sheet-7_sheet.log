   105	            ->setCardCondition($CardCondition)
   106	            ->setFoilFlg($foilFlg);
   107	
   108	        if ($orderDetail->purchaseCategory !== null) {
   109	            $BuyMainCard->setPurchaseCategory($orderDetail->purchaseCategory);
   110	        }
   111	
   112	        return $BuyMainCard;
   113	    }
   114	
   115	    /**
   116	     * 条件に一致する既存のBuyMainCardを検索
   117	     *
   118	     * @param DtbBuyMainCard[] $ExistingBuyMainCards
   119	     */
   120	    private function findMatchingCard(
   121	        array $ExistingBuyMainCards,
   122	        int $productId,
   123	        ?int $languageId,
   124	        ?int $conditionId,
   125	        ?int $foilFlg,
   126	        ?int $price,
   127	        ?int $purchaseCategory,
   128	    ): ?DtbBuyMainCard {
   129	        foreach ($ExistingBuyMainCards as $ExistingCard) {
   130	            $existingConditionId = $ExistingCard->getCardCondition()?->getId() ?? MtbCardCondition::NM;
   131	            $existingLanguageId = $ExistingCard->getLanguage()?->getId();
   132	            $existingFoilFlg = $ExistingCard->getFoilFlg() ?? DtbBuyMainCard::FOIL_NONE;
   133	
   134	            $isMatch = $existingLanguageId === $languageId
   135	                && $existingConditionId === ($conditionId ?? MtbCardCondition::NM)
   136	                && $existingFoilFlg === ($foilFlg ?? DtbBuyMainCard::FOIL_NONE)
   137	                && $ExistingCard->getPrice() === $price
   138	                && $ExistingCard->getProduct()->getId() === $productId
   139	                && $ExistingCard->getPurchaseCategory() === $purchaseCategory;
   140	
   141	            if ($isMatch) {
   142	                return $ExistingCard;
   143	            }
   144	        }
   145	
   146	        return null;
   147	    }
   148	
   149	    /**
   150	     * 申込時の買取価格を引き継いだApplicationPriceを構築
   151	     *
   152	     * 状態や単価が変更されても、申込時に提示した買取価格を維持するため。
   153	     *
   154	     * @return DtbApplicationPrice[]
   155	     */
   156	    private function buildInheritedApplicationPrices(
   157	        DtbBuyMainCard $NewBuyMainCard,
   158	        int $buyOrderId,
   159	        int $productId,
   160	        ?int $languageId,
   161	        ?int $foilFlg,
   162	    ): array {
   163	        // 状態違いの同じ商品規格の選んで買取の明細を取得する。取得先から状態ごとの申込時の買取価格を導けるため。
   164	        $OldBuyMainCard = $this->buyMainCardRepository->findOneBy([
   165	            'BuyOrder' => $buyOrderId,
   166	            'Product' => $productId,
   167	            'Language' => $languageId,
   168	            'foilFlg' => $foilFlg,
   169	            'purchaseCategory' => DtbBuyMainCard::SELECT_TYPE,
   170	        ]);
   171	
   172	        if ($OldBuyMainCard === null) {
   173	            return [];
   174	        }
   175	
   176	        $OldApplicationPrices = $this->applicationPriceRepository->findBy(['BuyMainCard' => $OldBuyMainCard->getId()]);
   177	        $newApplicationPrices = [];
   178	
   179	        foreach ($OldApplicationPrices as $OldApplicationPrice) {
   180	            $NewApplicationPrice = new DtbApplicationPrice();
   181	            $NewApplicationPrice
   182	                ->setBuyMainCard($NewBuyMainCard)
   183	                ->setApplicationPrice($OldApplicationPrice->getApplicationPrice())
   184	                ->setCardCondition($OldApplicationPrice->getCardCondition());
   185	
   186	            $newApplicationPrices[] = $NewApplicationPrice;
   187	        }
   188	
   189	        return $newApplicationPrices;
   190	    }
   191	}

