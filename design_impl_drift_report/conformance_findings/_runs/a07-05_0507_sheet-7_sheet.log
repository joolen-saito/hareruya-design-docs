    88	
    89	        // Assert
    90	        $this->assertSame(Response::HTTP_OK, $this->client->getResponse()->getStatusCode());
    91	
    92	        $responseData = json_decode($this->client->getResponse()->getContent(), true);
    93	        $this->assertIsArray($responseData);
    94	        $this->assertCount(4, $responseData);
    95	
    96	        // 取得したステータスIDが対象の4つのみであること
    97	        $responseStatusIds = array_map(fn ($item) => (int) $item['netOrderStatusId'], $responseData);
    98	        $this->assertEqualsCanonicalizing($targetStatuses, $responseStatusIds);
    99	
   100	        // ID昇順でソートされていること
   101	        $createdBuyOrderIds = array_map(fn ($buyOrder) => $buyOrder->getId(), $CreatedBuyOrders);
   102	        sort($createdBuyOrderIds);
   103	        $responseBuyOrderIds = array_map(fn ($item) => (int) $item['netBuyOrderId'], $responseData);
   104	        $this->assertSame($createdBuyOrderIds, $responseBuyOrderIds);
