    16	namespace Eccube\Service\App\MTGBuyer\V1\Admin\BuyOrder;
    17	
    18	use Doctrine\ORM\EntityManagerInterface;
    19	use Eccube\Dto\App\MTGBuyer\V1\Admin\UpdateBuyOrderDetailDto;
    20	use Eccube\Entity\DtbBuyMainCard;
    21	use Eccube\Entity\DtbBuyOrder;
    22	use Eccube\Entity\DtbBuyOrderIndivisualInputProduct;
    23	use Eccube\Exception\App\InternalException;
    24	use Eccube\Exception\App\InvalidParameterException;
    25	use Eccube\Repository\DtbBuyMainCardRepository;
    26	use Eccube\Repository\DtbBuyOrderIndivisualInputProductRepository;
    27	use Eccube\Service\App\MTGBuyer\V1\Admin\BuyOrder\ActionInput\UpdateBuyOrderInput;
    28	use Eccube\Service\EntityManager\BuyOrderStatusHistoryEntityManager;
    29	use Eccube\Service\Purchase\BulkPurchaseIdService;
    30	use Psr\Log\LoggerInterface;
    31	
    32	class UpdateBuyOrderAction
    33	{
    34	    private const PRICE_ROUNDING_UNIT = 10;
    35	
    36	    public function __construct(
    37	        private readonly EntityManagerInterface $entityManager,
    38	        private readonly LoggerInterface $logger,
    39	        private readonly DtbBuyMainCardRepository $buyMainCardRepository,
    40	        private readonly DtbBuyOrderIndivisualInputProductRepository $buyOrderIndivisualInputProductRepository,
    41	        private readonly BulkPurchaseIdService $bulkPurchaseIdService,
    42	        private readonly BuildBuyMainCard $buildBuyMainCard,
    43	        private readonly BuyOrderStatusHistoryEntityManager $buyOrderStatusHistoryEntityManager,
    44	    ) {
    45	    }
    46	
    47	    /**
    48	     * 査定終了処理
    49	     *
    50	     * ネット買取の場合はユーザーの買取申込時にカード情報をDBに登録済みのため店頭買取とロジックが異なる。
    51	     * ①査定データと登録済みデータを比較して同じものは上書きする
    52	     * ②言語や状態が異なるなどの場合は新規レコードとする
    53	     * ③査定データに含まれなかったDB登録済みレコードを削除する
    54	     */
    55	    public function handle(UpdateBuyOrderInput $input): void
    56	    {
    57	        $this->entityManager->beginTransaction();
    58	
    59	        try {
    60	            $oldStatusId = $input->BuyOrder->getBuyOrderStatus()->getId();
    61	            $bulkPurchaseId = $this->bulkPurchaseIdService->get();
    62	
    63	            // 既存データを取得
    64	            /** @var DtbBuyMainCard[] $ExistingBuyMainCards */
    65	            $ExistingBuyMainCards = $this->buyMainCardRepository->findBy(['BuyOrder' => $input->BuyOrder->getId()]);
    66	            $ExistingIndivisualMap = $this->buildExistingIndivisualMap($input->BuyOrder);
    67	
    68	            // orderDetailsから保存用のEntityを構築し、洗い替えで保持するIDと小計を取得
    69	            $buildResult = $this->buildOrderDetailEntities(
    70	                $input->BuyOrder,
    71	                $input->orderDetails,
    72	                $ExistingBuyMainCards,
    73	                $ExistingIndivisualMap
    74	            );
    75	
    76	            // 構築したEntityを永続化
    77	            foreach ($buildResult['entities'] as $Entity) {
    78	                $this->entityManager->persist($Entity);
    79	            }
    80	
    81	            // サプライ/パックは既存レコードを保持し、小計を加算
    82	            [$supplyPackTotal, $keepCardIds] = $this->preserveSupplyPackCards(
    83	                $ExistingBuyMainCards,
    84	                $bulkPurchaseId,
    85	                $buildResult['keepCardIds']
    86	            );
    87	
    88	            // 不要レコードを削除
    89	            foreach ($ExistingBuyMainCards as $Card) {
    90	                if (!in_array($Card->getId(), $keepCardIds, true)) {
    91	                    $this->entityManager->remove($Card);
    92	                }
    93	            }
    94	            foreach ($ExistingIndivisualMap as $IndivisualProduct) {
    95	                if (!in_array($IndivisualProduct->getId(), $buildResult['keepIndivisualIds'], true)) {
    96	                    $this->entityManager->remove($IndivisualProduct);
    97	                }
    98	            }
    99	
   100	            // BuyOrder更新
   101	            $now = new \DateTime();
   102	            $totalPrice = $this->roundUpPrice($buildResult['totalPrice'] + $supplyPackTotal);
   103	            $input->BuyOrder
   104	                ->setBuyOrderStatus($input->NewBuyOrderStatus)
   105	                ->setTotalPrice($totalPrice)
   106	                ->setMember($input->Member)
   107	                ->setUpdateDate($now);
   108	            $this->entityManager->persist($input->BuyOrder);
   109	
   110	            // ステータスが変更された場合、履歴を登録
   111	            if ($oldStatusId !== $input->NewBuyOrderStatus->getId()) {
   112	                $this->buyOrderStatusHistoryEntityManager->save(
   113	                    $input->BuyOrder,
   114	                    $input->NewBuyOrderStatus,
   115	                    $input->Member,
   116	                    $now
   117	                );
   118	            }
   119	
   120	            $this->entityManager->flush();
   121	            $this->entityManager->commit();
   122	        } catch (InvalidParameterException $e) {
   123	            $this->entityManager->rollback();
   124	            $this->logger->warning('Invalid parameter in buy order update', [
   125	                'exception' => $e,
   126	                'buyOrderId' => $input->BuyOrder->getId(),
   127	                'memberId' => $input->Member->getId(),
   128	            ]);
   129	            throw $e;
   130	        } catch (\Throwable $e) {
   131	            $this->entityManager->rollback();
   132	            $this->logger->error('Failed to update buy order assessment', [
   133	                'exception' => $e,
   134	                'buyOrderId' => $input->BuyOrder->getId(),
   135	                'memberId' => $input->Member->getId(),
   136	            ]);
   137	            throw new InternalException('システムエラーが発生しました', $e);
   138	        }
   139	    }
   140	
   141	    /**
   142	     * 既存の個別入力商品を商品名をキーにしたマップで返す
   143	     *
   144	     * @return array<string, DtbBuyOrderIndivisualInputProduct>
   145	     */
   146	    private function buildExistingIndivisualMap(DtbBuyOrder $BuyOrder): array
   147	    {
   148	        $ExistingIndivisualMap = [];
   149	        $Products = $this->buyOrderIndivisualInputProductRepository->findBy(['BuyOrder' => $BuyOrder->getId()]);
   150	
   151	        foreach ($Products as $Product) {
   152	            $ExistingIndivisualMap[$Product->getName()] = $Product;
   153	        }
   154	
   155	        return $ExistingIndivisualMap;
   156	    }
   157	
   158	    /**
   159	     * orderDetailsからEntityを構築
   160	     *
   161	     * @param UpdateBuyOrderDetailDto[] $orderDetails
   162	     * @param DtbBuyMainCard[] $ExistingBuyMainCards
   163	     * @param array<string, DtbBuyOrderIndivisualInputProduct> $ExistingIndivisualMap
   164	     *
   165	     * @return array{entities: object[], totalPrice: int, keepCardIds: int[], keepIndivisualIds: int[]}
   166	     */
   167	    private function buildOrderDetailEntities(
   168	        DtbBuyOrder $BuyOrder,
   169	        array $orderDetails,
   170	        array $ExistingBuyMainCards,
   171	        array $ExistingIndivisualMap,
   172	    ): array {
   173	        $EntitiesToPersist = [];
   174	        $totalPrice = 0;
   175	        $keepCardIds = [];
   176	        $keepIndivisualIds = [];
   177	
   178	        foreach ($orderDetails as $orderDetail) {
   179	            $price = $orderDetail->price ?? 0;
   180	            $quantity = $orderDetail->quantity ?? 0;
   181	            $totalPrice += $price * $quantity;
   182	
   183	            // productClassIdがnullまたは0のものは個別入力商品として扱う
   184	            $isIndivisualInputProduct = $orderDetail->productClassId === null || $orderDetail->productClassId === 0;
   185	
   186	            if ($isIndivisualInputProduct) {
   187	                $IndivisualProduct = $this->buildIndivisualInputProduct($BuyOrder, $orderDetail, $ExistingIndivisualMap);
   188	                $EntitiesToPersist[] = $IndivisualProduct;
   189	
   190	                if (isset($ExistingIndivisualMap[$orderDetail->name])) {
   191	                    $keepIndivisualIds[] = $IndivisualProduct->getId();
   192	                }
   193	            } else {
   194	                $BuyMainCard = $this->buildBuyMainCard->build($BuyOrder, $orderDetail, $ExistingBuyMainCards);
   195	                $EntitiesToPersist[] = $BuyMainCard;
   196	
   197	                if (in_array($BuyMainCard, $ExistingBuyMainCards, true)) {
   198	                    $keepCardIds[] = $BuyMainCard->getId();
   199	                }
   200	            }
   201	        }
   202	
   203	        return [
   204	            'entities' => $EntitiesToPersist,
   205	            'totalPrice' => $totalPrice,
   206	            'keepCardIds' => $keepCardIds,
   207	            'keepIndivisualIds' => $keepIndivisualIds,
   208	        ];
   209	    }
   210	
   211	    /**
   212	     * 個別入力商品Entityを構築
   213	     *
   214	     * @param array<string, DtbBuyOrderIndivisualInputProduct> $ExistingIndivisualMap
   215	     */
   216	    private function buildIndivisualInputProduct(
   217	        DtbBuyOrder $BuyOrder,
   218	        UpdateBuyOrderDetailDto $orderDetail,
   219	        array $ExistingIndivisualMap,
   220	    ): DtbBuyOrderIndivisualInputProduct {
   221	        $IndivisualProduct = $ExistingIndivisualMap[$orderDetail->name] ?? new DtbBuyOrderIndivisualInputProduct();
   222	        $IndivisualProduct
   223	            ->setName($orderDetail->name)
   224	            ->setQuantity($orderDetail->quantity)
   225	            ->setPrice($orderDetail->price)
   226	            ->setBuyOrder($BuyOrder);
   227	
   228	        return $IndivisualProduct;
   229	    }
   230	
   231	    /**
   232	     * サプライ/パック（CardDetail未設定）を保持し、金額を加算
   233	     *
   234	     * @param DtbBuyMainCard[] $ExistingBuyMainCards
   235	     * @param int[] $keepCardIds
   236	     *
   237	     * @return array{int, int[]} [サプライ/パック合計, 更新後の保持ID配列]
   238	     */
   239	    private function preserveSupplyPackCards(
   240	        array $ExistingBuyMainCards,
   241	        int $bulkPurchaseId,
   242	        array $keepCardIds,
   243	    ): array {
   244	        $supplyPackTotal = 0;
   245	
   246	        foreach ($ExistingBuyMainCards as $Card) {
   247	            $Product = $Card->getProduct();
   248	
   249	            // まとめて買取商品は削除対象（保持しない）
   250	            if ($Product->getId() === $bulkPurchaseId) {
   251	                continue;
   252	            }
   253	
   254	            // CardDetail未設定 = サプライ/パック → 保持
   255	            if ($Product->getCardDetail() === null) {
   256	                $supplyPackTotal += ($Card->getPrice() ?? 0) * ($Card->getCount() ?? 0);
   257	                $keepCardIds[] = $Card->getId();
   258	            }
   259	        }
   260	
   261	        return [$supplyPackTotal, $keepCardIds];
   262	    }
   263	
   264	    /**
   265	     * 金額を10円未満は切り上げ
   266	     *
   267	     * @param int $price
   268	     *
   269	     * @return int
   270	     */
   271	    private function roundUpPrice(int $price): int
   272	    {
   273	        return (int) ceil($price / self::PRICE_ROUNDING_UNIT) * self::PRICE_ROUNDING_UNIT;
   274	    }
   275	}

