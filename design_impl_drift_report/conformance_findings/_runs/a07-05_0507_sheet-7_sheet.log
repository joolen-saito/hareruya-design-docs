    59	    #[Route('/%eccube_api_v1_route%/admin/buyOrders.json', name: 'api_admin_buy_orders_product_arrival', methods: ['GET'])]
    60	    public function getProductArrivalBuyOrders(): JsonResponse
    61	    {
