    31	     * 管理画面へのアクセスかどうか.
    32	     */
    33	    public function isAdmin(): bool
    34	    {
    35	        $request = $this->requestStack->getMainRequest();
    36	
    37	        if (null === $request) {
    38	            return false;
    39	        }
    40	
    41	        $pathInfo = \rawurldecode($request->getPathInfo());
    42	        $adminPath = $this->eccubeConfig->get('eccube_admin_route');
    43	        $adminPath = '/'.\trim((string) $adminPath, '/').'/';
    44	
    45	        // ジョブ管理画面も管理画面へのアクセスと同じ認証を適用する
    46	        $messengerRoute = $this->eccubeConfig->get('eccube_messenger_route');
    47	        $messengerRoute = '/'.\trim((string) $messengerRoute, '/').'/';
    48	        if (str_starts_with($pathInfo, $messengerRoute)) {
    49	            return true;
    50	        }
    51	
    52	        return str_starts_with($pathInfo, $adminPath);
    53	    }
