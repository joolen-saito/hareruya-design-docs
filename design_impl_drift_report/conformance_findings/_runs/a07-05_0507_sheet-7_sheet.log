    22	/**
    23	 * @extends AbstractRepository<DtbBuyMainCard>
    24	 */
    25	class DtbBuyMainCardRepository extends AbstractRepository
    26	{
    27	    public function __construct(ManagerRegistry $registry)
    28	    {
    29	        parent::__construct($registry, DtbBuyMainCard::class);
    30	    }
    31	
    32	    /**
    33	     * 買取情報取得
    34	     *
    35	     * @return DtbBuyMainCard[]
    36	     */
    37	    public function getBuyMainCardsSortedByProductId(int $buyOrderId, ?int $purchaseCategory = null): mixed
    38	    {
    39	        $qb = $this->createQueryBuilder('bmc')
    40	            ->select('bmc, MIN(minBmc.id) AS HIDDEN minBuyMainCardId')
    41	            ->addSelect('(CASE WHEN bmc.CardCondition IS NULL THEN 1 ELSE 0 END) AS HIDDEN card_condition_is_null')
    42	            ->innerJoin('bmc.Product', 'p')
    43	            ->innerJoin(DtbBuyMainCard::class, 'minBmc', Join::WITH, 'minBmc.Product = p AND IDENTITY(minBmc.BuyOrder) = :buyOrderId')
    44	            ->where('IDENTITY(bmc.BuyOrder) = :buyOrderId')
    45	            ->setParameter('buyOrderId', $buyOrderId)
    46	            ->groupBy('bmc.id')
    47	            ->orderBy('minBuyMainCardId', 'ASC')
    48	            ->addOrderBy('IDENTITY(bmc.Language)', 'ASC')
    49	            ->addOrderBy('card_condition_is_null', 'ASC')
    50	            ->addOrderBy('IDENTITY(bmc.CardCondition)', 'ASC')
    51	            ->addOrderBy('bmc.id', 'ASC');
    52	
    53	        if ($purchaseCategory) {
    54	            $qb->andWhere('bmc.purchaseCategory = :purchaseCategory')
    55	                ->setParameter('purchaseCategory', $purchaseCategory);
    56	        }
    57	
    58	        return $qb->getQuery()->getResult();
    59	    }
    60	
    61	    /**
    62	     * 買取カテゴリで買取情報を取得する
    63	     * 取得に際してキャンセル商品を先頭にソートする
    64	     *
    65	     * @return DtbBuyMainCard[]
    66	     */
    67	    public function getBuyMainCardsByPurchaseCategory(int $buyOrderId, int $purchaseCategory): array
    68	    {
    69	        return $this->createQueryBuilder('bmc')
    70	            ->select([
    71	                'bmc',
    72	                'p',
    73	                'MIN(minBmc.id) AS HIDDEN minBuyMainCardId',
    74	                '(CASE WHEN bmc.CardCondition IS NULL THEN 1 ELSE 0 END) AS HIDDEN card_condition_is_null',
    75	                '(CASE WHEN bmc.saleFlg = :cancel THEN 1 ELSE 0 END) AS HIDDEN is_canceled',
    76	            ])
    77	            ->join('bmc.Product', 'p')
    78	            ->join(DtbBuyMainCard::class, 'minBmc', 'WITH', 'minBmc.Product = p AND IDENTITY(minBmc.BuyOrder) = :buyOrderId')
    79	            ->where('IDENTITY(bmc.BuyOrder) = :buyOrderId')
    80	            ->andWhere('bmc.purchaseCategory = :purchaseCategory')
    81	            ->setParameter('buyOrderId', $buyOrderId)
    82	            ->setParameter('purchaseCategory', $purchaseCategory)
    83	            ->setParameter('cancel', DtbBuyMainCard::NOT_SALE)
    84	            ->groupBy('bmc.id, p.id')
    85	            ->orderBy('is_canceled', 'DESC')
    86	            ->addOrderBy('minBuyMainCardId', 'ASC')
    87	            ->addOrderBy('IDENTITY(bmc.Language)', 'ASC')
    88	            ->addOrderBy('card_condition_is_null', 'ASC')
    89	            ->addOrderBy('IDENTITY(bmc.CardCondition)', 'ASC')
    90	            ->addOrderBy('bmc.id', 'ASC')
    91	            ->getQuery()
    92	            ->getResult();
    93	    }
    94	
    95	    /**
    96	     * まとめて買取の合計金額を取得する
    97	     */
    98	    public function getBulkPurchaseTotalPrice(int $buyOrderId): int
    99	    {
   100	        $result = $this->createQueryBuilder('bmc')
   101	            ->join('bmc.BuyOrder', 'bo')
   102	            ->select('SUM(bmc.price * bmc.count)')
   103	            ->where('IDENTITY(bmc.BuyOrder) = :buyOrderId')
   104	            ->andWhere('bmc.purchaseCategory = :purchaseCategory')
   105	            ->setParameter('buyOrderId', $buyOrderId)
   106	            ->setParameter('purchaseCategory', DtbBuyMainCard::BULK_TYPE)
   107	            ->groupBy('bo.id')
   108	            ->getQuery()
   109	            ->getOneOrNullResult();
   110	
   111	        return $result[1] ?? 0;
   112	    }
   113	
   114	    /**
   115	     * まとめて買取の承諾済み合計金額を取得する
   116	     */
   117	    public function getBulkPurchaseAcceptanceTotalPrice(int $buyOrderId): int
   118	    {
   119	        $result = $this->createQueryBuilder('bmc')
   120	            ->join('bmc.BuyOrder', 'bo')
   121	            ->select('SUM(bmc.price * bmc.count)')
   122	            ->where('IDENTITY(bmc.BuyOrder) = :buyOrderId')
   123	            ->andWhere('bmc.purchaseCategory = :purchaseCategory')
   124	            ->andWhere('bmc.saleFlg = :saleFlg')
   125	            ->setParameter('buyOrderId', $buyOrderId)
   126	            ->setParameter('purchaseCategory', DtbBuyMainCard::BULK_TYPE)
   127	            ->setParameter('saleFlg', DtbBuyMainCard::SALE)
   128	            ->groupBy('bo.id')
   129	            ->getQuery()
   130	            ->getOneOrNullResult();
   131	
   132	        return !is_null($result) ? $result[1] : 0;
   133	    }
   134	
   135	    /**
   136	     * ネット買取IDの配列から買取代表カード情報を取得する
   137	     *
   138	     * @param int[] $buyOrderIds
   139	     *
   140	     * @return DtbBuyMainCard[]
   141	     */
   142	    public function findByBuyOrderIdsWithApplicationPrices(array $buyOrderIds): array
   143	    {
   144	        return $this->createQueryBuilder('buyMainCard')
   145	            ->leftJoin('buyMainCard.ApplicationPrices', 'applicationPrice')
   146	            ->addSelect('applicationPrice')
   147	            ->leftJoin('applicationPrice.CardCondition', 'cardCondition')
   148	            ->addSelect('cardCondition')
   149	            ->where('IDENTITY(buyMainCard.BuyOrder) IN (:buyOrderIds)')
   150	            ->setParameter('buyOrderIds', $buyOrderIds)
   151	            ->getQuery()
   152	            ->getResult()
   153	        ;
   154	    }
   155	}

