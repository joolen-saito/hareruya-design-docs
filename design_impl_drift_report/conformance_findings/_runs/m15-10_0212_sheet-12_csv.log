   193	        $map = [];
   194	        foreach ($rows as $row) {
   195	            $cardId = (int) $row['cardId'];
   196	            if (!isset($map[$cardId])) {
   197	                $map[$cardId] = $row['url'];
   198	            }
   199	        }
   200	
   201	        return $map;
   202	    }
