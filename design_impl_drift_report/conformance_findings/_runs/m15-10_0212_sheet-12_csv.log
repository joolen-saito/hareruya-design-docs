   141	            'nameJp' => $nameJp,
   142	            'nameEn' => $nameEn,
   143	            'Format' => $Format,
   144	            'deletedAt' => null,
   145	        ]);
   146	
   147	        $isNew = $Archetype === null;
   148	        if ($isNew) {
   149	            $Archetype = new DtbArchetype();
   150	            $this->em->persist($Archetype);
   151	        }
   152	
   153	        $Archetype->setNameJp($nameJp);
   154	        $Archetype->setNameEn($nameEn);
   155	        $Archetype->setFormat($Format);
   156	
   157	        $DefaultDisp = $this->em->getRepository(MtbDisp::class)->find(MtbDisp::DISPLAY_SHOW);
   158	        if ($DefaultDisp === null) {
   159	            throw new \RuntimeException('MtbDisp::DISPLAY_SHOW not found in master data.');
   160	        }
   161	        $Archetype->setDisp($DefaultDisp);
   162	
   163	        if ($isNew) {
   164	            $Archetype->setCommentJp('');
