    55	    protected function sendTemplateResponse(Request $request, array $columns, string $filename): StreamedResponse
    56	    {
    57	        set_time_limit(0);
    58	
    59	        $response = new StreamedResponse();
    60	        $response->setCallback(function () use ($columns): void {
    61	            // ヘッダ行の出力
