   175	        }
   176	
   177	        if ($colorValue !== '') {
   178	            $Colors = new ArrayCollection();
   179	            foreach ($this->parseColorNames($colorValue) as $colorName) {
   180	                $Color = $this->em->getRepository(MtbColor::class)->find($this->colorNameToId[$colorName]);
