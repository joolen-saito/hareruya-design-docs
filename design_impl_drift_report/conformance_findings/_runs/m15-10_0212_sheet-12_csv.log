   171	     * @param list<int>      $cardIds
   172	     *
   173	     * @return array<int, string>
   174	     */
   175	    public function findUrlMapByCardIds(array $cardIds): array
   176	    {
   177	        if ($cardIds === []) {
   178	            return [];
   179	        }
   180	
   181	        /** @var list<array{cardId: int, url: string, id: int}> $rows */
   182	        $rows = $this->createQueryBuilder('ci')
   183	            ->select('IDENTITY(cd.Card) as cardId', 'ci.url', 'ci.id')
   184	            ->join('ci.CardDetail', 'cd')
   185	            ->where('IDENTITY(cd.Card) IN (:cardIds)')
   186	            ->andWhere('ci.dead_link_flg = false')
   187	            ->andWhere('ci.back_flg = false')
   188	            ->orderBy('ci.id', 'ASC')
   189	            ->setParameter('cardIds', $cardIds)
   190	            ->getQuery()
   191	            ->getArrayResult();
