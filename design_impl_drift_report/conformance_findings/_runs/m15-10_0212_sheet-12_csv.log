    84	    public function getLabel(): string
    85	    {
    86	        return $this->label;
    87	    }
    88	
    89	    /**
    90	     * @param string $label 列の表示名
    91	     *
    92	     * @return self
    93	     */
    94	    public function setLabel(string $label): self
    95	    {
    96	        $this->label = $label;
    97	
    98	        return $this;
    99	    }
   100	
   101	    /**
   102	     * @param bool $required 必須の場合 true
   103	     *
   104	     * @return self
   105	     */
   106	    public function setRequired(bool $required): self
   107	    {
   108	        $this->required = $required;
   109	
   110	        return $this;
   111	    }
   112	
   113	    /**
   114	     * @param bool $multiple 複数の値を指定可能な場合 true
   115	     *
   116	     * @return self
   117	     */
   118	    public function setMultiple(bool $multiple): self
   119	    {
   120	        $this->multiple = $multiple;
   121	
   122	        return $this;
   123	    }
   124	
   125	    /**
   126	     * @param ConverterInterface $converter 値の変換を行うもの
   127	     *
   128	     * @return self
   129	     */
   130	    public function setConverter(ConverterInterface $converter): self
   131	    {
   132	        $this->converter = $converter;
   133	
   134	        return $this;
   135	    }
   136	
   137	    /**
   138	     * 値を検証する。
   139	     *
   140	     * @param MessageStore $errors メッセージの格納先
   141	     * @param CsvRowInterface $row 値の取得先
   142	     *
   143	     * @return bool 値が正しい場合 true
   144	     */
   145	    public function validate(MessageStore $errors, CsvRowInterface $row): bool
   146	    {
   147	        $value = $this->find($row);
   148	        $firstValidator = $this->required ? new RequiredValidator() : NoActionValidator::getInstance();
   149	
   150	        return $firstValidator
   151	            ->thenValidate($this->validator)
   152	            ->validate($errors, $value);
   153	    }
   154	
   155	    /**
   156	     * 入力チェックを追加する。
   157	     *
   158	     * @param mixed $validator 追加するバリデータ
   159	     *
   160	     * @return self
   161	     */
   162	    public function addValidator(mixed $validator): self
   163	    {
   164	        $validators = is_array($validator) ? $validator : func_get_args();
   165	        $this->validator = $this->validator->thenValidate($validators);
   166	
   167	        return $this;
   168	    }
   169	
   170	    /**
   171	     * 行から変換後の値を取得する。
   172	     *
   173	     * @param CsvRowInterface $row
   174	     *
   175	     * @return mixed
   176	     */
   177	    public function getValue(CsvRowInterface $row): mixed
   178	    {
   179	        return $this->find($row)->getValue();
   180	    }
   181	
   182	    /**
   183	     * 行から値を取得する。
   184	     *
   185	     * @param CsvRowInterface $row 行
   186	     *
   187	     * @return CsvValueInterface 値
   188	     */
   189	    public function find(CsvRowInterface $row): CsvValueInterface
   190	    {
   191	        $originalValue = $row->getValue($this->name);
   192	        $rowNumber = $row->getRowNumber();
   193	        $name = $this->name;
   194	        $label = sprintf('%s(%s)', $this->label, $this->name);
   195	
   196	        $value = null;
   197	        if ($this->multiple) {
   198	            $value = new CsvArrayValue(
   199	                $originalValue,
   200	                $rowNumber,
   201	                $name,
   202	                $label,
   203	                ','
   204	            );
   205	        } else {
   206	            $value = new CsvValue(
   207	                $row->getValue($this->name),
   208	                $row->getRowNumber(),
   209	                $name,
   210	                $label
   211	            );
   212	        }
   213	
   214	        $value->setConverter($this->converter);
   215	
   216	        return $value;
   217	    }
   218	}

