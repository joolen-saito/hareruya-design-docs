   117	        }
   118	        foreach ($this->parseColorNames($colorValue) as $colorName) {
   119	            if (!isset($this->colorNameToId[$colorName])) {
   120	                $messageStore->addMasterNotExistsError($rowNumber, $this->colorsColumn->getLabel(), $colorName);
   121	                $event->breakAll();
