    22	use Eccube\Entity\Master\MtbDisp;
    23	use Eccube\Entity\Master\MtbFormat;
    24	use Eccube\Entity\Member;
    25	
    26	class ArchetypeEntityManager
    27	{
    28	    public function __construct(private readonly EntityManagerInterface $entityManager)
    29	    {
    30	    }
    31	
    32	    /**
    33	     * アーキタイプを永続化する。
    34	     * 既存アーキタイプを渡せば更新、null を渡せば新規作成として扱う。
    35	     *
    36	     * @param Collection<int, \Eccube\Entity\Master\MtbColor>|null $Colors
    37	     * @param Collection<int, \Eccube\Entity\Master\MtbDeckTag>|null $DeckTags
    38	     */
    39	    public function save(
    40	        ?DtbArchetype $Archetype,
    41	        MtbDisp $Disp,
    42	        MtbFormat $Format,
    43	        ?MtbCardImage $CardImage,
    44	        string $nameJp,
    45	        string $nameEn,
    46	        string $commentJp,
    47	        string $commentEn,
    48	        ?Collection $Colors,
    49	        ?Collection $DeckTags,
    50	        ?Member $Member,
    51	    ): DtbArchetype {
    52	        $now = new \DateTime();
    53	        if ($Archetype === null) {
    54	            $Archetype = new DtbArchetype();
    55	            $Archetype->setCreateDate($now);
    56	        }
    57	        $Archetype->setUpdateDate($now);
    58	
    59	        $Archetype->setNameJp($nameJp);
    60	        $Archetype->setNameEn($nameEn);
    61	        $Archetype->setCommentJp($commentJp);
    62	        $Archetype->setCommentEn($commentEn);
    63	        $Archetype->setDisp($Disp);
    64	        $Archetype->setFormat($Format);
    65	        $Archetype->setCardImage($CardImage);
    66	
    67	        if ($Colors !== null) {
    68	            $Archetype->setColors($Colors);
    69	        }
    70	        if ($DeckTags !== null) {
    71	            $Archetype->setDeckTags($DeckTags);
    72	        }
    73	
    74	        $this->entityManager->persist($Archetype);
    75	
    76	        return $Archetype;
    77	    }
    78	
    79	    /**
    80	     * アーキタイプを削除する。
    81	     */
    82	    public function delete(?DtbArchetype $Archetype): void
    83	    {
    84	        if ($Archetype === null) {
    85	            return;
    86	        }
    87	
    88	        $this->entityManager->remove($Archetype);
    89	    }
    90	}

