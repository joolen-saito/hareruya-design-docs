    68	            fputcsv($fp, $row, $this->eccubeConfig['eccube_csv_export_separator'], '"', '\\');
    69	            fclose($fp);
    70	        });
    71	
    72	        $response->headers->set('Content-Type', 'application/octet-stream');
    73	        $response->headers->set('Content-Disposition', 'attachment; filename='.$filename);
