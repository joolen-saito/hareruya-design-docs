    44	
    45	    /**
    46	     * BaseCsvColumn constructor.
    47	     *
    48	     * @param string $name 列の名前
    49	     * @param string $label 列の表示名
    50	     */
    51	    public function __construct(string $name, string $label)
    52	    {
    53	        $this->name = $name;
    54	        $this->label = $label;
    55	        $this->validator = NoActionValidator::getInstance();
    56	        $this->converter = NoActionConverter::getInstance();
    57	        $this->required = false;
    58	        $this->multiple = false;
    59	    }
    60	
    61	    /**
    62	     * @return string 列の名前
    63	     */
    64	    public function getName(): string
