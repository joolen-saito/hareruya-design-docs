   105	
   106	        $formatName = trim((string) $this->formatColumn->getValue($row));
   107	        if (!isset($this->formatNameToId[$formatName])) {
   108	            $messageStore->addMasterNotExistsError($rowNumber, $this->formatColumn->getLabel(), $formatName);
