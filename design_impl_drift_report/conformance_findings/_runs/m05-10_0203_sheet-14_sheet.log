   406	        $response = new StreamedResponse();
   407	        $response->setCallback(function () use ($request, $csvTypeId): void {
   408	            // CSV種別を元に初期化.
   409	            $this->csvExportService->initCsvType($csvTypeId);
   410	
   411	            // 受注データ検索用のクエリビルダを取得.
