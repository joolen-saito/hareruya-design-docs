   187	     */
   188	    private function extractSearchCriteria(FormInterface $form): ?array
   189	    {
   190	        $dateFrom = $form->get('summary_date_from')->getData();
   191	        $dateTo = $form->get('summary_date_to')->getData();
   192	        if (!$dateFrom instanceof \DateTimeInterface || !$dateTo instanceof \DateTimeInterface) {
   193	            return null;
   194	        }
   195	
   196	        $storeSalesTargets = $form->get('store_sales_targets')->getData();
   197	        $targets = [];
   198	        if (is_iterable($storeSalesTargets)) {
   199	            foreach ($storeSalesTargets as $storeSalesTarget) {
   200	                $targets[] = (int) $storeSalesTarget;
   201	            }
   202	        }
   203	
   204	        return [
   205	            'summary_type' => $this->normalizeSummaryType($form->get('summary_type')->getData()),
   206	            'date_from' => $dateFrom,
   207	            'date_to' => $dateTo,
   208	            'mail_order_enabled' => (bool) ($form->get('mail_order_enabled')->getData() ?? false),
   209	            'store_sales_targets' => $targets,
   210	        ];
