   242	     *
   243	     * @return array<string, mixed>
   244	     */
   245	    private function buildSummaryResponse(
   246	        string $summaryType,
   247	        FormInterface $form,
   248	        array $summary = [],
   249	        array $total = [],
   250	        array $columns = [],
   251	    ): array {
   252	        $isMonthly = $summaryType === 'monthly';
   253	
   254	        return [
   255	            'searchForm' => $form->createView(),
   256	            'summary' => $summary,
   257	            'total' => $total,
   258	            'columns' => $columns,
   259	            'summaryType' => $summaryType,
   260	            'summaryMenuKey' => $isMonthly ? 'analysis_summary_monthly' : 'analysis_summary_daily',
   261	            'dateInputType' => $isMonthly ? 'month' : 'date',
   262	            'isMonthlySummary' => $isMonthly,
   263	        ];
   264	    }
   265	
   266	    /**
   267	     * 集計期間の初期値を返す。
   268	     * 月次: 2ヶ月前 ～ 当月、日次: 当月1日 ～ 当月末日。
   269	     *
   270	     * @return array{0: \DateTime, 1: \DateTime}
   271	     */
   272	    private function resolveInitialSummaryDateRange(string $summaryType): array
   273	    {
   274	        if ($summaryType === 'monthly') {
   275	            $currentMonth = new \DateTime('first day of this month');
   276	            $twoMonthsAgo = (clone $currentMonth)->modify('-2 months');
   277	
   278	            return [$twoMonthsAgo, $currentMonth];
   279	        }
