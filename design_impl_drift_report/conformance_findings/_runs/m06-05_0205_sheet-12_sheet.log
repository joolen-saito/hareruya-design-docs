    16	namespace Eccube\Controller\Admin\OtcBuyOrder;
    17	
    18	use Doctrine\ORM\QueryBuilder;
    19	use Eccube\Controller\AbstractController;
    20	use Eccube\Controller\Admin\SearchControllerTrait;
    21	use Eccube\Dto\Admin\OtcBuyOrder\HistorySearchDataDto;
    22	use Eccube\Form\Type\Admin\OtcBuyOrder\OtcBuyOrderHistoryType;
    23	use Eccube\Repository\DtbOtcBuyOrderStockHistoryRepository;
    24	use Eccube\Repository\Master\PageMaxRepository;
    25	use Eccube\Service\Csv\Exporter\OtcBuyOrderHistoryCsvExportService;
    26	use Eccube\Util\FormUtil;
    27	use Knp\Component\Pager\PaginatorInterface;
    28	use Symfony\Bridge\Twig\Attribute\Template;
    29	use Symfony\Component\HttpFoundation\RedirectResponse;
    30	use Symfony\Component\HttpFoundation\Request;
    31	use Symfony\Component\HttpFoundation\Response;
    32	use Symfony\Component\HttpFoundation\StreamedResponse;
    33	use Symfony\Component\Routing\Attribute\Route;
    34	use Symfony\Component\Security\Csrf\CsrfTokenManagerInterface;
    35	
    36	/**
    37	 * 店頭買取管理
    38	 */
    39	class OtcBuyOrderHistoryController extends AbstractController
    40	{
    41	    use SearchControllerTrait;
    42	
    43	    public function __construct(
    44	        protected PageMaxRepository $pageMaxRepository,
    45	        protected PaginatorInterface $paginator,
    46	        protected DtbOtcBuyOrderStockHistoryRepository $otcBuyOrderStockHistoryRepository,
    47	        protected CsrfTokenManagerInterface $csrfTokenManager,
    48	        protected OtcBuyOrderHistoryCsvExportService $historyCsvExportService,
    49	    ) {
    50	        // === Trait 必須プロパティ ===
    51	        $this->sessionKey = 'otcbuyorder_history';
    52	        $this->formType = OtcBuyOrderHistoryType::class;
    53	    }
    54	
    55	    /**
    56	     * 買取商品履歴
    57	     *
    58	     * @return array<string, mixed>
    59	     */
    60	    #[
    61	        Route(
    62	            path: '/%eccube_admin_route%/otcbuyorder/history',
    63	            name: 'admin_otcbuyorder_history',
    64	            methods: ['GET', 'POST'],
    65	        ),
    66	    ]
    67	    #[
    68	        Route(
    69	            path: '/%eccube_admin_route%/otcbuyorder/history/page/{page_no}',
    70	            name: 'admin_otcbuyorder_history_page',
    71	            requirements: ['page_no' => "\d+"],
    72	            methods: ['GET'],
    73	        ),
    74	    ]
    75	    #[Template(template: '@admin/OtcBuyOrder/history.twig')]
    76	    public function index(
    77	        Request $request,
    78	        PaginatorInterface $paginator,
    79	        int $page_no = 0,
    80	    ): array {
    81	        // 現行だとパスパラメータでのページネーションだが、pager.twig が クエリパラメータでのページネーションを想定しているため両方に対応しておく
    82	        if ($page_no === 0) {
    83	            $page_no =
    84	                $request->query->getInt('pageno', 0) ?:
    85	                $request->query->getInt('page_no', 0);
    86	        }
    87	
    88	        // ページ番号が指定されている場合、セッションから検索条件を復元して指定のページを開く
    89	        if ($page_no > 0) {
    90	            return $this->search($request, null, $page_no);
    91	        }
    92	
    93	        // GET: 初期表示（空の状態）
    94	        if ($request->isMethod('GET')) {
    95	            $form = $this->createForm(OtcBuyOrderHistoryType::class);
    96	
    97	            return [
    98	                'searchForm' => $form->createView(),
    99	                'pagination' => [],
   100	                'pageMaxis' => [],
   101	                'page_count' => $this->eccubeConfig['eccube_default_page_count'],
   102	            ];
   103	        }
   104	
   105	        // POST: 検索実行
   106	        $result = $this->search($request);
   107	
   108	        return $result;
   109	    }
   110	
   111	    /**
   112	     * QueryBuilder取得（SearchControllerTraitのgetQueryBuilderをオーバーライドし、型安全なDtoを使うようにする）
   113	     *
   114	     * @param array{searchData: array<string, scalar|array<scalar>|object|null>} $args
   115	     *
   116	     * @return QueryBuilder
   117	     */
   118	    protected function getQueryBuilder(array $args): QueryBuilder
   119	    {
   120	        $searchData = HistorySearchDataDto::fromFormData($args['searchData']);
   121	
   122	        return $this->otcBuyOrderStockHistoryRepository->getQueryBuilderByHistorySearchData(
   123	            $searchData,
   124	        );
   125	    }
   126	
   127	    /**
   128	     * 買取商品履歴CSVの出力
   129	     */
   130	    #[
   131	        Route(
   132	            path: '/%eccube_admin_route%/otcbuyorder/history/export',
   133	            name: 'admin_otcbuyorder_history_export',
   134	            methods: ['POST'],
   135	        ),
   136	    ]
   137	    public function export(Request $request): Response
   138	    {
   139	        set_time_limit(0);
   140	
   141	        $exportType = $request->request->get('export_type');
   142	
   143	        return match ($exportType) {
   144	            'check_export' => $this->exportByChecked($request),
   145	            'all_export' => $this->exportAll($request),
   146	            default => throw new \InvalidArgumentException('Invalid export type: '.$exportType),
   147	        };
   148	    }
   149	
   150	    /**
   151	     * 選択した商品履歴をCSV出力
   152	     */
   153	    private function exportByChecked(Request $request): StreamedResponse|RedirectResponse
   154	    {
   155	        $historyIds = $request->request->all('otcBuyOrderHistoryIds');
   156	
   157	        if (empty($historyIds)) {
   158	            $this->addError('1つ以上の商品を選択してください', 'admin');
   159	
   160	            $pageNo = $request->getSession()->get('eccube.admin.otcbuyorder_history.search.page_no', 1);
   161	
   162	            return $this->redirect($this->generateUrl('admin_otcbuyorder_history_page', ['page_no' => $pageNo]));
   163	        }
   164	
   165	        return $this->historyCsvExportService->exportByIds(
   166	            array_map('intval', $historyIds),
   167	        );
   168	    }
   169	
   170	    /**
   171	     * 検索結果全件をCSV出力
   172	     */
   173	    private function exportAll(Request $request): StreamedResponse|RedirectResponse
   174	    {
   175	        $session = $request->getSession();
   176	        $viewData = $session->get('eccube.admin.otcbuyorder_history.search');
   177	
   178	        if ($viewData === null) {
   179	            $this->addError('条件に一致する商品がありません', 'admin');
   180	
   181	            $pageNo = $request->getSession()->get('eccube.admin.otcbuyorder_history.search.page_no', 1);
   182	
   183	            return $this->redirect($this->generateUrl('admin_otcbuyorder_history_page', ['page_no' => $pageNo]));
   184	        }
   185	
   186	        $searchForm = $this->createForm(OtcBuyOrderHistoryType::class);
   187	        $searchData = FormUtil::submitAndGetData($searchForm, $viewData);
   188	
   189	        return $this->historyCsvExportService->exportBySearchData($searchData);
   190	    }
   191	}

