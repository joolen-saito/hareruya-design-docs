   152	     *
   153	     * @return array{mode: 'all'|'mail_order'|'store', rootId: int}
   154	     */
   155	    private function resolveBaseInfoFilter(bool $mailOrder, bool $store): array
   156	    {
   157	        $rootId = (int) $this->eccubeConfig->get('eccube_root_base_info_id');
   158	
   159	        if ($mailOrder && $store) {
   160	            return ['mode' => 'all', 'rootId' => $rootId];
   161	        }
   162	        if ($mailOrder) {
   163	            return ['mode' => 'mail_order', 'rootId' => $rootId];
   164	        }
   165	
   166	        return ['mode' => 'store', 'rootId' => $rootId];
   167	    }
   168	
   169	    /**
   170	     * フォーマット別売上集計データを構築する.
   171	     *
   172	     * @param \DateTimeInterface $inputDate 集計月の1日
   173	     * @param array{mode: 'all'|'mail_order'|'store', rootId: int}|null $baseInfoFilter
   174	     *
   175	     * @return array{formats: list<string>, formatSales: array<int, list<int>>, daySum: array<int, int>, resultCalc: array<string, array{sum: int, average: int}>}
   176	     */
   177	    private function buildFormatSalesSummary(\DateTimeInterface $inputDate, ?array $baseInfoFilter): array
   178	    {
   179	        $lastDay = \DateTime::createFromInterface($inputDate)->modify('last day of this month');
   180	        $days = (int) $lastDay->format('d');
   181	
   182	        $resultKeys = [];
   183	        $resultInfo = [];
   184	        $resultDays = [];
   185	
   186	        foreach ($this->tagSalesAnalysisRepository->findBy([], ['rank' => 'ASC']) as $tag) {
   187	            $name = $tag->getName();
   188	            $tagSales = $this->orderRepository->getFormatTagSalesSummary($inputDate, (int) $tag->getId(), $baseInfoFilter);
   189	            $resultKeys[] = $name;
   190	            $resultInfo[$name] = $this->complementOrderDay(array_column($tagSales, 'price', 'day'), $days);
   191	            $resultDays[] = $resultInfo[$name]['days'];
   192	            unset($resultInfo[$name]['days']);
   193	        }
   194	
   195	        foreach (['その他(カード)' => true, 'その他' => false] as $label => $cardOnly) {
   196	            $noTagSales = $this->orderRepository->getFormatNoTagSalesSummary($inputDate, $cardOnly, $baseInfoFilter);
   197	            $resultKeys[] = $label;
   198	            $resultInfo[$label] = $this->complementOrderDay(array_column($noTagSales, 'price', 'day'), $days);
   199	            $resultDays[] = $resultInfo[$label]['days'];
   200	            unset($resultInfo[$label]['days']);
   201	        }
   202	
   203	        $formatSales = [];
   204	        $daySum = array_fill(1, $days, 0);
   205	        foreach ($resultDays as $daySales) {
   206	            foreach ($daySales as $day => $value) {
   207	                $formatSales[$day][] = $value;
   208	                $daySum[$day] += $value;
   209	            }
   210	        }
   211	
   212	        $totalSum = 0;
   213	        foreach ($resultInfo as $calc) {
   214	            $totalSum += $calc['sum'];
   215	        }
   216	        $totalAverage = (int) ($totalSum / $days);
   217	        $resultInfo['合計'] = ['sum' => $totalSum, 'average' => $totalAverage];
   218	
   219	        return [
   220	            'formats' => $resultKeys,
   221	            'formatSales' => $formatSales,
   222	            'daySum' => $daySum,
   223	            'resultCalc' => $resultInfo,
   224	        ];
   225	    }
   226	
   227	    /**
   228	     * 売上の無い日を0で補完し、合計と平均を返す。
   229	     *
   230	     * @param array<int, int> $order
   231	     *
   232	     * @return array{days: array<int, int>, sum: int, average: int}
   233	     */
   234	    private function complementOrderDay(array $order, int $days): array
   235	    {
   236	        $sum = 0;
   237	        for ($i = 1; $i <= $days; $i++) {
   238	            if (isset($order[$i])) {
   239	                $sum += $order[$i];
   240	            } else {
   241	                $order[$i] = 0;
   242	            }
   243	        }
   244	        ksort($order);
   245	
   246	        return [
   247	            'days' => $order,
   248	            'sum' => $sum,
   249	            'average' => $days > 0 ? (int) ($sum / $days) : 0,
   250	        ];
   251	    }
   252	}

