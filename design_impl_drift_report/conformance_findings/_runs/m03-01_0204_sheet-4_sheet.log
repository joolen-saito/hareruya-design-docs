    61	        $(function() {
    62	            $('#bulkDelete').on('click', function() {
    63	
    64	                var modal = $('#bulkDeleteModal');
    65	
    66	                // 削除中のUI変更処理
    67	                modal.find('button').attr('disabled', 'disabled');
    68	                $('.modal-body p', modal).text("{{ 'admin.product.permanently_delete__in_progress'|trans }}");
    69	                $('.progress', modal).show();
    70	
    71	                var checkedList = $('input[type=checkbox][data-delete-url]:checked');
    72	                var totalCount = checkedList.length;
    73	                var currentCount = 0;
    74	
    75	                var promises = checkedList.map(function() {
    76	                    return $.ajax({
    77	                        'url': $(this).data('delete-url'),
    78	                        'type': 'delete',
    79	                        'data': {'_token': $(this).attr('token-for-anchor')}
    80	                    }).always(function() {
    81	                        $('.progress-bar', modal).css('width', (++currentCount / totalCount * 100) + '%');
    82	                    });
    83	                });
    84	
    85	                var addError = function(errorMessage) {
    86	                    $('<li><span class="badge bg-danger">ERROR</span> </li>')
    87	                        .append($('<span></span>').text(errorMessage))
    88	                        .appendTo('#bulkErrors');
    89	                };
    90	
    91	                $.when.apply($, promises)
    92	                    .done(function() {
    93	                        // 削除できなかった場合はエラーメッセージを表示
    94	                        var args = promises.length === 1 ? [arguments[0]] : [].slice.call(arguments).map(function(result) {
    95	                            return result[0];
    96	                        });
    97	                        args.filter(function(result) {
    98	                            return result.success === false;
    99	                        }).forEach(function(result) {
   100	                            addError(result.message);
   101	                        });
   102	                    })
   103	                    .fail(function() {
   104	                        // システムエラー
   105	                        addError("{{ 'admin.product.permanently_delete__system_error'|trans }}");
   106	                    })
   107	                    .always(function() {
   108	                        $('.progress', modal).hide();
   109	                        $('.modal-body p', modal).text("{{ 'admin.product.permanently_delete__complete_message'|trans }}");
   110	                        modal.find('button').removeAttr('disabled').toggle();
   111	                    })
   112	            });
