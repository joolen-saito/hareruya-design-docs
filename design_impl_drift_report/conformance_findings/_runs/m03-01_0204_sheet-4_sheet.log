from pathlib import Path
import re, html
p=Path('/home/y-saito/Developments/hareruya-design-docs/excel_to_html/output/0204_基本設計仕様書(商品管理).html')
for i,line in enumerate(p.read_text(encoding='utf-8').splitlines(),1):
    if 1473 <= i <= 1575 and '<table' not in line and '<tr>' not in line:
        t=re.sub(r'<br\\s*/?>',' ',line)
        t=re.sub(r'<["'^>]+>'"',' ',t)
        t=html.unescape(t)
        t=re.sub(r'\\s+',' ',t).strip()
        if t:
            print(f'{i}: {t}')
