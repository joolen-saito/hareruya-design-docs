54:        "src/Eccube/Resource/template/admin/Product/index.twig:529\n526:                                     <thead>\n527:                                     <tr>\n528:                                         <th class=\"pt-2 text-right border-none\" colspan=\"17\">\n529:                                             <label class=\"col-form-label me-4\">{{ 'admin.product.list_display_data__title'|trans }}</label>\n530:                                             <div class=\"d-inline-block\">\n531:                                                 <select id=\"display_pulldown\" class=\"form-select\" >\n532:                                                     <option {% if display_mode != DISPLAY_MODE_SALES_BRANCH and display_mode != DISPLAY_MODE_STOCK %}selected=\"\"{% endif %} value=\"{{ path('admin_product_page', {'page_no': page_no, 'mode': DISPLAY_MODE_SALES_MAIN}) }}\">{{ 'admin.product.list_display_data__main'|trans }}</option>",
