    56	    public function __invoke(SmaregiStockProcessMessage $message): void
    57	    {
    58	        $Job = $this->messengerJobRepository->find($message->getJobId());
    59	        if (!$Job instanceof MessengerJob) {
    60	            $this->logger->error('Smaregi stock process job not found', [
    61	                'jobId' => $message->getJobId(),
    62	            ]);
    63	
    64	            return;
    65	        }
    66	
    67	        // スマレジ API 呼び出しログを当該子ジョブに紐付けるため、コンテキストへ jobId を設定する。
    68	        $this->smaregiMessengerJobContext->setJobId((int) $Job->getId());
    69	
    70	        try {
    71	            // 悲観ロック + PENDING/FAILED のときのみ PROCESSING へ遷移し、重複実行を抑止する。
    72	            if (!$this->smaregiMessengerJobProcessingLock->tryBeginProcessingJob($Job)) {
    73	                return;
    74	            }
