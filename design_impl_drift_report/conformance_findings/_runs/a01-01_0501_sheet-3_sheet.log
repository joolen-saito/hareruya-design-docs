   204	            );
   205	            $event->breakAll();
   206	
   207	            return 0;
   208	        }
   209	
   210	        $ProductStock = $this->productStockRepository->find($productStockId);
   211	
   212	        $stock = [
   213	            'productStockId' => $productStockId,
   214	            'editQuantity' => $this->editQuantityColumn->getValue($row),
   215	            'purchaseUnitPrice' => $this->purchaseUnitPriceColumn->getValue($row),
   216	            'beforeEditQuantity' => $ProductStock !== null ? (int) $ProductStock->getStock() : null,
   217	            'beforePurchaseUnitPrice' => $ProductStock !== null ? $ProductStock->getUnitCost() : null,
   218	            'changeBaseInfoId' => $this->input->changeBaseInfoId,
   219	            'changeStockLocationId' => $this->input->changeStockLocationId,
   220	            'stockChangeTypeDetailId' => $this->input->stockChangeTypeDetailId,
   221	            'stockChangeReason' => $this->input->stockChangeReason,
   222	            'approvalDepartment' => $this->input->approvalDepartment,
   223	            'approvalNotificationTargetMembers' => $this->input->approvalNotificationTargetMembers,
   224	            'stockEditApprovalId' => $this->input->stockEditApprovalId,
   225	            'memberId' => $this->Member->getId(),
   226	        ];
   227	
   228	        $stockChangeId = $repository->insertStockChangeDetail($stock);
   229	
   230	        $this->totalInventoryChange += (int) $this->editQuantityColumn->getValue($row);
   231	        $this->totalCostPriceBefore += $ProductStock !== null ? (int) $ProductStock->getTotalCost() : 0;
   232	        ++$this->rowCount;
   233	
