   187	     * レスポンス JSON から対象の在庫変動履歴IDに一致するレコードを取り出す。
   188	     * レスポンスは配列 (一覧) で返るため id 一致で特定する。単一オブジェクトでも許容する。
   189	     *
   190	     * @param array<int,array<string,mixed>>|array<string,mixed>|null $json
   191	     *
   192	     * @return array<string,mixed>|null
   193	     */
   194	    private function findRecord(?array $json, string $stockChangeId): ?array
   195	    {
   196	        if ($json === null) {
   197	            return null;
   198	        }
   199	
   200	        // 単一オブジェクト (id を持つ連想配列) の場合。
   201	        if (array_key_exists('id', $json)) {
   202	            return (string) $json['id'] === $stockChangeId ? $json : null;
   203	        }
   204	
   205	        foreach ($json as $row) {
   206	            if (is_array($row) && (string) ($row['id'] ?? '') === $stockChangeId) {
   207	                return $row;
   208	            }
   209	        }
   210	
   211	        return null;
   212	    }
   213	
   214	    /**
   215	     * 在庫変動区分から在庫履歴の理由区分マスタを解決する。
   216	     *
   217	     * 反映対象外の区分 (02:売上 / 12:返品 以外) は null を返す。反映対象の区分なのに理由区分マスタが
   218	     * 存在しない場合は、反映対象外と区別がつかず取り込み失敗を黙って握り潰すことになるため、
   219	     * null を返さず例外で fail-fast する。
   220	     */
   221	    private function resolveStockChangeTypeDetail(?string $division): ?MtbStockChangeTypeDetail
   222	    {
   223	        $detailId = match ($division) {
   224	            self::DIVISION_SALES => MtbStockChangeTypeDetail::SMAREGI_SYNC_SALES,
   225	            self::DIVISION_RETURN => MtbStockChangeTypeDetail::SMAREGI_SYNC_RETURN,
   226	            default => null,
   227	        };
   228	        if ($detailId === null) {
   229	            return null;
   230	        }
   231	
   232	        $StockChangeTypeDetail = $this->stockChangeTypeDetailRepository->find($detailId);
   233	        if ($StockChangeTypeDetail === null) {
   234	            throw new \RuntimeException(sprintf('Smaregi stock change type detail master not found (detailId=%d, division=%s)', $detailId, (string) $division));
   235	        }
   236	
   237	        return $StockChangeTypeDetail;
   238	    }
   239	
   240	    /**
   241	     * 在庫変動区分ごとに在庫履歴へ登録する在庫変動理由を解決する。
   242	     * 在庫変動履歴ID は別カラム (history_source_id) に記録するため理由文には含めない。
   243	     */
   244	    private function resolveStockChangeReason(?string $division): string
   245	    {
   246	        return match ($division) {
   247	            self::DIVISION_SALES => 'スマレジ連携（売上）による減算',
   248	            self::DIVISION_RETURN => 'スマレジ連携（返品）による加算',
   249	            default => 'スマレジ連携',
   250	        };
   251	    }
   252	
   253	    private function stringOrNull(mixed $value): ?string
   254	    {
   255	        if (is_string($value) && $value !== '') {
   256	            return $value;
   257	        }
   258	        if (is_int($value)) {
   259	            return (string) $value;
   260	        }
   261	
   262	        return null;
   263	    }
   264	}

