      <!-- function-design-embed:end m04-10-m04-10_admin_stock_stock_move_transfer_csv_export -->
      <!-- function-design-embed:start m04-27-m04-27_admin_stock_stock_move_result_csv_export -->
      <section class="function-design-embed" id="function-design-m04-27-m04-27_admin_stock_stock_move_result_csv_export" data-source="functions/ec-cube-enterprise/m04-27_admin_stock_stock_move_result_csv_export.md">
        <header class="function-design-header">
          <p class="function-design-source">Source:<br>functions/ec-cube-enterprise/m04-27_admin_stock_stock_move_result_csv_export.md</p>
          <h3>詳細設計書</h3>
          <h4>M04-27 在庫移動実績入力用CSV出力 / M04-27（在庫移動実績入力用CSV出力）</h4>
          <p class="function-design-note">※ この機能には専用の画面シートが無いため、親機能シート「在庫移動・振替情報CSV出力」の末尾に統合した詳細設計書です。</p>
        </header>
        <div class="function-design-body">
          <h2 id="function-design-m04-27-m04-27_admin_stock_stock_move_result_csv_export-文書情報">文書情報</h2>

exec
/bin/bash -lc "sed -n '7046,7165p' /home/y-saito/Developments/hareruya-design-docs/excel_to_html/output/0202_基本設計仕様書\\(在庫管理機能\\).html" in /home/y-saito/Developments/hareruya-design-docs
