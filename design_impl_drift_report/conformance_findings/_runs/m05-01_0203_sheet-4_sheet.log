   130	
   131	    /**
   132	     * 検索パターン保存
   133	     * - 検索フォームをシリアライズし、検索パターンテーブルへ保存します.
   134	     * - テーブル保存後、送信された検索条件で検索を実行します.
   135	     *
   136	     * @return RedirectResponse
   137	     */
   138	    #[Route(path: '/%eccube_admin_route%/order/save/pattern', name: 'admin_order_save_pattern', methods: ['POST'])]
   139	    #[Template(template: '@admin/Order/index.twig')]
   140	    public function saveSearchPattern(Request $request, PaginatorInterface $paginator): RedirectResponse
   141	    {
   142	        $builder = $this->formFactory
   143	            ->createBuilder(SearchOrderType::class);
   144	        $searchForm = $builder->getForm();
   145	        $searchForm->handleRequest($request);
   146	        $viewData = FormUtil::getViewData($searchForm);
   147	
   148	        if ($viewData['pattern_name'] === null || $viewData['pattern_name'] === '') {
   149	            $this->addError('admin.order.save_pattern.error.name_empty', 'admin');
   150	
   151	            return $this->redirectToRoute('admin_order');
   152	        }
   153	
   154	        // 店舗条件は保存しない
   155	        unset($viewData['tenants']);
   156	
   157	        $SearchPattern = $this->dtbSearchPatternRepository->get((int) $viewData['pattern_id']) ?? new DtbSearchPattern();
   158	        $SearchPattern->setBaseInfo($this->getMember()->getBaseInfo()); // TBD - RLS使わないならば必要
   159	        $SearchPattern->setName($viewData['pattern_name']);
   160	        $SearchPattern->setPattern(serialize($viewData));
   161	        $SearchPattern->setDisplayKey('order');
   162	        $this->entityManager->persist($SearchPattern);
   163	        $this->entityManager->flush();
   164	
   165	        $this->addSuccess('admin.order.save_pattern.success', 'admin');
   166	
   167	        return $this->redirectToRoute('admin_order_search_pattern', ['pattern_id' => $SearchPattern->getId()]);
   168	    }
   169	
   170	    /**
   171	     * 検索パターン削除
   172	     *
   173	     * @return RedirectResponse
   174	     */
   175	    #[Route(path: '/%eccube_admin_route%/order/delete/pattern/{pattern_id}', name: 'admin_order_delete_pattern', requirements: ['pattern_id' => '\d+'], methods: ['POST'])]
   176	    public function deleteSearchPattern(Request $request, int $pattern_id): RedirectResponse
   177	    {
   178	        $SearchPattern = $this->dtbSearchPatternRepository->get((int) $pattern_id);
   179	        if (!$SearchPattern) {
   180	            $this->addError('admin.order.delete_pattern.error', 'admin');
   181	
   182	            return $this->redirectToRoute('admin_order');
   183	        }
   184	        $this->entityManager->remove($SearchPattern);
   185	        $this->entityManager->flush();
   186	
   187	        $this->addSuccess('admin.order.delete_pattern.success', 'admin');
   188	
   189	        return $this->redirectToRoute('admin_order');
   190	    }
   191	
   192	    /**
   193	     * 検索パターンの件数を取得
   194	     *
   195	     * @return JsonResponse
   196	     */
   197	    #[Route(path: '/%eccube_admin_route%/order/count/pattern/{pattern_id}', name: 'admin_order_count_pattern', methods: ['GET'])]
   198	    public function count(Request $request, ?int $pattern_id = null): JsonResponse
   199	    {
   200	        $builder = $this->formFactory
   201	            ->createBuilder(SearchOrderType::class);
   202	        $searchForm = $builder->getForm();
   203	        $SearchPattern = $this->dtbSearchPatternRepository->get((int) $pattern_id);
   204	        if (!$SearchPattern) {
   205	            throw new \Exception('SearchPattern not found');
   206	        }
   207	        $viewData = unserialize($SearchPattern->getPattern());
   208	        $searchData = FormUtil::submitAndGetData($searchForm, $viewData);
   209	        $qb = $this->orderRepository->getQueryBuilderBySearchDataForAdmin($searchData);
   210	
   211	        // COUNT取得用にクエリビルダーをクローンして変更
   212	        $countQb = clone $qb;
   213	        $countQb->select('COUNT(DISTINCT o.id)')
   214	            ->resetDQLPart('orderBy')
   215	            ->resetDQLPart('groupBy');
   216	
   217	        $count = (int) $countQb->getQuery()->getSingleScalarResult();
   218	
   219	        return $this->json(['count' => $count]);
   220	    }
   221	}

