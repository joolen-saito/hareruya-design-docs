    29	use Eccube\Entity\DeliveryFee;
    30	use Eccube\Entity\DeliveryTime;
    31	use Eccube\Entity\MailTemplate;
    32	use Eccube\Entity\PaymentOption;
    33	use Eccube\Entity\TradeLaw;
    34	use Eccube\Request\Context;
    35	use Eccube\Session\Session;
    36	use Symfony\Component\HttpFoundation\Exception\SessionNotFoundException;
    37	
    38	#[AsDoctrineListener(event: Events::prePersist)]
    39	class TenantEventSubscriber
    40	{
    41	    public function __construct(protected Context $requestContext, protected EccubeConfig $eccubeConfig, protected Session $session)
    42	    {
    43	    }
    44	
    45	    /**
    46	     * プリペアドステートメントの前に呼び出される
    47	     * テナントIDがセッションの中にある場合、かつ、エンティティにテナントをセットするメソッドがある場合、
    48	     * エンティティにテナントIDをセットする
    49	     *
    50	     * @throws NonUniqueResultException
    51	     */
    52	    public function prePersist(PrePersistEventArgs $args): void
    53	    {
    54	        $entity = $args->getObject();
    55	        // エンティティにテナントをセットするメソッドがある場合、テナントをセットする
    56	        try {
    57	            if (
    58	                $this->session->has(EccubeRoleConnection::SESSION_ACTIVE_DYNAMIC_CONN_ADMIN)
    59	                && method_exists($entity, 'setBaseInfo')
    60	                // @TODO: もっとキレイな条件形式に変更する
    61	                && $entity instanceof MailTemplate === false
    62	                && $entity instanceof TradeLaw === false
    63	                && $entity instanceof Delivery === false
    64	                && $entity instanceof DeliveryFee === false
    65	                && $entity instanceof DeliveryTime === false
    66	                && $entity instanceof PaymentOption === false
    67	                && $entity instanceof Calendar === false
    68	            ) {
    69	                $activeDynamicConn = $this->session->get(EccubeRoleConnection::SESSION_ACTIVE_DYNAMIC_CONN_ADMIN);
    70	                if (array_key_exists('base_info', $activeDynamicConn)) {
    71	                    /** @var ObjectManagerDecorator<EntityManagerInterface> $em */
    72	                    $em = $args->getObjectManager();
    73	                    try {
    74	                        if ($entity->getBaseInfo()) {
    75	                            return;
    76	                        }
    77	                    } catch (\Throwable $e) {
    78	                        log_debug('既存BaseInfoの取得に失敗したため、テナントID設定を継続します。', [
    79	                            'entity' => $entity::class,
    80	                            'exception' => $e::class,
    81	                            'message' => $e->getMessage(),
    82	                            'file' => __FILE__,
    83	                        ]);
    84	                    }
    85	                    $tenant = $em->getRepository(BaseInfo::class)->find($activeDynamicConn['base_info']);
    86	                    $entity->setBaseInfo($tenant);
    87	                }
    88	            }
    89	        } catch (SessionNotFoundException) {
    90	            log_debug('セッションがないため、テナントIDをセットしません。', [
    91	                'entity' => $entity::class,
    92	                'method' => 'setBaseInfo',
    93	                'file' => __FILE__,
    94	            ]);
    95	            // セッションがない場合は何もしない
    96	        }
    97	    }
    98	}

