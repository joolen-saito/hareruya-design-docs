    36	    public function onInteractiveLogin(InteractiveLoginEvent $event): void
    37	    {
    38	        $user = $event
    39	            ->getAuthenticationToken()
    40	            ->getUser();
    41	
    42	        if ($user instanceof Member) {
    43	            $event->getRequest()->getSession()->set(EccubeRoleConnection::SESSION_ACTIVE_DYNAMIC_CONN_ADMIN, [
    44	                'role' => $user->getAuthority()->getRoleKey(),
    45	                'base_info' => $user->getBaseInfo()->getId(),
    46	                'member_id' => $user->getId(),
    47	            ]);
    48	            // ログイン後に顧客情報を更新するためのフラグをセット
    49	            $event->getRequest()->getSession()->set(Constant::TEMP_POST_MEMBER_LOGIN_ACTION_REQUIRED, true);
    50	        } elseif ($user instanceof Customer) {
    51	            $event->getRequest()->getSession()->set(EccubeRoleConnection::SESSION_ACTIVE_DYNAMIC_CONN_NON_ADMIN, [
    52	                'role' => Authority::CUSTOMER,
    53	                'customer_id' => $user->getId(),
    54	            ]);
    55	
    56	            // ログイン後に顧客情報を更新するためのフラグをセット
    57	            $event->getRequest()->getSession()->set(Constant::TEMP_POST_CUSTOMER_LOGIN_ACTION_REQUIRED, true);
    58	        }
    59	    }
    60	
    61	    public function onAuthenticationFailure(LoginFailureEvent $event): void
    62	    {
    63	        $request = $this->requestStack->getCurrentRequest();
    64	        $request->getSession()->set('_security.login_memory', (bool) $request->request->get('login_memory', 0));
    65	    }
    66	
    67	    /**
    68	     * Returns an array of event names this subscriber wants to listen to.
    69	     *
    70	     * The array keys are event names and the value can be:
    71	     *
    72	     * * The method name to call (priority defaults to 0)
    73	     * * An array composed of the method name to call and the priority
    74	     * * An array of arrays composed of the method names to call and respective
    75	     *   priorities, or 0 if unset
    76	     *
    77	     * For instance:
    78	     *
    79	     * * array('eventName' => 'methodName')
    80	     * * array('eventName' => array('methodName', $priority))
    81	     * * array('eventName' => array(array('methodName1', $priority), array('methodName2'))
    82	     *
    83	     * @return array<string, string> The event names to listen to
    84	     */
    85	    #[\Override]
    86	    public static function getSubscribedEvents(): array
    87	    {
    88	        return [
    89	            SecurityEvents::INTERACTIVE_LOGIN => 'onInteractiveLogin',
    90	            LoginFailureEvent::class => 'onAuthenticationFailure',
    91	        ];
    92	    }
