namespace Eccube\Repository;

use Doctrine\DBAL\ArrayParameterType;
use Doctrine\Persistence\ManagerRegistry;
use Eccube\Entity\BaseInfo;
use Eccube\Entity\DtbMonthlySummary;

/**
 * @extends AbstractRepository<DtbMonthlySummary>
 */
class DtbMonthlySummaryRepository extends AbstractRepository
{
    public function __construct(ManagerRegistry $registry)
    {
        parent::__construct($registry, DtbMonthlySummary::class);
    }

    /**
     * 指定した集計月の月次集計を全店舗分削除する。
     * 再集計時は本メソッドで削除してから insertMonthlySummary で登録し直す。
     */
    public function deleteBySummaryMonth(\DateTimeInterface $summaryMonth): void
    {
        $this->getEntityManager()->createQueryBuilder()
            ->delete(DtbMonthlySummary::class, 's')
            ->where('s.summaryMonth = :summaryMonth')
            ->setParameter('summaryMonth', $summaryMonth->format('Y-m-d'))
            ->getQuery()
            ->execute();
    }

    /**
     * 月次集計結果を1店舗分 INSERT する。
     * 同一 (summary_month, base_info_id) は事前に deleteBySummaryMonth で削除しておくこと。
     *
     * @param array<string, int> $summaryValues gross_sales/total_cost/gross_profit/sale_quantity/sale_count/sale_average/purchase_count/purchase_amount/waste_count/shortage_count
     */
    public function insertMonthlySummary(\DateTimeInterface $summaryMonth, int $baseInfoId, array $summaryValues): void
    {
        $em = $this->getEntityManager();
        $now = new \DateTime();

        $summary = (new DtbMonthlySummary())
            ->setSummaryMonth(\DateTime::createFromInterface($summaryMonth))
            ->setBaseInfo($em->getReference(BaseInfo::class, $baseInfoId))
            ->setGrossSales((string) ($summaryValues['gross_sales'] ?? 0))
            ->setTotalCost((string) ($summaryValues['total_cost'] ?? 0))
            ->setGrossProfit((string) ($summaryValues['gross_profit'] ?? 0))
            ->setSaleQuantity((int) ($summaryValues['sale_quantity'] ?? 0))
            ->setSaleCount((int) ($summaryValues['sale_count'] ?? 0))
            ->setSaleAverage((string) ($summaryValues['sale_average'] ?? 0))
            ->setPurchaseCount((int) ($summaryValues['purchase_count'] ?? 0))
            ->setPurchaseAmount((string) ($summaryValues['purchase_amount'] ?? 0))
            ->setWasteCount((int) ($summaryValues['waste_count'] ?? 0))
            ->setShortageCount((int) ($summaryValues['shortage_count'] ?? 0))
            ->setCreateDate($now)
            ->setUpdateDate($now);

        $em->persist($summary);
        $em->flush();
    }

    /**
     * @param list<int> $targetBaseInfoIds 空配列の場合は店舗絞り込みなし（全店舗）
     *
     * @return array<int, array<string, mixed>>
     */
    public function fetchSummaryRowsByMonthRangeAndTargets(
        \DateTimeInterface $from,
        \DateTimeInterface $to,
        array $targetBaseInfoIds,
    ): array {
        $sql = <<<'SQL'
SELECT
    s.summary_month,
    s.base_info_id,
    b.short_name_jp,
    b.shop_name,
    s.gross_sales,
    s.total_cost,
    s.gross_profit,
    s.sale_quantity,
    s.sale_count,
    s.sale_average,
    s.purchase_count,
    s.purchase_amount,
    s.waste_count,
    s.shortage_count
FROM dtb_monthly_summary s
INNER JOIN dtb_base_info b ON b.id = s.base_info_id
WHERE s.summary_month >= :from
  AND s.summary_month <= :to
SQL;
        $params = [
            'from' => $from->format('Y-m-d'),
            'to' => $to->format('Y-m-d'),
        ];
        $types = [];

        if ($targetBaseInfoIds !== []) {
            $sql .= ' AND s.base_info_id IN (:targetIds)';
            $params['targetIds'] = $targetBaseInfoIds;
            $types['targetIds'] = ArrayParameterType::INTEGER;
        }

        $sql .= ' ORDER BY s.summary_month ASC, s.base_info_id ASC';

        return $this->getEntityManager()->getConnection()->executeQuery($sql, $params, $types)->fetchAllAssociative();
    }
}

