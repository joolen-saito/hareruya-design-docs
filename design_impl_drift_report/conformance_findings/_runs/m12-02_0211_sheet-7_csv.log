   171	            }
   172	        }
   173	
   174	        $total['order_average_order'] = ((int) $total['buyer_count'] > 0)
   175	            ? intdiv((int) $total['order_amount_order'], (int) $total['buyer_count'])
   176	            : 0;
   177	
   178	        return $total;
   179	    }
