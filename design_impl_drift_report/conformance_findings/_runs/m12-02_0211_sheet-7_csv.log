    /**
     * 集計対象フォームの初期値を返す。
     * base_info_id が TC東京（通販）の場合は通販チェック、それ以外は店舗チェックを入れる。
     *
     * @return array{mail_order_enabled: bool, store_sales_targets: list<int>}
     */
    private function resolveInitialSummaryTargets(): array
    {
        $Member = $this->getUser();
        if (!$Member instanceof Member) {
            return [
                'mail_order_enabled' => false,
                'store_sales_targets' => [],
            ];
        }

        $memberBaseInfoId = $Member->getBaseInfo()->getId();
        if ($memberBaseInfoId === BaseInfo::TC_TOKYO_ID) {
            return [
                'mail_order_enabled' => true,
                'store_sales_targets' => $this->resolveMemberShopIds($Member),
            ];
        }

        return [
            'mail_order_enabled' => false,
            'store_sales_targets' => $this->resolveMemberShopIds($Member),
        ];
    }

    /**
     * ログイン中メンバーの所属店舗IDを初期選択値として返す（TC東京は除外）。
     *
     * @return list<int>
     */
    private function resolveMemberShopIds(Member $Member): array
    {
        $ids = [];
        $baseInfoId = $Member->getBaseInfo()->getId();
        if ($baseInfoId !== null && $baseInfoId !== BaseInfo::TC_TOKYO_ID) {
            $ids[$baseInfoId] = $baseInfoId;
        }

        foreach ($Member->getMemberBaseInfos() as $MemberBaseInfo) {
            $id = $MemberBaseInfo->getBaseInfo()->getId();
            if ($id !== null && $id !== BaseInfo::TC_TOKYO_ID) {
                $ids[$id] = $id;
            }
        }

        return array_values($ids);
    }
}

