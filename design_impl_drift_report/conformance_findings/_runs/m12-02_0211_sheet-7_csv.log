   158	    private function buildTotal(array $summary, array $resultColumns): array
   159	    {
   160	        $total = [];
   161	        foreach (array_keys($resultColumns) as $key) {
   162	            $total[$key] = $key === 'store_name' ? '' : 0;
   163	        }
   164	
