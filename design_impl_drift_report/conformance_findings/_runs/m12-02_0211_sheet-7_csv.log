namespace Eccube\Service\Admin\Analysis;

use Eccube\Common\EccubeConfig;
use Eccube\Repository\DtbDailySummaryRepository;
use Eccube\Repository\DtbMonthlySummaryRepository;

class AnalysisSummaryBuilder
{
    public function __construct(
        private readonly DtbDailySummaryRepository $dtbDailySummaryRepository,
        private readonly DtbMonthlySummaryRepository $dtbMonthlySummaryRepository,
        private readonly EccubeConfig $eccubeConfig,
    ) {
    }

    /**
     * @param list<int> $targetBaseInfoIds
     * @param array<string, string> $resultColumns
     *
     * @return array{
     *   summary: array<int, array<string, int|string>>,
     *   total: array<string, int|string>
     * }
     */
    public function build(
        string $summaryType,
        \DateTimeInterface $dateFrom,
        \DateTimeInterface $dateTo,
        array $targetBaseInfoIds,
        bool $mailOrderEnabled,
        array $resultColumns,
    ): array {
        $summary = $summaryType === 'monthly'
            ? $this->fetchMonthlySummary($dateFrom, $dateTo, $targetBaseInfoIds, $mailOrderEnabled)
            : $this->fetchDailySummary($dateFrom, $dateTo, $targetBaseInfoIds, $mailOrderEnabled);

        return [
            'summary' => $summary,
            'total' => $this->buildTotal($summary, $resultColumns),
        ];
    }

    /**
     * @param list<int> $targetBaseInfoIds
     *
     * @return array<int, array<string, int|string>>
     */
    private function fetchDailySummary(
        \DateTimeInterface $dateFrom,
        \DateTimeInterface $dateTo,
        array $targetBaseInfoIds,
        bool $mailOrderEnabled,
    ): array {
        $from = \DateTimeImmutable::createFromInterface($dateFrom)->setTime(0, 0, 0);
        $to = \DateTimeImmutable::createFromInterface($dateTo)->setTime(23, 59, 59);
        if ($from > $to) {
            [$from, $to] = [$to, $from];
        }

        $rowsRaw = $this->dtbDailySummaryRepository->fetchSummaryRowsByDateRangeAndTargets($from, $to, $targetBaseInfoIds);
        $rows = [];
        foreach ($rowsRaw as $raw) {
            $storeName = $this->resolveStoreName(
                (int) ($raw['base_info_id'] ?? 0),
                (string) ($raw['short_name_jp'] ?? ''),
                (string) ($raw['shop_name'] ?? ''),
                $mailOrderEnabled
            );
            $summaryDate = $raw['summary_date'];
            $rows[] = [
                'order_date' => $summaryDate instanceof \DateTimeInterface
                    ? $summaryDate->format('Y/m/d')
                    : (new \DateTime($summaryDate !== null ? (string) $summaryDate : 'now'))->format('Y/m/d'),
                'store_name' => $storeName,
                'order_amount_order' => (int) ($raw['gross_sales'] ?? 0),
                'cost' => (int) ($raw['total_cost'] ?? 0),
                'gross_profit' => (int) ($raw['gross_profit'] ?? 0),
                'order_count_order' => (int) ($raw['sale_quantity'] ?? 0),
                'buyer_count' => (int) ($raw['sale_count'] ?? 0),
                'order_average_order' => (int) ($raw['sale_average'] ?? 0),
                'purchase_count' => (int) ($raw['purchase_count'] ?? 0),
                'purchase_amount' => (int) ($raw['purchase_amount'] ?? 0),
                'discard_count' => (int) ($raw['waste_count'] ?? 0),
                'out_of_stock_count' => (int) ($raw['shortage_count'] ?? 0),
            ];
        }

        return $rows;
    }

    /**
     * @param list<int> $targetBaseInfoIds
     *
     * @return array<int, array<string, int|string>>
     */
    private function fetchMonthlySummary(
        \DateTimeInterface $dateFrom,
        \DateTimeInterface $dateTo,
        array $targetBaseInfoIds,
        bool $mailOrderEnabled,
    ): array {
        $from = \DateTimeImmutable::createFromInterface($dateFrom)->modify('first day of this month')->setTime(0, 0, 0);
        $to = \DateTimeImmutable::createFromInterface($dateTo)->modify('first day of this month')->setTime(0, 0, 0);
        if ($from > $to) {
            [$from, $to] = [$to, $from];
        }

        $rowsRaw = $this->dtbMonthlySummaryRepository->fetchSummaryRowsByMonthRangeAndTargets($from, $to, $targetBaseInfoIds);

        $rows = [];
        foreach ($rowsRaw as $raw) {
            $storeName = $this->resolveStoreName(
                (int) ($raw['base_info_id'] ?? 0),
                (string) ($raw['short_name_jp'] ?? ''),
                (string) ($raw['shop_name'] ?? ''),
                $mailOrderEnabled
            );
            $rows[] = [
                'order_date' => (new \DateTime((string) $raw['summary_month']))->format('Y/n'),
                'store_name' => $storeName,
                'order_amount_order' => (int) ($raw['gross_sales'] ?? 0),
                'cost' => (int) ($raw['total_cost'] ?? 0),
                'gross_profit' => (int) ($raw['gross_profit'] ?? 0),
                'order_count_order' => (int) ($raw['sale_quantity'] ?? 0),
                'buyer_count' => (int) ($raw['sale_count'] ?? 0),
                'order_average_order' => (int) ($raw['sale_average'] ?? 0),
                'purchase_count' => (int) ($raw['purchase_count'] ?? 0),
                'purchase_amount' => (int) ($raw['purchase_amount'] ?? 0),
                'discard_count' => (int) ($raw['waste_count'] ?? 0),
                'out_of_stock_count' => (int) ($raw['shortage_count'] ?? 0),
            ];
        }

        return $rows;
    }

    /**
     * @param array<int, array<string, int|string>> $summary
     * @param array<string, string> $resultColumns
     *
     * @return array<string, int|string>
     */
    private function buildTotal(array $summary, array $resultColumns): array
    {
        $total = [];
        foreach (array_keys($resultColumns) as $key) {
            $total[$key] = $key === 'store_name' ? '' : 0;
        }

        foreach ($summary as $row) {
            foreach (array_keys($resultColumns) as $key) {
                if ($key === 'store_name' || $key === 'order_average_order') {
                    continue;
                }
                $total[$key] += (int) ($row[$key] ?? 0);
            }
        }

        $total['order_average_order'] = ((int) $total['buyer_count'] > 0)
            ? intdiv((int) $total['order_amount_order'], (int) $total['buyer_count'])
            : 0;

        return $total;
    }

    private function resolveStoreName(int $baseInfoId, string $shortNameJp, string $shopName, bool $mailOrderEnabled): string
    {
        if ($mailOrderEnabled && $baseInfoId === (int) $this->eccubeConfig->get('eccube_root_base_info_id')) {
            return '通販';
        }

        $short = trim($shortNameJp);
        if ($short !== '') {
            return $short;
        }

        return $shopName;
    }
}

