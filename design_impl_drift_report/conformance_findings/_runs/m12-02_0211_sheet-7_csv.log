        $mailOrderEnabled = (bool) ($form->get('mail_order_enabled')->getData() ?? false);
        $storeSalesTargets = $form->get('store_sales_targets')->getData();

        if (!$dateFrom instanceof \DateTimeInterface || !$dateTo instanceof \DateTimeInterface) {
            $request->getSession()->remove(self::VIEW_KEY);

