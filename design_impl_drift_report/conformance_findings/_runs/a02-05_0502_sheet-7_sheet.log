   200	            ->leftJoin('p.ProductImage', 'pi')
   201	            ->leftJoin('p.ProductTag', 'pt')
   202	            ->where($qb->expr()->in('p.id', $ids))
   203	            ->andWhere('pc.visible = :visible')
   204	            ->setParameter('visible', true)
   205	            ->orderBy('cc1.sort_no', 'DESC')
   206	            ->addOrderBy('cc2.sort_no', 'DESC');
   207	
   208	        return $qb
