   187	    public function findProductsWithSortedClassCategories(array $ids, ?string $indexBy = null): ArrayCollection|array|null
   188	    {
   189	        if (count($ids) < 1) {
   190	            return [];
   191	        }
   192	        $qb = $this->createQueryBuilder('p', $indexBy);
   193	        $qb->addSelect(['pc', 'cc1', 'cc2', 'pi', 'pt', 'tr', 'ps'])
   194	            ->innerJoin('p.ProductClasses', 'pc')
