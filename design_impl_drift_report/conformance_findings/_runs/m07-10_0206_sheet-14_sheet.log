    28	 * @extends AbstractRepository<DtbBuyOrderStockHistory>
    29	 */
    30	class DtbBuyOrderStockHistoryRepository extends AbstractRepository
    31	{
    32	    public function __construct(ManagerRegistry $registry)
    33	    {
    34	        parent::__construct($registry, DtbBuyOrderStockHistory::class);
    35	    }
    36	
    37	    /**
    38	     * Get Sort keys
    39	     *
    40	     * @return array<string, string>
    41	     */
    42	    public function getSortKeys(): array
    43	    {
    44	        return ['default' => 'transferCompleteDate'];
    45	    }
    46	
    47	    /**
    48	     * 検索条件から QueryBuilder を構築
    49	     *
    50	     * @param HistorySearchDataDto $searchData
    51	     *
    52	     * @return QueryBuilder
    53	     */
    54	    public function getQueryBuilderByHistorySearchData(
    55	        HistorySearchDataDto $searchData,
    56	    ): QueryBuilder {
    57	        $qb = $this->createQueryBuilder('bosh')
    58	            ->addSelect('bos')
    59	            ->addSelect('bo')
    60	            ->addSelect('boStatus')
    61	            ->addSelect('m')
    62	            ->addSelect('pc')
    63	            ->addSelect('p')
    64	            ->addSelect('la')
    65	            ->join('bosh.BuyOrderStock', 'bos')
    66	            ->leftJoin('bosh.Member', 'm')
    67	            ->join('bos.BuyOrder', 'bo')
    68	            ->join('bos.ProductClass', 'pc')
    69	            ->join('pc.Product', 'p')
    70	            ->join('pc.Language', 'la')
    71	            ->join('bo.BuyOrderStatus', 'boStatus');
    72	
    73	        // 買取番号（完全一致）
    74	        if ($searchData->buyOrderId !== null) {
    75	            $qb->andWhere('bo.id = :buyOrderId')->setParameter(
    76	                'buyOrderId',
    77	                $searchData->buyOrderId,
    78	            );
    79	        }
    80	
    81	        // 会員ID（完全一致）
    82	        if ($searchData->customerId !== null && $searchData->customerId !== '') {
    83	            $qb->andWhere('IDENTITY(bo.Customer) = :customerId')->setParameter(
    84	                'customerId',
    85	                (int) $searchData->customerId,
    86	            );
    87	        }
    88	
    89	        // 申込者名（空白区切りで複数キーワード、姓・名・姓カナ・名カナに部分一致）
    90	        if ($searchData->customerName !== null) {
    91	            $keywords = preg_split(
    92	                "/[\s,　]+/u",
    93	                trim($searchData->customerName),
    94	            );
    95	            foreach ($keywords as $i => $keyword) {
    96	                if ($keyword === '') {
    97	                    continue;
    98	                }
    99	                $qb->andWhere(
   100	                    $qb->expr()->orX(
   101	                        $qb->expr()->like('bo.lastName', ":keyword{$i}"),
   102	                        $qb->expr()->like('bo.firstName', ":keyword{$i}"),
   103	                        $qb->expr()->like('bo.lastNameKana', ":keyword{$i}"),
   104	                        $qb->expr()->like('bo.firstNameKana', ":keyword{$i}"),
   105	                    ),
   106	                )->setParameter("keyword{$i}", "%{$keyword}%");
   107	            }
   108	        }
   109	
   110	        // 買取ステータス
   111	        if (
   112	            $searchData->buyOrderStatus !== null
   113	            && !$searchData->buyOrderStatus->isEmpty()
   114	        ) {
   115	            $qb->andWhere(
   116	                $qb->expr()->in('bo.BuyOrderStatus', ':buyOrderStatus'),
   117	            )->setParameter(
   118	                'buyOrderStatus',
   119	                $searchData->buyOrderStatus->getValues(),
   120	            );
   121	        }
   122	
   123	        // 振込完了日（サブクエリを WHERE と ORDER BY で使用）
   124	        $qb->setParameter('tcStatus', MtbBuyOrderStatus::TRANSFER_COMPLETE);
   125	        $createTcSubQuery = function (string $alias) {
   126	            return sprintf(
   127	                '(SELECT MAX(%s.createDate) FROM Eccube\Entity\DtbBuyOrderStatusHistory %s WHERE %s.BuyOrder = bo AND %s.BuyOrderStatus = :tcStatus)',
   128	                $alias,
   129	                $alias,
   130	                $alias,
   131	                $alias
   132	            );
   133	        };
   134	
   135	        // 振込完了日時：From
   136	        if ($searchData->transferCompleteDateFrom !== null) {
   137	            $qb->andWhere($createTcSubQuery('bosh_tc_from').' >= :transferCompleteDateFrom')
   138	                ->setParameter('transferCompleteDateFrom', $searchData->transferCompleteDateFrom);
   139	        }
   140	
   141	        // 振込完了日時：To
   142	        if ($searchData->transferCompleteDateTo !== null) {
   143	            $qb->andWhere($createTcSubQuery('bosh_tc_to').' <= :transferCompleteDateTo')
   144	                ->setParameter('transferCompleteDateTo', $searchData->transferCompleteDateTo);
   145	        }
   146	
   147	        // 査定担当者名（部分一致）
   148	        if (!empty($searchData->assessmentMemberName)) {
   149	            $qb->join('bo.Member', 'boMember')
   150	                ->andWhere('boMember.name LIKE :assessmentMemberName')
   151	                ->setParameter(
   152	                    'assessmentMemberName',
   153	                    '%'.addcslashes($searchData->assessmentMemberName, '%_').'%',
   154	                );
   155	        }
   156	
   157	        // 商品コード(完全一致)
   158	        if ($searchData->productCode !== null) {
   159	            $qb->andWhere('pc.code = :productCode')->setParameter(
   160	                'productCode',
   161	                $searchData->productCode,
   162	            );
   163	        }
   164	
   165	        // 商品名（部分一致）
   166	        if (!empty($searchData->productName)) {
   167	            $qb->andWhere('p.name LIKE :productName')->setParameter(
   168	                'productName',
   169	                '%'.addcslashes($searchData->productName, '%_').'%',
   170	            );
   171	        }
   172	
   173	        // 買取金額（仕入単価 = 小計 / 数量）
   174	        if ($searchData->buyPriceFrom !== null) {
   175	            $qb->andWhere('bos.subtotal >= :buyPriceFrom * bos.quantity')
   176	                ->setParameter('buyPriceFrom', $searchData->buyPriceFrom);
   177	        }
   178	        if ($searchData->buyPriceTo !== null) {
   179	            $qb->andWhere('bos.subtotal <= :buyPriceTo * bos.quantity')
   180	                ->setParameter('buyPriceTo', $searchData->buyPriceTo);
   181	        }
   182	
   183	        // 基準価格
   184	        if ($searchData->standardPriceFrom !== null) {
   185	            $qb->andWhere('pc.standardPrice >= :standardPriceFrom')
   186	                ->setParameter('standardPriceFrom', $searchData->standardPriceFrom);
   187	        }
   188	        if ($searchData->standardPriceTo !== null) {
   189	            $qb->andWhere('pc.standardPrice <= :standardPriceTo')
   190	                ->setParameter('standardPriceTo', $searchData->standardPriceTo);
   191	        }
   192	
   193	        // 言語
   194	        if (
   195	            $searchData->language !== null
   196	            && count($searchData->language) > 0
   197	        ) {
   198	            $orCondition = [];
   199	            $conditionLangIds = [];
   200	            foreach ($searchData->language as $language) {
   201	                if (in_array($language, MtbLanguage::CONSTANT_LANG_IDS, true)) {
   202	                    $conditionLangIds[] = $language;
   203	                } else {
   204	                    $orCondition[] = $qb->expr()->notIn('la.id', ':exceptLanguages');
   205	                    $qb->setParameter(
   206	                        'exceptLanguages',
   207	                        MtbLanguage::CONSTANT_LANG_IDS,
   208	                    );
   209	                }
   210	            }
   211	            $orCondition[] = $qb->expr()->in('la.id', ':languages');
   212	            $qb->andWhere(new Orx($orCondition))
   213	                ->setParameter('languages', $conditionLangIds);
   214	        }
   215	
   216	        // 状態
   217	        if (
   218	            $searchData->condition !== null
   219	            && count($searchData->condition) > 0
   220	        ) {
   221	            $qb->join('pc.CardCondition', 'cc')
   222	                ->andWhere($qb->expr()->in('cc.id', ':conditions'))
   223	                ->setParameter('conditions', $searchData->condition);
   224	        }
   225	
   226	        // ソート: 振込完了日の降順、注文日の降順
   227	        $qb->addSelect($createTcSubQuery('bosh_tc_sort').' AS HIDDEN transferCompleteDateSort');
   228	
   229	        // ステータス履歴で振込完了日がない場合の NULL を最後にするためのフラグ
   230	        $existsQuery = '(SELECT 1 FROM Eccube\Entity\DtbBuyOrderStatusHistory bosh_tc_null WHERE bosh_tc_null.BuyOrder = bo AND bosh_tc_null.BuyOrderStatus = :tcStatus)';
   231	        $qb->addSelect('CASE WHEN EXISTS '.$existsQuery.' THEN 0 ELSE 1 END AS HIDDEN transferCompleteDateNullLast');
   232	
   233	        $qb->addOrderBy('transferCompleteDateNullLast', 'ASC') // 0(存在する) が先、1(存在しない/NULL) が最後
   234	            ->addOrderBy('transferCompleteDateSort', 'DESC')
   235	            ->addOrderBy('bo.orderDate', 'DESC');
   236	
   237	        return $qb;
   238	    }
   239	
   240	    /**
   241	     * 買取の振込完了日（ステータス＝振込完了の履歴のうち最新の createDate）を取得
   242	     */
   243	    public function getTransferCompleteDateForOrder(DtbBuyOrder $order): ?\DateTimeInterface
   244	    {
   245	        $latest = null;
   246	        foreach ($order->getBuyOrderStatusHistories() as $history) {
   247	            if ($history->getBuyOrderStatus()->getId() === MtbBuyOrderStatus::TRANSFER_COMPLETE) {
   248	                $createDate = $history->getCreateDate();
   249	                if ($latest === null || $createDate > $latest) {
   250	                    $latest = $createDate;
   251	                }
   252	            }
   253	        }
   254	
   255	        return $latest;
   256	    }
