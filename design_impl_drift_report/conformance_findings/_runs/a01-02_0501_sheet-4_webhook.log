    30	        public bool $isOtcPcPurchase,
    31	        public bool $hasAddOnPurchase,
    32	        public PickupMethod $pickupMethod,
    33	        public bool $isMember,
    34	        public array $matchedOrders = [],
    35	        public array $matchedSmaregiCodes = [],
    36	        public ?DtbPlayer $member = null,
    37	    ) {
    38	    }
    39	}
