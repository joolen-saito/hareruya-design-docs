    16	namespace Eccube\Service\Smaregi\Webhook\Stock;
    17	
    18	use Doctrine\ORM\EntityManagerInterface;
    19	use Eccube\Entity\MessengerJob;
    20	use Eccube\Message\SmaregiStockProcessMessage;
    21	use Psr\Log\LoggerInterface;
    22	use Symfony\Component\Messenger\MessageBusInterface;
    23	
    24	/**
    25	 * 在庫変動履歴 1 件分の子 MessengerJob を作成し、{@see SmaregiStockProcessMessage} を MessageBus へ投入する。
    26	 *
    27	 * Webhook 受信経路 ({@see StockEventDispatcher}) と Webhook 連携エラー再連携バッチの双方から再利用する。
    28	 * Webhook 受信時は webhookEventId / parentJobId を伝搬し、再連携バッチからは webhookEventId=null で呼ばれる。
    29	 *
    30	 * dispatch 失敗時は当該子 MessengerJob を FAILED へ遷移させて例外を再 throw する
    31	 * (取引側 {@see \Eccube\Service\Smaregi\Webhook\Transaction\SmaregiTransactionProcessDispatcher} と同方針)。
    32	 */
    33	final readonly class SmaregiStockProcessDispatcher
    34	{
    35	    public function __construct(
    36	        private MessageBusInterface $messageBus,
    37	        private EntityManagerInterface $entityManager,
    38	        private LoggerInterface $logger,
    39	    ) {
    40	    }
    41	
    42	    public function dispatch(
    43	        string $action,
    44	        string $stockChangeId,
    45	        string $productId,
    46	        string $storeId,
    47	        ?int $webhookEventId = null,
    48	        ?int $parentJobId = null,
    49	    ): MessengerJob {
    50	        $Job = new MessengerJob();
    51	        $Job->setMessageClass(SmaregiStockProcessMessage::class);
    52	        $Job->setStatus(MessengerJob::STATUS_PENDING);
    53	        $Job->setParentJobId($parentJobId);
    54	        $Job->setPayloadSummary(sprintf(
    55	            'webhookEventId=%s event=%s action=%s stockChangeId=%s productId=%s storeId=%s',
    56	            $webhookEventId ?? '-',
    57	            StockEventDispatcher::EVENT_NAME,
    58	            $action,
    59	            $stockChangeId,
    60	            $productId,
    61	            $storeId,
    62	        ));
    63	        $this->entityManager->persist($Job);
    64	        $this->entityManager->flush();
    65	
    66	        try {
    67	            $this->messageBus->dispatch(new SmaregiStockProcessMessage(
    68	                (int) $Job->getId(),
    69	                $webhookEventId,
    70	                $action,
    71	                $stockChangeId,
    72	                $productId,
    73	                $storeId,
    74	            ));
    75	        } catch (\Throwable $e) {
    76	            try {
    77	                $Job->setStatus(MessengerJob::STATUS_FAILED);
    78	                $Job->setCompletedAt(new \DateTime());
    79	                $Job->setErrorMessage('メッセージバスへの投入に失敗しました: '.$e->getMessage());
    80	                $this->entityManager->flush();
    81	            } catch (\Throwable $persistError) {
    82	                $this->logger->error('Failed to persist Smaregi stock process job failure state', [
    83	                    'jobId' => $Job->getId(),
    84	                    'webhookEventId' => $webhookEventId,
    85	                    'error' => $persistError->getMessage(),
    86	                ]);
    87	            }
    88	            $this->logger->error('Smaregi stock process message dispatch failed', [
    89	                'exception' => $e,
    90	                'jobId' => $Job->getId(),
    91	                'webhookEventId' => $webhookEventId,
    92	                'action' => $action,
    93	                'stockChangeId' => $stockChangeId,
    94	            ]);
    95	
    96	            throw $e;
    97	        }
    98	
    99	        return $Job;
   100	    }
   101	}
