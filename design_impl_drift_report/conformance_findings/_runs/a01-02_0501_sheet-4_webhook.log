    18	use Doctrine\ORM\QueryBuilder;
    19	use Doctrine\Persistence\ManagerRegistry;
    20	use Eccube\Entity\SmaregiWebhookEvent;
    21	
    22	/**
    23	 * @extends AbstractRepository<SmaregiWebhookEvent>
    24	 */
    25	class SmaregiWebhookEventRepository extends AbstractRepository
    26	{
    27	    public function __construct(ManagerRegistry $registry)
    28	    {
    29	        parent::__construct($registry, SmaregiWebhookEvent::class);
    30	    }
    31	
    32	    /**
    33	     * ステータス別の件数を取得（ダッシュボード用）
    34	     *
    35	     * @return array<string, int> ステータスをキー、件数を値とする配列
    36	     */
    37	    public function getCountsByStatus(): array
    38	    {
    39	        $qb = $this->createQueryBuilder('s')
    40	            ->select('s.status', 'COUNT(s.id) AS cnt')
    41	            ->groupBy('s.status');
    42	
    43	        $result = $qb->getQuery()->getResult();
    44	        $counts = [
    45	            SmaregiWebhookEvent::STATUS_PENDING => 0,
    46	            SmaregiWebhookEvent::STATUS_PROCESSING => 0,
    47	            SmaregiWebhookEvent::STATUS_COMPLETED => 0,
    48	            SmaregiWebhookEvent::STATUS_FAILED => 0,
    49	        ];
    50	        foreach ($result as $row) {
    51	            $counts[$row['status']] = (int) $row['cnt'];
    52	        }
    53	
    54	        return $counts;
    55	    }
    56	
    57	    /**
    58	     * 一覧用の QueryBuilder（作成日時降順）
    59	     */
    60	    public function getQueryBuilderOrderByCreatedAtDesc(): QueryBuilder
    61	    {
    62	        return $this->createQueryBuilder('s')
    63	            ->orderBy('s.createDate', 'DESC');
    64	    }
    65	
    66	    public function findBySmaregiEventId(string $smaregiEventId): ?SmaregiWebhookEvent
    67	    {
    68	        return $this->createQueryBuilder('s')
    69	            ->where('s.smaregiEventId = :smaregiEventId')
    70	            ->setParameter('smaregiEventId', $smaregiEventId)
    71	            ->getQuery()
    72	            ->getOneOrNullResult();
    73	    }
    74	}

