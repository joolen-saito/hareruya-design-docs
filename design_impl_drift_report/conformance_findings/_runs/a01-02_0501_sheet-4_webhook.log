    15	
    16	namespace Eccube\Service\Smaregi\Webhook\Transaction;
    17	
    18	use Doctrine\DBAL\LockMode;
    19	use Doctrine\ORM\EntityManagerInterface;
    20	use Eccube\Dto\Smaregi\Api\Transaction\TransactionDto;
    21	use Eccube\Entity\Customer;
    22	use Eccube\Entity\Order;
    23	use Eccube\Repository\DtbPlayerRepository;
    24	use Eccube\Repository\DtbPointHistoryRepository;
    25	use Eccube\Service\PointService;
    26	use Psr\Log\LoggerInterface;
    27	
    28	/**
    29	 * スマレジ取引 (受注 Webhook) で会員が獲得/使用したポイントを EC-CUBE 会員残高へ反映する。
    30	 *
    31	 * 仕様:
    32	 *  - ポイント付与は「出荷完了 / 引渡し済み」時点 (= Webhook 受信時) に行う。
    33	 *    オンライン注文時点では付与しないため、ECCUBE 購入 (Pattern 1-3) でも二重付与にならない。
    34	 *  - 付与ポイント (`pointGetTotal`) を加算、使用ポイント (`pointUseTotal`) を減算する。
    35	 *    店頭受取のオンライン注文で使われたポイントは EC 側が注文時に減算済みのため、
    36	 *    Webhook の `pointUseTotal` には店頭レジでの使用分のみが乗る前提で二重減算しない。
    37	 *  - 非会員 (Order に Customer が紐付かない) は対象外。
    38	 *  - 冪等性: 同一 `transactionHeadId` のポイント履歴が既にあれば再適用しない
    39	 *    (Webhook 再送・補完取得バッチでの重複付与を防ぐ)。
    40	 *
    41	 * ポイント残高/履歴の更新は共通の {@see PointService} に委譲し、`transactionId` を履歴へ記録する。
    42	 */
    43	final readonly class SmaregiOrderPointApplier
    44	{
    45	    public function __construct(
    46	        private LoggerInterface $logger,
    47	        private EntityManagerInterface $entityManager,
    48	        private PointService $pointService,
    49	        private DtbPointHistoryRepository $pointHistoryRepository,
    50	        private DtbPlayerRepository $playerRepository,
    51	    ) {
    52	    }
    53	
    54	    /**
    55	     * @param Order $order ポイント付与対象の受注 (Pattern 1 は既存オンライン受注、Pattern 2-5/8 は新規受注)
    56	     */
    57	    public function apply(Order $order, TransactionDto $transaction): void
    58	    {
    59	        // 非会員はポイント対象外。
    60	        $customer = $order->getCustomer();
    61	        if (!$customer instanceof Customer) {
    62	            return;
    63	        }
    64	
    65	        $transactionId = $this->resolveTransactionId($transaction);
    66	        if ($transactionId === null) {
    67	            // 取引IDが数値でない場合は冪等性を担保できないため適用しない。
    68	            $this->logger->warning('Smaregi point not applied: transactionHeadId is not numeric', [
    69	                'transactionHeadId' => $transaction->transactionHeadId,
    70	                'orderId' => $order->getId(),
    71	            ]);
    72	
    73	            return;
    74	        }
    75	
    76	        $gained = (int) ($transaction->pointGetTotal ?? 0);
    77	        $spended = (int) ($transaction->pointUseTotal ?? 0);
    78	        if (0 === $gained && 0 === $spended) {
    79	            return;
    80	        }
    81	
    82	        // ポイント残高を持つ会員 (Player) を取得。Player が無ければ PointService 側でも
    83	        // 残高加減算されないため、ロックも適用も行わない。
    84	        $player = $this->playerRepository->findOneByCustomer($customer);
    85	        if ($player === null) {
    86	            $this->logger->warning('Smaregi point not applied: player not found for customer', [
    87	                'transactionHeadId' => $transaction->transactionHeadId,
    88	                'orderId' => $order->getId(),
    89	                'customerId' => $customer->getId(),
    90	            ]);
    91	
    92	            return;
    93	        }
    94	
    95	        // 同一 transactionHeadId の Webhook が並列処理されると existsByTransactionId が両者 false を
    96	        // 見て二重付与し得る。1 取引 = 1 会員のため、残高を持つ Player 行を悲観ロックして直列化し、
    97	        // ロック確立後に冪等性チェック → 付与 → 履歴記録までを同一トランザクションで完了させる。
    98	        $this->entityManager->beginTransaction();
    99	        try {
   100	            $this->entityManager->lock($player, LockMode::PESSIMISTIC_WRITE);
   101	
   102	            // 冪等性: 同一取引のポイント履歴が既にあれば再適用しない (ロック確立後に再確認)。
   103	            if ($this->pointHistoryRepository->existsByTransactionId($transactionId)) {
   104	                $this->entityManager->commit();
   105	                $this->logger->info('Smaregi point already applied for transaction, skipping', [
   106	                    'transactionHeadId' => $transaction->transactionHeadId,
   107	                    'orderId' => $order->getId(),
   108	                ]);
   109	
   110	                return;
   111	            }
   112	
   113	            $order->setGainedPoints($gained);
   114	            $order->setSpendedPoints($spended);
   115	            $this->entityManager->persist($order);
   116	
   117	            $this->pointService->gainPoints($order, $transactionId);
   118	            $this->pointService->spendPoints($order, $transactionId);
   119	            $this->entityManager->flush();
   120	            $this->entityManager->commit();
   121	        } catch (\Throwable $e) {
   122	            if ($this->entityManager->getConnection()->isTransactionActive()) {
   123	                $this->entityManager->rollback();
   124	            }
   125	
   126	            throw $e;
   127	        }
   128	
   129	        $this->logger->info('Smaregi point applied to member', [
   130	            'transactionHeadId' => $transaction->transactionHeadId,
   131	            'orderId' => $order->getId(),
   132	            'gainedPoints' => $gained,
   133	            'spendedPoints' => $spended,
   134	        ]);
   135	    }
   136	
   137	    /**
   138	     * 取引IDを履歴用の int に変換する。数値でなければ null を返す。
   139	     */
   140	    private function resolveTransactionId(TransactionDto $transaction): ?int
   141	    {
   142	        $transactionHeadId = $transaction->transactionHeadId;
   143	        if ($transactionHeadId === null || !ctype_digit($transactionHeadId)) {
   144	            return null;
   145	        }
   146	
   147	        return (int) $transactionHeadId;
   148	    }
   149	}
