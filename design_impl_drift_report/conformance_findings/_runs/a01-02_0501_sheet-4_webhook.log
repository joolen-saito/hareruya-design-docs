    29	use Eccube\Repository\Master\OrderStatusRepository;
    30	use Eccube\Repository\ProductClassRepository;
    31	use Psr\Log\LoggerInterface;
    32	
    33	/**
    34	 * 設計書: スマレジ取引の支払方法は「店頭支払」固定。原価は受信しても保存しない。
    35	 *
    36	 * TODO: 連携用アカウント (システム設定) を更新者にセットする
    37	 * TODO: order_no の採番ルールを確定する
    38	 * TODO: 商品未解決時の挙動 (現状: warningログ出して ProductClass 未リンクで継続) を
    39	 *       設計書「商品未解決 → エラーキューへ退避」に合わせる
    40	 * TODO: canceled/disposed 区分は当該 webhook 実装PRで Order にカラム追加してセットする
    41	 */
    42	final readonly class SmaregiOrderFactory
    43	{
    44	    private const SMAREGI_PAYMENT_METHOD = '店頭支払';
    45	    private const GUEST_NAME01 = '非会員';
    46	    private const GUEST_NAME02 = '';
    47	    private const FALLBACK_BASE_INFO_ID = 1;
    48	
    49	    public function __construct(
    50	        private LoggerInterface $logger,
    51	        private OrderStatusRepository $orderStatusRepository,
    52	        private OrderItemTypeRepository $orderItemTypeRepository,
    53	        private BaseInfoRepository $baseInfoRepository,
    54	        private ProductClassRepository $productClassRepository,
    55	    ) {
    56	    }
    57	
    58	    public function createForGuest(TransactionDto $transaction): Order
    59	    {
    60	        $baseInfo = $this->resolveBaseInfo($transaction->storeId);
    61	
    62	        $order = $this->buildOrderShell($transaction, $baseInfo);
    63	        $order->setName01(self::GUEST_NAME01);
    64	        $order->setName02(self::GUEST_NAME02);
    65	
    66	        foreach ($this->buildOrderItems($transaction, $baseInfo) as $item) {
    67	            $item->setOrder($order);
    68	            $order->addOrderItem($item);
    69	        }
    70	
    71	        return $order;
    72	    }
    73	
    74	    public function createForMember(TransactionDto $transaction, DtbPlayer $player): Order
    75	    {
    76	        $order = $this->createShellForMember($transaction, $player);
    77	        $baseInfo = $order->getBaseInfo();
    78	
    79	        foreach ($this->buildOrderItems($transaction, $baseInfo) as $item) {
    80	            $item->setOrder($order);
    81	            $order->addOrderItem($item);
    82	        }
    83	
    84	        return $order;
    85	    }
    86	
    87	    /**
    88	     * 取引明細を OrderItem として展開せず、ヘッダ (Order shell) のみを作成する。
    89	     *
    90	     * Pattern 2/3 ({@see Handler\Pattern\EccubeOtcPatternHandler})
    91	     * のように、新規受注の明細を「既存受注の OrderItem 複製 + 取引明細から作るついで買い分」で
    92	     * 組み立てたい場合に使う。
    93	     */
    94	    public function createShellForMember(TransactionDto $transaction, DtbPlayer $player): Order
    95	    {
    96	        $baseInfo = $this->resolveBaseInfo($transaction->storeId);
    97	
    98	        $order = $this->buildOrderShell($transaction, $baseInfo);
    99	        $customer = $player->getCustomer();
   100	        $order->setCustomer($customer);
   101	        // 顧客情報が紐付かない (smaregi_id だけ振っていてカスタマー未連結) Player のときは
   102	        // 表示が空にならないよう Player の氏名を fallback として使う。
   103	        $order->setName01($customer?->getName01() ?? $player->getLastNameJp() ?? '');
   104	        $order->setName02($customer?->getName02() ?? $player->getFirstNameJp() ?? '');
   105	
   106	        return $order;
   107	    }
   108	
   109	    public function createShellForGuest(TransactionDto $transaction): Order
   110	    {
   111	        $baseInfo = $this->resolveBaseInfo($transaction->storeId);
   112	
   113	        $order = $this->buildOrderShell($transaction, $baseInfo);
   114	        $order->setName01(self::GUEST_NAME01);
   115	        $order->setName02(self::GUEST_NAME02);
   116	
   117	        return $order;
   118	    }
   119	
   120	    /**
   121	     * 取引明細 1 件から OrderItem を組み立てる。Order への紐付けは呼び出し側で行う。
   122	     */
   123	    public function buildOrderItemFromDetail(TransactionDetailDto $detail, BaseInfo $baseInfo): OrderItem
   124	    {
   125	        $itemType = $this->orderItemTypeRepository->find(OrderItemType::PRODUCT);
   126	        if (!$itemType instanceof OrderItemType) {
   127	            throw new \RuntimeException('OrderItemType PRODUCT is not found.');
   128	        }
   129	
   130	        return $this->buildOrderItem($detail, $itemType, $baseInfo);
   131	    }
   132	
   133	    /**
   134	     * 既存 OrderItem を新規受注用に複製する。Order への紐付けは呼び出し側で行う。
   135	     *
   136	     * Pattern 2/3 で「既存受注の明細を解いて新規受注へ繋ぐ」用途に使う。
   137	     * Shipping は元受注のものに紐付くため意図的に複製しない。
   138	     */
   139	    public function cloneOrderItemForNewOrder(OrderItem $source, BaseInfo $baseInfo): OrderItem
   140	    {
   141	        $itemType = $source->getOrderItemType() ?? $this->orderItemTypeRepository->find(OrderItemType::PRODUCT);
   142	        if (!$itemType instanceof OrderItemType) {
   143	            throw new \RuntimeException('OrderItemType could not be resolved for clone source.');
   144	        }
   145	
   146	        $clone = new OrderItem();
   147	        $clone->setBaseInfo($baseInfo);
   148	        $clone->setOrderItemType($itemType);
   149	        $clone->setProduct($source->getProduct());
   150	        $clone->setProductClass($source->getProductClass());
   151	        $clone->setProductName($source->getProductName());
   152	        $clone->setProductCode($source->getProductCode());
   153	        $clone->setClassName1($source->getClassName1());
   154	        $clone->setClassName2($source->getClassName2());
   155	        $clone->setClassCategoryName1($source->getClassCategoryName1());
   156	        $clone->setClassCategoryName2($source->getClassCategoryName2());
   157	        $clone->setPrice($source->getPrice() ?? '0');
   158	        $clone->setQuantity($source->getQuantity());
   159	        $clone->setTotalCost($source->getTotalCost());
   160	        $clone->setTax($source->getTax());
   161	        $clone->setTaxRate($source->getTaxRate());
   162	        $clone->setTaxAdjust($source->getTaxAdjust());
   163	        $clone->setTaxType($source->getTaxType());
   164	        $clone->setTaxDisplayType($source->getTaxDisplayType());
   165	        $clone->setRoundingType($source->getRoundingType());
   166	
   167	        return $clone;
   168	    }
   169	
   170	    private function buildOrderShell(TransactionDto $transaction, BaseInfo $baseInfo): Order
   171	    {
   172	        $orderStatus = $this->orderStatusRepository->find(OrderStatus::PASSED);
   173	        if (!$orderStatus instanceof OrderStatus) {
   174	            throw new \RuntimeException('OrderStatus PASSED is not found.');
   175	        }
   176	
   177	        $order = new Order($orderStatus);
   178	        $order->setBaseInfo($baseInfo);
   179	        $order->setSmaregiTransactionId($transaction->transactionHeadId);
   180	        $order->setSmaregiMemo($transaction->memo);
   181	        $order->setOrderDate($this->parseDateTime($transaction->terminalTranDateTime) ?? new \DateTime());
   182	        $order->setPaymentMethod(self::SMAREGI_PAYMENT_METHOD);
   183	        $order->setSubtotal($transaction->subtotal ?? '0');
   184	        $order->setTotal($transaction->total ?? '0');
   185	        $order->setPaymentTotal($transaction->total ?? '0');
   186	        // Order.tax は deprecated (Order.php の setTax docblock 参照)。
   187	        // 税額は OrderItem 単位で taxIncludeProportional + taxExcludeProportional から算出する。
   188	        $order->setCouponDiscount($transaction->couponDiscount === null ? null : (int) $transaction->couponDiscount);
   189	        $order->setTaxFree($transaction->taxFreeTotal === null ? null : (int) $transaction->taxFreeTotal);
   190	        $order->setSubtotalDiscountDivision(null);
   191	
   192	        return $order;
   193	    }
   194	
   195	    /**
   196	     * @return list<OrderItem>
   197	     */
   198	    private function buildOrderItems(TransactionDto $transaction, BaseInfo $baseInfo): array
   199	    {
   200	        $itemType = $this->orderItemTypeRepository->find(OrderItemType::PRODUCT);
   201	        if (!$itemType instanceof OrderItemType) {
   202	            throw new \RuntimeException('OrderItemType PRODUCT is not found.');
   203	        }
   204	
   205	        $items = [];
   206	        foreach ($transaction->details as $detail) {
   207	            $items[] = $this->buildOrderItem($detail, $itemType, $baseInfo);
   208	        }
   209	
   210	        return $items;
   211	    }
   212	
   213	    private function buildOrderItem(TransactionDetailDto $detail, OrderItemType $itemType, BaseInfo $baseInfo): OrderItem
   214	    {
   215	        $item = new OrderItem();
   216	        $item->setBaseInfo($baseInfo);
   217	        $item->setOrderItemType($itemType);
   218	        $item->setProductName($detail->productName ?? '');
   219	        $item->setProductCode($detail->productCode);
   220	        $item->setPrice($detail->salesPrice ?? '0');
   221	        $item->setQuantity((string) ($detail->quantity ?? 0));
   222	        $item->setTax($this->calcDetailTax($detail));
   223	
   224	        $productClass = $this->resolveProductClass($detail->productId);
   225	        if ($productClass !== null) {
   226	            $item->setProductClass($productClass);
   227	            $item->setProduct($productClass->getProduct());
   228	        }
   229	
   230	        return $item;
   231	    }
   232	
   233	    /**
   234	     * 明細の税額を Smaregi の按分済み内税/外税から算出する。
   235	     *
   236	     * Smaregi 用語:
   237	     *  - `taxIncludeProportional` = 明細の内税 (税込価格に含まれる税) 按分額
   238	     *  - `taxExcludeProportional` = 明細の外税 (税抜価格に上乗せされた税) 按分額
   239	     * 両者の和がその明細の税額合計となる。
   240	     *
   241	     * いずれか/両方とも未設定 (Smaregi 仕様変更や旧データ) の場合は欠落側を 0 と扱う。
   242	     */
   243	    private function calcDetailTax(TransactionDetailDto $detail): string
   244	    {
   245	        $taxInclude = $detail->taxIncludeProportional !== null ? (int) $detail->taxIncludeProportional : 0;
   246	        $taxExclude = $detail->taxExcludeProportional !== null ? (int) $detail->taxExcludeProportional : 0;
   247	        $tax = $taxInclude + $taxExclude;
   248	        if ($tax < 0) {
   249	            return '0';
   250	        }
   251	
   252	        return (string) $tax;
   253	    }
   254	
   255	    private function resolveProductClass(?string $smaregiProductId): ?ProductClass
   256	    {
   257	        if ($smaregiProductId === null || $smaregiProductId === '') {
   258	            return null;
   259	        }
   260	
