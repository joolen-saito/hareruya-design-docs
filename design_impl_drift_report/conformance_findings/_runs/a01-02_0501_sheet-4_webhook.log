    15	
    16	namespace Eccube\Service\Smaregi\Webhook\Transaction;
    17	
    18	use Eccube\Dto\Smaregi\Api\Transaction\TransactionDto;
    19	use Eccube\Entity\Delivery;
    20	use Eccube\Entity\DtbPlayer;
    21	use Eccube\Entity\Order;
    22	use Eccube\Repository\DtbPlayerRepository;
    23	use Eccube\Repository\OrderRepository;
    24	
    25	/**
    26	 * 既存 EC-CUBE 受注との突合は `Order.smaregi_code` (= スマレジ商品コード) で行う。
    27	 * スマレジ側 `productId` は EC-CUBE に保存していないため、両者で共有可能な共通キーとして
    28	 * `productCode` を採用する。
    29	 *
    30	 * 店頭PC購入 (Pattern 4-7) も店頭受取 (Pattern 2/3) と同じく配送方法=店頭受取で登録されるため、
    31	 * 突合自体は同一クエリで行える。両者の区別は突合した既存受注に紐づく顧客 (Customer) の
    32	 * DtbPlayer の顧客グループが OTC / OTC_SHITEN (店頭販売グループ) か否かで判定する。
    33	 */
    34	final readonly class PurchasePatternContextBuilder
    35	{
    36	    public function __construct(
    37	        private OrderRepository $orderRepository,
    38	        private DtbPlayerRepository $playerRepository,
    39	    ) {
    40	    }
    41	
    42	    public function build(TransactionDto $transaction): PurchasePatternContext
    43	    {
    44	        $transactionProductCodes = $this->extractDistinctProductCodes($transaction);
    45	        $matchedOrders = $transactionProductCodes === []
    46	            ? []
    47	            : $this->orderRepository->findOtcOrdersBySmaregiCodes($transactionProductCodes);
    48	        $matchedSmaregiCodes = $this->collectSmaregiCodes($matchedOrders);
    49	
    50	        $hasEccubePurchase = $matchedOrders !== [];
    51	        $isMember = $this->hasSmaregiCustomerId($transaction);
    52	        // isMember はスマレジ側の会員判定 (customerId の有無) で決める。
    53	        // EC-CUBE 側の Player 解決失敗は OTC_MEMBER ハンドラの fallback に委ね、
    54	        // 「スマレジは会員と言っているが EC-CUBE 未連携」のケースを warning ログで可視化する。
    55	        $member = $isMember ? $this->resolveMember($transaction) : null;
    56	
    57	        return new PurchasePatternContext(
    58	            hasEccubePurchase: $hasEccubePurchase,
    59	            isOtcPcPurchase: $this->isOtcPcPurchase($matchedOrders),
    60	            hasAddOnPurchase: $hasEccubePurchase && $this->hasAddOnPurchase($transactionProductCodes, $matchedSmaregiCodes),
    61	            pickupMethod: $this->resolvePickupMethod($matchedOrders),
    62	            isMember: $isMember,
    63	            matchedOrders: $matchedOrders,
    64	            matchedSmaregiCodes: $matchedSmaregiCodes,
    65	            member: $member,
    66	        );
    67	    }
    68	
    69	    private function hasSmaregiCustomerId(TransactionDto $transaction): bool
    70	    {
    71	        $smaregiCustomerId = $transaction->customerId;
    72	
    73	        return $smaregiCustomerId !== null && $smaregiCustomerId !== '';
    74	    }
    75	
    76	    private function resolveMember(TransactionDto $transaction): ?DtbPlayer
    77	    {
    78	        return $this->playerRepository->findOneBy(['smaregiId' => $transaction->customerId]);
    79	    }
    80	
    81	    /**
    82	     * 突合した既存受注のいずれかが店頭販売グループの顧客の注文であれば店頭PC購入と判定する。
    83	     * 店頭PC購入注文も配送方法は店頭受取で登録されるため、店頭受取 (Pattern 2/3) との区別は
    84	     * 受注に紐づく顧客 (Customer) の DtbPlayer の顧客グループで行う。
    85	     *
    86	     * @param list<Order> $matchedOrders
    87	     */
    88	    private function isOtcPcPurchase(array $matchedOrders): bool
    89	    {
    90	        foreach ($matchedOrders as $order) {
    91	            if ($this->isOtcGroupCustomerOrder($order)) {
    92	                return true;
    93	            }
    94	        }
    95	
    96	        return false;
    97	    }
    98	
    99	    private function isOtcGroupCustomerOrder(Order $order): bool
   100	    {
   101	        $player = $order->getCustomer()?->getPlayer();
   102	
   103	        return $player !== null && $player->isOtcGroupPlayer();
   104	    }
   105	
   106	    /**
   107	     * @return list<string>
   108	     */
   109	    private function extractDistinctProductCodes(TransactionDto $transaction): array
   110	    {
   111	        $codes = [];
   112	        foreach ($transaction->details as $detail) {
   113	            $productCode = $detail->productCode;
   114	            if ($productCode === null || $productCode === '') {
   115	                continue;
   116	            }
   117	            $codes[$productCode] = true;
   118	        }
   119	
   120	        return array_keys($codes);
   121	    }
   122	
   123	    /**
   124	     * @param list<Order> $matchedOrders
   125	     *
   126	     * @return list<string>
   127	     */
   128	    private function collectSmaregiCodes(array $matchedOrders): array
   129	    {
   130	        $codes = [];
   131	        foreach ($matchedOrders as $order) {
   132	            $code = $order->getSmaregiCode();
   133	            if ($code === null || $code === '') {
   134	                continue;
   135	            }
   136	            $codes[$code] = true;
   137	        }
   138	
   139	        return array_keys($codes);
   140	    }
   141	
   142	    /**
   143	     * @param list<Order> $matchedOrders
   144	     */
   145	    private function resolvePickupMethod(array $matchedOrders): PickupMethod
   146	    {
   147	        foreach ($matchedOrders as $order) {
   148	            foreach ($order->getShippings() as $shipping) {
   149	                $delivery = $shipping->getDelivery();
   150	                if ($delivery === null) {
   151	                    continue;
   152	                }
   153	
   154	                $pickupMethod = match ($delivery->getId()) {
   155	                    Delivery::SMOOTH_OTC => PickupMethod::SMOOTH_OTC,
   156	                    Delivery::OTC => PickupMethod::OTC,
   157	                    default => null,
   158	                };
   159	                if ($pickupMethod !== null) {
   160	                    return $pickupMethod;
   161	                }
   162	            }
   163	        }
   164	
   165	        return PickupMethod::NONE;
   166	    }
   167	
   168	    /**
   169	     * 取引明細の productCode のうち、matchedSmaregiCodes に含まれないものが 1 件でもあればついで買い有り。
   170	     *
   171	     * @param list<string> $transactionProductCodes
   172	     * @param list<string> $matchedSmaregiCodes
   173	     */
   174	    private function hasAddOnPurchase(array $transactionProductCodes, array $matchedSmaregiCodes): bool
   175	    {
   176	        $matchedLookup = array_flip($matchedSmaregiCodes);
   177	        foreach ($transactionProductCodes as $code) {
   178	            if (!isset($matchedLookup[$code])) {
   179	                return true;
   180	            }
   181	        }
   182	
   183	        return false;
   184	    }
   185	}
