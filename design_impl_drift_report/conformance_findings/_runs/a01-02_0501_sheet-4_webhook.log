    16	namespace Eccube\MessageHandler;
    17	
    18	use Doctrine\ORM\EntityManagerInterface;
    19	use Eccube\Entity\MessengerJob;
    20	use Eccube\Message\SmaregiStockProcessMessage;
    21	use Eccube\Repository\MessengerJobRepository;
    22	use Eccube\Service\Smaregi\Api\SmaregiAccessTokenService;
    23	use Eccube\Service\Smaregi\Api\SmaregiMessengerJobContext;
    24	use Eccube\Service\Smaregi\Api\SmaregiStockApiClient;
    25	use Eccube\Service\Smaregi\SmaregiMessengerJobProcessingLock;
    26	use Eccube\Service\Smaregi\Webhook\Stock\SmaregiStockChangeApplier;
    27	use Psr\Log\LoggerInterface;
    28	use Symfony\Component\Messenger\Attribute\AsMessageHandler;
    29	
    30	/**
    31	 * スマレジ在庫変動 (pos:stock) の取り込みを 1 子ジョブ (= 在庫変動履歴 1 件) として消化する MessageHandler。
    32	 *
    33	 * 在庫変動履歴をスマレジ API から取得し、{@see SmaregiStockChangeApplier} で EC-CUBE のスマレジ在庫(区分2)・
    34	 * 在庫履歴へ反映する。在庫行の更新は競合を防ぐため悲観ロックのうえトランザクション内で行う。
    35	 */
    36	#[AsMessageHandler]
    37	final readonly class SmaregiStockProcessMessageHandler
    38	{
    39	    public function __construct(
    40	        private LoggerInterface $logger,
    41	        private EntityManagerInterface $entityManager,
    42	        private SmaregiMessengerJobProcessingLock $smaregiMessengerJobProcessingLock,
    43	        private MessengerJobRepository $messengerJobRepository,
    44	        private SmaregiMessengerJobContext $smaregiMessengerJobContext,
    45	        private SmaregiAccessTokenService $accessTokenService,
    46	        private SmaregiStockApiClient $stockApiClient,
    47	        private SmaregiStockChangeApplier $stockChangeApplier,
    48	        private string $smaregiApiIdUrl,
    49	        private string $smaregiApiUrl,
    50	        private string $smaregiApiClientId,
    51	        private string $smaregiApiClientSecret,
    52	        private string $smaregiApiContractId,
    53	    ) {
    54	    }
    55	
    56	    public function __invoke(SmaregiStockProcessMessage $message): void
    57	    {
    58	        $Job = $this->messengerJobRepository->find($message->getJobId());
    59	        if (!$Job instanceof MessengerJob) {
    60	            $this->logger->error('Smaregi stock process job not found', [
    61	                'jobId' => $message->getJobId(),
    62	            ]);
    63	
    64	            return;
    65	        }
    66	
    67	        // スマレジ API 呼び出しログを当該子ジョブに紐付けるため、コンテキストへ jobId を設定する。
    68	        $this->smaregiMessengerJobContext->setJobId((int) $Job->getId());
    69	
    70	        try {
    71	            // 悲観ロック + PENDING/FAILED のときのみ PROCESSING へ遷移し、重複実行を抑止する。
    72	            if (!$this->smaregiMessengerJobProcessingLock->tryBeginProcessingJob($Job)) {
    73	                return;
    74	            }
    75	
    76	            $response = $this->fetchStockChange($message);
    77	
    78	            // 在庫行の悲観ロックを取得するためトランザクション内で反映し、在庫更新・履歴登録・ジョブ完了を一括確定する。
    79	            $this->entityManager->beginTransaction();
    80	            try {
    81	                $this->stockChangeApplier->apply($message, $response['json']);
    82	
    83	                $Job->setStatus(MessengerJob::STATUS_COMPLETED);
    84	                $Job->setCompletedAt(new \DateTime());
    85	                $Job->setErrorMessage(null);
    86	                $this->entityManager->flush();
    87	                $this->entityManager->commit();
    88	            } catch (\Throwable $e) {
    89	                if ($this->entityManager->getConnection()->isTransactionActive()) {
    90	                    $this->entityManager->rollback();
    91	                }
    92	
    93	                throw $e;
    94	            }
    95	        } catch (\Throwable $e) {
    96	            $this->logger->warning('Smaregi stock process job failed', [
    97	                'jobId' => $Job->getId(),
    98	                'webhookEventId' => $message->getSmaregiWebhookEventId(),
    99	                'action' => $message->getAction(),
   100	                'stockChangeId' => $message->getStockChangeId(),
   101	                'error' => $e->getMessage(),
   102	            ]);
   103	            $this->failJob($Job, $e);
   104	
   105	            throw $e;
   106	        } finally {
   107	            $this->smaregiMessengerJobContext->clear();
   108	        }
   109	    }
   110	
   111	    /**
   112	     * 在庫変動履歴 1 件をスマレジ API から取得する。
   113	     *
   114	     * 2xx 以外は後続バッチ / リトライで回収できるよう例外を投げてジョブを FAILED にする。
   115	     *
   116	     * @return array{statusCode:int,headers:array<string,array<string>>,body:string,json:array<string,mixed>|array<int,array<string,mixed>>|null}
   117	     */
   118	    private function fetchStockChange(SmaregiStockProcessMessage $message): array
   119	    {
   120	        $accessToken = $this->accessTokenService->getAccessToken(
   121	            $this->smaregiApiIdUrl,
   122	            $this->smaregiApiContractId,
   123	            $this->smaregiApiClientId,
   124	            $this->smaregiApiClientSecret,
   125	        );
   126	
   127	        $response = $this->stockApiClient->getStockChange(
   128	            $this->smaregiApiUrl,
   129	            $this->smaregiApiContractId,
   130	            $accessToken,
   131	            $message->getStockChangeId(),
   132	            $message->getProductId(),
   133	            $message->getStoreId(),
   134	        );
   135	
   136	        $statusCode = $response['statusCode'];
   137	        if ($statusCode < 200 || $statusCode >= 300) {
   138	            throw new \RuntimeException(sprintf('Failed to fetch Smaregi stock change (stockChangeId=%s, statusCode=%d)', $message->getStockChangeId(), $statusCode));
   139	        }
   140	
   141	        return $response;
   142	    }
   143	
   144	    private function failJob(MessengerJob $Job, \Throwable $e): void
   145	    {
   146	        try {
   147	            $Job->setStatus(MessengerJob::STATUS_FAILED);
   148	            $Job->setCompletedAt(new \DateTime());
   149	            $Job->setErrorMessage($e->getMessage());
   150	            $this->entityManager->flush();
   151	        } catch (\Throwable $persistError) {
   152	            $this->logger->error('Failed to persist Smaregi stock process job failure state', [
   153	                'jobId' => $Job->getId(),
   154	                'error' => $persistError->getMessage(),
   155	            ]);
   156	        }
   157	    }
   158	}
