    15	
    16	namespace Eccube\Service\Smaregi\Webhook\Transaction;
    17	
    18	use Doctrine\DBAL\LockMode;
    19	use Doctrine\ORM\EntityManagerInterface;
    20	use Eccube\Dto\Smaregi\Api\Transaction\TransactionDto;
    21	use Eccube\Entity\Customer;
    22	use Eccube\Entity\Master\MtbPointType;
    23	use Eccube\Repository\DtbPlayerRepository;
    24	use Eccube\Repository\DtbPointHistoryRepository;
    25	use Eccube\Repository\Master\MtbPointTypeRepository;
    26	use Eccube\Service\EntityManager\PointHistoryEntityManager;
    27	use Psr\Log\LoggerInterface;
    28	
    29	/**
    30	 * スマレジ取引区分6 (ポイント加算) / 7 (ポイント減算) の「ポイント専用取引」を
    31	 * EC-CUBE 会員ポイント残高へ反映する。
    32	 *
    33	 * 通常購入 (取引区分1) と異なり商品明細を持たず受注作成パターンに乗らないため、
    34	 * {@see \Eccube\MessageHandler\SmaregiTransactionProcessMessageHandler} の created 処理で
    35	 * 受注を作らずに本サービスへ分岐させる。
    36	 *
    37	 * 仕様:
    38	 *  - 区分6: 付与ポイント (`pointGetTotal`) を加算。
    39	 *  - 区分7: 使用ポイント (`pointUseTotal`) を減算。
    40	 *  - 会員 (customerId → DtbPlayer) に紐付かない取引は対象外。
    41	 *  - 冪等性: 同一 `transactionHeadId` のポイント履歴が既にあれば再適用しない。
    42	 *  - 履歴種別はスマレジ由来ポイントとして {@see MtbPointType::PURCHASE_TYPE} で統一する。
    43	 */
    44	final readonly class SmaregiPointAdjustmentApplier
    45	{
    46	    private const DIVISION_POINT_ADD = '6';
    47	
    48	    private const DIVISION_POINT_SUBTRACT = '7';
    49	
    50	    public function __construct(
    51	        private LoggerInterface $logger,
    52	        private EntityManagerInterface $entityManager,
    53	        private DtbPlayerRepository $playerRepository,
    54	        private DtbPointHistoryRepository $pointHistoryRepository,
    55	        private MtbPointTypeRepository $pointTypeRepository,
    56	        private PointHistoryEntityManager $pointHistoryEntityManager,
    57	    ) {
    58	    }
    59	
    60	    /**
    61	     * 取引がポイント専用取引 (区分6/7) かどうか。
    62	     */
    63	    public function supports(TransactionDto $transaction): bool
    64	    {
    65	        return in_array(
    66	            $transaction->transactionHeadDivision,
    67	            [self::DIVISION_POINT_ADD, self::DIVISION_POINT_SUBTRACT],
    68	            true,
    69	        );
    70	    }
    71	
    72	    public function apply(TransactionDto $transaction): void
    73	    {
    74	        if (!$this->supports($transaction)) {
    75	            return;
    76	        }
    77	
    78	        $customerId = $transaction->customerId;
    79	        if ($customerId === null || $customerId === '') {
    80	            // ポイントは会員にしか紐付かないため、会員IDが無い取引は対象外。
    81	            $this->logger->warning('Smaregi point adjustment skipped: transaction has no customerId', [
    82	                'transactionHeadId' => $transaction->transactionHeadId,
    83	                'division' => $transaction->transactionHeadDivision,
    84	            ]);
    85	
    86	            return;
    87	        }
    88	
    89	        $player = $this->playerRepository->findOneBy(['smaregiId' => $customerId]);
    90	        $customer = $player?->getCustomer();
    91	        if ($player === null || !$customer instanceof Customer) {
    92	            $this->logger->warning('Smaregi point adjustment skipped: member not resolved', [
    93	                'transactionHeadId' => $transaction->transactionHeadId,
    94	                'customerId' => $customerId,
    95	            ]);
    96	
    97	            return;
    98	        }
    99	
   100	        $transactionId = $this->resolveTransactionId($transaction);
   101	        if ($transactionId === null) {
   102	            // 取引IDが数値でない場合は冪等性を担保できないため適用しない。
   103	            $this->logger->warning('Smaregi point adjustment skipped: transactionHeadId is not numeric', [
   104	                'transactionHeadId' => $transaction->transactionHeadId,
   105	            ]);
   106	
   107	            return;
   108	        }
   109	
   110	        $pointChange = $this->resolvePointChange($transaction);
   111	        if (0 === $pointChange) {
   112	            return;
   113	        }
   114	
   115	        // 同一 transactionHeadId の Webhook が並列処理されると existsByTransactionId が両者 false を
   116	        // 見て二重適用し得る。残高を持つ Player 行を悲観ロックして直列化し、ロック確立後に
   117	        // 冪等性チェック → 残高更新 → 履歴記録までを同一トランザクションで完了させる。
   118	        $this->entityManager->beginTransaction();
   119	        try {
   120	            $this->entityManager->lock($player, LockMode::PESSIMISTIC_WRITE);
   121	
   122	            // 冪等性: 同一取引のポイント履歴が既にあれば再適用しない (ロック確立後に再確認)。
   123	            if ($this->pointHistoryRepository->existsByTransactionId($transactionId)) {
   124	                $this->entityManager->commit();
   125	                $this->logger->info('Smaregi point adjustment already applied for transaction, skipping', [
   126	                    'transactionHeadId' => $transaction->transactionHeadId,
   127	                ]);
   128	
   129	                return;
   130	            }
   131	
   132	            $player->setPoint($player->getPoint() + $pointChange);
   133	            $this->entityManager->persist($player);
   134	
   135	            $pointType = $this->pointTypeRepository->find(MtbPointType::PURCHASE_TYPE);
   136	            $this->pointHistoryEntityManager->save(
   137	                null,
   138	                $customer,
   139	                null,
   140	                $pointType,
   141	                $pointChange,
   142	                null,
   143	                new \DateTime(),
   144	                $transactionId,
   145	            );
   146	            $this->entityManager->flush();
   147	            $this->entityManager->commit();
   148	        } catch (\Throwable $e) {
   149	            if ($this->entityManager->getConnection()->isTransactionActive()) {
   150	                $this->entityManager->rollback();
   151	            }
   152	
   153	            throw $e;
   154	        }
   155	
   156	        $this->logger->info('Smaregi point adjustment applied to member', [
   157	            'transactionHeadId' => $transaction->transactionHeadId,
   158	            'division' => $transaction->transactionHeadDivision,
   159	            'pointChange' => $pointChange,
   160	            'playerId' => $player->getId(),
   161	        ]);
   162	    }
   163	
   164	    /**
   165	     * 区分6は付与ポイントを加算、区分7は使用ポイントを減算する。
   166	     */
   167	    private function resolvePointChange(TransactionDto $transaction): int
   168	    {
   169	        return match ($transaction->transactionHeadDivision) {
   170	            self::DIVISION_POINT_ADD => (int) ($transaction->pointGetTotal ?? 0),
   171	            self::DIVISION_POINT_SUBTRACT => -(int) ($transaction->pointUseTotal ?? 0),
   172	            default => 0,
   173	        };
   174	    }
   175	
   176	    /**
   177	     * 取引IDを履歴用の int に変換する。数値でなければ null を返す。
   178	     */
   179	    private function resolveTransactionId(TransactionDto $transaction): ?int
   180	    {
   181	        $transactionHeadId = $transaction->transactionHeadId;
   182	        if ($transactionHeadId === null || !ctype_digit($transactionHeadId)) {
   183	            return null;
   184	        }
   185	
   186	        return (int) $transactionHeadId;
   187	    }
   188	}
