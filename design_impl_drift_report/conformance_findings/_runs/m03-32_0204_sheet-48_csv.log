   117	use Eccube\Service\Csv\Importer\Model\CsvValueInterface;
   118	
   119	/**
   120	 * 数値項目に対し、文字の長さを検証する ValidatorInterface 実装。
   121	 */
   122	class NumericMaxLengthValidator implements ValidatorInterface
   123	{
   124	    use ValidatorTrait;
   125	
   126	    /** @var int 最大の長さ */
   127	    private int $maxLength;
   128	
   129	    /**
   130	     * @param int $maxLength 最大の長さ
   131	     */
   132	    public function __construct(int $maxLength)
   133	    {
   134	        $this->maxLength = $maxLength;
   135	    }
   136	
   137	    /**
   138	     * @param MessageStore $errors エラーメッセージの格納先
   139	     * @param CsvValueInterface $value 検証する値
   140	     *
   141	     * @return bool $value が空ではない場合 true
   142	     */
   143	    public function validate(MessageStore $errors, CsvValueInterface $value): bool
   144	    {
   145	        if (!$value->hasValue()) {
   146	            // 未入力の場合はチェックしない
   147	            return true;
   148	        }
   149	
   150	        $validator = function ($value) {
   151	            return strlen($value) <= $this->maxLength;
   152	        };
   153	
   154	        if (!$value->validate($validator)) {
   155	            // message.yml に数値向けのメッセージしかないので、本クラスも数値専用になっている。
   156	            $errors->addNumericMaxLengthError(
   157	                $value->getRowNumber(),
   158	                $value->getLabel(),
   159	                $this->maxLength
   160	            );
   161	
   162	            return false;
   163	        }
   164	
   165	        return true;
   166	    }
   167	}

