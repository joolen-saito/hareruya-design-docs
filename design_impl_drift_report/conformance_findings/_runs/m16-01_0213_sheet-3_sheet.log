    34	    public function handle(TopBannerStoreInput $input): void
    35	    {
    36	        $form = $input->getForm();
    37	        $TopBanners = $input->getTopBanners();
    38	
    39	        $sortedBannerList = $this->buildSortedBannerList($form, $TopBanners);
    40	        if ($sortedBannerList === []) {
    41	            return;
    42	        }
    43	
    44	        $this->entityManager->beginTransaction();
    45	        try {
    46	            $position = 1;
    47	            foreach ($TopBanners as $TopBanner) {
    48	                if (!isset($sortedBannerList[$position])) {
    49	                    $position++;
    50	                    continue;
    51	                }
    52	                $sortNo = $position;
    53	                $sorted = $sortedBannerList[$position++];
    54	                $imageUrl = trim((string) ($form->get($sorted['image'])->getData() ?? ''));
    55	                $link = trim((string) ($form->get($sorted['link'])->getData() ?? ''));
    56	                $dispType = (int) ($form->get($sorted['dispType'])->getData() ?? MtbTopBanner::HIDE_BOTH);
    57	                if ($imageUrl === '') {
    58	                    $dispType = MtbTopBanner::HIDE_BOTH;
    59	                }
    60	                $imageAlt = (string) ($form->get($sorted['imageAlt'])->getData() ?? '');
    61	                $languageIds = $form->get($sorted['languages'])->getData() ?? [];
    62	
    63	                $Languages = $this->languageRepository->findBy(['id' => $languageIds], ['id' => 'ASC']);
    64	
    65	                $this->topBannerEntityManager->save(
    66	                    $TopBanner,
    67	                    $imageUrl,
    68	                    $link,
    69	                    $dispType,
    70	                    new ArrayCollection($Languages),
    71	                    $imageAlt,
    72	                    $sortNo,
    73	                );
    74	            }
    75	
    76	            $this->entityManager->flush();
    77	            $this->entityManager->commit();
    78	        } catch (\Throwable $e) {
    79	            $this->entityManager->rollback();
    80	            throw $e;
    81	        }
    82	    }
