    98	                'languages' => 'language_'.$TopBanner->getId(),
    99	                'imageAlt' => 'image_alt_'.$TopBanner->getId(),
   100	            ];
   101	        }
   102	
   103	        if ($sortedBannerList === []) {
   104	            return [];
   105	        }
   106	
   107	        ksort($sortedBannerList);
   108	
   109	        return array_combine(range(1, count($sortedBannerList)), $sortedBannerList);
