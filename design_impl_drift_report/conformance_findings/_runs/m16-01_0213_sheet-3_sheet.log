    46	        } catch (\Throwable) {
    47	            return [];
    48	        }
    49	        if ($files === []) {
    50	            return [];
    51	        }
    52	
    53	        $cdn = $this->cdnManager->getCDN();
    54	        $cdnBaseUrl = rtrim((string) $this->parameterBag->get('cdn_base_url'), '/');
    55	        $s3Endpoint = rtrim((string) $this->parameterBag->get('s3_endpoint'), '/');
    56	        $bucket = (string) $this->parameterBag->get('aws_s3_bucket');
    57	        $baseUrl = $cdnBaseUrl !== '' ? $cdnBaseUrl : $s3Endpoint.'/'.$bucket;
    58	
    59	        $fileList = [];
    60	        foreach ($files as $file) {
    61	            $key = (string) ($file['Key'] ?? '');
    62	            if ($key === '') {
    63	                continue;
    64	            }
    65	            $publicUrl = $cdn !== null
    66	                ? $cdn->CloudStorageLinkToCDNLink($key)
    67	                : $baseUrl.'/'.ltrim($key, '/');
    68	            $fileList[] = [
    69	                'key' => $key,
    70	                'publicUrl' => $publicUrl,
    71	                'lastModified' => $file['LastModified'] ?? null,
    72	            ];
    73	        }
    74	
    75	        usort($fileList, static function (array $left, array $right): int {
    76	            $leftTime = $left['lastModified'] instanceof \DateTimeInterface ? $left['lastModified']->getTimestamp() : 0;
    77	            $rightTime = $right['lastModified'] instanceof \DateTimeInterface ? $right['lastModified']->getTimestamp() : 0;
    78	
    79	            return $rightTime <=> $leftTime;
    80	        });
    81	
    82	        return array_slice($fileList, 0, self::MAX_LIST_COUNT);
    83	    }
    84	}
