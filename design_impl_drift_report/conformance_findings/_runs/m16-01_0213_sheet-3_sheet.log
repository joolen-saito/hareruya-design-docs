    23	class TopBannerUploadAction
    24	{
    25	    private const TOP_BANNER_S3_DIRECTORY = 'banner/top';
    26	
    27	    public function __construct(
    28	        private readonly FileManager $fileManager,
    29	    ) {
    30	    }
    31	
    32	    /**
    33	     * @return array{publicUrl: string, objectKey: string}
    34	     */
    35	    public function handle(TopBannerUploadInput $input): array
    36	    {
    37	        $file = $input->getFile();
    38	        $Member = $input->getMember();
    39	        $BaseInfo = $input->getBaseInfo();
    40	        if ($BaseInfo !== null && !$Member->isEditableShop($BaseInfo)) {
    41	            throw new \RuntimeException('admin.data.top_banner.upload_not_allowed');
    42	        }
    43	
    44	        $filename = $this->buildFileName($file);
    45	        $uploadDirectory = $this->buildUploadDirectory($BaseInfo);
    46	
    47	        $fileAdapter = $this->fileManager->getAdapter();
    48	        $publicUrl = $fileAdapter->upload($file->getPathname(), $uploadDirectory, $filename);
    49	        $entitySaveData = $fileAdapter->toEntitySaveData();
    50	
    51	        return [
    52	            'publicUrl' => $publicUrl,
    53	            'objectKey' => (string) ($entitySaveData['s3_object_key'] ?? ''),
    54	        ];
    55	    }
    56	
    57	    private function buildFileName(UploadedFile $file): string
    58	    {
    59	        $extension = $file->getClientOriginalExtension();
    60	        if ($extension === '') {
    61	            $extension = (string) $file->guessExtension();
    62	        }
    63	        if ($extension === '') {
    64	            $extension = 'jpg';
    65	        }
    66	
    67	        return date('mdHis').uniqid('_').'.'.strtolower($extension);
    68	    }
    69	
    70	    private function buildUploadDirectory(?BaseInfo $BaseInfo): string
    71	    {
    72	        if ($BaseInfo === null) {
    73	            return self::TOP_BANNER_S3_DIRECTORY;
    74	        }
    75	
    76	        $shopDigit = strtolower($BaseInfo->getShopDigit());
    77	        if ($shopDigit === '') {
    78	            return self::TOP_BANNER_S3_DIRECTORY;
    79	        }
    80	
    81	        return self::TOP_BANNER_S3_DIRECTORY.'/'.$shopDigit;
    82	    }
    83	}
