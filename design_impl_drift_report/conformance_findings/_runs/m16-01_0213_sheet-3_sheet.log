    88	     */
    89	    private function buildSortedBannerList(mixed $form, iterable $TopBanners): array
    90	    {
    91	        $sortedBannerList = [];
    92	        foreach ($TopBanners as $TopBanner) {
    93	            $sortNo = (int) $form->get('sort_no_'.$TopBanner->getId())->getData();
    94	            $sortedBannerList[$sortNo] = [
