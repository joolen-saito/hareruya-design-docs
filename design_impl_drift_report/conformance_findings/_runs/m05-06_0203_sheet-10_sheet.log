    /**
     * 一括手動メール通知
     *
     * @param Request $request
     * @param int $templateId
     *
     * @return Response
     */
    #[Route(path: '/%eccube_admin_route%/order/manual_mail/mail_all', name: 'admin_order_manual_mail_all', methods: ['GET'])]
    #[Route(path: '/%eccube_admin_route%/order/manual_mail/mail_all/{templateId}', name: 'admin_order_manual_mail_all_edit', requirements: ['templateId' => '\d+'], methods: ['GET', 'POST'])]
    #[Template(template: '@admin/Order/manual_mail_all.twig')]
    public function manualMailAll(Request $request, $templateId = null)
    {
        $shippingIds = $request->get('ids', []);
        if (!is_array($shippingIds) || $shippingIds === []) {
            throw new NotFoundHttpException();
        }

        // 配送IDの存在チェックを先に行う
        $Shippings = $this->shippingRepository->findBy(['id' => $shippingIds]);
        $foundShippingIds = array_map(fn ($Shipping) => $Shipping->getId(), $Shippings);
        $missingShippingIds = array_diff($shippingIds, $foundShippingIds);
        if ($missingShippingIds !== []) {
            foreach ($missingShippingIds as $missingId) {
                $this->addError(
                    sprintf($this->translator->trans('admin.order.mail_all.error.missing'), $missingId),
                    'admin'
                );
            }

            return $this->redirectToRoute('admin_order');
        }

        // 注文IDの重複を排除
        $orderIds = array_unique(
            array_map(fn ($Shipping) => $Shipping->getOrder()->getId(), $Shippings)
        );
        $Orders = $this->orderRepository->findBy(['id' => $orderIds]);

        // 注文番号を取得
        $orderNumbers = OrderUtil::getOrderNumbers($this->orderRepository, $orderIds);

        $mail = null;
        $templateBody = '';
        if ($templateId) {
            $mail = $this->getManualMailTemplate($templateId);
            $source = $this->twig->getLoader()->getSourceContext($mail->getFileName())->getCode();
            $templateBody = $this->mailService->replaceBody($source, $mail);
        }

        $form = $this->formFactory
        ->createBuilder(OrderManualMailAllType::class, $mail, [
            'autoMail' => false,
            'baseFiles' => [
                MailTemplate::BASE_SELL_ORDER,
                MailTemplate::BASE_SELL_ORDER_EN,
                MailTemplate::BASE_NO_BASE,
            ],
        ])
        ->getForm();

        if ($mail) {
            $form->get('template')->setData($mail);
            $form->get('subject')->setData($mail->getMailSubject());
        }

        if ('POST' === $request->getMethod()) {
            $form->handleRequest($request);
            $mode = $request->get('mode');

            $header = $form->get('header')->getData();
            $footer = $form->get('footer')->getData();

            switch ($mode) {
                // 確認画面
                case 'confirm':
                    if ($form->isSubmitted() && $form->isValid() && $mail) {
                        $firstOrder = reset($Orders) ?: null;
                        $previewBody = $firstOrder
                            ? $this->createManualBody($mail, $firstOrder, $header, $footer)
                            : '';

                        return $this->render('@admin/Order/manual_mail_all_confirm.twig', [
                            'form' => $form->createView(),
                            'id' => $templateId,
                            'Orders' => $Orders,
                            'firstOrder' => $firstOrder,
                            'previewSubject' => $form->get('subject')->getData(),
                            'previewBody' => $previewBody,
                            'mail' => $mail,
                            'orderNumbers' => $orderNumbers,
                            'shippingIds' => $shippingIds,
                        ]);
                    }
                    break;
                    // 送信する
                case 'complete':
                    if ($form->isSubmitted() && $form->isValid() && $mail) {
                        foreach ($Orders as $Order) {
                            $body = $this->createManualBody($mail, $Order, $header, $footer);
                            $this->mailService->sendManualMailForBulk($Order, $mail, $body, $request->request->all());
                        }

                        $this->addSuccess('admin.order.mail_send_complete', 'admin');

                        return $this->redirectToRoute('admin_order');
                    }
                    break;
            }
        }

        return $this->render('@admin/Order/manual_mail_all.twig', [
            'form' => $form->createView(),
            'id' => $templateId,
            'Orders' => $Orders,
            'body' => $templateBody,
            'mail' => $mail,
            'orderNumbers' => $orderNumbers,
            'shippingIds' => $shippingIds,
        ]);
    }

    /**
     * 手動メールテンプレートを取得
     *
     * @param int $templateId
     *
     * @return MailTemplate
     */
    private function getManualMailTemplate(int $templateId): MailTemplate
    {
        $criteria = new Criteria();
        $criteria->andWhere($criteria->expr()->eq('id', $templateId))
            ->andWhere($criteria->expr()->in('file_name', [
                MailTemplate::BASE_FILES[MailTemplate::BASE_SELL_ORDER],
                MailTemplate::BASE_FILES[MailTemplate::BASE_SELL_ORDER_EN],
                MailTemplate::BASE_FILES[MailTemplate::BASE_NO_BASE],
            ]));

        $mail = $this->mailTemplateRepository->matching($criteria)->first();
        if (!$mail) {
            throw new NotFoundHttpException();
        }

        return $mail;
    }

