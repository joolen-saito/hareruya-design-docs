   166	        public function getTaxableItems(): array
   167	        {
   168	            $Items = [];
   169	
   170	            foreach ($this->OrderItems as $Item) {
   171	                if (null === $Item->getTaxType()) {
   172	                    continue;
   173	                }
   174	
   175	                if ($Item->getTaxType()->getId() == TaxType::TAXATION) {
   176	                    $Items[] = $Item;
   177	                }
   178	            }
   179	
   180	            return $Items;
   181	        }
