{% extends '@admin/default_frame.twig' %}

{% set menus = ['order', 'order_master'] %}

{% block title %}{{ 'admin.order.order_management'|trans }}{% endblock %}
{% block sub_title %}{{ 'admin.order.manual_mail'|trans }}{% endblock %}

{% form_theme form '@admin/Form/bootstrap_4_horizontal_layout.html.twig' %}

{% block stylesheet %}
    {{ parent() }}
    <style>
        body[id^="page_admin_order_manual_mail_all"] .c-pageTitle__titles {
            display: flex;
            align-items: center;
            width: 100%;
        }

        body[id^="page_admin_order_manual_mail_all"] .c-pageTitle__subTitle {
            display: flex;
            flex: 1;
            align-items: center;
        }
    </style>
{% endblock %}

{% block javascript %}
    <script nonce="{{ csp_nonce }}">
        $(function(){
            $("#mail_template").on("change", function(){
                var templateId = $(this).val();
                var params = '';
                $('[id^=ids_]').each(function (id, elm) {
                    params += 'ids%5B%5D=' + $(this).attr('value') + '&';
                });
                if (templateId) {
                    location.href = '{{ path('admin_order_manual_mail_all_edit', {'templateId': 0}) }}'.replace(/\/0$/, '/' + templateId) + '?' + params;
                } else {
                    location.href = '{{ path('admin_order_manual_mail_all') }}?' + params;
                }
            });
        });
    </script>
{% endblock javascript%}

{% block main %}
    <form name="form1" role="form" class="form-horizontal" id="form1" method="post" action="">
        {{ form_widget(form._token) }}
        <input type="hidden" name="mail[header]" value="{{ mail ? mail.header : '' }}">
        <input type="hidden" name="mail[footer]" value="{{ mail ? mail.footer : '' }}">
        <div class="c-contentsArea__cols">
            <div class="c-contentsArea__primaryCol">
                <div class="c-primaryCol">
                    <div class="card rounded border-0 mb-4">
                        <div class="card-header">
                            <div class="row">
                                <div class="col-8">
                                    <div class="d-inline-block">
                                    <span class="card-title">
                                        {{ 'admin.order.manual_mail.box_title'|trans }}
                                    </span> 
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="card-header">
                            <div class="row">
                                <div class="col mb-4">
                                    <div class="d-inline-block" >
                                    <span class="card-title">
                                        <div id="order_info">
                                            {{ 'admin.order.manual_mail_all'|trans }}
                                        </div>
                                    </span> 
                                    </div>
                                </div>
                            </div>

                            {{ form_row(form.template) }}
                            {{ form_row(form.subject) }}
                        </div>
                        <div class="card-body">
                            <div id="mail_edit_box__body" class="row mb-3 form-group">
                                <label class="col-sm-2 col-form-label">{{ 'admin.order.manual_mail_body'|trans }}
</label>
                                <div class="col-sm-10">
                                    <div class="mt-2">{{ body|raw }}</div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>      

            <div class="c-contentsArea__secondaryCol">
                <div class="c-secondaryCol">
                    <div class="card rounded border-0 mb-4">
                        <div class="card-body">
                            <div id="common_info_box" class="box">
                                <div id="common_info_box__header" class="box-header">
                                    {{ 'admin.order.manual_mail_destination_info'|trans }}
                                </div>
                                <div id="common_info_box__body" class="box-body">
                                    <table class="table table-striped">
                                        <thead>
                                            <tr>
                                                <th>{{ 'admin.order.order_number'|trans }}</th>
                                                <th>{{ 'admin.order.orderer_name'|trans }}
</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            {% for Order in Orders %}
                                                <tr>
                                                    <td>
                                                        {{ attribute(orderNumbers, Order.id) }}
                                                        {% for Shipping in Order.Shippings %}
                                                            {% if Shipping.id in shippingIds %}
                                                                <input type="hidden" id="ids_{{ Shipping.id }}" name="ids[]" value="{{ Shipping.id }}">
                                                            {% endif %}
                                                        {% endfor %}
                                                    </td>
                                                    <td>
                                                        {{ Order.customer.name01 }} {{ Order.customer.name02 }}
                                                    </td>
                                                </tr>
                                            {% endfor %}
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="c-conversionArea">
            <div class="c-conversionArea__container">
                <div class="row justify-content-between align-items-center">
                    <div class="col-6">
                        <div class="c-conversionArea__leftBlockItem">

                            <a class="c-baseLink"
                               href="{{ path('admin_order', { page_no : app.session.get('eccube.admin.order.search.page_no')|default('1') } ) }}"
                               data-action="confirm"
                               title="{{ 'admin.common.move_to_confirm_message'|trans({'%name%' : 'admin.order.order_list'|trans }) }}">
                                <i class="fa fa-backward"
                                   aria-hidden="true"></i><span>{{ 'admin.order.back_to_list'|trans }}</span>
                            </a>
                        </div>
                    </div>
                    <div class="col-6">
                        <div id="ex-conversion-action" class="row align-items-center justify-content-end">
                            <div class="col-auto">
                                <button class="btn btn-ec-conversion px-5"
                                        type="submit"
                                        name="mode"
                                        value="confirm"
                                        {% if not id %}disabled{% endif %}>
                                    {{ 'common.repeated_confirm'|trans }}
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </form>
{% endblock %}

