   431	                MailTemplate::BASE_FILES[MailTemplate::BASE_NO_BASE],
   432	            ]));
   433	
   434	        $mail = $this->mailTemplateRepository->matching($criteria)->first();
   435	        if (!$mail) {
   436	            throw new NotFoundHttpException();
   437	        }
   438	
   439	        return $mail;
   440	    }
