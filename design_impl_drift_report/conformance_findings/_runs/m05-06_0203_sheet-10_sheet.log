   183	        /**
   184	         * 課税対象の明細の合計金額を返す.
   185	         * 商品合計 + 送料 + 手数料 + 値引き(課税).
   186	         */
   187	        public function getTaxableTotal(): string
   188	        {
   189	            $total = '0';
   190	
   191	            foreach ($this->getTaxableItems() as $Item) {
   192	                $total = bcadd($total, $Item->getTotalPrice(), 2);
   193	            }
   194	
   195	            return $total;
   196	        }
