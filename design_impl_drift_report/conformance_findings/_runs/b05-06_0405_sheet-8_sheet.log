   251	     */
   252	    public function getCustomersWithPointDifferential(): array
   253	    {
   254	        $qb = $this->createQueryBuilder('ph')
   255	            ->innerJoin(DtbPlayer::class, 'p', 'WITH', 'ph.Customer = p.Customer')
   256	            ->select([
   257	                'p AS player',
   258	                'SUM(ph.pointChange) AS point_history_total',
   259	                'p.point AS point',
   260	            ])
   261	            ->groupBy('ph.Customer', 'p.id')
   262	            ->having('p.point <> SUM(ph.pointChange)');
   263	
   264	        return $qb->getQuery()->getResult();
   265	    }
