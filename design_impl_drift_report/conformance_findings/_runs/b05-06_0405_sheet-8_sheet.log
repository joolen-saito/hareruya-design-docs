   171	    /**
   172	     * 最もポイント有効期限切れに近く、未使用のポイント履歴を取得する
   173	     * 有効期限が同日の履歴が複数ある場合は失効するポイントを合計する
   174	     */
   175	    public function getNextDeadlinePointHistory(DtbPlayer $player): ?DtbPointHistory
   176	    {
   177	        if ($player->getPoint() === 0) {
   178	            return null;
   179	        }
   180	
   181	        $qb = $this->createQueryBuilder('ph')
   182	            ->innerJoin('ph.Customer', 'c')
   183	            ->where('c.id = :customerId')
   184	            ->andWhere('ph.pointChange > 0')
   185	            ->andWhere('ph.issueDate >= :expireIssueDate')
   186	            ->setParameter('customerId', $player->getCustomer()->getId())
   187	            ->setParameter('expireIssueDate', $this->getExpireDate())
   188	            ->orderBy('ph.issueDate', 'DESC');
   189	        $pointHistories = $qb->getQuery()->getResult();
   190	
   191	        $deadlinePointHistory = null;
   192	        $previousPointHistory = null;
   193	        $totalSameDatePreviousPoint = 0;
   194	        $currentPoint = $player->getPoint();
   195	        foreach ($pointHistories as $pointHistory) {
   196	            $totalSameDatePreviousPoint = $this->isSameDatePointHistory($pointHistory, $previousPointHistory) ? $totalSameDatePreviousPoint : 0;
   197	
   198	            $currentPoint -= $pointHistory->getPointChange();
   199	            if ($currentPoint <= 0) {
   200	                $deadlinePointHistory = (clone $pointHistory)->setPointChange($currentPoint + $pointHistory->getPointChange() + $totalSameDatePreviousPoint);
   201	
   202	                break;
   203	            }
   204	
   205	            $totalSameDatePreviousPoint = $this->isSameDatePointHistory($pointHistory, $previousPointHistory)
   206	                ? $totalSameDatePreviousPoint + $pointHistory->getPointChange() : $pointHistory->getPointChange();
   207	
   208	            $previousPointHistory = $pointHistory;
   209	        }
   210	
   211	        return $deadlinePointHistory;
   212	    }
   213	
   214	    /**
   215	     * 24時間以内で二重でポイントが登録されている受注IDの取得
   216	     *
   217	     * @return list<int>
   218	     */
   219	    public function findDuplicatePoint(): array
   220	    {
   221	        $toDate = new \DateTime();
   222	        $fromDate = clone $toDate;
   223	        $fromDate->modify('-1 day');
   224	
   225	        $rows = $this->createQueryBuilder('ph')
   226	            ->select('o.id AS orderId')
   227	            ->join('ph.Order', 'o')
   228	            ->andWhere('ph.pointChange < 0')
   229	            ->andWhere('ph.issueDate >= :fromDate')
   230	            ->andWhere('ph.issueDate < :toDate')
   231	            ->groupBy('o.id')
   232	            ->addGroupBy('ph.pointChange')
   233	            ->having('COUNT(DISTINCT ph.id) > 1')
   234	            ->setParameter('toDate', $toDate)
   235	            ->setParameter('fromDate', $fromDate)
   236	            ->getQuery()
   237	            ->getScalarResult();
   238	
   239	        $result = array_values(array_unique(array_map(
   240	            static fn (array $row): int => (int) $row['orderId'],
   241	            $rows
   242	        )));
   243	
   244	        return $result;
   245	    }
