   288	    /**
   289	     * 有効期限を過ぎており未使用のポイントが残っているポイント履歴を持つプレイヤーを一覧で取得
   290	     *
   291	     * @return array<array{player: DtbPlayer, remainingPoint: int}>
   292	     */
   293	    public function getPlayersForLostPoint(): array
   294	    {
   295	        $qb = $this->createQueryBuilder('ph');
   296	        $qb->join(DtbPlayer::class, 'p', 'WITH', 'ph.Customer = p.Customer AND p.smaregiId IS NOT NULL')
   297	            ->select([
   298	                'p AS player',
   299	                'SUM(CASE
   300	                    WHEN ph.issueDate >= :expireIssueDate AND ph.pointChange > 0 THEN ph.pointChange
   301	                    ELSE 0
   302	                END) AS remainingPoint',
