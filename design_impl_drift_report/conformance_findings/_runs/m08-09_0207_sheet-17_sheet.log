                <tr id="item-sheet-17-17"><td><a class="item-no" href="#pin-sheet-17-17">17</a></td><td>配送先会社名</td><td>全角・半角</td><td>-</td><td>100</td><td>-</td><td></td></tr>
                <tr id="item-sheet-17-18"><td><a class="item-no" href="#pin-sheet-17-18">18</a></td><td>配送先一覧に戻る</td><td>リンク</td><td>-</td><td>-</td><td>-</td><td>配送先一覧画面に遷移<br>ECCUBE4系を踏襲するため削除する</td></tr>
                <tr id="item-sheet-17-19"><td><a class="item-no" href="#pin-sheet-17-19">19</a></td><td>会員登録ボタン</td><td>ボタン</td><td>-</td><td>-</td><td>-</td><td>会員編集画面に遷移</td></tr>
                <tr id="item-sheet-17-20"><td><a class="item-no" href="#pin-sheet-17-20">20</a></td><td>登録ボタン</td><td>ボタン</td><td>-</td><td>-</td><td>-</td><td></td></tr>
                <tr id="item-sheet-17-21"><td><a class="item-no" href="#pin-sheet-17-21">21</a></td><td>配送先名称</td><td>全角・半角</td><td>○</td><td>128</td><td>-</td><td>一番上の項目に追加</td></tr>
              </tbody>
            </table>
          </div>
