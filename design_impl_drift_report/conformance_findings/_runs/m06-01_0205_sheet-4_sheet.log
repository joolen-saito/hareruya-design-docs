$(function () {
    moment.updateLocale("ja", {
        week: {
            dow: 1,
        },
    });

    // DatePicker付与
    $(".datetimepicker-input").datetimepicker({
        locale: "ja",
        format: "YYYY-MM-DD HH:mm",
        useCurrent: false,
        showTodayButton: true,
    });

    $("#allCheck").click(function () {
        $("[otcBuyOrderId]").prop("checked", $(this).prop("checked"));
    });

    $(".export-link").click(function (e) {
        e.preventDefault();
        var type = $(this).data("type");
        if (type === "otc_buy_order_restock_list_pdf") {
            if ($("[otcBuyOrderId]:checked").length === 0) {
                alert("PDF出力する買取情報をひとつ以上選択してください。");

                return false;
            }
            const exportUrl = $(this).attr("data-export-url");
            if (!exportUrl) {
                return false;
            }
            const popupWindow = window.open(
                "about:blank",
                "otc_buy_order_restock_list_pdf_" + String(Date.now()),
                "toolbar=no,location=no,directories=no,status=no,menubar=no,scrollbars=yes,resizable=yes,width=900,height=800",
            );
            if (!popupWindow) {
                alert("ポップアップがブロックされているため、PDFを開けませんでした。ブラウザの設定を確認してください。");

                return false;
            }
            $.ajax({
                url: exportUrl,
                type: "POST",
                data: $("#result_form").serialize(),
                dataType: "json",
            })
                .done(function (response) {
                    if (response && response.ok === true && response.html) {
                        popupWindow.document.open();
                        popupWindow.document.write(response.html);
                        popupWindow.document.close();

                        // ポップアップは親画面の CSP が効くため、HTML 内の nonce 付き inline script は実行されない
                        const printButton = popupWindow.document.getElementById("printButton");
                        if (printButton) {
                            printButton.addEventListener("click", function () {
                                popupWindow.print();
                            });
                        }

                        return;
                    }
                    popupWindow.close();
                    if (response && response.redirectUrl) {
                        window.location.href = response.redirectUrl;

                        return;
                    }
                    alert("PDF用データの取得に失敗しました。");
                })
                .fail(function () {
                    popupWindow.close();
                    alert("PDF用データの取得に失敗しました。");
                });

            return false;
        }

        e.preventDefault();
        $("#export_type").val(type);
        $("#result_form").submit();
    });
});

