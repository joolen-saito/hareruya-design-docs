namespace Eccube\Form\Type\Admin\OtcBuyOrder;

use Doctrine\ORM\QueryBuilder;
use Eccube\Common\EccubeConfig;
use Eccube\Entity\BaseInfo;
use Eccube\Entity\Master\MtbOtcBuyOrderStatus;
use Eccube\Entity\Member;
use Eccube\Repository\BaseInfoRepository;
use Eccube\Repository\Master\MtbOtcBuyOrderStatusRepository;
use Symfony\Bridge\Doctrine\Form\Type\EntityType;
use Symfony\Bundle\SecurityBundle\Security;
use Symfony\Component\Form\AbstractType;
use Symfony\Component\Form\Extension\Core\Type\CheckboxType;
use Symfony\Component\Form\Extension\Core\Type\ChoiceType;
use Symfony\Component\Form\Extension\Core\Type\DateTimeType;
use Symfony\Component\Form\Extension\Core\Type\IntegerType;
use Symfony\Component\Form\Extension\Core\Type\TextType;
use Symfony\Component\Form\FormBuilderInterface;
use Symfony\Component\HttpFoundation\RequestStack;
use Symfony\Component\OptionsResolver\OptionsResolver;
use Symfony\Component\Validator\Constraints as Assert;

class OtcBuyOrderType extends AbstractType
{
    public const PRODUCT_NAME_FORM_NUM = 3;

    public const PRODUCT_NAME_SEARCH_AND = 0;

    public const PRODUCT_NAME_SEARCH_OR = 1;

    /**
     * @var EccubeConfig
     */
    protected EccubeConfig $eccubeConfig;

    /**
     * @var RequestStack
     */
    protected RequestStack $requestStack;

    /**
     * @var BaseInfoRepository
     */
    protected BaseInfoRepository $baseInfoRepository;

    /**
     * @var Security
     */
    protected Security $security;

    public function __construct(EccubeConfig $eccubeConfig, RequestStack $requestStack, BaseInfoRepository $baseInfoRepository, Security $security)
    {
        $this->eccubeConfig = $eccubeConfig;
        $this->requestStack = $requestStack;
        $this->baseInfoRepository = $baseInfoRepository;
        $this->security = $security;
    }

    /**
     * {@inheritdoc}
     */
    public function configureOptions(OptionsResolver $resolver): void
    {
        $resolver->setDefaults([
            // disable CSRF protection for this form
            'csrf_protection' => false,
        ]);
    }

    /**
     * {@inheritdoc}
     */
    public function buildForm(FormBuilderInterface $builder, array $options): void
    {
        $request = $this->requestStack->getCurrentRequest();

        $builder
            ->add('assessment_id', TextType::class, [
                'required' => false,
            ])
            ->add('complete_date_from', DateTimeType::class, [
                'required' => false,
                'input' => 'datetime',
                'widget' => 'single_text',
                'attr' => [
                    'class' => 'datetimepicker-input',
                    'data-target' => '#'.$this->getBlockPrefix().'_complete_date_from',
                    'data-toggle' => 'datetimepicker',
                ],
                'constraints' => [
                    new Assert\Range([
                        'min' => '0003-01-01',
                        'minMessage' => 'form_error.out_of_range',
                    ]),
                ],
            ])
            ->add('complete_date_to', DateTimeType::class, [
                'required' => false,
                'input' => 'datetime',
                'widget' => 'single_text',
                'attr' => [
                    'class' => 'datetimepicker-input',
                    'data-target' => '#'.$this->getBlockPrefix().'_complete_date_to',
                    'data-toggle' => 'datetimepicker',
                ],
            ])
            ->add('shop', EntityType::class, [
                'class' => BaseInfo::class,
                'required' => false,
                'expanded' => false,
                'multiple' => false,
                'placeholder' => 'admin.purchase.store.form.shop.placeholder',
                'data' => $this->getMemberDefaultSearchBaseInfo(),
            ])
            ->add('otc_buy_order_status', EntityType::class, [
                'required' => false,
                'expanded' => false,
                'multiple' => false,
                'class' => MtbOtcBuyOrderStatus::class,
                'placeholder' => 'admin.purchase.store.form.status.placeholder',
                'query_builder' => function (MtbOtcBuyOrderStatusRepository $repository): QueryBuilder {
                    return $repository->createQueryBuilder('s')
                        ->where('s.id NOT IN (:deprecated)')
                        ->setParameter('deprecated', MtbOtcBuyOrderStatus::DEPRECATED_STATUSES)
                        ->orderBy('s.id', 'ASC');
                },
            ])
            ->add('price_from', TextType::class, [
                'required' => false,
            ])
            ->add('price_to', TextType::class, [
                'required' => false,
            ])
            ->add('name_multi', TextType::class, [
                'required' => false,
            ])
            ->add('customer_id', IntegerType::class, [
                'required' => false,
            ])
            ->add('application_date_from', DateTimeType::class, [
                'required' => false,
                'input' => 'datetime',
                'widget' => 'single_text',
                'data' => (new \DateTime('first day of last month'))->setTime(0, 0, 0),
                'attr' => [
                    'class' => 'datetimepicker-input',
                    'data-target' => '#'.$this->getBlockPrefix().'_application_date_from',
                    'data-toggle' => 'datetimepicker',
                ],
                'constraints' => [
                    new Assert\Range([
                        'min' => '0003-01-01',
                        'minMessage' => 'form_error.out_of_range',
                    ]),
                ],
            ])
            ->add('application_date_to', DateTimeType::class, [
                'required' => false,
                'input' => 'datetime',
                'widget' => 'single_text',
                'attr' => [
                    'class' => 'datetimepicker-input',
                    'data-target' => '#'.$this->getBlockPrefix().'_application_date_to',
                    'data-toggle' => 'datetimepicker',
                ],
            ])
            // 棚戻し未完了のみ表示チェックボックス
            ->add('restock_incomplete_only', CheckboxType::class, [
                'required' => false,
                'label' => trans('admin.purchase.store.form.restock_incomplete_only.label'),
            ])
            // AND,OR検索選択
            ->add('product_name_select', ChoiceType::class, [
                'required' => false,
                'expanded' => true,
                'multiple' => false,
                'choices' => [
                    'admin.purchase.store.form.and_search.label' => self::PRODUCT_NAME_SEARCH_AND,
                    'admin.purchase.store.form.or_search.label' => self::PRODUCT_NAME_SEARCH_OR,
                ],
                'placeholder' => null,
            ]);
        // 商品名
        foreach (range(1, self::PRODUCT_NAME_FORM_NUM) as $num) {
            $builder->add('product_name'.$num, TextType::class, [
                'required' => false,
            ]);
        }
    }

    /**
     * {@inheritdoc}
     */
    public function getName(): string
    {
        return 'admin_otc_buy_order';
    }

    /**
     * メンバーのデフォルト検索表示店舗を取得
     *
     * @return BaseInfo|null
     */
    private function getMemberDefaultSearchBaseInfo(): ?BaseInfo
    {
        $Member = $this->security->getUser();

        if (!$Member instanceof Member) {
            return null;
        }

        try {
            return $Member->getDefaultSearchBaseInfo();
        } catch (\Error $e) {
            // プロパティが未初期化の場合
            return null;
        }
    }
}

