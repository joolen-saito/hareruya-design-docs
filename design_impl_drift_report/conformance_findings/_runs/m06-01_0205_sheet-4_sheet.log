namespace Eccube\Service\Csv\Exporter;

use Eccube\Repository\DtbOtcBuyOrderRepository;
use Eccube\Service\Admin\OtcBuyOrder\OtcBuyOrderRestockListService;
use Eccube\Service\CsvExportService;
use Symfony\Component\HttpFoundation\StreamedResponse;

class OtcBuyOrderCsvExportService
{
    public function __construct(
        protected CsvExportService $csvExportService,
        protected DtbOtcBuyOrderRepository $otcBuyOrderRepository,
        protected RestockListCsvRowFormatter $restockListCsvRowFormatter,
        protected OtcBuyOrderRestockListService $otcBuyOrderRestockListService,
    ) {
    }

    public const CSV_TYPES = [
        'old_goods_account' => [
            'header' => [
                'assessmentId' => '査定ID',
                'completeDate' => '年月日',
                'totalPrice' => '代金',
                'totalQuantity' => '数量',
                'fullName' => '氏名',
                'identificationType' => '身分証',
                'address' => '住所',
                'age' => '年齢',
                'phoneNumber' => '電話番号',
                'job' => '職業',
                'qualifiedInvoiceIssuerFlg' => '事業者であるか',
                'qualifiedInvoiceIssuerNumber' => '事業者番号',
            ],
        ],
        'otc_buy_order_product_list' => [
            'header' => [
                'productCode' => '商品コード',
                'productCount' => '在庫増減数',
                'productName' => '商品名',
                'standardPrice' => '基準価格',
                'buyPrice' => '買取価格',
                'languageId' => '言語ID',
                'storageCode' => '略称タグ',
                'rarityCode' => 'レアリティ',
                'conditionCode' => '状態',
            ],
        ],
        'otc_buy_order_restock_list_csv' => [
            'header' => [
                'pickingType' => 'ピッキング区分', // 店舗ごとの閾値（ネット買取管理の場合は本店しかないため本店の閾値）とサプライを出力 ●●円未満、●●円以上▲▲円未満、■■円以上、サプライ
                'shelfNumber' => '棚番号', // 本店のみ出力、他店舗は空
                'languageAndCondition' => '言語/状態', // Foilの場合はFoilをつけて、言語/状態の形式で出力する（例: FoilJP/NM）、サプライ品の場合は「サプライ品」と表示
                'storageCode' => '略称', // サプライ品の場合は表示しない
                'colorAndRarity' => '色/R', // 商品名から取り出した色とレアリティを出力（例: 金R)
                'quantity' => '数',
                'productName' => '商品名', // サプライ品でない場合は商品名から略称・言語・状態・色・レアリティを取り除く
                'standardPrice' => '基準価格',
            ],
        ],
    ];

    /**
     * @param array<int, int> $otcBuyOrderIds
     */
    public function exportByIds(
        string $exportType,
        array $otcBuyOrderIds,
    ): StreamedResponse {
        // exportTypeの存在確認。controllerでも確認しているが念の為。
        if (!isset(self::CSV_TYPES[$exportType])) {
            throw new \InvalidArgumentException('Invalid export type: '.$exportType);
        }

        $header = self::CSV_TYPES[$exportType]['header'];

        $response = new StreamedResponse();
        $response->setCallback(function () use (
            $header,
            $exportType,
            $otcBuyOrderIds,
        ): void {
            $this->csvExportService->fopen();

            // ヘッダー出力
            $this->csvExportService->fputcsv(array_values($header));

            // データ取得（選択されたIDでフィルタリング）
            $data = $this->getDataByExportType($exportType, $otcBuyOrderIds);

            foreach ($data as $row) {
                // ヘッダー順に並べ替え
                $orderedRow = array_map(
                    fn ($key) => $row[$key] ?? '',
                    array_keys($header),
                );
                $this->csvExportService->fputcsv($orderedRow);
            }

            $this->csvExportService->fclose();

            // CSV出力完了後に棚戻し済みフラグを更新する。
            // コールバック内で更新することで、出力が途中で失敗した場合にフラグが立たないようにする。
            if ($exportType === 'otc_buy_order_restock_list_csv') {
                $this->otcBuyOrderRestockListService->markOtcBuyOrdersAsRestocked($otcBuyOrderIds);
            }
        });
        $now = new \DateTime();
        $filename = $exportType.'_'.$now->format('YmdHis').'.csv';
        $response->headers->set('Content-Type', 'application/octet-stream');
        $response->headers->set(
            'Content-Disposition',
            'attachment; filename='.$filename,
        );

        log_info('店頭買取CSV出力完了. ファイル名: '.$filename);

        return $response;
    }

    /**
     * @param array<int, int> $otcBuyOrderIds
     *
     * @return iterable<array<string, mixed>>
     */
    private function getDataByExportType(
        string $exportType,
        array $otcBuyOrderIds,
    ): iterable {
        return match ($exportType) {
            'old_goods_account' => $this->otcBuyOrderRepository->getOldAccountCsvExportData(
                $otcBuyOrderIds,
            ),
            'otc_buy_order_product_list' => $this->otcBuyOrderRepository->getOtcBuyOrderProductListCsvExportData(
                $otcBuyOrderIds,
            ),
            'otc_buy_order_restock_list_csv' => $this->restockListCsvRowFormatter->iterateFormattedRows(
                $this->otcBuyOrderRepository->getOtcBuyOrderRestockListExportData($otcBuyOrderIds),
            ),
            default => throw new \InvalidArgumentException('Invalid export type: '.$exportType),
        };
    }
}

