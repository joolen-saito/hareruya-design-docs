    public function registerIndividualStock(
        Request $request,
        int $otcBuyOrderId,
        int $individualProductId,
    ): Response {
        if (!$this->isCsrfTokenValid('register_individual_stock', $request->request->get('_token'))) {
            $this->addError('admin.common.csrf_token_error', 'admin');

            return $this->redirectToRoute('admin_otcbuyorder_detail', ['otcBuyOrderId' => $otcBuyOrderId]);
        }

        $OtcBuyOrder = $this->otcBuyOrderRepository->find($otcBuyOrderId);
        if (!$OtcBuyOrder) {
            throw $this->createNotFoundException();
        }

        $IndividualProduct = $this->entityManager->find(
            DtbOtcBuyOrderIndivisualInputProduct::class,
            $individualProductId,
        );
        if (!$IndividualProduct || $IndividualProduct->getOtcBuyOrder()->getId() !== $OtcBuyOrder->getId()) {
            throw $this->createNotFoundException();
        }

        $productClassId = $request->request->getInt('product_class_id');
        $ProductClass = $this->entityManager->find(ProductClass::class, $productClassId);
        if (!$ProductClass) {
            $this->addError('商品規格が見つかりません。', 'admin');

            return $this->redirectToRoute('admin_otcbuyorder_detail', [
                'otcBuyOrderId' => $OtcBuyOrder->getId(),
            ]);
        }

        $Member = $this->getUser();
        if (!$Member instanceof Member) {
            throw new AuthenticationException();
        }

        try {
            $this->registerIndividualStockAction->handle(new RegisterIndividualStockInput(
                OtcBuyOrder: $OtcBuyOrder,
                Member: $Member,
                IndividualProduct: $IndividualProduct,
                ProductClass: $ProductClass,
            ));

            $this->addSuccess('実在庫登録が完了しました。', 'admin');
        } catch (\Exception $e) {
            $this->addError($e->getMessage(), 'admin');
        }

        return $this->redirectToRoute('admin_otcbuyorder_detail', [
            'otcBuyOrderId' => $OtcBuyOrder->getId(),
        ]);
    }

    /**
     * 戻しリストPDF出力
     */
    #[
        Route(
            path: '/%eccube_admin_route%/otcbuyorder/restock-list/pdf',
            name: 'admin_otcbuyorder_restock_list_pdf',
            methods: ['POST'],
        ),
    ]
    public function printRestockList(Request $request): JsonResponse
    {
        set_time_limit(0);
        $this->isTokenValid();

        $otcBuyOrderIds = array_filter(array_map('intval', $request->request->all('otcBuyOrderIds')));

        $pageNo = $request->getSession()->get('eccube.admin.otcbuyorder.search.page_no', 1);
        $redirectUrl = $this->generateUrl('admin_otcbuyorder_page', ['page_no' => $pageNo]);

        if ($otcBuyOrderIds === []) {
            $this->addError($this->translator->trans('admin.purchase.online.csv_export.no_selection'), 'admin');

            return $this->json(['ok' => false, 'redirectUrl' => $redirectUrl]);
        }

        $errs = $this->otcBuyOrderRestockListService->validateRestockListRequest(
            $otcBuyOrderIds,
            $this->getMember(),
        );
        if ($errs !== []) {
            foreach ($errs as $error) {
                $this->addError($error, 'admin');
            }

            return $this->json(['ok' => false, 'redirectUrl' => $redirectUrl]);
        }

        $html = $this->renderView(
            '@admin/Purchase/restock_list.twig',
            $this->otcBuyOrderRestockListService->buildPdfViewData($otcBuyOrderIds),
        );

        return $this->json(['ok' => true, 'html' => $html]);
    }
}

