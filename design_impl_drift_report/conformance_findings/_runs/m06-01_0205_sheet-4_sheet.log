namespace Eccube\Service\Admin\OtcBuyOrder;

use Doctrine\ORM\EntityManagerInterface;
use Eccube\Entity\DtbOtcBuyOrder;
use Eccube\Entity\Master\MtbOtcBuyOrderStatus;
use Eccube\Entity\Member;
use Eccube\Repository\DtbOtcBuyOrderRepository;
use Eccube\Service\Csv\Exporter\RestockListPdfSectionBuilder;

/**
 * 店頭買取 棚戻しリスト（CSV・PDF）共通処理
 */
class OtcBuyOrderRestockListService
{
    public function __construct(
        private readonly DtbOtcBuyOrderRepository $otcBuyOrderRepository,
        private readonly EntityManagerInterface $entityManager,
        private readonly RestockListPdfSectionBuilder $restockListPdfSectionBuilder,
    ) {
    }

    /**
     * 戻しリストPDF用のTwig変数を組み立て、対象買取を棚戻し済みに更新する
     *
     * @param list<int> $otcBuyOrderIds
     *
     * @return array{restockListSections: list<array{
     *     titleBase: string,
     *     isSupply: bool,
     *     items: list<array<string, mixed>>,
     *     total_quantity: int
     * }>}
     */
    public function buildPdfViewData(array $otcBuyOrderIds): array
    {
        $rawRows = $this->otcBuyOrderRepository->getOtcBuyOrderRestockListExportData($otcBuyOrderIds);
        $built = $this->restockListPdfSectionBuilder->buildSections($rawRows);
        $this->markOtcBuyOrdersAsRestocked($otcBuyOrderIds);

        return [
            'restockListSections' => $built['sections'],
        ];
    }

    /**
     * @param array<int, int> $otcBuyOrderIds
     */
    public function markOtcBuyOrdersAsRestocked(array $otcBuyOrderIds): void
    {
        $this->entityManager->beginTransaction();
        try {
            foreach ($otcBuyOrderIds as $id) {
                $OtcBuyOrder = $this->entityManager->find(DtbOtcBuyOrder::class, $id);
                if ($OtcBuyOrder === null) {
                    continue;
                }
                $OtcBuyOrder->setRestockedFlg(true);
                $this->entityManager->persist($OtcBuyOrder);
            }
            $this->entityManager->flush();
            $this->entityManager->commit();
        } catch (\Exception $e) {
            $this->entityManager->rollback();
            throw $e;
        }
    }

    /**
     * 棚戻しリスト出力用バリデーション
     *
     * @param array<int, int> $otcBuyOrderIds
     *
     * @return list<string>
     */
    public function validateRestockListRequest(array $otcBuyOrderIds, Member $Member): array
    {
        $orderData = $this->otcBuyOrderRepository->getStatusAndShopByIds(
            $otcBuyOrderIds,
        );

        if ($orderData === []) {
            return ['対象のデータが見つかりません。'];
        }

        $errs = [];
        $editableShopIds = $Member
            ->getMemberBaseInfos()
            ->map(fn ($memberBaseInfo) => $memberBaseInfo->getBaseInfo()->getId())
            ->toArray();

        $shopIds = [];
        foreach ($orderData as $data) {
            $shopIds[] = $data['shopId'];

            // 店舗編集権限チェック
            if (!in_array($data['shopId'], $editableShopIds, true)) {
                $errs[] = sprintf(
                    'ID: %d は権限のない店舗のデータです。',
                    $data['orderId'],
                );
            }

            // ステータスチェック
            if (
                $data['statusId'] !== MtbOtcBuyOrderStatus::STATUS_STOCKING_PENDING
                && $data['statusId'] !== MtbOtcBuyOrderStatus::STATUS_STOCKING_COMPLETE
            ) {
                $errs[] = sprintf(
                    'ID: %d は対象外のステータスです。',
                    $data['orderId'],
                );
            }
        }

        // 複数店舗チェック
        if (count(array_unique($shopIds)) > 1) {
            $errs[] = '複数店舗の買取情報を同時に処理することはできません。';
        }

        return $errs;
    }
}

