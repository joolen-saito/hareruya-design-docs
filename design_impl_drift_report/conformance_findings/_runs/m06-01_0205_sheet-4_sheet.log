                                        </div>
                                    {% endfor %}
                                    <div class="col-md-12">
                                        <div id="search_box_main__product_name_select" class="form-group col-sm-6 col-md-6">
                                            <label>{{ 'admin.purchase.store.form.product_name_select.label'|trans }}</label>
                                            {{ form_widget(searchForm.product_name_select) }}
