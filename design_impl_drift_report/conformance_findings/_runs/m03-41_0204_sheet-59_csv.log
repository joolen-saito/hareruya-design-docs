                $this->handler->onValidateRow($event);
                if ($event->isBreakAll()) {
                    $hasBreak = true;
                    break;
                }
                if ($event->isSkipRow()) {
                    continue;
                }

                $event->clearNextAction();
                $isOk = $this->handler->onReadRow($event);
                if ($isOk) {
                    $importCount++;
                }

                if ($index % $this->flushPerLines === 0) {
                    $this->em->flush();
