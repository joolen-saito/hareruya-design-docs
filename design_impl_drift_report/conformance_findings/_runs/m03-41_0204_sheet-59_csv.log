namespace Eccube\Controller\Admin\Product\Csv;

use Eccube\Controller\AbstractController;
use Eccube\Entity\Master\MtbCsvImportType;
use Eccube\Entity\Member;
use Eccube\Form\Type\Admin\CsvImportType;
use Eccube\Repository\CategoryRepository;
use Eccube\Repository\DtbCsvImportHistoryRepository;
use Eccube\Service\Csv\Importer\CsvImporter;
use Eccube\Service\Csv\Importer\Event\CategoryCsvImportHandler;
use Eccube\Service\CsvExportService;
use Knp\Component\Pager\PaginatorInterface;
use Symfony\Component\HttpFoundation\File\UploadedFile;
use Symfony\Component\HttpFoundation\RedirectResponse;
use Symfony\Component\HttpFoundation\Request;
use Symfony\Component\HttpFoundation\Response;
use Symfony\Component\HttpFoundation\StreamedResponse;
use Symfony\Component\Routing\Attribute\Route;

class CategoryCsvController extends AbstractController
{
    private const PAGE_COUNT_OPTIONS = [10, 50, 100, 300, 500, 1000, 2000, 10000, 12000];
    private const CSV_IMPORT_MAX = 5010;

    public function __construct(
        private readonly CategoryRepository $categoryRepository,
        private readonly CsvExportService $csvExportService,
        private readonly PaginatorInterface $paginator,
        private readonly DtbCsvImportHistoryRepository $csvImportHistoryRepository,
    ) {
    }

    /**
     * カテゴリ登録CSV雛形ダウンロード
     */
    #[Route(path: '/%eccube_admin_route%/product/category/csv_template', name: 'admin_product_category_bulk_csv_template', methods: ['GET'])]
    public function csvTemplate(): StreamedResponse
    {
        $headers = $this->getCsvHeader();
        $response = new StreamedResponse();
        $response->setCallback(function () use ($headers): void {
            $this->csvExportService->fopen();
            $this->csvExportService->fputcsv(array_keys($headers));
            $this->csvExportService->fclose();
        });

        $filename = 'category_registration_template.csv';
        $response->headers->set('Content-Type', 'application/octet-stream');
        $response->headers->set('Content-Disposition', 'attachment; filename='.$filename);

        return $response;
    }

    /**
     * カテゴリ登録CSVアップロード画面
     */
    #[Route(path: '/%eccube_admin_route%/product/category/category_bulk_csv_upload', name: 'admin_product_category_bulk_csv_upload', methods: ['GET'])]
    public function csv(Request $request): Response
    {
        $form = $this->createForm(CsvImportType::class);
        $form->handleRequest($request);

        $session = $request->getSession();
        $pageCountOptions = self::PAGE_COUNT_OPTIONS;
        $pageCountParam = $request->get('page_count');
        $sessionKeyPageCount = 'admin.product.category_bulk_csv.page_count';
        $pageCount = (int) ($pageCountParam ?? $session->get($sessionKeyPageCount, 10));
        if (!\in_array($pageCount, $pageCountOptions, true)) {
            $pageCount = 10;
        }
        if ($pageCountParam !== null && \in_array((int) $pageCountParam, $pageCountOptions, true)) {
            $pageCount = (int) $pageCountParam;
            $session->set($sessionKeyPageCount, $pageCount);
        }
        $sessionKeyPageNo = 'admin.product.category_bulk_csv.page_no';
        $pageNo = (int) ($request->get('page_no') ?? $session->get($sessionKeyPageNo, 1));
        $session->set($sessionKeyPageNo, $pageNo);

        $qb = $this->csvImportHistoryRepository->getQueryBuilderByCsvImportType(MtbCsvImportType::CATEGORY_BULK_IMPORT_CSV_ID);
        $importHistoriesPagination = $this->paginator->paginate($qb, $pageNo, $pageCount);

        $headers = $this->getCsvHeader();

        return $this->render('@admin/Product/csv_category_bulk.twig', [
            'form' => $form->createView(),
            'headers' => $headers,
            'csv_required_header_keys' => array_keys($this->getRequiredCsvHeader()),
            'csv_box_title' => 'admin.product.category_bulk_csv_upload_title',
            'csv_format_title' => 'admin.product.category_bulk_csv_format_title',
            'form_action_route' => 'admin_product_category_bulk_import',
            'template_download_route' => 'admin_product_category_bulk_csv_template',
            'import_histories_pagination' => $importHistoriesPagination,
            'history_page_route' => 'admin_product_category_bulk_csv_upload',
            'page_no' => $pageNo,
            'page_count' => $pageCount,
            'pageMax' => $pageCountOptions,
        ]);
    }

    /**
     * カテゴリ登録CSV取込
     */
    #[Route(path: '/%eccube_admin_route%/product/category/import', name: 'admin_product_category_bulk_import', methods: ['POST'])]
    public function import(Request $request): RedirectResponse
    {
        /** @var Member $Member */
        $Member = $this->getUser();

        $form = $this->formFactory->createBuilder(CsvImportType::class)->getForm();
        $form->handleRequest($request);

        if (!$form->isValid()) {
            foreach ($form->getErrors(true) as $error) {
                $this->addError($error->getMessage(), 'admin');
            }

            return $this->redirectToRoute('admin_product_category_bulk_csv_upload');
        }
        /** @var UploadedFile|null $formFile */
        $formFile = $form['import_file']->getData();

        if ($formFile === null) {
            $this->addError('admin.common.csv_invalid_format', 'admin');

            return $this->redirectToRoute('admin_product_category_bulk_csv_upload');
        }

        if ($this->countCsvRows($formFile) >= self::CSV_IMPORT_MAX) {
            $this->addError(
                $this->translator->trans('admin.csv.error.upload.maxrecord', ['%maxRecord%' => self::CSV_IMPORT_MAX]),
                'admin'
            );

            return $this->redirectToRoute('admin_product_category_bulk_csv_upload');
        }

        log_info('カテゴリ登録CSV取込開始');

        $handler = new CategoryCsvImportHandler(
            $this->categoryRepository,
            $this->eccubeConfig
        );
        $importer = new CsvImporter(
            $this->entityManager,
            $this->translator,
            $this->eccubeConfig,
            $handler,
            $Member
        );
        $result = $importer->import($formFile);

        if ($result->hasError()) {
            log_info('カテゴリ登録CSV取込 異常終了');
            foreach ($result->getErrors() as $error) {
                $this->addError($error['message'], 'admin');
            }
        } else {
            $this->addSuccess('admin.register.complete', 'admin');
            log_info('カテゴリ登録CSV取込完了', ['count' => $result->getCount()]);
            $this->csvImportHistoryRepository->insertCsvImportHistory(
                MtbCsvImportType::CATEGORY_BULK_IMPORT_CSV_ID,
                $formFile->getClientOriginalName(),
                $Member->getId()
            );
        }

        return $this->redirectToRoute('admin_product_category_bulk_csv_upload');
    }

    /**
     * @return array<string, string>
     */
    private function getCsvHeader(): array
    {
        return [
            'カテゴリID' => '更新時は必須。新規登録時は空',
            '表示ランク' => '更新時は必須。新規登録時は空（取込時は全カテゴリ件数+1を自動設定）',
            'カテゴリ名(日)' => '',
            'カテゴリ名(英)' => '',
            '親カテゴリID' => '必須。最上位は 0。',
            '階層' => '取込では使用しません。親カテゴリIDから自動設定されます。',
            'フロント非表示フラグ' => '0: 表示する、1: 表示しない',
            '支店非表示フラグ' => '0: 表示する、1: 表示しない',
            '検索パラメータ' => '',
            '最新セット用バナー画像パス' => '',
            'カテゴリアイコン画像パス' => '',
            '対象商品数' => '取込では使用しません。更新時はDBの値を維持します。',
        ];
    }

    /**
     * 常に必須バッジを付ける列（説明上「新規は空」などはヘッダー説明テキストで表現）
     *
     * @return array<string, string>
     */
    private function getRequiredCsvHeader(): array
    {
        return [
            'カテゴリ名(日)' => 'カテゴリ名(日)',
            'カテゴリ名(英)' => 'カテゴリ名(英)',
            '親カテゴリID' => '親カテゴリID',
            'フロント非表示フラグ' => 'フロント非表示フラグ',
            '支店非表示フラグ' => '支店非表示フラグ',
        ];
    }
}

