namespace Eccube\Service\Csv\Importer\Validator;

use Eccube\Common\EccubeConfig;
use Eccube\Repository\CategoryRepository;
use Eccube\Service\Csv\Importer\MessageStore;
use Eccube\Service\Csv\Importer\Model\CsvColumnInterface;
use Eccube\Service\Csv\Importer\Model\CsvRowInterface;

/**
 * カテゴリ登録CSVの行単位検証（新規/更新の組み合わせ・階層など）。
 */
final class CategoryCsvRowValidator implements RowValidatorInterface
{
    public function __construct(
        private readonly CategoryRepository $categoryRepository,
        private readonly EccubeConfig $eccubeConfig,
        private readonly CsvColumnInterface $categoryIdColumn,
        private readonly CsvColumnInterface $sortNoColumn,
        private readonly CsvColumnInterface $parentCategoryIdColumn,
    ) {
    }

    #[\Override]
    public function validate(MessageStore $errors, CsvRowInterface $row): bool
    {
        $categoryId = $this->categoryIdColumn->getValue($row);
        $sortNo = $this->sortNoColumn->getValue($row);
        $parentId = $this->parentCategoryIdColumn->getValue($row);

        $isUpdate = $categoryId !== null && $categoryId > 0;

        if ($isUpdate) {
            if ($sortNo === null) {
                $errors->addMessage('admin.csv.error.category.update_requires_sort', $row->getRowNumber());

                return false;
            }
            $Category = $this->categoryRepository->find($categoryId);
            if ($Category === null) {
                $errors->addMessage('admin.csv.error.category.not_found', $row->getRowNumber());

                return false;
            }
        } elseif ($sortNo !== null) {
            $errors->addMessage('admin.csv.error.category.new_must_not_have_sort', $row->getRowNumber());

            return false;
        }

        if ($categoryId !== null && $parentId !== null && (int) $categoryId === (int) $parentId && (int) $parentId > 0) {
            $errors->addMessage('admin.csv.error.category.id_equals_parent', $row->getRowNumber());

            return false;
        }

        $Parent = null;
        if ($parentId !== null && $parentId > 0) {
            $Parent = $this->categoryRepository->find($parentId);
            if ($Parent === null) {
                $errors->addMessage('admin.csv.error.category.parent_not_found', $row->getRowNumber());

                return false;
            }

            if ($isUpdate) {
                for ($cursor = $Parent; $cursor !== null; $cursor = $cursor->getParent()) {
                    if ((int) $cursor->getId() === (int) $categoryId) {
                        $errors->addMessage('admin.csv.error.category.parent_is_descendant', $row->getRowNumber());

                        return false;
                    }
                }
            }
        }

        $level = $Parent !== null ? (int) $Parent->getHierarchy() + 1 : 1;
        $maxLevel = (int) $this->eccubeConfig['eccube_category_nest_level'];
        if ($level > $maxLevel) {
            $errors->addMessage('admin.csv.error.category.nest_level_exceeded', $row->getRowNumber(), $maxLevel);

            return false;
        }

        return true;
    }
}

