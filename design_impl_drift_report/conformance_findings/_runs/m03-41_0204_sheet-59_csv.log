namespace Eccube\Service\Csv\Importer\Event;

use Eccube\Common\EccubeConfig;
use Eccube\Entity\Category;
use Eccube\Repository\CategoryRepository;
use Eccube\Service\Csv\Importer\Converter\IntConverter;
use Eccube\Service\Csv\Importer\Model\BaseCsvColumn;
use Eccube\Service\Csv\Importer\Model\CsvColumnInterface;
use Eccube\Service\Csv\Importer\Validator\CategoryCsvRowValidator;
use Eccube\Service\Csv\Importer\Validator\ChoiceValidator;
use Eccube\Service\Csv\Importer\Validator\NumericMaxLengthValidator;
use Eccube\Service\Csv\Importer\Validator\NumericValidator;
use Eccube\Service\Csv\Importer\Validator\RowValidatorInterface;
use Eccube\Service\Csv\Importer\Validator\StringMaxLengthValidator;
use Eccube\Util\StringUtil;

/**
 * カテゴリ登録CSVの取込。
 */
class CategoryCsvImportHandler extends BaseCsvImportHandler
{
    /** カテゴリ名(日)・カテゴリ名(英)・検索パラメータの CSV 最大文字数（UTF-8） */
    public const TEXT_FIELD_MAX_UTF8_LENGTH = 128;

    /** カテゴリID・表示ランク・親カテゴリID・階層・対象商品数の数値列の最大桁数 */
    public const NUMERIC_FIELD_MAX_DIGITS = 11;

    private ?BaseCsvColumn $categoryIdColumn = null;
    private ?BaseCsvColumn $sortNoColumn = null;
    private ?BaseCsvColumn $nameJaColumn = null;
    private ?BaseCsvColumn $nameEnColumn = null;
    private ?BaseCsvColumn $parentCategoryIdColumn = null;
    /** エクスポート列と列数を揃える。取込では親から算出した階層を使い、CSVの値は参照しない */
    private ?BaseCsvColumn $hierarchyColumn = null;
    private ?BaseCsvColumn $frontHideColumn = null;
    private ?BaseCsvColumn $branchHideColumn = null;
    private ?BaseCsvColumn $searchParametersColumn = null;
    private ?BaseCsvColumn $bannerPathColumn = null;
    private ?BaseCsvColumn $iconPathColumn = null;
    /** CSV に列として存在するが、取込では値を永続化しない（更新時は DB の値を維持） */
    private ?BaseCsvColumn $targetProductCountColumn = null;

    public function __construct(
        private readonly CategoryRepository $categoryRepository,
        private readonly EccubeConfig $eccubeConfig,
    ) {
    }

    #[\Override]
    public function onBeforeImport(): void
    {
        $this->initializeColumnDefinitions();
        parent::onBeforeImport();
    }

    #[\Override]
    public function onAfterImport(AfterReadEvent $event): void
    {
        parent::onAfterImport($event);
        $this->clearColumnDefinitions();
    }

    /**
     * @return array<CsvColumnInterface>
     */
    #[\Override]
    protected function getColumns(): array
    {
        return [
            $this->categoryIdColumn,
            $this->sortNoColumn,
            $this->nameJaColumn,
            $this->nameEnColumn,
            $this->parentCategoryIdColumn,
            $this->hierarchyColumn,
            $this->frontHideColumn,
            $this->branchHideColumn,
            $this->searchParametersColumn,
            $this->bannerPathColumn,
            $this->iconPathColumn,
            $this->targetProductCountColumn,
        ];
    }

    /**
     * @return array<RowValidatorInterface>
     */
    #[\Override]
    protected function getRowValidators(): array
    {
        return [
            new CategoryCsvRowValidator(
                $this->categoryRepository,
                $this->eccubeConfig,
                $this->categoryIdColumn,
                $this->sortNoColumn,
                $this->parentCategoryIdColumn
            ),
        ];
    }

    #[\Override]
    public function onReadRow(ReadCsvRowEvent $event): bool
    {
        $row = $event->getRow();
        $categoryId = $this->categoryIdColumn->getValue($row);
        $isUpdate = $categoryId !== null && $categoryId > 0;

        if ($isUpdate) {
            $Category = $this->categoryRepository->find((int) $categoryId);
            if (!$Category instanceof Category) {
                return false;
            }
        } else {
            $Category = new Category();
        }

        $nameJa = (string) $this->nameJaColumn->getValue($row);
        $Category->setName(StringUtil::trimAll($nameJa));

        $nameEn = $this->nameEnColumn->getValue($row);
        $Category->setCategoryNameEn($nameEn !== null && StringUtil::isNotBlank((string) $nameEn) ? StringUtil::trimAll((string) $nameEn) : null);

        $parentId = $this->parentCategoryIdColumn->getValue($row);
        $Parent = null;
        if ($parentId !== null && (int) $parentId > 0) {
            $Parent = $this->categoryRepository->find((int) $parentId);
        }
        $Category->setParent($Parent);

        $this->applyHierarchyFromParent($Category, $Parent);

        $front = (int) $this->frontHideColumn->getValue($row);
        $Category->setFrontSearchHideFlg($front === 1);

        $branch = (int) $this->branchHideColumn->getValue($row);
        $Category->setBranchHideFlg($branch === 1);

        $search = $this->searchParametersColumn->getValue($row);
        $Category->setSearchParameters($search !== null && StringUtil::isNotBlank((string) $search) ? StringUtil::trimAll((string) $search) : null);

        $banner = $this->bannerPathColumn->getValue($row);
        $Category->setBannerImage($banner !== null && StringUtil::isNotBlank((string) $banner) ? StringUtil::trimAll((string) $banner) : null);

        $icon = $this->iconPathColumn->getValue($row);
        $Category->setIconImage($icon !== null && StringUtil::isNotBlank((string) $icon) ? StringUtil::trimAll((string) $icon) : null);

        if ($isUpdate) {
            $sortNo = $this->sortNoColumn->getValue($row);
            if ($sortNo !== null) {
                $Category->setSortNo((int) $sortNo);
            }
            $Category->setUpdateDate(new \DateTime());
        } else {
            $now = new \DateTime();
            $Category->setCreateDate($now);
            $Category->setUpdateDate($now);
            // 表示ランク: 全カテゴリ件数 + 1（CSV では新規時に表示ランク列は空のため補完）
            $Category->setSortNo((int) $this->categoryRepository->getTotalCount() + 1);
        }

        if ($isUpdate) {
            $this->categoryRepository->save($Category);
        } else {
            $this->categoryRepository->saveNewCategoryFromCsvImport($Category);
        }

        return true;
    }

    private function initializeColumnDefinitions(): void
    {
        $this->categoryIdColumn = (new BaseCsvColumn('カテゴリID', 'カテゴリID'))
            ->setConverter(new IntConverter())
            ->addValidator(new NumericValidator(), new NumericMaxLengthValidator(self::NUMERIC_FIELD_MAX_DIGITS))
            ->setRequired(false);

        $this->sortNoColumn = (new BaseCsvColumn('表示ランク', '表示ランク'))
            ->setConverter(new IntConverter())
            ->addValidator(new NumericValidator(), new NumericMaxLengthValidator(self::NUMERIC_FIELD_MAX_DIGITS))
            ->setRequired(false);

        $this->nameJaColumn = (new BaseCsvColumn('カテゴリ名(日)', 'カテゴリ名(日)'))
            ->setRequired(true)
            ->addValidator(new StringMaxLengthValidator(self::TEXT_FIELD_MAX_UTF8_LENGTH, false));

        $this->nameEnColumn = (new BaseCsvColumn('カテゴリ名(英)', 'カテゴリ名(英)'))
            ->setRequired(true)
            ->addValidator(new StringMaxLengthValidator(self::TEXT_FIELD_MAX_UTF8_LENGTH, false));

        $this->parentCategoryIdColumn = (new BaseCsvColumn('親カテゴリID', '親カテゴリID'))
            ->setConverter(new IntConverter())
            ->addValidator(new NumericValidator(), new NumericMaxLengthValidator(self::NUMERIC_FIELD_MAX_DIGITS))
            ->setRequired(true);

        $this->hierarchyColumn = (new BaseCsvColumn('階層', '階層'))
            ->setRequired(false)
            ->setConverter(new IntConverter())
            ->addValidator(new NumericValidator(), new NumericMaxLengthValidator(self::NUMERIC_FIELD_MAX_DIGITS));

        $this->frontHideColumn = (new BaseCsvColumn('フロント非表示フラグ', 'フロント非表示フラグ'))
            ->setRequired(true)
            ->addValidator(new ChoiceValidator('0', '1'))->setConverter(new IntConverter());

        $this->branchHideColumn = (new BaseCsvColumn('支店非表示フラグ', '支店非表示フラグ'))
            ->setRequired(true)
            ->addValidator(new ChoiceValidator('0', '1'))->setConverter(new IntConverter());

        $this->searchParametersColumn = (new BaseCsvColumn('検索パラメータ', '検索パラメータ'))
            ->setRequired(false)
            ->addValidator(new StringMaxLengthValidator(self::TEXT_FIELD_MAX_UTF8_LENGTH));

        $this->bannerPathColumn = (new BaseCsvColumn('最新セット用バナー画像パス', '最新セット用バナー画像パス'))
            ->setRequired(false)
            ->addValidator(new StringMaxLengthValidator(255));

        $this->iconPathColumn = (new BaseCsvColumn('カテゴリアイコン画像パス', 'カテゴリアイコン画像パス'))
            ->setRequired(false)
            ->addValidator(new StringMaxLengthValidator(255));

        $this->targetProductCountColumn = (new BaseCsvColumn('対象商品数', '対象商品数'))
            ->setConverter(new IntConverter())
            ->addValidator(new NumericValidator(), new NumericMaxLengthValidator(self::NUMERIC_FIELD_MAX_DIGITS))
            ->setRequired(false);
    }

    /**
     * 親カテゴリID が 0（親なし）のとき階層 1、1 以上のときは親に登録済みの階層 + 1。
     */
    private function applyHierarchyFromParent(Category $Category, ?Category $Parent): void
    {
        $Category->setHierarchy($Parent !== null ? (int) $Parent->getHierarchy() + 1 : 1);
    }

    private function clearColumnDefinitions(): void
    {
        $this->categoryIdColumn = null;
        $this->sortNoColumn = null;
        $this->nameJaColumn = null;
        $this->nameEnColumn = null;
        $this->parentCategoryIdColumn = null;
        $this->hierarchyColumn = null;
        $this->frontHideColumn = null;
        $this->branchHideColumn = null;
        $this->searchParametersColumn = null;
        $this->bannerPathColumn = null;
        $this->iconPathColumn = null;
        $this->targetProductCountColumn = null;
    }
}

