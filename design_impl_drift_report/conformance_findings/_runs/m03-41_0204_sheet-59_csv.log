namespace Eccube\Service\Csv\Importer\Model;

use Eccube\Service\Csv\Importer\Converter\ConverterInterface;
use Eccube\Service\Csv\Importer\Converter\NoActionConverter;
use Eccube\Service\Csv\Importer\MessageStore;
use Eccube\Service\Csv\Importer\Validator\NoActionValidator;
use Eccube\Service\Csv\Importer\Validator\RequiredValidator;
use Eccube\Service\Csv\Importer\Validator\ValidatorInterface;

class BaseCsvColumn implements CsvColumnInterface
{
    /** @var string 列の名前 */
    private string $name;

    /** @var string 列の表示名 */
    private string $label;

    /** @var bool 必須の場合 true */
    private bool $required;

    /** @var bool 複数の値を指定可能な場合 true */
    private bool $multiple;

    /** @var ValidatorInterface 入力チェックを行うもの */
    private ValidatorInterface $validator;

    /** @var ConverterInterface 値の変換を行うもの */
    private ConverterInterface $converter;

    /**
     * BaseCsvColumn constructor.
     *
     * @param string $name 列の名前
     * @param string $label 列の表示名
     */
    public function __construct(string $name, string $label)
    {
        $this->name = $name;
        $this->label = $label;
        $this->validator = NoActionValidator::getInstance();
        $this->converter = NoActionConverter::getInstance();
        $this->required = false;
        $this->multiple = false;
    }

    /**
     * @return string 列の名前
     */
    public function getName(): string
    {
        return $this->name;
    }

    /**
     * @param string $name 列の名前
     *
     * @return self
     */
    public function setName(string $name): self
    {
        $this->name = $name;

        return $this;
    }

    /**
     * @return string 列の表示名
     */
    public function getLabel(): string
    {
        return $this->label;
    }

    /**
     * @param string $label 列の表示名
     *
     * @return self
     */
    public function setLabel(string $label): self
    {
        $this->label = $label;

        return $this;
    }

    /**
     * @param bool $required 必須の場合 true
     *
     * @return self
     */
    public function setRequired(bool $required): self
    {
        $this->required = $required;

        return $this;
    }

    /**
     * @param bool $multiple 複数の値を指定可能な場合 true
     *
     * @return self
     */
    public function setMultiple(bool $multiple): self
    {
        $this->multiple = $multiple;

        return $this;
    }

    /**
     * @param ConverterInterface $converter 値の変換を行うもの
     *
     * @return self
     */
    public function setConverter(ConverterInterface $converter): self
    {
        $this->converter = $converter;

        return $this;
    }

    /**
     * 値を検証する。
     *
     * @param MessageStore $errors メッセージの格納先
     * @param CsvRowInterface $row 値の取得先
     *
     * @return bool 値が正しい場合 true
     */
    public function validate(MessageStore $errors, CsvRowInterface $row): bool
    {
        $value = $this->find($row);
        $firstValidator = $this->required ? new RequiredValidator() : NoActionValidator::getInstance();

        return $firstValidator
            ->thenValidate($this->validator)
            ->validate($errors, $value);
    }

    /**
     * 入力チェックを追加する。
     *
     * @param mixed $validator 追加するバリデータ
     *
     * @return self
     */
    public function addValidator(mixed $validator): self
    {
        $validators = is_array($validator) ? $validator : func_get_args();
        $this->validator = $this->validator->thenValidate($validators);

        return $this;
    }

    /**
     * 行から変換後の値を取得する。
     *
     * @param CsvRowInterface $row
     *
     * @return mixed
     */
    public function getValue(CsvRowInterface $row): mixed
    {
        return $this->find($row)->getValue();
    }

