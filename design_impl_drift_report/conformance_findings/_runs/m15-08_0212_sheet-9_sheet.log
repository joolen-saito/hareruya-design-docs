{% block main %}

<div class="c-contentsArea__cols">
    <div class="row justify-content-between mb-2">
        <div class="col">
            <a class="btn btn-ec-conversion" href="{{ url('admin_deck_new') }}">{{ 'admin.deck.new'|trans }}</a>
            <a href="{{ url('admin_deck_csv_import') }}" class="btn btn-ec-conversion">{{ 'admin.deck.csv_import'|trans }}</a>
        </div>
    </div>

    {{ form_start(searchForm, { 'action': url('admin_deck_list'), 'method': 'POST', 'attr': { 'id': 'admin_search_deck' } }) }}

    {# 検索ボックスエリア #}
    <div class="c-outsideBlock search-box-inner p-0">
        <div class="c-outsideBlock__contents p-0">
            {# デッキID / フォーマット / カラー / アーキタイプ #}
            <div class="row mb-2">
                <div class="col-3">
