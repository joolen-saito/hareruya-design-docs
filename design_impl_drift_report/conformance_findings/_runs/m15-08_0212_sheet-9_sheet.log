namespace Eccube\Controller\Admin\Archetype;

use Doctrine\ORM\EntityManagerInterface;
use Eccube\Common\Constant;
use Eccube\Controller\AbstractController;
use Eccube\Controller\Admin\SearchControllerTrait;
use Eccube\Entity\DtbArchetype;
use Eccube\Entity\Master\MtbDisp;
use Eccube\Entity\Master\MtbFormat;
use Eccube\Form\Type\Admin\ArchetypeType;
use Eccube\Form\Type\Admin\SearchArchetypeType;
use Eccube\Repository\DtbArchetypeRepository;
use Eccube\Repository\Master\PageMaxRepository;
use Eccube\Service\Admin\Archetype\ActionInput\ArchetypeStoreInput;
use Eccube\Service\Admin\Archetype\ArchetypeDeleteAction;
use Eccube\Service\Admin\Archetype\ArchetypeStoreAction;
use Eccube\Util\FormUtil;
use Knp\Component\Pager\PaginatorInterface;
use Symfony\Bridge\Twig\Attribute\Template;
use Symfony\Component\HttpFoundation\JsonResponse;
use Symfony\Component\HttpFoundation\RedirectResponse;
use Symfony\Component\HttpFoundation\Request;
use Symfony\Component\Routing\Attribute\Route;
use Symfony\Component\Security\Csrf\CsrfTokenManagerInterface;

class ArchetypeController extends AbstractController
{
    use SearchControllerTrait;

    public function __construct(
        protected PaginatorInterface $paginator,
        protected readonly PageMaxRepository $pageMaxRepository,
        protected readonly CsrfTokenManagerInterface $csrfTokenManager,
        private readonly EntityManagerInterface $archetypeEntityManager,
        private readonly DtbArchetypeRepository $archetypeRepository,
        private readonly ArchetypeStoreAction $storeAction,
        private readonly ArchetypeDeleteAction $deleteAction,
    ) {
        $this->repository = $this->archetypeRepository;
        $this->sessionKey = 'archetype';
        $this->formType = SearchArchetypeType::class;
        $this->formName = 'admin_search_archetype';
        $this->defaultOrder = 'DESC';
    }

    /**
     * @return array<string, mixed>
     */
    #[Route('/%eccube_admin_route%/archetype', name: 'admin_archetype_list', methods: ['GET', 'POST'])]
    #[Route('/%eccube_admin_route%/archetype/search/{page_no}', name: 'admin_archetype_search', requirements: ['page_no' => '\d+'], methods: ['GET', 'POST'])]
    #[Template('@admin/Archetype/index.twig')]
    public function index(Request $request, PaginatorInterface $paginator, int $page_no = 1): array
    {
        $searchForm = $this->getForm();

        if ($request->isMethod('POST')) {
            $searchForm->handleRequest($request);

            if (!$searchForm->isValid()) {
                return [
                    'searchForm' => $searchForm->createView(),
                    'pagination' => null,
                    'is_search_filter_active' => true,
                ];
            }

            $page_no = 1;
            $viewData = FormUtil::getViewData($searchForm);

            $this->session->set('eccube.admin.'.$this->sessionKey.'.search', $viewData);
            $this->session->set('eccube.admin.'.$this->sessionKey.'.search.page_no', $page_no);
        } else {
            $pageNoAttr = $request->attributes->get('page_no');
            if ($request->query->getInt('resume') === Constant::ENABLED || $pageNoAttr !== null) {
                if ($pageNoAttr !== null) {
                    $page_no = (int) $pageNoAttr;
                    $this->session->set('eccube.admin.'.$this->sessionKey.'.search.page_no', $page_no);
                } else {
                    $page_no = $this->session->get('eccube.admin.'.$this->sessionKey.'.search.page_no', 1);
                }
                $viewData = $this->session->get('eccube.admin.'.$this->sessionKey.'.search', []);
                FormUtil::submitAndGetData($searchForm, $viewData);
            } else {
                $viewData = FormUtil::getViewData($searchForm);
                $this->session->set('eccube.admin.'.$this->sessionKey.'.search', $viewData);
                $this->session->set('eccube.admin.'.$this->sessionKey.'.search.page_no', 1);
                $this->session->set('eccube.admin.'.$this->sessionKey.'.search.page_count', 100);

                return [
                    'searchForm' => $searchForm->createView(),
                    'pagination' => null,
                    'is_search_filter_active' => false,
                ];
            }
        }

        $responseData = $this->search($request, null, $page_no);

        $searchData = $searchForm->getData();
        $sortKeys = $this->archetypeRepository->getSortKeys();
        $sortKey = (string) ($searchData['sortKey'] ?? $this->archetypeRepository::DEFAULT_SORT_KEY);
        if (!array_key_exists($sortKey, $sortKeys)) {
            $sortKey = $this->archetypeRepository::DEFAULT_SORT_KEY;
        }
        $sortOrder = strtoupper((string) ($searchData['sortOrder'] ?? $this->archetypeRepository::DEFAULT_SORT_ORDER));
        if (!in_array($sortOrder, ['ASC', 'DESC'], true)) {
            $sortOrder = $this->archetypeRepository::DEFAULT_SORT_ORDER;
        }

        $responseData['sortKeys'] = $sortKeys;
        $responseData['sortKey'] = $sortKey;
        $responseData['sortOrder'] = $sortOrder;

        return $responseData;
    }

    /**
     * アーキタイプ新規登録画面.
     *
     * @return array<string, mixed>|RedirectResponse
     */
    #[Route('/%eccube_admin_route%/archetype/new', name: 'admin_archetype_new', methods: ['GET', 'POST'])]
    #[Template('@admin/Archetype/edit.twig')]
    public function new(Request $request): array|RedirectResponse
    {
        $Archetype = new DtbArchetype();
        $defaultDisp = $this->entityManager->getRepository(MtbDisp::class)->find(MtbDisp::DISPLAY_SHOW);
        if ($defaultDisp !== null) {
            $Archetype->setDisp($defaultDisp);
        }
        $defaultFormat = $this->entityManager->getRepository(MtbFormat::class)
            ->createQueryBuilder('f')
            ->orderBy('f.rank', 'ASC')
            ->addOrderBy('f.id', 'ASC')
            ->setMaxResults(1)
            ->getQuery()
            ->getOneOrNullResult();
        if ($defaultFormat !== null) {
            $Archetype->setFormat($defaultFormat);
        }

        return $this->save($request, $Archetype, isNew: true);
    }

    /**
     * アーキタイプ編集画面.
     *
     * @return array<string, mixed>|RedirectResponse
     */
    #[Route('/%eccube_admin_route%/archetype/{id}/edit', name: 'admin_archetype_edit', requirements: ['id' => '\d+'], methods: ['GET', 'POST'])]
    #[Template('@admin/Archetype/edit.twig')]
    public function edit(Request $request, DtbArchetype $Archetype): array|RedirectResponse
    {
        if ($Archetype->getDeletedAt() !== null) {
            throw $this->createNotFoundException();
        }

        return $this->save($request, $Archetype, isNew: false);
    }

    /**
     * アーキタイプ削除.
     */
    #[Route('/%eccube_admin_route%/archetype/{id}/delete', name: 'admin_archetype_delete', requirements: ['id' => '\d+'], methods: ['POST'])]
    public function delete(Request $request, DtbArchetype $Archetype): RedirectResponse
    {
        if (!$this->isCsrfTokenValid('admin_archetype_delete', $request->request->get('_token'))) {
            $this->addError('admin.common.csrf_invalid', 'admin');

            return $this->redirectToRoute('admin_archetype_list');
        }

        try {
            $this->deleteAction->handle($Archetype);
        } catch (\RuntimeException $e) {
            $this->addError($e->getMessage(), 'admin');

            return $this->redirectToRoute('admin_archetype_edit', ['id' => $Archetype->getId()]);
        } catch (\Exception $e) {
            log_error('アーキタイプ削除エラー', ['message' => $e->getMessage()]);
            $this->addError('admin.common.delete_error', 'admin');

            return $this->redirectToRoute('admin_archetype_edit', ['id' => $Archetype->getId()]);
        }

        $this->addSuccess('admin.common.delete_complete', 'admin');

        return $this->redirectToRoute('admin_archetype_list');
    }

    /**
     * 保存処理（新規/編集共通）.
     *
     * @return array<string, mixed>|RedirectResponse
     */
    private function save(Request $request, DtbArchetype $Archetype, bool $isNew): array|RedirectResponse
    {
        $form = $this->createForm(ArchetypeType::class, $Archetype);

        if (!$isNew && !$request->isMethod('POST') && $Archetype->getCardImage() !== null) {
            $form->get('cardImageId')->setData((string) $Archetype->getCardImage()->getId());
        }

        $form->handleRequest($request);

        if ($form->isSubmitted() && $form->isValid()) {
            $User = $this->getUser();
            $Member = $User instanceof \Eccube\Entity\Member ? $User : null;

            $cardImageRaw = $form->get('cardImageId')->getData();
            $cardImageId = ($cardImageRaw !== null && $cardImageRaw !== '') ? (int) $cardImageRaw : null;

            $input = new ArchetypeStoreInput($Archetype, $cardImageId, $Member);

            try {
                $Saved = $this->storeAction->handle($input);
                $this->addSuccess('admin.common.save_complete', 'admin');

                return $this->redirectToRoute('admin_archetype_edit', ['id' => $Saved->getId()]);
            } catch (\RuntimeException $e) {
                $this->addError($e->getMessage(), 'admin');
            } catch (\Exception $e) {
                log_error('アーキタイプ保存エラー', ['message' => $e->getMessage()]);
                $this->addError('admin.common.save_error', 'admin');
            }

