namespace Eccube\Repository;

use Doctrine\ORM\Query\Expr\Join;
use Doctrine\ORM\QueryBuilder;
use Doctrine\Persistence\ManagerRegistry;
use Eccube\Entity\DtbArchetype;
use Eccube\Entity\Master\MtbDeckType;
use Eccube\Entity\Master\MtbDisp;
use Eccube\Entity\Master\MtbFormat;
use Eccube\Util\SqlUtil;

/**
 * @extends AbstractRepository<DtbArchetype>
 */
class DtbArchetypeRepository extends AbstractRepository
{
    public const DEFAULT_SORT_KEY = 'default';
    public const DEFAULT_SORT_ORDER = 'DESC';

    /**
     * 管理画面用ソートキー.
     *
     * @var array<string, string>
     */
    private array $sortKeys = [
        'default' => 'a.id',
        'archetypeName' => 'a.nameJp',
        'registArchetypeCount' => 'registeredArchetypeCount',
    ];

    public function __construct(
        ManagerRegistry $registry,
    ) {
        parent::__construct($registry, DtbArchetype::class);
    }

    /**
     * @return array<string, string>
     */
    public function getSortKeys(): array
    {
        return $this->sortKeys;
    }

    /**
     * 管理画面アーキタイプ検索用 QueryBuilder を構築する。
     *
     * ★カスタマイズ:
     *   - 旧アーキタイプID の検索条件を除去
     *
     * @param array<string, mixed> $searchData
     */
    public function getQueryBuilderBySearchData(array $searchData): QueryBuilder
    {
        $qb = $this->createQueryBuilder('a')
            ->leftJoin('a.Format', 'f')
            ->addSelect('f')
            ->leftJoin('a.CardImage', 'ci')
            ->addSelect('ci')
            ->leftJoin(
                \Eccube\Entity\DtbDeck::class,
                'd',
                Join::WITH,
                'a = d.Archetype AND IDENTITY(d.DeckType) = :deckType'
            )
            ->addSelect('COUNT(DISTINCT d.id) AS registeredArchetypeCount')
            ->setParameter('deckType', MtbDeckType::EVENT_ID)
            ->groupBy('a.id, f.id, ci.id');

        // アーキタイプ名（部分一致、スペース/カンマ区切りで複数検索）
        if (!empty($searchData['multi'])) {
            $texts = preg_split('/[\s,　]+/u', (string) $searchData['multi']);
            SqlUtil::multiTextQuery($qb, $texts, ['a' => ['nameJp', 'nameEn']]);
        }

        // フォーマット
        if (!empty($searchData['formats']) && count($searchData['formats']) > 0) {
            $qb->andWhere($qb->expr()->in('a.Format', ':formats'))
                ->setParameter('formats', $searchData['formats']);
        }

        // カラー（AND検索）
        if (!empty($searchData['colors'])) {
            foreach ($searchData['colors'] as $colorIdx => $Color) {
                if ($Color === null) {
                    continue;
                }
                $qb->join('a.Colors', 'co'.$colorIdx, Join::WITH, "co{$colorIdx}.id = :color{$colorIdx}")
                    ->setParameter("color{$colorIdx}", $Color);
            }
        }

        // デッキタグ（AND検索）
        if (!empty($searchData['deck_tags'])) {
            foreach ($searchData['deck_tags'] as $deckTagIdx => $DeckTag) {
                if ($DeckTag === null) {
                    continue;
                }
                $qb->join('a.DeckTags', 'dt'.$deckTagIdx, Join::WITH, "dt{$deckTagIdx}.id = :deckTag{$deckTagIdx}")
                    ->setParameter("deckTag{$deckTagIdx}", $DeckTag);
            }
        }

        // ソート
        $sortKey = (string) ($searchData['sortKey'] ?? $searchData['sort'] ?? self::DEFAULT_SORT_KEY);
        $sortOrder = strtoupper((string) ($searchData['sortOrder'] ?? $searchData['order'] ?? self::DEFAULT_SORT_ORDER));
        if (!in_array($sortOrder, ['ASC', 'DESC'], true)) {
            $sortOrder = self::DEFAULT_SORT_ORDER;
        }
        $sortColumn = $this->sortKeys[$sortKey] ?? $this->sortKeys[self::DEFAULT_SORT_KEY];
        $qb->orderBy($sortColumn, $sortOrder);

        return $qb;
    }

    private const RESULT_CACHE_LIFETIME_SECONDS = 86400;

    /**
     * @return array<int, array{id: int, name_jp: string|null, name_en: string|null}>
     */
    public function getDeckBuilderArchetypesByFormat(MtbFormat $Format): array
    {
        return $this->createQueryBuilder('a')
            ->select([
                'a.id',
                'a.nameJp AS name_jp',
                'a.nameEn AS name_en',
            ])
            ->where('a.Format = :Format')
            ->setParameter('Format', $Format)
            ->getQuery()
            ->enableResultCache(self::RESULT_CACHE_LIFETIME_SECONDS, 'archetypes_'.$Format->getId())
            ->getResult();
    }

    /**
     * @return array{id: int, name_jp: string|null, name_en: string|null}|null
     */
    public function getDeckBuilderArchetypeById(int $id): ?array
    {
        return $this->createQueryBuilder('a')
            ->select([
                'a.id',
                'a.nameJp AS name_jp',
                'a.nameEn AS name_en',
            ])
            ->where('a.id = :id')
            ->setParameter('id', $id)
            ->getQuery()
            ->getOneOrNullResult();
    }

    /**
     * デッキトップ・アーキタイプ検索条件
     *
     * @param int|null $formatId
     *
     * @return array<string, list<array{
     *     arche: DtbArchetype,
     *     code: string,
     *     url: string|null,
     *     colorNames: string
     * }>>
     */
    public function getAllArcheType(?int $formatId = null): array
    {
        $qb = $this->createQueryBuilder('a')
            ->innerJoin('a.Format', 'f')
            ->addSelect('f')
            ->leftJoin('a.CardImage', 'ci')
            ->addSelect('ci')
            ->leftJoin('a.Colors', 'c')
            ->addSelect('c')
            ->where('IDENTITY(a.Disp) = :dispId')
            ->andWhere('a.deletedAt IS NULL')
            ->setParameter('dispId', MtbDisp::DISPLAY_SHOW)
            ->orderBy('f.rank', 'ASC')
            ->addOrderBy('a.nameJp', 'ASC');

        if ($formatId !== null) {
            $qb->andWhere('IDENTITY(a.Format) = :formatId')
                ->setParameter('formatId', $formatId);
        }

        $cacheId = $formatId === null ? 'all_archetypes' : 'all_archetypes_format_'.$formatId;
        $archetypes = $qb->getQuery()
            ->enableResultCache(self::RESULT_CACHE_LIFETIME_SECONDS, $cacheId)
            ->getResult();

        $grouped = [];
        foreach ($archetypes as $arche) {
            $code = $arche->getFormat()->getCode() ?? '';
            $distinctNames = [];
            foreach ($arche->getColors() as $color) {
                $distinctNames[$color->getNameEn()] = true;
            }
            $grouped[$code][] = [
                'arche' => $arche,
                'code' => $code,
                'url' => $arche->getCardImage()?->getUrl(),
                'colorNames' => implode(',', array_keys($distinctNames)),
            ];
        }

        return $grouped;
    }
}

