            border-bottom: 0;
        }
        .archetype-result-table .archetype-action-cell {
            position: relative;
        }
        .archetype-result-table .archetype-action-cell .dropdown-menu {
            right: 100% !important;
            left: auto !important;
            top: 0 !important;
            min-width: max-content;
            transform: none !important;
        }
    </style>
{% endblock stylesheet %}

{% block javascript %}
    <script src="{{ asset('assets/js/select2.min.js', 'admin') }}" nonce="{{ csp_nonce }}"></script>
    <script nonce="{{ csp_nonce }}">
        $(function() {
            $('.select2-select').select2({ width: '100%', placeholder: '{{ 'admin.archetype.multi_select_placeholder'|trans|e('js') }}' });

            $('#page_count_pulldown').on('change', function () {
                const targetUrl = $(this).val();
                if (targetUrl) {
                    window.location.href = targetUrl;
                }
            });

            $('#sort_key_pulldown, #sort_order_pulldown').on('change', function () {
                const sortKey = $('#sort_key_pulldown').val();
                const sortOrder = $('#sort_order_pulldown').val();
                const $searchForm = $('#admin_search_archetype');
                $searchForm.find('.hidden_sort_key').val(sortKey);
                $searchForm.find('.hidden_sort_order').val(sortOrder);
                $searchForm.submit();
            });

        });
    </script>
{% endblock javascript %}

{% block main %}

<div class="c-contentsArea__cols">
    <div class="row justify-content-between mb-2">
        <div class="col">
            <a href="{{ url('admin_archetype_new') }}" class="btn btn-ec-conversion">{{ 'admin.archetype.new'|trans }}</a>
            <a href="{{ url('admin_archetype_csv_import') }}" class="btn btn-ec-conversion">{{ 'admin.archetype.csv_import'|trans }}</a>
        </div>
    </div>

    {{ form_start(searchForm, { 'action': url('admin_archetype_list'), 'method': 'POST', 'attr': { 'id': 'admin_search_archetype' } }) }}

    <div class="c-outsideBlock search-box-inner p-0">
        <div class="c-outsideBlock__contents p-0">
            <div class="row mb-2">
                <div class="col-6">
                    <label>{{ 'admin.archetype.archetype_name'|trans }}</label>
                    {{ form_widget(searchForm.multi) }}
                    {{ form_errors(searchForm.multi) }}
                </div>
                <div class="col-6">
                    <label>{{ 'admin.archetype.format'|trans }}</label>
                    {{ form_widget(searchForm.formats) }}
                </div>
            </div>

            <div class="row mb-2">
                <div class="col-6 archetype-search-check">
                    <label class="d-block">{{ 'admin.archetype.color'|trans }}</label>
                    {% for child in searchForm.colors %}
                        <div class="form-check form-check-inline">
                            {{ form_widget(child) }}
                            {{ form_label(child) }}
                        </div>
                    {% endfor %}
                </div>
                <div class="col-6">
                    <label>{{ 'admin.archetype.deck_tag'|trans }}</label>
                    {{ form_widget(searchForm.deck_tags) }}
                </div>
            </div>

            <div class="col-12 mt-3 text-center">
                <button type="submit" class="btn btn-ec-conversion px-5">{{ 'admin.archetype.search'|trans }}</button>
            </div>
        </div>

        {{ form_widget(searchForm.sortKey) }}
        {{ form_widget(searchForm.sortOrder) }}
    </div>

    {{ form_end(searchForm) }}

    {% if pagination %}
        <div class="mt-3 mb-2">
            <span class="fw-bold">{{ 'admin.common.search_result_count'|trans({ '%count%': pagination.totalItemCount }) }}</span> {{ 'admin.common.search_result_suffix'|trans }}
        </div>
        <hr class="mt-0 mb-2">
        <div class="row justify-content-end align-items-center mb-2">
            <div class="col-auto d-flex align-items-center gap-2">
                <select id="page_count_pulldown" class="form-select w-auto">
                    {% for pageMax in pageMaxis %}
                        <option {% if pageMax.name == page_count %} selected {% endif %}
                            value="{{ path('admin_archetype_search', {'page_no': 1, 'page_count': pageMax.name }) }}">
                            {{ 'admin.common.count'|trans({ '%count%': pageMax.name }) }}
                        </option>
                    {% endfor %}
                </select>
                <span>{{ 'admin.archetype.sort_label'|trans }}：</span>
                <select id="sort_key_pulldown" class="form-select w-auto">
                    {% for sortKeyOption in sortKeys|keys %}
                        <option {% if sortKeyOption == sortKey %} selected {% endif %} value="{{ sortKeyOption }}">
                            {{ ('admin.archetype.sort.' ~ sortKeyOption)|trans }}
                        </option>
                    {% endfor %}
                </select>
                <select id="sort_order_pulldown" class="form-select w-auto">
                    <option value="ASC" {% if sortOrder == 'ASC' %} selected {% endif %}>{{ 'admin.common.sort_asc'|trans }}</option>
                    <option value="DESC" {% if sortOrder == 'DESC' %} selected {% endif %}>{{ 'admin.common.sort_desc'|trans }}</option>
                </select>
            </div>
        </div>

        {% if pagination.totalItemCount %}
            <table class="table align-middle archetype-result-table">
                <thead>
                    <tr>
                        <th class="text-center" style="width: 120px;"></th>
                        <th>{{ 'admin.common.id'|trans }}</th>
                        <th>{{ 'admin.archetype.archetype_name'|trans }}</th>
                        <th>{{ 'admin.archetype.color'|trans }}</th>
                        <th>{{ 'admin.archetype.format'|trans }}</th>
                        <th>{{ 'admin.archetype.registered_archetype_count'|trans }}</th>
                        <th rowspan="2" style="width: 40px;"></th>
                    </tr>
                    <tr>
                        <th class="text-center">{{ 'admin.archetype.representative_card'|trans }}</th>
                        <th colspan="5">{{ 'admin.archetype.archetype_description'|trans }}</th>
                    </tr>
                </thead>
                <tbody>
                    {% for row in pagination %}
                        {% set Archetype = row[0] %}
                        {% set stripeClass = loop.index is even ? 'archetype-row-striped' : '' %}
                        <tr class="{{ stripeClass }}">
                            <td rowspan="2" class="align-middle text-center">
                                {% if Archetype.CardImage %}
                                    <img src="{{ Archetype.CardImage.url }}" alt="" class="img-fluid" style="max-height: 120px;">
                                {% else %}
                                    <span class="text-muted">-</span>
                                {% endif %}
                            </td>
                            <td>{{ Archetype.id }}</td>
                            <td><a href="{{ url('admin_archetype_edit', {id: Archetype.id}) }}" class="text-decoration-none">{{ Archetype.nameJp }} / {{ Archetype.nameEn }}</a></td>
                            <td>
                                {% set colorNames = [] %}
                                {% for Color in Archetype.Colors %}
                                    {% set colorNames = colorNames|merge([Color.name_jp]) %}
                                {% endfor %}
                                {{ colorNames|join('/') ?: '-' }}
                            </td>
                            <td>{{ Archetype.Format ? Archetype.Format.nameJp : '-' }}</td>
                            <td>{{ row.registeredArchetypeCount }}</td>
                            <td rowspan="2" class="align-middle text-center archetype-action-cell">
                                <div class="dropdown">
                                    <button type="button" class="btn p-0 border-0 bg-transparent text-secondary" data-bs-toggle="dropdown" data-bs-display="static" aria-label="{{ 'admin.common.open_detail'|trans }}">
                                        <i class="fa-solid fa-ellipsis" aria-hidden="true"></i>
                                    </button>
                                    <ul class="dropdown-menu dropdown-menu-end py-1">
                                        <li><a class="dropdown-item px-3 py-1" href="{{ url('admin_archetype_edit', {id: Archetype.id}) }}">{{ 'admin.common.edit'|trans }}</a></li>
                                        <li>
                                            <form method="post" action="{{ url('admin_archetype_delete', {id: Archetype.id}) }}" onsubmit="return confirm('{{ 'admin.archetype.delete_confirm'|trans|e('js') }}');">
                                                <input type="hidden" name="_token" value="{{ csrf_token('admin_archetype_delete') }}">
                                                <button type="submit" class="dropdown-item px-3 py-1">{{ 'admin.common.delete'|trans }}</button>
                                            </form>
                                        </li>
                                    </ul>
                                </div>
                            </td>
                        </tr>
                        <tr class="{{ stripeClass }}">
                            <td colspan="5"><a href="{{ url('admin_archetype_edit', {id: Archetype.id}) }}" class="text-decoration-none text-body">{{ Archetype.commentJp ?: '-' }}</a></td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>

            <div class="d-flex justify-content-center">
                {% include "@admin/pager.twig" with { 'pages': pagination.paginationData, 'routes': 'admin_archetype_search' } %}
            </div>
        {% else %}
            <div class="card rounded border-0">
                <div class="card-body p-4 text-center">
                    <div class="text-muted mb-4 h5">{{ 'admin.common.search_no_result'|trans }}</div>
                </div>
            </div>
        {% endif %}
    {% endif %}
</div>

