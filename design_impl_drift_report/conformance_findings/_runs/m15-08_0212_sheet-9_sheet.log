    /**
     * マイページ・イベント申込履歴
     * 該当プレーヤーのDeckのイベント詳細IDを取得
     *
     * @return array<int, int|null>
     */
    public function getEventDetailIds(int $id): array
    {
        // dtb_deck
        $qb = $this->createQueryBuilder('d')
            ->select('IDENTITY(d.EventDetail)')
            // 該当プレイヤーID
            ->where('IDENTITY(d.Player) = :playerId')
            ->setParameter('playerId', $id);

        return array_column($qb->getQuery()->getResult(), '1');
    }

    /**
     * マイページ・大会デッキ登録
     * 該当プレーヤーのとeventDetailsIdとdeckIdの組を取得
     *
     * @return list<array<int|string, int|null>>
     */
    public function getDetailsAndDecksByPlayerId(int $id): array
    {
        // dtb_deck
        $qb = $this->createQueryBuilder('d')
            ->select(['IDENTITY(d.EventDetail)', 'd.id'])
            // 該当プレイヤーID
            ->where('IDENTITY(d.Player) = :playerId')
            ->setParameter('playerId', $id);

        return $qb->getQuery()->getResult();
    }

    /**
     * get sort keys
     *
     * @return array<string, string>
     */
    public function getSortKeys(): array
    {
        return $this->sortKeys;
    }

    /**
     * 管理画面デッキ検索用 QueryBuilder を構築する。
     *
     * ★カスタマイズ:
     *   - 旧デッキID、DCIナンバー、勝敗数の検索条件を除去
     *   - イベントID → イベント詳細ID に差し替え
     *
     * @param array<string, mixed> $searchData
     */
    public function getQueryBuilderBySearchData(array $searchData): QueryBuilder
    {
        $qb = $this->createQueryBuilder('d');

        // 大会開始時刻前のデッキは検索結果に表示しない
        $qb->leftJoin('d.EventDetail', 'ed', Join::WITH, 'ed.startDate < :time OR IDENTITY(d.EventDetail) IS NULL')
            ->andWhere('ed.startDate < :time OR IDENTITY(d.EventDetail) IS NULL')
            ->setParameter('time', new \DateTime());

        // ユーザ作成のデッキは検索結果に表示しない
        $qb->andWhere('IDENTITY(d.DeckType) = :deckType')
            ->setParameter('deckType', MtbDeckType::EVENT_ID);

        // デッキID
        if (!empty($searchData['deck_id'])) {
            SqlUtil::searchByIds($qb, $searchData['deck_id'], 'd', 'id');
        }

        // デッキ名（部分一致、スペース/カンマ区切りで複数検索）
        if (!empty($searchData['deck_name'])) {
            $texts = preg_split('/[\s,　]+/u', $searchData['deck_name']);
            SqlUtil::multiTextQuery($qb, $texts, ['d' => ['deckName']]);
        }

        // フォーマット
        if (!empty($searchData['formats']) && count($searchData['formats']) > 0) {
            $qb->andWhere($qb->expr()->in('d.Format', ':formats'))
                ->setParameter('formats', $searchData['formats']);
        }

        // アーキタイプ
        if (!empty($searchData['archetypes']) && count($searchData['archetypes']) > 0) {
            $qb->andWhere($qb->expr()->in('d.Archetype', ':archetypes'))
                ->setParameter('archetypes', $searchData['archetypes']);
        }

        // カラー（アーキタイプ経由）
        if (!empty($searchData['color']) && count($searchData['color']) > 0) {
            $qb->join('d.Archetype', 'da')
                ->join('da.Colors', 'co', Join::WITH, $qb->expr()->in('co.id', ':colors'))
                ->setParameter('colors', $searchData['color']);
        }

        // 公開状態
        if (!empty($searchData['disp']) && count($searchData['disp']) > 0) {
            $qb->andWhere($qb->expr()->in('d.Disp', ':disp'))
                ->setParameter('disp', $searchData['disp']);
        }

        // デッキリスト公開状態
        if (!empty($searchData['private_flg']) && count($searchData['private_flg']) === 1) {
            $qb->andWhere('d.privateFlg = :privateFlg')
                ->setParameter('privateFlg', $searchData['private_flg'][0]);
        }

        // イベント開催日（From）
        if (!empty($searchData['event_date_from'])) {
            $from = (clone $searchData['event_date_from'])->setTime(0, 0, 0);
            $qb->andWhere('d.eventDate >= :eventDateFrom')
                ->setParameter('eventDateFrom', $from);
        }

        // イベント開催日（To）
        if (!empty($searchData['event_date_to'])) {
            $to = (clone $searchData['event_date_to'])->setTime(23, 59, 59);
            $qb->andWhere('d.eventDate <= :eventDateTo')
                ->setParameter('eventDateTo', $to);
        }

        // 順位（From/To）
        if (!empty($searchData['ranking_from'])) {
            $qb->andWhere('d.ranking >= :rankingFrom')
                ->setParameter('rankingFrom', $searchData['ranking_from']);
        }
        if (!empty($searchData['ranking_to'])) {
            $qb->andWhere('d.ranking <= :rankingTo')
                ->setParameter('rankingTo', $searchData['ranking_to']);
        }

        // 成績（部分一致）
        if (!empty($searchData['result'])) {
            $texts = preg_split('/[\s,　]+/u', $searchData['result']);
            SqlUtil::multiTextQuery($qb, $texts, ['d' => ['result']]);
        }

        // イベント名（部分一致、日英）
        if (!empty($searchData['event_name'])) {
            $texts = preg_split('/[\s,　]+/u', $searchData['event_name']);
            SqlUtil::multiTextQuery($qb, $texts, ['d' => ['eventNameJp', 'eventNameEn']]);
        }

        // プレイヤー名（部分一致）
        if (!empty($searchData['player_name'])) {
            $texts = preg_split('/[\s,　]+/u', $searchData['player_name']);
            SqlUtil::multiTextQuery($qb, $texts, ['d' => ['playerName']]);
        }

        // デッキタグ（AND検索）
        if (!empty($searchData['deck_tags'])) {
            foreach ($searchData['deck_tags'] as $deckTagIdx => $DeckTag) {
                if ($DeckTag === null) {
                    continue;
                }
                $qb->join('d.DeckTags', 'dt'.$deckTagIdx, Join::WITH, "dt{$deckTagIdx}.id = :deckTag{$deckTagIdx}")
                    ->setParameter("deckTag{$deckTagIdx}", $DeckTag);
            }
        }

        // カード名（完全一致、日英）
        if (!empty($searchData['card'])) {
            $qb->join('d.DeckCards', 'dc')
                ->join('dc.Card', 'c', Join::WITH, $qb->expr()->orX(
                    $qb->expr()->eq('c.nameJp', ':card'),
                    $qb->expr()->eq('c.nameEn', ':card')
                ))
                ->setParameter('card', $searchData['card']);
        }

        // ★イベント詳細ID（カスタマイズ: イベントIDから差し替え）
        if (!empty($searchData['event_detail_id'])) {
            SqlUtil::searchByIds($qb, $searchData['event_detail_id'], 'ed', 'id');
        }

        // 開催店舗
        if (!empty($searchData['shop'])) {
            $qb->join('ed.Event', 'e')
                ->join('e.BaseInfo', 'bi', Join::WITH, 'bi = :shop')
                ->setParameter('shop', $searchData['shop']);
        }

        // 最終更新者
        if (!empty($searchData['member'])) {
            $qb->andWhere('d.Member = :member')
                ->setParameter('member', $searchData['member']);
        }

        // ソート
        $sortKey = $searchData['sortKey'] ?? self::DEFAULT_SORT_KEY;
        $sortOrder = strtoupper((string) ($searchData['sortOrder'] ?? self::DEFAULT_SORT_ORDER));
        if (!in_array($sortOrder, ['ASC', 'DESC'], true)) {
            $sortOrder = self::DEFAULT_SORT_ORDER;
        }
        $sortColumn = $this->sortKeys[$sortKey] ?? $this->sortKeys[self::DEFAULT_SORT_KEY];
        $qb->orderBy($sortColumn, $sortOrder);

        return $qb;
    }

    // /**
    //  * デッキの件数を返す
    //  *
    //  * @param array<string, mixed> $searchData 検索条件
    //  * @return int 件数
    //  *
    //  * TODO: getQueryBuilderBySearchDataのコメントアウトを外すタイミングでここのコメントアウトも外す
