    public const USING_DECK_RESULT_REDIS_CACHING_TIME = 86400;
    public const USING_DECK_TOP_RESULT_REDIS_CACHING_TIME = 3600;
    public const USING_DECK_TOP_ALL_RESULT_REDIS_CACHING_TIME = 3600;

    public const DEFAULT_SORT_KEY = 'default';
    public const DEFAULT_SORT_ORDER = 'DESC';

    public const DEFAULT_ENTRY_DECK_SEARCH_SORT_KEY = 'event_start_date';

    /**
     * イベント申込一覧（デッキ登録検索）ソートキー（DQL フィールド）
