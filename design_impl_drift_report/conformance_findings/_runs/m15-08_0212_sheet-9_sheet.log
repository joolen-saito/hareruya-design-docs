        .archetype-search-check .form-check { padding-left: 0; margin-right: 0.5rem; }
        .archetype-search-check .form-check-input { margin-left: 0; margin-right: 0.25rem; }
        .archetype-result-table > tbody > tr.archetype-row-striped > td {
            background-color: #f7f7f7 !important;
