   868	    dtb_product p
   869	    INNER JOIN mtb_discount dis
   870	        ON p.discount_id = dis.id
   871	    INNER JOIN dtb_discount_card_condition dcc
   872	        ON dis.id = dcc.discount_id
   873	    INNER JOIN mtb_card_condition cc
