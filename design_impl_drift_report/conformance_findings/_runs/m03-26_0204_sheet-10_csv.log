    27	 * 地域別販売制限IDを検証する Validator 実装。
    28	 */
    29	class RegionRestrictionIdValidator implements ValidatorInterface
    30	{
    31	    use ValidatorTrait;
    32	
    33	    /** @var array<int, array<string, mixed>> 地域別販売制限マスタ（mtb_region_restriction）の内容 */
    34	    private array $regionRestrictions;
    35	
    36	    /**
    37	     * @param EntityManagerInterface $em
    38	     */
    39	    public function __construct(EntityManagerInterface $em)
    40	    {
    41	        $this->regionRestrictions = $this->loadRegionRestrictions($em);
    42	    }
    43	
    44	    /**
    45	     * @param MessageStore $errors エラーメッセージの格納先
    46	     * @param CsvValueInterface $value 検証する値
    47	     *
    48	     * @return bool 値が正しい場合 true
    49	     */
    50	    public function validate(MessageStore $errors, CsvValueInterface $value): bool
    51	    {
    52	        if (!$value->hasValue()) {
    53	            // 未入力の場合はチェックしない
    54	            return true;
    55	        }
    56	
    57	        $validator = function ($v) {
    58	            return array_key_exists((int) $v, $this->regionRestrictions);
    59	        };
    60	
    61	        if (!$value->validate($validator)) {
    62	            $errors->addMasterNotExistsError(
    63	                $value->getRowNumber(),
    64	                $value->getLabel(),
    65	                $value->getOriginalValue()
    66	            );
    67	
    68	            return false;
    69	        }
    70	
    71	        return true;
    72	    }
    73	
    74	    /**
    75	     * 地域別販売制限マスタの内容を配列で返す。
    76	     *
    77	     * @param EntityManagerInterface $em
    78	     *
    79	     * @return array<int, array<string, mixed>> key: 地域別販売制限ID, value: 地域別販売制限マスタの内容
    80	     */
    81	    private function loadRegionRestrictions(EntityManagerInterface $em): array
    82	    {
    83	        $sql = <<<EOT
    84	SELECT
    85	    id
    86	FROM
    87	    mtb_region_restriction
    88	EOT;
    89	
    90	        // 今のところID のみを返している。
    91	        // ほかに情報が必要な場合、適宜追加すること。
    92	
    93	        $rsm = new ResultSetMapping();
    94	        $rsm->addScalarResult('id', 'regionRestrictionId', Types::INTEGER);
    95	
    96	        $query = $em->createNativeQuery($sql, $rsm);
    97	        $result = $query->getResult();
    98	
    99	        // key: 地域別販売制限ID, value: 地域別販売制限マスタの内容 の配列に変換
   100	        $regionRestrictions = [];
   101	        foreach ($result as $row) {
   102	            $regionRestrictions[$row['regionRestrictionId']] = $row;
   103	        }
   104	
   105	        return $regionRestrictions;
   106	    }
   107	}

