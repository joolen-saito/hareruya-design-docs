   522	
   523	        $languageCode = $source['languageCode'];
   524	        $cardConditionCode = $source['cardConditionCode'];
   525	
   526	        $highPriceCode = '';
   527	        if (StringUtil::isNotBlank($source['highPriceCode'] ?? null)) {
   528	            $highPriceCode = str_pad($source['highPriceCode'], 5, '0', STR_PAD_LEFT);
   529	        }
   530	
   531	        return $promotionCode
   532	            .$cardsetCode
   533	            .$foilIdentifier
   534	            .$cardNo
   535	            .$languageCode
   536	            .$cardConditionCode
   537	            .$highPriceCode;
   538	    }
