   162	    public function exportHeader(): void
   163	    {
   164	        if (is_null($this->CsvType) || empty($this->Csvs)) {
   165	            throw new \LogicException('init csv type incomplete.');
   166	        }
   167	
   168	        $row = [];
   169	        foreach ($this->Csvs as $Csv) {
   170	            $row[] = $Csv->getDispName();
   171	        }
   172	
   173	        $this->fopen();
