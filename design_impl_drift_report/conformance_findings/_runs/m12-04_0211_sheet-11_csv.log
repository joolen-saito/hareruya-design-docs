    73	            $this->translator->trans('admin.analysis.sales.result.avg_price'),
    74	            $this->translator->trans('admin.analysis.sales.result.quantity'),
    75	            $this->translator->trans('admin.analysis.sales.result.total'),
    76	            $this->translator->trans('admin.analysis.sales.result.count'),
    77	        ];
    78	    }
    79	
