    16	namespace Eccube\Service\Csv\Exporter;
    17	
    18	use Eccube\Repository\DtbOtcBuyOrderStockHistoryRepository;
    19	use Eccube\Service\CsvExportService;
    20	use Symfony\Component\HttpFoundation\StreamedResponse;
    21	
    22	class OtcBuyOrderHistoryCsvExportService
    23	{
    24	    public function __construct(
    25	        protected CsvExportService $csvExportService,
    26	        protected DtbOtcBuyOrderStockHistoryRepository $stockHistoryRepository,
    27	    ) {
    28	    }
    29	
    30	    /**
    31	     * CSVヘッダー定義
    32	     *
    33	     * @var array<string, string>
    34	     */
    35	    private const CSV_HEADER = [
    36	        'assessmentId' => '査定番号',
    37	        'customerId' => '会員ID',
    38	        'customerName' => '申込者',
    39	        'productCode' => '商品コード',
    40	        'productName' => '商品名',
    41	        'standardPrice' => '基準価格',
    42	        'buyPrice' => '買取価格',
    43	        'shopName' => '買取店舗',
    44	        'memberName' => '作業者',
    45	        'buyQuantity' => '買取数',
    46	        'diffQuantity' => '増減数',
    47	        'completeDate' => '買取日時',
    48	    ];
    49	
    50	    /**
    51	     * 選択したIDでCSV出力
    52	     *
    53	     * @param array<int, int> $historyIds
    54	     */
    55	    public function exportByIds(array $historyIds): StreamedResponse
    56	    {
    57	        return $this->createResponse(
    58	            fn () => $this->stockHistoryRepository->getExportDataByIds($historyIds),
    59	        );
    60	    }
    61	
    62	    /**
    63	     * 検索条件で全件CSV出力
    64	     *
    65	     * @param array<string, mixed> $searchData
    66	     */
    67	    public function exportBySearchData(array $searchData): StreamedResponse
    68	    {
    69	        return $this->createResponse(
    70	            fn () => $this->stockHistoryRepository->getExportDataBySearchData($searchData),
    71	        );
    72	    }
    73	
    74	    /**
    75	     * StreamedResponse を生成
    76	     *
    77	     * @param callable(): iterable<array<string, mixed>> $dataProvider
    78	     */
    79	    private function createResponse(callable $dataProvider): StreamedResponse
    80	    {
    81	        $response = new StreamedResponse();
    82	        $response->setCallback(function () use ($dataProvider): void {
    83	            $this->csvExportService->fopen();
    84	
    85	            $this->csvExportService->fputcsv(array_values(self::CSV_HEADER));
    86	
    87	            $data = $dataProvider();
    88	            foreach ($data as $row) {
    89	                $orderedRow = array_map(
    90	                    fn (string $key): string => (string) ($row[$key] ?? ''),
    91	                    array_keys(self::CSV_HEADER),
    92	                );
    93	                $this->csvExportService->fputcsv($orderedRow);
    94	            }
    95	
    96	            $this->csvExportService->fclose();
    97	        });
    98	
    99	        $now = new \DateTime();
   100	        $filename = 'otc_buy_order_history_'.$now->format('YmdHis').'.csv';
   101	        $response->headers->set('Content-Type', 'application/octet-stream');
   102	        $response->headers->set('Content-Disposition', 'attachment; filename='.$filename);
   103	
   104	        log_info('買取商品履歴CSV出力完了. ファイル名: '.$filename);
   105	
   106	        return $response;
   107	    }
   108	}

