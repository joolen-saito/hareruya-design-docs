    84	            ->addSelect('pc')
    85	            ->addSelect('p')
    86	            ->addSelect('bi')
    87	            ->addSelect('la')
    88	            ->join('obosh.OtcBuyOrderStock', 'obos')
    89	            ->join('obosh.Member', 'm')
    90	            ->join('obos.OtcBuyOrder', 'obo')
    91	            ->join('obos.ProductClass', 'pc')
    92	            ->join('pc.Product', 'p')
    93	            ->join('pc.Language', 'la')
    94	            ->join('obo.OtcBuyOrderStatus', 'obosStatus')
    95	            ->leftJoin('obo.BaseInfo', 'bi');
    96	
    97	        // 会員ID（完全一致）
    98	        if ($searchData->customerId !== null) {
    99	            $qb->andWhere('obo.Customer = :customerId')->setParameter(
   100	                'customerId',
   101	                $searchData->customerId,
   102	            );
   103	        }
   104	
   105	        // 申込者名（空白区切りで複数キーワード、姓・名・姓カナ・名カナに部分一致）
   106	        if ($searchData->customerName !== null) {
   107	            $keywords = preg_split(
   108	                "/[\s,　]+/u",
   109	                trim($searchData->customerName),
   110	            );
   111	            foreach ($keywords as $i => $keyword) {
   112	                if ($keyword === '') {
   113	                    continue;
   114	                }
   115	                $qb->andWhere(
   116	                    $qb
   117	                        ->expr()
   118	                        ->orX(
   119	                            $qb->expr()->like('obo.lastName', ":keyword{$i}"),
   120	                            $qb->expr()->like('obo.firstName', ":keyword{$i}"),
   121	                            $qb
   122	                                ->expr()
   123	                                ->like('obo.lastNameKana', ":keyword{$i}"),
   124	                            $qb
   125	                                ->expr()
   126	                                ->like('obo.firstNameKana', ":keyword{$i}"),
   127	                        ),
   128	                )->setParameter("keyword{$i}", "%{$keyword}%");
   129	            }
   130	        }
   131	
   132	        // 査定ID
   133	        if ($searchData->assessmentId !== null) {
   134	            $qb->andWhere('obo.assessmentId = :assessmentId')->setParameter(
   135	                'assessmentId',
   136	                $searchData->assessmentId,
   137	            );
   138	        }
   139	
   140	        // 査定担当者名（部分一致）
   141	        if ($searchData->assessmentMemberName !== null) {
   142	            $qb->join('obo.Member', 'oboMember')
   143	                ->andWhere('oboMember.name LIKE :assessmentMemberName')
   144	                ->setParameter(
   145	                    'assessmentMemberName',
   146	                    '%'.
   147	                        addcslashes($searchData->assessmentMemberName, '%_').
   148	                        '%',
   149	                );
   150	        }
   151	
   152	        // 店舗ID
   153	        if ($searchData->shop !== null) {
   154	            $qb->andWhere('bi = :shop')->setParameter(
   155	                'shop',
   156	                $searchData->shop,
   157	            );
   158	        }
   159	
   160	        // 買取ステータス
   161	        if (
   162	            $searchData->otcBuyOrderStatus !== null
   163	            && !$searchData->otcBuyOrderStatus->isEmpty()
   164	        ) {
   165	            $qb->andWhere(
   166	                $qb->expr()->in('obo.OtcBuyOrderStatus', ':otcBuyOrderStatus'),
   167	            )->setParameter(
   168	                'otcBuyOrderStatus',
   169	                $searchData->otcBuyOrderStatus->getValues(),
   170	            );
   171	        }
   172	
   173	        // 商品コード
   174	        if ($searchData->productCode !== null) {
   175	            $qb->andWhere('pc.code = :productCode')->setParameter(
   176	                'productCode',
   177	                $searchData->productCode,
   178	            );
   179	        }
   180	
   181	        // 商品名(部分一致)
   182	        if ($searchData->productName !== null) {
   183	            $qb->andWhere('p.name like :productName')->setParameter(
   184	                'productName',
   185	                '%'.addcslashes($searchData->productName, '%_').'%',
   186	            );
   187	        }
   188	
   189	        // 買取日時
   190	        // 買取成立の場合は買取成立日、買取キャンセル日の場合は買取キャンセル日を検索する
   191	        if (!empty($searchData->completeDateFrom)) {
   192	            $qb->andWhere(
   193	                '(obosStatus.id = :cancelStatusId AND obo.cancelDate >= :cancelDateFrom) OR
   194	                        (obosStatus.id != :cancelStatusId AND obo.completeDate >= :completeDateFrom)',
   195	            )
   196	                ->setParameter('cancelStatusId', self::CANCEL_STATUS_ID)
   197	                ->setParameter('cancelDateFrom', $searchData->completeDateFrom)
   198	                ->setParameter(
   199	                    'completeDateFrom',
   200	                    $searchData->completeDateFrom,
   201	                );
   202	        }
   203	
   204	        if (!empty($searchData->completeDateTo)) {
   205	            $qb->andWhere(
   206	                '(obosStatus.id = :cancelStatusId AND obo.cancelDate <= :cancelDateTo) OR
   207	                        (obosStatus.id != :cancelStatusId AND obo.completeDate <= :completeDateTo)',
   208	            )
   209	                ->setParameter('cancelStatusId', self::CANCEL_STATUS_ID)
   210	                ->setParameter('cancelDateTo', $searchData->completeDateTo)
   211	                ->setParameter('completeDateTo', $searchData->completeDateTo);
   212	        }
   213	
   214	        // 買取金額（仕入単価 = 小計 / 数量, DtbOtcBuyOrderStock::getUnitCost() と同等）
   215	        // DQLでROUNDが使えないため、subtotal/quantity >= X を subtotal >= X * quantity に変形
   216	        if ($searchData->buyPriceFrom !== null) {
   217	            $qb->andWhere(
   218	                'obos.subtotal >= :buyPriceFrom * obos.quantity',
   219	            )->setParameter('buyPriceFrom', $searchData->buyPriceFrom);
   220	        }
   221	
   222	        if ($searchData->buyPriceTo !== null) {
   223	            $qb->andWhere(
   224	                'obos.subtotal <= :buyPriceTo * obos.quantity',
   225	            )->setParameter('buyPriceTo', $searchData->buyPriceTo);
   226	        }
   227	
   228	        // 基準価格
   229	        if ($searchData->standardPriceFrom !== null) {
   230	            $qb->andWhere(
   231	                'pc.standardPrice >= :standardPriceFrom',
   232	            )->setParameter(
   233	                'standardPriceFrom',
   234	                $searchData->standardPriceFrom,
   235	            );
   236	        }
   237	
   238	        if ($searchData->standardPriceTo !== null) {
   239	            $qb->andWhere('pc.standardPrice <= :standardPriceTo')->setParameter(
   240	                'standardPriceTo',
   241	                $searchData->standardPriceTo,
   242	            );
   243	        }
   244	
   245	        // 言語
   246	        if (
