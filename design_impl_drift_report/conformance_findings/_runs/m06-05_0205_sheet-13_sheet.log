   298	    public function getExportDataByIds(array $historyIds): iterable
   299	    {
   300	        $qb = $this->buildExportQueryBuilder();
   301	        $qb->andWhere($qb->expr()->in('obosh.id', ':historyIds'))->setParameter(
   302	            'historyIds',
