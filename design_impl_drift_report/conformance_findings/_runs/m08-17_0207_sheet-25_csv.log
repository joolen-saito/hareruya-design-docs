    22	use Symfony\Bridge\Twig\Attribute\Template;
    23	use Symfony\Component\HttpFoundation\Request;
    24	use Symfony\Component\Routing\Attribute\Route;
    25	
    26	class CustomerAddressCsvController extends AbstractController
    27	{
    28	    /**
    29	     * @param CustomerAddressCsvImportHandler $handler
    30	     */
    31	    public function __construct(
    32	        private readonly CustomerAddressCsvImportHandler $handler,
    33	    ) {
    34	    }
    35	
    36	    /**
    37	     * 配送先情報CSVアップロード画面
    38	     *
    39	     * @return array<string, mixed>
    40	     */
    41	    #[Route(path: '/%eccube_admin_route%/customer/address_csv', name: 'admin_customer_address_csv', methods: ['GET', 'POST'])]
    42	    #[Template(template: '@admin/Customer/customer_address_csv.twig')]
    43	    public function index(Request $request): array
    44	    {
    45	        $form = $this->formFactory->createBuilder(CsvImportType::class)->getForm();
    46	        $errors = [];
    47	
    48	        $form->handleRequest($request);
    49	        if ($form->isSubmitted() && $form->isValid()) {
    50	            $formFile = $form['import_file']->getData();
    51	
    52	            if (!empty($formFile)) {
    53	                $this->entityManager->getConfiguration()->setSQLLogger();
    54	
    55	                $Member = $this->getMember();
    56	                $importer = new CsvImporter(
    57	                    $this->entityManager,
    58	                    $this->translator,
    59	                    $this->eccubeConfig,
    60	                    $this->handler,
    61	                    $Member,
    62	                );
    63	
    64	                try {
    65	                    $result = $importer->import($formFile);
    66	                } catch (\Exception $e) {
    67	                    log_error('customer address csv import error', ['message' => $e->getMessage()]);
    68	
    69	                    return [
    70	                        'form' => $form->createView(),
    71	                        'headers' => CustomerAddressCsvImportHandler::getColumnDefs(),
    72	                        'errors' => [$this->translator->trans('admin.common.csv_upload_error')],
    73	                    ];
    74	                }
    75	
    76	                if ($result->hasError()) {
    77	                    $errors = array_map(static fn (array $e): string => $e['message'], $result->getErrors());
    78	                } else {
    79	                    $this->addInfo('admin.common.csv_upload_complete', 'admin');
    80	                }
    81	            }
    82	        }
    83	
    84	        return [
    85	            'form' => $form->createView(),
    86	            'headers' => CustomerAddressCsvImportHandler::getColumnDefs(),
    87	            'errors' => $errors,
    88	        ];
    89	    }
    90	}

