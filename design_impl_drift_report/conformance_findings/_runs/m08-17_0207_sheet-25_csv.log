lock;\n        width: 27px;\n        height: 26px;\n        background: #FFF;\n        border-radius: 50%;\n        position: absolute;\n        top: 2px;\n        left: 2px;\n        transition: all .3s;\n      }\n    }\n    input[type=checkbox]{\n      margin-bottom: 0;\n      display: none;\n      &:checked + label{\n        background-color: #25B877;\n        &:after{\n          left: 21.5px;\n        }\n      }\n    }\n  }\n  &__label {\n    margin-left: 5px;\n    display: inline-block;\n    vertical-align: top;\n    height: 30px;\n    color: #fff;\n    span {\n      vertical-align: middle;\n      line-height: 2;\n    }\n  }\n}\n","//メディアクエリ\n\n@mixin media_mainNav(){\n  @media only screen and (max-width: 1280px) {\n    @content;\n  }\n}\n\n@mixin media_middle(){\n  @media only screen and (min-width: 768px) and (max-width: 1279px) {\n    @content;\n  }\n}\n\n@mixin media_small(){\n  @media only screen and (max-width: 767px) {\n    @content;\n  }\n}\n"]}
