    25	/**
    26	 * 配送先情報CSV取込の行単位検証.
    27	 *
    28	 * 会員・国の存在チェック、郵便番号の相互必須チェック、
    29	 * および都道府県の条件チェックを行う。
    30	 */
    31	final class CustomerAddressRowValidator implements RowValidatorInterface
    32	{
    33	    /**
    34	     * @param CustomerRepository $customerRepository
    35	     * @param CountryRepository $countryRepository
    36	     * @param PrefRepository $prefRepository
    37	     * @param CsvColumnInterface $emailColumn
    38	     * @param CsvColumnInterface $countryColumn
    39	     * @param CsvColumnInterface $zip01Column
    40	     * @param CsvColumnInterface $zip02Column
    41	     * @param CsvColumnInterface $abroadPostalCodeColumn
    42	     * @param CsvColumnInterface $prefColumn
    43	     */
    44	    public function __construct(
    45	        private readonly CustomerRepository $customerRepository,
    46	        private readonly CountryRepository $countryRepository,
    47	        private readonly PrefRepository $prefRepository,
    48	        private readonly CsvColumnInterface $emailColumn,
    49	        private readonly CsvColumnInterface $countryColumn,
    50	        private readonly CsvColumnInterface $zip01Column,
    51	        private readonly CsvColumnInterface $zip02Column,
    52	        private readonly CsvColumnInterface $abroadPostalCodeColumn,
    53	        private readonly CsvColumnInterface $prefColumn,
    54	    ) {
    55	    }
    56	
    57	    /**
    58	     * 行データを検証し、エラーがなければ true を返す.
    59	     *
    60	     * @param MessageStore $errors エラーメッセージストア
    61	     * @param CsvRowInterface $row 検証対象行
    62	     *
    63	     * @return bool 検証結果（エラーなし: true）
    64	     */
    65	    #[\Override]
    66	    public function validate(MessageStore $errors, CsvRowInterface $row): bool
    67	    {
    68	        $rowNumber = $row->getRowNumber();
    69	
    70	        $email = (string) $this->emailColumn->getValue($row);
    71	        $Customer = $this->customerRepository->findOneBy(['email' => $email]);
    72	        if ($Customer === null) {
    73	            $errors->addMasterNotExistsError($rowNumber, 'メールアドレス', $email);
    74	
    75	            return false;
    76	        }
    77	
    78	        $countryName = (string) $this->countryColumn->getValue($row);
    79	        $Country = $this->countryRepository->findOneBy(['name' => $countryName]);
    80	        if ($Country === null) {
    81	            $errors->addMasterNotExistsError($rowNumber, '国(名称)', $countryName);
    82	
    83	            return false;
    84	        }
    85	
    86	        $zip01 = (string) $this->zip01Column->getValue($row);
    87	        $zip02 = (string) $this->zip02Column->getValue($row);
    88	        $abroadPostalCode = (string) $this->abroadPostalCodeColumn->getValue($row);
    89	        $prefName = (string) $this->prefColumn->getValue($row);
    90	
    91	        if ($Country->isJapan()) {
    92	            // 郵便番号1と2はどちらか一方のみの入力は不可
    93	            if (($zip01 === '') !== ($zip02 === '')) {
    94	                $errors->addMessage('admin.customer.delivery_csv.csv_invalid_zipcode_partial', $rowNumber);
    95	
    96	                return false;
    97	            }
    98	            // 日本は郵便番号1・2が必須
    99	            if ($zip01 === '') {
   100	                $errors->addMessage('admin.customer.delivery_csv.csv_invalid_zipcode', $rowNumber);
   101	
   102	                return false;
   103	            }
   104	            // 都道府県が必須
   105	            if ($prefName === '') {
   106	                $errors->addMessage('admin.customer.delivery_csv.csv_invalid_pref', $rowNumber);
   107	
   108	                return false;
   109	            }
   110	            $Pref = $this->prefRepository->findOneBy(['name' => $prefName]);
   111	            if ($Pref === null) {
   112	                $errors->addMasterNotExistsError($rowNumber, '都道府県(名称)', $prefName);
   113	
   114	                return false;
   115	            }
   116	        } else {
   117	            // 海外は海外郵便番号が必須
   118	            if ($abroadPostalCode === '') {
   119	                $errors->addMessage('admin.customer.delivery_csv.csv_invalid_zipcode', $rowNumber);
   120	
   121	                return false;
   122	            }
   123	            // 海外は都道府県指定不可
   124	            if ($prefName !== '') {
   125	                $errors->addMessage('admin.customer.delivery_csv.csv_invalid_pref', $rowNumber);
   126	
   127	                return false;
   128	            }
   129	        }
   130	
   131	        return true;
   132	    }
   133	}

