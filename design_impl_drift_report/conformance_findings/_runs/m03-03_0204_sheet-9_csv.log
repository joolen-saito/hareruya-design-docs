    30	class ProductCardCsv extends AbstractCsvService
    31	{
    32	    public function __construct(
    33	        EntityManagerInterface $entityManager,
    34	        TranslatorInterface $translator,
    35	        EccubeConfig $eccubeConfig,
    36	        private ProductRepository $productRepository,
    37	        private ProductClassRepository $productClassRepository,
    38	        private CsvExportService $csvExportService,
    39	        private BaseInfoRepository $baseInfoRepository,
    40	        array $csvHeader = [],
    41	        array $requiredCsvHeader = [],
    42	    ) {
    43	        parent::__construct($entityManager, $translator, $eccubeConfig, $csvHeader, $requiredCsvHeader);
    44	    }
    45	
    46	    /**
    47	     * CSVを出力する
    48	     *
    49	     * @param array<int, mixed> $productIds
    50	     *
    51	     * @return StreamedResponse
    52	     */
    53	    public function exportCsv(array $productIds): StreamedResponse
    54	    {
    55	        if (empty($productIds) || !$Products = $this->productRepository->findBy(['id' => $productIds])) {
    56	            throw new \RuntimeException($this->translator->trans('admin.csv.error.export.not_registered'));
    57	        }
    58	        $csvRows = $this->convertExportCsvRows($Products, $this->baseInfoRepository->getMallBaseInfo());
    59	        if ($csvRows === []) {
    60	            throw new \RuntimeException($this->translator->trans('admin.csv.error.export.no_card_data'));
    61	        }
    62	        $response = new StreamedResponse();
    63	
    64	        $headerKeys = array_keys($this->csvHeader);
    65	        $response->setCallback(function () use ($csvRows, $headerKeys): void {
    66	            $this->csvExportService->fopen();
    67	            $this->csvExportService->fputcsv($headerKeys);
    68	            foreach ($csvRows as $row) {
    69	                $this->csvExportService->fputcsv(array_map(fn (string $key) => $row[$key] ?? '', $headerKeys));
    70	            }
    71	            $this->csvExportService->fclose();
    72	        });
    73	
    74	        $filename = $this->createFileName('product_card_');
    75	        $this->setCsvResponseHeader($response, $filename);
    76	
    77	        if (function_exists('log_info')) {
    78	            log_info('カード商品CSV出力ファイル名', [$filename]);
    79	        }
    80	
    81	        return $response;
    82	    }
    83	
    84	    /**
    85	     * DtbProductをCSV出力できる形にコンバート
    86	     *
    87	     * @param array<int, Product> $Products Productの配列
    88	     * @param BaseInfo|null $mainBaseInfo 本店BaseInfo（原価単価は本店EC在庫の total_cost/stock を四捨五入）。null の場合は内部で解決する
    89	     *
    90	     * @return array<int, array<string, mixed>>
    91	     */
    92	    public function convertExportCsvRows(array $Products, ?BaseInfo $mainBaseInfo = null): array
    93	    {
    94	        $mainBaseInfo ??= $this->baseInfoRepository->getMallBaseInfo();
    95	        $csvRows = [];
    96	
    97	        foreach ($Products as $Product) {
    98	            if (!$Product->getCardDetail()) {
    99	                continue;
   100	            }
   101	            if (count($Product->getProductClasses()) === 0) {
   102	                continue;
   103	            }
   104	
   105	            $tags = [];
   106	            foreach ($Product->getProductTag() as $tag) {
   107	                $tags[] = $tag->getTagId();
   108	            }
   109	            $tags = array_unique($tags);
   110	            $categories = [];
   111	            foreach ($Product->getProductCategories() as $category) {
   112	                $categories[] = $category->getCategoryId();
   113	            }
   114	            $tagSalesAnalyses = [];
   115	            foreach ($Product->getTagSalesAnalysis() as $tag) {
   116	                $tagSalesAnalyses[] = $tag->getId();
   117	            }
   118	
   119	            $rowBase = [
   120	                '商品ID' => $Product->getId(),
   121	                '言語(ID)' => '',
   122	                '商品公開ステータス' => $Product->getStatus()->getId(),
   123	                '支店の商品公開ステータス' => (int) $Product->isBranchPublished(),
   124	                '商品名(日)' => $Product->getName(),
   125	                '商品名(英)' => $Product->getNameEn(),
   126	                'サイズ' => $Product->getSize(),
   127	                '重量' => $Product->getWeight(),
   128	                '商品説明(日)' => $Product->getDescriptionDetailJp(),
   129	                '商品説明(英)' => $Product->getDescriptionDetailEn(),
   130	                '買取商品説明(日)' => $Product->getBuyDescriptionDetail(),
   131	                '買取商品説明(英)' => $Product->getBuyDescriptionDetailEn(),
   132	                '検索ワード' => $Product->getSearchWord(),
   133	                '規格画像' => '',
   134	                '商品カテゴリ(ID)' => StringUtil::meldStrings(array_map('strval', $categories), ','),
   135	                '購入グループ名称' => $Product->getSellGroup()?->getName() ?? '',
   136	                '割引率(ID)' => $Product->getDiscount()?->getId() ?? '',
   137	                '買取減額率(ID)' => $Product->getBuyDiscount()?->getId() ?? '',
   138	                '略称タグ(ID)' => $Product->getStorageCode()?->getId() ?? '',
   139	                '売上分析タグ(ID)' => implode(',', $tagSalesAnalyses),
   140	                'タグ(ID)' => implode(',', $tags),
   141	                '発送日目安(ID)' => '',
   142	                '販売制限数' => '',
   143	                '基準価格' => '',
   144	                '販売価格' => '',
   145	                '買取価格' => '',
   146	                '原価単価' => '',
   147	                'カード詳細(ID)' => '',
   148	                '地域別販売制限' => $Product->getRegionRestriction()?->getId() ?? '',
   149	                'フリーエリア' => $Product->getFreeArea(),
   150	            ];
   151	
   152	            $productClasses = $this->productClassRepository->getProductClassesForProductCardCsv($Product);
   153	            if ($productClasses === []) {
   154	                continue;
   155	            }
   156	
   157	            foreach ($productClasses as $ProductClass) {
   158	                $row = $rowBase;
   159	                $row['規格画像'] = implode(',', array_filter($ProductClass->getProductClassImages()->map(function ($image) {
   160	                    return $image->getProductImage()?->getFileName();
   161	                })->toArray()));
   162	                $row['言語(ID)'] = $ProductClass->getLanguage()?->getId() ?? '';
   163	                $row['発送日目安(ID)'] = $ProductClass->getDeliveryDuration()?->getId() ?? '';
   164	                $row['販売制限数'] = $ProductClass->getSaleLimit();
   165	                $row['基準価格'] = $ProductClass->getStandardPrice();
   166	                $row['販売価格'] = $ProductClass->getPrice02();
   167	                $row['買取価格'] = $ProductClass->getBuyPrice();
   168	                $row['原価単価'] = $ProductClass->getMainEccubeUnitCost($mainBaseInfo);
   169	                $row['カード詳細(ID)'] = $Product->getCardDetail()->getId();
   170	                $csvRows[] = $row;
   171	            }
   172	        }
   173	
   174	        return $csvRows;
   175	    }
   176	}

