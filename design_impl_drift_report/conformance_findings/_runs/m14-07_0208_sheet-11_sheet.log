   142	     * カード画像をローカルディレクトリへ保存し、保存したファイル名を返す（旧 HareruyaEc S3AccessService::downloadFile 相当）.
   143	     */
   144	    public function downloadCardImageToDirectory(string $dirName, MtbCardImage $cardImage, int $foilFlg = 0): ?string
   145	    {
   146	        $ext = '.jpg';
   147	        $s3Key = ltrim(trim((string) $cardImage->getUrl()), '/');
   148	        $prefix = trim($this->s3Directory, '/');
   149	        if ($prefix !== '' && !str_starts_with($s3Key, $prefix.'/')) {
   150	            $s3Key = $prefix.'/'.$s3Key;
   151	        }
   152	
   153	        $cardDetail = $cardImage->getCardDetail();
   154	        if ($cardDetail === null || $cardDetail->getId() === null) {
   155	            return null;
   156	        }
   157	
   158	        $localFileName = $cardDetail->getId().$ext;
   159	        if ($foilFlg !== 0) {
   160	            $localFileName = 'F'.$localFileName;
   161	        }
   162	
   163	        try {
   164	            $this->client->getObject([
   165	                'Bucket' => $this->bucket,
   166	                'Key' => $s3Key,
   167	                '@http' => ['sink' => $dirName.'/'.$localFileName],
   168	            ]);
   169	        } catch (S3Exception $e) {
   170	            log_info('カード画像S3取得エラー', [$e->getMessage()]);
   171	
   172	            return null;
   173	        }
   174	
   175	        return $localFileName;
   176	    }
