   138	                    SELECT ci.url
   139	                    FROM mtb_card_detail cd
   140	                    JOIN mtb_card_image ci ON cd.id = ci.card_detail_id
   141	                    JOIN mtb_cardset cs ON cd.cardset_id = cs.id
   142	                    WHERE cd.card_id = c.id AND ci.back_flg = false
   143	                    ORDER BY cs.special_flg ASC, cd.promotion_flg ASC, cs.release_date DESC, cd.foil_flg ASC, ci.language_id = :language_id DESC, cd.id DESC
   144	                    limit 1
   145	                ) url
   146	                FROM mtb_card c
   147	                WHERE c.id IN (:card_ids)';
   148	
   149	        $rsm = new ResultSetMapping();
   150	        $rsm->addScalarResult('id', 'id')
   151	            ->addScalarResult('url', 'url');
   152	
   153	        $result = $this->getEntityManager()
   154	            ->createNativeQuery($query, $rsm)
   155	            ->setParameters([
   156	                ':card_ids' => $cardIds,
   157	                ':language_id' => $langId,
   158	            ])
   159	            ->enableResultCache(self::RESULT_CACHING_TIME, 'cardImages-'.implode('_', $cardIds))
   160	            ->getResult();
