    18	use Doctrine\ORM\Query\ResultSetMapping;
    19	use Doctrine\Persistence\ManagerRegistry;
    20	use Eccube\Entity\Master\MtbCard;
    21	use Eccube\Entity\Master\MtbCardDetail;
    22	use Eccube\Entity\Master\MtbCardImage;
    23	use Eccube\Entity\Master\MtbLanguage;
    24	use Eccube\Repository\AbstractRepository;
