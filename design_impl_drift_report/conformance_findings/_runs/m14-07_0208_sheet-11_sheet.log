    26	/**
    27	 * @extends AbstractRepository<MtbCardImage>
    28	 */
    29	class MtbCardImageRepository extends AbstractRepository
    30	{
    31	    public const RESULT_CACHING_TIME = 600;
    32	
    33	    public function __construct(ManagerRegistry $registry)
    34	    {
    35	        parent::__construct($registry, MtbCardImage::class);
    36	    }
    37	
    38	    public function get(int $id = 1): ?MtbCardImage
    39	    {
    40	        return $this->find($id);
    41	    }
    42	
    43	    /**
    44	     * 指定 Card に紐づく代表 CardImage を 1 件返す。MtbCardDetail を経由して取得する。
    45	     */
    46	    public function findOneByCardId(int $cardId): ?MtbCardImage
    47	    {
    48	        return $this->createQueryBuilder('ci')
    49	            ->innerJoin('ci.CardDetail', 'cd')
    50	            ->andWhere('IDENTITY(cd.Card) = :cardId')
    51	            ->setParameter('cardId', $cardId)
    52	            ->setMaxResults(1)
    53	            ->getQuery()
    54	            ->getOneOrNullResult();
    55	    }
    56	
    57	    public function findOneByCardDetail(MtbCardDetail $CardDetail): ?MtbCardImage
    58	    {
    59	        return $this->createQueryBuilder('ci')
    60	            ->andWhere('ci.CardDetail = :CardDetail')
    61	            ->setParameter('CardDetail', $CardDetail)
    62	            ->setMaxResults(1)
    63	            ->getQuery()
    64	            ->getOneOrNullResult();
    65	    }
    66	
    67	    /**
    68	     * カード（MtbCard）から最適な画像（日英優先・非プロモ・非Foil・表面）を1件取得する。
    69	     */
    70	    public function findOptimalByCard(MtbCard $Card): ?MtbCardImage
    71	    {
    72	        return $this->createQueryBuilder('ci')
    73	            ->join('ci.CardDetail', 'cd')
    74	            ->join('cd.Cardset', 'cs')
    75	            ->where('cd.Card = :card')
    76	            ->andWhere('ci.back_flg = :face')
    77	            ->andWhere('ci.Language IN (:languageEn, :languageJp)')
    78	            ->andWhere('cd.promotion_flg = :nonPromotion')
