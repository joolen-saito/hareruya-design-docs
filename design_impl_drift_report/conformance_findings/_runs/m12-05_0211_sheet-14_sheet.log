   436	     * Logical delete request that target non product for batch
   437	     */
   438	    public function deleteRequestByNonProduct(): void
   439	    {
   440	        $time = new \DateTime();
   441	        $sql = <<<EOT
   442	UPDATE
   443	    dtb_product_request pr
   444	JOIN dtb_product_class pc ON pr.product_class_id = pc.product_class_id
   445	LEFT OUTER JOIN dtb_product p ON pc.product_id = p.product_id
   446	SET
   447	    pr.deleted_at = ?
   448	WHERE
   449	    pr.deleted_at IS NULL
   450	AND (
   451	    pc.del_flg = 1
   452	OR
   453	    p.product_id IS NULL
   454	OR
   455	    p.del_flg = 1
   456	)
   457	EOT;
   458	
   459	        $connection = $this->getEntityManager()->getConnection();
   460	        $connection->executeUpdate(
   461	            $sql,
   462	            [
   463	                $time->format(self::MYSQL_DATE_FORMAT),
   464	            ]
   465	        );
   466	    }
