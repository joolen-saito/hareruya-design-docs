   974	        $qtext = '[\x21\x23-\x5b\x5d-\x7e]';
   975	        $qcontent = "(?:$qtext|$quoted_pair)";
   976	        $quoted_string = "\"$qcontent*\"";
   977	        $atext = '[a-zA-Z0-9!#$%&\'*+\-\/\=?^_`{|}~]';
   978	        $dot_atom = "$atext+(?:[.]$atext+)*";
