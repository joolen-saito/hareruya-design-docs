   255	    /**
   256	     * export - 正常系
   257	     * CSV出力が正常に完了すること
   258	     *
   259	     * @group HARERUYA
   260	     */
   261	    public function testExport(): void
   262	    {
   263	        $StorageCode = $this->createStorageCode();
   264	
   265	        $this->client->request('GET', $this->generateUrl('admin_product_storage_code_export'));
   266	
   267	        $this->assertTrue($this->client->getResponse()->isSuccessful());
   268	        $this->assertSame('application/octet-stream', $this->client->getResponse()->headers->get('Content-Type'));
   269	        $this->assertStringContainsString('attachment; filename=storage_code_', $this->client->getResponse()->headers->get('Content-Disposition'));
   270	
   271	        $content = $this->client->getInternalResponse()->getContent();
   272	        $exportEncoding = $this->eccubeConfig['eccube_csv_export_encoding'] ?? 'SJIS-win';
   273	        $contentUtf8 = mb_convert_encoding($content, 'UTF-8', $exportEncoding);
   274	
   275	        $this->assertStringContainsString('ID', $contentUtf8);
   276	        $this->assertStringContainsString('名称', $contentUtf8);
   277	        $this->assertStringContainsString('並び順', $contentUtf8);
   278	        $this->assertStringContainsString((string) $StorageCode->getId(), $contentUtf8);
   279	        $this->assertStringContainsString($StorageCode->getName(), $contentUtf8);
   280	    }
