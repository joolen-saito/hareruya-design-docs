    16	namespace Eccube\Service\S3;
    17	
    18	use Aws\S3\Exception\S3Exception;
    19	use Aws\S3\S3Client;
    20	use Symfony\Component\DependencyInjection\ParameterBag\ParameterBagInterface;
    21	
    22	class FileUploadService
    23	{
    24	    private S3Client $client;
    25	    private string $bucket;
    26	    private string $acl;
    27	    private string $region;
    28	
    29	    /**
    30	     * @param bool $isIdentification バッチ処理バケットフラグ
    31	     */
    32	    public function __construct(
    33	        private readonly ParameterBagInterface $parameterBag,
    34	        bool $isIdentification = false,
    35	    ) {
    36	        $s3Config = $this->parameterBag->get('s3_inventory_check');
    37	
    38	        $this->client = new S3Client([
    39	            'region' => $s3Config['region'],
    40	            'version' => $s3Config['version'],
    41	            'credentials' => $s3Config['credentials'],
    42	            'endpoint' => $s3Config['endpoint'] ?? null,
    43	            'use_path_style_endpoint' => $s3Config['use_path_style_endpoint'] ?? false,
    44	        ]);
    45	
    46	        $this->bucket = $isIdentification ? $s3Config['identificationBucket'] : $s3Config['bucket'];
    47	        $this->acl = $isIdentification ? $s3Config['identificationAcl'] : $s3Config['acl'];
    48	        $this->region = $s3Config['region'];
    49	    }
    50	
    51	    /**
    52	     * upload script
    53	     *
    54	     * @param string $fileName
    55	     * @param string $filePath
    56	     */
    57	    public function putFile(string $fileName, string $filePath): string
    58	    {
    59	        // バケットの存在確認（存在しない場合はバケット作成する）
    60	        try {
    61	            $this->client->headBucket(['Bucket' => $this->bucket]);
    62	        } catch (S3Exception $e) {
    63	            // バケットが存在しない場合 (404 Not Found)
    64	            if ($e->getAwsErrorCode() === 'NoSuchBucket' || $e->getStatusCode() === 404) {
    65	                log_info("バケットが存在しないため作成します: {$this->bucket}");
    66	                // バケット作成
    67	                $this->client->createBucket([
    68	                    'Bucket' => $this->bucket,
    69	                    'CreateBucketConfiguration' => [
    70	                        'LocationConstraint' => $this->region,
    71	                    ],
    72	                ]);
    73	                $this->client->waitUntil('BucketExists', ['Bucket' => $this->bucket]);
    74	                log_info("バケットが作成されました: {$this->bucket}");
    75	            } else {
    76	                throw $e;
    77	            }
    78	        }
    79	
    80	        $this->client->putObject([
    81	            'Bucket' => $this->bucket,
    82	            'Key' => $fileName,
    83	            'SourceFile' => $filePath,
    84	            'ACL' => $this->acl,
    85	        ]);
    86	
    87	        return $fileName;
    88	    }
    89	}

