   203	     * PostgreSQL では {@see save()} の新規パスと同様、シーケンス同期から INSERT までを同一トランザクション＋ LOCK で行う。
   204	     *
   205	     * @throws \InvalidArgumentException 既に id が付与されているとき
   206	     */
   207	    public function saveNewCategoryFromCsvImport(Category $Category): void
   208	    {
   209	        if ($Category->getId() !== null) {
   210	            throw new \InvalidArgumentException('CSV import new row must use a non-persisted Category.');
   211	        }
   212	
   213	        $em = $this->getEntityManager();
   214	
   215	        if ($this->isPostgreSQL()) {
   216	            $em->getConnection()->transactional(function (Connection $conn) use ($em, $Category): void {
   217	                $conn->executeStatement('LOCK TABLE dtb_category IN EXCLUSIVE MODE');
   218	                $this->synchronizePostgreSqlCategoryIdSequenceIfBehind($conn);
   219	                $em->persist($Category);
   220	                $em->flush();
   221	            });
   222	
   223	            return;
   224	        }
   225	
   226	        $em->persist($Category);
   227	        $em->flush();
   228	    }
   229	
   230	    /**
   231	     * 新規カテゴリ用: sort_no 決定と既存行の繰り上げ（DQL UPDATE）.
   232	     */
   233	    private function assignSortNoForNewCategoryAndShiftSiblings(Category $Category): void
   234	    {
   235	        $Parent = $Category->getParent();
   236	        if ($Parent) {
   237	            $sortNo = $Parent->getSortNo() - 1;
   238	        } else {
   239	            $sortNo = $this->createQueryBuilder('c')
   240	                ->select('COALESCE(MAX(c.sort_no), 0)')
   241	                ->getQuery()
   242	                ->getSingleScalarResult();
   243	        }
   244	
   245	        $Category->setSortNo($sortNo + 1);
   246	
   247	        $this
   248	            ->createQueryBuilder('c')
   249	            ->update()
   250	            ->set('c.sort_no', 'c.sort_no + 1')
   251	            ->where('c.sort_no > :sort_no')
   252	            ->setParameter('sort_no', $sortNo)
   253	            ->getQuery()
   254	            ->execute();
   255	    }
   256	
   257	    /**
   258	     * PostgreSQL で CSV 等により明示 ID が投入され、シーケンスが MAX(id) より遅れていると
   259	     * 新規 INSERT 時に主キー重複になる。遅れている場合のみ setval で追いつかせる.
   260	     */
   261	    private function synchronizePostgreSqlCategoryIdSequenceIfBehind(Connection $conn): void
   262	    {
   263	        if (!$this->isPostgreSQL()) {
   264	            return;
   265	        }
   266	        $seqFullName = $conn->fetchOne("SELECT pg_get_serial_sequence('dtb_category', 'id')");
   267	        if ($seqFullName === false || $seqFullName === null || $seqFullName === '') {
   268	            return;
   269	        }
   270	
   271	        $maxId = (int) $conn->fetchOne('SELECT COALESCE(MAX(id), 0) FROM dtb_category');
   272	        if ($maxId < 1) {
   273	            return;
   274	        }
   275	
   276	        $seqFullName = (string) $seqFullName;
   277	        $parts = explode('.', $seqFullName, 2);
   278	        if (count($parts) === 2) {
   279	            [$schema, $sequencename] = $parts;
   280	        } else {
   281	            $schema = 'public';
   282	            $sequencename = $parts[0];
   283	        }
   284	
   285	        $lastValue = (int) $conn->fetchOne(
   286	            'SELECT COALESCE(last_value, 0) FROM pg_sequences WHERE schemaname = ? AND sequencename = ?',
   287	            [$schema, $sequencename]
   288	        );
   289	
   290	        if ($lastValue >= $maxId) {
   291	            return;
   292	        }
   293	
   294	        $conn->executeStatement(
   295	            'SELECT setval(pg_get_serial_sequence(\'dtb_category\', \'id\'), ?, true)',
   296	            [$maxId]
   297	        );
   298	    }
   299	
   300	    /**
   301	     * カテゴリを削除する.
   302	     *
   303	     * @param  Category $Category 削除対象のカテゴリ
   304	     *
   305	     * @throws ForeignKeyConstraintViolationException 外部キー制約違反の場合
   306	     * @throws DriverException SQLiteの場合, 外部キー制約違反が発生すると, DriverExceptionをthrowします.
   307	     */
   308	    #[\Override]
   309	    public function delete($Category): void
   310	    {
   311	        $this
   312	            ->createQueryBuilder('c')
   313	            ->update()
   314	            ->set('c.sort_no', 'c.sort_no - 1')
   315	            ->where('c.sort_no > :sort_no')
   316	            ->setParameter('sort_no', $Category->getSortNo())
   317	            ->getQuery()
   318	            ->execute();
   319	
   320	        $em = $this->getEntityManager();
   321	        $em->remove($Category);
   322	        $em->flush();
   323	    }
   324	}

