   218	    /**
   219	     * 新規登録時のみ。バナー・アイコンを html/upload/save_image/category 配下へ保存しエンティティへ相対パスを設定する.
   220	     *
   221	     * @return array{success: bool, uploadedAbsolutePaths: string[]} success が false のときは移動済みファイルはすべて削除済み
   222	     */
   223	    private function processCategoryImageUploads(FormInterface $form, Category $TargetCategory): array
   224	    {
   225	        if (!$form->has('banner_image_file')) {
   226	            return ['success' => true, 'uploadedAbsolutePaths' => []];
   227	        }
   228	
   229	        $saveImageRoot = rtrim((string) $this->eccubeConfig['eccube_save_image_dir'], '/');
   230	        $categoryDir = $saveImageRoot.'/category';
   231	        if (!is_dir($categoryDir) && !@mkdir($categoryDir, 0775, true) && !is_dir($categoryDir)) {
   232	            $form->addError(new FormError(trans('admin.common.upload_error')));
   233	
   234	            return ['success' => false, 'uploadedAbsolutePaths' => []];
   235	        }
   236	
   237	        $uploadedAbsolutePaths = [];
   238	        $allowExtensions = ['gif', 'jpg', 'jpeg', 'png'];
   239	        $fields = [
   240	            'banner_image_file' => 'setBannerImage',
   241	            'icon_image_file' => 'setIconImage',
   242	        ];
   243	
   244	        foreach ($fields as $fieldName => $setter) {
   245	            $child = $form->get($fieldName);
   246	            $uploaded = $child->getData();
   247	            if (!$uploaded instanceof UploadedFile) {
   248	                continue;
   249	            }
   250	            if ($uploaded->getError() === \UPLOAD_ERR_NO_FILE) {
   251	                continue;
   252	            }
   253	            if (!$uploaded->isValid()) {
   254	                $child->addError(new FormError(trans('admin.common.upload_error')));
   255	                $this->unlinkCategoryImageFiles($uploadedAbsolutePaths);
   256	
   257	                return ['success' => false, 'uploadedAbsolutePaths' => []];
   258	            }
   259	            $mimeType = $uploaded->getMimeType();
   260	            if ($mimeType === null || !str_starts_with((string) $mimeType, 'image')) {
   261	                $child->addError(new FormError(trans('admin.common.upload_error')));
   262	                $this->unlinkCategoryImageFiles($uploadedAbsolutePaths);
   263	
   264	                return ['success' => false, 'uploadedAbsolutePaths' => []];
   265	            }
   266	            $extension = strtolower((string) $uploaded->getClientOriginalExtension());
   267	            if (!in_array($extension, $allowExtensions, true)) {
   268	                $child->addError(new FormError(trans('admin.common.upload_error')));
   269	                $this->unlinkCategoryImageFiles($uploadedAbsolutePaths);
   270	
   271	                return ['success' => false, 'uploadedAbsolutePaths' => []];
   272	            }
   273	            $filename = date('mdHis').uniqid('_').'.'.$extension;
   274	            try {
   275	                $uploaded->move($categoryDir, $filename);
   276	            } catch (\Throwable) {
   277	                $child->addError(new FormError(trans('admin.common.upload_error')));
   278	                $this->unlinkCategoryImageFiles($uploadedAbsolutePaths);
   279	
   280	                return ['success' => false, 'uploadedAbsolutePaths' => []];
   281	            }
   282	            $uploadedAbsolutePaths[] = $categoryDir.'/'.$filename;
   283	            $relativePath = 'category/'.$filename;
   284	            $TargetCategory->{$setter}($relativePath);
   285	        }
   286	
   287	        return ['success' => true, 'uploadedAbsolutePaths' => $uploadedAbsolutePaths];
   288	    }
