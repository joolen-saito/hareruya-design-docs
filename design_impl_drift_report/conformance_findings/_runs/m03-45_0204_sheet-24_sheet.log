   464	            $this->addSuccess('admin.common.delete_complete', 'admin');
   465	
   466	            log_info('カテゴリ削除完了', [$id]);
   467	
   468	            $cacheUtil->clearDoctrineCache();
   469	        } catch (\Exception $e) {
   470	            log_info('カテゴリ削除エラー', [$id, $e]);
   471	
   472	            $message = trans('admin.common.delete_error_foreign_key', ['%name%' => $TargetCategory->getName()]);
   473	            $this->addError($message, 'admin');
   474	        }
   475	
   476	        if ($Parent) {
   477	            return $this->redirectToRoute('admin_product_category_show', ['parent_id' => $Parent->getId()]);
   478	        } else {
   479	            return $this->redirectToRoute('admin_product_category');
   480	        }
   481	    }
   482	
   483	    /**
   484	     * 一覧の並び順（sort_no）更新（Ajax POST）。カテゴリ新規登録は {@see create} のみ。
   485	     *
   486	     * @throws BadRequestHttpException|\Exception
   487	     */
   488	    #[Route(path: '/%eccube_admin_route%/product/category/sort_no/move', name: 'admin_product_category_sort_no_move', methods: ['POST'])]
   489	    public function moveSortNo(Request $request, CacheUtil $cacheUtil): Response
   490	    {
   491	        if (!$request->isXmlHttpRequest()) {
   492	            throw new BadRequestHttpException();
   493	        }
   494	
   495	        if ($this->isTokenValid()) {
   496	            $sortNos = $request->request->all();
   497	            unset($sortNos[Constant::TOKEN_NAME]);
   498	
   499	            foreach ($sortNos as $categoryId => $sortNo) {
   500	                /** @var Category $Category */
   501	                $Category = $this->categoryRepository
   502	                    ->find($categoryId);
   503	                $Category->setSortNo((int) $sortNo);
   504	                $this->entityManager->persist($Category);
   505	            }
   506	            $this->entityManager->flush();
   507	
   508	            $cacheUtil->clearDoctrineCache();
   509	
   510	            return new Response('Successful');
   511	        }
   512	
   513	        throw new BadRequestHttpException();
   514	    }
   515	
   516	    /**
   517	     * カテゴリCSVの出力.
   518	     */
   519	    #[Route(path: '/%eccube_admin_route%/product/category/export', name: 'admin_product_category_export', methods: ['GET'])]
   520	    public function export(): StreamedResponse
   521	    {
   522	        set_time_limit(0);
   523	
   524	        $em = $this->entityManager;
   525	        $em->getConfiguration()->setSQLLogger();
   526	
   527	        $Csvs = $this->csvRepository->findByCsvTypeIdAndEnabledOrderBySortNo(
   528	            CsvType::CSV_TYPE_CATEGORY,
   529	            true,
   530	            'ASC',
   531	        );
   532	        $response = new StreamedResponse();
   533	        $response->setCallback(function () use ($Csvs): void {
   534	            $this->csvExportService->fopen();
   535	
   536	            $header = [];
   537	            foreach ($Csvs as $Csv) {
   538	                $header[] = $Csv->getDispName();
   539	            }
   540	            $this->csvExportService->fputcsv($header);
   541	
   542	            $Categories = $this->categoryRepository->findBy([], ['sort_no' => 'DESC']);
   543	            $categoryIds = array_values(array_filter(
   544	                array_map(static fn (Category $c): ?int => $c->getId(), $Categories),
   545	                static fn (?int $id): bool => $id !== null && $id > 0
   546	            ));
   547	            $productCountByCategoryId = $this->productCategoryRepository->getProductCountMapByCategoryIds($categoryIds);
   548	            foreach ($Categories as $Category) {
   549	                $row = [];
   550	                foreach ($Csvs as $Csv) {
   551	                    if ($Csv->getFieldName() === self::CATEGORY_CSV_FIELD_TARGET_PRODUCT_COUNT) {
   552	                        $cid = $Category->getId();
   553	                        $row[] = $cid !== null ? (string) ($productCountByCategoryId[$cid] ?? 0) : '0';
   554	
   555	                        continue;
   556	                    }
   557	                    if ($Csv->getFieldName() === self::CATEGORY_CSV_FIELD_PARENT) {
   558	                        $Parent = $Category->getParent();
   559	                        $row[] = $Parent !== null ? (string) $Parent->getId() : '0';
   560	
   561	                        continue;
   562	                    }
   563	                    $cell = $this->csvExportService->getData($Csv, $Category);
   564	                    $row[] = $cell !== null && $cell !== '' ? $cell : '';
   565	                }
   566	                $this->csvExportService->fputcsv($row);
   567	            }
   568	
   569	            $this->csvExportService->fclose();
   570	        });
   571	
   572	        $now = new \DateTime();
   573	        $filename = 'category_'.$now->format('YmdHis').'.csv';
   574	        $response->headers->set('Content-Type', 'application/octet-stream');
   575	        $response->headers->set('Content-Disposition', 'attachment; filename='.$filename);
   576	
   577	        log_info('カテゴリCSV出力ファイル名', [$filename]);
   578	
   579	        return $response;
   580	    }
   581	}

