    13	
    14	namespace Eccube\Repository;
    15	
    16	use Doctrine\DBAL\ParameterType;
    17	use Doctrine\Persistence\ManagerRegistry as RegistryInterface;
    18	use Eccube\Entity\ProductCategory;
    19	
    20	/**
    21	 * ProductCategoryRepository
    22	 *
    23	 * This class was generated by the Doctrine ORM. Add your own custom
    24	 * repository methods below.
    25	 *
    26	 * @extends AbstractRepository<ProductCategory>
    27	 */
    28	class ProductCategoryRepository extends AbstractRepository
    29	{
    30	    public function __construct(RegistryInterface $registry)
    31	    {
    32	        parent::__construct($registry, ProductCategory::class);
    33	    }
    34	
    35	    /**
    36	     * 管理画面 CSV 用。指定カテゴリ ID ごとに dtb_product_category 上の紐づき商品数（同一商品は 1）を数える.
    37	     * base_info は会社情報のため admin 集計では条件に含めない.
    38	     *
    39	     * @param list<int> $categoryIds
    40	     *
    41	     * @return array<int, int> category_id => count
    42	     */
    43	    public function getProductCountMapByCategoryIds(array $categoryIds): array
    44	    {
    45	        $categoryIds = array_values(array_unique(array_values(array_filter(
    46	            array_map(static fn (mixed $id): int => (int) $id, $categoryIds),
    47	            static fn (int $id): bool => $id > 0
    48	        ))));
    49	        if ($categoryIds === []) {
    50	            return [];
    51	        }
    52	
    53	        $placeholders = implode(',', array_fill(0, count($categoryIds), '?'));
    54	        $sql = 'SELECT category_id, COUNT(DISTINCT product_id) FROM dtb_product_category '
    55	            ."WHERE category_id IN ($placeholders) "
    56	            .'GROUP BY category_id';
    57	
    58	        $types = array_fill(0, count($categoryIds), ParameterType::INTEGER);
    59	
    60	        $rows = $this->getEntityManager()->getConnection()->fetchAllKeyValue($sql, $categoryIds, $types);
    61	
    62	        $map = [];
    63	        foreach ($rows as $categoryId => $count) {
    64	            $map[(int) $categoryId] = (int) $count;
    65	        }
    66	
    67	        return $map;
    68	    }
    69	}

