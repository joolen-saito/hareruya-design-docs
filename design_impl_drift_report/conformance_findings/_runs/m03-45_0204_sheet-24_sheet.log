    27	class CategoryListBlockPayloadBuilder
    28	{
    29	    public function __construct(
    30	        private readonly RequestStack $requestStack,
    31	        private readonly TopCategoryListBuilder $topCategoryListBuilder,
    32	        private readonly MtbCardsetRepository $mtbCardsetRepository,
    33	    ) {
    34	    }
    35	
    36	    /**
    37	     * @return array{
    38	     *     latestSetItems: list<array<string, mixed>>,
    39	     *     formatGroups: list<array{type: string, items: list<array<string, mixed>>}>,
    40	     *     othersItems: list<array<string, mixed>>,
    41	     *     RecentCardset: MtbCardset|null
    42	     * }
    43	     */
    44	    public function build(): array
    45	    {
    46	        $mainRequest = $this->requestStack->getMainRequest() ?? $this->requestStack->getCurrentRequest();
    47	        if ($mainRequest === null) {
    48	            throw new \RuntimeException('Request is not available.');
    49	        }
    50	
    51	        $locale = $mainRequest->getLocale();
    52	        $mainRoute = (string) $mainRequest->attributes->get('_route', '');
    53	        $linkContext = str_starts_with($mainRoute, 'purchase_')
    54	            ? CategorySidebarLinkContext::forPurchase()
    55	            : CategorySidebarLinkContext::forProduct();
    56	        $groups = $this->topCategoryListBuilder->build($locale, $linkContext);
    57	
    58	        $formats = [
    59	            ['type' => TopCategoryListBuilder::GROUP_STANDARD, 'items' => $groups[TopCategoryListBuilder::GROUP_STANDARD]['items']],
    60	            ['type' => TopCategoryListBuilder::GROUP_PIONEER, 'items' => $groups[TopCategoryListBuilder::GROUP_PIONEER]['items']],
    61	            ['type' => TopCategoryListBuilder::GROUP_MODERN, 'items' => $groups[TopCategoryListBuilder::GROUP_MODERN]['items']],
    62	            ['type' => TopCategoryListBuilder::GROUP_LEGACY, 'items' => $groups[TopCategoryListBuilder::GROUP_LEGACY]['items']],
    63	            ['type' => TopCategoryListBuilder::GROUP_COMMANDER, 'items' => $groups[TopCategoryListBuilder::GROUP_COMMANDER]['items']],
    64	        ];
    65	
    66	        return [
    67	            'latestSetItems' => $groups[TopCategoryListBuilder::GROUP_LATEST_SET]['items'],
    68	            'formatGroups' => $formats,
    69	            'othersItems' => $groups[TopCategoryListBuilder::GROUP_OTHERS]['items'],
    70	            'RecentCardset' => $this->mtbCardsetRepository->getRecentCardset(),
    71	        ];
    72	    }
    73	}

