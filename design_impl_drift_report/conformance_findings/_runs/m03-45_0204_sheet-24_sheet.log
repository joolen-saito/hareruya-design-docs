   297	    /**
   298	     * @param list<string> $absolutePaths save_image 配下へ移動済みの絶対パス（検証後にのみ削除）
   299	     */
   300	    private function unlinkCategoryImageFiles(array $absolutePaths): void
   301	    {
   302	        $rootReal = realpath(rtrim((string) $this->eccubeConfig['eccube_save_image_dir'], '/\\'));
   303	        if ($rootReal === false) {
   304	            return;
   305	        }
   306	        $rootNorm = str_replace('\\', '/', $rootReal);
   307	
   308	        foreach ($absolutePaths as $path) {
   309	            if ($path === '') {
   310	                continue;
   311	            }
   312	            $fileReal = realpath($path);
   313	            if ($fileReal === false || !is_file($fileReal)) {
   314	                continue;
   315	            }
   316	            $fileNorm = str_replace('\\', '/', $fileReal);
   317	            if (!str_starts_with($fileNorm, $rootNorm.'/')) {
   318	                continue;
   319	            }
   320	            @unlink($fileReal);
   321	        }
   322	    }
