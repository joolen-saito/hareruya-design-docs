    35	     * フロント表示対象のカテゴリについて、ルート直下から全ツリー構造を取得する
    36	     */
    37	    #[Route(path: '/api/categories/tree', name: 'api_categories_tree', methods: ['GET'])]
    38	    public function getCategoryTree(): JsonResponse
    39	    {
    40	        return $this->json($this->buildFullCategoryTreeNodes(), Response::HTTP_OK);
    41	    }
    42	
    43	    /**
    44	     * @return array<int, array<string, mixed>>
    45	     */
    46	    private function buildFullCategoryTreeNodes(): array
    47	    {
    48	        $tree = [];
    49	        foreach ($this->categoryRepository->getList() as $Category) {
    50	            foreach ($this->categoryTreeResponseBuilder->buildRoots($Category) as $node) {
    51	                $tree[] = $node;
    52	            }
    53	        }
    54	
    55	        return $tree;
    56	    }
    57	
    58	    /**
    59	     * 指定したカテゴリ ID をルートとしたツリー構造を取得する（本店想定・支店非表示フラグは見ない）
    60	     */
    61	    #[Route(path: '/api/categories/{id}/tree', name: 'api_categories_tree_by_id', requirements: ['id' => '\\d+'], methods: ['GET'])]
    62	    public function getCategoryTreeById(int $id): JsonResponse
    63	    {
    64	        return $this->respondCategoryTree($id, false);
    65	    }
    66	
    67	    /**
    68	     * 支店フラグ branch に応じたツリー（true: 支店向け、branch_hide_flg を除外）
    69	     */
    70	    #[Route(path: '/api/categories/{id}/tree/{branch}', name: 'api_categories_tree_by_id_branch', requirements: ['id' => '\\d+', 'branch' => 'true|false'], methods: ['GET'])]
    71	    public function getCategoryTreeByBranch(int $id, string $branch): JsonResponse
    72	    {
    73	        return $this->respondCategoryTree($id, $branch === 'true');
    74	    }
    75	
    76	    private function respondCategoryTree(int $id, bool $branchContext): JsonResponse
    77	    {
    78	        $Category = $this->categoryRepository->getTreeByRootId($id);
    79	        if ($Category === null) {
    80	            throw new NotFoundException('カテゴリが見つかりません');
    81	        }
    82	
    83	        $tree = $this->categoryTreeResponseBuilder->buildRoots($Category, $branchContext);
    84	        if ($tree === []) {
    85	            throw new NotFoundException('カテゴリが見つかりません');
    86	        }
    87	
    88	        return $this->json($tree, Response::HTTP_OK);
    89	    }
    90	}

