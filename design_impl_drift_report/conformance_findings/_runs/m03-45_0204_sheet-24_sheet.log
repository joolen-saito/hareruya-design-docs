    22	{% block javascript %}
    23	<script nonce="{{ csp_nonce }}">
    24	        $(function() {
    25	            // 初期表示時のsort noを保持.
    26	            var oldSortNos = [];
    27	            $('.sortable-item').each(function() {
    28	                oldSortNos.push(this.dataset.sortNo);
    29	            });
    30	            oldSortNos.sort(function(a, b) {
    31	                return a - b;
    32	            }).reverse();
    33	            // 並び替え後にsort noを更新
    34	            var updateSortNo = function() {
    35	                var newSortNos = {};
    36	                var i = 0;
    37	                $('.sortable-item').each(function() {
    38	                    newSortNos[this.dataset.id] = oldSortNos[i];
    39	                    i++;
    40	                });
    41	                $.ajax({
    42	                    url: '{{ url('admin_product_category_sort_no_move') }}',
    43	                    type: 'POST',
    44	                    data: newSortNos
    45	                }).always(function() {
    46	                    $(".modal-backdrop").remove();
    47	                });
    48	            };
    49	            var redrawDisableAllows = function() {
    50	                var items = $('.sortable-item');
    51	                items.find('a.action-up').removeClass('disabled');
    52	                items.find('a.action-down').removeClass('disabled');
    53	                items.first().find('a.action-up').addClass('disabled');
    54	                items.last().find('a.action-down').addClass('disabled');
    55	            };
    56	            // オーバレイ後, 表示順の更新を行う
    57	            var moveSortNo = function() {
    58	                $('body').append($('<div class="modal-backdrop show"></div>'));
    59	                updateSortNo();
    60	                redrawDisableAllows();
    61	            };
    62	            var categorySortDragConfirmMessage = {{ 'admin.product.category_sort_drag_confirm'|trans|json_encode|raw }};
    63	            var previousSortableOrder = [];
    64	            // Drag and Drop
    65	            $('.sortable-container').sortable({
    66	                items: '> .sortable-item',
    67	                cursor: 'move',
    68	                start: function() {
    69	                    previousSortableOrder = [];
    70	                    $(this).find('.sortable-item').each(function() {
    71	                        previousSortableOrder.push(this.id);
    72	                    });
    73	                },
    74	                update: function(e, ui) {
    75	                    if (!window.confirm(categorySortDragConfirmMessage)) {
    76	                        var container = this;
    77	                        previousSortableOrder.forEach(function(elementId) {
    78	                            var el = document.getElementById(elementId);
    79	                            if (el) {
    80	                                container.appendChild(el);
    81	                            }
    82	                        });
    83	                        return;
    84	                    }
    85	                    moveSortNo();
    86	                }
    87	            });
    88	            // Up
    89	            $('.sortable-item').on('click', 'a.action-up', function(e) {
    90	                e.preventDefault();
    91	                var current = $(this).parents("li");
    92	                if (!current.prev().hasClass('sortable-item')) {
    93	                    return;
    94	                }
    95	                if (!window.confirm(categorySortDragConfirmMessage)) {
    96	                    return;
    97	                }
    98	                current.prev().before(current);
    99	                moveSortNo();
   100	            });
   101	            // Down
   102	            $('.sortable-item').on('click', 'a.action-down', function(e) {
   103	                e.preventDefault();
   104	                var current = $(this).parents("li");
   105	                if (!current.next().hasClass('sortable-item')) {
   106	                    return;
   107	                }
   108	                if (!window.confirm(categorySortDragConfirmMessage)) {
   109	                    return;
   110	                }
   111	                current.next().after(current);
   112	                moveSortNo();
   113	            });
   114	
   115	            // 削除モーダルのhrefとmessageの変更
   116	            $('#DeleteModal').on('shown.bs.modal', function(event) {
   117	                var target = $(event.relatedTarget);
   118	                // hrefの変更
   119	                $(this).find('[data-method="delete"]').attr('href', target.data('url'));
   120	
   121	                // messageの変更
   122	                $(this).find('p.modal-message').text(target.data('message'));
   123	            });
   124	
   125	            {% if allowCategoryImageUpload|default(false) %}
   126	            function categoryImageValidateFile(file) {
   127	                if (!file || !file.type.match(/^image\//)) {
   128	                    return false;
   129	                }
   130	                var ext = (file.name.split('.').pop() || '').toLowerCase();
   131	                return ['gif', 'jpg', 'jpeg', 'png'].indexOf(ext) !== -1;
   132	            }
   133	            function categoryImageSetInputFile(input, file) {
   134	                var dt = new DataTransfer();
   135	                dt.items.add(file);
   136	                input.files = dt.files;
   137	                $(input).trigger('change');
   138	            }
   139	            function initCategoryImageDropzone(inputSelector, dropzoneSelector, listSelector, hintSelector) {
   140	                var $input = $(inputSelector);
   141	                var $dropzone = $(dropzoneSelector);
   142	                var $list = $(listSelector);
   143	                var $hint = $(hintSelector);
   144	                function renderPreview(file) {
   145	                    $list.empty();
   146	                    if (!file || !categoryImageValidateFile(file)) {
   147	                        $hint.show();
   148	                        return;
   149	                    }
   150	                    $hint.hide();
   151	                    var reader = new FileReader();
   152	                    reader.onload = function(e) {
   153	                        $list.append(
   154	                            $('<li style="float: left; margin-right: 10px; margin-bottom: 10px;"></li>').append(
   155	                                $('<img alt="">').attr('src', e.target.result).css({
   156	                                    width: '120px',
   157	                                    height: '160px',
   158	                                    objectFit: 'contain',
   159	                                    padding: '5px'
   160	                                })
   161	                            )
   162	                        );
   163	                    };
   164	                    reader.readAsDataURL(file);
   165	                }
   166	                $input.on('change', function() {
   167	                    var file = this.files && this.files[0];
   168	                    if (file && !categoryImageValidateFile(file)) {
   169	                        this.value = '';
   170	                        renderPreview(null);
   171	                        return;
   172	                    }
   173	                    renderPreview(file || null);
   174	                });
   175	                $dropzone.on('click', function() {
   176	                    var el = $input[0];
   177	                    if (el) {
   178	                        el.click();
   179	                    }
   180	                });
   181	                $dropzone.on('dragover', function(e) {
   182	                    e.preventDefault();
   183	                    e.stopPropagation();
   184	                    $dropzone.addClass('border-primary');
   185	                });
   186	                $dropzone.on('drop', function(e) {
   187	                    e.preventDefault();
   188	                    e.stopPropagation();
   189	                    $dropzone.removeClass('border-primary');
   190	                    var file = e.originalEvent.dataTransfer && e.originalEvent.dataTransfer.files[0];
   191	                    if (!file) {
   192	                        return;
   193	                    }
   194	                    if (!categoryImageValidateFile(file)) {
   195	                        return;
   196	                    }
   197	                    categoryImageSetInputFile($input[0], file);
   198	                });
   199	            }
   200	            initCategoryImageDropzone(
   201	                '#admin_category_banner_image_file',
   202	                '#category-banner-drag-drop-area',
   203	                '#category-banner-thumbnails',
   204	                '#category-banner-dropzone-hint'
   205	            );
   206	            initCategoryImageDropzone(
   207	                '#admin_category_icon_image_file',
   208	                '#category-icon-drag-drop-area',
   209	                '#category-icon-thumbnails',
   210	                '#category-icon-dropzone-hint'
   211	            );
   212	            {% endif %}
   213	        });
   214	    </script>
