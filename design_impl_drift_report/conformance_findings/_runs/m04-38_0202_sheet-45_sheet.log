    52	     * @return list<array<string, mixed>>
    53	     */
    54	    public function build(iterable $StockApprovalLists): array
    55	    {
    56	        $rows = [];
    57	        $locationNames = ProductStock::STOCK_LOCATION_ID_TO_NAME;
    58	
    59	        foreach ($StockApprovalLists as $ApprovalList) {
    60	            $typeId = $ApprovalList->getHistorySourceTypeId();
    61	
    62	            $approvalTargetLabel = $ApprovalList->getApprovalTargetLabel();
    63	            $approvalTargetLink = '#';
    64	            $approvalTargetLinkOpenType = '_self';
    65	
    66	            // 在庫移動振替の場合はラベル・リンク先を移動・振替に細分化
    67	            if (in_array($typeId, [MtbStockHistorySourceType::STOCK_MOVE_EDIT, MtbStockHistorySourceType::STOCK_TRANSFER_EDIT], true)) {
    68	                $stockChangeTypeId = $ApprovalList->getStockChangeTypeId();
    69	                if ($stockChangeTypeId === MtbStockChangeType::MOVE) {
    70	                    $approvalTargetLabel = 'admin.stock.approval_list.approval_target_stock_move';
    71	                    $approvalTargetLink = $this->urlGenerator->generate('admin_stock_move', ['id' => $ApprovalList->getHistorySourceId()]);
    72	                } elseif ($stockChangeTypeId === MtbStockChangeType::TRANSFER) {
    73	                    $approvalTargetLabel = 'admin.stock.approval_list.approval_target_stock_transfer';
    74	                    $approvalTargetLink = $this->urlGenerator->generate('admin_stock_transfer', ['id' => $ApprovalList->getHistorySourceId()]);
    75	                }
    76	
    77	                $approvalTargetLinkOpenType = '_blank';
    78	            } elseif ($typeId === MtbStockHistorySourceType::STOCK_SPLIT_EDIT) {
    79	                $approvalTargetLink = $this->urlGenerator->generate('admin_stock_split_approval', ['id' => $ApprovalList->getHistorySourceId()]);
    80	                $approvalTargetLinkOpenType = '_blank';
    81	            } elseif ($typeId === MtbStockHistorySourceType::STOCK_JOIN_EDIT) {
    82	                $approvalTargetLink = $this->urlGenerator->generate('admin_stock_join_approval', ['id' => $ApprovalList->getHistorySourceId()]);
    83	                $approvalTargetLinkOpenType = '_blank';
    84	            }
    85	
    86	            /** @var ?Member $user */
    87	            $user = $this->context->getCurrentUser();
    88	            $currentMemberId = $user?->getId();
    89	
    90	            $isBulkActionable = in_array($typeId, self::BULK_ACTIONABLE_HISTORY_SOURCE_TYPE_IDS, true)
    91	                && $ApprovalList->getApprovalStatus() === DtbStockApprovalList::APPROVAL_STATUS_UNAPPROVED
    92	                && $ApprovalList->getRegisteredMember()->getId() !== $currentMemberId; // 登録者と現在のログインユーザーが違う場合のみ一括操作を可能にする
