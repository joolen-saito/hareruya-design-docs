   106	        // 入庫時の総原価 = 登録時点の総原価 + (入庫単価 × 数量)
   107	        $totalCostBefore = $ProductStock->getTotalCost();
   108	        $totalCostAfter = bcadd($totalCostBefore, bcmul($purchaseUnitPrice, $editQuantity, 0), 0);
