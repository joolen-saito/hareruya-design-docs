    56	     *         id?:int|null,
    57	     *     } $searchData
    58	     */
    59	    public function getQueryBuilderBySearchDataForAdmin(array $searchData): QueryBuilder
    60	    {
    61	        $qb = $this->createQueryBuilder('a')
    62	            ->select('a')
