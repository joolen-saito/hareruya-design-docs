    96	
    97	            $registeredMemberName = $ApprovalList->getRegisteredMember()->getName() ?? '-';
    98	
    99	            $ApprovalMember = $ApprovalList->getApprovalMember();
   100	            $approvalMemberName = $ApprovalMember !== null ? ($ApprovalMember->getName() ?? null) : null;
   101	
   102	            // 編集・一括編集・変更CSV・分割・結合、合計在庫増減数・合計総原価増減数・在庫変動区分を表示
   103	            if ($typeId === MtbStockHistorySourceType::STOCK_EDIT
   104	                || $typeId === MtbStockHistorySourceType::STOCK_BULK_EDIT
   105	                || $typeId === MtbStockHistorySourceType::STOCK_CHANGE_CSV_IMPORT
   106	                || $typeId === MtbStockHistorySourceType::STOCK_SPLIT_EDIT
   107	                || $typeId === MtbStockHistorySourceType::STOCK_JOIN_EDIT) {
   108	                $totalChangeQuantity = $ApprovalList->getInventoryChangeTotalCount();
   109	                $totalCostChange = '¥'.number_format($ApprovalList->getTotalCostPriceBefore());
   110	                $changeTypeDetailName = $ApprovalList->getChangeTypeParentLabel().'/'.$ApprovalList->getChangeTypeChildLabel();
   111	            } else {
   112	                $totalChangeQuantity = '-';
   113	                $totalCostChange = '-';
   114	                $changeTypeDetailName = '-';
   115	            }
   116	
   117	            $rows[] = [
   118	                'id' => $ApprovalList->getId(),
   119	                'approval_status_id' => $ApprovalList->getApprovalStatus(),
   120	                'approval_status_label' => $ApprovalList->getApprovalStatusLabel(),
   121	                'approval_target_label' => $approvalTargetLabel,
   122	                'approval_target_link' => $approvalTargetLink,
   123	                'approval_target_link_open_type' => $approvalTargetLinkOpenType,
   124	                'is_bulk_actionable' => $isBulkActionable,
   125	                'store_name' => $storeName,
   126	                'stock_location_id' => $ApprovalList->getStockLocationId(),
   127	                'stock_location_name' => $locationNames[$ApprovalList->getStockLocationId()] ?? '-',
   128	                'target_product_count' => $ApprovalList->getProductStockTotalCount(),
   129	                'total_change_quantity' => $totalChangeQuantity,
   130	                'total_cost_change' => $totalCostChange,
   131	                'change_type_detail_name' => $changeTypeDetailName,
   132	                'registered_date' => $ApprovalList->getRegisteredDate(),
   133	                'registered_member_name' => $registeredMemberName,
   134	                'approved_date' => $ApprovalList->getApprovedDate(),
   135	                'approval_member_name' => $approvalMemberName,
   136	            ];
   137	        }
   138	
   139	        return $rows;
   140	    }
   141	}

