   110	
   111	        $this->productStockEntityManager->save(
   112	            ProductStock: $ProductStock,
   113	            ProductClass: $ProductStock->getProductClass(),
   114	            BaseInfo: $ProductStock->getBaseInfo(),
   115	            stock: $stockAfter,
   116	            pickUpFlg: $ProductStock->getPickUpFlg(),
   117	            stockLocationId: $ProductStock->getStockLocationId(),
   118	            totalCost: $totalCostAfter,
   119	        );
   120	
   121	        $this->stockHistoryEntityManager->save(
   122	            ProductStock: $ProductStock,
   123	            StockChangeTypeDetail: $StockChangeTypeDetail,
   124	            oldStock: $beforeEditQuantity,
   125	            stock: $stockAfter,
   126	            stockChangeQuantity: $editQuantity,
   127	            sellPrice: (string) $ProductStock->getProductClass()->getPrice02(),
