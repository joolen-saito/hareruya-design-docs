    77	                if (!in_array($StockApprovalList->getHistorySourceTypeId(), [
    78	                    MtbStockHistorySourceType::STOCK_EDIT,
    79	                    MtbStockHistorySourceType::STOCK_BULK_EDIT,
    80	                    MtbStockHistorySourceType::STOCK_CHANGE_CSV_IMPORT,
