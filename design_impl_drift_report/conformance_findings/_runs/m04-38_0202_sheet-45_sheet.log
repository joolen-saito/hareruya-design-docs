    29	    }
    30	
    31	    public function save(
    32	        ?DtbStockApprovalList $StockApprovalList,
    33	        BaseInfo $BaseInfo,
    34	        ?int $StockLocationId,
    35	        MtbStockHistorySourceType $HistorySourceType,
    36	        int $historySourceId,
    37	        ?MtbStockChangeTypeDetail $StockTransferTypeDetail,
    38	        int $approvalStatus,
    39	        \DateTime $registeredDate,
    40	        Member $RegisteredMember,
    41	        ?\DateTime $approvedDate = null,
    42	        ?Member $ApprovalMember = null,
    43	        ?int $ProductStockTotalCount = null,
    44	        ?int $InventoryChangeTotalCount = null,
    45	        ?int $TotalCostPriceBefore = null,
    46	    ): DtbStockApprovalList {
    47	        if (empty($StockApprovalList)) {
    48	            $StockApprovalList = new DtbStockApprovalList();
    49	        }
    50	        $StockApprovalList->setStockLocationId($StockLocationId);
    51	        $StockApprovalList->setHistorySourceType($HistorySourceType);
    52	        $StockApprovalList->setHistorySourceId($historySourceId);
    53	        $StockApprovalList->setStockTransferTypeDetail($StockTransferTypeDetail);
    54	        $StockApprovalList->setApprovalStatus($approvalStatus);
    55	        $StockApprovalList->setRegisteredDate($registeredDate);
    56	        $StockApprovalList->setRegisteredMember($RegisteredMember);
    57	        $StockApprovalList->setApprovedDate($approvedDate);
    58	        $StockApprovalList->setApprovalMember($ApprovalMember);
    59	        $StockApprovalList->setProductStockTotalCount($ProductStockTotalCount);
