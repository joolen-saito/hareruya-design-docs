    75	                $baseInfoIds[] = $Item->getId();
    76	            }
    77	        }
    78	        $baseInfoIds = array_values(array_unique($baseInfoIds));
    79	        if ($baseInfoIds !== []) {
    80	            $qb
    81	                ->andWhere($qb->expr()->in('a_BaseInfo.id', ':base_info_ids'))
    82	                ->setParameter('base_info_ids', $baseInfoIds);
    83	        }
    84	
    85	        // 在庫場所 (stock_location_id): 配列で 1, 2 等
    86	        if (!empty($searchData['stock_location_id'])) {
    87	            $qb
    88	                ->andWhere($qb->expr()->in('a.stockLocationId', ':stock_location_ids'))
    89	                ->setParameter('stock_location_ids', array_map('intval', $searchData['stock_location_id']));
    90	        }
    91	
    92	        // 承認対象の絞り込み: 未承認のみ
    93	        if (!empty($searchData['filter_approval_target'])) {
    94	            $qb->andWhere('a.approvalStatus = :filter_approval_status')
    95	                ->setParameter('filter_approval_status', 1);
    96	        }
    97	
    98	        // 承認ステータス (approval_status): 1=未承認, 2=承認済, 3=却下。複数時は OR
    99	        if (!empty($searchData['approval_status'])) {
   100	            $qb
   101	                ->andWhere($qb->expr()->in('a.approvalStatus', ':approval_statuses'))
   102	                ->setParameter('approval_statuses', array_map('intval', $searchData['approval_status']));
   103	        }
   104	
   105	        // 在庫変動区分 (stock_change_type_detail):
   106	        if (isset($searchData['stock_change_type_detail']) && StringUtil::isNotBlank($searchData['stock_change_type_detail'])) {
   107	            $qb
   108	                ->andWhere($qb->expr()->in('a.StockTransferTypeDetail', ':stock_change_type_detail'))
   109	                ->setParameter('stock_change_type_detail', $searchData['stock_change_type_detail']);
   110	        }
   111	
   112	        // 登録者 (registered_member): メンバーID
   113	        if (!empty($searchData['registered_member'])) {
   114	            $qb
   115	                ->andWhere($qb->expr()->in('a.RegisteredMember', ':registered_member_id'))
   116	                ->setParameter('registered_member_id', $searchData['registered_member']);
   117	        }
   118	
   119	        // 承認者 (approval_member): メンバーID
   120	        if (!empty($searchData['approval_member'])) {
   121	            $qb
   122	                ->andWhere($qb->expr()->in('a.ApprovalMember', ':approval_member_id'))
   123	                ->setParameter('approval_member_id', $searchData['approval_member']);
   124	        }
   125	
   126	        // 登録日範囲 (registered_date_start / registered_date_end):
   127	        if (!empty($searchData['registered_date_start'])) {
   128	            $qb
   129	                ->andWhere('a.registeredDate >= :registered_date_start')
   130	                ->setParameter('registered_date_start', $searchData['registered_date_start']->format('Y-m-d 00:00:00'));
   131	        }
   132	        if (!empty($searchData['registered_date_end'])) {
   133	            $qb
   134	                ->andWhere('a.registeredDate < :registered_date_end')
   135	                ->setParameter('registered_date_end', $searchData['registered_date_end']->format('Y-m-d 23:59:59'));
   136	        }
   137	
   138	        // 承認日範囲 (approved_date_start / approved_date_end):
   139	        if (!empty($searchData['approved_date_start'])) {
   140	            $qb
   141	                ->andWhere('a.approvedDate >= :approved_date_start')
   142	                ->setParameter('approved_date_start', $searchData['approved_date_start']->format('Y-m-d 00:00:00'));
   143	        }
   144	        if (!empty($searchData['approved_date_end'])) {
   145	            $qb
   146	                ->andWhere('a.approvedDate < :approved_date_end')
   147	                ->setParameter('approved_date_end', $searchData['approved_date_end']->format('Y-m-d 23:59:59'));
   148	        }
   149	
   150	        // 在庫編集承認ID (idで受け取り、history_source_idにセット)
   151	        if (!empty($searchData['id'])) {
   152	            $qb
   153	                ->andWhere('a.historySourceId = :id')
   154	                ->setParameter('id', (int) $searchData['id']);
   155	        }
   156	
   157	        // 並び順: 承認日が空（未承認）を上位、登録日昇順、id 昇順。
   158	        // PostgreSQL の SELECT DISTINCT では ORDER BY は SELECT リストの式のみ可のため、CASE は使わずエンティティのカラムのみ指定する。
   159	        $qb
   160	            ->addOrderBy('a.approvedDate', 'DESC')
   161	            ->addOrderBy('a.registeredDate', 'ASC')
   162	            ->addOrderBy('a.id', 'ASC');
   163	
   164	        return $qb;
   165	    }
