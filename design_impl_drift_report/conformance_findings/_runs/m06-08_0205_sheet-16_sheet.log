    18	use Eccube\Entity\Master\MtbSection;
    19	use Eccube\Repository\DtbOtcBuyOrderSummaryRepository;
    20	use Eccube\Service\CsvExportService;
    21	use Symfony\Component\HttpFoundation\StreamedResponse;
    22	
    23	class OtcBuyOrderSummaryCsvExportService
    24	{
    25	    public function __construct(
    26	        protected CsvExportService $csvExportService,
    27	        protected DtbOtcBuyOrderSummaryRepository $summaryRepository,
    28	    ) {
    29	    }
    30	
    31	    /**
    32	     * CSVヘッダー定義
    33	     *
    34	     * @var array<string, string>
    35	     */
    36	    private const CSV_HEADER = [
    37	        'summaryDate' => '集計日',
    38	        'sectionCode' => '部門コード',
    39	        'sectionName' => '部門',
    40	        'buyPriceTotal' => '買取金額',
    41	        'sellPriceTotal' => '販売金額',
    42	    ];
    43	
    44	    /**
    45	     * 検索条件でCSV出力
    46	     *
    47	     * @param array<string, mixed> $searchData
    48	     */
    49	    public function exportBySearchData(array $searchData): StreamedResponse
    50	    {
    51	        return $this->createResponse(
    52	            fn () => $this->getExportRows($searchData),
    53	        );
    54	    }
    55	
    56	    /**
    57	     * @param array<string, mixed> $searchData
    58	     *
    59	     * @return iterable<array<string, mixed>>
    60	     */
    61	    private function getExportRows(array $searchData): iterable
    62	    {
    63	        $results = $this->summaryRepository
    64	            ->getQueryBuilderBySearchData($searchData)
    65	            ->getQuery()
    66	            ->getResult();
    67	
    68	        foreach ($results as $row) {
    69	            yield [
    70	                'summaryDate' => $row['summaryDate'] instanceof \DateTime
    71	                    ? $row['summaryDate']->format('Y/m/d')
    72	                    : '',
    73	                'sectionCode' => $row['sectionCode'] ?? '',
    74	                'sectionName' => $row['sectionName'] ?? MtbSection::NO_SECTION,
    75	                'buyPriceTotal' => $row['buyPriceTotal'] ?? 0,
    76	                'sellPriceTotal' => $row['sellPriceTotal'] ?? 0,
    77	            ];
    78	        }
    79	    }
    80	
    81	    /**
    82	     * StreamedResponse を生成
    83	     *
    84	     * @param callable(): iterable<array<string, mixed>> $dataProvider
    85	     */
    86	    private function createResponse(callable $dataProvider): StreamedResponse
    87	    {
    88	        $response = new StreamedResponse();
    89	        $response->setCallback(function () use ($dataProvider): void {
    90	            $this->csvExportService->fopen();
    91	
    92	            $this->csvExportService->fputcsv(array_values(self::CSV_HEADER));
    93	
    94	            $data = $dataProvider();
    95	            foreach ($data as $row) {
    96	                $orderedRow = array_map(
    97	                    fn (string $key): string => (string) ($row[$key] ?? ''),
    98	                    array_keys(self::CSV_HEADER),
    99	                );
   100	                $this->csvExportService->fputcsv($orderedRow);
   101	            }
   102	
   103	            $this->csvExportService->fclose();
   104	        });
   105	
   106	        $now = new \DateTime();
   107	        $filename = 'otc_buy_order_summary_'.$now->format('YmdHis').'.csv';
   108	        $response->headers->set('Content-Type', 'application/octet-stream');
   109	        $response->headers->set('Content-Disposition', 'attachment; filename='.$filename);
   110	
   111	        log_info('買取集計CSV出力完了. ファイル名: '.$filename);
   112	
   113	        return $response;
   114	    }
   115	}

