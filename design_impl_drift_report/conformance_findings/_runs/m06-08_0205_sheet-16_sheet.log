   829	    /**
   830	     * 店舗×部門単位の買取集計データを取得
   831	     *
   832	     * 3つのデータソースを UNION ALL で結合:
   833	     * 1. OtcBuyOrderDetail（明細）のセクション別集計
   834	     * 2. OtcBuyOrderIndivisualInputProduct（個別入力商品）のセクション別集計
   835	     * 3. 端数調整（total_price - 明細合計 - 個別入力合計）を固定セクションに計上
   836	     *
   837	     * @return array<int, array{base_info_id: int, section_id: int, total_buy_price: int, total_sell_price: int}>
   838	     */
   839	    public function getSectionSummary(\DateTime $summaryDate, int $fixedPriceSection): array
   840	    {
   841	        $from = (clone $summaryDate)->modify('00:00:00');
   842	        $to = (clone $summaryDate)->modify('23:59:59');
   843	
   844	        $statusIds = implode(',', MtbOtcBuyOrderStatus::SUMMARY_STATUSES);
   845	
   846	        $sql = <<<EOT
   847	            SELECT
   848	                sub.base_info_id,
   849	                sub.section_id,
   850	                CAST(SUM(sub.buy_price) AS INTEGER) AS total_buy_price,
   851	                CAST(SUM(sub.sell_price) AS INTEGER) AS total_sell_price
   852	            FROM
   853	                (
   854	                    SELECT
   855	                        obo.base_info_id AS base_info_id,
   856	                        obod.section_id AS section_id,
   857	                        (obod.price * obod.original_quantity) AS buy_price,
   858	                        (obod.sell_price * obod.original_quantity) AS sell_price
   859	                    FROM
   860	                        dtb_otc_buy_order obo
   861	                    JOIN
   862	                        dtb_otc_buy_order_detail obod ON obod.otc_buy_order_id = obo.id
   863	                        AND obod.original_quantity > 0
   864	                    WHERE
   865	                        obo.otc_buy_order_status_id IN ({$statusIds})
   866	                        AND obo.complete_date >= ?
   867	                        AND obo.complete_date <= ?
   868	                    UNION ALL
   869	                    SELECT
   870	                        obo.base_info_id AS base_info_id,
   871	                        oboi.section_id AS section_id,
   872	                        (oboi.price * oboi.quantity) AS buy_price,
   873	                        (oboi.sell_price * oboi.quantity) AS sell_price
   874	                    FROM
   875	                        dtb_otc_buy_order obo
   876	                    JOIN
   877	                        dtb_otc_buy_order_indivisual_input_product oboi ON oboi.otc_buy_order_id = obo.id
   878	                        AND oboi.quantity > 0
   879	                    WHERE
   880	                        obo.otc_buy_order_status_id IN ({$statusIds})
   881	                        AND obo.complete_date >= ?
   882	                        AND obo.complete_date <= ?
   883	                    UNION ALL
   884	                    SELECT
   885	                        obo.base_info_id AS base_info_id,
   886	                        {$fixedPriceSection} AS section_id,
   887	                        -- 端数調整額 = total_price - 明細合計 - 個別入力合計
   888	                        -- detail × individual の LEFT JOIN で直積になるため、
   889	                        -- 各 SUM を相手テーブルの DISTINCT 行数で割って正味の合計に戻す
   890	                        (obo.total_price
   891	                            - SUM(COALESCE(obod.price, 0) * COALESCE(obod.original_quantity, 0)) /
   892	                              (CASE WHEN COUNT(DISTINCT oboi.id) > 0
   893	                                THEN COUNT(DISTINCT oboi.id) ELSE 1 END)
   894	                            - SUM(COALESCE(oboi.price, 0) * COALESCE(oboi.quantity, 0)) /
   895	                              (CASE WHEN COUNT(DISTINCT obod.id) > 0
   896	                                THEN COUNT(DISTINCT obod.id) ELSE 1 END)
   897	                        ) AS buy_price,
   898	                        0 AS sell_price
   899	                    FROM
   900	                        dtb_otc_buy_order obo

