   880	                        obo.otc_buy_order_status_id IN ({$statusIds})
   881	                        AND obo.complete_date >= ?
   882	                        AND obo.complete_date <= ?
   883	                    UNION ALL
   884	                    SELECT
   885	                        obo.base_info_id AS base_info_id,
   886	                        {$fixedPriceSection} AS section_id,
   887	                        -- 端数調整額 = total_price - 明細合計 - 個別入力合計
   888	                        -- detail × individual の LEFT JOIN で直積になるため、
   889	                        -- 各 SUM を相手テーブルの DISTINCT 行数で割って正味の合計に戻す
   890	                        (obo.total_price
   891	                            - SUM(COALESCE(obod.price, 0) * COALESCE(obod.original_quantity, 0)) /
   892	                              (CASE WHEN COUNT(DISTINCT oboi.id) > 0
   893	                                THEN COUNT(DISTINCT oboi.id) ELSE 1 END)
   894	                            - SUM(COALESCE(oboi.price, 0) * COALESCE(oboi.quantity, 0)) /
   895	                              (CASE WHEN COUNT(DISTINCT obod.id) > 0
   896	                                THEN COUNT(DISTINCT obod.id) ELSE 1 END)
   897	                        ) AS buy_price,
   898	                        0 AS sell_price
   899	                    FROM
   900	                        dtb_otc_buy_order obo
   901	                    LEFT JOIN
   902	                        dtb_otc_buy_order_detail obod ON obod.otc_buy_order_id = obo.id
   903	                    LEFT JOIN
   904	                        dtb_otc_buy_order_indivisual_input_product oboi ON oboi.otc_buy_order_id = obo.id
   905	                    WHERE
   906	                        obo.otc_buy_order_status_id IN ({$statusIds})
   907	                        AND obo.complete_date >= ?
   908	                        AND obo.complete_date <= ?
   909	                    GROUP BY
   910	                        obo.id, obo.base_info_id, obo.total_price
   911	                    -- 端数調整(= total_price - 明細合計 - 個別入力合計)が正の注文のみ抽出
   912	                    -- LEFT JOIN による直積の重複を除去するため、各 SUM を相手テーブルの
   913	                    -- DISTINCT 行数で割って正味の合計に戻している
   914	                    HAVING
   915	                        (obo.total_price
   916	                            - SUM(COALESCE(obod.price, 0) * COALESCE(obod.original_quantity, 0)) /
   917	                              (CASE WHEN COUNT(DISTINCT oboi.id) > 0
   918	                                THEN COUNT(DISTINCT oboi.id) ELSE 1 END)
   919	                            - SUM(COALESCE(oboi.price, 0) * COALESCE(oboi.quantity, 0)) /
   920	                              (CASE WHEN COUNT(DISTINCT obod.id) > 0
   921	                                THEN COUNT(DISTINCT obod.id) ELSE 1 END)
   922	                        ) > 0
   923	                ) AS sub
   924	            GROUP BY sub.base_info_id, sub.section_id
   925	        EOT;
   926	
   927	        $fromStr = $from->format('Y-m-d H:i:s');
   928	        $toStr = $to->format('Y-m-d H:i:s');
