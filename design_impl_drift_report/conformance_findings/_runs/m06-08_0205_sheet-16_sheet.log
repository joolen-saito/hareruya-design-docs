    23	/**
    24	 * 店頭買取の日次集計処理
    25	 *
    26	 * 指定日の集計データを削除して再登録する（べき等）。
    27	 * 端数調整セクションは MtbOption から取得する。
    28	 */
    29	class SummaryByDateAggregator
    30	{
    31	    /**
    32	     * 指定日の店頭買取集計を実行する
    33	     *
    34	     * @throws \RuntimeException 端数調整セクションが MtbOption に未設定の場合
    35	     */
    36	    public static function aggregate(
    37	        \DateTime $summaryDate,
    38	        DtbOtcBuyOrderRepository $otcBuyOrderRepository,
    39	        DtbOtcBuyOrderSummaryRepository $otcBuyOrderSummaryRepository,
    40	        MtbOptionRepository $mtbOptionRepository,
    41	    ): void {
    42	        $FixedPriceSectionOption = $mtbOptionRepository->findOneBy([
    43	            'option_key' => MtbOption::FIXED_PRICE_SECTION,
    44	        ]);
    45	        if ($FixedPriceSectionOption === null) {
    46	            throw new \RuntimeException('端数調整セクションの設定が見つかりません。MtbOption に fixed_price_section を登録してください。');
    47	        }
    48	        $fixedPriceSection = (int) $FixedPriceSectionOption->getOptionValue();
    49	
    50	        $summary = $otcBuyOrderRepository->getSectionSummary($summaryDate, $fixedPriceSection);
    51	        $otcBuyOrderSummaryRepository->replaceSummary($summary, $summaryDate);
    52	    }
    53	}

