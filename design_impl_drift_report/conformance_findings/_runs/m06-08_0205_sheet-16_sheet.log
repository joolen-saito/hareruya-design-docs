    18	use Doctrine\ORM\QueryBuilder;
    19	use Doctrine\Persistence\ManagerRegistry;
    20	use Eccube\Entity\DtbOtcBuyOrderSummary;
    21	
    22	/**
    23	 * @extends AbstractRepository<DtbOtcBuyOrderSummary>
    24	 */
    25	class DtbOtcBuyOrderSummaryRepository extends AbstractRepository
    26	{
    27	    public function __construct(ManagerRegistry $registry)
    28	    {
    29	        parent::__construct($registry, DtbOtcBuyOrderSummary::class);
    30	    }
    31	
    32	    /**
    33	     * @param array<string, mixed> $searchData
    34	     */
    35	    public function getQueryBuilderBySearchData(array $searchData): QueryBuilder
    36	    {
    37	        $qb = $this->createQueryBuilder('otcs')
    38	            ->leftJoin('otcs.Section', 's')
    39	            ->select([
    40	                's.name AS sectionName',
    41	                's.code AS sectionCode',
    42	                'otcs.summaryDate',
    43	                'SUM(otcs.sellPrice) AS sellPriceTotal',
    44	                'SUM(otcs.buyPrice) AS buyPriceTotal',
    45	            ])
    46	            ->where('otcs.summaryDate >= :summaryDateFrom')
    47	            ->andWhere('otcs.summaryDate <= :summaryDateTo')
    48	            ->setParameter('summaryDateFrom', $searchData['summary_date_from']->format('Y-m-d 00:00:00'))
    49	            ->setParameter('summaryDateTo', $searchData['summary_date_to']->format('Y-m-d 23:59:59'))
    50	            ->groupBy('otcs.summaryDate')
    51	            ->addGroupBy('s.id')
    52	            ->orderBy('otcs.summaryDate', 'ASC')
    53	            ->addOrderBy('s.code', 'ASC')
    54	        ;
    55	
    56	        $shop = isset($searchData['shop'])
    57	            ? (is_array($searchData['shop']) ? $searchData['shop'] : $searchData['shop']->toArray())
    58	            : [];
    59	        if (!empty($shop)) {
    60	            $qb->andWhere('otcs.BaseInfo IN (:shop)')
    61	                ->setParameter('shop', $shop);
    62	        }
    63	
    64	        $section = isset($searchData['section'])
    65	            ? (is_array($searchData['section']) ? $searchData['section'] : $searchData['section']->toArray())
    66	            : [];
    67	        if (!empty($section)) {
    68	            $qb->andWhere('s.id IN (:section)')
    69	                ->setParameter('section', $section);
    70	        }
    71	
    72	        return $qb;
    73	    }
    74	
    75	    /**
    76	     * 集計日のデータを削除して再登録する（1トランザクション）
    77	     *
    78	     * @param array<int, array{base_info_id: int, section_id: int, total_buy_price: int, total_sell_price: int}> $summary
    79	     */
    80	    public function replaceSummary(array $summary, \DateTime $summaryDate): void
    81	    {
    82	        $conn = $this->getEntityManager()->getConnection();
    83	        $conn->beginTransaction();
    84	
    85	        try {
    86	            $this->deleteOtcBuyOrderSummary($summaryDate);
    87	            $this->insertOtcBuyOrderSummary($summary, $summaryDate);
    88	            $conn->commit();
    89	        } catch (\Exception $e) {
    90	            $conn->rollBack();
    91	            throw $e;
    92	        }
    93	    }
    94	
    95	    /**
    96	     * 店頭買取集計の一括登録
    97	     *
    98	     * @param array<int, array{base_info_id: int, section_id: int, total_buy_price: int, total_sell_price: int}> $summary
    99	     */
   100	    private function insertOtcBuyOrderSummary(array $summary, \DateTime $summaryDate): void
   101	    {
   102	        if (empty($summary)) {
   103	            return;
   104	        }
   105	
   106	        $conn = $this->getEntityManager()->getConnection();
   107	        $summaryDateStr = $summaryDate->format('Y-m-d H:i:s');
   108	
   109	        // バッチ INSERT: VALUES (?, ?, ?, ?, ?), (?, ?, ?, ?, ?), ...
   110	        $placeholders = [];
   111	        $params = [];
   112	        foreach ($summary as $data) {
   113	            $placeholders[] = '(?, ?, ?, ?, ?)';
   114	            $params[] = $data['base_info_id'];
   115	            $params[] = $data['section_id'];
   116	            $params[] = $data['total_sell_price'];
   117	            $params[] = $data['total_buy_price'];
   118	            $params[] = $summaryDateStr;
   119	        }
   120	
   121	        $sql = 'INSERT INTO dtb_otc_buy_order_summary'
   122	            .' (base_info_id, section_id, sell_price, buy_price, summary_date)'
   123	            .' VALUES '.implode(', ', $placeholders);
   124	
   125	        $conn->executeStatement($sql, $params);
   126	    }
   127	
   128	    /**
   129	     * 集計日の店頭買取集計データを消去
   130	     */
   131	    private function deleteOtcBuyOrderSummary(\DateTime $summaryDate): void
   132	    {
   133	        $summaryDateStr = $summaryDate->format('Y-m-d 00:00:00');
   134	
   135	        $sql = <<<'EOT'
   136	            DELETE FROM dtb_otc_buy_order_summary
   137	            WHERE summary_date = ?
   138	        EOT;
   139	
   140	        $this->getEntityManager()
   141	            ->getConnection()
   142	            ->executeStatement($sql, [
   143	                $summaryDateStr,
   144	            ]);
   145	    }
   146	
   147	    /**
   148	     * 期間全体の集計データを取得する
   149	     *
   150	     * @param array<string, mixed> $searchData
   151	     */
   152	    public function aggregateDataBySectionForEntirePeriod(array $searchData): QueryBuilder
   153	    {
   154	        $qb = $this->getQueryBuilderBySearchData($searchData);
   155	        $qb->select([
   156	            's.name AS sectionName',
   157	            's.code AS sectionCode',
   158	            'SUM(otcs.sellPrice) AS sellPriceTotal',
   159	            'SUM(otcs.buyPrice) AS buyPriceTotal',
   160	        ])
   161	            ->resetDQLPart('orderBy')
   162	            ->resetDQLPart('groupBy')
   163	            ->groupBy('s.id')
   164	            ->orderBy('s.code', 'ASC');
   165	
   166	        return $qb;
   167	    }
   168	}

