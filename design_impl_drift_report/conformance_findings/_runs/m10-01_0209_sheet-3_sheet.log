    33	    /**
    34	     * ShopController constructor.
    35	     */
    36	    public function __construct(protected Environment $twig, protected BaseInfoRepository $baseInfoRepository)
    37	    {
    38	    }
    39	
    40	    /**
    41	     * @return array<string, mixed>|RedirectResponse
    42	     *
    43	     * @throws \Exception
    44	     */
    45	    #[Route(path: '/%eccube_admin_route%/setting/shop', name: 'admin_setting_shop', methods: ['GET', 'POST'])]
    46	    #[Template(template: '@admin/Setting/Shop/shop_master.twig')]
    47	    public function index(Request $request, CacheUtil $cacheUtil): array|RedirectResponse
    48	    {
    49	        $BaseInfo = $this->baseInfoRepository->getMallBaseInfo();
    50	        $builder = $this->formFactory
    51	            ->createBuilder(ShopMasterType::class, $BaseInfo);
    52	
    53	        $CloneInfo = clone $BaseInfo;
    54	        $this->entityManager->detach($CloneInfo);
    55	
    56	        $event = new EventArgs(
    57	            [
    58	                'builder' => $builder,
    59	                'BaseInfo' => $BaseInfo,
    60	            ],
    61	            $request
    62	        );
    63	        $this->eventDispatcher->dispatch($event, EccubeEvents::ADMIN_SETTING_SHOP_SHOP_INDEX_INITIALIZE);
    64	
    65	        $form = $builder->getForm();
    66	        $form->handleRequest($request);
    67	
    68	        if ($form->isSubmitted() && $form->isValid()) {
    69	            $this->entityManager->persist($BaseInfo);
    70	            $this->entityManager->flush();
    71	
    72	            $event = new EventArgs(
    73	                [
    74	                    'form' => $form,
    75	                    'BaseInfo' => $BaseInfo,
    76	                ],
    77	                $request
    78	            );
    79	            $this->eventDispatcher->dispatch(
    80	                $event,
    81	                EccubeEvents::ADMIN_SETTING_SHOP_SHOP_INDEX_COMPLETE
    82	            );
    83	
    84	            // キャッシュの削除
    85	            $cacheUtil->clearDoctrineCache();
    86	
    87	            $this->addSuccess('admin.common.save_complete', 'admin');
    88	
    89	            return $this->redirectToRoute('admin_setting_shop');
    90	        }
    91	
    92	        $this->twig->addGlobal('BaseInfo', $CloneInfo);
    93	
    94	        return [
    95	            'form' => $form->createView(),
    96	        ];
    97	    }
    98	}

