    18	use Eccube\Controller\AbstractController;
    19	use Eccube\Entity\DtbCustomerGroup;
    20	use Eccube\Form\Type\Admin\CustomerGroupType;
    21	use Eccube\Repository\DtbCustomerGroupRepository;
    22	use Eccube\Service\EntityManager\CustomerGroupEntityManager;
    23	use Symfony\Bridge\Twig\Attribute\Template;
    24	use Symfony\Component\HttpFoundation\RedirectResponse;
    25	use Symfony\Component\HttpFoundation\Request;
    26	use Symfony\Component\Routing\Attribute\Route;
    27	
    28	class CustomerGroupController extends AbstractController
    29	{
    30	    public function __construct(
    31	        private readonly DtbCustomerGroupRepository $customerGroupRepository,
    32	        private readonly CustomerGroupEntityManager $customerGroupEntityManager,
    33	    ) {
    34	    }
    35	
    36	    /**
    37	     * @return RedirectResponse|array<string, mixed>
    38	     */
    39	    #[Route('/%eccube_admin_route%/customer/customer_group', name: 'admin_customer_group_new', methods: ['GET', 'POST'])]
    40	    #[Route('/%eccube_admin_route%/customer/customer_group/{id}', name: 'admin_customer_group', requirements: ['id' => '\d+'], methods: ['GET', 'POST'])]
    41	    #[Template('@admin/CustomerGroup/index.twig')]
    42	    public function index(Request $request, ?DtbCustomerGroup $CustomerGroup): RedirectResponse|array
    43	    {
    44	        if (!$CustomerGroup) {
    45	            $CustomerGroup = new DtbCustomerGroup();
    46	        }
    47	
    48	        $CustomerGroups = $this->customerGroupRepository->findBy([], ['id' => 'ASC']);
    49	
    50	        $builder = $this->formFactory
    51	            ->createBuilder(CustomerGroupType::class, $CustomerGroup);
    52	
    53	        $form = $builder->getForm();
    54	        $form->handleRequest($request);
    55	
    56	        if ($form->isSubmitted() && $form->isValid()) {
    57	            $this->customerGroupEntityManager->save($CustomerGroup);
    58	            $this->entityManager->flush();
    59	
    60	            $this->addSuccess('admin.common.save_complete', 'admin');
    61	
    62	            return $this->redirectToRoute('admin_customer_group_new');
    63	        }
    64	
    65	        return [
    66	            'CustomerGroups' => $CustomerGroups,
    67	            'TargetCustomerGroup' => $CustomerGroup,
    68	            'form' => $form->createView(),
    69	        ];
    70	    }
    71	
    72	    #[Route('/%eccube_admin_route%/customer/customer_group/{id}/delete', name: 'admin_customer_group_delete', requirements: ['id' => '\d+'], methods: ['DELETE'])]
    73	    public function delete(DtbCustomerGroup $CustomerGroup): RedirectResponse
    74	    {
    75	        $this->isTokenValid();
    76	
    77	        log_info('顧客グループ情報削除開始', [$CustomerGroup->getId()]);
    78	
    79	        if ($CustomerGroup->getPlayers()->count() > 0) {
    80	            $message = trans('admin.customer.customer_group.delete_failed', ['%name%' => $CustomerGroup->getName()]);
    81	            $this->addError($message, 'admin');
    82	
    83	            return $this->redirectToRoute('admin_customer_group_new');
    84	        }
    85	
    86	        try {
    87	            $this->customerGroupRepository->delete($CustomerGroup);
    88	
    89	            $this->addSuccess('admin.common.delete_complete', 'admin');
    90	            $this->entityManager->flush();
    91	
    92	            log_info('顧客グループ情報削除完了', [$CustomerGroup->getId()]);
    93	        } catch (\Exception $e) {
    94	            $message = trans('admin.common.delete_error_foreign_key', ['%name%' => $CustomerGroup->getName()]);
    95	            $this->addError($message, 'admin');
    96	
    97	            log_error('顧客グループ情報削除エラー', [$CustomerGroup->getId(), $e]);
    98	        }
    99	
   100	        return $this->redirectToRoute('admin_customer_group_new');
   101	    }
   102	}

