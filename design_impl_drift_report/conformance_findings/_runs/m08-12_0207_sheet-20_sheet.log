    20	use Eccube\Form\Type\Master\PaymentType;
    21	use Symfony\Component\Form\AbstractType;
    22	use Symfony\Component\Form\Extension\Core\Type\CheckboxType;
    23	use Symfony\Component\Form\Extension\Core\Type\IntegerType;
    24	use Symfony\Component\Form\Extension\Core\Type\TextType;
    25	use Symfony\Component\Form\FormBuilderInterface;
    26	use Symfony\Component\OptionsResolver\OptionsResolver;
    27	use Symfony\Component\Validator\Constraints\NotBlank;
    28	use Symfony\Component\Validator\Constraints\Regex;
    29	
    30	class CustomerGroupType extends AbstractType
    31	{
    32	    #[\Override]
    33	    public function buildForm(FormBuilderInterface $builder, array $options): void
    34	    {
    35	        $builder
    36	            ->add('name', TextType::class, [
    37	                'required' => true,
    38	            ])
    39	            ->add('point_percentage', IntegerType::class, [
    40	                'required' => true,
    41	                'constraints' => [
    42	                    new NotBlank(),
    43	                    new Regex(['pattern' => '/^[-]?([1-9]\d*|0)$/']),
    44	                ],
    45	            ])
    46	            ->add('shop_front_flg', CheckboxType::class, [
    47	                'label' => '店内注文専用アカウント',
    48	                'required' => false,
    49	            ])
    50	            ->add('branch_shop_front_flg', CheckboxType::class, [
    51	                'label' => '支店店内注文専用アカウント',
    52	                'required' => false,
    53	            ])
    54	            ->add('Payments', PaymentType::class, [
    55	                'label' => 'admin.common.payment_method',
    56	                'required' => false,
    57	                'expanded' => true,
    58	                'multiple' => true,
    59	                'query_builder' => function (EntityRepository $er) {
    60	                    return $er->createQueryBuilder('p')
    61	                        ->where('p.visible = true')
    62	                        ->andWhere('p.id NOT IN (:excludeIds)')
    63	                        ->setParameter('excludeIds', [Payment::EC_CREDIT, Payment::EC_CVS])
    64	                        ->orderBy('p.sort_no', 'DESC');
    65	                },
    66	            ])
    67	        ;
    68	    }
    69	
    70	    #[\Override]
    71	    public function configureOptions(OptionsResolver $resolver): void
    72	    {
    73	        $resolver->setDefaults([
    74	        ]);
    75	    }
    76	
    77	    #[\Override]
    78	    public function getBlockPrefix(): string
    79	    {
    80	        return 'admin_customer_group';
    81	    }
    82	}

