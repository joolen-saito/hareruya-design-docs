namespace Eccube\Repository\Master;

use Doctrine\ORM\Query;
use Doctrine\Persistence\ManagerRegistry;
use Eccube\Entity\Master\MtbOption;
use Eccube\Repository\AbstractRepository;

/**
 * @extends AbstractRepository<MtbOption>
 */
class MtbOptionRepository extends AbstractRepository
{
    public function __construct(ManagerRegistry $registry)
    {
        parent::__construct($registry, MtbOption::class);
    }

    public function get(int $id = 1): ?MtbOption
    {
        return $this->find($id);
    }

    /**
     * 指定されたオプションキーの値を配列で返す
     *
     * @param array<int, string> $optionKeys
     */
    public function findListArray(array $optionKeys): mixed
    {
        $qb = $this->createQueryBuilder('r');

        return $qb->where($qb->expr()->in('r.option_key', ':optionKeys'))
            ->setParameter('optionKeys', $optionKeys)
            ->getQuery()
            ->getResult(Query::HYDRATE_ARRAY);
    }
}

