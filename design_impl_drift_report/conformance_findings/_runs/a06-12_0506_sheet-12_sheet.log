use Eccube\Entity\AbstractEntity;
use Eccube\Entity\Member;
use Eccube\Repository\Master\MtbOptionRepository;

#[ORM\Table(name: 'mtb_option')]
#[ORM\Entity(repositoryClass: MtbOptionRepository::class)]
class MtbOption extends AbstractEntity
{
    /**
     * 本店から移植した定数
     */
    public const FIXED_PRICE_SECTION = 'fixed_price_section';
    public const ORDER_LIST_THRESHOLD_PRICE_1 = 'order_list_threshold_price_1';
    public const ORDER_LIST_THRESHOLD_PRICE_1_DEFAULT = 980;
    public const ORDER_LIST_THRESHOLD_PRICE_2 = 'order_list_threshold_price_2';
    public const ORDER_LIST_THRESHOLD_PRICE_2_DEFAULT = 4800;
    public const SMAREGI_ERROR_MAIL_ADDRESS = 'smaregi_error_mail_address';

    /**
     * 支店から移植した定数
     */
    public const RECOMMEND_DAYS = 'recommend_days';
    public const SMAREGI_CONTRACT_ID = 'smaregi_contract_id';
    public const SMAREGI_DEPARTMENT_ID = 'smaregi_department_id';
    public const SMAREGI_SEND_URL = 'smaregi_send_url';
    public const SMAREGI_ERROR_SEND_MAILADDRESS = 'smaregi_error_send_mailaddress';
