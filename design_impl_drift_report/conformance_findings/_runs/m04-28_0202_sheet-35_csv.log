    68	    #[Template(template: '@admin/Stock/stock_move_instruction_index.twig')]
    69	    public function index(Request $request, PaginatorInterface $paginator, ?int $page_no = null): array
    70	    {
    71	        $session = $this->session;
    72	
    73	        $builder = $this->formFactory->createBuilder(SearchStockMoveInstructionType::class);
    74	        $searchForm = $builder->getForm();
    75	
    76	        $pageMaxis = $this->pageMaxRepository->findAll();
    77	        $page_count = (int) $session->get(
    78	            self::SESSION_KEY_PAGE_COUNT,
    79	            $this->eccubeConfig->get('eccube_default_page_count')
    80	        );
    81	
    82	        $page_count_param = (int) $request->get('page_count');
    83	        if ($page_count_param) {
    84	            foreach ($pageMaxis as $pageMax) {
    85	                if ((string) $page_count_param === $pageMax->getName()) {
    86	                    $page_count = $pageMax->getName();
    87	                    $session->set(self::SESSION_KEY_PAGE_COUNT, $page_count);
    88	                    break;
    89	                }
    90	            }
    91	        }
    92	
    93	        $searchData = [];
    94	
    95	        if ($request->isMethod('POST')) {
    96	            $searchForm->handleRequest($request);
    97	            if (!$searchForm->isSubmitted() || !$searchForm->isValid()) {
    98	                return [
    99	                    'searchForm' => $searchForm->createView(),
   100	                    'pagination' => null,
   101	                    'pageMaxis' => $pageMaxis,
   102	                    'page_count' => $page_count,
   103	                    'has_errors' => true,
   104	                    'is_search_filter_active' => true,
   105	                ];
   106	            }
   107	
   108	            $searchData = $searchForm->getData();
   109	            $session->set(self::SESSION_KEY_SEARCH, FormUtil::getViewData($searchForm));
   110	            $session->set(self::SESSION_KEY_PAGE_NO, 1);
   111	            $page_no = 1;
   112	        } else {
   113	            if ($request->query->get('resume')) {
   114	                $page_no = (int) $session->get(self::SESSION_KEY_PAGE_NO, 1);
   115	                $viewData = $session->get(self::SESSION_KEY_SEARCH, []);
   116	                $searchData = FormUtil::submitAndGetData($searchForm, $viewData);
   117	            } elseif ($page_no !== null) {
   118	                $session->set(self::SESSION_KEY_PAGE_NO, $page_no);
   119	                $viewData = $session->get(self::SESSION_KEY_SEARCH, []);
   120	                if ($viewData === []) {
   121	                    $viewData = FormUtil::getViewData($searchForm);
   122	                    $session->set(self::SESSION_KEY_SEARCH, $viewData);
   123	                }
   124	                $searchData = FormUtil::submitAndGetData($searchForm, $viewData);
   125	            } else {
   126	                $page_no = 1;
   127	                $viewData = FormUtil::getViewData($searchForm);
   128	                $searchData = FormUtil::submitAndGetData($searchForm, $viewData);
   129	                $session->set(self::SESSION_KEY_SEARCH, $viewData);
   130	                $session->set(self::SESSION_KEY_PAGE_NO, $page_no);
   131	            }
   132	        }
   133	
   134	        $qb = $this->stockMoveInstructionRepository->getQueryBuilderBySearchData($searchData);
   135	        $pagination = $paginator->paginate($qb, (int) $page_no, $page_count);
   136	
   137	        $instructionIds = [];
   138	        foreach ($pagination as $item) {
   139	            if ($item instanceof DtbStockMoveInstruction) {
   140	                $instructionIds[] = $item->getId();
   141	            }
   142	        }
   143	        $outboundTotalCostMap = $this->stockMoveInstructionRepository->getOutboundTotalCostByIds($instructionIds);
   144	
   145	        return [
   146	            'searchForm' => $searchForm->createView(),
   147	            'pagination' => $pagination,
   148	            'outboundTotalCostMap' => $outboundTotalCostMap,
   149	            'pageMaxis' => $pageMaxis,
   150	            'page_count' => $page_count,
   151	            'has_errors' => false,
   152	            'is_search_filter_active' => $this->isSearchFilterActive($searchData),
   153	        ];
   154	    }
