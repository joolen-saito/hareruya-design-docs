    96	    /**
    97	     * @return list<int|string>
    98	     */
    99	    private function buildRow(DtbStockMoveInstruction $StockMoveInstruction): array
   100	    {
   101	        $from = $StockMoveInstruction->getMoveFromBaseInfo();
   102	        $to = $StockMoveInstruction->getMoveToBaseInfo();
   103	        $standardTotal = $StockMoveInstruction->getStandardTotalPrice();
   104	
   105	        return [
   106	            (string) $StockMoveInstruction->getId(),
   107	            $standardTotal,
   108	            $this->formatCompanyAndShopName($from),
   109	            $this->formatCompanyAndShopKana($from),
   110	            (string) ($from->getPostalCode() ?? ''),
   111	            $from->getPref() !== null ? (string) $from->getPref()->getName() : '',
   112	            (string) ($from->getAddr01() ?? ''),
   113	            (string) ($from->getAddr02() ?? ''),
   114	            (string) ($from->getPhoneNumber() ?? ''),
   115	            $standardTotal,
   116	            '0',    // 送料 0固定
   117	            '0',    // 送料(税抜) 0固定
   118	            '0',    // 手数料 0固定
   119	            '0',    // 手数料(税抜) 0固定
   120	            $this->formatCompanyAndShopName($to),
   121	            $this->formatCompanyAndShopKana($to),
   122	            (string) ($to->getPostalCode() ?? ''),
   123	            $to->getPref() !== null ? (string) $to->getPref()->getName() : '',
   124	            (string) ($to->getAddr01() ?? ''),
   125	            (string) ($to->getAddr02() ?? ''),
   126	            (string) ($to->getPhoneNumber() ?? ''),
   127	            '0',    // 郵便種別 0固定（0：ゆうパック）
   128	            'ゆうパック',
   129	        ];
   130	    }
   131	
   132	    /**
   133	     * 店舗の会社名と店名を、送り状CSV用に「会社名 + 半角空白 + 店名」で連結する。
   134	     * どちらか片方のみの場合はその値のみ。
   135	     */
   136	    private function formatCompanyAndShopName(BaseInfo $BaseInfo): string
   137	    {
   138	        return $this->joinWithHalfWidthSpace($BaseInfo->getCompanyName(), $BaseInfo->getShopName());
   139	    }
   140	
   141	    /**
   142	     * 店舗の会社名カナと店名カナを、送り状CSV用に「会社名(カナ) + 半角空白 + 店名(カナ)」で連結する。
   143	     * どちらか片方のみの場合はその値のみ。
   144	     */
   145	    private function formatCompanyAndShopKana(BaseInfo $BaseInfo): string
   146	    {
   147	        return $this->joinWithHalfWidthSpace($BaseInfo->getCompanyKana(), $BaseInfo->getShopKana());
   148	    }
   149	
   150	    /**
   151	     * 左右の文字列をtrimしたうえで、両方とも空でなければ半角スペース1つで連結する。
   152	     * 片方が空のときは空でない方のみを返す。両方空のときは空文字列を返す。
   153	     */
   154	    private function joinWithHalfWidthSpace(?string $leftText, ?string $rightText): string
   155	    {
   156	        $trimmedLeftText = trim((string) $leftText);
   157	        $trimmedRightText = trim((string) $rightText);
   158	
   159	        if ($trimmedLeftText === '') {
   160	            return $trimmedRightText;
   161	        }
   162	
   163	        if ($trimmedRightText === '') {
   164	            return $trimmedLeftText;
   165	        }
   166	
   167	        return $trimmedLeftText.' '.$trimmedRightText;
   168	    }
   169	}

