    61	    ) {
    62	    }
    63	
    64	    /**
    65	     * @param list<int> $instructionIds 移動指示ID
    66	     */
    67	    public function exportByInstructionIds(array $instructionIds): StreamedResponse
    68	    {
    69	        $response = new StreamedResponse();
    70	        $response->setCallback(function () use ($instructionIds): void {
    71	            $this->csvExportService->fopen();
    72	
    73	            try {
    74	                $this->csvExportService->fputcsv(self::HEADER);
    75	
    76	                $Instructions = $this->stockMoveInstructionRepository->findByIdsForLabelExport($instructionIds);
    77	
    78	                foreach ($Instructions as $Instruction) {
    79	                    $this->csvExportService->fputcsv($this->buildRow($Instruction));
    80	                }
    81	            } finally {
    82	                $this->csvExportService->fclose();
    83	            }
    84	        });
    85	
    86	        $now = new \DateTime();
    87	        $filename = 'stock_move_instruction_labels_'.$now->format('YmdHis').'.csv';
    88	        $response->headers->set('Content-Type', 'application/octet-stream');
    89	        $response->headers->set('Content-Disposition', 'attachment; filename='.$filename);
    90	
    91	        log_info('在庫移動指示 送り状CSV出力完了. ファイル名: '.$filename);
    92	
    93	        return $response;
    94	    }
