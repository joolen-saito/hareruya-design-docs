   161	    #[Route(path: '/%eccube_admin_route%/product/stock/move-instruction/{id}', name: 'admin_stock_move_instruction_detail', requirements: ['id' => '\d+'], methods: ['GET', 'POST'])]
   162	    #[Template(template: '@admin/Stock/stock_move_instruction_detail.twig')]
   163	    public function detail(Request $request, int $id): array|RedirectResponse
   164	    {
   165	        $Instruction = $this->stockMoveInstructionRepository->find($id);
   166	        if ($Instruction === null) {
   167	            throw new NotFoundHttpException();
   168	        }
   169	
   170	        $originalTrackingNo = $Instruction->getTrackingNo();
   171	        $form = $this->formFactory->createBuilder(StockMoveInstructionDetailType::class, $Instruction)->getForm();
   172	        $form->handleRequest($request);
   173	
   174	        if ($form->isSubmitted() && $form->isValid()) {
   175	            $newTrackingNo = trim($Instruction->getTrackingNo() ?? '');
   176	            if ($originalTrackingNo !== null && $originalTrackingNo !== '' && $newTrackingNo === '') {
   177	                $form->get('trackingNo')->addError(
   178	                    new FormError(
   179	                        $this->translator->trans('admin.stock.move_instruction.detail_tracking_no_cannot_be_cleared', [], 'messages')
   180	                    )
   181	                );
   182	            } else {
   183	                $input = new StockMoveInstructionDetailUpdateInput(
   184	                    $Instruction,
   185	                    $this->getMember(),
   186	                );
   187	                $this->detailUpdateAction->handle($input);
   188	                $this->addSuccess('admin.common.save_complete', 'admin');
   189	
   190	                return $this->redirectToRoute('admin_stock_move_instruction_detail', ['id' => $id]);
   191	            }
   192	        }
   193	
   194	        $Moves = $this->stockMoveTransferRepository->findBy(
   195	            ['moveInstructionId' => $Instruction->getId()],
   196	            ['id' => 'ASC']
   197	        );
   198	
   199	        $moveIds = array_map(static fn ($m) => $m->getId(), $Moves);
   200	        $moveAggregates = $this->stockMoveInstructionRepository->getTransferAggregatesByTransferIds(
   201	            $moveIds,
   202	            $Instruction->getMoveFromPriceThreshold()
   203	        );
   204	
   205	        $outboundTotalCost = '0';
   206	        $highTotalPrice = '0';
   207	        $regularTotalPrice = '0';
   208	        foreach ($moveAggregates as $agg) {
   209	            $outboundTotalCost = bcadd($outboundTotalCost, $agg['outbound_total_cost'], 2);
   210	            $highTotalPrice = bcadd($highTotalPrice, $agg['high_total'], 2);
   211	            $regularTotalPrice = bcadd($regularTotalPrice, $agg['regular_total'], 2);
   212	        }
   213	
   214	        return [
   215	            'instruction' => $Instruction,
   216	            'form' => $form->createView(),
   217	            'Moves' => $Moves,
   218	            'moveAggregates' => $moveAggregates,
   219	            'outboundTotalCost' => $outboundTotalCost,
   220	            'highTotalPrice' => $highTotalPrice,
   221	            'regularTotalPrice' => $regularTotalPrice,
   222	        ];
   223	    }
