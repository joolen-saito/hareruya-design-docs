   334	    #[Route(path: '/%eccube_admin_route%/product/stock/move-instruction/csv-template', name: 'admin_stock_move_instruction_csv_download_record', methods: ['GET'])]
   335	    public function csvTemplateDownload(Request $request): StreamedResponse
   336	    {
   337	        set_time_limit(0);
   338	
   339	        $columns = ['移動指示ID', '出庫元店舗(名称)', '入庫先店舗(名称)', '送り状No.'];
   340	        $filename = 'stock_move_instruction_record_template_'.(new \DateTime())->format('YmdHis').'.csv';
   341	
   342	        $encoding = $this->eccubeConfig['eccube_csv_export_encoding'] ?? 'SJIS-win';
   343	        $response = new StreamedResponse();
   344	        $response->setCallback(function () use ($columns, $encoding): void {
   345	            $fp = fopen('php://output', 'w');
   346	            // ExcelでUTF-8を正しく認識させるためBOMを出力
   347	            if (strtoupper((string) $encoding) === 'UTF-8') {
   348	                fwrite($fp, "\xEF\xBB\xBF");
   349	            }
   350	            $row = [];
   351	            foreach ($columns as $column) {
   352	                $row[] = mb_convert_encoding($column, $encoding, 'UTF-8');
   353	            }
   354	            fputcsv($fp, $row, $this->eccubeConfig['eccube_csv_export_separator'] ?? ',', '"', '\\');
   355	            fclose($fp);
   356	        });
   357	
   358	        $contentType = strcasecmp($encoding, 'SJIS-win') === 0 ? 'windows-31j' : $encoding;
   359	        $response->headers->set('Content-Type', 'text/csv; charset='.$contentType);
   360	        $response->headers->set('Content-Disposition', 'attachment; filename='.$filename);
   361	
   362	        return $response;
   363	    }
