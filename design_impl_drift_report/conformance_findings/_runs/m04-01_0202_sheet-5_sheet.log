   435	    #[Route(path: '/%eccube_admin_route%/product/stock/bulk-edit-dispatch', name: 'admin_stock_list_bulk_edit_dispatch', methods: ['POST'])]
   436	    public function bulkEditDispatch(Request $request): RedirectResponse
   437	    {
   438	        $submitted = $request->request->get(Constant::TOKEN_NAME);
   439	        if (!$this->isCsrfTokenValid(SearchStockListType::CSRF_TOKEN_ID, is_string($submitted) ? $submitted : '')) {
   440	            throw new AccessDeniedHttpException('CSRF token is invalid.');
   441	        }
   442	
   443	        $ids = $this->extractProductStockIdsFromRequest($request);
   444	        if ($ids === []) {
   445	            $this->addError('admin.stock.bulk_approval.no_product_stocks', 'admin');
   446	
   447	            return $this->redirectToRoute('admin_stock_list');
   448	        }
   449	
