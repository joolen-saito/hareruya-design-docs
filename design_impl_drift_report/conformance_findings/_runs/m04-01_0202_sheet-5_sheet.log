    21	        .table-stock-list th:first-child,
    22	        .table-stock-list td:first-child { width: 2.5rem; min-width: 2.5rem; }
    23	        .table-stock-list .col-id      { min-width: 5rem; }
    24	        .table-stock-list .col-name    { min-width: 12rem; max-width: 16rem; }
    25	        .table-stock-list .col-name a  { display: block; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    26	        .table-stock-list .col-shop    { min-width: 7rem; }
    27	        .table-stock-list .col-lang    { min-width: 4rem; }
    28	        .table-stock-list .col-cond    { min-width: 3rem; }
    29	        .table-stock-list .col-price   { min-width: 5rem; text-align: right; }
    30	        .table-stock-list .col-stock   { min-width: 4rem; text-align: right; }
    31	        .table-stock-list .col-sales   { min-width: 4rem; text-align: right; }
    32	        .table-stock-list .col-menu    { min-width: 2.5rem; text-align: center; }
    33	        /* 検索条件保存エリア */
    34	        .search-pattern-area { background: #f8f9fa; border: 1px solid #dee2e6; border-radius: 0.25rem; padding: 0.75rem 1rem; }
    35	        .search-pattern-links a { font-size: 0.85rem; }
    36	    </style>
