    32	/**
    33	 * ProductClassRepository
    34	 *
    35	 * This class was generated by the Doctrine ORM. Add your own custom
    36	 * repository methods below.
    37	 *
    38	 * @extends AbstractRepository<ProductStock>
    39	 */
    40	class ProductStockRepository extends AbstractRepository
    41	{
    42	    /** 管理画面在庫一覧検索の `LIKE ... ESCAPE` 用（パラメータ側エスケープと一致） */
    43	    private const ADMIN_STOCK_LIST_LIKE_ESCAPE_CHAR = '!';
    44	
    45	    public function __construct(RegistryInterface $registry)
    46	    {
    47	        parent::__construct($registry, ProductStock::class);
    48	    }
    49	
    50	    /**
    51	     * 在庫一覧（M04-01）用 QueryBuilder。
    52	     *
    53	     * 同一商品規格の EC-CUBE / スマレジ行が隣接するよう
    54	     * ProductClass.id ASC → stockLocationId ASC でソートする。
    55	     *
    56	     * StockListSearchInput のうち、現時点で反映する条件のみを適用する（詳細の未実装分は今後ここへ追加）。
    57	     */
    58	    public function getQueryBuilderForAdminStockList(StockListSearchInput $input): QueryBuilder
    59	    {
    60	        $qb = $this->createQueryBuilder('ps')
    61	            ->innerJoin('ps.ProductClass', 'pc')
    62	            ->innerJoin('pc.Product', 'p');
    63	
    64	        $productNameTrimmed = $input->productName !== null ? trim($input->productName) : '';
    65	        if ($productNameTrimmed !== '') {
    66	            $qb->andWhere('p.name LIKE :productName'.$this->adminStockListLikeEscapeDql())
    67	                ->setParameter('productName', $this->adminStockListEscapeLikePattern($productNameTrimmed));
    68	        }
    69	
    70	        $cardNameTrimmed = $input->cardName !== null ? trim($input->cardName) : '';
    71	        if ($cardNameTrimmed !== '') {
    72	            $qb->leftJoin('p.CardDetail', 'sl_cd')
    73	                ->leftJoin('sl_cd.Card', 'sl_card');
    74	            $esc = $this->adminStockListLikeEscapeDql();
    75	            $qb->andWhere('(sl_card.name_jp LIKE :stockListCardName'.$esc.' OR sl_card.name_en LIKE :stockListCardName'.$esc.')')
    76	                ->setParameter('stockListCardName', $this->adminStockListEscapeLikePattern($cardNameTrimmed));
    77	        }
    78	
    79	        $productIdTrimmed = $input->productId !== null ? trim($input->productId) : '';
    80	        if ($productIdTrimmed !== '') {
    81	            $qb->andWhere("CONCAT(p.id, '') LIKE :stockListProductId".$this->adminStockListLikeEscapeDql())
    82	                ->setParameter('stockListProductId', $this->adminStockListEscapeLikePattern($productIdTrimmed));
    83	        }
    84	
    85	        $productCodeTrimmed = $input->productCode !== null ? trim($input->productCode) : '';
    86	        if ($productCodeTrimmed !== '') {
    87	            $qb->andWhere('pc.code LIKE :productCode'.$this->adminStockListLikeEscapeDql())
    88	                ->setParameter('productCode', $this->adminStockListEscapeLikePattern($productCodeTrimmed));
    89	        }
    90	
    91	        if ($input->baseInfos !== []) {
    92	            $qb->andWhere($qb->expr()->in('ps.baseInfo', ':stockListBaseInfos'))
    93	                ->setParameter('stockListBaseInfos', $input->baseInfos);
    94	        }
    95	
    96	        if ($input->stockLocationIds !== []) {
    97	            $qb->andWhere('ps.stockLocationId IN (:stockLocationIds)')
    98	                ->setParameter('stockLocationIds', $input->stockLocationIds);
    99	        }
   100	
   101	        if ($input->updateDateFrom !== null) {
   102	            $qb->andWhere('pc.update_date >= :stockListUpdateDateFrom')
   103	                ->setParameter('stockListUpdateDateFrom', $input->updateDateFrom);
   104	        }
   105	        if ($input->updateDateTo !== null) {
   106	            $toExclusive = \DateTimeImmutable::createFromInterface($input->updateDateTo)
   107	                ->modify('+1 day')
   108	                ->setTime(0, 0, 0);
   109	            $qb->andWhere('pc.update_date < :stockListUpdateDateToExclusive')
   110	                ->setParameter('stockListUpdateDateToExclusive', $toExclusive);
   111	        }
   112	
   113	        if ($input->cardConditions !== []) {
   114	            $qb->andWhere($qb->expr()->in('pc.CardCondition', ':stockListCardConditions'))
   115	                ->setParameter('stockListCardConditions', $input->cardConditions);
   116	        }
   117	
   118	        // CardDetail が必要なフィルターがある場合に一度だけ LEFT JOIN
   119	        if (
   120	            $input->cardsets !== []
   121	            || $input->foilValues !== []
   122	            || $input->rarities !== []
   123	            || $input->frameValues !== []
   124	            || $input->promotions !== []
   125	        ) {
   126	            $qb->leftJoin('p.CardDetail', 'sl_cd_main');
   127	        }
   128	
   129	        // エキスパンション（カードセット）フィルター
   130	        if ($input->cardsets !== []) {
   131	            $qb->andWhere($qb->expr()->in('sl_cd_main.Cardset', ':stockListCardsets'))
   132	                ->setParameter('stockListCardsets', $input->cardsets);
   133	        }
   134	
   135	        // Foil フィルター
   136	        if ($input->foilValues !== []) {
   137	            $qb->andWhere($qb->expr()->in('sl_cd_main.foil_flg', ':stockListFoilValues'))
   138	                ->setParameter('stockListFoilValues', $input->foilValues);
   139	        }
   140	
   141	        // レアリティフィルター
   142	        if ($input->rarities !== []) {
   143	            $qb->andWhere($qb->expr()->in('sl_cd_main.Rarity', ':stockListRarities'))
   144	                ->setParameter('stockListRarities', $input->rarities);
   145	        }
   146	
   147	        // フレームフィルター
   148	        if ($input->frameValues !== []) {
   149	            $qb->andWhere($qb->expr()->in('sl_cd_main.frameFlg', ':stockListFrameValues'))
   150	                ->setParameter('stockListFrameValues', $input->frameValues);
   151	        }
   152	
   153	        // プロモ種別フィルター
   154	        // NON_PROMOTION_ID(1)=ノーマル → CardDetail.Promotion IS NULL
   155	        // PROMOTION_ID(2)=プロモ      → CardDetail.Promotion IS NOT NULL
   156	        // 両方選択時はフィルターなし（全件表示）
   157	        if ($input->promotions !== []) {
   158	            $promotionIds = array_map(fn (MtbPromotion $promo) => $promo->getId(), $input->promotions);
   159	            $hasNormal = in_array(MtbPromotion::NON_PROMOTION_ID, $promotionIds, true);
   160	            $hasPromo = in_array(MtbPromotion::PROMOTION_ID, $promotionIds, true);
   161	            if (!($hasNormal && $hasPromo)) {
   162	                if ($hasNormal) {
   163	                    $qb->andWhere('sl_cd_main.Promotion IS NULL');
   164	                } else {
   165	                    $qb->andWhere('sl_cd_main.Promotion IS NOT NULL');
   166	                }
   167	            }
   168	        }
   169	
   170	        // カテゴリフィルター: p.ProductCategories.Category
   171	        if ($input->categories !== []) {
   172	            $qb->innerJoin('p.ProductCategories', 'sl_pcat')
   173	                ->andWhere($qb->expr()->in('sl_pcat.Category', ':stockListCategories'))
   174	                ->setParameter('stockListCategories', $input->categories);
   175	        }
   176	
   177	        // 公開状態フィルター: p.Status
   178	        if ($input->statuses !== []) {
   179	            $qb->andWhere($qb->expr()->in('p.Status', ':stockListStatuses'))
   180	                ->setParameter('stockListStatuses', $input->statuses);
   181	        }
   182	
   183	        // セールフラグフィルター
   184	        if ($input->saleFlag) {
   185	            $qb->andWhere('pc.sale_flg = true');
   186	        }
   187	
   188	        // 高額商品フィルター
   189	        // STATUS_HIGH_PRICE(1)  → high_price_code IS NOT NULL
   190	        // STATUS_NORMAL_PRICE(2) → high_price_code IS NULL
   191	        // 両方選択時はフィルターなし
   192	        if ($input->expensiveValues !== []) {
   193	            $hasHigh = in_array(ProductClass::STATUS_HIGH_PRICE, $input->expensiveValues, true);
   194	            $hasNormal = in_array(ProductClass::STATUS_NORMAL_PRICE, $input->expensiveValues, true);
   195	            if (!($hasHigh && $hasNormal)) {
   196	                if ($hasHigh) {
   197	                    $qb->andWhere($qb->expr()->isNotNull('pc.high_price_code'));
   198	                } else {
   199	                    $qb->andWhere($qb->expr()->isNull('pc.high_price_code'));
   200	                }
   201	            }
   202	        }
   203	
   204	        // タグフィルター: p.ProductTag.Tag
   205	        // JOIN だと同一商品がタグ数ぶん重複するため EXISTS にする
   206	        if ($input->tags !== []) {
   207	            $tagSubQb = $this->getEntityManager()->createQueryBuilder()
   208	                ->select('1')
   209	                ->from(ProductTag::class, 'sl_pt_sub')
   210	                ->where('sl_pt_sub.Product = p')
   211	                ->andWhere($qb->expr()->in('sl_pt_sub.Tag', ':stockListTags'));
   212	            $qb->andWhere($qb->expr()->exists($tagSubQb->getDQL()))
   213	                ->setParameter('stockListTags', $input->tags);
   214	        }
   215	
   216	        // 略称タグ（StorageCode）フィルター: p.StorageCode
   217	        if ($input->storageCodes !== []) {
   218	            $qb->andWhere($qb->expr()->in('p.StorageCode', ':stockListStorageCodes'))
   219	                ->setParameter('stockListStorageCodes', $input->storageCodes);
   220	        }
   221	
   222	        // 売上分析タグフィルター: p.TagSalesAnalysis (ManyToMany)
   223	        if ($input->tagSalesAnalyses !== []) {
   224	            $qb->innerJoin('p.TagSalesAnalysis', 'sl_tsa')
   225	                ->andWhere($qb->expr()->in('sl_tsa', ':stockListTagSalesAnalyses'))
   226	                ->setParameter('stockListTagSalesAnalyses', $input->tagSalesAnalyses);
   227	        }
   228	
   229	        // 部門フィルター: pc.Section
   230	        if ($input->sections !== []) {
   231	            $qb->andWhere($qb->expr()->in('pc.Section', ':stockListSections'))
   232	                ->setParameter('stockListSections', $input->sections);
   233	        }
   234	
   235	        // 棚番号フィルター: pc.ShelfNumber
   236	        if ($input->shelfNumbers !== []) {
   237	            $qb->andWhere($qb->expr()->in('pc.ShelfNumber', ':stockListShelfNumbers'))
   238	                ->setParameter('stockListShelfNumbers', $input->shelfNumbers);
   239	        }
   240	
   241	        // 基準価格フィルター
   242	        if ($input->basePriceFrom !== null) {
   243	            $qb->andWhere('pc.standardPrice >= :stockListBasePriceFrom')
   244	                ->setParameter('stockListBasePriceFrom', $input->basePriceFrom);
   245	        }
   246	        if ($input->basePriceTo !== null) {
   247	            $qb->andWhere('pc.standardPrice <= :stockListBasePriceTo')
   248	                ->setParameter('stockListBasePriceTo', $input->basePriceTo);
   249	        }
   250	
   251	        // 販売価格フィルター
   252	        if ($input->sellPriceFrom !== null) {
   253	            $qb->andWhere('pc.price02 >= :stockListSellPriceFrom')
   254	                ->setParameter('stockListSellPriceFrom', $input->sellPriceFrom);
   255	        }
   256	        if ($input->sellPriceTo !== null) {
   257	            $qb->andWhere('pc.price02 <= :stockListSellPriceTo')
   258	                ->setParameter('stockListSellPriceTo', $input->sellPriceTo);
   259	        }
   260	
   261	        // 期間別販売数フィルター（販売期間が選択されている場合のみ有効）
   262	        if (
   263	            $input->orderDate !== null
   264	            && in_array((string) $input->orderDate, DtbStockUpQuantity::ORDER_QUANTITY_COLUMN_NUMBERS, true)
   265	        ) {
   266	            $col = sprintf('pc.order_quantity_%02d', $input->orderDate);
   267	            if ($input->orderQuantityFrom !== null) {
   268	                $qb->andWhere($col.' >= :stockListOrderQuantityFrom')
   269	                    ->setParameter('stockListOrderQuantityFrom', $input->orderQuantityFrom);
   270	            }
   271	            if ($input->orderQuantityTo !== null) {
   272	                $qb->andWhere($col.' <= :stockListOrderQuantityTo')
   273	                    ->setParameter('stockListOrderQuantityTo', $input->orderQuantityTo);
   274	            }
   275	        }
   276	
   277	        // 在庫数フィルター
   278	        if ($input->stockFrom !== null) {
   279	            $qb->andWhere('ps.stock >= :stockListStockFrom')
   280	                ->setParameter('stockListStockFrom', $input->stockFrom);
   281	        }
   282	        if ($input->stockTo !== null) {
   283	            $qb->andWhere('ps.stock <= :stockListStockTo')
   284	                ->setParameter('stockListStockTo', $input->stockTo);
   285	        }
   286	
   287	        // 言語フィルター
   288	        // JP_ID(1)            → pc.Language = 1
   289	        // EN_ID(2)            → pc.Language = 2
   290	        // NOT_JP_EN_LANG_ID   → pc.Language NOT IN (1, 2)（日本語・英語以外）
   291	        // 複数選択時は OR で結合
   292	        if ($input->languages !== []) {
   293	            $hasJp = in_array(MtbLanguage::JP_ID, $input->languages, true);
   294	            $hasEn = in_array(MtbLanguage::EN_ID, $input->languages, true);
   295	            $hasOther = in_array(MtbLanguage::NOT_JP_EN_LANG_ID, $input->languages, true);
   296	
   297	            $conditions = [];
   298	            if ($hasJp) {
   299	                $conditions[] = 'IDENTITY(pc.Language) = '.MtbLanguage::JP_ID;
   300	            }
   301	            if ($hasEn) {
   302	                $conditions[] = 'IDENTITY(pc.Language) = '.MtbLanguage::EN_ID;
   303	            }
   304	            if ($hasOther) {
   305	                $conditions[] = '(pc.Language IS NOT NULL AND IDENTITY(pc.Language) NOT IN (:stockListConstantLangIds))';
   306	                $qb->setParameter('stockListConstantLangIds', MtbLanguage::CONSTANT_LANG_IDS);
   307	            }
   308	
   309	            if ($conditions !== []) {
   310	                $qb->andWhere('('.implode(' OR ', $conditions).')');
   311	            }
   312	        }
   313	
   314	        $qb->orderBy('pc.id', 'DESC')
   315	            ->addOrderBy('ps.stockLocationId', 'ASC');
   316	
   317	        return $qb;
   318	    }
   319	
   320	    private function adminStockListEscapeLikePattern(string $value): string
   321	    {
   322	        $e = self::ADMIN_STOCK_LIST_LIKE_ESCAPE_CHAR;
   323	        // ESCAPE '!' を明示指定した場合、\ は特殊文字ではなくリテラルとして扱われるため二重化不要。
   324	        $escaped = str_replace($e, $e.$e, $value);
   325	        $escaped = str_replace('%', $e.'%', $escaped);
   326	        $escaped = str_replace('_', $e.'_', $escaped);
   327	
   328	        return '%'.$escaped.'%';
   329	    }
   330	
   331	    private function adminStockListLikeEscapeDql(): string
   332	    {
   333	        return ' ESCAPE \''.self::ADMIN_STOCK_LIST_LIKE_ESCAPE_CHAR.'\'';
   334	    }
