   454	                                        {% endfor %}
   455	                                        <option value="{{ url('admin_setting_shop_csv_custom', { csvTypeId: constant('Eccube\\Entity\\Master\\CsvType::CSV_TYPE_STOCK') }) }}">{{ 'admin.stock.list.custom_csv_settings'|trans }}</option>
   456	                                    </select>
