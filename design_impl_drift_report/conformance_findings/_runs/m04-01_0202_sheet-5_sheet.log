   556	                                        <th class="border-top-0 pt-2 pb-2 col-sales qty">{{ 'admin.product.today'|trans }}</th>
   557	                                        <th class="border-top-0 pt-2 pb-2 col-sales qty">{{ 'admin.product.yesterday'|trans }}</th>
   558	                                        <th class="border-top-0 pt-2 pb-2 col-sales qty">{{ 'admin.product.3day'|trans }}</th>
   559	                                        <th class="border-top-0 pt-2 pb-2 col-sales qty">{{ 'admin.product.1week'|trans }}</th>
   560	                                        <th class="border-top-0 pt-2 pb-2 col-sales qty">{{ 'admin.product.1month'|trans }}</th>
   561	                                        <th class="border-top-0 pt-2 pb-2 col-sales qty pe-1">{{ 'admin.product.90day'|trans }}</th>
