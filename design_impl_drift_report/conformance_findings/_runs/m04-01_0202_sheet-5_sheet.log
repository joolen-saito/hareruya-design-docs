   669	        </div>
   670	    </div>
   671	</div>
   672	
   673	<script nonce="{{ csp_nonce }}">
   674	    $(function() {
   675	        $('.c-curtain').removeClass('is-active');
   676	        $('.c-mainNavArea').removeClass('is-active');
   677	
   678	        // 検索条件クリア
   679	        $('#clearSearchBtn').on('click', function() {
   680	            $('#searchStockListForm input').each(function() {
   681	                if (this.type === 'checkbox' || this.type === 'radio') {
   682	                    this.checked = false;
   683	                } else if (!this.name.match(/_token/i)) {
   684	                    $(this).val('');
   685	                }
   686	            });
   687	            $('#searchStockListForm select').val(null).trigger('change');
   688	            $('#searchStockListForm').submit();
   689	        });
   690	
   691	        // 検索パターン保存
   692	        $('#savePatternBtn').on('click', function() {
   693	            const url = $(this).data('url');
   694	            if (url) {
   695	                $('#searchStockListForm').attr('action', url).submit();
   696	            }
   697	        });
   698	
   699	        // 検索パターン削除
   700	        $('#deletePatternBtn').on('click', function() {
   701	            const url = $(this).data('url');
   702	            if (url) {
   703	                $('#searchStockListForm').attr('action', url).submit();
   704	            }
   705	        });
   706	
   707	        // 3点メニュー: 開閉制御
   708	        let $openMenu = null;
   709	
   710	        $(document).on('click', '.js-stock-row-menu-btn', function(e) {
   711	            e.stopPropagation();
   712	            const $btn = $(this);
   713	            const $menu = $btn.next('.js-stock-row-menu');
   714	            const isOpen = $menu.is(':visible');
   715	
   716	            // 他のメニューをすべて閉じる
   717	            if ($openMenu && $openMenu[0] !== $menu[0]) {
   718	                $openMenu.hide();
   719	            }
   720	
   721	            if (isOpen) {
   722	                $menu.hide();
   723	                $openMenu = null;
   724	            } else {
   725	                const rect = this.getBoundingClientRect();
   726	                // サイズ取得のため一瞬不可視で表示
   727	                $menu.css({ visibility: 'hidden', display: 'block' });
   728	                const menuW = $menu.outerWidth(true);
   729	                $menu.css({
   730	                    visibility: '',
   731	                    display: 'none',
   732	                    top: rect.top + 'px',
   733	                    left: (rect.left - menuW) + 'px'
   734	                }).show();
   735	                $openMenu = $menu;
   736	            }
   737	        });
   738	
   739	        // リンク以外のクリックで閉じる
   740	        $(document).on('click', function(e) {
   741	            if ($openMenu && !$(e.target).is('a') && !$(e.target).closest('.js-stock-row-menu-btn').length) {
   742	                $openMenu.hide();
   743	                $openMenu = null;
   744	            }
   745	        });
   746	
   747	        // 全選択チェックボックス
   748	        $('#checkAll').on('change', function() {
   749	            $('.row-check').prop('checked', $(this).prop('checked'));
   750	            updateActionButtons();
   751	        });
   752	        $(document).on('change', '.row-check', function() {
   753	            const total = $('.row-check').length;
   754	            const checked = $('.row-check:checked').length;
   755	            $('#checkAll').prop('indeterminate', checked > 0 && checked < total);
   756	            $('#checkAll').prop('checked', checked === total);
   757	            updateActionButtons();
   758	        });
   759	
   760	
   761	        function isSameShop() {
   762	            const shopIds = $('.row-check:checked').map(function() {
   763	                return $(this).data('shop-id');
   764	            }).get();
   765	            return new Set(shopIds).size <= 1;
   766	        }
   767	
   768	        function hasUnauthorizedShop() {
   769	            return $('.row-check:checked').filter(function() {
   770	                return $(this).data('editable') !== true;
   771	            }).length > 0;
   772	        }
   773	
   774	        function hasZeroStock() {
   775	            return $('.row-check:checked').filter(function() {
   776	                return parseInt($(this).data('stock'), 10) <= 0;
   777	            }).length > 0;
   778	        }
   779	
   780	        function updateActionButtons() {
   781	            const hasChecked = $('.row-check:checked').length > 0;
   782	            // 全ボタン: 1件以上チェックで活性（詳細条件は押下時にアラートで通知）
   783	            $('#bulkEditBtn, #stockMoveBtn, #stockTransferBtn, #stockSplitBtn, #stockJoinBtn').prop('disabled', !hasChecked);
   784	        }
   785	
   786	        // 表示件数セレクト: 選択値の URL へ遷移
   787	        $('#page_count_pulldown, #stock_csv_pulldown').on('change', function() {
   788	            const targetUrl = $(this).val();
   789	            if (targetUrl) {
   790	                window.location.href = targetUrl;
   791	            }
   792	        });
   793	
   794	        // 在庫一括編集: 権限なし店舗・複数店舗の場合はアラート
   795	        $('#bulkEditBtn').on('click', function() {
   796	            const ids = getCheckedIds();
   797	            if (ids.length === 0) {
   798	                return;
   799	            }
   800	            if (hasUnauthorizedShop()) {
   801	                alert('編集権限を持っていない店舗の在庫が選択されています。\n編集権限のある店舗の在庫のみ選択してください。');
   802	                return;
   803	            }
   804	            if (!isSameShop()) {
   805	                alert('複数の店舗の商品規格が選択されています。\n同一の店舗の在庫のみ選択してください。');
   806	                return;
   807	            }
   808	            const url = $(this).data('url');
   809	            if (!url) {
   810	                return;
   811	            }
   812	            submitBulkApprovalNewPost(url, ids);
   813	        });
   814	
   815	        // 在庫移動登録・振替登録: 権限なし店舗・複数店舗・在庫0の場合はアラート
   816	        $('#stockMoveBtn, #stockTransferBtn').on('click', function() {
   817	            const ids = getCheckedIds();
   818	            if (ids.length === 0) {
   819	                return;
   820	            }
   821	            if (hasUnauthorizedShop()) {
