   565	                                </thead>
   566	                                <tbody>
   567	                                {% if pagination is not empty %}
   568	                                    {% for Item in pagination %}
   569	                                        <tr>
   570	                                            <td class="ps-3">
   571	                                                <input type="checkbox" class="form-check-input row-check"
   572	                                                    name="productStockIds[]"
   573	                                                    value="{{ Item.id }}"
   574	                                                    data-shop-id="{{ Item.baseInfo.id }}"
   575	                                                    data-zone="{{ Item.stockLocationId }}"
   576	                                                    data-editable="{{ app.user.isEditableShop(Item.baseInfo) ? 'true' : 'false' }}"
   577	                                                    data-stock="{{ Item.stock|default(0) }}"
   578	                                                    aria-label="{{ 'admin.common.select'|trans }}">
   579	                                            </td>
   580	                                            <td class="col-id">{{ Item.ProductClass.Product.id }}</td>
   581	                                            {# (5-3)(5-4) 商品名（リンク） + コード（2行） #}
   582	                                            <td class="col-name">
   583	                                                <a href="{{ url('admin_stock_approval_new', {'productStockId': Item.id}) }}" title="{{ Item.ProductClass.Product.name }}">
   584	                                                    {{ Item.ProductClass.Product.name }}
   585	                                                </a>
   586	                                                <div class="text-muted small">{{ Item.ProductClass.code|default('') }}</div>
   587	                                            </td>
   588	                                            {# (5-5)(5-6) 店舗名 + 在庫区分（2行） #}
   589	                                            <td class="col-shop">
   590	                                                <div>{{ Item.baseInfo.shopName }}</div>
   591	                                                <div class="text-muted small">{{ Item.locationName }}</div>
   592	                                            </td>
   593	                                            <td class="col-lang">{{ Item.ProductClass.Language|default('-') }}</td>
   594	                                            <td class="col-cond">{{ Item.ProductClass.CardCondition|default('-') }}</td>
   595	                                            <td class="col-price">
   596	                                                <div>{{ Item.ProductClass.standardPrice|default(0)|number_format }}</div>
   597	                                                <div>{{ Item.ProductClass.price02|default(0)|number_format }}</div>
   598	                                            </td>
   599	                                            <td class="col-price">
   600	                                                <div>{{ Item.ProductClass.buy_price|default(0)|number_format }}</div>
   601	                                                <div>{{ Item.unitCost|number_format }}</div>
   602	                                            </td>
   603	                                            <td class="col-stock">
   604	                                                <div>{{ Item.stock|default(0)|number_format }}</div>
   605	                                                <div>{{ Item.totalCost|number_format }}</div>
   606	                                            </td>
   607	                                            {# (5-15〜5-20) 期間別販売数: ProductClass.ShopStockUpQuantities から店舗一致レコードを取得 #}
   608	                                            {% set suq = null %}
   609	                                            {% for q in Item.ProductClass.ShopStockUpQuantities %}
   610	                                                {% if q.BaseInfo.id == Item.baseInfo.id %}
   611	                                                    {% set suq = q %}
   612	                                                {% endif %}
   613	                                            {% endfor %}
   614	                                            <td class="col-sales align-middle text-end" nowrap>{{ suq ? suq.stockUpQuantity01|number_format : 0 }}</td>
   615	                                            <td class="col-sales align-middle text-end" nowrap>{{ suq ? suq.stockUpQuantity02|number_format : 0 }}</td>
   616	                                            <td class="col-sales align-middle text-end" nowrap>{{ suq ? suq.stockUpQuantity03|number_format : 0 }}</td>
   617	                                            <td class="col-sales align-middle text-end" nowrap>{{ suq ? suq.stockUpQuantity04|number_format : 0 }}</td>
   618	                                            <td class="col-sales align-middle text-end" nowrap>{{ suq ? suq.stockUpQuantity05|number_format : 0 }}</td>
   619	                                            <td class="col-sales align-middle text-end pe-1" nowrap>{{ suq ? suq.stockUpQuantity06|number_format : 0 }}</td>
   620	                                            {# (5-21) 3点メニュー #}
   621	                                            <td class="col-menu pe-3">
   622	                                                <button type="button"
   623	                                                    class="btn btn-link p-0 text-secondary js-stock-row-menu-btn"
   624	                                                    aria-label="{{ 'admin.common.operation'|trans }}">
   625	                                                    <i class="fa fa-ellipsis-h" aria-hidden="true"></i>
   626	                                                </button>
   627	                                                <ul class="js-stock-row-menu list-unstyled mb-0 py-1 rounded border bg-white shadow-sm"
   628	                                                    style="display:none; position:fixed; z-index:9999; min-width:8rem;">
   629	                                                    {# (5-22) 変動履歴 #}
   630	                                                    <li>
   631	                                                        <a class="dropdown-item" href="{{ url('admin_stock_history') ~ '?product_code=' ~ (Item.ProductClass.code|url_encode) ~ '&stock_location_id=' ~ Item.stockLocationId ~ '&base_info_id=' ~ Item.baseInfo.id }}">
   632	                                                            {{ 'admin.stock.list.menu.stock_history'|trans }}
   633	                                                        </a>
   634	                                                    </li>
   635	                                                    {# (5-23) 価格履歴 #}
   636	                                                    <li>
   637	                                                        <a class="dropdown-item" href="{{ url('admin_product_buy_sale_price_history_search', {'page_no': 1}) ~ '?code=' ~ (Item.ProductClass.code|url_encode) }}">
   638	                                                            {{ 'admin.stock.list.menu.price_history'|trans }}
   639	                                                        </a>
   640	                                                    </li>
   641	                                                </ul>
   642	                                            </td>
   643	                                        </tr>
   644	                                    {% else %}
   645	                                        <tr>
   646	                                            <td colspan="16" class="text-center py-4">{{ 'admin.common.search_no_result'|trans }}</td>
   647	                                        </tr>
   648	                                    {% endfor %}
   649	                                {% else %}
   650	                                    <tr>
   651	                                        <td colspan="16" class="text-center py-4 text-muted">{{ 'admin.stock.list.search_first'|trans }}</td>
   652	                                    </tr>
   653	                                {% endif %}
   654	                                </tbody>
   655	                            </table>
   656	                        </div>
   657	                    </div>
   658	
   659	                    {# (5-24) ページング #}
   660	                    {% if pagination is not empty and pagination.totalItemCount > 0 %}
   661	                        <div class="row justify-content-md-center mt-3 mb-4 pb-4">
   662	                            {% include "@admin/pager.twig" with { 'pages': pagination.paginationData, 'routes': 'admin_stock_list_page' } %}
   663	                        </div>
   664	                    {% endif %}
