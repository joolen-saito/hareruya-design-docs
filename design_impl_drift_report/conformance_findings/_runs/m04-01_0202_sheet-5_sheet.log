   484	                                    data-url="{{ url('admin_stock_move_new') }}">
   485	                                    {{ 'admin.stock.list.stock_move'|trans }}
   486	                                </button>
   487	                                {# (4-6) 在庫振替登録 #}
   488	                                <button type="button" id="stockTransferBtn" class="btn btn-ec-conversion btn-sm" disabled
   489	                                    data-url="{{ url('admin_stock_transfer_new') }}">
   490	                                    {{ 'admin.stock.list.stock_transfer'|trans }}
   491	                                </button>
   492	                                {# (4-7) 在庫分割登録: /product/stock/{id}/split/new へ遷移 #}
