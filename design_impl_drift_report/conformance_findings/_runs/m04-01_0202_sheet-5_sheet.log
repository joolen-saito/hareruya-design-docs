   454	
   455	    /**
   456	     * 他画面からの遷移用: クエリの product_name / card_condition をセッション検索条件へ反映する。
   457	     * card_condition はカード状態 ID。
   458	     */
   459	    private function applySearchContextFromQuery(Request $request): void
   460	    {
   461	        if (!$request->query->has('product_name') && !$request->query->has('card_condition')) {
   462	            return;
   463	        }
   464	
   465	        $viewData = [];
   466	        if ($request->query->has('product_name')) {
   467	            $productName = $request->query->get('product_name');
   468	            if (is_scalar($productName) && (string) $productName !== '') {
   469	                $viewData['product_name'] = (string) $productName;
   470	            }
   471	        }
   472	        if ($request->query->has('card_condition')) {
   473	            $cardCondition = $request->query->get('card_condition');
   474	            if (is_scalar($cardCondition) && ctype_digit((string) $cardCondition) && (int) $cardCondition > 0) {
   475	                $viewData['card_condition'] = [(string) $cardCondition];
   476	            }
   477	        }
   478	
   479	        $session = $this->session;
   480	        $session->set(self::SESSION_KEY_SEARCH, $this->withFreshCsrfToken($viewData));
   481	        $session->set(self::SESSION_KEY_PAGE_NO, 1);
   482	        $session->remove(self::SESSION_KEY_PATTERN_ID);
   483	    }
   484	
   485	    /**
   486	     * @return list<int>
   487	     */
   488	    private function extractProductStockIdsFromRequest(Request $request): array
   489	    {
   490	        // InputBag::get() は配列値で BadRequestException を投げるため all() 経由で取得する。
   491	        $body = $request->request->all();
   492	        $query = $request->query->all();
   493	        $raw = $body['productStockIds'] ?? ($query['productStockIds'] ?? ($body['productStockId'] ?? ($query['productStockId'] ?? null)));
   494	        if ($raw === null || $raw === '') {
   495	            return [];
   496	        }
   497	
   498	        $values = is_array($raw) ? $raw : [$raw];
   499	        $ids = [];
   500	        foreach ($values as $value) {
   501	            if (!is_scalar($value) || $value === '') {
   502	                continue;
   503	            }
   504	            $id = (int) $value;
   505	            if ($id > 0) {
   506	                $ids[] = $id;
   507	            }
   508	        }
   509	
   510	        /** @var list<int> $normalized */
   511	        $normalized = array_values(array_unique($ids));
   512	
   513	        return $normalized;
   514	    }
   515	}

