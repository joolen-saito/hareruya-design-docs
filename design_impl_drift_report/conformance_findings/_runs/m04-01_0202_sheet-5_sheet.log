   444	                                {# (4-10) 在庫情報CSV出力 (M04-04) #}
   445	                                <a href="{{ url('admin_stock_list_csv') }}" class="btn btn-ec-conversion btn-sm">
   446	                                    {{ 'admin.stock.list.stock_info_csv'|trans }}
   447	                                </a>
   448	                                {# (4-11) 在庫情報カスタムCSV出力 #}
