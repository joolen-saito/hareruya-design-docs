   458	                                {# (4-12) 表示件数（選択肢: 10件 50件 100件 300件 500件 1000件 2000件 10000件 12000件） #}
   459	                                <div class="ms-auto">
   460	                                    <select id="page_count_pulldown" class="form-select form-select-sm" style="width:auto;">
   461	                                        {% for pageMax in pageMaxis %}
