    23	
    24	/**
    25	 * 部門更新CSVをインポートするもの。
    26	 */
    27	class ProductSectionUpdateImportHandler extends BaseCsvImportHandler
    28	{
    29	    private ?CsvColumnInterface $productCodeColumn = null;
    30	
    31	    private ?CsvColumnInterface $sectionCodeColumn = null;
    32	
    33	    public function __construct(
    34	        private readonly ProductClassRepository $productClassRepository,
    35	        private readonly MtbSectionRepository $sectionRepository,
    36	    ) {
    37	    }
    38	
    39	    public function onBeforeImport(): void
    40	    {
    41	        parent::onBeforeImport();
    42	
    43	        $this->initializeColumnDefinitions();
    44	    }
    45	
    46	    public function onAfterImport(AfterReadEvent $event): void
    47	    {
    48	        parent::onAfterImport($event);
    49	
    50	        $this->clearColumnDefinitions();
    51	    }
    52	
    53	    /**
    54	     * CSVデータ1行の形式をチェックする。
    55	     *
    56	     * @param ReadCsvRowEvent $event イベント
    57	     */
    58	    public function onValidateRow(ReadCsvRowEvent $event): void
    59	    {
    60	        parent::onValidateRow($event);
    61	        if ($event->isBreakAll() || $event->isSkipRow()) {
    62	            return;
    63	        }
    64	
    65	        if (!$this->validateProductExists($event)) {
    66	            $event->breakAll();
    67	
    68	            return;
    69	        }
    70	
    71	        if (!$this->validateSectionExists($event)) {
    72	            $event->breakAll();
    73	        }
    74	    }
    75	
    76	    /**
    77	     * CSVデータ1行を取り込む。
    78	     *
    79	     * @param ReadCsvRowEvent $event イベント
    80	     *
    81	     * @return bool 読み込みに成功した場合 true
    82	     */
    83	    public function onReadRow(ReadCsvRowEvent $event): bool
    84	    {
    85	        $row = $event->getRow();
    86	        $productCode = (string) $this->productCodeColumn->getValue($row);
    87	        $this->persistSection($event, $productCode);
    88	
    89	        return true;
    90	    }
    91	
    92	    /**
    93	     * 列の定義を取得する。
    94	     *
    95	     * @return array<CsvColumnInterface>
    96	     */
    97	    protected function getColumns(): array
    98	    {
    99	        return [
   100	            $this->productCodeColumn,
   101	            $this->sectionCodeColumn,
   102	        ];
   103	    }
   104	
   105	    /**
   106	     * 列を検証するロジックを取得する。
   107	     *
   108	     * @return array<RowValidatorInterface>
   109	     */
   110	    protected function getRowValidators(): array
   111	    {
   112	        return [];
   113	    }
   114	
   115	    private function initializeColumnDefinitions(): void
   116	    {
   117	        $this->productCodeColumn = ColumnDefinitions::productCode()->setRequired(true);
   118	        $this->sectionCodeColumn = ColumnDefinitions::sectionCode();
   119	    }
   120	
   121	    private function clearColumnDefinitions(): void
   122	    {
   123	        $this->productCodeColumn = null;
   124	        $this->sectionCodeColumn = null;
   125	    }
   126	
   127	    /**
   128	     * 商品の有無をチェックし、エラーがあればメッセージを設定する。
   129	     */
   130	    private function validateProductExists(ReadCsvRowEvent $event): bool
   131	    {
   132	        $row = $event->getRow();
   133	
   134	        $productCode = (string) $this->productCodeColumn->getValue($row);
   135	        if (!$this->productClassRepository->existsByProductCode($productCode)) {
   136	            $event->getMessageStore()
   137	                ->addProductNotExistsError(
   138	                    $row->getRowNumber(),
   139	                    $this->productCodeColumn->getLabel()
   140	                );
   141	            $event->breakAll();
   142	
   143	            return false;
   144	        }
   145	
   146	        return true;
   147	    }
   148	
   149	    /**
   150	     * 部門の有無をチェックし、エラーがあればメッセージを設定する。（部門コードが空の場合はスキップ）
   151	     */
   152	    private function validateSectionExists(ReadCsvRowEvent $event): bool
   153	    {
   154	        $row = $event->getRow();
   155	
   156	        $sectionCode = trim((string) $this->sectionCodeColumn->getValue($row));
   157	        if ($sectionCode === '') {
   158	            return true;
   159	        }
   160	
   161	        $Section = $this->sectionRepository->findOneBy(['code' => $sectionCode]);
   162	        if ($Section === null) {
   163	            $event->getMessageStore()
   164	                ->addMasterNotExistsError(
   165	                    $row->getRowNumber(),
   166	                    $this->sectionCodeColumn->getLabel(),
   167	                    $sectionCode
   168	                );
   169	            $event->breakAll();
   170	
   171	            return false;
   172	        }
   173	
   174	        return true;
   175	    }
   176	
   177	    /**
   178	     * 部門コードから部門IDを取得する。
   179	     *
   180	     * @return int|null 部門ID（存在しない場合は null）
   181	     */
   182	    private function getSectionIdByCode(string $sectionCode): ?int
   183	    {
   184	        $sectionCode = trim($sectionCode);
   185	        if ($sectionCode === '') {
   186	            return null;
   187	        }
   188	
   189	        $Section = $this->sectionRepository->findOneBy(['code' => $sectionCode]);
   190	
   191	        return $Section !== null ? $Section->getId() : null;
   192	    }
   193	
   194	    /**
   195	     * 部門を更新する。
   196	     *
   197	     * @param ReadCsvRowEvent $event イベント
   198	     * @param string $productCode 商品コード
   199	     */
   200	    private function persistSection(ReadCsvRowEvent $event, string $productCode): void
   201	    {
   202	        $sectionCode = (string) $this->sectionCodeColumn->getValue($event->getRow());
   203	        $sectionId = $this->getSectionIdByCode($sectionCode);
   204	
   205	        $this->productClassRepository->replaceSection($productCode, $sectionId);
   206	    }
   207	}

