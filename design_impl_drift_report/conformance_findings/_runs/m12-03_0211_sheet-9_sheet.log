    79	        $searchData = $searchForm->getData();
    80	        $this->session->set(self::SESSION_KEY, FormUtil::getViewData($searchForm));
    81	
    82	        $searchData['base_info_ids'] = $this->resolveTargetBaseInfoIds(
    83	            (bool) ($searchData['mail_order_enabled'] ?? false),
    84	            is_iterable($searchData['store_sales_targets'] ?? null) ? $searchData['store_sales_targets'] : []
    85	        );
    86	        $summary = $this->orderItemRepository->getAnalysisSummary($searchData);
    87	
    88	        return [
