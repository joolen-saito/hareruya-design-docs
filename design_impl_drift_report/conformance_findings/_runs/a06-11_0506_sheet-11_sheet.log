    34	     */
    35	    #[Route('/%eccube_api_v1_route%/admin/sections.json', name: 'api_admin_sections', methods: ['GET'])]
    36	    public function getSections(): JsonResponse
    37	    {
    38	        $Sections = $this->mtbSectionRepository->findBy(['visible' => true], ['code' => 'ASC']);
