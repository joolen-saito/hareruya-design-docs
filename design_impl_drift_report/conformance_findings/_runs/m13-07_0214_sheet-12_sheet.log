    16	namespace Eccube\Service\Admin\Entry;
    17	
    18	use Doctrine\ORM\EntityManagerInterface;
    19	use Eccube\Repository\DtbEntryHistoryRepository;
    20	use Eccube\Repository\DtbEventEntryRepository;
    21	use Eccube\Service\Admin\Entry\ActionInput\EntryStatusBulkUpdateInput;
    22	use Eccube\Service\EntityManager\EventEntryEntityManager;
    23	
    24	class EntryStatusBulkUpdateAction
    25	{
    26	    public function __construct(
    27	        private readonly EntityManagerInterface $entityManager,
    28	        private readonly DtbEventEntryRepository $eventEntryRepository,
    29	        private readonly DtbEntryHistoryRepository $entryHistoryRepository,
    30	        private readonly EventEntryEntityManager $eventEntryEntityManager,
    31	    ) {
    32	    }
    33	
    34	    public function handle(EntryStatusBulkUpdateInput $input): void
    35	    {
    36	        $this->entityManager->wrapInTransaction(function () use ($input): void {
    37	            $ids = $input->entryIds;
    38	            $entries = $this->eventEntryRepository->findBy(['id' => $ids]);
    39	            if (count($entries) !== count($ids)) {
    40	                throw new \InvalidArgumentException(trans('admin.event.entry.bulk_update.invalid_selection'));
    41	            }
    42	
    43	            $member = $input->Member;
    44	            $entryStatus = $input->EntryStatus;
    45	
    46	            foreach ($entries as $entry) {
    47	                $baseInfo = $entry->getEventDetail()->getEvent()->getBaseInfo();
    48	                if ($baseInfo === null || !$member->isEditableShop($baseInfo)) {
    49	                    throw new \InvalidArgumentException(trans('admin.event.entry.bulk_update.permission_denied'));
    50	                }
    51	
    52	                $this->eventEntryEntityManager->save(
    53	                    Entry: $entry,
    54	                    EventDetail: $entry->getEventDetail(),
    55	                    EntryStatus: $entryStatus,
    56	                    Payment: $entry->getPayment(),
    57	                    price: $entry->getPrice(),
    58	                    paymentNo: $entry->getPaymentNo(),
    59	                    paymentLimit: $entry->getPaymentLimit(),
    60	                    PayingCustomer: $entry->getPayingCustomer(),
    61	                    deletedAt: $entry->getDeletedAt(),
    62	                );
    63	                $this->entryHistoryRepository->createEntryHistory($entry, $member->getId());
    64	            }
    65	
    66	            $this->entityManager->flush();
    67	        });
    68	    }
    69	}

