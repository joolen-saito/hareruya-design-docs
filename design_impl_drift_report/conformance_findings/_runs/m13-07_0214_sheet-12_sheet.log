   301	    public function bulkUpdateEntryStatus(Request $request): JsonResponse
   302	    {
   303	        $form = $this->formFactory->create(EventEntryBulkUpdateType::class);
   304	        $form->handleRequest($request);
   305	
   306	        if (!$form->isSubmitted() || !$form->isValid()) {
   307	            $msg = trans('admin.common.error_invalid_request');
   308	            foreach ($form->getErrors(true) as $error) {
   309	                $msg = $error->getMessage();
   310	                break;
   311	            }
   312	
   313	            return new JsonResponse(['message' => [$msg]], Response::HTTP_BAD_REQUEST);
   314	        }
   315	
   316	        $ids = array_values(array_unique(array_filter(array_map('intval', (array) ($request->request->all()['entries'] ?? [])))));
   317	        if ($ids === []) {
   318	            return new JsonResponse(['message' => [trans('admin.event.entry.bulk_update.nothing_selected')]], Response::HTTP_BAD_REQUEST);
   319	        }
   320	
   321	        /** @var MtbEntryStatus $entryStatus */
   322	        $entryStatus = $form->get('entryStatus')->getData();
   323	
   324	        try {
   325	            $this->entryStatusBulkUpdateAction->handle(new EntryStatusBulkUpdateInput(
   326	                entryIds: $ids,
   327	                EntryStatus: $entryStatus,
   328	                Member: $this->getMember(),
   329	            ));
   330	        } catch (\InvalidArgumentException $e) {
   331	            return new JsonResponse(['message' => [$e->getMessage()]], Response::HTTP_BAD_REQUEST);
   332	        }
   333	
   334	        return new JsonResponse(['message' => [trans('admin.event.entry.bulk_update.success', ['%count%' => count($ids)])]]);
   335	    }
