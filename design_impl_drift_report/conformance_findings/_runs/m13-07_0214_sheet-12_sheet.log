   249	    #[Route(path: '/%eccube_admin_route%/event/entry/{eventEntry}/edit', name: 'admin_event_entry_edit', requirements: ['eventEntry' => '\d+'], methods: ['GET', 'POST'])]
   250	    #[Template(template: '@admin/Event/EntryRegistration/edit.twig')]
   251	    public function edit(Request $request, #[MapEntity(id: 'eventEntry')] DtbEventEntry $eventEntry): RedirectResponse|array
   252	    {
   253	        $baseInfo = $eventEntry->getEventDetail()->getEvent()->getBaseInfo();
   254	        if ($baseInfo === null || !$this->getMember()->isEditableShop($baseInfo)) {
   255	            throw $this->createNotFoundException();
   256	        }
   257	
   258	        $form = $this->formFactory->create(EventEntryDetailType::class, $eventEntry, [
   259	            'registration_mode' => false,
   260	            'entry_status_editable' => true,
   261	        ]);
   262	        $form->get('eventDetailId')->setData((string) $eventEntry->getEventDetail()->getId());
   263	        $form->get('eventEntryId')->setData((string) $eventEntry->getId());
   264	        $form->handleRequest($request);
   265	
   266	        if ($form->isSubmitted() && $form->isValid()) {
   267	            $submittedPlayerId = (int) $form->get('entryPlayer')->getData();
   268	
   269	            try {
   270	                $input = new EntryUpdateInput(
   271	                    EventEntry: $eventEntry,
   272	                    Member: $this->getMember(),
   273	                    playerId: $submittedPlayerId,
   274	                );
   275	                $this->entryUpdateAction->handle($input);
   276	                $this->addSuccess('admin.common.save_complete', 'admin');
   277	
   278	                return $this->redirectToRoute('admin_event_entry_edit', ['eventEntry' => $eventEntry->getId()]);
   279	            } catch (\InvalidArgumentException $e) {
   280	                $this->addError($e->getMessage(), 'admin');
   281	            } catch (\Exception $e) {
   282	                $this->addError('admin.common.save_error', 'admin');
   283	            }
   284	        }
   285	
   286	        $players = $eventEntry->getEntryPlayers();
   287	        if ($players->isEmpty()) {
   288	            throw $this->createNotFoundException();
   289	        }
   290	        $entryPlayer = $players->first();
   291	
   292	        return [
   293	            'form' => $form->createView(),
   294	            'eventEntry' => $eventEntry,
   295	            'entryPlayer' => $entryPlayer,
   296	            'seatNames' => [],
   297	        ];
   298	    }
