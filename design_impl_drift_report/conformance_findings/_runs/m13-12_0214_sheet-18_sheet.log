  5015	          <div class="doc-flow">
  5016	            <h3 class="doc-h doc-h-section" style="--lv:0">レイアウト図</h3>
  5017	          </div>
  5018	          <div class="image-block">
  5019	            <figure class="sheet-image wf-frame">
  5020	              <div class="wf-stage">
  5021	                <img src="data:image/png;base64," alt="イベント一括登録 / C8 / image 1" width="989">
