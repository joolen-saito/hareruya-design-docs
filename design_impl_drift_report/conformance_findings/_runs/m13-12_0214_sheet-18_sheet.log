    47	    public function getQueryBuilderByEntrySearchData(array $searchData): QueryBuilder
    48	    {
    49	        $sortKey = [
    50	            'playerId' => 'pl.id',
    51	        ];
    52	
    53	        $qb = $this->createQueryBuilder('pl')
    54	            ->distinct()
    55	            ->leftJoin('pl.Customer', 'cu')
    56	            ->andWhere('pl.deletedAt IS NULL');
    57	
    58	        $searchStr = isset($searchData['search']) ? trim((string) $searchData['search']) : '';
    59	        if ($searchStr !== '') {
    60	            $texts = preg_split('/[\s,　]+/u', $searchStr, -1, PREG_SPLIT_NO_EMPTY);
    61	            if ($texts !== false) {
    62	                SqlUtil::multiTextQuery($qb, $texts, [
    63	                    'cu' => ['name01', 'name02', 'kana01', 'kana02'],
    64	                    'pl' => ['firstNameJp', 'firstNameEn', 'lastNameJp', 'lastNameEn', 'nickname', 'dciNo'],
    65	                ]);
    66	            }
    67	        }
    68	
    69	        if (!empty($searchData['sort']) && is_string($searchData['sort']) && isset($sortKey[$searchData['sort']])) {
    70	            $qb->addOrderBy($sortKey[$searchData['sort']], 'DESC');
    71	        } else {
    72	            $qb->addOrderBy('pl.id', 'ASC');
    73	        }
    74	
    75	        return $qb;
    76	    }
