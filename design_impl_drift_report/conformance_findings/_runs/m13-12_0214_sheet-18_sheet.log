    21	
    22	class EntryRegistrationScheduleRowBuilder
    23	{
    24	    /**
    25	     * @param iterable<DtbEvent>       $events
    26	     * @param \DateTimeInterface|null $startDateFrom
    27	     * @param \DateTimeInterface|null $startDateTo
    28	     *
    29	     * @return list<array<string, mixed>>
    30	     */
    31	    public function expandScheduleRows(iterable $events, ?\DateTimeInterface $startDateFrom = null, ?\DateTimeInterface $startDateTo = null): array
    32	    {
    33	        $toExclusive = null;
    34	        if ($startDateTo instanceof \DateTimeInterface) {
    35	            $toExclusive = \DateTimeImmutable::createFromInterface($startDateTo)->modify('+1 day');
    36	        }
    37	
    38	        $allDatas = [];
    39	        foreach ($events as $event) {
    40	            $details = $event->getDetails()->filter(function ($d) use ($startDateFrom, $toExclusive) {
    41	                if (!$d->getEntryFlg()) {
    42	                    return false;
    43	                }
    44	                $start = $d->getStartDate();
    45	                if ($startDateFrom instanceof \DateTimeInterface && $start < $startDateFrom) {
    46	                    return false;
    47	                }
    48	                if ($toExclusive !== null && $start >= $toExclusive) {
    49	                    return false;
    50	                }
    51	
    52	                return true;
    53	            })->toArray();
    54	            if ($details === []) {
    55	                continue;
    56	            }
    57	            usort($details, fn ($a, $b) => $b->getId() <=> $a->getId());
    58	            $rowSpan = count($details);
    59	            $shop = $event->getBaseInfo()?->getShopName() ?? '';
    60	            $formatNames = $event->getFormats()->map(fn ($f) => $f->getNameJp())->toArray();
    61	            $baseInfo = $event->getBaseInfo();
    62	            foreach ($details as $index => $detail) {
    63	                $allDatas[] = [
    64	                    'rowSpan' => $index === 0 ? $rowSpan : null,
    65	                    'eventId' => $event->getId(),
    66	                    'name' => $event->getNameJp().' '.$event->getNameEn(),
    67	                    'shop' => $shop,
    68	                    'formatNames' => $formatNames,
    69	                    'startDate' => $detail->getStartDate(),
    70	                    'eventDetailId' => $detail->getId(),
    71	                    'baseInfo' => $baseInfo,
    72	                    'baseInfoId' => $baseInfo?->getId(),
    73	                ];
    74	            }
    75	        }
    76	
    77	        return $allDatas;
    78	    }
    79	
    80	    /**
    81	     * 日程行をページングし、ページ先頭でイベント単位の rowspan を付け直す
    82	     *
    83	     * @param list<array<string, mixed>> $allScheduleRows
    84	     *
    85	     * @return array{0: PaginationInterface<int, array<string, mixed>>, 1: list<array<string, mixed>>}
    86	     */
    87	    public function paginateWithRowSpanByEvent(PaginatorInterface $paginator, array $allScheduleRows, int $pageNo, int $perPage): array
    88	    {
    89	        $pagination = $paginator->paginate(
    90	            $allScheduleRows,
    91	            $pageNo,
    92	            $perPage
    93	        );
    94	
    95	        $datas = [];
    96	        $pageItems = iterator_to_array($pagination);
    97	        $eventCountsOnPage = [];
    98	        foreach ($pageItems as $item) {
    99	            $eventId = $item['eventId'];
   100	            $eventCountsOnPage[$eventId] = ($eventCountsOnPage[$eventId] ?? 0) + 1;
   101	        }
   102	        $eventFirstSeen = [];
   103	        foreach ($pageItems as $item) {
   104	            $eventId = $item['eventId'];
   105	            $isFirst = !isset($eventFirstSeen[$eventId]);
   106	            $eventFirstSeen[$eventId] = true;
   107	            $datas[] = [
   108	                'rowSpan' => $isFirst ? $eventCountsOnPage[$eventId] : null,
   109	                'eventId' => $item['eventId'],
   110	                'name' => $item['name'],
   111	                'shop' => $item['shop'],
   112	                'formatNames' => $item['formatNames'],
   113	                'startDate' => $item['startDate'],
   114	                'eventDetailId' => $item['eventDetailId'],
   115	                'baseInfo' => $item['baseInfo'],
   116	                'baseInfoId' => $item['baseInfoId'] ?? null,
   117	            ];
   118	        }
   119	
   120	        return [$pagination, $datas];
   121	    }
   122	}

