   303	    #[Route(path: '/%eccube_admin_route%/product/stock/save-pattern', name: 'admin_stock_list_save_pattern', methods: ['POST'])]
   304	    public function savePattern(Request $request): RedirectResponse
   305	    {
   306	        $searchForm = $this->formFactory->createBuilder(SearchStockListType::class)->getForm();
   307	        $searchForm->handleRequest($request);
   308	
   309	        if (!$searchForm->isSubmitted() || !$searchForm->isValid()) {
   310	            $this->addError('admin.common.csrf_invalid', 'admin');
   311	
   312	            return $this->redirectToRoute('admin_stock_list');
   313	        }
   314	
   315	        $viewData = FormUtil::getViewData($searchForm);
   316	
   317	        if (empty($viewData['pattern_name'])) {
   318	            $this->addError('admin.common.save_pattern.error.name_empty', 'admin');
   319	
   320	            return $this->redirectToRoute('admin_stock_list');
   321	        }
   322	
   323	        $baseInfo = $this->getMember()->getBaseInfo();
   324	
   325	        // 同じ名前のパターンがあれば上書き、なければ新規作成
   326	        $searchPattern = $this->dtbSearchPatternRepository->findOneBy([
   327	            'name' => $viewData['pattern_name'],
   328	            'display_key' => self::PATTERN_DISPLAY_KEY,
   329	            'BaseInfo' => $baseInfo,
   330	        ]) ?? new DtbSearchPattern();
   331	
   332	        $dataToStore = $viewData;
   333	        unset($dataToStore['_token']); // トークンは保存しない
   334	
   335	        $searchPattern
   336	            ->setPattern(serialize($dataToStore))
   337	            ->setName($viewData['pattern_name'])
   338	            ->setDisplayKey(self::PATTERN_DISPLAY_KEY)
   339	            ->setBaseInfo($baseInfo);
   340	
   341	        $this->entityManager->persist($searchPattern);
   342	        $this->entityManager->flush();
   343	
   344	        $this->addSuccess('admin.common.save_pattern.success', 'admin');
   345	
   346	        return $this->redirectToRoute('admin_stock_list_pattern', ['patternId' => $searchPattern->getId()]);
   347	    }
