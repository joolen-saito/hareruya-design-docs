   438	                            {# 行1: CSV 出力系ボタン (4-9〜4-11) + 表示件数 (4-12) #}
   439	                            <div class="d-flex flex-wrap align-items-center gap-2 mb-2">
   440	                                {# (4-9) 在庫リコメンドCSV出力 (M04-16) #}
   441	                                <a href="{{ path('admin_stock_list_recommend_csv') }}" class="btn btn-ec-conversion btn-sm">
   442	                                    {{ 'admin.stock.list.recommend_csv'|trans }}
   443	                                </a>
   444	                                {# (4-10) 在庫情報CSV出力 (M04-04) #}
   445	                                <a href="{{ url('admin_stock_list_csv') }}" class="btn btn-ec-conversion btn-sm">
   446	                                    {{ 'admin.stock.list.stock_info_csv'|trans }}
   447	                                </a>
   448	                                {# (4-11) 在庫情報カスタムCSV出力 #}
   449	                                <div class="d-inline-block">
   450	                                    <select id="stock_csv_pulldown" class="form-select form-select-sm">
   451	                                        <option value="">{{ 'admin.stock.list.custom_csv'|trans }}</option>
   452	                                        {% for CsvEx in StockCsvExtensions %}
   453	                                            <option value="{{ url('admin_stock_list_custom_csv', { csvExtensionId: CsvEx.id }) }}">{{ CsvEx.name }}</option>
   454	                                        {% endfor %}
   455	                                        <option value="{{ url('admin_setting_shop_csv_custom', { csvTypeId: constant('Eccube\\Entity\\Master\\CsvType::CSV_TYPE_STOCK') }) }}">{{ 'admin.stock.list.custom_csv_settings'|trans }}</option>
   456	                                    </select>
   457	                                </div>
   458	                                {# (4-12) 表示件数（選択肢: 10件 50件 100件 300件 500件 1000件 2000件 10000件 12000件） #}
   459	                                <div class="ms-auto">
   460	                                    <select id="page_count_pulldown" class="form-select form-select-sm" style="width:auto;">
   461	                                        {% for pageMax in pageMaxis %}
   462	                                            <option value="{{ path('admin_stock_list_page_count', {'page_no': 1, 'page_count': pageMax.name}) }}"
   463	                                                {% if page_count == pageMax.name %}selected=""{% endif %}>
   464	                                                {{ 'admin.common.count'|trans({ '%count%': pageMax.name }) }}
   465	                                            </option>
   466	                                        {% endfor %}
   467	                                    </select>
   468	                                </div>
   469	                            </div>
   470	                            {# 行2: 在庫操作系ボタン (4-4〜4-8) #}
   471	                            {#
   472	                                活性ルール:
   473	                                - 在庫一括編集 (4-4)         : 1件以上選択かつ権限のない店舗が含まれない場合のみ活性
   474	                                - 在庫移動・振替・分割・結合 (4-5〜4-8) : 1件のみ選択で活性（2件以上でグレーアウト）
   475	                            #}
   476	                            <div class="d-flex flex-wrap gap-2">
   477	                                {# (4-4) 在庫一括編集: admin_stock_bulk_approval_new へ直接 POST #}
   478	                                <button type="button" id="bulkEditBtn" class="btn btn-ec-conversion btn-sm" disabled
   479	                                    data-url="{{ path('admin_stock_bulk_approval_new') }}">
   480	                                    {{ 'admin.stock.list.bulk_edit'|trans }}
   481	                                </button>
   482	                                {# (4-5) 在庫移動登録 #}
   483	                                <button type="button" id="stockMoveBtn" class="btn btn-ec-conversion btn-sm" disabled
   484	                                    data-url="{{ url('admin_stock_move_new') }}">
   485	                                    {{ 'admin.stock.list.stock_move'|trans }}
   486	                                </button>
   487	                                {# (4-6) 在庫振替登録 #}
   488	                                <button type="button" id="stockTransferBtn" class="btn btn-ec-conversion btn-sm" disabled
   489	                                    data-url="{{ url('admin_stock_transfer_new') }}">
   490	                                    {{ 'admin.stock.list.stock_transfer'|trans }}
   491	                                </button>
   492	                                {# (4-7) 在庫分割登録: /product/stock/{id}/split/new へ遷移 #}
   493	                                <button type="button" id="stockSplitBtn" class="btn btn-ec-conversion btn-sm" disabled>
   494	                                    {{ 'admin.stock.list.stock_split'|trans }}
   495	                                </button>
   496	                                {# (4-8) 在庫結合登録: /product/stock/{id}/join/new へ遷移 #}
   497	                                <button type="button" id="stockJoinBtn" class="btn btn-ec-conversion btn-sm" disabled>
   498	                                    {{ 'admin.stock.list.stock_join'|trans }}
   499	                                </button>
   500	                            </div>
   501	                        {% endif %}
