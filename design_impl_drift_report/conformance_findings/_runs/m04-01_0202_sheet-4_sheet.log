   505	                    {# ═══ 在庫一覧テーブル (5-x) ═══ #}
   506	                    <div class="card-body p-0">
   507	                        <div class="table-responsive">
   508	                            <table class="table table-sm table-stock-list mb-0">
   509	                                <thead>
   510	                                    {# 商品一覧（/admin/product）と同様: 1行目に「販売数」見出しを colspan で統合 #}
   511	                                    <tr class="table-secondary">
   512	                                        <th class="border-top-0 ps-3 pt-2 pb-2 border-none" colspan="12"></th>
