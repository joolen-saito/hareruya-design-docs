   541	                                        <th class="border-top-0 pt-2 pb-2 col-price">
   542	                                            <div>{{ 'admin.stock.list.col.base_price'|trans }}</div>
   543	                                            <div>{{ 'admin.stock.list.col.sell_price'|trans }}</div>
   544	                                        </th>
   545	                                        {# (5-11)(5-12) 買取価格／原価単価 #}
   546	                                        <th class="border-top-0 pt-2 pb-2 col-price">
   547	                                            <div>{{ 'admin.stock.list.col.buy_price'|trans }}</div>
   548	                                            <div>{{ 'admin.stock.list.col.unit_cost'|trans }}</div>
   549	                                        </th>
   550	                                        {# (5-13)(5-14) 在庫／総原価 #}
   551	                                        <th class="border-top-0 pt-2 pb-2 col-stock">
   552	                                            <div>{{ 'admin.stock.list.col.stock'|trans }}</div>
   553	                                            <div>{{ 'admin.stock.list.col.total_cost'|trans }}</div>
   554	                                        </th>
   555	                                        {# (5-15〜5-20) 販売数: 商品一覧と同一キー（当日〜90日） #}
   556	                                        <th class="border-top-0 pt-2 pb-2 col-sales qty">{{ 'admin.product.today'|trans }}</th>
   557	                                        <th class="border-top-0 pt-2 pb-2 col-sales qty">{{ 'admin.product.yesterday'|trans }}</th>
   558	                                        <th class="border-top-0 pt-2 pb-2 col-sales qty">{{ 'admin.product.3day'|trans }}</th>
   559	                                        <th class="border-top-0 pt-2 pb-2 col-sales qty">{{ 'admin.product.1week'|trans }}</th>
   560	                                        <th class="border-top-0 pt-2 pb-2 col-sales qty">{{ 'admin.product.1month'|trans }}</th>
   561	                                        <th class="border-top-0 pt-2 pb-2 col-sales qty pe-1">{{ 'admin.product.90day'|trans }}</th>
   562	                                        {# (5-21) 3点メニュー #}
   563	                                        <th class="border-top-0 pt-2 pb-2 pe-3 col-menu"></th>
   564	                                    </tr>
   565	                                </thead>
   566	                                <tbody>
   567	                                {% if pagination is not empty %}
   568	                                    {% for Item in pagination %}
   569	                                        <tr>
   570	                                            <td class="ps-3">
   571	                                                <input type="checkbox" class="form-check-input row-check"
   572	                                                    name="productStockIds[]"
   573	                                                    value="{{ Item.id }}"
   574	                                                    data-shop-id="{{ Item.baseInfo.id }}"
   575	                                                    data-zone="{{ Item.stockLocationId }}"
   576	                                                    data-editable="{{ app.user.isEditableShop(Item.baseInfo) ? 'true' : 'false' }}"
   577	                                                    data-stock="{{ Item.stock|default(0) }}"
   578	                                                    aria-label="{{ 'admin.common.select'|trans }}">
   579	                                            </td>
   580	                                            <td class="col-id">{{ Item.ProductClass.Product.id }}</td>
   581	                                            {# (5-3)(5-4) 商品名（リンク） + コード（2行） #}
   582	                                            <td class="col-name">
   583	                                                <a href="{{ url('admin_stock_approval_new', {'productStockId': Item.id}) }}" title="{{ Item.ProductClass.Product.name }}">
   584	                                                    {{ Item.ProductClass.Product.name }}
   585	                                                </a>
   586	                                                <div class="text-muted small">{{ Item.ProductClass.code|default('') }}</div>
   587	                                            </td>
   588	                                            {# (5-5)(5-6) 店舗名 + 在庫区分（2行） #}
   589	                                            <td class="col-shop">
   590	                                                <div>{{ Item.baseInfo.shopName }}</div>
   591	                                                <div class="text-muted small">{{ Item.locationName }}</div>
   592	                                            </td>
   593	                                            <td class="col-lang">{{ Item.ProductClass.Language|default('-') }}</td>
   594	                                            <td class="col-cond">{{ Item.ProductClass.CardCondition|default('-') }}</td>
   595	                                            <td class="col-price">
   596	                                                <div>{{ Item.ProductClass.standardPrice|default(0)|number_format }}</div>
   597	                                                <div>{{ Item.ProductClass.price02|default(0)|number_format }}</div>
   598	                                            </td>
   599	                                            <td class="col-price">
   600	                                                <div>{{ Item.ProductClass.buy_price|default(0)|number_format }}</div>
   601	                                                <div>{{ Item.unitCost|number_format }}</div>
   602	                                            </td>
   603	                                            <td class="col-stock">
   604	                                                <div>{{ Item.stock|default(0)|number_format }}</div>
   605	                                                <div>{{ Item.totalCost|number_format }}</div>
   606	                                            </td>
   607	                                            {# (5-15〜5-20) 期間別販売数: ProductClass.ShopStockUpQuantities から店舗一致レコードを取得 #}
   608	                                            {% set suq = null %}
   609	                                            {% for q in Item.ProductClass.ShopStockUpQuantities %}
   610	                                                {% if q.BaseInfo.id == Item.baseInfo.id %}
   611	                                                    {% set suq = q %}
   612	                                                {% endif %}
   613	                                            {% endfor %}
   614	                                            <td class="col-sales align-middle text-end" nowrap>{{ suq ? suq.stockUpQuantity01|number_format : 0 }}</td>
   615	                                            <td class="col-sales align-middle text-end" nowrap>{{ suq ? suq.stockUpQuantity02|number_format : 0 }}</td>
   616	                                            <td class="col-sales align-middle text-end" nowrap>{{ suq ? suq.stockUpQuantity03|number_format : 0 }}</td>
   617	                                            <td class="col-sales align-middle text-end" nowrap>{{ suq ? suq.stockUpQuantity04|number_format : 0 }}</td>
   618	                                            <td class="col-sales align-middle text-end" nowrap>{{ suq ? suq.stockUpQuantity05|number_format : 0 }}</td>
   619	                                            <td class="col-sales align-middle text-end pe-1" nowrap>{{ suq ? suq.stockUpQuantity06|number_format : 0 }}</td>
   620	                                            {# (5-21) 3点メニュー #}
   621	                                            <td class="col-menu pe-3">
   622	                                                <button type="button"
   623	                                                    class="btn btn-link p-0 text-secondary js-stock-row-menu-btn"
   624	                                                    aria-label="{{ 'admin.common.operation'|trans }}">
   625	                                                    <i class="fa fa-ellipsis-h" aria-hidden="true"></i>
   626	                                                </button>
   627	                                                <ul class="js-stock-row-menu list-unstyled mb-0 py-1 rounded border bg-white shadow-sm"
   628	                                                    style="display:none; position:fixed; z-index:9999; min-width:8rem;">
   629	                                                    {# (5-22) 変動履歴 #}
   630	                                                    <li>
   631	                                                        <a class="dropdown-item" href="{{ url('admin_stock_history') ~ '?product_code=' ~ (Item.ProductClass.code|url_encode) ~ '&base_info_id=' ~ Item.baseInfo.id ~ '&stock_location_id=' ~ Item.stockLocationId }}">
   632	                                                            {{ 'admin.stock.list.menu.stock_history'|trans }}
   633	                                                        </a>
   634	                                                    </li>
   635	                                                    {# (5-23) 価格履歴 #}
   636	                                                    <li>
   637	                                                        <a class="dropdown-item" href="{{ url('admin_product_buy_sale_price_history_search', {'page_no': 1}) ~ '?code=' ~ (Item.ProductClass.code|url_encode) }}">
   638	                                                            {{ 'admin.stock.list.menu.price_history'|trans }}
   639	                                                        </a>
   640	                                                    </li>
   641	                                                </ul>
   642	                                            </td>
   643	                                        </tr>
   644	                                    {% else %}
   645	                                        <tr>
   646	                                            <td colspan="16" class="text-center py-4">{{ 'admin.common.search_no_result'|trans }}</td>
   647	                                        </tr>
   648	                                    {% endfor %}
   649	                                {% else %}
   650	                                    <tr>
   651	                                        <td colspan="16" class="text-center py-4 text-muted">{{ 'admin.stock.list.search_first'|trans }}</td>
   652	                                    </tr>
   653	                                {% endif %}
   654	                                </tbody>
   655	                            </table>
   656	                        </div>
   657	                    </div>
   658	
   659	                    {# (5-24) ページング #}
   660	                    {% if pagination is not empty and pagination.totalItemCount > 0 %}
   661	                        <div class="row justify-content-md-center mt-3 mb-4 pb-4">
   662	                            {% include "@admin/pager.twig" with { 'pages': pagination.paginationData, 'routes': 'admin_stock_list_page' } %}
   663	                        </div>
   664	                    {% endif %}
   665	
   666	                </div>
   667	            </div>
   668	
   669	        </div>
   670	    </div>
   671	</div>
   672	
   673	<script nonce="{{ csp_nonce }}">
   674	    $(function() {
   675	        $('.c-curtain').removeClass('is-active');
   676	        $('.c-mainNavArea').removeClass('is-active');
   677	
   678	        // 検索条件クリア
   679	        $('#clearSearchBtn').on('click', function() {
   680	            $('#searchStockListForm')[0].reset();
   681	            $('#searchStockListForm select.select2-hidden-accessible').trigger('change');
   682	        });
   683	
   684	        // 検索パターン保存
   685	        $('#savePatternBtn').on('click', function() {
   686	            const url = $(this).data('url');
   687	            if (url) {
   688	                $('#searchStockListForm').attr('action', url).submit();
   689	            }
   690	        });
   691	
   692	        // 検索パターン削除
   693	        $('#deletePatternBtn').on('click', function() {
   694	            const url = $(this).data('url');
   695	            if (url) {
   696	                $('#searchStockListForm').attr('action', url).submit();
   697	            }
   698	        });
   699	
   700	        // 3点メニュー: 開閉制御
   701	        let $openMenu = null;
   702	
   703	        $(document).on('click', '.js-stock-row-menu-btn', function(e) {
   704	            e.stopPropagation();
   705	            const $btn = $(this);
   706	            const $menu = $btn.next('.js-stock-row-menu');
   707	            const isOpen = $menu.is(':visible');
   708	
   709	            // 他のメニューをすべて閉じる
   710	            if ($openMenu && $openMenu[0] !== $menu[0]) {
   711	                $openMenu.hide();
   712	            }
   713	
   714	            if (isOpen) {
   715	                $menu.hide();
   716	                $openMenu = null;
   717	            } else {
   718	                const rect = this.getBoundingClientRect();
   719	                // サイズ取得のため一瞬不可視で表示
   720	                $menu.css({ visibility: 'hidden', display: 'block' });
   721	                const menuW = $menu.outerWidth(true);
   722	                $menu.css({
   723	                    visibility: '',
   724	                    display: 'none',
   725	                    top: rect.top + 'px',
   726	                    left: (rect.left - menuW) + 'px'
   727	                }).show();
   728	                $openMenu = $menu;
   729	            }
   730	        });
   731	
   732	        // リンク以外のクリックで閉じる
   733	        $(document).on('click', function(e) {
   734	            if ($openMenu && !$(e.target).is('a') && !$(e.target).closest('.js-stock-row-menu-btn').length) {
   735	                $openMenu.hide();
   736	                $openMenu = null;
   737	            }
   738	        });
   739	
   740	        // 全選択チェックボックス
   741	        $('#checkAll').on('change', function() {
   742	            $('.row-check').prop('checked', $(this).prop('checked'));
   743	            updateActionButtons();
   744	        });
   745	        $(document).on('change', '.row-check', function() {
   746	            const total = $('.row-check').length;
   747	            const checked = $('.row-check:checked').length;
   748	            $('#checkAll').prop('indeterminate', checked > 0 && checked < total);
   749	            $('#checkAll').prop('checked', checked === total);
   750	            updateActionButtons();
   751	        });
   752	
   753	
   754	        function isSameShop() {
   755	            const shopIds = $('.row-check:checked').map(function() {
   756	                return $(this).data('shop-id');
   757	            }).get();
   758	            return new Set(shopIds).size <= 1;
   759	        }
   760	
   761	        function hasUnauthorizedShop() {
   762	            return $('.row-check:checked').filter(function() {
   763	                return $(this).data('editable') !== true;
   764	            }).length > 0;
   765	        }
   766	
   767	        function hasZeroStock() {
   768	            return $('.row-check:checked').filter(function() {
   769	                return parseInt($(this).data('stock'), 10) <= 0;
   770	            }).length > 0;
   771	        }
   772	
   773	        function updateActionButtons() {
   774	            const hasChecked = $('.row-check:checked').length > 0;
   775	            // 全ボタン: 1件以上チェックで活性（詳細条件は押下時にアラートで通知）
   776	            $('#bulkEditBtn, #stockMoveBtn, #stockTransferBtn, #stockSplitBtn, #stockJoinBtn').prop('disabled', !hasChecked);
   777	        }
   778	
   779	        // 表示件数セレクト: 選択値の URL へ遷移
   780	        $('#page_count_pulldown, #stock_csv_pulldown').on('change', function() {
   781	            const targetUrl = $(this).val();
   782	            if (targetUrl) {
   783	                window.location.href = targetUrl;
   784	            }
   785	        });
   786	
   787	        // 在庫一括編集: 権限なし店舗・複数店舗の場合はアラート
   788	        $('#bulkEditBtn').on('click', function() {
   789	            const ids = getCheckedIds();
   790	            if (ids.length === 0) {
   791	                return;
   792	            }
   793	            if (hasUnauthorizedShop()) {
   794	                alert('編集権限を持っていない店舗の在庫が選択されています。\n編集権限のある店舗の在庫のみ選択してください。');
   795	                return;
   796	            }
   797	            if (!isSameShop()) {
   798	                alert('複数の店舗の商品規格が選択されています。\n同一の店舗の在庫のみ選択してください。');
   799	                return;
   800	            }
   801	            const url = $(this).data('url');
   802	            if (!url) {
   803	                return;
   804	            }
   805	            submitBulkApprovalNewPost(url, ids);
   806	        });
   807	
   808	        // 在庫移動登録・振替登録: 権限なし店舗・複数店舗・在庫0の場合はアラート
   809	        $('#stockMoveBtn, #stockTransferBtn').on('click', function() {
   810	            const ids = getCheckedIds();
   811	            if (ids.length === 0) {
   812	                return;
   813	            }
   814	            if (hasUnauthorizedShop()) {
   815	                alert('編集権限を持っていない店舗の在庫が選択されています。\n編集権限のある店舗の在庫のみ選択してください。');
   816	                return;
   817	            }
   818	            if (!isSameShop()) {
   819	                alert('複数の店舗の商品規格が選択されています。\n同一の店舗の在庫のみ選択してください。');
   820	                return;
   821	            }
   822	            if (hasZeroStock()) {
   823	                alert('在庫数が0の在庫が選択されています。\n在庫数が1以上の在庫のみ選択してください。');
   824	                return;
   825	            }
   826	            const url = $(this).data('url');
   827	            if (url) {
   828	                submitIdsToUrl(url, ids);
   829	            }
   830	        });
   831	
