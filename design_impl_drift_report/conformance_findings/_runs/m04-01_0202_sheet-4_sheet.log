    98	    public function index(Request $request, PaginatorInterface $paginator, ?int $page_no = null, ?int $page_count = null): array
    99	    {
   100	        $session = $this->session;
   101	
   102	        $searchForm = $this->formFactory->createBuilder(SearchStockListType::class)->getForm();
   103	
   104	        $pageMaxis = $this->pageMaxRepository->findAll();
   105	        $stockCsvExtensions = $this->csvExtensionRepository->findActiveByCsvTypeId(CsvType::CSV_TYPE_STOCK);
   106	        $pageNo = (int) ($page_no ?? $session->get(self::SESSION_KEY_PAGE_NO, 1));
   107	        $defaultPageCount = (int) $this->eccubeConfig['eccube_default_page_count'];
   108	        $pageCount = (int) $session->get(self::SESSION_KEY_PAGE_COUNT, $defaultPageCount);
   109	        if ($page_count !== null) {
   110	            $normalizedCount = $defaultPageCount;
   111	            foreach ($pageMaxis as $pageMax) {
   112	                if ($page_count === (int) $pageMax->getName()) {
   113	                    $normalizedCount = (int) $pageMax->getName();
   114	                    break;
   115	                }
   116	            }
   117	            $pageCount = $normalizedCount;
   118	            $session->set(self::SESSION_KEY_PAGE_COUNT, $pageCount);
   119	        }
   120	
   121	        $patternId = null;
   122	
   123	        if ($request->isMethod('POST')) {
   124	            $searchForm->handleRequest($request);
   125	
   126	            if (!$searchForm->isSubmitted() || !$searchForm->isValid()) {
   127	                return [
   128	                    'searchForm' => $searchForm->createView(),
   129	                    'pagination' => [],
   130	                    'pageMaxis' => $pageMaxis,
   131	                    'pageNo' => $pageNo,
   132	                    'page_count' => $pageCount,
   133	                    'has_errors' => true,
   134	                    'StockCsvExtensions' => $stockCsvExtensions,
   135	                    'pattern_id' => null,
   136	                ];
   137	            }
   138	
   139	            $pageNo = 1;
   140	            $viewData = FormUtil::getViewData($searchForm);
   141	            $session->set(self::SESSION_KEY_SEARCH, $viewData);
   142	            $session->set(self::SESSION_KEY_PAGE_NO, $pageNo);
   143	            $session->set(self::SESSION_KEY_PAGE_COUNT, $pageCount);
   144	            // 新規検索はパターンIDをリセット
   145	            $patternId = null;
   146	            $session->remove(self::SESSION_KEY_PATTERN_ID);
   147	        } else {
   148	            if ($page_no !== null || $request->query->get('resume')) {
   149	                if ($page_no !== null) {
   150	                    $session->set(self::SESSION_KEY_PAGE_NO, $pageNo);
   151	                } else {
   152	                    $pageNo = (int) $session->get(self::SESSION_KEY_PAGE_NO, 1);
   153	                }
   154	                try {
   155	                    $viewData = $this->withFreshCsrfToken($session->get(self::SESSION_KEY_SEARCH, []));
   156	                    FormUtil::submitAndGetData($searchForm, $viewData);
   157	                } catch (\Throwable) {
   158	                    // セッションデータが旧フォーム構造と不整合の場合はリセットして空検索に戻す
   159	                    $session->remove(self::SESSION_KEY_SEARCH);
   160	                    $session->remove(self::SESSION_KEY_PAGE_NO);
   161	                    $session->remove(self::SESSION_KEY_PATTERN_ID);
   162	
   163	                    return [
   164	                        'searchForm' => $searchForm->createView(),
   165	                        'pagination' => [],
   166	                        'pageMaxis' => $pageMaxis,
   167	                        'pageNo' => 1,
   168	                        'page_count' => $pageCount,
   169	                        'has_errors' => false,
   170	                        'StockCsvExtensions' => $stockCsvExtensions,
   171	                        'pattern_id' => null,
   172	                    ];
   173	                }
   174	                $patternId = $session->get(self::SESSION_KEY_PATTERN_ID);
   175	            } else {
   176	                $session->remove(self::SESSION_KEY_SEARCH);
   177	                $session->remove(self::SESSION_KEY_PAGE_NO);
   178	                $session->remove(self::SESSION_KEY_PATTERN_ID);
   179	
   180	                return [
   181	                    'searchForm' => $searchForm->createView(),
   182	                    'pagination' => [],
   183	                    'pageMaxis' => $pageMaxis,
   184	                    'pageNo' => 1,
   185	                    'page_count' => $pageCount,
   186	                    'has_errors' => false,
   187	                    'StockCsvExtensions' => $stockCsvExtensions,
   188	                    'pattern_id' => null,
   189	                ];
   190	            }
   191	        }
   192	
   193	        $input = StockListSearchInput::fromFormData($searchForm->getData());
   194	        $qb = $this->searchAction->handle($input);
   195	
   196	        $pagination = $paginator->paginate($qb, $pageNo, $pageCount);
   197	
   198	        return [
   199	            'searchForm' => $searchForm->createView(),
   200	            'pagination' => $pagination,
   201	            'pageMaxis' => $pageMaxis,
   202	            'pageNo' => $pageNo,
   203	            'page_count' => $pageCount,
   204	            'has_errors' => false,
   205	            'StockCsvExtensions' => $stockCsvExtensions,
   206	            'pattern_id' => $patternId,
   207	        ];
   208	    }
