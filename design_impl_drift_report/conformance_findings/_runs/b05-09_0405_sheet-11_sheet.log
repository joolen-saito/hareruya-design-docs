namespace Eccube\MessageHandler;

use Doctrine\ORM\EntityManagerInterface;
use Eccube\Dto\Smaregi\Api\Transaction\TransactionDto;
use Eccube\Entity\MessengerJob;
use Eccube\Entity\Order;
use Eccube\Entity\SmaregiTransactionJob;
use Eccube\Entity\SmaregiWebhookEvent;
use Eccube\Message\SmaregiTransactionProcessMessage;
use Eccube\Repository\MessengerJobRepository;
use Eccube\Repository\SmaregiTransactionJobRepository;
use Eccube\Repository\SmaregiWebhookEventRepository;
use Eccube\Service\Smaregi\Api\SmaregiAccessTokenService;
use Eccube\Service\Smaregi\Api\SmaregiMessengerJobContext;
use Eccube\Service\Smaregi\Api\SmaregiTransactionApiClient;
use Eccube\Service\Smaregi\SmaregiMessengerJobProcessingLock;
use Eccube\Service\Smaregi\Webhook\Transaction\Handler\CanceledHandler;
use Eccube\Service\Smaregi\Webhook\Transaction\Handler\CreatedHandler;
use Eccube\Service\Smaregi\Webhook\Transaction\Handler\DisposedHandler;
use Eccube\Service\Smaregi\Webhook\Transaction\Handler\Pattern\EccubeOtcPatternHandler;
use Eccube\Service\Smaregi\Webhook\Transaction\Handler\Pattern\EccubeSmoothOtcPatternHandler;
use Eccube\Service\Smaregi\Webhook\Transaction\Handler\Pattern\OtcGuestPatternHandler;
use Eccube\Service\Smaregi\Webhook\Transaction\Handler\Pattern\OtcMemberPatternHandler;
use Eccube\Service\Smaregi\Webhook\Transaction\Processor\SmaregiTransactionCanceledProcessor;
use Eccube\Service\Smaregi\Webhook\Transaction\Processor\SmaregiTransactionDisposedProcessor;
use Eccube\Service\Smaregi\Webhook\Transaction\PurchasePattern;
use Eccube\Service\Smaregi\Webhook\Transaction\PurchasePatternContext;
use Eccube\Service\Smaregi\Webhook\Transaction\PurchasePatternContextBuilder;
use Eccube\Service\Smaregi\Webhook\Transaction\PurchasePatternResolver;
use Eccube\Service\Smaregi\Webhook\Transaction\SmaregiOrderPointApplier;
use Eccube\Service\Smaregi\Webhook\Transaction\SmaregiPointAdjustmentApplier;
use Eccube\Service\Smaregi\Webhook\Transaction\SmaregiPointAdjustmentReverter;
use Psr\Log\LoggerInterface;
use Symfony\Component\Messenger\Attribute\AsMessageHandler;

/**
 * スマレジ取引取得 + action 別処理を 1 子ジョブとして消化する MessageHandler。
 *
 * 親ジョブ ({@see SmaregiWebhookEventMessageHandler}) は SmaregiWebhookEvent 単位での
 * 受信状態を管理し、本ハンドラは transactionHeadId 単位の処理状態を MessengerJob として管理する。
 *
 * 主な責務:
 *  1. 子 MessengerJob を {@see SmaregiMessengerJobProcessingLock} で悲観ロック + 状態遷移
 *     (PENDING/FAILED → PROCESSING、COMPLETED は skip)
 *  2. スマレジ取引取得 API 呼出
 *  3. updateDateTime ベースの dedup ({@see SmaregiTransactionJobRepository::findLatestCompletedByTransaction()})
 *     により、同一 (transactionHeadId, action) で過去に完了した updateDateTime 以下のリクエストを skip
 *  4. action ('created' / 'canceled' / 'disposed') 別に Pattern Handler / Processor を実行
 *  5. 処理結果を {@see SmaregiTransactionJob} に保存 (updateDateTime と共に)
 *
 * TODO: edited / bulk-* も同パターンで子ジョブ化する
 * TODO: webhook 到着順序が逆転して対応 Order が無い canceled/disposed の救済
 */
#[AsMessageHandler]
final readonly class SmaregiTransactionProcessMessageHandler
{
    public function __construct(
        private LoggerInterface $logger,
        private EntityManagerInterface $entityManager,
        private SmaregiMessengerJobProcessingLock $smaregiMessengerJobProcessingLock,
        private MessengerJobRepository $messengerJobRepository,
        private SmaregiWebhookEventRepository $smaregiWebhookEventRepository,
        private SmaregiTransactionJobRepository $smaregiTransactionJobRepository,
        private SmaregiMessengerJobContext $smaregiMessengerJobContext,
        private SmaregiAccessTokenService $accessTokenService,
        private SmaregiTransactionApiClient $transactionApiClient,
        private PurchasePatternContextBuilder $contextBuilder,
        private PurchasePatternResolver $patternResolver,
        private OtcGuestPatternHandler $otcGuestPatternHandler,
        private OtcMemberPatternHandler $otcMemberPatternHandler,
        private EccubeSmoothOtcPatternHandler $eccubeSmoothOtcPatternHandler,
        private EccubeOtcPatternHandler $eccubeOtcPatternHandler,
        private SmaregiOrderPointApplier $pointApplier,
        private SmaregiPointAdjustmentApplier $pointAdjustmentApplier,
        private SmaregiPointAdjustmentReverter $pointAdjustmentReverter,
        private SmaregiTransactionCanceledProcessor $canceledProcessor,
        private SmaregiTransactionDisposedProcessor $disposedProcessor,
        private string $smaregiApiIdUrl,
        private string $smaregiApiUrl,
        private string $smaregiApiClientId,
        private string $smaregiApiClientSecret,
        private string $smaregiApiContractId,
    ) {
    }

    public function __invoke(SmaregiTransactionProcessMessage $message): void
    {
        $Job = $this->messengerJobRepository->find($message->getJobId());
        if (!$Job instanceof MessengerJob) {
            $this->logger->error('Smaregi transaction process job not found', [
                'jobId' => $message->getJobId(),
            ]);

            return;
        }

        // スマレジ API 呼び出しログを当該子ジョブに紐付けるため、コンテキストへ jobId を設定する。
        // ({@see \Eccube\Service\Smaregi\Api\SmaregiPlatformApiCallRecorder} は本 ID を見て記録の可否を判断する)
        $this->smaregiMessengerJobContext->setJobId((int) $Job->getId());

        try {
            // 悲観ロック + PENDING/FAILED のときのみ PROCESSING へ遷移し、重複実行を抑止する。
            if (!$this->smaregiMessengerJobProcessingLock->tryBeginProcessingJob($Job)) {
                return;
            }

            $Event = $this->smaregiWebhookEventRepository->find($message->getSmaregiWebhookEventId());
            if (!$Event instanceof SmaregiWebhookEvent) {
                throw new \RuntimeException(sprintf('Smaregi webhook event not found (webhookEventId=%d)', $message->getSmaregiWebhookEventId()));
            }

            $this->processTransaction($Job, $Event, $message->getAction(), $message->getTransactionHeadId());

            $Job->setStatus(MessengerJob::STATUS_COMPLETED);
            $Job->setCompletedAt(new \DateTime());
            $Job->setErrorMessage(null);
            $this->entityManager->flush();
        } catch (\Throwable $e) {
            $this->logger->warning('Smaregi transaction process job failed', [
                'jobId' => $Job->getId(),
                'webhookEventId' => $message->getSmaregiWebhookEventId(),
                'action' => $message->getAction(),
                'transactionHeadId' => $message->getTransactionHeadId(),
                'error' => $e->getMessage(),
            ]);
            $this->failJob($Job, $e);

            throw $e;
        } finally {
            $this->smaregiMessengerJobContext->clear();
        }
    }

    private function processTransaction(MessengerJob $Job, SmaregiWebhookEvent $event, string $action, string $transactionHeadId): void
    {
        $accessToken = $this->accessTokenService->getAccessToken(
            $this->smaregiApiIdUrl,
            $this->smaregiApiContractId,
            $this->smaregiApiClientId,
            $this->smaregiApiClientSecret,
        );

        $response = $this->transactionApiClient->getTransaction(
            $this->smaregiApiUrl,
            $this->smaregiApiContractId,
            $accessToken,
            $transactionHeadId,
        );

        $transaction = $response['dto'] ?? null;
        if ($transaction === null) {
            throw new \RuntimeException(sprintf('Failed to fetch Smaregi transaction (transactionHeadId=%s, statusCode=%d)', $transactionHeadId, $response['statusCode']));
        }

        $updateDateTime = $transaction->updateDateTime;

        if ($this->isStaleUpdate($transactionHeadId, $action, $updateDateTime)) {
            $this->logger->info('Skip Smaregi transaction: stale updateDateTime (already processed)', [
                'jobId' => $Job->getId(),
                'webhookEventId' => $event->getId(),
                'action' => $action,
                'transactionHeadId' => $transactionHeadId,
                'updateDateTime' => $updateDateTime,
            ]);
            $this->upsertTransactionJobRecord($Job, $transactionHeadId, $action, $updateDateTime);

            return;
        }

        $this->dispatchByAction($event, $action, $transaction);
        $this->upsertTransactionJobRecord($Job, $transactionHeadId, $action, $updateDateTime);
    }

    private function isStaleUpdate(string $transactionHeadId, string $action, ?string $incomingUpdateDateTime): bool
    {
        if ($incomingUpdateDateTime === null || $incomingUpdateDateTime === '') {
            return false;
        }
        $latest = $this->smaregiTransactionJobRepository->findLatestCompletedByTransaction($transactionHeadId, $action);
        if ($latest === null) {
            return false;
        }
        $stored = $latest->getTransactionUpdateDateTime();
        if ($stored === null || $stored === '') {
            return false;
        }

        return $stored >= $incomingUpdateDateTime;
    }

    private function dispatchByAction(SmaregiWebhookEvent $event, string $action, TransactionDto $transaction): void
    {
        match ($action) {
            CreatedHandler::ACTION => $this->processCreated($event, $transaction),
            CanceledHandler::ACTION => $this->processCanceled($event, $transaction),
            DisposedHandler::ACTION => $this->processDisposed($event, $transaction),
            default => $this->logger->warning('Smaregi transaction action not yet handled in child job', [
                'webhookEventId' => $event->getId(),
                'action' => $action,
                'transactionHeadId' => $transaction->transactionHeadId,
            ]),
        };
    }

    /**
     * 取消(canceled)。ポイント専用取引(区分6/7)は受注が無いためポイントを差し戻し、
     * それ以外は従来どおり受注の取消処理を行う。
     */
    private function processCanceled(SmaregiWebhookEvent $event, TransactionDto $transaction): void
    {
        if ($transaction->isCanceled() && $this->pointAdjustmentReverter->revert($transaction->transactionHeadId)) {
            return;
        }

        $this->canceledProcessor->process($event, $transaction);
    }

    /**
     * 打消(disposed)。打消元(disposeServerTransactionHeadId)がポイント専用取引なら差し戻し、
     * それ以外は従来どおり受注の取消処理を行う。
     */
    private function processDisposed(SmaregiWebhookEvent $event, TransactionDto $transaction): void
    {
        if ($transaction->isDisposed() && $this->pointAdjustmentReverter->revert($transaction->disposeServerTransactionHeadId)) {
            return;
        }

        $this->disposedProcessor->process($event, $transaction);
    }

    private function processCreated(SmaregiWebhookEvent $event, TransactionDto $transaction): void
    {
        // 取引区分6/7 (ポイント加算/減算) は商品明細を持たないポイント専用取引のため、
        // 受注作成パターンには乗せず会員ポイントのみを増減する。
        if ($this->pointAdjustmentApplier->supports($transaction)) {
            if ($transaction->isCanceled() || $transaction->isDisposed()) {
                $this->logger->info('Smaregi point-only transaction is canceled/disposed, skipping point apply', [
                    'webhookEventId' => $event->getId(),
                    'transactionHeadId' => $transaction->transactionHeadId,
                    'division' => $transaction->transactionHeadDivision,
                    'cancelDivision' => $transaction->cancelDivision,
                    'disposeDivision' => $transaction->disposeDivision,
                ]);

                return;
            }

            $this->logger->info('Smaregi transaction is point-only (division 6/7), applying point adjustment', [
                'webhookEventId' => $event->getId(),
                'transactionHeadId' => $transaction->transactionHeadId,
                'division' => $transaction->transactionHeadDivision,
            ]);
            $this->pointAdjustmentApplier->apply($transaction);

            return;
        }

        $context = $this->contextBuilder->build($transaction);
        $pattern = $this->patternResolver->resolve($context);

        $this->logger->info('Smaregi transaction pattern resolved', [
            'webhookEventId' => $event->getId(),
            'action' => CreatedHandler::ACTION,
            'transactionHeadId' => $transaction->transactionHeadId,
            'pattern' => $pattern->name,
            'patternNumber' => $pattern->value,
        ]);

        $this->dispatchByPattern($event, $transaction, $pattern, $context);
    }

    private function dispatchByPattern(
        SmaregiWebhookEvent $event,
        TransactionDto $transaction,
        PurchasePattern $pattern,
        PurchasePatternContext $context,
    ): void {
        $pointBearingOrder = match ($pattern) {
            PurchasePattern::ECCUBE_SMOOTH_OTC => $this->handleSmoothOtc($transaction, $context),
            // Pattern 2/3 (店頭受取) と Pattern 4-7 (店頭PC購入) は連携方法が同一:
            // 既存受注を引き渡し済みにし、取引明細から新規受注を作成する。
            // 店頭PC購入注文も配送方法=店頭受取で登録されるため突合・複製ロジックは共通で、
            // 会員(4/5)・非会員(6/7)の差は member 引数 (非会員は null → guest として作成) で吸収する。
            PurchasePattern::ECCUBE_OTC,
            PurchasePattern::ECCUBE_OTC_WITH_ADD_ON,
            PurchasePattern::OTC_PC_MEMBER,
            PurchasePattern::OTC_PC_MEMBER_WITH_ADD_ON,
            PurchasePattern::OTC_PC_GUEST,
            PurchasePattern::OTC_PC_GUEST_WITH_ADD_ON => $this->handleEccubeOtc($transaction, $context),
            PurchasePattern::OTC_MEMBER => $this->handleOtcMember($event, $transaction, $context),
            PurchasePattern::OTC_GUEST => $this->handleOtcGuest($transaction),
        };

        // 会員が購入した受注のポイント (付与/使用) を EC 会員残高へ反映する。
        // 非会員受注や取引IDが無い場合は applier 側で skip される。
        if ($pointBearingOrder !== null) {
            $this->pointApplier->apply($pointBearingOrder, $transaction);
        }
    }

    /**
     * Pattern 1: 既存オンライン受注を引渡し済みにする。ポイント付与対象は既存オンライン受注。
     */
    private function handleSmoothOtc(TransactionDto $transaction, PurchasePatternContext $context): ?Order
    {
        $orders = $this->eccubeSmoothOtcPatternHandler->handle($transaction, $context->matchedOrders);

        // Pattern 1 は構造上 1 注文 = 1 スマレジ商品のため先頭の既存受注を付与対象とする。
        return $orders[0] ?? null;
    }

    /**
     * Pattern 2-7: 既存受注を引渡し済みにし新規受注を作成する。ポイント付与対象は新規受注 (戻り値の末尾)。
     */
    private function handleEccubeOtc(TransactionDto $transaction, PurchasePatternContext $context): ?Order
    {
        $orders = $this->eccubeOtcPatternHandler->handle(
            $transaction,
            $context->matchedOrders,
            $context->matchedSmaregiCodes,
            $context->member,
        );

        return $orders === [] ? null : $orders[array_key_last($orders)];
    }

    private function handleOtcGuest(TransactionDto $transaction): null
    {
        $this->otcGuestPatternHandler->handle($transaction);

        // 非会員はポイント対象外。
        return null;
    }

    private function handleOtcMember(
        SmaregiWebhookEvent $event,
        TransactionDto $transaction,
        PurchasePatternContext $context,
    ): ?Order {
        $member = $context->member;
        if ($member === null) {
            // 解決済み Player が無い場合は guest 扱いに fallback して取り込み漏れを防ぐ。
            $this->logger->warning('Smaregi OTC_MEMBER pattern resolved but member is null, falling back to guest creation', [
                'webhookEventId' => $event->getId(),
                'transactionHeadId' => $transaction->transactionHeadId,
            ]);
            $this->otcGuestPatternHandler->handle($transaction);

            // guest fallback はポイント対象外。
            return null;
        }

        return $this->otcMemberPatternHandler->handle($transaction, $member);
    }

    /**
     * 1 子ジョブ = 1 SmaregiTransactionJob となるよう upsert する。
     * 既存行があれば updateDateTime のみ更新し、無ければ新規作成。
     */
    private function upsertTransactionJobRecord(MessengerJob $Job, string $transactionHeadId, string $action, ?string $updateDateTime): void
    {
        $jobId = $Job->getId();
        if ($jobId === null) {
            return;
        }
        $TransactionJob = $this->smaregiTransactionJobRepository->findByMessengerJobId($jobId);
        if ($TransactionJob === null) {
            $TransactionJob = new SmaregiTransactionJob();
            $TransactionJob->setMessengerJobId($jobId);
            $TransactionJob->setTransactionHeadId($transactionHeadId);
            $TransactionJob->setAction($action);
            $this->entityManager->persist($TransactionJob);
        }
        $TransactionJob->setTransactionUpdateDateTime($updateDateTime);
    }

    private function failJob(MessengerJob $Job, \Throwable $e): void
    {
        try {
            $Job->setStatus(MessengerJob::STATUS_FAILED);
            $Job->setCompletedAt(new \DateTime());
            $Job->setErrorMessage($this->truncateErrorMessage($e->getMessage()));
            $this->entityManager->flush();
        } catch (\Throwable $persistError) {
            $this->logger->error('Failed to persist Smaregi transaction process job failure state', [
                'jobId' => $Job->getId(),
                'error' => $persistError->getMessage(),
            ]);
        }
    }

    private function truncateErrorMessage(string $message): string
    {
        // dtb_messenger_job.error_message は TEXT だが、巨大な stack trace でログ膨張するのを避ける
        if (strlen($message) <= 2000) {
            return $message;
        }

        return substr($message, 0, 2000).'... (truncated)';
    }
}

