    34	    /**
    35	     * @param array<int> $stockChangeTypeIds
    36	     */
    37	    public function getQueryBuilderByStockChangeTypeIds(array $stockChangeTypeIds): QueryBuilder
    38	    {
    39	        return $this->createQueryBuilder('d')
    40	            ->innerJoin('d.StockChangeType', 't')
    41	            ->where('t.id IN (:ids)')
    42	            ->setParameter('ids', $stockChangeTypeIds)
    43	            ->orderBy('d.id', 'ASC');
    44	    }
    45	
    46	    public function get(int $id = 1): ?MtbStockChangeTypeDetail
    47	    {
    48	        return $this->find($id);
    49	    }
