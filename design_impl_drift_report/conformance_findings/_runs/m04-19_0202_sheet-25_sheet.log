    36	class StockMoveOutboundApprovalApproveAction
    37	{
    38	    public function __construct(
    39	        private readonly EntityManagerInterface $entityManager,
    40	        private readonly MtbStockMoveTransferStatusRepository $stockMoveTransferStatusRepository,
    41	        private readonly StockMoveTransferEntityManager $stockMoveTransferEntityManager,
    42	        private readonly DtbStockMoveTransferDetailRepository $stockMoveTransferDetailRepository,
    43	        private readonly ProductStockEntityManager $productStockEntityManager,
    44	        private readonly StockHistoryEntityManager $stockHistoryEntityManager,
    45	        private readonly MtbStockChangeTypeDetailRepository $stockChangeTypeDetailRepository,
    46	        private readonly MtbStockHistorySourceTypeRepository $stockHistorySourceTypeRepository,
    47	        private readonly DtbStockApprovalListRepository $dtbStockApprovalListRepository,
    48	    ) {
    49	    }
    50	
    51	    public function handle(StockMoveOutboundApprovalApproveInput $input): void
    52	    {
    53	        $StockMoveTransfer = $input->StockMoveTransfer;
    54	        $Member = $input->Member;
    55	
    56	        $StockMoveTransferDetails = $this->stockMoveTransferDetailRepository->findBy(
    57	            ['StockMoveTransfer' => $StockMoveTransfer],
    58	            ['id' => 'ASC']
    59	        );
    60	
    61	        foreach ($StockMoveTransferDetails as $StockMoveTransferDetail) {
    62	            if ($StockMoveTransferDetail->getStockoutQuantity() <= 0) {
    63	                continue;
    64	            }
    65	
    66	            // 欠品登録を行う場合、欠品分の在庫を一度戻してから欠品分減らし、在庫変動履歴を登録する
    67	            $this->registerShortageWithReturnAndReduce($StockMoveTransferDetail, $StockMoveTransfer, $Member);
    68	        }
    69	
    70	        $Status = $this->stockMoveTransferStatusRepository->find(MtbStockMoveTransferStatus::STATUS_OUTBOUND_APPROVED);
    71	
    72	        // 移動振替ステータスと移動振替メモを更新
    73	        $this->stockMoveTransferEntityManager->save(
    74	            StockMoveTransfer: $StockMoveTransfer,
    75	            MoveTransferStatus: $Status,
    76	            MoveFromBaseInfo: $StockMoveTransfer->getMoveFromBaseInfo(),
    77	            MoveToBaseInfo: $StockMoveTransfer->getMoveToBaseInfo(),
    78	            moveFromStockLocationId: $StockMoveTransfer->getMoveFromStockLocationId(),
    79	            moveToStockLocationId: $StockMoveTransfer->getMoveToStockLocationId(),
    80	            memo: $input->memo,
    81	            RegisteredMember: $StockMoveTransfer->getRegisteredMember(),
    82	            UpdatedMember: $Member,
    83	            MoveFromApprovalMember: $Member,
    84	            MoveFromApprovalAt: new \DateTime(),
    85	        );
    86	
    87	        // 在庫承認一覧の該当レコードを取得し、承認ステータスを承認済に更新
    88	        $StockApprovalList = $this->dtbStockApprovalListRepository->findOneBy([
    89	            'historySourceId' => $StockMoveTransfer->getId(),
    90	            'HistorySourceType' => $this->stockHistorySourceTypeRepository->find(MtbStockHistorySourceType::STOCK_MOVE_EDIT),
    91	            'StockTransferTypeDetail' => $this->stockChangeTypeDetailRepository->find(MtbStockChangeTypeDetail::MOVE_OUTBOUND),
    92	        ]);
    93	        if ($StockApprovalList === null) {
    94	            throw new \RuntimeException('在庫承認一覧の該当レコードが見つかりません。');
    95	        }
    96	
    97	        $StockApprovalList->setApprovedDate(new \DateTime());
    98	        $StockApprovalList->setApprovalMember($Member);
    99	        $StockApprovalList->setApprovalStatus(DtbStockApprovalList::APPROVAL_STATUS_APPROVED);
   100	
   101	        $this->entityManager->flush();
   102	    }
   103	
   104	    /**
   105	     * 欠品分の在庫を一度戻し、欠品分減らし、在庫変動履歴を登録する
   106	     *
   107	     * @param DtbStockMoveTransferDetail $StockMoveTransferDetail
   108	     * @param DtbStockMoveTransfer $StockMoveTransfer
   109	     * @param Member $Member
   110	     *
   111	     * @return void
   112	     */
   113	    private function registerShortageWithReturnAndReduce(
   114	        DtbStockMoveTransferDetail $StockMoveTransferDetail,
   115	        DtbStockMoveTransfer $StockMoveTransfer,
   116	        Member $Member,
   117	    ): void {
   118	        // 出庫元在庫情報
   119	        $MoveFromProductStock = $StockMoveTransferDetail->getMoveFromProductStock();
   120	        $moveQuantity = (string) $StockMoveTransferDetail->getMoveTransferQuantity();
   121	        $stockoutQuantity = (string) $StockMoveTransferDetail->getStockoutQuantity();
   122	        $outboundTotalCost = $StockMoveTransferDetail->getOutboundTotalCost();
   123	        $ProductClass = $MoveFromProductStock->getProductClass();
   124	
   125	        // 現在の在庫情報
   126	        $currentStock = $MoveFromProductStock->getStock() ?? '0';
   127	        $currentTotalCost = $MoveFromProductStock->getTotalCost();
   128	        $currentUnitCost = $MoveFromProductStock->getUnitCost();
   129	
   130	        // 欠品分の在庫戻し
   131	        $unitCost = bcdiv($outboundTotalCost, $moveQuantity, 8);
   132	        $returnTotalCost = bcround(bcmul($unitCost, $stockoutQuantity, 8), 0);
   133	        $stockAfterReturn = $MoveFromProductStock->getStockQuantityAfterChange($stockoutQuantity);
   134	        $totalCostAfterReturn = bcadd($currentTotalCost, $returnTotalCost, 0);
   135	
   136	        $this->productStockEntityManager->save(
   137	            ProductStock: $MoveFromProductStock,
   138	            ProductClass: $ProductClass,
   139	            BaseInfo: $MoveFromProductStock->getBaseInfo(),
   140	            stock: $stockAfterReturn,
   141	            pickUpFlg: $MoveFromProductStock->getPickUpFlg(),
   142	            stockLocationId: $MoveFromProductStock->getStockLocationId(),
   143	            totalCost: $totalCostAfterReturn,
   144	        );
   145	
   146	        $this->stockHistoryEntityManager->save(
   147	            ProductStock: $MoveFromProductStock,
   148	            StockChangeTypeDetail: $this->stockChangeTypeDetailRepository->find(MtbStockChangeTypeDetail::MOVE_SHORTAGE_ADD),
   149	            oldStock: $currentStock,
   150	            stock: $stockAfterReturn,
   151	            stockChangeQuantity: $stockoutQuantity,
   152	            sellPrice: $ProductClass->getPrice02(),
   153	            unitCostPriceBefore: $currentUnitCost,
   154	            unitCostPriceAfter: $unitCost,
   155	            totalCostPriceBefore: $currentTotalCost,
   156	            totalCostPriceAfter: $totalCostAfterReturn,
   157	            stockChangeReason: '欠品による加算 在庫移動振替ID：'.$StockMoveTransfer->getId(),
   158	            shortageReason: null,
   159	            HistorySourceType: $this->stockHistorySourceTypeRepository->find(MtbStockHistorySourceType::STOCK_MOVE_EDIT),
   160	            historySourceId: $StockMoveTransfer->getId(),
   161	            registeredAt: new \DateTime(),
   162	            RegisteredMember: $Member,
   163	            operatorMemberName: $Member->getName(),
   164	        );
   165	
   166	        // 欠品分の在庫減算
   167	        $stockAfterShortage = $MoveFromProductStock->getStockQuantityAfterChange(bcmul($stockoutQuantity, '-1', 0));
   168	        $totalCostAfterShortage = bcsub($totalCostAfterReturn, $returnTotalCost, 0);
   169	
   170	        $this->productStockEntityManager->save(
   171	            ProductStock: $MoveFromProductStock,
   172	            ProductClass: $ProductClass,
   173	            BaseInfo: $MoveFromProductStock->getBaseInfo(),
   174	            stock: $stockAfterShortage,
   175	            pickUpFlg: $MoveFromProductStock->getPickUpFlg(),
   176	            stockLocationId: $MoveFromProductStock->getStockLocationId(),
   177	            totalCost: $totalCostAfterShortage,
   178	        );
   179	
   180	        $shortageUnitCost = bcround(bcdiv($returnTotalCost, $stockoutQuantity, 8), 0);
   181	
   182	        $this->stockHistoryEntityManager->save(
   183	            ProductStock: $MoveFromProductStock,
   184	            StockChangeTypeDetail: $this->stockChangeTypeDetailRepository->find(MtbStockChangeTypeDetail::MOVE_SHORTAGE_SUBTRACT),
   185	            oldStock: $stockAfterReturn,
   186	            stock: $stockAfterShortage,
   187	            stockChangeQuantity: bcmul($stockoutQuantity, '-1', 0),
   188	            sellPrice: $ProductClass->getPrice02(),
   189	            unitCostPriceBefore: $shortageUnitCost,
   190	            unitCostPriceAfter: $shortageUnitCost,
   191	            totalCostPriceBefore: $totalCostAfterReturn,
   192	            totalCostPriceAfter: $totalCostAfterShortage,
   193	            stockChangeReason: '欠品による減算 在庫移動振替ID：'.$StockMoveTransfer->getId(),
   194	            shortageReason: null,
   195	            HistorySourceType: $this->stockHistorySourceTypeRepository->find(MtbStockHistorySourceType::STOCK_MOVE_EDIT),
   196	            historySourceId: $StockMoveTransfer->getId(),
   197	            registeredAt: new \DateTime(),
   198	            RegisteredMember: $Member,
   199	            operatorMemberName: $Member->getName(),
   200	        );
   201	    }
   202	}

