   364	    /**
   365	     * 受注編集後の注文明細に記録されている単価（マスタの販売価格ではない）を返す.
   366	     */
   367	    private function resolveOrderEditOrderItemUnitPriceInt(Order $order, int $productClassId): int
   368	    {
   369	        foreach ($order->getItems() as $Item) {
   370	            if ($Item->isProduct() && $Item->getProductClass()?->getId() === $productClassId) {
   371	                return (int) ($Item->getPrice() ?? 0);
   372	            }
   373	        }
   374	
   375	        return 0;
   376	    }
