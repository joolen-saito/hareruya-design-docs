   131	                    headers: {
   132	                        'X-Requested-With': 'XMLHttpRequest',
   133	                    },
   134	                }).done(function(response) {
   135	                    if (response.success) {
   136	                        const displayText = response.stock_change_reason_display || pendingReason;
   137	                        const savedReason = response.stock_change_reason || pendingReason;
   138	                        $reasonDisplay.html(renderReasonTextAsHtml(displayText));
   139	                        $reasonTextarea.val(savedReason);
   140	                        $reasonEditContainer.data('original-display-html', $reasonDisplay.html());
   141	                        $reasonEditContainer.data('original-textarea-val', savedReason);
   142	                        $('#stockHistoryList .card-body').find('.js-stock-change-history-alert').remove();
   143	                    } else {
   144	                        restoreReasonEditSnapshot($reasonEditContainer, $reasonDisplay, $reasonTextarea);
   145	                        showStockHistoryReasonAlert(response.message || saveErrorMsg, true);
   146	                    }
   147	                }).fail(function(xhr) {
   148	                    restoreReasonEditSnapshot($reasonEditContainer, $reasonDisplay, $reasonTextarea);
   149	                    let message = saveErrorMsg;
   150	                    if (xhr.responseJSON && xhr.responseJSON.message) {
   151	                        message = xhr.responseJSON.message;
   152	                    }
   153	                    showStockHistoryReasonAlert(message, true);
   154	                }).always(function() {
   155	                    $reasonEditContainer.removeClass('is-saving');
   156	                    setReasonEditToggleLoading($toggle, false);
   157	                });
   158	            });
   159	        });
   160	        const select2Ids = [
   161	            '#admin_stock_history_base_info',
   162	            '#admin_stock_history_stock_change_type_detail',
   163	            '#admin_stock_history_category_id',
   164	            '#admin_stock_history_cardset',
   165	            '#admin_stock_history_create_source',
   166	            '#admin_stock_history_create_department',
   167	            '#admin_stock_history_create_notification_target_members',
   168	            '#admin_stock_history_approval_department',
   169	            '#admin_stock_history_approval_notification_target_members',
   170	            '#admin_stock_history_update_department',
   171	            '#admin_stock_history_update_notification_target_members',
   172	        ];
   173	        const select2Selector = $(select2Ids.join(','));
   174	        select2Selector.select2({width:'100%'});
   175	    </script>
   176	{% endblock javascript %}
