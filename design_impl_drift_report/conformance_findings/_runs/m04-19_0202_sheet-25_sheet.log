   296	        // create_source_id 登録元ID
   297	        if (isset($searchData['create_source_id']) && StringUtil::isNotBlank($searchData['create_source_id'])) {
   298	            $qb
   299	                ->andWhere('sh.historySourceId = :create_source_id')
   300	                ->setParameter('create_source_id', $searchData['create_source_id']);
   301	        }
   302	
   303	        // create_notification_target_members 登録者
   304	        if (isset($searchData['create_notification_target_members']) && StringUtil::isNotBlank($searchData['create_notification_target_members'])) {
   305	            $qb
   306	                ->andWhere($qb->expr()->in('sh.RegisteredMember', ':create_notification_target_members'))
   307	                ->setParameter('create_notification_target_members', $searchData['create_notification_target_members']);
   308	        }
   309	
   310	        // update_notification_target_members 最終更新者
   311	        if (isset($searchData['update_notification_target_members']) && StringUtil::isNotBlank($searchData['update_notification_target_members'])) {
   312	            $qb
   313	                ->andWhere($qb->expr()->in('sh.UpdateMember', ':update_notification_target_members'))
   314	                ->setParameter('update_notification_target_members', $searchData['update_notification_target_members']);
   315	        }
   316	
   317	        // update_date_to 最終更新日
   318	        if (isset($searchData['update_date_to']) && StringUtil::isNotBlank($searchData['update_date_to'])) {
   319	            $date = $searchData['update_date_to']->format('Y-m-d 23:59:59');
   320	            $qb
   321	                ->andWhere('sh.updateDate < :update_date_to')
   322	                ->setParameter('update_date_to', $date);
   323	        }
   324	
   325	        // stock_change_reason 在庫変動理由・欠品理由
   326	        if (isset($searchData['stock_change_reason']) && StringUtil::isNotBlank($searchData['stock_change_reason'])) {
   327	            $qb
   328	                ->andWhere('sh.stockChangeReason LIKE :likeStockChangeReason')
   329	                ->setParameter('likeStockChangeReason', '%'.str_replace(['%', '_'], ['\\%', '\\_'], $searchData['stock_change_reason']).'%');
   330	        }
   331	
   332	        // Order By
   333	        $qb->addOrderBy('pc.code', 'DESC');
   334	        $qb->addOrderBy('ps.baseInfo', 'DESC');
   335	        $qb->addOrderBy('sh.createDate', 'DESC');
   336	
   337	        return $qb;
   338	    }
   339	
   340	    /**
   341	     * 指定した在庫の最新履歴を取得する.
   342	     *
   343	     * 承認日時があるものは承認日時、ないものは登録日時を基準に降順で最大 $limit 件.
   344	     *
   345	     * @return list<DtbStockHistory>
   346	     */
   347	    public function findLatestByProductStockId(int $productStockId, int $limit = 30): array
   348	    {
   349	        $qb = $this->createQueryBuilder('sh')
   350	            ->addSelect('sctd', 'sct', 'hst', 'rm', 'am')
   351	            ->innerJoin('sh.StockChangeTypeDetail', 'sctd')
   352	            ->innerJoin('sctd.StockChangeType', 'sct')
   353	            ->leftJoin('sh.HistorySourceType', 'hst')
   354	            ->leftJoin('sh.RegisteredMember', 'rm')
   355	            ->leftJoin('sh.ApprovalMember', 'am')
   356	            ->andWhere('sh.ProductStock = :productStockId')
   357	            ->setParameter('productStockId', $productStockId)
   358	            ->addSelect('COALESCE(sh.approvalAt, sh.registeredAt, sh.createDate) AS HIDDEN sortDate')
   359	            ->orderBy('sortDate', 'DESC')
   360	            ->addOrderBy('sh.registeredAt', 'DESC')
   361	            ->setMaxResults($limit);
   362	
   363	        return $qb->getQuery()->getResult();
   364	    }
   365	
   366	    /**
   367	     * スマレジ在庫変動連携で当該在庫変動履歴ID (history_source_id) が既に取り込み済みかを判定する。
   368	     *
   369	     * スマレジ在庫変動 Webhook と再連携バッチで同一の在庫変動履歴を二重反映しないための冪等性チェック。
   370	     */
   371	    public function existsBySmaregiStockChangeId(int $smaregiStockChangeId): bool
   372	    {
   373	        $count = $this->createQueryBuilder('sh')
   374	            ->select('COUNT(sh.id)')
   375	            ->andWhere('sh.HistorySourceType = :sourceType')
   376	            ->andWhere('sh.historySourceId = :sourceId')
   377	            ->setParameter('sourceType', MtbStockHistorySourceType::SMAREGI_SYNC)
   378	            ->setParameter('sourceId', $smaregiStockChangeId)
   379	            ->getQuery()
   380	            ->getSingleScalarResult();
   381	
   382	        return (int) $count > 0;
   383	    }
   384	
   385	    /**
   386	     * 在庫履歴ID配列に一致する在庫履歴データを取得する。
   387	     *
   388	     * @param array<int, int> $ids
   389	     *
   390	     * @return array<int, DtbStockHistory>
   391	     */
   392	    public function getStockHistories(array $ids): array
   393	    {
   394	        $qb = $this->createQueryBuilder('sh')
   395	            ->addSelect('ps', 'm', 'pc', 'p', 'cd')
   396	            ->leftJoin('sh.ProductStock', 'ps')
   397	            ->leftJoin('sh.Member', 'm')
   398	            ->leftJoin('ps.ProductClass', 'pc')
   399	            ->leftJoin('pc.Product', 'p')
   400	            ->leftJoin('pc.TaxRule', 'tr')
   401	            ->leftJoin('p.CardDetail', 'cd');
   402	
   403	        // ids 在庫履歴ID
   404	        if (!empty($ids) && StringUtil::isNotBlank($ids)) {
   405	            $qb
   406	                ->Where($qb->expr()->in('sh.id', ':stock_history_ids'))
   407	                ->setParameter('stock_history_ids', $ids);
   408	        }
   409	
   410	        // Order By
   411	        $qb->addOrderBy('pc.code', 'DESC');
   412	        $qb->addOrderBy('ps.baseInfo', 'DESC');
   413	        $qb->addOrderBy('sh.createDate', 'DESC');
   414	
   415	        return $qb->getQuery()->getResult();
   416	    }
   417	
   418	    /**
   419	     * 欠品理由を更新する。
   420	     *
   421	     * @param array{
   422	     *     stockHistoryId: int,
   423	     *     disposalReason: string,
   424	     *     memberId: int,
   425	     * } $inputs 更新する情報
   426	     */
   427	    public function updateDisposalReason(array $inputs): void
   428	    {
   429	        $date = (new \DateTime())->format('Y/m/d H:i:s');
   430	        $inputs['updateDate'] = $date;
   431	        $query = '
   432	            UPDATE dtb_stock_history
   433	            SET stock_change_reason = :disposalReason,
   434	                update_member_id = :memberId,
   435	                update_date = :updateDate
   436	            WHERE id = :stockHistoryId';
   437	
   438	        $this->getEntityManager()->getConnection()->executeUpdate($query, $inputs);
   439	    }
   440	
   441	    /**
   442	     * 指定商品在庫の指定日付以降の在庫履歴を取得する
   443	     *
   444	     * @return list<array<string, mixed>>
   445	     */
   446	    public function getRecentStockHistoriesByProductStockId(int $productStockId, \DateTime $createDateFrom): array
   447	    {
   448	        return $this->createQueryBuilder('sh')
   449	            ->select([
   450	                'sh.id',
   451	                'sh.old_stock AS oldStock',
   452	                'sh.stock',
   453	                'sh.stockChangeReason',
   454	                'sh.shortageReason',
   455	                'sh.createDate',
   456	                'sctd.childName AS stockChangeTypeDetail',
   457	                'sh.operatorMemberName AS memberName',
   458	            ])
   459	            ->leftJoin('sh.StockChangeTypeDetail', 'sctd')
   460	            ->join('sh.ProductStock', 'ps')
   461	            ->where('ps.id = :productStockId')
   462	            ->andWhere('sh.createDate >= :createDateFrom')
   463	            ->setParameter('productStockId', $productStockId)
   464	            ->setParameter('createDateFrom', $createDateFrom)
   465	            ->orderBy('sh.createDate', 'DESC')
   466	            ->getQuery()
   467	            ->getResult();
   468	    }
   469	
   470	    /**
   471	     * 指定商品在庫について、指定日付より後の在庫変動履歴が存在するか
   472	     */
   473	    public function existsStockHistoryAfterDateByProductStockId(int $productStockId, \DateTime $afterDate): bool
   474	    {
   475	        $count = $this->createQueryBuilder('sh')
   476	            ->select('COUNT(sh.id)')
   477	            ->join('sh.ProductStock', 'ps')
   478	            ->where('ps.id = :productStockId')
   479	            ->andWhere('sh.createDate > :afterDate')
   480	            ->setParameter('productStockId', $productStockId)
   481	            ->setParameter('afterDate', $afterDate)
   482	            ->getQuery()
   483	            ->getSingleScalarResult();
   484	
   485	        return (int) $count > 0;
   486	    }
   487	}

