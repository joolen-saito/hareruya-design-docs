   281	    /**
   282	     * 受注編集時の在庫履歴用 {@see MtbStockChangeTypeDetail} ID を返す.
   283	     *
   284	     * 優先: (5) 受注がキャンセルへ遷移 → 10、(3)(4) 欠品合計の増減 → 20/19、(1)(2) 欠品不変でグロス注文数のみ変化 → 8/9。
   285	     * いずれも当てはまらないときは実在庫差分の符号に合わせ 8 または 9 を返す.
   286	     *
   287	     * @param string $netQuantityDiff 商品規格単位の実在庫差分（prepare の $quantity）
   288	     */
   289	    private function resolveOrderEditStockChangeTypeDetailId(Order $From, Order $To, int $productClassId, string $netQuantityDiff): int
   290	    {
   291	        if ($To->getOrderStatus()?->getId() === OrderStatus::CANCEL
   292	            && $From->getOrderStatus()?->getId() !== OrderStatus::CANCEL) {
   293	            return MtbStockChangeTypeDetail::ORDER_CANCEL;
   294	        }
   295	
   296	        $deltas = $this->getStockoutAndGrossQuantityDeltasForProductClass($From, $To, $productClassId);
   297	        if (bccomp($deltas['delta_stockout'], '0', 0) !== 0) {
   298	            return bccomp($deltas['delta_stockout'], '0', 0) > 0
   299	                ? MtbStockChangeTypeDetail::ORDER_STOCKOUT_INCREASE
   300	                : MtbStockChangeTypeDetail::ORDER_STOCKOUT_DECREASE;
   301	        }
   302	
   303	        if (bccomp($deltas['gross_qty_delta'], '0', 0) !== 0) {
   304	            return bccomp($deltas['gross_qty_delta'], '0', 0) > 0
   305	                ? MtbStockChangeTypeDetail::ORDER_COMPLETE
   306	                : MtbStockChangeTypeDetail::ORDER_ADD;
   307	        }
   308	
   309	        return bccomp($netQuantityDiff, '0', 0) > 0
   310	            ? MtbStockChangeTypeDetail::ORDER_COMPLETE
   311	            : MtbStockChangeTypeDetail::ORDER_ADD;
   312	    }
   313	
   314	    /**
   315	     * 同一商品規格の明細について、欠品数合計の差分および「数量+欠品」の合計差分（グロス注文数の差）を返す.
   316	     *
   317	     * @return array{delta_stockout: string, gross_qty_delta: string}
   318	     */
   319	    private function getStockoutAndGrossQuantityDeltasForProductClass(Order $From, Order $To, int $productClassId): array
   320	    {
   321	        $sumDeltaStockout = '0';
   322	        $sumGrossQtyDelta = '0';
   323	
   324	        $gross = static function (OrderItem $item): string {
   325	            return bcadd($item->getQuantity(), (string) ($item->getStockout() ?? 0), 0);
   326	        };
   327	
   328	        $fromById = [];
   329	        foreach ($From->getOrderItems() as $item) {
   330	            if (!$item->isProduct() || $item->getProductClass()?->getId() !== $productClassId || $item->getId() === null) {
   331	                continue;
   332	            }
   333	            $fromById[$item->getId()] = $item;
   334	        }
   335	
   336	        foreach ($To->getOrderItems() as $toItem) {
   337	            if (!$toItem->isProduct() || $toItem->getProductClass()?->getId() !== $productClassId) {
   338	                continue;
   339	            }
   340	            $tid = $toItem->getId();
   341	            if ($tid !== null && isset($fromById[$tid])) {
   342	                $fromItem = $fromById[$tid];
   343	                $sumDeltaStockout = bcadd(
   344	                    $sumDeltaStockout,
   345	                    bcsub((string) ($toItem->getStockout() ?? 0), (string) ($fromItem->getStockout() ?? 0), 0),
   346	                    0
   347	                );
   348	                $sumGrossQtyDelta = bcadd($sumGrossQtyDelta, bcsub($gross($toItem), $gross($fromItem), 0), 0);
   349	                unset($fromById[$tid]);
   350	            } else {
   351	                $sumDeltaStockout = bcadd($sumDeltaStockout, (string) ($toItem->getStockout() ?? 0), 0);
   352	                $sumGrossQtyDelta = bcadd($sumGrossQtyDelta, $gross($toItem), 0);
   353	            }
   354	        }
   355	
   356	        foreach ($fromById as $fromItem) {
   357	            $sumDeltaStockout = bcsub($sumDeltaStockout, (string) ($fromItem->getStockout() ?? 0), 0);
   358	            $sumGrossQtyDelta = bcsub($sumGrossQtyDelta, $gross($fromItem), 0);
   359	        }
   360	
   361	        return ['delta_stockout' => $sumDeltaStockout, 'gross_qty_delta' => $sumGrossQtyDelta];
   362	    }
