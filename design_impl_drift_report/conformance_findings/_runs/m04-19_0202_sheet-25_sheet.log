/home/y-saito/Developments/ec-cube-enterprise/src/Eccube/Service/PurchaseFlow/Processor/StockDiffProcessor.php:361:        return ['delta_stockout' => $sumDeltaStockout, 'gross_qty_delta' => $sumGrossQtyDelta];
