namespace Eccube\Controller\Front;

use Eccube\Common\EccubeConfig;
use Eccube\Controller\AbstractController;
use Eccube\Repository\TradeLawRepository;
use Symfony\Bridge\Twig\Attribute\Template;
use Symfony\Component\Routing\Attribute\Route;

class TradeLawController extends AbstractController
{
    public function __construct(
        protected TradeLawRepository $tradeLawRepository,
        EccubeConfig $eccubeConfig,
    ) {
        $this->eccubeConfig = $eccubeConfig;
    }

    /**
     * @return array<string, mixed>
     */
    #[Route(path: '/help/tradelaw', name: 'help_tradelaw', methods: ['GET'])]
    #[Template(template: 'Help/tradelaw.twig')]
    public function index(): array
    {
        $tradelaws = $this->tradeLawRepository->findBy([
            'baseInfo' => $this->eccubeConfig->get('eccube_root_base_info_id'),
        ], ['sortNo' => 'ASC']);

        return [
            'tradelaws' => $tradelaws,
        ];
    }
}
