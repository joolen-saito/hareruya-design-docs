    52	    /**
    53	     * @param array<int, int> $buyOrderIds
    54	     */
    55	    public function exportByIds(array $buyOrderIds): StreamedResponse
    56	    {
    57	        $header = self::CSV_HEADER;
    58	        $headerKeys = array_keys($header);
    59	
    60	        $response = new StreamedResponse();
    61	        $response->setCallback(function () use ($header, $headerKeys, $buyOrderIds): void {
    62	            $this->csvExportService->fopen();
    63	            $this->csvExportService->fputcsv(array_values($header));
