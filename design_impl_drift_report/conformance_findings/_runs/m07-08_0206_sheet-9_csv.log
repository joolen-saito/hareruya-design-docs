    65	            $rows = $this->restockListCsvRowFormatter->iterateFormattedRows(
    66	                $this->buyOrderRepository->getBuyOrderRestockListCsvExportData($buyOrderIds),
    67	            );
    68	
    69	            foreach ($rows as $row) {
    70	                $orderedRow = array_map(
    71	                    fn ($key) => $row[$key] ?? '',
    72	                    $headerKeys,
    73	                );
    74	                $this->csvExportService->fputcsv($orderedRow);
    75	            }
    76	
    77	            $this->csvExportService->fclose();
    78	            $this->buyOrderRestockListService->markBuyOrdersAsRestocked($buyOrderIds);
