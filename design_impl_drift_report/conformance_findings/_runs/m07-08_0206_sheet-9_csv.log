   762	    /**
   763	     * ネット買取 棚戻しリストCSV・PDF用の生SQL行（iterateAssociative）
   764	     *
   765	     * @param array<int, int> $buyOrderIds
   766	     *
   767	     * @return iterable<int, array<string, mixed>>
   768	     */
   769	    public function getBuyOrderRestockListCsvExportData(array $buyOrderIds): iterable
   770	    {
   771	        if ($buyOrderIds === []) {
   772	            return new \ArrayIterator([]);
   773	        }
   774	
   775	        $conn = $this->getEntityManager()->getConnection();
   776	        $conn->executeStatement("SET TIME ZONE 'Asia/Tokyo'");
   777	
   778	        // 店頭買取の棚戻しリストと同様の集計だが実在庫は dtb_buy_order_stock。閾値は本店 base_info 固定。
   779	        // CSV出力のため raw SQL + iterateAssociative（大量データのストリーミング対応）。
   780	        $pickingTypeSortSupply = RestockListPdfSectionBuilder::PICKING_TYPE_SORT_SUPPLY;
   781	        $pickingTypeSortNullStandardPrice = RestockListPdfSectionBuilder::PICKING_TYPE_SORT_NULL_STANDARD_PRICE;
   782	
   783	        $sql = <<<SQL
   784	            SELECT
   785	                p.name AS "rawProductName",
   786	                sc.name AS "storageCodeName",
   787	                lng.code AS "languageCode",
   788	                cond.code AS "conditionCode",
   789	                (
   790	                    SELECT STRING_AGG(cl.name_jp, '' ORDER BY cl.id)
   791	                    FROM dtb_card_color dcc
   792	                    JOIN mtb_color cl ON cl.id = dcc.color_id
   793	                    WHERE dcc.card_id = c.id
   794	                ) AS "colorName",
   795	                r.code AS "rarityCode",
   796	                COALESCE(cd.foil_flg, 0) AS "foilFlg",
   797	                SUM(s.quantity) AS "quantity",
   798	                pc.standard_price AS "standardPrice",
   799	                bi.expensive_threshold1 AS "threshold1",
   800	                bi.expensive_threshold2 AS "threshold2",
   801	                bi.expensive_threshold3 AS "threshold3",
   802	                CASE WHEN EXISTS (
   803	                    SELECT 1 FROM dtb_product_category pcat
   804	                    WHERE pcat.product_id = p.id
   805	                      AND pcat.category_id IN (:goods_category_id, :reserved_goods_category_id)
   806	                ) THEN 1 ELSE 0 END AS "isSupply",
   807	                CASE
   808	                    WHEN EXISTS (
   809	                        SELECT 1 FROM dtb_product_category pcat
   810	                        WHERE pcat.product_id = p.id
   811	                          AND pcat.category_id IN (:goods_category_id, :reserved_goods_category_id)
   812	                    ) THEN {$pickingTypeSortSupply}
   813	                    WHEN pc.standard_price IS NULL THEN {$pickingTypeSortNullStandardPrice}
   814	                    -- biは本店のみの前提のため、threhold1,2,3の価格順やnullableに依存せず、閾値を超えた数で区間番号を求めてソートtierを決定する
   815	                    ELSE
   816	                        (
   817	                            (CASE WHEN bi.expensive_threshold1 IS NOT NULL AND pc.standard_price >= bi.expensive_threshold1 THEN 1 ELSE 0 END)
   818	                            + (CASE WHEN bi.expensive_threshold2 IS NOT NULL AND pc.standard_price >= bi.expensive_threshold2 THEN 1 ELSE 0 END)
   819	                            + (CASE WHEN bi.expensive_threshold3 IS NOT NULL AND pc.standard_price >= bi.expensive_threshold3 THEN 1 ELSE 0 END)
   820	                        ) + 1
   821	                END AS "pickingTypeSort",
   822	                sn.name AS "shelfNumberName",
   823	                bi.id AS "baseInfoId",
   824	                COALESCE(sn.sort_no, 99999) AS "shelfSort",
   825	                COALESCE(lng.id, 99999) AS "languageSort",
   826	                COALESCE(pc.card_condition_id, 99999) AS "conditionSort",
   827	                COALESCE(cd.foil_flg, 0) AS "foilSort",
   828	                COALESCE(sc.rank, 99999) AS "storageCodeSort",
   829	                COALESCE(r.sort_no, 99999) AS "raritySort",
   830	                COALESCE(cs.sort_no, 99999) AS "colorSort",
   831	                CASE WHEN sc.alphabet_sort_flg = true THEN c.name_en ELSE cd.card_no END AS "cardSort"
   832	            FROM dtb_buy_order_stock s
   833	            JOIN dtb_buy_order o ON o.id = s.buy_order_id
   834	            JOIN dtb_base_info bi ON bi.id = :main_store_id
   835	            JOIN dtb_product_class pc ON pc.id = s.product_class_id
   836	            JOIN dtb_product p ON p.id = pc.product_id
   837	            LEFT JOIN mtb_card_condition cond ON cond.id = pc.card_condition_id
   838	            LEFT JOIN mtb_storage_code sc ON sc.id = p.storage_code_id
   839	            LEFT JOIN mtb_card_detail cd ON cd.id = p.card_detail_id
   840	            LEFT JOIN mtb_rarity r ON r.id = cd.rarity_id
   841	            LEFT JOIN mtb_language lng ON lng.id = pc.language_id
   842	            LEFT JOIN mtb_card c ON c.id = cd.card_id
   843	            LEFT JOIN mtb_color_sequence cs ON cs.id = c.color_sequence_id
   844	            LEFT JOIN dtb_shelf_number sn ON sn.id = pc.shelf_number_id
   845	            WHERE
   846	                s.buy_order_id IN (:ids)
   847	                AND o.buy_order_status_id <> :cancel_status_id
   848	            GROUP BY
   849	                pc.id, p.id, p.name, sc.name, sc.rank, sc.alphabet_sort_flg,
   850	                lng.id, lng.code, cond.code, r.code, r.sort_no,
   851	                cd.foil_flg, cd.card_no, pc.standard_price,
   852	                bi.id, bi.expensive_threshold1, bi.expensive_threshold2, bi.expensive_threshold3,
   853	                c.id, c.name_en, c.color_sequence_id,
   854	                cs.sort_no, sn.sort_no, sn.name
   855	            ORDER BY
   856	                -- 1. ピッキング区分: 円未満→円以上〜円未満→円以上→サプライ
   857	                "pickingTypeSort" ASC,
   858	                -- 2. 棚番: 本店のみ昇順（支店は棚番ソートなし）
   859	                "shelfSort" ASC,
   860	                -- 3. 言語: 日→英→他言語
   861	                "languageSort" ASC,
   862	                -- 4. 状態: NM→HP
   863	                "conditionSort" ASC,
   864	                -- 5. Foilフラグ: 非Foil→Foil
   865	                "foilSort" ASC,
   866	                -- 6. 略称タグ: 昇順
   867	                "storageCodeSort" ASC,
   868	                -- 7. レアリティ: M→C
   869	                "raritySort" ASC,
   870	                -- 8. 色: マスターデータ色順（mtb_color_sequence.sort_no）
   871	                "colorSort" ASC,
   872	                -- 9. 略称タグがアルファベットソートなら英語カード名昇順、コレクター番号ソートならcard_no昇順
   873	                "cardSort" ASC
   874	        SQL;
   875	
   876	        $rawData = $conn->iterateAssociative(
   877	            $sql,
   878	            [
   879	                'ids' => $buyOrderIds,
   880	                'cancel_status_id' => MtbBuyOrderStatus::CANCELED,
   881	                'goods_category_id' => Category::GOODS_ID,
   882	                'reserved_goods_category_id' => Category::RESERVED_GOODS_ID,
   883	                'main_store_id' => BaseInfo::TC_TOKYO_ID,
