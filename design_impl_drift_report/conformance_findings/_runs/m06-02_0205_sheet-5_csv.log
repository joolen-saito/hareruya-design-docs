   315	    public function getOldAccountCsvExportData(array $otcBuyOrderIds): iterable
   316	    {
   317	        if (empty($otcBuyOrderIds)) {
   318	            return new \ArrayIterator([]);
   319	        }
   320	        // SQLが複雑でDoctrineでうまく対応できない & 数万件のデータ出力も想定されるため、SQLでクエリ
   321	        // Connectionの取得
   322	        $conn = $this->getEntityManager()->getConnection();
   323	        $conn->executeStatement("SET TIME ZONE 'Asia/Tokyo'");
   324	
   325	        $sql = <<<SQL
   326	            SELECT
   327	                o.id AS "otcBuyOrderId",
   328	                o.assessment_id AS "assessmentId",
   329	                TO_CHAR(o.complete_date, 'YYYY"年"FMMM"月"FMDD"日"') AS "completeDate",
   330	                -- サブクエリで事前に集計した数量を結合して、重複を完全に防ぐ
   331	                COALESCE(sub_od.detail_quantity, 0) + COALESCE(sub_oip.input_product_quantity, 0) AS "totalQuantity",
   332	                o.total_price AS "totalPrice",
   333	                -- first_nameとlast_nameの間に全角空白
   334	                CONCAT(o.last_name, '　', o.first_name) AS "fullName",
   335	                -- PostgreSQLのAGE関数で正確な年齢（年数）を取得
   336	                EXTRACT(YEAR FROM AGE(o.apply_date, o.birth)) AS "age",
   337	                -- "日本の場合は県名 + 半角空白 + 住所1 + 半角空白 + 住所2 + 住所3
   338	                -- 海外の場合は国名 + 半角空白 + 住所3 + 半角空白 + 住所2 + 住所1
   339	                CASE
   340	                    WHEN c.id = :countryId
   341	                    THEN CONCAT_WS(' ', p.name, o.addr01, o.addr02, o.addr03)
   342	                    ELSE CONCAT_WS(' ', c.name, o.addr03, o.addr02, o.addr01)
   343	                END AS "address",
   344	                i.name AS "identificationType",
   345	                j.name AS "job",
   346	                -- ="電話番号"の形式で出力
   347	                CASE
   348	                    WHEN o.tel_no IS NULL OR o.tel_no = ''
   349	                    THEN o.tel_no
   350	                    ELSE CONCAT('="', REPLACE(o.tel_no, '"', '""'), '"') -- 電話番号に"が含まれている場合はCSVの数式が壊れるのでエスケープ
   351	                END AS "phoneNumber",
   352	                o.qualified_invoice_issuer_flg AS "qualifiedInvoiceIssuerFlg",
   353	                qiia.qualified_invoice_issuer_code AS "qualifiedInvoiceIssuerNumber"
   354	            FROM dtb_otc_buy_order AS o
   355	            -- 明細の集計
   356	            LEFT JOIN (
   357	                SELECT otc_buy_order_id, SUM(original_quantity) as detail_quantity
   358	                FROM dtb_otc_buy_order_detail GROUP BY otc_buy_order_id
   359	            ) AS sub_od ON sub_od.otc_buy_order_id = o.id
   360	            -- 個別入力の集計
   361	            LEFT JOIN (
   362	                SELECT otc_buy_order_id, SUM(quantity) as input_product_quantity
   363	                FROM dtb_otc_buy_order_indivisual_input_product GROUP BY otc_buy_order_id
   364	            ) AS sub_oip ON sub_oip.otc_buy_order_id = o.id
   365	            LEFT JOIN mtb_job AS j ON o.job_id = j.id
   366	            LEFT JOIN mtb_country AS c ON o.country_id = c.id
   367	            LEFT JOIN mtb_pref AS p ON o.pref_id = p.id
   368	            LEFT JOIN mtb_identification AS i ON o.identification_id = i.id
   369	            LEFT JOIN dtb_qualified_invoice_issuer_account AS qiia ON o.qualified_invoice_issuer_account_id = qiia.id
   370	            WHERE o.id IN (:ids)
   371	            ORDER BY o.assessment_id DESC
   372	        SQL;
