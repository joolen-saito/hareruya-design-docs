   294	    /**
   295	     * 古物台帳入力用CSV出力用データ取得
   296	     *
   297	     * @param array<int, int> $otcBuyOrderIds
   298	     *
   299	     * @return \Traversable<int, array{
   300	     * otcBuyOrderId: int,
   301	     * assessmentId: string|null,
   302	     * completeDate: string,
   303	     * totalQuantity: int|string,
