    66	                'shelfNumber' => '棚番号', // 本店のみ出力、他店舗は空
    67	                'languageAndCondition' => '言語/状態', // Foilの場合はFoilをつけて、言語/状態の形式で出力する（例: FoilJP/NM）、サプライ品の場合は「サプライ品」と表示
    68	                'storageCode' => '略称', // サプライ品の場合は表示しない
