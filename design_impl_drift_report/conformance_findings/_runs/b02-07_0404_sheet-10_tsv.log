   305	    /**
   306	     * @return array<int, array{min_id: ?int, max_id: ?int, high_price_only: bool}>
   307	     */
   308	    private function buildExportRanges(): array
   309	    {
   310	        $ranges = [];
   311	        $maxProductId = $this->productClassRepository->getMaxProductId();
   312	        $batchSize = $maxProductId > 0 ? (int) ($maxProductId / 50) : 0;
   313	
   314	        if ($batchSize <= 0) {
   315	            $ranges[] = [
   316	                'min_id' => 0,
   317	                'max_id' => 0,
   318	                'high_price_only' => false,
   319	            ];
   320	        } else {
   321	            for ($i = 0; $i <= 50; $i++) {
   322	                $min = $i * $batchSize;
   323	                $max = $min + $batchSize;
   324	                $ranges[] = [
   325	                    'min_id' => $min,
   326	                    'max_id' => $max,
   327	                    'high_price_only' => false,
   328	                ];
   329	            }
   330	        }
   331	
   332	        $ranges[] = [
   333	            'min_id' => null,
   334	            'max_id' => null,
   335	            'high_price_only' => true,
   336	        ];
   337	
   338	        return $ranges;
   339	    }
