    62	    public function exportAndUpload(bool $isManualExecution = false): int
    63	    {
    64	        $executionTime = new \DateTimeImmutable('now');
    65	        $lockHandle = $this->acquireLock();
    66	        if ($lockHandle === null) {
    67	            log_warning('Unisearch 商品フィードTSV出力処理は既に実行中のためスキップしました。');
    68	
    69	            return 0;
    70	        }
    71	        $this->deleteExistingOutputFiles();
    72	        $baseFileName = 'feed_hareruyamtgecc_'.$executionTime->format('YmdHis');
    73	        $baseDoneFileName = 'done_hareruyamtgecc_'.$executionTime->format('YmdHis');
    74	
    75	        $tsvPath = $this->workDir.$baseFileName.'.tsv';
    76	        $donePath = $this->workDir.$baseDoneFileName.'.txt';
    77	
    78	        try {
    79	            $this->deleteOldBackupFiles();
    80	
    81	            $total = $this->exportTsvBySql($tsvPath);
    82	            if ($total === 0) {
    83	                $this->filesystem->dumpFile($tsvPath, '');
    84	                log_info('出力対象が0件のため空ファイルを作成しました。', ['path' => $tsvPath]);
    85	            }
    86	
    87	            $gzipPath = $this->compressFile($tsvPath, self::COMPRESS_GZIP);
    88	
    89	            $md5 = md5_file($gzipPath);
    90	            $this->filesystem->dumpFile($donePath, $md5);
    91	            log_info('.doneファイルを生成しました。', ['path' => $donePath, 'md5' => $md5]);
    92	
    93	            log_info('バックアップファイルを作成しました。', ['path' => $gzipPath]);
    94	            $this->applyPermissions([$tsvPath, $gzipPath, $donePath]);
    95	
    96	            if (!$isManualExecution) {
    97	                if (!$this->sftpService->deleteRemoteByPrefixes(['feed_hareruyamtg_', 'done_hareruyamtg_'])) {
    98	                    throw new \RuntimeException('SFTP既存ファイルの削除に失敗しました。');
    99	                }
   100	                if (!$this->sftpService->upload($gzipPath)) {
   101	                    throw new \RuntimeException('SFTPアップロードに失敗しました。');
   102	                }
   103	                if (!$this->sftpService->upload($donePath)) {
