    27	class StorageCodeCsv extends AbstractCsvService
    28	{
    29	    /** @var array<int|string, true> CSV 内で使用済みの並び順 */
    30	    private array $importedRanks = [];
    31	
    32	    /** @var array<string, string> */
    33	    private const DEFAULT_CSV_HEADER = ['ID' => 'ID', '名称' => '名称', '並び順' => '並び順'];
    34	
    35	    /** @var array<string, string> */
    36	    private const DEFAULT_REQUIRED_CSV_HEADER = ['名称' => '名称', '並び順' => '並び順'];
    37	
    38	    /**
    39	     * @param EntityManagerInterface $entityManager
    40	     * @param TranslatorInterface $translator
    41	     * @param EccubeConfig $eccubeConfig
    42	     * @param array<string, string> $csvHeader
    43	     * @param array<string, string> $requiredCsvHeader
    44	     */
    45	    public function __construct(
    46	        EntityManagerInterface $entityManager,
    47	        TranslatorInterface $translator,
    48	        EccubeConfig $eccubeConfig,
    49	        private MtbStorageCodeRepository $storageCodeRepository,
    50	        array $csvHeader = [],
    51	        array $requiredCsvHeader = [],
    52	    ) {
    53	        $csvHeader = $csvHeader !== [] ? $csvHeader : self::DEFAULT_CSV_HEADER;
    54	        $requiredCsvHeader = $requiredCsvHeader !== [] ? $requiredCsvHeader : self::DEFAULT_REQUIRED_CSV_HEADER;
    55	        parent::__construct($entityManager, $translator, $eccubeConfig, $csvHeader, $requiredCsvHeader);
    56	    }
    57	
    58	    /**
    59	     * 略称コードの登録処理
    60	     *
    61	     * @param array<int, string> $headers
    62	     * @param int $headerSize
    63	     * @param \Iterator<array<string, string>> $data
    64	     *
    65	     * @throws \RuntimeException
    66	     * @throws \Throwable
    67	     */
    68	    public function register(array $headers, int $headerSize, \Iterator $data): void
    69	    {
    70	        $requiredHeaders = $this->requiredCsvHeader;
    71	        $this->importedRanks = [];
    72	
    73	        $this->entityManager->getConnection()->beginTransaction();
    74	
    75	        try {
    76	            $i = 0;
    77	            foreach ($data as $row) {
    78	                $rowIndex = $i + 2;
    79	
    80	                if (end($row) === '') {
    81	                    array_pop($row);
    82	                }
    83	
    84	                $this->checkHeaderSize($headerSize, $row, $rowIndex);
    85	                $this->checkRequiredHeaders($requiredHeaders, $row, $rowIndex);
    86	
    87	                $rank = $row['並び順'] ?? '';
    88	                if (isset($this->importedRanks[$rank])) {
    89	                    $message = $this->translator->trans(
    90	                        'admin.storagecode.duplicate_csv_rank_error',
    91	                        ['%row%' => $rowIndex],
    92	                        'messages'
    93	                    );
    94	                    throw new \RuntimeException($message);
    95	                }
    96	
    97	                $existingByName = $this->storageCodeRepository->findOneBy(['name' => $row['名称']]);
    98	                $rowId = isset($row['ID']) ? (int) $row['ID'] : null;
    99	                if ($existingByName !== null && $existingByName->getId() !== $rowId) {
   100	                    $message = $this->translator->trans(
   101	                        'admin.storagecode.duplicate_error',
   102	                        ['%row%' => $rowIndex],
   103	                        'messages'
   104	                    );
   105	                    throw new \RuntimeException($message);
   106	                }
   107	
   108	                $mtbStorageCode = null;
   109	                if ($rowId !== null && $rowId !== 0) {
   110	                    $mtbStorageCode = $this->storageCodeRepository->find($rowId);
   111	                }
   112	
   113	                if ($mtbStorageCode === null) {
   114	                    $mtbStorageCode = new MtbStorageCode();
   115	                }
   116	
   117	                $mtbStorageCode
   118	                    ->setName($row['名称'])
   119	                    ->setRank((int) $row['並び順']);
   120	
   121	                $this->entityManager->persist($mtbStorageCode);
   122	                $this->importedRanks[$row['並び順']] = true;
   123	
   124	                if ($rowIndex % 100 === 0) {
   125	                    $this->entityManager->flush();
   126	                    $this->clearCache();
   127	                }
   128	                $i++;
   129	            }
   130	
   131	            $this->entityManager->flush();
   132	            $this->entityManager->getConnection()->commit();
   133	            $this->clearCache();
   134	        } catch (\Throwable $e) {
   135	            if ($this->entityManager->getConnection()->isTransactionActive()) {
   136	                $this->entityManager->getConnection()->rollBack();
   137	            }
   138	            throw $e;
   139	        }
   140	    }
   141	}

