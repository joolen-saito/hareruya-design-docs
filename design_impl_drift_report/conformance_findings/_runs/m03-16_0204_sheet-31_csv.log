   271	            $this->addError('admin.common.csv_invalid_format', 'admin');
   272	            $storageCodeCsv->deleteTempData();
   273	
   274	            return $this->redirectToRoute('admin_product_storage_code_csv');
   275	        }
   276	
   277	        log_info('略称タグCSV登録開始');
   278	        $data = $storageCodeCsv->getImportData($formFile);
   279	
   280	        if ($data === false) {
   281	            $this->addError('admin.common.csv_invalid_format', 'admin');
   282	            $storageCodeCsv->deleteTempData();
   283	            log_info('略称タグCSVインポートでエラーが発生しました');
   284	
   285	            return $this->redirectToRoute('admin_product_storage_code_csv');
   286	        }
   287	
   288	        try {
   289	            $headers = $this->getCsvHeader();
   290	            $columnHeaders = array_filter($data->getColumnHeaders());
   291	            $storageCodeCsv->checkHeaderValues(array_keys($headers), $columnHeaders, $this->getNotRequiredCsvHeader());
   292	            $headerSize = count($columnHeaders);
   293	            $storageCodeCsv->checkDataSize($data);
   294	            $this->entityManager->getConnection()->getConfiguration()->setSQLLogger(null);
   295	
   296	            $storageCodeCsv->register(array_keys($headers), $headerSize, $data);
