    16	namespace Eccube\Security\AccessToken;
    17	
    18	use Symfony\Component\HttpFoundation\Request;
    19	use Symfony\Component\Security\Http\AccessToken\AccessTokenExtractorInterface;
    20	
    21	/**
    22	 * カスタムヘッダーからアクセストークンを抽出する
    23	 *
    24	 * Why: クライアントAppとの互換性のため、標準のAuthorizationヘッダーではなく
    25	 *      カスタムヘッダーを使用する
    26	 */
    27	class JwtTokenHeaderExtractor implements AccessTokenExtractorInterface
    28	{
    29	    private const HEADER_NAME = 'jwt-token';
    30	
    31	    #[\Override]
    32	    public function extractAccessToken(Request $request): ?string
    33	    {
    34	        $token = $request->headers->get(self::HEADER_NAME);
    35	
    36	        if ($token === null || $token === '') {
    37	            return null;
    38	        }
    39	
    40	        return $token;
    41	    }
    42	}
