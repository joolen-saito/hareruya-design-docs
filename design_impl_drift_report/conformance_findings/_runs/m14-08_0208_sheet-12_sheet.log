    16	namespace Eccube\Service\Admin\Cardset;
    17	
    18	use Doctrine\ORM\EntityManagerInterface;
    19	use Eccube\Common\EccubeConfig;
    20	use Eccube\Entity\Master\MtbCardset;
    21	use Eccube\Service\Upload\FileManager;
    22	use Symfony\Component\HttpKernel\Exception\UnsupportedMediaTypeHttpException;
    23	
    24	class CardsetSaveAction
    25	{
    26	    private EntityManagerInterface $entityManager;
    27	
    28	    // シンボル画像を保存するときのファイル名接頭辞（この後にIDをつける）
    29	    private const SYMBOL_IMAGE_PREFIX = 'cardset_symbol_image_';
    30	
    31	    public function __construct(
    32	        EntityManagerInterface $entityManager,
    33	        protected EccubeConfig $eccubeConfig,
    34	        private readonly FileManager $fileManager,
    35	    ) {
    36	        $this->entityManager = $entityManager;
    37	    }
    38	
    39	    public function handle(
    40	        MtbCardset $Cardset,
    41	    ): void {
    42	        $this->entityManager->beginTransaction();
    43	
    44	        try {
    45	            if ($image = $Cardset->uploadedFile) {
    46	                // シンボル画像ファイルを保存
    47	                // ファイルフォーマット検証
    48	                $mimeType = $image->getMimeType();
    49	                if (!str_starts_with((string) $mimeType, 'image')) {
    50	                    throw new UnsupportedMediaTypeHttpException();
    51	                }
    52	                // 拡張子検証
    53	                $allowExtensions = ['gif', 'jpg', 'jpeg', 'png'];
    54	                $extension = $image->getClientOriginalExtension();
    55	                if (!in_array(strtolower((string) $extension), $allowExtensions, true)) {
    56	                    throw new UnsupportedMediaTypeHttpException();
    57	                }
    58	                $this->entityManager->persist($Cardset);
    59	                $this->entityManager->flush(); // IDが採番される
    60	
    61	                $symbolImageDir = rtrim((string) $this->eccubeConfig['eccube_cardset_symbol_image_dir'], '/');
    62	                $symbolImageName = self::SYMBOL_IMAGE_PREFIX.$Cardset->getId().'.'.$extension;
    63	                $symbolImagePath = $symbolImageDir.'/'.$symbolImageName;
    64	
    65	                $fileAdapter = $this->fileManager->getAdapter();
    66	                $fileAdapter->upload(
    67	                    $image->getRealPath(),
    68	                    $symbolImageDir,
    69	                    $symbolImageName,
    70	                );
    71	
    72	                $Cardset->setSymbolImage($symbolImagePath);
    73	                unset($Cardset->uploadedFile);
    74	            }
    75	
    76	            $this->entityManager->persist($Cardset);
