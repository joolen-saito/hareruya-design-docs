   238	    /**
   239	     * getList
   240	     *
   241	     * @return TaxRule[]|null
   242	     */
   243	    public function getList(): ?array
   244	    {
   245	        $qb = $this->createQueryBuilder('t')
   246	            ->orderBy('t.apply_date', 'DESC')
   247	            ->where('t.Product IS NULL AND t.ProductClass IS NULL');
   248	
   249	        return $qb
   250	            ->getQuery()
   251	            ->getResult();
   252	    }
   253	
   254	    /**
   255	     * 税規約の削除.
   256	     *
   257	     * @param  int|TaxRule $TaxRule 税規約
   258	     *
   259	     * @throws NoResultException
   260	     */
   261	    #[\Override]
   262	    public function delete($TaxRule): void
   263	    {
   264	        if (!$TaxRule instanceof TaxRule) {
   265	            $TaxRule = $this->find($TaxRule);
   266	        }
   267	        if (!$TaxRule) {
   268	            throw new NoResultException();
   269	        }
   270	        $em = $this->getEntityManager();
   271	        $em->remove($TaxRule);
   272	        $em->flush();
   273	    }
