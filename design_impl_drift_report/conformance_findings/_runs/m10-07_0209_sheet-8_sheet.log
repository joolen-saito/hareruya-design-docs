   125	        if ($Product instanceof Product) {
   126	            $productId = $Product->getId();
   127	        } elseif ($Product) {
   128	            $productId = $Product;
   129	        } else {
   130	            $productId = '0';
   131	        }
   132	        if ($ProductClass instanceof ProductClass) {
   133	            $productClassId = $ProductClass->getId();
   134	        } elseif ($ProductClass) {
   135	            $productClassId = $ProductClass;
   136	        } else {
   137	            $productClassId = '0';
   138	        }
   139	        if ($Pref instanceof Pref) {
   140	            $prefId = $Pref->getId();
   141	        } elseif ($Pref) {
   142	            $prefId = $Pref;
   143	        } else {
   144	            $prefId = '0';
   145	        }
   146	        if ($Country instanceof Country) {
   147	            $countryId = $Country->getId();
   148	        } elseif ($Country) {
   149	            $countryId = $Country;
   150	        } else {
   151	            $countryId = '0';
   152	        }
   153	        $cacheKey = $productId.':'.$productClassId.':'.$prefId.':'.$countryId;
   154	
   155	        // すでに取得している場合はキャッシュから
   156	        if (isset($this->rules[$cacheKey])) {
   157	            return $this->rules[$cacheKey];
   158	        }
   159	        $apply_date = new \DateTime();
   160	        $qb = $this->createQueryBuilder('t')
   161	            ->where('t.apply_date < :apply_date')
   162	            ->setParameter('apply_date', $apply_date);
   163	
   164	        // Pref
   165	        if ($Pref) {
   166	            $qb->andWhere('t.Pref IS NULL OR t.Pref = :Pref');
   167	            $qb->setParameter('Pref', $Pref);
   168	        } else {
   169	            $qb->andWhere('t.Pref IS NULL');
   170	        }
   171	
   172	        // Country
   173	        if ($Country) {
   174	            $qb->andWhere('t.Country IS NULL OR t.Country = :Country');
   175	            $qb->setParameter('Country', $Country);
   176	        } else {
   177	            $qb->andWhere('t.Country IS NULL');
   178	        }
   179	
   180	        /*
   181	         * Product, ProductClass が persist される前に TaxRuleEventSubscriber によってアクセスされる
   182	         * 場合があるため、ID の存在もチェックする.
   183	         * https://github.com/EC-CUBE/ec-cube/issues/677
   184	         */
   185	
   186	        // Product
   187	        if ($Product && $productId > 0) {
   188	            $qb->andWhere('t.Product IS NULL OR t.Product = :Product');
   189	            $qb->setParameter('Product', $Product);
   190	        } else {
   191	            $qb->andWhere('t.Product IS NULL');
   192	        }
   193	
   194	        // ProductClass
   195	        if ($ProductClass && 0 !== $productClassId) {
   196	            $qb->andWhere('t.ProductClass IS NULL OR t.ProductClass = :ProductClass');
   197	            $qb->setParameter('ProductClass', $ProductClass);
   198	        } else {
   199	            $qb->andWhere('t.ProductClass IS NULL');
   200	        }
   201	
   202	        $TaxRules = $qb
   203	            ->orderBy('t.apply_date', 'DESC') // 実際は usort() でソートする
   204	            ->getQuery()
   205	            ->getResult();
   206	
   207	        // 地域設定を優先するが、システムパラメーターなどに設定を持っていくか
   208	        // 後に書いてあるほど優先される
   209	        $priorityKeys = [];
   210	        foreach ($this->eccubeConfig['eccube_tax_rule_priority'] as $priorityKey) {
   211	            $priorityKeys[] = str_replace('_', '', preg_replace('/_id\z/', '', (string) $priorityKey));
   212	        }
   213	
   214	        foreach ($TaxRules as $TaxRule) {
   215	            $sortNo = 0;
   216	            foreach ($priorityKeys as $index => $key) {
   217	                $arrayProperties = array_change_key_case($TaxRule->toArray());
   218	                if ($arrayProperties[$key]) {
   219	                    // 配列の数値添字を重みとして利用する
   220	                    $sortNo += 1 << ($index + 1);
   221	                }
   222	            }
   223	            $TaxRule->setSortNo($sortNo);
   224	        }
   225	
   226	        // 適用日降順, sortNo 降順にソートする
   227	        usort($TaxRules, fn ($a, $b) => $a->compareTo($b));
   228	
   229	        if (!empty($TaxRules)) {
   230	            $this->rules[$cacheKey] = $TaxRules[0];
   231	
   232	            return $TaxRules[0];
   233	        } else {
   234	            throw new NoResultException();
   235	        }
   236	    }
