   165	                    $row->getRowNumber(),
   166	                    $this->sectionCodeColumn->getLabel(),
   167	                    $sectionCode
   168	                );
   169	            $event->breakAll();
   170	
   171	            return false;
   172	        }
   173	
   174	        return true;
   175	    }
   176	
   177	    /**
   178	     * 部門コードから部門IDを取得する。
   179	     *
   180	     * @return int|null 部門ID（存在しない場合は null）
   181	     */
   182	    private function getSectionIdByCode(string $sectionCode): ?int
   183	    {
   184	        $sectionCode = trim($sectionCode);
   185	        if ($sectionCode === '') {
   186	            return null;
   187	        }
   188	
   189	        $Section = $this->sectionRepository->findOneBy(['code' => $sectionCode]);
   190	
   191	        return $Section !== null ? $Section->getId() : null;
   192	    }
   193	
   194	    /**
   195	     * 部門を更新する。
   196	     *
   197	     * @param ReadCsvRowEvent $event イベント
   198	     * @param string $productCode 商品コード
   199	     */
   200	    private function persistSection(ReadCsvRowEvent $event, string $productCode): void
