   739	    /**
   740	     * 入庫待ちの場合のみ入庫済みに更新する（二重入庫防止のための compare-and-swap）
   741	     *
   742	     * バッチと手動処理が同時実行された場合の二重入庫を防ぐため、
   743	     * DB レベルで WHERE BuyOrderStatus = WAITING_FOR_STOCK の条件付き UPDATE を行う。
   744	     * ※ステータス更新は呼び出し元でも行われる（冪等）
   745	     *
   746	     * @return int 更新件数（0 の場合はすでに処理済み）
   747	     */
   748	    public function updateStatusIfWaitingForStock(int $id): int
   749	    {
   750	        return $this->createQueryBuilder('b')
   751	            ->update()
   752	            ->set('b.BuyOrderStatus', ':next')
   753	            ->where('b.id = :id')
   754	            ->andWhere('b.BuyOrderStatus = :waiting')
   755	            ->setParameter('next', MtbBuyOrderStatus::STOCKING_COMPLETE)
   756	            ->setParameter('id', $id)
   757	            ->setParameter('waiting', MtbBuyOrderStatus::WAITING_FOR_STOCK)
   758	            ->getQuery()
   759	            ->execute();
   760	    }

