   373	    /**
   374	     * 複数の買取注文に対してそれぞれの買取依頼商品数と前回依頼日を取得（買取情報CSV用）
   375	     *
   376	     * @param array<int, int> $buyOrderIds 買取注文IDの配列
   377	     *
   378	     * @return array<int, array{productCounts: int, previousOrderDate: string|null}> キーは買取注文ID。previousOrderDate は 'Y/m/d' または null
   379	     */
   380	    public function getBuyOrdersProductsCount(array $buyOrderIds): array
   381	    {
   382	        if ($buyOrderIds === []) {
   383	            return [];
   384	        }
   385	
   386	        // 返却配列の初期化（すべてのIDについてデフォルト値をセット）
   387	        $result = [];
   388	        foreach ($buyOrderIds as $id) {
   389	            $result[$id] = [
   390	                'productCounts' => 0,
   391	                'previousOrderDate' => null,
   392	            ];
   393	        }
   394	
   395	        // 前回利用日のみを取得するクエリ
   396	        $qbDate = $this->createQueryBuilder('b');
   397	        $qbDate->select('b.id AS buyOrderId')
   398	            ->addSelect('MAX(preBo.orderDate) AS previousOrderDate')
   399	            ->leftJoin(DtbBuyOrder::class, 'preBo', Join::WITH, 'IDENTITY(preBo.Customer) = IDENTITY(b.Customer) AND preBo.orderDate < b.orderDate')
   400	            ->where($qbDate->expr()->in('b.id', ':buyOrderIds'))
   401	            ->groupBy('b.id')
   402	            ->setParameter('buyOrderIds', $buyOrderIds);
   403	
   404	        foreach ($qbDate->getQuery()->getResult() as $row) {
   405	            $id = (int) $row['buyOrderId'];
   406	            $prevDateRaw = $row['previousOrderDate'];
   407	
   408	            if ($prevDateRaw !== null) {
   409	                $dt = $prevDateRaw instanceof \DateTimeInterface
   410	                    ? $prevDateRaw
   411	                    : new \DateTime($prevDateRaw);
   412	                $result[$id]['previousOrderDate'] = $dt->format('Y/m/d');
   413	            }
   414	        }
   415	
   416	        // BuyMainCards の商品点数を集計
   417	        $qbCards = $this->createQueryBuilder('b');
   418	        $qbCards->select('b.id AS buyOrderId')
   419	            ->addSelect('SUM(bmc.count) AS cardCount')
   420	            ->join('b.BuyMainCards', 'bmc')
   421	            ->where($qbCards->expr()->in('b.id', ':buyOrderIds'))
   422	            ->groupBy('b.id')
   423	            ->setParameter('buyOrderIds', $buyOrderIds);
   424	
   425	        foreach ($qbCards->getQuery()->getResult() as $row) {
   426	            $id = (int) $row['buyOrderId'];
   427	            $result[$id]['productCounts'] += (int) $row['cardCount'];
   428	        }
   429	
   430	        // BuyOrderIndivisualInputProducts の商品点数を集計
   431	        $qbIndiv = $this->createQueryBuilder('b');
   432	        $qbIndiv->select('b.id AS buyOrderId')
   433	            ->addSelect('SUM(boi.quantity) AS indivCount')
   434	            ->join('b.BuyOrderIndivisualInputProducts', 'boi')
   435	            ->where($qbIndiv->expr()->in('b.id', ':buyOrderIds'))
   436	            ->groupBy('b.id')
   437	            ->setParameter('buyOrderIds', $buyOrderIds);
   438	
   439	        foreach ($qbIndiv->getQuery()->getResult() as $row) {
   440	            $id = (int) $row['buyOrderId'];
   441	            $result[$id]['productCounts'] += (int) $row['indivCount'];
   442	        }
   443	
   444	        return $result;
   445	    }

