   114	    /**
   115	     * @param DtbBuyOrder[] $BuyOrders
   116	     * @param array<int, array{productCounts: int, previousOrderDate: string|null}> $productCountData
   117	     * @param array<int, array{orderCount: int, identityConfirmStatusId: int, identityConfirmStatusNameJp: string, customerId: int}> $customerData
   118	     *
   119	     * @return list<array<string, mixed>>
   120	     */
   121	    private function buildCsvRows(array $BuyOrders, array $productCountData, array $customerData): array
   122	    {
   123	        $rows = [];
   124	        foreach ($BuyOrders as $BuyOrder) {
   125	            $prefName = $BuyOrder->getPref()?->getName() ?? '';
   126	            $addr01 = $BuyOrder->getAddr01();
   127	            $addr02 = $BuyOrder->getAddr02();
   128	            $addr03 = $BuyOrder->getAddr03();
   129	            $address = $prefName.' '.$addr01.' '.$addr02.($addr03 !== null && $addr03 !== '' ? $addr03 : '');
   130	
   131	            $birth = $BuyOrder->getBirth();
   132	            $age = $birth !== null ? (int) date('Y') - (int) $birth->format('Y') : '';
   133	
   134	            $orderDate = $BuyOrder->getOrderDate();
   135	            $customerId = $BuyOrder->getCustomer()->getId();
   136	            $orderCount = isset($customerData[$customerId]) ? (int) $customerData[$customerId]['orderCount'] : 0;
   137	            $productCounts = $productCountData[$BuyOrder->getId()]['productCounts'] ?? 0;
   138	            $previousOrderDate = $productCountData[$BuyOrder->getId()]['previousOrderDate'] ?? null;
   139	
   140	            $rows[] = [
   141	                'order_date' => $orderDate instanceof \DateTimeInterface ? $orderDate->format('Y/m/d') : '',
   142	                'buy_order_id' => $BuyOrder->getId(),
   143	                'name' => $BuyOrder->getLastName().$BuyOrder->getFirstName(),
   144	                'address' => $address,
   145	                'age' => $age,
   146	                'job' => $BuyOrder->getJob()?->getName() ?? '',
   147	                'tel_no' => $BuyOrder->getTelNo() ?? '',
   148	                'identificaion' => $BuyOrder->getIdentification()?->getName() ?? '',
   149	                'count' => $productCounts,
   150	                'total_price' => (string) ($BuyOrder->getTotalPrice() ?? ''),
   151	                'distinction' => self::DISTINCTION,
   152	                'article' => self::ARTICLE,
   153	                'feature' => self::FEATURE,
   154	                'orderCount' => $orderCount,
   155	                'previousOrderDate' => $previousOrderDate,
   156	            ];
   157	        }
   158	
   159	        return $rows;
   160	    }
   161	}

