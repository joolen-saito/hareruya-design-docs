   343	    public function findCustomerDisplayDataByConditions(array $conditions): array
   344	    {
   345	        $qb = $this->createQueryBuilder('bo')
   346	            ->join(DtbPlayer::class, 'p', Join::WITH, 'p.Customer = bo.Customer')
   347	            ->join('p.IdentityConfirmStatus', 'ics')
   348	            ->select([
   349	                'COUNT(bo) AS orderCount',
   350	                'ics.id AS identityConfirmStatusId',
   351	                'ics.nameJp AS identityConfirmStatusNameJp',
   352	                'IDENTITY(bo.Customer) AS customerId',
   353	            ])
   354	            ->groupBy('bo.Customer')
   355	            ->addGroupBy('ics.id')
   356	            ->addGroupBy('ics.nameJp');
   357	
   358	        if (!empty($conditions['customerIds'])) {
   359	            $qb->andWhere($qb->expr()->in('IDENTITY(bo.Customer)', ':customerIds'))
   360	                ->setParameter('customerIds', $conditions['customerIds']);
   361	        }
   362	        if (!empty($conditions['buyOrderIds'])) {
   363	            $subQb = $this->createQueryBuilder('bos')
   364	                ->select('IDENTITY(bos.Customer)')
   365	                ->where($qb->expr()->in('bos.id', ':buyOrderIds'));
   366	            $qb->andWhere($qb->expr()->in('IDENTITY(bo.Customer)', $subQb->getDQL()))
   367	                ->setParameter('buyOrderIds', $conditions['buyOrderIds']);
   368	        }
   369	
   370	        return $qb->getQuery()->getResult();
   371	    }
