    28	     */
    29	    protected string $csvFileName;
    30	
    31	    /**
    32	     * アップロードされたCSVファイルの行ごとの処理
    33	     *
    34	     * @return CsvImportService<int, mixed>|bool
    35	     */
    36	    protected function getImportData(UploadedFile $formFile): CsvImportService|bool
    37	    {
