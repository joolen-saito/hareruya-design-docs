    16	namespace Eccube\Service\Csv\Importer\Model;
    17	
    18	/**
    19	 * CsvRowInterface のデフォルト実装。
    20	 */
    21	class CsvRow implements CsvRowInterface
    22	{
    23	    /** @var int 行番号 */
    24	    private int $rowNumber;
    25	
    26	    /** @var array<int, string> 列のデータ */
    27	    private array $values;
    28	
    29	    /** @var array<string, int>|null ヘッダ行の名前が key 、インデックスが value の連想配列 */
    30	    private ?array $headers = null;
    31	
    32	    /**
    33	     * @param int $rowNumber 行番号
    34	     * @param array<int, string> $values 列のデータ
    35	     */
    36	    public function __construct(int $rowNumber, array $values)
    37	    {
    38	        $this->rowNumber = $rowNumber;
    39	        $this->setValues($values);
    40	        $this->setHeaders(null);
    41	    }
    42	
    43	    /**
    44	     * @param array<int, string> $values 各行の値
    45	     *
    46	     * @return self
    47	     */
    48	    public function setValues(array $values): self
    49	    {
    50	        $this->values = array_values($values);
    51	
    52	        return $this;
    53	    }
    54	
    55	    /**
    56	     * @param array<string>|null $headers ヘッダ行
    57	     *
    58	     * @return self
    59	     */
    60	    public function setHeaders(?array $headers): self
    61	    {
    62	        if (is_null($headers)) {
    63	            $this->headers = null;
    64	
    65	            return $this;
    66	        }
    67	
    68	        $this->headers = array_flip(
    69	            array_values($headers)
    70	        );
    71	
    72	        return $this;
    73	    }
    74	
    75	    /**
    76	     * @return int 行番号
    77	     */
    78	    public function getRowNumber(): int
    79	    {
    80	        return $this->rowNumber;
    81	    }
    82	
    83	    /**
    84	     * @return int 列数
    85	     */
    86	    public function count(): int
    87	    {
    88	        return count($this->values);
    89	    }
    90	
    91	    /**
    92	     * @param string|int $index 列の名前 or 列番号
    93	     *
    94	     * @return bool 列が存在する場合 true
    95	     */
    96	    public function exists(string|int $index): bool
    97	    {
    98	        if (is_int($index)) {
    99	            return isset($this->values[$index]);
   100	        }
   101	        if (is_null($this->headers)) {
   102	            throw new \LogicException('ヘッダ情報が未設定です。 setHeaders() でヘッダ名を設定してください。');
   103	        }
   104	        $indexByHeader = $this->headers[$index] ?? -1;
   105	
   106	        return ($indexByHeader >= 0) && (isset($this->values[$indexByHeader]));
   107	    }
   108	
   109	    /**
   110	     * @param string|int $index 列の名前 or 列番号
   111	     *
   112	     * @return string 列の値
   113	     */
   114	    public function getValue(string|int $index): string
   115	    {
   116	        return (string) $this->getColumnValue($index);
   117	    }
   118	
   119	    /**
   120	     * @param string|int $index 列の名前 or 列番号
   121	     *
   122	     * @return string 列の値
   123	     */
   124	    private function getColumnValue(string|int $index): string
   125	    {
   126	        if (is_int($index)) {
   127	            if (isset($this->values[$index])) {
   128	                return $this->values[$index];
   129	            }
   130	
   131	            throw new \InvalidArgumentException(sprintf('%d 行目には %d 列目のデータが存在しません。（最大 %d 列）', $this->getRowNumber(), $index, $this->count()));
   132	        }
   133	
   134	        if (is_null($this->headers)) {
   135	            throw new \LogicException('ヘッダ情報が未設定です。 setHeaders() でヘッダ名を設定してください。');
   136	        }
   137	
   138	        if (!isset($this->headers[$index])) {
   139	            throw new \InvalidArgumentException(sprintf('ヘッダに指定されたキー %s が存在しません', $index));
   140	        }
   141	
   142	        $indexByHeader = $this->headers[$index];
   143	
   144	        if (isset($this->values[$indexByHeader])) {
   145	            return $this->values[$indexByHeader];
   146	        }
   147	
   148	        throw new \InvalidArgumentException(sprintf('%d 行目には %d 列目（%s）のデータが存在しません。（最大 %d 列）', $this->getRowNumber(), $indexByHeader, $index, $this->count()));
   149	    }
   150	}

