    63	    /**
    64	     * @param array<int, int> $ids
    65	     */
    66	    public function exportByIds(string $exportType, array $ids): StreamedResponse
    67	    {
    68	        if (!isset(self::CSV_TYPES[$exportType])) {
    69	            throw new \InvalidArgumentException('Invalid export type: '.$exportType);
    70	        }
    71	
    72	        $header = self::CSV_TYPES[$exportType]['header'];
    73	        $Decks = $this->getDecksByExportType($exportType, $ids);
    74	
