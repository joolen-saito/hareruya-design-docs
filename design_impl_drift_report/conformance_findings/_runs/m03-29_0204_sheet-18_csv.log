    18	use Doctrine\Common\Collections\ArrayCollection;
    19	use Doctrine\ORM\QueryBuilder;
    20	use Doctrine\Persistence\ManagerRegistry;
    21	use Eccube\Entity\DtbCsvImportHistory;
    22	use Eccube\Entity\Master\MtbCsvImportType;
    23	use Eccube\Entity\Member;
    24	
    25	/**
    26	 * @extends AbstractRepository<DtbCsvImportHistory>
    27	 */
    28	class DtbCsvImportHistoryRepository extends AbstractRepository
    29	{
    30	    public const HISTORY_PERIOD = '-1 month';
    31	
    32	    public function __construct(ManagerRegistry $registry)
    33	    {
    34	        parent::__construct($registry, DtbCsvImportHistory::class);
    35	    }
    36	
    37	    /**
    38	     * @param int $csvImportTypeId mtb_csv_import_type.id
    39	     * @param string $fileName アップロードしたCSVファイル名
    40	     * @param int|null $memberId 作業者の会員ID（ログインユーザ）。null の場合は未設定
    41	     */
    42	    public function insertCsvImportHistory(int $csvImportTypeId, string $fileName, ?int $memberId): void
    43	    {
    44	        $em = $this->getEntityManager();
    45	        $CsvImportType = $em->getRepository(MtbCsvImportType::class)->find($csvImportTypeId);
    46	        if ($CsvImportType === null) {
    47	            return;
    48	        }
    49	        $CsvImportHistory = new DtbCsvImportHistory();
    50	        $CsvImportHistory->setFileName($fileName)
    51	            ->setCreateDate(new \DateTime())
    52	            ->setCsvImportType($CsvImportType);
    53	        if ($memberId !== null) {
    54	            $CsvImportHistory->setMember($em->getReference(Member::class, $memberId));
    55	        }
    56	        $em->persist($CsvImportHistory);
    57	        $em->flush();
    58	    }
    59	
    60	    /**
    61	     * CSVインポート種別で履歴のQueryBuilderを取得（ページネーション用）
    62	     *
    63	     * @param int $csvImportTypeId mtb_csv_import_type.id
    64	     */
    65	    public function getQueryBuilderByCsvImportType(int $csvImportTypeId): QueryBuilder
    66	    {
    67	        return $this->createQueryBuilder('cih')
    68	            ->innerJoin('cih.CsvImportType', 'ct')
    69	            ->where('ct.id = :csvImportTypeId')
    70	            ->setParameter('csvImportTypeId', $csvImportTypeId)
    71	            ->orderBy('cih.createDate', 'DESC');
    72	    }
    73	
    74	    /**
    75	     * 直近インポートされた履歴を取得
    76	     *
    77	     * @return DtbCsvImportHistory[]
    78	     */
    79	    public function getRecentCsvImportHistory(int $csvImportType, string $fileName): array
    80	    {
    81	        $createDate = (new \DateTime())->modify(self::HISTORY_PERIOD)->format('Y-m-d H:i:s');
    82	
    83	        return $this->createQueryBuilder('cih')
    84	            ->where('cih.CsvImportType = :csvImportType')
    85	            ->andWhere('cih.fileName = :fileName')
    86	            ->andWhere('cih.createDate >= :createDate')
    87	            ->setParameters(new ArrayCollection([
    88	                'csvImportType' => $csvImportType,
    89	                'fileName' => $fileName,
    90	                'createDate' => $createDate,
    91	            ]))
    92	            ->getQuery()
    93	            ->getResult();
    94	    }
    95	}

