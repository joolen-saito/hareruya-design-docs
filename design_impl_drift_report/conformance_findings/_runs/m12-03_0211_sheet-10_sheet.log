   194	     * @return array{result: array<int, array<string, mixed>>, total: array{sales: int, total: int, order_count: int}}
   195	     */
   196	    public function getAnalysisSummary(array $searchData): array
   197	    {
   198	        $summaryType = ($searchData['summary_type'] ?? null) === 'class_category_name' ? 'class_category_name' : 'product_id';
   199	        $dateType = in_array($searchData['date_type'] ?? null, self::ANALYSIS_DATE_COLUMNS, true)
   200	            ? (string) $searchData['date_type']
   201	            : 'order_date';
   202	
   203	        $avgPriceExpr = 'SUM(oi.price * oi.quantity) / NULLIF(SUM(oi.quantity), 0)';
   204	
   205	        $qb = $this->getEntityManager()->getConnection()->createQueryBuilder()
   206	            ->from('dtb_order_item', 'oi')
   207	            ->innerJoin('oi', 'dtb_order', 'o', 'oi.order_id = o.id')
   208	            ->innerJoin('oi', 'dtb_product', 'p', 'oi.product_id = p.id')
   209	            ->addSelect('SUM(oi.price * oi.quantity) AS total')
   210	            ->addSelect('SUM(oi.quantity) AS sales')
   211	            ->addSelect($avgPriceExpr.' AS price')
   212	            ->addSelect('COUNT(DISTINCT o.id) AS order_count');
   213	
   214	        if ($summaryType === 'class_category_name') {
   215	            $qb->addSelect("'' AS code")
   216	                ->addSelect('cat.category_name AS name')
   217	                ->innerJoin('oi', 'dtb_product_category', 'pcat', 'pcat.product_id = oi.product_id')
   218	                ->innerJoin('pcat', 'dtb_category', 'cat', 'cat.id = pcat.category_id')
   219	                ->groupBy('cat.category_name');
   220	        } else {
   221	            $qb->addSelect('oi.product_code AS code')
   222	                ->addSelect('MAX(oi.product_name) AS name')
   223	                ->groupBy('oi.product_code');
   224	        }
   225	
   226	        $baseInfoIds = array_values(array_filter(array_map('intval', (array) ($searchData['base_info_ids'] ?? []))));
   227	        if ($baseInfoIds === []) {
   228	            return ['result' => [], 'total' => ['sales' => 0, 'total' => 0, 'order_count' => 0]];
   229	        }
   230	        $qb->andWhere('o.base_info_id IN (:baseInfoIds)')
   231	            ->setParameter('baseInfoIds', $baseInfoIds, ArrayParameterType::INTEGER);
   232	
   233	        $qb->andWhere('o.order_date IS NOT NULL');
   234	
   235	        if ($dateType === 'cancel_date') {
   236	            $qb->andWhere('o.cancel_date IS NOT NULL')
   237	                ->andWhere('o.order_status_id = :cancelStatus')
   238	                ->setParameter('cancelStatus', OrderStatus::CANCEL);
   239	        } else {
   240	            $qb->andWhere('o.order_status_id != :cancelStatus')
   241	                ->setParameter('cancelStatus', OrderStatus::CANCEL);
   242	        }
   243	
   244	        if (!empty($searchData['summary_date_from'])) {
   245	            $qb->andWhere("o.{$dateType} >= :summaryDateFrom")
   246	                ->setParameter('summaryDateFrom', $searchData['summary_date_from']->format('Y-m-d H:i:s'));
   247	        }
   248	        if (!empty($searchData['summary_date_to'])) {
   249	            $qb->andWhere("o.{$dateType} <= :summaryDateTo")
   250	                ->setParameter('summaryDateTo', $searchData['summary_date_to']->format('Y-m-d H:i:s'));
   251	        }
   252	
   253	        $multi = isset($searchData['multi']) ? trim((string) $searchData['multi']) : '';
   254	        if ($multi !== '') {
   255	            $qb->leftJoin('p', 'mtb_card_detail', 'cd', 'p.card_detail_id = cd.id')
   256	                ->leftJoin('cd', 'mtb_card', 'c', 'cd.card_id = c.id');
   257	            $terms = preg_split('/[\s,\x{3000}]+/u', $multi, -1, PREG_SPLIT_NO_EMPTY) ?: [];
   258	            foreach ($terms as $index => $term) {
   259	                $param = 'multi'.$index;
   260	                $qb->andWhere("(oi.product_name LIKE :{$param} OR oi.product_code LIKE :{$param} OR p.name_en LIKE :{$param} OR c.name_jp LIKE :{$param} OR c.name_en LIKE :{$param} OR o.message LIKE :{$param} OR o.note LIKE :{$param})")
   261	                    ->setParameter($param, '%'.addcslashes($term, '%_\\').'%');
   262	            }
   263	        }
   264	
   265	        if (!empty($searchData['category_id'])) {
   266	            $categoryIds = array_map(static fn ($Category) => $Category->getId(), $searchData['category_id']->getSelfAndDescendants());
   267	            $qb->andWhere('EXISTS (SELECT 1 FROM dtb_product_category pcf WHERE pcf.product_id = oi.product_id AND pcf.category_id IN (:categoryIds))')
   268	                ->setParameter('categoryIds', $categoryIds, ArrayParameterType::INTEGER);
   269	        }
   270	
   271	        if (!empty($searchData['card_condition'])) {
   272	            $cardConditionIds = array_values(array_map('intval', (array) $searchData['card_condition']));
   273	            $qb->andWhere('EXISTS (SELECT 1 FROM dtb_product_class pcc WHERE pcc.id = oi.product_class_id AND pcc.card_condition_id IN (:cardConditionIds))')
   274	                ->setParameter('cardConditionIds', $cardConditionIds, ArrayParameterType::INTEGER);
   275	        }
   276	
   277	        if (!empty($searchData['tag_sales_analysis']) && count($searchData['tag_sales_analysis']) > 0) {
   278	            $tagIds = array_map(static fn ($Tag) => $Tag->getId(), $searchData['tag_sales_analysis']->toArray());
   279	            $qb->andWhere('EXISTS (SELECT 1 FROM dtb_order_item_tag_sales_analysis oita WHERE oita.order_item_id = oi.id AND oita.tag_sales_analysis_id IN (:tagIds))')
   280	                ->setParameter('tagIds', $tagIds, ArrayParameterType::INTEGER);
   281	        }
   282	
