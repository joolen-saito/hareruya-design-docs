{# オリジナル: pf-eccube3/app/Plugin/HareruyaEc/Resource/template/admin/OtcBuyOrder/index.twig #}
{% extends '@admin/default_frame.twig' %}

{% set menus = ['purchase_store', 'list'] %}

{% block title %}{{ 'admin.purchase.store.title'|trans }}{% endblock %}
{% block sub_title %}{{ 'admin.purchase.store.list'|trans }}{% endblock %}

{% form_theme searchForm '@admin/Form/bootstrap_4_horizontal_layout.html.twig' %}

{% block stylesheet %}
{{ parent() }}
{# TODO: Bootstrap ドロップダウンの display:none 問題の一時的な回避策 - デザイン適用時に削除すること #}
<style>
#result_list_main__pagemax_menu .dropdown-menu.show,
#result_list__custom_csv_menu .dropdown-menu.show {
    display: block !important;
}
.form-group.range {
    position: relative;
}
</style>
{% endblock stylesheet %}

{% block javascript %}
<script src="{{ asset('assets/js/vendor/moment-with-locales.min.js', 'admin') }}"></script>
<script src="{{ asset('assets/js/vendor/tempusdominus-bootstrap-4.min.js', 'admin') }}"></script>
<script>
    var exportUrl = "{{ url('admin_otcbuyorder_export') }}";
</script>
<script src="{{ asset('assets/js/OtcBuyOrder/otc-buy-order.js', 'admin') }}"></script>
{% endblock javascript %}

{% block main %}
<form name="search_form" id="search_form" method="post" action="{{ url('admin_otcbuyorder') }}">
    <div id="search_wrap" class="search-box">
        <div id="search_box" class="row">
            <div class="col-md-12 accordion">
                <div id="search_box___body" class="search-box-inner">
                    <div class="row">
                        <div id="search_box__body_inner" class="col-sm-12 col-lg-12 search">
                            <div class="row">
                                <div class="col-md-6">
                                    <div id="search_box__assessment_id" class="form-group">
                                        <label>{{ 'admin.purchase.store.form.assessment_id.label'|trans }}</label>
                                        {{ form_widget(searchForm.assessment_id) }}
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div id="search_box__name_multi" class="form-group">
                                        <label>{{ 'admin.purchase.store.form.name_multi.label'|trans }}</label>
                                        {{ form_widget(searchForm.name_multi) }}
                                    </div>
                                </div>
                            </div>
                            <div class="row">
                                <div class="col-md-6">
                                    <div id="search_box__customer_id" class="form-group">
                                        <label>{{ 'admin.purchase.store.form.customer_id.label'|trans }}</label>
                                        {{ form_widget(searchForm.customer_id) }}
                                    </div>
                                </div>
                            </div>
                            <div class="row" >
                                <div class="form-group col-sm-12 col-md-12">
                                    <label for="admin_purchase_list_product_name" class="col-sm-12 col-md-2">{{ 'admin.purchase.store.form.product_name.label'|trans }}</label>
                                    {% for num in 1..constant('Eccube\\Form\\Type\\Admin\\OtcBuyOrder\\OtcBuyOrderType::PRODUCT_NAME_FORM_NUM') %}
                                        <div class="col-md-3">
                                            <div id="search_box_main__product_name{{num}}" class="form-group">
                                                {{ form_widget(attribute(searchForm, 'product_name' ~ num) ) }}
                                            </div>
                                        </div>
                                    {% endfor %}
                                    <div class="col-md-12">
                                        <div id="search_box_main__product_name_select" class="form-group col-sm-6 col-md-6">
                                            <label>{{ 'admin.purchase.store.form.product_name_select.label'|trans }}</label>
                                            {{ form_widget(searchForm.product_name_select) }}
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="row">
                                <div class="col-md-6">
                                    <div id="search_box__otc_buy_order_status" class="form-group">
                                        <label>{{ 'admin.purchase.store.form.status.label'|trans }}</label>
                                        {{ form_widget(searchForm.otc_buy_order_status) }}
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div id="search_box__shop" class="form-group">
                                        <label>{{ 'admin.purchase.store.form.shop.label'|trans }}</label>
                                        {{ form_widget(searchForm.shop) }}
                                    </div>
                                </div>
                            </div>
                            <div class="row">
                                <div class="col-md-12">
                                    <div id="search_box__application_date_from" class="form-group">
                                        <label>{{ 'admin.purchase.store.form.application_date_from.label'|trans }}</label>
                                        <div class="form-group range">
                                            {{ form_widget(searchForm.application_date_from) }}　～　{{ form_widget(searchForm.application_date_to) }}
                                            {{ form_errors(searchForm.application_date_from) }}
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="row">
                                <div class="col-md-12">
                                    <div id="search_box__complete_date_from" class="form-group">
                                        <label>{{ 'admin.purchase.store.form.complete_date_from.label'|trans }}</label>
                                        <div class="form-group range">
                                            {{ form_widget(searchForm.complete_date_from) }}　～　{{ form_widget(searchForm.complete_date_to) }}
                                            {{ form_errors(searchForm.complete_date_from) }}
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="row">
                                <div class="col-md-12">
                                    <div id="search_box__price_from" class="form-group">
                                        <label>{{ 'admin.purchase.store.form.price.label'|trans }}</label>
                                        <div class="form-group range">
                                            {{ form_widget(searchForm.price_from) }}　～　{{ form_widget(searchForm.price_to) }}
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="row">
                                <div class="col-md-12">
                                    <div id="search_box__restock_incomplete_only" class="form-group">
                                        <div class="form-check">
                                            {{ form_widget(searchForm.restock_incomplete_only, {attr: {class: 'form-check-input'}}) }}
                                            {{ form_label(searchForm.restock_incomplete_only, null, {label_attr: {class: 'form-check-label'}}) }}
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div id="search_box_footer" class="row btn_area">
            <div id="search_box_footer__button_area" class="col-xs-8 col-xs-offset-2 col-sm-4 col-sm-offset-4 text-center">
                <button type="submit" class="btn btn-primary btn-block btn-lg searchBtn">
                    {{ 'admin.purchase.store.form.search.button'|trans }} <svg class="cb cb-angle-right"><use xlink:href="#cb-angle-right"></svg>
                </button>
            </div>
        </div>
    </div>
</form>
<form name="result_form" id="result_form" method="post" action="{{ path('admin_otcbuyorder_export') }}">
    <input type="hidden" name="{{ constant('Eccube\\Common\\Constant::TOKEN_NAME') }}" value="{{ csrf_token(constant('Eccube\\Common\\Constant::TOKEN_NAME')) }}">
    <input type="hidden" id="export_type" name="export_type">
    {% if pagination %}
    <div id="result_list" class="row">
        <div class="col-md-12">
            <div id="result_list_main" class="box">
                {% if pagination and pagination.totalItemCount > 0 %}
                <div id="result_list_main__header" class="box-header with-arrow">
                    <h3 class="box-title">検索結果 <span class="normal"><strong>{{ pagination.totalItemCount }} 件</strong> が該当しました</span></h3>
                </div>
                <div id="result_list_main__body" class="box-body">
                    <div id="result_list_main__menu" class="row">
                        <div class="col-md-12">
                            <ul class="sort-dd">
                                <li id="result_list_main__pagemax_menu" class="dropdown">
                                {% for pageMax in pageMaxis %}
                                    {% if pageMax.name == page_count %}
                                        <a class="dropdown-toggle" data-bs-toggle="dropdown">{{ pageMax.name|e }}件<svg class="cb cb-angle-down icon_down"><use xlink:href="#cb-angle-down"></svg></a>
                                        <ul class="dropdown-menu">
                                    {% endif %}
                                {% endfor %}
                                {% for pageMax in pageMaxis %}
                                    {% if pageMax.name != page_count %}
                                        <li><a href="{{ path('admin_otcbuyorder', {'pageno': 1, 'page_count': pageMax.name}) }}">{{ pageMax.name|e }}件</a></li>
                                    {% endif %}
                                {% endfor %}
                                        </ul>
                                </li>
                                <li id="result_list__custom_csv_menu" class="dropdown">
                                    <a class="dropdown-toggle" data-bs-toggle="dropdown">CSVダウンロード<svg class="cb cb-angle-down icon_down"><use xlink:href="#cb-angle-down"></svg></a>
                                    <ul class="dropdown-menu">
                                        <li><a href="#" class="dropdown-item export-link" data-type="old_goods_account">古物台帳入力用CSV</a></li>
                                        <li><a href="#" class="dropdown-item export-link" data-type="otc_buy_order_product_list">買取商品一覧CSV</a></li>
                                        <li><a href="#" class="dropdown-item export-link" data-type="otc_buy_order_restock_list_csv">戻しリストCSV</a></li>
                                        <li><button type="button" class="dropdown-item text-left export-link" data-type="otc_buy_order_restock_list_pdf" data-export-url="{{ path('admin_otcbuyorder_restock_list_pdf') }}">戻しリストPDF</button></li>
                                    </ul>
                                </li>
                            </ul>
                        </div>
                    </div>
                    {% for OtcBuyOrder in pagination %}
                    <div id="result_list_main__list" class="table_list">
                        <div class="table-responsive with-border">
                            <table class="table table-striped">
                                <thead>
                                <tr id="result_list_main__header">
                                    <th scope="col" rowspan="2">
                                        <input type="checkbox" id="allCheck"/>
                                    </th>
                                    <th id="result_list_main__header_id">査定ID</th>
                                    <th id="result_list_main__header_name">申込者</th>
                                    <th id="result_list_main__header_price">買取金額</th>
                                    <th id="result_list_main__header_shop">買取店舗</th>
                                    <th id="result_list_main__header_member1">査定担当者</th>
                                    <th id="result_list_main__header_member2">最終更新者</th>
                                    <th id="result_list_main__header_otc_buy_order_status">ステータス</th>
                                </tr>
                                </thead>
                                <tbody>
                                {% for OtcBuyOrder in pagination %}
                                <tr id="result_list_main__item--{{ OtcBuyOrder.id }}">
                                    <th scope="row">
                                        <input type="checkbox" id="otcBuyOrderIds[]" name="otcBuyOrderIds[]" value="{{ OtcBuyOrder.id }}" otcBuyOrderId="{{ OtcBuyOrder.id }}">
                                    </th>
                                    <td id="result_list_main__id--{{ OtcBuyOrder.id }}">
                                        <a href="{{ url('admin_otcbuyorder_detail', { 'otcBuyOrderId': OtcBuyOrder.id}) }}">
                                            {{ OtcBuyOrder.assessmentId }}
                                        </a>
                                    </td>
                                    <td id="result_list_main__name--{{ OtcBuyOrder.id }}">{{ OtcBuyOrder.lastName }}&nbsp;{{ OtcBuyOrder.firstName }}</td>
                                    <td id="result_list_main__price--{{ OtcBuyOrder.id }}">{{ OtcBuyOrder.totalPrice|price }}</td>
                                    <td id="result_list_main__shop--{{ OtcBuyOrder.id }}">{{ OtcBuyOrder.BaseInfo.shop_name }}</td>
                                    <td id="result_list_main__member1--{{ OtcBuyOrder.id }}">{{ OtcBuyOrder.getLatestUpdaterByStatus(constant('Eccube\\Entity\\Master\\MtbOtcBuyOrderStatus::STATUS_COMPLETE')).name ?? OtcBuyOrder.Member.name ?? '' }}</td>
                                    <td id="result_list_main__member2--{{ OtcBuyOrder.id }}">{{ OtcBuyOrder.Member.name ?? '' }}</td>
                                    <td id="result_list_main__otc_buy_order_status--{{ OtcBuyOrder.id }}">{{ OtcBuyOrder.OtcBuyOrderStatus.name }}</td>
                                </tr>
                                {% endfor %}
                                </tbody>
                            </table>
                        </div>
                    </div>
                    {% endfor %}
                </div>
                {% if pagination.totalItemCount > 0 %}
                {% include "pager.twig" with { 'pages' : pagination.paginationData, 'routes' : 'admin_otcbuyorder' } %}
                {% endif %}
                {% else %}
                <div id="result_list_main__header" class="box-header with-arrow">
                    <h3 class="box-title">検索条件に該当するデータがありませんでした。</h3>
                </div>
                {% endif %}
            </div>
        </div>
    </div>
{% endif %}
</form>
