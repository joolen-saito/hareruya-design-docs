use Eccube\Service\Admin\OtcBuyOrder\OtcBuyOrderRestockListService;
use Eccube\Service\Admin\OtcBuyOrder\RegisterIndividualStockAction;
use Eccube\Service\Admin\OtcBuyOrder\UpdateOtcBuyOrderStockAction;
use Eccube\Service\Admin\OtcBuyOrder\UpdateStatusAction;
use Eccube\Service\Csv\Exporter\OtcBuyOrderCsvExportService;
use Eccube\Twig\Extension\IsAccessibleRouteExtension;
use Knp\Component\Pager\PaginatorInterface;
use Symfony\Bridge\Twig\Attribute\Template;
use Symfony\Component\HttpFoundation\JsonResponse;
use Symfony\Component\HttpFoundation\Request;
use Symfony\Component\HttpFoundation\Response;
use Symfony\Component\Routing\Attribute\Route;
use Symfony\Component\Security\Core\Exception\AuthenticationException;
use Symfony\Component\Security\Csrf\CsrfTokenManagerInterface;

/**
 * 店頭買取管理
 */
class OtcBuyOrderController extends AbstractController
{
    use SearchControllerTrait;

    public function __construct(
        protected PageMaxRepository $pageMaxRepository,
        protected PaginatorInterface $paginator,
        protected DtbOtcBuyOrderRepository $otcBuyOrderRepository,
        protected DtbOtcBuyOrderStatusHistoryRepository $otcBuyOrderStatusHistoryRepository,
        protected MtbOtcBuyOrderStatusRepository $otcBuyOrderStatusRepository,
        protected CsrfTokenManagerInterface $csrfTokenManager,
        protected OtcBuyOrderCsvExportService $otcBuyOrderCsvExportService,
        protected OtcBuyOrderRestockListService $otcBuyOrderRestockListService,
        protected UpdateStatusAction $updateStatusAction,
        protected UpdateOtcBuyOrderStockAction $updateOtcBuyOrderStockAction,
        protected RegisterIndividualStockAction $registerIndividualStockAction,
        protected ProductClassRepository $productClassRepository,
        protected DtbOtcBuyOrderStockRepository $otcBuyOrderStockRepository,
        protected DtbOtcBuyOrderDetailRepository $otcBuyOrderDetailRepository,
        private readonly IsAccessibleRouteExtension $isAccessibleRouteExtension,
    ) {
        // === Trait 必須プロパティ ===
        $this->sessionKey = 'otcbuyorder';
        $this->formType = OtcBuyOrderType::class;
    }

    /**
     * 買取一覧
     *
     * @return array<string, mixed>
     */
    #[
        Route(
            path: '/%eccube_admin_route%/otcbuyorder',
            name: 'admin_otcbuyorder',
            methods: ['GET', 'POST'],
        ),
    ]
    #[
        Route(
            path: '/%eccube_admin_route%/otcbuyorder/page/{page_no}',
            name: 'admin_otcbuyorder_page',
            requirements: ['page_no' => "\d+"],
            methods: ['GET'],
        ),
    ]
    #[Template(template: '@admin/OtcBuyOrder/index.twig')]
    public function index(
        Request $request,
        PaginatorInterface $paginator,
        int $page_no = 0,
    ): array {
        // 現行だとパスパラメータでのページネーションだが、pager.twig が クエリパラメータでのページネーションを想定しているため両方に対応しておく
        if ($page_no === 0) {
            $page_no =
                $request->query->getInt('pageno', 0) ?:
                $request->query->getInt('page_no', 0);
        }

        // ページ番号が指定されている場合、セッションから検索条件を復元して指定のページを開く
        if ($page_no > 0) {
            return $this->search($request, null, $page_no);
        }

        // GET: 初期表示（空の状態）
        if ($request->isMethod('GET')) {
            $form = $this->createForm(OtcBuyOrderType::class);

            return [
                'searchForm' => $form->createView(),
                'pagination' => [],
                'pageMaxis' => [],
                'page_count' => $this->eccubeConfig['eccube_default_page_count'],
            ];
        }

        // POST: 検索実行
        $result = $this->search($request);

        return $result;
    }

    /**
     * QueryBuilder取得（SearchControllerTraitのgetQueryBuilderをオーバーライドし、型安全なDtoを使うようにする）
     *
     * @param array{searchData: array<string, scalar|array<scalar>|object|null>} $args
     *
     * @return QueryBuilder
     */
    protected function getQueryBuilder(array $args): QueryBuilder
    {
        $searchData = SearchDataDto::fromFormData($args['searchData']);

        return $this->otcBuyOrderRepository->getQueryBuilderBySearchData(
            $searchData,
        );
    }

    /**
     * CSV出力
     *
     * @return Response
     */
    #[
        Route(
            path: '/%eccube_admin_route%/otcbuyorder/export',
            name: 'admin_otcbuyorder_export',
            methods: ['POST'],
        ),
    ]
    public function export(Request $request): Response
    {
        // タイムアウトを無効にする.
        set_time_limit(0);
        $this->isTokenValid();

        // CSV出力タイプを取得.
        $exportType = $request->request->get('export_type');
        if (
            !array_key_exists(
                $exportType,
                OtcBuyOrderCsvExportService::CSV_TYPES,
            )
        ) {
            throw new \InvalidArgumentException('export type not found. exportType: '.$exportType);
        }

        // 選択されたIDを取得.
        $otcBuyOrderIds = array_filter(array_map('intval', $request->request->all('otcBuyOrderIds')));

        if ($otcBuyOrderIds === []) {
            $this->addError($this->translator->trans('admin.purchase.online.csv_export.no_selection'), 'admin');

            $pageNo = $request->getSession()->get('eccube.admin.otcbuyorder.search.page_no', 1);

            return $this->redirectToRoute('admin_otcbuyorder_page', ['page_no' => $pageNo]);
        }

        // 戻しリストCSVのリクエストだった場合、追加validation
        if ($exportType === 'otc_buy_order_restock_list_csv') {
            $errs = $this->otcBuyOrderRestockListService->validateRestockListRequest(
                $otcBuyOrderIds,
                $this->getMember(),
            );
            if (!empty($errs)) {
                foreach ($errs as $error) {
                    $this->addError($error, 'admin');
                }

                $pageNo = $request->getSession()->get('eccube.admin.otcbuyorder.search.page_no', 1);

                return $this->redirectToRoute('admin_otcbuyorder_page', ['page_no' => $pageNo]);
            }
        }

        return $this->otcBuyOrderCsvExportService->exportByIds(
            $exportType,
            $otcBuyOrderIds,
        );
    }

    /**
     * 詳細画面表示
     *
     * @return array<string, mixed>
     */
    #[Template(template: '@admin/OtcBuyOrder/detail.twig')]
    #[
        Route(
            path: '/%eccube_admin_route%/otcbuyorder/{otcBuyOrderId}',
            name: 'admin_otcbuyorder_detail',
            requirements: ['otcBuyOrderId' => "\d+"],
            methods: ['GET'],
        ),
    ]
    public function detail(int $otcBuyOrderId): array
    {
        $OtcBuyOrder = $this->otcBuyOrderRepository->find($otcBuyOrderId);
        if (!$OtcBuyOrder) {
            throw $this->createNotFoundException();
        }

        // 価格降順 → 明細ID昇順
        $OtcBuyOrder->setOtcBuyOrderDetails(
            new ArrayCollection($this->otcBuyOrderDetailRepository->selectForOtcBuyOrderDetail($otcBuyOrderId)),
        );

        $StatusHistories = $this->otcBuyOrderStatusHistoryRepository->findBy(
            ['OtcBuyOrder' => $OtcBuyOrder],
            ['createDate' => 'DESC'],
        );

        /** @var array<int, string> $statusList */
        $statusList = [];
        foreach ($this->otcBuyOrderStatusRepository->findAll() as $Status) {
            $statusList[$Status->getId()] = $Status->getName();
        }

        $form = $this->createForm(OtcBuyOrderDetailType::class, $OtcBuyOrder);

        // 表示テーブル用: カード状態ID昇順 → 買取金額高い順 → 商品規格ID昇順
        $StockDisplayRows = $this->otcBuyOrderStockRepository->selectForStockTable($OtcBuyOrder);

        // 編集テーブル用: 高額商品はそのまま、通常商品は全カード状態(NM/SP/MP/HP)に展開して取得
        $StockEditRows = array_merge(
            $this->productClassRepository->selectHighPriceProductClassByOtcBuyOrder($OtcBuyOrder),
            $this->productClassRepository->selectAllProductClassByOtcBuyOrder($OtcBuyOrder),
        );

        $searchProductModalForm = $this->createForm(SearchProductType::class);

        return [
            'OtcBuyOrder' => $OtcBuyOrder,
            'StatusHistories' => $StatusHistories,
            'statusList' => $statusList,
            'form' => $form->createView(),
            'StockDisplayRows' => $StockDisplayRows,
            'StockEditRows' => $StockEditRows,
            'searchProductModalForm' => $searchProductModalForm->createView(),
        ];
    }


