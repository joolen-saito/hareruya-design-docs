   301	     * assessmentId: string|null,
   302	     * completeDate: string,
   303	     * totalQuantity: int|string,
   304	     * totalPrice: int|string,
   305	     * fullName: string,
   306	     * age: int|null,
   307	     * address: string,
   308	     * identificationType: string|null,
