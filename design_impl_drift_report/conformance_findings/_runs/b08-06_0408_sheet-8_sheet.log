   134	
   135	        try {
   136	            $response = $this->httpClient->request('GET', $url, [
   137	                'headers' => $headers,
   138	                'query' => $query,
   139	                'http_errors' => false,
   140	            ]);
   141	        } catch (\Throwable $e) {
   142	            $this->recordGetFailure($operation, $requestUrl, $headers, $started, $e, $logContext);
