   168	                }
   169	            }
   170	        } catch (\Throwable) {
   171	            $decoded = null;
   172	        }
   173	
   174	        $this->recordSuccess($operation, 'GET', $requestUrl, $headers, '', $statusCode, $responseHeaders, $body, $durationMs, $logContext);
   175	
   176	        return [
