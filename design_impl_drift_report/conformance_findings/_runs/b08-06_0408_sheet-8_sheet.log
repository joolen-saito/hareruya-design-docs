   758	    /**
   759	     * 店頭受取注文 (Delivery::OTC_GROUP) のうち、スマレジ商品/在庫の連携が未完了な受注を返す。
   760	     *
   761	     * 取得条件:
   762	     * - Shipping.Delivery が OTC または SMOOTH_OTC
   763	     * - OrderStatus = NEW (受取前)
   764	     * - smaregi_del_flg = false (削除対象でない)
   765	     * - smaregi_error_flg = false (エラー受注は本バッチでは扱わない)
   766	     * - smaregi_product_flg = false または smaregi_stock_flg = false (いずれかが未連携)
   767	     *
   768	     * 1 受注 = 1 スマレジ商品の前提で、productCode は注文番号+店舗IDから決定論的に採番する。
   769	     *
   770	     * @return list<Order>
   771	     */
   772	    public function findOtcOrdersAwaitingSmaregiSync(int $limit = 100): array
   773	    {
   774	        $qb = $this->createQueryBuilder('o');
   775	        $qb
   776	            ->distinct()
   777	            ->innerJoin(\Eccube\Entity\Shipping::class, 's', 'WITH', 's.Order = o')
   778	            ->where('s.Delivery IN (:deliveryIds)')
   779	            ->andWhere('o.OrderStatus = :orderNew')
   780	            ->andWhere('o.smaregi_del_flg = :flgFalse')
   781	            ->andWhere('o.smaregi_error_flg = :flgFalse')
   782	            ->andWhere($qb->expr()->orX(
   783	                'o.smaregi_product_flg = :flgFalse',
   784	                'o.smaregi_stock_flg = :flgFalse',
   785	            ))
   786	            ->setParameter('deliveryIds', Delivery::OTC_GROUP)
   787	            ->setParameter('orderNew', OrderStatus::NEW)
   788	            ->setParameter('flgFalse', Constant::DISABLED)
   789	            ->orderBy('o.id', 'ASC')
   790	            ->setMaxResults($limit);
   791	
   792	        /** @var list<Order> $result */
   793	        $result = $qb->getQuery()->getResult();
   794	
   795	        return $result;
   796	    }
   797	
   798	    /**
   799	     * 店頭受取注文 (Delivery::OTC_GROUP) のうち `smaregi_code` (= 13桁 productCode) が
   800	     * 指定リストに含まれ、かつ確定済み (CANCEL/DELIVERED/PASSED/RETURNED) でない Order を返す。
   801	     *
   802	     * スマレジ Webhook で受信した取引明細の `productCode` を突合キーに、対応する
   803	     * EC-CUBE 既存 OTC 受注を逆引きするのに使う。Smaregi 側 `productId` は EC-CUBE 側に
   804	     * 保存していないため、両者で共有可能なキーである `productCode` を採用している
   805	     * ({@see \Eccube\Service\Smaregi\Otc\SmaregiOtcOrderSyncService} が
   806	     *  `Order.smaregi_code` に保存する 13 桁インストアコード)。
   807	     *
   808	     * @param list<string> $smaregiCodes
   809	     *
   810	     * @return list<Order>
   811	     */
   812	    public function findOtcOrdersBySmaregiCodes(array $smaregiCodes): array
   813	    {
   814	        if ($smaregiCodes === []) {
   815	            return [];
   816	        }
   817	
   818	        $qb = $this->createQueryBuilder('o');
   819	        $qb
   820	            ->distinct()
   821	            ->innerJoin(\Eccube\Entity\Shipping::class, 's', 'WITH', 's.Order = o')
   822	            ->where('o.smaregi_code IN (:smaregiCodes)')
   823	            ->andWhere('s.Delivery IN (:deliveryIds)')
   824	            // 確定済み (引渡し/出荷完了/キャンセル/返品) の受注は突合対象外。
   825	            // 突合成功後に Pattern Handler が PASSED へ遷移させるため、これを除外しないと
   826	            // 後続取引で productCode が重なった際に処理済み受注を再突合してしまう。
   827	            ->andWhere('o.OrderStatus NOT IN (:excludedStatuses)')
   828	            ->setParameter('smaregiCodes', $smaregiCodes)
   829	            ->setParameter('deliveryIds', Delivery::OTC_GROUP)
   830	            ->setParameter('excludedStatuses', [
   831	                OrderStatus::CANCEL,
   832	                OrderStatus::DELIVERED,
   833	                OrderStatus::PASSED,
   834	                OrderStatus::RETURNED,
   835	            ])
   836	            ->orderBy('o.id', 'ASC');
   837	
   838	        /** @var list<Order> $result */
   839	        $result = $qb->getQuery()->getResult();
   840	
   841	        return $result;
   842	    }
   843	
   844	    /**
   845	     * スマレジ削除対象の受注を取得
   846	     *
   847	     * TODO (パフォーマンス): 現状 dtb_order には smaregi_del_flg / smaregi_code / order_status_id を
   848	     * 含む複合インデックスが無いため、本クエリは全件スキャンになり得る。
   849	     * 受注テーブルが肥大化した時点で部分インデックス
   850	     *   `CREATE INDEX dtb_order_smaregi_delete_idx
   851	     *      ON dtb_order (order_status_id) WHERE smaregi_del_flg = false AND smaregi_code IS NOT NULL`
   852	     * 等の追加を検討する。バッチが日次 4 時実行のため当面は許容範囲を想定。
   853	     *
   854	     * @return list<Order>
   855	     */
   856	    public function getDeleteSmaregiProduct(int $limit = 100): array
   857	    {
   858	        $qb = $this->createQueryBuilder('o');
   859	        $qb
   860	            ->where($qb->expr()->in('o.OrderStatus', ':statusIds'))
   861	            ->andWhere('o.smaregi_code IS NOT NULL')
   862	            ->andWhere('o.smaregi_del_flg = :flgFalse')
   863	            ->setParameter('statusIds', [OrderStatus::CANCEL, OrderStatus::DELIVERED, OrderStatus::PASSED])
   864	            ->setParameter('flgFalse', Constant::DISABLED)
   865	            ->orderBy('o.id', 'ASC')
   866	            ->setMaxResults($limit);
   867	
   868	        /** @var list<Order> $result */
   869	        $result = $qb->getQuery()->getResult();
   870	
   871	        return $result;
   872	    }
   873	
   874	    /**
   875	     * スマレジ連携エラーの受注を取得
   876	     */
   877	    public function getSmaregiErrorOrder(): mixed
   878	    {
   879	        $qb = $this->createQueryBuilder('o');
   880	
   881	        $results = $qb->join('o.Customer', 'c')
   882	            ->join(DtbPlayer::class, 'p', 'WITH', 'c = p.Customer')
   883	            ->select('o', 'p', 'c')
   884	            ->where('o.smaregi_error_flg = 1')
   885	            ->getQuery()
   886	            ->getResult();
   887	
   888	        $orders = [];
   889	        $players = [];
   890	
   891	        foreach ($results as $result) {
   892	            if ($result instanceof Order) {
   893	                $orders[] = $result;
   894	            }
   895	
   896	            if ($result instanceof DtbPlayer) {
   897	                $players[$result->getCustomer()->getId()] = $result;
   898	            }
   899	        }
