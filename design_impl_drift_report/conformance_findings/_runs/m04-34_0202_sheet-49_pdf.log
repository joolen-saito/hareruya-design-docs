   124	     * SQL 由来の行順はグループ内で維持する。
   125	     *
   126	     * @param list<array<string, string|int|null>> $formattedRows RestockListCsvRowFormatter 出力
   127	     *
   128	     * @return MoveTransferListPrintData
   129	     */
   130	    public function buildListDataFromCsvFormattedRows(array $formattedRows): array
   131	    {
   132	        // pickingType を閾値ラベルとしてグループ化する
   133	        $rowsByThresholdLabel = [];
   134	        foreach ($formattedRows as $formattedRow) {
   135	            $thresholdLabel = (string) ($formattedRow['pickingType'] ?? '');
   136	            if (!array_key_exists($thresholdLabel, $rowsByThresholdLabel)) {
   137	                $rowsByThresholdLabel[$thresholdLabel] = [];
   138	            }
   139	            $rowsByThresholdLabel[$thresholdLabel][] = $formattedRow;
   140	        }
   141	
   142	        // 各グループを印刷ページへ分割する
   143	        $groups = [];
   144	        foreach ($rowsByThresholdLabel as $thresholdLabel => $rows) {
   145	            $groups[] = [
   146	                'thresholdLabel' => $thresholdLabel,
   147	                'pages' => $this->buildPrintPagesForThresholdGroup($rows),
   148	            ];
   149	        }
   150	
   151	        return [
   152	            'createdAt' => (new \DateTime('now', new \DateTimeZone('Asia/Tokyo')))->format('Y/m/d H:i:s'),
   153	            'maxPageRows' => self::MAX_PAGE_ROWS,
   154	            'groups' => $groups,
   155	        ];
   156	    }
   157	
   158	    /**
   159	     * 1 閾値グループ分の整形済み行を、印刷ページ単位に分割する。
   160	     *
   161	     * @param list<array<string, string|int|null>> $formattedRows 同一 thresholdLabel の行
   162	     *
   163	     * @return list<MoveTransferListPrintPage>
   164	     */
   165	    private function buildPrintPagesForThresholdGroup(array $formattedRows): array
   166	    {
   167	        if ($formattedRows === []) {
   168	            return [];
   169	        }
   170	
   171	        $pageChunks = array_chunk($formattedRows, self::MAX_PAGE_ROWS);
   172	        $totalPages = count($pageChunks);
   173	        $pages = [];
   174	
   175	        foreach ($pageChunks as $pageIndex => $pageRows) {
   176	            $items = [];
   177	            $pageQuantitySubtotal = 0;
   178	
   179	            foreach ($pageRows as $rowIndex => $formattedRow) {
   180	                $items[] = [
   181	                    'rowNo' => $rowIndex + 1,
   182	                    'remarks' => '',
   183	                ] + array_diff_key($formattedRow, ['pickingType' => true]);
   184	
   185	                $pageQuantitySubtotal += (int) ($formattedRow['quantity'] ?? 0);
   186	            }
   187	
   188	            $pages[] = [
   189	                'currentPage' => $pageIndex + 1,
   190	                'totalPages' => $totalPages,
   191	                'items' => $items,
   192	                'pageQuantitySubtotal' => $pageQuantitySubtotal,
   193	            ];
   194	        }
   195	
   196	        return $pages;
   197	    }
   198	}

