    29	 */
    30	class DtbStockMoveTransferRepository extends AbstractRepository
    31	{
    32	    /** ピック表出力 */
    33	    public const LIST_EXPORT_TYPE_PICK = 'pick';
    34	
    35	    /** 戻しリスト出力 */
    36	    public const LIST_EXPORT_TYPE_RETURN = 'return';
    37	
    38	    public function __construct(ManagerRegistry $registry)
    39	    {
    40	        parent::__construct($registry, DtbStockMoveTransfer::class);
    41	    }
    42	
    43	    /**
    44	     * 在庫移動・振替一覧の検索条件でQueryBuilderを返す.
    45	     *
    46	     * @param array<string, mixed> $searchData
    47	     */
    48	    public function getQueryBuilderBySearchData(array $searchData): QueryBuilder
    49	    {
    50	        $qb = $this->createQueryBuilder('s')
    51	            ->select('s')
    52	            ->leftJoin('s.MoveFromBaseInfo', 'fromBase')->addSelect('fromBase')
    53	            ->leftJoin('s.MoveToBaseInfo', 'toBase')->addSelect('toBase')
    54	            ->leftJoin('s.MoveTransferStatus', 'st')->addSelect('st')
    55	            ->leftJoin('s.RegisteredMember', 'reg')->addSelect('reg')
    56	            ->orderBy('s.createDate', 'DESC')
    57	            ->addOrderBy('s.id', 'DESC');
    58	
    59	        $stockMoveTransferId = isset($searchData['stock_move_transfer_id']) ? trim((string) $searchData['stock_move_transfer_id']) : '';
    60	        if ($stockMoveTransferId !== '') {
    61	            if (ctype_digit($stockMoveTransferId)) {
    62	                $qb->andWhere('s.id = :smt_id_exact')
    63	                    ->setParameter('smt_id_exact', (int) $stockMoveTransferId);
    64	            } else {
    65	                $qb->andWhere('CONCAT(s.id, \'\') LIKE :smt_id_like')
    66	                    ->setParameter('smt_id_like', '%'.addcslashes($stockMoveTransferId, '%_').'%');
    67	            }
    68	        }
    69	
    70	        $moveInstructionId = isset($searchData['move_instruction_id']) ? trim((string) $searchData['move_instruction_id']) : '';
    71	        if ($moveInstructionId !== '') {
    72	            $qb->andWhere('s.moveInstructionId IS NOT NULL AND CONCAT(s.moveInstructionId, \'\') LIKE :move_instr_like')
    73	                ->setParameter('move_instr_like', '%'.addcslashes($moveInstructionId, '%_').'%');
    74	        }
    75	
    76	        $trackingNo = isset($searchData['tracking_no']) ? trim((string) $searchData['tracking_no']) : '';
    77	        if ($trackingNo !== '') {
    78	            $qb->andWhere('s.trackingNo LIKE :trk')
    79	                ->setParameter('trk', '%'.addcslashes($trackingNo, '%_').'%');
    80	        }
    81	
    82	        if (!empty($searchData['move_from_base_info']) && !$searchData['move_from_base_info']->isEmpty()) {
    83	            $qb->andWhere('s.MoveFromBaseInfo IN (:move_from_bi)')
    84	                ->setParameter('move_from_bi', $searchData['move_from_base_info']);
    85	        }
    86	
    87	        if (!empty($searchData['move_to_base_info']) && !$searchData['move_to_base_info']->isEmpty()) {
    88	            $qb->andWhere('s.MoveToBaseInfo IN (:move_to_bi)')
    89	                ->setParameter('move_to_bi', $searchData['move_to_base_info']);
    90	        }
    91	
    92	        if (!empty($searchData['move_from_stock_location_id'])) {
    93	            $qb->andWhere('s.moveFromStockLocationId IN (:mfrom_loc)')
    94	                ->setParameter('mfrom_loc', $searchData['move_from_stock_location_id']);
    95	        }
    96	
    97	        if (!empty($searchData['move_to_stock_location_id'])) {
    98	            $qb->andWhere('s.moveToStockLocationId IN (:mto_loc)')
    99	                ->setParameter('mto_loc', $searchData['move_to_stock_location_id']);
   100	        }
   101	
   102	        if (!empty($searchData['move_transfer_type'])) {
   103	            $qb->andWhere('s.moveTransferType IN (:mtt)')
   104	                ->setParameter('mtt', $searchData['move_transfer_type']);
   105	        }
   106	
   107	        if (!empty($searchData['move_transfer_status'])) {
   108	            $qb->andWhere('s.MoveTransferStatus IN (:mts)')
   109	                ->setParameter('mts', $searchData['move_transfer_status']);
   110	        }
   111	
   112	        if (!empty($searchData['create_date_start'])) {
   113	            $start = $searchData['create_date_start'];
   114	            $qb->andWhere('s.createDate >= :cstart')
   115	                ->setParameter('cstart', $start);
   116	        }
   117	
   118	        if (!empty($searchData['create_date_end'])) {
   119	            $end = $searchData['create_date_end'];
   120	            $end = $end instanceof \DateTimeImmutable ? $end->modify('+1 day') : (clone $end)->modify('+1 day');
   150	        }
   151	
   152	        if (!empty($searchData['move_to_stock_date_start'])) {
   153	            $qb->andWhere('s.moveToStockAt >= :mts_start')
   154	                ->setParameter('mts_start', $searchData['move_to_stock_date_start']);
   155	        }
   156	
   157	        if (!empty($searchData['move_to_stock_date_end'])) {
   158	            $end = $searchData['move_to_stock_date_end'];
   159	            $end = $end instanceof \DateTimeImmutable ? $end->modify('+1 day') : (clone $end)->modify('+1 day');
   160	            $qb->andWhere('s.moveToStockAt < :mts_end')
   161	                ->setParameter('mts_end', $end);
   162	        }
   163	
   164	        return $qb;
   165	    }
