   167	    /**
   168	     * ピック表・戻しリスト出力用データ取得
   169	     *
   170	     * - ピック表: 出庫元在庫（move_from_product_stock）を集計し、出庫元店舗の閾値でソート。欠品点数を差し引く。
   171	     * - 戻しリスト: 入庫先在庫（move_to_product_stock）を集計し、入庫先店舗の閾値でソート。
   172	     *
   173	     * @param array<int, int> $stockMoveTransferIds
   174	     *
   175	     * @return iterable<int, array<string, mixed>>
   176	     */
   177	    public function getListExportRows(array $stockMoveTransferIds, string $listExportType): iterable
   178	    {
   179	        if ($stockMoveTransferIds === []) {
   180	            return new \ArrayIterator([]);
   181	        }
   182	
   183	        if ($listExportType === self::LIST_EXPORT_TYPE_PICK) {
   184	            $productStockJoinColumn = 'd.move_from_product_stock_id';
   185	            $baseInfoJoinColumn = 'smt.move_from_base_info_id';
   186	            $quantityExpression = 'd.move_transfer_quantity - COALESCE(d.stockout_quantity, 0)';
   187	            $havingClause = 'HAVING SUM('.$quantityExpression.') > 0';
   188	        } elseif ($listExportType === self::LIST_EXPORT_TYPE_RETURN) {
   189	            $productStockJoinColumn = 'd.move_to_product_stock_id';
   190	            $baseInfoJoinColumn = 'smt.move_to_base_info_id';
   191	            $quantityExpression = 'd.move_transfer_quantity';
   192	            $havingClause = '';
   193	        } else {
   194	            throw new \InvalidArgumentException('Invalid list export type: '.$listExportType);
   195	        }
   196	
   197	        $connection = $this->getEntityManager()->getConnection();
   198	        $connection->executeStatement("SET TIME ZONE 'Asia/Tokyo'");
   199	
   200	        $sql = <<<SQL
   201	            SELECT
   202	                p.name AS "rawProductName",
   203	                sc.name AS "storageCodeName",
   204	                lng.code AS "languageCode",
   205	                cond.code AS "conditionCode",
   206	                (
   207	                    SELECT STRING_AGG(cl.name_jp, '' ORDER BY cl.id)
   208	                    FROM dtb_card_color dcc
   209	                    JOIN mtb_color cl ON cl.id = dcc.color_id
   210	                    WHERE dcc.card_id = c.id
   211	                ) AS "colorName",
   212	                r.code AS "rarityCode",
   213	                COALESCE(cd.foil_flg, 0) AS "foilFlg",
   214	                SUM({$quantityExpression}) AS "quantity",
   215	                pc.standard_price AS "standardPrice",
   216	                bi.expensive_threshold1 AS "threshold1",
   217	                bi.expensive_threshold2 AS "threshold2",
   218	                bi.expensive_threshold3 AS "threshold3",
   219	                -- カテゴリ判定を EXISTS に分離: 1:N JOIN による数量重複を防ぐ
   220	                CASE WHEN EXISTS (
   221	                    SELECT 1 FROM dtb_product_category pcat
   222	                    WHERE pcat.product_id = p.id
   223	                      AND pcat.category_id IN (:goods_category_id, :reserved_goods_category_id)
   224	                ) THEN 1 ELSE 0 END AS "isSupply",
   225	                -- ピッキング区分ソート: 円未満(1) → 円以上~円未満(2) → 円以上(3) → サプライ(99)
   226	                CASE
   227	                    WHEN EXISTS (
   228	                        SELECT 1 FROM dtb_product_category pcat
   229	                        WHERE pcat.product_id = p.id
   230	                          AND pcat.category_id IN (:goods_category_id, :reserved_goods_category_id)
   231	                    ) THEN 99
   232	                    ELSE
   233	                        (
   234	                            (CASE WHEN bi.expensive_threshold1 IS NOT NULL AND pc.standard_price >= bi.expensive_threshold1 THEN 1 ELSE 0 END)
   235	                            + (CASE WHEN bi.expensive_threshold2 IS NOT NULL AND pc.standard_price >= bi.expensive_threshold2 THEN 1 ELSE 0 END)
   236	                            + (CASE WHEN bi.expensive_threshold3 IS NOT NULL AND pc.standard_price >= bi.expensive_threshold3 THEN 1 ELSE 0 END)
   237	                        ) + 1
   238	                END AS "pickingTypeSort",
   239	                sn.name AS "shelfNumberName",
   240	                bi.id AS "baseInfoId",
   241	                -- 棚番ソート: 本店のみ棚番順、支店は棚番によるソートを行わない（全て0で同順）
   242	                CASE WHEN bi.id = :main_store_id THEN COALESCE(sn.sort_no, 99999) ELSE 0 END AS "shelfSort",
   243	                -- 言語ソート: mtb_language.id 昇順（日→英→他言語はマスターの並び順に依存）
   244	                COALESCE(lng.id, 99999) AS "languageSort",
   245	                -- 状態ソート: mtb_card_condition.id 昇順（NM→HP はマスターの並び順に依存）
   246	                COALESCE(pc.card_condition_id, 99999) AS "conditionSort",
   247	                -- Foilソート: 非Foil(0)→Foil(1以上)
   248	                COALESCE(cd.foil_flg, 0) AS "foilSort",
   249	                -- 略称タグソート: mtb_storage_code.rank 昇順
   250	                COALESCE(sc.rank, 99999) AS "storageCodeSort",
   251	                -- レアリティソート: mtb_rarity.sort_no 昇順（M→C はマスターの並び順に依存）
   252	                COALESCE(r.sort_no, 99999) AS "raritySort",
   253	                -- 色ソート: mtb_card.color_sequence_id → mtb_color_sequence.sort_no 昇順
   254	                COALESCE(cs.sort_no, 99999) AS "colorSort",
   255	                -- カードソート: alphabet_sort_flgがtrueの略称タグ→英語カード名昇順、falseならコレクター番号昇順
   256	                CASE WHEN sc.alphabet_sort_flg = true THEN c.name_en ELSE cd.card_no END AS "cardSort"
   257	            FROM dtb_stock_move_transfer_detail d
   258	            JOIN dtb_stock_move_transfer smt ON smt.id = d.stock_move_transfer_id
   259	            JOIN dtb_product_stock ps ON ps.id = {$productStockJoinColumn}
   260	            JOIN dtb_base_info bi ON bi.id = {$baseInfoJoinColumn}
   261	            JOIN dtb_product_class pc ON pc.id = ps.product_class_id
   262	            JOIN dtb_product p ON p.id = pc.product_id
   263	            LEFT JOIN mtb_card_condition cond ON cond.id = pc.card_condition_id
   264	            LEFT JOIN mtb_storage_code sc ON sc.id = p.storage_code_id
   265	            LEFT JOIN mtb_card_detail cd ON cd.id = p.card_detail_id
   266	            LEFT JOIN mtb_rarity r ON r.id = cd.rarity_id
   267	            LEFT JOIN mtb_language lng ON lng.id = pc.language_id
   268	            LEFT JOIN mtb_card c ON c.id = cd.card_id
   269	            LEFT JOIN mtb_color_sequence cs ON cs.id = c.color_sequence_id
   270	            LEFT JOIN dtb_shelf_number sn ON sn.id = pc.shelf_number_id
   271	            WHERE
   272	                smt.id IN (:ids)
   273	            GROUP BY
   274	                pc.id, p.id, p.name, sc.name, sc.rank, sc.alphabet_sort_flg,
   275	                lng.id, lng.code, cond.code, r.code, r.sort_no,
   276	                cd.foil_flg, cd.card_no, pc.standard_price,
   277	                bi.id, bi.expensive_threshold1, bi.expensive_threshold2, bi.expensive_threshold3,
   278	                c.id, c.name_en, c.color_sequence_id,
   279	                cs.sort_no, sn.sort_no, sn.name
   280	            {$havingClause}
   281	            ORDER BY
   282	                -- 1. ピッキング区分: 円未満→円以上〜円未満→円以上→サプライ
   283	                "pickingTypeSort" ASC,
   284	                -- 2. 棚番: 本店のみ棚番順、支店は棚番によるソートを行わない（全て0で同順）
   285	                "shelfSort" ASC,
   286	                -- 3. 言語: 日→英→他言語
   287	                "languageSort" ASC,
   288	                -- 4. 状態: NM→HP
   289	                "conditionSort" ASC,
   290	                -- 5. Foilフラグ: 非Foil→Foil
   291	                "foilSort" ASC,
   292	                -- 6. 略称タグ: 昇順
   293	                "storageCodeSort" ASC,
   294	                -- 7. レアリティ: M→C
   295	                "raritySort" ASC,
   296	                -- 8. 色: マスターデータ色順（mtb_color_sequence.sort_no）
   297	                "colorSort" ASC,
   298	                -- 9. 略称タグがアルファベットソートなら英語カード名昇順、コレクター番号ソートならcard_no昇順
   299	                "cardSort" ASC
   300	        SQL;
   301	
   302	        return $connection->iterateAssociative(
   303	            $sql,
   304	            [
   305	                'ids' => $stockMoveTransferIds,
   306	                'goods_category_id' => Category::GOODS_ID,
   307	                'reserved_goods_category_id' => Category::RESERVED_GOODS_ID,
   308	                'main_store_id' => BaseInfo::TC_TOKYO_ID,
   309	            ],
   310	            [
   311	                'ids' => ArrayParameterType::INTEGER,
   312	                'goods_category_id' => \PDO::PARAM_INT,
   313	                'reserved_goods_category_id' => \PDO::PARAM_INT,
   314	                'main_store_id' => \PDO::PARAM_INT,
   315	            ]
   316	        );
   317	    }
