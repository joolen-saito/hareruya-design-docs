   103	            return [
   104	                'createdAt' => (new \DateTime('now', new \DateTimeZone('Asia/Tokyo')))->format('Y/m/d H:i:s'),
   105	                'maxPageRows' => self::MAX_PAGE_ROWS,
   106	                'groups' => [],
   107	            ];
   108	        }
   109	
   110	        $csvFormattedRows = $this->restockListCsvRowFormatter->iterateFormattedRows(
