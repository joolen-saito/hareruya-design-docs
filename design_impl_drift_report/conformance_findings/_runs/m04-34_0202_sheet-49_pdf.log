    55	    public const MAX_PAGE_ROWS = 30;
    56	
    57	    public function __construct(
    58	        private readonly DtbStockMoveTransferRepository $stockMoveTransferRepository,
    59	        private readonly RestockListCsvRowFormatter $restockListCsvRowFormatter,
    60	    ) {
    61	    }
    62	
    63	    /**
    64	     * 在庫移動振替 ID から戻しリスト印刷用データ（Twig の ReturnList）を組み立てる。
    65	     *
    66	     * Repository で行を取得し RestockListCsvRowFormatter で整形したうえで、
    67	     * {@see buildListDataFromCsvFormattedRows()} に委譲する。
    68	     *
    69	     * @param array<int, int> $stockMoveTransferIds
    70	     *
    71	     * @return MoveTransferListPrintData
    72	     */
    73	    public function buildReturnListDataByStockMoveTransferIds(array $stockMoveTransferIds): array
    74	    {
    75	        if ($stockMoveTransferIds === []) {
    76	            return [
    77	                'createdAt' => (new \DateTime('now', new \DateTimeZone('Asia/Tokyo')))->format('Y/m/d H:i:s'),
    78	                'maxPageRows' => self::MAX_PAGE_ROWS,
