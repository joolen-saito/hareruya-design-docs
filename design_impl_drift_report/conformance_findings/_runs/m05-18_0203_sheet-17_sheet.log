    65	    /**
    66	     * 複数の販売種別から配送業者を取得
    67	     *
    68	     * @param array<int, SaleType> $saleTypes
    69	     * @param BaseInfo|null $baseInfo
    70	     *
    71	     * @return array<int, Delivery>
    72	     */
    73	    public function getDeliveries(array $saleTypes, ?BaseInfo $baseInfo = null): array
    74	    {
    75	        $qb = $this->createQueryBuilder('d')
    76	            ->where('d.SaleType in (:saleTypes)')
    77	            ->andWhere('d.visible = :visible')
    78	            ->setParameter('saleTypes', $saleTypes)
    79	            ->setParameter('visible', true)
    80	        ;
    81	        if ($baseInfo) {
    82	            $qb->andWhere('d.baseInfo = :baseInfo')
    83	                ->setParameter('baseInfo', $baseInfo);
    84	        }
    85	        $qb->orderBy('d.sort_no', 'DESC')
    86	            ->getQuery()
    87	            ->getResult();
    88	
    89	        return $qb->getQuery()->getResult();
    90	    }

