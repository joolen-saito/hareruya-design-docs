   133	
   134	if (typeof Ladda !== 'undefined') {
   135	    // a[token-for-anchor] を押下されるとJavaScriptで formを作成してPOSTする仕様になっていて、
   136	    // aタグにdisable属性を付与しても駄目（form生成&postしてしまう）だったので、cssでpointer-event:none;しています。
   137	    // https://github.com/EC-CUBE/ec-cube/pull/5971
   138	    Ladda.bind('button[type=submit],a[token-for-anchor]', {timeout: 2000});
   139	    $('button[type=submit].btn-ec-regular').attr('data-spinner-color', '#595959');
   140	}
   141	
   142	// anchorをクリックした時にformを裏で作って指定のメソッドでリクエストを飛ばす
   143	// Twigには以下のように埋め込む
   144	// <a href="PATH" {{ csrf_token_for_anchor() }} data-method="(put/delete/postのうちいずれか)" data-confirm="xxxx" data-message="xxxx">
   145	//
   146	// オプション要素
   147	// data-confirm : falseを定義すると確認ダイアログを出さない。デフォルトはダイアログを出す
   148	// data-message : 確認ダイアログを出す際のメッセージをデフォルトから変更する
   149	//
   150	$(function() {
   151	    var createForm = function(action, data) {
   152	        var $form = $('<form action="' + action + '" method="post"></form>');
   153	        for (input in data) {
   154	            if (data.hasOwnProperty(input)) {
   155	                $form.append('<input name="' + input + '" value="' + data[input] + '">');
   156	            }
   157	        }
   158	        return $form;
   159	    };
   160	
   161	    $('a[token-for-anchor]').click(function(e) {
   162	        e.preventDefault();
   163	        var $this = $(this);
   164	        $this.css('pointer-events','none');
   165	        var data = $this.data();
   166	        if (data.confirm != false) {
   167	            if (!confirm(data.message ? data.message : '削除してもよろしいですか?')) {
   168	                $this.css('pointer-events', '');
   169	                return false;
   170	            }
   171	        }
   172	
   173	        var $form = createForm($this.attr('href'), {
   174	            _token: $this.attr('token-for-anchor'),
   175	            _method: data.method
   176	        }).hide();
   177	
   178	        $('body').append($form); // Firefox requires form to be on the page to allow submission
   179	        $form.submit();
   180	    });
   181	
   182	    /**
   183	     * 検索条件をクリア
   184	     * 各検索画面の検索条件をクリアをクリック時に発火させる
   185	     * フォーム#search_form内の検索項目（.input_search, .search-box-inner内のinput/select）の値をリセット
   186	     */
   187	    $('.search-clear').click(function (event) {
   188	        event.preventDefault();
   189	        $('#search_form .input_search, .search-box-inner input, .search-box-inner select').each(function () {
   190	            if (this.type === 'checkbox' || this.type === 'radio') {
   191	                this.checked = false;
   192	            } else {
   193	                if (this.type === 'hidden') {
   194	                    if (!this.name.match(/_token/i)) {
   195	                        $(this).val('');
   196	                    }
   197	                } else {
   198	                    $(this).val('');
   199	                }
   200	            }
   201	            $('li.select2-selection__choice').remove();
