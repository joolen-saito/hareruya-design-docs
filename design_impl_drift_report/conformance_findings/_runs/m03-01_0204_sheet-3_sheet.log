   172	                    dataClass[productId] = data;
   173	                    renderClass(dataClass[productId], btnClass);
   174	                }).fail(function() {
   175	                    alert('Failed');
   176	                });
   177	            });
   178	
   179	            // Append html and show popup
   180	            function renderClass(data, btnClass) {
   181	                $('div.modal-body', modalClass).html(data);
   182	                $('h5.modal-title', modalClass).text(btnClass.data('message'));
   183	                $('a.btn-ec-conversion', modalClass).attr('href', btnClass.data('class-url'));
   184	                modalClass.modal('show');
   185	                btnClass.attr('disabled', false);
   186	            }
   187	
   188	            const searchDetailEl = document.getElementById('searchDetail');
   189	            const searchDetailToggleBtn = document.querySelector('[data-bs-target="#searchDetail"]');
   190	            if (searchDetailEl && searchDetailToggleBtn) {
   191	                const toggleExpanded = searchDetailToggleBtn.querySelector('.admin-product-search-detail-toggle-expanded');
   192	                const toggleCollapsed = searchDetailToggleBtn.querySelector('.admin-product-search-detail-toggle-collapsed');
   193	                searchDetailEl.addEventListener('shown.bs.collapse', function () {
   194	                    if (toggleExpanded) { toggleExpanded.classList.remove('d-none'); }
   195	                    if (toggleCollapsed) { toggleCollapsed.classList.add('d-none'); }
   196	                    searchDetailToggleBtn.setAttribute('aria-expanded', 'true');
   197	                });
   198	                searchDetailEl.addEventListener('hidden.bs.collapse', function () {
   199	                    if (toggleExpanded) { toggleExpanded.classList.add('d-none'); }
   200	                    if (toggleCollapsed) { toggleCollapsed.classList.remove('d-none'); }
   201	                    searchDetailToggleBtn.setAttribute('aria-expanded', 'false');
   202	                });
   203	            }
   204	        });
   205	    </script>
   206	{% endblock javascript %}
