  1007	    public function getQueryBuilderBySearchDataForAdmin(array $searchData): QueryBuilder
  1008	    {
  1009	        $qb = $this->createQueryBuilder('p')
  1010	            ->addSelect('pc', 'tr', 'ps', 'cd', 'pi')
  1011	            ->innerJoin('p.ProductClasses', 'pc')
  1012	            ->leftJoin('pc.TaxRule', 'tr')
  1013	            ->leftJoin('pc.ProductStock', 'ps')
  1014	            ->leftJoin('p.CardDetail', 'cd')
  1015	            ->leftJoin('p.ProductImage', 'pi');
  1016	
  1017	        $likeContains = static fn (string $s): string => '%'.str_replace(['%', '_'], ['\\%', '\\_'], $s).'%';
  1018	
  1019	        // product_name 商品名（項目別）
  1020	        if (isset($searchData['product_name']) && StringUtil::isNotBlank($searchData['product_name'])) {
  1021	            $pnLike = $likeContains($searchData['product_name']);
  1022	            $qb->andWhere('p.name LIKE :adminSearchProductName')
  1023	                ->setParameter('adminSearchProductName', $pnLike);
  1024	        }
  1025	
  1026	        // card_name カード名（項目別）
  1027	        if (isset($searchData['card_name']) && StringUtil::isNotBlank($searchData['card_name'])) {
  1028	            $cardLike = $likeContains($searchData['card_name']);
  1029	            $cardNameSub = $this->getEntityManager()->createQueryBuilder();
  1030	            $cardNameSub->select('1')
  1031	                ->from(Product::class, 'p_card')
  1032	                ->leftJoin('p_card.CardDetail', 'cd_card')
  1033	                ->leftJoin('cd_card.Card', 'ca_card')
  1034	                ->where('p_card = p')
  1035	                ->andWhere('ca_card.name_jp LIKE :adminSearchCardName');
  1036	            $qb
  1037	                ->andWhere($qb->expr()->exists($cardNameSub->getDQL()))
  1038	                ->setParameter('adminSearchCardName', $cardLike);
  1039	        }
  1040	
  1041	        // product_id 商品ID（項目別・部分一致）
  1042	        if (isset($searchData['product_id']) && StringUtil::isNotBlank($searchData['product_id'])) {
  1043	            $raw = trim((string) $searchData['product_id']);
  1044	            if (preg_match('/^\d{1,10}$/', $raw)) {
  1045	                $qb->andWhere("CONCAT('', p.id) LIKE :adminSearchProductTableIdLike")
  1046	                    ->setParameter('adminSearchProductTableIdLike', $likeContains($raw));
  1047	            }
  1048	        }
  1049	
  1050	        // product_code 商品コード（項目別・規格コード部分一致。外側の pc を絞り一覧の規格行と一致させる）
  1051	        if (isset($searchData['product_code']) && StringUtil::isNotBlank($searchData['product_code'])) {
  1052	            $codeLike = $likeContains(trim((string) $searchData['product_code']));
  1053	            $qb
  1054	                ->andWhere('pc.code LIKE :adminSearchProductCodeLike')
  1055	                ->setParameter('adminSearchProductCodeLike', $codeLike);
  1056	        }
  1057	
  1058	        // id キーワード（従来・商品ID・名称・規格コード・カード名への一括 OR）
  1059	        if (isset($searchData['id']) && StringUtil::isNotBlank($searchData['id'])) {
  1060	            $id = preg_match('/^\d{0,10}$/', (string) $searchData['id']) ? $searchData['id'] : null;
  1061	            $qb
  1062	                ->leftJoin('cd.Card', 'ca')
  1063	                ->andWhere('p.id = :id OR p.name LIKE :likeid OR p.name_en LIKE :likeid OR pc.code LIKE :likeid OR ca.name_jp LIKE :likeid OR ca.name_en LIKE :likeid')
  1064	                ->setParameter('id', $id)
  1065	                ->setParameter('likeid', '%'.str_replace(['%', '_'], ['\\%', '\\_'], $searchData['id']).'%');
  1066	        }
  1067	
  1068	        // category カテゴリ
  1069	        if (isset($searchData['category_id']) && $this->isAdminSearchFieldActive($searchData['category_id'])) {
  1070	            // 複数カテゴリ選択に対応
  1071	            $Categories = [];
  1072	            foreach ($searchData['category_id'] as $category) {
  1073	                $Categories = array_merge($Categories, $category->getSelfAndDescendants());
  1074	            }
  1075	            $Categories = array_unique($Categories);
  1076	            // memo:単数選択から複数選択に変更したため、参考情報として改修前の状態をコメントアウトで残す
