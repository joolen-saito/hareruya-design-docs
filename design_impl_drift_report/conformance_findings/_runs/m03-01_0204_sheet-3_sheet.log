   156	    /**
   157	     * 人気商品リコメンド取得
   158	     */
   159	    public function getPopularProductRecommend(int $currentBaseInfoId, int $limit = 30): mixed
   160	    {
   161	        // サブクエリ セール帯・通常版・日本語・非FOILを各キーとして優先表示
   162	        $sqlPriority = <<<SQL
   163	        CONCAT(
   164	            CASE WHEN pc.sale_flg = :isSale THEN '1' ELSE '0' END,
   165	            CASE WHEN pr.id = :nonPromotion THEN '1' ELSE '0' END,
   166	            CASE WHEN l.id = :japanese THEN '1' ELSE '0' END,
   167	            CASE WHEN cd.foil_flg = :nonFoil THEN '1' ELSE '0' END
   168	        ) AS priority
   169	        SQL;
   170	        $priorities = $this->createQueryBuilder('sq')
   171	            ->select(['pc.id AS productClassId', 'p.id AS productId', 'l.id AS languageId', $sqlPriority])
   172	            ->innerJoin('sq.BaseInfo', 'bi')
   173	            ->innerJoin('sq.ProductClass', 'pc')
   174	            ->innerJoin('pc.Product', 'p')
   175	            ->innerJoin('pc.Language', 'l')
   176	            ->innerJoin('pc.ProductStock', 'ps')
   177	            ->innerJoin('ps.baseInfo', 'psbi')
   178	            ->innerJoin('p.CardDetail', 'cd')
   179	            ->innerJoin('cd.Card', 'c')
   180	            ->innerJoin('cd.Promotion', 'pr')
   181	            ->where('bi.id = :baseInfoId')
   182	            ->andWhere('psbi.id = :currentBaseInfoId')
   183	            ->andWhere('ps.stock > 0')
   184	            ->setParameter('baseInfoId', self::POPULAR_PRODUCT_RECOMMEND_SHOP_ID)
   185	            ->setParameter('currentBaseInfoId', $currentBaseInfoId)
   186	            ->setParameter('isSale', ProductClass::SALE)
   187	            ->setParameter('japanese', MtbLanguage::JP_ID)
   188	            ->setParameter('nonPromotion', MtbPromotion::NON_PROMOTION_ID)
   189	            ->setParameter('nonFoil', MtbCardDetail::NON_FOIL)
   190	            ->orderBy('priority', 'ASC')
   191	            ->getQuery()
   192	            ->getResult();
   193	
   194	        $targetProductId = [];
   195	        foreach ($priorities as $priority) {
   196	            // priorityの昇順で並んだものを上書きするので、最終的に最もpriority高いものが残る
   197	            $targetProductId[$priority['productId'].'/'.$priority['languageId']] = $priority['productClassId'];
   198	        }
   199	
   200	        // 在庫があるもののうち、上位30件を表示
   201	        return $this->createQueryBuilder('sq')
   202	            ->select([
   203	                'p.id AS productId',
   204	                'p.name AS productName',
   205	                'pc.sale_flg AS saleFlg',
   206	                'pc.price02 AS price',
   207	                'pi.file_name AS fileName',
   208	                'l.code AS languageCode',
   209	                'cd.foil_flg AS foilFlg',
   210	                'SUM(sqs.sales_quantity_04) AS sum',
   211	            ])
   212	            ->groupBy('p.id', 'p.name', 'pc.sale_flg', 'pc.price02', 'pi.file_name', 'pc.Language', 'l.code', 'cd.foil_flg')
   213	            ->innerJoin('sq.ProductClass', 'pc')
   214	            ->innerJoin('pc.Product', 'p')
   215	            ->innerJoin('pc.Language', 'l')
   216	            ->innerJoin('p.ProductClasses', 'pcs', Join::WITH, 'pc.Language = pcs.Language')
   217	            ->innerJoin('pcs.ShopSalesQuantities', 'sqs', Join::WITH, 'sqs.BaseInfo = :baseInfoId')
   218	            ->leftJoin('pc.ProductClassImages', 'pci')
   219	            ->leftJoin('pci.ProductImage', 'pi')
   220	            ->innerJoin('p.CardDetail', 'cd')
