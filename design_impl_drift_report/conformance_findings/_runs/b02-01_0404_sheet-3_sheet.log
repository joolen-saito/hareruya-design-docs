   231	    /**
   232	     * 指定支店(base_info_id) の週間販売数 (sales_quantity_04) 上位の ProductClass を取得する。
   233	     * 支店ECTOP「今週の売れ筋商品」向け。公開商品・在庫1以上・ロケール一致を満たすもののみ。
   234	     *
   235	     * @return ProductClass[]
   236	     */
   237	    public function findTopSellingProductsByBaseInfo(int $baseInfoId, string $locale, int $limit): array
   238	    {
   239	        $rows = $this->createQueryBuilder('sq')
   240	            ->select('p.id AS productId')
   241	            ->addSelect('SUM(sq.sales_quantity_04) AS HIDDEN weeklyQuantity')
   242	            ->innerJoin('sq.ProductClass', 'pc')
   243	            ->innerJoin('pc.Product', 'p')
   244	            ->innerJoin('pc.ProductStock', 'ps')
   245	            ->innerJoin('ps.baseInfo', 'psbi')
   246	            ->leftJoin('p.RegionRestriction', 'rr')
   247	            ->where('sq.BaseInfo = :baseInfoId')
   248	            ->andWhere('psbi.id = :baseInfoId')
   249	            ->andWhere('ps.stock > 0')
   250	            ->andWhere('pc.visible = true')
   251	            ->andWhere('p.Status = :statusShow')
   252	            ->andWhere('(rr.display_locale_list IS NULL OR rr.display_locale_list LIKE :locale)')
   253	            ->andWhere('sq.sales_quantity_04 > 0')
   254	            ->groupBy('p.id')
   255	            ->orderBy('weeklyQuantity', 'DESC')
   256	            ->setMaxResults($limit)
   257	            ->setParameter('baseInfoId', $baseInfoId)
   258	            ->setParameter('statusShow', ProductStatus::DISPLAY_SHOW)
   259	            ->setParameter('locale', '%'.$locale.'%')
   260	            ->getQuery()
   261	            ->getResult();
   262	
   263	        $productIds = array_map(static fn (array $row): int => (int) $row['productId'], $rows);
   264	        if ($productIds === []) {
   265	            return [];
   266	        }
   267	
   268	        /** @var ProductClass[] $candidates */
   269	        $candidates = $this->getEntityManager()->createQueryBuilder()
   270	            ->select('pc', 'p')
   271	            ->from(ProductClass::class, 'pc')
   272	            ->innerJoin('pc.Product', 'p')
   273	            ->where('p.id IN (:ids)')
   274	            ->andWhere('pc.visible = true')
   275	            ->andWhere('EXISTS (
   276	                SELECT 1 FROM \Eccube\Entity\ProductStock ps
   277	                WHERE ps.ProductClass = pc
   278	                  AND ps.stock > 0
   279	                  AND IDENTITY(ps.baseInfo) = :baseInfoId
   280	            )')
   281	            ->setParameter('ids', $productIds)
   282	            ->setParameter('baseInfoId', $baseInfoId)
   283	            ->getQuery()
   284	            ->getResult();
   285	
   286	        $selectedByProductId = [];
   287	        foreach ($candidates as $ProductClass) {
   288	            $productId = $ProductClass->getProduct()->getId();
   289	            $current = $selectedByProductId[$productId] ?? null;
   290	            if ($current === null || (int) $ProductClass->getId() < (int) $current->getId()) {
   291	                $selectedByProductId[$productId] = $ProductClass;
   292	            }
   293	        }
   294	
   295	        $ordered = [];
   296	        foreach ($productIds as $id) {
   297	            if (isset($selectedByProductId[$id])) {
   298	                $ordered[] = $selectedByProductId[$id];
   299	            }
   300	        }
   301	
   302	        return $ordered;
   303	    }
