   391	    /**
   392	     * 期間別販売数集計バッチ用データ取得
   393	     *
   394	     * 現状は EC 受注（dtb_order/dtb_shipping）を対象に、
   395	     * 商品規格ID・店舗ID別の期間別販売数を返す。
   396	     * 閉店店舗・キャンセル受注は除外する。
   397	     * スマレジ実店舗販売の取り込み実装後に対象拡張予定。
   398	     *
   399	     * @return array<int, array{
   400	     *     product_class_id: int,
   401	     *     base_info_id: int,
   402	     *     sales_yesterday: int,
   403	     *     sales_3day: int,
   404	     *     sales_weekly: int,
   405	     *     sales_month: int,
   406	     *     sales_90day: int,
   407	     *     sales_180day: int,
   408	     *     sales_365day: int,
   409	     * }>
   410	     */
   411	    public function getSalesForAggregate(?\DateTimeInterface $orderDate = null): array
   412	    {
   413	        $utc = new \DateTimeZone('UTC');
   414	        $orderDateUtc = \DateTimeImmutable::createFromInterface($orderDate ?? new \DateTimeImmutable('now', $utc))
   415	            ->setTimezone($utc);
   416	
   417	        $rsm = new ResultSetMapping();
   418	        $rsm
   419	            ->addScalarResult('product_class_id', 'product_class_id', 'integer')
   420	            ->addScalarResult('base_info_id', 'base_info_id', 'integer')
   421	            ->addScalarResult('sales_yesterday', 'sales_yesterday', 'integer')
   422	            ->addScalarResult('sales_3day', 'sales_3day', 'integer')
   423	            ->addScalarResult('sales_weekly', 'sales_weekly', 'integer')
   424	            ->addScalarResult('sales_month', 'sales_month', 'integer')
   425	            ->addScalarResult('sales_90day', 'sales_90day', 'integer')
   426	            ->addScalarResult('sales_180day', 'sales_180day', 'integer')
   427	            ->addScalarResult('sales_365day', 'sales_365day', 'integer');
   428	
   429	        $cancelStatus = OrderStatus::CANCEL;
   430	        $productItemType = OrderItemType::PRODUCT;
   431	
   432	        // TODO: スマレジ実店舗販売の dtb_order 取り込みが実装されたら、
   433	        //       スマレジ受注が dtb_order + dtb_shipping 経由で集計されるか確認する。
   434	        //       スマレジ受注が別テーブル管理の場合は UNION 等で本クエリを拡張すること。
   435	        $query = <<<SQL
   436	            SELECT
   437	                oi.product_class_id,
   438	                s.base_info_id,
   439	                SUM(CASE WHEN o.order_date::date = (:order_date_ts::timestamptz)::date - 1 THEN oi.quantity::int ELSE 0 END) AS sales_yesterday,
   440	                SUM(CASE WHEN o.order_date >= :order_date_ts::timestamptz - INTERVAL '3 days' THEN oi.quantity::int ELSE 0 END) AS sales_3day,
   441	                SUM(CASE WHEN o.order_date >= :order_date_ts::timestamptz - INTERVAL '7 days' THEN oi.quantity::int ELSE 0 END) AS sales_weekly,
   442	                SUM(CASE WHEN o.order_date >= :order_date_ts::timestamptz - INTERVAL '28 days' THEN oi.quantity::int ELSE 0 END) AS sales_month,
   443	                SUM(CASE WHEN o.order_date >= :order_date_ts::timestamptz - INTERVAL '90 days' THEN oi.quantity::int ELSE 0 END) AS sales_90day,
   444	                SUM(CASE WHEN o.order_date >= :order_date_ts::timestamptz - INTERVAL '180 days' THEN oi.quantity::int ELSE 0 END) AS sales_180day,
   445	                SUM(CASE WHEN o.order_date >= :order_date_ts::timestamptz - INTERVAL '365 days' THEN oi.quantity::int ELSE 0 END) AS sales_365day
   446	            FROM dtb_order_item oi
   447	            JOIN dtb_order o ON oi.order_id = o.id
   448	            JOIN dtb_shipping s ON oi.shipping_id = s.id
   449	            JOIN dtb_base_info bi ON s.base_info_id = bi.id
   450	            WHERE o.order_date >= :order_date_ts::timestamptz - INTERVAL '366 days'
   451	              AND o.order_status_id != :cancel_status
   452	              AND bi.is_open_shop = true
   453	              AND oi.order_item_type_id = :product_item_type
   454	              AND oi.product_class_id IS NOT NULL
   455	            GROUP BY oi.product_class_id, s.base_info_id
   456	            SQL;
   457	
   458	        return $this->getEntityManager()
   459	            ->createNativeQuery($query, $rsm)
   460	            ->setParameter('cancel_status', $cancelStatus)
   461	            ->setParameter('product_item_type', $productItemType)
   462	            ->setParameter('order_date_ts', $orderDateUtc->format('Y-m-d H:i:sP'))
   463	            ->getResult();
   464	    }
   465	
   466	    /**
   467	     * 通販+TC東京（base_info_id = TC_TOKYO_ID）の合計販売数を取得
   468	     *
   469	     * @param array<int> $productClassIds
   470	     *
   471	     * @return array<int, array{orderQuantity01:int,orderQuantity02:int,orderQuantity03:int,orderQuantity04:int,orderQuantity05:int,orderQuantity06:int}>
   472	     */
   473	    public function getMainSalesQuantitiesByProductClassIds(array $productClassIds): array
   474	    {
   475	        return $this->getSalesQuantitiesByProductClassIds($productClassIds, true);
   476	    }
   477	
   478	    /**
   479	     * 支店の合計販売数を取得
   480	     *
   481	     * @param array<int> $productClassIds
   482	     *
   483	     * @return array<int, array{orderQuantity01:int,orderQuantity02:int,orderQuantity03:int,orderQuantity04:int,orderQuantity05:int,orderQuantity06:int}>
   484	     */
   485	    public function getBranchSalesQuantitiesByProductClassIds(array $productClassIds): array
   486	    {
   487	        return $this->getSalesQuantitiesByProductClassIds($productClassIds, false);
   488	    }
   489	
   490	    /**
   491	     * 商品規格IDごとの期間別販売数を取得する.
   492	     *
   493	     * @param array<int> $productClassIds
   494	     * @param bool $isMainBase true の場合は通販+TC東京（base_info_id = TC_TOKYO_ID）、false の場合は支店（dtb_base_info.is_main_shop = false）を集計する
   495	     *
   496	     * @return array<int, array{orderQuantity01:int,orderQuantity02:int,orderQuantity03:int,orderQuantity04:int,orderQuantity05:int,orderQuantity06:int}>
   497	     */
   498	    private function getSalesQuantitiesByProductClassIds(array $productClassIds, bool $isMainBase): array
   499	    {
   500	        if ($productClassIds === []) {
   501	            return [];
   502	        }
   503	
   504	        $params = ['ids' => $productClassIds];
   505	        $types = ['ids' => \Doctrine\DBAL\ArrayParameterType::INTEGER];
   506	
   507	        if ($isMainBase) {
   508	            $baseInfoCondition = 'bi.id = :mallBaseInfoId';
   509	            $params['mallBaseInfoId'] = BaseInfo::TC_TOKYO_ID;
   510	            $types['mallBaseInfoId'] = \PDO::PARAM_INT;
   511	        } else {
   512	            $baseInfoCondition = 'bi.is_main_shop = false';
   513	        }
   514	
   515	        $rows = $this->getEntityManager()->getConnection()->fetchAllAssociative(
   516	            'SELECT
   517	                sq.product_class_id,
   518	                COALESCE(SUM(sq.sales_quantity_01), 0) AS order_quantity_01,
   519	                COALESCE(SUM(sq.sales_quantity_02), 0) AS order_quantity_02,
   520	                COALESCE(SUM(sq.sales_quantity_03), 0) AS order_quantity_03,
   521	                COALESCE(SUM(sq.sales_quantity_04), 0) AS order_quantity_04,
   522	                COALESCE(SUM(sq.sales_quantity_05), 0) AS order_quantity_05,
   523	                COALESCE(SUM(sq.sales_quantity_06), 0) AS order_quantity_06
   524	            FROM dtb_sales_quantity sq
   525	            JOIN dtb_base_info bi ON sq.base_info_id = bi.id
   526	            WHERE sq.product_class_id IN (:ids)
   527	              AND '.$baseInfoCondition.'
   528	            GROUP BY sq.product_class_id',
   529	            $params,
   530	            $types
   531	        );
   532	
   533	        $result = [];
   534	        foreach ($rows as $row) {
   535	            $id = (int) $row['product_class_id'];
   536	            $result[$id] = [
   537	                'orderQuantity01' => (int) ($row['order_quantity_01'] ?? 0),
   538	                'orderQuantity02' => (int) ($row['order_quantity_02'] ?? 0),
   539	                'orderQuantity03' => (int) ($row['order_quantity_03'] ?? 0),
   540	                'orderQuantity04' => (int) ($row['order_quantity_04'] ?? 0),
   541	                'orderQuantity05' => (int) ($row['order_quantity_05'] ?? 0),
   542	                'orderQuantity06' => (int) ($row['order_quantity_06'] ?? 0),
   543	            ];
   544	        }
   545	
   546	        return $result;
   547	    }
   548	}

