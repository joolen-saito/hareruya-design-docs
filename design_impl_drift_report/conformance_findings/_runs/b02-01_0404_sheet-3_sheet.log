   305	    /**
   306	     * 人気商品リコメンド更新
   307	     */
   308	    public function updateRecommend(): void
   309	    {
   310	        set_time_limit(0);
   311	        ini_set('memory_limit', '-1');
   312	
   313	        /** @var EntityManagerInterface $em */
   314	        $em = $this->getEntityManager();
   315	        $em->getConnection()->getConfiguration()->setSQLLogger(null);
   316	
   317	        // 人気商品リコメンドCSV読み込み
   318	        echo '[実行開始][read]:'.date('Y-m-d H:i:s')."\n";
   319	        $csv = file($this->eccubeConfig['popular_product_recommend_csv_path']);
   320	        $csvRowCount = count($csv);
   321	        $csvData = [];
   322	        for ($i = 0; $i < $csvRowCount; ++$i) {
   323	            $line = explode(',', trim((string) $csv[$i]));
   324	            // 先頭のproduct_class_idをキーとし値から除外。メモリ消費量削減のため値はテキストで保持。
   325	            $csvData[array_shift($line)] = implode(',', $line);
   326	            unset($csv[$i]);
   327	        }
   328	        unset($csv);
   329	        echo '[実行終了][read]:'.date('Y-m-d H:i:s')."\n";
   330	
   331	        // 古い人気商品リコメンドの削除
   332	        echo '[実行開始][deleteOldRecommend]:'.date('Y-m-d H:i:s')."\n";
   333	        $this->deleteOldRecommend($em);
   334	        echo '[実行終了][deleteOldRecommend]:'.date('Y-m-d H:i:s')."\n";
   335	
   336	        // 人気商品リコメンド挿入
   337	        if (empty($csvData)) {
   338	            return;
   339	        }
   340	
   341	        echo '[実行開始][master]:'.date('Y-m-d H:i:s')."\n";
   342	
   343	        $productClassRepository = $em->getRepository(ProductClass::class);
   344	        $BaseInfo = $em->getRepository(BaseInfo::class)->find(self::POPULAR_PRODUCT_RECOMMEND_SHOP_ID);
   345	        $csvDataKeys = array_keys($csvData);
   346	
   347	        // 大量に行うとメモリを食い過ぎて止まるので、一定数ごとにエンティティマネージャをリセット
   348	        for ($i = 0; $i < count($csvDataKeys); $i += self::RECOMMEND_BULK_QUANTITY) {
   349	            $batchProductClassIds = array_slice($csvDataKeys, $i, self::RECOMMEND_BULK_QUANTITY);
   350	            $productClasses = $productClassRepository->findBy(['id' => $batchProductClassIds]);
   351	
   352	            foreach ($productClasses as $productClass) {
   353	                $singleCsvData = $csvData[$productClass->getId()];
   354	
   355	                $salesQuantity = new DtbSalesQuantity();
   356	                $salesQuantity->setBaseInfo($BaseInfo);
   357	                $salesQuantity->setProductClass($productClass);
   358	                $salesQuantity->setSalesQuantity_04((int) $singleCsvData);
   359	                $em->persist($salesQuantity);
   360	            }
   361	
   362	            $em->flush();
   363	            $em->clear();
   364	
   365	            // shopエンティティを再アタッチ
   366	            /**
   367	             * TODO: Undefined method 'merge'.
   368	             */
   369	            // $shop = $em->merge($shop);
   370	        }
   371	
   372	        $em->flush();
   373	
   374	        unset($csvData);
   375	        echo '[実行終了][master]:'.date('Y-m-d H:i:s')."\n";
   376	    }
