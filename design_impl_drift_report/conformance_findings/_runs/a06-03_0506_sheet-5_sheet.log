    16	use Eccube\Exception\App\BaseApiException;
    17	use Eccube\Exception\CloudFileAccessedBeforeMergeException;
    18	use Eccube\Request\Context;
    19	use Symfony\Component\EventDispatcher\EventSubscriberInterface;
    20	use Symfony\Component\HttpFoundation\JsonResponse;
    21	use Symfony\Component\HttpFoundation\Response;
    22	use Symfony\Component\HttpKernel\Event\ExceptionEvent;
    23	use Symfony\Component\HttpKernel\Exception\HttpExceptionInterface;
    24	use Symfony\Component\HttpKernel\KernelEvents;
    25	use Twig\Environment;
    26	
    27	class ExceptionListener implements EventSubscriberInterface
    28	{
    29	    /**
    30	     * ExceptionListener constructor.
    31	     */
    32	    public function __construct(private readonly Environment $twig, protected Context $requestContext)
    33	    {
    34	    }
    35	
    36	    public function onKernelException(ExceptionEvent $event): void
    37	    {
    38	        $title = trans('exception.error_title');
    39	        $message = trans('exception.error_message');
    40	        $statusCode = Response::HTTP_INTERNAL_SERVER_ERROR;
    41	
    42	        $exception = $event->getThrowable();
    43	
    44	        /**
    45	         * スマレジ Webhook の場合は JSON でエラーを返す（API と同様）
    46	         */
    47	        if ($this->requestContext->isSmaregiWebhook()) {
    48	            $statusCode = $exception instanceof HttpExceptionInterface
    49	                ? $exception->getStatusCode()
    50	                : Response::HTTP_INTERNAL_SERVER_ERROR;
    51	            $message = $exception instanceof HttpExceptionInterface && $exception->getMessage()
    52	                ? $exception->getMessage()
    53	                : 'An error occurred';
    54	            log_error('Smaregi webhook error', [
    55	                'status' => $statusCode,
    56	                'message' => $exception->getMessage(),
    57	                'file' => $exception->getFile(),
    58	                'line' => $exception->getLine(),
    59	                'trace' => $exception->getTraceAsString(),
    60	            ]);
    61	            $event->setResponse(new JsonResponse([
    62	                'status' => 'error',
    63	                'message' => $statusCode >= 500 ? 'Internal server error' : $message,
    64	            ], $statusCode));
    65	
    66	            return;
    67	        }
    68	
    69	        /**
    70	         * APIの場合は、エラー詳細をログ出力し、JSON形式で必ず(code, errors)を返す
    71	         */
    72	        if ($this->requestContext->isAppApi()) {
    73	            $logLevel = 'error';
    74	            $errors = ['システムエラーが発生しました'];
    75	            $statusCode = Response::HTTP_INTERNAL_SERVER_ERROR;
    76	
    77	            $logException = $exception->getPrevious() ?: $exception;
    78	            $errorClass = (new \ReflectionClass($exception))->getShortName();
    79	
    80	            // カスタムエラーの場合は、エラーコードとメッセージを取得
    81	            if ($exception instanceof BaseApiException) {
    82	                $statusCode = $exception->getStatusCode();
    83	                $errors = $exception->getErrors();
    84	                $logLevel = $exception->getLogLevel();
    85	            // HttpException は statusCode を尊重（4xxはwarning, 5xxはerror）
    86	            } elseif ($exception instanceof HttpExceptionInterface) {
