    62	     *
    63	     * @param int $csvImportTypeId mtb_csv_import_type.id
    64	     */
    65	    public function getQueryBuilderByCsvImportType(int $csvImportTypeId): QueryBuilder
    66	    {
    67	        return $this->createQueryBuilder('cih')
    68	            ->innerJoin('cih.CsvImportType', 'ct')
    69	            ->where('ct.id = :csvImportTypeId')
