   297	     *
   298	     * @param ReadCsvRowEvent $event
   299	     */
   300	    private function updateProductClass(ReadCsvRowEvent $event): void
   301	    {
   302	        $row = $event->getRow();
   303	        $productId = (int) $this->productIdColumn->getValue($row);
   304	        $languageId = (int) $this->languageIdColumn->getValue($row);
   305	
   306	        $productClasses = $this->findProductClasses($productId, $languageId);
   307	
   308	        $baseSellPrice = (int) bcfloor((string) $this->sellPriceColumn->getValue($row));
   309	        $baseBuyPrice = (int) bcfloor((string) $this->buyPriceColumn->getValue($row));
   310	
   311	        $saleFlgValue = $this->saleFlgColumn->getValue($row);
   312	        $saleFlg = ($saleFlgValue !== '' && $saleFlgValue !== null)
   313	            ? (bool) (int) $saleFlgValue
   314	            : false;
   315	        $beltUrlValue = $this->beltUrlColumn->getValue($row);
   316	        $beltUrl = ($beltUrlValue !== '' && $beltUrlValue !== null) ? $beltUrlValue : null;
   317	
   318	        $csvSellPriceSet = StringUtil::isNotBlank($this->sellPriceColumn->getValue($row));
   319	        $messageStore = $event->getMessageStore();
   320	        $rowNumber = $row->getRowNumber();
   321	        $alertSellPriceNotReflected = false;
   322	        $alertNormalProductSellPriceUnchanged = false;
   323	
   324	        foreach ($productClasses as $productClass) {
   325	            $currentSaleFlg = (bool) (int) ($productClass['saleFlg'] ?? 0);
   326	            $csvSaleFlg = $saleFlg;
   327	
   328	            $newSaleFlg = $csvSaleFlg;
   329	            if ($currentSaleFlg && !$csvSaleFlg) {
   330	                // DB=有効(1), CSV=無効(0): セールフラグを無効に。販売価格は standard_price からコピー
   331	                $newSaleFlg = false;
   332	                $newSellPrice = (int) bcfloor((string) ($productClass['standardPrice'] ?? '0'));
   333	                if ($csvSellPriceSet && !$alertSellPriceNotReflected) {
   334	                    $messageStore->addMessage('admin.product.price_csv.sell_price_not_reflected', $rowNumber);
   335	                    $alertSellPriceNotReflected = true;
   336	                }
   337	            } elseif (!$currentSaleFlg && !$csvSaleFlg) {
   338	                // DB=無効(0), CSV=無効(0): 販売価格は変更しない（通常商品）
   339	                $newSellPrice = (int) ($productClass['sellPrice'] ?? 0);
   340	                if (!$alertNormalProductSellPriceUnchanged) {
   341	                    $messageStore->addMessage('admin.product.price_csv.normal_product_sell_price_unchanged', $rowNumber);
   342	                    $alertNormalProductSellPriceUnchanged = true;
   343	                }
   344	            } else {
   345	                // DB=無効,CSV=有効 または DB=有効,CSV=有効: CSVの販売価格をそのまま反映
   346	                $newSellPrice = $baseSellPrice;
   347	            }
   348	
   349	            // 買取価格: NMはCSV値、SP/MP/HPは買取減額率・買取価格表・既定率から算出する（減額率取得はメソッド内で処理）
   350	            $specialFlg = (int) ($productClass['specialFlg'] ?? 0);
   351	            $buyDiscountId = isset($productClass['buyDiscountId']) ? (int) $productClass['buyDiscountId'] : null;
   352	            $newBuyPrice = $this->discountBuyPriceCalculator->calculate(
   353	                $baseBuyPrice,
   354	                (int) $productClass['cardConditionId'],
   355	                $specialFlg,
   356	                $buyDiscountId,
   357	            );
   358	            // 販売価格: NMはCSV値、SP/MP/HPは「商品の割引 × カードコンディション」のrateで算出
   359	            $newSellPrice = PriceUtil::discount($newSellPrice, $productClass['discountRate']);
   360	            $this->productClassRepository->updateProductClass([
   361	                'id' => $productClass['productClassId'],
   362	                'saleLimit' => $productClass['saleLimit'] ?? 0,
   363	                'price02' => $newSellPrice,
   364	                'buyPrice' => $newBuyPrice,
   365	                'beltUrl' => $beltUrl,
   366	                'saleFlg' => $saleFlg,
   367	                'smaregiAlignmentFlg' => $productClass['smaregiAlignmentFlg'] ?? 0,
   368	                'standardPrice' => $productClass['standardPrice'] ?? null,
   369	                'languageId' => (int) $productClass['languageId'],
   370	                'highPriceCode' => $productClass['highPriceCode'] ?? null,
   371	                'wholesalePrice' => $productClass['wholesalePrice'] ?? null,
   372	                'memo' => $productClass['memo'] ?? null,
   373	                'smaregiProductCode' => $productClass['smaregiProductCode'] ?? null,
   374	                'sectionId' => $productClass['sectionId'] ?? null,
   375	            ]);
   376	
   377	            $oldSellPrice = (int) ($productClass['sellPrice'] ?? 0);
   378	            $oldBuyPrice = (int) ($productClass['buyPrice'] ?? 0);
   379	            // ここでは基準価格は更新しないので同じ値を入れる
   380	            $oldStandardPrice = (int) bcfloor((string) ($productClass['standardPrice'] ?? '0'));
   381	            $newStandardPrice = (int) bcfloor((string) ($productClass['standardPrice'] ?? '0'));
   382	
   383	            $productClassEntity = $this->productClassRepository->getEntityManager()->getReference(
   384	                ProductClass::class,
   385	                (int) $productClass['productClassId']
   386	            );
   387	
   388	            $this->priceHistoryRepository->addSellBuyPriceHistoryIfChanged(
   389	                $productClassEntity,
   390	                $event->getUpdateUser()->getId(),
   391	                $oldSellPrice,
   392	                $oldBuyPrice,
   393	                $oldStandardPrice,
   394	                $newSellPrice,
   395	                $newBuyPrice,
   396	                $newStandardPrice,
   397	            );
   398	
   399	            $alignment = (int) ($productClass['smaregiAlignmentFlg'] ?? 0);
   400	            $smaregiCode = $productClass['smaregiProductCode'] ?? null;
   401	            $this->smaregiCsvImportUpsertCoordinator->deferIfEligible(
   402	                (int) $productClass['productClassId'],
   403	                $alignment,
   404	                \is_string($smaregiCode) ? $smaregiCode : null,
   405	            );
   406	        }
   407	    }
