    42	trait SearchControllerTrait
    43	{
    44	    /** セッションキー。表示件数、検索条件、ソート条件の保持に使用 */
    45	    protected string $sessionKey;
    46	    /** フォームタイプ */
    47	    protected string $formType;
    48	    /** フォーム名 */
    49	    protected string $formName;
    50	    /** デフォルトソートキー */
    51	    protected string $defaultSort = 'default';
    52	    /** デフォルト並び順 */
    53	    protected string $defaultOrder = 'DESC';
    54	    /**
    55	     * ソート参照用レポジトリ
    56	     * 使用する場合は[ | ]を使用してリポジトリの宣言追加をすること
    57	     * 追加するリポジトリにgetQueryBuilderBySearchDataを実装すること
    58	     */
    59	    protected CustomerRepository|DtbArchetypeRepository|DtbBuyOrderRepository|DtbBuyOrderStockHistoryRepository|DtbDeckRepository|DtbPriceHistoryRepository|MtbCardRepository|DtbShippingStandbyRepository $repository;
    60	    /** リダイレクト先 */
    61	    protected string $redirect = '';
    62	    /** 検索パターンキー名 */
    63	    protected string $patternKey = '';
    64	    /**
    65	     * @var array<string, mixed>
    66	     * Form作成時のオプション
    67	     */
    68	    protected array $formCreateOption = [];
    69	
    70	    /** 意図名（intention） */
    71	    protected string $intention = '';
    72	
    73	    protected PaginatorInterface $paginator;
    74	
    75	    protected DtbSearchPatternRepository $dtbSearchPatternRepository;
    76	
    77	    public function __construct(
    78	        PageMaxRepository $pageMaxRepository,
    79	        EccubeConfig $eccubeConfig,
    80	        PaginatorInterface $paginator,
    81	    ) {
    82	        $this->pageMaxRepository = $pageMaxRepository;
    83	        $this->eccubeConfig = $eccubeConfig;
    84	    }
    85	
    86	    /**
    87	     * 表示件数ドロップダウン用。画面ごとにコントローラでオーバーライドする。
    88	     *
    89	     * @return list<\Eccube\Entity\Master\PageMax>
    90	     */
    91	    protected function getPageMaxisForSearch(): array
    92	    {
    93	        return $this->pageMaxRepository->findAll();
    94	    }
    95	
    96	    /**
    97	     * データ検索メイン処理
    98	     *
    99	     * @return array<string, mixed>
   100	     *
   101	     * @throws \Exception
   102	     */
   103	    public function search(Request $request, ?int $patternId = null, int $pageNo = 1): array
   104	    {
   105	        // セッション取得
   106	        $session = $request->getSession();
   107	        $sessionkey = $this->sessionKey;
   108	        // セッションキー：ページ内表示件数
   109	        $pageCountKey = "eccube.admin.{$sessionkey}.search.page_count";
   110	        // セッションキー：ページ表示番号
   111	        $pageNoKey = "eccube.admin.{$sessionkey}.search.page_no";
   112	        // セッションキー：検索条件
   113	        $viewKey = "eccube.admin.{$sessionkey}.search";
   114	        // セッションキー：ソートカラム
   115	        $sortKey = "eccube.admin.{$sessionkey}.sort";
   116	        // セッションキー：降順/昇順
   117	        $orderKey = "eccube.admin.{$sessionkey}.order";
   118	
   119	        // フォーム取得
   120	        $builder = $this->formFactory->createBuilder($this->formType, null, $this->formCreateOption);
   121	
   122	        // パターンIDに設定する
   123	        $searchForm = $builder->getForm();
   124	        $searchForm->handleRequest($request);
   125	
   126	        // ソートキー、並び順
   127	        // sort の処理
   128	        $sort = match (true) {
   129	            !empty($request->get('sort')) => $request->get('sort'),
   130	            !is_null($session->get($sortKey)) => $session->get($sortKey),
   131	            default => $this->defaultSort,
   132	        };
   133	
   134	        // order の処理
   135	        $order = match (true) {
   136	            !empty($request->get('order')) => $request->get('order'),
   137	            !is_null($session->get($orderKey)) => $session->get($orderKey),
   138	            default => $this->defaultOrder,
   139	        };
   140	
   141	        if (!preg_match('/^(ASC|DESC|asc|desc)$/', $order)) {
   142	            $this->addError('admin.error.sort', 'admin');
   143	
   144	            return $this->index($request, $this->paginator);
   145	        }
   146	
   147	        $pageMaxis = $this->getPageMaxisForSearch();
   148	
   149	        $maxArr = [];
   150	        foreach ($pageMaxis as $pageMax) {
   151	            $maxArr[] = $pageMax->getName();
   152	        }
   153	        // 表示件数取得する、1.SESSION 2.設定ファイル
   154	        $defaultPageCount = (string) $this->eccubeConfig['eccube_default_page_count'];
   155	        $pageCount = (string) $session->get($pageCountKey, $defaultPageCount);
   156	        if ($maxArr !== [] && !in_array($pageCount, $maxArr, true)) {
   157	            $pageCount = in_array($defaultPageCount, $maxArr, true) ? $defaultPageCount : $maxArr[0];
   158	            $session->set($pageCountKey, $pageCount);
   159	        }
   160	        $pageCountParam = $request->get('page_count');
   161	        // 表示件数入力値がマスターに設定されている場合SESSIONに保存する
   162	        if ($pageCountParam !== null && $pageCountParam !== '' && in_array((string) $pageCountParam, $maxArr, true)) {
   163	            $pageCount = (string) $pageCountParam;
   164	            $session->set($pageCountKey, $pageCount);
   165	        }
   166	
   167	        // 検索条件
   168	        $searchData = $searchForm->getData();
   169	        $viewData = FormUtil::getViewData($searchForm);
   170	
   171	        // 検索条件が空の場合、セッションに保存されている検索条件を復元する
   172	        if (is_null($searchData)) {
   173	            $viewData = $session->get($viewKey);
   174	            // sessionに保持されている検索条件を復元.
   175	            $searchData = FormUtil::submitAndGetData($searchForm, $viewData);
   176	            if (is_null($viewData) && is_null($searchData)) {
   177	                return $this->index($request, $this->paginator);
   178	            }
   179	        }
   180	
   181	        $searchData['pattern_id'] = $patternId ?? null;
   182	        $searchData['sort'] = $sort;
   183	        $searchData['order'] = $order;
   184	        $searchRequest = ['searchData' => $searchData];
   185	
   186	        $qb = $this->getQueryBuilder($searchRequest);
   187	
   188	        // Sessionに設定
   189	        $session->set($pageNoKey, $pageNo);
   190	        $session->set($viewKey, $viewData);
   191	        $session->set($sortKey, $sort);
   192	        $session->set($orderKey, $order);
   193	        $session->set($pageCountKey, $pageCount);
   194	
   195	        // 検索結果
   196	        $pagination = $this->paginator->paginate(
   197	            $qb,
   198	            $pageNo,
   199	            (int) $pageCount,
   200	            $this->paginationOption ?? []
   201	        );
   202	        // 最終ページのデータ削除時に表示するデータがなくなった場合、１つ前のページを表示する
   203	        $resultCount = $pagination->getTotalItemCount();
   204	        $pageCountInt = (int) $pageCount;
   205	        if ($pageNo > 1 && $resultCount === (($pageNo - 1) * $pageCountInt)) {
   206	            $pageNo = $pageNo - 1;
   207	            $session->set($pageNoKey, $pageNo);
   208	            $pagination = $this->paginator->paginate(
   209	                $qb,
   210	                $pageNo,
   211	                $pageCountInt,
   212	                $this->paginationOption ?? []
   213	            );
   214	        }
   215	
   216	        return [
   217	            'searchForm' => $searchForm->createView(),
   218	            'pagination' => $pagination,
   219	            'pageMaxis' => $pageMaxis,
   220	            'page_no' => $pageNo,

