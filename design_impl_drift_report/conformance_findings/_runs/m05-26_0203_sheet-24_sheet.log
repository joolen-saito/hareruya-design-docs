   223	    public function checkFormValid(FormInterface $form): bool
   224	    {
   225	        if ($form->isSubmitted() && $form->isValid()) {
   226	            return true;
   227	        }
   228	        foreach ($form->getErrors(true) as $error) {
   229	            $this->addErrors($error->getMessage());
   230	        }
   231	
   232	        return false;
   233	    }
