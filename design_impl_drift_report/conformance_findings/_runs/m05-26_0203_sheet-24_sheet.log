   191	    #[Route(path: '/%eccube_admin_route%/order/export/order', name: 'admin_order_export_for_input', methods: ['GET', 'POST'])]
   192	    public function exportForInput(Request $request)
   193	    {
   194	        // タイムアウトを無効にする
   195	        set_time_limit(0);
   196	        // SQL Loggerを無効にする
   197	        $em = $this->entityManager;
   198	        $em->getConfiguration()->setSQLLogger(null);
   199	        // 注文情報IDを取得する
   200	        $rawOrderIds = $request->get('order_ids', []);
   201	        if (!is_array($rawOrderIds) || empty($rawOrderIds)) {
   202	            $this->addError('admin.common.select', 'admin');
   203	
   204	            $referer = $request->headers->get('referer');
   205	            if ($referer !== null && $referer !== '') {
   206	                return $this->redirect($referer);
   207	            }
   208	
   209	            return $this->redirectToRoute('admin_order');
   210	        }
   211	        $orderIdList = array_keys($rawOrderIds);
   212	
   213	        // CSVを出力する
   214	        try {
   215	            $response = $this->orderCsv->exportCsv($orderIdList);
   216	        } catch (\RuntimeException $e) {
   217	            $this->addError($e->getMessage(), 'admin');
   218	
   219	            $referer = $request->headers->get('referer');
   220	            if ($referer !== null && $referer !== '') {
   221	                return $this->redirect($referer);
   222	            }
   223	
   224	            return $this->redirectToRoute('admin_order');
   225	        }
   226	
   227	        return $response;
   228	    }
   229	
   230	    /**
   231	     * 出荷実績CSVアップロード画面
   232	     *
   233	     * @param Request $request
   234	     *
   235	     * @return Response
   236	     */
   237	    #[Route(
   238	        path: '/%eccube_admin_route%/order/shipping_result_csv/import',
   239	        name: 'admin_shipping_result_csv_import',
   240	        methods: ['GET'])
   241	    ]
   242	    #[Template(template: '@admin/Order/shipping_result_csv_import.twig')]
   243	    public function shippingResultCsv(Request $request)
   244	    {
   245	        $form = $this->formFactory->createBuilder(CsvImportType::class)->getForm();
   246	        $headers = self::CSV_HEADER;
   247	
   248	        return $this->render('@admin/Order/shipping_result_csv_import.twig', [
   249	            'form' => $form->createView(),
   250	            'headers' => $headers,
   251	            'errors' => [],
   252	            'warnings' => [],
   253	        ]);
   254	    }
   255	
   256	    /**
   257	     * 出荷実績CSVアップロード
   258	     *
   259	     * @param Request $request
   260	     *
   261	     * @return Response
   262	     */
   263	    #[Route(path: '/%eccube_admin_route%/order/shipping_result_csv/import', name: 'admin_shipping_result_csv_upload', methods: ['POST'], ),]
   264	    public function shippingResultImport(Request $request)
   265	    {
   266	        $form = $this->formFactory->createBuilder(CsvImportType::class)->getForm()->handleRequest($request);
   267	
   268	        $this->orderCsv->checkFormValid($form);
   269	        $formFile = $this->orderCsv->getFormFile($form);
   270	        if ($formFile === null) {
   271	            $this->orderCsv->render();
   272	
   273	            return $this->redirectToRoute('admin_shipping_result_csv_import');
   274	        }
   275	
   276	        $data = $this->orderCsv->getImportData($formFile);
   277	        if ($data === false) {
   278	            $this->orderCsv->render();
   279	
   280	            return $this->redirectToRoute('admin_shipping_result_csv_import');
   281	        }
   282	
   283	        if (!$this->orderRepository->isFree('registerShippingResult')) {
   284	            $this->orderCsv->render();
   285	
   286	            $message = trans('admin.csv.error.data.already_executing', ['%csvName%' => '出荷実績CSV']);
   287	            $this->addError($message, 'admin');
   288	
   289	            return $this->redirectToRoute('admin_shipping_result_csv_import');
   290	        } else {
   291	            try {
   292	                if (!$this->orderRepository->getLock('registerShippingResult')) {
   293	                    throw new \RuntimeException('admin.csv.error.data.lock_failed');
   294	                }
   295	                // ヘッダーの値が一致するかチェック
   296	                $headers = self::CSV_HEADER;
   297	                $notRequiredCsvHeader = self::NOT_REQUIRED_CSV_HEADER;
   298	                $columnHeaders = $data->getColumnHeaders();
   299	                $this->orderCsv->checkHeaderValues(array_keys($headers), $columnHeaders, array_keys($notRequiredCsvHeader));
   300	                $headerSize = count($columnHeaders);
   301	
   302	                // CSVデータが空でないかチェック
   303	                $this->orderCsv->checkDataSize($data);
   304	
   305	                $this->entityManager->getConfiguration()->setSQLLogger(null);
   306	                $this->entityManager->beginTransaction();
   307	
   308	                // CSVファイルの登録処理
   309	                $updatedOrders = $this->orderCsv->registerShippingResult($headers, $headerSize, $data);
   310	                foreach ($updatedOrders as $updateOrder) {
   311	                    $this->pointService->gainPoints($updateOrder['order']);
   312	                }
   313	                $this->entityManager->flush();
   314	                $this->entityManager->commit();
   315	            } catch (\Throwable $e) {
   316	                if ($this->entityManager->getConnection()->isTransactionActive()) {
   317	                    // トランザクション内でエラーが発生した場合はロールバック
   318	                    $this->entityManager->rollback();
   319	                }
   320	
   321	                $this->addError($e->getMessage(), 'admin');
   322	
   323	                $this->orderCsv->render();
   324	
   325	                return $this->redirectToRoute('admin_shipping_result_csv_import');
   326	            }
   327	
   328	            $this->addSuccess('admin.register.complete', 'admin');
   329	
   330	            $this->orderCsv->render();
   331	
   332	            return $this->redirectToRoute('admin_shipping_result_csv_import');
   333	        }
   334	    }
   335	}

