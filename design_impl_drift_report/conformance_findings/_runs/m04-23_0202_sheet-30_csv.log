   109	        }
   110	
   111	        $StatusPending = $this->mtbStockSplitJoinStatusRepository->find(MtbStockSplitJoinStatus::SPLIT_APPROVAL_WAITING);
   112	        if ($StatusPending === null) {
   113	            throw new \LogicException('StockSplitApplyApprovalAction::handle requires split approval waiting status in master.');
   114	        }
   115	
   116	        $now = new \DateTime();
   117	        $historyMember = $Member ?? $StockSplitJoin->getRegisteredMember();
   118	        $this->statusHistoryEntityManager->save(null, $StockSplitJoin, $StatusPending, $historyMember, $now);
   119	        $StockSplitJoin->setStockSplitJoinStatus($StatusPending);
   120	        $StockSplitJoin->setMoveToApprovalAt($now);
   121	        if ($Member !== null) {
   122	            $StockSplitJoin->setMoveToApprovalMember($Member);
   123	        }
   124	        $StockSplitJoin->setUpdateDate($now);
   125	        if ($Member !== null) {
   126	            $StockSplitJoin->setUpdater($Member);
   127	        }
   128	        $splitJoinMemo = trim($input->splitJoinMemo);
   129	        $StockSplitJoin->setSplitJoinMemo($splitJoinMemo !== '' ? $splitJoinMemo : null);
   130	
   131	        $HistorySourceType = $this->stockHistorySourceTypeRepository->find(MtbStockHistorySourceType::STOCK_SPLIT_EDIT);
   132	        if ($HistorySourceType === null) {
   133	            throw new \LogicException('StockSplitApplyApprovalAction requires STOCK_SPLIT_EDIT in master.');
   134	        }
   135	
   136	        $destinationTotalQuantity = 0;
   137	        foreach ($Destinations as $detail) {
   138	            $destinationTotalQuantity += \max(0, $detail->getSplitJoinQuantity());
   139	        }
   140	
   141	        // 移動分の総原価 = 登録時に計算済みの出庫総原価（= 総原価 × 移動個数 ÷ 総在庫数）をそのまま使用
   142	        $splitTransferCost = (int) bcround($StockSplitJoin->getOutboundTotalCost() ?? '0', 0);
   143	
   144	        // 1申請 = 1行（分割先全件 + 分割元1件）
   145	        $this->stockApprovalListEntityManager->save(
   146	            StockApprovalList: null,
   147	            BaseInfo: $ProductStock->getBaseInfo(),
   148	            StockLocationId: $ProductStock->getStockLocationId(),
   149	            HistorySourceType: $HistorySourceType,
   150	            historySourceId: (int) $StockSplitJoin->getId(),
   151	            StockTransferTypeDetail: $this->entityManager->getReference(MtbStockChangeTypeDetail::class, MtbStockChangeTypeDetail::SPLIT_OUTBOUND),
   152	            approvalStatus: DtbStockApprovalList::APPROVAL_STATUS_UNAPPROVED,
   153	            registeredDate: $now,
   154	            RegisteredMember: $historyMember,
   155	            ProductStockTotalCount: count($Destinations) + 1,
   156	            InventoryChangeTotalCount: $destinationTotalQuantity,
   157	            TotalCostPriceBefore: $splitTransferCost,
   158	        );
   159	
   160	        $this->entityManager->flush();
   161	
   162	        return [
   163	            'stockSplitJoinId' => $StockSplitJoin->getId(),
   164	            'successMessage' => 'admin.stock.split.apply_approval_success',
   165	        ];
   166	    }
   167	
   168	    /**
   169	     * @param list<DtbStockSplitJoinDetail> $Destinations
   170	     */
   171	    private function validateSplitDestinationCommitRules(DtbStockSplitJoin $StockSplitJoin, array $Destinations): ?string
   172	    {
   173	        if ($StockSplitJoin->getSplitJoinQuantity() < 1) {
   174	            return 'admin.stock.split.quantity_min';
   175	        }
   176	        if ($Destinations === []) {
   177	            return 'admin.stock.split.destination_required';
   178	        }
   179	        $destinationQuantitySum = 0;
   180	        foreach ($Destinations as $detail) {
   181	            $destinationQuantitySum += \max(0, $detail->getSplitJoinQuantity());
   182	        }
   183	        if ($destinationQuantitySum < 1) {
   184	            return 'admin.stock.split.destination_total_zero';
   185	        }
   186	
   187	        return null;
   188	    }
   189	}

