    99	    public function onValidateRow(ReadCsvRowEvent $event): void
   100	    {
   101	        ++$this->dataRowCount;
   102	
   103	        $row = $event->getRow();
   104	        $lineNum = $row->getRowNumber();
   105	        $ms = $event->getMessageStore();
   106	
   107	        if ($this->dataRowCount > self::MAX_ROWS) {
   108	            $ms->addRawMessage('登録上限（'.self::MAX_ROWS.'件）を超えています。');
   109	            $this->hasErrors = true;
   110	            $event->breakAll();
   111	
   112	            return;
   113	        }
   114	
   115	        if ($row->count() !== 5) {
   116	            $ms->addRawMessage("{$lineNum}行目: 列数が不正です（5列必要です）。");
   117	            $this->hasErrors = true;
   118	            $event->skipRow();
   119	
   120	            return;
   121	        }
   122	
   123	        foreach ([self::COL_DEST_CODE, self::COL_JOIN_QTY, self::COL_SRC_CODE, self::COL_SRC_CAT, self::COL_SRC_QTY] as $col) {
   124	            if (!$row->exists($col)) {
   125	                $ms->addRawMessage("1行目のヘッダー「{$col}」が見つかりません。CSVテンプレートを確認してください。");
   126	                $this->hasErrors = true;
   127	                $event->breakAll();
   128	
   129	                return;
   130	            }
   131	        }
   132	
   133	        $destCode = trim($row->getValue(self::COL_DEST_CODE));
   134	        $joinQtyRaw = trim($row->getValue(self::COL_JOIN_QTY));
   135	        $srcCode = trim($row->getValue(self::COL_SRC_CODE));
   136	        $srcCat = trim($row->getValue(self::COL_SRC_CAT));
   137	        $srcQtyRaw = trim($row->getValue(self::COL_SRC_QTY));
   138	
   139	        $rowErrors = [];
   140	
   141	        // 結合先商品コード・結合数の検証:
   142	        // 空欄 → グローバル値を引き継ぐ（許可）
   143	        // グローバル値と同一 → 許可
   144	        // グローバル値と異なる → エラー
   145	        if ($destCode !== '') {
   146	            if ($this->globalDestCode === '') {
   147	                $this->globalDestCode = $destCode;
   148	            } elseif ($this->globalDestCode !== $destCode) {
   149	                $rowErrors[] = "{$lineNum}行目: 結合先商品コードが異なります。1ファイルに指定できる結合先は1件のみです。";
   150	            }
   151	        }
   152	        if ($joinQtyRaw !== '') {
   153	            if (!ctype_digit($joinQtyRaw) || (int) $joinQtyRaw <= 0) {
   154	                $rowErrors[] = "{$lineNum}行目: 結合数が不正です。";
   155	            } elseif ($this->globalJoinQty === '') {
   156	                $this->globalJoinQty = (string) (int) $joinQtyRaw;
   157	            } elseif ((int) $this->globalJoinQty !== (int) $joinQtyRaw) {
   158	                $rowErrors[] = "{$lineNum}行目: 結合数が異なります。1ファイルに指定できる結合数は1件のみです。";
   159	            }
   160	        }
   161	
   162	        // 結合元の検証
   163	        if ($srcCode === '') {
   164	            $rowErrors[] = "{$lineNum}行目: 結合元商品コードが空です。";
   165	        }
   166	        if ($this->resolveSourceStockLocation($srcCat) === null) {
   167	            $rowErrors[] = "{$lineNum}行目: 結合元在庫区分が不正です（{$srcCat}）。";
   168	        }
