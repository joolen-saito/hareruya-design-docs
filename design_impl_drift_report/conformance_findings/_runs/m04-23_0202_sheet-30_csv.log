   294	    protected function getRowValidators(): array
   295	    {
   296	        return [];
   297	    }
   298	
   299	    /**
   300	     * 全行を1グループとしてまとめる（1ファイル=1分割）。
   301	     * src_code/split_qty が空の行はグローバル値を使用する。
   302	     *
   303	     * @return array<string, list<array{src_code: string, split_qty: int, dest_code: string, dest_qty: int}>>
   304	     */
   305	    private function buildGroups(): array
   306	    {
   307	        $groups = [];
   308	        $srcCode = $this->globalSrcCode;
   309	        $splitQty = (int) $this->globalSplitQty;
   310	        $k = $srcCode."\0".$splitQty;
   311	
   312	        foreach ($this->pendingRows as $row) {
   313	            if ($row['dest_code'] === '') {
   314	                continue;
   315	            }
   316	            $groups[$k][] = [
   317	                'src_code' => $srcCode,
   318	                'split_qty' => $splitQty,
   319	                'dest_code' => $row['dest_code'],
   320	                'dest_qty' => (int) $row['dest_qty'],
   321	            ];
   322	        }
   323	
   324	        return $groups;
   325	    }
   326	
   327	    /**
   328	     * @param list<array{src_code: string, split_qty: int, dest_code: string, dest_qty: int}> $groupRows
   329	     *
   330	     * @return array{ok: bool, errors: list<string>}
   331	     */
   332	    private function processGroup(array $groupRows, Member $member, BaseInfo $baseInfo): array
   333	    {
   334	        $errors = [];
   335	        $first = $groupRows[0];
   336	        $srcCode = $first['src_code'];
   337	        $splitQuantity = $first['split_qty'];
   338	
   339	        $sourcePs = $this->productStockRepository->findOneByProductCodeAndBaseInfoAndStockLocation(
   340	            $srcCode,
   341	            $baseInfo,
   342	            $this->stockLocationId
   343	        );
   344	        if ($sourcePs === null) {
   345	            $errors[] = sprintf('分割元商品コード「%s」が同一店舗・在庫区分で見つかりません。', $srcCode);
   346	
   347	            return ['ok' => false, 'errors' => $errors];
   348	        }
   349	
   350	        /** @var array<int, array{ProductStock: ProductStock, quantity: int}> $destDetailsByPsId */
   351	        $destDetailsByPsId = [];
   352	        foreach ($groupRows as $gr) {
   353	            $destCode = $gr['dest_code'];
   354	            $destPs = $this->productStockRepository->findOneByProductCodeAndBaseInfoAndStockLocation(
   355	                $destCode,
   356	                $baseInfo,
   357	                $this->stockLocationId
   358	            );
   359	            if ($destPs === null) {
   360	                $errors[] = sprintf('分割先商品コード「%s」が同一店舗・在庫区分で見つかりません。', $destCode);
   361	
   362	                return ['ok' => false, 'errors' => $errors];
   363	            }
   364	            if ($destPs->getId() === $sourcePs->getId()) {
   365	                $errors[] = sprintf('分割元と分割先が同一在庫です（%s）。', $srcCode);
   366	
   367	                return ['ok' => false, 'errors' => $errors];
   368	            }
   369	            $psId = (int) $destPs->getId();
   370	            if (isset($destDetailsByPsId[$psId])) {
   371	                $destDetailsByPsId[$psId]['quantity'] += $gr['dest_qty'];
   372	            } else {
   373	                $destDetailsByPsId[$psId] = ['ProductStock' => $destPs, 'quantity' => $gr['dest_qty']];
   374	            }
   375	        }
   376	
   377	        if ($destDetailsByPsId === []) {
   378	            $errors[] = sprintf('分割元 %s: 分割先が空です。', $srcCode);
   379	
   380	            return ['ok' => false, 'errors' => $errors];
   381	        }
   382	
   383	        $registerInput = new StockSplitRegisterInput(
   384	            $sourcePs,
   385	            $member,
   386	            max(0, $splitQuantity),
   387	            '',
   388	            array_values($destDetailsByPsId),
   389	        );
   390	
   391	        try {
   392	            $regResult = $this->stockSplitRegisterAction->handle($registerInput);
   393	        } catch (\LogicException $e) {
   394	            $errors[] = sprintf('分割元 %s: %s', $srcCode, trans($e->getMessage()));
   395	
   396	            return ['ok' => false, 'errors' => $errors];
   397	        }
   398	
   399	        if (isset($regResult['errorMessage'])) {
   400	            $errors[] = sprintf('分割元 %s: %s', $srcCode, trans((string) $regResult['errorMessage']));
   401	
   402	            return ['ok' => false, 'errors' => $errors];
   403	        }
   404	
   405	        $joinId = (int) ($regResult['stockSplitJoinId'] ?? 0);
   406	        if ($joinId < 1) {
   407	            $errors[] = sprintf('分割元 %s: 登録に失敗しました。', $srcCode);
   408	
   409	            return ['ok' => false, 'errors' => $errors];
   410	        }
   411	
   412	        $applyResult = $this->stockSplitApplyApprovalAction->handle(
   413	            new StockSplitApplyApprovalInput(
   414	                stockSplitJoinId: $joinId,
   415	                sessionDestinations: array_map(static fn ($v) => ['quantity' => $v['quantity']], $destDetailsByPsId),
   416	                ProductStock: $sourcePs,
   417	                Member: $member,
   418	            )
   419	        );
   420	        if (isset($applyResult['errorMessage'])) {
   421	            $errors[] = sprintf('分割元 %s（承認申請）: %s', $srcCode, trans((string) $applyResult['errorMessage']));
   422	
   423	            return ['ok' => false, 'errors' => $errors];
   424	        }
   425	
   426	        return ['ok' => true, 'errors' => []];
   427	    }
   428	}

