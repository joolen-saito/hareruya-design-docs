   170	            $rowErrors[] = "{$lineNum}行目: 結合元在庫数が不正です。";
   171	        }
   172	
   173	        if ($rowErrors !== []) {
   174	            $ms->addRawMessage($rowErrors);
   175	            $this->hasErrors = true;
   176	            $event->skipRow();
   177	        }
   178	    }
