   188	    /**
   189	     * @param list<string> $headers
   190	     */
   191	    private function buildCsvTemplateResponse(array $headers, string $filename): StreamedResponse
   192	    {
   193	        $out = fopen('php://temp', 'r+');
   194	        if ($out === false) {
   195	            throw new \RuntimeException('Failed to open temp stream.');
   196	        }
   197	        fputcsv($out, $headers, ',', '"', '\\');
   198	        rewind($out);
   199	        $content = stream_get_contents($out);
   200	        fclose($out);
   201	        $response = new StreamedResponse(function () use ($content): void {
   202	            echo "\xEF\xBB\xBF".($content !== false ? $content : '');
   203	        });
   204	        $response->headers->set('Content-Type', 'application/octet-stream');
   205	        $response->headers->set('Content-Disposition', 'attachment; filename="'.$filename.'"');
   206	
   207	        return $response;
   208	    }
