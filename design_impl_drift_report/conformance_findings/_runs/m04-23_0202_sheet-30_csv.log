    20	use Eccube\Util\SimpleCache;
    21	
    22	/**
    23	 * CsvImportFormatInterface のデフォルト実装。
    24	 */
    25	abstract class BaseCsvImportHandler implements CsvImportHandlerInterface
    26	{
    27	    /** @var int 行ロックタイムアウト（秒）のデフォルト値 */
    28	    public const DEFAULT_LOCK_TIMEOUT = 5;
    29	
    30	    /** @var SimpleCache|null 列定義の取得先 */
    31	    private ?SimpleCache $columnsCache = null;
    32	
    33	    /** @var SimpleCache|null 行バリデータ定義の取得先 */
    34	    private ?SimpleCache $rowValidatorsCache = null;
    35	
    36	    /**
    37	     * 最初のCSVデータを読み込む前に呼び出される関数。
    38	     */
    39	    public function onBeforeImport(): void
    40	    {
    41	        $this->columnsCache = new SimpleCache(function () {
    42	            return $this->getColumns();
    43	        });
    44	        $this->rowValidatorsCache = new SimpleCache(function () {
    45	            return $this->getRowValidators();
    46	        });
    47	    }
    48	
    49	    /**
    50	     * CSVの読み込みが終わった後に呼び出される関数。
    51	     *
    52	     * @param AfterReadEvent $event イベント
    53	     */
    54	    public function onAfterImport(AfterReadEvent $event): void
    55	    {
    56	        $this->columnsCache = null;
    57	        $this->rowValidatorsCache = null;
    58	    }
    59	
    60	    /**
    61	     * CSVデータ1行の形式をチェックする。
    62	     *
    63	     * @param ReadCsvRowEvent $event イベント
    64	     */
    65	    public function onValidateRow(ReadCsvRowEvent $event): void
    66	    {
    67	        /** @var array<CsvColumnInterface> $columns */
    68	        $columns = $this->columnsCache->get();
    69	        $row = $event->getRow();
    70	
    71	        // 列数が一致しない場合、エラー
    72	        if (count($row) !== count($columns)) {
    73	            $event->getMessageStore()
    74	                ->addInvalidColumnCountError($row->getRowNumber());
    75	            $event->breakAll();
    76	
    77	            return;
    78	        }
    79	
    80	        // 行内の各データが正しくない場合、エラー
    81	        $messageStore = $event->getMessageStore();
    82	
    83	        /** @var CsvColumnInterface $column */
    84	        foreach ($columns as $column) {
    85	            $name = $column->getName();
    86	            if (!$row->exists($name)) {
    87	                $messageStore->addColumnNotExistsError($row->getRowNumber(), $name);
    88	                $event->breakAll();
    89	
    90	                return;
    91	            }
    92	
    93	            if (!$column->validate($messageStore, $row)) {
    94	                $event->breakAll();
    95	
    96	                return;
    97	            }
    98	        }
    99	
   100	        // 行全体を検証する
   101	        /** @var array<RowValidatorInterface> $rowValidators */
   102	        $rowValidators = $this->rowValidatorsCache->get();
   103	        if (!empty($rowValidators)) {
   104	            /** @var RowValidatorInterface $rowValidator */
   105	            foreach ($rowValidators as $rowValidator) {
   106	                if (!$rowValidator->validate($messageStore, $row)) {
   107	                    $event->breakAll();
   108	
   109	                    return;
   110	                }
   111	            }
   112	        }
   113	    }
   114	
   115	    /**
   116	     * 行ロックのタイムアウト時間を返す。
   117	     *
   118	     * @return int タイムアウト（秒）
   119	     */
   120	    public function getLockTimeout(): int
   121	    {
   122	        return self::DEFAULT_LOCK_TIMEOUT;
   123	    }
   124	
   125	    /**
   126	     * 列の定義を取得する。
   127	     *
   128	     * @return array<CsvColumnInterface> 列の定義を CsvColumnInterface で返す。
   129	     */
   130	    abstract protected function getColumns(): array;
   131	
   132	    /**
   133	     * 列を検証するロジックを取得する。
   134	     *
   135	     * @return array<RowValidatorInterface> 列全体を検証する定義を RowValidatorInterface で返す。
   136	     */
   137	    abstract protected function getRowValidators(): array;
   138	}

