   285	            new BaseCsvColumn(self::COL_SPLIT_QTY, self::COL_SPLIT_QTY),
   286	            new BaseCsvColumn(self::COL_DEST_CODE, self::COL_DEST_CODE),
   287	            new BaseCsvColumn(self::COL_DEST_QTY, self::COL_DEST_QTY),
   288	        ];
