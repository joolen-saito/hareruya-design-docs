   309	    /**
   310	     * 全行を1グループとしてまとめる（1ファイル=1結合）。
   311	     * dest_code/join_qty が空の行はグローバル値を使用する。
   312	     *
   313	     * @return array<string, list<array{dest_code: string, join_qty: int, src_code: string, src_cat: string, src_qty: int}>>
   314	     */
   315	    private function buildGroups(): array
   316	    {
   317	        $groups = [];
   318	        $destCode = $this->globalDestCode;
   319	        $joinQty = (int) $this->globalJoinQty;
   320	        $k = $destCode."\0".$joinQty;
   321	
   322	        foreach ($this->pendingRows as $row) {
   323	            if ($row['src_code'] === '') {
   324	                continue;
   325	            }
   326	            $groups[$k][] = [
   327	                'dest_code' => $destCode,
   328	                'join_qty' => $joinQty,
   329	                'src_code' => $row['src_code'],
   330	                'src_cat' => $row['src_cat'],
   331	                'src_qty' => (int) $row['src_qty'],
   332	            ];
   333	        }
   334	
   335	        return $groups;
   336	    }
   337	
   338	    /**
   339	     * @param list<array{dest_code: string, join_qty: int, src_code: string, src_cat: string, src_qty: int}> $groupRows
   340	     *
   341	     * @return array{ok: bool, errors: list<string>}
   342	     */
   343	    private function processGroup(array $groupRows, Member $member, BaseInfo $baseInfo): array
   344	    {
   345	        $errors = [];
   346	        $first = $groupRows[0];
   347	        $destCode = $first['dest_code'];
   348	        $joinQuantity = $first['join_qty'];
   349	
   350	        $destPs = $this->productStockRepository->findOneByProductCodeAndBaseInfoAndStockLocation(
   351	            $destCode,
   352	            $baseInfo,
   353	            $this->destinationStockLocationId
   354	        );
   355	        if ($destPs === null) {
   356	            $errors[] = sprintf('結合先商品コード「%s」が同一店舗・在庫区分で見つかりません。', $destCode);
   357	
   358	            return ['ok' => false, 'errors' => $errors];
   359	        }
   360	
   361	        /** @var array<int, array{ProductStock: ProductStock, quantity: int}> $sourceByPsId */
   362	        $sourceByPsId = [];
   363	        foreach ($groupRows as $gr) {
   364	            $srcCode = $gr['src_code'];
   365	            $cat = $gr['src_cat'];
   366	            $srcLoc = $this->resolveSourceStockLocation($cat);
   367	            if ($srcLoc === null) {
   368	                $errors[] = sprintf('結合先 %s 結合元 %s: 在庫区分が不正です（%s）。', $destCode, $srcCode, $cat);
   369	
   370	                return ['ok' => false, 'errors' => $errors];
   371	            }
   372	            $srcPs = $this->productStockRepository->findOneByProductCodeAndBaseInfoAndStockLocation(
   373	                $srcCode,
   374	                $baseInfo,
   375	                $srcLoc
   376	            );
   377	            if ($srcPs === null) {
   378	                $errors[] = sprintf('結合元商品コード「%s」（在庫区分 %s）が見つかりません。', $srcCode, $cat);
   379	
   380	                return ['ok' => false, 'errors' => $errors];
   381	            }
   382	            if ($srcPs->getId() === $destPs->getId()) {
   383	                $errors[] = sprintf('結合先と結合元が同一在庫です（%s）。', $destCode);
   384	
   385	                return ['ok' => false, 'errors' => $errors];
   386	            }
   387	            $psId = (int) $srcPs->getId();
   388	            if (isset($sourceByPsId[$psId])) {
   389	                $sourceByPsId[$psId]['quantity'] += $gr['src_qty'];
   390	            } else {
   391	                $sourceByPsId[$psId] = ['productStockId' => $psId, 'quantity' => $gr['src_qty']];
   392	            }
   393	        }
   394	
   395	        if ($sourceByPsId === []) {
   396	            $errors[] = sprintf('結合先 %s: 結合元が空です。', $destCode);
   397	
   398	            return ['ok' => false, 'errors' => $errors];
   399	        }
   400	
   401	        $registerInput = new StockJoinRegisterInput(
   402	            $destPs,
   403	            $member,
   404	            max(0, $joinQuantity),
   405	        );
   406	
   407	        try {
   408	            $regResult = $this->stockJoinRegisterAction->handle($registerInput);
   409	        } catch (\LogicException $e) {
   410	            $errors[] = sprintf('結合先 %s: %s', $destCode, trans($e->getMessage()));
   411	
   412	            return ['ok' => false, 'errors' => $errors];
   413	        }
   414	
   415	        $joinId = (int) $regResult->getId();
   416	        if ($joinId < 1) {
   417	            $errors[] = sprintf('結合先 %s: 登録に失敗しました。', $destCode);
   418	
   419	            return ['ok' => false, 'errors' => $errors];
   420	        }
   421	
   422	        try {
   423	            $this->stockJoinMoveToShortageEntryAction->handle(
   424	                new StockJoinMoveToShortageEntryInput(
   425	                    ProductStock: $destPs,
   426	                    stockSplitJoinId: $joinId,
   427	                    Member: $member,
   428	                    sessionSources: array_map(static fn ($v) => ['quantity' => $v['quantity']], $sourceByPsId),
   429	                )
   430	            );
   431	        } catch (StockJoinMoveToShortageValidationException $e) {
   432	            $errors[] = sprintf('結合先 %s（欠品入力へ）: %s', $destCode, trans($e->getMessage()));
   433	
   434	            return ['ok' => false, 'errors' => $errors];
   435	        }
   436	
   437	        return ['ok' => true, 'errors' => []];
   438	    }
   439	
   440	    private function resolveSourceStockLocation(string $category): ?int
   441	    {
   442	        $normalized = mb_strtolower(trim($category));
   443	        if ($normalized === '') {
   444	            return null;
   445	        }
   446	
   447	        if (
   448	            $normalized === (string) ProductStock::STOCK_LOCATION_ECCUBE
   449	            || $normalized === 'ec-cube'
   450	            || $normalized === 'eccube'
   451	            || $normalized === 'ec cube'
   452	            || $normalized === 'ec'
   453	            || $normalized === '自社'
   454	            || $normalized === '自社在庫'
   455	            || $normalized === 'ec在庫'
   456	        ) {
   457	            return ProductStock::STOCK_LOCATION_ECCUBE;
   458	        }
   459	
   460	        if (
   461	            $normalized === (string) ProductStock::STOCK_LOCATION_SMAREGI
   462	            || $normalized === 'スマレジ'
   463	            || $normalized === 'smaregi'
   464	            || $normalized === 'smaregi在庫'
   465	            || $normalized === 'スマレジ在庫'
   466	        ) {
   467	            return ProductStock::STOCK_LOCATION_SMAREGI;
   468	        }
   469	
   470	        return null;
   471	    }
   472	}

