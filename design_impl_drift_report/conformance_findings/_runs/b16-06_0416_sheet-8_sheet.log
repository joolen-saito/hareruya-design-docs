   108	    /**
   109	     * ProductStock[] から DtbSalesQuantity を一括ロードし、
   110	     * "productClassId_baseInfoId" をキーとするマップを返す。
   111	     *
   112	     * @param list<ProductStock> $productStocks
   113	     *
   114	     * @return array<string, DtbSalesQuantity>
   115	     */
   116	    private function buildSalesQuantityMap(array $productStocks): array
   117	    {
   118	        if ($productStocks === []) {
   119	            return [];
   120	        }
   121	
   122	        $pcIds = [];
   123	        foreach ($productStocks as $ps) {
   124	            $pcId = $ps->getProductClass()->getId();
   125	            if ($pcId !== null) {
   126	                $pcIds[$pcId] = true;
   127	            }
   128	        }
   129	
   130	        if ($pcIds === []) {
   131	            return [];
   132	        }
   133	
   134	        /** @var list<DtbSalesQuantity> $sqEntities */
   135	        $sqEntities = $this->entityManager->createQueryBuilder()
   136	            ->select('sq')
   137	            ->from(DtbSalesQuantity::class, 'sq')
   138	            ->where('sq.ProductClass IN (:pcIds)')
   139	            ->andWhere('sq.BaseInfo IS NOT NULL')
   140	            ->setParameter('pcIds', array_keys($pcIds))
   141	            ->getQuery()
   142	            ->getResult();
   143	
   144	        $map = [];
   145	        foreach ($sqEntities as $sq) {
   146	            $pcId = $sq->getProductClass()?->getId();
   147	            $biId = $sq->getBaseInfo()?->getId();
   148	            if ($pcId !== null && $biId !== null) {
   149	                $map[$pcId.'_'.$biId] = $sq;
   150	            }
   151	        }
   152	
   153	        return $map;
   154	    }
   155	
   156	    /**
   157	     * @param list<ProductStock>                 $productStocks
   158	     * @param array<string, DtbSalesQuantity>    $salesQuantityMap
   159	     *
   160	     * @return list<array<string, string>>
   161	     */
   162	    private function buildCsvRows(array $productStocks, array $salesQuantityMap): array
   163	    {
   164	        $rows = [];
   165	
   166	        foreach ($productStocks as $ps) {
   167	            $pc = $ps->getProductClass();
   168	            $product = $pc->getProduct();
   169	
   170	            $pcId = $pc->getId();
   171	            $biId = $ps->getBaseInfo()->getId();
   172	            $sq = $pcId !== null ? ($salesQuantityMap[$pcId.'_'.$biId] ?? null) : null;
   173	
   174	            $rows[] = [
   175	                'product_id' => (string) ($product->getId() ?? ''),
   176	                'product_name' => (string) $product->getName(),
   177	                'product_code' => (string) ($pc->getCode() ?? ''),
   178	                'shop_name' => (string) ($ps->getBaseInfo()->getShopName() ?? ''),
   179	                'stock_location_name' => $ps->getLocationName(),
   180	                'language' => $pc->getLanguageNameJp(),
   181	                'card_condition' => $pc->getCardConditionNameJp(),
   182	                'standard_price' => (string) ($pc->getStandardPrice() ?? ''),
   183	                'sell_price' => (string) ($pc->getPrice02() ?? ''),
   184	                'buy_price' => (string) ($pc->getBuyPrice() ?? ''),
   185	                'stock' => (string) ($ps->getStock() ?? '0'),
   186	                'unit_cost' => $ps->getUnitCost(),
   187	                'total_cost' => $ps->getTotalCost(),
   188	                'today_sales' => (string) ($sq?->getSalesQuantity_01() ?? ''),
   189	                'yesterday_sales' => (string) ($sq?->getSalesQuantity_02() ?? ''),
   190	                'three_day_sales' => (string) ($sq?->getSalesQuantity_03() ?? ''),
   191	                'one_week_sales' => (string) ($sq?->getSalesQuantity_04() ?? ''),
   192	                'one_month_sales' => (string) ($sq?->getSalesQuantity_05() ?? ''),
   193	                'ninety_day_sales' => (string) ($sq?->getSalesQuantity_06() ?? ''),
   194	            ];
   195	        }
   196	
   197	        return $rows;
   198	    }
