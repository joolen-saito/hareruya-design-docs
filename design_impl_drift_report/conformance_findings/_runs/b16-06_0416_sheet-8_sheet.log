    21	use Symfony\Component\Console\Command\Command;
    22	use Symfony\Component\Console\Input\InputArgument;
    23	use Symfony\Component\Console\Input\InputInterface;
    24	use Symfony\Component\Console\Output\OutputInterface;
    25	use Symfony\Component\Console\Style\SymfonyStyle;
    26	use Symfony\Contracts\Service\ServiceSubscriberInterface;
    27	
    28	#[AsCommand(
    29	    name: 'list:batch',
    30	    description: 'Execute various list text batches.',
    31	)]
    32	final class ListTextBatchCommand extends Command implements ServiceSubscriberInterface
    33	{
    34	    private const BATCH_SERVICES = [
    35	        'createCardNameList' => CardNameListService::class,
    36	        // 将来的に別のリスト作成サービスが増えた際、ここに追加する
    37	    ];
    38	
    39	    public function __construct(
    40	        private readonly ContainerInterface $container,
    41	    ) {
    42	        parent::__construct();
    43	    }
    44	
    45	    /**
    46	     * DIコンテナから取得可能なサービスを定義
    47	     */
    48	    public static function getSubscribedServices(): array
    49	    {
    50	        return self::BATCH_SERVICES;
    51	    }
    52	
    53	    protected function configure(): void
    54	    {
    55	        $this
    56	            ->addArgument('batch_name', InputArgument::REQUIRED, 'The name of the batch to execute')
    57	            ->addArgument('args', InputArgument::IS_ARRAY | InputArgument::OPTIONAL, 'Optional arguments for the batch');
    58	    }
    59	
    60	    protected function execute(InputInterface $input, OutputInterface $output): int
    61	    {
    62	        $io = new SymfonyStyle($input, $output);
    63	        $batchName = $input->getArgument('batch_name');
    64	        $options = $input->getArgument('args');
    65	
    66	        $resultMessagePrefix = '['.date('Y/m/d H:i').'] ';
    67	
    68	        // サービスが存在するか確認（キー名でチェック）
    69	        if (!isset(self::BATCH_SERVICES[$batchName])) {
    70	            $io->error($resultMessagePrefix."Command '{$batchName}' not found.");
    71	
    72	            return Command::FAILURE;
    73	        }
    74	
    75	        try {
    76	            $service = $this->container->get($batchName);
    77	            $result = $service->create($options);
    78	            $io->text($resultMessagePrefix.$result[1]);
    79	
    80	            return $result[0] === 0 ? Command::SUCCESS : Command::FAILURE;
    81	        } catch (\Exception $e) {
    82	            $io->error($resultMessagePrefix.'Fatal error: '.$e->getMessage());
    83	
    84	            return Command::FAILURE;
    85	        }
    86	    }
    87	}

