   583	
   584	        $sql = <<<SQL
   585	            SELECT
   586	                p.name AS "rawProductName",
   587	                sc.name AS "storageCodeName",
   588	                lng.code AS "languageCode",
   589	                cond.code AS "conditionCode",
   590	                (
   591	                    SELECT STRING_AGG(cl.name_jp, '' ORDER BY cl.id)
   592	                    FROM dtb_card_color dcc
   593	                    JOIN mtb_color cl ON cl.id = dcc.color_id
   594	                    WHERE dcc.card_id = c.id
   595	                ) AS "colorName",
   596	                r.code AS "rarityCode",
   597	                COALESCE(cd.foil_flg, 0) AS "foilFlg",
   598	                SUM(s.quantity) AS "quantity",
   599	                pc.standard_price AS "standardPrice",
   600	                bi.expensive_threshold1 AS "threshold1",
   601	                bi.expensive_threshold2 AS "threshold2",
   602	                bi.expensive_threshold3 AS "threshold3",
   603	                -- カテゴリ判定を EXISTS に分離: 1:N JOIN による数量重複を防ぐ
   604	                CASE WHEN EXISTS (
   605	                    SELECT 1 FROM dtb_product_category pcat
   606	                    WHERE pcat.product_id = p.id
   607	                      AND pcat.category_id IN (:goods_category_id, :reserved_goods_category_id)
   608	                ) THEN 1 ELSE 0 END AS "isSupply",
   609	                -- ピッキング区分ソート: 円未満(1) → 円以上~円未満(2) → 円以上(3) → サプライ(99)
   610	                CASE
   611	                    WHEN EXISTS (
   612	                        SELECT 1 FROM dtb_product_category pcat
   613	                        WHERE pcat.product_id = p.id
   614	                          AND pcat.category_id IN (:goods_category_id, :reserved_goods_category_id)
   615	                    ) THEN {$pickingTypeSortSupply}
   616	                    WHEN pc.standard_price IS NULL THEN {$pickingTypeSortNullStandardPrice}
   617	                    -- バリデーションでbiは1店舗のみの前提のため、threhold1,2,3の価格順やnullableに依存せず、閾値を超えた数で区間番号を求めてソートtierを決定する
   618	                    ELSE
   619	                        (
   620	                            (CASE WHEN bi.expensive_threshold1 IS NOT NULL AND pc.standard_price >= bi.expensive_threshold1 THEN 1 ELSE 0 END)
   621	                            + (CASE WHEN bi.expensive_threshold2 IS NOT NULL AND pc.standard_price >= bi.expensive_threshold2 THEN 1 ELSE 0 END)
   622	                            + (CASE WHEN bi.expensive_threshold3 IS NOT NULL AND pc.standard_price >= bi.expensive_threshold3 THEN 1 ELSE 0 END)
   623	                        ) + 1
   624	                END AS "pickingTypeSort",
   625	                sn.name AS "shelfNumberName",
   626	                o.base_info_id AS "baseInfoId",
   627	                -- 棚番ソート: 本店のみ棚番順、支店は棚番によるソートを行わない（全て0で同順）
   628	                CASE WHEN o.base_info_id = :main_store_id THEN COALESCE(sn.sort_no, 99999) ELSE 0 END AS "shelfSort",
   629	                -- 言語ソート: mtb_language.id 昇順（日→英→他言語はマスターの並び順に依存）
   630	                COALESCE(lng.id, 99999) AS "languageSort",
   631	                -- 状態ソート: mtb_card_condition.id 昇順（NM→HP はマスターの並び順に依存）
   632	                COALESCE(pc.card_condition_id, 99999) AS "conditionSort",
   633	                -- Foilソート: 非Foil(0)→Foil(1以上)
   634	                COALESCE(cd.foil_flg, 0) AS "foilSort",
   635	                -- 略称タグソート: mtb_storage_code.rank 昇順
   636	                COALESCE(sc.rank, 99999) AS "storageCodeSort",
   637	                -- レアリティソート: mtb_rarity.sort_no 昇順（M→C はマスターの並び順に依存）
   638	                COALESCE(r.sort_no, 99999) AS "raritySort",
   639	                -- 色ソート: mtb_card.color_sequence_id → mtb_color_sequence.sort_no 昇順
   640	                COALESCE(cs.sort_no, 99999) AS "colorSort",
   641	                -- カードソート: alphabet_sort_flgがtrueの略称タグ→英語カード名昇順、falseならコレクター番号昇順
   642	                CASE WHEN sc.alphabet_sort_flg = true THEN c.name_en ELSE cd.card_no END AS "cardSort"
   643	            FROM dtb_otc_buy_order_stock s
   644	            JOIN dtb_otc_buy_order o ON o.id = s.otc_buy_order_id
   645	            JOIN dtb_base_info bi ON bi.id = o.base_info_id
   646	            JOIN dtb_product_class pc ON pc.id = s.product_class_id
   647	            JOIN dtb_product p ON p.id = pc.product_id
   648	            LEFT JOIN mtb_card_condition cond ON cond.id = pc.card_condition_id
   649	            LEFT JOIN mtb_storage_code sc ON sc.id = p.storage_code_id
   650	            LEFT JOIN mtb_card_detail cd ON cd.id = p.card_detail_id
   651	            LEFT JOIN mtb_rarity r ON r.id = cd.rarity_id
   652	            LEFT JOIN mtb_language lng ON lng.id = pc.language_id
   653	            LEFT JOIN mtb_card c ON c.id = cd.card_id
   654	            LEFT JOIN mtb_color_sequence cs ON cs.id = c.color_sequence_id
   655	            LEFT JOIN dtb_shelf_number sn ON sn.id = pc.shelf_number_id
   656	            WHERE
   657	                s.otc_buy_order_id IN (:ids)
   658	                AND o.otc_buy_order_status_id <> :cancel_status_id
   659	            GROUP BY
   660	                pc.id, p.id, p.name, sc.name, sc.rank, sc.alphabet_sort_flg,
   661	                lng.id, lng.code, cond.code, r.code, r.sort_no,
   662	                cd.foil_flg, cd.card_no, pc.standard_price,
   663	                bi.expensive_threshold1, bi.expensive_threshold2, bi.expensive_threshold3,
   664	                c.id, c.name_en, c.color_sequence_id,
   665	                cs.sort_no, sn.sort_no, sn.name, o.base_info_id
   666	            ORDER BY
   667	                -- 1. ピッキング区分: 円未満→円以上〜円未満→円以上→サプライ
   668	                "pickingTypeSort" ASC,
   669	                -- 2. 棚番: 本店のみ昇順（支店は棚番ソートなし）
   670	                "shelfSort" ASC,
   671	                -- 3. 言語: 日→英→他言語
   672	                "languageSort" ASC,
   673	                -- 4. 状態: NM→HP
   674	                "conditionSort" ASC,
   675	                -- 5. Foilフラグ: 非Foil→Foil
   676	                "foilSort" ASC,
   677	                -- 6. 略称タグ: 昇順
   678	                "storageCodeSort" ASC,
   679	                -- 7. レアリティ: M→C
   680	                "raritySort" ASC,
   681	                -- 8. 色: マスターデータ色順（mtb_color_sequence.sort_no）
   682	                "colorSort" ASC,
   683	                -- 9. 略称タグがアルファベットソートなら英語カード名昇順、コレクター番号ソートならcard_no昇順
   684	                "cardSort" ASC
   685	        SQL;
   686	
   687	        $rawData = $conn->iterateAssociative(
   688	            $sql,
   689	            [
   690	                'ids' => $otcBuyOrderIds,
   691	                'cancel_status_id' => self::CANCEL_STATUS_ID,
   692	                'goods_category_id' => Category::GOODS_ID,
   693	                'reserved_goods_category_id' => Category::RESERVED_GOODS_ID,
   694	                'main_store_id' => BaseInfo::TC_TOKYO_ID,
   695	            ],
   696	            [
   697	                'ids' => ArrayParameterType::INTEGER,
   698	                'cancel_status_id' => \PDO::PARAM_INT,
   699	                'goods_category_id' => \PDO::PARAM_INT,
   700	                'reserved_goods_category_id' => \PDO::PARAM_INT,
   701	                'main_store_id' => \PDO::PARAM_INT,
   702	            ]
   703	        );
   704	
   705	        return $rawData;
   706	    }
   707	
   708	    /**
   709	     * 日別店舗別に査定番号を採番
   710	     */

