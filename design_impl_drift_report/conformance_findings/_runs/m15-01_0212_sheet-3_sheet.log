   120	    public function delete(?DtbDeck $Deck, ?Member $Member): void
   121	    {
   122	        if ($Deck === null) {
   123	            return;
   124	        }
   125	
   126	        foreach ($Deck->getDeckCards() as $DeckCard) {
   127	            $this->entityManager->remove($DeckCard);
