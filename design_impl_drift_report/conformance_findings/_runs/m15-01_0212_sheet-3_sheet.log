   347	    public function getDeckCountByFormatId(int $formatId, int $metaRange, int $limit): array
   348	    {
   349	        $redisKey = sprintf('redis_deck_top_usage_%d_%d_%d', $formatId, $metaRange, $limit);
   350	
   351	        try {
   352	            $cached = $this->redisService->get($redisKey);
   353	            if (is_string($cached) && $cached !== '') {
   354	                $decoded = json_decode($cached, true);
   355	                if (is_array($decoded)) {
   356	                    return $decoded;
   357	                }
   358	            }
   359	        } catch (\Throwable) {
   360	        }
   361	
   362	        $from = new \DateTime($this->getMetaDate($metaRange));
   363	        $to = (new \DateTime())->setTime(23, 59, 59);
   364	
   365	        $qb = $this->createQueryBuilder('d')
   366	            ->select([
   367	                'ci.url',
   368	                'a.nameJp',
   369	                'a.nameEn',
   370	                'COUNT(d.id) AS deckcount',
   371	                'IDENTITY(d.Archetype) AS archetypeId',
   372	            ])
   373	            ->innerJoin('d.Archetype', 'a')
   374	            ->leftJoin('a.CardImage', 'ci')
   375	            ->where('IDENTITY(d.Format) = :formatId')
   376	            ->andWhere('IDENTITY(d.DeckType) = :deckType')
   377	            ->andWhere('IDENTITY(d.Disp) = :dispId')
   378	            ->andWhere('d.eventDate BETWEEN :from AND :to')
   379	            ->setParameter('formatId', $formatId)
   380	            ->setParameter('deckType', MtbDeckType::EVENT_ID)
   381	            ->setParameter('dispId', MtbDisp::DISPLAY_SHOW)
   382	            ->setParameter('from', $from)
   383	            ->setParameter('to', $to)
   384	            ->groupBy('d.Archetype', 'ci.url', 'a.nameJp', 'a.nameEn')
   385	            ->orderBy('deckcount', 'DESC');
   386	
   387	        if ($limit > 0) {
   388	            $qb->setMaxResults($limit);
   389	        }
   390	
   391	        /** @var array<int, array{url: ?string, nameJp: string, nameEn: string, deckcount: int, archetypeId: int}> $result */
   392	        $result = $qb->getQuery()->getResult();
   393	
   394	        try {
   395	            $this->redisService->set($redisKey, json_encode($result), self::USING_DECK_TOP_RESULT_REDIS_CACHING_TIME);
