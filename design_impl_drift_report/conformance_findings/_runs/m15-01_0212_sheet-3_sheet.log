   173	     *   - イベントID → イベント詳細ID に差し替え
   174	     *
   175	     * @param array<string, mixed> $searchData
   176	     */
   177	    public function getQueryBuilderBySearchData(array $searchData): QueryBuilder
   178	    {
   179	        $qb = $this->createQueryBuilder('d');
   180	
   181	        // 大会開始時刻前のデッキは検索結果に表示しない
   182	        $qb->leftJoin('d.EventDetail', 'ed', Join::WITH, 'ed.startDate < :time OR IDENTITY(d.EventDetail) IS NULL')
   183	            ->andWhere('ed.startDate < :time OR IDENTITY(d.EventDetail) IS NULL')
   184	            ->setParameter('time', new \DateTime());
   185	
   186	        // ユーザ作成のデッキは検索結果に表示しない
   187	        $qb->andWhere('IDENTITY(d.DeckType) = :deckType')
   188	            ->setParameter('deckType', MtbDeckType::EVENT_ID);
   189	
   190	        // デッキID
   191	        if (!empty($searchData['deck_id'])) {
   192	            SqlUtil::searchByIds($qb, $searchData['deck_id'], 'd', 'id');
   193	        }
   194	
   195	        // デッキ名（部分一致、スペース/カンマ区切りで複数検索）
   196	        if (!empty($searchData['deck_name'])) {
   197	            $texts = preg_split('/[\s,　]+/u', $searchData['deck_name']);
   198	            SqlUtil::multiTextQuery($qb, $texts, ['d' => ['deckName']]);
   199	        }
   200	
   201	        // フォーマット
   202	        if (!empty($searchData['formats']) && count($searchData['formats']) > 0) {
   203	            $qb->andWhere($qb->expr()->in('d.Format', ':formats'))
   204	                ->setParameter('formats', $searchData['formats']);
   205	        }
   206	
   207	        // アーキタイプ
   208	        if (!empty($searchData['archetypes']) && count($searchData['archetypes']) > 0) {
   209	            $qb->andWhere($qb->expr()->in('d.Archetype', ':archetypes'))
   210	                ->setParameter('archetypes', $searchData['archetypes']);
   211	        }
   212	
   213	        // カラー（アーキタイプ経由）
   214	        if (!empty($searchData['color']) && count($searchData['color']) > 0) {
   215	            $qb->join('d.Archetype', 'da')
   216	                ->join('da.Colors', 'co', Join::WITH, $qb->expr()->in('co.id', ':colors'))
   217	                ->setParameter('colors', $searchData['color']);
   218	        }
   219	
   220	        // 公開状態
   221	        if (!empty($searchData['disp']) && count($searchData['disp']) > 0) {
   222	            $qb->andWhere($qb->expr()->in('d.Disp', ':disp'))
   223	                ->setParameter('disp', $searchData['disp']);
   224	        }
   225	
   226	        // デッキリスト公開状態
   227	        if (!empty($searchData['private_flg']) && count($searchData['private_flg']) === 1) {
   228	            $qb->andWhere('d.privateFlg = :privateFlg')
   229	                ->setParameter('privateFlg', $searchData['private_flg'][0]);
   230	        }
   231	
   232	        // イベント開催日（From）
   233	        if (!empty($searchData['event_date_from'])) {
   234	            $from = (clone $searchData['event_date_from'])->setTime(0, 0, 0);
   235	            $qb->andWhere('d.eventDate >= :eventDateFrom')
   236	                ->setParameter('eventDateFrom', $from);
   237	        }
   238	
   239	        // イベント開催日（To）
   240	        if (!empty($searchData['event_date_to'])) {
   241	            $to = (clone $searchData['event_date_to'])->setTime(23, 59, 59);
   242	            $qb->andWhere('d.eventDate <= :eventDateTo')
   243	                ->setParameter('eventDateTo', $to);
   244	        }
   245	
   246	        // 順位（From/To）
   247	        if (!empty($searchData['ranking_from'])) {
   248	            $qb->andWhere('d.ranking >= :rankingFrom')
   249	                ->setParameter('rankingFrom', $searchData['ranking_from']);
   250	        }
   251	        if (!empty($searchData['ranking_to'])) {
   252	            $qb->andWhere('d.ranking <= :rankingTo')
   253	                ->setParameter('rankingTo', $searchData['ranking_to']);
   254	        }
   255	
   256	        // 成績（部分一致）
   257	        if (!empty($searchData['result'])) {
   258	            $texts = preg_split('/[\s,　]+/u', $searchData['result']);
   259	            SqlUtil::multiTextQuery($qb, $texts, ['d' => ['result']]);
   260	        }
   261	
   262	        // イベント名（部分一致、日英）
   263	        if (!empty($searchData['event_name'])) {
   264	            $texts = preg_split('/[\s,　]+/u', $searchData['event_name']);
   265	            SqlUtil::multiTextQuery($qb, $texts, ['d' => ['eventNameJp', 'eventNameEn']]);
   266	        }
   267	
   268	        // プレイヤー名（部分一致）
   269	        if (!empty($searchData['player_name'])) {
   270	            $texts = preg_split('/[\s,　]+/u', $searchData['player_name']);
   271	            SqlUtil::multiTextQuery($qb, $texts, ['d' => ['playerName']]);
   272	        }
   273	
   274	        // デッキタグ（AND検索）
   275	        if (!empty($searchData['deck_tags'])) {
   276	            foreach ($searchData['deck_tags'] as $deckTagIdx => $DeckTag) {
   277	                if ($DeckTag === null) {
   278	                    continue;
   279	                }
   280	                $qb->join('d.DeckTags', 'dt'.$deckTagIdx, Join::WITH, "dt{$deckTagIdx}.id = :deckTag{$deckTagIdx}")
   281	                    ->setParameter("deckTag{$deckTagIdx}", $DeckTag);
   282	            }
   283	        }
   284	
   285	        // カード名（完全一致、日英）
   286	        if (!empty($searchData['card'])) {
   287	            $qb->join('d.DeckCards', 'dc')
   288	                ->join('dc.Card', 'c', Join::WITH, $qb->expr()->orX(
   289	                    $qb->expr()->eq('c.nameJp', ':card'),
   290	                    $qb->expr()->eq('c.nameEn', ':card')
   291	                ))
   292	                ->setParameter('card', $searchData['card']);
   293	        }
   294	
   295	        // ★イベント詳細ID（カスタマイズ: イベントIDから差し替え）
   296	        if (!empty($searchData['event_detail_id'])) {
   297	            SqlUtil::searchByIds($qb, $searchData['event_detail_id'], 'ed', 'id');
   298	        }
   299	
   300	        // 開催店舗
   301	        if (!empty($searchData['shop'])) {
   302	            $qb->join('ed.Event', 'e')
   303	                ->join('e.BaseInfo', 'bi', Join::WITH, 'bi = :shop')
   304	                ->setParameter('shop', $searchData['shop']);
   305	        }
   306	
   307	        // 最終更新者
   308	        if (!empty($searchData['member'])) {
   309	            $qb->andWhere('d.Member = :member')
   310	                ->setParameter('member', $searchData['member']);
   311	        }
   312	
   313	        // ソート
   314	        $sortKey = $searchData['sortKey'] ?? self::DEFAULT_SORT_KEY;
   315	        $sortOrder = strtoupper((string) ($searchData['sortOrder'] ?? self::DEFAULT_SORT_ORDER));
   316	        if (!in_array($sortOrder, ['ASC', 'DESC'], true)) {
   317	            $sortOrder = self::DEFAULT_SORT_ORDER;
   318	        }
   319	        $sortColumn = $this->sortKeys[$sortKey] ?? $this->sortKeys[self::DEFAULT_SORT_KEY];
   320	        $qb->orderBy($sortColumn, $sortOrder);
   321	
   322	        return $qb;
   323	    }
