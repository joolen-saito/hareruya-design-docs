    16	namespace Eccube\Service\Admin\Deck;
    17	
    18	use Doctrine\ORM\EntityManagerInterface;
    19	use Eccube\Repository\DtbDeckRepository;
    20	use Eccube\Service\Admin\Deck\ActionInput\DeckBulkDeleteInput;
    21	use Eccube\Service\EntityManager\DeckEntityManager;
    22	use Symfony\Component\HttpKernel\Exception\NotFoundHttpException;
    23	
    24	class DeckBulkDeleteAction
    25	{
    26	    public function __construct(
    27	        private readonly DtbDeckRepository $deckRepository,
    28	        private readonly EntityManagerInterface $entityManager,
    29	        private readonly DeckEntityManager $deckEntityManager,
    30	    ) {
    31	    }
    32	
    33	    /**
    34	     * @throws NotFoundHttpException デッキが見つからない場合
    35	     * @throws \RuntimeException 記事に紐付いている場合
    36	     * @throws \Exception 削除処理で例外が発生した場合
    37	     */
    38	    public function handle(DeckBulkDeleteInput $input): void
    39	    {
    40	        try {
    41	            $this->entityManager->beginTransaction();
    42	            foreach ($input->deckIds as $deckId) {
    43	                if (!ctype_digit((string) $deckId)) {
    44	                    $this->entityManager->rollback();
    45	                    throw new NotFoundHttpException();
    46	                }
    47	
    48	                $Deck = $this->deckRepository->find((int) $deckId);
    49	                if ($Deck === null) {
    50	                    $this->entityManager->rollback();
    51	                    throw new NotFoundHttpException();
    52	                }
    53	
    54	                if ($Deck->getArticles()->count() > 0) {
    55	                    $this->entityManager->rollback();
    56	                    throw new \RuntimeException('admin.deck.delete_error_article');
    57	                }
    58	
    59	                $this->deckEntityManager->delete($Deck, $input->Member);
    60	            }
    61	            $this->entityManager->flush();
    62	            $this->entityManager->commit();
    63	        } catch (NotFoundHttpException|\RuntimeException $e) {
    64	            throw $e;
    65	        } catch (\Exception $e) {
    66	            $this->entityManager->rollback();
    67	            throw $e;
    68	        }
    69	    }
    70	}

