    20	use Eccube\Repository\DtbMonthlySummaryRepository;
    21	
    22	class BatchAggregateMonthlySummaryAction
    23	{
    24	    public function __construct(
    25	        private readonly EntityManagerInterface $entityManager,
    26	        private readonly DtbDailySummaryRepository $dailySummaryRepository,
    27	        private readonly DtbMonthlySummaryRepository $monthlySummaryRepository,
    28	    ) {
    29	    }
    30	
    31	    public function handle(\DateTimeInterface $targetMonth): int
    32	    {
    33	        $monthStart = \DateTimeImmutable::createFromInterface($targetMonth)->modify('first day of this month')->setTime(0, 0, 0);
    34	        $monthEnd = $monthStart->modify('last day of this month')->setTime(23, 59, 59);
    35	
    36	        // 月内の日次集計を店舗ごとに合算する（sale_average は合算値ではないためここで算出する）
    37	        $dailyTotals = $this->dailySummaryRepository->aggregateMonthlyTotalsByBaseInfo($monthStart, $monthEnd);
    38	
    39	        $connection = $this->entityManager->getConnection();
    40	        $connection->beginTransaction();
    41	        try {
    42	            // 再集計に備え、対象月の既存集計を一旦すべて削除してから登録し直す。
    43	            // 失敗時はトランザクションごとロールバックされ、削除前の状態に戻る。
    44	            $this->monthlySummaryRepository->deleteBySummaryMonth($monthStart);
    45	
    46	            $affected = 0;
    47	            foreach ($dailyTotals as $row) {
    48	                $baseInfoId = (int) ($row['base_info_id'] ?? 0);
    49	                $grossSales = (int) ($row['gross_sales'] ?? 0);
    50	                $saleCount = (int) ($row['sale_count'] ?? 0);
    51	                $saleAverage = $saleCount > 0
    52	                    ? (int) round($grossSales / $saleCount, 0, PHP_ROUND_HALF_UP)
    53	                    : 0;
    54	
    55	                $this->monthlySummaryRepository->insertMonthlySummary(
    56	                    $monthStart,
    57	                    $baseInfoId,
    58	                    [
    59	                        'gross_sales' => $grossSales,
    60	                        'total_cost' => (int) ($row['total_cost'] ?? 0),
    61	                        'gross_profit' => (int) ($row['gross_profit'] ?? 0),
    62	                        'sale_quantity' => (int) ($row['sale_quantity'] ?? 0),
    63	                        'sale_count' => $saleCount,
    64	                        'sale_average' => $saleAverage,
    65	                        'purchase_count' => (int) ($row['purchase_count'] ?? 0),
    66	                        'purchase_amount' => (int) ($row['purchase_amount'] ?? 0),
    67	                        'waste_count' => (int) ($row['waste_count'] ?? 0),
    68	                        'shortage_count' => (int) ($row['shortage_count'] ?? 0),
    69	                    ]
    70	                );
    71	                ++$affected;
    72	            }
    73	
    74	            $connection->commit();
    75	
    76	            return $affected;
    77	        } catch (\Throwable $e) {
    78	            $connection->rollBack();
    79	            throw $e;
    80	        }
    81	    }
    82	}

