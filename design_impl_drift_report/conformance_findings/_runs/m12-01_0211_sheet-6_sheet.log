p=Path('/home/y-saito/Developments/hareruya-design-docs/excel_to_html/output/0211_基本設計仕様書(分析・集計管理機能)_詳細設計.html')
lines=p.read_text(encoding='utf-8').splitlines()
start=end=None
for i,l in enumerate(lines,1):
    if 'id=\"sheet-6\"' in l:
        start=i
    elif start and 'id=\"sheet-7\"' in l:
        end=i; break
print('section lines',start,end)
class P(HTMLParser):
    def __init__(self): super().__init__(); self.text=[]; self.skip=False
    def handle_starttag(self, tag, attrs):
        if tag in ('script','style'): self.skip=True
        if tag in ('p','h2','h3','h4','div','td','th','li','dt','dd','tr','span','code'):
            self.text.append('\\n')
    def handle_endtag(self, tag):
        if tag in ('script','style'): self.skip=False
    def handle_data(self, data):
        if not self.skip:
            s=' '.join(data.split())
            if s: self.text.append(s+' ')
parser=P(); parser.feed('\\n'.join(lines[start-1:end-1]))
out=''.join(parser.text)
# normalize blanks
for n,line in enumerate([x.strip() for x in out.splitlines() if x.strip()], start=1):
    print(f'{n}: {line}')
