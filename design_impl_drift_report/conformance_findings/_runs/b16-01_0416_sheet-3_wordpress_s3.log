    55	    /**
    56	     * @throws \RuntimeException
    57	     */
    58	    private function fetchWordPressResponseBody(): string
    59	    {
    60	        try {
    61	            $response = $this->httpClient->request('GET', self::WP_API_URL);
    62	        } catch (GuzzleException $e) {
    63	            throw new \RuntimeException('WordPress記事の取得に失敗しました。: '.$e->getMessage(), 0, $e);
    64	        }
    65	
    66	        $statusCode = $response->getStatusCode();
    67	        if ($statusCode !== 200) {
    68	            throw new \RuntimeException(sprintf('WordPress APIの取得に失敗しました。HTTPステータス: %d', $statusCode));
    69	        }
    70	
    71	        $body = (string) $response->getBody();
    72	        if ($body === '') {
    73	            throw new \RuntimeException('WordPress APIのレスポンス本文が空です。');
    74	        }
    75	
    76	        return $body;
    77	    }
    78	
    79	    /**
    80	     * JSONファイルを保存する
