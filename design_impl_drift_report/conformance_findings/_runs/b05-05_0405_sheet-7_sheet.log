    22	use Psr\Log\LoggerInterface;
    23	use Symfony\Component\Messenger\MessageBusInterface;
    24	
    25	/**
    26	 * 店頭受取注文 (OTC) スマレジ商品削除バッチ用ディスパッチャ。
    27	 *
    28	 * 同一 DB トランザクション内で MessengerJob を pending で永続化 → commit 成功後に
    29	 * MessageBus へ dispatch する。dispatch 失敗時は MessengerJob を FAILED に遷移させ
    30	 * 例外を再 throw する ({@see SmaregiOtcSyncDispatcher} と同方針)。
    31	 */
    32	final readonly class SmaregiOtcDeleteDispatcher
    33	{
    34	    public function __construct(
    35	        private MessageBusInterface $messageBus,
    36	        private EntityManagerInterface $entityManager,
    37	        private LoggerInterface $logger,
    38	    ) {
    39	    }
    40	
    41	    public function dispatch(Order $Order): MessengerJob
    42	    {
    43	        $orderId = $Order->getId();
    44	        if ($orderId === null) {
    45	            throw new \InvalidArgumentException('Order id is null; cannot enqueue Smaregi OTC delete job.');
    46	        }
    47	
    48	        $Job = new MessengerJob();
    49	        $Job->setMessageClass(SmaregiOtcDeleteMessage::class);
    50	        $Job->setStatus(MessengerJob::STATUS_PENDING);
    51	        $Job->setPayloadSummary(sprintf(
    52	            'orderId=%d orderNo=%s smaregiCode=%s',
    53	            $orderId,
    54	            (string) ($Order->getOrderNo() ?? ''),
    55	            (string) ($Order->getSmaregiCode() ?? ''),
    56	        ));
    57	        $this->entityManager->persist($Job);
    58	        $this->entityManager->flush();
    59	
    60	        try {
    61	            $this->messageBus->dispatch(new SmaregiOtcDeleteMessage(
    62	                $orderId,
    63	                (int) $Job->getId(),
    64	            ));
    65	        } catch (\Throwable $e) {
    66	            try {
    67	                $Job->setStatus(MessengerJob::STATUS_FAILED);
    68	                $Job->setCompletedAt(new \DateTime());
    69	                $Job->setErrorMessage('メッセージバスへの投入に失敗しました: '.$e->getMessage());
    70	                $this->entityManager->flush();
    71	            } catch (\Throwable $persistError) {
    72	                $this->logger->error('Failed to persist Smaregi OTC delete job failure state', [
    73	                    'jobId' => $Job->getId(),
    74	                    'orderId' => $orderId,
    75	                    'error' => $persistError->getMessage(),
    76	                ]);
    77	            }
    78	            $this->logger->error('Smaregi OTC delete message dispatch failed', [
    79	                'exception' => $e,
    80	                'jobId' => $Job->getId(),
    81	                'orderId' => $orderId,
    82	            ]);
    83	
    84	            throw $e;
    85	        }
    86	
    87	        return $Job;
    88	    }
    89	}

