   114	    {
   115	        if ($result === SmaregiOtcDeleteResult::DELETE_FAILED) {
   116	            $this->failJob($Job, sprintf('Smaregi OTC delete failed: result=%s', $result->value));
   117	
   118	            return;
   119	        }
   120	
   121	        $Job->setStatus(MessengerJob::STATUS_COMPLETED);
   122	        $Job->setCompletedAt(new \DateTime());
   123	        $Job->setErrorMessage(null);
   124	        $this->entityManager->flush();
   125	
   126	        $this->logger->info('Smaregi OTC delete handler completed', [
   127	            'jobId' => $Job->getId(),
   128	            'orderId' => $orderId,
   129	            'result' => $result->value,
   130	        ]);
   131	    }
   132	
   133	    private function failJob(MessengerJob $Job, string $message): void
   134	    {
   135	        try {
   136	            $Job->setStatus(MessengerJob::STATUS_FAILED);
   137	            $Job->setCompletedAt(new \DateTime());
   138	            $Job->setErrorMessage($message);
   139	            $this->entityManager->flush();
   140	        } catch (\Throwable $persistError) {
   141	            $this->logger->error('Failed to persist Smaregi OTC delete job failure state', [
   142	                'jobId' => $Job->getId(),
   143	                'error' => $persistError->getMessage(),
   144	            ]);
   145	        }
   146	    }
   147	}

