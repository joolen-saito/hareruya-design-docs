    28	
    29	/**
    30	 * 店頭受取注文 (OTC) スマレジ商品削除バッチ。
    31	 *
    32	 * 手続き完了済み (引渡し済み PASSED / 出荷完了 DELIVERED / キャンセル CANCEL) かつ smaregi_code 連携済み・
    33	 * smaregi_del_flg 未 ON の店頭受取注文を抽出し、1 件ごとに MessengerJob を enqueue する。
    34	 * 実処理 (Smaregi 商品削除 API 実行) は {@see \Eccube\MessageHandler\SmaregiOtcDeleteMessageHandler}
    35	 * が Messenger ワーカー上で消化する。
    36	 *
    37	 * 実行タイミング: 毎日 4 時 / スケジュール起動 (Step Functions)
    38	 */
    39	#[AsCommand(name: 'eccube:smaregi:otc:delete', description: '店頭受取注文スマレジ商品削除バッチ (MessengerJob を enqueue する)')]
    40	final class SmaregiOtcDeleteCommand extends Command
    41	{
    42	    public function __construct(
    43	        private readonly LoggerInterface $logger,
    44	        private readonly SmaregiOtcDeleteDispatcher $dispatcher,
    45	        private readonly OrderRepository $orderRepository,
    46	    ) {
    47	        parent::__construct();
    48	    }
    49	
    50	    #[\Override]
    51	    protected function configure(): void
    52	    {
    53	        $this
    54	            ->addOption('order-id', null, InputOption::VALUE_REQUIRED, '特定の受注 ID のみ enqueue する')
    55	            ->addOption('limit', null, InputOption::VALUE_REQUIRED, '一括 enqueue する受注の最大件数', '100');
    56	    }
    57	
    58	    #[\Override]
    59	    protected function execute(InputInterface $input, OutputInterface $output): int
    60	    {
    61	        $io = new SymfonyStyle($input, $output);
    62	
    63	        $orderIdOption = $input->getOption('order-id');
    64	        if ($orderIdOption !== null) {
    65	            $orders = $this->loadSingleOrder((string) $orderIdOption, $io);
    66	            if ($orders === null) {
    67	                return Command::FAILURE;
    68	            }
    69	        } else {
    70	            $limitOption = $input->getOption('limit');
    71	            if (!is_string($limitOption) || !ctype_digit($limitOption) || (int) $limitOption < 1) {
    72	                $io->error('--limit は 1 以上の数値を指定してください。');
    73	
    74	                return Command::FAILURE;
    75	            }
    76	            $limit = (int) $limitOption;
    77	            $orders = $this->orderRepository->getDeleteSmaregiProduct($limit);
    78	        }
    79	
    80	        if ($orders === []) {
    81	            $io->success('対象受注はありません。');
    82	
    83	            return Command::SUCCESS;
    84	        }
    85	
    86	        $enqueued = 0;
    87	        $failed = 0;
    88	        foreach ($orders as $Order) {
    89	            try {
    90	                $Job = $this->dispatcher->dispatch($Order);
    91	                ++$enqueued;
    92	                $io->writeln(sprintf('  - orderId=%d jobId=%d enqueued', $Order->getId() ?? 0, $Job->getId() ?? 0));
    93	            } catch (\Throwable $e) {
    94	                ++$failed;
    95	                $this->logger->error('Smaregi OTC delete enqueue failed', [
    96	                    'orderId' => $Order->getId(),
    97	                    'error' => $e->getMessage(),
    98	                ]);
    99	                $io->writeln(sprintf('  - orderId=%d enqueue_failed: %s', $Order->getId() ?? 0, $e->getMessage()));
   100	            }
   101	        }
   102	
   103	        $message = sprintf('OTC delete enqueue completed: enqueued=%d failed=%d', $enqueued, $failed);
   104	
   105	        if ($failed > 0) {
   106	            $io->error($message);
   107	
   108	            return Command::FAILURE;
   109	        }
   110	
   111	        $io->success($message);
   112	
   113	        return Command::SUCCESS;
   114	    }
   115	
   116	    /**
   117	     * @return list<Order>|null  null は失敗 (エラー出力済み)
   118	     */
   119	    private function loadSingleOrder(string $orderId, SymfonyStyle $io): ?array
   120	    {
   121	        if (!ctype_digit($orderId)) {
   122	            $io->error('--order-id は数値で指定してください。');
   123	
   124	            return null;
   125	        }
   126	        $Order = $this->orderRepository->find((int) $orderId);
   127	        if (!$Order instanceof Order) {
   128	            $io->error(sprintf('受注 ID %s が見つかりません。', $orderId));
   129	
   130	            return null;
   131	        }
   132	
   133	        return [$Order];
   134	    }
   135	}

