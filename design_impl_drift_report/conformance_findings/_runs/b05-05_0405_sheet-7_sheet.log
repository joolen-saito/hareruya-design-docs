    27	 *   1. Order.smaregi_del_flg / smaregi_code をスキップ判定
    28	 *   2. productCode (= Order.smaregi_code) で Smaregi 商品 ID を解決
    29	 *      ({@see SmaregiOtcOrderSyncService::resolveProductIdByCode()} と同方針)
    30	 *   3. 解決した productId に対して商品削除 API (DELETE /pos/products/{productId}) を実行
    31	 *   4. 成功または「Smaregi 側に存在しなかった」場合は Order.smaregi_del_flg を ON にする
    32	 *
    33	 * 失敗時は smaregi_error_flg は触らない (OTC sync 側で使う運用と区別)。
    34	 * MessengerJob 側で FAILED 遷移されることで再試行を運用に委ねる方針。
    35	 */
    36	final readonly class SmaregiOtcDeleteService
    37	{
    38	    public function __construct(
    39	        private LoggerInterface $logger,
    40	        private EntityManagerInterface $entityManager,
    41	        private SmaregiProductApiClient $productApiClient,
    42	    ) {
    43	    }
    44	
    45	    public function delete(
    46	        Order $Order,
    47	        string $apiUrl,
    48	        string $contractId,
    49	        string $accessToken,
    50	    ): SmaregiOtcDeleteResult {
    51	        if ($Order->isSmaregiDelFlg()) {
    52	            return SmaregiOtcDeleteResult::ALREADY_DELETED;
    53	        }
    54	
    55	        $productCode = $Order->getSmaregiCode();
    56	        if ($productCode === null || $productCode === '') {
    57	            $this->logger->warning('Smaregi OTC delete skipped: smaregi_code is empty', [
    58	                'orderId' => $Order->getId(),
    59	            ]);
    60	
    61	            return SmaregiOtcDeleteResult::SKIPPED;
    62	        }
    63	
    64	        // 商品コード → スマレジ商品 ID を解決
    65	        $listResult = $this->productApiClient->listByProductCode($apiUrl, $contractId, $accessToken, $productCode);
    66	        if (!$this->isHttpSuccess($listResult['statusCode'])) {
    67	            // 通信/サーバ障害 (4xx/5xx) は「Smaregi 側に存在しない」とは区別する。
    68	            // ここでフラグを ON にすると未削除のまま完了扱いになり再試行されないため、
    69	            // フラグは据え置き DELETE_FAILED を返して MessengerJob の再試行に委ねる。
    70	            $this->logger->error('Smaregi product lookup failed', [
    71	                'orderId' => $Order->getId(),
    72	                'productCode' => $productCode,
    73	                'statusCode' => $listResult['statusCode'],
    74	            ]);
    75	
    76	            return SmaregiOtcDeleteResult::DELETE_FAILED;
    77	        }
    78	
    79	        $productId = $this->extractProductId($listResult['json'], $productCode);
    80	        if ($productId === null) {
    81	            // スマレジ側に該当 productCode の商品が無い (200 だが該当なし = 連携先で既に消えている可能性)。
    82	            // ローカル側の削除フラグだけ ON にして冪等な再試行を可能にする。
    83	            $this->markDeleted($Order);
    84	            $this->logger->info('Smaregi product not found, marked as deleted locally', [
    85	                'orderId' => $Order->getId(),
    86	                'productCode' => $productCode,
    87	            ]);
    88	
    89	            return SmaregiOtcDeleteResult::NOT_FOUND_ON_SMAREGI;
    90	        }
    91	
    92	        $deleteResult = $this->productApiClient->delete($apiUrl, $contractId, $accessToken, $productId);
    93	        if (!$this->isHttpSuccess($deleteResult['statusCode'])) {
    94	            $this->logger->error('Smaregi product delete failed', [
    95	                'orderId' => $Order->getId(),
    96	                'productCode' => $productCode,
    97	                'productId' => $productId,
    98	                'statusCode' => $deleteResult['statusCode'],
    99	            ]);
   100	
   101	            return SmaregiOtcDeleteResult::DELETE_FAILED;
   102	        }
   103	
   104	        $this->markDeleted($Order);
   105	
   106	        return SmaregiOtcDeleteResult::SUCCESS;
   107	    }
   108	
   109	    /**
   110	     * listByProductCode の応答 (HTTP 2xx) から productCode 完全一致行の productId を取り出す。
   111	     * HTTP 失敗の判定は呼び出し側で行い、障害と「未検出」を区別する
   112	     * ({@see SmaregiOtcOrderSyncService::resolveProductIdByCode()} と同等の突合ロジック)。
   113	     *
   114	     * @param mixed $json listByProductCode 応答の json 部
   115	     */
   116	    private function extractProductId(mixed $json, string $productCode): ?string
   117	    {
   118	        if (!is_array($json)) {
   119	            return null;
   120	        }
   121	
   122	        foreach ($json as $row) {
   123	            if (($row['productCode'] ?? null) !== $productCode) {
   124	                continue;
   125	            }
   126	            $productId = $row['productId'] ?? null;
   127	            if (is_string($productId) && $productId !== '') {
   128	                return $productId;
   129	            }
   130	        }
   131	
   132	        return null;
   133	    }
   134	
   135	    private function markDeleted(Order $Order): void
   136	    {
   137	        $Order->setSmaregiDelFlg(true);
   138	        $this->entityManager->flush();
   139	    }
   140	
   141	    private function isHttpSuccess(int $statusCode): bool
   142	    {
   143	        return $statusCode >= 200 && $statusCode < 300;
   144	    }
   145	}

