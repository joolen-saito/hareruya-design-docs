  3312	                <tr id="item-sheet-11-8"><td><a class="item-no" href="#pin-sheet-11-8">8</a></td><td>カラー</td><td>チェックボックス</td><td>-</td><td></td><td></td><td></td></tr>
  3313	                <tr id="item-sheet-11-9"><td><a class="item-no" href="#pin-sheet-11-9">9</a></td><td>フォーマット</td><td>セレクトボックス</td><td>〇</td><td></td><td></td><td></td></tr>
  3314	                <tr id="item-sheet-11-10"><td><a class="item-no" href="#pin-sheet-11-10">10</a></td><td>タグ</td><td>セレクトボックス</td><td>-</td><td></td><td></td><td>サジェスト機能</td></tr>
  3315	                <tr id="item-sheet-11-11"><td><a class="item-no" href="#pin-sheet-11-11">11</a></td><td>旧アーキタイプID</td><td>文字列</td><td>-</td><td></td><td></td><td>※カスタマイズ対応、項目を除去する</td></tr>
  3316	                <tr id="item-sheet-11-12"><td><a class="item-no" href="#pin-sheet-11-12">12</a></td><td>新規登録</td><td>ボタン</td><td>-</td><td></td><td></td><td>登録時のみ表示。<br>フォーム入力チェックを実施。<br>OKであれば登録を実施、NGがあればエラー内容を表示する。</td></tr>
  3317	                <tr id="item-sheet-11-13"><td><a class="item-no" href="#pin-sheet-11-13">13</a></td><td>更新</td><td>ボタン</td><td></td><td></td><td></td><td>編集時のみ表示。<br>フォーム入力チェックを実施。<br>OKであれば更新を実施、NGがあればエラー内容を表示する。</td></tr>
  3318	                <tr id="item-sheet-11-14"><td><a class="item-no" href="#pin-sheet-11-14">14</a></td><td>削除</td><td>ボタン</td><td>-</td><td></td><td></td><td>編集時のみ表示。<br>現在表示中のデッキ情報削除を確認するJSダイアログを表示<br>「OK」押下で削除を実行する</td></tr>
  3319	                <tr id="item-sheet-11-15"><td><a class="item-no" href="#pin-sheet-11-15">15</a></td><td>戻る</td><td>ボタン</td><td>-</td><td></td><td></td><td>ひとつ前のページに戻る</td></tr>
  3320	              </tbody>
