    30	class DtbArchetypeRepository extends AbstractRepository
    31	{
    32	    public const DEFAULT_SORT_KEY = 'default';
    33	    public const DEFAULT_SORT_ORDER = 'DESC';
    34	
    35	    /**
    36	     * 管理画面用ソートキー.
    37	     *
    38	     * @var array<string, string>
    39	     */
    40	    private array $sortKeys = [
    41	        'default' => 'a.id',
    42	        'archetypeName' => 'a.nameJp',
    43	        'registArchetypeCount' => 'registeredArchetypeCount',
    44	    ];
    45	
    46	    public function __construct(
    47	        ManagerRegistry $registry,
    48	    ) {
    49	        parent::__construct($registry, DtbArchetype::class);
    50	    }
    51	
    52	    /**
    53	     * @return array<string, string>
    54	     */
    55	    public function getSortKeys(): array
    56	    {
    57	        return $this->sortKeys;
    58	    }
    59	
    60	    /**
    61	     * 管理画面アーキタイプ検索用 QueryBuilder を構築する。
    62	     *
    63	     * ★カスタマイズ:
    64	     *   - 旧アーキタイプID の検索条件を除去
    65	     *
    66	     * @param array<string, mixed> $searchData
    67	     */
    68	    public function getQueryBuilderBySearchData(array $searchData): QueryBuilder
    69	    {
    70	        $qb = $this->createQueryBuilder('a')
    71	            ->leftJoin('a.Format', 'f')
    72	            ->addSelect('f')
    73	            ->leftJoin('a.CardImage', 'ci')
    74	            ->addSelect('ci')
    75	            ->leftJoin(
    76	                \Eccube\Entity\DtbDeck::class,
    77	                'd',
    78	                Join::WITH,
    79	                'a = d.Archetype AND IDENTITY(d.DeckType) = :deckType'
    80	            )
    81	            ->addSelect('COUNT(DISTINCT d.id) AS registeredArchetypeCount')
    82	            ->setParameter('deckType', MtbDeckType::EVENT_ID)
    83	            ->groupBy('a.id, f.id, ci.id');
    84	
    85	        // アーキタイプ名（部分一致、スペース/カンマ区切りで複数検索）
    86	        if (!empty($searchData['multi'])) {
    87	            $texts = preg_split('/[\s,　]+/u', (string) $searchData['multi']);
    88	            SqlUtil::multiTextQuery($qb, $texts, ['a' => ['nameJp', 'nameEn']]);
    89	        }
    90	
    91	        // フォーマット
    92	        if (!empty($searchData['formats']) && count($searchData['formats']) > 0) {
    93	            $qb->andWhere($qb->expr()->in('a.Format', ':formats'))
    94	                ->setParameter('formats', $searchData['formats']);
    95	        }
    96	
    97	        // カラー（AND検索）
    98	        if (!empty($searchData['colors'])) {
    99	            foreach ($searchData['colors'] as $colorIdx => $Color) {
   100	                if ($Color === null) {
   101	                    continue;
   102	                }
   103	                $qb->join('a.Colors', 'co'.$colorIdx, Join::WITH, "co{$colorIdx}.id = :color{$colorIdx}")
   104	                    ->setParameter("color{$colorIdx}", $Color);
   105	            }
   106	        }
   107	
   108	        // デッキタグ（AND検索）
   109	        if (!empty($searchData['deck_tags'])) {
   110	            foreach ($searchData['deck_tags'] as $deckTagIdx => $DeckTag) {
   111	                if ($DeckTag === null) {
   112	                    continue;
   113	                }
   114	                $qb->join('a.DeckTags', 'dt'.$deckTagIdx, Join::WITH, "dt{$deckTagIdx}.id = :deckTag{$deckTagIdx}")
   115	                    ->setParameter("deckTag{$deckTagIdx}", $DeckTag);
   116	            }
   117	        }
   118	
   119	        // ソート
   120	        $sortKey = (string) ($searchData['sortKey'] ?? $searchData['sort'] ?? self::DEFAULT_SORT_KEY);
   121	        $sortOrder = strtoupper((string) ($searchData['sortOrder'] ?? $searchData['order'] ?? self::DEFAULT_SORT_ORDER));
   122	        if (!in_array($sortOrder, ['ASC', 'DESC'], true)) {
   123	            $sortOrder = self::DEFAULT_SORT_ORDER;
   124	        }
   125	        $sortColumn = $this->sortKeys[$sortKey] ?? $this->sortKeys[self::DEFAULT_SORT_KEY];
   126	        $qb->orderBy($sortColumn, $sortOrder);
   127	
   128	        return $qb;
   129	    }
   130	
   131	    private const RESULT_CACHE_LIFETIME_SECONDS = 86400;
   132	
   133	    /**
   134	     * @return array<int, array{id: int, name_jp: string|null, name_en: string|null}>
   135	     */
   136	    public function getDeckBuilderArchetypesByFormat(MtbFormat $Format): array
   137	    {
   138	        return $this->createQueryBuilder('a')
   139	            ->select([
   140	                'a.id',
   141	                'a.nameJp AS name_jp',
   142	                'a.nameEn AS name_en',
   143	            ])
   144	            ->where('a.Format = :Format')
   145	            ->setParameter('Format', $Format)
   146	            ->getQuery()
   147	            ->enableResultCache(self::RESULT_CACHE_LIFETIME_SECONDS, 'archetypes_'.$Format->getId())
   148	            ->getResult();
   149	    }
   150	
   151	    /**
   152	     * @return array{id: int, name_jp: string|null, name_en: string|null}|null
   153	     */
   154	    public function getDeckBuilderArchetypeById(int $id): ?array
   155	    {
   156	        return $this->createQueryBuilder('a')
   157	            ->select([
   158	                'a.id',
   159	                'a.nameJp AS name_jp',
   160	                'a.nameEn AS name_en',
   161	            ])
   162	            ->where('a.id = :id')
   163	            ->setParameter('id', $id)
   164	            ->getQuery()
   165	            ->getOneOrNullResult();
   166	    }
   167	
   168	    /**
   169	     * デッキトップ・アーキタイプ検索条件
   170	     *
   171	     * @param int|null $formatId
   172	     *
   173	     * @return array<string, list<array{
   174	     *     arche: DtbArchetype,
   175	     *     code: string,
   176	     *     url: string|null,
   177	     *     colorNames: string
   178	     * }>>
   179	     */
   180	    public function getAllArcheType(?int $formatId = null): array
   181	    {
   182	        $qb = $this->createQueryBuilder('a')
   183	            ->innerJoin('a.Format', 'f')
   184	            ->addSelect('f')
   185	            ->leftJoin('a.CardImage', 'ci')
   186	            ->addSelect('ci')
   187	            ->leftJoin('a.Colors', 'c')
   188	            ->addSelect('c')
   189	            ->where('IDENTITY(a.Disp) = :dispId')
   190	            ->andWhere('a.deletedAt IS NULL')
   191	            ->setParameter('dispId', MtbDisp::DISPLAY_SHOW)
   192	            ->orderBy('f.rank', 'ASC')
   193	            ->addOrderBy('a.nameJp', 'ASC');
   194	
   195	        if ($formatId !== null) {
   196	            $qb->andWhere('IDENTITY(a.Format) = :formatId')
   197	                ->setParameter('formatId', $formatId);
   198	        }
   199	
   200	        $cacheId = $formatId === null ? 'all_archetypes' : 'all_archetypes_format_'.$formatId;
   201	        $archetypes = $qb->getQuery()
   202	            ->enableResultCache(self::RESULT_CACHE_LIFETIME_SECONDS, $cacheId)
   203	            ->getResult();
   204	
   205	        $grouped = [];
   206	        foreach ($archetypes as $arche) {
   207	            $code = $arche->getFormat()->getCode() ?? '';
   208	            $distinctNames = [];
   209	            foreach ($arche->getColors() as $color) {
   210	                $distinctNames[$color->getNameEn()] = true;
   211	            }
   212	            $grouped[$code][] = [
   213	                'arche' => $arche,
   214	                'code' => $code,
   215	                'url' => $arche->getCardImage()?->getUrl(),
   216	                'colorNames' => implode(',', array_keys($distinctNames)),
   217	            ];
   218	        }
   219	
   220	        return $grouped;
   221	    }
   222	}

