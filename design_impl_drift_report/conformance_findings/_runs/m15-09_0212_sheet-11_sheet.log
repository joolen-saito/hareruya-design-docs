   567	    #[Route('/%eccube_admin_route%/deck/search_card_image', name: 'admin_deck_search_card_image', methods: ['POST'])]
   568	    public function searchCardImage(Request $request): JsonResponse
   569	    {
   570	        $searchWord = $request->request->getString('search_word');
   571	        $exactMatch = $request->request->getString('exact_match') === '1';
   572	        $cardText = $request->request->getString('card_text');
   573	        $page = $request->request->getInt('page', 1);
   574	        $limit = 10;
   575	
   576	        $qb = $this->entityManager->createQueryBuilder()
   577	            ->select('ci.id', 'ci.url', 'c.name_jp', 'c.name_en')
   578	            ->from(\Eccube\Entity\Master\MtbCardImage::class, 'ci')
   579	            ->join('ci.CardDetail', 'cd')
   580	            ->join('cd.Card', 'c')
   581	            ->andWhere('ci.back_flg = false');
   582	
   583	        if (!empty($searchWord)) {
   584	            if ($exactMatch) {
   585	                $qb->andWhere('c.name_jp = :word OR c.name_en = :word')
   586	                    ->setParameter('word', $searchWord);
   587	            } else {
   588	                $words = preg_split('/[\s\x{3000},,]+/u', $searchWord, -1, PREG_SPLIT_NO_EMPTY) ?: [];
   589	                foreach ($words as $i => $word) {
   590	                    $param = 'word_'.$i;
   591	                    $qb->andWhere(sprintf('c.name_jp LIKE :%1$s OR c.name_en LIKE :%1$s', $param))
   592	                        ->setParameter($param, '%'.$word.'%');
   593	                }
   594	            }
   595	        }
   596	
   597	        if (!empty($cardText)) {
   598	            $textWords = preg_split('/[\s\x{3000},,]+/u', $cardText, -1, PREG_SPLIT_NO_EMPTY) ?: [];
   599	            foreach ($textWords as $i => $textWord) {
   600	                $param = 'cardText_'.$i;
   601	                $qb->andWhere(sprintf('c.text_jp LIKE :%1$s OR c.text_en LIKE :%1$s', $param))
   602	                    ->setParameter($param, '%'.$textWord.'%');
   603	            }
   604	        }
   605	
   606	        $countQb = clone $qb;
   607	        $countQb->select('COUNT(ci.id)');
   608	        $totalCount = (int) $countQb->getQuery()->getSingleScalarResult();
   609	        $totalPages = (int) ceil($totalCount / $limit);
   610	
   611	        $qb->setFirstResult(($page - 1) * $limit)
   612	            ->setMaxResults($limit);
   613	
   614	        $results = $qb->getQuery()->getResult();
   615	        $data = [];
   616	        foreach ($results as $row) {
   617	            $data[] = [
   618	                'id' => $row['id'],
   619	                'url' => $row['url'],
   620	                'nameJp' => $row['name_jp'] ?? '',
   621	                'nameEn' => $row['name_en'] ?? '',
   622	            ];
   623	        }
   624	
   625	        return new JsonResponse([
   626	            'items' => $data,
   627	            'totalCount' => $totalCount,
   628	            'page' => $page,
   629	            'totalPages' => $totalPages,
   630	        ]);
   631	    }
