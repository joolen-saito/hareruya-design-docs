   253	    #[Route('/%eccube_admin_route%/archetype/search_card_image', name: 'admin_archetype_search_card_image', methods: ['POST'])]
   254	    public function searchCardImage(Request $request): JsonResponse
   255	    {
   256	        $searchWord = $request->request->getString('search_word');
   257	        $exactMatch = $request->request->getString('exact_match') === '1';
   258	        $cardText = $request->request->getString('card_text');
   259	        $page = max(1, $request->request->getInt('page', 1));
   260	        $limit = 10;
   261	
   262	        $qb = $this->archetypeEntityManager->createQueryBuilder()
   263	            ->select('ci.id', 'ci.url', 'c.name_jp', 'c.name_en')
   264	            ->from(\Eccube\Entity\Master\MtbCardImage::class, 'ci')
   265	            ->join('ci.CardDetail', 'cd')
   266	            ->join('cd.Card', 'c')
   267	            ->andWhere('ci.back_flg = false');
   268	
   269	        if (!empty($searchWord)) {
   270	            if ($exactMatch) {
   271	                $qb->andWhere($qb->expr()->orX(
   272	                    $qb->expr()->eq('c.name_jp', ':word'),
   273	                    $qb->expr()->eq('c.name_en', ':word'),
   274	                ))
   275	                    ->setParameter('word', $searchWord);
   276	            } else {
   277	                $qb->andWhere($qb->expr()->orX(
   278	                    $qb->expr()->like('c.name_jp', ':word'),
   279	                    $qb->expr()->like('c.name_en', ':word'),
   280	                ))
   281	                    ->setParameter('word', '%'.$searchWord.'%');
   282	            }
   283	        }
   284	
   285	        if (!empty($cardText)) {
   286	            $qb->andWhere($qb->expr()->orX(
   287	                $qb->expr()->like('c.text_jp', ':cardText'),
   288	                $qb->expr()->like('c.text_en', ':cardText'),
   289	            ))
   290	                ->setParameter('cardText', '%'.$cardText.'%');
   291	        }
   292	
   293	        $countQb = clone $qb;
   294	        $countQb->select('COUNT(ci.id)');
   295	        $totalCount = (int) $countQb->getQuery()->getSingleScalarResult();
   296	        $totalPages = (int) ceil($totalCount / $limit);
   297	        if ($totalPages > 0 && $page > $totalPages) {
   298	            $page = $totalPages;
   299	        }
   300	
   301	        $qb->orderBy('ci.id', 'ASC')
   302	            ->setFirstResult(($page - 1) * $limit)
   303	            ->setMaxResults($limit);
   304	
   305	        $results = $qb->getQuery()->getResult();
   306	        $data = [];
   307	        foreach ($results as $row) {
   308	            $data[] = [
   309	                'id' => $row['id'],
   310	                'url' => $row['url'],
   311	                'nameJp' => $row['name_jp'] ?? '',
   312	                'nameEn' => $row['name_en'] ?? '',
   313	            ];
   314	        }
   315	
   316	        return new JsonResponse([
   317	            'items' => $data,
   318	            'totalCount' => $totalCount,
   319	            'page' => $page,
   320	            'totalPages' => $totalPages,
   321	        ]);
   322	    }
   323	}

