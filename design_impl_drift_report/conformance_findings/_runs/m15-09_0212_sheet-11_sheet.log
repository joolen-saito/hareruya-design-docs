    96	            function buildPagination(current, total) {
    97	                const $nav = $('<nav>');
    98	                const $ul = $('<ul>').addClass('pagination justify-content-center').appendTo($nav);
    99	                const display = 5;
   100	                const half = Math.floor(display / 2);
   101	                let start = Math.max(1, current - half);
   102	                let end = start + display - 1;
   103	                if (end > total) { end = total; start = Math.max(1, end - display + 1); }
   104	                const addItem = function(page, label, isActive, isDisabled) {
   105	                    const $li = $('<li>').addClass('page-item');
   106	                    if (isActive) { $li.addClass('active'); }
   107	                    if (isDisabled) { $li.addClass('disabled'); }
   108	                    $('<a>')
   109	                        .addClass('page-link card-image-page')
   110	                        .attr('href', '#')
   111	                        .attr('data-page', page)
   112	                        .text(label)
   113	                        .appendTo($li);
   114	                    $li.appendTo($ul);
   115	                };
   116	                addItem(current - 1, '{{ 'admin.common.prev'|trans|e('js') }}', false, current === 1);
   117	                for (let i = start; i <= end; i++) {
   118	                    addItem(i, String(i), i === current, false);
   119	                }
   120	                addItem(current + 1, '{{ 'admin.common.next'|trans|e('js') }}', false, current === total);
   121	                return $nav;
   122	            }
   123	
   124	            function searchCardImage(page) {
   125	                $.post('{{ url("admin_archetype_search_card_image") }}', {
   126	                    search_word: $('#card_image_search_word').val(),
   127	                    exact_match: $('#card_image_exact_match').is(':checked') ? '1' : '0',
   128	                    card_text: $('#card_image_search_set').val(),
   129	                    page: page
   130	                }, function(res) {
   131	                    const $results = $('#card_image_search_results').empty();
   132	                    if (res.items.length === 0) {
   133	                        $('<p>').addClass('text-muted').text('{{ "admin.common.search_no_result"|trans|e('js') }}').appendTo($results);
   134	                        return;
   135	                    }
   136	                    const $table = $('<table>').addClass('table table-sm');
   137	                    const $thead = $('<thead>').appendTo($table);
   138	                    const $headRow = $('<tr>').appendTo($thead);
   139	                    $('<th>').text('ID').appendTo($headRow);
   140	                    $('<th>').text('{{ "admin.deck.card_name"|trans|e('js') }}').appendTo($headRow);
   141	                    $('<th>').text('{{ "admin.deck.card_image"|trans|e('js') }}').appendTo($headRow);
   142	                    $('<th>').appendTo($headRow);
   143	                    const $tbody = $('<tbody>').appendTo($table);
   144	                    res.items.forEach(function(c) {
   145	                        buildCardImageRow(c).appendTo($tbody);
   146	                    });
   147	                    $table.appendTo($results);
   148	                    if (res.totalPages > 1) {
   149	                        buildPagination(res.page, res.totalPages).appendTo($results);
   150	                    }
   151	                });
   152	            }
   153	
   154	            $('#btn_search_card_image').on('click', function() {
   155	                searchCardImage(1);
   156	            });
   157	
   158	            $(document).on('click', '.card-image-page', function(e) {
