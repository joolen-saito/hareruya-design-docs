   179	    #[Route(path: '/deck/{deckId}/show/', name: 'deck_show', requirements: ['deckId' => '\d+'], methods: ['GET'])]
   180	    #[Template(template: 'Deck/show.twig')]
   181	    public function show(Request $request, int $deckId): array|Response
   182	    {
   183	        $Deck = $this->dtbDeckRepository->findByDeckIdWithCards($deckId);
   184	        if ($Deck === null
   185	            || $Deck->getDisp()->getId() === MtbDisp::DISPLAY_HIDE
   186	            || $Deck->getDeckType()->getId() === MtbDeckType::USER_ID
   187	        ) {
   188	            throw new NotFoundHttpException();
   189	        }
   190	
   191	        $lists = $this->initClassifiedLists();
   192	
   193	        if (!$Deck->getPrivateFlg()) {
   194	            foreach ($Deck->getDeckCards() as $DeckCard) {
   195	                $this->classifyDeckCard($lists, $DeckCard);
   196	            }
   197	
   198	            $locale = $request->getLocale() === 'en' ? 'en' : 'ja';
   199	            foreach ($lists as $list) {
   200	                $cardIds = [];
   201	                foreach ($list->deckCards as $DeckCard) {
   202	                    $cardId = $DeckCard->getCard()->getId();
   203	                    if ($cardId !== null) {
   204	                        $cardIds[] = $cardId;
   205	                    }
   206	                }
   207	                $list->images = $this->mtbCardImageRepository->getOptimalCardImages($cardIds, $locale);
   208	            }
   209	        }
   210	
   211	        return array_merge(
   212	            [
   213	                'Deck' => $Deck,
   214	                'lists' => $lists,
   215	                'addCartCsrfToken' => $this->csrfTokenManager->getToken(AddCartType::class)->getValue(),
   216	            ],
   217	            $this->getCommonArr($request->query->all()),
   218	        );
   219	    }
