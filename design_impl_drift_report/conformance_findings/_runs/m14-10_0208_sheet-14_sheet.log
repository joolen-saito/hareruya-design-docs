   112	    #[Template(template: 'Deck/metagame.twig')]
   113	    public function metagame(int $formatId): array|Response
   114	    {
   115	        $Format = $this->mtbFormatRepository->find($formatId);
   116	        if ($Format === null) {
   117	            throw new NotFoundHttpException();
   118	        }
   119	
   120	        $metaRange = $Format->getMetaRange();
   121	        $allCount = $this->dtbDeckRepository->getMetagameTotalDeckCount($formatId, $metaRange);
   122	        $archetypes = $this->dtbDeckRepository->getMetagameArchetypeCounts($formatId, $metaRange);
   123	        foreach ($archetypes as $key => $archetype) {
   124	            $archetypes[$key]['percentage'] = $allCount > 0
   125	                ? round($archetype['deck_count'] / $allCount * 100, 2)
   126	                : 0.0;
   127	        }
   128	
   129	        return [
   130	            'Format' => $Format,
   131	            'archetypes' => $archetypes,
   132	            'metaRangeDate' => $this->dtbDeckRepository->getMetaDate($metaRange),
