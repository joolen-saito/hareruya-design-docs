   221	    #[Route(path: '/deck/{oldDeckId}/old/', name: 'deck_old', requirements: ['oldDeckId' => '[A-Za-z0-9]+'], methods: ['GET'])]
   222	    public function old(string $oldDeckId): RedirectResponse
   223	    {
   224	        $Deck = $this->dtbDeckRepository->findOneByOldDeckId($oldDeckId);
   225	        if ($Deck !== null) {
   226	            return $this->redirectToRoute('deck_show', ['deckId' => $Deck->getId()], Response::HTTP_MOVED_PERMANENTLY);
   227	        }
   228	
   229	        if (ctype_digit($oldDeckId)) {
   230	            $Deck = $this->dtbDeckRepository->find((int) $oldDeckId);
   231	            if ($Deck !== null) {
   232	                return $this->redirectToRoute('deck_show', ['deckId' => $Deck->getId()], Response::HTTP_MOVED_PERMANENTLY);
   233	            }
   234	        }
   235	
   236	        return $this->redirectToRoute('deck_index');
   237	    }
