    89	            $metaRangeDates[$Format->getId()] = $this->dtbDeckRepository->getMetaDate($Format->getMetaRange());
    90	        }
    91	
    92	        $otherMetaData = [];
    93	        foreach ($this->mtbFormatRepository->findBy(['other_meta_flg' => true], ['rank' => 'ASC']) as $Format) {
    94	            $otherMetaData[$Format->getId()] = $Format;
    95	        }
    96	
    97	        $latestEvents = $this->mtbLatestEventDeckRepository->getLatestEventDeck();
    98	
    99	        return [
   100	            'rankFormats' => $rankFormats,
   101	            'metaData' => $metaData,
   102	            'metaRangeDates' => $metaRangeDates,
   103	            'otherMetaData' => $otherMetaData,
   104	            'latestEvents' => $latestEvents,
   105	        ];
