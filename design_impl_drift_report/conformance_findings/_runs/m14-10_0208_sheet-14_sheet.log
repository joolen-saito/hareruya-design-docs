   247	    #[Route(path: '/deck/result/', name: 'deck_result', methods: ['GET'])]
   248	    #[Template(template: 'Deck/result.twig')]
   249	    public function searchResults(Request $request, PaginatorInterface $paginator): array|Response
   250	    {
   251	        $pageRaw = $request->query->get('page');
   252	        $page = max(self::DEFAULT_PAGE, is_numeric($pageRaw) ? (int) $pageRaw : self::DEFAULT_PAGE);
   253	        $pageSizeRaw = $request->query->get('pageSize');
   254	        $pageSize = is_numeric($pageSizeRaw) ? (int) $pageSizeRaw : self::DEFAULT_PAGE_SIZE;
   255	        if (!in_array($pageSize, self::ALLOWED_PAGE_SIZES, true)) {
   256	            $pageSize = self::DEFAULT_PAGE_SIZE;
   257	        }
   258	        $query = $request->query->all();
   259	        $count = $this->dtbDeckRepository->countBy($query);
   260	        $decks = [];
   261	        if ($count > 0) {
   262	            $decks = $this->dtbDeckRepository
   263	                ->searchBy($query, $paginator, $pageSize, $page);
   264	        }
   265	
   266	        $searchResultData = array_merge([
   267	            'decks' => $decks,
   268	            'count' => $count,
   269	            'page' => $page,
   270	            'pageSize' => $pageSize],
   271	            $this->getCommonArr($query));
   272	
   273	        if ($count === 0) {
   274	            // 件数0件時は、HTTPステータス404を返す
   275	            return new Response(
   276	                $this->renderView('Deck/result.twig', $searchResultData),
   277	                Response::HTTP_NOT_FOUND);
   278	        }
   279	
   280	        return $searchResultData;
   281	    }
