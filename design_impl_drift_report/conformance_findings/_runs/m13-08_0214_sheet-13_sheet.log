   162	                    'page_count' => $pageCount,
   163	                    'sortKeys' => array_keys($errSortKeysMap),
   164	                    'sort_key' => $sortKey,
   165	                    'order_key' => $order,
   166	                    'has_errors' => true,
   167	                    'is_deck_registration_list' => $errIsDeck,
