   301	    public function bulkUpdateEntryStatus(Request $request): JsonResponse
   302	    {
   303	        $form = $this->formFactory->create(EventEntryBulkUpdateType::class);
   304	        $form->handleRequest($request);
   305	
   306	        if (!$form->isSubmitted() || !$form->isValid()) {
   307	            $msg = trans('admin.common.error_invalid_request');
   308	            foreach ($form->getErrors(true) as $error) {
   309	                $msg = $error->getMessage();
   310	                break;
