   312	
   313	            return new JsonResponse(['message' => [$msg]], Response::HTTP_BAD_REQUEST);
   314	        }
   315	
   316	        $ids = array_values(array_unique(array_filter(array_map('intval', (array) ($request->request->all()['entries'] ?? [])))));
   317	        if ($ids === []) {
   318	            return new JsonResponse(['message' => [trans('admin.event.entry.bulk_update.nothing_selected')]], Response::HTTP_BAD_REQUEST);
   319	        }
   320	
   321	        /** @var MtbEntryStatus $entryStatus */
   322	        $entryStatus = $form->get('entryStatus')->getData();
   323	
   324	        try {
   325	            $this->entryStatusBulkUpdateAction->handle(new EntryStatusBulkUpdateInput(
   326	                entryIds: $ids,
