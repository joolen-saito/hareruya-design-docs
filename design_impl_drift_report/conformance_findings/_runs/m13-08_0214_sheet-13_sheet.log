   330	        } catch (\InvalidArgumentException $e) {
   331	            return new JsonResponse(['message' => [$e->getMessage()]], Response::HTTP_BAD_REQUEST);
   332	        }
   333	
   334	        return new JsonResponse(['message' => [trans('admin.event.entry.bulk_update.success', ['%count%' => count($ids)])]]);
