   118	        );
   119	        $pageCountParam = (int) $request->get('page_count');
   120	        $pageMaxis = $this->pageMaxRepository->findAll();
   121	        if ($pageCountParam > 0) {
   122	            foreach ($pageMaxis as $pageMax) {
   123	                if ((string) $pageCountParam === $pageMax->getName()) {
   124	                    $pageCount = $pageMax->getName();
   125	                    $this->session->set(self::SESSION_KEY.'.page_count', $pageCount);
   126	                    break;
   127	                }
   128	            }
   129	        }
   130	
   131	        $entrySortKeysMap = $this->entryRepository->getEntryListSortKeys();
   132	
   133	        if ($request->isMethod(Request::METHOD_POST)) {
   134	            $searchForm->handleRequest($request);
