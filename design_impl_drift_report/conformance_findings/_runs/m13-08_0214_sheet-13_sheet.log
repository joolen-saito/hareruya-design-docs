   169	            }
   170	
   171	            $pageNo = 1;
   172	            $searchData = $searchForm->getData();
   173	            $this->session->set(self::SESSION_KEY, FormUtil::getViewData($searchForm));
   174	            $this->session->set(self::SESSION_KEY.'.page_no', $pageNo);
