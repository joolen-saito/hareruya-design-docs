   381	    public function entryEventHtml(Request $request, PaginatorInterface $paginator, ?int $page_no = null): Response
   382	    {
   383	        $modalPayload = $request->query->all()['admin_entry_event_modal'] ?? [];
   384	        if (!is_array($modalPayload)) {
   385	            $modalPayload = [];
   386	        }
   387	        $defaultBaseInfo = $this->getMember()->getDefaultSearchBaseInfo();
   388	        $form = $this->formFactory->create(SearchEntryEventModalType::class, null, [
   389	            'base_info_default' => $defaultBaseInfo ? [$defaultBaseInfo] : [],
   390	        ]);
   391	        $form->submit($modalPayload, false);
   392	
   393	        if (!$form->isValid()) {
   394	            return $this->render('@admin/Event/Entry/search_event_modal_list.twig', [
   395	                'datas' => [],
   396	                'pagination' => null,
   397	                'eventModalForm' => $form,
   398	                'modal' => true,
   399	            ]);
   400	        }
   401	
   402	        $pageNo = $page_no ?? max(1, (int) $request->query->get('page_no', 1));
   403	        $editableBaseInfoIds = [];
   404	        foreach ($this->getMember()->getMemberBaseInfos() as $mbi) {
   405	            $editableBaseInfoIds[] = $mbi->getBaseInfo()->getId();
   406	        }
   407	
   408	        $modalData = $form->getData();
   409	        $selectedBase = $modalData['base_info'] ?? null;
   410	        $rawBases = $selectedBase instanceof BaseInfo ? [$selectedBase] : [];
   411	        $editableBaseInfoSet = array_flip($editableBaseInfoIds);
   412	        $allowedBases = array_filter(
   413	            $rawBases,
   414	            static fn (BaseInfo $b): bool => isset($editableBaseInfoSet[$b->getId()]),
   415	        );
   416	
   417	        $events = [];
   418	        if ($rawBases === [] || $allowedBases !== []) {
   419	            $qb = $this->eventRepository->getQueryBuilderByEntryRegistrationSearchData([
   420	                'multi' => $modalData['event_name'] ?? null,
   421	                'start_date_from' => $modalData['start_date_from'] ?? null,
   422	                'start_date_to' => $modalData['start_date_to'] ?? null,
   423	                'base_info' => $allowedBases,
   424	            ]);
   425	            if ($allowedBases === []) {
   426	                $qb->andWhere('IDENTITY(e.BaseInfo) IN (:entryModalEditableBaseInfoIds)')
   427	                    ->setParameter('entryModalEditableBaseInfoIds', $editableBaseInfoIds);
   428	            }
   429	            $events = $qb->getQuery()->getResult();
   430	        }
   431	
   432	        [$pagination, $datas] = $this->entryRegistrationScheduleRowBuilder->paginateWithRowSpanByEvent(
   433	            $paginator,
   434	            $this->entryRegistrationScheduleRowBuilder->expandScheduleRows(
   435	                $events,
   436	                !empty($modalData['start_date_from']) ? $modalData['start_date_from'] : null,
   437	                !empty($modalData['start_date_to']) ? $modalData['start_date_to'] : null,
   438	            ),
   439	            $pageNo,
   440	            self::MODAL_EVENT_SEARCH_PER_PAGE,
   441	        );
   442	
   443	        return $this->render('@admin/Event/Entry/search_event_modal_list.twig', [
   444	            'datas' => $datas,
   445	            'pagination' => $pagination,
   446	            'eventModalForm' => null,
   447	            'modal' => true,
   448	        ]);
   449	    }
