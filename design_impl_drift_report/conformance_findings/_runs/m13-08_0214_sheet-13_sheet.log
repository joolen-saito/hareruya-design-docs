   164	    /**
   165	     * 管理画面デッキ検索用 QueryBuilder を構築する。
   166	     *
   167	     * ★カスタマイズ:
   168	     *   - 旧デッキID、DCIナンバー、勝敗数の検索条件を除去
   169	     *   - イベントID → イベント詳細ID に差し替え
   170	     *
   171	     * @param array<string, mixed> $searchData
   172	     */
   173	    public function getQueryBuilderBySearchData(array $searchData): QueryBuilder
   174	    {
   175	        $qb = $this->createQueryBuilder('d');
   176	
   177	        // 大会開始時刻前のデッキは検索結果に表示しない
   178	        $qb->leftJoin('d.EventDetail', 'ed', Join::WITH, 'ed.startDate < :time OR IDENTITY(d.EventDetail) IS NULL')
   179	            ->andWhere('ed.startDate < :time OR IDENTITY(d.EventDetail) IS NULL')
   180	            ->setParameter('time', new \DateTime());
   181	
   182	        // ユーザ作成のデッキは検索結果に表示しない
   183	        $qb->andWhere('IDENTITY(d.DeckType) = :deckType')
   184	            ->setParameter('deckType', MtbDeckType::EVENT_ID);
   185	
   186	        // デッキID
   187	        if (!empty($searchData['deck_id'])) {
   188	            SqlUtil::searchByIds($qb, $searchData['deck_id'], 'd', 'id');
   189	        }
   190	
   191	        // デッキ名（部分一致、スペース/カンマ区切りで複数検索）
   192	        if (!empty($searchData['deck_name'])) {
   193	            $texts = preg_split('/[\s,　]+/u', $searchData['deck_name']);
   194	            SqlUtil::multiTextQuery($qb, $texts, ['d' => ['deckName']]);
   195	        }
   196	
   197	        // フォーマット
   198	        if (!empty($searchData['formats']) && count($searchData['formats']) > 0) {
   199	            $qb->andWhere($qb->expr()->in('d.Format', ':formats'))
   200	                ->setParameter('formats', $searchData['formats']);
   201	        }
   202	
   203	        // アーキタイプ
   204	        if (!empty($searchData['archetypes']) && count($searchData['archetypes']) > 0) {
   205	            $qb->andWhere($qb->expr()->in('d.Archetype', ':archetypes'))
   206	                ->setParameter('archetypes', $searchData['archetypes']);
   207	        }
   208	
   209	        // カラー（アーキタイプ経由）
   210	        if (!empty($searchData['color']) && count($searchData['color']) > 0) {
   211	            $qb->join('d.Archetype', 'da')
   212	                ->join('da.Colors', 'co', Join::WITH, $qb->expr()->in('co.id', ':colors'))
   213	                ->setParameter('colors', $searchData['color']);
   214	        }
   215	
   216	        // 公開状態
   217	        if (!empty($searchData['disp']) && count($searchData['disp']) > 0) {
   218	            $qb->andWhere($qb->expr()->in('d.Disp', ':disp'))
   219	                ->setParameter('disp', $searchData['disp']);
   220	        }
   221	
   222	        // デッキリスト公開状態
   223	        if (!empty($searchData['private_flg']) && count($searchData['private_flg']) === 1) {
   224	            $qb->andWhere('d.privateFlg = :privateFlg')
   225	                ->setParameter('privateFlg', $searchData['private_flg'][0]);
   226	        }
   227	
   228	        // イベント開催日（From）
   229	        if (!empty($searchData['event_date_from'])) {
   230	            $from = (clone $searchData['event_date_from'])->setTime(0, 0, 0);
   231	            $qb->andWhere('d.eventDate >= :eventDateFrom')
   232	                ->setParameter('eventDateFrom', $from);
   233	        }
   234	
   235	        // イベント開催日（To）
   236	        if (!empty($searchData['event_date_to'])) {
   237	            $to = (clone $searchData['event_date_to'])->setTime(23, 59, 59);
   238	            $qb->andWhere('d.eventDate <= :eventDateTo')
   239	                ->setParameter('eventDateTo', $to);
   240	        }
   241	
   242	        // 順位（From/To）
   243	        if (!empty($searchData['ranking_from'])) {
   244	            $qb->andWhere('d.ranking >= :rankingFrom')
   245	                ->setParameter('rankingFrom', $searchData['ranking_from']);
   246	        }
   247	        if (!empty($searchData['ranking_to'])) {
   248	            $qb->andWhere('d.ranking <= :rankingTo')
   249	                ->setParameter('rankingTo', $searchData['ranking_to']);
   250	        }
   251	
   252	        // 成績（部分一致）
   253	        if (!empty($searchData['result'])) {
   254	            $texts = preg_split('/[\s,　]+/u', $searchData['result']);
   255	            SqlUtil::multiTextQuery($qb, $texts, ['d' => ['result']]);
   256	        }
   257	
   258	        // イベント名（部分一致、日英）
   259	        if (!empty($searchData['event_name'])) {
   260	            $texts = preg_split('/[\s,　]+/u', $searchData['event_name']);
   261	            SqlUtil::multiTextQuery($qb, $texts, ['d' => ['eventNameJp', 'eventNameEn']]);
   262	        }
   263	
   264	        // プレイヤー名（部分一致）
   265	        if (!empty($searchData['player_name'])) {
   266	            $texts = preg_split('/[\s,　]+/u', $searchData['player_name']);
   267	            SqlUtil::multiTextQuery($qb, $texts, ['d' => ['playerName']]);
   268	        }
   269	
   270	        // デッキタグ（AND検索）
   271	        if (!empty($searchData['deck_tags'])) {
   272	            foreach ($searchData['deck_tags'] as $deckTagIdx => $DeckTag) {
   273	                if ($DeckTag === null) {
   274	                    continue;
   275	                }
   276	                $qb->join('d.DeckTags', 'dt'.$deckTagIdx, Join::WITH, "dt{$deckTagIdx}.id = :deckTag{$deckTagIdx}")
   277	                    ->setParameter("deckTag{$deckTagIdx}", $DeckTag);
   278	            }
   279	        }
   280	
   281	        // カード名（完全一致、日英）
   282	        if (!empty($searchData['card'])) {
   283	            $qb->join('d.DeckCards', 'dc')
   284	                ->join('dc.Card', 'c', Join::WITH, $qb->expr()->orX(
   285	                    $qb->expr()->eq('c.nameJp', ':card'),
   286	                    $qb->expr()->eq('c.nameEn', ':card')
   287	                ))
   288	                ->setParameter('card', $searchData['card']);
   289	        }
   290	
   291	        // ★イベント詳細ID（カスタマイズ: イベントIDから差し替え）
   292	        if (!empty($searchData['event_detail_id'])) {
   293	            SqlUtil::searchByIds($qb, $searchData['event_detail_id'], 'ed', 'id');
   294	        }
   295	
   296	        // 開催店舗
   297	        if (!empty($searchData['shop'])) {
   298	            $qb->join('ed.Event', 'e')
   299	                ->join('e.BaseInfo', 'bi', Join::WITH, 'bi = :shop')
   300	                ->setParameter('shop', $searchData['shop']);
   301	        }
   302	
   303	        // 最終更新者
   304	        if (!empty($searchData['member'])) {
   305	            $qb->andWhere('d.Member = :member')
   306	                ->setParameter('member', $searchData['member']);
   307	        }
   308	
   309	        // ソート
   310	        $sortKey = $searchData['sortKey'] ?? self::DEFAULT_SORT_KEY;
   311	        $sortOrder = strtoupper((string) ($searchData['sortOrder'] ?? self::DEFAULT_SORT_ORDER));
   312	        if (!in_array($sortOrder, ['ASC', 'DESC'], true)) {
   313	            $sortOrder = self::DEFAULT_SORT_ORDER;
   314	        }
   315	        $sortColumn = $this->sortKeys[$sortKey] ?? $this->sortKeys[self::DEFAULT_SORT_KEY];
   316	        $qb->orderBy($sortColumn, $sortOrder);
   317	
   318	        return $qb;
   319	    }
