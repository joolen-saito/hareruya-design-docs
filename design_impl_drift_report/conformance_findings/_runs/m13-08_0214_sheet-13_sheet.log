   141	                // クエリ文字列優先、なければセッションからソートキーを復元し、その他の場合は既定値へ
   142	                $sortKey = (string) ($request->query->get('sort') ?? $this->session->get(self::SESSION_KEY.'.sort', $errDefaultSortKey));
   143	                if (!isset($errSortKeysMap[$sortKey])) {
   144	                    $sortKey = $errDefaultSortKey;
   145	                }
   146	                $order = strtoupper((string) ($request->query->get('order') ?? $this->session->get(self::SESSION_KEY.'.order', 'DESC')));
   147	                if ($order !== 'ASC' && $order !== 'DESC') {
   148	                    $order = 'DESC';
   149	                }
   150	                $this->session->set(self::SESSION_KEY.'.sort', $sortKey);
   151	                $this->session->set(self::SESSION_KEY.'.order', $order);
   152	
   153	                $emptyPagination = $paginator->paginate([], $pageNo, (int) $pageCount);
   154	
   155	                return [
   156	                    'searchForm' => $searchForm->createView(),
   157	                    'eventModalForm' => $eventModalFormView,
