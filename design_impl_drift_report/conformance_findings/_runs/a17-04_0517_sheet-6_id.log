   234	    STRING_AGG(DISTINCT pimg.file_name, ',') AS imageFileNames,
   235	    pc.order_quantity_04 AS orderQuantity04,
   236	    pc.id AS productClassId,
   237	    pc.product_code AS productCode,
   238	    cc.id AS cardConditionId,
   239	    CASE WHEN pc.memo IS NOT NULL AND pc.memo != '' THEN pc.memo ELSE cc.code END AS conditionCode,
   240	    pc.price02 AS price,
   241	    pc.sale_limit AS saleLimit,
   242	    pc.stock AS stock,
   243	    c.name_jp AS cardName,
   244	    STRING_AGG(DISTINCT colors.name_jp, ',') AS colors,
   245	    c.mana_cost AS manaCost,
   246	    rarity.name_jp AS rarityName,
   247	    STRING_AGG(DISTINCT types.name_jp, ',') AS cardtypes,
   248	    cd.text_jp AS textJp,
   249	    cd.flavor_jp AS flavorJp,
   250	    c.power,
   251	    c.toughness,
   252	    c.loyalty,
   253	    cardset.name_jp AS cardsetName,
   254	    cardsetblock.name_jp AS cardsetblockName,
   255	    illustrator.name_en AS illustratorName,
   256	    STRING_AGG(DISTINCT fmt.name_en, ',') AS formats,
   257	    rr.name_jp AS regionRestrictionName,
   258	    STRING_AGG(cat.category_name, '|' ORDER BY cat.id) AS categoryNames
   259	FROM
   260	    dtb_product p
   261	    LEFT JOIN dtb_product_class pc ON p.id = pc.product_id AND pc.visible = true
   262	    LEFT JOIN mtb_language lang ON pc.language_id = lang.id AND lang.code = :languageCode
   263	    LEFT JOIN mtb_card_condition cc ON pc.card_condition_id = cc.id
   264	    LEFT JOIN dtb_product_class_image pci ON pc.id = pci.product_class_id
   265	    LEFT JOIN dtb_product_image pimg ON pci.product_image_id = pimg.id
   266	    LEFT JOIN dtb_product_category pct ON p.id = pct.product_id
   267	    LEFT JOIN dtb_category cat ON pct.category_id = cat.id
   268	    LEFT JOIN mtb_region_restriction rr ON p.region_restriction_id = rr.id
   269	    LEFT JOIN mtb_card_detail cd ON p.card_detail_id = cd.id
   270	    LEFT JOIN mtb_card c ON cd.card_id = c.id
   271	    LEFT JOIN dtb_card_color cc_rel ON c.id = cc_rel.card_id
   272	    LEFT JOIN mtb_color colors ON cc_rel.color_id = colors.id
   273	    LEFT JOIN dtb_card_cardtype ct_rel ON c.id = ct_rel.card_id
   274	    LEFT JOIN mtb_cardtype types ON ct_rel.cardtype_id = types.id
   275	    LEFT JOIN dtb_card_format cf ON c.id = cf.card_id
   276	    LEFT JOIN mtb_format fmt ON cf.format_id = fmt.id
   277	    LEFT JOIN mtb_rarity rarity ON cd.rarity_id = rarity.id
   278	    LEFT JOIN mtb_cardset cardset ON cd.cardset_id = cardset.id
   279	    LEFT JOIN mtb_cardsetblock cardsetblock ON cardset.cardsetblock_id = cardsetblock.id
   280	    LEFT JOIN mtb_illustrator illustrator ON cd.illustrator_id = illustrator.id
   281	WHERE
   282	    p.id = :productId
   283	    AND pc.id IS NOT NULL
   284	GROUP BY
   285	    p.id, p.name, p.description_detail,
   286	    lang.code,
   287	    pc.id, pc.high_price_code, pc.order_quantity_04, pc.product_code, pc.memo, pc.price02, pc.sale_limit, pc.stock,
   288	    cc.id, cc.code,
   289	    c.name_jp, c.mana_cost, c.power, c.toughness, c.loyalty,
   290	    cd.text_jp, cd.flavor_jp,
   291	    rarity.name_jp,
   292	    cardset.name_jp,
   293	    cardsetblock.name_jp,
   294	    illustrator.name_en,
   295	    rr.name_jp
   296	ORDER BY
   297	    pc.id ASC
   298	SQL;
