    93	    /**
    94	     * 商品名を構築（カード名がある場合は【言語コード】をプレフィックスとして付与）
    95	     *
    96	     * @param array<string, mixed> $detail
    97	     * @param string $languageCode
    98	     *
    99	     * @return string
   100	     */
   101	    private function buildProductName(array $detail, string $languageCode): string
   102	    {
   103	        $productName = $detail['productName'];
   104	        $cardName = $detail['cardName'] ?? null;
   105	
   106	        if ($cardName !== null) {
   107	            return '【'.$languageCode.'】'.$productName;
   108	        }
   109	
   110	        return $productName;
   111	    }
   112	
   113	    /**
   114	     * カード詳細情報を構築
   115	     *
   116	     * @param array<string, mixed> $detail
   117	     *
   118	     * @return array<string, mixed>|null
   119	     */
   120	    private function buildCardDetail(array $detail): ?array
   121	    {
   122	        if (($detail['cardName'] ?? null) === null) {
   123	            return null;
   124	        }
   125	
   126	        return [
   127	            'card_name' => $detail['cardName'],
   128	            'colors' => $detail['colors'] ?? '',
   129	            'mana_cost' => $detail['manaCost'],
   130	            'rarity' => $detail['rarityName'],
   131	            'card_type' => $detail['cardtypes'] ?? '',
   132	            'card_text' => $detail['textJp'],
   133	            'flavor' => $detail['flavorJp'],
   134	            'power_toughness' => $this->buildPowerToughness($detail['power'], $detail['toughness']),
   135	            'loyalty' => $this->normalizeLoyalty($detail['loyalty']),
   136	            'cardset' => $detail['cardsetName'],
   137	            'cardsetblock' => $detail['cardsetblockName'],
   138	            'illustrator' => $detail['illustratorName'],
   139	            'formats' => $detail['formats'] ?? '',
   140	        ];
   141	    }
   142	
   143	    /**
   144	     * カードのパワー/タフネスを構築
   145	     *
   146	     * @param string|null $power
   147	     * @param string|null $toughness
   148	     *
   149	     * @return string|null
   150	     */
   151	    private function buildPowerToughness(?string $power, ?string $toughness): ?string
   152	    {
   153	        if ($power !== null && $power !== '' && $toughness !== null && $toughness !== '') {
   154	            return $power.'/'.$toughness;
   155	        }
   156	
   157	        return null;
   158	    }
   159	
   160	    /**
   161	     *  カードの忠誠度を正規化（空文字やnullはnullとして扱う）
   162	     *
   163	     * @param string|null $loyalty
   164	     *
   165	     * @return string|null
   166	     */
   167	    private function normalizeLoyalty(?string $loyalty): ?string
   168	    {
   169	        return ($loyalty === '' || $loyalty === null) ? null : $loyalty;
   170	    }
   171	
   172	    /**
   173	     * 商品クラス情報を構築
   174	     * カード状態が「NM」以外で価格が条件未満の場合は表示しない
   175	     *
   176	     * @param array<string, mixed> $detail
   177	     *
   178	     * @return array<string, mixed>|null
   179	     */
   180	    private function buildProductClass(array $detail): ?array
   181	    {
   182	        $conditionCode = $detail['conditionCode'] ?? null;
   183	        $price = (int) $detail['price'];
   184	
   185	        if ($conditionCode !== MtbCardCondition::CODE_NEAR_MINT && $price < $this->conditionDisplayMinPrice) {
   186	            return null;
   187	        }
   188	
   189	        // 画像ファイル名をS3 URLに変換
   190	        $imageFileNames = $this->splitString($detail['imageFileNames'] ?? '');
   191	        $productClassImages = [];
   192	        foreach ($imageFileNames as $imageFile) {
   193	            $productClassImages[] = $this->getS3Url($imageFile);
   194	        }
   195	
   196	        $productClass = [
   197	            'product_class_id' => $detail['productClassId'],
   198	            'product_code' => $detail['productCode'],
   199	            'high_price_code' => $detail['highPriceCode'],
   200	            'card_condition_code' => $conditionCode,
   201	            'price' => $price,
   202	            'sale_limit' => $detail['saleLimit'] !== null ? (int) $detail['saleLimit'] : null,
   203	            'stock' => (int) ($detail['stock'] ?? 0),
   204	            'product_class_images' => $productClassImages,
   205	        ];
   206	
   207	        return $productClass;
   208	    }
   209	
   210	    /**
   211	     * ファイルパスをS3のURLに変換
   212	     *
   213	     * @param string $path
   214	     *
   215	     * @return string
   216	     */
   217	    private function getS3Url(string $path): string
   218	    {
   219	        if (!empty($this->cdnBaseUrl)) {
   220	            return $this->cdnBaseUrl.$path;
   221	        }
   222	
   223	        return $this->s3Endpoint.$this->awsS3Bucket.'/'.$path;
   224	    }
   225	}

