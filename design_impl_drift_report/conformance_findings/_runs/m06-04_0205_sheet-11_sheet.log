    16	namespace Eccube\Service\Admin\OtcBuyOrder;
    17	
    18	use Doctrine\ORM\EntityManagerInterface;
    19	use Eccube\Entity\DtbOtcBuyOrder;
    20	use Eccube\Entity\Master\MtbOtcBuyOrderStatus;
    21	use Eccube\Entity\Master\MtbStockHistorySourceType;
    22	use Eccube\Repository\DtbOtcBuyOrderRepository;
    23	use Eccube\Repository\Master\MtbStockHistorySourceTypeRepository;
    24	use Eccube\Service\Admin\OtcBuyOrder\ActionInput\OtcBuyOrderStockInboundInput;
    25	use Eccube\Service\Admin\OtcBuyOrder\ActionInput\RecalculateSummaryInput;
    26	use Eccube\Service\Admin\OtcBuyOrder\ActionInput\UpdateStatusInput;
    27	use Eccube\Service\EntityManager\OtcBuyOrderEntityManager;
    28	
    29	class UpdateStatusAction
    30	{
    31	    public function __construct(
    32	        private readonly EntityManagerInterface $entityManager,
    33	        private readonly OtcBuyOrderEntityManager $otcBuyOrderEntityManager,
    34	        private readonly RecalculateSummaryAction $recalculateSummaryAction,
    35	        private readonly OtcBuyOrderStockInbound $otcBuyOrderStockInbound,
    36	        private readonly DtbOtcBuyOrderRepository $otcBuyOrderRepository,
    37	        private readonly MtbStockHistorySourceTypeRepository $stockHistorySourceTypeRepository,
    38	    ) {
    39	    }
    40	
    41	    public function handle(UpdateStatusInput $input): void
    42	    {
    43	        $CurrentStatus = $input->OtcBuyOrder->getOtcBuyOrderStatus();
    44	        $currentStatusId = $CurrentStatus?->getId();
    45	
    46	        // ログインしているメンバーの編集可能店舗が、買取情報の買取店舗と一致する場合のみステータス変更が可能
    47	        $OtcBuyOrderBaseInfo = $input->OtcBuyOrder->getBaseInfo();
    48	        if (!$input->Member->isEditableShop($OtcBuyOrderBaseInfo)) {
    49	            throw new \InvalidArgumentException('編集可能な店舗と買取情報の買取店舗が一致しません。');
    50	        }
    51	
    52	        // 入庫済みステータスからは管理者取消のみ許可
    53	        if (
    54	            $CurrentStatus !== null
    55	            && $CurrentStatus->getId() === MtbOtcBuyOrderStatus::STATUS_STOCKING_COMPLETE
    56	            && $input->NextStatus->getId() !== MtbOtcBuyOrderStatus::STATUS_REVOKED_BY_ADMIN
    57	        ) {
    58	            throw new \InvalidArgumentException('入庫済みのステータスは管理者取消以外に変更できません。');
    59	        }
    60	
    61	        // 入庫済みステータスに変更する際、マスタ未登録商品がないかチェック
    62	        if ($input->NextStatus->getId() === MtbOtcBuyOrderStatus::STATUS_STOCKING_COMPLETE) {
    63	            $this->validateProductMasterRegistration($input->OtcBuyOrder);
    64	        }
    65	
    66	        $currentTime = new \DateTime();
    67	
    68	        $this->entityManager->beginTransaction();
    69	
    70	        try {
    71	            // 入庫待ち → 入庫済みへの遷移時、２重入庫を防ぐために先にステータスを確定する。
    72	            // ※ステータス更新は updateStatusIfStockingPending 内でも行われる（updateStatusWithHistory と冪等）
    73	            $stockInboundNeeded = $input->NextStatus->getId() === MtbOtcBuyOrderStatus::STATUS_STOCKING_COMPLETE
    74	                && $this->otcBuyOrderRepository->updateStatusIfStockingPending($input->OtcBuyOrder->getId()) > 0;
    75	
    76	            $input->OtcBuyOrder->setStatusChangedDateTime($input->NextStatus);
    77	            $input->OtcBuyOrder->setUpdateDate($currentTime);
    78	
    79	            $this->otcBuyOrderEntityManager->updateStatusWithHistory(
    80	                $input->OtcBuyOrder,
    81	                $input->NextStatus,
    82	                $input->Member,
    83	                $currentTime,
    84	            );
    85	
    86	            // 買取成立の場合は2段階目のステータス更新を行う
    87	            // 個別入力商品の有無で「未登録在庫あり」or「入庫待ち」に遷移
    88	            // （MTGBuyerAPI の UpdateOtcBuyOrderAction と同等のロジック）
    89	            $FinalStatus = $this->resolvePostCompleteStatus($input);
    90	            if ($FinalStatus !== null) {
    91	                $this->otcBuyOrderEntityManager->updateStatusWithHistory(
    92	                    $input->OtcBuyOrder,
    93	                    $FinalStatus,
    94	                    $input->Member,
    95	                    $currentTime,
    96	                );
    97	            }
    98	
    99	            // 入庫処理が必要であれば実施
   100	            if ($stockInboundNeeded) {
   101	                $HistorySourceType = $this->stockHistorySourceTypeRepository->find(MtbStockHistorySourceType::MANUAL_OTC_BUY_ORDER);
   102	                $this->otcBuyOrderStockInbound->process(new OtcBuyOrderStockInboundInput(
   103	                    OtcBuyOrder: $input->OtcBuyOrder,
   104	                    HistorySourceType: $HistorySourceType,
   105	                    Member: $input->Member,
   106	                ));
   107	            }
   108	
   109	            $this->entityManager->flush();
   110	            $this->entityManager->commit();
   111	        } catch (\Exception $e) {
   112	            $this->entityManager->rollback();
   113	
   114	            throw $e;
   115	        }
   116	
   117	        // ステータス更新トランザクション完了後に集計再計算（flush 競合回避）
   118	        // 2段階更新時は最終ステータスで recalculate を行う
   119	        $finalStatusId = $FinalStatus?->getId() ?? $input->NextStatus->getId();
   120	        $this->recalculateSummaryAction->handle(new RecalculateSummaryInput(
   121	            OtcBuyOrder: $input->OtcBuyOrder,
   122	            oldStatusId: $currentStatusId ?? 0,
   123	            newStatusId: $finalStatusId,
   124	        ));
   125	    }
   126	
   127	    /**
   128	     * 買取成立時の2段階目ステータスを判定する
   129	     *
   130	     * @return ?MtbOtcBuyOrderStatus 2段階目のステータス。買取成立以外の場合は null
   131	     */
   132	    private function resolvePostCompleteStatus(UpdateStatusInput $input): ?MtbOtcBuyOrderStatus
   133	    {
   134	        if (!$input->NextStatus->isComplete()) {
   135	            return null;
   136	        }
   137	
   138	        $nextStatusId = $input->OtcBuyOrder->resolvePostCompleteStatusId();
   139	
   140	        return $this->entityManager->find(MtbOtcBuyOrderStatus::class, $nextStatusId);
   141	    }
   142	
   143	    /**
   144	     * 入庫時にすべての商品がマスタ（ProductClass）に紐付いているかチェックする
   145	     */
   146	    private function validateProductMasterRegistration(DtbOtcBuyOrder $OtcBuyOrder): void
   147	    {
   148	        // 明細の全てに商品規格が紐づいているかチェック
   149	        foreach ($OtcBuyOrder->getOtcBuyOrderDetails() as $Detail) {
   150	            if ($Detail->getOriginalQuantity() > 0 && $Detail->getProductClass() === null) {
   151	                throw new \InvalidArgumentException('商品マスターに登録されていない商品明細が含まれているため、入庫済みに変更できません。');
   152	            }
   153	        }
   154	
   155	        // 個別入力商品の全てに商品規格が紐づいているかチェック
   156	        foreach ($OtcBuyOrder->getOtcBuyOrderIndivisualInputProducts() as $Individual) {
   157	            if ($Individual->getQuantity() > 0 && $Individual->getProductClass() === null) {
   158	                throw new \InvalidArgumentException('実在庫情報が登録されていない個別入力商品が含まれているため、入庫済みに変更できません。');
   159	            }
   160	        }
   161	    }
   162	}

