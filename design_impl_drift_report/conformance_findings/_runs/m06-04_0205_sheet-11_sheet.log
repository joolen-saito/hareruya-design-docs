   568	    public function getOtcBuyOrderRestockListExportData(
   569	        array $otcBuyOrderIds,
   570	    ): iterable {
   571	        if (empty($otcBuyOrderIds)) {
   572	            return new \ArrayIterator([]);
   573	        }
   574	
   575	        $conn = $this->getEntityManager()->getConnection();
