   613	    public function getOtcBuyOrderDetailAndIndivisualCombinedLinesSorted(): array
   614	    {
   615	        $lines = array_merge(
   616	            $this->OtcBuyOrderDetails->toArray(),
   617	            $this->OtcBuyOrderIndivisualInputProducts->toArray(),
   618	        );
   619	        usort(
   620	            $lines,
   621	            function (DtbOtcBuyOrderDetail|DtbOtcBuyOrderIndivisualInputProduct $a, DtbOtcBuyOrderDetail|DtbOtcBuyOrderIndivisualInputProduct $b): int {
   622	                $priceA = $a->getPrice() ?? 0;
   623	                $priceB = $b->getPrice() ?? 0;
   624	                if ($priceA !== $priceB) {
   625	                    return $priceB <=> $priceA;
   626	                }
   627	                $cardConditionA = $a instanceof DtbOtcBuyOrderDetail
   628	                    ? ($a->getProductClass()?->getCardCondition()?->getId() ?? \PHP_INT_MAX)
   629	                    : \PHP_INT_MAX;
   630	                $cardConditionB = $b instanceof DtbOtcBuyOrderDetail
   631	                    ? ($b->getProductClass()?->getCardCondition()?->getId() ?? \PHP_INT_MAX)
   632	                    : \PHP_INT_MAX;
   633	
   634	                return $cardConditionA <=> $cardConditionB;
   635	            },
   636	        );
   637	
   638	        return $lines;
   639	    }
