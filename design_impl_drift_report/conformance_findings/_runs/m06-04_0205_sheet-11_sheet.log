    63	    /**
    64	     * 検索条件から QueryBuilder を構築
    65	     *
    66	     * @param SearchDataDto $searchData
    67	     */
    68	    public function getQueryBuilderBySearchData(
    69	        SearchDataDto $searchData,
    70	    ): QueryBuilder {
    71	        $qb = $this->createQueryBuilder('obo')
    72	            ->join('obo.OtcBuyOrderStatus', 'obos')
    73	            ->select('obo');
    74	
    75	        // 査定番号
    76	        if (!empty($searchData->assessmentId)) {
    77	            $qb->andWhere('obo.assessmentId = :assessmentId')->setParameter(
    78	                'assessmentId',
    79	                $searchData->assessmentId,
    80	            );
    81	        }
    82	
    83	        // 店舗
    84	        if (!empty($searchData->shop)) {
    85	            $qb->join('obo.BaseInfo', 'bi')
    86	                ->andWhere('bi.id = :shopId')
    87	                ->setParameter('shopId', $searchData->shop->getId());
    88	        }
    89	
    90	        // ステータス
    91	        if (!empty($searchData->otcBuyOrderStatus)) {
    92	            $qb->andWhere('obos.id = :otcBuyOrderStatus')->setParameter(
    93	                'otcBuyOrderStatus',
    94	                $searchData->otcBuyOrderStatus->getId(),
    95	            );
    96	        } else {
    97	            // キャンセル以外
    98	            $qb->andWhere('obos.id != :otcBuyOrderStatusCancel')->setParameter(
    99	                'otcBuyOrderStatusCancel',
   100	                self::CANCEL_STATUS_ID,
   101	            );
   102	        }
   103	
   104	        // 金額（From/To入れ替え処理）
   105	        $priceFrom = $searchData->priceFrom ?? null;
   106	        $priceTo = $searchData->priceTo ?? null;
   107	        if ($priceFrom !== null && $priceTo !== null && $priceFrom > $priceTo) {
   108	            [$priceFrom, $priceTo] = [$priceTo, $priceFrom];
   109	        }
   110	        if ($priceFrom !== null) {
   111	            $qb->andWhere('obo.totalPrice >= :priceFrom')->setParameter(
   112	                'priceFrom',
   113	                $priceFrom,
   114	            );
   115	        }
   116	        if ($priceTo !== null) {
   117	            $qb->andWhere('obo.totalPrice <= :priceTo')->setParameter(
   118	                'priceTo',
   119	                $priceTo,
   120	            );
   121	        }
   122	
   123	        // 申込日（From）
   124	        if (!empty($searchData->applicationDateFrom)) {
   125	            $qb->andWhere(
   126	                'obo.applyDate >= :applicationDateFrom',
   127	            )->setParameter(
   128	                'applicationDateFrom',
   129	                $searchData->applicationDateFrom,
   130	            );
   131	        }
   132	
   133	        // 申込日（To）
   134	        if (!empty($searchData->applicationDateTo)) {
   135	            $qb->andWhere('obo.applyDate <= :applicationDateTo')->setParameter(
   136	                'applicationDateTo',
   137	                $searchData->applicationDateTo,
   138	            );
   139	        }
   140	
   141	        // 完了日（From）
   142	        if (!empty($searchData->completeDateFrom)) {
   143	            $qb->andWhere(
   144	                '(obos.id = :cancelStatusId AND obo.cancelDate >= :cancelDateFrom) OR
   145	                        (obos.id != :cancelStatusId AND obo.completeDate >= :completeDateFrom)',
   146	            )
   147	                ->setParameter('cancelStatusId', self::CANCEL_STATUS_ID)
   148	                ->setParameter('cancelDateFrom', $searchData->completeDateFrom)
   149	                ->setParameter(
   150	                    'completeDateFrom',
   151	                    $searchData->completeDateFrom,
   152	                );
   153	        }
   154	
   155	        // 完了日（To）
   156	        if (!empty($searchData->completeDateTo)) {
   157	            $qb->andWhere(
   158	                '(obos.id = :cancelStatusId AND obo.cancelDate <= :cancelDateTo) OR
   159	                        (obos.id != :cancelStatusId AND obo.completeDate <= :completeDateTo)',
   160	            )
   161	                ->setParameter('cancelStatusId', self::CANCEL_STATUS_ID)
   162	                ->setParameter('cancelDateTo', $searchData->completeDateTo)
   163	                ->setParameter('completeDateTo', $searchData->completeDateTo);
   164	        }
   165	
   166	        // 氏名（複数キーワード検索）
   167	        if (!empty($searchData->nameMulti)) {
   168	            $keywords = preg_split("/[\s,　]+/u", trim($searchData->nameMulti));
   169	            foreach ($keywords as $i => $keyword) {
   170	                if ($keyword === '') {
   171	                    continue;
   172	                }
   173	                $qb->andWhere(
   174	                    $qb
   175	                        ->expr()
   176	                        ->orX(
   177	                            $qb->expr()->like('obo.lastName', ":keyword{$i}"),
   178	                            $qb->expr()->like('obo.firstName', ":keyword{$i}"),
   179	                            $qb
   180	                                ->expr()
   181	                                ->like('obo.lastNameKana', ":keyword{$i}"),
   182	                            $qb
   183	                                ->expr()
   184	                                ->like('obo.firstNameKana', ":keyword{$i}"),
   185	                        ),
   186	                )->setParameter("keyword{$i}", "%{$keyword}%");
   187	            }
   188	        }
   189	
   190	        // 商品名による検索
   191	        $productNames = $searchData->productNames ?? [];
   192	        $isOrSearch =
   193	            $searchData->productNameSelect ===
   194	            OtcBuyOrderType::PRODUCT_NAME_SEARCH_OR;
   195	        $productNameConditions = [];
   196	
   197	        // 有効な商品名条件があるか確認し、JOINを追加
   198	        foreach ($productNames as $index => $productName) {
   199	            if (StringUtil::isNotBlank($productName)) {
   200	                $detailAlias = "otcBuyOrderDetail{$index}";
   201	                $productClassAlias = "productClass{$index}";
   202	                $productAlias = "product{$index}";
   203	                $paramName = "productName{$index}";
   204	
   205	                $qb->join('obo.OtcBuyOrderDetails', $detailAlias)
   206	                    ->join("{$detailAlias}.ProductClass", $productClassAlias)
   207	                    ->join("{$productClassAlias}.Product", $productAlias);
   208	
   209	                $productNameConditions[] = [
   210	                    'productAlias' => $productAlias,
   211	                    'paramName' => $paramName,
   212	                    'value' => '%'.addcslashes($productName, '%_').'%',
   213	                ];
   214	            }
   215	        }
   216	
   217	        if (!empty($productNameConditions)) {
   218	            if ($isOrSearch) {
   219	                // OR検索: いずれかの条件を満たす（name または name_en にマッチ）
   220	                $orConditions = [];
   221	                foreach ($productNameConditions as $condition) {
   222	                    $orConditions[] = $qb
   223	                        ->expr()
   224	                        ->like(
   225	                            "{$condition['productAlias']}.name",
   226	                            ":{$condition['paramName']}",
   227	                        );
   228	                    $orConditions[] = $qb
   229	                        ->expr()
   230	                        ->like(
   231	                            "{$condition['productAlias']}.name_en",
   232	                            ":{$condition['paramName']}",
   233	                        );
   234	                    $qb->setParameter(
   235	                        $condition['paramName'],
   236	                        $condition['value'],
   237	                    );
   238	                }
   239	                $qb->andWhere($qb->expr()->orX(...$orConditions));
   240	            } else {
   241	                // AND検索: 各キーワードが name または name_en にマッチ
   242	                foreach ($productNameConditions as $condition) {
   243	                    $qb->andWhere(
   244	                        $qb
   245	                            ->expr()
   246	                            ->orX(
   247	                                $qb
   248	                                    ->expr()
   249	                                    ->like(
   250	                                        "{$condition['productAlias']}.name",
   251	                                        ":{$condition['paramName']}",
   252	                                    ),
   253	                                $qb
   254	                                    ->expr()
   255	                                    ->like(
   256	                                        "{$condition['productAlias']}.name_en",
   257	                                        ":{$condition['paramName']}",
   258	                                    ),
   259	                            ),
   260	                    )->setParameter(
   261	                        $condition['paramName'],
   262	                        $condition['value'],
   263	                    );
   264	                }
   265	            }
   266	        }
   267	
   268	        // 会員ID
   269	        if (!empty($searchData->customerId)) {
   270	            $qb->andWhere('obo.Customer = :customerId')->setParameter(
   271	                'customerId',
   272	                $searchData->customerId,
   273	            );
   274	        }
   275	
   276	        // 棚戻し未完了のみ表示
   277	        if ($searchData->restockIncompleteOnly) {
   278	            $qb->andWhere('obo.restockedFlg = :restockedFlg')->setParameter(
   279	                'restockedFlg',
   280	                false,
   281	            );
   282	        }
   283	
   284	        // ソート
   285	        $sortKey = $searchData->sort ?? 'default';
   286	        $order = $searchData->order ?? 'DESC';
   287	        $sortColumn = $this->sortKeys[$sortKey] ?? $this->sortKeys['default'];
   288	        $qb->addOrderBy($sortColumn, $order);
   289	
   290	        return $qb;
   291	    }
