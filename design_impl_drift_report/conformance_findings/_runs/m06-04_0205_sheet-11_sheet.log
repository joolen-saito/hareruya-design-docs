   577	
   578	        // generatePickingListと同様の構造だが実在庫（dtb_otc_buy_order_stock）を参照する。
   579	        // CSV出力のためDQLではなくraw SQL + iterateAssociativeを使用（大量データのストリーミング対応）。
   580	        $pickingTypeSortSupply = RestockListPdfSectionBuilder::PICKING_TYPE_SORT_SUPPLY;
   581	        $pickingTypeSortNullStandardPrice = RestockListPdfSectionBuilder::PICKING_TYPE_SORT_NULL_STANDARD_PRICE;
   582	
   583	        $sql = <<<SQL
   584	            SELECT
   585	                p.name AS "rawProductName",
   586	                sc.name AS "storageCodeName",
   587	                lng.code AS "languageCode",
   588	                cond.code AS "conditionCode",
   589	                (
   590	                    SELECT STRING_AGG(cl.name_jp, '' ORDER BY cl.id)
   591	                    FROM dtb_card_color dcc
   592	                    JOIN mtb_color cl ON cl.id = dcc.color_id
   593	                    WHERE dcc.card_id = c.id
   594	                ) AS "colorName",
   595	                r.code AS "rarityCode",
   596	                COALESCE(cd.foil_flg, 0) AS "foilFlg",
   597	                SUM(s.quantity) AS "quantity",
   598	                pc.standard_price AS "standardPrice",
   599	                bi.expensive_threshold1 AS "threshold1",
   600	                bi.expensive_threshold2 AS "threshold2",
   601	                bi.expensive_threshold3 AS "threshold3",
   602	                CASE WHEN p.card_detail_id IS NULL THEN 1 ELSE 0 END AS "isSupply",
   603	                -- ピッキング区分ソート: 円未満(1) → 円以上~円未満(2) → 円以上(3) → サプライ(99)
   604	                CASE
   605	                    WHEN p.card_detail_id IS NULL THEN {$pickingTypeSortSupply}
   606	                    WHEN pc.standard_price IS NULL THEN {$pickingTypeSortNullStandardPrice}
   607	                    -- バリデーションでbiは1店舗のみの前提のため、threhold1,2,3の価格順やnullableに依存せず、閾値を超えた数で区間番号を求めてソートtierを決定する
   608	                    ELSE
   609	                        (
   610	                            (CASE WHEN bi.expensive_threshold1 IS NOT NULL AND pc.standard_price >= bi.expensive_threshold1 THEN 1 ELSE 0 END)
   611	                            + (CASE WHEN bi.expensive_threshold2 IS NOT NULL AND pc.standard_price >= bi.expensive_threshold2 THEN 1 ELSE 0 END)
   612	                            + (CASE WHEN bi.expensive_threshold3 IS NOT NULL AND pc.standard_price >= bi.expensive_threshold3 THEN 1 ELSE 0 END)
   613	                        ) + 1
   614	                END AS "pickingTypeSort",
   615	                sn.name AS "shelfNumberName",
   616	                o.base_info_id AS "baseInfoId",
   617	                -- 棚番ソート: 本店のみ棚番順、支店は棚番によるソートを行わない（全て0で同順）
   618	                CASE WHEN o.base_info_id = :main_store_id THEN COALESCE(sn.sort_no, 99999) ELSE 0 END AS "shelfSort",
   619	                -- 言語ソート: mtb_language.id 昇順（日→英→他言語はマスターの並び順に依存）
   620	                COALESCE(lng.id, 99999) AS "languageSort",
   621	                -- 状態ソート: mtb_card_condition.id 昇順（NM→HP はマスターの並び順に依存）
   622	                COALESCE(pc.card_condition_id, 99999) AS "conditionSort",
   623	                -- Foilソート: 非Foil(0)→Foil(1以上)
   624	                COALESCE(cd.foil_flg, 0) AS "foilSort",
   625	                -- 略称タグソート: mtb_storage_code.rank 昇順
   626	                COALESCE(sc.rank, 99999) AS "storageCodeSort",
   627	                -- レアリティソート: mtb_rarity.sort_no 昇順（M→C はマスターの並び順に依存）
   628	                COALESCE(r.sort_no, 99999) AS "raritySort",
   629	                -- 色ソート: mtb_card.color_sequence_id → mtb_color_sequence.sort_no 昇順
   630	                COALESCE(cs.sort_no, 99999) AS "colorSort",
   631	                -- カードソート: alphabet_sort_flgがtrueの略称タグ→英語カード名昇順、falseならコレクター番号昇順
   632	                CASE WHEN sc.alphabet_sort_flg = true THEN c.name_en ELSE cd.card_no END AS "cardSort"
   633	            FROM dtb_otc_buy_order_stock s
   634	            JOIN dtb_otc_buy_order o ON o.id = s.otc_buy_order_id
   635	            JOIN dtb_base_info bi ON bi.id = o.base_info_id
   636	            JOIN dtb_product_class pc ON pc.id = s.product_class_id
   637	            JOIN dtb_product p ON p.id = pc.product_id
   638	            LEFT JOIN mtb_card_condition cond ON cond.id = pc.card_condition_id
   639	            LEFT JOIN mtb_storage_code sc ON sc.id = p.storage_code_id
   640	            LEFT JOIN mtb_card_detail cd ON cd.id = p.card_detail_id
   641	            LEFT JOIN mtb_rarity r ON r.id = cd.rarity_id
   642	            LEFT JOIN mtb_language lng ON lng.id = pc.language_id
   643	            LEFT JOIN mtb_card c ON c.id = cd.card_id
   644	            LEFT JOIN mtb_color_sequence cs ON cs.id = c.color_sequence_id
   645	            LEFT JOIN dtb_shelf_number sn ON sn.id = pc.shelf_number_id
   646	            WHERE
   647	                s.otc_buy_order_id IN (:ids)
   648	                AND o.otc_buy_order_status_id <> :cancel_status_id
   649	            GROUP BY
   650	                pc.id, p.id, p.name, sc.name, sc.rank, sc.alphabet_sort_flg,
   651	                lng.id, lng.code, cond.code, r.code, r.sort_no,
   652	                cd.foil_flg, cd.card_no, pc.standard_price,
   653	                bi.expensive_threshold1, bi.expensive_threshold2, bi.expensive_threshold3,
   654	                c.id, c.name_en, c.color_sequence_id,
   655	                cs.sort_no, sn.sort_no, sn.name, o.base_info_id
   656	            ORDER BY
   657	                -- 1. ピッキング区分: 円未満→円以上〜円未満→円以上→サプライ
   658	                "pickingTypeSort" ASC,
   659	                -- 2. 棚番: 本店のみ昇順（支店は棚番ソートなし）
   660	                "shelfSort" ASC,
   661	                -- 3. 言語: 日→英→他言語
   662	                "languageSort" ASC,
   663	                -- 4. 状態: NM→HP
   664	                "conditionSort" ASC,
   665	                -- 5. Foilフラグ: 非Foil→Foil
   666	                "foilSort" ASC,
   667	                -- 6. 略称タグ: 昇順
   668	                "storageCodeSort" ASC,
   669	                -- 7. レアリティ: M→C
   670	                "raritySort" ASC,
   671	                -- 8. 色: マスターデータ色順（mtb_color_sequence.sort_no）
   672	                "colorSort" ASC,
   673	                -- 9. 略称タグがアルファベットソートなら英語カード名昇順、コレクター番号ソートならcard_no昇順
   674	                "cardSort" ASC
   675	        SQL;
