   383	    /**
   384	     * 買取商品CSV出力用データ取得
   385	     *
   386	     * @param array<int, int> $otcBuyOrderIds
   387	     *
   388	     * @return \Traversable<int, array{
   389	     * productCode: string|null,
   390	     * stockChange: int,
   391	     * productName: string,
   392	     * standardPrice: int,
   393	     * buyPrice: int,
   394	     * languageId: int,
   395	     * slug: string|null,
   396	     * rarity: string|null,
   397	     * condition: string|null,
   398	     * }>
   399	     *
   400	     * 買取商品一覧の集計単位仕様:
   401	     * 旧仕様のネット買取商品一覧に沿っている
   402	     * 集計対象データ: OtcBuyOrderにて買取状況が「キャンセル済み」でないもの
   403	     *
   404	     * 集計方法: 以下の3つのデータソースをUNIONで結合し、それぞれ異なる単位で集計（SUM）
   405	     * * 1. OtcBuyOrderDetail
   406	     * [集計単位] 商品規格ID (product_class_id) ＋ 買取単価 (price)
   407	     * [説明] 同じ商品・同じコンディションでも、「買取価格」が1円でも異なれば別行として出力される。
   408	     * 逆に、規格と価格が完全に一致していれば、複数の注文に跨っていても数量が合算される。
   409	     * * 2. BuyOrderIndividualInput
   410	     * [集計単位] 1レコード単位（集計なし）
   411	     * [説明] dtb_buy_order_indivisual_input_product テーブルの各行をそのまま出力。
   412	     * 商品名や価格が同じであっても、登録されたレコードごとに1行ずつ出力される。
   413	     * * 3. 状態未指定の商品（コンディションIDが空のデータ）
   414	     * [集計単位] 商品ID (product_id)
   415	     * [説明] 規格（言語や状態）の区別がないため、商品単位で数量が合算される。
   416	     * ※この際、価格(price)はGROUP BYに含まれていないため、SQLの挙動により最初に見つかった価格が表示される。
   417	     * * [ソート順]
   418	     * 1. 通常買取商品 -> 通常買取商品(商品コード未設定) -> 個別入力商品 (indivisual_input_product_sort ASC)
   419	     * 2. 商品ID順
   420	     * 3. コンディションID順
   421	     **/
   422	    public function getOtcBuyOrderProductListCsvExportData(
   423	        array $otcBuyOrderIds,
   424	    ): iterable {
   425	        if (empty($otcBuyOrderIds)) {
   426	            return new \ArrayIterator([]);
   427	        }
   428	        // SQLが複雑でDoctrineでうまく対応できない & 数万件のデータ出力も想定されるため、SQLでクエリ
   429	        // Connectionの取得
   430	        $conn = $this->getEntityManager()->getConnection();
   431	        $conn->executeStatement("SET TIME ZONE 'Asia/Tokyo'");
   432	
   433	        $sql = <<<SQL
   434	            (
   435	                -- 1. 通常商品（状態/Conditionあり）
   436	                SELECT
   437	                    pc.product_code AS "productCode",
   438	                    SUM(od.original_quantity) AS "productCount",
   439	                    p.name AS "productName",
   440	                    pc.standard_price AS "standardPrice",
   441	                    od.price AS "buyPrice",
   442	                    pc.language_id AS "languageId",
   443	                    sc.name AS "storageCode",
   444	                    r.code AS "rarityCode",
   445	                    cc.code AS "conditionCode",
   446	                    (CASE WHEN pc.product_code IS NULL THEN 1 ELSE 0 END) AS "productCodeNullSort",
   447	                    pc.card_condition_id AS "cardConditionId",
   448	                    p.id AS "productId",
   449	                    '0' AS "individualInputProductSort"
   450	                FROM
   451	                    dtb_otc_buy_order o
   452	                JOIN
   453	                    dtb_otc_buy_order_detail od ON od.otc_buy_order_id = o.id
   454	                JOIN
   455	                    dtb_product_class pc ON pc.id = od.product_class_id
   456	                    AND pc.product_status_id IN (:product_status_ids) -- 移植元のネット買取の結合仕様に合わせている
   457	                    AND pc.high_price_code IS NULL -- 移植元のネット買取の結合仕様に合わせている
   458	                JOIN
   459	                    dtb_product p ON p.id = pc.product_id
   460	                JOIN
   461	                    mtb_card_condition cc ON cc.id = pc.card_condition_id -- 状態があるもののみ
   462	                LEFT JOIN
   463	                    mtb_storage_code sc ON sc.id = p.storage_code_id
   464	                LEFT JOIN
   465	                    mtb_card_detail cd ON cd.id = p.card_detail_id
   466	                LEFT JOIN
   467	                    mtb_rarity r ON r.id = cd.rarity_id
   468	                WHERE
   469	                    o.id IN (:ids)
   470	                    AND o.otc_buy_order_status_id <> :cancel_status_id
   471	                GROUP BY
   472	                    pc.id, od.price, pc.product_code, p.name, pc.standard_price, pc.language_id,
   473	                    sc.name, r.code, cc.code, pc.card_condition_id, p.id
   474	            )
   475	            UNION ALL
   476	            (
   477	                -- 2. 個別入力商品
   478	                SELECT
   479	                    '' AS "productCode",
   480	                    iip.quantity AS "productCount",
   481	                    iip.name AS "productName",
   482	                    NULL AS "standardPrice",
   483	                    iip.price AS "buyPrice",
   484	                    1 AS "languageId",
   485	                    '' AS "storageCode",
   486	                    '' AS "rarityCode",
   487	                    '' AS "conditionCode",
   488	                    2 AS "productCodeNullSort",
   489	                    NULL AS "cardConditionId",
   490	                    NULL AS "productId",
   491	                    '1' AS "individualInputProductSort"
   492	                FROM
   493	                    dtb_otc_buy_order_indivisual_input_product iip
   494	                JOIN
   495	                    dtb_otc_buy_order o ON o.id = iip.otc_buy_order_id -- ステータス確認のため結合
   496	                WHERE
   497	                    o.otc_buy_order_status_id <> :cancel_status_id
   498	                    AND iip.otc_buy_order_id IN (:ids)
   499	            )
   500	            UNION ALL
   501	            (
   502	                -- 3. 通常商品（状態/Conditionなし）
   503	                SELECT
   504	                    '' AS "productCode",
   505	                    SUM(od.original_quantity) AS "productCount",
   506	                    p.name AS "productName",
   507	                    pc.standard_price AS "standardPrice",
   508	                    od.price AS "buyPrice",
   509	                    pc.language_id AS "languageId",
   510	                    sc.name AS "storageCode",
   511	                    r.code AS "rarityCode",
   512	                    '' AS "conditionCode",
   513	                    1 AS "productCodeNullSort",
   514	                    NULL AS "cardConditionId",
   515	                    p.id AS "productId",
   516	                    '0' AS "individualInputProductSort"
   517	                FROM
   518	                    dtb_otc_buy_order o
   519	                JOIN
   520	                    dtb_otc_buy_order_detail od ON od.otc_buy_order_id = o.id
   521	                JOIN
   522	                    dtb_product_class pc ON pc.id = od.product_class_id
   523	                JOIN
   524	                    dtb_product p ON p.id = pc.product_id
   525	                LEFT JOIN
   526	                    mtb_storage_code sc ON sc.id = p.storage_code_id
   527	                LEFT JOIN
   528	                    mtb_card_detail cd ON cd.id = p.card_detail_id
   529	                LEFT JOIN
   530	                    mtb_rarity r ON r.id = cd.rarity_id
   531	                WHERE
   532	                    o.id IN (:ids)
   533	                    AND o.otc_buy_order_status_id <> :cancel_status_id
   534	                    AND (pc.card_condition_id IS NULL OR pc.card_condition_id = 0)
   535	                GROUP BY
   536	                    pc.id, od.price, pc.product_code, p.name, pc.standard_price, pc.language_id,
   537	                    sc.name, r.code, p.id
   538	            )
   539	            ORDER BY
   540	                "individualInputProductSort" ASC,
   541	                "productId" ASC,
   542	                "productCodeNullSort" ASC,
   543	                "cardConditionId" ASC
   544	        SQL;
   545	
   546	        return $conn->iterateAssociative(
   547	            $sql,
   548	            [
   549	                'ids' => $otcBuyOrderIds,
   550	                'cancel_status_id' => self::CANCEL_STATUS_ID,
   551	                'product_status_ids' => [ProductStatus::DISPLAY_SHOW, ProductStatus::DISPLAY_HIDE],
   552	            ],
   553	            [
   554	                'ids' => ArrayParameterType::INTEGER,
   555	                'cancel_status_id' => \PDO::PARAM_INT,
   556	                'product_status_ids' => \Doctrine\DBAL\Connection::PARAM_INT_ARRAY,
   557	            ]
   558	        );
   559	    }
