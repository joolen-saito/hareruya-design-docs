    16	use Eccube\Common\EccubeConfig;
    17	use Eccube\Entity\Member;
    18	use Eccube\Repository\AuthorityRoleRepository;
    19	use Symfony\Bundle\SecurityBundle\Security;
    20	use Symfony\Component\Routing\Generator\UrlGeneratorInterface;
    21	use Twig\Extension\AbstractExtension;
    22	use Twig\TwigFunction;
    23	
    24	class IsAccessibleRouteExtension extends AbstractExtension
    25	{
    26	    public function __construct(
    27	        private readonly UrlGeneratorInterface $router,
    28	        private readonly Security $security,
    29	        private readonly AuthorityRoleRepository $authorityRoleRepository,
    30	        private readonly EccubeConfig $eccubeConfig,
    31	    ) {
    32	    }
    33	
    34	    /**
    35	     * Twig関数を返します.
    36	     *
    37	     * @return TwigFunction[]
    38	     */
    39	    #[\Override]
    40	    public function getFunctions(): array
    41	    {
    42	        return [
    43	            new TwigFunction('is_accessable_route', $this->isAccessibleRoute(...)),
    44	        ];
    45	    }
    46	
    47	    /**
    48	     * ユーザーがアクセス可能なルートかどうかを判定します.
    49	     */
    50	    public function isAccessibleRoute(string $routeName): bool
    51	    {
    52	        $Member = $this->security->getUser();
    53	        if (!$Member instanceof Member) {
    54	            return false;
    55	        }
    56	
    57	        /** @phpstan-ignore-next-line $routeCollection - phpstanにgetRouteCollection関数は存在していないと言われているけど、存在している */
    58	        $routeCollection = $this->router->getRouteCollection();
    59	        $route = $routeCollection->get($routeName);
    60	        if ($route === null) {
    61	            return true;
    62	        }
    63	
    64	        $path = $route->getPath();
    65	        $AuthorityRoles = $this->authorityRoleRepository->findBy(['Authority' => $Member->getAuthority()]);
    66	        $adminRoute = $this->eccubeConfig->get('eccube_admin_route');
    67	
    68	        foreach ($AuthorityRoles as $AuthorityRole) {
    69	            // 許可しないURLが含まれていればアクセス拒否
    70	            try {
    71	                // denyUrlの\d+をプレースホルダー{id}等にもマッチするよう変換し、正規表現でURLチェック
    72	                // AuthorityVoterとは違い、{id}等のプレースホルダーが含まれている場合があるためマッチするように変換
    73	                $denyUrl = str_replace(['\\d+', '/'], ['(\\d+|\\{[^}]+\\})', '\\/'], $AuthorityRole->getDenyUrl());
    74	                if (preg_match("/^(\\/{$adminRoute}{$denyUrl})/i", (string) $path)) {
    75	                    return false;
    76	                }
    77	            } catch (\Exception) {
    78	                // 拒否URLの指定に誤りがある場合、エスケープさせてチェック
    79	                $denyUrl = preg_quote((string) $AuthorityRole->getDenyUrl(), '/');
    80	                if (preg_match("/^(\\/{$adminRoute}{$denyUrl})/i", (string) $path)) {
    81	                    return false;
    82	                }
    83	            }
    84	        }
    85	
    86	        return true;
    87	    }
    88	}

