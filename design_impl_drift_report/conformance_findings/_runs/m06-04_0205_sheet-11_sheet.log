   293	    /**
   294	     * 古物台帳入力用CSV出力用データ取得
   295	     *
   296	     * @param array<int, int> $otcBuyOrderIds
   297	     *
   298	     * @return \Traversable<int, array{
   299	     * otcBuyOrderId: int,
   300	     * assessmentId: string|null,
   301	     * completeDate: string,
   302	     * totalQuantity: int|string,
   303	     * totalPrice: int|string,
   304	     * fullName: string,
   305	     * age: int|null,
   306	     * address: string,
   307	     * identificationType: string|null,
   308	     * job: string|null,
   309	     * phoneNumber: string|null,
   310	     * qualifiedInvoiceIssuerFlg: bool|int,
   311	     * qualifiedInvoiceIssuerNumber: string|null
   312	     * }>
   313	     **/
   314	    public function getOldAccountCsvExportData(array $otcBuyOrderIds): iterable
   315	    {
   316	        if (empty($otcBuyOrderIds)) {
   317	            return new \ArrayIterator([]);
   318	        }
   319	        // SQLが複雑でDoctrineでうまく対応できない & 数万件のデータ出力も想定されるため、SQLでクエリ
   320	        // Connectionの取得
   321	        $conn = $this->getEntityManager()->getConnection();
   322	        $conn->executeStatement("SET TIME ZONE 'Asia/Tokyo'");
   323	
   324	        $sql = <<<SQL
   325	            SELECT
   326	                o.id AS "otcBuyOrderId",
   327	                o.assessment_id AS "assessmentId",
   328	                TO_CHAR(o.complete_date, 'YYYY"年"FMMM"月"FMDD"日"') AS "completeDate",
   329	                -- サブクエリで事前に集計した数量を結合して、重複を完全に防ぐ
   330	                COALESCE(sub_od.detail_quantity, 0) + COALESCE(sub_oip.input_product_quantity, 0) AS "totalQuantity",
   331	                o.total_price AS "totalPrice",
   332	                -- first_nameとlast_nameの間に全角空白
   333	                CONCAT(o.last_name, '　', o.first_name) AS "fullName",
   334	                -- PostgreSQLのAGE関数で正確な年齢（年数）を取得
   335	                EXTRACT(YEAR FROM AGE(o.apply_date, o.birth)) AS "age",
   336	                -- "日本の場合は県名 + 半角空白 + 住所1 + 半角空白 + 住所2 + 住所3
   337	                -- 海外の場合は国名 + 半角空白 + 住所3 + 半角空白 + 住所2 + 住所1
   338	                CASE
   339	                    WHEN c.id = :countryId
   340	                    THEN CONCAT_WS(' ', p.name, o.addr01, o.addr02, o.addr03)
   341	                    ELSE CONCAT_WS(' ', c.name, o.addr03, o.addr02, o.addr01)
   342	                END AS "address",
   343	                i.name AS "identificationType",
   344	                j.name AS "job",
   345	                -- ="電話番号"の形式で出力
   346	                CASE
   347	                    WHEN o.tel_no IS NULL OR o.tel_no = ''
   348	                    THEN o.tel_no
   349	                    ELSE CONCAT('="', REPLACE(o.tel_no, '"', '""'), '"') -- 電話番号に"が含まれている場合はCSVの数式が壊れるのでエスケープ
   350	                END AS "phoneNumber",
   351	                o.qualified_invoice_issuer_flg AS "qualifiedInvoiceIssuerFlg",
   352	                qiia.qualified_invoice_issuer_code AS "qualifiedInvoiceIssuerNumber"
   353	            FROM dtb_otc_buy_order AS o
   354	            -- 明細の集計
   355	            LEFT JOIN (
   356	                SELECT otc_buy_order_id, SUM(original_quantity) as detail_quantity
   357	                FROM dtb_otc_buy_order_detail GROUP BY otc_buy_order_id
   358	            ) AS sub_od ON sub_od.otc_buy_order_id = o.id
   359	            -- 個別入力の集計
   360	            LEFT JOIN (
   361	                SELECT otc_buy_order_id, SUM(quantity) as input_product_quantity
   362	                FROM dtb_otc_buy_order_indivisual_input_product GROUP BY otc_buy_order_id
   363	            ) AS sub_oip ON sub_oip.otc_buy_order_id = o.id
   364	            LEFT JOIN mtb_job AS j ON o.job_id = j.id
   365	            LEFT JOIN mtb_country AS c ON o.country_id = c.id
   366	            LEFT JOIN mtb_pref AS p ON o.pref_id = p.id
   367	            LEFT JOIN mtb_identification AS i ON o.identification_id = i.id
   368	            LEFT JOIN dtb_qualified_invoice_issuer_account AS qiia ON o.qualified_invoice_issuer_account_id = qiia.id
   369	            WHERE o.id IN (:ids)
   370	            ORDER BY o.assessment_id DESC
   371	        SQL;
   372	
   373	        return $conn->iterateAssociative(
   374	            $sql,
   375	            ['ids' => $otcBuyOrderIds, 'countryId' => Country::JAPAN],
   376	            [
   377	                'ids' => ArrayParameterType::INTEGER,
   378	                'countryId' => ParameterType::INTEGER,
   379	            ],
   380	        );
   381	    }
