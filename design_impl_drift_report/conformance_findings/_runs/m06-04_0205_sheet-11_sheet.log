    21	use Eccube\Repository\Master\MtbOptionRepository;
    22	use Eccube\Service\Admin\OtcBuyOrder\ActionInput\RecalculateSummaryInput;
    23	
    24	class RecalculateSummaryAction
    25	{
    26	    public function __construct(
    27	        private readonly DtbOtcBuyOrderRepository $otcBuyOrderRepository,
    28	        private readonly DtbOtcBuyOrderSummaryRepository $otcBuyOrderSummaryRepository,
    29	        private readonly MtbOptionRepository $mtbOptionRepository,
    30	    ) {
    31	    }
    32	
    33	    public function handle(RecalculateSummaryInput $input): void
    34	    {
    35	        // 集計対象ステータスの出入りがなければ再集計不要
    36	        $wasInSummary = in_array($input->oldStatusId, MtbOtcBuyOrderStatus::SUMMARY_STATUSES, true);
    37	        $isInSummary = in_array($input->newStatusId, MtbOtcBuyOrderStatus::SUMMARY_STATUSES, true);
    38	        if ($wasInSummary === $isInSummary) {
    39	            return;
    40	        }
    41	
    42	        $completeDate = $input->OtcBuyOrder->getCompleteDate();
    43	        if ($completeDate === null) {
    44	            return;
    45	        }
    46	
    47	        $summaryDate = (clone $completeDate)->modify('00:00:00');
    48	
    49	        SummaryByDateAggregator::aggregate(
    50	            $summaryDate,
    51	            $this->otcBuyOrderRepository,
    52	            $this->otcBuyOrderSummaryRepository,
    53	            $this->mtbOptionRepository,
    54	        );
    55	    }
    56	}

