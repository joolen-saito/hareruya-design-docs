    /**
     * スマレジ再送信対象の受注を取得
     */
    public function getResendSmaregiProduct(): mixed
    {
        $qb = $this->createQueryBuilder('os');

        return $qb->where('os.smaregi_code is not null')
            ->andWhere('os.smaregi_del_flg = :delFlg')
            ->andWhere($qb->expr()->orX(
                $qb->expr()->eq('os.smaregi_product_flg', ':productFlg'),
                $qb->expr()->eq('os.smaregi_stock_flg', ':stockFlg')
            ))
            ->setParameter('delFlg', Constant::DISABLED)
            ->setParameter('productFlg', Constant::DISABLED)
            ->setParameter('stockFlg', Constant::DISABLED)
            ->getQuery()
            ->getResult();
    }

    /**
     * 店頭受取注文 (Delivery::OTC_GROUP) のうち、スマレジ商品/在庫の連携が未完了な受注を返す。
     *
     * 取得条件:
     * - Shipping.Delivery が OTC または SMOOTH_OTC
     * - OrderStatus = NEW (受取前)
     * - smaregi_del_flg = false (削除対象でない)
     * - smaregi_error_flg = false (エラー受注は本バッチでは扱わない)
     * - smaregi_product_flg = false または smaregi_stock_flg = false (いずれかが未連携)
     *
     * 1 受注 = 1 スマレジ商品の前提で、productCode は注文番号+店舗IDから決定論的に採番する。
     *
     * @return list<Order>
     */
    public function findOtcOrdersAwaitingSmaregiSync(int $limit = 100): array
    {
        $qb = $this->createQueryBuilder('o');
        $qb
            ->distinct()
            ->innerJoin(\Eccube\Entity\Shipping::class, 's', 'WITH', 's.Order = o')
            ->where('s.Delivery IN (:deliveryIds)')
            ->andWhere('o.OrderStatus = :orderNew')
            ->andWhere('o.smaregi_del_flg = :flgFalse')
            ->andWhere('o.smaregi_error_flg = :flgFalse')
            ->andWhere($qb->expr()->orX(
                'o.smaregi_product_flg = :flgFalse',
                'o.smaregi_stock_flg = :flgFalse',
            ))
            ->setParameter('deliveryIds', Delivery::OTC_GROUP)
            ->setParameter('orderNew', OrderStatus::NEW)
            ->setParameter('flgFalse', Constant::DISABLED)
            ->orderBy('o.id', 'ASC')
            ->setMaxResults($limit);
     * スマレジ連携済みフラグ = 未連携
     * スマレジ在庫連携済みフラグ = 未連携
     * 注文ステータス = 注文受領・入金待ち・入金済み・ピック中・ピック済み
     *
     * @param \DateTime $targetDateTime
     *
     * @return array<Order>
     */
    public function findTargetOrdersForSmaregiPost(\DateTime $targetDateTime): array
    {
        $qb = $this->createQueryBuilder('o');
        $qb->select('o, bi')
            ->where('o.order_date < :targetDateTime')
            ->join('o.baseInfo', 'bi')
            ->andWhere('bi.smaregi_shop_id IS NOT NULL')
            ->andWhere('bi.smaregi_shop_code IS NOT NULL')
            ->join('o.Shippings', 's')
            ->andWhere('s.Delivery IN (:delivery)')
            ->setParameter('delivery', [Delivery::OTC, Delivery::SMOOTH_OTC])
            ->andWhere('o.smaregi_product_flg = false')
            ->andWhere('o.smaregi_stock_flg = false')
            ->andWhere('o.order_number IS NOT NULL')
            ->andWhere('o.OrderStatus IN (:orderStatus)')
            ->setParameter('targetDateTime', $targetDateTime)
