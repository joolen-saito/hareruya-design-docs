namespace Eccube\Service\Smaregi\Otc;

use Doctrine\ORM\EntityManagerInterface;
use Eccube\Entity\MessengerJob;
use Eccube\Entity\Order;
use Eccube\Message\SmaregiOtcSyncMessage;
use Psr\Log\LoggerInterface;
use Symfony\Component\Messenger\MessageBusInterface;

/**
 * 店頭受取注文 (OTC) スマレジ連携を MessengerJob として enqueue するディスパッチャ。
 *
 * 同一 DB トランザクション内で MessengerJob を pending で永続化 → commit 成功後に
 * MessageBus へ dispatch する (アウトボックス順序)。
 * dispatch 失敗時は MessengerJob を FAILED に遷移させ例外を再 throw する
 * (既存 SmaregiProductClassEventService::dispatchUpsert と同方針)。
 */
final readonly class SmaregiOtcSyncDispatcher
{
    public function __construct(
        private MessageBusInterface $messageBus,
        private EntityManagerInterface $entityManager,
        private LoggerInterface $logger,
    ) {
    }

    public function dispatch(Order $Order): MessengerJob
    {
        $orderId = $Order->getId();
        if ($orderId === null) {
            throw new \InvalidArgumentException('Order id is null; cannot enqueue Smaregi OTC sync job.');
        }

        $Job = new MessengerJob();
        $Job->setMessageClass(SmaregiOtcSyncMessage::class);
        $Job->setStatus(MessengerJob::STATUS_PENDING);
        $Job->setPayloadSummary(sprintf(
            'orderId=%d orderNo=%s',
            $orderId,
            (string) ($Order->getOrderNo() ?? ''),
        ));
        $this->entityManager->persist($Job);
        $this->entityManager->flush();

        try {
            $this->messageBus->dispatch(new SmaregiOtcSyncMessage(
                $orderId,
                (int) $Job->getId(),
            ));
        } catch (\Throwable $e) {
            try {
                $Job->setStatus(MessengerJob::STATUS_FAILED);
                $Job->setCompletedAt(new \DateTime());
                $Job->setErrorMessage('メッセージバスへの投入に失敗しました: '.$e->getMessage());
                $this->entityManager->flush();
            } catch (\Throwable $persistError) {
                $this->logger->error('Failed to persist Smaregi OTC sync job failure state', [
                    'jobId' => $Job->getId(),
                    'orderId' => $orderId,
                    'error' => $persistError->getMessage(),
                ]);
            }
            $this->logger->error('Smaregi OTC sync message dispatch failed', [
                'exception' => $e,
                'jobId' => $Job->getId(),
                'orderId' => $orderId,
            ]);

            throw $e;
        }

        return $Job;
    }
}
