    private function isHttpSuccess(int $statusCode): bool
    {
        return $statusCode >= 200 && $statusCode < 300;
    }

    /**
     * 仕様書より抜粋: スムーズ店頭受取は 0 円固定 / 店頭受取は注文合計 (payment_total)。
     */
    private function resolvePrice(Order $Order): string
    {
        foreach ($Order->getShippings() as $Shipping) {
            $delivery = $Shipping->getDelivery();
            if ($delivery instanceof Delivery && $delivery->getId() === Delivery::SMOOTH_OTC) {
                return '0';
            }
        }

        return (string) max(0, (int) $Order->getPaymentTotal());
    }

    private function markError(Order $Order, string $message): void
    {
        $this->logger->error($message, [
            'orderId' => $Order->getId(),
            'orderNumber' => $Order->getOrderNumber(),
            'smaregiCode' => $Order->getSmaregiCode(),
        ]);
        $Order->setSmaregiErrorFlg(true);
        $this->entityManager->flush();
    }
}

