use Psr\Log\LoggerInterface;

/**
 * 店頭受取注文 (OTC) を「1 注文 = 1 スマレジ商品」として連携する同期サービス。
 *
 * 処理フロー:
 *   1. smaregi_del_flg / 既連携をスキップ判定
 *   2. productCode を採番 ({@see SmaregiOtcProductCodeGenerator})
 *   3. 商品登録 (存在チェック→未登録なら create)
 *   4. 在庫登録 (quantity=1)
 *
 * 各ステップは独立に flush されるため、商品登録のみ完了して在庫登録が失敗しても
 * 次回バッチで在庫登録のみが再試行される (smaregi_product_flg / smaregi_stock_flg の状態に応じて)。
 *
 * API 呼び出し失敗時は smaregi_error_flg を true にし、{@see SmaregiOtcSyncResult} を返す。
 * エラー受注は次回バッチで自動再試行しない方針 (運用側でのフラグ解除を前提)。
 */
final readonly class SmaregiOtcOrderSyncService
{
    public function __construct(
        private LoggerInterface $logger,
        private EntityManagerInterface $entityManager,
        private SmaregiOtcProductCodeGenerator $productCodeGenerator,
        private SmaregiProductApiClient $productApiClient,
        private SmaregiStockApiClient $stockApiClient,
    ) {
    }

    public function sync(
        Order $Order,
        string $apiUrl,
        string $contractId,
        string $accessToken,
        string $storeId,
        string $categoryId,
    ): SmaregiOtcSyncResult {
        if ($Order->isSmaregiDelFlg()) {
            return SmaregiOtcSyncResult::SKIPPED;
        }
        if ($Order->isSmaregiProductFlg() && $Order->isSmaregiStockFlg()) {
            return SmaregiOtcSyncResult::ALREADY_SYNCED;
        }

        $orderNumber = (string) ($Order->getOrderNumber() ?? '');
        if ($orderNumber === '') {
            $this->logger->warning('Smaregi OTC sync skipped: order_number is empty', [
                'orderId' => $Order->getId(),
            ]);

            return SmaregiOtcSyncResult::SKIPPED;
        }

        try {
            $productCode = $Order->getSmaregiCode();
            if ($productCode === null || $productCode === '') {
                $productCode = $this->productCodeGenerator->generate($storeId, $orderNumber);
            }
        } catch (\InvalidArgumentException $e) {
            $this->markError($Order, sprintf(
                'Smaregi OTC sync failed: product code generation error (storeId=%s, orderNumber=%s, error=%s)',
                $storeId,
                $orderNumber,
                $e->getMessage(),
            ));

            return SmaregiOtcSyncResult::PRODUCT_FAILED;
        }

        $productId = null;

        // Phase A: product registration
        if (!$Order->isSmaregiProductFlg()) {
            $phaseResult = $this->ensureProductRegistered(
                $Order,
                $apiUrl,
                $contractId,
                $accessToken,
                $categoryId,
                $productCode,
            );
            if ($phaseResult instanceof SmaregiOtcSyncResult) {
                return $phaseResult;
            }
            $productId = $phaseResult;
        }

        // Phase B: stock registration
        if (!$Order->isSmaregiStockFlg()) {
            if ($productId === null) {
                $productId = $this->resolveProductIdByCode($apiUrl, $contractId, $accessToken, $productCode);
                if ($productId === null) {
                    $this->markError($Order, 'Smaregi product id lookup failed for stock add');

                    return SmaregiOtcSyncResult::STOCK_FAILED;
                }
            }

            $stockResult = $this->stockApiClient->add(
                $apiUrl,
                $contractId,
                $accessToken,
                $storeId,
                $productId,
                1,
            );
            if (!$this->isHttpSuccess($stockResult['statusCode'])) {
                $this->markError($Order, sprintf('Smaregi stock add failed (status=%d)', $stockResult['statusCode']));

                return SmaregiOtcSyncResult::STOCK_FAILED;
            }

            $Order->setSmaregiStockFlg(true);
            $this->entityManager->flush();
        }

        return SmaregiOtcSyncResult::SUCCESS;
    }

    /**
     * 商品登録フェーズ。成功した場合は productId を返し、失敗時は失敗系の Result を返す。
     */
    private function ensureProductRegistered(
        Order $Order,
        string $apiUrl,
        string $contractId,
        string $accessToken,
        string $categoryId,
        string $productCode,
    ): string|SmaregiOtcSyncResult {
        // まずは Smaregi 側に既存の productCode が存在するか確認する (冪等性確保)。
        $resolvedId = $this->resolveProductIdByCode($apiUrl, $contractId, $accessToken, $productCode);
        if ($resolvedId !== null) {
            $Order->setSmaregiCode($productCode);
            $Order->setSmaregiProductFlg(true);
            $this->entityManager->flush();

            return $resolvedId;
        }

        if ($categoryId === '') {
            $this->markError($Order, 'Smaregi OTC categoryId is empty');

            return SmaregiOtcSyncResult::PRODUCT_FAILED;
        }

        $body = $this->buildProductBody($Order, $productCode, $categoryId);
        $createResult = $this->productApiClient->create($apiUrl, $contractId, $accessToken, $body);

        if (!$this->isHttpSuccess($createResult['statusCode'])) {
            // create 失敗後にもう一度 listByProductCode で取り直す (競合作成の救済)。
            $retryId = $this->resolveProductIdByCode($apiUrl, $contractId, $accessToken, $productCode);
            if ($retryId !== null) {
                $Order->setSmaregiCode($productCode);
                $Order->setSmaregiProductFlg(true);
                $this->entityManager->flush();

                return $retryId;
            }

            $this->markError($Order, sprintf('Smaregi product create failed (status=%d)', $createResult['statusCode']));

            return SmaregiOtcSyncResult::PRODUCT_FAILED;
        }

        $newId = $this->extractProductId($createResult['json']);
        if ($newId === null) {
            $this->markError($Order, 'Smaregi product create response has no productId');

            return SmaregiOtcSyncResult::PRODUCT_FAILED;
        }

        $Order->setSmaregiCode($productCode);
        $Order->setSmaregiProductFlg(true);
        $this->entityManager->flush();

        return $newId;
    }

    private function resolveProductIdByCode(
        string $apiUrl,
        string $contractId,
        string $accessToken,
        string $productCode,
    ): ?string {
        $result = $this->productApiClient->listByProductCode($apiUrl, $contractId, $accessToken, $productCode);
        if (!$this->isHttpSuccess($result['statusCode'])) {
            return null;
        }

        $json = $result['json'];
        if (!is_array($json)) {
            return null;
        }

        foreach ($json as $row) {
            if (($row['productCode'] ?? null) !== $productCode) {
                continue;
            }
            $productId = $row['productId'] ?? null;
            if (is_string($productId) && $productId !== '') {
                return $productId;
            }
        }

        return null;
    }

    private function extractProductId(mixed $json): ?string
    {
        if (!is_array($json)) {
            return null;
        }
        if (array_is_list($json)) {
            return null;
        }
        $productId = $json['productId'] ?? null;
        if (!is_string($productId) || $productId === '') {
            return null;
        }

        return $productId;
    }

