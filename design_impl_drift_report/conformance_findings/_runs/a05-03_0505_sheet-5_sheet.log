     5	    function isUpdateList(newList) {
     6	        if (!Array.isArray(newList)) {
     7	            // 配列でなければfalse
     8	            return false;
     9	        }
    10	        if (newList.length === 0) {
    11	            // 新しいリストが空ならfalse
