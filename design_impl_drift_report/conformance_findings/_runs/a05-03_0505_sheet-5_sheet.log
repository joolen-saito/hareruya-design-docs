    13	        }
    14	        if (currentList.length === 0) {
    15	            // 現在のリストが空ならtrue
    16	            return true;
    17	        }
    18	        if (currentList.length < newList.length) {
    19	            // 新しいリストの方が長い場合はtrue
    20	            return true;
    21	        }
    22	
    23	        for (let i = 0; i < newList.length; ++i) {
