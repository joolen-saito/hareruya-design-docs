    16	namespace Eccube\Repository;
    17	
    18	use Doctrine\Persistence\ManagerRegistry;
    19	use Eccube\Entity\DtbWaitingNumber;
    20	use Eccube\Entity\Order;
    21	
    22	/**
    23	 * @extends AbstractRepository<DtbWaitingNumber>
    24	 */
    25	class DtbWaitingNumberRepository extends AbstractRepository
    26	{
    27	    public function __construct(ManagerRegistry $registry)
    28	    {
    29	        parent::__construct($registry, DtbWaitingNumber::class);
    30	    }
    31	
    32	    /**
    33	     * 店舗販売用整理番号を物理削除
    34	     *
    35	     * @return void
    36	     */
    37	    public function truncateWaitingNumber(): void
    38	    {
    39	        $connection = $this->getEntityManager()->getConnection();
    40	        $connection->executeStatement('TRUNCATE TABLE dtb_waiting_number');
    41	    }
    42	
    43	    public function getWaitingNumberByStatus(int $status, int $baseInfoId): mixed
    44	    {
    45	        return $this->createQueryBuilder('wn')
    46	            ->select('wn')
    47	            ->join(Order::class, 'o', 'WITH', 'wn.orderId = o.id AND o.OrderStatus = :statusId')
    48	            ->setParameter('statusId', $status)
    49	            ->andWhere('IDENTITY(wn.BaseInfo) = :baseInfoId')
    50	            ->setParameter('baseInfoId', $baseInfoId)
    51	            ->orderBy('wn.waitingNumber', 'ASC')
    52	            ->getQuery()
    53	            ->getResult();
    54	    }
    55	}

