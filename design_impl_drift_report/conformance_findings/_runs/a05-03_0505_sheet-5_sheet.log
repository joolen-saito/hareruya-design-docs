    32	    function summerizeNumber(start, end) {
    33	        if (start === end) {
    34	            return start;
    35	        } else {
    36	            return start + '~' + end;
    37	        }
    38	    }
    39	
    40	    // 注文番号リストを指定サイズ内に整形
    41	    function shapingList(waitingList) {
    42	        // 規定サイズの設定
    43	        const limitSize = {{ eccube_config.waiting_monitor_max_size }};
    44	
    45	        if (waitingList.length <= limitSize) {
    46	            return waitingList;
    47	        }
    48	
    49	        let shapedList = []; // 修正後リスト
    50	        let start = null; // 連続開始の数字
    51	        let end = null;   // 連続終了の数字
    52	        for (let i=0; i < waitingList.length; ++i) {
    53	            const latestNumber = waitingList[i];
    54	
    55	            // 数値の場合
    56	            if (typeof(latestNumber) === 'number') {
    57	                if (start === null) {
    58	                    start = end = latestNumber;
    59	
    60	                    continue;
    61	                }
    62	
    63	                if (latestNumber === end + 1) {
    64	                    end = latestNumber;
    65	
    66	                    continue;
    67	                }
    68	
    69	                shapedList.push(summerizeNumber(start, end));
    70	                start = end = latestNumber;
    71	            }
    72	
    73	            // アルファベットの場合
    74	            if (typeof(latestNumber) === 'string') {
    75	                // 数字の記録が残っている場合
    76	                if (start !== null) {
    77	                    shapedList.push(summerizeNumber(start, end));
    78	                    start = end = null;
    79	                }
    80	                shapedList.push(latestNumber);
    81	            }
    82	        }
    83	
    84	        // 最後に残っている数値を修正後リストに追加(数字のみかつアルファベットがない場合に発生)
    85	        if (start !== null) {
    86	            shapedList.push(summerizeNumber(start, end));
    87	        }
    88	
    89	        return shapedList;
    90	    }
