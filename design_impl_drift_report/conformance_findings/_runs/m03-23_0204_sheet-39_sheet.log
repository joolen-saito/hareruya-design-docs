    29	use Knp\Component\Pager\PaginatorInterface;
    30	use Symfony\Bridge\Twig\Attribute\Template;
    31	use Symfony\Component\HttpFoundation\RedirectResponse;
    32	use Symfony\Component\HttpFoundation\Request;
    33	use Symfony\Component\HttpFoundation\StreamedResponse;
    34	use Symfony\Component\Routing\Attribute\Route;
    35	use Symfony\Component\Security\Csrf\CsrfTokenManagerInterface;
    36	
    37	/**
    38	 * 買取/販売価格履歴
    39	 */
    40	class BuySalePriceHistoryController extends AbstractController
    41	{
    42	    use SearchControllerTrait;
    43	
    44	    /** CSV ヘッダ（一覧画面の列順に合わせる） */
    45	    public const EXPORT_HEADER = [
    46	        '商品コード',
    47	        '言語',
    48	        '商品名',
    49	        '状態',
    50	        '変更前基準価格',
    51	        '変更後基準価格',
    52	        '変更前販売価格',
    53	        '変更後販売価格',
    54	        '変更前買取価格',
    55	        '変更後買取価格',
    56	        '登録日',
    57	        '登録者',
    58	    ];
    59	
    60	    public function __construct(
    61	        protected PageMaxRepository $pageMaxRepository,
    62	        protected EccubeConfig $eccubeConfig,
    63	        protected PaginatorInterface $paginator,
    64	        private readonly DtbPriceHistoryRepository $priceHistoryRepository,
    65	        protected CsrfTokenManagerInterface $csrfTokenManager,
    66	        private readonly CsvExportService $csvExportService,
    67	    ) {
    68	        $this->sessionKey = 'product.buy_sale_price_history';
    69	        $this->formType = BuySalePriceHistorySearchType::class;
    70	        $this->formName = 'admin_product_buy_sale_price_history';
    71	        $this->repository = $priceHistoryRepository;
    72	    }
    73	
    74	    /**
    75	     * 表示件数: 10,50,100,300,500,1000,2000,10000,12000（デフォルト10は eccube_default_page_count）
    76	     *
    77	     * @return list<PageMax>
    78	     */
    79	    protected function getPageMaxisForSearch(): array
    80	    {
    81	        $choices = [10, 50, 100, 300, 500, 1000, 2000, 10000, 12000];
    82	        $pageMaxis = [];
    83	        foreach ($choices as $i => $value) {
    84	            $pageMax = new PageMax();
    85	            $pageMax->setId($i + 1);
    86	            $pageMax->setName((string) $value);
    87	            $pageMax->setSortNo($i);
    88	            $pageMaxis[] = $pageMax;
    89	        }
    90	
    91	        return $pageMaxis;
    92	    }
    93	
    94	    /**
    95	     * 買取/販売価格履歴 一覧・検索
    96	     *
    97	     * GET  `/buy_sale_price_history` … 検索フォームのみ（結果なし）
    98	     * POST `/buy_sale_price_history` … 検索実行（1 ページ目）
    99	     * GET/POST `/buy_sale_price_history/search/{page_no}` … ページング・他画面からの遷移（product_id / code）
   100	     *
   101	     * @return array<string, mixed>
   102	     */
   103	    #[Route(path: '/%eccube_admin_route%/product/buy_sale_price_history', name: 'admin_product_buy_sale_price_history', defaults: ['page_no' => 0], methods: ['GET', 'POST'])]
   104	    #[Route(path: '/%eccube_admin_route%/product/buy_sale_price_history/search/{page_no}', name: 'admin_product_buy_sale_price_history_search', requirements: ['page_no' => '\d+'], defaults: ['page_no' => 1], methods: ['GET', 'POST'])]
   105	    #[Template(template: '@admin/Product/buy_sale_price_history.twig')]
   106	    public function index(Request $request, PaginatorInterface $paginator, int $page_no = 0): array
   107	    {
   108	        if ($page_no > 0) {
   109	            return $this->indexPagedSearch($request, $page_no);
   110	        }
   111	
   112	        if ($request->isMethod(Request::METHOD_GET)) {
   113	            return $this->indexInitialForm();
   114	        }
   115	
   116	        return $this->search($request);
   117	    }
   118	
   119	    /**
   120	     * ページ付き URL（/search/{page_no}）: 一覧表示・ページング。クエリの product_id / code をセッション検索文脈にマージしてから検索する。
   121	     *
   122	     * @return array<string, mixed>
   123	     */
   124	    private function indexPagedSearch(Request $request, int $page_no): array
   125	    {
   126	        $this->mergeProductContextFromQueryIntoSession($request);
   127	
   128	        return $this->search($request, null, $page_no);
   129	    }
   130	
   131	    /**
   132	     * 他画面からの遷移用: クエリの product_id / code をセッションの検索ビュー用データに取り込む。
   133	     */
   134	    private function mergeProductContextFromQueryIntoSession(Request $request): void
   135	    {
   136	        if (!$request->query->has('product_id') && !$request->query->has('code')) {
   137	            return;
   138	        }
   139	
   140	        $session = $request->getSession();
   141	        $viewKey = "eccube.admin.{$this->sessionKey}.search";
   142	        $viewData = $session->get($viewKey) ?? [];
   143	        if ($request->query->has('product_id')) {
   144	            $viewData['product_id'] = $request->query->get('product_id');
   145	        }
   146	        if ($request->query->has('code')) {
   147	            $viewData['code'] = $request->query->get('code');
   148	        }
   149	        $session->set($viewKey, $viewData);
   150	    }
   151	
   152	    /**
   153	     * GET のみ: 初回表示（検索結果なし・フォームのみ）。
   154	     *
   155	     * @return array<string, mixed>
   156	     */
   157	    private function indexInitialForm(): array
   158	    {
   159	        $form = $this->createForm(BuySalePriceHistorySearchType::class);
   160	
   161	        return [
   162	            'searchForm' => $form->createView(),
   163	            'pagination' => null,
   164	            'pageMaxis' => $this->getPageMaxisForSearch(),
   165	            'page_count' => (string) $this->eccubeConfig->get('eccube_default_page_count'),
   166	        ];
   167	    }
   168	
   169	    /**
   170	     * 検索QueryBuilder（SearchControllerTraitのgetQueryBuilderをオーバーライド）
   171	     *
   172	     * @param array{searchData: array<string, mixed>} $args
   173	     */
   174	    protected function getQueryBuilder(array $args): QueryBuilder
   175	    {
   176	        return $this->priceHistoryRepository->getQueryBuilderBySearchData($args['searchData']);
   177	    }
   178	
   179	    /**
   180	     * 買取/販売価格履歴 CSVエクスポート
   181	     */
   182	    #[Route(path: '/%eccube_admin_route%/product/buy_sale_price_history/export', name: 'admin_product_buy_sale_price_history_export', methods: ['GET'])]
   183	    public function export(Request $request): StreamedResponse|RedirectResponse
   184	    {
   185	        $session = $request->getSession();
   186	        $viewKey = "eccube.admin.{$this->sessionKey}.search";
   187	        $viewData = $session->get($viewKey);
   188	        if ($viewData === null) {
   189	            $this->addError('検索条件を指定してからCSVをダウンロードしてください。', 'admin');
   190	
   191	            return $this->redirectToRoute('admin_product_buy_sale_price_history');
   192	        }
   193	
   194	        set_time_limit(0);
   195	
   196	        // ストリーム開始後はセッションが閉じられることがあるため、Query はコールバック外で組み立てる
   197	        $qb = $this->getQueryBuilderForExport($request);
   198	
   199	        $response = new StreamedResponse();
   200	        $response->setCallback(function () use ($qb): void {
   201	            $this->csvExportService->fopen();
   202	            $this->csvExportService->fputcsv(self::EXPORT_HEADER);
   203	
   204	            $query = $qb->getQuery();
   205	            foreach ($query->toIterable() as $ph) {
   206	                $this->csvExportService->fputcsv($this->buildPriceHistoryCsvRow($ph));
   207	            }
   208	
   209	            $this->csvExportService->fclose();
   210	        });
   211	
   212	        $now = new \DateTime();
   213	        $filename = 'buy_sale_price_'.$now->format('YmdHis').'.csv';
   214	        $response->headers->set('Content-Type', 'application/octet-stream');
   215	        $response->headers->set('Content-Disposition', 'attachment; filename='.$filename);
   216	
   217	        return $response;
   218	    }
   219	
   220	    /**
   221	     * セッションの検索ビューデータから QueryBuilder を構築（一覧検索と同一条件）。
   222	     */
   223	    private function getQueryBuilderForExport(Request $request): QueryBuilder
   224	    {
   225	        $session = $request->getSession();
   226	        $viewKey = "eccube.admin.{$this->sessionKey}.search";
   227	        $viewData = $session->get($viewKey) ?? [];
   228	
   229	        $builder = $this->formFactory->createBuilder(BuySalePriceHistorySearchType::class, null, [
   230	            'csrf_protection' => false,
   231	        ]);
   232	        $searchForm = $builder->getForm();
   233	        $searchData = FormUtil::submitAndGetData($searchForm, $viewData);
   234	
   235	        // addSelect で関連を増やすと ORM 3 の toIterable() の行形状が変わり得るため、ルート ph のみ（N+1 は許容）
   236	        return $this->priceHistoryRepository->getQueryBuilderBySearchData($searchData);
   237	    }
   238	
   239	    /**
   240	     * @return list<string|int>
   241	     */
   242	    private function buildPriceHistoryCsvRow(DtbPriceHistory $ph): array
   243	    {
   244	        $pc = $ph->getProductClass();
   245	        $Product = $pc->getProduct();
   246	        $languageName = $pc->getLanguage() !== null ? $pc->getLanguage()->getNameJp() : '';
   247	        $conditionCell = $pc->getMemo() !== null && $pc->getMemo() !== ''
   248	            ? $pc->getMemo()
   249	            : ($pc->getCardCondition() !== null ? (string) $pc->getCardCondition()->getCode() : '');
   250	        $memberName = $ph->getMember() !== null ? $ph->getMember()->getName() : '';
   251	
   252	        return [
   253	            (string) ($pc->getCode() ?? ''),
   254	            $languageName,
   255	            $Product->getName(),
   256	            $conditionCell,
   257	            $this->nullableIntToCsvCell($ph->getOldStandardPrice()),
   258	            $this->nullableIntToCsvCell($ph->getStandardPrice()),
   259	            $this->nullableIntToCsvCell($ph->getOldSellPrice()),
   260	            $this->nullableIntToCsvCell($ph->getSellPrice()),
   261	            $this->nullableIntToCsvCell($ph->getOldBuyPrice()),
   262	            $this->nullableIntToCsvCell($ph->getBuyPrice()),
   263	            $ph->getCreateDate()->format('Y/m/d H:i'),
   264	            $memberName,
   265	        ];
   266	    }
   267	
   268	    private function nullableIntToCsvCell(?int $value): string
   269	    {
   270	        return $value === null ? '' : (string) $value;
   271	    }
   272	}

