   215	    /**
   216	     * 在庫/価格履歴検索の共通処理部
   217	     *
   218	     * @param QueryBuilder $qb
   219	     * @param array<string, mixed> $searchData
   220	     * @param array<string> $sortKeys
   221	     * @param string $alias
   222	     *
   223	     * @return void
   224	     */
   225	    public static function setProductHistoryQuery(QueryBuilder $qb, array $searchData, array $sortKeys, string $alias): void
   226	    {
   227	        $product = $searchData['product'] ?? [];
   228	
   229	        // 商品名(日/英)・ID・コード、カード名（SearchProductType の multi に合わせる。ps は JOIN していないため含めない）
   230	        $multi = $searchData['multi'] ?? null;
   231	        if (isset($multi) && StringUtil::isNotBlank($multi)) {
   232	            // 半角スペース、全角スペース、カンマで分割
   233	            $texts = preg_split('/[\s, ]+/u', $multi, -1, PREG_SPLIT_NO_EMPTY);
   234	            if ($texts) {
   235	                $qb->leftJoin('cd.Card', 'c');
   236	                $searchColumns = [
   237	                    'p' => ['name', 'name_en'],
   238	                    'pc' => ['code'],
   239	                    'c' => ['name_jp', 'name_en'],
   240	                ];
   241	                if ($alias === 'sh') {
   242	                    $searchColumns['sh'] = ['memo'];
   243	                } elseif ($alias === 'ph') {
   244	                    $searchColumns['p'][] = 'note';
   245	                }
   246	                SqlUtil::multiTextQuery($qb, $texts, $searchColumns, ['p', 'id']);
   247	            }
   248	        }
   249	        // category（SearchProductType は category_id を multiple にしているため ArrayCollection のこともある）
   250	        $category = $product['category_id'] ?? null;
   251	        if (!empty($category)) {
   252	            $categories = self::expandProductSearchCategories($category);
   253	            if ($categories !== []) {
   254	                $qb->distinct()->innerJoin('p.ProductCategories', 'pct', Join::WITH, $qb->expr()->in('pct.Category', ':categories'))
   255	                    ->setParameter('categories', $categories);
   256	            }
   257	        }
   258	
   259	        // product_satatus_id（フォームは ArrayCollection、セッション復元などでは配列のことがある）
   260	        $statusItems = self::collectionOrArrayToArray($product['status'] ?? null);
   261	        if ($statusItems !== []) {
   262	            $qb->andWhere($qb->expr()->in('p.Status', ':Status'))
   263	                ->setParameter('Status', $statusItems);
   264	        }
   265	
   266	        // cardset
   267	        $cardSetItems = self::collectionOrArrayToArray($product['cardset'] ?? null);
   268	        if ($cardSetItems !== []) {
   269	            $qb->andWhere($qb->expr()->in('cd.Cardset', ':cardset'))
   270	                ->setParameter('cardset', $cardSetItems);
   271	        }
   272	
   273	        // rarity
   274	        $rarityItems = self::collectionOrArrayToArray($product['rarity'] ?? null);
   275	        if ($rarityItems !== []) {
   276	            $qb->andWhere($qb->expr()->in('cd.Rarity', ':rarity'))
   277	                ->setParameter('rarity', $rarityItems);
   278	        }
   279	
   280	        // language（配列のほか ArrayCollection のこともある）
   281	        $languageItems = self::collectionOrArrayToArray($product['language'] ?? null);
   282	        if ($languageItems !== []) {
   283	            $languageIds = [];
   284	            $hasOther = false;
   285	            foreach ($languageItems as $lang) {
   286	                $id = is_object($lang) ? (int) $lang->getId() : (int) $lang;
   287	                if ($id === MtbLanguage::NOT_JP_EN_LANG_ID) {
   288	                    $hasOther = true;
   289	                } else {
   290	                    $languageIds[] = $id;
   291	                }
   292	            }
   293	            $conds = [];
   294	            if ($languageIds !== []) {
   295	                $conds[] = $qb->expr()->in('IDENTITY(pc.Language)', ':languageIds');
   296	                $qb->setParameter('languageIds', $languageIds);
   297	            }
   298	            if ($hasOther) {
   299	                $conds[] = $qb->expr()->notIn('IDENTITY(pc.Language)', ':exceptLanguageIds');
   300	                $qb->setParameter('exceptLanguageIds', MtbLanguage::CONSTANT_LANG_IDS);
   301	            }
   302	            if ($conds !== []) {
   303	                $qb->andWhere(new Orx($conds));
   304	            }
   305	        }
   306	
   307	        // card condition
   308	        $cardConditionItems = self::collectionOrArrayToArray($product['card_condition'] ?? null);
   309	        if ($cardConditionItems !== []) {
   310	            $cardConditionIds = array_map(
   311	                static fn ($item): int => is_object($item) ? (int) $item->getId() : (int) $item,
   312	                $cardConditionItems
   313	            );
   314	            $qb->andWhere($qb->expr()->in('IDENTITY(pc.CardCondition)', ':card_condition'))
   315	                ->setParameter('card_condition', $cardConditionIds);
   316	        }
   317	
   318	        // foil（複数選択時は IN。ArrayCollection / セッション配列にも対応）
   319	        $foilItems = self::collectionOrArrayToArray($product['foil'] ?? null);
   320	        if ($foilItems !== []) {
   321	            $foilCodes = array_values(array_unique(array_map(
   322	                static fn ($item): int => (int) $item,
   323	                $foilItems
   324	            )));
   325	            $qb->andWhere($qb->expr()->in('cd.foil_flg', ':foils'))
   326	                ->setParameter('foils', $foilCodes);
   327	        }
   328	
   329	        // promotion（SearchProductType ChoiceType は MtbPromotion の ID。cd.promotion_flg は MtbCardDetail 0/1）
   330	        $promotion = $product['promotion'] ?? null;
   331	        if (!empty($promotion) && is_array($promotion) && count($promotion) === 1) {
   332	            $raw = $promotion[0];
   333	            $promotionId = is_object($raw) && method_exists($raw, 'getId')
   334	                ? (int) $raw->getId()
   335	                : (int) $raw;
   336	            if ($promotionId === MtbPromotion::PROMOTION_ID) {
   337	                $qb->andWhere('cd.promotion_flg = :promotion')
   338	                    ->setParameter('promotion', MtbCardDetail::PROMOTION);
   339	            } elseif ($promotionId === MtbPromotion::NON_PROMOTION_ID) {
   340	                $qb->andWhere('cd.promotion_flg = :promotion')
   341	                    ->setParameter('promotion', MtbCardDetail::NON_PROMOTION);
   342	            }
   343	        }
   344	
   345	        // 日付From
   346	        $dateFrom = $searchData['date_from'] ?? null;
   347	        if (!empty($dateFrom) && $dateFrom instanceof \DateTimeInterface) {
   348	            $dateFromStr = $dateFrom->format('Y-m-d H:i:s');
   349	            $qb->andWhere("{$alias}.createDate >= :date_from")
   350	                ->setParameter('date_from', $dateFromStr);
   351	        }
   352	        // 日付To
   353	        $dateTo = $searchData['date_to'] ?? null;
   354	        if (!empty($dateTo)) {
   355	            $dateToStr = $dateTo->modify('+1 days')->format('Y-m-d H:i:s');
   356	            $qb->andWhere("{$alias}.createDate < :date_to")
   357	                ->setParameter('date_to', $dateToStr);
   358	        }
   359	
   360	        // Order By

