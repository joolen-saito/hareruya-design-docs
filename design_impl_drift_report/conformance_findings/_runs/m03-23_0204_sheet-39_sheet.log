   366	    /**
   367	     * Query#getSQL() のプレースホルダに設定するパラメータを返す。
   368	     *
   369	     * @param Query<mixed, mixed> $query DQL クエリ
   370	     *
   371	     * @return array<mixed> クエリパラメータ
   372	     */
   373	    public static function getIndexedSQLParameter(Query $query): array
   374	    {
   375	        $source = $query->getParameters();
   376	        if ($source->isEmpty()) {
   377	            return [];
   378	        }
   379	
   380	        $dql = $query->getDQL();
   381	        $matches = [];
   382	        preg_match_all('/:(\\w+)/', $dql, $matches, PREG_PATTERN_ORDER);
   383	        $dqlParamNames = $matches[1];
   384	
   385	        $paramMap = [];
   386	        foreach ($source->getIterator() as $param) {
   387	            $paramMap[$param->getName()] = $param->getValue();
   388	        }
   389	
   390	        $indexedParams = [];
   391	        foreach ($dqlParamNames as $dqlName) {
   392	            if (isset($paramMap[$dqlName])) {
   393	                $indexedParams[] = $paramMap[$dqlName];
   394	            }
   395	        }
   396	
   397	        return $indexedParams;
   398	    }
