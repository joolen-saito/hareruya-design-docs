   191	    #[Route(path: '/%eccube_admin_route%/order/export/order', name: 'admin_order_export_for_input', methods: ['GET', 'POST'])]
   192	    public function exportForInput(Request $request)
   193	    {
   194	        // タイムアウトを無効にする
   195	        set_time_limit(0);
   196	        // SQL Loggerを無効にする
   197	        $em = $this->entityManager;
   198	        $em->getConfiguration()->setSQLLogger(null);
   199	        // 注文情報IDを取得する
   200	        $rawOrderIds = $request->get('order_ids', []);
   201	        if (!is_array($rawOrderIds) || empty($rawOrderIds)) {
   202	            $this->addError('admin.common.select', 'admin');
   203	
   204	            $referer = $request->headers->get('referer');
   205	            if ($referer !== null && $referer !== '') {
   206	                return $this->redirect($referer);
   207	            }
   208	
   209	            return $this->redirectToRoute('admin_order');
   210	        }
   211	        $orderIdList = array_keys($rawOrderIds);
   212	
   213	        // CSVを出力する
   214	        try {
   215	            $response = $this->orderCsv->exportCsv($orderIdList);
   216	        } catch (\RuntimeException $e) {
   217	            $this->addError($e->getMessage(), 'admin');
   218	
   219	            $referer = $request->headers->get('referer');
   220	            if ($referer !== null && $referer !== '') {
   221	                return $this->redirect($referer);
   222	            }
   223	
   224	            return $this->redirectToRoute('admin_order');
   225	        }
   226	
   227	        return $response;
   228	    }
