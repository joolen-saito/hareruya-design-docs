namespace Eccube\Form\Type\Admin;

use Doctrine\ORM\EntityRepository;
use Eccube\Entity\BaseInfo;
use Symfony\Bridge\Doctrine\Form\Type\EntityType;
use Symfony\Component\Form\AbstractType;
use Symfony\Component\Form\Extension\Core\Type\DateType;
use Symfony\Component\Form\Extension\Core\Type\TextType;
use Symfony\Component\Form\FormBuilderInterface;
use Symfony\Component\Form\FormError;
use Symfony\Component\Form\FormEvent;
use Symfony\Component\Form\FormEvents;
use Symfony\Component\OptionsResolver\OptionsResolver;
use Symfony\Component\Validator\Constraints\Range;

class EntryRegisterSearchType extends AbstractType
{
    #[\Override]
    public function buildForm(FormBuilderInterface $builder, array $options): void
    {
        $builder
            ->add('multi', TextType::class, [
                'label' => 'admin.event.multi',
                'required' => false,
            ])
            ->add('base_info', EntityType::class, [
                'class' => BaseInfo::class,
                'label' => 'admin.event.base_info',
                'required' => false,
                'multiple' => true,
                'expanded' => false,
                'placeholder' => 'common.select__unspecified',
                'choice_label' => 'shopName',
                'data' => $options['base_info_default'] ?? [],
                'query_builder' => fn (EntityRepository $er) => $er->createQueryBuilder('b')
                    ->orderBy('b.id', 'ASC'),
            ])
            ->add('start_date_from', DateType::class, [
                'label' => 'admin.event.start_date_from',
                'required' => false,
                'input' => 'datetime',
                'widget' => 'single_text',
                'data' => (new \DateTime())->setTime(0, 0),
                'constraints' => [
                    new Range([
                        'min' => '1900-01-01',
                        'minMessage' => 'form_error.out_of_range',
                    ]),
                ],
                'attr' => [
                    'class' => 'datetimepicker-input',
                    'data-target' => '#'.$this->getBlockPrefix().'_start_date_from',
                    'data-toggle' => 'datetimepicker',
                ],
            ])
            ->add('start_date_to', DateType::class, [
                'label' => 'admin.event.start_date_to',
                'required' => false,
                'input' => 'datetime',
                'widget' => 'single_text',
                'constraints' => [
                    new Range([
                        'min' => '1900-01-01',
                        'minMessage' => 'form_error.out_of_range',
                    ]),
                ],
                'attr' => [
                    'class' => 'datetimepicker-input',
                    'data-target' => '#'.$this->getBlockPrefix().'_start_date_to',
                    'data-toggle' => 'datetimepicker',
                ],
            ])
            ->addEventListener(FormEvents::POST_SUBMIT, function (FormEvent $event): void {
                $form = $event->getForm();

                $startDateFrom = $form['start_date_from']->getData();
                $startDateTo = $form['start_date_to']->getData();

                if (!empty($startDateFrom) && !empty($startDateTo)) {
                    if ($startDateFrom > $startDateTo) {
                        $form['start_date_to']->addError(new FormError(trans('admin.common.date_range_error')));
                    }
                }
            })
        ;
    }

    #[\Override]
    public function configureOptions(OptionsResolver $resolver): void
    {
        $resolver->setDefaults([
            'base_info_default' => [],
        ]);
        $resolver->setAllowedTypes('base_info_default', 'array');
    }

    #[\Override]
    public function getBlockPrefix(): string
    {
        return 'admin_search_event';
    }
}

