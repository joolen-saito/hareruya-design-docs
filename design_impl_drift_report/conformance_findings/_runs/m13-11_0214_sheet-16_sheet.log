namespace Eccube\Service\Admin\Event;

use Eccube\Entity\DtbEvent;
use Knp\Component\Pager\Pagination\PaginationInterface;
use Knp\Component\Pager\PaginatorInterface;

class EntryRegistrationScheduleRowBuilder
{
    /**
     * @param iterable<DtbEvent>       $events
     * @param \DateTimeInterface|null $startDateFrom
     * @param \DateTimeInterface|null $startDateTo
     *
     * @return list<array<string, mixed>>
     */
    public function expandScheduleRows(iterable $events, ?\DateTimeInterface $startDateFrom = null, ?\DateTimeInterface $startDateTo = null): array
    {
        $toExclusive = null;
        if ($startDateTo instanceof \DateTimeInterface) {
            $toExclusive = \DateTimeImmutable::createFromInterface($startDateTo)->modify('+1 day');
        }

        $allDatas = [];
        foreach ($events as $event) {
            $details = $event->getDetails()->filter(function ($d) use ($startDateFrom, $toExclusive) {
                if (!$d->getEntryFlg()) {
                    return false;
                }
                $start = $d->getStartDate();
                if ($startDateFrom instanceof \DateTimeInterface && $start < $startDateFrom) {
                    return false;
                }
                if ($toExclusive !== null && $start >= $toExclusive) {
                    return false;
                }

                return true;
            })->toArray();
            if ($details === []) {
                continue;
            }
            usort($details, fn ($a, $b) => $b->getId() <=> $a->getId());
            $rowSpan = count($details);
            $shop = $event->getBaseInfo()?->getShopName() ?? '';
            $formatNames = $event->getFormats()->map(fn ($f) => $f->getNameJp())->toArray();
            $baseInfo = $event->getBaseInfo();
            foreach ($details as $index => $detail) {
                $allDatas[] = [
                    'rowSpan' => $index === 0 ? $rowSpan : null,
                    'eventId' => $event->getId(),
                    'name' => $event->getNameJp().' '.$event->getNameEn(),
                    'shop' => $shop,
                    'formatNames' => $formatNames,
                    'startDate' => $detail->getStartDate(),
                    'eventDetailId' => $detail->getId(),
                    'baseInfo' => $baseInfo,
                    'baseInfoId' => $baseInfo?->getId(),
                ];
            }
        }

        return $allDatas;
    }

    /**
     * 日程行をページングし、ページ先頭でイベント単位の rowspan を付け直す
     *
     * @param list<array<string, mixed>> $allScheduleRows
     *
     * @return array{0: PaginationInterface<int, array<string, mixed>>, 1: list<array<string, mixed>>}
     */
    public function paginateWithRowSpanByEvent(PaginatorInterface $paginator, array $allScheduleRows, int $pageNo, int $perPage): array
    {
        $pagination = $paginator->paginate(
            $allScheduleRows,
            $pageNo,
            $perPage
        );

        $datas = [];
        $pageItems = iterator_to_array($pagination);
        $eventCountsOnPage = [];
        foreach ($pageItems as $item) {
            $eventId = $item['eventId'];
            $eventCountsOnPage[$eventId] = ($eventCountsOnPage[$eventId] ?? 0) + 1;
        }
        $eventFirstSeen = [];
        foreach ($pageItems as $item) {
            $eventId = $item['eventId'];
            $isFirst = !isset($eventFirstSeen[$eventId]);
            $eventFirstSeen[$eventId] = true;
            $datas[] = [
                'rowSpan' => $isFirst ? $eventCountsOnPage[$eventId] : null,
                'eventId' => $item['eventId'],
                'name' => $item['name'],
                'shop' => $item['shop'],
                'formatNames' => $item['formatNames'],
                'startDate' => $item['startDate'],
                'eventDetailId' => $item['eventDetailId'],
                'baseInfo' => $item['baseInfo'],
                'baseInfoId' => $item['baseInfoId'] ?? null,
            ];
        }

        return [$pagination, $datas];
    }
}
