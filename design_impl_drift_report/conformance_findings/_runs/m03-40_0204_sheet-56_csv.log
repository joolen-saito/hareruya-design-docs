   112	    private function initializeColumnDefinitions(): void
   113	    {
   114	        $this->productCodeColumn = ColumnDefinitions::productCode()->setRequired(true);
   115	        $this->shelfNumberIdColumn = ColumnDefinitions::shelfNumberId();
   116	    }
   117	
   118	    private function clearColumnDefinitions(): void
   119	    {
   120	        $this->productCodeColumn = null;
   121	        $this->shelfNumberIdColumn = null;
   122	    }
   123	
   124	    /**
   125	     * 商品コードが dtb_product_class にちょうど1件あるか検証する。
   126	     * 0件の場合は商品なしエラー、2件以上の場合は商品コード重複エラーで breakAll する。
   127	     */
   128	    private function validateProductCodeSingle(ReadCsvRowEvent $event): bool
   129	    {
   130	        $row = $event->getRow();
   131	        $productCode = (string) $this->productCodeColumn->getValue($row);
   132	        $count = $this->productClassRepository->countByProductCode($productCode);
   133	
   134	        if ($count === 0) {
   135	            $event->getMessageStore()
   136	                ->addProductNotExistsError(
   137	                    $row->getRowNumber(),
   138	                    $this->productCodeColumn->getLabel()
   139	                );
   140	            $event->breakAll();
   141	
   142	            return false;
   143	        }
   144	
   145	        if ($count >= 2) {
   146	            $event->getMessageStore()
   147	                ->addProductCodeDuplicatedError($row->getRowNumber(), $productCode);
   148	            $event->breakAll();
   149	
   150	            return false;
   151	        }
   152	
   153	        return true;
   154	    }
   155	
   156	    /**
   157	     * 棚番号名称の有無をチェックする。（空の場合はスキップ＝未設定でOK）
   158	     */
   159	    private function validateShelfNumberExists(ReadCsvRowEvent $event): bool
   160	    {
   161	        $row = $event->getRow();
   162	
   163	        $shelfNumberName = $this->shelfNumberIdColumn->getValue($row);
   164	        if ($shelfNumberName === null || $shelfNumberName === '') {
   165	            return true;
   166	        }
   167	
   168	        $ShelfNumber = $this->shelfNumberRepository->findOneByName((string) $shelfNumberName);
   169	        if ($ShelfNumber === null) {
   170	            $event->getMessageStore()
   171	                ->addMasterNotExistsError(
   172	                    $row->getRowNumber(),
   173	                    $this->shelfNumberIdColumn->getLabel(),
   174	                    (string) $shelfNumberName
   175	                );
   176	            $event->breakAll();
   177	
   178	            return false;
   179	        }
   180	
   181	        return true;
   182	    }
   183	
   184	    private function getShelfNumberIdFromRow(ReadCsvRowEvent $event): ?int
   185	    {
   186	        $name = $this->shelfNumberIdColumn->getValue($event->getRow());
   187	        if ($name === null || $name === '') {
   188	            return null;
   189	        }
   190	
   191	        $ShelfNumber = $this->shelfNumberRepository->findOneByName((string) $name);
   192	
   193	        return $ShelfNumber?->getId();
   194	    }
   195	
   196	    /**
   197	     * 棚番号を更新する。
   198	     *
   199	     * @param ReadCsvRowEvent $event イベント
   200	     * @param string $productCode 商品コード
   201	     */
   202	    private function persistShelfNumber(ReadCsvRowEvent $event, string $productCode): void
   203	    {
   204	        $shelfNumberId = $this->getShelfNumberIdFromRow($event);
   205	
   206	        $this->productClassRepository->replaceShelfNumber($productCode, $shelfNumberId);
   207	    }
   208	}

