   178	    /**
   179	     * 店舗選択（EntityType）のラベル文言を組み立てる。
   180	     */
   181	    private static function formatBaseInfoChoiceLabel(BaseInfo $BaseInfo): string
   182	    {
   183	        $label = trim(str_replace('晴れる屋', '', $BaseInfo->getShopName() ?? ''));
   184	
   185	        return $label !== '' ? $label : (string) ($BaseInfo->getShopName() ?? $BaseInfo->getShortNameJp());
   186	    }
   187	
   188	    /**
   189	     * 各スロットの sort_no が 1..N の順列であること（必須・重複なし）を検証する。
   190	     */
   191	    private function validateSortNumbers(FormEvent $event, int $slotCount): void
   192	    {
   193	        $form = $event->getForm();
   194	        $sortNoValues = [];
   195	        for ($slot = 1; $slot <= $slotCount; ++$slot) {
   196	            $fieldName = 'sort_no_'.$slot;
   197	            $sortNo = $form->get($fieldName)->getData();
   198	            if ($sortNo === null || $sortNo === '') {
   199	                $form->get($fieldName)->addError(new FormError(
   200	                    trans('admin.data.top_banner.sort_no_required', [], 'validators')
   201	                ));
   202	                continue;
   203	            }
   204	            if ($sortNo < 1 || $sortNo > $slotCount) {
   205	                $form->get($fieldName)->addError(new FormError(
   206	                    trans('admin.data.top_banner.sort_no_range', [], 'validators')
   207	                ));
   208	                continue;
   209	            }
   210	            $sortNoValues[(int) $sortNo][] = $fieldName;
   211	        }
   212	
   213	        foreach ($sortNoValues as $fieldNames) {
   214	            if (count($fieldNames) > 1) {
   215	                foreach ($fieldNames as $fieldName) {
   216	                    $form->get($fieldName)->addError(new FormError(
   217	                        trans('admin.data.top_banner.sort_no_duplicate', [], 'validators')
   218	                    ));
   219	                }
   220	            }
   221	        }
   222	    }
   223	}

