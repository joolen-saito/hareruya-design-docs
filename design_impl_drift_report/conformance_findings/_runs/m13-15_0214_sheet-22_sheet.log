   121	    #[Route(path: '/%eccube_admin_route%/event/banner/delete', name: 'admin_event_banner_delete', methods: ['DELETE'])]
   122	    public function delete(Request $request): RedirectResponse
   123	    {
   124	        $this->isTokenValid();
   125	        $Member = $this->getMember();
   126	        $htmlClass = $this->eventBannerStorage->normalizeNarrowHtmlClassQuery($request->query->get('htmlClass'));
   127	
   128	        $narrowBaseInfo = null;
   129	        if ($htmlClass !== null) {
   130	            $narrowBaseInfo = $this->baseInfoRepository->findByHtmlClassName($htmlClass);
   131	            if ($narrowBaseInfo === null) {
   132	                throw new NotFoundHttpException();
   133	            }
   134	            if (!$Member->isEditableShop($narrowBaseInfo)) {
   135	                $this->addError('admin.event.banner.delete_shop_not_permitted', 'admin');
   136	
   137	                return $this->redirectAfterBannerDelete($htmlClass);
   138	            }
   139	        }
   140	
   141	        $selectFile = $this->eventBannerStorage->normalizeObjectKey($request->query->get('select_file'));
   142	        if ($selectFile === null) {
   143	            return $this->redirectAfterBannerDelete($htmlClass);
   144	        }
   145	
   146	        if (!$this->eventBannerStorage->isObjectKeyUnderNarrowShop($narrowBaseInfo, $selectFile)) {
   147	            return $this->redirectAfterBannerDelete($htmlClass);
   148	        }
   149	
   150	        if (!$this->eventBannerStorage->canMemberDeleteObject($Member, $selectFile)) {
   151	            $this->addError('admin.event.banner.delete_shop_not_permitted', 'admin');
   152	
   153	            return $this->redirectAfterBannerDelete($htmlClass);
   154	        }
   155	
   156	        $this->eventBannerStorage->deleteObjectIfExists($selectFile);
   157	        $this->addSuccess('admin.common.delete_complete', 'admin');
   158	
   159	        return $this->redirectAfterBannerDelete($htmlClass);
   160	    }
