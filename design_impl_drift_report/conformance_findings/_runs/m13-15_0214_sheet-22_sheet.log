    92	{% block javascript %}
    93	    <script nonce="{{ csp_nonce }}">
    94	        $(function () {
    95	            $('form[name="top_banner_upload"]').on('submit', function (event) {
    96	                const $form = $(this);
    97	                const $fileInput = $form.find('input[type="file"]');
    98	                const $errorBox = $('#top-banner-upload-error');
    99	                if ($errorBox.length) {
   100	                    $errorBox.text('');
   101	                }
   102	                if ($fileInput.length && !$fileInput.val()) {
   103	                    if ($errorBox.length) {
   104	                        $errorBox.text('{{ 'admin.data.top_banner.upload_required'|trans }}');
   105	                    }
   106	                    event.preventDefault();
   107	                }
   108	            });
   109	
   110	            function copyString(textString) {
   111	                const $tmpAttr = $('<div></div>');
   112	                $tmpAttr.text(textString);
   113	                $tmpAttr.css({
   114	                    position: 'absolute',
   115	                    left: '-100%',
   116	                });
   117	                $('body').append($tmpAttr);
   118	                const selection = document.getSelection();
   119	                if (selection) {
   120	                    selection.removeAllRanges();
   121	                    selection.selectAllChildren($tmpAttr.get(0));
   122	                }
   123	                const copied = document.execCommand('copy');
   124	                $tmpAttr.remove();
   125	                if (!copied) {
   126	                    if (navigator.clipboard && navigator.clipboard.writeText) {
   127	                        navigator.clipboard.writeText(textString);
   128	                    } else {
   129	                        window.prompt('URL', textString);
   130	                    }
   131	                }
   132	                return copied;
   133	            }
   134	
   135	            $(document).on('click', '.js-copy-url', function (event) {
   136	                event.preventDefault();
   137	                const url = $(this).data('url');
   138	                if (!url) {
   139	                    return;
   140	                }
   141	                copyString(url);
   142	            });
   143	        });
   144	    </script>
