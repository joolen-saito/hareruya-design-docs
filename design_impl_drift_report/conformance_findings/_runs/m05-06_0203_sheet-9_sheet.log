  2088	    public function sendManualMailForBulk(Order $order, MailTemplate $template, string $body, array $content): void
  2089	    {
  2090	        $message = (new Email())
  2091	            ->subject($content['mail']['subject'])
  2092	            ->from(new Address($this->BaseInfo->getEmail01(), $this->BaseInfo->getShopName()))
