   434	                            // 受注データにない場合は, 受注明細を検索.
   435	                            $ExportCsvRow->setData($csvService->getData($Csv, $OrderItem));
   436	                        }
   437	                        if ($ExportCsvRow->isDataNull() && $Shipping = $OrderItem->getShipping()) {
   438	                            // 受注明細データにない場合は, 出荷を検索.
