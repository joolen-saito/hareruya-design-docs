   397	    protected function exportCsv(Request $request, int $csvTypeId, string $fileName): StreamedResponse
   398	    {
   399	        // タイムアウトを無効にする.
   400	        set_time_limit(0);
   401	
   402	        // sql loggerを無効にする.
   403	        $em = $this->entityManager;
