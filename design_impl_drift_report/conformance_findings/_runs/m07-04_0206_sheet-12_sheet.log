    34	    public function buildForm(FormBuilderInterface $builder, array $options): void
    35	    {
    36	        $fileNames = [];
    37	        if (!empty($options['baseFiles'])) {
    38	            $fileNames[] = MailTemplate::BASE_FILES[MailTemplate::BASE_NO_BASE];
    39	        }
    40	        foreach ($options['baseFiles'] as $baseFile) {
    41	            $fileNames[] = MailTemplate::BASE_FILES[$baseFile];
    42	        }
    43	        $fileNames = array_values(array_unique($fileNames));
    44	
    45	        $builder
    46	            ->add('template', MailTemplateType::class, [
    47	                'required' => true,
    48	                'mapped' => false,
    49	                'constraints' => [new Assert\NotBlank()],
    50	                'query_builder' => function (EntityRepository $er) use ($fileNames) {
    51	                    $qb = $er->createQueryBuilder('mt');
    52	                    $qb->where('mt.isAutoSend = false');
