    94	                            $BuyOrder,
    95	                            $MailTemplate,
    96	                            (string) $form->get('subject')->getData(),
    97	                            (string) $form->get('body')->getData(),
    98	                        );
    99	                        $this->mailService->sendManualPurchaseMail($input);
   100	                        $this->addSuccess('admin.order.mail_send_complete', 'admin');
   101	
