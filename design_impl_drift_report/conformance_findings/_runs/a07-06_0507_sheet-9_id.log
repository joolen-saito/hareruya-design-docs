    52	    private function initializeKey(): void
    53	    {
    54	        if ($this->jwtSecret === '') {
    55	            return;
    56	        }
    57	
    58	        $rawSecret = base64_decode($this->jwtSecret, true);
    59	        if ($rawSecret === false) {
