    27	use Symfony\Component\HttpFoundation\StreamedResponse;
    28	use Symfony\Component\Routing\Attribute\Route;
    29	
    30	class SalesAnalysisController extends AbstractController
    31	{
    32	    private const SESSION_KEY = 'eccube.admin.analysis.sales.search';
    33	
    34	    public function __construct(
    35	        private readonly OrderItemRepository $orderItemRepository,
    36	        private readonly SalesAnalysisCsvExporterService $salesAnalysisCsvExporterService,
    37	    ) {
    38	    }
    39	
    40	    /**
    41	     * @return array<string, mixed>
    42	     */
    43	    #[Route(path: '/%eccube_admin_route%/analysis/sales', name: 'admin_analysis_sales', methods: ['GET'])]
    44	    #[Template(template: '@admin/Analysis/sales.twig')]
    45	    public function index(): array
    46	    {
    47	        $searchForm = $this->createForm(SalesType::class);
    48	        $searchForm->get('store_sales_targets')->setData($this->resolveMemberShopIds());
    49	
    50	        return [
    51	            'searchForm' => $searchForm->createView(),
    52	            'searched' => false,
    53	            'summary' => null,
    54	            'total' => null,
    55	            'summaryType' => 'product_id',
    56	        ];
    57	    }
    58	
    59	    /**
    60	     * @return array<string, mixed>
    61	     */
    62	    #[Route(path: '/%eccube_admin_route%/analysis/sales/search', name: 'admin_analysis_sales_search', methods: ['POST'])]
    63	    #[Template(template: '@admin/Analysis/sales.twig')]
    64	    public function search(Request $request): array
    65	    {
    66	        $searchForm = $this->createForm(SalesType::class);
    67	        $searchForm->handleRequest($request);
    68	
    69	        if (!$searchForm->isSubmitted() || !$searchForm->isValid()) {
    70	            return [
    71	                'searchForm' => $searchForm->createView(),
    72	                'searched' => false,
    73	                'summary' => null,
    74	                'total' => null,
    75	                'summaryType' => 'product_id',
    76	            ];
    77	        }
    78	
    79	        $searchData = $searchForm->getData();
    80	        $this->session->set(self::SESSION_KEY, FormUtil::getViewData($searchForm));
    81	
    82	        $searchData['base_info_ids'] = $this->resolveTargetBaseInfoIds(
    83	            (bool) ($searchData['mail_order_enabled'] ?? false),
    84	            is_iterable($searchData['store_sales_targets'] ?? null) ? $searchData['store_sales_targets'] : []
    85	        );
    86	        $summary = $this->orderItemRepository->getAnalysisSummary($searchData);
    87	
    88	        return [
    89	            'searchForm' => $searchForm->createView(),
    90	            'searched' => true,
    91	            'summary' => $summary['result'],
    92	            'total' => $summary['total'],
    93	            'summaryType' => $searchData['summary_type'] ?? 'product_id',
    94	        ];
    95	    }
    96	
    97	    #[Route(path: '/%eccube_admin_route%/analysis/sales/export', name: 'admin_analysis_sales_export', methods: ['GET'])]
    98	    public function export(): StreamedResponse|RedirectResponse
    99	    {
   100	        $viewData = $this->session->get(self::SESSION_KEY);
   101	        if ($viewData === null) {
   102	            $this->addError('検索条件がありません。先に検索を実行してください。', 'admin');
   103	
   104	            return $this->redirectToRoute('admin_analysis_sales');
   105	        }
   106	
   107	        set_time_limit(0);
   108	        $this->entityManager->getConfiguration()->setSQLLogger(null);
   109	
   110	        $searchForm = $this->createForm(SalesType::class);
   111	        $searchData = FormUtil::submitAndGetData($searchForm, $viewData);
   112	        $searchData['base_info_ids'] = $this->resolveTargetBaseInfoIds(
   113	            (bool) ($searchData['mail_order_enabled'] ?? false),
   114	            is_iterable($searchData['store_sales_targets'] ?? null) ? $searchData['store_sales_targets'] : []
   115	        );
   116	
   117	        return $this->salesAnalysisCsvExporterService->exportBySearchData($searchData);
   118	    }
   119	
   120	    /**
   121	     * @param iterable<mixed> $storeSalesTargets
   122	     *
   123	     * @return list<int>
   124	     */
   125	    private function resolveTargetBaseInfoIds(bool $mailOrderEnabled, iterable $storeSalesTargets): array
   126	    {
   127	        $ids = [];
   128	        if ($mailOrderEnabled) {
   129	            $rootBaseInfoId = (int) $this->eccubeConfig->get('eccube_root_base_info_id');
   130	            $ids[$rootBaseInfoId] = $rootBaseInfoId;
   131	        }
   132	
   133	        foreach ($storeSalesTargets as $storeId) {
   134	            $id = (int) $storeId;
   135	            if ($id > 0) {
   136	                $ids[$id] = $id;
   137	            }
   138	        }
   139	
   140	        return array_values($ids);
   141	    }
   142	
   143	    /**
   144	     * @return list<int>
   145	     */
   146	    private function resolveMemberShopIds(): array
   147	    {
   148	        $Member = $this->getUser();
   149	        if (!$Member instanceof Member) {
   150	            return [];
   151	        }
   152	
   153	        $ids = [];
   154	        $baseInfoId = $Member->getBaseInfo()->getId();
   155	        if ($baseInfoId !== null) {
   156	            $ids[$baseInfoId] = $baseInfoId;
   157	        }
   158	
   159	        foreach ($Member->getMemberBaseInfos() as $MemberBaseInfo) {
   160	            $id = $MemberBaseInfo->getBaseInfo()->getId();
   161	            if ($id !== null) {
   162	                $ids[$id] = $id;
   163	            }
   164	        }
   165	
   166	        return array_values($ids);
   167	    }
   168	}

