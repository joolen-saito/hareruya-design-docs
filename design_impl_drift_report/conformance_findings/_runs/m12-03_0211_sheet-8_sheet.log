  2042	                <tr id="item-sheet-8-11"><td><a class="item-no" href="#pin-sheet-8-11">11</a></td><td>並び替え(並び順)</td><td>ラジオボックス</td><td>-</td><td></td><td>-</td><td>上記の並び替え(項目)の並び順を指定 選択肢:昇順・降順</td></tr>
  2043	                <tr id="item-sheet-8-12"><td><a class="item-no" href="#pin-sheet-8-12">12</a></td><td>件数</td><td>リストボックス</td><td>-</td><td></td><td>-</td><td>1ページに表示する件数<br>選択肢(赤文字は追加項目)<br>10,50,100,300,500,1000,2000,10000,12000,15000,20000</td></tr>
  2044	                <tr id="item-sheet-8-13"><td><a class="item-no" href="#pin-sheet-8-13">13</a></td><td>カテゴリ</td><td>リストボックス</td><td>-</td><td></td><td>-</td><td>集計したいカテゴリを指定</td></tr>
  2045	                <tr id="item-sheet-8-14"><td><a class="item-no" href="#pin-sheet-8-14">14</a></td><td>状態</td><td>チェックボックス</td><td>-</td><td></td><td>-</td><td>選択肢 : NM・SP・MP・HP</td></tr>
  2046	                <tr id="item-sheet-8-15"><td><a class="item-no" href="#pin-sheet-8-15">15</a></td><td>売上分析タグ</td><td>複数テキストボックス</td><td>-</td><td></td><td>-</td><td>商品管理 - 売上分析タグで登録されているデータから選択</td></tr>
  2047	                <tr id="item-sheet-8-16"><td><a class="item-no" href="#pin-sheet-8-16">16</a></td><td>カードセット</td><td>複数テキストボックス</td><td>-</td><td></td><td>-</td><td>カード管理 - カードセット管理で登録されているデータから選択</td></tr>
  2048	                <tr id="item-sheet-8-17"><td><a class="item-no" href="#pin-sheet-8-17">17</a></td><td>平均単価</td><td>数値</td><td>-</td><td></td><td>-</td><td></td></tr>
  2049	                <tr id="item-sheet-8-18"><td><a class="item-no" href="#pin-sheet-8-18">18</a></td><td>数量</td><td>数値</td><td>-</td><td></td><td>-</td><td></td></tr>
  2050	                <tr id="item-sheet-8-19"><td><a class="item-no" href="#pin-sheet-8-19">19</a></td><td>検索条件をクリア</td><td>リンク</td><td>-</td><td></td><td>-</td><td></td></tr>
  2051	                <tr id="item-sheet-8-20"><td><a class="item-no" href="#pin-sheet-8-20">20</a></td><td>検索ボタン</td><td>ボタン</td><td>-</td><td></td><td>-</td><td></td></tr>
  2052	              </tbody>
