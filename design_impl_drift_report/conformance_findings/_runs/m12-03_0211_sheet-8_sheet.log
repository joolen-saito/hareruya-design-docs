2931:                <tr><th>識別ID</th><th>ラベル</th><th>書式・制限</th><th>必須</th><th>最大値</th><th>初期値</th><th>画面部品の説明</th></tr>
2934:                <tr id="item-sheet-13-1"><td><a class="item-no" href="#pin-sheet-13-1">1</a></td><td>キーワード検索</td><td>テキストボックス</td><td>-</td><td></td><td>-</td><td>検索対象 : 商品名(日/英)・会員名</td></tr>
2935:                <tr id="item-sheet-13-2"><td><a class="item-no" href="#pin-sheet-13-2">2</a></td><td>検索枠表示・非表示ボタン</td><td>ボタン</td><td>-</td><td></td><td>-</td><td>検索枠(識別ID 3～13)の表示・非表示</td></tr>
