   172	     */
   173	    #[
   174	        Route(
   175	            path: '/%eccube_admin_route%/purchase/history/export',
   176	            name: 'admin_purchase_history_export',
   177	            methods: ['POST'],
   178	        ),
   179	    ]
   180	    public function export(Request $request): Response
   181	    {
   182	        set_time_limit(0);
   183	
   184	        $exportType = $request->request->get('export_type');
   185	
   186	        return match ($exportType) {
   187	            'check_export' => $this->exportByChecked($request),
   188	            'all_export' => $this->exportAll($request),
   189	            default => throw new \InvalidArgumentException('Invalid export type: '.$exportType),
   190	        };
   191	    }
   192	
   193	    private function exportByChecked(Request $request): StreamedResponse|RedirectResponse
   194	    {
   195	        $historyIds = $request->request->all('purchaseHistoryIds');
   196	
   197	        if (empty($historyIds)) {
   198	            $this->addError('1つ以上の商品を選択してください', 'admin');
   199	
   200	            $pageNo = $request->getSession()->get('eccube.admin.purchase_history.search.page_no', 1);
   201	
   202	            return $this->redirect($this->generateUrl('admin_purchase_history_page', ['page_no' => $pageNo]));
   203	        }
   204	
   205	        return $this->historyCsvExportService->exportByIds(
   206	            array_map('intval', $historyIds),
   207	        );
   208	    }
   209	
   210	    private function exportAll(Request $request): StreamedResponse|RedirectResponse
   211	    {
   212	        $session = $request->getSession();
   213	        $viewData = $session->get('eccube.admin.purchase_history.search');
   214	
   215	        if ($viewData === null) {
   216	            $this->addError('条件に一致する商品がありません', 'admin');
   217	
   218	            $pageNo = $request->getSession()->get('eccube.admin.purchase_history.search.page_no', 1);
   219	
   220	            return $this->redirect($this->generateUrl('admin_purchase_history_page', ['page_no' => $pageNo]));
   221	        }
   222	
   223	        $searchForm = $this->createForm(PurchaseHistoryType::class);
   224	        $searchData = FormUtil::submitAndGetData($searchForm, $viewData);
   225	
   226	        return $this->historyCsvExportService->exportBySearchData($searchData);
   227	    }
   228	}

