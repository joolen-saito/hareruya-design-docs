    59	
    60	    /**
    61	     * 買取商品履歴
    62	     *
    63	     * @return array<string, mixed>
    64	     */
    65	    #[
    66	        Route(
    67	            path: '/%eccube_admin_route%/purchase/history',
    68	            name: 'admin_purchase_history',
    69	            methods: ['GET', 'POST'],
    70	        ),
    71	    ]
    72	    #[
