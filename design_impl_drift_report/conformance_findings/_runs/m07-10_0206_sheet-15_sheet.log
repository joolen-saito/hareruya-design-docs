    81	    public function index(
    82	        Request $request,
    83	        PaginatorInterface $paginator,
    84	        int $page_no = 0,
    85	    ): array {
    86	        if ($page_no === 0) {
    87	            $page_no = $request->query->getInt('pageno', 0) ?: $request->query->getInt('page_no', 0);
    88	        }
    89	
    90	        // ページ番号が指定されている場合、セッションから検索条件を復元して指定のページを開く
    91	        if ($page_no > 0) {
    92	            $result = $this->search($request, null, $page_no);
    93	            $result['displayRows'] = $this->buildPurchaseHistoryDisplayRows($result);
    94	
    95	            return $result;
    96	        }
    97	
    98	        // GET: 初期表示（空の状態）
    99	        if ($request->isMethod('GET')) {
   100	            $form = $this->createForm(PurchaseHistoryType::class);
   101	
   102	            return [
   103	                'searchForm' => $form->createView(),
   104	                'pagination' => [],
   105	                'displayRows' => [],
   106	                'pageMaxis' => [],
   107	                'page_count' => $this->eccubeConfig['eccube_default_page_count'],
   108	            ];
   109	        }
   110	
   111	        // POST: 検索実行
   112	        $result = $this->search($request);
