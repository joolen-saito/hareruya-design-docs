   132	    /**
   133	     * 買取単価（小計 ÷ 数量）を算出
   134	     *
   135	     * 小数点以下は四捨五入。数量が0の場合は0を返す
   136	     */
   137	    public function getUnitCost(): int
   138	    {
   139	        if ($this->quantity === 0) {
   140	            return 0;
   141	        }
   142	
   143	        return (int) bcround(bcdiv((string) $this->subtotal, (string) $this->quantity, 8), 0);
   144	    }
   145	
   146	    /**
   147	     * 売却しない明細1行分の数量・査定小計を控除する（振込完了時の返却分）。
   148	     * 在庫数量が明細枚数より少ないときはデータ不整合として当該実在庫行を空にする。
   149	     * 永続化・削除は行わない。控除後に {@see getQuantity()} が 0 なら呼び出し元で EntityManager::remove する。
   150	     */
   151	    public function applyNotSaleLineDeduction(int $lineQuantity, int $lineSubtotal): void
   152	    {
   153	        if ($lineQuantity <= 0) {
   154	            throw new \InvalidArgumentException('lineQuantity must be positive');
   155	        }
   156	        if ($lineSubtotal < 0) {
   157	            throw new \InvalidArgumentException('lineSubtotal must not be negative');
   158	        }
   159	        $oldQty = $this->getQuantity();
   160	        if ($oldQty === 0) {
   161	            return;
   162	        }
   163	
   164	        if ($oldQty < $lineQuantity) {
   165	            $this->setQuantity(0);
   166	
   167	            return;
   168	        }
   169	
   170	        $newQty = $oldQty - $lineQuantity;
   171	        $newSubtotal = max(0, $this->getSubtotal() - $lineSubtotal);
   172	        $this->setQuantity($newQty);
   173	        $this->setSubtotal($newSubtotal);
   174	    }
