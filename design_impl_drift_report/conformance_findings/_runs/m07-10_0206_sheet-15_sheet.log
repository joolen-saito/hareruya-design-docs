   289	    /**
   290	     * エクスポート用のベースQueryBuilderを構築（一覧と同じソート順：振込完了日降順→注文日降順）
   291	     */
   292	    private function buildExportQueryBuilder(): QueryBuilder
   293	    {
   294	        $qb = $this->createQueryBuilder('bosh')
   295	            ->addSelect('bos')
   296	            ->addSelect('bo')
   297	            ->addSelect('m')
   298	            ->addSelect('pc')
   299	            ->addSelect('p')
   300	            ->addSelect('la')
   301	            ->join('bosh.BuyOrderStock', 'bos')
   302	            ->leftJoin('bosh.Member', 'm')
   303	            ->join('bos.BuyOrder', 'bo')
   304	            ->join('bos.ProductClass', 'pc')
   305	            ->join('pc.Product', 'p')
   306	            ->join('pc.Language', 'la');
   307	
   308	        $qb->setParameter('tcStatus', MtbBuyOrderStatus::TRANSFER_COMPLETE);
   309	        $tcSubQuery = '(SELECT MAX(bosh_tc_sort.createDate) FROM Eccube\Entity\DtbBuyOrderStatusHistory bosh_tc_sort WHERE bosh_tc_sort.BuyOrder = bo AND bosh_tc_sort.BuyOrderStatus = :tcStatus)';
   310	        $qb->addSelect($tcSubQuery.' AS HIDDEN transferCompleteDateSort');
   311	        $existsQuery = '(SELECT 1 FROM Eccube\Entity\DtbBuyOrderStatusHistory bosh_tc_null WHERE bosh_tc_null.BuyOrder = bo AND bosh_tc_null.BuyOrderStatus = :tcStatus)';
   312	        $qb->addSelect('CASE WHEN EXISTS '.$existsQuery.' THEN 0 ELSE 1 END AS HIDDEN transferCompleteDateNullLast');
   313	        $qb->addOrderBy('transferCompleteDateNullLast', 'ASC')
   314	            ->addOrderBy('transferCompleteDateSort', 'DESC')
   315	            ->addOrderBy('bo.orderDate', 'DESC');
   316	
   317	        return $qb;
   318	    }
