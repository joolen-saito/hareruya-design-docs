   118	    /**
   119	     * 一覧表示用の行データを組み立て
   120	     *
   121	     * @param array<string, mixed> $searchResult search() の戻り値
   122	     *
   123	     * @return list<array<string, mixed>>
   124	     */
   125	    private function buildPurchaseHistoryDisplayRows(array $searchResult): array
   126	    {
   127	        $pagination = $searchResult['pagination'] ?? null;
   128	        if ($pagination === null || $pagination->getTotalItemCount() === 0) {
   129	            return [];
   130	        }
   131	
   132	        $rows = [];
   133	        foreach ($pagination->getItems() as $history) {
   134	            if (!$history instanceof DtbBuyOrderStockHistory) {
   135	                continue;
   136	            }
   137	            $buyOrderStock = $history->getBuyOrderStock();
   138	            $buyOrder = $buyOrderStock->getBuyOrder();
   139	
   140	            $rows[] = [
   141	                'id' => $history->getId(),
   142	                'buy_order_id' => $buyOrder->getBuyOrderId(),
   143	                'customer_name' => $buyOrder->getLastName().' '.$buyOrder->getFirstName(),
   144	                'product_code' => $buyOrderStock->getProductClass()->getCode(),
   145	                'product_name' => '【'.$buyOrderStock->getProductClass()->getLanguage()->getCode().'】'.$buyOrderStock->getProductClass()->getProduct()->getName(),
   146	                'standard_price' => $buyOrderStock->getProductClass()->getStandardPrice(),
   147	                'buy_price' => $buyOrderStock->getUnitCost(),
   148	                'assessment_member_name' => $buyOrder->getMember()?->getName() ?? '',
   149	                'buy_quantity' => $buyOrderStock->getQuantity(),
   150	                'after_quantity' => $history->getAfterQuantity(),
   151	                'diff_quantity' => ($history->getAfterQuantity() ?? 0) - ($history->getBeforeQuantity() ?? 0),
   152	                'transfer_complete_date' => $this->stockHistoryRepository->getTransferCompleteDateForOrder($buyOrder),
   153	                'update_date' => $buyOrder->getUpdateDate(),
   154	            ];
   155	        }
   156	
   157	        return $rows;
   158	    }
