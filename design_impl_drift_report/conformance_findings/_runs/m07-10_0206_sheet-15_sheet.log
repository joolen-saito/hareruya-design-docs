   258	    /**
   259	     * 選択されたIDからCSVエクスポート用データを取得
   260	     *
   261	     * @param array<int, int> $historyIds
   262	     *
   263	     * @return iterable<array<string, mixed>>
   264	     */
   265	    public function getExportDataByIds(array $historyIds): iterable
   266	    {
   267	        $qb = $this->buildExportQueryBuilder();
   268	        $qb->andWhere($qb->expr()->in('bosh.id', ':historyIds'))
   269	            ->setParameter('historyIds', $historyIds);
   270	
   271	        return $this->mapExportRows($qb->getQuery()->getResult());
   272	    }
