   160	    /**
   161	     * @param array{searchData: array<string, scalar|array<scalar>|object|null>} $args
   162	     */
   163	    protected function getQueryBuilder(array $args): QueryBuilder
   164	    {
   165	        $searchData = HistorySearchDataDto::fromFormData($args['searchData']);
   166	
   167	        return $this->stockHistoryRepository->getQueryBuilderByHistorySearchData($searchData);
   168	    }
