   946	    /**
   947	     * @return array<int, array{product_name: string, product_code: string}>
   948	     */
   949	    public function getNoSectionProducts(\DateTime $summaryDate): array
   950	    {
   951	        // 集計区間
   952	        $from = clone $summaryDate;
   953	        $to = (clone $summaryDate)->modify('23:59:59');
   954	
   955	        // 部門未設定(null)の商品データ
   956	        $sql = <<<EOT
   957	            SELECT
   958	                p.name AS product_name,
   959	                pc.product_code AS product_code
