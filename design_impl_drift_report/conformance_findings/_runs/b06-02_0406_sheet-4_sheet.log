   970	            WHERE
   971	                AND obo.complete_date >= :from
   972	                AND obo.complete_date <= :to
   973	            UNION
   974	            SELECT
   975	                oboi.name AS product_name,
   976	                '' AS product_code
   977	            FROM
   978	                dtb_otc_buy_order obo
   979	            JOIN
   980	                dtb_otc_buy_order_indivisual_input_product oboi
   981	                ON oboi.otc_buy_order_id = obo.id
   982	                AND oboi.section_id IS NULL
   983	            WHERE
