    23	class BatchAggregateSummaryAction
    24	{
    25	    public function __construct(
    26	        private readonly DtbOtcBuyOrderRepository $otcBuyOrderRepository,
    27	        private readonly DtbOtcBuyOrderSummaryRepository $otcBuyOrderSummaryRepository,
    28	        private readonly MtbOptionRepository $mtbOptionRepository,
    29	        private readonly MailService $mailService,
    30	    ) {
    31	    }
    32	
    33	    /**
    34	     * バッチ用の集計実行。
    35	     * 集計完了後に部門未設定商品が存在する場合は通知メールを送信する。
    36	     * 集計処理で例外が発生した場合はエラー通知メールを送信して例外を再スローする。
    37	     *
    38	     * @throws \Exception 集計処理で例外が発生した場合
    39	     */
    40	    public function handle(\DateTime $summaryDate): void
    41	    {
    42	        try {
    43	            SummaryByDateAggregator::aggregate(
    44	                $summaryDate,
    45	                $this->otcBuyOrderRepository,
    46	                $this->otcBuyOrderSummaryRepository,
    47	                $this->mtbOptionRepository,
    48	            );
    49	
    50	            $noSectionProducts = $this->otcBuyOrderRepository->getNoSectionProducts($summaryDate);
    51	            if (!empty($noSectionProducts)) {
    52	                $this->mailService->sendNoSectionAlertMail($noSectionProducts);
    53	            }
    54	        } catch (\Exception $exception) {
    55	            $this->mailService->sendUpdateOtcBuyOrderSummaryErrorMail($exception->getMessage());
    56	
    57	            throw $exception;
    58	        }
    59	    }
    60	}

