    16	namespace Eccube\Service\Csv\Importer\Converter;
    17	
    18	use Eccube\Util\StringUtil;
    19	
    20	/**
    21	 * int の配列に変換する Converter 実装。
    22	 */
    23	class IntArrayConverter implements ConverterInterface
    24	{
    25	    /** @var string 区切り文字 */
    26	    private string $separator;
    27	
    28	    /**
    29	     * @param string $separator 区切り文字
    30	     */
    31	    public function __construct(string $separator = ',')
    32	    {
    33	        $this->separator = $separator;
    34	    }
    35	
    36	    /**
    37	     * @param string $value 変換する値
    38	     *
    39	     * @return array<int> 変換後の値
    40	     */
    41	    public function convert(string $value): array
    42	    {
    43	        if (StringUtil::isBlank($value)) {
    44	            return [];
    45	        }
    46	
    47	        return array_map(
    48	            function ($value) {
    49	                return (int) $value;
    50	            },
    51	            explode($this->separator, $value)
    52	        );
    53	    }
    54	}
