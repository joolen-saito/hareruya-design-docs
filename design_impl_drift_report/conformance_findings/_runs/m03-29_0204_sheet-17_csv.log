    21	use Eccube\Service\Csv\Importer\MessageStore;
    22	use Eccube\Service\Csv\Importer\Model\CsvValueInterface;
    23	use Eccube\Service\Csv\Importer\Validator\ValidatorInterface;
    24	use Eccube\Service\Csv\Importer\Validator\ValidatorTrait;
    25	
    26	/**
    27	 * 売上分析タグIDを検証する Validator 実装。
    28	 */
    29	class TagSalesAnalysisIdValidator implements ValidatorInterface
    30	{
    31	    use ValidatorTrait;
    32	
    33	    /** @var array<int, array<string, mixed>> 売上分析タグマスタの内容 */
    34	    private array $tagSalesAnalyses;
    35	
    36	    /**
    37	     * @param EntityManagerInterface $em
    38	     */
    39	    public function __construct(EntityManagerInterface $em)
    40	    {
    41	        $this->tagSalesAnalyses = $this->loadTagSalesAnalyses($em);
    42	    }
    43	
    44	    /**
    45	     * @param MessageStore $errors エラーメッセージの格納先
    46	     * @param CsvValueInterface $value 検証する値
    47	     *
    48	     * @return bool 値が正しい場合 true
    49	     */
    50	    public function validate(MessageStore $errors, CsvValueInterface $value): bool
    51	    {
    52	        if (!$value->hasValue()) {
    53	            // 未入力の場合はチェックしない
    54	            return true;
    55	        }
    56	
    57	        $validator = function ($v) {
    58	            return array_key_exists((int) $v, $this->tagSalesAnalyses);
    59	        };
    60	
    61	        if (!$value->validate($validator)) {
    62	            $errors->addMasterNotExistsError(
    63	                $value->getRowNumber(),
    64	                $value->getLabel(),
    65	                $value->getOriginalValue()
    66	            );
    67	
    68	            return false;
    69	        }
    70	
    71	        return true;
    72	    }
    73	
    74	    /**
    75	     * 売上分析タグマスタの内容を配列で返す。
    76	     *
    77	     * @param EntityManagerInterface $em
    78	     *
    79	     * @return array<int, array<string, mixed>> key: 売上分析タグID, value: 売上分析タグマスタの内容
    80	     */
    81	    private function loadTagSalesAnalyses(EntityManagerInterface $em): array
    82	    {
    83	        $sql = <<<EOT
    84	SELECT
    85	    id
    86	FROM
    87	    mtb_tag_sales_analysis
    88	EOT;
    89	
    90	        $rsm = new ResultSetMapping();
    91	        $rsm->addScalarResult('id', 'tagSalesAnalysisId', Types::INTEGER);
    92	
    93	        $query = $em->createNativeQuery($sql, $rsm);
    94	        $result = $query->getResult();
    95	
    96	        // key: 売上分析タグID, value: 売上分析タグマスタの内容 の配列に変換
    97	        $tagSalesAnalyses = [];
    98	        foreach ($result as $row) {
    99	            $tagSalesAnalyses[$row['tagSalesAnalysisId']] = $row;
   100	        }
   101	
   102	        return $tagSalesAnalyses;
   103	    }
   104	}

