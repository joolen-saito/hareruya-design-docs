    18	use Doctrine\ORM\EntityManagerInterface;
    19	use Eccube\Entity\DtbTagSort;
    20	use Eccube\Entity\Tag;
    21	use Eccube\Repository\DtbTagSortRepository;
    22	use Eccube\Repository\ProductClassRepository;
    23	use Symfony\Contracts\Translation\TranslatorInterface;
    24	
    25	class TagStoreAction
    26	{
    27	    public function __construct(
    28	        private readonly EntityManagerInterface $entityManager,
    29	        private readonly DtbTagSortRepository $tagSortRepository,
    30	        private readonly ProductClassRepository $productClassRepository,
    31	        private readonly TranslatorInterface $translator,
    32	    ) {
    33	    }
    34	
    35	    /**
    36	     * @param Tag $Tag
    37	     *
    38	     * @throws \Exception
    39	     */
    40	    public function handle(Tag $Tag): void
    41	    {
    42	        $this->entityManager->beginTransaction();
    43	
    44	        try {
    45	            $this->entityManager->persist($Tag);
    46	            $this->entityManager->flush();
    47	
    48	            $tagId = $Tag->getId();
    49	
    50	            $this->tagSortRepository->deleteByTagId($tagId);
    51	
    52	            $priorityCodes = explode("\r\n", (string) $Tag->getPriorityProducts());
    53	            $priorityCodes = array_filter($priorityCodes, fn ($code) => $code !== '');
    54	            $priorityCodes = array_unique($priorityCodes);
    55	
    56	            if (!empty($priorityCodes)) {
    57	                $ProductClass = $this->productClassRepository->getProductClassByCodeAndTag($priorityCodes, $tagId);
    58	                $codesCount = count($priorityCodes);
    59	
    60	                foreach ($priorityCodes as $index => $code) {
    61	                    if (!isset($ProductClass[$code])) {
    62	                        throw new \Exception($this->translator->trans('admin.error.not_exist_code', ['%code%' => $code, '%name%' => $Tag->getName()]));
    63	                    }
    64	
    65	                    $TagSort = new DtbTagSort();
    66	                    $TagSort->setProductClass($ProductClass[$code])
    67	                        ->setTagId($tagId)
    68	                        ->setRank($codesCount - $index);
    69	
    70	                    $this->entityManager->persist($TagSort);
    71	                }
    72	
    73	                $this->entityManager->flush();
    74	            }
    75	
    76	            $this->entityManager->commit();
    77	        } catch (\Exception $e) {
    78	            $this->entityManager->rollback();
    79	
    80	            throw $e;
    81	        }
    82	    }
    83	}

