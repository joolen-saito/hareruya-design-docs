use Symfony\Component\Routing\Attribute\Route;
use Symfony\Component\Security\Core\Exception\AuthenticationException;
use Symfony\Component\Security\Csrf\CsrfTokenManagerInterface;

/**
 * ネット買取管理
 */
class PurchaseController extends AbstractController
{
    use SearchControllerTrait {
        SearchControllerTrait::search as traitSearch;
    }

    /**
     * ソートは Repository で実施するため Knp Sortable を無効化
     *
     * @var array<string, mixed>
     */
    protected array $paginationOption = [
        'wrap-queries' => true,
        'sortFieldParameterName' => null,
        'sortDirectionParameterName' => null,
    ];

    protected PageMaxRepository $pageMaxRepository;

    public function __construct(
        PageMaxRepository $pageMaxRepository,
        protected \Eccube\Common\EccubeConfig $eccubeConfig,
        protected PaginatorInterface $paginator,
        protected DtbBuyOrderRepository $buyOrderRepository,
        protected DtbBuyMainCardRepository $buyMainCardRepository,
        protected DtbBuyOrderStatusHistoryRepository $buyOrderStatusHistoryRepository,
        protected DtbPlayerRepository $playerRepository,
        protected MtbBuyOrderStatusRepository $buyOrderStatusRepository,
        protected CsrfTokenManagerInterface $csrfTokenManager,
        protected PurchaseSearchAction $purchaseSearchAction,
        protected ProductRepository $productRepository,
        protected DtbBuyOrderStockRepository $buyOrderStockRepository,
        protected ProductClassRepository $productClassRepository,
        protected BuyOrderCsvExportService $BuyOrderCsvExportService,
        protected BuyOrderDepositCsvExportService $BuyOrderDepositCsvExportService,
        protected BuyOrderProductListCsvExportService $buyOrderProductListCsvExportService,
        protected BuyOrderRestockListCsvExportService $buyOrderRestockListCsvExportService,
        protected BuyOrderRestockListService $buyOrderRestockListService,
        protected RegisterIndividualStockAction $registerIndividualStockAction,
    ) {
        $this->pageMaxRepository = $pageMaxRepository;
    }

    /** 買取商品一覧CSV */
    private const CSV_EXPORT_PRODUCT_LIST_TYPE_SALE = 'sale';

    /** 買取商品一覧（キャンセル）CSV*/
    private const CSV_EXPORT_PRODUCT_LIST_TYPE_NOT_SALE = 'notSale';

    /**
     * 買取一覧ページを表示する
     *
     * @return array<string, mixed>
     */
    #[Route(path: '/%eccube_admin_route%/purchase/list', name: 'admin_purchase_list', methods: ['GET'])]
    #[Template(template: '@admin/Purchase/index.twig')]
    public function index(Request $request, PaginatorInterface $paginator, ?int $page_no = null): array
    {
        $builder = $this->formFactory->createBuilder(PurchaseListType::class);

        $searchForm = $builder->getForm();

        return [
            'searchForm' => $searchForm->createView(),
            'pagination' => [],
            'pageMaxis' => [],
            'page_no' => 1,
            'page_count' => $this->eccubeConfig->get('eccube_default_page_count'),
        ];
    }

    /**
     * 買取一覧検索
     *
     * @return array<string, mixed>
     */
    #[Route(path: '/%eccube_admin_route%/purchase/search', name: 'admin_purchase_search', methods: ['POST'])]
    #[Route(path: '/%eccube_admin_route%/purchase/page/{page_no}', name: 'admin_purchase_page', requirements: ['page_no' => '\d+'], methods: ['GET'])]
    #[Template(template: '@admin/Purchase/index.twig')]
    public function search(Request $request, ?int $patternId = null, ?int $page_no = null): array
    {
        $this->sessionKey = 'purchase';
        $this->formType = PurchaseListType::class;
        $this->formName = 'admin_purchase_list';
        $this->repository = $this->buyOrderRepository;
        $this->redirect = 'admin_purchase_list';

        $pageNo = $page_no ?? (int) $request->get('page_no', 1);

        // SearchControllerTraitのsearchメソッドを呼び出す
        $result = $this->traitSearch($request, $patternId, $pageNo);

        $result['sortKeys'] = array_keys($this->repository->getSortKeys());

        $pagination = $result['pagination'] ?? null;
        $BuyOrders = ($pagination && $pagination->getTotalItemCount() > 0) ? $pagination->getItems() : [];
        $result = array_merge($result, $this->purchaseSearchAction->handle($BuyOrders));

        return $result;
    }

    /**
     * 買取情報削除
     */
    #[Route(path: '/%eccube_admin_route%/purchase/{id}/delete', name: 'admin_purchase_delete', requirements: ['id' => '\d+'], methods: ['DELETE'])]
    public function delete(Request $request, int $id): RedirectResponse
    {
        $BuyOrder = $this->buyOrderRepository->find($id);
        if ($BuyOrder === null) {
            throw new NotFoundHttpException();
        }

        $this->isTokenValid();

        foreach ($BuyOrder->getBuyMainCards() as $BuyMainCard) {
            $this->entityManager->remove($BuyMainCard);
        }
        $this->entityManager->flush();

        $this->entityManager->remove($BuyOrder);
        $this->entityManager->flush();

        $this->addSuccess('admin.common.delete_complete', 'admin');

        return $this->redirectToPurchaseSearchResult($request);
    }

    /**
     * 買取情報詳細
     *
     * @return array<string, mixed>
     */
    #[Route(path: '/%eccube_admin_route%/purchase/{id}/edit', name: 'admin_purchase_edit', requirements: ['id' => '\d+'], methods: ['GET'])]
    #[Template(template: '@admin/Purchase/detail.twig')]
    public function edit(Request $request, int $id): array
    {
        $BuyOrder = $this->buyOrderRepository->find($id);
        if ($BuyOrder === null) {
            throw new NotFoundHttpException();
        }

        $viewData = $this->getDetailViewData($BuyOrder, $id);

        // 実在庫に関連する商品規格を取得する
        $stockProductClasses = array_merge(
            $this->productClassRepository->selectHighPriceProductClassByBuyOrder($BuyOrder),
            $this->productClassRepository->selectAllProductClassByBuyOrder($BuyOrder)
        );

        // 適格請求書発行事業者確認フラグが nullであればフォームで「未確認＝null」とする。
        // Note　移植元の仕様を維持。保存時にnullを維持するためと思われる
        $treatNullAsUnconfirmed = $BuyOrder->getQualifiedInvoiceIssuerConfirmationFlg() === null;
        $buyOrderStockForm = $this->formFactory->createBuilder(BuyOrderStockType::class, ['stockProductClasses' => $stockProductClasses])->getForm();
        $form = $this->formFactory->createBuilder(PurchaseDetailType::class, $BuyOrder, [
            'treatNullAsUnconfirmed' => $treatNullAsUnconfirmed,
            'original_buy_order_status_id' => $BuyOrder->getBuyOrderStatus()->getId(),
            'buy_order_stock_form' => $buyOrderStockForm,
        ])
            ->getForm();

        $searchProductModalForm = $this->formFactory->createBuilder(SearchProductType::class)->getForm();
        $stockSearchProductModalForm = $this->formFactory->createBuilder(SearchProductType::class)->getForm();

        $bankAccountForm = $this->formFactory->createBuilder(BankAccountType::class, $BuyOrder->getBankAccount())->getForm();

        $qualifiedInvoiceIssuerForm = $this->formFactory->createBuilder(
            QualifiedInvoiceIssuerAccountType::class,
            $BuyOrder->getQualifiedInvoiceIssuerAccount(),
            ['qualifiedInvoiceIssuerFlgForDisplay' => $BuyOrder->isQualifiedInvoiceIssuerFlg()]
        )->getForm();
        $qualifiedInvoiceIssuerForm->handleRequest($request);

        return array_merge($viewData, [
            'form' => $form->createView(),
    public function bulkDetailSell(Request $request, int $id): RedirectResponse
    {
        $BuyOrder = $this->buyOrderRepository->find($id);
        if ($BuyOrder === null) {
            throw new NotFoundHttpException();
        }

        $this->buyOrderRepository->updateBulkSell($id);

        return $this->redirectToRoute('admin_purchase_edit', ['id' => $id]);
    }

    /**
     * 買取情報CSV出力
     */
    #[Route(path: '/%eccube_admin_route%/purchase/csv_export', name: 'admin_purchase_csv_export', methods: ['POST'])]
    public function export(Request $request): Response
    {
        // タイムアウトを無効にする
        // Note: 移植元と同様に設定しておく
        set_time_limit(0);

        $buyOrderIds = $request->request->all('buyOrderIds');
        $buyOrderIds = array_filter(array_map('intval', $buyOrderIds));

        if ($buyOrderIds === []) {
            $this->addError($this->translator->trans('admin.purchase.online.csv_export.no_selection'), 'admin');

            return $this->redirectToPurchaseSearchResult($request);
        }

        try {
            return $this->BuyOrderCsvExportService->exportByIds($buyOrderIds);
        } catch (\RuntimeException $e) {
            $message = $this->translator->trans($e->getMessage());
            $this->addError($message, 'admin');

            return $this->redirectToPurchaseSearchResult($request);
        }
    }

    /**
     * 銀行入金CSV出力
     */
    #[Route(path: '/%eccube_admin_route%/purchase/csv_export_deposit', name: 'admin_purchase_csv_export_deposit', methods: ['POST'])]
    public function exportDeposit(Request $request): Response
    {
        // タイムアウトを無効にする
        // Note: 移植元と同様に設定しておく
        set_time_limit(0);

        $buyOrderIds = $request->request->all('buyOrderIds');
        $buyOrderIds = array_filter(array_map('intval', $buyOrderIds));

        if ($buyOrderIds === []) {
            $this->addError($this->translator->trans('admin.purchase.online.csv_export.no_selection'), 'admin');

            return $this->redirectToPurchaseSearchResult($request);
        }

        try {
            return $this->BuyOrderDepositCsvExportService->exportByIds($buyOrderIds);
        } catch (\RuntimeException $e) {
            $message = $this->translator->trans($e->getMessage());
            $this->addError($message, 'admin');

            return $this->redirectToPurchaseSearchResult($request);
        }
    }

    /**
     * 買取商品一覧CSV出力
     * （売却数・キャンセル数のいずれのCSVと共用。クエリ type=sale / type=notSale で切り替え）
     */
    #[Route(path: '/%eccube_admin_route%/purchase/csv_export_product_list', name: 'admin_purchase_csv_export_product_list', methods: ['POST'])]
    public function exportProductList(Request $request): Response
    {
        // タイムアウトを無効にする
        // Note: 移植元と同様に設定しておく
        set_time_limit(0);

        $buyOrderIds = $request->request->all('buyOrderIds');
        $buyOrderIds = array_filter(array_map('intval', $buyOrderIds));

        if ($buyOrderIds === []) {
            $this->addError($this->translator->trans('admin.purchase.online.csv_export.no_selection'), 'admin');

            return $this->redirectToPurchaseSearchResult($request);
        }

        $type = $request->query->get('type');
        switch ($type) {
            case self::CSV_EXPORT_PRODUCT_LIST_TYPE_SALE:
                $isSale = true;
                break;

            case self::CSV_EXPORT_PRODUCT_LIST_TYPE_NOT_SALE:
                $isSale = false;
                break;
            default:
                $this->addError('不正なCSV種別です', 'admin');

                return $this->redirectToPurchaseSearchResult($request);
        }

        try {
            return $this->buyOrderProductListCsvExportService->exportByIds($buyOrderIds, $isSale);
        } catch (\RuntimeException $e) {
            $message = $this->translator->trans($e->getMessage());
            $this->addError($message, 'admin');

            return $this->redirectToPurchaseSearchResult($request);
        }
    }

