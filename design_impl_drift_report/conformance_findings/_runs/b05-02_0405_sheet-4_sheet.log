  1788	     * スマレジ店舗ID(BaseInfo) = 設定済み
  1789	     * スマレジ店舗コード(BaseInfo) = 設定済み
  1790	     * スマレジ連携済みフラグ = 未連携
  1791	     * スマレジ在庫連携済みフラグ = 未連携
  1792	     * 注文ステータス = 注文受領・入金待ち・入金済み・ピック中・ピック済み
  1793	     *
  1794	     * @param \DateTime $targetDateTime
  1795	     *
  1796	     * @return array<Order>
  1797	     */
  1798	    public function findTargetOrdersForSmaregiPost(\DateTime $targetDateTime): array
  1799	    {
  1800	        $qb = $this->createQueryBuilder('o');
  1801	        $qb->select('o, bi')
  1802	            ->where('o.order_date < :targetDateTime')
  1803	            ->join('o.baseInfo', 'bi')
  1804	            ->andWhere('bi.smaregi_shop_id IS NOT NULL')
  1805	            ->andWhere('bi.smaregi_shop_code IS NOT NULL')
  1806	            ->join('o.Shippings', 's')
  1807	            ->andWhere('s.Delivery IN (:delivery)')
  1808	            ->setParameter('delivery', [Delivery::OTC, Delivery::SMOOTH_OTC])
  1809	            ->andWhere('o.smaregi_product_flg = false')
  1810	            ->andWhere('o.smaregi_stock_flg = false')
  1811	            ->andWhere('o.order_number IS NOT NULL')
  1812	            ->andWhere('o.OrderStatus IN (:orderStatus)')
  1813	            ->setParameter('targetDateTime', $targetDateTime)
  1814	            ->setParameter('orderStatus', [OrderStatus::NEW, OrderStatus::PAY_WAIT, OrderStatus::PAID, OrderStatus::PICKED, OrderStatus::PICKING]);
  1815	
  1816	        return $qb->getQuery()->getResult();
  1817	    }
