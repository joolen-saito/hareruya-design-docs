  1819	    /**
  1820	     * ポイント利用が反映されない決済を取得
  1821	     *
  1822	     * @return array<array{order_id: int}>
  1823	     */
  1824	    public function getNotReflectedPointsUsage(): array
  1825	    {
  1826	        $sql = <<<EOT
  1827	            SELECT o.id AS order_id
  1828	            FROM dtb_order o
  1829	            JOIN plg_sln_order_payment_status sln ON sln.order_id = o.id
  1830	            LEFT JOIN dtb_stockout_history soh ON soh.order_id = o.id
  1831	            WHERE o.total != o.payment_total
  1832	            AND o.order_number IS NOT NULL
  1833	            AND o.note IS NULL
  1834	            AND o.discount > 0
  1835	            AND soh.order_id IS NULL
  1836	            AND GREATEST(o.total, o.payment_total) != (o.discount + LEAST(o.total, o.payment_total))
  1837	            AND sln.amount::numeric = GREATEST(o.total, o.payment_total)
  1838	            AND o.payment_date BETWEEN NOW() - INTERVAL '1 hour' AND NOW()
  1839	            AND o.deleted_at IS NULL
  1840	            ORDER BY o.id DESC
  1841	            EOT;
  1842	
  1843	        $rsm = new ResultSetMapping();
  1844	        $rsm->addScalarResult('order_id', 'order_id', Types::INTEGER);
  1845	
  1846	        return $this->getEntityManager()->createNativeQuery($sql, $rsm)->getResult();
  1847	    }
