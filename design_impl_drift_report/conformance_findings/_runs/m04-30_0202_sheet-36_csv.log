    17	
    18	/**
    19	 * バーコード貼替リストCSVの1行整形
    20	 *
    21	 * 商品名は半角 [] で囲まれた略称タグの閉じ括弧までを出力し、それ以降（色・レアリティ等）を除去する。
    22	 */
    23	final class BarcodeReplacementListCsvRowFormatter
    24	{
    25	    /**
    26	     * @param iterable<array<string, mixed>> $rawRows
    27	     *
    28	     * @return \Generator<int, array<string, string>>
    29	     */
    30	    public function iterateFormattedRows(iterable $rawRows): \Generator
    31	    {
    32	        foreach ($rawRows as $row) {
    33	            yield $this->formatRow($row);
    34	        }
    35	    }
    36	
    37	    /**
    38	     * @param array<string, mixed> $row
    39	     *
    40	     * @return array<string, string>
    41	     */
    42	    public function formatRow(array $row): array
    43	    {
    44	        $isSupply = (bool) $row['isSupply'];
    45	        $standardPrice = $row['standardPrice'] !== null ? (int) $row['standardPrice'] : null;
    46	        $languageNameJp = (string) ($row['languageNameJp'] ?? '');
    47	        $conditionCode = (string) ($row['conditionCode'] ?? '');
    48	        $smaregiProductCode = (string) ($row['smaregiProductCode'] ?? '');
    49	
    50	        return [
    51	            'productName' => $this->formatProductName((string) ($row['rawProductName'] ?? '')),
    52	            'languageAndCondition' => $this->formatLanguageAndCondition($isSupply, $languageNameJp, $conditionCode),
    53	            'standardPrice' => $this->formatStandardPrice($standardPrice),
    54	            'smaregiProductId' => (string) ($row['smaregiProductId'] ?? ''),
    55	            'smaregiProductCode' => $smaregiProductCode,
    56	            'smaregiBarcode' => $this->formatSmaregiBarcode($smaregiProductCode, $standardPrice),
    57	        ];
    58	    }
    59	
    60	    /**
    61	     * 商品名を整形する
    62	     *
    63	     * []で囲まれた略称の後は出力しない
    64	     * 例) 入力: 【ネオンインク・Foil】(361)■ボーダーレス■《恐れを知らぬ者、カタラ/Katara, the Fearless》[TLA] 金R
    65	     *     出力: 【ネオンインク・Foil】(361)■ボーダーレス■《恐れを知らぬ者、カタラ/Katara, the Fearless》[TLA]
    66	     */
    67	    public function formatProductName(string $productName): string
    68	    {
    69	        $lastBracketClosePosition = strrpos($productName, ']');
    70	        if ($lastBracketClosePosition === false) {
    71	            return $productName;
    72	        }
    73	
    74	        return substr($productName, 0, $lastBracketClosePosition + 1);
    75	    }
    76	
    77	    /**
    78	     * 言語・状態を整形する
    79	     *
    80	     * 「言語・状態」の形式で返す。
    81	     * サプライ品の場合は「サプライ品」を返す。
    82	     */
    83	    private function formatLanguageAndCondition(bool $isSupply, string $languageNameJp, string $conditionCode): string
    84	    {
    85	        if ($isSupply) {
    86	            return 'サプライ品';
    87	        }
    88	
    89	        if ($languageNameJp === '' && $conditionCode === '') {
    90	            return '';
    91	        }
    92	
    93	        if ($languageNameJp === '') {
    94	            return $conditionCode;
    95	        }
    96	
    97	        if ($conditionCode === '') {
    98	            return $languageNameJp;
    99	        }
   100	
   101	        return $languageNameJp.'・'.$conditionCode;
   102	    }
   103	
   104	    /**
   105	     * 販売価格を #,###円 の形式で整形する
   106	     */
   107	    private function formatStandardPrice(?int $standardPrice): string
   108	    {
   109	        if ($standardPrice === null) {
   110	            return '';
   111	        }
   112	
   113	        return number_format($standardPrice).'円';
   114	    }
   115	
   116	    /**
   117	     * スマレジバーコードを整形する
   118	     *
   119	     * スマレジバーコードは「22」+ 商品コード（6桁）+ 販売価格（7桁）の形式で返す。
   120	     * それぞれ6桁・7桁に満たない場合は左0埋めする。
   121	     */
   122	    private function formatSmaregiBarcode(string $smaregiProductCode, ?int $standardPrice): string
   123	    {
   124	        if ($smaregiProductCode === '') {
   125	            return '';
   126	        }
   127	
   128	        $pricePart = $standardPrice !== null ? (string) $standardPrice : '0';
   129	
   130	        return '22'
   131	            .$this->formatFixedWidthPart($smaregiProductCode, 6)
   132	            .$this->formatFixedWidthPart($pricePart, 7);
   133	    }
   134	
   135	    /**
   136	     * 指定桁数に0埋めする。桁数超過時は下位桁を返す。
   137	     */
   138	    private function formatFixedWidthPart(string $value, int $length): string
   139	    {
   140	        if (strlen($value) > $length) {
   141	            return substr($value, -$length);
   142	        }
   143	
   144	        return str_pad($value, $length, '0', STR_PAD_LEFT);
   145	    }
   146	}

