   582	    /**
   583	     * バーコード貼替リストCSV出力用の行（iterateAssociative）
   584	     *
   585	     * 価格変更発生期間は dtb_price_history.create_date で絞り込む。
   586	     * 同一商品規格に期間内の履歴が複数ある場合は1行にまとめる（DISTINCT ON）。
   587	     * 出力順: 色の並び順昇順 → カードタイプの並び順昇順 → マナコスト(CMC)昇順 → 基準価格降順。
   588	     *
   589	     * @return iterable<int, array<string, mixed>>
   590	     */
   591	    public function iterateBarcodeReplacementListExportRows(
   592	        int $baseInfoId,
   593	        \DateTimeInterface $priceChangePeriodFrom,
   594	        \DateTimeInterface $priceChangePeriodTo,
   595	    ): iterable {
   596	        $connection = $this->getEntityManager()->getConnection();
   597	
   598	        $sql = <<<SQL
   599	            SELECT
   600	                barcode_rows."rawProductName",
   601	                barcode_rows."storageCodeName",
   602	                barcode_rows."languageCode",
   603	                barcode_rows."languageNameJp",
   604	                barcode_rows."conditionCode",
   605	                barcode_rows."standardPrice",
   606	                barcode_rows."smaregiProductId",
   607	                barcode_rows."smaregiProductCode",
   608	                barcode_rows."isSupply"
   609	            FROM (
   610	                SELECT DISTINCT ON (pc.id)
   611	                    pc.id AS product_class_id,
   612	                    p.name AS "rawProductName",
   613	                    sc.name AS "storageCodeName",
   614	                    lng.code AS "languageCode",
   615	                    lng.name_jp AS "languageNameJp",
   616	                    cond.code AS "conditionCode",
   617	                    pc.standard_price AS "standardPrice",
   618	                    pc.smaregi_product_id AS "smaregiProductId",
   619	                    pc.smaregi_product_code AS "smaregiProductCode",
   620	                    CASE WHEN EXISTS (
   621	                        SELECT 1 FROM dtb_product_category pcat
   622	                        WHERE pcat.product_id = p.id
   623	                          AND pcat.category_id IN (:goods_category_id, :reserved_goods_category_id)
   624	                    ) THEN 1 ELSE 0 END AS "isSupply",
   625	                    COALESCE(cs.sort_no, 99999) AS "colorSort",
   626	                    COALESCE(
   627	                        (
   628	                            SELECT MIN(ct.sort_no)
   629	                            FROM dtb_card_cardtype dcc
   630	                            INNER JOIN mtb_cardtype ct ON ct.id = dcc.cardtype_id
   631	                            WHERE dcc.card_id = c.id
   632	                        ),
   633	                        99999
   634	                    ) AS "cardTypeSort",
   635	                    COALESCE(c.cmc, 99999) AS "manaCostSort"
   636	                FROM dtb_price_history ph
   637	                INNER JOIN dtb_product_class pc ON pc.id = ph.product_class_id
   638	                INNER JOIN dtb_product p ON p.id = pc.product_id
   639	                INNER JOIN dtb_product_stock ps ON ps.product_class_id = pc.id
   640	                    AND ps.base_info_id = :base_info_id
   641	                    AND ps.stock_location_id = :smaregi_stock_location_id
   642	                    AND COALESCE(ps.stock, 0) >= 0
   643	                INNER JOIN mtb_product_status p_status ON p_status.id = p.product_status_id
   644	                INNER JOIN mtb_product_status pc_status ON pc_status.id = pc.product_status_id
   645	                LEFT JOIN mtb_language lng ON lng.id = pc.language_id
   646	                LEFT JOIN mtb_card_condition cond ON cond.id = pc.card_condition_id
   647	                LEFT JOIN mtb_storage_code sc ON sc.id = p.storage_code_id
   648	                LEFT JOIN mtb_card_detail cd ON cd.id = p.card_detail_id
   649	                LEFT JOIN mtb_card c ON c.id = cd.card_id
   650	                LEFT JOIN mtb_color_sequence cs ON cs.id = c.color_sequence_id
   651	                WHERE ph.create_date >= :price_change_period_from
   652	                    AND ph.create_date <= :price_change_period_to
   653	                    AND pc.smaregi_alignment_flg = TRUE
   654	                    AND pc.smaregi_product_id IS NOT NULL
   655	                    AND TRIM(pc.smaregi_product_id) <> ''
   656	                    AND p_status.id <> :abolished_status_id
   657	                    AND pc_status.id <> :abolished_status_id
   658	                ORDER BY pc.id ASC, ph.create_date DESC
   659	            ) AS barcode_rows
   660	            ORDER BY
   661	                barcode_rows."colorSort" ASC,
   662	                barcode_rows."cardTypeSort" ASC,
   663	                barcode_rows."manaCostSort" ASC,
   664	                barcode_rows."standardPrice" DESC NULLS LAST,
   665	                barcode_rows.product_class_id ASC
   666	        SQL;
   667	
   668	        return $connection->iterateAssociative($sql, [
   669	            'base_info_id' => $baseInfoId,
   670	            'smaregi_stock_location_id' => ProductStock::STOCK_LOCATION_SMAREGI,
   671	            'goods_category_id' => Category::GOODS_ID,
   672	            'reserved_goods_category_id' => Category::RESERVED_GOODS_ID,
   673	            'abolished_status_id' => ProductStatus::DISPLAY_ABOLISHED,
   674	            'price_change_period_from' => $priceChangePeriodFrom->format('Y-m-d H:i:s'),
   675	            'price_change_period_to' => $priceChangePeriodTo->format('Y-m-d H:i:s'),
   676	        ]);
   677	    }
   678	}

