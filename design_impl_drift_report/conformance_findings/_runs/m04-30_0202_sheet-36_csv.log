    16	namespace Eccube\Tests\Service\Csv\Exporter;
    17	
    18	use Eccube\Service\Csv\Exporter\BarcodeReplacementListCsvRowFormatter;
    19	use PHPUnit\Framework\Attributes\Group;
    20	use PHPUnit\Framework\TestCase;
    21	
    22	#[Group('HARERUYA')]
    23	final class BarcodeReplacementListCsvRowFormatterTest extends TestCase
    24	{
    25	    private BarcodeReplacementListCsvRowFormatter $formatter;
    26	
    27	    protected function setUp(): void
    28	    {
    29	        parent::setUp();
    30	        $this->formatter = new BarcodeReplacementListCsvRowFormatter();
    31	    }
    32	
    33	    /**
    34	     * @param array<string, mixed> $overrides
    35	     *
    36	     * @return array<string, mixed>
    37	     */
    38	    private function createMinimalRow(array $overrides = []): array
    39	    {
    40	        return array_merge([
    41	            'isSupply' => false,
    42	            'standardPrice' => 1500,
    43	            'languageNameJp' => '英語',
    44	            'conditionCode' => 'NM',
    45	            'rawProductName' => '【EN/NM】テスト商品',
    46	            'smaregiProductId' => '12345',
    47	            'smaregiProductCode' => '99',
    48	        ], $overrides);
    49	    }
    50	
    51	    /**
    52	     * formatRow - 正常系
    53	     * 言語と状態が両方ある場合は「・」で結合されること
    54	     * 言語のみの場合は言語が返されること
    55	     * 状態のみの場合は状態が返されること
    56	     * 言語と状態が両方ない場合は空文字が返されること
    57	     *
    58	     * @group HARERUYA
    59	     */
    60	    public function testFormatLanguageAndCondition(): void
    61	    {
    62	        $this->assertSame('英語・NM', $this->formatter->formatRow($this->createMinimalRow(['languageNameJp' => '英語', 'conditionCode' => 'NM']))['languageAndCondition']);
    63	        $this->assertSame('英語', $this->formatter->formatRow($this->createMinimalRow(['languageNameJp' => '英語', 'conditionCode' => '']))['languageAndCondition']);
    64	        $this->assertSame('NM', $this->formatter->formatRow($this->createMinimalRow(['languageNameJp' => '', 'conditionCode' => 'NM']))['languageAndCondition']);
    65	        $this->assertSame('', $this->formatter->formatRow($this->createMinimalRow(['languageNameJp' => '', 'conditionCode' => '']))['languageAndCondition']);
    66	    }
    67	
    68	    /**
    69	     * formatRow - 正常系
    70	     * 販売価格が#,###円の形式で返されること
    71	     *
    72	     * @group HARERUYA
    73	     */
    74	    public function testFormatStandardPrice(): void
    75	    {
    76	        $result = $this->formatter->formatRow($this->createMinimalRow(['standardPrice' => 1500]));
    77	
    78	        $this->assertSame('1,500円', $result['standardPrice']);
    79	    }
    80	
    81	    /**
    82	     * formatRow - 正常系
    83	     * スマレジバーコードが22 + 商品コード（6桁） + 販売価格（7桁）の形式で返されること
    84	     *
    85	     * @group HARERUYA
    86	     */
    87	    public function testFormatSmaregiBarcode(): void
    88	    {
    89	        $result = $this->formatter->formatRow($this->createMinimalRow([
    90	            'smaregiProductCode' => '99',
    91	            'standardPrice' => 1500,
    92	        ]));
    93	
    94	        $this->assertSame('220000990001500', $result['smaregiBarcode']);
    95	    }
    96	
    97	    /**
    98	     * formatRow - 正常系
    99	     * 商品コードが6桁を超える場合は下位6桁が使用されスマレジバーコードが返されること
   100	     *
   101	     * @group HARERUYA
   102	     */
   103	    public function testFormatSmaregiBarcodeUsesTrailingDigitsWhenOverflow(): void
   104	    {
   105	        $result = $this->formatter->formatRow($this->createMinimalRow([
   106	            'smaregiProductCode' => '1234567890',
   107	            'standardPrice' => 12345678,
   108	        ]));
   109	
   110	        $this->assertSame('225678902345678', $result['smaregiBarcode']);
   111	    }
   112	
   113	    /**
   114	     * formatRow - 正常系
   115	     * 商品コードが空の場合は空文字が返されること
   116	     *
   117	     * @group HARERUYA
   118	     */
   119	    public function testFormatSmaregiBarcodeReturnsEmptyStringWhenSmaregiProductCodeIsEmpty(): void
   120	    {
   121	        $result = $this->formatter->formatRow($this->createMinimalRow(['smaregiProductCode' => '']));
   122	        $this->assertSame('', $result['smaregiBarcode']);
   123	    }
   124	
   125	    /**
   126	     * formatRow - 正常系
   127	     * 商品名が半角 [] で囲まれた略称の後は出力しないこと
   128	     *
   129	     * @group HARERUYA
   130	     */
   131	    public function testFormatProductNameTruncatesAfterLastHalfWidthBracketTag(): void
   132	    {
   133	        $rawProductName = '【ネオンインク・Foil】(361)■ボーダーレス■《恐れを知らぬ者、カタラ/Katara, the Fearless》[TLA] 金R';
   134	
   135	        $this->assertSame(
   136	            '【ネオンインク・Foil】(361)■ボーダーレス■《恐れを知らぬ者、カタラ/Katara, the Fearless》[TLA]',
   137	            $this->formatter->formatProductName($rawProductName),
   138	        );
   139	    }
   140	
   141	    /**
   142	     * formatRow - 正常系
   143	     * 商品名が半角 [] で囲まれた略称がない場合はそのまま出力されること
   144	     *
   145	     * @group HARERUYA
   146	     */
   147	    public function testFormatProductNameReturnsWholeStringWhenNoHalfWidthBrackets(): void
   148	    {
   149	        $rawProductName = '【JP/NM】テスト商品';
   150	
   151	        $this->assertSame($rawProductName, $this->formatter->formatProductName($rawProductName));
   152	    }
   153	
   154	    /**
   155	     * formatRow - 正常系
   156	     * サプライ品の場合は言語・状態が「サプライ品」で返されること
   157	     *
   158	     * @group HARERUYA
   159	     */
   160	    public function testFormatWhenIsSupply(): void
   161	    {
   162	        $result = $this->formatter->formatRow($this->createMinimalRow([
   163	            'isSupply' => true,
   164	            'rawProductName' => 'サプライ商品名',
   165	        ]));
   166	
   167	        $this->assertSame('サプライ品', $result['languageAndCondition']);
   168	    }
   169	}

