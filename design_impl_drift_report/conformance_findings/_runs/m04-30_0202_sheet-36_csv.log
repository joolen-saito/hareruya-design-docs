    31	/**
    32	 * BarcodeReplacementListCsvExportService の統合テスト
    33	 */
    34	#[Group('HARERUYA')]
    35	final class BarcodeReplacementListCsvExportServiceTest extends EccubeTestCase
    36	{
    37	    private ?BarcodeReplacementListCsvExportService $service = null;
    38	
    39	    #[\Override]
    40	    protected function setUp(): void
    41	    {
    42	        parent::setUp();
    43	        $this->service = static::getContainer()->get(BarcodeReplacementListCsvExportService::class);
    44	    }
    45	
    46	    /**
    47	     * export - 正常系
    48	     * ヘッダー行と対象データが CSV に出力されること
    49	     */
    50	    public function testExportOutputsCsvWithHeadersAndData(): void
    51	    {
    52	        $expectedCsvRow = $this->createSmaregiAlignedProductWithExpectedCsvOutput();
    53	
    54	        $baseInfo = $this->entityManager->find(BaseInfo::class, $expectedCsvRow['baseInfoId']);
    55	
    56	        $response = $this->service->export(
    57	            baseInfo: $baseInfo,
    58	            priceChangePeriodFrom: new \DateTime('2026-05-19 00:00:00'),
    59	            priceChangePeriodTo: new \DateTime('2026-05-20 23:59:59'),
    60	        );
    61	
    62	        $csv = $this->captureStreamedResponseCsv($response);
    63	        $lines = array_values(array_filter(explode("\n", str_replace("\r\n", "\n", trim($csv)))));
    64	        $this->assertCount(2, $lines, 'ヘッダー + 1データ行が出力されること');
    65	
    66	        $headerCells = str_getcsv($lines[0]);
    67	        $headerCells[0] = preg_replace('/^\xEF\xBB\xBF/', '', $headerCells[0]) ?? $headerCells[0];
    68	        $this->assertSame(array_values(BarcodeReplacementListCsvExportService::CSV_HEADER), $headerCells);
    69	
    70	        $bodyCells = str_getcsv($lines[1]);
    71	        $this->assertSame($expectedCsvRow['expectedProductName'], $bodyCells[0]);
    72	        $this->assertSame($expectedCsvRow['expectedLanguageAndCondition'], $bodyCells[1]);
    73	        $this->assertSame($expectedCsvRow['expectedStandardPrice'], $bodyCells[2]);
    74	        $this->assertSame($expectedCsvRow['smaregiProductId'], $bodyCells[3]);
    75	        $this->assertSame($expectedCsvRow['smaregiProductCode'], $bodyCells[4]);
    76	        $this->assertSame($expectedCsvRow['expectedSmaregiBarcode'], $bodyCells[5]);
    77	    }
    78	
    79	    private function captureStreamedResponseCsv(StreamedResponse $response): string
    80	    {
    81	        ob_start();
    82	        try {
    83	            $response->sendContent();
    84	        } finally {
    85	            $csv = ob_get_clean();
    86	        }
    87	
    88	        return is_string($csv) ? $csv : '';
    89	    }
