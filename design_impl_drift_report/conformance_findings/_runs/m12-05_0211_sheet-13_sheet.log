   427	            : (int) $this->eccubeConfig->get('eccube_default_page_count');
   428	        if ($limit > 0) {
   429	            $qb->setMaxResults($limit);
   430	        }
   431	
   432	        return $qb->executeQuery()->fetchAllAssociative();
   433	    }
