   438	    public function deleteRequestByNonProduct(): void
   439	    {
   440	        $time = new \DateTime();
   441	        $sql = <<<EOT
   442	UPDATE
   443	    dtb_product_request pr
   444	JOIN dtb_product_class pc ON pr.product_class_id = pc.product_class_id
