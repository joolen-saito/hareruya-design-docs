   308	     * 入荷通知依頼分析集計 - 商品ID×言語ごとの通知待ち/通知済み件数
   309	     *
   310	     * 通知待ち: 同一ユーザーが同一商品を複数規格で登録していても1件としてカウント（いずれか1件でも未削除なら通知待ち）
   311	     * 通知済み: 同一ユーザーの同一商品に紐づく全規格が削除済みの場合のみカウント
   312	     *
   313	     * @param array<string, mixed> $searchData
   314	     *
   315	     * @return list<array<string, int|string|null>>
   316	     */
   317	    public function getAnalysisSummary(array $searchData): array
   318	    {
   319	        $conn = $this->getEntityManager()->getConnection();
   320	        $qb = $conn->createQueryBuilder()
   321	            ->select(
   322	                'p.id AS product_id',
   323	                'p.name AS product_name',
   324	                'l.id AS language_id',
   325	                'l.code AS language_code',
   326	                'COUNT(DISTINCT CASE WHEN pr.deleted_at IS NULL THEN pr.player_id ELSE NULL END) AS pending_count',
   327	                '(COUNT(DISTINCT pr.player_id) - COUNT(DISTINCT CASE WHEN pr.deleted_at IS NULL THEN pr.player_id ELSE NULL END)) AS deleted_count',
   328	                'MIN(pc.price02) AS min_price',
   329	            )
   330	            ->from('dtb_product_request', 'pr')
   331	            ->innerJoin('pr', 'dtb_product_class', 'pc', 'pr.product_class_id = pc.id')
   332	            ->innerJoin('pc', 'dtb_product', 'p', 'pc.product_id = p.id')
   333	            ->leftJoin('pc', 'mtb_language', 'l', 'pc.language_id = l.id')
   334	            ->groupBy('p.id')
   335	            ->addGroupBy('l.id');
   336	
   337	        // キーワード（商品名日/英）
   338	        $multi = isset($searchData['multi']) ? trim((string) $searchData['multi']) : '';
   339	        if ($multi !== '') {
   340	            $qb->andWhere('(p.name LIKE :multi OR p.name_en LIKE :multi)')
   341	                ->setParameter('multi', '%'.$multi.'%');
   342	        }
   343	
   344	        // 依頼日 From/To
   345	        if (!empty($searchData['create_date_from'])) {
   346	            $qb->andWhere('pr.create_date >= :create_date_from')
   347	                ->setParameter('create_date_from', $searchData['create_date_from']->format('Y-m-d 00:00:00'));
   348	        }
   349	        if (!empty($searchData['create_date_to'])) {
   350	            $dateTo = clone $searchData['create_date_to'];
   351	            $dateTo->modify('+1 day');
   352	            $qb->andWhere('pr.create_date < :create_date_to')
   353	                ->setParameter('create_date_to', $dateTo->format('Y-m-d 00:00:00'));
   354	        }
   355	
   356	        // 販売価格 From/To
   357	        if (!empty($searchData['price_from'])) {
   358	            $qb->andWhere('pc.price02 >= :price_from')
   359	                ->setParameter('price_from', (int) $searchData['price_from']);
   360	        }
   361	        if (!empty($searchData['price_to'])) {
   362	            $qb->andWhere('pc.price02 <= :price_to')
   363	                ->setParameter('price_to', (int) $searchData['price_to']);
   364	        }
   365	
   366	        // 言語フィルター（ProductRepository と同じロジック）
   367	        $languageItems = $searchData['language'] ?? [];
   368	        if (!empty($languageItems) && count($languageItems) < 3) {
   369	            $languageParts = [];
   370	            $languageIds = [];
   371	            $needsExceptLanguageIds = false;
   372	            foreach ($languageItems as $langId) {
   373	                $id = (int) $langId;
   374	                if ($id === MtbLanguage::JP_ID || $id === MtbLanguage::EN_ID) {
   375	                    $languageIds[] = $id;
   376	                } elseif ($id === MtbLanguage::NOT_JP_EN_LANG_ID) {
   377	                    $languageParts[] = 'pc.language_id NOT IN (:exceptLanguageIds)';
   378	                    $needsExceptLanguageIds = true;
   379	                }
   380	            }
   381	            if ($languageIds !== []) {
   382	                $languageParts[] = 'pc.language_id IN (:languageIds)';
   383	                $qb->setParameter('languageIds', $languageIds, ArrayParameterType::INTEGER);
   384	            }
   385	            if ($languageParts !== []) {
   386	                $condition = count($languageParts) === 1 ? $languageParts[0] : '('.implode(' OR ', $languageParts).')';
   387	                $qb->andWhere($condition);
   388	            }
   389	            if ($needsExceptLanguageIds) {
   390	                $qb->setParameter('exceptLanguageIds', MtbLanguage::CONSTANT_LANG_IDS, ArrayParameterType::INTEGER);
   391	            }
   392	        }
   393	
   394	        // 売上分析タグ
   395	        $tagSalesAnalyses = $searchData['tag_sales_analysis'] ?? null;
   396	        if (!empty($tagSalesAnalyses) && count($tagSalesAnalyses) > 0) {
   397	            $tagIds = array_map(
   398	                fn ($tag) => is_object($tag) ? $tag->getId() : (int) $tag,
   399	                is_array($tagSalesAnalyses) ? $tagSalesAnalyses : $tagSalesAnalyses->toArray(),
   400	            );
   401	            $qb->innerJoin('p', 'dtb_product_tag_sales_analysis', 'ptsa', 'ptsa.product_id = p.id')
   402	                ->andWhere('ptsa.tag_sales_analysis_id IN (:tagSalesAnalyses)')
   403	                ->setParameter('tagSalesAnalyses', $tagIds, ArrayParameterType::INTEGER);
   404	        }
   405	
   406	        // ソート
   407	        $sortKey = $searchData['sort_key'] ?? null;
   408	        $order = strtoupper((string) ($searchData['asc_desc'] ?? 'ASC'));
   409	        $order = in_array($order, ['ASC', 'DESC'], true) ? $order : 'ASC';
   410	        $sortSqlMap = [
   411	            'product_name' => 'p.name',
   412	            'price' => 'MIN(pc.price02)',
   413	        ];
   414	        if ($sortKey !== null && isset($sortSqlMap[$sortKey])) {
   415	            $qb->orderBy($sortSqlMap[$sortKey], $order)
   416	                ->addOrderBy('p.id', 'ASC')
   417	                ->addOrderBy('l.id', 'ASC');
   418	        } else {
   419	            $qb->orderBy('p.id', 'ASC')
   420	                ->addOrderBy('l.id', 'ASC');
   421	        }
   422	
   423	        // 表示件数
   424	        $pageCount = $searchData['page_count'] ?? null;
   425	        $limit = $pageCount !== null
