    16	namespace Eccube\Controller\App\MTGBuyer\V1\Admin;
    17	
    18	use Eccube\Controller\AbstractController;
    19	use Eccube\Entity\BaseInfo;
    20	use Eccube\Entity\Master\Work;
    21	use Eccube\Entity\Member;
    22	use Eccube\Exception\App\UnauthenticatedException;
    23	use Eccube\Repository\Views\LoginMemberViewRepository;
    24	use Eccube\Security\AccessToken\JwtTokenService;
    25	use Symfony\Component\HttpFoundation\JsonResponse;
    26	use Symfony\Component\HttpFoundation\Request;
    27	use Symfony\Component\HttpFoundation\Response;
    28	use Symfony\Component\PasswordHasher\Hasher\UserPasswordHasherInterface;
    29	use Symfony\Component\Routing\Attribute\Route;
    30	
    31	class LoginController extends AbstractController
    32	{
    33	    public function __construct(
    34	        private readonly LoginMemberViewRepository $loginMemberViewRepository,
    35	        private readonly UserPasswordHasherInterface $passwordHasher,
    36	        private readonly JwtTokenService $jwtTokenService,
    37	    ) {
    38	    }
    39	
    40	    /**
    41	     * 管理者ログイン認証API
    42	     *
    43	     * login_id と password を受け取り、認証成功時にJWTトークンとメンバー情報を返す。
    44	     */
    45	    #[Route('/%eccube_api_v1_route%/admin/login.json', name: 'api_admin_login', methods: ['POST'])]
    46	    public function login(Request $request): JsonResponse
    47	    {
    48	        $loginId = (string) $request->request->get('login_id', '');
    49	        $password = (string) $request->request->get('password', '');
    50	
    51	        if ($loginId === '' || $password === '') {
    52	            throw new UnauthenticatedException('ログインIDまたはパスワードが入力されていません');
    53	        }
    54	
    55	        $viewMember = $this->loginMemberViewRepository->findOneBy(['login_id' => $loginId, 'work_id' => Work::ACTIVE]);
    56	
    57	        if ($viewMember === null) {
    58	            throw new UnauthenticatedException('ログインIDまたはパスワードが正しくありません');
    59	        }
    60	
    61	        // MemberProvider と同じパターンで Member オブジェクトを構築してパスワード検証
    62	        $member = new Member();
    63	        $member->setId($viewMember->getId());
    64	        $member->setLoginId($viewMember->getLoginId());
    65	        $member->setPassword($viewMember->getPassword());
    66	        $member->setSalt($viewMember->getSalt());
    67	        $member->setBaseInfo($this->entityManager->find(BaseInfo::class, $viewMember->getBaseInfoId()));
    68	
    69	        if (!$this->passwordHasher->isPasswordValid($member, $password)) {
    70	            throw new UnauthenticatedException('ログインIDまたはパスワードが正しくありません');
    71	        }
    72	
    73	        $baseInfo = $member->getBaseInfo();
    74	        $shopAddr = implode('', array_filter([
    75	            $baseInfo->getAddr01(),
    76	            $baseInfo->getAddr02(),
    77	        ]));
    78	
    79	        $jwtToken = $this->jwtTokenService->createToken($member->getId());
    80	
    81	        return new JsonResponse([
    82	            'memberName' => $viewMember->getName() ?? '',
    83	            'memberId' => $member->getId(),
    84	            'shopName' => $baseInfo->getShopName() ?? '',
    85	            'shopAddr' => $shopAddr,
    86	            'jwtToken' => $jwtToken,
    87	        ], Response::HTTP_OK);
    88	    }
    89	}

