    48	            $newKeyword = $input->keyword;
    49	
    50	            if ($NewBlacklistTag && $newKeyword) {
    51	                $this->blacklistEntityManager->save($NewBlacklistTag, $newKeyword);
    52	            }
    53	
    54	            $this->entityManager->flush();
    55	            $this->entityManager->commit();
    56	        } catch (\Exception $e) {
    57	            $this->entityManager->rollback();
    58	
