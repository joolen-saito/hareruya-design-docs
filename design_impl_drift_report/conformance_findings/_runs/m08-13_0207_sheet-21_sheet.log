    16	namespace Eccube\Repository;
    17	
    18	use Doctrine\Persistence\ManagerRegistry as RegistryInterface;
    19	use Eccube\Entity\Customer;
    20	use Eccube\Entity\DtbBlacklist;
    21	use Eccube\Entity\Master\MtbBlacklistTag;
    22	use Eccube\Util\StringUtil;
    23	
    24	/**
    25	 * @extends AbstractRepository<DtbBlacklist>
    26	 */
    27	class DtbBlacklistRepository extends AbstractRepository
    28	{
    29	    public function __construct(RegistryInterface $registry)
    30	    {
    31	        parent::__construct($registry, DtbBlacklist::class);
    32	    }
    33	
    34	    /**
    35	     * 会員情報の氏名・電話番号・住所からブラックリストを検索
    36	     */
    37	    public function FindBlacklistByCustomer(Customer $Customer): mixed
    38	    {
    39	        $name = StringUtil::removeSpace($Customer->getName01().$Customer->getName02());
    40	        $tel = StringUtil::removeSpace($Customer->getTel01().$Customer->getTel02().$Customer->getTel03());
    41	        $address = StringUtil::removeSpace($Customer->getPref().$Customer->getAddr01().$Customer->getAddr02().$Customer->getAddr03());
    42	
    43	        $qb = $this->createQueryBuilder('bl');
    44	        $qb->andWhere(
    45	            $qb->expr()->orX(
    46	                $qb->expr()->andX(
    47	                    $qb->expr()->eq('bl.BlacklistTag', ':name_id'),
    48	                    $qb->expr()->eq('bl.keyword', ':name')
    49	                ),
    50	                $qb->expr()->andX(
    51	                    $qb->expr()->eq('bl.BlacklistTag', ':tel_id'),
    52	                    $qb->expr()->eq('bl.keyword', ':tel')
    53	                ),
    54	                $qb->expr()->andX(
    55	                    $qb->expr()->eq('bl.BlacklistTag', ':address_id'),
    56	                    $qb->expr()->eq('bl.keyword', ':address')
    57	                )
    58	            )
    59	        );
    60	
    61	        $qb->setParameter('name_id', MtbBlacklistTag::NAME_ID)
    62	            ->setParameter('name', $name)
    63	            ->setParameter('tel_id', MtbBlacklistTag::TEL_ID)
    64	            ->setParameter('tel', $tel)
    65	            ->setParameter('address_id', MtbBlacklistTag::ADDRESS_ID)
    66	            ->setParameter('address', $address);
    67	
    68	        return $qb->getQuery()->getResult();
    69	    }
    70	}

