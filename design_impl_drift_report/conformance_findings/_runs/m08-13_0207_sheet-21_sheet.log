./zap/scripts/plugin_mailmagazine_create_customers.zst:32:            "body": "<!doctype html>\n<html lang=\"ja\">\n<head>\n    <meta charset=\"utf-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1, shrink-to-fit=no\">\n    <meta name=\"eccube-csrf-token\" content=\"n1N8eRNqnuybBJ0n9q06SwK36cGwamqh9yXfWXC2rl0\">\n    <title>会員管理 会員登録 - EC-CUBE SHOP</title>\n    <link rel=\"icon\" href=\"/html/template/admin/assets/img/favicon.ico\">\n    <link rel=\"stylesheet\" href=\"/html/template/admin/assets/css/bootstrap.css\">\n    <link href=\"https://maxcdn.bootstrapcdn.com/font-awesome/4.7.0/css/font-awesome.min.css\" rel=\"stylesheet\" integrity=\"sha384-wvfXpqpZZVQGK6TAh5PVlGOfQNHSoD2xbE+QkPxCAFlNEevoEH3Sl0sibVcOQVnN\" crossorigin=\"anonymous\">\n    <link rel=\"stylesheet\" href=\"https://use.fontawesome.com/releases/v5.3.1/css/all.css\">\n    <link rel=\"stylesheet\" href=\"https://use.fontawesome.com/releases/v5.3.1/css/v4-shims.css\">\n    <link rel=\"stylesheet\" href=\"/html/template/admin/assets/css/ladda-themeless.min.css\"></link>\n    <link rel=\"stylesheet\" href=\"/html/template/admin/assets/css/app.css\">\n        <script src=\"https://code.jquery.com/jquery-3.6.0.min.js\" integrity=\"sha256-/xUj+3OJU5yExlq6GSYGSHk7tPXikynS7ogEvDej/m4=\" crossorigin=\"anonymous\"></script>\n    <script>\n        $(function() {\n            $.ajaxSetup({\n                'headers': {\n                    'ECCUBE-CSRF-TOKEN': $('meta[name=\"eccube-csrf-token\"]').attr('content')\n                }\n            });\n        });\n    </script>\n        </head>\n<body id=\"page_admin_customer_new\">\n<header class=\"c-headerBar\">\n    <div class=\"c-headerBar__container\">\n        <div class=\"c-headerBar__logo\">\n            <h1><img src=\"/html/template/admin/assets/img/logo@2x.png\"></h1>\n        </div>\n        <a class=\"c-headerBar__toggleBtn\"><i class=\"fa fa-bars\" aria-hidden=\"true\"></i></a>\n        <a class=\"c-headerBar__shopTitle\