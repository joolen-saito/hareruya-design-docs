    28	
    29	class BlacklistUpdateType extends AbstractType
    30	{
    31	    public function buildForm(FormBuilderInterface $builder, array $options): void
    32	    {
    33	        $builder
    34	            ->add('new_blacklist_tag', BlacklistTagType::class, [
    35	                'label' => 'admin.customer.blacklist.blacklist_tag',
    36	                'class' => MtbBlacklistTag::class,
    37	                'mapped' => false,
    38	                'required' => false,
    39	            ])
    40	            ->add('new_keyword', TextType::class, [
    41	                'mapped' => false,
    42	                'required' => false,
    43	            ])
    44	            ->add('Blacklists', CollectionType::class, [
    45	                'entry_type' => BlacklistType::class,
    46	                'allow_add' => true,
    47	                'allow_delete' => true,
    48	            ]);
    49	    }
    50	
    51	    #[\Override]
    52	    public function configureOptions(OptionsResolver $resolver): void
    53	    {
    54	        $resolver->setDefaults([
    55	            'data_class' => null,
    56	            'constraints' => [
    57	                new Assert\Callback([$this, 'validate']),
    58	            ],
    59	        ]);
    60	    }
    61	
    62	    public function validate(mixed $data, ExecutionContextInterface $context): void
    63	    {
    64	        $form = $context->getRoot();
    65	        $Blacklists = $data['Blacklists'] ?? [];
    66	        $checkList = [];
    67	
    68	        $blacklistsForm = $form->get('Blacklists');
    69	        foreach ($Blacklists as $index => $Blacklist) {
    70	            $BlacklistTag = $Blacklist->getBlacklistTag();
    71	            $keyword = $Blacklist->getKeyword();
    72	
    73	            if (empty($keyword)) {
    74	                $blacklistsForm->get((string) $index)->get('keyword')
    75	                    ->addError(new FormError(trans('admin.customer.blacklist.input_error')));
    76	            }
    77	
    78	            if ($BlacklistTag->isTel()) {
    79	                if (!preg_match('/^[0-9]+$/', $keyword)) {
    80	                    $blacklistsForm->get((string) $index)->get('keyword')
    81	                        ->addError(new FormError(trans('admin.customer.blacklist.input_error')));
    82	                }
    83	            }
    84	
    85	            $key = $BlacklistTag->getId().'_'.$keyword;
    86	            if (isset($checkList[$key])) {
    87	                $blacklistsForm->get((string) $index)->get('keyword')
    88	                    ->addError(new FormError(trans('admin.customer.blacklist.registered_error')));
    89	            }
    90	            $checkList[$key] = true;
    91	        }
    92	
    93	        $NewBlacklistTag = $form->get('new_blacklist_tag')->getData();
    94	        $newKeyword = $form->get('new_keyword')->getData();
    95	
    96	        if (!$NewBlacklistTag && !empty($newKeyword)) {
    97	            $form->get('new_blacklist_tag')
    98	                ->addError(new FormError(trans('admin.customer.blacklist.new_register_tag_error')));
    99	        }
   100	
   101	        if (!empty($newKeyword) && $NewBlacklistTag instanceof MtbBlacklistTag) {
   102	            $newKey = $NewBlacklistTag->getId().'_'.$newKeyword;
   103	            if (isset($checkList[$newKey])) {
   104	                $form->get('new_keyword')
   105	                    ->addError(new FormError(trans('admin.customer.blacklist.registered_error')));
   106	            }
   107	
   108	            if ($NewBlacklistTag->isTel()) {
   109	                if (!preg_match('/^[0-9]+$/', $newKeyword)) {
   110	                    $form->get('new_keyword')
   111	                        ->addError(new FormError(trans('admin.customer.blacklist.input_error')));
   112	                }
   113	            }
   114	        }
   115	    }
   116	
