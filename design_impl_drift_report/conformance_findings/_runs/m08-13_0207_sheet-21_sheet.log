    59	     * @return RedirectResponse|array<string, mixed>
    60	     */
    61	    #[Route(path: '/%eccube_admin_route%/customer/blacklist/update', name: 'admin_customer_blacklist_update', methods: ['POST'])]
    62	    #[Template(template: '@admin/Customer/blacklist.twig')]
    63	    public function update(Request $request, BlacklistUpdateAction $updateAction): RedirectResponse|array
    64	    {
    65	        $Blacklists = $this->dtbBlacklistRepository->findBy([], ['id' => 'ASC']);
    66	
    67	        $formData = [
    68	            'Blacklists' => $Blacklists,
    69	        ];
    70	
    71	        $builder = $this->formFactory->createBuilder(BlacklistUpdateType::class, $formData);
