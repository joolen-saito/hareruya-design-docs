    21	
    22	class BlacklistUpdateAction
    23	{
    24	    public function __construct(
    25	        private readonly EntityManagerInterface $entityManager,
    26	        private readonly BlacklistEntityManager $blacklistEntityManager,
    27	    ) {
    28	    }
    29	
    30	    /**
    31	     * @throws \Exception
    32	     */
    33	    public function handle(BlacklistUpdateInput $input): void
    34	    {
    35	        $this->entityManager->beginTransaction();
    36	
    37	        try {
    38	            foreach ($input->BlacklistsData as $data) {
    39	                $Blacklist = $data['entity'];
    40	                $isDelete = $data['delete_flg'];
    41	
