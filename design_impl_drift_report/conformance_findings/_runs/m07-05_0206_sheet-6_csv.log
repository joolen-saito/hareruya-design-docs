    25	    /**
    26	     * 銀行入金CSVヘッダー定義
    27	     *
    28	     * @var array<string, string>
    29	     */
    30	    public const CSV_HEADER = [
    31	        'buy_order_id' => '受注番号',
    32	        'delivery_fee' => '送料',
    33	        'total_price' => '査定額',
    34	        'bank_code' => '銀行名',
    35	        'bank_branch_code' => '支店名',
    36	        'bank_account_type' => '口座種別',
    37	        'bank_account_no' => '口座番号',
    38	        'bank_account_holder' => '受取人口座名義',
    39	        'deposit_price' => '振込金額',
    40	        'online_identificaion_status' => 'オンライン本人確認区分',
    41	    ];
    42	
    43	    public function __construct(
    44	        protected CsvExportService $csvExportService,
    45	        protected DtbBuyOrderRepository $buyOrderRepository,
    46	    ) {
    47	    }
    48	
    49	    /**
    50	     * 入金CSVを出力する
    51	     *
    52	     * @param array<int, int> $buyOrderIds 買取注文IDの配列
    53	     */
    54	    public function exportByIds(array $buyOrderIds): StreamedResponse
    55	    {
    56	        $BuyOrders = $this->buyOrderRepository->findBy(
    57	            ['id' => $buyOrderIds],
    58	            ['id' => 'ASC'],
    59	        );
    60	
    61	        if ($BuyOrders === []) {
    62	            throw new \RuntimeException('admin.purchase.online.csv_export.not_registered_buy_order_id');
    63	        }
    64	
    65	        $bankRows = $this->buyOrderRepository->findBankDataByBuyOrderIds($buyOrderIds);
    66	        $bankData = array_column($bankRows, null, 'buyOrderId');
    67	        $rows = $this->buildCsvRows($BuyOrders, $bankData);
    68	
    69	        $header = self::CSV_HEADER;
    70	        $headerKeys = array_keys($header);
    71	
    72	        $response = new StreamedResponse();
    73	        $response->setCallback(function () use ($header, $headerKeys, $rows): void {
    74	            $this->csvExportService->fopen();
    75	            $this->csvExportService->fputcsv(array_values($header));
    76	
    77	            foreach ($rows as $row) {
    78	                $orderedRow = array_map(
    79	                    fn ($key) => $row[$key] ?? '',
    80	                    $headerKeys,
    81	                );
    82	                $this->csvExportService->fputcsv($orderedRow);
    83	            }
    84	
    85	            $this->csvExportService->fclose();
    86	        });
    87	
    88	        $prefix = 'purchase_bank_deposit_'.sprintf('%07d', min($buyOrderIds)).'_';
    89	        $filename = $prefix.(new \DateTime())->format('YmdHis').'.csv';
    90	        $response->headers->set('Content-Type', 'application/octet-stream');
    91	        $response->headers->set(
    92	            'Content-Disposition',
    93	            'attachment; filename='.$filename,
    94	        );
    95	
    96	        log_info('入金CSV出力完了. ファイル名: '.$filename);
    97	
    98	        return $response;
    99	    }
   100	
   101	    /**
   102	     * @param DtbBuyOrder[] $BuyOrders
   103	     * @param array<int, array{buyOrderId: mixed, bank_code: mixed, bank_branch_code: mixed, bank_account_type: mixed, bank_account_no: mixed, bank_account_holder: mixed, online_identificaion_status: mixed}> $bankData 買取IDでキー化した銀行データ（Repositoryの生の戻り値をキー化したもの）
   104	     *
   105	     * @return list<array<string, mixed>>
   106	     */
   107	    private function buildCsvRows(array $BuyOrders, array $bankData): array
   108	    {
   109	        $rows = [];
   110	        foreach ($BuyOrders as $BuyOrder) {
   111	            $id = $BuyOrder->getId();
   112	            $bank = $bankData[$id] ?? [];
   113	            $deliveryFee = $BuyOrder->getDeliveryFee();
   114	            $acceptanceTotalPrice = $BuyOrder->getAcceptanceTotalPrice();
   115	
   116	            $rows[] = [
   117	                'buy_order_id' => $id,
   118	                'delivery_fee' => $deliveryFee,
   119	                'total_price' => $acceptanceTotalPrice,
   120	                'bank_code' => $bank['bank_code'] ?? '',
   121	                'bank_branch_code' => $bank['bank_branch_code'] ?? '',
   122	                'bank_account_type' => $bank['bank_account_type'] ?? '',
   123	                'bank_account_no' => $bank['bank_account_no'] ?? '',
   124	                'bank_account_holder' => $bank['bank_account_holder'] ?? '',
   125	                'deposit_price' => $deliveryFee + $acceptanceTotalPrice,
   126	                'online_identificaion_status' => $bank['online_identificaion_status'] ?? '',
   127	            ];
   128	        }
   129	
   130	        return $rows;
   131	    }
   132	}

