class P(HTMLParser):
    def __init__(self): super().__init__(); self.in_sheet=False; self.depth=0; self.skip=0; self.out=[]
    def handle_starttag(self, tag, attrs):
        attrs=dict(attrs)
        if tag=='section' and attrs.get('id')=='sheet-3': self.in_sheet=True; self.depth=1
        elif self.in_sheet and tag=='section': self.depth+=1
        if self.in_sheet and tag in ('script','style'): self.skip+=1
    def handle_startendtag(self, tag, attrs): pass
    def handle_endtag(self, tag):
        if self.in_sheet and tag in ('script','style') and self.skip: self.skip-=1
        if self.in_sheet and tag=='section':
            self.depth-=1
            if self.depth==0: self.in_sheet=False
    def handle_data(self,data):
        if self.in_sheet and not self.skip:
            t=' '.join(data.split())
            if t and len(t)>1: self.out.append((self.getpos()[0],t))
