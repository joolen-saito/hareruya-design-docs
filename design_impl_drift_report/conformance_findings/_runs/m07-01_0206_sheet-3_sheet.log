namespace Eccube\Form\Type\Admin\Purchase;

use Doctrine\ORM\EntityRepository;
use Eccube\Common\EccubeConfig;
use Eccube\Entity\Master\MtbBuyOrderStatus;
use Eccube\Entity\Master\MtbIdentityConfirmStatus;
use Eccube\Repository\DtbBuyOrderRepository;
use Symfony\Bridge\Doctrine\Form\Type\EntityType;
use Symfony\Component\Form\AbstractType;
use Symfony\Component\Form\Extension\Core\Type\CheckboxType;
use Symfony\Component\Form\Extension\Core\Type\ChoiceType;
use Symfony\Component\Form\Extension\Core\Type\DateType;
use Symfony\Component\Form\Extension\Core\Type\IntegerType;
use Symfony\Component\Form\Extension\Core\Type\TextType;
use Symfony\Component\Form\FormBuilderInterface;
use Symfony\Component\OptionsResolver\OptionsResolver;
use Symfony\Component\Validator\Constraints as Assert;

class PurchaseListType extends AbstractType
{
    public const PRODUCT_NAME_FORM_NUM = 3;

    public const PRODUCT_NAME_SEARCH_AND = 0;

    public const PRODUCT_NAME_SEARCH_OR = 1;

    /**
     * 検索条件として表示する進捗ステータス履歴の許可リスト
     * 画面の表示順序に合わせて設定すること
     */
    private const SEARCHABLE_BUY_ORDER_STATUS_IDS = [
        MtbBuyOrderStatus::ORDERED,
        MtbBuyOrderStatus::PRODUCT_ARRIVAL,
        MtbBuyOrderStatus::ASSESSING,
        MtbBuyOrderStatus::APPRAISAL_COMPLETE,
        MtbBuyOrderStatus::COMMUNICATED,
        MtbBuyOrderStatus::APPRAISAL_ACCEPTANCE,
        MtbBuyOrderStatus::TRANSFER_REQUESTED,
        MtbBuyOrderStatus::TRANSFER_COMPLETE,
        MtbBuyOrderStatus::STOCKING_COMPLETE,
        MtbBuyOrderStatus::CANCELED,
    ];

    /**
     * @var EccubeConfig
     */
    protected EccubeConfig $eccubeConfig;

    public function __construct(EccubeConfig $eccubeConfig)
    {
        $this->eccubeConfig = $eccubeConfig;
    }

    public function configureOptions(OptionsResolver $resolver)
    {
        $resolver->setDefaults([
            // disable CSRF protection for this form
            'csrf_protection' => false,
        ]);
    }

    /**
     * {@inheritdoc}
     */
    public function buildForm(FormBuilderInterface $builder, array $options)
    {
        $builder->add('buy_order_status', EntityType::class, [
            'class' => MtbBuyOrderStatus::class,
            'label' => 'form.purchase.buy_order_status.label',
            'required' => false,
            'multiple' => true,
            'query_builder' => fn (EntityRepository $er) => $er->createQueryBuilder('bos')->orderBy('bos.rank', 'ASC'),
        ]);

        foreach (self::SEARCHABLE_BUY_ORDER_STATUS_IDS as $statusId) {
            $buyOrderStatusName = MtbBuyOrderStatus::BUY_ORDER_STATUS[$statusId];

            $orderStatusArr = [
                $buyOrderStatusName.DtbBuyOrderRepository::DATE_FROM,
                $buyOrderStatusName.DtbBuyOrderRepository::DATE_TO,
            ];
            foreach ($orderStatusArr as $dateColumn) {
                $formOption = [
                    'required' => false,
                    'input' => 'datetime',
                    'widget' => 'single_text',
                    'format' => 'yyyy-MM-dd',
                    'placeholder' => ['year' => '----', 'month' => '--', 'day' => '--'],
                ];
                if (
                    $statusId === MtbBuyOrderStatus::ORDERED
                    && $dateColumn === $buyOrderStatusName.DtbBuyOrderRepository::DATE_FROM
                ) {
                    // 「買取依頼日」のFROM値にデフォルト値を設定する
                    $formOption['data'] = (new \DateTime())->modify($this->eccubeConfig['eccube_default_from_term']);
                }
                $builder
                    ->add($dateColumn, DateType::class, $formOption);
            }
        }

        $builder
            // 買取番号
            ->add('purchase_number', TextType::class, [
                'required' => false,
                'label' => trans('form.purchase.purchase_number.label'),
                'attr' => [
                    'class' => 'input_search',
                ],
                'constraints' => [
                    new Assert\Length(['max' => $this->eccubeConfig['eccube_stext_len']]),
                ],
            ])
            // 注文者名
            ->add('name_multi', TextType::class, [
                'required' => false,
                'label' => trans('form.purchase.name_multi.label'),
                'attr' => [
                    'class' => 'input_search',
                ],
            ])
            // AND,OR検索選択
            ->add('product_name_select', ChoiceType::class, [
                'required' => false,
                'expanded' => true,
                'multiple' => false,
                'choices' => [
                    'admin.purchase.online.form.and_search.label' => self::PRODUCT_NAME_SEARCH_AND,
                    'admin.purchase.online.form.or_search.label' => self::PRODUCT_NAME_SEARCH_OR,
                ],
                'placeholder' => null,
            ])
            // 本人確認ステータス
            ->add('identityConfirmStatus', EntityType::class, [
                'class' => MtbIdentityConfirmStatus::class,
                'choice_label' => 'nameJp',
                'required' => false,
                'expanded' => true,
                'multiple' => true,
                'placeholder' => false,
            ])
            // 利用回数
            ->add('orderCountFrom', IntegerType::class, [
                'required' => false,
                'attr' => [
                    'min' => '1',
                ],
            ])
            ->add('orderCountTo', IntegerType::class, [
                'required' => false,
                'attr' => [
                    'min' => '1',
                ],
            ])
            // 棚戻し未完了のみ表示
            ->add('restock_incomplete_only', CheckboxType::class, [
                'required' => false,
                'label' => trans('admin.purchase.store.form.restock_incomplete_only.label'),
            ])
        ;

        // 商品名
        foreach (range(1, self::PRODUCT_NAME_FORM_NUM) as $num) {
            $builder->add('product_name'.$num, TextType::class, [
                'required' => false,
            ]);
        }
    }

    /**
     * {@inheritdoc}
     */
    public function getBlockPrefix(): string
    {
        return 'admin_purchase_list';
    }
}

