   204	            $qb->setParameter('orderCountFrom', $searchData['orderCountFrom']);
   205	        }
   206	        if (!empty($searchData['orderCountTo'])) {
   207	            $orderCountConditions[] = $qb->expr()->lte($qb->expr()->count('bs.id'), ':orderCountTo');
   208	            $qb->setParameter('orderCountTo', $searchData['orderCountTo']);
   209	        }
   210	        if (count($orderCountConditions) > 0) {
   211	            $subQuery = $this->createQueryBuilder('bs')
