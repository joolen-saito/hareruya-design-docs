namespace Eccube\Repository;

use Doctrine\Common\Collections\ArrayCollection;
use Doctrine\DBAL\ArrayParameterType;
use Doctrine\ORM\Query\Expr\Andx;
use Doctrine\ORM\Query\Expr\Join;
use Doctrine\ORM\Query\Expr\Orx;
use Doctrine\ORM\QueryBuilder;
use Doctrine\Persistence\ManagerRegistry;
use Eccube\Entity\BaseInfo;
use Eccube\Entity\Customer;
use Eccube\Entity\DtbBuyMainCard;
use Eccube\Entity\DtbBuyOrder;
use Eccube\Entity\DtbBuyOrderIndivisualInputProduct;
use Eccube\Entity\DtbBuyOrderStatusHistory;
use Eccube\Entity\DtbPlayer;
use Eccube\Entity\Master\MtbBuyOrderStatus;
use Eccube\Entity\Master\ProductStatus;
use Eccube\Form\Type\Admin\Purchase\PurchaseListType;
use Eccube\Service\Csv\Exporter\RestockListPdfSectionBuilder;
use Eccube\Util\SqlUtil;
use Eccube\Util\StringUtil;

/**
 * @extends AbstractRepository<DtbBuyOrder>
 */
class DtbBuyOrderRepository extends AbstractRepository
{
    public const DATE_FROM = '_date_from';
    public const DATE_TO = '_date_to';

    /**
     * @var array<string, string>
     */
    private array $sortKeys = [
        'default' => 'b.id',
        'orderDate' => 'b.orderDate',
    ];

    public function __construct(ManagerRegistry $registry)
    {
        parent::__construct($registry, DtbBuyOrder::class);
    }

    /**
     * Get Sort keys
     *
     * @return array<string, string>
     */
    public function getSortKeys(): array
    {
        return $this->sortKeys;
    }

    /**
     * 買取一覧
     * 検索条件に該当するデータを取得
     *
     * @param array<string, mixed> $searchData
     *
     * @return QueryBuilder
     */
    public function getQueryBuilderBySearchData(array $searchData): QueryBuilder
    {
        $sortKey = $this->sortKeys;

        $qb = $this->createQueryBuilder('b');
        $qb->select(['b', 'bos'])
            ->join('b.BuyOrderStatus', 'bos');

        // 現在の進捗ステータスによる検索
        $BuyOrderStatuses = $searchData['buy_order_status'] ?? [];
        if ($BuyOrderStatuses instanceof ArrayCollection) {
            $BuyOrderStatuses = $BuyOrderStatuses->toArray();
        }
        if ($BuyOrderStatuses !== []) {
            $qb->andWhere('b.BuyOrderStatus IN (:BuyOrderStatuses)')
            ->setParameter('BuyOrderStatuses', $BuyOrderStatuses);
        }

        // 進捗ステータス履歴による検索
        foreach (MtbBuyOrderStatus::BUY_ORDER_STATUS as $buyOrderStatusId => $buyOrderStatusName) {
            $periodQueryArr = [];
            $dateFromStatus = $buyOrderStatusName.self::DATE_FROM;
            $dateToStatus = $buyOrderStatusName.self::DATE_TO;

            if (empty($searchData[$dateFromStatus]) && empty($searchData[$dateToStatus])) {
                continue;
            }

            $periodQueryArr[] = $qb->expr()->eq('b', "bh{$buyOrderStatusId}.BuyOrder");
            $periodQueryArr[] = $qb->expr()->eq("IDENTITY(bh{$buyOrderStatusId}.BuyOrderStatus)", $buyOrderStatusId);

            if (!empty($searchData[$dateFromStatus])) {
                $fromDate = clone $searchData[$dateFromStatus];
                $fromDate->setTime(0, 0, 0);
                $periodQueryArr[] = $qb->expr()->gte("bh{$buyOrderStatusId}.createDate", ":from{$buyOrderStatusId}");
                $qb->setParameter("from{$buyOrderStatusId}", $fromDate);
            }
            if (!empty($searchData[$dateToStatus])) {
                $toDate = clone $searchData[$dateToStatus];
                $toDate->modify('+1 days');
                $toDate->setTime(0, 0, 0);
                $periodQueryArr[] = $qb->expr()->lt("bh{$buyOrderStatusId}.createDate", ":to{$buyOrderStatusId}");
                $qb->setParameter("to{$buyOrderStatusId}", $toDate);
            }
            $qb->join(DtbBuyOrderStatusHistory::class, "bh{$buyOrderStatusId}", Join::WITH, new Andx($periodQueryArr));
        }

        // 買取番号による検索
        $purchaseNumber = $searchData['purchase_number'] ?? null;
        if (StringUtil::isNotBlank($purchaseNumber)) {
            $qb->andWhere($qb->expr()->eq('b.id', ':purchaseNumber'))
                ->setParameter('purchaseNumber', (int) $purchaseNumber);
        }

        // 注文者名による検索
        $nameMulti = $searchData['name_multi'] ?? null;
        if (StringUtil::isNotBlank($nameMulti)) {
            $nameTexts = preg_split('/[\s, ]+/u', $nameMulti, -1, PREG_SPLIT_NO_EMPTY);
            if ($nameTexts) {
                $nameSearchColumns = [
                    'b' => ['lastName', 'firstName', 'lastNameKana', 'firstNameKana'],
                ];
                SqlUtil::multiTextQuery($qb, $nameTexts, $nameSearchColumns);
            }
        }

        // 商品名による検索
        if (isset($searchData['product_name_select']) && $searchData['product_name_select'] === PurchaseListType::PRODUCT_NAME_SEARCH_OR) {
            $nameOrQuery = [];
            foreach (range(1, PurchaseListType::PRODUCT_NAME_FORM_NUM) as $num) {
                $productNameKey = 'product_name'.$num;
                if (isset($searchData[$productNameKey]) && StringUtil::isNotBlank($searchData[$productNameKey])) {
                    $nameOrQuery[] = $qb->expr()->like("p{$num}.name", ':product_name'.$num);
                    $nameOrQuery[] = $qb->expr()->like("p{$num}.name_en", ':product_name'.$num);
                    $productName = '%'.addcslashes($searchData[$productNameKey], '%_').'%';
                    $qb->join('b.BuyMainCards', "bmc{$num}")
                        ->join("bmc{$num}.Product", "p{$num}")
                        ->setParameter('product_name'.$num, $productName);
                }
            }
            if (count($nameOrQuery) > 0) {
                $qb->andWhere(new Orx($nameOrQuery));
            }
        } else {
            foreach (range(1, PurchaseListType::PRODUCT_NAME_FORM_NUM) as $num) {
                $productNameKey = 'product_name'.$num;
                $nameAndQuery = [];
                if (isset($searchData[$productNameKey]) && StringUtil::isNotBlank($searchData[$productNameKey])) {
                    $nameAndQuery[] = $qb->expr()->like("p{$num}.name", ':product_name'.$num);
                    $nameAndQuery[] = $qb->expr()->like("p{$num}.name_en", ':product_name'.$num);
                    $productName = '%'.addcslashes($searchData[$productNameKey], '%_').'%';
                    $qb->join('b.BuyMainCards', "bmc{$num}")
                        ->join("bmc{$num}.Product", "p{$num}")
                        ->setParameter('product_name'.$num, $productName);
                }
                if (count($nameAndQuery) > 0) {
                    $qb->andWhere(new Orx($nameAndQuery));
                }
            }
        }

        // 本人確認ステータス
        if (isset($searchData['identityConfirmStatus']) && $searchData['identityConfirmStatus'] instanceof ArrayCollection && !$searchData['identityConfirmStatus']->isEmpty()) {
            $identityConfirmStatusArray = [];
            foreach ($searchData['identityConfirmStatus'] as $status) {
                if ($status instanceof \Eccube\Entity\Master\MtbIdentityConfirmStatus) {
                    $identityConfirmStatusArray[] = $status->getId();
                }
            }
            if (count($identityConfirmStatusArray) > 0) {
                $qb->innerJoin(
                    DtbPlayer::class,
                    'pl',
                    Join::WITH,
                    new Andx([
                        $qb->expr()->eq('pl.Customer', 'b.Customer'),
                        $qb->expr()->in('IDENTITY(pl.IdentityConfirmStatus)', $identityConfirmStatusArray),
                    ])
                );
            }
        }

        // 利用回数
        $orderCountConditions = [];
        if (!empty($searchData['orderCountFrom'])) {
            $orderCountConditions[] = $qb->expr()->gte($qb->expr()->count('bs.id'), ':orderCountFrom');
            $qb->setParameter('orderCountFrom', $searchData['orderCountFrom']);
        }
        if (!empty($searchData['orderCountTo'])) {
            $orderCountConditions[] = $qb->expr()->lte($qb->expr()->count('bs.id'), ':orderCountTo');
            $qb->setParameter('orderCountTo', $searchData['orderCountTo']);
        }
        if (count($orderCountConditions) > 0) {
            $subQuery = $this->createQueryBuilder('bs')
                ->select('IDENTITY(bs.Customer)')
                ->groupBy('bs.Customer')
                ->having(new Andx($orderCountConditions));
            $qb->andWhere($qb->expr()->in('IDENTITY(b.Customer)', $subQuery->getDQL()));
        }

        // 棚戻し未完了のみ表示
        if (!empty($searchData['restock_incomplete_only'])) {
            $qb->andWhere($qb->expr()->eq('b.restockedFlg', ':restockedFlg'))
                ->setParameter('restockedFlg', false);
        }

        // Order By
        $sort = $searchData['sort'];
        $order = $searchData['order'];
        if (isset($sortKey[$sort])) {
            $sortKeys = explode(',', $sortKey[$sort]);
            foreach ($sortKeys as $sortColumn) {
                $qb->addOrderBy(trim($sortColumn), $order);
            }
        }

        return $qb;
    }

    //     /**
    //      * 買取一覧の件数を返す
    //      *
    //      * @param array<string, mixed> $searchData

