namespace Eccube\Service\Admin\Purchase;

use Eccube\Entity\DtbBuyMainCard;
use Eccube\Entity\DtbBuyOrder;
use Eccube\Entity\Master\MtbOption;
use Eccube\Repository\DtbBuyOrderRepository;
use Eccube\Repository\Master\MtbOptionRepository;

/**
 * 買取一覧検索結果の表示用データ（additionalData・キャンセルID・買取詳細ソート済み）を取得する
 */
class PurchaseSearchAction
{
    public function __construct(
        private DtbBuyOrderRepository $buyOrderRepository,
        private MtbOptionRepository $mtbOptionRepository,
    ) {
    }

    /**
     * 表示ページ分の 顧客情報・キャンセル含む買取ID・買取詳細列表示データ を返す
     *
     * @param iterable<DtbBuyOrder> $BuyOrders 表示対象の買取注文（pagination の items）
     *
     * @return array{
     *   additionalDataList: array<int, array<string, mixed>>,
     *   buyOrderIdsWithCancel: array<int, int>,
     *   bulkPurchaseSortedBuyMainCardsByOrder: array<int, DtbBuyMainCard[]>,
     *   bulkPurchaseId: int|null
     * }
     */
    public function handle(iterable $BuyOrders): array
    {
        $BulkOption = $this->mtbOptionRepository->findOneBy(['option_key' => MtbOption::BULK_PURCHASE_ID]);
        $bulkPurchaseId = $BulkOption !== null && ctype_digit($BulkOption->getOptionValue()) ? (int) $BulkOption->getOptionValue() : null;

        $customerIds = [];
        $buyOrderIds = [];
        $BuyOrderIdToBuyMainCards = [];
        foreach ($BuyOrders as $BuyOrder) {
            $customerIds[] = $BuyOrder->getCustomer()->getId();
            $buyOrderIds[] = $BuyOrder->getId();
            $BuyOrderIdToBuyMainCards[$BuyOrder->getId()] = $BuyOrder->getBulkPurchaseSortedBuyMainCards($bulkPurchaseId);
        }

        if ($buyOrderIds === []) {
            return [
                'additionalDataList' => [],
                'buyOrderIdsWithCancel' => [],
                'bulkPurchaseSortedBuyMainCardsByOrder' => [],
                'bulkPurchaseId' => $bulkPurchaseId,
            ];
        }

        $additionalRows = $this->buyOrderRepository->findCustomerDisplayDataByConditions(['customerIds' => array_unique($customerIds)]);
        $additionalDataList = array_column($additionalRows, null, 'customerId');
        $buyOrderIdsWithCancel = $this->buyOrderRepository->getBuyOrderIdsWithCancel($buyOrderIds);

        return [
            'additionalDataList' => $additionalDataList,
            'buyOrderIdsWithCancel' => $buyOrderIdsWithCancel,
            'bulkPurchaseSortedBuyMainCardsByOrder' => $BuyOrderIdToBuyMainCards,
            'bulkPurchaseId' => $bulkPurchaseId,
        ];
    }
}

