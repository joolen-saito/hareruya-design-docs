   335	    /**
   336	     * 買取一覧表示用の顧客データ（利用回数・本人確認ステータス等）を条件で取得する
   337	     *
   338	     * @param array{customerIds?: int[], buyOrderIds?: int[]} $conditions
   339	     *
   340	     * @return array<int, array{orderCount: int, identityConfirmStatusId: int, identityConfirmStatusNameJp: string, customerId: int}>
   341	     */
   342	    public function findCustomerDisplayDataByConditions(array $conditions): array
   343	    {
   344	        $qb = $this->createQueryBuilder('bo')
   345	            ->join(DtbPlayer::class, 'p', Join::WITH, 'p.Customer = bo.Customer')
   346	            ->join('p.IdentityConfirmStatus', 'ics')
   347	            ->select([
   348	                'COUNT(bo) AS orderCount',
   349	                'ics.id AS identityConfirmStatusId',
   350	                'ics.nameJp AS identityConfirmStatusNameJp',
   351	                'IDENTITY(bo.Customer) AS customerId',
   352	            ])
   353	            ->groupBy('bo.Customer')
   354	            ->addGroupBy('ics.id')
   355	            ->addGroupBy('ics.nameJp');
   356	
   357	        if (!empty($conditions['customerIds'])) {
   358	            $qb->andWhere($qb->expr()->in('IDENTITY(bo.Customer)', ':customerIds'))
   359	                ->setParameter('customerIds', $conditions['customerIds']);
   360	        }
   361	        if (!empty($conditions['buyOrderIds'])) {
   362	            $subQb = $this->createQueryBuilder('bos')
   363	                ->select('IDENTITY(bos.Customer)')
   364	                ->where($qb->expr()->in('bos.id', ':buyOrderIds'));
   365	            $qb->andWhere($qb->expr()->in('IDENTITY(bo.Customer)', $subQb->getDQL()))
   366	                ->setParameter('buyOrderIds', $conditions['buyOrderIds']);
   367	        }
   368	
   369	        return $qb->getQuery()->getResult();
   370	    }
