{# オリジナル: pf-eccube3/app/Plugin/HareruyaEc/Resource/template/admin/Purchase/purchaselist.twig #}
{% extends '@admin/default_frame.twig' %}

{% set menus = ['purchase_online', 'admin_purchase_list'] %}

{% block title %}{{ 'admin.purchase.online.title'|trans }}{% endblock %}
{% block sub_title %}{{ 'admin.purchase.online.list'|trans }}{% endblock %}

{% form_theme searchForm '@admin/Form/bootstrap_4_horizontal_layout.html.twig' %}

{% block stylesheet %}
{{ parent() }}
{# TODO: Bootstrap ドロップダウンの display:none 問題の一時的な回避策 - デザイン適用時に削除すること #}
<style>
#result_list__custom_csv_menu .dropdown-menu.show,
#result_list_main__sort_menu .dropdown-menu.show {
    display: block !important;
}
</style>
{% endblock stylesheet %}

{% block javascript %}
<script src="{{ asset('assets/js/select2.min.js', 'admin') }}"></script>
<script src="{{ asset('assets/js/sort-method-display.js', 'admin') }}"></script>
<script src="{{ asset('assets/js/Purchase/purchase.js', 'admin') }}"></script>
<script nonce="{{ csp_nonce }}">
$(function() {
    $('#page_count_pulldown').on('change', function () {
        const targetUrl = $(this).val();
        if (targetUrl) {
            window.location.href = targetUrl;
        }
    });
    $.ajax({
        url: '{{ asset('assets/img/svg.html', 'admin') }}',
        type: 'GET',
        dataType: 'html',
    }).done(function(data) {
        $('body').prepend(data);
    });
});
</script>
{% endblock javascript %}

{% block main %}
    <div class="c-outsideBlock">
        <form name="search_form" id="search_form" method="post" action="{{ url('admin_purchase_search', { 'page_no': 1}) }}">
            <div class="c-outsideBlock__contents search-box-inner">
                <div class="row mb-2">
                    <div class="col-6">
                        <label class="col-form-label" for="admin_purchase_list_buy_order_status">{{ 'admin.purchase.online.form.buy_order_status.label'|trans }}</label>
                        {{ form_widget(searchForm.buy_order_status) }}
                        {{ form_errors(searchForm.buy_order_status) }}
                    </div>
                    <div class="col-6">
                        <label class="col-form-label" for="admin_purchase_list_purchase_number">{{ 'admin.purchase.online.form.purchase_number.label'|trans }}</label>
                        {{ form_widget(searchForm.purchase_number) }}
                        {{ form_errors(searchForm.purchase_number) }}
                    </div>
                </div>
                <div class="row mb-2">
                    <div class="col-6">
                        <label class="col-form-label" for="admin_purchase_list_name_multi">{{ 'admin.purchase.online.form.name_multi.label'|trans }}</label>
                        {{ form_widget(searchForm.name_multi) }}
                        {{ form_errors(searchForm.name_multi) }}
                    </div>
                    <div class="col-6">
                        <label class="col-form-label">{{ 'admin.purchase.online.form.order_count.label'|trans }}</label>
                        <div class="row align-items-center">
                            <div class="col">
                                {{ form_widget(searchForm.orderCountFrom) }}
                                {{ form_errors(searchForm.orderCountFrom) }}
                            </div>
                            <div class="col-auto text-center"><span>{{ 'admin.common.separator__range'|trans }}</span></div>
                            <div class="col">
                                {{ form_widget(searchForm.orderCountTo) }}
                                {{ form_errors(searchForm.orderCountTo) }}
                            </div>
                        </div>
                    </div>
                </div>
                <div class="row mb-2">
                    <div class="col-12">
                        <label class="col-form-label">{{ 'admin.purchase.online.form.product_name.label'|trans }}</label>
                    </div>
                    {% for num in 1..constant('Eccube\\Form\\Type\\Admin\\Purchase\\PurchaseListType::PRODUCT_NAME_FORM_NUM') %}
                        <div class="col-6 col-md-3">
                            <div id="search_box_main__product_name{{ num }}" class="mb-2">
                                {{ form_widget(attribute(searchForm, 'product_name' ~ num)) }}
                                {{ form_errors(attribute(searchForm, 'product_name' ~ num)) }}
                            </div>
                        </div>
                    {% endfor %}
                </div>
                <div class="row mb-2">
                    <div class="col-6">
                        <label class="col-form-label">{{ 'admin.purchase.online.form.product_name_select.label'|trans }}</label>
                        {{ form_widget(searchForm.product_name_select) }}
                        {{ form_errors(searchForm.product_name_select) }}
                    </div>
                    <div class="col-6">
                        <label class="col-form-label">{{ 'admin.purchase.online.form.identity_confirm_status.label'|trans }}</label>
                        {{ form_widget(searchForm.identityConfirmStatus) }}
                        {{ form_errors(searchForm.identityConfirmStatus) }}
                    </div>
                </div>
                <div class="row mb-2">
                    {% for f in searchForm.getIterator %}
                        {% if f.vars.name matches '[.*_date_from$]' %}
                            {% set status = f.vars.name|replace({'_from':''}) %}
                            <div id="search_box_main__{{ status }}" class="col-12 col-md-4">
                                {% set label = 'admin.purchase.online.form.'~status~'.label' %}
                                <label class="col-form-label" for="admin_purchase_list_{{ status }}">{{ label|trans }}</label>
                                <div class="row align-items-center">
                                    <div class="col">
                                        {{ form_widget(f, {'attr': {'class': 'input_cal'}}) }}
                                        {{ form_errors(f) }}
                                    </div>
                                    <div class="col-auto text-center"><span>{{ 'admin.common.separator__range'|trans }}</span></div>
                        {% elseif f.vars.name matches '[.*_date_to$]' %}
                                    <div class="col">
                                        {{ form_widget(f, {'attr': {'class': 'input_cal'}}) }}
                                        {{ form_errors(f) }}
                                    </div>
                                </div>
                            </div>
                        {% endif %}
                    {% endfor %}
                </div>
                <div class="row mb-2">
                    <div class="col-12 col-md-4">
                        <div class="form-check">
                            {{ form_widget(searchForm.restock_incomplete_only) }}
                            {{ form_label(searchForm.restock_incomplete_only) }}
                        </div>
                        {{ form_errors(searchForm.restock_incomplete_only) }}
                    </div>
                </div>
            </div>
            <div class="c-outsideBlock__contents mb-5">
                <div class="row mb-2">
                    <div class="col-12">
                        <button type="button" class="btn btn-ec-conversion px-5 search-clear">{{ 'admin.purchase.online.form.clear_search_conditions.label'|trans }}</button>
                        <button type="submit" class="btn btn-ec-conversion px-5">{{ 'admin.common.search'|trans }}</button>
                    </div>
                </div>
                {% if pagination %}
                    <div class="row">
                        <div class="col-12">
                            <span class="fw-bold">{{ 'admin.common.search_result'|trans({'%count%': pagination.totalItemCount})|raw }}</span>
                        </div>
                    </div>
                {% endif %}
            </div>
        </form>
    </div>
    {% if pagination %}
        <div class="c-contentsArea__cols">
            <div class="c-contentsArea__primaryCol">
                <div class="c-primaryCol">
                    {% if pagination and pagination.totalItemCount > 0 %}
                        <form name="bulk_csv_export" id="bulk_csv_export" method="post">
                            <input type="hidden" name="{{ constant('Eccube\\Common\\Constant::TOKEN_NAME') }}" value="{{ csrf_token(constant('Eccube\\Common\\Constant::TOKEN_NAME')) }}">
                            <div class="row justify-content-between mb-2">
                                <div class="col-auto">
                                    <div id="result_list__custom_csv_menu" class="d-inline-block dropdown">
                                        <button type="button" class="btn btn-ec-regular dropdown-toggle" data-bs-toggle="dropdown" aria-expanded="false">
                                            {{ 'admin.common.download'|trans }}
                                        </button>
                                        <ul class="dropdown-menu dropdown-menu-end">
                                            <li><button type="submit" id="csvexport" class="dropdown-item" formaction="{{ url('admin_purchase_csv_export') }}">{{ 'admin.purchase.online.btn.csvexport'|trans }}</button></li>
                                            <li><button type="submit" id="csvexport_deposit" class="dropdown-item" formaction="{{ url('admin_purchase_csv_export_deposit') }}">{{ 'admin.purchase.online.btn.csvexport_deposit'|trans }}</button></li>
                                            <li><button type="submit" id="csvexport_product_list" class="dropdown-item text-left" formaction="{{ path('admin_purchase_csv_export_product_list', { type: 'sale' }) }}">{{ 'admin.purchase.online.btn.csvexport_product_list'|trans }}</button></li>
                                            <li><button type="submit" id="csv_export_product_cancel" class="dropdown-item text-left" formaction="{{ path('admin_purchase_csv_export_product_list', { type: 'notSale' }) }}">{{ 'admin.purchase.online.btn.csv_export_product_cancel'|trans }}</button></li>
                                            <li><button type="submit" id="csv_export_return_list" class="dropdown-item text-left" formaction="{{ path('admin_purchase_csv_export_return_list') }}">{{ 'admin.purchase.online.btn.csv_export_return_list'|trans }}</button></li>
                                            <li><button type="button" id="pdf_export_return_list" class="dropdown-item text-left" data-export-url="{{ path('admin_purchase_pdf_export_return_list') }}">{{ 'admin.purchase.online.btn.pdf_export_return_list'|trans }}</button></li>
                                        </ul>
                                    </div>
                                </div>
                                <div class="col-auto text-end">
                                    <div class="d-inline-block me-2 align-bottom">
                                        <select id="page_count_pulldown" class="form-select">
                                            {% for pageMax in pageMaxis %}
                                                <option {% if pageMax.name == page_count %} selected {% endif %} value="{{ path('admin_purchase_page', {'page_no': 1, 'page_count': pageMax.name}) }}">{{ 'admin.common.count'|trans({ '%count%': pageMax.name }) }}</option>
                                            {% endfor %}
                                        </select>
                                    </div>
                                    <div id="result_list_main__sort_menu" class="d-inline-block dropdown sort-dropdown">
                                        <button type="button" class="btn btn-ec-regular dropdown-toggle" data-bs-toggle="dropdown" aria-expanded="false">
                                            {{ 'admin.common.sort_order'|trans }}：{{ ('admin.purchase.online.btn.purchase.' ~ sort_key)|trans }} | {{ ('admin.common.sort_' ~ order_key|lower)|trans }}
                                        </button>
                                        <ul class="dropdown-menu dropdown-menu-end">
                                            {% for sortKey in sortKeys %}
                                                <li class="toggle-sort-key{% if sortKey == sort_key %} font-weight-bold{% endif %}" data-name="{{ sortKey }}">
                                                    <a class="dropdown-item" href="javascript:void(0)">{{ ('admin.purchase.online.btn.purchase.' ~ sortKey)|trans }}</a>
                                                    <ul class="dropdown-menu dropdown-menu-sort" id="dropdown-menu-{{ sortKey }}">
                                                        <li><a class="dropdown-item" href="{{ path('admin_purchase_page', {'page_no': 1, 'sort': sortKey, 'order': 'ASC'}) }}">{{ 'admin.common.sort_asc'|trans }}</a></li>
                                                        <li><a class="dropdown-item" href="{{ path('admin_purchase_page', {'page_no': 1, 'sort': sortKey, 'order': 'DESC'}) }}">{{ 'admin.common.sort_desc'|trans }}</a></li>
                                                    </ul>
                                                </li>
                                            {% endfor %}
                                        </ul>
                                    </div>
                                </div>
                            </div>
                            <div id="result_list_main" class="card rounded border-0 mb-4 d-block">
                                <div id="result_list_main__list" class="card-body p-0">
                                    <div class="table-responsive">
                                        <table class="table table-sm table-striped">
                                            <thead>
                                                <tr id="result_list_main__header">
                                                    <th><input type="checkbox" id="allCheck"></th>
                                                    <th id="result_list_main__header_purchase_number">買取番号</th>
                                                    <th id="result_list_main__header_purchase_request_date">買取依頼日</th>
                                                    <th id="result_list_main__header_customer_name">買取依頼者氏名</th>
                                                    <th id="result_list_main__header_identification">本人確認</th>
                                                    <th id="result_list_main__header_purchase_detail">買取詳細</th>
                                                    <th id="result_list_main__header_package_count">箱数</th>
                                                    <th id="result_list_main__header_purchase_status">買取状況</th>
                                                    <th id="result_list_main__header_purchase_order_coount">利用回数</th>
                                                    <th id="result_list_main__header_menu_box"></th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                {% for Purchase in pagination %}
                                                    {% set customerId = Purchase.Customer.id %}
                                                    {% set additionalData = attribute(additionalDataList|default([]), customerId)|default(null) %}
                                                    {% set hasCancel = Purchase.id in (buyOrderIdsWithCancel|default([])) %}
                                                    <tr id="result_list_main__item--{{ Purchase.id }}">
                                                        <td>
                                                            <input type="checkbox" name="buyOrderIds[]" class="searched_buy_order_id" value="{{ Purchase.id }}" buyOrderId="{{ Purchase.id }}">
                                                        </td>
                                                        <td id="result_list_main__purchase_number--{{ Purchase.id }}">
                                                            <a href="{{ url('admin_purchase_edit', {'id': Purchase.id}) }}" class="{% if hasCancel %}text-danger{% endif %}">
                                                                {{ "%07d"|format(Purchase.id) }}
                                                            </a>
                                                            {% if hasCancel %}<div class="small m-0 text-danger">{{ 'admin.purchase.alert.has_cancel'|trans }}</div>{% endif %}
                                                        </td>
                                                        <td id="result_list_main__purchase_request_date--{{ Purchase.id }}">
                                                            {{ Purchase.order_date|date('Y-m-d H:i:s') }}
                                                        </td>
                                                        <td id="result_list_main__purchase_customer_name--{{ Purchase.id }}">
                                                            <a href="" class="post_name">{{ Purchase.last_name }}&nbsp;{{ Purchase.first_name }}</a>
                                                        </td>
                                                        <td id="result_list_main__purchase_identification--{{ Purchase.id }}" class="text-center">
                                                            {% set identityConfirmStatusId = attribute(additionalData, 'identityConfirmStatusId')|default(null) %}
                                                            {% if identityConfirmStatusId == constant('\\Eccube\\Entity\\Master\\MtbIdentityConfirmStatus::STATUS_CONFIRMED') %}
                                                                {{ attribute(additionalData, 'identityConfirmStatusNameJp') }}
                                                            {% elseif identityConfirmStatusId == constant('\\Eccube\\Entity\\Master\\MtbIdentityConfirmStatus::STATUS_REGISTERED_MAIL_CONFIRMED') %}
                                                                書留確認済み
                                                            {% elseif identityConfirmStatusId == constant('\\Eccube\\Entity\\Master\\MtbIdentityConfirmStatus::STATUS_NOW_CONFIRMING') %}
                                                                <svg class="cb cb-tag"><use xlink:href="#cb-eye" /></svg>
                                                            {% else %}
                                                                <svg class="cb cb-tag"><use xlink:href="#cb-warning" /></svg>
