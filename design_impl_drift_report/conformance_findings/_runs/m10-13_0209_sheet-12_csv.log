    16	namespace Eccube\Form\Type\Admin;
    17	
    18	use Doctrine\Common\Collections\Criteria;
    19	use Doctrine\ORM\EntityRepository;
    20	use Eccube\Entity\Csv;
    21	use Eccube\Entity\DtbCsvCsvExtension;
    22	use Eccube\Entity\Master\CsvType;
    23	use Eccube\Repository\CsvRepository;
    24	use Symfony\Bridge\Doctrine\Form\Type\EntityType;
    25	use Symfony\Component\Form\AbstractType;
    26	use Symfony\Component\Form\Extension\Core\Type\TextType;
    27	use Symfony\Component\Form\FormBuilderInterface;
    28	use Symfony\Component\OptionsResolver\OptionsResolver;
    29	use Symfony\Component\Validator\Constraints\NotBlank;
    30	
    31	class CustomCsvType extends AbstractType
    32	{
    33	    public const CSV_TYPES = [
    34	        CsvType::CSV_TYPE_PRODUCT,
    35	        CsvType::CSV_TYPE_CUSTOMER,
    36	        CsvType::CSV_TYPE_ORDER,
    37	        CsvType::CSV_TYPE_SHIPPING,
    38	        CsvType::CSV_TYPE_STOCK,
    39	        CsvType::CSV_TYPE_STOCK_MOVE,
    40	        CsvType::CSV_TYPE_STOCK_SPLIT,
    41	    ];
    42	
    43	    private CsvRepository $csvRepository;
    44	
    45	    public function __construct(
    46	        CsvRepository $csvRepository,
    47	    ) {
    48	        $this->csvRepository = $csvRepository;
    49	    }
    50	
    51	    public function buildForm(FormBuilderInterface $builder, array $options): void
    52	    {
    53	        $CsvType = $options['csvType'];
    54	        $CsvExtension = $options['csvExtension'];
    55	        $isCsvExtensionExisting = $CsvExtension->getId() !== null;
    56	
    57	        $csvOutput = [];
    58	        $csvOutputIds = [];
    59	        if ($isCsvExtensionExisting) {
    60	            $CsvCsvExtensions = $CsvExtension->getCsvCsvExtensions()->toArray();
    61	            usort($CsvCsvExtensions, function (DtbCsvCsvExtension $a, DtbCsvCsvExtension $b) {
    62	                return $a->getRank() <=> $b->getRank();
    63	            });
    64	            $csvOutput = array_map(function (DtbCsvCsvExtension $CsvCsvExtension) {
    65	                return $CsvCsvExtension->getCsv();
    66	            }, $CsvCsvExtensions);
    67	            $csvOutputIds = array_map(function (Csv $Csv) {
    68	                return $Csv->getId();
    69	            }, $csvOutput);
    70	        }
    71	
    72	        $criteria = new Criteria();
    73	        if (!empty($csvOutputIds)) {
    74	            $criteria->where($criteria->expr()->notIn('id', $csvOutputIds));
    75	        }
    76	        $criteria->andWhere($criteria->expr()->eq('CsvType', $CsvType))
    77	            ->orderBy(['sort_no' => 'ASC']);
    78	        $csvNotOutput = $this->csvRepository->matching($criteria);
    79	
    80	        $builder
    81	            ->add('csv_type', EntityType::class, [
    82	                'class' => 'Eccube\Entity\Master\CsvType',
    83	                'required' => true,
    84	                'constraints' => [
    85	                    new NotBlank(),
    86	                ],
    87	                'query_builder' => function (EntityRepository $er) {
    88	                    return $er->createQueryBuilder('c')
    89	                        ->where('c.id IN (:csvIds)')
    90	                        ->setParameter('csvIds', self::CSV_TYPES);
    91	                },
    92	                'data' => $CsvType,
    93	            ])
    94	            ->add('csv_extensions', EntityType::class, [
    95	                'class' => 'Eccube\Entity\DtbCsvExtension',
    96	                'required' => false,
    97	                'query_builder' => function (EntityRepository $er) use ($CsvType) {
    98	                    return $er->createQueryBuilder('ce')
    99	                        ->join('ce.CsvType', 'ct', 'WITH', 'ct = :csvType')
   100	                        ->setParameter('csvType', $CsvType);
   101	                },
   102	                'placeholder' => '新規作成',
   103	                'data' => $isCsvExtensionExisting ? $CsvExtension : null,
   104	            ])
   105	            ->add('name', TextType::class, [
   106	                'required' => true,
   107	                'constraints' => [
   108	                    new NotBlank(),
   109	                ],
   110	                'attr' => [
   111	                    'placeholder' => 'カスタムCSV名称',
   112	                ],
   113	                'data' => $isCsvExtensionExisting ? $CsvExtension->getName() : null,
   114	            ])
   115	            ->add('csv_not_output', EntityType::class, [
   116	                'class' => 'Eccube\Entity\Csv',
   117	                'choice_label' => 'disp_name',
   118	                'required' => false,
   119	                'expanded' => false,
   120	                'multiple' => true,
   121	                'choices' => $csvNotOutput,
   122	            ])
   123	            ->add('csv_output', EntityType::class, [
   124	                'class' => 'Eccube\Entity\Csv',
   125	                'choice_label' => 'disp_name',
   126	                'required' => false,
   127	                'expanded' => false,
   128	                'multiple' => true,
   129	                'choices' => $csvOutput,
   130	            ])
   131	        ;
   132	    }
   133	
   134	    public function configureOptions(OptionsResolver $resolver): void
   135	    {
   136	        $resolver->setRequired(['csvType', 'csvExtension']);
   137	        $resolver->setAllowedTypes('csvType', 'Eccube\Entity\Master\CsvType');
   138	        $resolver->setAllowedTypes('csvExtension', 'Eccube\Entity\DtbCsvExtension');
   139	    }
   140	
   141	    public function getBlockPrefix(): string
   142	    {
   143	        return 'admin_custom_csv';
   144	    }
   145	}

