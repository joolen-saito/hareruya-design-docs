    16	namespace Eccube\Service\Csv\Exporter;
    17	
    18	use Eccube\Entity\DtbCsvExtension;
    19	use Eccube\Entity\ExportCsvRow;
    20	use Eccube\Entity\ProductStock;
    21	use Eccube\Repository\DtbCsvCsvExtensionRepository;
    22	use Eccube\Repository\ProductStockRepository;
    23	use Eccube\Service\Admin\Stock\ActionInput\StockListSearchInput;
    24	use Eccube\Service\CsvExportService;
    25	use Symfony\Component\HttpFoundation\StreamedResponse;
    26	
    27	/**
    28	 * 在庫情報カスタムCSV出力（M04-01）
    29	 *
    30	 * DtbCsvExtension で定義されたカラム設定に基づき、在庫一覧の検索条件に
    31	 * 一致する ProductStock を CSV 出力する。
    32	 */
    33	class StockCustomCsvExportService
    34	{
    35	    public function __construct(
    36	        private readonly CsvExportService $csvExportService,
    37	        private readonly DtbCsvCsvExtensionRepository $dtbCsvCsvExtensionRepository,
    38	        private readonly ProductStockRepository $productStockRepository,
    39	    ) {
    40	    }
    41	
    42	    public function export(DtbCsvExtension $csvExtension, StockListSearchInput $input): StreamedResponse
    43	    {
    44	        set_time_limit(0);
    45	
    46	        $csvExtension->setCsvs($this->dtbCsvCsvExtensionRepository->findCsvOrderbyRank((int) $csvExtension->getId()));
    47	        $qb = $this->productStockRepository->getQueryBuilderForAdminStockList($input);
    48	
    49	        $response = new StreamedResponse();
    50	        $response->setCallback(function () use ($csvExtension, $qb): void {
    51	            $this->csvExportService->setCsvsAndCsvType($csvExtension);
    52	            $this->csvExportService->exportHeader();
    53	            $this->csvExportService->setExportQueryBuilder($qb);
    54	            $this->csvExportService->exportData(function ($entity, CsvExportService $csvService): void {
    55	                $this->exportRow($entity, $csvService);
    56	            });
    57	        });
    58	
    59	        $filename = 'stock_custom_'.(new \DateTime())->format('YmdHis').'.csv';
    60	        $response->headers->set('Content-Type', 'application/octet-stream');
    61	        $response->headers->set('Content-Disposition', 'attachment; filename='.$filename);
    62	
    63	        log_info('在庫情報カスタムCSV出力完了. ファイル名: '.$filename);
    64	
    65	        return $response;
    66	    }
    67	
    68	    private function exportRow(ProductStock $productStock, CsvExportService $csvExportService): void
    69	    {
    70	        $pc = $productStock->getProductClass();
    71	        $product = $pc->getProduct();
    72	        $cardDetail = $product->getCardDetail();
    73	        $card = $cardDetail?->getCard();
    74	
    75	        $exportRow = new ExportCsvRow();
    76	        foreach ($csvExportService->getCsvs() as $csv) {
    77	            $entityName = str_replace('\\\\', '\\', $csv->getEntityName());
    78	            switch ($entityName) {
    79	                case 'Eccube\Entity\ProductStock':
    80	                    $exportRow->setData($csvExportService->getData($csv, $productStock));
    81	                    break;
    82	                case 'Eccube\Entity\ProductClass':
    83	                    $exportRow->setData($csvExportService->getData($csv, $pc));
    84	                    break;
    85	                case 'Eccube\Entity\Product':
    86	                    $exportRow->setData($csvExportService->getData($csv, $product));
    87	                    break;
    88	                case 'Eccube\Entity\Master\MtbCardDetail':
    89	                    $exportRow->setData($cardDetail !== null ? $csvExportService->getData($csv, $cardDetail) : null);
    90	                    break;
    91	                case 'Eccube\Entity\Master\MtbCard':
    92	                    $exportRow->setData($card !== null ? $csvExportService->getData($csv, $card) : null);
    93	                    break;
    94	                case 'Eccube\Entity\DtbSalesQuantity':
    95	                    $salesQuantity = $pc->getShopSalesQuantity((int) $productStock->getBaseInfo()->getId());
    96	                    if ($salesQuantity === null) {
    97	                        $exportRow->setData(null);
    98	                        break;
    99	                    }
   100	                    // DtbSalesQuantity getters use _NN suffix (e.g. getSalesQuantity_01).
   101	                    // AbstractEntity::offsetGet uses classify() which drops the underscore,
   102	                    // so we build the getter name directly: sales_quantity_01 → getSalesQuantity_01
   103	                    $field = $csv->getFieldName();
   104	                    $getter = 'get'.str_replace(' ', '', ucwords(str_replace('_', ' ', substr($field, 0, -3)))).substr($field, -3);
   105	                    $exportRow->setData(method_exists($salesQuantity, $getter) ? (string) $salesQuantity->$getter() : null);
   106	                    break;
   107	                case 'Eccube\Entity\DtbStockUpQuantity':
   108	                    $stockUpQuantity = $pc->getShopStockUpQuantity((int) $productStock->getBaseInfo()->getId());
   109	                    $exportRow->setData($stockUpQuantity !== null ? $csvExportService->getData($csv, $stockUpQuantity) : null);
   110	                    break;
   111	                default:
   112	                    $exportRow->setData(null);
   113	                    break;
   114	            }
   115	            $exportRow->pushData();
   116	        }
   117	        $csvExportService->fputcsv($exportRow->getRow());
   118	    }
   119	}

