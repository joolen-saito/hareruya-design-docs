    20	use Eccube\Repository\DtbStockMoveTransferRepository;
    21	use Eccube\Service\Admin\Stock\ActionInput\StockMoveInstructionDetailUpdateInput;
    22	
    23	/**
    24	 * 在庫移動指示詳細更新（送り状Noを紐づく Transfer に同期）
    25	 */
    26	readonly class StockMoveInstructionDetailUpdateAction
    27	{
    28	    public function __construct(
    29	        private EntityManagerInterface $EntityManager,
    30	        private DtbStockMoveTransferRepository $stockMoveTransferRepository,
    31	    ) {
    32	    }
    33	
    34	    public function handle(StockMoveInstructionDetailUpdateInput $input): void
    35	    {
    36	        $instruction = $input->Instruction;
    37	        $instruction->setUpdateDate(new \DateTime());
    38	        $instruction->setUpdateMember($input->UpdateMember);
    39	
    40	        $trackingNo = $instruction->getTrackingNo();
    41	        $Transfers = $this->stockMoveTransferRepository->findBy(
    42	            ['moveInstructionId' => $instruction->getId()],
    43	            ['id' => 'ASC']
    44	        );
    45	        $MovingStatus = $trackingNo !== null && $trackingNo !== ''
    46	            ? $this->EntityManager->find(MtbStockMoveTransferStatus::class, MtbStockMoveTransferStatus::STATUS_MOVING)
    47	            : null;
    48	        foreach ($Transfers as $Transfer) {
    49	            $Transfer->setTrackingNo($trackingNo);
    50	            if ($MovingStatus !== null) {
    51	                $Transfer->setMoveTransferStatus($MovingStatus);
    52	            }
    53	        }
    54	
    55	        $this->EntityManager->flush();
    56	    }
    57	}

