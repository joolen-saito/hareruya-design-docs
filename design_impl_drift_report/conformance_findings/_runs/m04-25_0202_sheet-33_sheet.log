from html.parser import HTMLParser
p='excel_to_html/output/0202_基本設計仕様書(在庫管理機能).html'
class P(HTMLParser):
    def __init__(self): super().__init__(); self.insec=False; self.depth=0; self.text=[]
    def handle_starttag(self, tag, attrs):
        a=dict(attrs)
        if a.get('id')=='sheet-33': self.insec=True; self.depth=1
        elif self.insec: self.depth+=1
        if self.insec and tag in ('tr','p','li','h1','h2','h3','h4','div','td','th'):
            self.text.append('\\n')
    def handle_endtag(self, tag):
        if self.insec:
            self.depth-=1
            if self.depth==0: self.insec=False
    def handle_data(self, data):
        if self.insec:
            s=' '.join(data.split())
            if s: self.text.append(s+' ')
parser=P(); parser.feed(open(p,encoding='utf-8').read())
for i,line in enumerate(''.join(parser.text).splitlines(),1):
    line=' '.join(line.split())
    if line: print(f'{i}: {line}')
