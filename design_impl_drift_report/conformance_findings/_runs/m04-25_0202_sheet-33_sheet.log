   289	    /**
   290	     * 在庫移動指示削除（送り状No未登録のみ可。紐づく Transfer の move_instruction_id / luggage_no を null にしてから削除）
   291	     *
   292	     * @throws StockMoveInstructionDeleteException 送り状No.登録済みの場合は削除不可
   293	     */
   294	    private function deleteInstruction(DtbStockMoveInstruction $Instruction): void
   295	    {
   296	        $trackingNo = $Instruction->getTrackingNo();
   297	        if ($trackingNo !== null && $trackingNo !== '') {
   298	            throw new StockMoveInstructionDeleteException();
   299	        }
   300	
   301	        $Moves = $this->stockMoveTransferRepository->findBy(
   302	            ['moveInstructionId' => $Instruction->getId()],
   303	            ['id' => 'ASC']
   304	        );
   305	        foreach ($Moves as $Move) {
   306	            $Move->setTrackingNo(null);
   307	            $Move->setMoveInstructionId(null);
   308	        }
   309	
   310	        $this->entityManager->remove($Instruction);
   311	        $this->entityManager->flush();
   312	    }
