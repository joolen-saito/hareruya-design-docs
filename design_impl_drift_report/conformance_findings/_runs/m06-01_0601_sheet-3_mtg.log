   113	                    'birth' => $otcBuyOrder['birth']->format('Y-m-d'),
   114	                    'telNo' => $otcBuyOrder['telNo'],
   115	                    'zipcode' => $otcBuyOrder['zipcode'],
   116	                    'jobName' => $otcBuyOrder['jobName'] ?? null,
   117	                    'address' => $address,
   118	                ],
   119	            ];
   120	        }, $otcBuyOrders);
   121	
   122	        return new JsonResponse($response);
