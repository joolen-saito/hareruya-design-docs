   399	use Doctrine\Common\Collections\ArrayCollection;
   400	use Eccube\Entity\DtbOtcBuyOrderDetail;
   401	use Eccube\Repository\DtbOtcBuyOrderDetailRepository;
   402	use Eccube\Service\App\MTGBuyer\V1\Admin\OtcBuyOrder\ActionInput\RebuildOtcBuyOrderDetailInput;
   403	use Eccube\Service\EntityManager\OtcBuyOrderDetailEntityManager;
   404	
   405	class RebuildOtcBuyOrderDetail
   406	{
   407	    public function __construct(private readonly OtcBuyOrderDetailEntityManager $otcBuyOrderDetailEntityManager, private readonly DtbOtcBuyOrderDetailRepository $otcBuyOrderDetailRepository)
   408	    {
   409	    }
   410	
   411	    /**
   412	     * order_details を “全消し→再作成” で反映
   413	     *
   414	     * @param RebuildOtcBuyOrderDetailInput $input
   415	     *
   416	     * @return array<DtbOtcBuyOrderDetail>
   417	     */
   418	    public function rebuild(RebuildOtcBuyOrderDetailInput $input): array
   419	    {
   420	        $OtcBuyOrder = $input->OtcBuyOrder;
   421	        $orderDetails = $input->orderDetails;
   422	
   423	        // 既存の注文詳細を削除 (DBから削除)
   424	        $this->otcBuyOrderDetailRepository->deleteByOtcBuyOrder($OtcBuyOrder);
   425	
   426	        // 一括DELETEはメモリ上のコレクションは更新しないため、明示的に空にする
   427	        $OtcBuyOrder->setOtcBuyOrderDetails(new ArrayCollection());
   428	
   429	        $NewOtcBuyOrderDetails = [];
   430	        foreach ($orderDetails as $detail) {
   431	            $NewOtcBuyOrderDetails[] = $this->otcBuyOrderDetailEntityManager->create($OtcBuyOrder, $detail);
   432	        }
   433	
   434	        return $NewOtcBuyOrderDetails;
   435	    }
   436	}
