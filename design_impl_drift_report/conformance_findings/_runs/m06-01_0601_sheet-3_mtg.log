   510	
   511	use Doctrine\Common\Collections\ArrayCollection;
   512	use Doctrine\ORM\EntityManagerInterface;
   513	use Eccube\Entity\DtbOtcBuyOrderStock;
   514	use Eccube\Entity\ProductClass;
   515	use Eccube\Exception\App\InvalidRequestParameterException;
   516	use Eccube\Repository\DtbOtcBuyOrderStockHistoryRepository;
   517	use Eccube\Repository\DtbOtcBuyOrderStockRepository;
   518	use Eccube\Service\App\MTGBuyer\V1\Admin\OtcBuyOrder\ActionInput\RebuildOtcBuyOrderStockAndHistoryInput;
   519	use Eccube\Service\EntityManager\OtcBuyOrderStockEntityManager;
   520	use Eccube\Service\EntityManager\OtcBuyOrderStockHistoryEntityManager;
   521	
   522	class RebuildOtcBuyOrderStockAndHistory
   523	{
   524	    public function __construct(private readonly EntityManagerInterface $entityManager, private readonly DtbOtcBuyOrderStockRepository $otcBuyOrderStockRepository, private readonly DtbOtcBuyOrderStockHistoryRepository $otcBuyOrderStockHistoryRepository, private readonly OtcBuyOrderStockEntityManager $otcBuyOrderStockEntityManager, private readonly OtcBuyOrderStockHistoryEntityManager $otcBuyOrderStockHistoryEntityManager)
   525	    {
   526	    }
   527	
   528	    /**
   529	     * 店頭買取実在庫と店頭買取実在庫履歴を “全消し→再作成” で反映
   530	     *
   531	     * @param RebuildOtcBuyOrderStockAndHistoryInput $input
   532	     *
   533	     * @return array<DtbOtcBuyOrderStock>
   534	     */
   535	    public function rebuild(RebuildOtcBuyOrderStockAndHistoryInput $input): array
   536	    {
   537	        $OtcBuyOrder = $input->OtcBuyOrder;
   538	        $productClassQuantities = $input->productClassQuantities;
   539	        $productClassSubtotals = $input->productClassSubtotals;
   540	        $Member = $input->Member;
   541	        $currentTime = $input->currentTime;
   542	        // 既存の店頭買取実在庫と店頭買取実在庫履歴を削除 (DBから削除)
   543	        $this->otcBuyOrderStockHistoryRepository->deleteByOtcBuyOrder($OtcBuyOrder);
   544	        $this->otcBuyOrderStockRepository->deleteByOtcBuyOrder($OtcBuyOrder);
   545	
   546	        // メモリ上のEntityも空にする
   547	        $OtcBuyOrder->setOtcBuyOrderStocks(new ArrayCollection());
   548	
   549	        $NewOtcBuyOrderStocks = [];
   550	        foreach ($productClassQuantities as $productClassId => $quantity) {
   551	            $ProductClass = $this->entityManager->find(ProductClass::class, $productClassId);
   552	            if (!$ProductClass) {
   553	                throw new InvalidRequestParameterException('商品規格IDが存在しません');
   554	            }
   555	            $subtotal = $productClassSubtotals[$productClassId];
   556	
   557	            $OtcBuyOrderStock = $this->otcBuyOrderStockEntityManager->create($OtcBuyOrder, $ProductClass, $quantity, $subtotal);
   558	            $OtcBuyOrderStockHistory = $this->otcBuyOrderStockHistoryEntityManager->create($OtcBuyOrderStock, $Member, $quantity, $currentTime);
   559	
   560	            // 店頭買取実在庫履歴を置き換え
   561	            $OtcBuyOrderStock->addOtcBuyOrderStockHistory($OtcBuyOrderStockHistory);
   562	
   563	            $NewOtcBuyOrderStocks[] = $OtcBuyOrderStock;
   564	        }
   565	
   566	        return $NewOtcBuyOrderStocks;
   567	    }
   568	}
