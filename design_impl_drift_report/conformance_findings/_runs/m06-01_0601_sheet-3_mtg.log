   736	
   737	use Doctrine\Common\Collections\ArrayCollection;
   738	use Doctrine\ORM\EntityManagerInterface;
   739	use Eccube\Entity\Master\MtbOtcBuyOrderStatus;
   740	use Eccube\Exception\App\InvalidRequestParameterException;
   741	use Eccube\Service\App\MTGBuyer\V1\Admin\OtcBuyOrder\ActionInput\RebuildOtcBuyOrderDetailInput;
   742	use Eccube\Service\App\MTGBuyer\V1\Admin\OtcBuyOrder\ActionInput\RebuildOtcBuyOrderIndivisualInputProductInput;
   743	use Eccube\Service\App\MTGBuyer\V1\Admin\OtcBuyOrder\ActionInput\RebuildOtcBuyOrderStockAndHistoryInput;
   744	use Eccube\Service\App\MTGBuyer\V1\Admin\OtcBuyOrder\ActionInput\UpdateOtcBuyOrderActionInput;
   745	use Eccube\Service\EntityManager\OtcBuyOrderEntityManager;
   746	use Eccube\Service\EntityManager\OtcBuyOrderStatusHistoryEntityManager;
   747	use Eccube\Service\MailService;
   748	use Psr\Log\LoggerInterface;
   749	
   750	class UpdateOtcBuyOrderAction
   751	{
   752	    public function __construct(
   753	        private readonly EntityManagerInterface $entityManager,
   754	        private readonly LoggerInterface $logger,
   755	        private readonly RebuildOtcBuyOrderDetail $rebuildOtcBuyOrderDetail,
   756	        private readonly RebuildOtcBuyOrderIndivisualInputProduct $rebuildOtcBuyOrderIndivisualInputProduct,
   757	        private readonly RebuildOtcBuyOrderStockAndHistory $rebuildOtcBuyOrderStockAndHistory,
   758	        private readonly BuildOtcBuyOrderDetailUpdatePlan $buildOtcBuyOrderDetailUpdatePlan,
   759	        private readonly OtcBuyOrderEntityManager $otcBuyOrderEntityManager,
   760	        private readonly OtcBuyOrderStatusHistoryEntityManager $otcBuyOrderStatusHistoryEntityManager,
   761	        private readonly MailService $mailService,
   762	    ) {
   763	    }
   764	
   765	    public function handle(UpdateOtcBuyOrderActionInput $input): void
   766	    {
   767	        $OtcBuyOrderStatus = $this->entityManager->find(MtbOtcBuyOrderStatus::class, $input->UpdateOtcBuyOrderDto->orderStatusId);
   768	        if (!$OtcBuyOrderStatus) {
   769	            throw new InvalidRequestParameterException('Invalid order status id');
   770	        }
   771	
   772	        $PrevStatus = $input->OtcBuyOrder->getOtcBuyOrderStatus();
   773	
   774	        // 商品規格IDの有無により、注文詳細と注文個別入力商品に分類
   775	        $updatePlan = $this->buildOtcBuyOrderDetailUpdatePlan->build($input->UpdateOtcBuyOrderDto->orderDetails);
   776	
   777	        // 以降前システムにて、複数Entity間で同じ時間がsetされていた。意図は不明だが踏襲する
   778	        $currentTime = new \DateTime();
   779	
   780	        $this->entityManager->beginTransaction();
   781	        try {
   782	            $OrderDetails = $this->rebuildOtcBuyOrderDetail->rebuild(new RebuildOtcBuyOrderDetailInput($input->OtcBuyOrder, $updatePlan->details));
   783	            $IndivisualInputProducts = $this->rebuildOtcBuyOrderIndivisualInputProduct->rebuild(new RebuildOtcBuyOrderIndivisualInputProductInput($input->OtcBuyOrder, $updatePlan->indivisuals));
   784	            $OtcBuyOrderStocksAndHistories = $this->rebuildOtcBuyOrderStockAndHistory->rebuild(new RebuildOtcBuyOrderStockAndHistoryInput($input->OtcBuyOrder, $updatePlan->productClassQuantities, $updatePlan->productClassSubtotals, $input->Member, $currentTime));
   785	
   786	            // 以降前システムの仕様に合わせて、10円単位に切り上げる。bcmatchを使うルールに従う。
   787	            $totalPrice = (int) bcceil(bcdiv((string) $updatePlan->totalPrice, '10', 10)) * 10;
   788	            $this->otcBuyOrderEntityManager->update(
   789	                $input->OtcBuyOrder,
   790	                $OtcBuyOrderStatus,
   791	                $input->UpdateOtcBuyOrderDto->qualifiedInvoiceIssuerConfirmationFlg,
   792	                $input->UpdateOtcBuyOrderDto->smaregiTransactionId,
   793	                $totalPrice,
   794	                new ArrayCollection($OrderDetails),
   795	                new ArrayCollection($IndivisualInputProducts),
   796	                new ArrayCollection($OtcBuyOrderStocksAndHistories),
   797	                $input->Member,
   798	                $currentTime
   799	            );
   800	
   801	            // 以降前システムの仕様に合わせて、ステータスが変更された場合のみステータス履歴を保存する
   802	            if ($PrevStatus !== $OtcBuyOrderStatus) {
   803	                $this->otcBuyOrderStatusHistoryEntityManager->save($input->OtcBuyOrder, $OtcBuyOrderStatus, $input->Member, $currentTime);
   804	            }
   805	            // 買取成立の場合は2段階目のステータス更新と履歴保存を行う
   806	            // (合わせて2件の履歴が必要のため、上記と分けて更新を行なっている)
   807	            if ($OtcBuyOrderStatus->isComplete()) {
   808	                $PostCompleteStatus = $this->entityManager->find(
   809	                    MtbOtcBuyOrderStatus::class,
   810	                    $input->OtcBuyOrder->resolvePostCompleteStatusId(),
   811	                );
   812	                $this->otcBuyOrderEntityManager->updateStatusWithHistory($input->OtcBuyOrder, $PostCompleteStatus, $input->Member, $currentTime);
   813	            }
   814	            $this->entityManager->flush();
   815	            $this->entityManager->commit();
   816	
   817	            // 経理払出し待ちの場合は、経理チームにメールを送信する
   818	            if ($OtcBuyOrderStatus->isAccountingPaymentPending()) {
   819	                $this->mailService->sendOtcBuyOrderAccountingPaymentPendingMail($input->OtcBuyOrder);
   820	            }
   821	        } catch (\Exception $e) {
   822	            $this->entityManager->rollback();
   823	            $this->logger->error('Failed to update otc buy order', ['exception' => $e, 'otcBuyOrderId' => $input->OtcBuyOrder->getId(), 'memberId' => $input->Member->getId()]);
   824	            throw $e;
   825	        }
   826	    }
   827	}
