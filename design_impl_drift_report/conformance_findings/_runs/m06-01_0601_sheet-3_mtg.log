   481	        $this->otcBuyOrderIndivisualInputProductRepository->deleteByOtcBuyOrder($OtcBuyOrder);
   482	        // メモリ上のEntityも空にする
   483	        $OtcBuyOrder->setOtcBuyOrderIndivisualInputProducts(new ArrayCollection());
