    69	    #[Route('/%eccube_api_v1_route%/admin/otcBuyOrders.json', name: 'api_admin_otc_buy_orders', methods: ['GET'])]
    70	    public function getUncompletedOtcBuyOrders(): JsonResponse
    71	    {
    72	        $Member = $this->getUser();
    73	        if (!$Member instanceof Member) {
    74	            throw new UnauthenticatedException('認証エラー');
    75	        }
    76	
    77	        $shopId = $Member->getBaseInfo()->getId();
    78	
    79	        $otcBuyOrders = $this->dtbOtcBuyOrderRepository->getOtcBuyOrdersByShopIdAndStatus($shopId, MtbOtcBuyOrderStatus::ASSESSMENT_UNCOMPLETED_STATUSES);
    80	        $response = array_map(function (array $otcBuyOrder): array {
    81	            $isJapan = $otcBuyOrder['countryId'] === Country::JAPAN;
    82	
    83	            $join = static function (array $parts): string {
    84	                $parts = array_map(static fn ($v) => trim((string) ($v ?? '')), $parts);
    85	                $parts = array_values(array_filter($parts, static fn ($v) => $v !== ''));
    86	
    87	                return implode(' ', $parts);
    88	            };
    89	
    90	            $address = $isJapan ?
    91	                $join([$otcBuyOrder['prefName'] ?? '', $otcBuyOrder['addr01'], $otcBuyOrder['addr02'], $otcBuyOrder['addr03'] ?? '']) :
    92	                $join([$otcBuyOrder['countryName'] ?? '', $otcBuyOrder['addr03'] ?? '', $otcBuyOrder['addr02'], $otcBuyOrder['addr01']]);
    93	
    94	            return [
    95	                'otcBuyOrderId' => $otcBuyOrder['id'],
    96	                'assessmentId' => $otcBuyOrder['assessmentId'],
    97	                'applyDate' => $otcBuyOrder['applyDate']?->format('Y/m/d H:i:s') ?? null,
    98	                'freeComment' => $otcBuyOrder['freeComment'] ?? null,
    99	                'memberName' => $otcBuyOrder['memberName'] ?? null,
   100	                'otcOrderStatusId' => $otcBuyOrder['otcOrderStatusId'],
   101	                'returnSupply' => $otcBuyOrder['returnSupply'] ?? null,
   102	                'callFlg' => $otcBuyOrder['callFlg'],
   103	                'adultFlg' => $otcBuyOrder['adultFlg'],
   104	                'playingFlg' => $otcBuyOrder['playingFlg'],
