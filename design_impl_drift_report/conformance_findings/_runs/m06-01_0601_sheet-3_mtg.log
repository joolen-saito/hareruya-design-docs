   329	use Eccube\Dto\App\MTGBuyer\V1\Admin\UpdateOtcBuyOrderDetailDto;
   330	use Eccube\Exception\App\InvalidRequestParameterException;
   331	
   332	final readonly class OtcBuyOrderDetailUpdatePlan
   333	{
   334	    /**
   335	     * @param list<UpdateOtcBuyOrderDetailDto> $details
   336	     * @param list<UpdateOtcBuyOrderDetailDto> $indivisuals
   337	     * @param array<int,int> $productClassQuantities
   338	     * @param array<int,int> $productClassSubtotals
   339	     */
   340	    public function __construct(
   341	        public array $details,
   342	        public array $indivisuals,
   343	        public array $productClassQuantities,
   344	        public array $productClassSubtotals,
   345	        public int $totalPrice,
   346	    ) {
   347	    }
   348	}
   349	
   350	final class BuildOtcBuyOrderDetailUpdatePlan
   351	{
   352	    /** @param list<UpdateOtcBuyOrderDetailDto> $orderDetails */
   353	    public function build(array $orderDetails): OtcBuyOrderDetailUpdatePlan
   354	    {
   355	        $details = [];
   356	        $indivisuals = [];
   357	        $productClassQuantities = [];
   358	        $productClassSubtotals = [];
   359	        $totalPrice = 0;
   360	
   361	        foreach ($orderDetails as $detail) {
   362	            if ($detail->price === null || $detail->quantity === null) {
   363	                // Validationでガードしているが、念のためチェックしている
   364	                throw new InvalidRequestParameterException('価格または数量が指定されていません');
   365	            }
   366	
   367	            $totalPrice += $detail->price * $detail->quantity;
   368	
   369	            if ($detail->productClassId !== null) {
   370	                $details[] = $detail;
   371	                $productClassQuantities[$detail->productClassId] = ($productClassQuantities[$detail->productClassId] ?? 0) + $detail->quantity;
   372	                // MTGBuyerは ”単価 x 数量" で計算しておりbcmath不要。
   373	                $productClassSubtotals[$detail->productClassId] = ($productClassSubtotals[$detail->productClassId] ?? 0) + $detail->price * $detail->quantity;
   374	            } else {
   375	                $indivisuals[] = $detail;
   376	            }
   377	        }
   378	
   379	        return new OtcBuyOrderDetailUpdatePlan($details, $indivisuals, $productClassQuantities, $productClassSubtotals, $totalPrice);
   380	    }
   381	}
