   843	namespace Eccube\Service\App\MTGBuyer\V1\Admin\OtcBuyOrder;
   844	
   845	use Doctrine\ORM\EntityManagerInterface;
   846	use Eccube\Entity\Master\MtbOtcBuyOrderStatus;
   847	use Eccube\Exception\App\InternalException;
   848	use Eccube\Exception\App\InvalidStatusTransitionException;
   849	use Eccube\Service\App\MTGBuyer\V1\Admin\OtcBuyOrder\ActionInput\UpdateStatusInput;
   850	use Eccube\Service\EntityManager\OtcBuyOrderEntityManager;
   851	use Psr\Log\LoggerInterface;
   852	
   853	class UpdateStatusAction
   854	{
   855	    public function __construct(
   856	        private readonly EntityManagerInterface $entityManager,
   857	        private readonly LoggerInterface $logger,
   858	        private readonly OtcBuyOrderEntityManager $otcBuyOrderEntityManager,
   859	    ) {
   860	    }
   861	
   862	    private const FROM_STATUS_TO_ALLOWED_STATUSES = [
   863	        // 査定前 -> 査定中, 査定中断, 査定再開
   864	        MtbOtcBuyOrderStatus::STATUS_ASSESSMENT_PENDING => [
   865	            MtbOtcBuyOrderStatus::STATUS_ASSESSMENT_IN_PROGRESS,
   866	            MtbOtcBuyOrderStatus::STATUS_ASSESSMENT_PAUSED,
   867	            MtbOtcBuyOrderStatus::STATUS_ASSESSMENT_RESUMED,
   868	        ],
   869	        // 査定中 -> 査定中断, 査定再開
   870	        MtbOtcBuyOrderStatus::STATUS_ASSESSMENT_IN_PROGRESS => [
   871	            MtbOtcBuyOrderStatus::STATUS_ASSESSMENT_PAUSED,
   872	            MtbOtcBuyOrderStatus::STATUS_ASSESSMENT_RESUMED,
   873	        ],
   874	        // 査定中断 -> 査定中, 査定再開
   875	        MtbOtcBuyOrderStatus::STATUS_ASSESSMENT_PAUSED => [
   876	            MtbOtcBuyOrderStatus::STATUS_ASSESSMENT_IN_PROGRESS,
   877	            MtbOtcBuyOrderStatus::STATUS_ASSESSMENT_RESUMED,
   878	        ],
   879	        // 査定再開 -> 査定中, 査定中断
   880	        MtbOtcBuyOrderStatus::STATUS_ASSESSMENT_RESUMED => [
   881	            MtbOtcBuyOrderStatus::STATUS_ASSESSMENT_IN_PROGRESS,
   882	            MtbOtcBuyOrderStatus::STATUS_ASSESSMENT_PAUSED,
   883	        ],
   884	    ];
   885	
   886	    /**
   887	     * ステータスを更新する
   888	     * 更新前ステータス [5: 査定前, 6: 査定中, 8: 査定中断, 9: 査定再開]
   889	     * 更新後ステータス [6: 査定中, 8: 査定中断, 9: 査定再開]
   890	     * ただし、査定中 -> 査定再開のステータス更新ができるのは OtcBuyOrderの更新者(Member)のみ
   891	     */
   892	    public function handle(UpdateStatusInput $input): void
   893	    {
   894	        $CurrentStatus = $input->OtcBuyOrder->getOtcBuyOrderStatus();
   895	        if (!$CurrentStatus) {
   896	            throw new InvalidStatusTransitionException('不正なステータス遷移です');
   897	        }
   898	
   899	        $currentStatusId = $CurrentStatus->getId();
   900	        $nextStatusId = $input->NextStatus->getId();
   901	
   902	        if ($currentStatusId === $nextStatusId) {
   903	            return;
   904	        }
   905	
   906	        // 査定終了後のステータスは変更不可 (直後のロジックと重複しているが移行前のコードを踏襲)
   907	        if ($CurrentStatus->isAssessmentCompleted()) {
   908	            $message = $input->NextStatus->isAssessmentActive()
   909	                ? 'この査定はすでに終了しているため開くことができません。'
   910	                : 'この査定はすでに終了しているためステータスの更新に失敗しました。';
   911	
   912	            throw new InvalidStatusTransitionException($message);
   913	        }
   914	
   915	        if (
   916	            !isset(self::FROM_STATUS_TO_ALLOWED_STATUSES[$currentStatusId])
   917	            || !in_array($nextStatusId, self::FROM_STATUS_TO_ALLOWED_STATUSES[$currentStatusId], true)
   918	        ) {
   919	            throw new InvalidStatusTransitionException('不正なステータス遷移です');
   920	        }
   921	
   922	        // 査定中 -> 査定再開のステータス更新ができるのは 直近の更新者(Member)のみ (一部ロジックが重複しているが移行前のコードを踏襲)
   923	        if (
   924	            $CurrentStatus->isAssessmentActive()
   925	            && $input->NextStatus->isAssessmentActive()
   926	            && $input->Member !== $input->OtcBuyOrder->getMember()
   927	        ) {
