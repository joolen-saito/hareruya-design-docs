   592	class UpdateDoubleCheckMemberAction
   593	{
   594	    public function __construct(
   595	        private readonly EntityManagerInterface $entityManager,
   596	        private readonly LoggerInterface $logger,
   597	        private readonly OtcBuyOrderApproverEntityManager $otcBuyOrderApproverEntityManager,
   598	    ) {
   599	    }
   600	
   601	    public function handle(UpdateDoubleCheckMemberInput $input): void
   602	    {
   603	        // 更新者とダブルチェック者が同じ場合はエラーを返す
   604	        if ($input->Member->getId() === $input->DoubleCheckMember->getId()) {
   605	            throw new InvalidMemberAssignmentException('更新者とダブルチェック者に同一のメンバーを割り当てることはできません');
   606	        }
   607	
   608	        $this->entityManager->beginTransaction();
   609	        try {
   610	            $input->OtcBuyOrder
   611	                ->setMember($input->Member)
   612	                ->setUpdateDate(new \DateTime());
   613	            $this->entityManager->persist($input->OtcBuyOrder);
   614	
   615	            $this->otcBuyOrderApproverEntityManager->saveDoubleCheckApproval($input->OtcBuyOrder, $input->DoubleCheckMember, $input->Member);
   616	
   617	            $this->entityManager->flush();
   618	            $this->entityManager->commit();
   619	        } catch (\Exception $e) {
   620	            $this->entityManager->rollback();
   621	            $this->logger->error('Failed to update double check member', ['exception' => $e, 'otcBuyOrderId' => $input->OtcBuyOrder->getId(), 'memberId' => $input->Member->getId(), 'doubleCheckMemberId' => $input->DoubleCheckMember->getId()]);
   622	            throw new \RuntimeException('システムエラーが発生しました');
   623	        }
   624	    }
   625	}
