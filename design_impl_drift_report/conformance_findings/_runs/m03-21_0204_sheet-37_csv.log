   135	    public function delete(int $id): Response
   136	    {
   137	        $this->isTokenValid();
   138	
   139	        $Section = $this->mtbSectionRepository->find($id);
   140	
   141	        if ($Section === null) {
   142	            $this->addError('admin.common.delete_error', 'admin');
   143	
   144	            return $this->redirectToRoute('admin_product_section');
   145	        }
   146	
   147	        if ($Section->hasProductClasses()) {
   148	            $message = trans('admin.product.section.delete_product_class.failed', ['%name%' => $Section->getName()]);
   149	            $this->addError($message, 'admin');
   150	
   151	            return $this->redirectToRoute('admin_product_section');
   152	        }
   153	
   154	        if ($Section->hasOtcBuyOrderDetails()) {
   155	            $message = trans('admin.product.section.delete_otc_buy_order_detail.failed', ['%name%' => $Section->getName()]);
   156	            $this->addError($message, 'admin');
   157	
   158	            return $this->redirectToRoute('admin_product_section');
   159	        }
   160	
   161	        if ($Section->hasOtcBuyOrderIndivisualInputProducts()) {
   162	            $message = trans('admin.product.section.delete_otc_buy_order_indivisual_input_product.failed', ['%name%' => $Section->getName()]);
   163	            $this->addError($message, 'admin');
   164	
   165	            return $this->redirectToRoute('admin_product_section');
   166	        }
   167	
   168	        if ($Section->hasOtcBuyOrderSummaries()) {
   169	            $message = trans('admin.product.section.delete_otc_buy_order_summary.failed', ['%name%' => $Section->getName()]);
   170	            $this->addError($message, 'admin');
   171	
   172	            return $this->redirectToRoute('admin_product_section');
   173	        }
   174	
   175	        log_info('部門削除開始', [$id]);
   176	
   177	        // EC 削除後は MtbSection が消えるため、スマレジ削除連携用に部門ID(categoryId)を退避する。
   178	        $smaregiCategoryId = $Section->getSmaregiCategoryId();
   179	        $deleteJob = null;
   180	
   181	        try {
   182	            $this->mtbSectionRepository->delete($Section);
   183	
   184	            // スマレジ連携済み（部門IDあり）の場合のみ、EC 削除と同一トランザクションで削除連携ジョブを登録。
   185	            if ($smaregiCategoryId !== null && $smaregiCategoryId !== '') {
   186	                $deleteJob = $this->smaregiSectionEventService->registerDeleteJob($smaregiCategoryId);
   187	            }
   188	
   189	            $this->entityManager->flush();
   190	
   191	            // commit（flush）成功後にスマレジ部門削除メッセージを送信する（アウトボックス的な順序）。
   192	            // $deleteJob は smaregi_category_id が非空のときのみ生成されるため、ここでは非nullが保証される。
   193	            if ($deleteJob !== null) {
   194	                $this->smaregiSectionEventService->dispatchDeleteMessage($deleteJob, (string) $smaregiCategoryId);
   195	            }
   196	
   197	            $this->addSuccess('admin.common.delete_complete', 'admin');
   198	
   199	            log_info('部門削除完了', [$id]);
   200	        } catch (\Exception $e) {
   201	            $message = trans('admin.common.delete_error', ['%name%' => $Section->getName()]);
   202	            $this->addError($message, 'admin');
   203	
   204	            log_error('部門削除エラー', [$id, $e]);
   205	        }
