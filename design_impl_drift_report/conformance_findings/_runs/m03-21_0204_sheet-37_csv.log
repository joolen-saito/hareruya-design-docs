    69	        if ($event->isBreakAll() || $event->isSkipRow()) {
    70	            return;
    71	        }
    72	
    73	        $row = $event->getRow();
    74	        $messageStore = $event->getMessageStore();
    75	        $rowNumber = $row->getRowNumber();
    76	        $idRaw = trim((string) $row->getValue('ID'));
    77	        if ($this->isNewRegistrationId($idRaw)) {
    78	            $name = trim((string) $row->getValue('名称'));
    79	            if ($name !== '' && $this->shelfNumberRepository->findOneBy(['name' => $name]) !== null) {
    80	                $messageStore->addShelfNumberNameDuplicateError($rowNumber);
    81	                $event->breakAll();
    82	            }
    83	
    84	            return;
    85	        }
    86	        $idLabel = $this->idColumn->getLabel();
    87	
    88	        if (!SqlUtil::isNumericParam($idRaw)) {
    89	            $messageStore->addNumericError($rowNumber, $idLabel);
    90	            $event->breakAll();
    91	
    92	            return;
    93	        }
    94	
    95	        $id = (int) $idRaw;
    96	        if ($this->shelfNumberRepository->find($id) === null) {
    97	            $messageStore->addMasterNotExistsError($rowNumber, $idLabel, $idRaw);
    98	            $event->breakAll();
    99	
   100	            return;
   101	        }
   102	
   103	        // 更新時: 指定した名称が別レコードにすでに存在する場合は重複エラー
   104	        $name = trim((string) $row->getValue('名称'));
   105	        if ($name !== '') {
   106	            $existing = $this->shelfNumberRepository->findOneBy(['name' => $name]);
   107	            if ($existing !== null && $existing->getId() !== $id) {
   108	                $messageStore->addShelfNumberNameDuplicateError($rowNumber);
   109	                $event->breakAll();
   110	            }
   111	        }
   112	    }
   113	
   114	    public function onReadRow(ReadCsvRowEvent $event): bool
   115	    {
   116	        $row = $event->getRow();
   117	        $idRaw = trim((string) $this->idColumn->getValue($row));
   118	        $name = trim((string) $this->nameColumn->getValue($row));
   119	        $sortNo = (int) $this->sortNoColumn->getValue($row);
   120	
   121	        $em = $this->shelfNumberRepository->getEntityManager();
   122	
   123	        if ($this->isNewRegistrationId($idRaw)) {
   124	            $ShelfNumber = new DtbShelfNumber();
   125	            $ShelfNumber->setName($name);
   126	            $ShelfNumber->setSortNo($sortNo);
   127	            $em->persist($ShelfNumber);
   128	        } else {
   129	            $ShelfNumber = $this->shelfNumberRepository->find((int) $idRaw);
   130	            \assert($ShelfNumber instanceof DtbShelfNumber);
   131	            $ShelfNumber->setName($name);
   132	            $ShelfNumber->setSortNo($sortNo);
   133	        }
   134	
   135	        return true;
   136	    }
   137	
   138	    /**
   139	     * ID なし（新規登録）: 空、または数値 0（未採番扱い）
   140	     */
   141	    private function isNewRegistrationId(string $idRaw): bool
   142	    {
   143	        if ($idRaw === '') {
   144	            return true;
   145	        }
   146	        if (!SqlUtil::isNumericParam($idRaw)) {
   147	            return false;
   148	        }
   149	
   150	        return (int) $idRaw === 0;
   151	    }
   152	
   153	    /**
   154	     * @return array<CsvColumnInterface>
   155	     */
   156	    protected function getColumns(): array
   157	    {
   158	        return [
   159	            $this->idColumn,
   160	            $this->nameColumn,
   161	            $this->sortNoColumn,
   162	        ];
   163	    }
   164	
   165	    /**
   166	     * @return array<RowValidatorInterface>
   167	     */
   168	    protected function getRowValidators(): array
   169	    {
   170	        return [];
   171	    }
   172	}

