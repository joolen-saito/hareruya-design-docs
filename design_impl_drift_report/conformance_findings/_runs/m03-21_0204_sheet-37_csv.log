design_impl_drift_report/conformance_findings/_runs/m07-04_0206_sheet-12_sheet.result.json:1:{"functionId":"m07-04_0206_sheet-12_sheet","featureNo":"M07-04","requirementsChecked":82,"extractorMissed":1,"refutedCount":5,"findings":[{"category":"実装違い","designRequirement":"テンプレ選択のフォームブロック接頭辞は m07-04_admin_online_purchase_purchase_manual_mail。フィールドキーは template。","designRef":"excel_to_html/output/0206_基本設計仕様書(ネット買取管理機能).html#sheet-12:3172","implRef":"src/Eccube/Form/Type/Admin/Purchase/PurchaseManualMailType.php:91","implementationActual":"PurchaseManualMailType::getBlockPrefix() は admin_purchase_manual_mail を返す。反証検索でも m07-04_admin_online_purchase_purchase_manual_mail は src/Eccube/html 配下に存在しない。","mismatchReason":"設計がPOSTフォーム名前空間として指定する接頭辞と、Symfonyフォームが生成する実装接頭辞が異なる。template/subject/body のフィールドキー自体は存在するが、外部POST名は設計値にならない。","comparisonRows":[{"item":"フォームブロック接頭辞","design":"m07-04_admin_online_purchase_purchase_manual_mail","implementation":"admin_purchase_manual_mail","mismatch":"設計の接頭辞では生成されない"},{"item":"テンプレ選択POST名","design":"m07-04_admin_online_purchase_purchase_manual_mail[template]","implementation":"admin_purchase_manual_mail[template]","mismatch":"POSTフィールド名の名前空間が異なる"}]},{"category":"実装違い","designRequirement":"送信成功時はメール履歴 INSERT が中心であり、送信が成功した場合のみ履歴行が増える。HTTP経由ではリクエスト終了までに flush される前提。","designRef":"excel_to_html/output/0206_基本設計仕様書(ネット買取管理機能).html#sheet-12:3177","implRef":"src/Eccube/Service/MailService.php:1588; src/Eccube/Service/EntityManager/MailHistoryEntityManager.php:67; src/Eccube/EventListener/TransactionListener.php:119","implementationActual":"sendManualPurchaseMail は送信成功後に MailHistoryEntityManager::save() を呼ぶが flush しない。save() は persist のみ。TransactionListener の terminate 処理も commit のみで EntityManager::flush() を呼ばない。","mismatchReason":"設計は送信成功でメール履歴行がDBに増えることを求めるが、実装はUnitOfWorkへpersistするだけでSQL INSERTを発行する flush の証跡がない。送信元未設定・送信例外時に履歴を増やさない分岐は実装済みだが、成功時履歴INSERTが未達。","comparisonRows":[{"item":"送信成功後の履歴保存","design":"メール履歴 INSERT / 履歴行が増える","implementation":"mailHistoryEntityManager->save(...) のみで flush なし","mismatch":"DB確定に必要な flush がない"},{"item":"HTTPリクエスト終了時","design":"リクエスト終了までに flush される前提","implementation":"TransactionListener は EntityManager::commit() のみ","mismatch":"commit は未flushのDoctrine UnitOfWorkをSQL化しない"},{"item":"MailHistoryEntityManager","design":"dtb_mail_history へ直接保存","implementation":"MailHistory を生成し persist($MailHistory) するのみ","mismatch":"永続化キュー追加止まりでINSERT確定にならない"}]},{"category":"実装違い","designRequirement":"テンプレート候補には Mail/buy_order_old.twig、Mail/buy_order_assessment_old.twig、Mail/buy_order_include_delivery_fee_old.twig を含め、選択テンプレートの file_name を BuyOrder・header・footer・BaseInfo でレンダリングして本文を初期生成する。","designRef":"excel_to_html/output/0206_基本設計仕様書(ネット買取管理機能).html#sheet-12:3170","implRef":"src/Eccube/Form/Type/Admin/Purchase/PurchaseManualMailType.php:82; src/Eccube/Controller/Admin/Purchase/MailController.php:126; src/Eccube/Resource/template/default/Mail/buy_order_old.twig:1; src/Eccube/Resource/template/default/Mail/buy_order_old.twig:12; app/DoctrineMigrations/Version20251204111453.php:4131","implementationActual":"フォーム候補には旧フローTwigを含め、DB登録もある。一方、createBody は BuyOrder 変数だけを渡すが、旧フローTwigは buyOrder 小文字と Plugin\\HareruyaEc\\Entity\\DtbBuyMainCard::SALE を参照する。該当Plugin名前空間は実装に存在しない。","mismatchReason":"設計上の許容テンプレートとして選択できる旧フローTwigが、実装のレンダリング変数・現行名前空間と整合せず、実行時例外として空本文になる。これは「選択テンプレートのメール本文を初期セットする」要求を、登録済み候補の一部で満たさない。","comparisonRows":[{"item":"旧フロー許容テンプレート","design":"old系3パスも候補として許容し本文レンダリング対象","implementation":"FormTypeで候補に含め、migrationにも旧テンプレート登録あり","mismatch":"候補化されるがレンダリング可能性が担保されない"},{"item":"テンプレート変数","design":"BuyOrder, header, footer, BaseInfo","implementation":"createBodyは BuyOrder を渡すが old系Twigは buyOrder を参照","mismatch":"旧テンプレートに必要な小文字 buyOrder が未供給"},{"item":"旧Plugin参照","design":"ec-cube-enterpriseコア実装を正とする","implementation":"old系Twigが Plugin\\HareruyaEc\\Entity\\DtbBuyMainCard::SALE を参照","mismatch":"現行実装に該当Pluginクラスがなく、実行時例外で本文初期生成が空になる"}]}],"summary":"materialGapRows 81件と、独立再列挙で単独候補化されていなかった買取番