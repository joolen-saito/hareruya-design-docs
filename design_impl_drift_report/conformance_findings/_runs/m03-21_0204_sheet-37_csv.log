    48	    }
    49	
    50	    public function onBeforeImport(): void
    51	    {
    52	        $this->sectionsForSmaregi = [];
    53	        parent::onBeforeImport();
    54	        $this->idColumn = (new BaseCsvColumn('ID', 'ID'))->setRequired(false);
    55	        $this->nameColumn = (new BaseCsvColumn('部門名', '部門名'))->setRequired(true);
    56	        $this->codeColumn = (new BaseCsvColumn('部門コード', '部門コード'))->setRequired(true);
    57	        $this->taxFreeColumn = (new BaseCsvColumn('免税区分', '免税区分'))
    58	            ->setRequired(true)
    59	            ->addValidator(new NumericValidator())
    60	            ->addValidator(new ChoiceValidator('0', '1', '2'))
    61	            ->setConverter(new IntConverter());
    62	        $this->visibleColumn = (new BaseCsvColumn('MTGBuyer表示フラグ', 'MTGBuyer表示フラグ'))
    63	            ->setRequired(false)
    64	            ->addValidator(new ChoiceValidator('0', '1'));
    65	    }
    66	
    67	    public function onAfterImport(AfterReadEvent $event): void
    68	    {
    69	        if ($event->isSuccessful()) {
    70	            $uniqueById = [];
    71	            foreach ($this->sectionsForSmaregi as $Section) {
    72	                $id = $Section->getId();
    73	                if ($id !== 0) {
    74	                    $uniqueById[(int) $id] = $Section;
    75	                }
    76	            }
    77	            foreach ($uniqueById as $Section) {
    78	                $this->smaregiSectionEventService->dispatchUpsert($Section);
    79	            }
    80	        }
    81	        $this->sectionsForSmaregi = [];
