   437	     * 更新時に対象となる商品規格件数を取得する。
   438	     */
   439	    private function countProductClassesForUpdate(int $productId): int
   440	    {
   441	        return (int) $this->em->createQueryBuilder()
   442	            ->select('COUNT(pc.id)')
   443	            ->from(ProductClass::class, 'pc')
   444	            ->where('IDENTITY(pc.Product) = :productId')
