   450	    /**
   451	     * 商品情報を更新または登録する。
   452	     *
   453	     * NOTE: このメソッドは pf-eccube3 の persistProductSub の機能も統合しています。
   454	     * ec-cube-enterprise では DtbProductSub テーブルは存在せず、Product テーブルにカラムが統合されているため、
   455	     * 商品サブ情報の更新・登録もこのメソッドで行います。
   456	     *
   457	     * @param ReadCsvRowEvent $event イベント
   458	     *
   459	     * @return int 商品ID
   460	     */
   461	    private function persistProduct(ReadCsvRowEvent $event): int
   462	    {
   463	        /** @var ProductRepository $repository */
   464	        $repository = $this->productRepository;
   465	
   466	        $row = $event->getRow();
   467	        $isBranchPublished = $this->isBranchPublishedColumn->getValue($row);
   468	
   469	        $product = [
   470	            'status' => $this->statusIdColumn->getValue($row),
   471	            'isBranchPublished' => $isBranchPublished,
   472	            'name' => $this->nameJpColumn->getValue($row),
   473	            'nameEn' => $this->nameEnColumn->getValue($row),
   474	            'descriptionDetail' => $this->descriptionJpColumn->getValue($row),
   475	            'descriptionDetailEn' => $this->descriptionEnColumn->getValue($row),
   476	            'buyDescriptionDetail' => $this->buyDescriptionJpColumn->getValue($row),
   477	            'buyDescriptionDetailEn' => $this->buyDescriptionEnColumn->getValue($row),
   478	            'sellGroupId' => $this->sellGroupIdByNameColumn->getValue($row),
   479	            'size' => $this->sizeColumn->getValue($row),
   480	            'weight' => $this->weightColumn->getValue($row),
   481	            'storageCodeId' => $this->storageCodeIdColumn->getValue($row),
   482	            'regionRestrictionId' => $this->regionRestrictionIdColumn->getValue($row),
   483	            'searchWord' => $this->searchWordColumn->getValue($row),
   484	            'cardsetId' => $this->cardsetIdColumn->getValue($row),
   485	            'freeArea' => $this->freeAreaColumn->getValue($row),
   486	        ];
   487	
   488	        // 商品ID があれば UPDATE、なければ INSERT
   489	        $productIdValue = $this->productIdColumn->find($event->getRow());
   490	        if ($productIdValue->hasValue()) {
   491	            $productId = $productIdValue->getValue();
   492	            $product['productId'] = $productId;
   493	            $existingProduct = $repository->find($productId);
   494	            if ($existingProduct !== null) {
   495	                $product['discountId'] = $existingProduct->getDiscount()?->getId();
   496	                $product['buyDiscountId'] = $existingProduct->getBuyDiscount()?->getId();
   497	                $product['cardDetailId'] = $existingProduct->getCardDetail()?->getId();
   498	            }
   499	            $repository->updateProduct($product);
   500	
   501	            return $productId;
   502	        }
   503	
   504	        $product['creatorId'] = $event->getUpdateUser()->getId();
   505	        // TODO: 暫定的に設定しているが、base_info_idカラムは削除予定
   506	        $product['baseInfoId'] = 1;
   507	
   508	        return $repository->insertProduct($product);
   509	    }
