    18	use Eccube\Common\Constant;
    19	use Eccube\Entity\ProductClass;
    20	use Eccube\Repository\ProductRepository;
    21	use Eccube\Service\Csv\Importer\MessageStore;
    22	use Eccube\Service\Csv\Importer\Model\CsvColumnInterface;
    23	use Eccube\Service\Csv\Importer\Model\CsvRowInterface;
    24	
    25	/**
    26	 * スマレジ連携フラグを有効から無効に変更する際、スマレジ在庫が存在すればエラーを返すバリデーター
    27	 */
    28	class SmaregiAlignmentFlgOffStockValidator implements RowValidatorInterface
    29	{
    30	    private CsvColumnInterface $productIdColumn;
    31	
    32	    private CsvColumnInterface $smaregiAlignmentFlgColumn;
    33	
    34	    private ProductRepository $productRepository;
    35	
    36	    /**
    37	     * @param CsvColumnInterface $productIdColumn 商品ID列
    38	     * @param CsvColumnInterface $smaregiAlignmentFlgColumn スマレジ連携フラグ列
    39	     * @param ProductRepository $productRepository 商品リポジトリ
    40	     */
    41	    public function __construct(
    42	        CsvColumnInterface $productIdColumn,
    43	        CsvColumnInterface $smaregiAlignmentFlgColumn,
    44	        ProductRepository $productRepository,
    45	    ) {
    46	        $this->productIdColumn = $productIdColumn;
    47	        $this->smaregiAlignmentFlgColumn = $smaregiAlignmentFlgColumn;
    48	        $this->productRepository = $productRepository;
    49	    }
    50	
    51	    public function validate(MessageStore $errors, CsvRowInterface $row): bool
    52	    {
    53	        $smaregiFlg = $this->smaregiAlignmentFlgColumn->getValue($row);
    54	
    55	        // スマレジ連携フラグが有効の場合はバリデーションをスキップ
    56	        if ($smaregiFlg === Constant::ENABLED) {
    57	            return true;
    58	        }
    59	
    60	        $productIdValue = $this->productIdColumn->find($row);
    61	
    62	        // 新規登録時はバリデーションをスキップ
    63	        if (!$productIdValue->hasValue()) {
    64	            return true;
    65	        }
    66	
    67	        $Product = $this->productRepository->find($productIdValue->getValue());
    68	
    69	        // 更新対象の商品が存在しない場合はバリデーションをスキップ
    70	        if ($Product === null) {
    71	            return true;
    72	        }
    73	
    74	        /** @var ProductClass $ProductClass */
    75	        foreach ($Product->getProductClasses() as $ProductClass) {
    76	            // 現在のスマレジ連携フラグが既に無効の場合はスキップ
    77	            if (!$ProductClass->getSmaregiAlignmentFlg()) {
    78	                continue;
    79	            }
    80	
    81	            foreach ($ProductClass->getProductStocks() as $ProductStock) {
    82	                // EC-CUBE在庫はスキップ
    83	                if ($ProductStock->isLocationEccube()) {
    84	                    continue;
    85	                }
    86	
    87	                if ($ProductStock->hasStock()) {
    88	                    $errors->addSmaregiAlignmentFlgOffWithStockError(
    89	                        $row->getRowNumber(),
    90	                        $this->smaregiAlignmentFlgColumn->getLabel()
    91	                    );
    92	
    93	                    return false;
    94	                }
    95	            }
    96	        }
    97	
    98	        return true;
    99	    }
   100	}

