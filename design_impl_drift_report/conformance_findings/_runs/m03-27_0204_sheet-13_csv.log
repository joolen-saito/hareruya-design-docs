    24	
    25	/**
    26	 * 商品公開ステータスを「廃止」に変更する場合、在庫が存在するかチェックするバリデーター
    27	 */
    28	class AbolishedStatusStockValidator implements RowValidatorInterface
    29	{
    30	    private CsvColumnInterface $productIdColumn;
    31	
    32	    private CsvColumnInterface $statusIdColumn;
    33	
    34	    private ProductRepository $productRepository;
    35	
    36	    /**
    37	     * @param CsvColumnInterface $productIdColumn 商品ID列
    38	     * @param CsvColumnInterface $statusIdColumn 商品公開ステータス列
    39	     * @param ProductRepository $productRepository 商品リポジトリ
    40	     */
    41	    public function __construct(
    42	        CsvColumnInterface $productIdColumn,
    43	        CsvColumnInterface $statusIdColumn,
    44	        ProductRepository $productRepository,
    45	    ) {
    46	        $this->productIdColumn = $productIdColumn;
    47	        $this->statusIdColumn = $statusIdColumn;
    48	        $this->productRepository = $productRepository;
    49	    }
    50	
    51	    public function validate(MessageStore $errors, CsvRowInterface $row): bool
    52	    {
    53	        $statusId = $this->statusIdColumn->getValue($row);
    54	
    55	        // 商品公開ステータスが「廃止」でない場合はバリデーションをスキップ
    56	        if ($statusId !== ProductStatus::DISPLAY_ABOLISHED) {
    57	            return true;
    58	        }
    59	
    60	        $productIdValue = $this->productIdColumn->find($row);
    61	
    62	        // 新規登録時はバリデーションをスキップ
    63	        if (!$productIdValue->hasValue()) {
    64	            return true;
    65	        }
    66	
    67	        $productId = $productIdValue->getValue();
    68	        $Product = $this->productRepository->find($productId);
    69	
    70	        // 更新対象の商品が存在しない場合はバリデーションをスキップ
    71	        if ($Product === null) {
    72	            return true;
    73	        }
    74	
    75	        // 商品規格の在庫をチェック
    76	        /** @var ProductClass $ProductClass */
    77	        foreach ($Product->getProductClasses() as $ProductClass) {
    78	            foreach ($ProductClass->getProductStocks() as $ProductStock) {
    79	                // 在庫が存在しない場合はスキップ
    80	                if (!$ProductStock->hasStock()) {
    81	                    continue;
    82	                }
    83	
    84	                $errors->addAbolishedStatusWithStockError(
    85	                    $row->getRowNumber(),
    86	                    $this->statusIdColumn->getLabel()
    87	                );
    88	
    89	                return false;
    90	            }
    91	        }
    92	
    93	        return true;
    94	    }
    95	}
