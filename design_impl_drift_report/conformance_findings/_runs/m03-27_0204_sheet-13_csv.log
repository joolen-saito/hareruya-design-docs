    23	/**
    24	 * スマレジ連携フラグが「1(有効)」の場合、スマレジ商品コードと部門IDを必須とするバリデーター
    25	 */
    26	class SmaregiConditionalRequiredValidator implements RowValidatorInterface
    27	{
    28	    private CsvColumnInterface $smaregiAlignmentFlgColumn;
    29	
    30	    private CsvColumnInterface $smaregiProductCodeColumn;
    31	
    32	    private CsvColumnInterface $sectionIdColumn;
    33	
    34	    /**
    35	     * @param CsvColumnInterface $smaregiAlignmentFlgColumn スマレジ連携フラグ列
    36	     * @param CsvColumnInterface $smaregiProductCodeColumn スマレジ商品コード列
    37	     * @param CsvColumnInterface $sectionIdColumn 部門ID列
    38	     */
    39	    public function __construct(
    40	        CsvColumnInterface $smaregiAlignmentFlgColumn,
    41	        CsvColumnInterface $smaregiProductCodeColumn,
    42	        CsvColumnInterface $sectionIdColumn,
    43	    ) {
    44	        $this->smaregiAlignmentFlgColumn = $smaregiAlignmentFlgColumn;
    45	        $this->smaregiProductCodeColumn = $smaregiProductCodeColumn;
    46	        $this->sectionIdColumn = $sectionIdColumn;
    47	    }
    48	
    49	    public function validate(MessageStore $errors, CsvRowInterface $row): bool
    50	    {
    51	        $smaregiFlg = $this->smaregiAlignmentFlgColumn->getValue($row);
    52	
    53	        // スマレジ連携フラグが「1(有効)」でない場合はバリデーションをスキップ
    54	        if ($smaregiFlg !== Constant::ENABLED) {
    55	            return true;
    56	        }
    57	
    58	        $smaregiCode = $this->smaregiProductCodeColumn->getValue($row);
    59	        $sectionId = $this->sectionIdColumn->getValue($row);
    60	
    61	        if (empty($smaregiCode)) {
    62	            $errors->addRequireError($row->getRowNumber(), $this->smaregiProductCodeColumn->getLabel());
    63	
    64	            return false;
    65	        }
    66	
    67	        if (empty($sectionId)) {
    68	            $errors->addRequireError($row->getRowNumber(), $this->sectionIdColumn->getLabel());
    69	
    70	            return false;
    71	        }
    72	
    73	        // スマレジ商品コードと部門IDが存在する場合はバリデーションを通過
    74	        return true;
    75	    }
    76	}
