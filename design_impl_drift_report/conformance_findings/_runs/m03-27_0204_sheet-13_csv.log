   709	    /**
   710	     * 商品IDから商品規格情報を1件取得
   711	     *
   712	     * @param int $productId 商品ID
   713	     *
   714	     * @return array<string, mixed>|null 商品規格および商品規格サブの情報
   715	     */
   716	    private function findProductClass(int $productId): ?array
   717	    {
   718	        // NOTE:
   719	        // pf-eccube3ではdel_flgにより削除されていないレコードが対象となっているが、
   720	        // ec-cube-enterpriseでは、del_flgカラムは存在しない。
   721	        // product_status_idの廃止が削除と近い扱いとなっているが、
   722	        // CSVインポートでは廃止された商品も更新可能にするため、product_status_idによる絞り込みは行わない
   723	        $sql = <<<EOT
   724	SELECT
   725	    p.id as product_id,
   726	    pc.id as product_class_id,
   727	    pc.price02,
   728	    pc.buy_price,
   729	    pc.sale_flg
   730	FROM
   731	    dtb_product p
   732	    LEFT JOIN
   733	        dtb_product_class pc ON p.id = pc.product_id
   734	WHERE
   735	    p.id = :productId
   736	LIMIT 1
   737	EOT;
   738	
   739	        $rsm = new ResultSetMapping();
   740	
   741	        // 以下の項目は常に取得できる
   742	        $rsm->addScalarResult('product_id', 'productId', Types::INTEGER);
   743	
   744	        // 以下の項目は商品規格がある場合のみ取得できる
   745	        $rsm->addScalarResult('product_class_id', 'productClassId', Types::INTEGER)
   746	            ->addScalarResult('price02', 'price02', Types::STRING)
   747	            ->addScalarResult('buy_price', 'buyPrice', Types::INTEGER)
   748	            ->addScalarResult('sale_flg', 'saleFlg', Types::BOOLEAN);
   749	
   750	        return $this->em->createNativeQuery($sql, $rsm)
   751	            ->setParameter('productId', $productId)
   752	            ->getOneOrNullResult();
   753	    }
