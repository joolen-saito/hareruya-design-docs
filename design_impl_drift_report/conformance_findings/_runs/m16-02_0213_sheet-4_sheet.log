   127	namespace Eccube\Service\EntityManager;
   128	
   129	use Doctrine\Common\Collections\Collection;
   130	use Doctrine\ORM\EntityManagerInterface;
   131	use Eccube\Entity\Master\MtbLanguage;
   132	use Eccube\Entity\Master\MtbTopBanner;
   133	
   134	class TopBannerEntityManager
   135	{
   136	    public function __construct(
   137	        private readonly EntityManagerInterface $entityManager,
   138	    ) {
   139	    }
   140	
   141	    /**
   142	     * @param Collection<int, MtbLanguage> $Languages
   143	     */
   144	    public function save(
   145	        ?MtbTopBanner $TopBanner,
   146	        string $imageUrl,
   147	        string $link,
   148	        int $dispType,
   149	        Collection $Languages,
   150	        string $imageAlt,
   151	        int $sortNo,
   152	    ): MtbTopBanner {
   153	        $TopBanner = $TopBanner ?? new MtbTopBanner();
   154	        $TopBanner
   155	            ->setImageUrl($imageUrl)
   156	            ->setLink($link)
   157	            ->setDispType($dispType)
   158	            ->setLanguages($Languages)
   159	            ->setImageAlt($imageAlt)
   160	            ->setSortNo($sortNo);
   161	
   162	        $this->entityManager->persist($TopBanner);
   163	
   164	        return $TopBanner;
   165	    }
   166	}

