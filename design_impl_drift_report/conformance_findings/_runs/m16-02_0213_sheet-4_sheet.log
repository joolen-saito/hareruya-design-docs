    92	
    93	class TopBannerUploadAction
    94	{
    95	    private const TOP_BANNER_S3_DIRECTORY = 'banner/top';
    96	
    97	    public function __construct(
    98	        private readonly FileManager $fileManager,
    99	    ) {
   100	    }
   101	
   102	    /**
   103	     * @return array{publicUrl: string, objectKey: string}
   104	     */
   105	    public function handle(TopBannerUploadInput $input): array
   106	    {
   107	        $file = $input->getFile();
   108	        $Member = $input->getMember();
   109	        $BaseInfo = $input->getBaseInfo();
   110	        if ($BaseInfo !== null && !$Member->isEditableShop($BaseInfo)) {
   111	            throw new \RuntimeException('admin.data.top_banner.upload_not_allowed');
   112	        }
   113	
   114	        $filename = $this->buildFileName($file);
   115	        $uploadDirectory = $this->buildUploadDirectory($BaseInfo);
   116	
   117	        $fileAdapter = $this->fileManager->getAdapter();
   118	        $publicUrl = $fileAdapter->upload($file->getPathname(), $uploadDirectory, $filename);
   119	        $entitySaveData = $fileAdapter->toEntitySaveData();
   120	
   121	        return [
   122	            'publicUrl' => $publicUrl,
   123	            'objectKey' => (string) ($entitySaveData['s3_object_key'] ?? ''),
   124	        ];
   125	    }
   126	
   127	    private function buildFileName(UploadedFile $file): string
   128	    {
   129	        $extension = $file->getClientOriginalExtension();
   130	        if ($extension === '') {
   131	            $extension = (string) $file->guessExtension();
   132	        }
   133	        if ($extension === '') {
   134	            $extension = 'jpg';
   135	        }
   136	
   137	        return date('mdHis').uniqid('_').'.'.strtolower($extension);
   138	    }
   139	
   140	    private function buildUploadDirectory(?BaseInfo $BaseInfo): string
   141	    {
   142	        if ($BaseInfo === null) {
   143	            return self::TOP_BANNER_S3_DIRECTORY;
   144	        }
   145	
   146	        $shopDigit = strtolower($BaseInfo->getShopDigit());
   147	        if ($shopDigit === '') {
   148	            return self::TOP_BANNER_S3_DIRECTORY;
   149	        }
   150	
   151	        return self::TOP_BANNER_S3_DIRECTORY.'/'.$shopDigit;
   152	    }
   153	}
