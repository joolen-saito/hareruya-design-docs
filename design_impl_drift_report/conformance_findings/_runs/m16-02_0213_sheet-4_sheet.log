    16	namespace Eccube\Service\Admin\Data;
    17	
    18	use Doctrine\Common\Collections\ArrayCollection;
    19	use Doctrine\ORM\EntityManagerInterface;
    20	use Eccube\Entity\Master\MtbTopBanner;
    21	use Eccube\Repository\Master\MtbLanguageRepository;
    22	use Eccube\Service\Admin\Data\ActionInput\TopBannerStoreInput;
    23	use Eccube\Service\EntityManager\TopBannerEntityManager;
    24	
    25	class TopBannerStoreAction
    26	{
    27	    public function __construct(
    28	        private readonly EntityManagerInterface $entityManager,
    29	        private readonly MtbLanguageRepository $languageRepository,
    30	        private readonly TopBannerEntityManager $topBannerEntityManager,
    31	    ) {
    32	    }
    33	
    34	    public function handle(TopBannerStoreInput $input): void
    35	    {
    36	        $form = $input->getForm();
    37	        $TopBanners = $input->getTopBanners();
    38	
    39	        $sortedBannerList = $this->buildSortedBannerList($form, $TopBanners);
    40	        if ($sortedBannerList === []) {
    41	            return;
    42	        }
    43	
    44	        $this->entityManager->beginTransaction();
    45	        try {
    46	            $position = 1;
    47	            foreach ($TopBanners as $TopBanner) {
    48	                if (!isset($sortedBannerList[$position])) {
    49	                    $position++;
    50	                    continue;
    51	                }
    52	                $sortNo = $position;
    53	                $sorted = $sortedBannerList[$position++];
    54	                $imageUrl = trim((string) ($form->get($sorted['image'])->getData() ?? ''));
    55	                $link = trim((string) ($form->get($sorted['link'])->getData() ?? ''));
    56	                $dispType = (int) ($form->get($sorted['dispType'])->getData() ?? MtbTopBanner::HIDE_BOTH);
    57	                if ($imageUrl === '') {
    58	                    $dispType = MtbTopBanner::HIDE_BOTH;
    59	                }
    60	                $imageAlt = (string) ($form->get($sorted['imageAlt'])->getData() ?? '');
    61	                $languageIds = $form->get($sorted['languages'])->getData() ?? [];
    62	
    63	                $Languages = $this->languageRepository->findBy(['id' => $languageIds], ['id' => 'ASC']);
    64	
    65	                $this->topBannerEntityManager->save(
    66	                    $TopBanner,
    67	                    $imageUrl,
    68	                    $link,
    69	                    $dispType,
    70	                    new ArrayCollection($Languages),
    71	                    $imageAlt,
    72	                    $sortNo,
    73	                );
    74	            }
    75	
    76	            $this->entityManager->flush();
    77	            $this->entityManager->commit();
    78	        } catch (\Throwable $e) {
    79	            $this->entityManager->rollback();
    80	            throw $e;
    81	        }
    82	    }
    83	
    84	    /**
    85	     * @param iterable<MtbTopBanner> $TopBanners
    86	     *
    87	     * @return array<int, array{image: string, link: string, dispType: string, languages: string, imageAlt: string}>
    88	     */
    89	    private function buildSortedBannerList(mixed $form, iterable $TopBanners): array
    90	    {
    91	        $sortedBannerList = [];
    92	        foreach ($TopBanners as $TopBanner) {
    93	            $sortNo = (int) $form->get('sort_no_'.$TopBanner->getId())->getData();
    94	            $sortedBannerList[$sortNo] = [
    95	                'image' => 'image_url_'.$TopBanner->getId(),
    96	                'link' => 'link_'.$TopBanner->getId(),
    97	                'dispType' => 'disp_type_'.$TopBanner->getId(),
    98	                'languages' => 'language_'.$TopBanner->getId(),
    99	                'imageAlt' => 'image_alt_'.$TopBanner->getId(),
   100	            ];
   101	        }
   102	
   103	        if ($sortedBannerList === []) {
   104	            return [];
   105	        }
   106	
   107	        ksort($sortedBannerList);
   108	
   109	        return array_combine(range(1, count($sortedBannerList)), $sortedBannerList);
   110	    }
   111	}
