namespace Eccube\Service\Csv\Importer\Extension\StockMoveTransfer;

use Doctrine\ORM\EntityManagerInterface;
use Eccube\Common\EccubeConfig;
use Eccube\Entity\Member;
use Eccube\Service\Csv\Importer\CsvImporter;
use Eccube\Service\Csv\Importer\Event\StockMoveCsvImportHandler;
use Symfony\Component\HttpFoundation\File\UploadedFile;
use Symfony\Contracts\Translation\TranslatorInterface;

/**
 * 在庫移動CSV登録専用の CsvImporter。
 */
class StockMoveCsvImporter extends CsvImporter
{
    public function __construct(
        EntityManagerInterface $em,
        TranslatorInterface $translator,
        EccubeConfig $eccubeConfig,
        private readonly StockMoveCsvImportHandler $stockMoveCsvImportHandler,
        Member $loginUser,
    ) {
        parent::__construct($em, $translator, $eccubeConfig, $stockMoveCsvImportHandler, $loginUser);
    }

    public function import(UploadedFile $file): StockMoveCsvImportResult
    {
        $baseResult = parent::import($file);

        $result = new StockMoveCsvImportResult();
        $result->setCount($baseResult->getCount())
            ->setErrors($baseResult->getErrors())
            ->setInfos($baseResult->getInfos());
        $result->setStockMoveTransferId($this->stockMoveCsvImportHandler->getStockMoveTransferId());

        return $result;
    }
}

