namespace Eccube\Service\Csv\Importer;

use Symfony\Contracts\Translation\TranslatorInterface;

/**
 * メッセージの格納先。
 */
class MessageStore implements \Countable
{
    /** @var TranslatorInterface */
    private TranslatorInterface $translator;

    /** @var array<int, array{message: string}> メッセージ（エラー） */
    private array $messages = [];

    /** @var array<int, array{message: string}> 情報メッセージ（アラート等。hasError には含めない） */
    private array $infos = [];

    /**
     * @param TranslatorInterface $translator
     */
    public function __construct(TranslatorInterface $translator)
    {
        $this->translator = $translator;
        $this->messages = [];
        $this->infos = [];
    }

    /**
     * @return int エラーの件数
     */
    public function count(): int
    {
        return count($this->messages);
    }

    /**
     * @return array<int, array{message: string}> エラーメッセージ
     */
    public function getMessages(): array
    {
        return $this->messages;
    }

    /**
     * 渡された文字列をそのままエラーに追加する。
     *
     * @param string|array<string> $message エラーメッセージ
     *
     * @return self
     */
    public function addRawMessage(string|array $message): self
    {
        $messages = is_iterable($message) ? $message : func_get_args();
        foreach ($messages as $m) {
            $this->messages[] = ['message' => $m];
        }

        return $this;
    }

    /**
     * リソースファイルから取得したメッセージをエラーに追加する。
     *
     * @param string $key メッセージのキー
     * @param string|int ...$args メッセージに埋め込む値（sprintf で処理する）
     *
     * @return self
     */
    public function addMessage(string $key, string|int ...$args): self
    {
        $this->addRawMessage($this->getMessage($key, ...$args));

        return $this;
    }

    /**
     * 情報メッセージを追加する（エラーとは別。アラート・注意喚起用）。
     *
     * @param string $key メッセージのキー
     * @param string|int ...$args メッセージに埋め込む値（sprintf で処理する）
     *
     * @return self
     */
    public function addInfo(string $key, string|int ...$args): self
    {
        $this->infos[] = ['message' => $this->getMessage($key, ...$args)];

        return $this;
    }

    /**
     * @return array<int, array{message: string}> 情報メッセージ
     */
    public function getInfos(): array
    {
        return $this->infos;
    }

    /**
     * ヘッダ部の形式エラーを追加する。
     *
     * @return self
     */
    public function addHeaderFormatError(): self
    {
        $this->addMessage('admin.csv.error.format.header');

        return $this;
    }

    /**
     * データ部の列数が不正であるエラーを追加する。
     *
     * @param int $rowNumber 行番号
     *
     * @return self
     */
    public function addInvalidColumnCountError(int $rowNumber): self
    {
        $this->addMessage('admin.csv.error.format.body', $rowNumber);

        return $this;
    }

    /**
     * データ部全体が存在しないエラーを追加する。
     *
     * @return self
     */
    public function addNoDataError(): self
    {
        $this->addMessage('admin.csv.error.data.empty');

        return $this;
    }

    /**
     * データ部の指定された列が存在しないエラーを追加する。
     *
     * @param int $rowNumber 行番号
     * @param string $columnName 列名
     *
     * @return self
     */

