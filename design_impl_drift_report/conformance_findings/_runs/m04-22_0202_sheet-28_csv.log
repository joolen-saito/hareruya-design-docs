namespace Eccube\Service\Csv\Importer\Validator;

use Eccube\Service\Csv\Importer\MessageStore;
use Eccube\Service\Csv\Importer\Model\CsvValueInterface;

/**
 * 文字列項目に対し、UTF-8 の文字数（コードポイント）の上限を検証する ValidatorInterface 実装。
 *
 * {@see NumericMaxLengthValidator} は数値文字列の桁数（バイト長）用。
 */
class StringMaxLengthValidator implements ValidatorInterface
{
    use ValidatorTrait;

    /**
     * @param int $maxLength 最大文字数
     * @param bool $skipWhenCellBlank true のとき {@see CsvValueInterface::hasValue()} が false のセルは検証しない（任意項目向け）。false のときは空・空白のみのセルも長さを検証する（必須名など、スペースのみの超長文を弾く）
     */
    public function __construct(
        private readonly int $maxLength,
        private readonly bool $skipWhenCellBlank = true,
    ) {
    }

    /**
     * @param MessageStore $errors エラーメッセージの格納先
     * @param CsvValueInterface $value 検証する値
     *
     * @return bool 値が正しい場合 true
     */
    public function validate(MessageStore $errors, CsvValueInterface $value): bool
    {
        if ($this->skipWhenCellBlank && !$value->hasValue()) {
            return true;
        }

        if (mb_strlen($value->getOriginalValue(), 'UTF-8') > $this->maxLength) {
            $errors->addStringMaxLengthError(
                $value->getRowNumber(),
                $value->getLabel(),
                $this->maxLength
            );

            return false;
        }

        return true;
    }
}

