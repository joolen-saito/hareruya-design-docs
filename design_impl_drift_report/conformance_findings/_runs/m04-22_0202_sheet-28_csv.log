namespace Eccube\Service\Csv\Importer\Event;

use Eccube\Service\Csv\Importer\Model\CsvColumnInterface;
use Eccube\Service\Csv\Importer\Validator\RowValidatorInterface;
use Eccube\Util\SimpleCache;

/**
 * CsvImportFormatInterface のデフォルト実装。
 */
abstract class BaseCsvImportHandler implements CsvImportHandlerInterface
{
    /** @var int 行ロックタイムアウト（秒）のデフォルト値 */
    public const DEFAULT_LOCK_TIMEOUT = 5;

    /** @var SimpleCache|null 列定義の取得先 */
    private ?SimpleCache $columnsCache = null;

    /** @var SimpleCache|null 行バリデータ定義の取得先 */
    private ?SimpleCache $rowValidatorsCache = null;

    /**
     * 最初のCSVデータを読み込む前に呼び出される関数。
     */
    public function onBeforeImport(): void
    {
        $this->columnsCache = new SimpleCache(function () {
            return $this->getColumns();
        });
        $this->rowValidatorsCache = new SimpleCache(function () {
            return $this->getRowValidators();
        });
    }

    /**
     * CSVの読み込みが終わった後に呼び出される関数。
     *
     * @param AfterReadEvent $event イベント
     */
    public function onAfterImport(AfterReadEvent $event): void
    {
        $this->columnsCache = null;
        $this->rowValidatorsCache = null;
    }

    /**
     * CSVデータ1行の形式をチェックする。
     *
     * @param ReadCsvRowEvent $event イベント
     */
    public function onValidateRow(ReadCsvRowEvent $event): void
    {
        /** @var array<CsvColumnInterface> $columns */
        $columns = $this->columnsCache->get();
        $row = $event->getRow();

        // 列数が一致しない場合、エラー
        if (count($row) !== count($columns)) {
            $event->getMessageStore()
                ->addInvalidColumnCountError($row->getRowNumber());
            $event->breakAll();

            return;
        }

        // 行内の各データが正しくない場合、エラー
        $messageStore = $event->getMessageStore();

        /** @var CsvColumnInterface $column */
        foreach ($columns as $column) {
            $name = $column->getName();
            if (!$row->exists($name)) {
                $messageStore->addColumnNotExistsError($row->getRowNumber(), $name);
                $event->breakAll();

                return;
            }

            if (!$column->validate($messageStore, $row)) {
                $event->breakAll();

                return;
            }
        }

        // 行全体を検証する
        /** @var array<RowValidatorInterface> $rowValidators */
        $rowValidators = $this->rowValidatorsCache->get();
        if (!empty($rowValidators)) {
            /** @var RowValidatorInterface $rowValidator */
            foreach ($rowValidators as $rowValidator) {
                if (!$rowValidator->validate($messageStore, $row)) {
                    $event->breakAll();

                    return;
                }
            }
        }
    }

    /**
     * 行ロックのタイムアウト時間を返す。
     *
     * @return int タイムアウト（秒）
     */
    public function getLockTimeout(): int
    {
        return self::DEFAULT_LOCK_TIMEOUT;
    }

    /**
     * 列の定義を取得する。
     *
     * @return array<CsvColumnInterface> 列の定義を CsvColumnInterface で返す。
     */
    abstract protected function getColumns(): array;

    /**
     * 列を検証するロジックを取得する。
     *
     * @return array<RowValidatorInterface> 列全体を検証する定義を RowValidatorInterface で返す。
     */
    abstract protected function getRowValidators(): array;
}

