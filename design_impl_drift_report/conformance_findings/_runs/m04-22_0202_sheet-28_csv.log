/**
 * CSVの列定義を集めたもの。
 */
class ColumnDefinitions
{
    /**
     * @param string $name 列名
     *
     * @return BaseCsvColumn 商品コードの列定義
     */
    public static function productCode(string $name = '商品コード'): BaseCsvColumn
    {
        return self::createStringColumn($name, '商品コード');
    }

    /**
     * @param string $name 列名
     *
     * @return BaseCsvColumn 在庫移動CSVの移動点数列
     */
    public static function stockMoveQuantity(string $name = '移動点数'): BaseCsvColumn
    {
        return self::createUnsignedNumericColumn($name, '移動点数');
    }

    /**
     * @param string $name 列名
     *
     * @return BaseCsvColumn 在庫振替CSVの振替元商品コード列
     */
    public static function stockTransferFromProductCode(string $name = '振替元商品コード'): BaseCsvColumn
    {
        return self::createStringColumn($name, '振替元商品コード');
    }

    /**
     * @param string $name 列名
     *
     * @return BaseCsvColumn 在庫振替CSVの振替先商品コード列
     */
    public static function stockTransferToProductCode(string $name = '振替先商品コード'): BaseCsvColumn
    {
        return self::createStringColumn($name, '振替先商品コード');
    }

    /**
     * @param string $name 列名
     *
     * @return BaseCsvColumn 在庫振替CSVの振替点数列
     */
    public static function stockTransferQuantity(string $name = '振替点数'): BaseCsvColumn
    {
        return self::createUnsignedNumericColumn($name, '振替点数');
    }

    /**
     * @param string $name 列名
     *
     * @return BaseCsvColumn 商品IDの列定義
     */
    public static function productId(string $name = '商品ID'): BaseCsvColumn
    {
        return self::createUnsignedNumericColumn($name, '商品ID');
    }

    /**
     * @param string $name 列名
     *
     * @return BaseCsvColumn 商品公開ステータスの列定義
     */
    public static function statusId(string $name = '商品公開ステータス'): BaseCsvColumn
    {
        return self::createNumericChoiceColumn(
            $name,
            '商品公開ステータス',
            [ProductStatus::DISPLAY_SHOW, ProductStatus::DISPLAY_HIDE, ProductStatus::DISPLAY_ABOLISHED]
        );
    }

    /**
     * @param EntityManagerInterface $em
     * @param string $name 列名
     *
     * @return BaseCsvColumn 言語IDの列定義
     */
    public static function languageId(EntityManagerInterface $em, string $name = '言語(ID)'): BaseCsvColumn
    {
        /** @var \Eccube\Repository\Master\MtbLanguageRepository $repository */
        $repository = $em->getRepository(\Eccube\Entity\Master\MtbLanguage::class);
        $languages = $repository->findAll();
        $languageIds = array_map(function ($language) {
