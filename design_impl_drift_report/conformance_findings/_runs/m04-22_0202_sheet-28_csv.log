    /**
     * 移動点数が半角数字の正の整数（1以上）であることを検証する。
     */
    private function validateMoveQuantity(ReadCsvRowEvent $event): bool
    {
        $row = $event->getRow();
        $label = $this->moveQuantityColumn->getLabel();
        $moveQuantity = trim((string) $this->moveQuantityColumn->getValue($row));

        if ((int) $moveQuantity <= 0) {
            $event->getMessageStore()
                ->addInvalidFormatError($row->getRowNumber(), $label);
            $event->breakAll();

            return false;
        }

        return true;
    }

