namespace Eccube\Service\Csv\Importer\Validator;

use Eccube\Service\Csv\Importer\MessageStore;
use Eccube\Service\Csv\Importer\Model\CsvValueInterface;
use Eccube\Util\SqlUtil;

/**
 * 0以上の整数であることを検証する ValidatorInterface 実装。
 */
class NumericValidator implements ValidatorInterface
{
    use ValidatorTrait;

    /**
     * @param MessageStore $errors エラーメッセージの格納先
     * @param CsvValueInterface $value 検証する値
     *
     * @return bool $value が空ではない場合 true
     */
    public function validate(MessageStore $errors, CsvValueInterface $value): bool
    {
        if (!$value->hasValue()) {
            // 未入力の場合はチェックしない
            return true;
        }

        $validator = function ($value) {
            return SqlUtil::isNumericParam($value);
        };

        if (!$value->validate($validator)) {
            $errors->addNumericError($value->getRowNumber(), $value->getLabel());

            return false;
        }

        return true;
    }
}
