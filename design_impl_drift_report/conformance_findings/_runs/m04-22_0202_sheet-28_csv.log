use Eccube\Service\EntityManager\ProductStockEntityManager;
use Eccube\Service\EntityManager\StockHistoryEntityManager;
use Eccube\Service\EntityManager\StockMoveTransferDetailEntityManager;
use Eccube\Service\EntityManager\StockMoveTransferEntityManager;

/**
 * 在庫移動CSV登録（一覧モーダル）の取込ハンドラ。
 * CSV行の検証と、在庫移動数量の抽出を担当する。
 */
class StockMoveCsvImportHandler extends BaseCsvImportHandler
{
    private ?CsvColumnInterface $productCodeColumn = null;

    private ?CsvColumnInterface $moveQuantityColumn = null;

    private ?DtbStockMoveTransfer $StockMoveTransfer = null;

    public function __construct(
        private readonly ProductClassRepository $productClassRepository,
        private readonly ProductStockRepository $productStockRepository,
        private readonly BaseInfo $moveFromBaseInfo,
        private readonly BaseInfo $moveToBaseInfo,
        private readonly int $moveFromStockLocationId,
        private readonly int $moveToStockLocationId,
        private readonly Member $Member,
        private readonly MtbStockMoveTransferStatusRepository $stockMoveTransferStatusRepository,
        private readonly EntityManagerInterface $entityManager,
        private readonly ProductStockEntityManager $productStockEntityManager,
        private readonly StockHistoryEntityManager $stockHistoryEntityManager,
        private readonly StockMoveTransferDetailEntityManager $stockMoveTransferDetailEntityManager,
        private readonly StockMoveTransferEntityManager $stockMoveTransferEntityManager,
        private readonly MtbStockChangeTypeDetailRepository $stockChangeTypeDetailRepository,
        private readonly MtbStockHistorySourceTypeRepository $stockHistorySourceTypeRepository,
    ) {
    }

    public function onBeforeImport(): void
    {
        parent::onBeforeImport();

        $this->initializeColumnDefinitions();

        // 在庫移動振替の親エンティティを作成
        $MoveTransferStatus = $this->stockMoveTransferStatusRepository->find(MtbStockMoveTransferStatus::STATUS_NEW);

        $StockMove = $this->stockMoveTransferEntityManager->save(
            StockMoveTransfer: null,
            MoveTransferStatus: $MoveTransferStatus,
            MoveFromBaseInfo: $this->moveFromBaseInfo,
            MoveToBaseInfo: $this->moveToBaseInfo,
            moveFromStockLocationId: $this->moveFromStockLocationId,
            moveToStockLocationId: $this->moveToStockLocationId,
            memo: '',
            RegisteredMember: $this->Member,
            UpdatedMember: $this->Member,
        );

        $this->entityManager->flush();

        $this->StockMoveTransfer = $StockMove;
    }

    public function onAfterImport(AfterReadEvent $event): void
    {
        parent::onAfterImport($event);
        $this->clearColumnDefinitions();
    }

    /**
     * CSVデータ1行の形式をチェックする。
     *
     * @param ReadCsvRowEvent $event イベント
     */
    public function onValidateRow(ReadCsvRowEvent $event): void
    {
        parent::onValidateRow($event);
        if ($event->isBreakAll() || $event->isSkipRow()) {
            return;
        }

        if (!$this->validateProductExists($event)) {
            $event->breakAll();
        }

        if (!$this->validateMoveQuantity($event)) {
            $event->breakAll();
        }
    }

    /**
     * CSVデータ1行を取り込む。
     *
     * @param ReadCsvRowEvent $event イベント
     *
     * @return bool 読み込みに成功した場合 true
     */
    public function onReadRow(ReadCsvRowEvent $event): bool
    {
        $row = $event->getRow();
        $productCode = trim((string) $this->productCodeColumn->getValue($row));
        $quantity = trim((string) $this->moveQuantityColumn->getValue($row));

        $ProductClass = $this->productClassRepository->findOneBy(
            [
                'code' => $productCode,
            ]
        );

        $FromProductStock = $this->productStockRepository->findOneBy([
            'ProductClass' => $ProductClass,
            'baseInfo' => $this->moveFromBaseInfo,
            'stockLocationId' => $this->moveFromStockLocationId,
        ]);

        if ($FromProductStock === null) {
            throw new \Exception('移動元の商品在庫が見つかりません');
        }

        $ToProductStock = $this->productStockRepository->findOneBy([
            'ProductClass' => $ProductClass,
            'baseInfo' => $this->moveToBaseInfo,
            'stockLocationId' => $this->moveToStockLocationId,
        ]);

        if ($ToProductStock === null) {
            throw new \Exception('移動先の商品在庫が見つかりません');
        }

        // 移動分の基準価格
        $standardPrice = $ProductClass->getStandardPrice();
        $standardTotalPrice = bcmul((string) $standardPrice, $quantity, 0);

        // 移動元の出庫総原価
        $fromOutboundTotalCost = $FromProductStock->getMovementTotalCost($quantity);

        // 在庫移動振替の詳細を作成
        $this->stockMoveTransferDetailEntityManager->save(
            StockMoveTransferDetail: null,
            StockMoveTransfer: $this->StockMoveTransfer,
            MoveFromProductStock: $FromProductStock,
            MoveToProductStock: $ToProductStock,
            moveTransferQuantity: (int) $quantity,
            standardTotalPrice: (string) $standardTotalPrice,
            outboundTotalCost: (string) $fromOutboundTotalCost,
        );

        // 出庫元から減算後の在庫数と総原価
        $afterFromStock = $FromProductStock->getStockQuantityAfterChange(bcmul($quantity, '-1', 0));
        $afterFromTotalCost = $FromProductStock->getTotalCostAfterChange(bcmul($quantity, '-1', 0));

        // 在庫変動履歴を作成
        $this->stockHistoryEntityManager->save(
            ProductStock: $FromProductStock,
            StockChangeTypeDetail: $this->stockChangeTypeDetailRepository->find(MtbStockChangeTypeDetail::MOVE_OUTBOUND),
            oldStock: $FromProductStock->getStock(),
            stock: $afterFromStock,
            stockChangeQuantity: $quantity,
            sellPrice: $ProductClass->getPrice02(),
            unitCostPriceBefore: $FromProductStock->getUnitCost(),
            unitCostPriceAfter: $FromProductStock->getUnitCostPriceAfterChange($quantity),
            totalCostPriceBefore: $FromProductStock->getTotalCost(),
            totalCostPriceAfter: (string) $afterFromTotalCost,
            stockChangeReason: '',
            shortageReason: null,
            HistorySourceType: $this->stockHistorySourceTypeRepository->find(MtbStockHistorySourceType::STOCK_MOVE_EDIT),
            historySourceId: $this->StockMoveTransfer->getId(),
            registeredAt: new \DateTime(),
            RegisteredMember: $this->Member,
            operatorMemberName: $this->Member->getName(),
        );

        // 出庫元から在庫を減算
        $this->productStockEntityManager->save(
            ProductStock: $FromProductStock,
            ProductClass: $ProductClass,
            BaseInfo: $FromProductStock->getBaseInfo(),
            stock: $afterFromStock,
            pickUpFlg: $FromProductStock->getPickUpFlg(),
            stockLocationId: $FromProductStock->getStockLocationId(),
            totalCost: $afterFromTotalCost,
        );

        return true;
    }

    /**
     * 列の定義を取得する。
     *
     * @return array<CsvColumnInterface>
     */
    protected function getColumns(): array
    {
        return [
            $this->productCodeColumn,
            $this->moveQuantityColumn,
        ];
    }

    /**
     * 列を検証するロジックを取得する。
     *
     * @return array<RowValidatorInterface>
     */
    protected function getRowValidators(): array
    {
        return [];
    }

    private function initializeColumnDefinitions(): void
    {
        $this->productCodeColumn = ColumnDefinitions::productCode()->setRequired(true);
        $this->moveQuantityColumn = ColumnDefinitions::stockMoveQuantity()->setRequired(true);
    }

    private function clearColumnDefinitions(): void
    {
        $this->productCodeColumn = null;
        $this->moveQuantityColumn = null;
    }

    /**
     * 商品の有無を検証する。
     */
