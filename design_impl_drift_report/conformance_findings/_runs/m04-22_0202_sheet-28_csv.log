 */
class StockMoveCsvImportType extends AbstractType
{
    private readonly int $csvMaxSize;

    public function __construct(EccubeConfig $eccubeConfig)
    {
        $this->csvMaxSize = (int) $eccubeConfig['eccube_csv_size'];
    }

    /**
     * @param array<string, mixed> $options
     */
    #[\Override]
    public function buildForm(FormBuilderInterface $builder, array $options): void
    {
        $builder
            ->add('move_from_base_info', EntityType::class, [
                'class' => BaseInfo::class,
                'choice_label' => 'shop_name',
                'label' => false,
                'required' => true,
                'placeholder' => 'admin.common.select',
                'query_builder' => function (BaseInfoRepository $baseInfoRepository) {
                    return $baseInfoRepository->createQueryBuilder('bi')
                        ->orderBy('bi.shop_name', 'ASC');
                },
                'attr' => ['class' => 'form-select'],
                'constraints' => [
                    new Assert\NotBlank(),
                ],
            ])
            ->add('move_to_base_info', EntityType::class, [
                'class' => BaseInfo::class,
                'choice_label' => 'shop_name',
                'label' => false,
                'required' => true,
                'placeholder' => 'admin.common.select',
                'query_builder' => function (BaseInfoRepository $baseInfoRepository) {
                    return $baseInfoRepository->createQueryBuilder('bi')
                        ->orderBy('bi.shop_name', 'ASC');
                },
                'attr' => ['class' => 'form-select'],
                'constraints' => [
                    new Assert\NotBlank(),
                ],
            ])
            ->add('move_from_stock_location_id', ChoiceType::class, [
                'label' => false,
                'required' => true,
                'expanded' => true,
                'multiple' => false,
                'choices' => [
                    'admin.stock.move.stock_location_ec_cube' => ProductStock::STOCK_LOCATION_ECCUBE,
                    'admin.stock.move.stock_location_smaregi' => ProductStock::STOCK_LOCATION_SMAREGI,
                ],
                'placeholder' => false,
                'choice_translation_domain' => 'messages',
                'attr' => ['class' => 'd-flex flex-wrap gap-3 align-items-center'],
                'constraints' => [
                    new Assert\NotBlank(),
                ],
            ])
            ->add('move_to_stock_location_id', ChoiceType::class, [
                'label' => false,
                'required' => true,
                'expanded' => true,
                'multiple' => false,
                'choices' => [
                    'admin.stock.move.stock_location_ec_cube' => ProductStock::STOCK_LOCATION_ECCUBE,
                    'admin.stock.move.stock_location_smaregi' => ProductStock::STOCK_LOCATION_SMAREGI,
                ],
                'placeholder' => false,
                'choice_translation_domain' => 'messages',
                'attr' => ['class' => 'd-flex flex-wrap gap-3 align-items-center'],
                'constraints' => [
                    new Assert\NotBlank(),
                ],
            ])
            ->add('import_file', FileType::class, [
                'label' => false,
                'mapped' => false,
                // 非表示 file では HTML5 required だと「not focusable」になるため false。必須は NotBlank で担保する
                'required' => false,
                'constraints' => [
                    new Assert\NotBlank(),
                    new Assert\File([
                        'maxSize' => $this->csvMaxSize.'M',
                    ]),
                ],
            ]);
    }

    #[\Override]
    public function getBlockPrefix(): string
    {
        return 'stock_move_csv_import';
    }
}

