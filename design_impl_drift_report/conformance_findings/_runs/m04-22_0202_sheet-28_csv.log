     */
    public function setName(string $name): self
    {
        $this->name = $name;

        return $this;
    }

    /**
     * @return string 列の表示名
     */
    public function getLabel(): string
    {
        return $this->label;
    }

    /**
     * @param string $label 列の表示名
     *
     * @return self
     */
    public function setLabel(string $label): self
    {
        $this->label = $label;

        return $this;
    }

    /**
     * @param bool $required 必須の場合 true
     *
