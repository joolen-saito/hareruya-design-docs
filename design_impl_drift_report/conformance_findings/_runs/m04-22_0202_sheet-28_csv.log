    #[Route(path: '/%eccube_admin_route%/product/stock/move_transfer/move_csv_template', name: 'admin_stock_move_transfer_move_csv_template', methods: ['GET'])]
    public function stockMoveCsvTemplate(): StreamedResponse
    {
        return $this->csvTemplateStreamedResponse(
            $this->csvExportService,
            $this->getStockMoveCsvHeader(),
            'stock_move.csv'
        );
    }

    /**
