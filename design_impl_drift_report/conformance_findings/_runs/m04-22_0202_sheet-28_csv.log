     */
    public function setRequired(bool $required): self
    {
        $this->required = $required;

        return $this;
    }

    /**
     * @param bool $multiple 複数の値を指定可能な場合 true
     *
     * @return self
     */
    public function setMultiple(bool $multiple): self
    {
        $this->multiple = $multiple;

        return $this;
    }

    /**
     * @param ConverterInterface $converter 値の変換を行うもの
     *
     * @return self
     */
    public function setConverter(ConverterInterface $converter): self
    {
        $this->converter = $converter;

        return $this;
    }

    /**
     * 値を検証する。
     *
     * @param MessageStore $errors メッセージの格納先
     * @param CsvRowInterface $row 値の取得先
     *
     * @return bool 値が正しい場合 true
     */
    public function validate(MessageStore $errors, CsvRowInterface $row): bool
    {
        $value = $this->find($row);
        $firstValidator = $this->required ? new RequiredValidator() : NoActionValidator::getInstance();

        return $firstValidator
            ->thenValidate($this->validator)
            ->validate($errors, $value);
    }

    /**
     * 入力チェックを追加する。
     *
     * @param mixed $validator 追加するバリデータ
     *
     * @return self
     */
    public function addValidator(mixed $validator): self
    {
        $validators = is_array($validator) ? $validator : func_get_args();
        $this->validator = $this->validator->thenValidate($validators);

        return $this;
    }

    /**
