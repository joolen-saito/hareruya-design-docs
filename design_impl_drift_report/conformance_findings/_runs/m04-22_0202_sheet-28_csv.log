namespace Eccube\Service\Csv\Importer\Model;

/**
 * CsvRowInterface のデフォルト実装。
 */
class CsvRow implements CsvRowInterface
{
    /** @var int 行番号 */
    private int $rowNumber;

    /** @var array<int, string> 列のデータ */
    private array $values;

    /** @var array<string, int>|null ヘッダ行の名前が key 、インデックスが value の連想配列 */
    private ?array $headers = null;

    /**
     * @param int $rowNumber 行番号
     * @param array<int, string> $values 列のデータ
     */
    public function __construct(int $rowNumber, array $values)
    {
        $this->rowNumber = $rowNumber;
        $this->setValues($values);
        $this->setHeaders(null);
    }

    /**
     * @param array<int, string> $values 各行の値
     *
     * @return self
     */
    public function setValues(array $values): self
    {
        $this->values = array_values($values);

        return $this;
    }

    /**
     * @param array<string>|null $headers ヘッダ行
     *
     * @return self
     */
    public function setHeaders(?array $headers): self
    {
        if (is_null($headers)) {
            $this->headers = null;

            return $this;
        }

        $this->headers = array_flip(
            array_values($headers)
        );

        return $this;
    }

    /**
     * @return int 行番号
     */
    public function getRowNumber(): int
    {
        return $this->rowNumber;
    }

    /**
     * @return int 列数
     */
    public function count(): int
    {
        return count($this->values);
    }

    /**
     * @param string|int $index 列の名前 or 列番号
     *
     * @return bool 列が存在する場合 true
     */
    public function exists(string|int $index): bool
    {
        if (is_int($index)) {
            return isset($this->values[$index]);
        }
        if (is_null($this->headers)) {
            throw new \LogicException('ヘッダ情報が未設定です。 setHeaders() でヘッダ名を設定してください。');
        }
        $indexByHeader = $this->headers[$index] ?? -1;

        return ($indexByHeader >= 0) && (isset($this->values[$indexByHeader]));
    }

    /**
     * @param string|int $index 列の名前 or 列番号
     *
     * @return string 列の値
     */
    public function getValue(string|int $index): string
    {
        return (string) $this->getColumnValue($index);
    }

    /**
     * @param string|int $index 列の名前 or 列番号
     *
     * @return string 列の値
     */
    private function getColumnValue(string|int $index): string
    {
        if (is_int($index)) {
            if (isset($this->values[$index])) {
                return $this->values[$index];
            }

            throw new \InvalidArgumentException(sprintf('%d 行目には %d 列目のデータが存在しません。（最大 %d 列）', $this->getRowNumber(), $index, $this->count()));
        }

        if (is_null($this->headers)) {
            throw new \LogicException('ヘッダ情報が未設定です。 setHeaders() でヘッダ名を設定してください。');
        }

        if (!isset($this->headers[$index])) {
            throw new \InvalidArgumentException(sprintf('ヘッダに指定されたキー %s が存在しません', $index));
        }

        $indexByHeader = $this->headers[$index];

        if (isset($this->values[$indexByHeader])) {
            return $this->values[$indexByHeader];
        }

        throw new \InvalidArgumentException(sprintf('%d 行目には %d 列目（%s）のデータが存在しません。（最大 %d 列）', $this->getRowNumber(), $indexByHeader, $index, $this->count()));
    }
}
