class BaseCsvColumn implements CsvColumnInterface
{
    /** @var string 列の名前 */
    private string $name;

    /** @var string 列の表示名 */
    private string $label;

    /** @var bool 必須の場合 true */
    private bool $required;

    /** @var bool 複数の値を指定可能な場合 true */
    private bool $multiple;

    /** @var ValidatorInterface 入力チェックを行うもの */
    private ValidatorInterface $validator;

    /** @var ConverterInterface 値の変換を行うもの */
    private ConverterInterface $converter;

    /**
     * BaseCsvColumn constructor.
     *
     * @param string $name 列の名前
     * @param string $label 列の表示名
     */
    public function __construct(string $name, string $label)
    {
        $this->name = $name;
        $this->label = $label;
        $this->validator = NoActionValidator::getInstance();
        $this->converter = NoActionConverter::getInstance();
        $this->required = false;
        $this->multiple = false;
    }

    /**
     * @return string 列の名前
     */
    public function getName(): string
    {
        return $this->name;
    }

    /**
