    66	            $io->success('ポイント利用未反映は検出されませんでした。');
    67	        } else {
    68	            $io->success(sprintf('ポイント利用未反映が検出されました。（%d件）', $count));
    69	        }
    70	
    71	        return Command::SUCCESS;
    72	    }
    73	}

