    37	)]
    38	class CheckNotReflectedPointUsageCommand extends Command
    39	{
    40	    public function __construct(
    41	        private readonly CheckNotReflectedPointUsageAction $checkNotReflectedPointUsageAction,
    42	    ) {
    43	        parent::__construct();
    44	    }
    45	
    46	    /**
    47	     * {@inheritdoc}
    48	     */
    49	    protected function execute(InputInterface $input, OutputInterface $output): int
    50	    {
    51	        $io = new SymfonyStyle($input, $output);
    52	        $io->text('ポイント利用未反映チェックバッチ開始');
