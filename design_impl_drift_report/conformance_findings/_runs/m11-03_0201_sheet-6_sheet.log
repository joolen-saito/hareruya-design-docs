   190	                checkbox.checked = sourceCheckboxes[index]?.checked || false;
   191	            }
   192	        });
   193	        
   194	        const actionCell = newRow.querySelector('td:last-child');
   195	        const deleteButton = document.createElement('button');
   196	        deleteButton.type = 'button';
   197	        deleteButton.className = 'btn btn-ec-regular btn-delete';
