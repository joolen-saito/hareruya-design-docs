   196	    /**
   197	     * URLに対する権限有無チェックして表示するNavを返す
   198	     *
   199	     * @param array<string, array<string, mixed>> $parentNav
   200	     * @param AuthorityRole[] $AuthorityRoles
   201	     *
   202	     * @return array<string, array<string, mixed>>
   203	     */
   204	    private function getDisplayEccubeNav(array $parentNav, array $AuthorityRoles, string $baseUrl): array
   205	    {
   206	        $restrictUrls = $this->eccubeConfig['eccube_restrict_file_upload_urls'];
   207	
   208	        foreach ($parentNav as $key => $childNav) {
   209	            if (array_key_exists('children', $childNav) && count($childNav['children']) > 0) {
   210	                // 子のメニューがある場合は子の権限チェック
   211	                $parentNav[$key]['children'] = $this->getDisplayEccubeNav($childNav['children'], $AuthorityRoles, $baseUrl);
   212	
   213	                if (count($parentNav[$key]['children']) <= 0) {
   214	                    // 子が存在しない場合は配列から削除
   215	                    unset($parentNav[$key]);
   216	                }
   217	            } elseif (array_key_exists('url', $childNav)) {
   218	                // 子のメニューがなく、URLが設定されている場合は権限があるURLか確認
   219	                $param = array_key_exists('param', $childNav) ? $childNav['param'] : [];
   220	                $url = $this->router->generate($childNav['url'], $param);
   221	
   222	                // メニューに追加するかしないか条件
   223	                $condition = array_key_exists('condition', $childNav) ? $childNav['condition'] : [];
   224	                if ($condition !== []) {
   225	                    if (array_key_exists('expect', $condition) === false) {
   226	                        continue;
   227	                    }
   228	
   229	                    // ECCUBEパラメータから条件がある場合、
   230	                    if (array_key_exists('eccube_param', $condition) === true) {
   231	                        if ($this->eccubeConfig->has($condition['eccube_param']) === true && $this->eccubeConfig->get($condition['eccube_param']) !== $condition['expect']) {
   232	                            unset($parentNav[$key]);
   233	                            continue;
   234	                        }
   235	                    }
   236	                }
   237	
   238	                foreach ($AuthorityRoles as $AuthorityRole) {
   239	                    $denyUrl = str_replace('/', '\/', $baseUrl.$AuthorityRole->getDenyUrl());
   240	                    if (preg_match("/^({$denyUrl})/i", $url)) {
   241	                        // 権限がないURLの場合は配列から削除
   242	                        unset($parentNav[$key]);
   243	                        break;
   244	                    }
   245	                }
   246	
   247	                if ($this->eccubeConfig['eccube_restrict_file_upload'] === '1' && in_array($childNav['url'], $restrictUrls)) {
   248	                    unset($parentNav[$key]);
   249	                }
   250	            }
   251	        }
   252	
   253	        return $parentNav;
   254	    }
