    97	    /**
    98	     * スマレジ店舗ID (smaregi_shop_id) から店舗情報を取得する。
    99	     *
   100	     * スマレジ在庫変動 Webhook の storeId と EC-CUBE 店舗を突合する突合キーであり、別店舗へ在庫を
   101	     * 誤反映しないよう一意に解決できる必要がある。smaregi_shop_id に DB のユニーク制約は無いため、
   102	     * 同一 smaregi_shop_id を持つ店舗が複数存在する場合は先頭を黙って採用せず例外で失敗させる。
   103	     */
   104	    public function findOneBySmaregiShopId(int $smaregiShopId): ?BaseInfo
   105	    {
   106	        try {
   107	            return $this->createQueryBuilder('bi')
   108	                ->where('bi.smaregi_shop_id = :smaregiShopId')
   109	                ->setParameter('smaregiShopId', $smaregiShopId)
   110	                ->getQuery()
   111	                ->getOneOrNullResult();
   112	        } catch (NonUniqueResultException $e) {
   113	            throw new \RuntimeException(sprintf('Multiple BaseInfo found for smaregi_shop_id=%d; store resolution must be unique.', $smaregiShopId), 0, $e);
   114	        }
   115	    }
   116	
   117	    /**
   118	     * ショップアイコンまたはご当地晴れる屋くん画像の object key から店舗情報を取得する.
   119	     *
   120	     * shop_icon / localHareruyakunImage に一意制約はないため、同一 objectKey を持つ店舗が複数ある場合は例外で失敗させる.
   121	     */
   122	    public function findOneByTenantImageObjectKey(string $objectKey): ?BaseInfo
   123	    {
   124	        try {
   125	            return $this->createQueryBuilder('b')
   126	                ->where('b.shop_icon = :objectKey OR b.localHareruyakunImage = :objectKey')
   127	                ->setParameter('objectKey', $objectKey)
   128	                ->getQuery()
   129	                ->getOneOrNullResult();
   130	        } catch (NonUniqueResultException $e) {
   131	            throw new \RuntimeException(sprintf('Multiple BaseInfo found for tenant image object key=%s; image resolution must be unique.', $objectKey), 0, $e);
   132	        }
   133	    }
   134	
   135	    /**
   136	     * セッションからテナント情報を取得する
   137	     *
   138	     * @throws NonUniqueResultException
   139	     */
   140	    public function getTenantBaseInfo(): BaseInfo
   141	    {
   142	        if (
   143	            $this->request->getSession()->has(EccubeRoleConnection::SESSION_ACTIVE_DYNAMIC_CONN_ADMIN)
   144	            && str_contains((string) $this->request->getSession()->get(EccubeRoleConnection::SESSION_ACTIVE_DYNAMIC_CONN_ADMIN)['role'], 'tenant') === true
   145	            && str_contains($this->request->getMainRequest()->getRequestUri(), (string) $this->eccubeConfig->get('eccube_admin_route')) === true
   146	        ) {
   147	            $id = $this->request->getSession()->get(EccubeRoleConnection::SESSION_ACTIVE_DYNAMIC_CONN_ADMIN)['base_info'];
   148	        } else {
   149	            throw new \Exception('店舗が見つかりませんでした。');
   150	        }
   151	
   152	        $BaseInfo = $this->getTenantData()
   153	            ->andWhere('bi.id = :id')
   154	            ->setParameter('id', $id)
   155	            ->getQuery()
   156	            ->getOneOrNullResult();
   157	
   158	        if (null === $BaseInfo) {
   159	            throw new \Exception('BaseInfo not found. id = '.$id);
   160	        }
   161	
   162	        return $BaseInfo;
   163	    }
