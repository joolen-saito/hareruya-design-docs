    22	
    23	/**
    24	 * EnforceSecondLevelCacheTrait
    25	 * 強制的にSecond Level Cacheを利用するTrait
    26	 */
    27	trait EnforceSecondLevelCacheTrait
    28	{
    29	    /**
    30	     * DoctrineのSecond Level Cacheを利用できるため、find機能をQueryBuilderに変更します。
    31	     *
    32	     * @param $id - ID
    33	     * @param $lockMode - ロックモード
    34	     * @param $lockVersion - ロックバージョン
    35	     *
    36	     * @throws NonUniqueResultException
    37	     * @throws \Exception
    38	     */
    39	    public function find($id, $lockMode = null, $lockVersion = null): ?object
    40	    {
    41	        // テーブルの主キー名を取得
    42	        $primaryKey = $this->getClassMetadata()->getSingleIdentifierFieldName();
    43	
    44	        return $this->createQueryBuilder('t')
    45	            ->where('t.'.$primaryKey.' = :id')
    46	            ->setParameter('id', $id)
    47	            ->setCacheable($this->isCacheable())
    48	            ->getQuery()
    49	            ->getOneOrNullResult();
    50	    }
    51	
    52	    /**
    53	     * キャッシュ可能かどうかを判定します。
    54	     *
    55	     * @return bool - キャッシュ可能かどうか
    56	     *
    57	     * @throws \Exception
    58	     */
    59	    public function isCacheable(): bool
    60	    {
    61	        log_debug('Checking Cache for '.$this::class, [
    62	            'ParentClass' => get_parent_class($this),
    63	            'Class' => $this::class,
    64	            'DoctrineClass' => $this->getClassName(),
    65	            'EntityClass' => $this->getEntityName(),
    66	            'isClassCacheable' => in_array($this->getEntityName(), Constant::CACHEABLE_CLASSES),
    67	            'isParentClassCacheable' => in_array(get_parent_class($this->getEntityName()), Constant::CACHEABLE_CLASSES),
    68	        ]);
    69	
    70	        return in_array(
    71	            $this->getEntityName(), Constant::CACHEABLE_CLASSES)
    72	            || in_array(get_parent_class($this->getEntityName()), Constant::CACHEABLE_CLASSES
    73	            );
    74	    }
    75	
    76	    /**
    77	     * DoctrineのSecond Level Cacheを利用できるため、findOneBy機能をQueryBuilderに変更します。
    78	     *
    79	     * @param array<string, mixed> $criteria - 検索条件
    80	     * @param array<string, string>|null $orderBy - ソート条件
    81	     *
    82	     * @throws NonUniqueResultException
    83	     */
    84	    public function findOneBy(array $criteria, ?array $orderBy = null): ?object
    85	    {
    86	        try {
    87	            return $this->findByQueryBuilder($criteria, $orderBy)
    88	                ->setMaxResults(1)
    89	                ->getQuery()
    90	                ->getOneOrNullResult();
    91	        } catch (\BadMethodCallException) {
    92	            // 検索条件に未登録のEntityが指定された場合はnullを返却
    93	            return null;
    94	        }
    95	    }
    96	
    97	    /**
    98	     * DoctrineのSecond Level Cacheを利用できるため、findAll機能をQueryBuilderに変更します。
    99	     *
   100	     * @return array|object[]
   101	     *
   102	     * @throws \Exception
   103	     */
   104	    public function findAll(): array
   105	    {
   106	        return $this->createQueryBuilder('t')
   107	            ->getQuery()
   108	            ->setCacheable($this->isCacheable())
   109	            ->getResult();
   110	    }
   111	
   112	    /**
   113	     * DoctrineのSecond Level Cacheを利用できるため、findBy機能をQueryBuilderに変更します。
   114	     *
   115	     * @param array<string, mixed> $criteria - 検索条件
   116	     * @param array<string, string>|null $orderBy - ソート条件
   117	     * @param int|null $limit - 取得件数
   118	     * @param int|null $offset - オフセット
   119	     *
   120	     * @return array<object>
   121	     *
   122	     * @throws \Exception
   123	     */
   124	    public function findBy(array $criteria, ?array $orderBy = null, ?int $limit = null, ?int $offset = null): array
   125	    {
   126	        try {
   127	            $qb = $this->findByQueryBuilder($criteria, $orderBy);
   128	        } catch (\BadMethodCallException) {
   129	            // 検索条件に未登録のEntityが指定された場合は空の配列を返却
   130	            return [];
   131	        }
   132	
   133	        // 取得件数がある場合は追加
   134	        if ($limit) {
   135	            $qb->setMaxResults($limit);
   136	        }
   137	        // オフセットがある場合は追加
   138	        if ($offset) {
   139	            $qb->setFirstResult($offset);
   140	        }

