7457:                <tr id="item-sheet-32-11"><td><a class="item-no" href="#pin-sheet-32-11">11</a></td><td>免税区分</td><td>ラベル</td><td>-</td><td>-</td><td>-</td><td>-</td></tr>
7458:                <tr id="item-sheet-32-12"><td><a class="item-no" href="#pin-sheet-32-12">12</a></td><td>MTGBuyer表示フラグ</td><td>ラベル</td><td>-</td><td>-</td><td>-</td><td>-</td></tr>
