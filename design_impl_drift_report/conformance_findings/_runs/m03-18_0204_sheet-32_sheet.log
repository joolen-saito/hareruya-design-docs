    23	use Symfony\Component\Messenger\MessageBusInterface;
    24	
    25	class SmaregiSectionEventService
    26	{
    27	    public function __construct(
    28	        private readonly MessageBusInterface $messageBus,
    29	        private readonly EntityManagerInterface $entityManager,
    30	        private readonly LoggerInterface $logger,
    31	    ) {
    32	    }
    33	
    34	    public function dispatchUpsert(MtbSection $section): void
    35	    {
    36	        $job = new MessengerJob();
    37	        $job->setMessageClass(SmaregiSectionUpsertMessage::class);
    38	        $job->setStatus(MessengerJob::STATUS_PENDING);
    39	        $job->setPayloadSummary(sprintf(
    40	            'sectionId=%d name=%s code=%s',
    41	            $section->getId(),
    42	            $section->getName(),
    43	            $section->getCode(),
    44	        ));
    45	        $this->entityManager->persist($job);
    46	        $this->entityManager->flush();
    47	
    48	        try {
    49	            $this->messageBus->dispatch(new SmaregiSectionUpsertMessage(
    50	                $section->getId(),
    51	                $section->getName(),
    52	                $section->getCode(),
    53	                (int) $job->getId(),
    54	            ));
    55	        } catch (\Throwable $e) {
    56	            try {
    57	                $job->setStatus(MessengerJob::STATUS_FAILED);
    58	                $job->setCompletedAt(new \DateTime());
    59	                $job->setErrorMessage('メッセージバスへの投入に失敗しました: '.$e->getMessage());
    60	                $this->entityManager->flush();
    61	            } catch (\Throwable $persistError) {
    62	                $this->logger->error('Failed to persist Smaregi section upsert job failure state', [
    63	                    'jobId' => $job->getId(),
    64	                    'sectionId' => $section->getId(),
    65	                    'error' => $persistError->getMessage(),
    66	                ]);
    67	            }
    68	            $this->logger->error('Smaregi section upsert message dispatch failed', [
    69	                'exception' => $e,
    70	                'jobId' => $job->getId(),
    71	                'sectionId' => $section->getId(),
    72	            ]);
    73	
    74	            throw $e;
    75	        }
