    16	namespace Eccube\MessageHandler;
    17	
    18	use Doctrine\ORM\EntityManagerInterface;
    19	use Eccube\Entity\Master\MtbSection;
    20	use Eccube\Entity\MessengerJob;
    21	use Eccube\Message\SmaregiSectionUpsertMessage;
    22	use Eccube\Repository\Master\MtbSectionRepository;
    23	use Eccube\Repository\MessengerJobRepository;
    24	use Eccube\Service\Smaregi\Api\SmaregiAccessTokenService;
    25	use Eccube\Service\Smaregi\Api\SmaregiMessengerJobContext;
    26	use Eccube\Service\Smaregi\Api\SmaregiSectionApiClient;
    27	use Psr\Log\LoggerInterface;
    28	use Symfony\Component\Messenger\Attribute\AsMessageHandler;
    29	
    30	#[AsMessageHandler]
    31	final readonly class SmaregiSectionUpsertMessageHandler
    32	{
    33	    public function __construct(
    34	        private LoggerInterface $logger,
    35	        private EntityManagerInterface $entityManager,
    36	        private MessengerJobRepository $messengerJobRepository,
    37	        private MtbSectionRepository $mtbSectionRepository,
    38	        private SmaregiAccessTokenService $accessTokenService,
    39	        private SmaregiSectionApiClient $sectionApiClient,
    40	        private SmaregiMessengerJobContext $smaregiMessengerJobContext,
    41	        private string $smaregiApiIdUrl,
    42	        private string $smaregiApiUrl,
    43	        private string $smaregiApiClientId,
    44	        private string $smaregiApiClientSecret,
    45	        private string $smaregiApiContractId,
    46	    ) {
    47	    }
    48	
    49	    public function __invoke(SmaregiSectionUpsertMessage $message): void
    50	    {
    51	        $Job = $this->messengerJobRepository->find($message->getJobId());
    52	        if (!$Job instanceof MessengerJob) {
    53	            $this->logger->error('MessengerJob not found for SmaregiSectionUpsertMessage', [
    54	                'jobId' => $message->getJobId(),
    55	                'sectionId' => $message->getSectionId(),
    56	            ]);
    57	
    58	            return;
    59	        }
    60	
    61	        $Section = $this->mtbSectionRepository->find($message->getSectionId());
    62	        if (!$Section instanceof MtbSection) {
    63	            $this->failJob($Job, '部門が見つかりません (sectionId='.$message->getSectionId().').');
    64	
    65	            return;
    66	        }
    67	
    68	        $this->smaregiMessengerJobContext->setJobId((int) $Job->getId());
    69	        try {
    70	            $Job->setStatus(MessengerJob::STATUS_PROCESSING);
    71	            $Job->setStartedAt(new \DateTime());
    72	            $Job->setErrorMessage(null);
    73	            $this->entityManager->flush();
    74	
    75	            try {
    76	                $accessToken = $this->accessTokenService->getAccessToken(
    77	                    $this->smaregiApiIdUrl,
    78	                    $this->smaregiApiContractId,
    79	                    $this->smaregiApiClientId,
    80	                    $this->smaregiApiClientSecret,
    81	                );
    82	
    83	                $smaregiCategoryId = $Section->getSmaregiCategoryId();
    84	                $trimmedSmaregiId = $smaregiCategoryId !== null ? trim($smaregiCategoryId) : '';
    85	
    86	                if ($trimmedSmaregiId === '') {
    87	                    $resolvedId = $this->resolveCategoryIdFromList($Section, $accessToken);
    88	                    if ($resolvedId !== null && $resolvedId !== '') {
    89	                        $Section->setSmaregiCategoryId($resolvedId);
    90	                        $this->entityManager->persist($Section);
    91	                        $this->assertSectionUpdateOk(
    92	                            $Section,
    93	                            $accessToken,
    94	                            $resolvedId,
    95	                        );
    96	                    } else {
    97	                        $result = $this->sectionApiClient->create(
    98	                            $this->smaregiApiUrl,
    99	                            $this->smaregiApiContractId,
   100	                            $accessToken,
   101	                            $Section->getCode(),
   102	                            $Section->getName(),
   103	                        );
   104	                        $statusCode = $result['statusCode'];
   105	                        if ($statusCode !== 200) {
   106	                            $resolvedAfterCreateFail = $this->resolveCategoryIdFromList($Section, $accessToken);
   107	                            if ($resolvedAfterCreateFail !== null && $resolvedAfterCreateFail !== '') {
   108	                                $Section->setSmaregiCategoryId($resolvedAfterCreateFail);
   109	                                $this->entityManager->persist($Section);
   110	                                $this->assertSectionUpdateOk(
   111	                                    $Section,
   112	                                    $accessToken,
   113	                                    $resolvedAfterCreateFail,
   114	                                );
   115	                            } else {
   116	                                throw new \RuntimeException('スマレジ部門登録APIが失敗しました (status='.$statusCode.').');
   117	                            }
   118	                        } else {
   119	                            $newId = $this->extractCategoryIdFromResponse($result['json'] ?? null);
   120	                            if ($newId === null || $newId === '') {
   121	                                throw new \RuntimeException('スマレジ部門登録APIの応答に categoryId が含まれていません。');
   122	                            }
   123	                            $Section->setSmaregiCategoryId($newId);
   124	                            $this->entityManager->persist($Section);
   125	                        }
   126	                    }
   127	                } else {
   128	                    $this->assertSectionUpdateOk(
   129	                        $Section,
   130	                        $accessToken,
   131	                        $trimmedSmaregiId,
   132	                    );
   133	                }
   134	
   135	                $Job->setStatus(MessengerJob::STATUS_COMPLETED);
   136	                $Job->setCompletedAt(new \DateTime());
   137	                $Job->setErrorMessage(null);
   138	                $this->entityManager->flush();
   139	            } catch (\Throwable $e) {
   140	                try {
   141	                    $Job->setStatus(MessengerJob::STATUS_FAILED);
   142	                    $Job->setCompletedAt(new \DateTime());
   143	                    $Job->setErrorMessage($e->getMessage());
   144	                    $this->entityManager->flush();
   145	                } catch (\Throwable $persistError) {
   146	                    $this->logger->error('Failed to persist Smaregi section upsert job failure state', [
   147	                        'jobId' => $Job->getId(),
   148	                        'error' => $persistError->getMessage(),
   149	                    ]);
   150	                }
   151	
   152	                throw $e;
   153	            }
   154	        } finally {
   155	            $this->smaregiMessengerJobContext->clear();
   156	        }
   157	    }
   158	
   159	    private function failJob(MessengerJob $Job, string $errorMessage): void
   160	    {
   161	        $Job->setStatus(MessengerJob::STATUS_FAILED);
   162	        $Job->setCompletedAt(new \DateTime());
   163	        $Job->setErrorMessage($errorMessage);
   164	        try {
   165	            $this->entityManager->flush();
   166	        } catch (\Throwable $persistError) {
   167	            $this->logger->error('Failed to persist Smaregi section upsert job failure state', [
   168	                'jobId' => $Job->getId(),
   169	                'error' => $persistError->getMessage(),
   170	            ]);
   171	        }
   172	        $this->logger->error($errorMessage, ['jobId' => $Job->getId()]);
   173	    }
   174	
   175	    /**
   176	     * @param array<string,mixed>|null $json
   177	     */
   178	    private function extractCategoryIdFromResponse(?array $json): ?string
   179	    {
   180	        if ($json === null) {
   181	            return null;
   182	        }
   183	
   184	        $id = $json['categoryId'] ?? null;
   185	
   186	        return is_scalar($id) && (string) $id !== '' ? (string) $id : null;
   187	    }
   188	
   189	    private function assertSectionUpdateOk(
   190	        MtbSection $Section,
   191	        string $accessToken,
   192	        string $smaregiCategoryId,
   193	    ): void {
   194	        $result = $this->sectionApiClient->update(
   195	            $this->smaregiApiUrl,
   196	            $this->smaregiApiContractId,
   197	            $accessToken,
   198	            $smaregiCategoryId,
   199	            $Section->getName(),
   200	        );
   201	        $statusCode = $result['statusCode'];
   202	        if ($statusCode !== 200) {
   203	            throw new \RuntimeException('スマレジ部門更新APIが失敗しました (status='.$statusCode.').');
   204	        }
   205	    }
   206	
   207	    /**
   208	     * 部門一覧取得APIの結果から categoryId を解決する.
   209	     */
   210	    private function resolveCategoryIdFromList(MtbSection $Section, string $accessToken): ?string
   211	    {
   212	        $result = $this->sectionApiClient->listByCategoryCode(
   213	            $this->smaregiApiUrl,
   214	            $this->smaregiApiContractId,
   215	            $accessToken,
   216	            $Section->getCode(),
   217	        );
   218	        $statusCode = $result['statusCode'];
   219	        if ($statusCode !== 200) {
   220	            throw new \RuntimeException('スマレジ部門一覧APIが失敗しました (status='.$statusCode.').');
   221	        }
   222	
   223	        $json = $result['json'];
   224	        if ($json === null || $json === []) {
   225	            return null;
   226	        }
   227	
   228	        $code = $Section->getCode();
   229	        $candidates = [];
   230	        foreach ($json as $row) {
   231	            $rowId = $row['categoryId'] ?? null;
   232	            if (!is_scalar($rowId) || (string) $rowId === '') {
   233	                continue;
   234	            }
   235	            $idStr = (string) $rowId;
   236	            $rowCode = $row['categoryCode'] ?? null;
   237	            $candidates[] = ['id' => $idStr, 'code' => is_scalar($rowCode) ? (string) $rowCode : null];
   238	        }
   239	
   240	        $exactMatchIds = [];
   241	        foreach ($candidates as $c) {
   242	            if ($c['code'] === $code) {
   243	                $exactMatchIds[$c['id']] = $c['id'];
   244	            }
   245	        }
   246	
   247	        if (count($exactMatchIds) === 1) {
   248	            return array_values($exactMatchIds)[0];
   249	        }
   250	
   251	        if (count($exactMatchIds) > 1) {
   252	            $this->logger->warning('スマレジ部門一覧で categoryId を一意に決められませんでした。', [
   253	                'sectionCode' => $code,
   254	                'matchCount' => count($exactMatchIds),
   255	                'reason' => 'duplicate_category_code',
   256	            ]);
   257	
   258	            return null;
   259	        }
   260	

