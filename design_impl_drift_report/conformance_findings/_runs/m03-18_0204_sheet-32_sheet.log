    65	    }
    66	
    67	    public function onAfterImport(AfterReadEvent $event): void
    68	    {
    69	        if ($event->isSuccessful()) {
    70	            $uniqueById = [];
    71	            foreach ($this->sectionsForSmaregi as $Section) {
    72	                $id = $Section->getId();
    73	                if ($id !== 0) {
    74	                    $uniqueById[(int) $id] = $Section;
