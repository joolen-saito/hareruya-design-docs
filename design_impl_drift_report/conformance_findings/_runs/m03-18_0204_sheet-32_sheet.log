    83	        parent::onAfterImport($event);
    84	        $this->idColumn = null;
    85	        $this->nameColumn = null;
    86	        $this->codeColumn = null;
    87	        $this->taxFreeColumn = null;
    88	        $this->visibleColumn = null;
    89	    }
    90	
    91	    /**
    92	     * ID 指定行は数値形式と部門存在を検証する（未存在・非数値のとき新規登録へ落とさない）。
    93	     */
    94	    public function onValidateRow(ReadCsvRowEvent $event): void
    95	    {
    96	        parent::onValidateRow($event);
    97	        if ($event->isBreakAll() || $event->isSkipRow()) {
    98	            return;
    99	        }
   100	
   101	        $row = $event->getRow();
   102	        $idRaw = trim((string) $row->getValue('ID'));
   103	        if ($idRaw === '') {
   104	            return;
   105	        }
   106	
   107	        $messageStore = $event->getMessageStore();
   108	        $rowNumber = $row->getRowNumber();
   109	        $idLabel = $this->idColumn->getLabel();
   110	
   111	        if (!SqlUtil::isNumericParam($idRaw)) {
   112	            $messageStore->addNumericError($rowNumber, $idLabel);
   113	            $event->breakAll();
   114	
   115	            return;
   116	        }
   117	
   118	        $id = (int) $idRaw;
   119	        if ($this->sectionRepository->find($id) === null) {
   120	            $messageStore->addMasterNotExistsError($rowNumber, $idLabel, $idRaw);
   121	            $event->breakAll();
   122	        }
   123	    }
   124	
   125	    public function onReadRow(ReadCsvRowEvent $event): bool
   126	    {
   127	        $row = $event->getRow();
   128	        $idRaw = trim((string) $this->idColumn->getValue($row));
   129	        $name = trim((string) $this->nameColumn->getValue($row));
   130	        $code = trim((string) $this->codeColumn->getValue($row));
   131	        $taxFree = (int) $this->taxFreeColumn->getValue($row);
   132	        $visibleRaw = trim((string) $this->visibleColumn->getValue($row));
   133	        $visible = $visibleRaw === '1';
   134	
   135	        $em = $this->sectionRepository->getEntityManager();
   136	
   137	        if ($idRaw === '') {
   138	            $Section = new MtbSection();
   139	            $Section->setName($name);
   140	            $Section->setCode($code);
   141	            $Section->setTaxFreeDivision($taxFree);
   142	            $Section->setVisible($visible);
   143	            $em->persist($Section);
   144	        } else {
   145	            $Section = $this->sectionRepository->find((int) $idRaw);
   146	            \assert($Section instanceof MtbSection);
   147	            $Section->setName($name);
   148	            $Section->setCode($code);
   149	            $Section->setTaxFreeDivision($taxFree);
   150	            $Section->setVisible($visible);
   151	        }
   152	
   153	        $this->sectionsForSmaregi[] = $Section;
   154	
   155	        return true;
   156	    }
   157	
