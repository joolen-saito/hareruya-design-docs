namespace Eccube\Repository;

use Doctrine\DBAL\ParameterType;
use Doctrine\DBAL\Types\Types;
use Doctrine\ORM\QueryBuilder;
use Doctrine\Persistence\ManagerRegistry as RegistryInterface;
use Eccube\Entity\BaseInfo;
use Eccube\Entity\DtbStockUpQuantity;
use Eccube\Entity\Master\MtbLanguage;
use Eccube\Entity\Master\MtbPromotion;
use Eccube\Entity\ProductClass;
use Eccube\Entity\ProductStock;
use Eccube\Entity\ProductTag;
use Eccube\Service\Admin\Stock\ActionInput\StockListSearchInput;

/**
 * ProductClassRepository
 *
 * This class was generated by the Doctrine ORM. Add your own custom
 * repository methods below.
 *
 * @extends AbstractRepository<ProductStock>
 */
class ProductStockRepository extends AbstractRepository
{
    /** 管理画面在庫一覧検索の `LIKE ... ESCAPE` 用（パラメータ側エスケープと一致） */
    private const ADMIN_STOCK_LIST_LIKE_ESCAPE_CHAR = '!';

    public function __construct(RegistryInterface $registry)
    {
        parent::__construct($registry, ProductStock::class);
    }

    /**
     * 在庫一覧（M04-01）用 QueryBuilder。
     *
     * 同一商品規格の EC-CUBE / スマレジ行が隣接するよう
     * ProductClass.id ASC → stockLocationId ASC でソートする。
     *
     * StockListSearchInput のうち、現時点で反映する条件のみを適用する（詳細の未実装分は今後ここへ追加）。
     */
    public function getQueryBuilderForAdminStockList(StockListSearchInput $input): QueryBuilder
    {
        $qb = $this->createQueryBuilder('ps')
            ->innerJoin('ps.ProductClass', 'pc')
            ->innerJoin('pc.Product', 'p');

        $productNameTrimmed = $input->productName !== null ? trim($input->productName) : '';
        if ($productNameTrimmed !== '') {
            $qb->andWhere('p.name LIKE :productName'.$this->adminStockListLikeEscapeDql())
                ->setParameter('productName', $this->adminStockListEscapeLikePattern($productNameTrimmed));
        }

        $cardNameTrimmed = $input->cardName !== null ? trim($input->cardName) : '';
        if ($cardNameTrimmed !== '') {
            $qb->leftJoin('p.CardDetail', 'sl_cd')
                ->leftJoin('sl_cd.Card', 'sl_card');
            $esc = $this->adminStockListLikeEscapeDql();
            $qb->andWhere('(sl_card.name_jp LIKE :stockListCardName'.$esc.' OR sl_card.name_en LIKE :stockListCardName'.$esc.')')
                ->setParameter('stockListCardName', $this->adminStockListEscapeLikePattern($cardNameTrimmed));
        }

        $productIdTrimmed = $input->productId !== null ? trim($input->productId) : '';
        if ($productIdTrimmed !== '') {
            $qb->andWhere("CONCAT(p.id, '') LIKE :stockListProductId".$this->adminStockListLikeEscapeDql())
                ->setParameter('stockListProductId', $this->adminStockListEscapeLikePattern($productIdTrimmed));
        }

        $productCodeTrimmed = $input->productCode !== null ? trim($input->productCode) : '';
        if ($productCodeTrimmed !== '') {
            $qb->andWhere('pc.code LIKE :productCode'.$this->adminStockListLikeEscapeDql())
                ->setParameter('productCode', $this->adminStockListEscapeLikePattern($productCodeTrimmed));
        }

        if ($input->baseInfos !== []) {
            $qb->andWhere($qb->expr()->in('ps.baseInfo', ':stockListBaseInfos'))
                ->setParameter('stockListBaseInfos', $input->baseInfos);
        }

        if ($input->stockLocationIds !== []) {
            $qb->andWhere('ps.stockLocationId IN (:stockLocationIds)')
                ->setParameter('stockLocationIds', $input->stockLocationIds);
        }

        if ($input->updateDateFrom !== null) {
            $qb->andWhere('pc.update_date >= :stockListUpdateDateFrom')
                ->setParameter('stockListUpdateDateFrom', $input->updateDateFrom);
        }
        if ($input->updateDateTo !== null) {
            $toExclusive = \DateTimeImmutable::createFromInterface($input->updateDateTo)
                ->modify('+1 day')
                ->setTime(0, 0, 0);
            $qb->andWhere('pc.update_date < :stockListUpdateDateToExclusive')
                ->setParameter('stockListUpdateDateToExclusive', $toExclusive);
        }

        if ($input->cardConditions !== []) {
            $qb->andWhere($qb->expr()->in('pc.CardCondition', ':stockListCardConditions'))
                ->setParameter('stockListCardConditions', $input->cardConditions);
        }

        // CardDetail が必要なフィルターがある場合に一度だけ LEFT JOIN
        if (
            $input->cardsets !== []
            || $input->foilValues !== []
            || $input->rarities !== []
            || $input->frameValues !== []
            || $input->promotions !== []
        ) {
            $qb->leftJoin('p.CardDetail', 'sl_cd_main');
        }

        // エキスパンション（カードセット）フィルター
        if ($input->cardsets !== []) {
            $qb->andWhere($qb->expr()->in('sl_cd_main.Cardset', ':stockListCardsets'))
                ->setParameter('stockListCardsets', $input->cardsets);
        }

        // Foil フィルター
        if ($input->foilValues !== []) {
            $qb->andWhere($qb->expr()->in('sl_cd_main.foil_flg', ':stockListFoilValues'))
                ->setParameter('stockListFoilValues', $input->foilValues);
        }

        // レアリティフィルター
        if ($input->rarities !== []) {
            $qb->andWhere($qb->expr()->in('sl_cd_main.Rarity', ':stockListRarities'))
                ->setParameter('stockListRarities', $input->rarities);
        }

        // フレームフィルター
        if ($input->frameValues !== []) {
            $qb->andWhere($qb->expr()->in('sl_cd_main.frameFlg', ':stockListFrameValues'))
                ->setParameter('stockListFrameValues', $input->frameValues);
        }

        // プロモ種別フィルター
        // NON_PROMOTION_ID(1)=ノーマル → CardDetail.Promotion IS NULL
        // PROMOTION_ID(2)=プロモ      → CardDetail.Promotion IS NOT NULL
        // 両方選択時はフィルターなし（全件表示）
        if ($input->promotions !== []) {
            $promotionIds = array_map(fn (MtbPromotion $promo) => $promo->getId(), $input->promotions);
            $hasNormal = in_array(MtbPromotion::NON_PROMOTION_ID, $promotionIds, true);
            $hasPromo = in_array(MtbPromotion::PROMOTION_ID, $promotionIds, true);
            if (!($hasNormal && $hasPromo)) {
                if ($hasNormal) {
                    $qb->andWhere('sl_cd_main.Promotion IS NULL');
                } else {
                    $qb->andWhere('sl_cd_main.Promotion IS NOT NULL');
                }
            }
        }

        // カテゴリフィルター: p.ProductCategories.Category
        if ($input->categories !== []) {
            $qb->innerJoin('p.ProductCategories', 'sl_pcat')
                ->andWhere($qb->expr()->in('sl_pcat.Category', ':stockListCategories'))
                ->setParameter('stockListCategories', $input->categories);
        }

        // 公開状態フィルター: p.Status
        if ($input->statuses !== []) {
            $qb->andWhere($qb->expr()->in('p.Status', ':stockListStatuses'))
                ->setParameter('stockListStatuses', $input->statuses);
        }

        // セールフラグフィルター
        if ($input->saleFlag) {
            $qb->andWhere('pc.sale_flg = true');
        }

        // 高額商品フィルター
        // STATUS_HIGH_PRICE(1)  → high_price_code IS NOT NULL
        // STATUS_NORMAL_PRICE(2) → high_price_code IS NULL
        // 両方選択時はフィルターなし
        if ($input->expensiveValues !== []) {
            $hasHigh = in_array(ProductClass::STATUS_HIGH_PRICE, $input->expensiveValues, true);
            $hasNormal = in_array(ProductClass::STATUS_NORMAL_PRICE, $input->expensiveValues, true);
            if (!($hasHigh && $hasNormal)) {
                if ($hasHigh) {
                    $qb->andWhere($qb->expr()->isNotNull('pc.high_price_code'));
                } else {
                    $qb->andWhere($qb->expr()->isNull('pc.high_price_code'));
                }
            }
        }

        // タグフィルター: p.ProductTag.Tag
        // JOIN だと同一商品がタグ数ぶん重複するため EXISTS にする
        if ($input->tags !== []) {
            $tagSubQb = $this->getEntityManager()->createQueryBuilder()
