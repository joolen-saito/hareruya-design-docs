{% extends '@admin/default_frame.twig' %}

{% set menus = ['product', 'product_edit'] %}

{% block title %}{{ 'admin.product.product_class_list'|trans }}{% endblock %}
{% block sub_title %}{{ 'admin.product.product_management'|trans }}{% endblock %}

{% block main %}
    <div class="c-contentsArea__cols">
        <div class="c-contentsArea__primaryCol">
            <div class="c-primaryCol">
                <div class="card rounded border-0 mb-4">
                    <div id="ex-product_class-header" class="card-header">
                        <div class="row">
                            <div class="col-8">
                                <div class="mb-2">
                                    <span class="text-muted">{{ 'admin.product.name'|trans }}</span>
                                </div>
                                <span class="card-title align-middle fw-bold">{{ Product.name }}</span>
                            </div>
                            <div class="col-4 text-end d-flex align-items-center justify-content-end">
                                <a href="{{ url('admin_product_product_class_new', {'id': Product.id}) }}" class="btn btn-ec-regular btn-sm">
                                    {{ 'admin.common.registration__new'|trans }}
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="card rounded border-0 mb-4">
                    <div class="card-header">
                        <div class="row">
                            <div class="col-12">
                                <span class="align-middle">
                                    {{ 'admin.common.search_result'|trans({'%count%': ActiveProductClasses|length}) }}
                                </span>
                            </div>
                        </div>
                    </div>
                    <div id="ex-product_class" class="card-body p-0">
                        <table class="table table-sm">
                            <thead>
                            <tr>
                                <th class="pt-2 pb-2 ps-3">{{ 'admin.product.display_status'|trans }}</th>
                                <th class="pt-2 pb-2">{{ 'admin.product.language'|trans }}</th>
                                <th class="pt-2 pb-2">{{ 'admin.product.card_condition'|trans }}</th>
                                <th class="pt-2 pb-2">{{ 'admin.product.smaregi_alignment_flg'|trans }}</th>
                                <th class="pt-2 pb-2">{{ 'admin.product.product_code'|trans }}</th>
                                <th class="pt-2 pb-2">{{ 'admin.product.stock'|trans }}</th>
                                <th class="pt-2 pb-2">{{ 'admin.product.sale_limit'|trans }}</th>
                                <th class="pt-2 pb-2">{{ 'admin.product.standard_price'|trans }}</th>
                                <th class="pt-2 pb-2">{{ 'admin.product.sale_price'|trans }}</th>
                                <th class="pt-2 pb-2">{{ 'admin.product.buy_price'|trans }}</th>
                                <th class="pt-2 pb-2 pe-3"></th>
                            </tr>
                            </thead>
                            <tbody>
                            {% for ProductClass in ActiveProductClasses %}
                                {% set Product = ProductClass.Product %}
                                <tr id="ex-product_class-{{ ProductClass.id }}">
                                    <td class="align-middle ps-3">
                                        {{ ProductClass.Status ? ProductClass.Status.name : '' }}
                                    </td>
                                    <td class="align-middle">
                                        {{ ProductClass.Language ? ProductClass.Language.nameJp : '' }}
                                    </td>
                                    <td class="align-middle">
                                        {{ ProductClass.CardCondition ? ProductClass.CardCondition.code : '' }}
                                    </td>
                                    <td class="align-middle">
                                        {{ ProductClass.smaregiAlignmentFlg ? 'ON' : 'OFF' }}
                                    </td>
                                    <td class="align-middle">
                                        {{ ProductClass.code ? ProductClass.code : '' }}
                                    </td>
                                    <td class="align-middle">
                                        {% if ProductClass.stockUnlimited %}
                                            {{ 'admin.product.stock_unlimited__short'|trans }}
                                        {% else %}
                                            {{ mainStoreDisplayStocks[ProductClass.id]|default(0) }}
                                        {% endif %}
                                    </td>
                                    <td class="align-middle">
                                        {{ ProductClass.sale_limit ? ProductClass.sale_limit : '' }}
                                    </td>
                                    <td class="align-middle">
                                        {{ ProductClass.standardPrice ? ProductClass.standardPrice|number_format : '' }}
                                    </td>
                                    <td class="align-middle">
                                        {{ ProductClass.price02 ? ProductClass.price02|number_format : '' }}
                                    </td>
                                    <td class="align-middle">
                                        {{ ProductClass.buy_price ? ProductClass.buy_price|number_format : '' }}
                                    </td>
                                    <td class="align-middle pe-3">
                                        <a href="{{ url('admin_product_product_class_edit', {'id': Product.id, 'productClassId': ProductClass.id}) }}" class="btn btn-ec-regular btn-sm">
                                            {{ 'admin.common.edit'|trans }}
                                        </a>
                                    </td>
                                </tr>
                            {% endfor %}
                            </tbody>
                        </table>
                    </div>
                </div>
                <div class="card rounded border-0 mb-4">
                    <div class="card-header">
                        <div class="row justify-content-between">
                            <div class="col-6">
                                <span class="align-middle">
                                    {{ 'admin.product.abolished_product_class'|trans }}
                                </span>
                            </div>
                            <div class="col-4 text-end">
                                <a data-bs-toggle="collapse" href="#abolishedProductClass" aria-expanded="false"
                                   aria-controls="abolishedProductClass">
                                    <i class="fa fa-angle-down fa-lg"></i>
                                </a>
                            </div>
                        </div>
                    </div>
                    <div id="abolishedProductClass" class="collapse ec-cardCollapse card-body p-0">
                        <table class="table table-sm">
                            <thead>
                            <tr>
                                <th class="pt-2 pb-2 ps-3">{{ 'admin.product.language'|trans }}</th>
                                <th class="pt-2 pb-2">{{ 'admin.product.card_condition'|trans }}</th>
                                <th class="pt-2 pb-2">{{ 'admin.product.product_code'|trans }}</th>
                                <th class="pt-2 pb-2">{{ 'admin.product.stock'|trans }}</th>
                                <th class="pt-2 pb-2">{{ 'admin.product.sale_limit'|trans }}</th>
                                <th class="pt-2 pb-2">{{ 'admin.product.standard_price'|trans }}</th>
                                <th class="pt-2 pb-2">{{ 'admin.product.sale_price'|trans }}</th>
                                <th class="pt-2 pb-2">{{ 'admin.product.buy_price'|trans }}</th>
                            </tr>
                            </thead>
                            <tbody>
                            {% for ProductClass in AbolishedProductClasses %}
                                {% set Product = ProductClass.Product %}
                                <tr id="ex-product_class-{{ ProductClass.id }}">
                                    <td class="align-middle ps-3">
                                        {{ ProductClass.Language ? ProductClass.Language.nameJp : '' }}
                                    </td>
                                    <td class="align-middle">
                                        {{ ProductClass.CardCondition ? ProductClass.CardCondition.code : '' }}
                                    </td>
                                    <td class="align-middle">
                                        {{ ProductClass.code ? ProductClass.code : '' }}
                                    </td>
                                    <td class="align-middle">
                                        {% if ProductClass.stockUnlimited %}
                                            {{ 'admin.product.stock_unlimited__short'|trans }}
                                        {% else %}
                                            {{ mainStoreDisplayStocks[ProductClass.id]|default(0) }}
                                        {% endif %}
                                    </td>
                                    <td class="align-middle">
                                        {{ ProductClass.sale_limit ? ProductClass.sale_limit : '' }}
                                    </td>
                                    <td class="align-middle">
                                        {{ ProductClass.standardPrice ? ProductClass.standardPrice|number_format : '' }}
                                    </td>
                                    <td class="align-middle">
                                        {{ ProductClass.price02 ? ProductClass.price02|number_format : '' }}
                                    </td>
                                    <td class="align-middle">
                                        {{ ProductClass.buy_price ? ProductClass.buy_price|number_format : '' }}
                                    </td>
                                </tr>
                            {% endfor %}
                            </tbody>
                        </table>
                    </div>
                </div>
                <div class="c-conversionArea">
                    <div class="c-conversionArea__container">
                        <div class="row justify-content-between align-items-center">
                            <div class="col-6">
                                <div class="c-conversionArea__leftBlockItem">
                                    {% if return_product_list %}
                                        <a class="c-baseLink" href="{{ url('admin_product', {'resume': 1}) }}">
                                            <i class="fa fa-backward" aria-hidden="true"></i>
                                            <span>{{ 'admin.product.product_list'|trans }}</span>
                                        </a>
                                    {% else %}
                                        <a class="c-baseLink" href="{{ url('admin_product_product_edit', {'id': Product.id}) }}">
                                            <i class="fa fa-backward" aria-hidden="true"></i>
                                            <span>{{ 'admin.product.product_registration'|trans }}</span>
                                        </a>
                                    {% endif %}
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
{% endblock %}

