    private function resolveMainStoreDisplayStock(ProductClass $ProductClass): int
    {
        $productClassId = $ProductClass->getId();
        if ($productClassId === null) {
            return 0;
        }

        $stocks = $this->productStockRepository->getMainStoreDisplayStockByProductClassIds([(int) $productClassId]);

        return (int) ($stocks[(int) $productClassId] ?? 0);
    }
