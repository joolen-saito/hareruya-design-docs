    /**
     * 公開ステータスが廃止ではない商品規格を取得
     *
     * @return array<int, ProductClass>
     */
    public function getActiveProductClasses(int $productId): array
    {
        $qb = $this->createQueryBuilder('pc');
        $qb->addSelect('ps')
            ->innerJoin('pc.Product', 'p')
            ->leftJoin('pc.Status', 'pcs')
            ->leftJoin('pc.ProductStock', 'ps')
            ->where('p.id = :productId')
            ->andWhere('pcs.id != :abolishedStatus')
            ->andWhere('pc.CardCondition IS NOT NULL')
            ->andWhere('pc.Language IS NOT NULL')
            ->setParameter('productId', $productId)
            ->setParameter('abolishedStatus', ProductStatus::DISPLAY_ABOLISHED)
            ->addOrderBy('pc.Language', 'ASC')
            ->addOrderBy('pc.CardCondition', 'ASC')
            ->addOrderBy('pc.price02', 'DESC')
            ->addOrderBy('pc.id', 'ASC');

        return $qb->getQuery()->getResult();
    }

    /**
     * 買取カート画面向けに規格と関連エンティティを取得する（移植元 getBuyOrderProductSubClasses）。
     *
     * @param array<int> $productClassIds
     *
     * @return list<ProductClass>
     */
    public function getBuyOrderProductClasses(array $productClassIds): array
    {
        $productClassIds = array_values(array_unique(array_map(static fn ($id): int => (int) $id, $productClassIds)));
        if ($productClassIds === []) {
            return [];
        }

        $qb = $this->createQueryBuilder('pc');

        $qb->select(['pc', 'p', 'l', 'cco', 'cd', 'pci', 'pi'])
            ->distinct()
            ->innerJoin('pc.Product', 'p')
            ->innerJoin('pc.Language', 'l')
            ->innerJoin('pc.CardCondition', 'cco', Join::WITH, $qb->expr()->eq('cco.code', ':condition'))
            ->leftJoin('p.CardDetail', 'cd')
            ->leftJoin('pc.ProductClassImages', 'pci')
            ->leftJoin('pci.ProductImage', 'pi')
            ->where($qb->expr()->in('pc.id', ':productClassIds'))
            ->andWhere($qb->expr()->gte('pc.buy_price', ':minBuyPrice'))
            ->andWhere($qb->expr()->isNull('pc.high_price_code'))
            ->setParameter('productClassIds', $productClassIds)
            ->setParameter('condition', self::PURCHASE_CONDITION)
            ->setParameter('minBuyPrice', self::MIN_BUY_PRICE)
            ->orderBy('p.id', 'ASC');

        /** @var list<ProductClass> */
        return $qb->getQuery()->getResult();
    }

    /**
     * 移植元: DtbProductSubClassRepository::getProductSubClassesForApplicationPrice
     *
     * @return list<ProductClass>
     */
    public function getProductClassesForApplicationPrice(int $productId, int $languageId, ?string $highPriceCode = null): array
    {
        $qb = $this->createQueryBuilder('pc')
            ->innerJoin('pc.Product', 'p')
            ->innerJoin('pc.Language', 'l')
            ->innerJoin('pc.CardCondition', 'cco')
            ->where('p.id = :productId')
            ->andWhere('l.id = :languageId')
            ->setParameter('productId', $productId)
            ->setParameter('languageId', $languageId);

        if ($highPriceCode !== null && $highPriceCode !== '') {
            $qb->andWhere('pc.high_price_code = :highPriceCode')
                ->setParameter('highPriceCode', $highPriceCode);
        } else {
            $qb->andWhere($qb->expr()->isNull('pc.high_price_code'));
        }

        /** @var list<ProductClass> */
        return $qb->getQuery()->getResult();
    }

    /**
     * UniSearch doc の product_class を正の規格 ID に正規化する。無効・欠落時は null。
     *
     * @param array<string, mixed> $doc
     */
    public function getProductClassIdFromUnisearchDoc(array $doc): ?int
    {
        if (!isset($doc['product_class']) || !is_numeric($doc['product_class'])) {
            return null;
        }

        $id = (int) $doc['product_class'];

        return $id > 0 ? $id : null;
    }

    /**
     * ユニサーチ doc 1件から ProductClass を解決する。
     * product_class があればその ID を優先（商品 ID・price02・visible・公開ステータスの整合を確認）。
     *
     * @param array<string, mixed> $doc
     */
    public function resolveProductClassForUnisearchDoc(array $doc): ?ProductClass
    {
        $pcId = $this->getProductClassIdFromUnisearchDoc($doc);
        if ($pcId !== null) {
            $pc = $this->find($pcId);
            if ($pc !== null) {
                $Product = $pc->getProduct();
                $productStatus = $Product !== null ? $Product->getStatus() : null;
                if (
                    $Product !== null
                    && $Product->getId() === (int) $doc['product']
                    && (int) $pc->getPrice02() > 0
                    && $pc->isVisible()
                    && $productStatus !== null
                    && $productStatus->getId() === ProductStatus::DISPLAY_SHOW
                ) {
                    return $pc;
                }
            }
        }

        $rawHighPriceCode = $doc['high_price_code'] ?? null;
        $highPriceCode = ($rawHighPriceCode !== null && (string) $rawHighPriceCode !== '')
            ? (string) $rawHighPriceCode
            : null;

        return $this->searchProductById([
            'id' => $doc['product'],
            'highPriceCode' => $highPriceCode,
            'languageId' => (int) ($doc['language'] ?? 0),
        ]);
    }

    /**
     * 買取 UniSearch 遅延描画: ID ごとの買取価格のみ取得（表示用）。
     *
     * @param list<int> $productClassIds
     *
     * @return array<int, int|null> product_class_id => buy_price
     */
    public function getBuyPricesByProductClassIds(array $productClassIds): array
    {
        $productClassIds = array_values(array_unique(array_filter(
            $productClassIds,
            static fn (int $id): bool => $id > 0,
        )));
        if ($productClassIds === []) {
            return [];
        }

        /** @var list<array{id: int, buy_price: int|null}> $rows */
        $rows = $this->createQueryBuilder('pc')
            ->select('pc.id', 'pc.buy_price')
            ->where('pc.id IN (:ids)')
            ->setParameter('ids', $productClassIds)
            ->getQuery()
            ->getArrayResult();

        $prices = [];
        foreach ($rows as $row) {
            $prices[(int) $row['id']] = $row['buy_price'] !== null ? (int) $row['buy_price'] : null;
        }

        return $prices;
    }

    /**
     * 移植元: pf-eccube3/app/Eccube/Repository/DtbProductSubClassRepository.php::searchProductById
     *
     * @param array<string, mixed> $keys id, languageId, highPriceCode（null または空文字は通常価格。フロント相当: visible かつ商品ステータス公開のみヒット）
     */
    public function searchProductById(array $keys): ?ProductClass
    {
        $qb = $this->createQueryBuilder('pc')
            ->innerJoin('pc.Product', 'p');

        $highPriceCode = $keys['highPriceCode'] ?? null;
        if ($highPriceCode === null || $highPriceCode === '') {
            $qb->where($qb->expr()->eq('p.id', ':id'))
                ->andWhere($qb->expr()->eq('IDENTITY(pc.Language)', ':languageId'))
                ->andWhere('pc.price02 > 0')
                ->andWhere('(pc.high_price_code IS NULL OR pc.high_price_code = :emptyHighPriceCode)')
                ->andWhere('pc.visible = true')
                ->andWhere('IDENTITY(p.Status) = :productStatusShowId')
                ->setParameter('id', $keys['id'])
                ->setParameter('languageId', $keys['languageId'])
                ->setParameter('emptyHighPriceCode', '')
                ->setParameter('productStatusShowId', ProductStatus::DISPLAY_SHOW);
        } else {
            $qb->where($qb->expr()->eq('p.id', ':id'))
                ->andWhere($qb->expr()->eq('IDENTITY(pc.Language)', ':languageId'))
                ->andWhere($qb->expr()->eq('pc.high_price_code', ':highPriceCode'))
                ->andWhere('pc.price02 > 0')
                ->andWhere('pc.visible = true')
                ->andWhere('IDENTITY(p.Status) = :productStatusShowId')
                ->setParameter('id', $keys['id'])
                ->setParameter('languageId', $keys['languageId'])
                ->setParameter('highPriceCode', (string) $keys['highPriceCode'])
                ->setParameter('productStatusShowId', ProductStatus::DISPLAY_SHOW);
        }

        $qb->setMaxResults(1);

        return $qb->getQuery()->getOneOrNullResult();
    }

