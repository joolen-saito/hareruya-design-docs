    /**
     * 商品規格IDごとに、本店（base_info_id = TC_TOKYO_ID）在庫と支店（dtb_base_info.is_main_shop = false）合計在庫を取得する。
     *
     * @param array<int> $productClassIds
     *
     * @return array<int, array{mainStoreStock:int,branchTotalStock:int}>
     */
    public function getStockSummaryByProductClassIds(array $productClassIds): array
    {
        if ($productClassIds === []) {
            return [];
        }

        $rows = $this->getEntityManager()->getConnection()->fetchAllAssociative(
            'SELECT
                ps.product_class_id,
                COALESCE(SUM(CASE WHEN ps.base_info_id = :mallBaseInfoId THEN ps.stock ELSE 0 END), 0) AS main_store_stock,
                COALESCE(SUM(CASE WHEN bi.is_main_shop = false THEN ps.stock ELSE 0 END), 0) AS branch_total_stock
            FROM dtb_product_stock ps
            JOIN dtb_base_info bi ON ps.base_info_id = bi.id
            WHERE ps.product_class_id IN (:ids)
            GROUP BY ps.product_class_id',
            [
                'ids' => $productClassIds,
