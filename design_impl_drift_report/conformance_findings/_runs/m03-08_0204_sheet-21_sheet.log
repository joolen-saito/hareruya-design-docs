namespace Eccube\Controller\Admin\Product;

use Doctrine\Common\Collections\ArrayCollection;
use Doctrine\DBAL\Exception\ForeignKeyConstraintViolationException;
use Doctrine\ORM\NonUniqueResultException;
use Doctrine\ORM\NoResultException;
use Eccube\Controller\AbstractController;
use Eccube\Entity\ClassCategory;
use Eccube\Entity\ClassName;
use Eccube\Entity\Product;
use Eccube\Entity\ProductClass;
use Eccube\Entity\ProductStock;
use Eccube\Entity\Views\MallReferenceViaTenantView;
use Eccube\Form\Type\Admin\ProductClassMatrixType;
use Eccube\Form\Type\Admin\ProductClassType;
use Eccube\Repository\ClassCategoryRepository;
use Eccube\Repository\ProductClassRepository;
use Eccube\Repository\ProductRepository;
use Eccube\Repository\ProductStockRepository;
use Eccube\Repository\TaxRuleRepository;
use Eccube\Repository\Views\MallReferenceViaTenantViewRepository;
use Eccube\Service\Admin\Product\ProductClassDeleteAction;
use Eccube\Service\Admin\Product\ProductClassStoreAction;
use Eccube\Service\Admin\Product\ProductClassUpdateAction;
use Eccube\Service\Smaregi\SmaregiProductClassEventService;
use Eccube\Util\CacheUtil;
use Symfony\Bridge\Doctrine\Attribute\MapEntity;
use Symfony\Bridge\Twig\Attribute\Template;
use Symfony\Component\Form\Extension\Core\Type\FormType;
use Symfony\Component\Form\FormInterface;
use Symfony\Component\HttpFoundation\RedirectResponse;
use Symfony\Component\HttpFoundation\Request;
use Symfony\Component\HttpKernel\Exception\NotFoundHttpException;
use Symfony\Component\Routing\Attribute\Route;

class ProductClassController extends AbstractController
{
    private readonly MallReferenceViaTenantView $mallBaseInfo;

    /**
     * ProductClassController constructor.
     */
    public function __construct(
        protected ProductRepository $productRepository,
        protected ProductClassRepository $productClassRepository,
        protected ProductStockRepository $productStockRepository,
        protected ClassCategoryRepository $classCategoryRepository,
        MallReferenceViaTenantViewRepository $mallReferenceViaTenantViewRepository,
        protected TaxRuleRepository $taxRuleRepository,
    ) {
        $this->mallBaseInfo = $mallReferenceViaTenantViewRepository->getMallBaseInfo();
    }

    /**
     * @return RedirectResponse|array<string, mixed>
     *
     * @throws NotFoundHttpException|NonUniqueResultException
     */
    #[Route('/%eccube_admin_route%/product/product/class/{id}', name: 'admin_product_product_class', requirements: ['id' => '\d+'], methods: ['GET', 'POST'])]
    #[Template('@admin/Product/ProductClass/index.twig')]
    public function index(Request $request, Product $Product, CacheUtil $cacheUtil): RedirectResponse|array
    {
        // 公開ステータスが廃止ではない商品規格を取得
        $ActiveProductClasses = $this->productClassRepository->getActiveProductClasses($Product->getId());

        // 公開ステータスが廃止の商品規格を取得
        $AbolishedProductClasses = $this->productClassRepository->getAbolishedProductClasses($Product->getId());

        $productClassIds = [];
        foreach (array_merge($ActiveProductClasses, $AbolishedProductClasses) as $ProductClass) {
            if ($ProductClass->getId() !== null) {
                $productClassIds[] = (int) $ProductClass->getId();
            }
        }
        $mainStoreDisplayStocks = $this->productStockRepository->getMainStoreDisplayStockByProductClassIds($productClassIds);

        return [
            'Product' => $Product,
            'ActiveProductClasses' => $ActiveProductClasses,
            'AbolishedProductClasses' => $AbolishedProductClasses,
            'mainStoreDisplayStocks' => $mainStoreDisplayStocks,
            'return_product_list' => (bool) $request->get('return_product_list', false),
        ];
    }

    /**
     * @return array<string, mixed>
     */
    #[Route('/%eccube_admin_route%/product/product/class/{id}/new', name: 'admin_product_product_class_new', requirements: ['id' => '\d+'], methods: ['GET', 'POST'])]
    #[Template('@admin/Product/ProductClass/edit.twig')]
    public function new(Product $Product): array
    {
        $ProductClass = new ProductClass();
        $ProductClass->setBaseInfo($this->getMember()->getBaseInfo());
        $ProductClass->setProduct($Product);
        $ProductClass->setSmaregiAlignmentFlg(false);

        $builder = $this->formFactory->createBuilder(ProductClassType::class, $ProductClass);
        $form = $builder->getForm();

        return [
            'Product' => $Product,
            'ProductClass' => $ProductClass,
            'form' => $form->createView(),
            'formAction' => $this->generateUrl('admin_product_product_class_store', ['id' => $Product->getId()]),
        ];
    }

    /**
     * @return RedirectResponse|array<string, mixed>
     */
    #[Route('/%eccube_admin_route%/product/product/class/{id}/store', name: 'admin_product_product_class_store', requirements: ['id' => '\d+'], methods: ['POST'])]
    #[Template('@admin/Product/ProductClass/edit.twig')]
    public function store(Request $request, Product $Product, ProductClassStoreAction $storeAction): RedirectResponse|array
    {
        $builder = $this->formFactory->createBuilder(ProductClassType::class, new ProductClass());
        $form = $builder->getForm();
        $form->handleRequest($request);

        if (!$form->isSubmitted() || !$form->isValid()) {
            $this->addError('admin.common.save_error', 'admin');

            return [
                'Product' => $Product,
                'ProductClass' => $form->getData(),
                'form' => $form->createView(),
                'formAction' => $this->generateUrl('admin_product_product_class_store', ['id' => $Product->getId()]),
            ];
        }

        $ProductClass = $form->getData();
        $ProductClassImages = $form->get('ProductClassImages')->getData();

        try {
            $storeAction->handle(
                $Product,
                $ProductClass,
                $ProductClassImages,
                $this->getMember()->getBaseInfo(),
                $this->getMember()->getId()
            );
        } catch (\Exception $e) {
            $this->addError($e->getMessage(), 'admin');

            return [
                'Product' => $Product,
                'ProductClass' => $form->getData(),
                'form' => $form->createView(),
                'formAction' => $this->generateUrl('admin_product_product_class_store', ['id' => $Product->getId()]),
            ];
        }

        $this->addSuccess('admin.common.save_complete', 'admin');

        return $this->redirectToRoute('admin_product_product_class', ['id' => $Product->getId()]);
    }

    /**
     * @return array<string, mixed>
     */
    #[Route('/%eccube_admin_route%/product/product/class/{id}/edit/{productClassId}', name: 'admin_product_product_class_edit', requirements: ['id' => '\d+', 'productClassId' => '\d+'], methods: ['GET'])]
    #[Template('@admin/Product/ProductClass/edit.twig')]
    public function edit(
        Product $Product,
        #[MapEntity(id: 'productClassId')]
        ProductClass $ProductClass,
    ): array {
        return [
            'Product' => $Product,
            'ProductClass' => $ProductClass,
            'mainStoreDisplayStock' => $this->resolveMainStoreDisplayStock($ProductClass),
            'form' => $this->formFactory
                ->createBuilder(ProductClassType::class, $ProductClass)
                ->getForm()
                ->createView(),
            'formAction' => $this->generateUrl('admin_product_product_class_update', [
                'id' => $Product->getId(),
                'productClassId' => $ProductClass->getId(),
            ]),
        ];
    }

    /**
     * @return RedirectResponse|array<string, mixed>
     */
    #[Route('/%eccube_admin_route%/product/product/class/{id}/update/{productClassId}', name: 'admin_product_product_class_update', requirements: ['id' => '\d+', 'productClassId' => '\d+'], methods: ['POST'])]
    #[Template('@admin/Product/ProductClass/edit.twig')]
    public function update(
        Request $request,
        Product $Product,
        #[MapEntity(id: 'productClassId')]
        ProductClass $ProductClass,
        ProductClassUpdateAction $updateAction,
    ): RedirectResponse|array {
        $form = $this->formFactory->createBuilder(ProductClassType::class, $ProductClass)->getForm();
        $form->handleRequest($request);

        if (!$form->isSubmitted() || !$form->isValid()) {
            $this->addError('admin.common.save_error', 'admin');

            return [
                'Product' => $Product,
                'ProductClass' => $ProductClass,
                'mainStoreDisplayStock' => $this->resolveMainStoreDisplayStock($ProductClass),
                'form' => $form->createView(),
                'formAction' => $this->generateUrl('admin_product_product_class_update', [
                    'id' => $Product->getId(),
                    'productClassId' => $ProductClass->getId(),
                ]),
            ];
        }

        // 更新前の販売価格と買取価格を保持
        $previousSellPrice = (int) $ProductClass->getPrice02();
        $previousBuyPrice = (int) $ProductClass->getBuyPrice();

        $ProductClassImages = $form->get('ProductClassImages')->getData();

        try {
            $updateAction->handle(
                $Product,
                $ProductClass,
                $ProductClassImages,
                $this->getMember()->getBaseInfo(),
                $this->getMember()->getId(),
                $previousSellPrice,
                $previousBuyPrice

