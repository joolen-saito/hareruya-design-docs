   121	
   122	            $destSourceQuantity = 0;
   123	            $destSourceStandardTotal = 0;
   124	            foreach ($splitJoin->getDetails() as $detail) {
   125	                $qty = $detail->getSplitJoinQuantity();
   126	                $destSourceQuantity += $qty;
   127	                $standardPrice = (int) $detail->getStandardPrice();
   128	                $destSourceStandardTotal += $standardPrice * $qty;
   129	            }
   130	
   131	            $rows[] = [
