   140	                'destination_source_standard_price_total' => (string) $destSourceStandardTotal,
   141	                'status' => $splitJoin->getStockSplitJoinStatus()->getName(),
   142	                'create_date' => $splitJoin->getCreateDate()->format('Y/m/d H:i'),
   143	                'registered_member' => $splitJoin->getRegisteredMember()->getName() ?? '-',
   144	            ];
   145	        }
