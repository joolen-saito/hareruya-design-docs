   888	    private function collectAdminExportReferencedAliases(): array
   889	    {
   890	        /** @var array<string, true> $aliases */
   891	        $aliases = [];
   892	        foreach ($this->getSelectedColumns() as $column) {
   893	            $def = self::getAvailableColumns()[$column['key']] ?? null;
   894	            if ($def === null) {
   895	                continue;
   896	            }
   897	            if (preg_match_all('/\b([a-z][a-z0-9]*)\s*\./i', (string) $def['column'], $m) > 0) {
   898	                foreach ($m[1] as $a) {
   899	                    $aliases[strtolower($a)] = true;
   900	                }
   901	            }
   902	        }
   903	        if ($this->target === self::TARGET_CARD || $this->target === self::TARGET_NON_CARD) {
   904	            $aliases['cd'] = true;
   905	            $aliases['c'] = true;
   906	        }
   907	        if ($this->cardCondition !== []) {
   908	            $aliases['cc'] = true;
   909	        }
   910	        if ($this->productIdFrom !== null || $this->productIdTo !== null) {
   911	            $aliases['p'] = true;
   912	        }
   913	
   914	        return array_keys($aliases);
   915	    }
