    26	use Eccube\Service\EntityManager\CsvExtensionEntityManager;
    27	
    28	class CustomerCsvUpdateAction
    29	{
    30	    private EntityManagerInterface $entityManager;
    31	    private DtbCsvCsvExtensionRepository $csvCsvExtensionRepository;
    32	    private CsvRepository $csvRepository;
    33	    private CsvExtensionEntityManager $csvExtensionEntityManager;
    34	    private CsvCsvExtensionEntityManager $csvCsvExtensionEntityManager;
    35	
    36	    public function __construct(
    37	        EntityManagerInterface $entityManager,
    38	        DtbCsvCsvExtensionRepository $csvCsvExtensionRepository,
    39	        CsvRepository $csvRepository,
    40	        CsvExtensionEntityManager $csvExtensionEntityManager,
    41	        CsvCsvExtensionEntityManager $csvCsvExtensionEntityManager,
    42	    ) {
    43	        $this->entityManager = $entityManager;
    44	        $this->csvCsvExtensionRepository = $csvCsvExtensionRepository;
    45	        $this->csvRepository = $csvRepository;
    46	        $this->csvExtensionEntityManager = $csvExtensionEntityManager;
    47	        $this->csvCsvExtensionEntityManager = $csvCsvExtensionEntityManager;
    48	    }
    49	
    50	    /**
    51	     * @param DtbCsvExtension $CsvExtension
    52	     * @param CsvType $CsvType
    53	     * @param array<string, mixed> $requestData
    54	     * @param Member $member
    55	     */
    56	    public function handle(
    57	        DtbCsvExtension $CsvExtension,
    58	        CsvType $CsvType,
    59	        array $requestData,
    60	        Member $member,
    61	    ): void {
    62	        $this->entityManager->beginTransaction();
    63	
    64	        try {
    65	            $this->csvExtensionEntityManager->save(
    66	                $CsvExtension,
    67	                $CsvType,
    68	                $requestData['name'],
    69	                $member
    70	            );
    71	            $this->entityManager->flush();
    72	
    73	            if ($CsvExtension->getCsvCsvExtensions()->count() > 0) {
    74	                $this->csvCsvExtensionRepository->deleteByCsvExtensionId($CsvExtension->getId());
    75	            }
    76	
    77	            $csvIds = isset($requestData['csv_output']) ? $requestData['csv_output'] : [];
    78	            $Csvs = $this->csvRepository->findBy(['id' => $csvIds]);
    79	
    80	            foreach ($Csvs as $key => $Csv) {
    81	                $CsvCsvExtension = new DtbCsvCsvExtension();
    82	                $this->csvCsvExtensionEntityManager->save($CsvCsvExtension, $CsvExtension, $Csv, $key);
    83	            }
    84	            $this->entityManager->flush();
    85	            $this->entityManager->commit();
    86	        } catch (\Exception $e) {
    87	            $this->entityManager->rollback();
    88	
    89	            throw $e;
    90	        }
    91	    }
    92	}

