 * file that was distributed with this source code.
 */

namespace Eccube\Repository;

use Doctrine\ORM\QueryBuilder;
use Doctrine\Persistence\ManagerRegistry;
use Eccube\Entity\DtbOtcBuyOrderSummary;

/**
 * @extends AbstractRepository<DtbOtcBuyOrderSummary>
 */
class DtbOtcBuyOrderSummaryRepository extends AbstractRepository
{
    public function __construct(ManagerRegistry $registry)
    {
        parent::__construct($registry, DtbOtcBuyOrderSummary::class);
    }

    /**
     * @param array<string, mixed> $searchData
     */
    public function getQueryBuilderBySearchData(array $searchData): QueryBuilder
    {
        $qb = $this->createQueryBuilder('otcs')
            ->leftJoin('otcs.Section', 's')
            ->select([
                's.name AS sectionName',
                's.code AS sectionCode',
                'otcs.summaryDate',
                'SUM(otcs.sellPrice) AS sellPriceTotal',
                'SUM(otcs.buyPrice) AS buyPriceTotal',
            ])
            ->where('otcs.summaryDate >= :summaryDateFrom')
            ->andWhere('otcs.summaryDate <= :summaryDateTo')
            ->setParameter('summaryDateFrom', $searchData['summary_date_from']->format('Y-m-d 00:00:00'))
            ->setParameter('summaryDateTo', $searchData['summary_date_to']->format('Y-m-d 23:59:59'))
            ->groupBy('otcs.summaryDate')
            ->addGroupBy('s.id')
            ->orderBy('otcs.summaryDate', 'ASC')
            ->addOrderBy('s.code', 'ASC')
        ;

        $shop = isset($searchData['shop'])
            ? (is_array($searchData['shop']) ? $searchData['shop'] : $searchData['shop']->toArray())
            : [];
        if (!empty($shop)) {
            $qb->andWhere('otcs.BaseInfo IN (:shop)')
                ->setParameter('shop', $shop);
        }

        $section = isset($searchData['section'])
            ? (is_array($searchData['section']) ? $searchData['section'] : $searchData['section']->toArray())
            : [];
        if (!empty($section)) {
            $qb->andWhere('s.id IN (:section)')
                ->setParameter('section', $section);
        }

        return $qb;
    }

    /**
     * 集計日のデータを削除して再登録する（1トランザクション）
     *
     * @param array<int, array{base_info_id: int, section_id: int, total_buy_price: int, total_sell_price: int}> $summary
     */
    public function replaceSummary(array $summary, \DateTime $summaryDate): void
    {
        $conn = $this->getEntityManager()->getConnection();
        $conn->beginTransaction();

        try {
            $this->deleteOtcBuyOrderSummary($summaryDate);
            $this->insertOtcBuyOrderSummary($summary, $summaryDate);
            $conn->commit();
        } catch (\Exception $e) {
            $conn->rollBack();
            throw $e;
        }
    }

    /**
     * 店頭買取集計の一括登録
     *
     * @param array<int, array{base_info_id: int, section_id: int, total_buy_price: int, total_sell_price: int}> $summary
     */
    private function insertOtcBuyOrderSummary(array $summary, \DateTime $summaryDate): void
    {
        if (empty($summary)) {
            return;
        }

        $conn = $this->getEntityManager()->getConnection();
        $summaryDateStr = $summaryDate->format('Y-m-d H:i:s');

        // バッチ INSERT: VALUES (?, ?, ?, ?, ?), (?, ?, ?, ?, ?), ...
        $placeholders = [];
        $params = [];
        foreach ($summary as $data) {
            $placeholders[] = '(?, ?, ?, ?, ?)';
            $params[] = $data['base_info_id'];
            $params[] = $data['section_id'];
            $params[] = $data['total_sell_price'];
            $params[] = $data['total_buy_price'];
            $params[] = $summaryDateStr;
        }

        $sql = 'INSERT INTO dtb_otc_buy_order_summary'
            .' (base_info_id, section_id, sell_price, buy_price, summary_date)'
            .' VALUES '.implode(', ', $placeholders);

        $conn->executeStatement($sql, $params);
    }

    /**
     * 集計日の店頭買取集計データを消去
     */
    private function deleteOtcBuyOrderSummary(\DateTime $summaryDate): void
    {
        $summaryDateStr = $summaryDate->format('Y-m-d 00:00:00');

        $sql = <<<'EOT'
            DELETE FROM dtb_otc_buy_order_summary
            WHERE summary_date = ?
        EOT;

        $this->getEntityManager()
            ->getConnection()
            ->executeStatement($sql, [
                $summaryDateStr,
            ]);
    }

    /**
     * 期間全体の集計データを取得する
     *
     * @param array<string, mixed> $searchData
     */
    public function aggregateDataBySectionForEntirePeriod(array $searchData): QueryBuilder
    {
        $qb = $this->getQueryBuilderBySearchData($searchData);
        $qb->select([
            's.name AS sectionName',
            's.code AS sectionCode',
            'SUM(otcs.sellPrice) AS sellPriceTotal',
            'SUM(otcs.buyPrice) AS buyPriceTotal',
        ])
            ->resetDQLPart('orderBy')
            ->resetDQLPart('groupBy')
            ->groupBy('s.id')
            ->orderBy('s.code', 'ASC');

        return $qb;
    }
}

