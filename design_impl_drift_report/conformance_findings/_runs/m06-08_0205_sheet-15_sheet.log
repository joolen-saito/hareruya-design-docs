namespace Eccube\Controller\Admin\OtcBuyOrder;

use Eccube\Controller\AbstractController;
use Eccube\Form\Type\Admin\OtcBuyOrder\OtcBuyOrderSummaryType;
use Eccube\Repository\DtbOtcBuyOrderSummaryRepository;
use Eccube\Service\Csv\Exporter\OtcBuyOrderSummaryCsvExportService;
use Eccube\Util\FormUtil;
use Symfony\Bridge\Twig\Attribute\Template;
use Symfony\Component\HttpFoundation\RedirectResponse;
use Symfony\Component\HttpFoundation\Request;
use Symfony\Component\HttpFoundation\StreamedResponse;
use Symfony\Component\Routing\Attribute\Route;

/**
 * 店頭買取管理
 */
class OtcBuyOrderSummaryController extends AbstractController
{
    private const SESSION_KEY = 'eccube.admin.otcbuyorder_summary.search';

    public function __construct(
        protected DtbOtcBuyOrderSummaryRepository $summaryRepository,
        protected OtcBuyOrderSummaryCsvExportService $summaryCsvExportService,
    ) {
    }

    /**
     * 買取集計データ
     *
     * @return array<string, mixed>
     */
    #[Route(path: '/%eccube_admin_route%/otcbuyorder/summary', name: 'admin_otcbuyorder_summary', methods: ['GET'])]
    #[Template(template: '@admin/OtcBuyOrder/summary.twig')]
    public function index(): array
    {
        $searchForm = $this->createForm(OtcBuyOrderSummaryType::class);

        return [
            'searchForm' => $searchForm->createView(),
            'searched' => false,
            'entirePeriodSummary' => null,
            'daysSummary' => null,
        ];
    }

    /**
     * 買取検索
     *
     * @return array<string, mixed>
     */
    #[Route(path: '/%eccube_admin_route%/otcbuyorder/summary/search', name: 'admin_otcbuyorder_summary_search', methods: ['POST'])]
    #[Template(template: '@admin/OtcBuyOrder/summary.twig')]
    public function search(Request $request): array
    {
        $searchForm = $this->createForm(OtcBuyOrderSummaryType::class);
        $searchForm->handleRequest($request);

        if (!$searchForm->isSubmitted() || !$searchForm->isValid()) {
            return [
                'searchForm' => $searchForm->createView(),
                'searched' => false,
                'entirePeriodSummary' => null,
                'daysSummary' => null,
            ];
        }

        $searchData = $searchForm->getData();

        // セッションに検索条件を保存（CSV出力用）
        $session = $request->getSession();
        $session->set(self::SESSION_KEY, FormUtil::getViewData($searchForm));

        // 期間全体集計（部門別）
        $entirePeriodSummary = $this->summaryRepository
            ->aggregateDataBySectionForEntirePeriod($searchData)
            ->getQuery()
            ->getResult();

        // 日別集計
        $daysSummary = $this->summaryRepository
            ->getQueryBuilderBySearchData($searchData)
            ->getQuery()
            ->getResult();

        return [
            'searchForm' => $searchForm->createView(),
            'searched' => true,
            'entirePeriodSummary' => $entirePeriodSummary ?: null,
            'daysSummary' => $daysSummary ?: null,
        ];
    }

    /**
     * 買取集計CSVの出力
     */
    #[Route(path: '/%eccube_admin_route%/otcbuyorder/summary/export', name: 'admin_otcbuyorder_summary_export', methods: ['POST'])]
    public function export(Request $request): StreamedResponse|RedirectResponse
    {
        set_time_limit(0);

        $session = $request->getSession();
        $viewData = $session->get(self::SESSION_KEY);

        if ($viewData === null) {
            $this->addError('検索条件がありません。先に検索を実行してください。', 'admin');

            return $this->redirectToRoute('admin_otcbuyorder_summary');
        }

        $searchForm = $this->createForm(OtcBuyOrderSummaryType::class);
        $searchData = FormUtil::submitAndGetData($searchForm, $viewData);

        return $this->summaryCsvExportService->exportBySearchData($searchData);
    }
}

