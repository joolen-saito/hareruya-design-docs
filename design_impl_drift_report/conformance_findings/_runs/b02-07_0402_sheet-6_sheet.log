    24	class DtbWeeklyStockHistoryRepository extends AbstractRepository
    25	{
    26	    public function __construct(ManagerRegistry $registry)
    27	    {
    28	        parent::__construct($registry, DtbWeeklyStockHistory::class);
    29	    }
    30	
    31	    /**
    32	     * 週間在庫履歴一時テーブルからデータをコピーする。
    33	     */
    34	    public function copyDataFromTemp(): void
    35	    {
    36	        $insertParams = ['product_stock_id'];
    37	        $selectParams = ['wsht.product_stock_id'];
    38	        for ($i = 1; $i <= DtbWeeklyStockHistory::HISTORY_COUNT; ++$i) {
    39	            $insertParams[] = sprintf('stock_%02d', $i);
    40	            $selectParams[] = sprintf('wsht.stock_%02d', $i);
    41	        }
    42	        $insertQuery = implode(',', $insertParams);
    43	        $selectQuery = implode(',', $selectParams);
    44	
    45	        $sql = <<<EOT
    46	            INSERT INTO
    47	                dtb_weekly_stock_history (
    48	                    {$insertQuery}
    49	                )
    50	            SELECT
    51	                {$selectQuery}
    52	            FROM
    53	                dtb_weekly_stock_history_temp wsht
    54	            EOT;
    55	
    56	        $em = $this->getEntityManager();
    57	        $em->getConnection()->executeStatement($sql);
    58	        $em->clear();
    59	    }
    60	
    61	    /**
    62	     * 本テーブルを TRUNCATE し、一時テーブルからデータをコピーする。
    63	     *
    64	     * TRUNCATE 後に COPY が失敗するとデータが空になるため、トランザクションでラップする。
    65	     * PostgreSQL では TRUNCATE がトランザクション内でロールバック可能。
    66	     */
    67	    public function replaceFromTemp(): void
    68	    {
    69	        $em = $this->getEntityManager();
    70	        $connection = $em->getConnection();
    71	        $connection->beginTransaction();
    72	        try {
    73	            $connection->executeStatement('TRUNCATE TABLE dtb_weekly_stock_history');
    74	            $this->copyDataFromTemp();
    75	            $connection->commit();
    76	        } catch (\Throwable $e) {
    77	            $connection->rollBack();
    78	            throw $e;
    79	        }
    80	        $em->clear();
    81	    }
    82	}

