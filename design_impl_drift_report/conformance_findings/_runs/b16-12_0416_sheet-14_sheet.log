   447	    /**
   448	     * ロックタイムアウトの値を設定する。
   449	     * 現在のセッションにしか影響を及ぼさない。
   450	     *
   451	     * @param EntityManagerInterface $em
   452	     * @param int $timeout タイムアウト（秒）
   453	     *
   454	     * @return void
   455	     */
   456	    public static function setLockTimeout(EntityManagerInterface $em, int $timeout): void
   457	    {
   458	        // 最小値: 1, 最大値: 50（MySQLのデフォルト設定値） とする。
   459	        $adjustedTimeout = min(
   460	            max($timeout, 1),
   461	            50
   462	        );
   463	
   464	        $platform = $em->getConnection()->getDatabasePlatform()->getName();
   465	
   466	        if ($platform === 'postgresql') {
   467	            // NOTE:
   468	            // PostgreSQL の SET コマンドはプレースホルダーをサポートしていないため、値を直接埋め込む
   469	            // $adjustedTimeout は既に整数に制限されているため、SQLインジェクションのリスクはない
   470	            $sql = 'SET lock_timeout = \''.$adjustedTimeout.'s\'';
   471	            $em->getConnection()->executeUpdate($sql);
   472	
   473	            return;
   474	        }
