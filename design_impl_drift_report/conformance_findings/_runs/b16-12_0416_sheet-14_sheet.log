   421	    public static function getLockTimeout(EntityManagerInterface $em): int
   422	    {
   423	        $rsm = new Query\ResultSetMapping();
   424	
   425	        $platform = $em->getConnection()->getDatabasePlatform()->getName();
   426	
   427	        if ($platform === 'postgresql') {
   428	            $sql = "SELECT setting FROM pg_settings WHERE name = 'lock_timeout'";
   429	            $rsm->addScalarResult('setting', 'value', Types::STRING);
   430	            $result = $em->createNativeQuery($sql, $rsm)
   431	                ->getSingleResult();
   432	
   433	            // PostgreSQL の lock_timeout は "30s" のような形式の為、数値部分を取得
   434	            return (int) preg_replace('/\D/', '', $result['value']) ?: 0;
   435	        }
   436	
   437	        $sql = 'SHOW VARIABLES LIKE \'innodb_lock_wait_timeout\'';
   438	
   439	        $rsm->addScalarResult('Value', 'value', Types::INTEGER);
   440	
   441	        $result = $em->createNativeQuery($sql, $rsm)
   442	            ->getSingleResult();
   443	
   444	        return (int) $result['value'];
   445	    }
