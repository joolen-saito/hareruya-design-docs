namespace Eccube\Form\Type\Admin;

use Eccube\Common\EccubeConfig;
use Symfony\Component\Form\AbstractType;
use Symfony\Component\Form\Extension\Core\Type\CheckboxType;
use Symfony\Component\Form\Extension\Core\Type\FileType;
use Symfony\Component\Form\Extension\Core\Type\IntegerType;
use Symfony\Component\Form\FormBuilderInterface;
use Symfony\Component\Validator\Constraints as Assert;

class CsvImportType extends AbstractType
{
    /**
     * @var int CSVの最大アップロードサイズ
     */
    private readonly int $csvMaxSize;

    /**
     * CsvImportType constructor.
     */
    public function __construct(EccubeConfig $eccubeConfig)
    {
        $this->csvMaxSize = $eccubeConfig['eccube_csv_size'];
    }

    /**
     * {@inheritdoc}
     *
     * @param array<string, mixed> $options
     */
    #[\Override]
    public function buildForm(FormBuilderInterface $builder, array $options): void
    {
        $builder
            ->add('import_file', FileType::class, [
                'label' => false,
                'mapped' => false,
                'required' => true,
                'constraints' => [
                    new Assert\NotBlank(),
                    new Assert\File([
                        'maxSize' => $this->csvMaxSize.'M',
                    ]),
                ],
            ])
            ->add('force_file_to_db', CheckboxType::class, [
                'label' => trans('admin.common.csv_checkbox_force_missing_file_pass_to_db'),
                'mapped' => false,
                'required' => false,
            ])
            ->add('is_split_csv', CheckboxType::class, [
                'label' => false,
                'mapped' => false,
                'required' => false,
            ])
            ->add('csv_file_no', IntegerType::class, [
                'label' => false,
                'mapped' => false,
                'required' => false,
            ]);
    }

    /**
     * {@inheritdoc}
     */
    #[\Override]
    public function getBlockPrefix(): string
    {
        return 'admin_csv_import';
    }
}
     * @return array{pageCount: int, pageNo: int, pageCountOptions: list<int>}
     */
    protected function getCsvImportHistoryPaginationParams(
        Request $request,
        string $sessionKeyPageCount,
        string $sessionKeyPageNo,
        int $defaultPageCount = 10,
    ): array {
        $session = $request->getSession();
        /** @var list<int> $pageCountOptions */
        $pageCountOptions = static::ADMIN_CSV_IMPORT_HISTORY_PAGE_COUNT_OPTIONS;
        $pageCountParam = $request->get('page_count');
        $pageCount = (int) ($pageCountParam ?? $session->get($sessionKeyPageCount, $defaultPageCount));
        if (!\in_array($pageCount, $pageCountOptions, true)) {
            $pageCount = $defaultPageCount;
        }
        if ($pageCountParam !== null && \in_array((int) $pageCountParam, $pageCountOptions, true)) {
            $pageCount = (int) $pageCountParam;
            $session->set($sessionKeyPageCount, $pageCount);
        }
        $pageNo = (int) ($request->get('page_no') ?? $session->get($sessionKeyPageNo, 1));
        $session->set($sessionKeyPageNo, $pageNo);

        return [
            'pageCount' => $pageCount,
            'pageNo' => $pageNo,
            'pageCountOptions' => $pageCountOptions,
        ];
    }

    /**
     * ヘッダー行のみのCSV雛形をダウンロードする StreamedResponse を生成する。
     *
     * @param array<string, string> $headersKeyed キーがCSV列名（getCsvHeader() 形式）
     */
    protected function csvTemplateStreamedResponse(
        CsvExportService $csvExportService,
        array $headersKeyed,
        string $downloadFilename,
    ): StreamedResponse {
        $response = new StreamedResponse();
        $response->setCallback(function () use ($csvExportService, $headersKeyed) {
            $csvExportService->fopen();
            $csvExportService->fputcsv(array_keys($headersKeyed));
            $csvExportService->fclose();
        });
        $response->headers->set('Content-Type', 'application/octet-stream');
        $response->headers->set('Content-Disposition', 'attachment; filename='.$downloadFilename);

        return $response;
    }

    protected function getCsvImportMaxRowsExceededMessage(): string
    {
        return $this->translator->trans(
            'admin.csv.error.upload.maxrecord',
            ['%maxRecord%' => static::ADMIN_CSV_IMPORT_MAX_ROWS]
        );
    }
}

