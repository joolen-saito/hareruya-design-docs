namespace Eccube\Controller\Admin\Product\Csv;

use Eccube\Controller\AbstractController;
use Eccube\Entity\Master\MtbCsvImportType;
use Eccube\Entity\Member;
use Eccube\Form\Type\Admin\CsvImportType;
use Eccube\Repository\DtbCsvImportHistoryRepository;
use Eccube\Repository\Master\ProductStatusRepository;
use Eccube\Repository\ProductRepository;
use Eccube\Service\Csv\Importer\CsvImporter;
use Eccube\Service\Csv\Importer\Event\ProductStatusUpdateImportHandler;
use Eccube\Service\CsvExportService;
use Knp\Component\Pager\PaginatorInterface;
use Symfony\Component\HttpFoundation\File\UploadedFile;
use Symfony\Component\HttpFoundation\RedirectResponse;
use Symfony\Component\HttpFoundation\Request;
use Symfony\Component\HttpFoundation\Response;
use Symfony\Component\HttpFoundation\StreamedResponse;
use Symfony\Component\Routing\Attribute\Route;

class ProductStatusCsvController extends AbstractController
{
    public function __construct(
        private readonly ProductRepository $productRepository,
        private readonly ProductStatusRepository $productStatusRepository,
        private readonly CsvExportService $csvExportService,
        private readonly PaginatorInterface $paginator,
        private readonly DtbCsvImportHistoryRepository $csvImportHistoryRepository,
    ) {
    }

    /**
     * 商品公開CSV雛形ファイルダウンロード
     *
     * @return StreamedResponse
     */
    #[Route(path: '/%eccube_admin_route%/product/status/csv_template', name: 'admin_product_status_csv_template', methods: ['GET'])]
    public function csvTemplate(): StreamedResponse
    {
        return $this->csvTemplateStreamedResponse(
            $this->csvExportService,
            $this->getCsvHeader(),
            'product_status_template.csv'
        );
    }

    /**
     * 商品公開CSVアップロード画面
     *
     * @param Request $request
     *
     * @return Response
     */
    #[Route(path: '/%eccube_admin_route%/product/status/csv_upload', name: 'admin_product_status_csv_upload', methods: ['GET'])]
    public function csv(Request $request): Response
    {
        $form = $this->createForm(CsvImportType::class);
        $form->handleRequest($request);

        $pagination = $this->getCsvImportHistoryPaginationParams(
            $request,
            'admin.product.status_csv.page_count',
            'admin.product.status_csv.page_no',
            50,
        );
        $pageCount = $pagination['pageCount'];
        $pageNo = $pagination['pageNo'];
        $pageCountOptions = $pagination['pageCountOptions'];

        $qb = $this->csvImportHistoryRepository->getQueryBuilderByCsvImportType(MtbCsvImportType::PRODUCT_STATUS_IMPORT_CSV_ID);
        $importHistoriesPagination = $this->paginator->paginate($qb, $pageNo, $pageCount);

        $headers = $this->getCsvHeader();

        return $this->render('@admin/Product/csv_product_status.twig', [
            'form' => $form->createView(),
            'headers' => $headers,
            'csv_required_header_keys' => array_keys($this->getRequiredCsvHeader()),
            'csv_box_title' => 'admin.product.product_status_csv_upload_title',
            'csv_format_title' => 'admin.product.product_status_csv_format_title',
            'form_action_route' => 'admin_product_status_import',
            'template_download_route' => 'admin_product_status_csv_template',
            'import_histories_pagination' => $importHistoriesPagination,
            'history_page_route' => 'admin_product_status_csv_upload',
            'page_no' => $pageNo,
            'page_count' => $pageCount,
            'pageMax' => $pageCountOptions,
        ]);
    }

    /**
     * 商品公開CSV取込
     *
     * @param Request $request
     *
     * @return RedirectResponse
     */
    #[Route(path: '/%eccube_admin_route%/product/status/import', name: 'admin_product_status_import', methods: ['POST'])]
    public function import(Request $request): RedirectResponse
    {
        /** @var Member $Member */
        $Member = $this->getUser();

        $form = $this->formFactory->createBuilder(CsvImportType::class)->getForm();
        $form->handleRequest($request);

        if (!$form->isValid()) {
            foreach ($form->getErrors() as $error) {
                $this->addError($error->getMessage(), 'admin');
            }

            return $this->redirectToRoute('admin_product_status_csv_upload');
        }
        /** @var UploadedFile|null $formFile */
        $formFile = $form['import_file']->getData();

        if ($formFile === null) {
            $this->addError('admin.common.csv_invalid_format', 'admin');

            return $this->redirectToRoute('admin_product_status_csv_upload');
        }

        if ($this->countCsvRows($formFile) >= static::ADMIN_CSV_IMPORT_MAX_ROWS) {
            $this->addError($this->getCsvImportMaxRowsExceededMessage(), 'admin');

            return $this->redirectToRoute('admin_product_status_csv_upload');
        }

        log_info('商品公開CSV登録開始');

        $handler = new ProductStatusUpdateImportHandler($this->productRepository, $this->productStatusRepository);
        $importer = new CsvImporter(
            $this->entityManager,
            $this->translator,
            $this->eccubeConfig,
            $handler,
            $Member
        );
        $result = $importer->import($formFile);

        if ($result->hasError()) {
            log_info('商品公開CSV登録 異常終了');
            foreach ($result->getErrors() as $error) {
                $this->addError($error['message'], 'admin');
            }
        } else {
            $this->addSuccess('admin.register.complete', 'admin');
            log_info('商品公開CSV登録完了', ['count' => $result->getCount()]);
            $this->csvImportHistoryRepository->insertCsvImportHistory(
                MtbCsvImportType::PRODUCT_STATUS_IMPORT_CSV_ID,
                $formFile->getClientOriginalName(),
                $Member->getId()
            );
        }

        return $this->redirectToRoute('admin_product_status_csv_upload');
    }

    /**
     * 商品公開CSVヘッダー定義
     *
     * @return array<string, string>
     */
    private function getCsvHeader(): array
    {
        return [
            '商品ID' => '',
            '商品公開ステータス' => '2:非公開 1:公開',
            '支店の商品公開ステータス' => '0:非公開 1:公開',
        ];
    }

    /**
     * 商品公開CSV必須ヘッダー定義
     *
     * @return array<string, string>
     */
    private function getRequiredCsvHeader(): array
    {
        return [
            '商品ID' => '商品ID',
            '商品公開ステータス' => '商品公開ステータス',
            '支店の商品公開ステータス' => '支店の商品公開ステータス',
        ];
    }
}

