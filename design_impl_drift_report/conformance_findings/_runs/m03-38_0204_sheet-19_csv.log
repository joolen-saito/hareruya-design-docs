  4733	          <h2 id="function-design-m03-38-m03-38_admin_product_product_status_csv-フロント挙動">フロント挙動</h2>
  4734	          <div class="table-wrap"><table><thead>
  4735	<tr><th>観点</th><th>内容</th></tr>
  4736	</thead><tbody>
