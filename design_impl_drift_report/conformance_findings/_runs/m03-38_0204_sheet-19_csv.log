{% extends '@admin/Product/base_csv_upload.twig' %}

{% set menus = ['product', 'product_csv_management', 'admin_product_status_import'] %}

{% block sub_title %}{{ 'admin.product.product_status_csv'|trans }}{% endblock %}
{% extends '@admin/default_frame.twig' %}

{% block title %}{{ 'admin.product.product_management'|trans }}{% endblock %}
{% block sub_title %}{% endblock %}

{% form_theme form '@admin/Form/bootstrap_4_horizontal_layout.html.twig' %}

{% block stylesheet %}
    <style>
        .custom-file-input:lang(ja) ~ .custom-file-label::after {
            content: "{{ 'admin.common.browse'|trans }}";
        }
        .custom-file-label::after {
            background-color: #b6b6b6;
            color: #fff;
        }
    </style>
{% endblock %}

{% block import_file_accept %}.csv, text/csv, .tsv, text/tsv{% endblock %}

{% block javascript %}
<script nonce="{{ csp_nonce|default('') }}">
    $(function() {
        $('.custom-file-input').on('change', function() {
            const fileName = $(this).val().split('\\').pop();
            $(this).next('.custom-file-label').addClass("selected").html(fileName);
        });
        $('#upload-form').on('submit', function() {
            $.changeLoading(true);
        });
    });
</script>
{% endblock javascript %}

{% block main %}
    <div class="c-contentsArea__cols">
        <div class="c-contentsArea__primaryCol">
            <div class="c-primaryCol">
                {% if import_errors is defined and import_errors|length > 0 %}
                    <div class="alert alert-danger mb-4">
                        <div class="font-weight-bold mb-2">
                            <i class="fa fa-exclamation-triangle mr-2"></i>{{ 'admin.common.csv_import_error'|trans }}
                        </div>
                        <ul class="mb-0 pl-3">
                            {% for error in import_errors %}
                                <li>{{ error }}</li>
                            {% endfor %}
                        </ul>
                    </div>
                {% endif %}

                <form id="upload-form" method="post" action="{{ url(form_action_route) }}" enctype="multipart/form-data">
                    {{ form_widget(form._token) }}

                    <div class="card rounded border shadow-sm mb-4">
                        <div class="card-header">
                            <h4 class="card-title mb-0">{{ csv_box_title|trans }}</h4>
                        </div>
                        <div class="card-body">
                            <div class="row justify-content-center">
                                <div class="col-md-8">
                                    <div class="form-group">
                                        <div class="custom-file">
                                            {{ form_widget(form.import_file, {'attr': {'class': 'custom-file-input', 'accept': block('import_file_accept')}}) }}
                                        </div>
                                        {{ form_errors(form.import_file) }}
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="card-footer text-center">
                            <button id="upload-button" type="submit" class="btn btn-ec-conversion px-5">
                                {{ 'admin.common.csv_upload'|trans }}
                            </button>
                        </div>
                    </div>
                </form>

                <div class="card rounded border shadow-sm mb-4">
                    <div class="card-header d-flex align-items-center justify-content-between">
                        <h4 class="card-title mb-0">{{ csv_format_title|trans }}</h4>
                        <a href="{{ url(template_download_route, template_download_route_params|default({})) }}" class="btn btn-secondary" id="download-template-button">{{ 'admin.common.csv_skeleton_download'|trans }}</a>
                    </div>
                    <div class="card-body p-0">
                        <div class="table-responsive">
                            <table class="table table-striped table-bordered mb-0">
                                <thead class="thead-light">
                                    <tr>
                                        <th class="w-50">{{ 'admin.common.csv_item_name'|trans }}</th>
                                        <th>{{ 'admin.common.csv_description'|trans }}</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    {% for key, value in headers %}
                                        <tr>
                                            <td class="text-nowrap">
                                                {{ key }}
                                                {% if csv_required_header_keys is defined %}
                                                    {% if key in csv_required_header_keys %}
                                                        <span class="badge bg-primary ms-1">{{ 'admin.common.required'|trans }}</span>
                                                    {% endif %}
                                                {% endif %}
                                            </td>
                                            <td>{{ value|nl2br }}</td>
                                        </tr>
                                    {% endfor %}
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
                {% include '@admin/Product/csv_import_history.twig' %}
            </div>
        </div>
    </div>
{% endblock %}
{% if import_histories_pagination is defined and import_histories_pagination is not null %}
<div class="card rounded border shadow-sm mb-4">
    <div class="card-header">
        <div class="row justify-content-between align-items-center">
            <div class="col">
                <h4 class="card-title mb-0">{{ 'admin.product.csv_import_history_title'|trans }}</h4>
            </div>
            {% if pageMax is defined and pageMax|length > 0 and history_page_route is defined %}
            <div class="col-auto">
                <select id="page_count_pulldown" class="form-select">
                    {% for count in pageMax %}
                        <option {% if count == page_count %}selected=""{% endif %} value="{{ path(history_page_route, {'page_no': 1, 'page_count': count}) }}">{{ 'admin.common.count'|trans({ '%count%': count }) }}</option>
                    {% endfor %}
                </select>
            </div>
            {% endif %}
        </div>
    </div>
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-striped table-bordered mb-0">
                <thead class="thead-light">
                    <tr>
                        <th class="text-nowrap">{{ 'admin.product.csv_import_history_filename'|trans }}</th>
                        <th class="text-nowrap">{{ 'admin.product.csv_import_history_upload_date'|trans }}</th>
                        <th class="text-nowrap">{{ 'admin.product.csv_import_history_operator'|trans }}</th>
                    </tr>
                </thead>
                <tbody>
                    {% for importHistory in import_histories_pagination %}
                        <tr>
                            <td>{{ importHistory.fileName }}</td>
                            <td>{{ importHistory.createDate|date('Y-m-d H:i') }}</td>
                            <td>{{ importHistory.member is not null ? importHistory.member.name : '' }}</td>
                        </tr>
                    {% else %}
                        <tr>
                            <td colspan="3" class="text-center text-muted py-4">{{ 'admin.common.search_no_result'|trans }}</td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
        {% if import_histories_pagination.paginationData.pageCount > 1 and history_page_route is defined %}
        <div class="row justify-content-md-center mb-4 mt-2">
            {% include '@admin/pager.twig' with { 'pages': import_histories_pagination.paginationData, 'routes': history_page_route } %}
        </div>
        {% endif %}
    </div>
</div>
<script nonce="{{ csp_nonce|default('') }}">
    $(function() {
        $('#page_count_pulldown').on('change', function() {
            const targetUrl = $(this).val();
            if (targetUrl) {
                window.location.href = targetUrl;
            }
        });
    });
</script>
{% endif %}

