   678	    /**
   679	     * @param array<int, string> $paths
   680	     */
   681	    private function applyPermissions(array $paths): void
   682	    {
   683	        foreach ($paths as $path) {
   684	            if ($path === '' || !file_exists($path)) {
   685	                continue;
   686	            }
   687	            @chmod($path, 0777);
   688	        }
   689	    }
   690	
   691	    private function deleteOldBackupFilesByPattern(string $pattern, int $keep): void
   692	    {
   693	        $files = glob($pattern);
   694	        if (!is_array($files) || count($files) <= $keep) {
   695	            return;
   696	        }
   697	
   698	        usort($files, static function (string $a, string $b): int {
   699	            return filemtime($b) <=> filemtime($a);
   700	        });
   701	
   702	        $toDelete = array_slice($files, $keep);
   703	        if ($toDelete !== []) {
   704	            $this->filesystem->remove($toDelete);
   705	            log_info('既存のバックアップファイルを削除しました。', [
   706	                'pattern' => $pattern,
   707	                'count' => count($toDelete),
   708	            ]);
   709	        }
   710	    }
   711	
   712	    /**
   713	     * @return resource|null
   714	     */
   715	    private function acquireLock()
   716	    {
   717	        $handle = fopen($this->lockFile, 'c');
   718	        if ($handle === false) {
   719	            log_error('Unisearch ロックファイルを作成できませんでした。', ['path' => $this->lockFile]);
   720	
   721	            return null;
   722	        }
   723	
   724	        if (!flock($handle, LOCK_EX | LOCK_NB)) {
   725	            fclose($handle);
   726	
   727	            return null;
   728	        }
   729	
   730	        ftruncate($handle, 0);
   731	        fwrite($handle, (string) getmypid());
   732	        fflush($handle);
   733	
   734	        return $handle;
   735	    }

