    16	namespace Eccube\Service\UniSearch;
    17	
    18	use Eccube\Repository\CategoryRepository;
    19	use Eccube\Repository\ProductClassRepository;
    20	use Symfony\Component\DependencyInjection\ParameterBag\ParameterBagInterface;
    21	use Symfony\Component\Filesystem\Filesystem;
    22	use Symfony\Component\HttpKernel\KernelInterface;
    23	use Symfony\Component\Process\Process;
    24	
    25	/**
    26	 * ユニサーチ商品フィード連携バッチ用のサービス
    27	 */
    28	class UniSearchExportService
    29	{
    30	    private const COMPRESS_GZIP = 'gzip';
    31	    private const BACKUP_KEEP_COUNT = 5;
    32	    private string $workDir;
    33	    private string $lockFile;
    34	    private string $projectDir;
    35	    private string $cdnBaseUrl;
    36	    private string $s3Endpoint;
    37	    private string $awsS3Bucket;
    38	    /**
    39	     * @var array<string, array{hierarchicalCategoryIds: array<int, int>, hierarchicalCategoryName: string, hierarchicalCategoryNameEn: string}>|null
    40	     */
    41	    private ?array $hierarchicalCategories = null;
    42	    private int $workerCount;
    43	
    44	    public function __construct(
    45	        private readonly ProductClassRepository $productClassRepository,
    46	        private readonly CategoryRepository $categoryRepository,
    47	        private readonly UniSearchSftpService $sftpService,
    48	        private readonly Filesystem $filesystem,
    49	        ParameterBagInterface $params,
    50	        KernelInterface $kernel,
    51	    ) {
    52	        $this->projectDir = $kernel->getProjectDir();
    53	        $this->workDir = $this->projectDir.'/var/unisearch/';
    54	        $this->filesystem->mkdir([$this->workDir]);
    55	        $this->lockFile = $this->workDir.'unisearch.lock';
    56	        $this->cdnBaseUrl = (string) $params->get('cdn_base_url');
    57	        $this->s3Endpoint = (string) $params->get('s3_endpoint');
    58	        $this->awsS3Bucket = (string) $params->get('aws_s3_bucket');
    59	        $this->workerCount = max(1, (int) $params->get('eccube_unisearch_export_workers'));
    60	    }
    61	
    62	    public function exportAndUpload(bool $isManualExecution = false): int
    63	    {
    64	        $executionTime = new \DateTimeImmutable('now');
    65	        $lockHandle = $this->acquireLock();
    66	        if ($lockHandle === null) {
    67	            log_warning('Unisearch 商品フィードTSV出力処理は既に実行中のためスキップしました。');
    68	
    69	            return 0;
    70	        }
    71	        $this->deleteExistingOutputFiles();
    72	        $baseFileName = 'feed_hareruyamtgecc_'.$executionTime->format('YmdHis');
    73	        $baseDoneFileName = 'done_hareruyamtgecc_'.$executionTime->format('YmdHis');
    74	
    75	        $tsvPath = $this->workDir.$baseFileName.'.tsv';
    76	        $donePath = $this->workDir.$baseDoneFileName.'.txt';
    77	
    78	        try {
    79	            $this->deleteOldBackupFiles();
    80	
    81	            $total = $this->exportTsvBySql($tsvPath);
    82	            if ($total === 0) {
    83	                $this->filesystem->dumpFile($tsvPath, '');
    84	                log_info('出力対象が0件のため空ファイルを作成しました。', ['path' => $tsvPath]);
    85	            }
    86	
    87	            $gzipPath = $this->compressFile($tsvPath, self::COMPRESS_GZIP);
    88	
    89	            $md5 = md5_file($gzipPath);
    90	            $this->filesystem->dumpFile($donePath, $md5);
    91	            log_info('.doneファイルを生成しました。', ['path' => $donePath, 'md5' => $md5]);
    92	
    93	            log_info('バックアップファイルを作成しました。', ['path' => $gzipPath]);
    94	            $this->applyPermissions([$tsvPath, $gzipPath, $donePath]);
    95	
    96	            if (!$isManualExecution) {
    97	                if (!$this->sftpService->deleteRemoteByPrefixes(['feed_hareruyamtg_', 'done_hareruyamtg_'])) {
    98	                    throw new \RuntimeException('SFTP既存ファイルの削除に失敗しました。');
    99	                }
   100	                if (!$this->sftpService->upload($gzipPath)) {
   101	                    throw new \RuntimeException('SFTPアップロードに失敗しました。');
   102	                }
   103	                if (!$this->sftpService->upload($donePath)) {
   104	                    throw new \RuntimeException('SFTPアップロードに失敗しました。');
   105	                }
   106	                log_info('生成したファイルをSFTPにアップロードしました。');
   107	            } else {
   108	                log_info('手動実行モードのため、SFTPアップロードをスキップしました。');
   109	            }
   110	        } catch (\Throwable $e) {
   111	            log_error('ユニサーチ商品フィード連携処理でエラーが発生しました。', [
   112	                'error' => $e->getMessage(),
   113	                'trace' => $e->getTraceAsString(),
   114	            ]);
   115	            throw $e;
   116	        } finally {
   117	            $this->releaseLock($lockHandle);
   118	        }
   119	
   120	        return $total;
   121	    }
