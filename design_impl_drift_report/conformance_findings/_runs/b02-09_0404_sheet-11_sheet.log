   660	    private function deleteExistingOutputFiles(): void
   661	    {
   662	        $patterns = [
   663	            $this->workDir.'feed_hareruyamtgecc_*.tsv',
   664	            $this->workDir.'feed_hareruyamtgecc_*.tsv.gz',
   665	            $this->workDir.'done_hareruyamtgecc_*.txt',
