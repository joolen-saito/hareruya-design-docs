   400	     *
   401	     * 買取商品一覧の集計単位仕様:
   402	     * 旧仕様のネット買取商品一覧に沿っている
   403	     * 集計対象データ: OtcBuyOrderにて買取状況が「キャンセル済み」でないもの
   404	     *
   405	     * 集計方法: 以下の3つのデータソースをUNIONで結合し、それぞれ異なる単位で集計（SUM）
   406	     * * 1. OtcBuyOrderDetail
   407	     * [集計単位] 商品規格ID (product_class_id) ＋ 買取単価 (price)
   408	     * [説明] 同じ商品・同じコンディションでも、「買取価格」が1円でも異なれば別行として出力される。
   409	     * 逆に、規格と価格が完全に一致していれば、複数の注文に跨っていても数量が合算される。
   410	     * * 2. BuyOrderIndividualInput
   411	     * [集計単位] 1レコード単位（集計なし）
   412	     * [説明] dtb_buy_order_indivisual_input_product テーブルの各行をそのまま出力。
   413	     * 商品名や価格が同じであっても、登録されたレコードごとに1行ずつ出力される。
   414	     * * 3. 状態未指定の商品（コンディションIDが空のデータ）
   415	     * [集計単位] 商品ID (product_id)
   416	     * [説明] 規格（言語や状態）の区別がないため、商品単位で数量が合算される。
   417	     * ※この際、価格(price)はGROUP BYに含まれていないため、SQLの挙動により最初に見つかった価格が表示される。
   418	     * * [ソート順]
   419	     * 1. 通常買取商品 -> 通常買取商品(商品コード未設定) -> 個別入力商品 (indivisual_input_product_sort ASC)
   420	     * 2. 商品ID順
   421	     * 3. コンディションID順
   422	     **/
   423	    public function getOtcBuyOrderProductListCsvExportData(
   424	        array $otcBuyOrderIds,
   425	    ): iterable {
   426	        if (empty($otcBuyOrderIds)) {
   427	            return new \ArrayIterator([]);
   428	        }
   429	        // SQLが複雑でDoctrineでうまく対応できない & 数万件のデータ出力も想定されるため、SQLでクエリ
   430	        // Connectionの取得
   431	        $conn = $this->getEntityManager()->getConnection();
   432	        $conn->executeStatement("SET TIME ZONE 'Asia/Tokyo'");
   433	
   434	        $sql = <<<SQL
   435	            (
   436	                -- 1. 通常商品（状態/Conditionあり）
   437	                SELECT
   438	                    pc.product_code AS "productCode",
   439	                    SUM(od.original_quantity) AS "productCount",
   440	                    p.name AS "productName",
   441	                    pc.standard_price AS "standardPrice",
   442	                    od.price AS "buyPrice",
   443	                    pc.language_id AS "languageId",
   444	                    sc.name AS "storageCode",
   445	                    r.code AS "rarityCode",
   446	                    cc.code AS "conditionCode",
   447	                    (CASE WHEN pc.product_code IS NULL THEN 1 ELSE 0 END) AS "productCodeNullSort",
   448	                    pc.card_condition_id AS "cardConditionId",
   449	                    p.id AS "productId",
   450	                    '0' AS "individualInputProductSort"
   451	                FROM
   452	                    dtb_otc_buy_order o
   453	                JOIN
   454	                    dtb_otc_buy_order_detail od ON od.otc_buy_order_id = o.id
   455	                JOIN
   456	                    dtb_product_class pc ON pc.id = od.product_class_id
   457	                    AND pc.product_status_id IN (:product_status_ids) -- 移植元のネット買取の結合仕様に合わせている
   458	                    AND pc.high_price_code IS NULL -- 移植元のネット買取の結合仕様に合わせている
   459	                JOIN
   460	                    dtb_product p ON p.id = pc.product_id
   461	                JOIN
   462	                    mtb_card_condition cc ON cc.id = pc.card_condition_id -- 状態があるもののみ
   463	                LEFT JOIN
   464	                    mtb_storage_code sc ON sc.id = p.storage_code_id
   465	                LEFT JOIN
   466	                    mtb_card_detail cd ON cd.id = p.card_detail_id
   467	                LEFT JOIN
   468	                    mtb_rarity r ON r.id = cd.rarity_id
   469	                WHERE
   470	                    o.id IN (:ids)
   471	                    AND o.otc_buy_order_status_id <> :cancel_status_id
   472	                GROUP BY
   473	                    pc.id, od.price, pc.product_code, p.name, pc.standard_price, pc.language_id,
   474	                    sc.name, r.code, cc.code, pc.card_condition_id, p.id
   475	            )
   476	            UNION ALL
   477	            (
   478	                -- 2. 個別入力商品
   479	                SELECT
   480	                    '' AS "productCode",
   481	                    iip.quantity AS "productCount",
   482	                    iip.name AS "productName",
   483	                    NULL AS "standardPrice",
   484	                    iip.price AS "buyPrice",
   485	                    1 AS "languageId",
   486	                    '' AS "storageCode",
   487	                    '' AS "rarityCode",
   488	                    '' AS "conditionCode",
   489	                    2 AS "productCodeNullSort",
   490	                    NULL AS "cardConditionId",
   491	                    NULL AS "productId",
   492	                    '1' AS "individualInputProductSort"
   493	                FROM
   494	                    dtb_otc_buy_order_indivisual_input_product iip
   495	                JOIN
   496	                    dtb_otc_buy_order o ON o.id = iip.otc_buy_order_id -- ステータス確認のため結合
   497	                WHERE
   498	                    o.otc_buy_order_status_id <> :cancel_status_id
   499	                    AND iip.otc_buy_order_id IN (:ids)
   500	            )
   501	            UNION ALL
   502	            (
   503	                -- 3. 通常商品（状態/Conditionなし）
   504	                SELECT
   505	                    '' AS "productCode",
   506	                    SUM(od.original_quantity) AS "productCount",
   507	                    p.name AS "productName",
   508	                    pc.standard_price AS "standardPrice",
   509	                    od.price AS "buyPrice",
   510	                    pc.language_id AS "languageId",
   511	                    sc.name AS "storageCode",
   512	                    r.code AS "rarityCode",
   513	                    '' AS "conditionCode",
   514	                    1 AS "productCodeNullSort",
   515	                    NULL AS "cardConditionId",
   516	                    p.id AS "productId",
   517	                    '0' AS "individualInputProductSort"
   518	                FROM
   519	                    dtb_otc_buy_order o
   520	                JOIN
   521	                    dtb_otc_buy_order_detail od ON od.otc_buy_order_id = o.id
   522	                JOIN
   523	                    dtb_product_class pc ON pc.id = od.product_class_id
   524	                JOIN
   525	                    dtb_product p ON p.id = pc.product_id
   526	                LEFT JOIN
   527	                    mtb_storage_code sc ON sc.id = p.storage_code_id
   528	                LEFT JOIN
   529	                    mtb_card_detail cd ON cd.id = p.card_detail_id
   530	                LEFT JOIN
   531	                    mtb_rarity r ON r.id = cd.rarity_id
   532	                WHERE
   533	                    o.id IN (:ids)
   534	                    AND o.otc_buy_order_status_id <> :cancel_status_id
   535	                    AND (pc.card_condition_id IS NULL OR pc.card_condition_id = 0)
   536	                GROUP BY
   537	                    pc.id, od.price, pc.product_code, p.name, pc.standard_price, pc.language_id,
   538	                    sc.name, r.code, p.id
   539	            )
   540	            ORDER BY
   541	                "individualInputProductSort" ASC,
   542	                "productId" ASC,
   543	                "productCodeNullSort" ASC,
   544	                "cardConditionId" ASC
   545	        SQL;
   546	
   547	        return $conn->iterateAssociative(
   548	            $sql,
   549	            [
   550	                'ids' => $otcBuyOrderIds,
   551	                'cancel_status_id' => self::CANCEL_STATUS_ID,
   552	                'product_status_ids' => [ProductStatus::DISPLAY_SHOW, ProductStatus::DISPLAY_HIDE],
   553	            ],
   554	            [
   555	                'ids' => ArrayParameterType::INTEGER,

