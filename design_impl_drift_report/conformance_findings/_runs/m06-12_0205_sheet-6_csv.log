    79	     */
    80	    public function exportByIds(
    81	        string $exportType,
    82	        array $otcBuyOrderIds,
    83	    ): StreamedResponse {
    84	        // exportTypeの存在確認。controllerでも確認しているが念の為。
    85	        if (!isset(self::CSV_TYPES[$exportType])) {
    86	            throw new \InvalidArgumentException('Invalid export type: '.$exportType);
    87	        }
    88	
    89	        $header = self::CSV_TYPES[$exportType]['header'];
    90	
    91	        $response = new StreamedResponse();
    92	        $response->setCallback(function () use (
    93	            $header,
    94	            $exportType,
    95	            $otcBuyOrderIds,
    96	        ): void {
    97	            $this->csvExportService->fopen();
    98	
    99	            // ヘッダー出力
   100	            $this->csvExportService->fputcsv(array_values($header));
   101	
   102	            // データ取得（選択されたIDでフィルタリング）
   103	            $data = $this->getDataByExportType($exportType, $otcBuyOrderIds);
   104	
   105	            foreach ($data as $row) {
   106	                // ヘッダー順に並べ替え
   107	                $orderedRow = array_map(
   108	                    fn ($key) => $row[$key] ?? '',
   109	                    array_keys($header),
   110	                );
   111	                $this->csvExportService->fputcsv($orderedRow);
   112	            }
   113	
   114	            $this->csvExportService->fclose();
   115	
   116	            // CSV出力完了後に棚戻し済みフラグを更新する。
   117	            // コールバック内で更新することで、出力が途中で失敗した場合にフラグが立たないようにする。
   118	            if ($exportType === 'otc_buy_order_restock_list_csv') {
   119	                $this->otcBuyOrderRestockListService->markOtcBuyOrdersAsRestocked($otcBuyOrderIds);
   120	            }
   121	        });
   122	        $now = new \DateTime();
   123	        $filename = $exportType.'_'.$now->format('YmdHis').'.csv';
   124	        $response->headers->set('Content-Type', 'application/octet-stream');
   125	        $response->headers->set(
   126	            'Content-Disposition',
   127	            'attachment; filename='.$filename,
   128	        );
   129	
   130	        log_info('店頭買取CSV出力完了. ファイル名: '.$filename);
   131	
   132	        return $response;
   133	    }
