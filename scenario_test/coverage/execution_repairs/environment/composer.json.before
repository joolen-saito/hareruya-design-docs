{
    "name": "ec-cube/ec-cube",
    "description": "EC-CUBE EC open platform.",
    "type": "project",
    "homepage": "https://www.ec-cube.net/",
    "license": [
        "GPL-2.0-only",
        "proprietary"
    ],
    "support": {
        "issues": "https://github.com/EC-CUBE/ec-cube/issues"
    },
    "minimum-stability": "RC",
    "prefer-stable": true,
    "require": {
        "php": "^8.2",
        "ext-curl": "*",
        "ext-gd": "*",
        "ext-intl": "*",
        "ext-json": "*",
        "ext-mbstring": "*",
        "ext-openssl": "*",
        "ext-redis": "*",
        "ext-zip": "*",
        "aws/aws-sdk-php-symfony": "^2.7",
        "azuyalabs/yasumi": "^2.7",
        "composer/ca-bundle": "^1.1",
        "composer/composer": "^2.0",
        "doctrine/cache": "^2.0",
        "doctrine/collections": "^2.1",
        "doctrine/common": "^3.0",
        "doctrine/data-fixtures": "^1.3",
        "doctrine/dbal": "^3.8",
        "doctrine/doctrine-bundle": "^2",
        "doctrine/doctrine-fixtures-bundle": "^3.0",
        "doctrine/doctrine-migrations-bundle": "^3.1",
        "doctrine/inflector": "^2.0",
        "doctrine/instantiator": "^2.0",
        "doctrine/lexer": "^3.0",
        "doctrine/orm": "^3.0",
        "doctrine/persistence": "^3",
        "ec-cube/plugin-installer": "^2.0",
        "ec-cube/slnpayment42": "^1.2",
        "egulias/email-validator": "^4.0",
        "endroid/qr-code": "^6.0",
        "exercise/htmlpurifier-bundle": "^5.0",
        "friendsofphp/php-cs-fixer": "^3.75",
        "gedmo/doctrine-extensions": "^3.11",
        "guzzlehttp/guzzle": "^7.4.5",
        "knplabs/knp-paginator-bundle": "^6.8",
        "mobiledetect/mobiledetectlib": "^2.8",
        "monolog/monolog": "^3.0",
        "nanasess/bcmath-polyfill": "^1.0",
        "nesbot/carbon": "^3",
        "phpdocumentor/reflection-docblock": "^5.6",
        "phpnexus/cwh": "^3.0",
        "psr/cache": "^3.0",
        "psr/container": "^2.0",
        "psr/http-message": "^2.0",
        "psr/log": "^3",
        "psr/simple-cache": "^1.0",
        "robthree/twofactorauth": "^1.8",
        "setasign/fpdi": "^2.2",
        "skorp/detect-incompatible-samesite-useragents": "^1.0",
        "softcreatr/jsonpath": "^0.8",
        "symfony/asset": "^7.4",
        "symfony/cache": "^7.4",
        "symfony/config": "^7.4",
        "symfony/console": "^7.4",
        "symfony/css-selector": "^7.4",
        "symfony/debug-bundle": "^7.4",
        "symfony/dependency-injection": "^7.4",
        "symfony/doctrine-bridge": "^7.4",
        "symfony/doctrine-messenger": "^7.4",
        "symfony/dom-crawler": "^7.4",
        "symfony/dotenv": "^7.4",
        "symfony/event-dispatcher": "^7.4",
        "symfony/expression-language": "^7.4",
        "symfony/filesystem": "^7.4",
        "symfony/finder": "^7.4",
        "symfony/flex": "^2.7",
        "symfony/form": "^7.4",
        "symfony/framework-bundle": "^7.4",
        "symfony/http-foundation": "^7.4",
        "symfony/http-kernel": "^7.4",
        "symfony/intl": "^7.4",
        "symfony/lock": "^7.4",
        "symfony/mailer": "^7.4",
        "symfony/maker-bundle": "^1.0",
        "symfony/messenger": "7.4.*",
        "symfony/monolog-bridge": "^7.4",
        "symfony/monolog-bundle": "^3.1",
        "symfony/options-resolver": "^7.4",
        "symfony/password-hasher": "^7.4",
        "symfony/process": "^7.4",
        "symfony/property-access": "^7.4",
        "symfony/rate-limiter": "^7.4",
        "symfony/redis-messenger": "^7.4",
        "symfony/routing": "^7.4",
        "symfony/security-bundle": "^7.4",
        "symfony/serializer": "^7.4",
        "symfony/stopwatch": "^7.4",
        "symfony/translation": "^7.4",
        "symfony/twig-bridge": "^7.4",
        "symfony/twig-bundle": "^7.4",
        "symfony/validator": "^7.4",
        "symfony/var-dumper": "^7.4",
        "symfony/web-profiler-bundle": "^7.4",
        "symfony/workflow": "^7.4",
        "symfony/yaml": "^7.4",
        "tattali/mobile-detect-bundle": "^2.3",
        "tecnickcom/tcpdf": "^6.2",
        "twig/extra-bundle": "^3.21",
        "twig/intl-extra": "^3.21",
        "twig/twig": "^3.21",
        "vlucas/phpdotenv": "^5.6",
        "web-token/jwt-library": "^4.0"
    },
    "require-dev": {
        "brianium/paratest": "^7.0",
        "captbaritone/mailcatcher-codeception-module": "^3.0",
        "codeception/codeception": "^5.0",
        "codeception/lib-innerbrowser": "^4.0",
        "codeception/module-asserts": "^3.0",
        "codeception/module-phpbrowser": "^3.0",
        "codeception/module-rest": "^3.3",
        "codeception/module-webdriver": "^4.0",
        "dama/doctrine-test-bundle": "^8.0",
        "fakerphp/faker": "^1.16",
        "mikey179/vfsstream": "^1.6",
        "phpstan/extension-installer": "*",
        "phpstan/phpstan": "^2.1",
        "phpstan/phpstan-doctrine": "*",
        "phpunit/phpcov": "^10.0",
        "phpunit/phpunit": "^11.0",
        "rector/rector": "^2.2",
        "symfony/browser-kit": "^7.4",
        "symfony/phpunit-bridge": "^7.4"
    },
    "autoload": {
        "files": [
            "src/Eccube/Resource/functions/log.php",
            "src/Eccube/Resource/functions/env.php",
            "src/Eccube/Resource/functions/trans.php"
        ],
        "psr-4": {
            "Eccube\\Entity\\": "app/proxy/entity",
            "Customize\\": "app/Customize",
            "Eccube\\": "src/Eccube",
            "Plugin\\": "app/Plugin"
        },
        "exclude-from-classmap": [
            "tests/"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Eccube\\Tests\\": "tests/Eccube/Tests"
        }
    },
    "scripts": {
        "compile": {
            "doctrine:schema:create": "bin/console doctrine:schema:create --em=write_only",
            "eccube:fixtures:load": "bin/console eccube:fixtures:load --em=write_only"
        },
        "auto-scripts-custom": {
            "cache:clear --no-warmup": "bin/console cache:clear --no-warmup",
            "cache:warmup --no-optional-warmers": "bin/console cache:warmup --no-optional-warmers",
            "assets:install --symlink --relative html": "bin/console assets:install --symlink --relative html"
        },
        "auto-scripts": {
            "cache:clear --no-warmup": "symfony-cmd",
            "cache:warmup --no-optional-warmers": "symfony-cmd",
            "assets:install --symlink --relative html": "symfony-cmd"
        },
        "installer-scripts": {
            "doctrine:database:create": "bin/console doctrine:database:create --if-not-exists --connection primary",
            "doctrine:schema:create": "bin/console doctrine:schema:create",
            "eccube:fixtures:load": "bin/console eccube:fixtures:load"
        },
        "post-install-cmd": [
            "@auto-scripts-custom"
        ],
        "post-update-cmd": [
            "@auto-scripts-custom"
        ],
        "post-create-project-cmd": [
            "@installer-scripts",
            "@auto-scripts"
        ],
        "test-group-HARERUYA": [
            "echo [1/5] Clearing Symfony test cache...",
            "rm -rf var/cache/test || true",
            "echo [2/5] Terminating active connections to test database...",
            "DATABASE_URL=postgres://dbuser:secret@postgres_primary/postgres bin/console doctrine:query:sql \"SELECT pg_terminate_backend(pid) FROM pg_stat_activity WHERE datname = 'eccubedb_test' AND pid <> pg_backend_pid()\" -q || true",
            "echo [3/5] Dropping test database...",
            "DATABASE_URL=postgres://dbuser:secret@postgres_primary/postgres bin/console doctrine:query:sql \"DROP DATABASE IF EXISTS eccubedb_test\" -q || true",
            "echo [4/5] Creating test database...",
            "DATABASE_URL=postgres://dbuser:secret@postgres_primary/postgres bin/console doctrine:query:sql \"CREATE DATABASE eccubedb_test\" -q || true",
            "echo [5/5] Creating and Updating schema...",
            "DATABASE_URL=postgres://dbuser:secret@postgres_primary/eccubedb_test && bin/console doctrine:schema:create --env=test -q",
            "DATABASE_URL=postgres://dbuser:secret@postgres_primary/eccubedb_test && bin/console eccube:fixtures:load --env=test -q",
            "DATABASE_URL=postgres://dbuser:secret@postgres_primary/eccubedb_test && bin/console doctrine:migrations:migrate --no-interaction --env=test -q",
            "DATABASE_URL=postgres://dbuser:secret@postgres_primary/eccubedb_test && bin/console doctrine:schema:update --force --env=test -q",
            "DATABASE_URL=postgres://dbuser:secret@postgres_primary/eccubedb_test && vendor/bin/phpunit --group HARERUYA"
        ],
        "paratest-group-HARERUYA": [
            "echo [1/6] Clearing Symfony test cache...",
            "rm -rf var/cache/test || true",
            "echo [2/6] Terminating active test DB connections...",
            "DATABASE_URL=postgres://dbuser:secret@postgres_primary/postgres bin/console doctrine:query:sql \"SELECT pg_terminate_backend(pid) FROM pg_stat_activity WHERE datname LIKE 'eccubedb_test%' AND pid <> pg_backend_pid()\" -q || true",
            "echo [3/6] Creating template database...",
            "DATABASE_URL=postgres://dbuser:secret@postgres_primary/postgres bin/console doctrine:query:sql \"DROP DATABASE IF EXISTS eccubedb_test_template\" -q || true",
            "DATABASE_URL=postgres://dbuser:secret@postgres_primary/postgres bin/console doctrine:query:sql \"CREATE DATABASE eccubedb_test_template\" -q",
            "echo [4/6] Preparing template schema...",
            "DATABASE_URL=postgres://dbuser:secret@postgres_primary/eccubedb_test_template bin/console doctrine:schema:create --env=test -q",
            "DATABASE_URL=postgres://dbuser:secret@postgres_primary/eccubedb_test_template bin/console eccube:fixtures:load --env=test -q",
            "DATABASE_URL=postgres://dbuser:secret@postgres_primary/eccubedb_test_template bin/console doctrine:migrations:migrate --no-interaction --env=test -q",
            "DATABASE_URL=postgres://dbuser:secret@postgres_primary/eccubedb_test_template bin/console doctrine:schema:update --force --env=test -q",
            "echo [5/6] Cloning template DB to worker DBs...",
            "PARATEST_PROCESSES=${PARATEST_PROCESSES:-4}; for i in $(seq 1 ${PARATEST_PROCESSES}); do DATABASE_URL=postgres://dbuser:secret@postgres_primary/postgres bin/console doctrine:query:sql \"DROP DATABASE IF EXISTS eccubedb_test_$i\" -q || true; done",
            "PARATEST_PROCESSES=${PARATEST_PROCESSES:-4}; for i in $(seq 1 ${PARATEST_PROCESSES}); do DATABASE_URL=postgres://dbuser:secret@postgres_primary/postgres bin/console doctrine:query:sql \"CREATE DATABASE eccubedb_test_$i TEMPLATE eccubedb_test_template\" -q; done",
            "echo [6/6] Running ParaTest workers=${PARATEST_PROCESSES:-4} batch=${PARATEST_MAX_BATCH_SIZE:-10} extra=${PARATEST_EXTRA_ARGS:-}...",
            "{ echo 0 > /sys/fs/cgroup/memory.peak; } 2>/dev/null || true",
            "PARATEST_PROCESSES=${PARATEST_PROCESSES:-4}; PARATEST_MAX_BATCH_SIZE=${PARATEST_MAX_BATCH_SIZE:-10}; DATABASE_URL=postgres://dbuser:secret@postgres_primary/eccubedb_test vendor/bin/paratest --group HARERUYA -p${PARATEST_PROCESSES} --max-batch-size=${PARATEST_MAX_BATCH_SIZE} ${PARATEST_EXTRA_ARGS:-}; status=$?; if [ -r /sys/fs/cgroup/memory.peak ]; then awk '{ printf \"[paratest] container memory.peak = %.2f MiB\\n\", $1/1024/1024 }' /sys/fs/cgroup/memory.peak; else echo \"[paratest] memory.peak unavailable\"; fi; exit $status"
        ],
        "coverage-group-HARERUYA": [
            "php -d pcov.enabled=1 -r \"if (!extension_loaded('pcov')) { fwrite(STDERR, 'ERROR: PCOV is not installed. Run: apt-get install -y php8.3-pcov' . PHP_EOL); exit(1); } echo 'PCOV coverage mode: OK' . PHP_EOL;\"",
            "echo [0/6] Clearing Symfony test cache...",
            "rm -rf var/cache/test || true",
            "echo [1/6] Terminating active test DB connections...",
            "DATABASE_URL=postgres://dbuser:secret@postgres_primary/postgres bin/console doctrine:query:sql \"SELECT pg_terminate_backend(pid) FROM pg_stat_activity WHERE datname LIKE 'eccubedb_test%' AND pid <> pg_backend_pid()\" -q || true",
            "echo [2/6] Creating template database...",
            "DATABASE_URL=postgres://dbuser:secret@postgres_primary/postgres bin/console doctrine:query:sql \"DROP DATABASE IF EXISTS eccubedb_test_template\" -q || true",
            "DATABASE_URL=postgres://dbuser:secret@postgres_primary/postgres bin/console doctrine:query:sql \"CREATE DATABASE eccubedb_test_template\" -q",
            "echo [3/6] Preparing template schema...",
            "DATABASE_URL=postgres://dbuser:secret@postgres_primary/eccubedb_test_template && bin/console doctrine:schema:create --env=test -q",
            "DATABASE_URL=postgres://dbuser:secret@postgres_primary/eccubedb_test_template && bin/console eccube:fixtures:load --env=test -q",
            "DATABASE_URL=postgres://dbuser:secret@postgres_primary/eccubedb_test_template && bin/console doctrine:migrations:migrate --no-interaction --env=test -q",
            "DATABASE_URL=postgres://dbuser:secret@postgres_primary/eccubedb_test_template && bin/console doctrine:schema:update --force --env=test -q",
            "echo [4/6] Cloning template DB to worker DBs...",
            "for i in 1 2 3 4; do DATABASE_URL=postgres://dbuser:secret@postgres_primary/postgres bin/console doctrine:query:sql \"DROP DATABASE IF EXISTS eccubedb_test_$i\" -q || true; done",
            "for i in 1 2 3 4; do DATABASE_URL=postgres://dbuser:secret@postgres_primary/postgres bin/console doctrine:query:sql \"CREATE DATABASE eccubedb_test_$i TEMPLATE eccubedb_test_template\" -q; done",
            "echo [5/6] Warming coverage cache...",
            "php -d pcov.enabled=1 vendor/bin/phpunit --warm-coverage-cache",
            "echo [6/6] Running ParaTest with PCOV coverage...",
            "DATABASE_URL=postgres://dbuser:secret@postgres_primary/eccubedb_test php -d pcov.enabled=1 vendor/bin/paratest --group HARERUYA -p4 --passthru-php=\"'-d' 'pcov.enabled=1' '-d' 'display_errors=0'\" --coverage-html var/coverage"
        ]
    },
    "conflict": {
        "symfony/symfony": "*",
        "easycorp/easy-log-handler": "1.0.4|1.0.5"
    },
    "extra": {
        "symfony": {
            "id": "01C0Q71D54BCVSB8ZWR3VECDRD",
            "allow-contrib": false,
            "require": "7.4.*"
        },
        "symfony-web-dir": ".",
        "bin-dir": "bin",
        "src-dir": "src/Eccube",
        "config-dir": "app/config/eccube",
        "public-dir": "."
    },
    "config": {
        "platform": {
            "php": "8.3.6"
        },
        "preferred-install": {
            "*": "dist"
        },
        "optimize-autoloader": true,
        "sort-packages": true,
        "allow-plugins": {
            "composer/*": true,
            "kylekatarnls/update-helper": true,
            "ec-cube/plugin-installer": true,
            "symfony/flex": true,
            "phpstan/extension-installer": true
        }
    },
    "repositories": [
        {
            "name": "eccube",
            "type": "composer",
            "url": "https://package-api-c2.ec-cube.net/v43",
            "options": {
                "http": {
                    "header": ["X-ECCUBE-KEY: "]
                }
            },
            "exclude": ["ec-cube/slnpayment42"]
        },
        {
            "name": "plugin_reposslnpayment42",
            "type": "path",
            "url": "plugin_repos/SlnPayment42"
        }
    ]
}
